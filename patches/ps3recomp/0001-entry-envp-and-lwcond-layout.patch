+/* ---------------------------------------------------------------------------
+ * Save states: cellSaveData's part of the MISC section (runtime/savestate/
+ * ss_state.h), written by cellSysmodule.c, which registers the section.
+ *
+ * A strict save is refused while an operation runs (it calls guest callbacks
+ * and stages files; cellSaveData_ss_check, the same rule ppu_loader.cpp adds
+ * with ss_add_check before the stop). Outside one, the only state a title
+ * can observe again is the text of its last save (s_last_text above); the
+ * scratch window, the sort keys and the savedata root are per operation or
+ * host configuration, and the saves themselves are files on disk, which a
+ * state never rewrites (engine design 6.2).
+ * -----------------------------------------------------------------------*/
+static const ss_field k_savedata_ss_fields[] = {
+    SS_FIELD_AS("count", s_last_text.count), SS_FIELD_AS("wrote", s_last_text.wrote),
+    SS_FIELD_AS("dir", s_last_text.dir), SS_FIELD_AS("title", s_last_text.title),
+    SS_FIELD_AS("subTitle", s_last_text.subTitle), SS_FIELD_AS("detail", s_last_text.detail),
+};
+const ss_list cellSaveData_ss_list = SS_LIST("savedata", k_savedata_ss_fields);
+
+int cellSaveData_ss_check(char* why, size_t n)
+{
+    if (!ps3_savedata_busy()) return 0;
+    snprintf(why, n, "a cellSaveData operation is in progress");
+    return SS_REASON_GAME_SAVING;
+}
+
+/* A load (M4c; cellSysmodule.c reads the image). Teardown, every guest
+ * thread gone: no operation is in progress any more -- a lenient load may
+ * have discarded a thread inside one, whose count would refuse every later
+ * save -- and no text recorded, the boot state. */
+void cellSaveData_ss_text_write(int end);
+void cellSaveData_ss_teardown(void)
+{
+    __atomic_store_n(&s_savedata_busy, 0, __ATOMIC_SEQ_CST);
+    cellSaveData_ss_text_write(0);
+    s_last_text.count = 0;
+    s_last_text.wrote = 0;
+    s_last_text.dir[0] = s_last_text.title[0] = s_last_text.subTitle[0] = s_last_text.detail[0] = '\0';
+    cellSaveData_ss_text_write(1);
+}
+
+/* Around a write of s_last_text that is not savedata_note_text's (the
+ * teardown above, ss_read_fields in the restore): end = 0 before it (seq odd:
+ * a reader retries), end = 1 after it, which also ends each string inside
+ * its buffer. */
+void cellSaveData_ss_text_write(int end)
+{
+    if (end) {
+        s_last_text.dir[sizeof s_last_text.dir - 1] = '\0';
+        s_last_text.title[sizeof s_last_text.title - 1] = '\0';
+        s_last_text.subTitle[sizeof s_last_text.subTitle - 1] = '\0';
+        s_last_text.detail[sizeof s_last_text.detail - 1] = '\0';
+    }
+    __atomic_add_fetch(&s_last_text.seq, 1, __ATOMIC_SEQ_CST);
+}
