+/* One capture's per-slot scratch (no allocation inside a stop): the park
+ * record, the context it points at and the chain, so each table is walked
+ * once and the records are written one array at a time. */
+static struct pput_scr {
+    int                live;      /* RUNNING / DETACHED: it has a park and a context record */
+    pput_park          p;
+    const ppu_context* ctx;
+    uint32_t           sp[PPUT_CHAIN_MAX], ra[PPUT_CHAIN_MAX];
