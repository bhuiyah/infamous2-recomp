+/* ---------------------------------------------------------------------------
+ * SPU threads
+ * -----------------------------------------------------------------------*/
+typedef struct ss_spu_slot {
+    volatile long used;
+    const void*   ctx;
+    uint32_t      tid, group;
+    int           kind;
+    volatile long state, gen;
+    int           where;
+    uint64_t      t_park_us;
+    ss_spu_desc   d;
+    unsigned      irq_skips, n_parks;
+    double        max_ms;
+    int           foreign;      /* parked while running a context not its own */
+    unsigned long host_tid;     /* its host thread (a load's discard waits for it to exit) */
+    void*         root;         /* its discard root (ss_spu_set_root), NULL: none */
+} ss_spu_slot;
+static ss_spu_slot s_spu[SS_SPU_MAX];
+static PPU_THREAD_LOCAL ss_spu_slot* t_spu;
+static volatile long s_spu_foreign;         /* park points reached on unregistered contexts */
+static const void* volatile s_spu_foreign_ctx;
+static volatile uint32_t s_spu_foreign_pc, s_spu_foreign_img;
+static volatile long s_spu_reg_total;
+
+void ss_spu_thread_begin(const void* ctx, uint32_t tid, uint32_t group, int kind, const ss_spu_ops* ops)
+{
+    if (ops && !s_spu_ops) s_spu_ops = ops;
+    for (int i = 0; i < SS_SPU_MAX; i++) {
+        ss_spu_slot* s = &s_spu[i];
+        if (s->used || InterlockedCompareExchange(&s->used, 2, 0) != 0) continue;
+        s->ctx = ctx; s->tid = tid; s->group = group; s->kind = kind;
+        s->state = 0; s->gen = -1; s->irq_skips = 0; s->n_parks = 0; s->max_ms = 0;
+        s->host_tid = GetCurrentThreadId(); s->root = NULL;
+        t_spu = s;
+        InterlockedExchange(&s->used, 1);
+        const long n = InterlockedIncrement(&s_spu_reg_total);
+        if (g_ss_armed)
+            fprintf(stderr, "[ss] spu thread registered: tid=0x%X group=0x%X ctx=%p kind=%s (#%ld)\n",
+                    tid, group, ctx, kind == SS_SPU_FALLBACK ? "fallback" : "lifted", n);
+        return;
+    }
+    if (g_ss_armed)
+        fprintf(stderr, "[ss] WARNING: more than %d SPU host threads -- tid 0x%X is not tracked\n",
+                SS_SPU_MAX, tid);
+}
+
+void ss_spu_thread_end(void)
+{
+    ss_spu_slot* s = t_spu;
+    if (!s) return;
+    t_spu = 0;
+    AcquireSRWLockExclusive(&s_lk);
+    s->ctx = 0;
+    s->root = NULL;
+    InterlockedExchange(&s->used, 0);
+    ReleaseSRWLockExclusive(&s_lk);
+}
+
+void ss_spu_set_root(void* jb)
+{
+    ss_spu_slot* s = t_spu;
+    if (s) s->root = jb;
+}
+
+void ss_spu_park_point(const void* ctx, int where)
+{
+    if (!g_ss_spu_req) return;
+    ss_spu_slot* s = t_spu;
+    const int foreign = !s || (ctx && s->ctx && s->ctx != ctx);
+    if (foreign) {
+        /* Not the registered SPU thread's own context: an extra one is live
+         * (a policy module, a nested job, an async or raw SPU). Counted for
+         * the M0 check. A registered thread still parks (its host thread is
+         * what has to stop); SPU code on any other thread -- an HLE job run
+         * on a PPU thread -- is never parked and never waited for. */
+        InterlockedIncrement(&s_spu_foreign);
+        if (ctx && ctx != s_spu_foreign_ctx) {
+            if (s_spu_ops && s_spu_ops->describe) {
+                ss_spu_desc d;
+                memset(&d, 0, sizeof d);
+                s_spu_ops->describe(ctx, &d);
+                s_spu_foreign_pc = d.pc; s_spu_foreign_img = d.image_id;
+            }
+            s_spu_foreign_ctx = ctx;
+        }
+        if (!s) return;
+    }
+    const void* c = ctx ? ctx : s->ctx;
+    ss_spu_desc d;
+    memset(&d, 0, sizeof d);
+    if (c && s_spu_ops && s_spu_ops->describe) s_spu_ops->describe(c, &d);
+    if (where == SS_SPU_AT_HOP && d.irq_saved) { s->irq_skips++; return; }   /* handler in flight */
+    const uint64_t t = ss_now_us();
+    AcquireSRWLockExclusive(&s_lk);
+    if (g_ss_spu_req) {
+        const long gen = s_spu_gen;
+        s->d = d; s->where = where; s->t_park_us = t; s->gen = gen; s->foreign = foreign;
+        InterlockedExchange(&s->state, 1);
+        while (g_ss_spu_req && s_spu_gen == gen) {
+            SleepConditionVariableSRW(&s_cv, &s_lk, 50, 0);
+            watchdog();
+        }
+        InterlockedExchange(&s->state, 0);
+        if (s_spu_discard_gen == gen && s->root) {
+            /* A LOAD threw this world away: unregistered (critique H2: no
+             * ghost slot for the next stop to wait on), then back to the
+             * thread proc's discard root, every nested run with it (C8). */
+            void* jb = s->root;
+            s->ctx = 0;
+            s->root = NULL;
+            t_spu = 0;
+            InterlockedExchange(&s->used, 0);
+            ReleaseSRWLockExclusive(&s_lk);
+            longjmp(*(jmp_buf*)jb, SS_ROOT_DISCARD);
+        }
+    }
+    ReleaseSRWLockExclusive(&s_lk);
+}
