+        while (g_ss_mix_req && s_mix_gen == gen) {
+            SleepConditionVariableSRW(&s_cv, &s_lk, 50, 0);
+            watchdog();
+        }
+        InterlockedExchange(&s_mix.state, 0);
+    }
+    ReleaseSRWLockExclusive(&s_lk);
+}
