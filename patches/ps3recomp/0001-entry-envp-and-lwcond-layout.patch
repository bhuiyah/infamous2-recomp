+        s_tp.vram_budget = 1000u + at;
+        CHECK(tp_rt_bind(&sA, &dA, g2 + oA, oA, fw2d, 110, s_tp.frame) == NULL);
+        CHECK(sA.rep->inflight && s_tp.nreq == 1 && s_tp.vram_pending == at && at > 148);
+        if (s_tp.nreq == 1) { tp_req qq = s_tp.req[--s_tp.nreq]; free(qq.path); }
+        s_tp.vram_pending = 0; sA.rep->pend = 0; sA.rep->inflight = 0;
+        /* one file bigger than the whole budget loads when nothing else is resident or loading */
+        s_tp.vram_budget = 16; s_tp.vram_used = 0;
+        CHECK(tp_rt_bind(&sA, &dA, g2 + oA, oA, fw2d, 111, s_tp.frame) == NULL && sA.rep->inflight && s_tp.nreq == 1);
+        if (s_tp.nreq == 1) { tp_req qq = s_tp.req[--s_tp.nreq]; free(qq.path); }
