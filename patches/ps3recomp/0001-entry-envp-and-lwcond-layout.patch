+                   + [f"/I{i}" for i in inc] + srcs + [f"/Fe:{exe}", f"/Fo:{tmp}\\"])
+        else:
+            cmd = [cxx, "-std=c++20", "-O1", "-w"] + [f"-I{i}" for i in inc] + srcs + ["-o", exe, "-lpthread"]
+        r = subprocess.run(cmd, capture_output=True, text=True, cwd=tmp, timeout=600)
+        check(r.returncode == 0, "compile failed:\n" + (r.stdout + r.stderr)[-3000:])
+        if r.returncode:
+            return
+        r = subprocess.run([exe, os.path.join(tmp, "e2e.log")], capture_output=True, text=True,
+                           timeout=120)
+        print(r.stdout.strip())
+        check(r.returncode == 0, "end-to-end run failed:\n" + r.stdout[-3000:] + r.stderr[-1000:])
+
+
+def main():
+    test_emission()
+    test_end_to_end()
+    if FAILS:
+        print(f"{len(FAILS)} FAILED")
+        return 1
+    print("ok: slotcheck emission and reporter")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
