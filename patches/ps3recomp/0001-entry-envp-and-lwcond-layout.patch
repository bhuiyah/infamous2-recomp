+    for (int i = 0; i < PPU_THREAD_MAX; i++)
+        if (s_pput_scr[i].live) ss_recs_add(w, (uint32_t)i + 1, s_pput_scr[i].ctx);
+    ss_recs_end(w);
+
+    ss_recs_begin(w, &k_pput_frame_list);
+    for (int i = 0; i < PPU_THREAD_MAX; i++) {
+        const struct pput_scr* s = &s_pput_scr[i];
+        if (!s->live) continue;
+        for (uint32_t d = 0; d < s->p.frames; d++) {
+            pput_frame f;
+            f.tid = (uint32_t)i + 1; f.depth = d; f.sp = s->sp[d]; f.ra = s->ra[d];
+            ss_recs_add(w, (((uint32_t)i + 1) << 8) | d, &f);   /* tid, depth */
+        }
+    }
+    ss_recs_end(w);
+    return ss_writer_error(w);
+}
+
+/* Record sizes as the writer lays them out (ss_state.c: a u32 key and its
+ * padding, every field 8-aligned), plus each array's header. */
+static uint64_t pput_size_hint(void)
+{
+    uint64_t live = 0, used = 0;
+    for (int i = 0; i < PPU_THREAD_MAX; i++) {
+        if (g_ppu_threads[i].state != PPU_THREAD_STATE_FREE) used++;
+        if (pput_live(&g_ppu_threads[i])) live++;
+    }
+    return 16384u + used * 160u + live * (176u + 1120u + PPUT_CHAIN_MAX * 40u);
+}
+
+/* ---- the load (M4c; ss_core.h "the load") ---------------------------------
+ * TEARDOWN: every guest thread but main is gone (its host thread returned
+ * from the proc), so every slot's host handles go -- main's slot keeps its
+ * own (its host thread lives on, at the load gate).
+ * RESTORE: the table slot by slot at its index (guest memory stores tids):
+ * FREE slots zeroed; FINISHED ones with a finish event already signalled (a
+ * join returns at once, as it would have); RUNNING / DETACHED ones with a
+ * fresh event, their context from the image, and their park record handed
+ * to the coordinator (ss_load_set_park), which recreates each in resume mode
+ * (ppu_ss_recreate) once every section is restored. Main's slot keeps its
+ * host side; main's context and park go to the coordinator, which gives
+ * them to main at the gate. The "frames" records are the chains as captured:
+ * validation only. */
+static void pput_teardown(void)
+{
+    table_lock();
+#ifdef _WIN32
+    /* PPU_THREADGATE (a debug switch): a held-back thread never ran -- it is
+     * in neither state and holds nothing -- so it ends here, before its slot's
+     * handle (the same one) is closed; and the list goes, or a later release
+     * would resume whatever thread a closed handle names by then. */
+    for (int i = 0; i < g_gate_n; i++)
+        if (g_gate_pending[i]) TerminateThread(g_gate_pending[i], 0);
+    g_gate_n = 0;
+#endif
+    for (int i = 0; i < PPU_THREAD_MAX; i++) {
+        ppu_thread_info* t = &g_ppu_threads[i];
+        if (t->state != PPU_THREAD_STATE_FREE && pput_is_main(t)) continue;
+#ifdef _WIN32
+        if (t->host_thread) CloseHandle(t->host_thread);
+        if (t->finish_event) CloseHandle(t->finish_event);
+#endif
+        t->host_thread = NULL;
+        t->finish_event = NULL;
+        s_resume_slot[i] = 0;
+    }
+    table_unlock();
+}
+
+static ppu_context s_pput_rctx[PPU_THREAD_MAX];     /* the image's contexts, by slot (restore scratch) */
+static uint8_t     s_pput_rhas[PPU_THREAD_MAX];
+
+static int pput_restore(ss_reader* r)
+{
+    ss_recs_it it;
+    uint32_t key;
+    int k, e;
+    /* contexts first: the park records refer to them */
+    memset(s_pput_rhas, 0, sizeof s_pput_rhas);
+    if ((e = ss_recs_open(r, &k_pput_ctx_list, &it)) != 0) return e;
+    for (;;) {
+        ppu_context c;
+        memset(&c, 0, sizeof c);
+        if ((k = ss_recs_next(&it, &key, &c)) != 1) break;
+        if (key < 1 || key > PPU_THREAD_MAX)
+            return ss_reader_fail(r, SS_E_CORRUPT, "contexts[%u]: no such thread slot", key);
+        s_pput_rctx[key - 1] = c;
+        s_pput_rctx[key - 1].thread_id = key;
+        s_pput_rhas[key - 1] = 1;
+    }
+    if (k < 0) return k;
+    if ((e = ss_recs_open(r, &k_pput_thread_list, &it)) != 0) return e;
+    table_lock();
+    for (int i = 0; i < PPU_THREAD_MAX; i++) {          /* every slot that is not main's: empty */
+        ppu_thread_info* t = &g_ppu_threads[i];
+        if (t->state != PPU_THREAD_STATE_FREE && pput_is_main(t)) continue;
+        memset(t, 0, sizeof *t);
+        s_slot_gen[i]++;
+    }
+    for (;;) {
+        ppu_thread_info tmp;
+        memset(&tmp, 0, sizeof tmp);
+        if ((k = ss_recs_next(&it, &key, &tmp)) != 1) break;
+        if (key < 1 || key > PPU_THREAD_MAX) {
+            table_unlock();
+            return ss_reader_fail(r, SS_E_CORRUPT, "threads[%u]: no such thread slot", key);
+        }
+        ppu_thread_info* t = &g_ppu_threads[key - 1];
+        const int main_slot = t->state != PPU_THREAD_STATE_FREE && pput_is_main(t);
+        /* the listed members only: the host side (and main's context) stays */
+        t->state = tmp.state; t->priority = tmp.priority; t->exit_status = tmp.exit_status;
+        t->joinable = tmp.joinable; t->stack_addr = tmp.stack_addr; t->stack_size = tmp.stack_size;
+        t->entry_addr = tmp.entry_addr; t->tls_addr = tmp.tls_addr;
+        memcpy(t->name, tmp.name, sizeof t->name);
+        if (main_slot) continue;
+        if (s_pput_rhas[key - 1]) t->ctx = s_pput_rctx[key - 1];
+        else { ppu_context_init(&t->ctx); }
+        t->ctx.thread_id = key;
+        t->ctx.reserve_addr = 0;
+        t->ctx.reserve_valid = 0;
+#ifdef _WIN32
+        /* FINISHED: nobody joined it yet -- its event set, a join returns at once */
+        t->finish_event = CreateEventA(NULL, TRUE, t->state == PPU_THREAD_STATE_FINISHED ? TRUE : FALSE, NULL);
+#endif
+    }
+    table_unlock();
+    if (k < 0) return k;
+    /* the park records: what each live thread resumes from */
+    if ((e = ss_recs_open(r, &k_pput_park_list, &it)) != 0) return e;
+    for (;;) {
+        pput_park p;
+        memset(&p, 0, sizeof p);
+        if ((k = ss_recs_next(&it, &key, &p)) != 1) break;
+        if (key < 1 || key > PPU_THREAD_MAX || !s_pput_rhas[key - 1])
+            return ss_reader_fail(r, SS_E_CORRUPT, "parks[%u]: no such thread slot, or no context for it", key);
+        const ppu_thread_info* t = &g_ppu_threads[key - 1];
+        if (!pput_live(t)) continue;
+        if (!p.at)
+            return ss_reader_fail(r, SS_E_STATE, "parks[%u]: tid %u '%s' has no park record to resume from", key,
+                                  key, t->name);
+        ss_wait_rec wr;
+        memset(&wr, 0, sizeof wr);
+        wr.nid_or_sc = p.nid_or_sc; wr.a = p.wa; wr.b = p.wb; wr.c = p.wc; wr.deadline_ns = p.deadline_ns;
+        ss_sr_root root;
+        root.root_lr = p.root_lr; root.root_sp = p.root_sp; root.stack_lo = p.stack_lo; root.stack_hi = p.stack_hi;
+        ss_load_set_park(key, p.at, p.tier, p.at == SS_IN_WAIT ? p.kind : p.num, p.obj, &wr, &root,
+                         (int)p.root_valid, &s_pput_rctx[key - 1]);
+    }
+    return k < 0 ? k : SS_OK;
+}
+
+/* Before a load, with the world running (ss_set_ppu_image_check): every
+ * RUNNING / DETACHED thread of the image has a park record of a kind this
+ * build can resume. */
+static int pput_image_check(const ss_image* img, char* why, size_t n)
+{
+    ss_reader r;
+    if (ss_reader_open(&r, img, SS_FOURCC('P', 'P', 'U', 'T')) != SS_OK) { snprintf(why, n, "no PPUT section"); return 1; }
+    ss_recs_it it;
+    uint32_t key;
+    int k;
+    int32_t state[PPU_THREAD_MAX];
+    char name[PPU_THREAD_MAX][28];
+    for (int i = 0; i < PPU_THREAD_MAX; i++) { state[i] = PPU_THREAD_STATE_FREE; name[i][0] = 0; }
+    if (ss_recs_open(&r, &k_pput_thread_list, &it) != SS_OK) { snprintf(why, n, "PPUT: %s", r.what); return 1; }
+    for (;;) {
+        ppu_thread_info tmp;
+        if ((k = ss_recs_next(&it, &key, &tmp)) != 1) break;
+        if (key >= 1 && key <= PPU_THREAD_MAX) {
+            state[key - 1] = tmp.state;
+            snprintf(name[key - 1], sizeof name[key - 1], "%s", tmp.name);
+        }
+    }
+    uint8_t parked[PPU_THREAD_MAX];
+    memset(parked, 0, sizeof parked);
+    if (ss_recs_open(&r, &k_pput_park_list, &it) != SS_OK) { snprintf(why, n, "PPUT: %s", r.what); return 1; }
+    for (;;) {
+        pput_park p;
+        if ((k = ss_recs_next(&it, &key, &p)) != 1) break;
+        if (key < 1 || key > PPU_THREAD_MAX) continue;
+        parked[key - 1] = p.at != 0;
+        if (p.at == SS_IN_WAIT && !ss_wait_resumable((int)p.kind)) {
+            snprintf(why, n, "tid %u '%s' waits in %s, which this build cannot resume", key, name[key - 1],
+                     ss_wait_name((int)p.kind));
+            return 1;
+        }
+    }
+    for (int i = 0; i < PPU_THREAD_MAX; i++)
+        if ((state[i] == PPU_THREAD_STATE_RUNNING || state[i] == PPU_THREAD_STATE_DETACHED) && !parked[i]) {
+            snprintf(why, n, "tid %d '%s' has no park record", i + 1, name[i]);
+            return 1;
+        }
+    /* M5: every return address a resume would dispatch -- the parked call's
+     * own (ra0), then each frame's of the chain the capture walked, up to the
+     * root (its LR, a 0, an address outside lifted code) or a continuation
+     * that never returns -- has a continuation in THIS build. An image of
+     * another build, or a relift that lost one, is refused here, before the
+     * stop, with the address named. (No continuation table: not checked.) */
+    {   /* fault injection (tests, M7b): SS_FAULT=cont_miss refuses every load here, as a state whose
+         * return address this build has no continuation for (another build's) -- the refusal path */
+        const char* f = getenv("SS_FAULT");
+        if (f && strstr(f, "cont_miss")) {
+            snprintf(why, n, "tid 1 '%s': a return address has no continuation in this build (SS_FAULT=cont_miss)",
+                     name[0]);
+            return 1;
+        }
+    }
+    if (ss_cont_covered(0, NULL) < 0) return 0;
+    pput_park pk[PPU_THREAD_MAX];
+    uint8_t chk[PPU_THREAD_MAX];                       /* 1: frames still to check */
+    memset(chk, 0, sizeof chk);
+    if (ss_recs_open(&r, &k_pput_park_list, &it) != SS_OK) { snprintf(why, n, "PPUT: %s", r.what); return 1; }
+    for (;;) {
+        pput_park p;
+        if ((k = ss_recs_next(&it, &key, &p)) != 1) break;
+        if (key < 1 || key > PPU_THREAD_MAX || !p.at) continue;
+        const int i = (int)key - 1;
+        if (state[i] != PPU_THREAD_STATE_RUNNING && state[i] != PPU_THREAD_STATE_DETACHED) continue;
+        pk[i] = p;
+        chk[i] = 1;
+        if (!p.ra0 || (p.root_valid && p.ra0 == p.root_lr)) { chk[i] = 0; continue; }
+        int nr = 0;
+        const int c = ss_cont_covered(p.ra0, &nr);
+        if (c == 0) {
+            snprintf(why, n, "tid %u '%s': return address 0x%08X has no continuation in this build (list it in"
+                     " config/ss_cont_list.txt and relift)", key, name[i], p.ra0);
+            return 1;
+        }
+        if (c == 2 || nr) chk[i] = 0;
+    }
+    if (ss_recs_open(&r, &k_pput_frame_list, &it) != SS_OK) { snprintf(why, n, "PPUT: %s", r.what); return 1; }
+    for (;;) {
+        pput_frame f;
+        if ((k = ss_recs_next(&it, &key, &f)) != 1) break;
+        if (f.tid < 1 || f.tid > PPU_THREAD_MAX || !chk[f.tid - 1]) continue;
+        const int i = (int)f.tid - 1;
+        if (!f.ra || (pk[i].root_valid && f.ra == pk[i].root_lr)) { chk[i] = 0; continue; }
+        int nr = 0;
+        const int c = ss_cont_covered(f.ra, &nr);
+        if (c == 0) {
+            snprintf(why, n, "tid %u '%s': return address 0x%08X (frame %u) has no continuation in this build (list"
+                     " it in config/ss_cont_list.txt and relift)", f.tid, name[i], f.ra, f.depth);
+            return 1;
+        }
+        if (c == 2 || nr) chk[i] = 0;
+    }
+    /* a chain the capture's walk cut at its depth, not at the root or at a
+     * continuation that never returns: frames above it are unchecked, and a
+     * resume would need more than it follows */
+    for (int i = 0; i < PPU_THREAD_MAX; i++)
+        if (chk[i] && pk[i].chain_end == PPUT_END_DEPTH) {
+            snprintf(why, n, "tid %d '%s': its call chain is deeper than the %d frames a resume follows", i + 1,
+                     name[i], PPUT_CHAIN_MAX);
+            return 1;
+        }
+    return 0;
+}
+
+/* RECREATE (ss_set_ppu_recreate): slot tid's host thread, in resume mode --
+ * the same thread proc, its root the restored park's; it waits at the load
+ * gate and resumes from that park at the release. */
+static int ppu_ss_recreate(unsigned tid, char* why, size_t n)
+{
+    if (tid < 1 || tid > PPU_THREAD_MAX) { snprintf(why, n, "tid %u out of range", tid); return -1; }
+    const int slot = (int)tid - 1;
+    ppu_thread_info* t = &g_ppu_threads[slot];
+    if (!pput_live(t)) { snprintf(why, n, "slot %d holds no live thread", slot); return -1; }
+#ifdef _WIN32
+    table_lock();
+    if (!t->finish_event) t->finish_event = CreateEventA(NULL, TRUE, FALSE, NULL);
+    s_slot_gen[slot]++;
+    InterlockedExchange(&s_resume_slot[slot], 1);
+    t->host_thread = (HANDLE)_beginthreadex(NULL, PPU_HOST_STACK_BYTES,
+                                            (unsigned (__stdcall*)(void*))ppu_host_thread_proc, t,
+                                            STACK_SIZE_PARAM_IS_A_RESERVATION, (unsigned*)&t->host_tid);
+    if (!t->host_thread) {
+        InterlockedExchange(&s_resume_slot[slot], 0);
+        table_unlock();
+        snprintf(why, n, "_beginthreadex failed (error %lu)", (unsigned long)GetLastError());
+        return -1;
+    }
+    if (t->priority < 256) SetThreadPriority(t->host_thread, THREAD_PRIORITY_ABOVE_NORMAL);
+    table_unlock();
+    return 0;
+#else
+    snprintf(why, n, "resume-mode threads are Windows only");
+    return -1;
+#endif
+}
+
+static const ss_section_ops k_pput_ops = {
+    SS_FOURCC('P', 'P', 'U', 'T'), 1, 0, SS_ORDER_PPU,
+    pput_check, pput_capture, pput_teardown, pput_restore, NULL,
+    "PPU threads", k_pput_lists, pput_size_hint, NULL,
+};
+SS_SECTION_REGISTER(k_pput_ops)
