+static void test_axis_u8(void)
+{
+    CHECK_EQ(kbm_axis_u8(-1.0f), 0);
+    CHECK_EQ(kbm_axis_u8(0.0f), 128);
+    CHECK_EQ(kbm_axis_u8(1.0f), 255);
+    CHECK_EQ(kbm_axis_u8(0.5f), 192);
+    CHECK_EQ(kbm_axis_u8(-0.5f), 64);
+    CHECK_EQ(kbm_axis_u8(2.0f), 255);
+    CHECK_EQ(kbm_axis_u8(-2.0f), 0);
+    CHECK_EQ(kbm_axis_u8(0.001f), 128);
+}
