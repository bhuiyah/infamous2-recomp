+      const size_t rn = ss_rec_size();
+      CHECK(rn > 0 && rn <= sizeof a, "record size %u", (unsigned)rn);
+      m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
