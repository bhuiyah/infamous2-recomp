+/* DRED aid: the first copy recorded into the frame list since its last Reset
+ * (a hang DRED places on a frame's first CopyTextureRegion is then named). */
+static char s_first_copy[192];
+static int  s_first_copy_set;
+static void copy_note(int line, const D3D12_TEXTURE_COPY_LOCATION* dst,
+                      const D3D12_TEXTURE_COPY_LOCATION* src)
+{
+    if (s_first_copy_set) return;
+    s_first_copy_set = 1;
+    if (src->Type == D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT)
+        snprintf(s_first_copy, sizeof s_first_copy,
+                 "line %d: footprint fmt=%d %ux%u pitch=%u off=%llu -> sub %u", line,
+                 (int)src->PlacedFootprint.Footprint.Format, src->PlacedFootprint.Footprint.Width,
+                 src->PlacedFootprint.Footprint.Height, src->PlacedFootprint.Footprint.RowPitch,
+                 (unsigned long long)src->PlacedFootprint.Offset, dst->SubresourceIndex);
+    else
+        snprintf(s_first_copy, sizeof s_first_copy, "line %d: subresource %u -> %s", line,
+                 src->SubresourceIndex,
+                 dst->Type == D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT ? "footprint" : "texture");
+}
+/* DRED (device removed extended data; built into d3d12.dll, no SDK layers
+ * needed): on a GPU hang or fault, which command list and operation the GPU
+ * was in, and which allocation a page fault hit. D3D12_DRED=0 disables. */
+static int dred_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("D3D12_DRED"); v = e ? atoi(e) : 1; }
+    return v;
+}
+static void dred_report(const char* where)
+{
+    static int done = 0;
+    if (done || !s_d3d.device) return;
+    done = 1;
+    HRESULT rr = s_d3d.device->lpVtbl->GetDeviceRemovedReason(s_d3d.device);
+    fprintf(stderr, "[DRED] device removed (reason 0x%08lX) seen at %s%c", (long)rr, where, 10);
+    pi_note("the GPU stopped responding (device removed, reason 0x%08lX, at %s): a driver reset or a GPU "
+            "problem -- the picture freezes from here", (unsigned long)rr, where);
+    fprintf(stderr, "[DRED] frame list first copy: %s%c", s_first_copy_set ? s_first_copy : "(none)", 10);
+    ID3D12DeviceRemovedExtendedData* dr = NULL;
+    if (FAILED(s_d3d.device->lpVtbl->QueryInterface(s_d3d.device,
+            &IID_ID3D12DeviceRemovedExtendedData, (void**)&dr)) || !dr) {
+        fprintf(stderr, "[DRED] not available%c", 10); return; }
+    D3D12_DRED_AUTO_BREADCRUMBS_OUTPUT bo = {0};
+    if (SUCCEEDED(dr->lpVtbl->GetAutoBreadcrumbsOutput(dr, &bo))) {
+        for (const D3D12_AUTO_BREADCRUMB_NODE* n = bo.pHeadAutoBreadcrumbNode; n; n = n->pNext) {
+            u32 last = n->pLastBreadcrumbValue ? *n->pLastBreadcrumbValue : 0;
+            if (last >= n->BreadcrumbCount) continue;   /* list completed */
+            u32 draws = 0, copies = 0;
+            for (u32 i = 0; i < last && n->pCommandHistory; i++) {
+                int op = (int)n->pCommandHistory[i];
+                if (op == D3D12_AUTO_BREADCRUMB_OP_DRAWINSTANCED ||
+                    op == D3D12_AUTO_BREADCRUMB_OP_DRAWINDEXEDINSTANCED) draws++;
+                if (op == D3D12_AUTO_BREADCRUMB_OP_COPYTEXTUREREGION ||
+                    op == D3D12_AUTO_BREADCRUMB_OP_COPYRESOURCE) copies++;
+            }
+            fprintf(stderr, "[DRED] list '%ls' stopped at op %u of %u (%u draws, %u copies done); ops:",
+                    n->pCommandListDebugNameW ? n->pCommandListDebugNameW : L"?",
+                    last, n->BreadcrumbCount, draws, copies);
+            for (u32 i = last > 6 ? last - 6 : 0; i < n->BreadcrumbCount && i < last + 6; i++)
+                fprintf(stderr, " %s%d", i == last ? "*" : "", (int)n->pCommandHistory[i]);
+            fprintf(stderr, "%c", 10);
+        }
+    }
+    D3D12_DRED_PAGE_FAULT_OUTPUT pf = {0};
+    if (SUCCEEDED(dr->lpVtbl->GetPageFaultAllocationOutput(dr, &pf)) && pf.PageFaultVA) {
+        fprintf(stderr, "[DRED] page fault at GPU VA 0x%llX%c", (unsigned long long)pf.PageFaultVA, 10);
+        for (const D3D12_DRED_ALLOCATION_NODE* a = pf.pHeadExistingAllocationNode; a; a = a->pNext)
+            fprintf(stderr, "[DRED]   existing: %ls (type %d)%c", a->ObjectNameW ? a->ObjectNameW : L"?",
+                    (int)a->AllocationType, 10);
+        for (const D3D12_DRED_ALLOCATION_NODE* a = pf.pHeadRecentFreedAllocationNode; a; a = a->pNext)
+            fprintf(stderr, "[DRED]   recently freed: %ls (type %d)%c", a->ObjectNameW ? a->ObjectNameW : L"?",
+                    (int)a->AllocationType, 10);
+    }
+    dr->lpVtbl->Release(dr);
+    fflush(stderr);
+}
