+#!/usr/bin/env python3
+"""ss_manifest_check.py -- every static of the save-state owning files, classified.
+
+A save state stores guest-visible state only (runtime/savestate/ss_state.h),
+so every variable with static storage in a file that owns such state must be
+accounted for: saved in a section, reset on a load, kept, a diagnostic, or set
+once at boot. A static nobody classified is state a load would silently get
+wrong. This tool lists the statics of the given files -- file-scope variables
+(static or not, thread-locals included) and function-local statics -- and
+checks each one against the manifest (config/ss_manifest.txt by default):
+
+    # comment
+    <path>:<symbol> <CLASS> # <reason>
+
+  path    from the project root (the folder above config/), '/' separators
+  symbol  a file-scope name, or <function>.<name> for a function-local static
+          (the linker map's own spelling: report.last_n)
+  CLASS   SAVE   captured in a section, restored on a load
+          RESET  back to its boot value (or rebuilt) on a load
+          KEEP   host state a load keeps: devices, handles, locks, caches
+          DIAG   diagnostics or statistics only: no behaviour depends on it
+          BOOT   set at startup (configuration, registration) and never after
+
+Read-only objects (a `static const` table, `const char* const`) hold no state
+and need no line; they are listed by --list as CONST.
+
+    ss_manifest_check.py FILE...             check (default files: every path in the manifest)
+    ss_manifest_check.py --suggest FILE...   the unclassified ones as manifest lines, with a guess
+    ss_manifest_check.py --list FILE...      every static with its class
+    ss_manifest_check.py --map build/infamous2.map FILE...
+                                             also every data symbol the linker placed for those
+                                             files (catches what the source scan cannot see: a
+                                             header's statics, placed in every file that
+                                             includes it, and statics a macro defines -- but
+                                             SS_SECTION_REGISTER, which the scan knows). The
+                                             gate runs with it (--strict --map): without it, a
+                                             header static's line reads as stale
+
+Exit status: 0 every static classified; 1 an unclassified static, or a bad
+manifest line (--strict: or a stale entry); 2 usage.
+"""
+import argparse
+import collections
+import os
+import re
+import sys
+
+CLASSES = ("SAVE", "RESET", "KEEP", "DIAG", "BOOT")
+KEYWORDS = {
+    "static", "const", "volatile", "extern", "register", "auto", "inline", "restrict", "__restrict",
+    "unsigned", "signed", "int", "char", "short", "long", "float", "double", "void", "struct", "union",
+    "enum", "class", "typedef", "constexpr", "thread_local", "_Thread_local", "__thread", "mutable",
+    "_Atomic", "__declspec", "__attribute__", "alignas", "_Alignas", "sizeof", "return", "if", "else",
+    "for", "while", "do", "switch", "case", "default", "break", "continue", "goto", "namespace", "using",
+    "template", "typename", "operator", "new", "delete", "STR", "CHR",
+}
+TLS_WORDS = {"thread_local", "_Thread_local", "__thread", "PPU_THREAD_LOCAL", "SPU_THREAD_LOCAL", "THREAD_LOCAL"}
+
+
+# ---- source scanning ---------------------------------------------------------
+def strip_source(text):
+    """Comments, strings and preprocessor lines out; newlines kept."""
+    out = []
+    i, n = 0, len(text)
+    line_start = True
+    while i < n:
+        c = text[i]
+        if line_start:
+            j = i
+            while j < n and text[j] in " \t":
+                j += 1
+            if j < n and text[j] == "#":          # a directive, with its continuations
+                while j < n:
+                    if text[j] == "\n" and text[j - 1] != "\\" and not (text[j - 1] == "\r" and text[j - 2] == "\\"):
+                        break
+                    if text[j] == "/" and j + 1 < n and text[j + 1] == "*":
+                        # a block comment opened on the directive's line runs to its own end,
+                        # lines past it included (#include <x.h>  /* why ...\n * ... */)
+                        k = text.find("*/", j + 2)
+                        k = n if k < 0 else k + 2
+                        out.append("\n" * text.count("\n", j, k))
+                        j = k
+                        continue
+                    if text[j] == "\n":
+                        out.append("\n")
+                    j += 1
+                i = j
+                continue
+        line_start = False
+        if c == "/" and i + 1 < n and text[i + 1] == "*":
+            j = text.find("*/", i + 2)
+            j = n if j < 0 else j + 2
+            out.append("".join(ch if ch == "\n" else " " for ch in text[i:j]))
+            i = j
+            continue
+        if c == "/" and i + 1 < n and text[i + 1] == "/":
+            j = text.find("\n", i)
+            i = n if j < 0 else j
+            continue
+        if c in "\"'":
+            q = c
+            j = i + 1
+            while j < n and text[j] != q:
+                if text[j] == "\\":
+                    j += 1
+                j += 1
+            out.append(" STR " if q == '"' else " CHR ")
+            i = j + 1
+            continue
+        if c == "\n":
+            line_start = True
+        out.append(c)
+        i += 1
+    return "".join(out)
+
+
+TOK = re.compile(r"[A-Za-z_]\w*|\d[\w.]*|::|->|\S")
+
+
+def tokenize(text):
+    toks = []
+    for ln, line in enumerate(text.split("\n"), 1):
+        for m in TOK.finditer(line):
+            toks.append((m.group(0), ln))
+    return toks
+
+
+def group_end(toks, i):
+    """Index after the bracket group that opens at toks[i]."""
+    pairs = {"(": ")", "[": "]", "{": "}"}
+    stack = [pairs[toks[i][0]]]
+    j = i + 1
+    while j < len(toks) and stack:
+        t = toks[j][0]
+        if t in pairs:
+            stack.append(pairs[t])
+        elif stack and t == stack[-1]:
+            stack.pop()
+        j += 1
+    return j
+
+
+def flatten(toks):
+    """Bracket groups removed except parens, attributes dropped: [tok]."""
+    out = []
+    i = 0
+    while i < len(toks):
+        t = toks[i][0]
+        if t in ("__attribute__", "__declspec", "alignas", "_Alignas") and i + 1 < len(toks) and toks[i + 1][0] == "(":
+            i = group_end(toks, i + 1)
+            continue
+        if t == "{":
+            i = group_end(toks, i)
+            out.append("{}")
+            continue
+        out.append(t)
+        i += 1
+    return out
+
+
+def split_top(seq, sep):
+    parts, cur, depth = [], [], 0
+    for t in seq:
+        if t in "([":
+            depth += 1
+        elif t in ")]":
+            depth -= 1
+        if t == sep and depth == 0:
+            parts.append(cur)
+            cur = []
+        else:
+            cur.append(t)
+    parts.append(cur)
+    return parts
+
+
+def top_level_assign(flat):
+    """An '=' outside every (...) / [...]: an initializer (a default argument's is inside parens)."""
+    depth = 0
+    for t in flat:
+        if t in "([":
+            depth += 1
+        elif t in ")]":
+            depth -= 1
+        elif t == "=" and depth == 0:
+            return True
+    return False
+
+
+def declarators(flat):
+    """[(name, is_const, is_tls)] of a variable declaration, [] for anything else."""
+    if not flat or flat[0] in ("typedef", "using", "template", "static_assert", "_Static_assert", "friend"):
+        return []
+    # a declaration of something defined elsewhere -- unless it has an initializer, which makes
+    # it the definition: extern "C" uint32_t g_x = 0; (C++ exports a C-linkage global that way)
+    if "extern" in flat and "{}" not in flat and not top_level_assign(flat):
+        return []
+    parts = split_top(flat, ",")
+    first = parts[0]
+    # the type specifiers: the first part up to its declarator
+    tls = any(t in TLS_WORDS for t in first)
+    out = []
+    spec_const = None
+    for k, p in enumerate(parts):
+        # cut the initializer
+        eq = None
+        depth = 0
+        for idx, t in enumerate(p):
+            if t in "([":
+                depth += 1
+            elif t in ")]":
+                depth -= 1
+            elif t == "=" and depth == 0:
+                eq = idx
+                break
+        d = p[:eq] if eq is not None else p
+        if not d:
+            continue
+        if k == 0 and "{}" in d and any(w in ("struct", "union", "enum", "class") for w in d):
+            after = d[len(d) - 1 - d[::-1].index("{}") + 1:]
+            if not any(re.match(r"[A-Za-z_]\w*$", w) and w not in KEYWORDS for w in after):
+                return []                          # a type definition, no variable
+        # a function pointer / pointer to array: (*name) or (&name) or (*name[N])
+        name = None
+        for idx in range(len(d) - 2):
+            if d[idx] == "(" and d[idx + 1] in ("*", "&"):
+                j = idx + 2
+                while j < len(d) and d[j] in ("const", "volatile", "*"):
+                    j += 1
+                if j < len(d) and re.match(r"[A-Za-z_]\w*$", d[j]) and d[j] not in KEYWORDS:
+                    name = d[j]
+                    break
+        if name is None:
+            if eq is None and "(" in d:
+                # a function declaration (name followed by a parameter list) -- unless
+                # the parens are a macro around the type, e.g. SS_UNUSED(x) -- skip it
+                pi = d.index("(")
+                if pi > 0 and re.match(r"[A-Za-z_]\w*$", d[pi - 1]):
+                    return []
+            # the last identifier outside [...]
+            depth = 0
+            for t in d:
+                if t == "[":
+                    depth += 1
+                elif t == "]":
+                    depth -= 1
+                elif depth == 0 and re.match(r"[A-Za-z_]\w*$", t) and t not in KEYWORDS and t not in TLS_WORDS:
+                    name = t
+            if name is None:
+                continue
+            # a bare struct / enum declaration ("struct foo;")
+            if k == 0 and len(d) == 2 and d[0] in ("struct", "union", "enum", "class"):
+                return []
+        # const object? the last '*' before the name decides
+        try:
+            ni = len(d) - 1 - d[::-1].index(name)
+        except ValueError:
+            ni = len(d)
+        stars = [idx for idx in range(ni) if d[idx] == "*"]
+        if stars:
+            is_const = "const" in d[stars[-1] + 1:ni]
+        else:
+            if spec_const is None:
+                spec_const = "const" in first or "constexpr" in first
+            is_const = spec_const
+        if k == 0 and not stars:
+            spec_const = "const" in d or "constexpr" in d
+            is_const = spec_const
+        out.append((name, is_const, tls))
+    return out
+
+
+def scan_file(path):
+    """[(symbol, line, is_const, is_tls, scope)] -- scope 'file' or the function's name."""
+    text = strip_source(open(path, encoding="utf-8", errors="replace").read())
+    toks = tokenize(text)
+    cpp = os.path.splitext(path)[1].lower() in (".cpp", ".cc", ".cxx")
+    found = []
+    i = 0
+    acc = []                                       # the file-scope declaration being read
+    scopes = []                                    # transparent scopes (namespace, extern "C") open
+    def flush():
+        flat = flatten(acc)
+        ln = acc[0][1] if acc else 0
+        for (name, c, tls) in declarators(flat):
+            found.append((name, ln, c, tls, "file"))
+
+    while i < len(toks):
+        t = toks[i][0]
+        if t == "}" and scopes:                    # the end of a namespace / extern "C" block
+            flush()
+            acc = []
+            scopes.pop()
+            i += 1
+            continue
+        if t == ";":
+            flush()
+            acc = []
+            i += 1
+            continue
+        if t == "SS_SECTION_REGISTER" and not acc and i + 3 < len(toks) and toks[i + 1][0] == "(" and \
+                toks[i + 3][0] == ")":
+            # runtime/savestate/ss_state.h's registration, a statement with no ';' of its own (left
+            # in the stream it would swallow the declaration after it): in C++ the static-init
+            # object ss_section_reg_<ops> -- dynamically initialised, so data like any static --
+            # in C a constructor function, no data
+            if cpp:
+                found.append(("ss_section_reg_" + toks[i + 2][0], toks[i][1], False, False, "file"))
+            i += 4
+            continue
+        if t == "{":
+            words = [a[0] for a in acc]
+            if words[:1] == ["namespace"] or (words[:1] == ["extern"] and words[1:2] == ["STR"] and len(words) == 2):
+                scopes.append(i)
+                acc = []
+                i += 1
+                continue
+            flat_before = flatten(acc)
+            is_type = any(w in ("struct", "union", "enum", "class") for w in flat_before) and \
+                not (flat_before and flat_before[-1] == ")")
+            # C++ list-initialisation, T name{...} / T name[N]{...}: no parameter list before the
+            # brace (a function's body always follows one), and a name or ']' right before it
+            brace_init = cpp and flat_before and "(" not in flat_before and \
+                (flat_before[-1] == "]" or (re.match(r"[A-Za-z_]\w*$", flat_before[-1]) and
+                                            flat_before[-1] not in KEYWORDS))
+            if "=" in flat_before or is_type or brace_init:
+                j = group_end(toks, i)              # an initializer or a type body: part of the declaration
+                acc.extend(toks[i:j])
+                i = j
+                continue
+            # a function body: its name is the identifier before the last
+            # top-level parameter list (a macro call without ';' may precede it)
+            fname = None
+            depth = 0
+            for k, w in enumerate(flat_before):
+                if w == "(":
+                    if depth == 0 and k > 0 and re.match(r"[A-Za-z_]\w*$", flat_before[k - 1]):
+                        fname = flat_before[k - 1]
+                    depth += 1
+                elif w == ")":
+                    depth -= 1
+            j = group_end(toks, i)
+            scan_body(toks[i + 1:j - 1], fname or "?", found)
+            acc = []
+            i = j
+            continue
+        acc.append(toks[i])
+        i += 1
+    flush()
+    return found
+
+
+def scan_body(toks, fname, found):
+    """Function-local statics: a `static` that starts a statement."""
+    i = 0
+    prev = "{"
+    while i < len(toks):
+        t = toks[i][0]
+        if t == "static" and prev in ("{", "}", ";", ":"):
+            j = i
+            depth = 0
+            while j < len(toks):
+                u = toks[j][0]
+                if u in "({[":
+                    depth += 1
+                elif u in ")}]":
+                    depth -= 1
+                elif u == ";" and depth == 0:
+                    break
+                j += 1
+            for (name, c, tls) in declarators(flatten(toks[i:j])):
+                found.append(("%s.%s" % (fname, name), toks[i][1], c, tls, fname))
+            i = j + 1
+            prev = ";"
+            continue
+        prev = t
+        i += 1
+
+
+# ---- the linker map ------------------------------------------------------------
+MAP_LINE = re.compile(r"^\s000[35]:[0-9a-f]{8}\s+(\S+)\s+[0-9a-f]{16}\s+(?:f\s+)?(\S+)\s*$")
+MAP_SKIP = re.compile(r"^(\?\?_C@|__xmm@|__real@|__imp_|\.refptr|__local_stdio_|_tls_|__security|__guard)")
+
+
+def map_name(sym):
+    """A map symbol in the source scan's spelling (C: name, func.name, name.N
+    split by the optimizer; C++: ?name@... demangled enough)."""
+    if sym.startswith("?"):
+        m = re.match(r"\?(\w+)@\?\d+\?\?(\w+)@", sym)       # a C++ function-local static
+        if m:
+            return "%s.%s" % (m.group(2), m.group(1))
+        m = re.match(r"\?(\w+)@", sym)
+        return m.group(1) if m else sym
+    return re.sub(r"\.\d+$", "", sym)
+
+
+def map_symbols(map_path, objs):
+    out = collections.defaultdict(set)
+    for line in open(map_path, encoding="utf-8", errors="replace"):
+        m = MAP_LINE.match(line)
+        if not m:
+            continue
+        obj = m.group(2).split(":")[-1]
+        if obj not in objs or MAP_SKIP.match(m.group(1)):
+            continue
+        name = map_name(m.group(1))
+        if not MAP_SKIP.match(name):                  # (the CRT's inline statics, demangled)
+            out[obj].add(name)
+    return out
+
+
+# ---- the manifest ------------------------------------------------------------------
+ENTRY = re.compile(r"^(\S+?):(\S+)\s+([A-Z]+)\s*(?:#\s*(.*))?$")
+
+
+def read_manifest(path):
+    entries, errors = {}, []
+    if not os.path.exists(path):
+        return entries, errors
+    for ln, raw in enumerate(open(path, encoding="utf-8"), 1):
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        m = ENTRY.match(line)
+        if not m:
+            errors.append("%s:%d: not '<path>:<symbol> <CLASS> # reason': %s" % (path, ln, line))
+            continue
+        p, sym, cls, why = m.group(1), m.group(2), m.group(3), (m.group(4) or "").strip()
+        if cls not in CLASSES:
+            errors.append("%s:%d: class %s is not one of %s" % (path, ln, cls, "/".join(CLASSES)))
+            continue
+        if (p, sym) in entries:
+            errors.append("%s:%d: %s:%s classified twice" % (path, ln, p, sym))
+            continue
+        if not why:
+            errors.append("%s:%d: %s:%s has no reason" % (path, ln, p, sym))
+        entries[(p, sym)] = (cls, why, ln)
+    return entries, errors
+
+
+def guess(sym, tls, decl):
+    s = sym.split(".")[-1].lower()
+    if tls:
+        return "RESET", "thread-local: a recreated thread starts it afresh"
+    if re.search(r"(stat|hist|count|^n_|_n$|seen|warn|last_|log|dbg|diag|_ms$|_us$|max|sum|tmp|fired|total|"
+                 r"opened|nlog|sample|words|^s_st$)", s):
+        return "DIAG", "statistics / diagnostics"
+    if re.search(r"(cfg|config|env|inited|init|_on$|enabled|switch|freq|^k_)", s):
+        return "BOOT", "configuration, set at startup"
+    if re.search(r"(lk$|lock|_cv$|^s_cv|mutex|event|handle|ops$|_fn$|_cb$|hook|^s_host|^s_ppu$|_user$|dir)", s):
+        return "KEEP", "host object / hook"
+    return "SAVE", "guest-visible? (check)"
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("files", nargs="*")
+    ap.add_argument("--manifest", default=os.path.join("config", "ss_manifest.txt"))
+    ap.add_argument("--map", help="lld-link /MAP file: also check the data symbols it lists for these files")
+    ap.add_argument("--suggest", action="store_true", help="print the unclassified statics as manifest lines")
+    ap.add_argument("--list", action="store_true", help="print every static with its class")
+    ap.add_argument("--strict", action="store_true", help="a manifest entry whose static is gone is an error")
+    a = ap.parse_args()
+    root = os.path.dirname(os.path.dirname(os.path.abspath(a.manifest)))
+    entries, errors = read_manifest(a.manifest)
+    files = a.files or sorted({p for (p, _) in entries})
+    if not files:
+        print("ss_manifest_check: no files given and none in %s" % a.manifest, file=sys.stderr)
+        return 2
+    rels = []
+    for f in files:
+        full = f if os.path.isabs(f) else (f if os.path.exists(f) else os.path.join(root, f))
+        if not os.path.exists(full):
+            print("ss_manifest_check: %s: no such file" % f, file=sys.stderr)
+            return 2
+        rels.append((os.path.relpath(os.path.abspath(full), root).replace(os.sep, "/"), full))
+    mapped = {}
+    if a.map:
+        mapped = map_symbols(a.map, {os.path.basename(full) + ".obj" for (_, full) in rels})
+    unclassified = []
+    total = consts = 0
+    seen_keys = set()
+    for rel, full in rels:
+        found = scan_file(full)
+        syms = collections.OrderedDict()
+        for (name, ln, c, tls, scope) in found:
+            syms.setdefault(name, (ln, c, tls))
+        for extra in sorted(mapped.get(os.path.basename(full) + ".obj", ())):
+            if extra not in syms:
+                syms[extra] = (0, False, False)     # in the map only
+        n_file = n_ok = 0
+        for name, (ln, c, tls) in syms.items():
+            key = (rel, name)
+            seen_keys.add(key)
+            if c and key not in entries:
+                consts += 1
+                if a.list:
+                    print("  %s:%s CONST  (line %d)" % (rel, name, ln))
+                continue
+            total += 1
+            n_file += 1
+            if key in entries:
+                n_ok += 1
+                if a.list:
+                    print("  %s:%s %s  # %s" % (rel, name, entries[key][0], entries[key][1]))
+            else:
+                unclassified.append((rel, name, ln, tls))
+                if a.list:
+                    print("  %s:%s ????  (line %s%s)" % (rel, name, ln or "map", ", thread-local" if tls else ""))
+        print("%s: %d static(s), %d classified%s" % (rel, n_file, n_ok,
+                                                   "" if n_ok == n_file else ", %d NOT" % (n_file - n_ok)))
+    stale = [(p, s, v) for (p, s), v in entries.items() if any(p == r for r, _ in rels) and (p, s) not in seen_keys]
+    for (p, s, v) in stale:
+        print("%s:%d: stale: %s:%s (%s) is not a static of that file any more" % (a.manifest, v[2], p, s, v[0]))
+    for e in errors:
+        print(e)
+    if unclassified:
+        print("\n%d unclassified static(s)%s:" % (len(unclassified), "" if a.suggest else
+                                                  " (--suggest prints manifest lines)"))
+        for (rel, name, ln, tls) in unclassified:
+            if a.suggest:
+                cls, why = guess(name, tls, "")
+                print("%s:%s %s # %s%s" % (rel, name, cls, why, "" if ln else " (linker map only)"))
+            else:
+                print("  %s:%s  (line %s%s)" % (rel, name, ln or "map", ", thread-local" if tls else ""))
+    print("ss_manifest_check: %d static(s) in %d file(s), %d read-only, %d unclassified%s" % (
+        total, len(rels), consts, len(unclassified), ", %d stale" % len(stale) if stale else ""))
+    bad = bool(unclassified) or bool(errors) or (a.strict and bool(stale))
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/ss_selfresume.py b/tools/ss_selfresume.py
new file mode 100644
index 0000000..cb34da9
--- /dev/null
+++ b/tools/ss_selfresume.py
@@ -0,0 +1,195 @@
+#!/usr/bin/env python3
+"""Check a save-state P0 run (SS_SELFRESUME, runtime/savestate/ss_core.c +
+runtime/ppu/ppu_selfresume.cpp) and grow the continuation list from it.
+
+    py tools/ss_selfresume.py --log logs/run-X.log [--baseline logs/run-Y.log]
+        [--tid N] [--min-resumes N] [--min-armed-s S] [--skip-first-s S]
+        [--fps-ratio R] [--missing out.txt] [--off]
+
+--log          the run log (UTF-16 from run.ps1, or UTF-8)
+--off          the run had SS_SELFRESUME unset: PASS when the log carries no
+               save-state line at all ([ss], [ss-resume], [resume]) -- the
+               "unset = identical" check (compare fps with --baseline too)
+--tid          judge this thread's resumes (default: all threads together)
+--min-resumes  at least this many resumes (default 100)
+--min-armed-s  self-resume armed for at least this long: one periodic summary
+               is printed every 10 s (default 0)
+--baseline     the same route with SS_SELFRESUME unset: the median FPS_LOG
+               frame rate of this run (after --skip-first-s) must be at least
+               --fps-ratio (default 0.90) of the baseline's
+--missing      write the return addresses that had no continuation, in
+               --cont-list form: append to config/ss_cont_list.txt and relift
+
+PASS needs: armed; continuations registered; >= --min-resumes resumes;
+REFUSED = 0 (a chain WITH continuations that disagreed with the stack);
+context changed between park and root = 0; root host frame drift = 0; no
+"recursion cap", no FATAL, no WATCHDOG; the armed span; fps (with
+--baseline). Reported: skip reasons, latency, frame depths, per-thread
+resume counts, the missing / unmodelled return addresses, REFUSED chains.
+Exit status 0 = pass, 1 = fail, 2 = no data.
+"""
+import argparse
+import collections
+import re
+import sys
+
+
+def read_text(path):
+    data = open(path, "rb").read()
+    if data[:2] in (b"\xff\xfe", b"\xfe\xff") or data[1:2] == b"\x00":
+        return data.decode("utf-16", errors="replace")
+    return data.decode("utf-8", errors="replace")
+
+
+FPS = re.compile(r"\[fps\] ([\d.]+) draws=\d+ t=(\d+)s")
+RESUMED = re.compile(r"\[ss\] tid=(\d+) resumed frames=(\d+) at (\S+) ra=0x([0-9A-F]{8}) (\S+) icall=(-?\d+)"
+                     r" after ([\d.]+) ms \(#(\d+)\)")
+SUMMARY = re.compile(r"\[ss\] selfresume (periodic|exit): (.*)$")
+MISSING = re.compile(r"\[ss-resume\] missing 0x([0-9A-F]{8}) \(([^)]*)\) tid=(\d+)")
+UNMODELLED = re.compile(r"\[ss-resume\] unmodelled 0x([0-9A-F]{8}) \(([^)]*)\)")
+PER_TID = re.compile(r"\[ss\]\s+tid=(\d+) '([^']*)' requests=(\d+) resumed=(\d+)")
+
+
+def pct(v, p):
+    if not v:
+        return 0.0
+    s = sorted(v)
+    return s[min(len(s) - 1, int(round(p * (len(s) - 1))))]
+
+
+def fps_median(text, skip_s):
+    v = [float(m.group(1)) for m in FPS.finditer(text) if float(m.group(2)) >= skip_s]
+    return (pct(v, 0.5), len(v)) if v else (None, 0)
+
+
+def kv(s):
+    return dict((k, v) for k, v in re.findall(r"([A-Za-z-]+)=([\d.]+)", s))
+
+
+def main(argv):
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--log", required=True)
+    ap.add_argument("--baseline")
+    ap.add_argument("--off", action="store_true")
+    ap.add_argument("--tid", type=int, default=0)
+    ap.add_argument("--min-resumes", type=int, default=100)
+    ap.add_argument("--min-armed-s", type=float, default=0.0)
+    ap.add_argument("--skip-first-s", type=float, default=60.0)
+    ap.add_argument("--fps-ratio", type=float, default=0.90)
+    ap.add_argument("--missing")
+    a = ap.parse_args(argv)
+    text = read_text(a.log)
+    lines = text.splitlines()
+    verdict = []
+
+    if a.off:
+        ss = [l for l in lines if re.search(r"\[(ss|ss-resume|resume|resume-check)\]", l)]
+        verdict.append((not ss, f"no save-state line in the log ({len(ss)} found)"
+                                + (f": first {ss[0][:120]!r}" if ss else "")))
+    else:
+        armed = [l for l in lines if "[ss] self-resume armed" in l]
+        reg = [l for l in lines if re.search(r"\[ss\] self-resume: \d+ continuation", l)]
+        nreg = int(re.search(r"(\d+) continuation", reg[-1]).group(1)) if reg else 0
+        print(armed[0][armed[0].index("[ss]"):] if armed else "(no '[ss] self-resume armed' line)")
+        print(reg[-1][reg[-1].index("[ss]"):] if reg else "(no continuation count line)")
+        verdict.append((bool(armed), "SS_SELFRESUME armed"))
+        verdict.append((nreg > 0, f"continuations registered: {nreg}"))
+
+        per = collections.defaultdict(lambda: dict(n=0, frames=[], lat=[], ras=collections.Counter(),
+                                                  at=collections.Counter()))
+        for l in lines:
+            m = RESUMED.search(l)
+            if m:
+                t = int(m.group(1))
+                p = per[t]
+                p["n"] = max(p["n"], int(m.group(8)))
+                p["frames"].append(int(m.group(2)))
+                p["lat"].append(float(m.group(7)))
+                p["ras"][m.group(5)] += 1
+                p["at"][m.group(3)] += 1
+        sums = [m for m in (SUMMARY.search(l) for l in lines) if m]
+        last = kv(sums[-1].group(2)) if sums else {}
+        nper = sum(1 for m in sums if m.group(1) == "periodic")
+        print(f"\nsummaries: {len(sums)} ({nper} periodic, ~{nper * 10} s armed)")
+        if sums:
+            print("last: [ss] selfresume " + sums[-1].group(1) + ": " + sums[-1].group(2))
+        exit_tid = {}
+        for l in lines:
+            m = PER_TID.search(l)
+            if m:
+                exit_tid[int(m.group(1))] = (m.group(2), int(m.group(3)), int(m.group(4)))
+        print("\nresumes per thread (from the resume lines; 'requests' from the exit summary when present):")
+        for t in sorted(set(per) | set(exit_tid)):
+            p = per[t]
+            nm, rq, rs = exit_tid.get(t, ("", 0, 0))
+            n = max(p["n"], rs)
+            fr = p["frames"]
+            print(f"  tid={t:<3} {nm:<16} resumed={n:<6} {'requests=' + str(rq) if t in exit_tid else ''}"
+                  f" frames avg={sum(fr) / len(fr) if fr else 0:.1f} max={max(fr) if fr else 0}"
+                  f" latency p50={pct(p['lat'], .5):.1f} max={max(p['lat']) if p['lat'] else 0:.1f} ms"
+                  f" top ra: {', '.join(f'{k} x{v}' for k, v in p['ras'].most_common(3))}")
+        total = int(last.get("resumed", 0)) if last else sum(p["n"] for p in per.values())
+        total = max(total, sum(p["n"] for p in per.values()))
+        got = per[a.tid]["n"] if a.tid else total
+        if a.tid and a.tid in exit_tid:
+            got = max(got, exit_tid[a.tid][2])
+        who = f"tid {a.tid}" if a.tid else "all threads"
+        verdict.append((got >= a.min_resumes, f"resumes ({who}): {got} (need >= {a.min_resumes})"))
+        refused = int(last.get("REFUSED", 0))
+        verdict.append((refused == 0, f"REFUSED (a chain with continuations that disagreed with the stack): {refused}"))
+        verdict.append((int(last.get("ctx-changed", 0)) == 0,
+                        f"context changed between park and root: {last.get('ctx-changed', '0')}"))
+        verdict.append((int(last.get("host-sp-drift", 0)) == 0,
+                        f"root host frame drift: {last.get('host-sp-drift', '0')} bytes"))
+        if a.min_armed_s:
+            verdict.append((nper * 10 >= a.min_armed_s,
+                            f"armed span ~{nper * 10} s (need >= {a.min_armed_s:.0f} s)"))
+        print("\nskips (last summary): " + ", ".join(f"{k}={last.get(k, '0')}" for k in
+              ("not-covered", "no-ra", "callback", "trampoline", "bridge", "no-root", "no-ops", "overdue")))
+        miss = collections.OrderedDict()
+        for l in lines:
+            m = MISSING.search(l)
+            if m:
+                miss.setdefault(m.group(1), (m.group(2), m.group(3)))
+        unm = sorted(set(m.group(1) + " " + m.group(2) for m in (UNMODELLED.search(l) for l in lines) if m))
+        ref = [l[l.index("[ss-resume]"):] for l in lines if "[ss-resume] REFUSED" in l]
+        print(f"missing return addresses: {len(miss)} distinct; unmodelled: {len(unm)}; REFUSED chains logged: {len(ref)}")
+        for r in ref[:20]:
+            print("  " + r[:400])
+        for u in unm[:10]:
+            print("  unmodelled " + u)
+        if a.missing:
+            with open(a.missing, "w", newline="\n") as f:
+                f.write(f"# from SS_SELFRESUME ({a.log}): return addresses with no continuation\n")
+                for ra, (nm, tid) in miss.items():
+                    f.write(f"0x{ra}   # {nm} tid={tid}\n")
+            print(f"  written to {a.missing} (append to config/ss_cont_list.txt, relift, rebuild)")
+    bad_lines = collections.Counter()
+    for l in lines:
+        for k in ("recursion cap", "[resume] FATAL", "[ss] FATAL", "[ss] WATCHDOG", "[ppu] FATAL"):
+            if k in l:
+                bad_lines[k] += 1
+    for k in ("recursion cap", "[resume] FATAL", "[ss] FATAL", "[ss] WATCHDOG", "[ppu] FATAL"):
+        verdict.append((bad_lines[k] == 0, f"no '{k}' line ({bad_lines[k]})"))
+    exitln = [l for l in lines if "[checkpoint] exiting" in l]
+    if exitln:
+        print("\n" + exitln[-1][exitln[-1].index("[checkpoint]"):])
+    if a.baseline:
+        f_run, n_run = fps_median(text, a.skip_first_s)
+        f_base, n_base = fps_median(read_text(a.baseline), a.skip_first_s)
+        if f_run is None or f_base is None:
+            verdict.append((False, "fps comparison: FPS_LOG=1 lines missing in the run or the baseline"))
+        else:
+            r = f_run / f_base if f_base else 0.0
+            verdict.append((r >= a.fps_ratio, f"fps within noise: median {f_run:.2f} ({n_run} s) vs baseline"
+                            f" {f_base:.2f} ({n_base} s) = {100.0 * r:.1f}% (need >= {100.0 * a.fps_ratio:.0f}%)"))
+    print()
+    for ok, what in verdict:
+        print(("PASS " if ok else "FAIL ") + what)
+    ok = all(v for v, _ in verdict)
+    print("\nVERDICT: " + ("PASS" if ok else "FAIL"))
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/tools/test_find_spu_functions_getter.py b/tools/test_find_spu_functions_getter.py
new file mode 100644
index 0000000..48c5387
--- /dev/null
+++ b/tools/test_find_spu_functions_getter.py
@@ -0,0 +1,66 @@
+"""find_spu_functions.collect_duff_targets: computed branches through a PC-getter
+(`brsl $rX, .+4` [+ `ai $rX, $rX, K`]) -- the unconditional `bi` (Duff ladder)
+and the conditional forms (biz/binz/bihz/bihnz: seed link+K only).
+
+Synthetic code assembled from the ISA encodings below.
+
+    python -m unittest test_find_spu_functions_getter
+"""
+import os
+import sys
+import unittest
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from find_spu_functions import collect_duff_targets  # noqa: E402
+from spu_disasm import disassemble_spu  # noqa: E402
+
+BASE = 0x1000
+
+
+def brsl(rt, words):            # RI16, op9 0x066
+    return (0x066 << 23) | ((words & 0xFFFF) << 7) | rt
+
+
+def ai(rt, ra, imm):            # RI10, op8 0x1C
+    return (0x1C << 24) | ((imm & 0x3FF) << 14) | (ra << 7) | rt
+
+
+def bi_family(op11, cond, ra, e=False):   # RR: bi 0x1A8 / biz 0x128 / binz 0x129 / bihz 0x12A / bihnz 0x12B
+    return (op11 << 21) | ((1 << 18) if e else 0) | (ra << 7) | cond
+
+
+NOP = (0x201 << 21) | 0x7F      # nop $r127
+RET = bi_family(0x1A8, 0, 0)    # bi $r0
+
+
+def lift_targets(words):
+    code = b"".join(w.to_bytes(4, "big") for w in words)
+    insns = disassemble_spu(code, BASE)
+    return collect_duff_targets(insns, BASE, BASE + len(code))
+
+
+class GetterBranchTargets(unittest.TestCase):
+    def test_conditional_interrupt_window(self):
+        # 0x1004: brsl $r5,.+4 / ai $r5,$r5,8 / bihze $r7,$r5 / 0x1010: ...
+        words = [NOP, brsl(5, 1), ai(5, 5, 8), bi_family(0x12A, 7, 5, e=True),
+                 NOP, NOP, RET]
+        self.assertEqual(lift_targets(words), {0x1010})
+
+    def test_every_conditional_form(self):
+        for op in (0x128, 0x129, 0x12A, 0x12B):
+            words = [brsl(9, 1), ai(9, 9, 12), NOP, bi_family(op, 3, 9), NOP, NOP, RET]
+            self.assertEqual(lift_targets(words), {0x1010}, hex(op))
+
+    def test_conditional_return_is_not_seeded(self):
+        words = [brsl(9, 1), ai(9, 9, 8), bi_family(0x128, 3, 0), NOP, RET]
+        self.assertEqual(lift_targets(words), set())
+
+    def test_unconditional_keeps_the_ladder(self):
+        words = [brsl(8, 1), ai(8, 8, 8), bi_family(0x1A8, 0, 8)] + [NOP] * 20 + [RET]
+        t = lift_targets(words)
+        self.assertIn(0x100C, t)
+        self.assertIn(0x100C + 64, t)
+
+
+if __name__ == "__main__":
+    unittest.main()
