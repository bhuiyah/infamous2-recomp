+    CHECK(!res.ok && res.reason == SS_REASON_NOT_YET && res.eligible_ms >= 0, "hold: %s", ss_reason_name(res.reason));
+    {
+        /* loads: the racing one (8), the busy table (11), 12b, 12c */
+        ss_request_stats rs; ss_get_request_stats(SS_P_LOAD, &rs);
+        CHECK(rs.done == 4 && rs.not_yet == 3 && rs.refused == 1 && rs.by_reason[SS_REASON_TRANSITION] == 1,
