+    map_of(&d, m, sizeof m);
+    CHECK_STR(m, "Cross=b2 Circle=b3 Square=b1 Triangle=b4 L1=b5 R1=b6 L2=a2+/b7 R2=a2-/b8 "
+                 "Start=b10 Select=b9 Dpad=h0 LX=a0 LY=a1 RX=a3 RY=a4");
+    memset(&st, 0, sizeof st);
+    set_raw(GEN_PAGE_GD, 0x30, 32767); set_raw(GEN_PAGE_GD, 0x31, 32768);
+    set_raw(GEN_PAGE_GD, 0x33, 65535); set_raw(GEN_PAGE_GD, 0x34, 0);
+    set_raw(GEN_PAGE_GD, 0x32, 65535);          /* LT fully: Z up */
+    set_raw(GEN_PAGE_GD, 0x39, 0);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 128); CHECK_EQ(st.ly, 128); CHECK_EQ(st.rx, 255); CHECK_EQ(st.ry, 0);
+    CHECK_EQ(st.press[10], 255); CHECK_EQ(st.press[11], 0);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_L2);
+    set_raw(GEN_PAGE_GD, 0x32, 0);              /* RT fully */
+    set_raw(GEN_PAGE_GD, 0x39, 3);              /* 1..8: 3 = right */
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.press[10], 0); CHECK_EQ(st.press[11], 255);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_R2 | CELL_PAD_CTRL_RIGHT);
+    set_raw(GEN_PAGE_GD, 0x32, 32767);          /* both released */
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.press[10], 0); CHECK_EQ(st.press[11], 0);
+    set_raw(GEN_PAGE_GD, 0x32, 32767 + 16384);  /* LT half */
+    parse_id(&d, 0, &st);
+    CHECK(st.press[10] >= 126 && st.press[10] <= 129);
+}
