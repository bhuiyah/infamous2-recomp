+static void test_dds(void)
+{
+    static const uint32_t fmts[] = { TP_DXGI_R8G8B8A8_UNORM, TP_DXGI_BC1_UNORM, TP_DXGI_BC2_UNORM, TP_DXGI_BC3_UNORM, TP_DXGI_BC7_UNORM,
+                                     TP_DXGI_BC4_UNORM, TP_DXGI_BC5_UNORM, TP_DXGI_BC5_SNORM, TP_DXGI_R8_UNORM, TP_DXGI_R8G8_UNORM,
+                                     TP_DXGI_R8G8_SNORM, TP_DXGI_R16_UNORM, TP_DXGI_R16G16_UNORM, TP_DXGI_R16G16_FLOAT,
+                                     TP_DXGI_R16G16B16A16_FLOAT, TP_DXGI_R32_FLOAT, TP_DXGI_R32G32B32A32_FLOAT, TP_DXGI_B8G8R8A8_UNORM,
+                                     TP_DXGI_BC7_UNORM_SRGB };
+    uint8_t* samples[8] = {0}; size_t sample_n[8]; int ns = 0;
+    for (size_t i = 0; i < sizeof fmts / sizeof fmts[0]; i++)
+        for (int cube = 0; cube < 2; cube++) {
+            const uint32_t w = 64, h = cube ? 64 : 32, lv = 4;
+            uint8_t hd[148];
+            const size_t hn = tp_dds_header(hd, fmts[i], w, h, lv, cube);
+            uint64_t data = 0;
+            for (uint32_t m = 0; m < lv; m++) data += tp_dxgi_level_bytes(fmts[i], (w >> m) ? w >> m : 1, (h >> m) ? h >> m : 1, NULL, NULL);
+            data *= cube ? 6u : 1u;
+            const size_t n = hn + (size_t)data;
+            uint8_t* f = (uint8_t*)malloc(n);
+            memcpy(f, hd, hn); fill(f + hn, (size_t)data);
+            tp_dds_info di;
+            const int r = tp_dds_parse(f, n, &di);
+            if (r) printf("  dds %u cube %d: %s\n", fmts[i], cube, di.err);
+            CHECK(r == 0 && di.dxgi == fmts[i] && di.w == w && di.h == h && di.levels == lv && di.faces == (cube ? 6u : 1u));
+            CHECK(r == 0 && di.data_bytes == data && di.off[0] == hn);
+            CHECK(tp_dds_parse(f, n - 1, &di) != 0);                     /* one byte short */
+            if (ns < 8 && (cube || i % 3 == 0)) { samples[ns] = f; sample_n[ns] = n; ns++; } else free(f);
+        }
+    /* inconsistent headers */
+    { uint8_t hd[148]; tp_dds_header(hd, TP_DXGI_BC1_UNORM, 64, 64, 1, 0); tp_dds_info di;
+      uint8_t* f = (uint8_t*)calloc(1, 148 + 4096); memcpy(f, hd, 128);
+      tp_wr32le(f + 4 + 8, 0); CHECK(tp_dds_parse(f, 128 + 2048, &di) != 0);                        /* height 0 */
+      tp_wr32le(f + 4 + 8, 40000); CHECK(tp_dds_parse(f, 128 + 2048, &di) != 0);                    /* too tall */
+      tp_wr32le(f + 4 + 8, 64); tp_wr32le(f + 4 + 24, 9); CHECK(tp_dds_parse(f, 128 + 4096, &di) != 0);   /* 9 levels at 64 */
+      tp_wr32le(f + 4 + 24, 1); tp_wr32le(f + 4 + 8, 16384); tp_wr32le(f + 4 + 12, 16384);
+      CHECK(tp_dds_parse(f, 128 + 4096, &di) != 0);                                                 /* 128 MB of blocks in 4 KB */
+      tp_wr32le(f + 4 + 8, 64); tp_wr32le(f + 4 + 12, 64); tp_wr32le(f + 4 + 20, 4);
+      CHECK(tp_dds_parse(f, 128 + 4096, &di) != 0);                                                 /* volume */
+      memcpy(f, "DDX ", 4); CHECK(tp_dds_parse(f, 128 + 4096, &di) != 0);
+      free(f); }
+    { uint8_t hd[148]; tp_dds_header(hd, TP_DXGI_R16_UNORM, 64, 64, 1, 0); tp_dds_info di;   /* DX10 array of 2 */
+      uint8_t* f = (uint8_t*)calloc(1, 148 + 65536); memcpy(f, hd, 148);
+      tp_wr32le(f + 128 + 12, 2); CHECK(tp_dds_parse(f, 148 + 65536, &di) != 0);
+      tp_wr32le(f + 128 + 12, 1); tp_wr32le(f + 128 + 4, 4); CHECK(tp_dds_parse(f, 148 + 65536, &di) != 0);   /* 3D */
+      tp_wr32le(f + 128 + 4, 3); tp_wr32le(f + 128, 999); CHECK(tp_dds_parse(f, 148 + 65536, &di) != 0);    /* bad dxgi */
+      free(f); }
+    /* random mutations: parse never reads past the file (guard page) and never
+     * describes a level outside it */
+    int ok = 0, rejected = 0;
+    for (int it = 0; it < 200000 && ns; it++) {
+        const int k = it % ns;
+        const size_t n = sample_n[k] > 65536 ? 65536 : sample_n[k];
+        size_t cut = (rnd() & 3u) == 0 ? (size_t)(rnd() % (uint32_t)n) : n;
+        uint8_t* g = guard_buf(cut);
+        if (!g) continue;
+        memcpy(g, samples[k], cut);
+        const int muts = 1 + (int)(rnd() % 6u);
+        for (int m = 0; m < muts && cut; m++) {
+            const size_t at = (rnd() & 1u) ? rnd() % (cut < 148 ? (uint32_t)cut : 148u) : rnd() % (uint32_t)cut;
+            g[at] = (rnd() & 3u) ? (uint8_t)rnd() : (uint8_t)((rnd() & 1u) ? 0xFF : 0);
+        }
+        tp_dds_info di;
+        if (tp_dds_parse(g, cut, &di) == 0) {
+            ok++;
+            const uint64_t last = di.off[di.faces * di.levels - 1];
+            const uint32_t lm = di.levels - 1;
+            const uint64_t lb = tp_dxgi_level_bytes(di.dxgi, (di.w >> lm) ? di.w >> lm : 1, (di.h >> lm) ? di.h >> lm : 1, NULL, NULL);
+            CHECK(last + lb <= cut);
+        } else rejected++;
+    }
+    printf("dds: 200000 mutated files: %d parsed in bounds, %d rejected, no read past the end\n", ok, rejected);
+    for (int i = 0; i < ns; i++) free(samples[i]);
+}
