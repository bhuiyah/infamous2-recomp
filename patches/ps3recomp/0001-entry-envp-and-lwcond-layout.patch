+/* ---------------------------------------------------------------------------
+ * Save states: sys_memory's records of the KMEM section (M4b; engine design
+ * 5.2, 6.2). The section is ppu_sysprx.cpp's -- it gathers the guest address
+ * space's allocators from four files -- and calls sys_memory_ss_capture with
+ * every guest thread parked. The pages themselves are GMEM's; what comes back
+ * from here is the bookkeeping that hands out the next ones and answers the
+ * queries about the old ones:
+ *   allocations  every live sys_memory_allocate block, keyed by its slot
+ *   containers   every live container, keyed by its id (slot + 1)
+ *   shared       every live mmapper shared block, keyed by its id
+ *   sys_memory   the bump pointer and the total the guest has been handed
+ *                (get_user_memory_size reports what is left of it)
+ * The lists are exported for the section's layout hash.
+ * -----------------------------------------------------------------------*/
+static const ss_field k_ss_alloc_fields[] = {
+    SS_MEMBER(sys_mem_alloc_info, addr), SS_MEMBER(sys_mem_alloc_info, size),
+    SS_MEMBER(sys_mem_alloc_info, container_id), SS_MEMBER(sys_mem_alloc_info, page_size),
+};
+const ss_list g_ss_list_kmem_allocs = SS_LIST("allocations", k_ss_alloc_fields);
+static const ss_field k_ss_container_fields[] = {
+    SS_MEMBER(sys_mem_container_info, total_size), SS_MEMBER(sys_mem_container_info, used_size),
+};
+const ss_list g_ss_list_kmem_containers = SS_LIST("containers", k_ss_container_fields);
+static const ss_field k_ss_shared_fields[] = {
+    SS_MEMBER(sys_mmapper_shared_info, size), SS_MEMBER(sys_mmapper_shared_info, addr),
+    SS_MEMBER(sys_mmapper_shared_info, key),
+};
+const ss_list g_ss_list_kmem_shared = SS_LIST("shared", k_ss_shared_fields);
+static const ss_field k_ss_sysmem_fields[] = {
+    SS_FIELD(g_sys_mem_bump_ptr), SS_FIELD(s_total_allocated),
+};
+const ss_list g_ss_list_kmem_sysmem = SS_LIST("sys_memory", k_ss_sysmem_fields);
+
+/* Everything parked: plain reads of the tables (the bump lock is free -- an
+ * allocation holds it only around its own bookkeeping, with no park point). */
+int sys_memory_ss_capture(ss_writer* w)
+{
+    ss_recs_begin(w, &g_ss_list_kmem_allocs);
+    for (int i = 0; i < SYS_MEMORY_ALLOC_MAX; i++)
+        if (g_sys_mem_allocs[i].active) ss_recs_add(w, (uint32_t)i, &g_sys_mem_allocs[i]);
+    ss_recs_end(w);
+    ss_recs_begin(w, &g_ss_list_kmem_containers);
+    for (int i = 0; i < SYS_MEMORY_CONTAINER_MAX; i++)
+        if (g_sys_mem_containers[i].active) ss_recs_add(w, (uint32_t)i + 1, &g_sys_mem_containers[i]);
+    ss_recs_end(w);
+    ss_recs_begin(w, &g_ss_list_kmem_shared);
+    for (int i = 0; i < SYS_MMAPPER_SHARED_MAX; i++)
+        if (g_sys_mmapper_shared[i].active) ss_recs_add(w, (uint32_t)i + 1, &g_sys_mmapper_shared[i]);
+    ss_recs_end(w);
+    ss_write_fields(w, &g_ss_list_kmem_sysmem);
+    return ss_writer_error(w);
+}
+
+/* The load (M4c; KMEM's restore and check_image, ppu_sysprx.cpp): the tables
+ * as the image has them -- every slot it does not list free, every listed
+ * one at its key -- and the bump pointer with the total handed out. No host
+ * object is involved (the pages are MAPS / GMEM's), so there is no teardown;
+ * the restore replaces the whole tables. Every guest thread is gone, so the
+ * bump lock is free and not needed. apply 0 checks the keys only (the world
+ * running; the statics record needs no check beyond its layout). */
+int sys_memory_ss_restore(ss_reader* r, int apply)
+{
+    uint32_t seen[(SYS_MEMORY_ALLOC_MAX + 31) / 32];
+    ss_recs_it it;
+    uint32_t key;
+    int k, e;
+    memset(seen, 0, sizeof seen);
+    if (apply) {
+        memset(g_sys_mem_allocs,     0, sizeof(g_sys_mem_allocs));
+        memset(g_sys_mem_containers, 0, sizeof(g_sys_mem_containers));
+        memset(g_sys_mmapper_shared, 0, sizeof(g_sys_mmapper_shared));
+    }
+    if ((e = ss_recs_open(r, &g_ss_list_kmem_allocs, &it)) != 0) return e;
+    for (;;) {
+        sys_mem_alloc_info t;
+        memset(&t, 0, sizeof t);
+        if ((k = ss_recs_next(&it, &key, &t)) != 1) break;
+        if (key >= SYS_MEMORY_ALLOC_MAX)                  /* (keyed by slot, from 0) */
+            return ss_reader_fail(r, SS_E_CORRUPT, "allocations[%u]: no such slot", key);
+        if (seen[key >> 5] & (1u << (key & 31u)))
+            return ss_reader_fail(r, SS_E_CORRUPT, "allocations[%u]: listed twice", key);
+        seen[key >> 5] |= 1u << (key & 31u);
+        if (!apply) continue;
+        t.active = 1;
+        g_sys_mem_allocs[key] = t;
+    }
+    if (k < 0) return k;
+    memset(seen, 0, sizeof seen);
+    if ((e = ss_recs_open(r, &g_ss_list_kmem_containers, &it)) != 0) return e;
+    for (;;) {
+        sys_mem_container_info t;
+        memset(&t, 0, sizeof t);
+        if ((k = ss_recs_next(&it, &key, &t)) != 1) break;
+        if (key < 1 || key > SYS_MEMORY_CONTAINER_MAX)
+            return ss_reader_fail(r, SS_E_CORRUPT, "containers[%u]: no such container id", key);
+        if (seen[(key - 1) >> 5] & (1u << ((key - 1) & 31u)))
+            return ss_reader_fail(r, SS_E_CORRUPT, "containers[%u]: listed twice", key);
+        seen[(key - 1) >> 5] |= 1u << ((key - 1) & 31u);
+        if (!apply) continue;
+        t.active = 1;
+        g_sys_mem_containers[key - 1] = t;
+    }
+    if (k < 0) return k;
+    memset(seen, 0, sizeof seen);
+    if ((e = ss_recs_open(r, &g_ss_list_kmem_shared, &it)) != 0) return e;
+    for (;;) {
+        sys_mmapper_shared_info t;
+        memset(&t, 0, sizeof t);
+        if ((k = ss_recs_next(&it, &key, &t)) != 1) break;
+        if (key < 1 || key > SYS_MMAPPER_SHARED_MAX)
+            return ss_reader_fail(r, SS_E_CORRUPT, "shared[%u]: no such shared block id", key);
+        if (seen[(key - 1) >> 5] & (1u << ((key - 1) & 31u)))
+            return ss_reader_fail(r, SS_E_CORRUPT, "shared[%u]: listed twice", key);
+        seen[(key - 1) >> 5] |= 1u << ((key - 1) & 31u);
+        if (!apply) continue;
+        t.active = 1;
+        g_sys_mmapper_shared[key - 1] = t;
+    }
+    if (k < 0) return k;
+    return apply ? ss_read_fields(r, &g_ss_list_kmem_sysmem) : SS_OK;
+}
