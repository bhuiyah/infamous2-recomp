 }
 
+/* ===========================================================================
+ * A save-state load's resume (spu_channels_ss_resume)
+ *
+ * A load restores a context exactly as it was captured, reservation and all,
+ * but not the notify registry that would tell it of a write to its line. So
+ * just before its thread resumes the reservation is dropped the way a peer's
+ * write drops one: the SPU resumes holding SPU_EVENT_LR -- whatever its event
+ * mask, as the notify raises it -- and no reservation, its PUTLLC fails and
+ * writes nothing, and its next GETLLAR reserves the line again and is in the
+ * registry, so a peer's write reaches it: the loop a parked SPURS kernel runs.
+ * ===========================================================================*/
+static void test_load_resume_drops_reservation(void)
+{
+    reset_pair();
+    spu_atomic(&g_a, LSA_A, LINE_A, MFC_GETLLAR_CMD);
+    CHECK(g_a.resv_valid == 1);
+    spu_coh_unregister(&g_a);              /* restored: not in the registry */
+
+    TEST("a load's resume drops the reservation and raises SPU_EVENT_LR, mask or not");
+    CHECK_EQ_U32(g_a.event_mask, 0);
+    spu_channels_ss_resume(&g_a);
+    CHECK(g_a.resv_valid == 0);
+    CHECK_EQ_U32(g_a.event_status, SPU_EVENT_LR);
+
+    TEST("...so its PUTLLC fails and writes nothing");
+    stage(&g_a, LSA_A, 0xA0, 128);
+    spu_atomic(&g_a, LSA_A, LINE_A, MFC_PUTLLC_CMD);
+    CHECK_EQ_U32(g_a.atomic_stat, 1);
+    { int zero = 1;
+      for (uint32_t i = 0; i < 128; i++) zero &= g_guest_mem[LINE_A + i] == 0;
+      CHECK(zero); }
+
+    TEST("...and its next GETLLAR reserves the line again, where a peer's write reaches it");
+    spu_atomic(&g_a, LSA_A, LINE_A, MFC_GETLLAR_CMD);
+    CHECK(g_a.resv_valid == 1);
+    g_a.event_status = 0;
+    stage(&g_b, LSA_B, 0xB0, 128);
+    spu_put(&g_b, LSA_B, LINE_A, 128);
+    CHECK_EQ_U32(g_a.event_status & SPU_EVENT_LR, SPU_EVENT_LR);
+    CHECK(g_a.resv_valid == 0);
+
+    TEST("a resume with no reservation raises nothing");
+    reset_ctx(&g_a, 0);
+    spu_channels_ss_resume(&g_a);
+    CHECK_EQ_U32(g_a.event_status, 0);
+    CHECK(g_a.resv_valid == 0);
+}
+
 /* ===========================================================================
  * main
  * ===========================================================================*/
@@ -427,6 +479,7 @@ int main(void)
     test_plain_put_elsewhere_is_quiet();
     test_wide_put_finds_the_reserved_line();
