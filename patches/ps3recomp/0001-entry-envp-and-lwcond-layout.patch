+/* ---------------------------------------------------------------------------
+ * child processes: exit paths and environment precedence
+ * -----------------------------------------------------------------------*/
+
+static int child_exit(const char* marker, const char* mode)
+{
+    snprintf(s_marker, sizeof s_marker, "%s", marker);
+    s_main_tid = GetCurrentThreadId();
+    padhost_config_set("controllers", "0");
+    padhost_init();
+    int a = attach("X", 0, 0);
+    unsigned char last[4];
+    padhost_set_actuator(padhost_virtual_port(a), 1, 255);
+    wait_outputs(a, 2, 1000, last);
+    if (!strcmp(mode, "exitprocess")) ExitProcess(0);       /* the window close button's path */
+    exit(0);                                                /* atexit path */
+}
+
+/* --hw: a driver for the real DualSense that only READS (feature 0x20, the
+ * firmware info) and never writes: close() reads the feature again and records
+ * which thread it ran on and what it got, so the exit paths are checked with a
+ * real HID handle whose reader thread was killed mid-read. */
+static int  run_child(const char* args, const char* env_block, DWORD* code);
+static void read_marker(const char* path, char* out, int n);
+static volatile LONG s_hw_reports;
+static int hw_match(const PadHostDevice* d) { return d->vid == 0x054C && d->pid == 0x0CE6 ? 1000 : 0; }
+static int hw_open(PadHostDevice* d)
+{
+    unsigned char f[64] = { 0x20 };
+    return padhost_dev_get_feature(d, f, 64) == 64 ? 0 : -1;
+}
+static int hw_parse(PadHostDevice* d, const unsigned char* rep, int len, PadHostPortState* st)
+{
+    (void)d; (void)rep; (void)len; (void)st;
+    InterlockedIncrement(&s_hw_reports);
+    return 1;
+}
+static int hw_build(PadHostDevice* d, u8 s, u8 l, int port, unsigned char* out, int cap)
+{
+    (void)d; (void)s; (void)l; (void)port; (void)out; (void)cap;
+    return 0;                      /* never an output report */
+}
+static void hw_close(PadHostDevice* d)
+{
+    unsigned char f[64] = { 0x20 };
+    int n = padhost_dev_get_feature(d, f, 64);
+    HANDLE h = CreateFileA(s_marker, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+    if (h != INVALID_HANDLE_VALUE) {
+        char what[64];
+        DWORD w;
+        snprintf(what, sizeof what, "%s:%d", GetCurrentThreadId() == s_main_tid ? "close:caller" : "close:device", n);
+        WriteFile(h, what, (DWORD)strlen(what), &w, NULL);
+        CloseHandle(h);
+    }
+}
+static const PadHostDriver hw_drv = { "hw-readonly", PADHOST_KIND_GENERIC, hw_match, hw_open, hw_parse, hw_build, hw_close };
+
+static int child_hw(const char* marker, const char* mode)
+{
+    snprintf(s_marker, sizeof s_marker, "%s", marker);
+    s_main_tid = GetCurrentThreadId();
+    padhost_config_set("backends", "generic");     /* no XInput, only drivers of kind generic: ours */
+    padhost_register_driver(&hw_drv);
+    padhost_init();
+    PadHostPortState st;
+    ULONGLONG end = GetTickCount64() + 3000;
+    while ((!padhost_get(0, &st) || s_hw_reports < 20) && GetTickCount64() < end) Sleep(5);
+    if (!padhost_get(0, &st)) return 4;
+    if (!strcmp(mode, "exitprocess")) ExitProcess(0);
+    exit(0);
+}
+
+static void test_hw(void)
+{
+    printf("-- exit paths with the real DualSense (read-only driver)\n");
+    char marker[MAX_PATH], got[64], args[MAX_PATH + 64];
+    GetTempPathA(MAX_PATH, marker);
+    strncat(marker, "padhost_hw_marker.txt", MAX_PATH - strlen(marker) - 1);
+    const char* modes[2] = { "exitprocess", "exit" };
+    const char* want[2] = { "close:caller:64", "close:device:64" };
+    for (int i = 0; i < 2; i++) {
+        DWORD code = 0;
+        DeleteFileA(marker);
+        snprintf(args, sizeof args, "--hw-child \"%s\" %s", marker, modes[i]);
+        int r = run_child(args, NULL, &code);
+        read_marker(marker, got, sizeof got);
+        if (code == 4) { printf("    no DualSense on port 0: skipped\n"); return; }
+        CHECK(r == 0 && !strcmp(got, want[i]), "%s: close() did HID I/O (%s, want %s)", modes[i], got, want[i]);
+    }
+    DeleteFileA(marker);
+}
+
+static int child_env(void)
+{
+    /* PAD_DEADZONE=0, PAD_PREFER_PHYSICAL=0 and PAD_HOST="rumble=50|backends=ds4" set by the parent */
+    padhost_config_set("controllers", "0");
+    int ok = 1;
+    ok &= padhost_config_set("deadzone", "50") == 1;         /* accepted ... */
+    ok &= s_cfg.dz_left == 0;                                /* ... but the environment wins */
+    ok &= s_cfg.rumble_pct == 50;
+    ok &= padhost_config_parse_text("[controller]\nrumble=100\n", 0, NULL) == 0 && s_cfg.rumble_pct == 50;
+    ok &= (s_cfg.backends & (1L << PADHOST_KIND_DS4)) && !(s_cfg.backends & (1L << PADHOST_KIND_XINPUT));
+    ok &= padhost_config_set("prefer_physical", "1") == 1 && s_cfg.prefer_physical == 0;
+    printf("child env: dz %ld rumble %ld backends %lx prefer_physical %ld -> %s\n", s_cfg.dz_left, s_cfg.rumble_pct,
+           s_cfg.backends, s_cfg.prefer_physical, ok ? "ok" : "WRONG");
+    return ok ? 0 : 3;
+}
+
+static int run_child(const char* args, const char* env_block, DWORD* code)
+{
+    char exe[MAX_PATH], cmd[MAX_PATH * 2];
+    GetModuleFileNameA(NULL, exe, MAX_PATH);
+    snprintf(cmd, sizeof cmd, "\"%s\" %s", exe, args);
+    STARTUPINFOA si;
+    PROCESS_INFORMATION pi;
+    memset(&si, 0, sizeof si);
+    si.cb = sizeof si;
+    if (!CreateProcessA(NULL, cmd, NULL, NULL, FALSE, 0, (LPVOID)(uintptr_t)env_block, NULL, &si, &pi)) return -1;
+    DWORD w = WaitForSingleObject(pi.hProcess, 15000);
+    GetExitCodeProcess(pi.hProcess, code);
+    CloseHandle(pi.hProcess);
+    CloseHandle(pi.hThread);
+    return w == WAIT_OBJECT_0 ? 0 : -1;
+}
+
+static void read_marker(const char* path, char* out, int n)
+{
+    out[0] = 0;
+    HANDLE h = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (h == INVALID_HANDLE_VALUE) return;
+    DWORD r = 0;
+    ReadFile(h, out, (DWORD)n - 1, &r, NULL);
+    out[r] = 0;
+    CloseHandle(h);
+}
+
+static void test_children(void)
+{
+    printf("-- exit paths (child processes)\n");
+    char marker[MAX_PATH], got[64], args[MAX_PATH + 64];
+    GetTempPathA(MAX_PATH, marker);
+    strncat(marker, "padhost_exit_marker.txt", MAX_PATH - strlen(marker) - 1);
+    DWORD code = 0;
+
+    DeleteFileA(marker);
+    snprintf(args, sizeof args, "--exit-child \"%s\" exitprocess", marker);
+    int r = run_child(args, NULL, &code);
+    read_marker(marker, got, sizeof got);
+    CHECK(r == 0 && !strcmp(got, "close:caller"), "ExitProcess with a rumbling pad: close() from the TLS callback (%s)", got);
+
+    DeleteFileA(marker);
+    snprintf(args, sizeof args, "--exit-child \"%s\" exit", marker);
+    r = run_child(args, NULL, &code);
+    read_marker(marker, got, sizeof got);
+    CHECK(r == 0 && !strcmp(got, "close:device"), "exit(): atexit shutdown, close() on the device thread (%s)", got);
+    DeleteFileA(marker);
+
+    /* environment block for the precedence test */
+    char env[4096];
+    size_t o = 0;
+    const char* add[] = { "PAD_DEADZONE=0", "PAD_HOST=rumble=50|backends=ds4", "PAD_PREFER_PHYSICAL=0" };
+    LPCH cur = GetEnvironmentStringsA();
+    for (LPCH s = cur; *s; s += strlen(s) + 1) {
+        if (!_strnicmp(s, "PAD_", 4)) continue;
+        size_t l = strlen(s) + 1;
+        if (o + l + 200 > sizeof env) break;
+        memcpy(env + o, s, l);
+        o += l;
+    }
+    FreeEnvironmentStringsA(cur);
+    for (unsigned i = 0; i < sizeof add / sizeof add[0]; i++) { size_t l = strlen(add[i]) + 1; memcpy(env + o, add[i], l); o += l; }
+    env[o] = 0;
+    r = run_child("--env-child", env, &code);
+    CHECK(r == 0 && code == 0, "environment beats input.ini / config_set (exit %lu)", (unsigned long)code);
+}
+
+int main(int argc, char** argv)
+{
+    if (argc >= 4 && !strcmp(argv[1], "--exit-child")) return child_exit(argv[2], argv[3]);
+    if (argc >= 2 && !strcmp(argv[1], "--env-child")) return child_env();
+    if (argc >= 4 && !strcmp(argv[1], "--hw-child")) return child_hw(argv[2], argv[3]);
+    int hw = argc >= 2 && !strcmp(argv[1], "--hw");
+    setvbuf(stdout, NULL, _IONBF, 0);
+    s_main_tid = GetCurrentThreadId();
+
+    test_pure();
+    test_config();                         /* leaves controllers=0: no physical device is touched */
+    padhost_init();
+    test_ports();
+    test_outputs();
+    test_receiver();
+    test_pipe_hid();
+    test_out_set_report();
+    test_review_fixes();
+    test_virtual_dups();
+    test_concurrency();
+    test_shutdown();
+    padhost_shutdown();
+    test_children();
+    if (hw) test_hw();
+
+    printf("\n%d passed, %d failed\n", s_pass, s_fail);
+    return s_fail ? 1 : 0;
+}
diff --git a/libs/input/tests/test_pad_hotkeys.c b/libs/input/tests/test_pad_hotkeys.c
new file mode 100644
index 0000000..45b053c
--- /dev/null
+++ b/libs/input/tests/test_pad_hotkeys.c
@@ -0,0 +1,335 @@
+/*
+ * ps3recomp - self-contained tests for the window hotkeys (pad_hotkeys.h)
+ *
+ *   cc -I libs/input -o /tmp/t libs/input/tests/test_pad_hotkeys.c -lm && /tmp/t
+ *   clang-cl /nologo -I libs\input libs\input\tests\test_pad_hotkeys.c /Fe:t.exe && t.exe
+ *
+ * pad_hotkeys.h's parser is header-only and OS-free on top of pad_kbm.h, so
+ * there is nothing to link. Covers the defaults (and that none of their keys
+ * is a game binding, nor F1 / F10 / F12 / an Alt combination), exact
+ * matching with modifiers, the [hotkeys] section and the "hotkey_" prefix
+ * elsewhere (PAD_KBM style), slot groups (F-keys, the number row, the
+ * numpad), moving a combination between actions, every refusal, the text the
+ * menu shows, the startup table, and that pad_kbm.h's parser and this one
+ * each leave the other's lines alone in one file.
+ */
+#include "pad_kbm.h"
+#include "pad_hotkeys.h"
+
+#include <stdio.h>
+
+static int g_fail = 0, g_checks = 0;
+
+#define CHECK(cond)                                                            \
+    do { g_checks++;                                                           \
+         if (!(cond)) { printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #cond); \
+                        g_fail++; } } while (0)
+
+#define CHECK_EQ(got, want)                                                    \
+    do { long _g = (long)(got), _w = (long)(want); g_checks++;                 \
+         if (_g != _w) { printf("FAIL %s:%d  %s = %ld, want %ld\n",            \
+                                __FILE__, __LINE__, #got, _g, _w);             \
+                         g_fail++; } } while (0)
+
+#define CHECK_STR(got, want)                                                   \
+    do { const char* _g = (got); const char* _w = (want); g_checks++;          \
+         if (strcmp(_g, _w)) { printf("FAIL %s:%d  %s = \"%s\", want \"%s\"\n",\
+                                      __FILE__, __LINE__, #got, _g, _w);       \
+                               g_fail++; } } while (0)
+
+#define VK_F(n)  (0x6F + (n))
+#define SH HK_MOD_SHIFT
+#define CT HK_MOD_CTRL
+#define AL HK_MOD_ALT
+
+static int g_warns;
+static char g_last_warn[400];
+static void warn(const void* ctx, const char* msg)
+{
+    (void)ctx;
+    g_warns++;
+    snprintf(g_last_warn, sizeof g_last_warn, "%s", msg);
+}
+
+static int parse(HkConfig* c, const char* text, int env)
+{
+    g_warns = 0;
+    g_last_warn[0] = 0;
+    return hk_parse_text(c, text, env, warn, "test");
+}
+
+static const char* text_of(const HkConfig* c, int a)
+{
+    static char buf[4][40];
+    static int k;
+    k = (k + 1) & 3;
+    return hk_action_text(c, a, buf[k], sizeof buf[k]);
+}
+
+static void test_defaults(void)
+{
+    HkConfig c;
+    hk_config_defaults(&c);
+    CHECK_EQ(hk_match(&c, VK_F(5), 0), HK_QUICK_SAVE);
+    CHECK_EQ(hk_match(&c, VK_F(9), 0), HK_QUICK_LOAD);
+    CHECK_EQ(hk_match(&c, VK_F(11), 0), HK_FULLSCREEN);
+    for (int s = 1; s <= HK_SLOTS; s++) {
+        CHECK_EQ(hk_match(&c, VK_F(s), CT), HK_SAVE_SLOT1 + s - 1);
+        CHECK_EQ(hk_match(&c, VK_F(s), CT | SH), HK_LOAD_SLOT1 + s - 1);
+        CHECK_EQ(hk_match(&c, VK_F(s), SH), HK_NONE);   /* Shift is L3: never a default */
+    }
+    /* left alone: F1 (options overlay), F10 (mouse release), F12, plain F2-F4/F6-F7 */
+    static const int free_keys[] = { 1, 2, 3, 4, 6, 7, 10, 12 };
+    for (int i = 0; i < KBM_COUNT(free_keys); i++) CHECK_EQ(hk_match(&c, VK_F(free_keys[i]), 0), HK_NONE);
+    /* no Alt combination at all */
+    for (int a = HK_NONE + 1; a < HK_COUNT; a++)
+        for (int i = 0; i < c.n[a]; i++) CHECK(!(c.c[a][i].mods & AL));
+    CHECK_EQ(c.n[HK_SHOW_FPS], 0);
+    CHECK_EQ(c.n[HK_OPTIONS], 0);
+    CHECK_EQ(c.n[HK_MENU], 0);
+    CHECK_EQ(hk_match(&c, VK_F(8), 0), HK_MARK);              /* F8: mark a problem moment */
+    CHECK_EQ(hk_match(&c, 'Z', CT | SH), HK_UNDO_LOAD);        /* Ctrl+Shift+Z: undo last load (M7b) */
+    CHECK_EQ(hk_match(&c, 'Z', CT), HK_NONE);                  /* (a load takes two modifiers) */
+    CHECK_EQ(hk_match(&c, 'Z', 0), HK_NONE);
+    CHECK_EQ(hk_match(&c, VK_F(8), CT), HK_SAVE_SLOT1 + 7);   /* Ctrl+F8 is still slot 8 */
+    /* exact: an extra modifier is another combination */
+    CHECK_EQ(hk_match(&c, VK_F(5), SH), HK_NONE);
+    CHECK_EQ(hk_match(&c, VK_F(5), CT), HK_SAVE_SLOT1 + 4);   /* slot 5, not the quick save */
+    CHECK_EQ(hk_match(&c, VK_F(9), AL), HK_NONE);
+    CHECK_EQ(hk_match(&c, VK_F(3), CT | AL), HK_NONE);
+    CHECK_EQ(hk_match(&c, VK_F(3), CT | SH | AL), HK_NONE);
+    CHECK_EQ(hk_match(&c, 'S', 0), HK_NONE);
+
+    /* none of the default keys drives the game in the default bindings */
+    KbmConfig k;
+    kbm_config_defaults(&k);
+    CHECK_EQ(hk_report_conflicts(&c, &k, warn, "test"), 0);
+
+    /* what the menu shows */
+    CHECK_STR(text_of(&c, HK_QUICK_SAVE), "F5");
+    CHECK_STR(text_of(&c, HK_QUICK_LOAD), "F9");
+    CHECK_STR(text_of(&c, HK_SAVE_SLOT1 + 2), "Ctrl+F3");
+    CHECK_STR(text_of(&c, HK_LOAD_SLOT1 + 9), "Ctrl+Shift+F10");
+    CHECK_STR(text_of(&c, HK_FULLSCREEN), "F11");
+    CHECK_STR(text_of(&c, HK_SHOW_FPS), "");
+    CHECK_STR(text_of(&c, HK_NONE), "");
+    CHECK_STR(text_of(&c, HK_COUNT), "");
+
+    /* the startup table: groups collapse to one cell */
+    FILE* f = tmpfile();
+    if (f) {
+        hk_print(&c, f, "[t]");
+        char all[2048];
+        rewind(f);
+        size_t n = fread(all, 1, sizeof all - 1, f);
+        all[n] = 0;
+        fclose(f);
+        CHECK(strstr(all, "save slots 1-10 = Ctrl+F1..Ctrl+F10") != NULL);
+        CHECK(strstr(all, "load slots 1-10 = Ctrl+Shift+F1..Ctrl+Shift+F10") != NULL);
+        CHECK(strstr(all, "quick_save = F5") != NULL);
+        CHECK(strstr(all, "show_fps = none") != NULL);
+        CHECK(strstr(all, "save_slot_3") == NULL);
+    }
+}
+
+static void test_names(void)
+{
+    char b[32];
+    CHECK_STR(hk_action_name(HK_SAVE_SLOT1, b, sizeof b), "save_slot_1");
+    CHECK_STR(hk_action_name(HK_LOAD_SLOT1 + 9, b, sizeof b), "load_slot_10");
+    CHECK_STR(hk_action_name(HK_MENU, b, sizeof b), "menu");
+    CHECK_STR(hk_action_name(HK_MARK, b, sizeof b), "mark");
+    CHECK_STR(hk_action_name(HK_UNDO_LOAD, b, sizeof b), "undo_load");
+    CHECK_EQ(hk_action_from_name("undoload"), HK_UNDO_LOAD);
+    CHECK_EQ(hk_action_from_name("undolastload"), HK_UNDO_LOAD);
+    CHECK_EQ(hk_action_from_name("quicksave"), HK_QUICK_SAVE);
+    CHECK_EQ(hk_action_from_name("saveslot10"), HK_SAVE_SLOT1 + 9);
+    CHECK_EQ(hk_action_from_name("loadslot1"), HK_LOAD_SLOT1);
+    CHECK_EQ(hk_action_from_name("saveslot0"), -1);
+    CHECK_EQ(hk_action_from_name("saveslot11"), -1);
+    CHECK_EQ(hk_action_from_name("saveslot"), -1);
+    CHECK_EQ(hk_action_from_name("saveslot3x"), -1);
+    CHECK_EQ(hk_action_from_name("saveslots"), HK_GROUP_SAVE);
+    CHECK_EQ(hk_action_from_name("fps"), HK_SHOW_FPS);
+
+    HkCombo k;
+    char e[160];
+    CHECK_EQ(hk_parse_combo("Ctrl+Shift+F1", &k, e, sizeof e), 1);
+    CHECK_EQ(k.vk, VK_F(1));
+    CHECK_EQ(k.mods, CT | SH);
+    CHECK_STR(hk_combo_text(&k, b, sizeof b), "Ctrl+Shift+F1");
+    CHECK_EQ(hk_parse_combo(" shift + ctrl + alt + num5 ", &k, e, sizeof e), 1);
+    CHECK_EQ(k.vk, 0x65);
+    CHECK_STR(hk_combo_text(&k, b, sizeof b), "Ctrl+Alt+Shift+Num5");    /* Windows' order */
+    CHECK_EQ(hk_parse_combo("LCtrl+F2", &k, e, sizeof e), 1);            /* a side-specific name is the modifier */
+    CHECK_EQ(k.mods, CT);
+    CHECK_EQ(hk_parse_combo("0x74", &k, e, sizeof e), 1);                /* raw virtual-key code */
+    CHECK_EQ(k.vk, VK_F(5));
+}
+
+static void test_refusals(void)
+{
+    static const char* const bad[] = {
+        "", "Ctrl+", "+F1", "Ctrl++F1", "Bogus", "Ctrl+Bogus", "F1+Ctrl", "A+B",
+        "Shift", "Ctrl+Alt", "LMB", "Ctrl+WheelUp", "Mouse4", "0x5B", "0x5C",
+        "Alt+F4", "Alt+Enter", "Ctrl+Alt+Enter", "Alt+Tab", "Alt+Esc", "Alt+Space", "Ctrl+Esc",
+    };
+    for (int i = 0; i < KBM_COUNT(bad); i++) {
+        HkCombo k;
+        char e[160] = "";
+        int r = hk_parse_combo(bad[i], &k, e, sizeof e);
+        if (r != -1) printf("  accepted \"%s\"\n", bad[i]);
+        CHECK_EQ(r, -1);
+        CHECK(e[0] != 0);
+    }
+    /* refused lines keep the old value and count as bad lines */
+    HkConfig c;
+    hk_config_defaults(&c);
+    CHECK_EQ(parse(&c, "[hotkeys]\nquick_save = Alt+F4\n", 0), 1);
+    CHECK(strstr(g_last_warn, "Alt+F4 closes the window") != NULL);
+    CHECK_EQ(hk_match(&c, VK_F(5), 0), HK_QUICK_SAVE);
+    CHECK_EQ(parse(&c, "[hotkeys]\nquick_save = F6, F7, F8\n", 0), 1);    /* more than two */
+    CHECK_EQ(parse(&c, "[hotkeys]\nteleport = F6\n", 0), 1);              /* unknown name */
+    CHECK(strstr(g_last_warn, "unknown hotkey") != NULL);
+    CHECK_EQ(parse(&c, "[hotkeys]\nquick_save F6\n", 0), 1);              /* no '=' in the section */
+    CHECK_EQ(parse(&c, "[hotkeys]\nsave_slots = F20\n", 0), 1);           /* F20..F29 does not exist */
+    CHECK_EQ(parse(&c, "[hotkeys]\nsave_slots = A\n", 0), 1);             /* not a run */
+    CHECK_EQ(parse(&c, "[hotkeys]\nload_slots = 2\n", 0), 1);             /* 2..0 is only nine keys */
+    CHECK_EQ(parse(&c, "[hotkeys]\nsave_slot_11 = F6\n", 0), 1);
+    CHECK_EQ(hk_match(&c, VK_F(6), 0), HK_NONE);
+    /* nothing above changed the defaults */
+    HkConfig d;
+    hk_config_defaults(&d);
+    for (int a = HK_NONE + 1; a < HK_COUNT; a++) {
+        CHECK_EQ(c.n[a], d.n[a]);
+        for (int i = 0; i < c.n[a] && i < d.n[a]; i++) {
+            CHECK_EQ(c.c[a][i].vk, d.c[a][i].vk);
+            CHECK_EQ(c.c[a][i].mods, d.c[a][i].mods);
+        }
+    }
+}
+
+static void test_parse(void)
+{
+    HkConfig c;
+    hk_config_defaults(&c);
+    const char* file =
+        "# comment\n"
+        "[bindings]\n"
+        "Cross = Space            # not ours\n"
+        "quick_save = F2          # outside [hotkeys] without the prefix: not ours either\n"
+        "hotkey_show_fps = F8     # the prefix works anywhere\n"
+        "\n"
+        "[Hotkeys]                # case and spaces do not matter\n"
+        "Quick Save  = F6, Ctrl+S ; two combinations\n"
+        "quick-load  = none\n"
+        "save_slots  = Ctrl+Alt+1\n"
+        "load_slots  = Num1\n"
+        "load_slot_3 = Ctrl+L\n"
+        "menu        = Ctrl+M\n"
+        "options     = F1\n"
+        "[controller]\n"
+        "deadzone = 0\n"
+        "save_slot_1 = F12        # a hotkey name outside the section: ignored\n";
+    CHECK_EQ(parse(&c, file, 0), 0);
+    CHECK_EQ(hk_match(&c, VK_F(2), 0), HK_NONE);
+    CHECK_EQ(hk_match(&c, VK_F(12), 0), HK_NONE);
+    CHECK_EQ(hk_match(&c, VK_F(8), 0), HK_SHOW_FPS);
+    CHECK_EQ(hk_match(&c, VK_F(6), 0), HK_QUICK_SAVE);
+    CHECK_EQ(hk_match(&c, 'S', CT), HK_QUICK_SAVE);
+    CHECK_EQ(hk_match(&c, VK_F(5), 0), HK_NONE);           /* replaced */
+    CHECK_EQ(c.n[HK_QUICK_LOAD], 0);
+    CHECK_EQ(hk_match(&c, VK_F(9), 0), HK_NONE);
+    /* number-row group: 1..9 then 0 */
+    for (int s = 1; s <= 9; s++) CHECK_EQ(hk_match(&c, '0' + s, CT | AL), HK_SAVE_SLOT1 + s - 1);
+    CHECK_EQ(hk_match(&c, '0', CT | AL), HK_SAVE_SLOT1 + 9);
+    CHECK_EQ(hk_match(&c, VK_F(1), CT), HK_NONE);          /* the old group is gone */
+    /* numpad group, with slot 3 given its own key afterwards */
+    CHECK_EQ(hk_match(&c, 0x61, 0), HK_LOAD_SLOT1);        /* Num1 */
+    CHECK_EQ(hk_match(&c, 0x60, 0), HK_LOAD_SLOT1 + 9);    /* Num0 */
+    CHECK_EQ(hk_match(&c, 'L', CT), HK_LOAD_SLOT1 + 2);
+    CHECK_EQ(hk_match(&c, 0x63, 0), HK_NONE);              /* Num3 was replaced */
+    CHECK_EQ(hk_match(&c, 'M', CT), HK_MENU);
+    CHECK_EQ(hk_match(&c, VK_F(1), 0), HK_OPTIONS);
+    CHECK_STR(text_of(&c, HK_QUICK_SAVE), "F6");            /* the first combination */
+
+    /* PAD_KBM style: items end at '|' or ';' and need the prefix */
+    hk_config_defaults(&c);
+    CHECK_EQ(parse(&c, "mouse_sensitivity=1.5|hotkey_quick_save=F7;hotkeys_quick_load=Shift+F7|quick_load=F2", 1), 0);
+    CHECK_EQ(hk_match(&c, VK_F(7), 0), HK_QUICK_SAVE);
+    CHECK_EQ(hk_match(&c, VK_F(7), SH), HK_QUICK_LOAD);
+    CHECK_EQ(hk_match(&c, VK_F(2), 0), HK_NONE);
+    CHECK_EQ(parse(&c, "hotkey_bogus=F7", 1), 1);
+
+    /* a combination given to another action moves, with a note (not an error) */
+    hk_config_defaults(&c);
+    CHECK_EQ(parse(&c, "[hotkeys]\nshow_fps = F5\n", 0), 0);
+    CHECK_EQ(g_warns, 1);
+    CHECK(strstr(g_last_warn, "F5 moves from quick_save to show_fps") != NULL);
+    CHECK_EQ(hk_match(&c, VK_F(5), 0), HK_SHOW_FPS);
+    CHECK_EQ(c.n[HK_QUICK_SAVE], 0);
+    /* and out of a group */
+    hk_config_defaults(&c);
+    CHECK_EQ(parse(&c, "[hotkeys]\nfullscreen = Ctrl+F4\n", 0), 0);
+    CHECK_EQ(hk_match(&c, VK_F(4), CT), HK_FULLSCREEN);
+    CHECK_EQ(c.n[HK_SAVE_SLOT1 + 3], 0);
+    CHECK_EQ(c.n[HK_FULLSCREEN], 1);                        /* F11 went: a line sets the whole list */
+    /* duplicates inside one line count once */
+    hk_config_defaults(&c);
+    CHECK_EQ(parse(&c, "[hotkeys]\nquick_save = F6, f6\n", 0), 0);
+    CHECK_EQ(c.n[HK_QUICK_SAVE], 1);
+
+    /* a game binding on a hotkey's key is reported */
+    KbmConfig k;
+    kbm_config_defaults(&k);
+    hk_config_defaults(&c);
+    CHECK_EQ(parse(&c, "[hotkeys]\nsave_slots = Ctrl+1\n", 0), 0);
+    g_warns = 0;
+    CHECK_EQ(hk_report_conflicts(&c, &k, warn, "test"), 4);   /* 1..4 are the D-pad */
+    CHECK(strstr(g_last_warn, "the game sees that key too") != NULL);
+}
+
+/* One file, both readers: each takes its own lines and leaves the other's. */
+static void test_shared_file(void)
+{
+    const char* file =
+        "[bindings]\n"
+        "Cross = Enter\n"
+        "hotkey_quick_save = F6\n"
+        "[hotkeys]\n"
+        "quick_save = F7, F6\n"
+        "save_slots = Ctrl+1\n"
+        "menu = none\n"
+        "[mouse]\n"
+        "mouse_sensitivity = 2.0\n";
+    KbmConfig k;
+    kbm_config_defaults(&k);
+    g_warns = 0;
+    CHECK_EQ(kbm_parse_text(&k, file, 0, warn, "test"), 0);
+    CHECK_EQ(g_warns, 0);
+    CHECK_EQ(k.nkeys[KBM_CROSS], 1);
+    CHECK_EQ(k.keys[KBM_CROSS][0], 0x0D);
+    CHECK(k.mouse_sens > 1.99 && k.mouse_sens < 2.01);
+    HkConfig c;
+    hk_config_defaults(&c);
+    CHECK_EQ(parse(&c, file, 0), 0);
+    CHECK_EQ(hk_match(&c, VK_F(7), 0), HK_QUICK_SAVE);
+    CHECK_EQ(hk_match(&c, VK_F(6), 0), HK_QUICK_SAVE);
+    CHECK_EQ(hk_match(&c, '1', CT), HK_SAVE_SLOT1);
+    CHECK_EQ(hk_match(&c, 0x0D, 0), HK_NONE);
+    /* PAD_KBM with both kinds of items */
+    kbm_config_defaults(&k);
+    CHECK_EQ(kbm_parse_text(&k, "Cross=Enter|hotkey_quick_save=F6|mouse_sensitivity=3", 1, warn, "env"), 0);
+    CHECK(k.mouse_sens > 2.99 && k.mouse_sens < 3.01);
+}
+
+int main(void)
+{
+    test_defaults();
+    test_names();
+    test_refusals();
+    test_parse();
+    test_shared_file();
+    printf("%d checks, %d failed\n", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/input/tests/test_pad_kbm.c b/libs/input/tests/test_pad_kbm.c
new file mode 100644
index 0000000..2cb7e51
--- /dev/null
+++ b/libs/input/tests/test_pad_kbm.c
@@ -0,0 +1,1079 @@
+/*
+ * ps3recomp - self-contained tests for the keyboard/mouse pad mapping
+ *
+ *   cc -I libs/input -o /tmp/t libs/input/tests/test_pad_kbm.c -lm && /tmp/t
+ *   clang-cl /nologo -I libs\input libs\input\tests\test_pad_kbm.c /Fe:t.exe && t.exe
+ *
+ * pad_kbm.h is header-only and OS-free, so there is nothing to link. Covers
+ * the key/target name tables, the input.ini / PAD_KBM parser (and config
+ * files with a UTF-8 BOM or in UTF-16, as PowerShell 5 writes), the default
+ * table (every DUALSHOCK 3 input bound, no key on two inputs), the key ->
+ * button/stick evaluation, wheel pulses, and the mouse-motion -> right-stick
+ * conversion (speed mapping, saturation, return to centre, anti-deadzone,
+ * invert, and that the camera input integrates to the distance moved however
+ * the motion is chopped into reports), and kbm_arbitrate: which device drives
+ * each stick when a controller is on port 0 too (a resting or jittering mouse
+ * never moves the camera away from a controller player; hybrids still work).
+ */
+#include "pad_kbm.h"
+
+#include <stdio.h>
+
+static int g_fail = 0, g_checks = 0;
+
+#define CHECK(cond)                                                            \
+    do { g_checks++;                                                           \
+         if (!(cond)) { printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #cond); \
+                        g_fail++; } } while (0)
+
+#define CHECK_EQ(got, want)                                                    \
+    do { long _g = (long)(got), _w = (long)(want); g_checks++;                 \
+         if (_g != _w) { printf("FAIL %s:%d  %s = %ld, want %ld\n",            \
+                                __FILE__, __LINE__, #got, _g, _w);             \
+                         g_fail++; } } while (0)
+
+#define CHECK_NEAR(got, want, tol)                                             \
+    do { double _g = (double)(got), _w = (double)(want); g_checks++;           \
+         if (fabs(_g - _w) > (tol)) {                                          \
+             printf("FAIL %s:%d  %s = %.4f, want %.4f +- %.4f\n",              \
+                    __FILE__, __LINE__, #got, _g, _w, (double)(tol));          \
+             g_fail++; } } while (0)
+
+/* CELL_PAD_CTRL_* as cellPad.h defines them (not included: it pulls in the
+ * guest type headers). Must agree with the target numbering in pad_kbm.h. */
+#define CTRL_SELECT   (1 << 0)
+#define CTRL_L3       (1 << 1)
+#define CTRL_R3       (1 << 2)
+#define CTRL_START    (1 << 3)
+#define CTRL_UP       (1 << 4)
+#define CTRL_RIGHT    (1 << 5)
+#define CTRL_DOWN     (1 << 6)
+#define CTRL_LEFT     (1 << 7)
+#define CTRL_L2       (1 << 8)
+#define CTRL_R2       (1 << 9)
+#define CTRL_L1       (1 << 10)
+#define CTRL_R1       (1 << 11)
+#define CTRL_TRIANGLE (1 << 12)
+#define CTRL_CIRCLE   (1 << 13)
+#define CTRL_CROSS    (1 << 14)
+#define CTRL_SQUARE   (1 << 15)
+
+/* ---- fake host key state ---------------------------------------------- */
+
+static int g_keys[0x200];
+
+static int fake_down(void* ctx, int code)
+{
+    (void)ctx;
+    return code >= 0 && code < 0x200 && g_keys[code];
+}
+
+static void keys_clear(void) { memset(g_keys, 0, sizeof g_keys); }
+
+static void press(const char* name)
+{
+    int k = kbm_key_from_name(name);
+    if (k < 0) { printf("FAIL press(%s): unknown key\n", name); g_fail++; return; }
+    g_keys[k] = 1;
+}
+
+/* One report with no mouse motion. */
+static KbmOut eval_keys(const KbmConfig* c, KbmRuntime* rt, double now)
+{
+    KbmOut o;
+    kbm_eval(c, rt, fake_down, NULL, now, 0, 0, 0, &o);
+    return o;
+}
+
+/* ---- name tables -------------------------------------------------------- */
+
+static void test_key_names(void)
+{
+    CHECK_EQ(kbm_key_from_name("Space"), 0x20);
+    CHECK_EQ(kbm_key_from_name("space"), 0x20);
+    CHECK_EQ(kbm_key_from_name("SPACE"), 0x20);
+    CHECK_EQ(kbm_key_from_name("Enter"), 0x0D);
+    CHECK_EQ(kbm_key_from_name("Return"), 0x0D);
+    CHECK_EQ(kbm_key_from_name("Esc"), 0x1B);
+    CHECK_EQ(kbm_key_from_name("Escape"), 0x1B);
+    CHECK_EQ(kbm_key_from_name("LShift"), 0xA0);
+    CHECK_EQ(kbm_key_from_name("Left Shift"), 0xA0);
+    CHECK_EQ(kbm_key_from_name("left_ctrl"), 0xA2);
+    CHECK_EQ(kbm_key_from_name("LMB"), 0x01);
+    CHECK_EQ(kbm_key_from_name("Mouse1"), 0x01);
+    CHECK_EQ(kbm_key_from_name("RMB"), 0x02);
+    CHECK_EQ(kbm_key_from_name("MMB"), 0x04);
+    CHECK_EQ(kbm_key_from_name("mouse4"), 0x05);
+    CHECK_EQ(kbm_key_from_name("Mouse5"), 0x06);
+    CHECK_EQ(kbm_key_from_name("WheelUp"), KBM_KEY_WHEEL_UP);
+    CHECK_EQ(kbm_key_from_name("Wheel Down"), KBM_KEY_WHEEL_DOWN);
+    CHECK_EQ(kbm_key_from_name("a"), 'A');
+    CHECK_EQ(kbm_key_from_name("Z"), 'Z');
+    CHECK_EQ(kbm_key_from_name("7"), '7');
+    CHECK_EQ(kbm_key_from_name("F1"), 0x70);
+    CHECK_EQ(kbm_key_from_name("f12"), 0x7B);
+    CHECK_EQ(kbm_key_from_name("F24"), 0x87);
+    CHECK_EQ(kbm_key_from_name("F25"), -1);
+    CHECK_EQ(kbm_key_from_name("F0"), -1);
+    CHECK_EQ(kbm_key_from_name("Num5"), 0x65);
+    CHECK_EQ(kbm_key_from_name("Numpad 0"), 0x60);
+    CHECK_EQ(kbm_key_from_name("NumAdd"), 0x6B);
+    CHECK_EQ(kbm_key_from_name("Page Up"), 0x21);
+    CHECK_EQ(kbm_key_from_name("PgDn"), 0x22);
+    CHECK_EQ(kbm_key_from_name("Up"), 0x26);
+    CHECK_EQ(kbm_key_from_name("Semicolon"), 0xBA);
+    CHECK_EQ(kbm_key_from_name("Comma"), 0xBC);
+    CHECK_EQ(kbm_key_from_name("["), 0xDB);
+    CHECK_EQ(kbm_key_from_name("\\"), 0xDC);
+    CHECK_EQ(kbm_key_from_name("'"), 0xDE);
+    CHECK_EQ(kbm_key_from_name("-"), 0xBD);
+    CHECK_EQ(kbm_key_from_name("0x41"), 0x41);
+    CHECK_EQ(kbm_key_from_name("0XBA"), 0xBA);
+    CHECK_EQ(kbm_key_from_name("0x00"), -1);
+    CHECK_EQ(kbm_key_from_name("0x1FF"), -1);
+    CHECK_EQ(kbm_key_from_name("0x4G"), -1);
+    CHECK_EQ(kbm_key_from_name("Foo"), -1);
+    CHECK_EQ(kbm_key_from_name(""), -1);
+    CHECK_EQ(kbm_key_from_name(","), -1);
+    CHECK_EQ(kbm_key_from_name("Num"), -1);
+
+    /* Every code prints as a name that parses back to the same code. */
+    for (int code = 1; code <= 0xFE; code++) {
+        char buf[32];
+        const char* n = kbm_key_name(code, buf, sizeof buf);
+        if (kbm_key_from_name(n) != code) {
+            printf("FAIL round trip: code 0x%02X -> \"%s\" -> %d\n", (unsigned)code, n, kbm_key_from_name(n));
+            g_fail++;
+        }
+        g_checks++;
+    }
+    {
+        char buf[32];
+        CHECK(!strcmp(kbm_key_name(KBM_KEY_WHEEL_UP, buf, sizeof buf), "WheelUp"));
+        CHECK(!strcmp(kbm_key_name(0x20, buf, sizeof buf), "Space"));
+        CHECK(!strcmp(kbm_key_name(0x65, buf, sizeof buf), "Num5"));
+        CHECK(!strcmp(kbm_key_name(0x7B, buf, sizeof buf), "F12"));
+    }
+    CHECK(kbm_is_mouse_key(0x01) && kbm_is_mouse_key(0x06) && kbm_is_mouse_key(KBM_KEY_WHEEL_UP));
+    CHECK(!kbm_is_mouse_key(0x20) && !kbm_is_mouse_key(0x03));
+}
+
+static void test_target_names(void)
+{
+    CHECK_EQ(kbm_target_from_name("Cross"), KBM_CROSS);
+    CHECK_EQ(kbm_target_from_name("cross"), KBM_CROSS);
+    CHECK_EQ(kbm_target_from_name("Triangle"), KBM_TRIANGLE);
+    CHECK_EQ(kbm_target_from_name("L1"), KBM_L1);
+    CHECK_EQ(kbm_target_from_name("r3"), KBM_R3);
+    CHECK_EQ(kbm_target_from_name("Start"), KBM_START);
+    CHECK_EQ(kbm_target_from_name("SELECT"), KBM_SELECT);
+    CHECK_EQ(kbm_target_from_name("Up"), KBM_UP);
+    CHECK_EQ(kbm_target_from_name("dpad_left"), KBM_LEFT);
+    CHECK_EQ(kbm_target_from_name("LStickUp"), KBM_LS_UP);
+    CHECK_EQ(kbm_target_from_name("left stick right"), KBM_LS_RIGHT);
+    CHECK_EQ(kbm_target_from_name("MoveForward"), KBM_LS_UP);
+    CHECK_EQ(kbm_target_from_name("RStickDown"), KBM_RS_DOWN);
+    CHECK_EQ(kbm_target_from_name("LookLeft"), KBM_RS_LEFT);
+    CHECK_EQ(kbm_target_from_name("Walk"), KBM_WALK);
+    CHECK_EQ(kbm_target_from_name("X"), -1);          /* ambiguous: not a target name */
+    CHECK_EQ(kbm_target_from_name("Bogus"), -1);
+    for (int t = 0; t < KBM_NUM_TARGETS; t++)
+        CHECK_EQ(kbm_target_from_name(kbm_target_name(t)), t);
+    /* targets 0..15 are the CELL_PAD_CTRL_* bit numbers */
+    CHECK_EQ(1 << KBM_SELECT, CTRL_SELECT);
+    CHECK_EQ(1 << KBM_START, CTRL_START);
+    CHECK_EQ(1 << KBM_LEFT, CTRL_LEFT);
+    CHECK_EQ(1 << KBM_L2, CTRL_L2);
+    CHECK_EQ(1 << KBM_R1, CTRL_R1);
+    CHECK_EQ(1 << KBM_CROSS, CTRL_CROSS);
+    CHECK_EQ(1 << KBM_SQUARE, CTRL_SQUARE);
+}
+
+/* ---- defaults --------------------------------------------------------- */
+
+static int has_key(const KbmConfig* c, int t, const char* name)
+{
+    int k = kbm_key_from_name(name);
+    for (int i = 0; i < c->nkeys[t]; i++) if (c->keys[t][i] == k) return 1;
+    return 0;
+}
+
+static void test_defaults(void)
+{
+    KbmConfig c;
+    kbm_config_defaults(&c);
+    /* every DUALSHOCK 3 input (16 buttons + 8 stick directions) has a key */
+    for (int t = 0; t < KBM_NUM_TARGETS; t++)
+        if (!c.nkeys[t]) { printf("FAIL default: %s unbound\n", kbm_target_name(t)); g_fail++; }
+    /* no key drives two inputs */
+    for (int t = 0; t < KBM_NUM_TARGETS; t++)
+        for (int i = 0; i < c.nkeys[t]; i++)
+            for (int u = t; u < KBM_NUM_TARGETS; u++)
+                for (int j = (u == t ? i + 1 : 0); j < c.nkeys[u]; j++)
+                    if (c.keys[t][i] == c.keys[u][j]) {
+                        printf("FAIL default: key 0x%X on %s and %s\n", (unsigned)c.keys[t][i],
+                               kbm_target_name(t), kbm_target_name(u));
+                        g_fail++;
+                    }
+    CHECK(has_key(&c, KBM_CROSS, "Space"));
+    CHECK(has_key(&c, KBM_SQUARE, "F"));
+    CHECK(has_key(&c, KBM_TRIANGLE, "E"));
+    CHECK(has_key(&c, KBM_CIRCLE, "C"));
+    CHECK(has_key(&c, KBM_L1, "RMB"));
+    CHECK(has_key(&c, KBM_R1, "LMB"));
+    CHECK(has_key(&c, KBM_L2, "Q"));
+    CHECK(has_key(&c, KBM_R2, "R"));
+    CHECK(has_key(&c, KBM_START, "Esc"));
+    CHECK(has_key(&c, KBM_SELECT, "Tab"));
+    CHECK(has_key(&c, KBM_UP, "Up") && has_key(&c, KBM_UP, "1") && has_key(&c, KBM_UP, "WheelUp"));
+    CHECK(has_key(&c, KBM_DOWN, "WheelDown"));
+    CHECK(has_key(&c, KBM_LS_UP, "W") && has_key(&c, KBM_LS_LEFT, "A"));
+    CHECK(has_key(&c, KBM_LS_DOWN, "S") && has_key(&c, KBM_LS_RIGHT, "D"));
+    CHECK(has_key(&c, KBM_RS_UP, "I") && has_key(&c, KBM_RS_LEFT, "J"));
+    CHECK(has_key(&c, KBM_RS_DOWN, "K") && has_key(&c, KBM_RS_RIGHT, "L"));
+    CHECK(has_key(&c, KBM_WALK, "LCtrl"));
+    CHECK_NEAR(c.mouse_sens, 1.0, 1e-6);
+    CHECK_EQ(c.invert_y, 0);
+    CHECK_EQ(c.capture, KBM_CAPTURE_CLICK);
+    CHECK_EQ(c.merge, 1);
+    CHECK(c.keyboard && c.mouse);
+}
+
+/* ---- parser ------------------------------------------------------------ */
+
+static int g_warns;
+static char g_last_warn[300];
+static void warn_cb(const void* ctx, const char* msg)
+{
+    (void)ctx;
+    g_warns++;
+    snprintf(g_last_warn, sizeof g_last_warn, "%s", msg);
+}
+
+static void test_parse_lines(void)
+{
+    KbmConfig c;
+    char err[200];
+    kbm_config_defaults(&c);
+
+    CHECK_EQ(kbm_parse_line(&c, "Cross = J, K", err, sizeof err), 1);
+    CHECK_EQ(c.nkeys[KBM_CROSS], 2);
+    CHECK_EQ(c.keys[KBM_CROSS][0], 'J');
+    CHECK_EQ(c.keys[KBM_CROSS][1], 'K');
+
+    CHECK_EQ(kbm_parse_line(&c, "square=none", err, sizeof err), 1);
+    CHECK_EQ(c.nkeys[KBM_SQUARE], 0);
+    CHECK_EQ(kbm_parse_line(&c, "Triangle =", err, sizeof err), 1);
+    CHECK_EQ(c.nkeys[KBM_TRIANGLE], 0);
+
+    CHECK_EQ(kbm_parse_line(&c, "", err, sizeof err), 0);
+    CHECK_EQ(kbm_parse_line(&c, "   ", err, sizeof err), 0);
+    CHECK_EQ(kbm_parse_line(&c, "# Cross = Z", err, sizeof err), 0);
+    CHECK_EQ(kbm_parse_line(&c, "  ; Cross = Z", err, sizeof err), 0);
+    CHECK_EQ(kbm_parse_line(&c, "[bindings]", err, sizeof err), 0);
+    CHECK_EQ(c.keys[KBM_CROSS][0], 'J');               /* comments did nothing */
+
+    CHECK_EQ(kbm_parse_line(&c, "Triangle = E   ; interact", err, sizeof err), 1);
+    CHECK_EQ(c.nkeys[KBM_TRIANGLE], 1);
+    CHECK_EQ(c.keys[KBM_TRIANGLE][0], 'E');
+    CHECK_EQ(kbm_parse_line(&c, "R2 = R # kinetic pulse", err, sizeof err), 1);
+    CHECK_EQ(c.nkeys[KBM_R2], 1);
+
+    /* a bad key leaves the target unchanged */
+    CHECK_EQ(kbm_parse_line(&c, "Circle = V, Foo", err, sizeof err), -1);
+    CHECK(strstr(err, "Foo") != NULL);
+    CHECK(has_key(&c, KBM_CIRCLE, "C") && !has_key(&c, KBM_CIRCLE, "V"));
+    CHECK_EQ(kbm_parse_line(&c, "R3 = A, B, C, D, E", err, sizeof err), -1);
+    CHECK_EQ(kbm_parse_line(&c, "R3 = A, a, A", err, sizeof err), 1);   /* duplicates fold */
+    CHECK_EQ(c.nkeys[KBM_R3], 1);
+    CHECK_EQ(kbm_parse_line(&c, "L3 = Mouse4, WheelDown, Num 7, F11", err, sizeof err), 1);
+    CHECK_EQ(c.nkeys[KBM_L3], 4);
+    CHECK_EQ(c.keys[KBM_L3][1], KBM_KEY_WHEEL_DOWN);
+    CHECK_EQ(c.keys[KBM_L3][2], 0x67);
+    CHECK_EQ(kbm_parse_line(&c, "Look Left = Left Arrow", err, sizeof err), 1);
+    CHECK_EQ(c.keys[KBM_RS_LEFT][0], 0x25);
+
+    CHECK_EQ(kbm_parse_line(&c, "mouse_sensitivity = 2.5", err, sizeof err), 1);
+    CHECK_NEAR(c.mouse_sens, 2.5, 1e-6);
+    CHECK_EQ(kbm_parse_line(&c, "MouseSensitivity=abc", err, sizeof err), -1);
+    CHECK_EQ(kbm_parse_line(&c, "mouse_sensitivity = 0", err, sizeof err), -1);
+    CHECK_EQ(kbm_parse_line(&c, "mouse_sensitivity = 1.5x", err, sizeof err), -1);
+    CHECK_NEAR(c.mouse_sens, 2.5, 1e-6);
+    CHECK_EQ(kbm_parse_line(&c, "mouse_sensitivity_y = 0.5", err, sizeof err), 1);
+    CHECK_NEAR(c.mouse_sens_y, 0.5, 1e-6);
+    CHECK_EQ(kbm_parse_line(&c, "mouse_invert_y = yes", err, sizeof err), 1);
+    CHECK_EQ(c.invert_y, 1);
+    CHECK_EQ(kbm_parse_line(&c, "invert_y = off", err, sizeof err), 1);
+    CHECK_EQ(c.invert_y, 0);
+    CHECK_EQ(kbm_parse_line(&c, "invert_y = maybe", err, sizeof err), -1);
+    CHECK_EQ(kbm_parse_line(&c, "mouse_smoothing_ms = 30", err, sizeof err), 1);
+    CHECK_NEAR(c.smoothing_ms, 30, 1e-6);
+    CHECK_EQ(kbm_parse_line(&c, "mouse_smoothing_ms = 900", err, sizeof err), -1);
+    CHECK_EQ(kbm_parse_line(&c, "mouse_anti_deadzone = 0.3", err, sizeof err), 1);
+    CHECK_NEAR(c.anti_deadzone, 0.3, 1e-6);
+    CHECK_EQ(kbm_parse_line(&c, "mouse_anti_deadzone = 1.2", err, sizeof err), -1);
+    CHECK_EQ(kbm_parse_line(&c, "mouse_curve = 0.7", err, sizeof err), 1);
+    CHECK_NEAR(c.curve, 0.7, 1e-6);
+    CHECK_EQ(kbm_parse_line(&c, "mouse_capture = focus", err, sizeof err), 1);
+    CHECK_EQ(c.capture, KBM_CAPTURE_FOCUS);
+    CHECK_EQ(kbm_parse_line(&c, "capture = off", err, sizeof err), 1);
+    CHECK_EQ(c.capture, KBM_CAPTURE_OFF);
+    CHECK_EQ(kbm_parse_line(&c, "capture = Click", err, sizeof err), 1);
+    CHECK_EQ(c.capture, KBM_CAPTURE_CLICK);
+    CHECK_EQ(kbm_parse_line(&c, "capture = sometimes", err, sizeof err), -1);
+    CHECK_EQ(kbm_parse_line(&c, "walk_scale = 0.3", err, sizeof err), 1);
+    CHECK_NEAR(c.walk_scale, 0.3, 1e-6);
+    CHECK_EQ(kbm_parse_line(&c, "wheel_pulse_ms = 5", err, sizeof err), -1);
+    CHECK_EQ(kbm_parse_line(&c, "wheel_pulse_ms = 150", err, sizeof err), 1);
+    CHECK_EQ(kbm_parse_line(&c, "merge_with_controller = 0", err, sizeof err), 1);
+    CHECK_EQ(c.merge, 0);
+    CHECK_EQ(kbm_parse_line(&c, "keyboard = false", err, sizeof err), 1);
+    CHECK_EQ(c.keyboard, 0);
+    CHECK_EQ(kbm_parse_line(&c, "mouse = 1", err, sizeof err), 1);
+    CHECK_EQ(c.mouse, 1);
+    CHECK_EQ(kbm_parse_line(&c, "frobnicate = 1", err, sizeof err), -1);
+    CHECK(strstr(err, "frobnicate") != NULL);
+    CHECK_EQ(kbm_parse_line(&c, "no equals sign", err, sizeof err), -1);
+}
+
+static void test_parse_text(void)
+{
+    KbmConfig c;
+    kbm_config_defaults(&c);
+    g_warns = 0;
+    const char* file =
+        "# inFamous 2 input\r\n"
+        "[bindings]\r\n"
+        "Cross = Space, J\r\n"
+        "Square = Bogus\r\n"
+        "\r\n"
+        "[mouse]\n"
+        "mouse_sensitivity = 0.75\n"
+        "mouse_invert_y = 1";              /* no trailing newline */
+    CHECK_EQ(kbm_parse_text(&c, file, 0, warn_cb, NULL), 1);
+    CHECK_EQ(g_warns, 1);
+    CHECK(strstr(g_last_warn, "line 4") != NULL);
+    CHECK(has_key(&c, KBM_CROSS, "J"));
+    CHECK(has_key(&c, KBM_SQUARE, "F"));               /* bad line skipped */
+    CHECK_NEAR(c.mouse_sens, 0.75, 1e-6);
+    CHECK_EQ(c.invert_y, 1);
+
+    /* env style: ';' and '|' separate items too */
+    kbm_config_defaults(&c);
+    g_warns = 0;
+    CHECK_EQ(kbm_parse_text(&c, "mouse_sensitivity=2|Cross=J;Square=K,  L ", 1, warn_cb, NULL), 0);
+    CHECK_EQ(g_warns, 0);
+    CHECK_NEAR(c.mouse_sens, 2.0, 1e-6);
+    CHECK(has_key(&c, KBM_CROSS, "J") && !has_key(&c, KBM_CROSS, "Space"));
+    CHECK(has_key(&c, KBM_SQUARE, "K") && has_key(&c, KBM_SQUARE, "L"));
+    CHECK_EQ(kbm_parse_text(&c, "bogus=1|walk_scale=0.25", 1, warn_cb, NULL), 1);
+    CHECK(strstr(g_last_warn, "item 1") != NULL);
+    CHECK_NEAR(c.walk_scale, 0.25, 1e-6);
+    CHECK_EQ(kbm_parse_text(&c, "", 1, warn_cb, NULL), 0);
+}
+
+/* A config file as Notepad / VS Code (UTF-8 with BOM) or Windows PowerShell 5
+ * ('>' / Out-File: UTF-16LE with BOM) may write it. */
+static void test_text_prepare(void)
+{
+    static const char body[] = "Cross = J\r\nmouse_sensitivity = 2\r\n";
+    char buf[256];
+    size_t n = strlen(body);
+    KbmConfig c;
+
+    /* plain: unchanged */
+    memcpy(buf, body, n);
+    CHECK(!strcmp(kbm_text_prepare(buf, n), body));
+
+    /* UTF-8 BOM: skipped, so the first line's name still parses */
+    buf[0] = (char)0xEF; buf[1] = (char)0xBB; buf[2] = (char)0xBF;
+    memcpy(buf + 3, body, n);
+    kbm_config_defaults(&c);
+    CHECK_EQ(kbm_parse_text(&c, kbm_text_prepare(buf, n + 3), 0, NULL, NULL), 0);
+    CHECK(has_key(&c, KBM_CROSS, "J"));
+    CHECK_NEAR(c.mouse_sens, 2.0, 1e-6);
+
+    /* UTF-16LE and UTF-16BE with BOM: folded to 8-bit */
+    for (int be = 0; be < 2; be++) {
+        size_t k = 0;
+        buf[k++] = (char)(be ? 0xFE : 0xFF);
+        buf[k++] = (char)(be ? 0xFF : 0xFE);
+        for (size_t i = 0; i < n; i++) {
+            buf[k++] = be ? 0 : body[i];
+            buf[k++] = be ? body[i] : 0;
+        }
+        kbm_config_defaults(&c);
+        const char* t = kbm_text_prepare(buf, k);
+        CHECK(!strcmp(t, body));
+        CHECK_EQ(kbm_parse_text(&c, t, 0, NULL, NULL), 0);
+        CHECK(has_key(&c, KBM_CROSS, "J"));
+        CHECK_NEAR(c.mouse_sens, 2.0, 1e-6);
+    }
+    /* UTF-16 non-ASCII becomes '?', an odd trailing byte is dropped */
+    {
+        unsigned char u[] = { 0xFF, 0xFE, 'A', 0, 0xE9, 0x00, 0x3A, 0x26, 'B', 0, 'x' };
+        memcpy(buf, u, sizeof u);
+        CHECK(!strcmp(kbm_text_prepare(buf, sizeof u), "A??B"));
+    }
+    /* empty and BOM-only files */
+    CHECK(!strcmp(kbm_text_prepare(buf, 0), ""));
+    buf[0] = (char)0xFF; buf[1] = (char)0xFE;
+    CHECK(!strcmp(kbm_text_prepare(buf, 2), ""));
+}
+
+/* ---- keys -> report ---------------------------------------------------- */
+
+static void test_eval_keys(void)
+{
+    KbmConfig c;
+    KbmRuntime rt;
+    KbmOut o;
+    kbm_config_defaults(&c);
+    kbm_runtime_reset(&rt);
+    double t = 1000.0;
+
+    keys_clear();
+    o = eval_keys(&c, &rt, t += 16);
+    CHECK_EQ(o.buttons, 0);
+    CHECK_EQ(kbm_axis_u8(o.lx), 128);
+    CHECK_EQ(kbm_axis_u8(o.ly), 128);
+    CHECK_EQ(kbm_axis_u8(o.rx), 128);
+    CHECK_EQ(kbm_axis_u8(o.ry), 128);
+    CHECK(!o.l_active && !o.r_active);
+
+    static const struct { const char* key; int mask; } one[] = {
+        {"Space", CTRL_CROSS}, {"Enter", CTRL_CROSS}, {"F", CTRL_SQUARE}, {"E", CTRL_TRIANGLE},
+        {"C", CTRL_CIRCLE}, {"Backspace", CTRL_CIRCLE}, {"RMB", CTRL_L1}, {"LMB", CTRL_R1},
+        {"Q", CTRL_L2}, {"Mouse4", CTRL_L2}, {"R", CTRL_R2}, {"Mouse5", CTRL_R2},
+        {"LShift", CTRL_L3}, {"MMB", CTRL_R3}, {"G", CTRL_R3}, {"Esc", CTRL_START},
+        {"P", CTRL_START}, {"Tab", CTRL_SELECT}, {"M", CTRL_SELECT},
+        {"Up", CTRL_UP}, {"1", CTRL_UP}, {"Right", CTRL_RIGHT}, {"2", CTRL_RIGHT},
+        {"Down", CTRL_DOWN}, {"3", CTRL_DOWN}, {"Left", CTRL_LEFT}, {"4", CTRL_LEFT},
+    };
+    for (unsigned i = 0; i < sizeof one / sizeof one[0]; i++) {
+        keys_clear();
+        press(one[i].key);
+        o = eval_keys(&c, &rt, t += 16);
+        if (o.buttons != one[i].mask) {
+            printf("FAIL key %s -> buttons 0x%04X, want 0x%04X\n", one[i].key, (unsigned)o.buttons,
+                   (unsigned)one[i].mask);
+            g_fail++;
+        }
+        g_checks++;
+        CHECK(!o.l_active && !o.r_active);
+    }
+
+    /* several at once */
+    keys_clear(); press("Space"); press("RMB"); press("LMB");
+    o = eval_keys(&c, &rt, t += 16);
+    CHECK_EQ(o.buttons, CTRL_CROSS | CTRL_L1 | CTRL_R1);
+
+    /* left stick: 8-way, full deflection; walk halves it */
+    keys_clear(); press("W");
+    o = eval_keys(&c, &rt, t += 16);
+    CHECK_EQ(kbm_axis_u8(o.lx), 128);
+    CHECK_EQ(kbm_axis_u8(o.ly), 0);                    /* up = 0 on the PS3 */
+    CHECK(o.l_active);
+    CHECK_EQ(o.buttons, 0);                            /* sticks are not buttons */
+    keys_clear(); press("S"); press("D");
+    o = eval_keys(&c, &rt, t += 16);
+    CHECK_EQ(kbm_axis_u8(o.lx), 255);
+    CHECK_EQ(kbm_axis_u8(o.ly), 255);
+    keys_clear(); press("W"); press("A");
+    o = eval_keys(&c, &rt, t += 16);
+    CHECK_EQ(kbm_axis_u8(o.lx), 0);
+    CHECK_EQ(kbm_axis_u8(o.ly), 0);
+    keys_clear(); press("A"); press("D");             /* opposite keys cancel */
+    o = eval_keys(&c, &rt, t += 16);
+    CHECK_EQ(kbm_axis_u8(o.lx), 128);
+    CHECK(!o.l_active);
+    keys_clear(); press("W"); press("LCtrl");
+    o = eval_keys(&c, &rt, t += 16);
+    CHECK_EQ(kbm_axis_u8(o.ly), 64);                   /* walk_scale 0.5 */
+    CHECK_EQ(o.buttons, 0);
+    keys_clear(); press("LCtrl");                      /* walk alone: nothing */
+    o = eval_keys(&c, &rt, t += 16);
+    CHECK(!o.l_active);
+    CHECK_EQ(o.buttons, 0);
+
+    /* right stick from keys */
+    keys_clear(); press("I");
+    o = eval_keys(&c, &rt, t += 16);
+    CHECK_EQ(kbm_axis_u8(o.ry), 0);
+    CHECK(o.r_active);
+    keys_clear(); press("L"); press("Num2");
+    o = eval_keys(&c, &rt, t += 16);
+    CHECK_EQ(kbm_axis_u8(o.rx), 255);
+    CHECK_EQ(kbm_axis_u8(o.ry), 255);
+
+    /* unbinding works */
+    {
+        char err[100];
+        CHECK_EQ(kbm_parse_line(&c, "Cross = none", err, sizeof err), 1);
+        keys_clear(); press("Space");
+        o = eval_keys(&c, &rt, t += 16);
+        CHECK_EQ(o.buttons, 0);
+    }
+}
