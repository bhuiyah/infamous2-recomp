+        vm_base[ent + 0x34] = dir ? CELL_FS_TYPE_DIR : CELL_FS_TYPE_REG;
+        vm_base[ent + 0x35] = (uint8_t)nl;
+        for (size_t i = 0; i < nl; i++) vm_base[ent + 0x36 + i] = (uint8_t)e->d_name[i];
+        vm_base[ent + 0x36 + nl] = 0;
