+static void rsx_write_note_hook(u32 ea, u32 len);   /* below, with the texture packs' hooks */
+/* Start of a texture prepass. render_frame has waited for the GPU, so last
+ * batch's upload memory is free. */
+static void tc_batch_begin(void)
