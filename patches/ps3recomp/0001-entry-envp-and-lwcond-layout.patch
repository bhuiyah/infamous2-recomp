+/* ---- the image, the guest clock frozen as the coordinator freezes it ---- */
+static void freeze(int on)
+{
+    if (on) { LARGE_INTEGER q; QueryPerformanceCounter(&q); g_guest_qpc_frozen = q.QuadPart; }
+    else g_guest_qpc_frozen = 0;
