+#if RSX_VF_SSE41
+static inline u64 rsx_vf_ld_upto8(const u8* p, u32 nb)
+{
+    u64 w = 0; u32 a; u16 b;
+    switch (nb) {
+    case 8: memcpy(&w, p, 8); break;
+    case 6: memcpy(&a, p, 4); memcpy(&b, p + 4, 2); w = (u64)a | ((u64)b << 32); break;
+    case 4: memcpy(&a, p, 4); w = a; break;
+    case 3: memcpy(&b, p, 2); w = (u64)b | ((u64)p[2] << 16); break;
+    case 2: memcpy(&b, p, 2); w = b; break;
+    case 1: w = p[0]; break;
+    default: break;
+    }
+    return w;
+}
+
+/* Lanes [0, n) from v, the rest from k (components the array lacks keep the
+ * constant register). */
+static inline __m128 rsx_vf_keep(__m128 v, const float* k, u32 n)
+{
+    if (n >= 4) return v;
+    static const u32 m[4][4] = {
+        {0, 0, 0, 0}, {~0u, 0, 0, 0}, {~0u, ~0u, 0, 0}, {~0u, ~0u, ~0u, 0} };
+    return _mm_blendv_ps(_mm_loadu_ps(k), v, _mm_castsi128_ps(_mm_loadu_si128((const __m128i*)m[n])));
+}
+
+/* One FAST element -> one float4 at d. Same arithmetic as rsx_fetch_attrib:
+ * IEEE division by the same constants (lane-wise divps rounds exactly like
+ * scalar divss), bit copies for floats and halves. */
+static inline void rsx_vf_conv(const rsx_vf_slot* s, const u8* p, float* d)
+{
+    const __m128i bswap32 = _mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12);
+    const __m128i bswap16 = _mm_setr_epi8(1, 0, 3, 2, 5, 4, 7, 6, 9, 8, 11, 10, 13, 12, 15, 14);
+    __m128 v;
+    switch (s->type) {
+    case 2: {   /* float32 BE */
+        __m128i x;
+        u32 w;
+        switch (s->n) {
+        case 4:  x = _mm_loadu_si128((const __m128i*)p); break;
+        case 3:  memcpy(&w, p + 8, 4);
+                 x = _mm_insert_epi32(_mm_loadl_epi64((const __m128i*)p), (int)w, 2); break;
+        case 2:  x = _mm_loadl_epi64((const __m128i*)p); break;
+        default: memcpy(&w, p, 4); x = _mm_cvtsi32_si128((int)w); break;
+        }
+        v = rsx_vf_keep(_mm_castsi128_ps(_mm_shuffle_epi8(x, bswap32)), s->k, s->n);
+        break; }
+    case 3: {   /* half BE: rsx_rd_half_be, four lanes at once */
+        const __m128i h = _mm_cvtepu16_epi32(_mm_shuffle_epi8(
+            _mm_cvtsi64_si128((long long)rsx_vf_ld_upto8(p, s->bytes)), bswap16));
+        const __m128i sgn = _mm_slli_epi32(_mm_and_si128(h, _mm_set1_epi32(0x8000)), 16);
+        const __m128i em  = _mm_and_si128(h, _mm_set1_epi32(0x7FFF));
+        const __m128i ex  = _mm_srli_epi32(em, 10);
+        const __m128i nrm = _mm_or_si128(sgn, _mm_add_epi32(_mm_slli_epi32(em, 13), _mm_set1_epi32(112 << 23)));
+        const __m128i inf = _mm_or_si128(sgn, _mm_or_si128(_mm_set1_epi32(0x7F800000),
+                                _mm_slli_epi32(_mm_and_si128(h, _mm_set1_epi32(0x3FF)), 13)));
+        __m128i r = _mm_blendv_epi8(nrm, inf, _mm_cmpeq_epi32(ex, _mm_set1_epi32(31)));
+        r = _mm_blendv_epi8(r, sgn, _mm_cmpeq_epi32(ex, _mm_setzero_si128()));
+        v = rsx_vf_keep(_mm_castsi128_ps(r), s->k, s->n);
+        break; }
+    case 4:     /* UB: u8 / 255 */
+    case 7: {   /* UB256: u8 */
+        const __m128i x = _mm_cvtepu8_epi32(_mm_cvtsi32_si128((int)(u32)rsx_vf_ld_upto8(p, s->bytes)));
+        v = _mm_cvtepi32_ps(x);
+        if (s->type == 4) v = _mm_div_ps(v, _mm_set1_ps(255.0f));
+        v = rsx_vf_keep(v, s->k, s->n);
+        break; }
+    case 1:     /* S1: s16 / 32767 */
+    case 5: {   /* S32K: s16 */
+        const __m128i x = _mm_cvtepi16_epi32(_mm_shuffle_epi8(
+            _mm_cvtsi64_si128((long long)rsx_vf_ld_upto8(p, s->bytes)), bswap16));
+        v = _mm_cvtepi32_ps(x);
+        if (s->type == 1) v = _mm_div_ps(v, _mm_set1_ps(32767.0f));
+        v = rsx_vf_keep(v, s->k, s->n);
+        break; }
+    case 6: {   /* CMP 11:11:10, w = 1 regardless of size */
+        u32 raw; memcpy(&raw, p, 4);
+        raw = (raw >> 24) | ((raw >> 8) & 0xFF00u) | ((raw << 8) & 0xFF0000u) | (raw << 24);
+        const s32 x = ((s32)(raw << 21)) >> 21;
+        const s32 y = ((s32)(raw << 10)) >> 21;
+        const s32 z = ((s32)raw) >> 22;
+        v = _mm_div_ps(_mm_cvtepi32_ps(_mm_setr_epi32(x, y, z, 1)),
+                       _mm_setr_ps(1023.0f, 1023.0f, 511.0f, 1.0f));
+        break; }
+    default:
+        v = _mm_loadu_ps(s->k);   /* unreachable: plan marks other types SLOW */
+        break;
+    }
+    _mm_storeu_ps(d, v);
+}
+#else
+static inline void rsx_vf_conv(const rsx_vf_slot* s, const u8* p, float* d)
+{
+    /* Portable fallback: the per-attribute code, element address given. */
+    float t[4]; memcpy(t, s->k, sizeof t);
+    const u32 n = s->n;
+    switch (s->type) {
+    case 2: for (u32 k = 0; k < n; k++) t[k] = rsx_rd_bef(p + k * 4); break;
+    case 3: for (u32 k = 0; k < n; k++) t[k] = rsx_rd_half_be(p + k * 2); break;
+    case 4: for (u32 k = 0; k < n; k++) t[k] = p[k] / 255.0f; break;
+    case 1: for (u32 k = 0; k < n; k++) { s16 v = (s16)((p[k*2] << 8) | p[k*2+1]); t[k] = (float)v / 32767.0f; } break;
+    case 5: for (u32 k = 0; k < n; k++) t[k] = (float)(s16)((p[k*2] << 8) | p[k*2+1]); break;
+    case 7: for (u32 k = 0; k < n; k++) t[k] = (float)p[k]; break;
+    case 6: { const u32 raw = ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | (u32)p[3];
+              const s32 x = ((s32)(raw << 21)) >> 21, y = ((s32)(raw << 10)) >> 21, z = ((s32)raw) >> 22;
+              t[0] = x / 1023.0f; t[1] = y / 1023.0f; t[2] = z / 511.0f; t[3] = 1.0f; } break;
+    default: break;
+    }
+    memcpy(d, t, sizeof t);
+}
+#endif
