+    c.tier1_ms = 150; c.timeout_ms = 2000; c.spu_expect = 0; c.verify = 1; c.fatal_box = 0;
+    c.discard_ms = 3000; c.selftest_every_s = 0; c.selftest_ab_s = 0;
+    c.chains_path[0] = 0;                 /* no chains file (SS_CHAINS=- reads as this) */
+    ss_configure(&c);
+    if (!g_ss_armed) { printf("not armed\n"); exit(2); }
+    { static const ss_host_ops h = { fake_walker_pass, fake_walker_info, fake_rebase, fake_wake };
+      ss_set_host_ops(&h); }
+    set_ppu_ops(0);
+    g_ss_on_capture = on_capture;
+    g_wake = CreateEventA(NULL, FALSE, FALSE, NULL);
+    g_done_ev = CreateEventA(NULL, TRUE, FALSE, NULL);
+    g_clock = (HANDLE)_beginthreadex(NULL, 0, clock_proc, NULL, 0, NULL);
+}
+static void world_stop(void)
+{
+    InterlockedExchange(&g_quit_clock, 1);
+    WaitForSingleObject(g_clock, 5000);
+}
