+#include <stdlib.h>
 
 /* ---- little-endian word read (RPCS3-capture native order) --------------- */
 static u32 rd_le(const u8* p)
@@ -76,10 +77,43 @@ static void emit(Out* o, const char* s)
 /* ---- source operand ---------------------------------------------------- */
 static const char SWZ[4] = {'x','y','z','w'};
 
+/* ---- Spec semantics switches (docs/GROUND_TRUTH.md section 6), read at
+ * every decompile. VP_COLSAT: 1 (default) clamps the primary and secondary
+ * colours COL0/COL1 to [0,1] at the vertex output -- "The selected primary
+ * and secondary colors for each primitive are clamped to the range [0,1] and
+ * then interpolated" (NV_vertex_program 2.14.1.5, the same sentence in
+ * NV_vertex_program2 section 2.14.1.5; T2), i.e. per vertex, before
+ * interpolation, which a clamp at the fragment read (RPCS3, T4 "reading COL0/
+ * COL1 is clamped" from hw tests) only approximates. 0 = no clamp, 2 = clamp
+ * at the fragment read instead (rsx_fp_decompiler.c). VP_SPEC: 1 (default)
+ * the published special cases:
+ *   RCC  sign kept, |1/x| clamped to [2^-64, 2^+64] (NV_vertex_program1_1
+ *        2.14.1.10.19, NV_vertex_program2 2.14.3.25); was clamp(1/x,
+ *        5.42101e-20, 1.884467e19), positive only and a typo'd bound;
+ *   RSQ  1/sqrt(|x|) with RSQ(0) = +INF (NV_vp 2.14.1.10.7, NV_vp2 2.14.3.28
+ *        rule 4); was rsqrt(max(|x|, 1e-10)). Negative inputs keep the abs:
+ *        NV_vp2 says NaN there, NV_vp |x| -- the specs disagree, open;
+ *   LG2  log2(x): LG2(+-0) = -INF, LG2(x < 0) = NaN (NV_vp2 2.14.3.17); was
+ *        log2(max(|x|, 1e-10));
+ *   EXP  (2^floor(x), x - floor(x), 2^x, 1) and LOG (exponent, mantissa,
