diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4ef4dfa..872ba17 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -21,6 +21,44 @@ set(CMAKE_CXX_STANDARD_REQUIRED ON)
 # ---------------------------------------------------------------------------
 option(PS3RECOMP_BUILD_TESTS "Build unit tests" OFF)
 
+# Host ISA the lifted SPU code is compiled for. spu_helpers.h executes every SPU
+# instruction on the host; at x86-64-v3 (AVX2 + FMA3 + BMI2: every x86-64 CPU
+# since Intel Haswell and AMD Excavator, 2013-15, and every Zen) the
+# single-precision float, shuffle and quadword byte-rotate instructions are a
+# few SIMD instructions each, ~10x faster than without (results are
+# bit-identical either way). A port calls ps3recomp_apply_spu_isa(<its lifted
+# SPU sources>) (templates/project/CMakeLists.txt), which adds the flags to those
+# sources and tells the runtime what they need; the runtime then checks the CPU
+# before running lifted code and exits with a message, instead of an
+# illegal-instruction crash, on one that lacks it. A port that never calls it
+# gets baseline lifted code and no check.
+# x86-64-v4 (opt-in) adds AVX-512F/BW/CD/DQ/VL: the same helpers with 32
+# vector registers -- register-cached lifted code holds far more SPU registers
+# than 16 can -- and a few AVX-512 instructions (spu_helpers.h, SPU__AVX512).
+# Same results bit for bit. On Zen 5, 11-34% less time than v3 in hot lifted
+# regions on ordinary float data (standalone region benchmarks); code that
+# often takes the helpers' out-of-line fallbacks gains less, or loses a few
+# percent (the extra registers are caller-saved on Win64).
+# CPUs: AMD Zen 4 and later; Intel Skylake-SP/X and later P-core Xeons and
+# HEDT, Ice Lake, Tiger Lake, Rocket Lake -- but NOT Alder Lake and later
+# client chips (AVX-512 disabled) or E-core Xeons, so a v4 build only suits
+# machines known to have it; it exits with a message on the others.
+set(PS3RECOMP_SPU_HOST_ISA "x86-64-v3" CACHE STRING
+    "Host ISA for the lifted SPU code: x86-64-v4 (AVX-512), x86-64-v3 (AVX2/FMA3), x86-64-v2 (SSE4.2) or baseline")
+set_property(CACHE PS3RECOMP_SPU_HOST_ISA PROPERTY STRINGS x86-64-v4 x86-64-v3 x86-64-v2 baseline)
+if(NOT PS3RECOMP_SPU_HOST_ISA MATCHES "^(x86-64-v4|x86-64-v3|x86-64-v2|baseline)$")
+    message(FATAL_ERROR "PS3RECOMP_SPU_HOST_ISA=${PS3RECOMP_SPU_HOST_ISA}: expected x86-64-v4, x86-64-v3, x86-64-v2 or baseline")
+endif()
+# SPU host threads run with MXCSR = round toward zero + DAZ + FTZ, and the
+# lifted SPU code's float helpers are compiled for exactly that mode
+# (SPU_HELPERS_FP_RZDAZ in spu_helpers.h): the host then does in hardware what
+# the helpers otherwise test for on every operand (denormals read as zero,
+# truncation), so the single-precision fast paths are about half the
+# instructions. Results are the same bits as with the option off (and as the
+# default SPU_FPMODE=rz); 20-65% less time in float-heavy lifted SPU code
+# (standalone region benchmarks; less with many zero/special lanes).
+option(PS3RECOMP_SPU_FP_RZDAZ "Lifted SPU float helpers for MXCSR RZ+DAZ+FTZ, forced on SPU host threads" ON)
+
 # ---------------------------------------------------------------------------
 # Collect source files
 # ---------------------------------------------------------------------------
@@ -54,6 +92,11 @@ endif()
 # to a stub wherever the shader tools are absent, so it is part of the
 # library everywhere. See the "Guest shaders on Metal" section below.
 list(APPEND HLE_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/libs/video/rsx_shader_msl.cpp")
+# The options overlay's DirectComposition attachment is C++ (dcomp.h has no C
+# binding); dcomp.dll is loaded at run time, nothing is linked.
+if(WIN32)
+    list(APPEND HLE_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/libs/video/ovl_dcomp.cpp")
+endif()
 # cellAtrac decodes with FFmpeg's ATRAC3plus decoder as extracted by PPSSPP
 # (LGPL-2.1, kept separate in third_party/at3_standalone -- see its README).
 file(GLOB AT3_SOURCES "third_party/at3_standalone/*.cpp")
@@ -297,6 +340,88 @@ if(NOT MSVC AND NOT WIN32)
     target_compile_definitions(ps3recomp_runtime PRIVATE _GNU_SOURCE)
 endif()
 
+# Flags for the lifted SPU sources (PS3RECOMP_SPU_HOST_ISA above). Also: no
+# floating-point contraction there -- with FMA enabled clang fuses `a*b + c` by
+# default, and clang-cl silently ignores -ffp-contract=off; it has to be spelt
+# /clang:-ffp-contract=off. (spu_helpers.h turns contraction off for its own
+# code as well.)
+set(PS3RECOMP_SPU_LIFTED_FLAGS "")
+set(_ps3recomp_spu_isa_level 0)
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|x64)$" AND CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
+    if(PS3RECOMP_SPU_HOST_ISA STREQUAL "x86-64-v4")
+        # 256-bit vectors for the compiler's own code (copies, loops): clang-cl's
+        # /arch:AVX512 otherwise widens them to zmm, which costs clock speed on
+        # Intel's AVX-512 parts and gains nothing here (-march=x86-64-v4 prefers
+        # 256 already; said explicitly for both). The helpers' own zmm use is
+        # explicit (spu_helpers.h: frest/frsqest).
+        set(_ps3recomp_spu_isa_level 4)
+        if(MSVC)                                  # clang-cl
+            list(APPEND PS3RECOMP_SPU_LIFTED_FLAGS /arch:AVX512 /clang:-mprefer-vector-width=256)
+        else()
+            list(APPEND PS3RECOMP_SPU_LIFTED_FLAGS -march=x86-64-v4 -mprefer-vector-width=256)
+        endif()
+    elseif(PS3RECOMP_SPU_HOST_ISA STREQUAL "x86-64-v3")
+        set(_ps3recomp_spu_isa_level 3)
+        if(MSVC)                                  # clang-cl
+            list(APPEND PS3RECOMP_SPU_LIFTED_FLAGS /arch:AVX2)
+        else()
+            list(APPEND PS3RECOMP_SPU_LIFTED_FLAGS -march=x86-64-v3)
+        endif()
+    elseif(PS3RECOMP_SPU_HOST_ISA STREQUAL "x86-64-v2")
+        set(_ps3recomp_spu_isa_level 2)
+        list(APPEND PS3RECOMP_SPU_LIFTED_FLAGS -msse4.2 -mpopcnt)
+    endif()
+endif()
+if(MSVC AND CMAKE_C_COMPILER_ID MATCHES "Clang")
+    list(APPEND PS3RECOMP_SPU_LIFTED_FLAGS /clang:-ffp-contract=off)
+elseif(CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
+    list(APPEND PS3RECOMP_SPU_LIFTED_FLAGS -ffp-contract=off)
+endif()
+# Generated code: no /GS stack cookies (a check on every call of a lifted
+# function with an addressed local aggregate -- e.g. a u128 passed by value
+# to spu_wrch) and no /Zc:tlsGuards on-demand TLS-initialization test on
+# every g_spu_trampoline_fn access (C has no dynamic TLS initializers).
+if(MSVC)
+    list(APPEND PS3RECOMP_SPU_LIFTED_FLAGS /GS- /Zc:tlsGuards-)
+endif()
+set(_ps3recomp_spu_fp_rzdaz 0)
+# Clang/GCC only: spu_helpers.h keeps the compiler from folding the RZDAZ fast
+# paths' operands and results with IEEE-denormal assumptions through empty asm
+# statements, which MSVC (cl) does not have.
+if(PS3RECOMP_SPU_FP_RZDAZ AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|x64)$"
+   AND CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
+    set(_ps3recomp_spu_fp_rzdaz 1)
+    list(APPEND PS3RECOMP_SPU_LIFTED_FLAGS -DSPU_HELPERS_FP_RZDAZ)
+endif()
+# ps3recomp_apply_spu_isa(<sources>): compile those lifted SPU sources with
+# PS3RECOMP_SPU_LIFTED_FLAGS AND tell the runtime what they need -- the CPU
+# check's ISA level and the RZ+DAZ+FTZ host mode -- on spu_drain.c alone (a
+# target-wide definition would rebuild the whole runtime whenever the option
+# changes). The two travel together: lifted code built for the RZDAZ mode run
+# without it, or a CPU check for AVX2/AVX-512 code that was never compiled (or
+# none for code that was), are both wrong, and a port that adds the flags by
+# hand gets neither.
+set(PS3RECOMP_SPU_ISA_LEVEL "${_ps3recomp_spu_isa_level}" CACHE INTERNAL "")
+set(PS3RECOMP_SPU_FP_RZDAZ_ON "${_ps3recomp_spu_fp_rzdaz}" CACHE INTERNAL "")
+set(PS3RECOMP_SPU_DRAIN_C "${CMAKE_CURRENT_SOURCE_DIR}/runtime/spu/spu_drain.c" CACHE INTERNAL "")
+function(ps3recomp_apply_spu_isa)
+    if(ARGN)
+        set_property(SOURCE ${ARGN} APPEND PROPERTY COMPILE_OPTIONS ${PS3RECOMP_SPU_LIFTED_FLAGS})
+    endif()
+    get_property(_done GLOBAL PROPERTY PS3RECOMP_SPU_ISA_DEFS_SET)
+    if(NOT _done)
+        set_property(GLOBAL PROPERTY PS3RECOMP_SPU_ISA_DEFS_SET 1)
+        set_property(SOURCE "${PS3RECOMP_SPU_DRAIN_C}" TARGET_DIRECTORY ps3recomp_runtime APPEND PROPERTY
+            COMPILE_DEFINITIONS PS3RECOMP_SPU_HOST_ISA_LEVEL=${PS3RECOMP_SPU_ISA_LEVEL}
+                                PS3RECOMP_SPU_FP_RZDAZ=${PS3RECOMP_SPU_FP_RZDAZ_ON})
+    endif()
+endfunction()
+get_directory_property(_ps3recomp_parent PARENT_DIRECTORY)
+if(_ps3recomp_parent)
+    set(PS3RECOMP_SPU_LIFTED_FLAGS "${PS3RECOMP_SPU_LIFTED_FLAGS}" PARENT_SCOPE)
+endif()
+message(STATUS "Lifted SPU ISA:  ${PS3RECOMP_SPU_HOST_ISA} (${PS3RECOMP_SPU_LIFTED_FLAGS})")
+
 # ---------------------------------------------------------------------------
 # Tests
 # ---------------------------------------------------------------------------
diff --git a/include/ps3emu/hle_abi.h b/include/ps3emu/hle_abi.h
new file mode 100644
index 0000000..33c0fd2
--- /dev/null
+++ b/include/ps3emu/hle_abi.h
@@ -0,0 +1,152 @@
+/*
+ * ps3recomp - PPC64 ELFv1 argument marshalling for HLE handlers that take or
+ * return floating-point values.
+ *
+ * The generic HLE adapter (runtime/ppu/ppu_hle.cpp) calls every handler as
+ * uint64_t f(uint64_t x8) with r3..r10. That is right for integer and pointer
+ * parameters only. A float parameter is not in a GPR at all, so a handler
+ * declared `s32 cellVideoOutSetGamma(u32 videoOut, float gamma)` read its
+ * gamma from whatever the HOST left in its float argument register
+ * (inFamous 2 logged "VideoOutSetGamma(-0.00)").
+ *
+ * The rules, from the 64-bit PowerPC ELF ABI Supplement 1.9 (T2),
+ * section 3.2.3 "Parameter Passing" and 3.2.4 "Return Values"
+ * (https://refspecs.linuxfoundation.org/ELF/ppc64/PPC-elf64abi-1.9.html):
+ *
+ *  - Every parameter occupies doublewords of the parameter save area, in
+ *    order. "The first eight doublewords mapped to the parameter save area
+ *    correspond to the registers r3 through r10."  The save area itself is
+ *    "located at a fixed offset of 48 bytes from the stack pointer".
+ *  - "Floating point registers f1 through f13 are used consecutively to pass
+ *    up to 13 floating point values." A floating-point parameter still takes
+ *    its doubleword slot, so the GPR of that slot is SKIPPED: in the spec's
+ *    Figure 3-18, func(c, ff, d, ...) puts c in r3, ff in f1 and d in r5.
+ *    Numbering is therefore interleaved: the slot counter advances for every
+ *    parameter, the FPR counter only for floating-point ones.
+ *  - A floating-point parameter keeps its FPR even past slot 8 (Figure 3-18:
+ *    hh, at save-area offset 88, is in f5). Past f13 it is read from its
+ *    save-area doubleword; "Single precision floating point values are mapped
+ *    to the second word in a single doubleword."
+ *  - FPRs hold single-precision values in double format (lfs/frsp), which is
+ *    how ppu_context.fpr[] (double) stores them.
+ *  - "Functions shall return float or double values in f1, with float values
+ *    rounded to single precision." Integer and pointer results go in r3.
+ *
+ * The PS3 ABI is this one with 32-bit pointers: a pointer is still one
+ * doubleword. Aggregates passed by value and varargs functions are NOT
+ * handled here; gen_hle_nids.py refuses to emit a thunk for them.
+ *
+ * That the PS3 toolchain numbers the slots this way is T3 (inFamous 2's own
+ * compiled code, lifted): of the 168 functions whose entry block reads f1
+ * and r5 as arguments, 77 never read r4 (f(p, float, int); e.g.
+ * func_0011DE1C keeps f1 and r5 and overwrites r4); the
+ * varargs-style call at 0x1B54C duplicates f3 into r6 and f4 into r9 -- each
+ * float's own slot GPR -- and stores its 9th doubleword at r1+0x70; the
+ * title's cellGcmBindZcull call (0x4EFC74) passes arguments 9-12 at
+ * r1+0x70..0x88.
+ *
+ * Usage: gen_hle_nids.py emits, for every handler whose prototype has a
+ * float/double parameter or result, a thunk that pulls its arguments through
+ * a ps3_abi_args cursor in declaration order and stores the result through a
+ * ps3_abi_ret; ppu_hle.cpp builds the cursor from the caller's registers and
+ * writes r3 or f1 back. The header is C and C++ and depends on nothing but
+ * <stdint.h>/<string.h>, so the host unit tests include it directly.
+ */
+#ifndef PS3EMU_HLE_ABI_H
+#define PS3EMU_HLE_ABI_H
+
+#include <stdint.h>
+#include <string.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PS3_ABI_GPR_SLOTS      8u    /* r3..r10 */
+#define PS3_ABI_FPR_ARGS      13u    /* f1..f13 */
+#define PS3_ABI_SAVE_AREA_OFS 48u    /* parameter save area = r1 + 48 */
+
+/* Big-endian doubleword load from guest memory at an effective address. */
+typedef uint64_t (*ps3_abi_load64_fn)(uint64_t ea);
+
+typedef struct ps3_abi_args {
+    const uint64_t*   gpr;     /* r0..r31 of the caller */
+    const double*     fpr;     /* f0..f31 of the caller */
+    uint64_t          sp;      /* r1 at the call */
+    ps3_abi_load64_fn load64;  /* for parameters past the registers */
+    unsigned          slot;    /* next parameter doubleword (0 = r3) */
+    unsigned          nfpr;    /* floating-point parameters taken so far */
+    unsigned          mem_reads; /* parameters read from the save area */
+} ps3_abi_args;
+
+enum { PS3_ABI_RET_NONE = 0, PS3_ABI_RET_GPR = 1, PS3_ABI_RET_FPR = 2 };
+
+typedef struct ps3_abi_ret {
+    int      kind;   /* PS3_ABI_RET_* */
+    uint64_t gpr;    /* -> r3 */
+    double   fpr;    /* -> f1 */
+} ps3_abi_ret;
+
+/* A generated marshalling thunk. */
+typedef void (*ps3_abi_thunk)(ps3_abi_args* a, ps3_abi_ret* r);
+
+static inline void ps3_abi_begin(ps3_abi_args* a, const uint64_t* gpr, const double* fpr,
+                                 uint64_t sp, ps3_abi_load64_fn load64)
+{
+    a->gpr = gpr; a->fpr = fpr; a->sp = sp; a->load64 = load64;
+    a->slot = 0; a->nfpr = 0; a->mem_reads = 0;
+}
+
+/* The save-area doubleword of parameter slot s (s >= 8 is memory only). */
+static inline uint64_t ps3_abi_slot_mem(ps3_abi_args* a, unsigned s)
+{
+    a->mem_reads++;
+    return a->load64 ? a->load64(a->sp + PS3_ABI_SAVE_AREA_OFS + 8ull * s) : 0;
+}
+
+/* Next integer, pointer or enum parameter: the full doubleword. */
+static inline uint64_t ps3_abi_int(ps3_abi_args* a)
+{
+    unsigned s = a->slot++;
+    if (s < PS3_ABI_GPR_SLOTS) return a->gpr[3 + s];
+    return ps3_abi_slot_mem(a, s);
+}
+
+/* Next double parameter. */
+static inline double ps3_abi_f64(ps3_abi_args* a)
+{
+    unsigned s = a->slot++;
+    if (a->nfpr < PS3_ABI_FPR_ARGS) return a->fpr[1 + a->nfpr++];
+    {   uint64_t bits = ps3_abi_slot_mem(a, s);
+        double d; memcpy(&d, &bits, sizeof d); return d; }
+}
+
+/* Next float parameter. In an FPR it is a double-format value of single
+ * precision, so the narrowing is exact; in memory it is the second word of
+ * its doubleword. */
+static inline float ps3_abi_f32(ps3_abi_args* a)
+{
+    unsigned s = a->slot++;
+    if (a->nfpr < PS3_ABI_FPR_ARGS) return (float)a->fpr[1 + a->nfpr++];
+    {   uint32_t bits = (uint32_t)ps3_abi_slot_mem(a, s);
+        float f; memcpy(&f, &bits, sizeof f); return f; }
+}
+
+/* Results. Integer results are widened the way the PPU compiler leaves them
+ * in r3: signed types sign-extended, unsigned ones zero-extended. */
+static inline void ps3_abi_ret_none(ps3_abi_ret* r) { r->kind = PS3_ABI_RET_NONE; }
+static inline void ps3_abi_ret_s64(ps3_abi_ret* r, int64_t v)
+{ r->kind = PS3_ABI_RET_GPR; r->gpr = (uint64_t)v; }
+static inline void ps3_abi_ret_u64(ps3_abi_ret* r, uint64_t v)
+{ r->kind = PS3_ABI_RET_GPR; r->gpr = v; }
+static inline void ps3_abi_ret_f64(ps3_abi_ret* r, double v)
+{ r->kind = PS3_ABI_RET_FPR; r->fpr = v; }
+/* "float values rounded to single precision", held in f1 in double format. */
+static inline void ps3_abi_ret_f32(ps3_abi_ret* r, float v)
+{ r->kind = PS3_ABI_RET_FPR; r->fpr = (double)v; }
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3EMU_HLE_ABI_H */
diff --git a/include/ps3emu/options.h b/include/ps3emu/options.h
new file mode 100644
index 0000000..a6b2033
--- /dev/null
+++ b/include/ps3emu/options.h
@@ -0,0 +1,180 @@
+/*
+ * ps3recomp - the settings store (libs/system/options.c)
+ *
+ * One table of settings. A row (opt_def) says what a setting is: its ini key,
+ * type and range or choices, built-in default, the environment variable that
+ * overrides it, its preset values, and when a change takes effect. The store
+ * keeps one value per row, read lock-free by the code that uses it, and writes
+ * menu changes to a comment-preserving config\options.ini.
+ *
+ * Layers, lowest priority first:
+ *   1. the built-in default        -- ALWAYS today's behaviour: no options.ini
+ *                                     and no env = exactly the old code paths
+ *   2. the row's home file         -- config\display.ini or config\input.ini
+ *                                     (git-tracked, read as before, never
+ *                                     written by the store)
+ *   3. config\options.ini          -- the menu's file (git-ignored). Found as
+ *                                     OPTIONS_CONFIG=<file> (OPTIONS_CONFIG=none:
+ *                                     no file, nothing saved), else the first of
+ *                                     .\options.ini, .\config\options.ini and
+ *                                     options.ini next to the exe; created on the
+ *                                     first save in .\config\ when that folder
+ *                                     exists (else next to the exe)
+ *   4. the environment             -- the row's own variable (FPS_CAP, ...) or a
+ *                                     multi-setting one (DISPLAY_CFG, PAD_KBM,
+ *                                     PAD_HOST, OPTIONS_CFG="k=v|k=v"). A setting
+ *                                     set this way is LOCKED: opt_set refuses it
+ *                                     and it is never saved.
+ * The home parsers (display.ini: rsx_d3d12_backend.c, input.ini: cellPad.c)
+ * read options.ini's [display] / input sections between their file and their
+ * env overrides (opt_layer_text), so every consumer sees the same value; keys
+ * the store has no row for pass through unchanged.
+ *
+ * Saving: every opt_set saves at once (tmp file + atomic replace), because the
+ * window-close path ends in ExitProcess. A value equal to what the lower
+ * layers give goes back to its commented "# key = default" line; nothing else
+ * in the file changes (comments, order, line endings, encoding are kept).
+ *
+ * Threads: getters are lock-free (one 64-bit slot per row) and may be called
+ * from any thread, also on hot paths -- poll opt_generation() to re-read only
+ * after a change. opt_set / opt_reset / presets may be called from any thread;
+ * OPT_ON_SETTER callbacks run on the setter's thread, OPT_ON_RENDER callbacks
+ * on the render (window) thread inside opt_render_point(), which the presenting
+ * backend calls right after the game's Present -- never mid-frame. Live
+ * renderer state (vsync, anisotropy, brightness) is latched there.
+ *
+ * Unit test: libs/system/tests/test_options_store.c (no game data).
+ */
+#ifndef PS3EMU_OPTIONS_H
+#define PS3EMU_OPTIONS_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum { OPT_BOOL, OPT_INT, OPT_FLOAT, OPT_ENUM, OPT_TEXT } opt_type;
+
+/* When a change takes effect. */
+typedef enum {
+    OPT_LIVE,       /* at once (the next read of the value)                     */
+    OPT_FRAME,      /* at the next frame boundary (latched at opt_render_point)  */
+    OPT_RELOAD,     /* at the next frame boundary, with a cache flush (a hitch)  */
+    OPT_RESTART     /* at the next launch                                        */
+} opt_apply;
+
+enum { OPT_PRESET_PS3 = 0, OPT_PRESET_LOW, OPT_PRESET_MED, OPT_PRESET_HIGH, OPT_PRESET_ULTRA,
+       OPT_NPRESETS };
+
+enum {
+    OPT_F_ENHANCEMENT  = 1,    /* beyond the PS3's output                    */
+    OPT_F_EXPERIMENTAL = 2,
+    OPT_F_ADVANCED     = 4,    /* troubleshooting rows                       */
+    OPT_F_HIDDEN       = 8     /* not shown by a menu                        */
+};
+
+/* Where the current value came from. */
+typedef enum {
+    OPT_SRC_DEFAULT = 0,       /* built-in default                           */
+    OPT_SRC_HOME,              /* display.ini / input.ini                    */
+    OPT_SRC_FILE,              /* options.ini                                */
+    OPT_SRC_MENU,              /* opt_set at run time                        */
+    OPT_SRC_ENV                /* environment: locked                        */
+} opt_source_kind;
+
+typedef struct opt_def {
+    const char* key;        /* ini spelling, unique (names compare ignoring case, ' ', '_', '-') */
+    const char* alias;      /* other accepted spellings, '|' separated, or NULL */
+    const char* home;       /* "display" | "input" | "options": the shipped file that may hold it */
+    const char* section;    /* its options.ini section ("display", "mouse", "graphics", ...) */
+    const char* tab;        /* UI: tab, group, label, help text */
+    const char* group;
+    const char* label;
+    const char* tip;
+    opt_type    type;
+    opt_apply   apply;
+    const char* values;     /* OPT_ENUM: "game|2|4|8|16"; OPT_INT/FLOAT: extra words ("auto") */
+    const char* labels;     /* OPT_ENUM: the matching UI text, '|' separated */
+    double      lo, hi, step;
+    const char* dflt;       /* built-in default = today's behaviour */
+    const char* env;        /* single-setting env variable, or NULL */
+    const char* env_multi;  /* "k=v|k=v" env variable that may also set it (DISPLAY_CFG, ...) */
+    const char* preset[OPT_NPRESETS];   /* NULL: the preset leaves it alone */
+    unsigned    flags;      /* OPT_F_* */
+    const char* owner;      /* module that implements it (logs / UI) */
+    int       (*check)(const char* v);  /* OPT_TEXT validator (1 = ok), or NULL */
+} opt_def;
+
+typedef int opt_id;          /* -1 = no such setting */
+
+/* Registration. Any time, any thread; a row registered after the files were
+ * read resolves its value at once. The toolkit's own rows (frame limit,
+ * vsync, display, input, ...) are built in. Returns the id, or -1 (duplicate
+ * key, table full, or a default its own row rejects). */
+opt_id   opt_register(const opt_def* d);
+opt_id   opt_find(const char* key);                 /* by key or alias */
+int      opt_count(void);
