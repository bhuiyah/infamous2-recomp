+/* Vertices + indices of one DRAW_ARRAYS / DRAW_INDEX_ARRAY entry for record
+ * dr (rsx_vemit_run: the triangle-list expansion as u32 indices into this
+ * parity's half of vp_ib, each distinct vertex converted once -- reused from
+ * the converted-vertex cache, or converted into this batch's stream half).
+ * Returns the number of indices emitted (0: nothing drawn). */
+static u32 vnew_upload(D3D12DrawRecord* dr, const rsx_state* st, u32 prim, u32 first,
+                       u32 count, int indexed)
+{
+    if ((u64)s_d3d.vp_ib_used + rsx_vexpand_count(prim, count) > VP_IB_HALF) return 0;
+    rsx_vemit e;
+    memset(&e, 0, sizeof e);
+    e.st = st; e.prim = prim; e.first = first; e.count = count; e.indexed = indexed;
+    e.mask = dr->vmask; e.stride = dr->vstride;
+    e.arena = (u8*)s_d3d.vp_vb_mapped;
+    e.half0 = (u64)s_d3d.vp_parity * VP_VB_HALF; e.half_bytes = VP_VB_HALF;
+    e.vb_used = s_d3d.vp_vb_offset;
+    e.ib = (u32*)s_d3d.vp_ib_mapped + (u64)s_d3d.vp_parity * VP_IB_HALF + s_d3d.vp_ib_used;
+    e.dd = &s_vdd; e.dd_sig = &s_vdd_sig;
+    e.vc = s_vc.nent ? &s_vc : NULL;
+    e.batch = s_d3d.vbatch;
+    const u32 n = vraw_on() ? vraw_probe_run(&e, st, prim, first, count, indexed, dr->vmask)
+                            : rsx_vemit_run(&e);
+    if (!n) return 0;
+    s_d3d.vp_vb_offset = e.vb_used;
+    s_d3d.vp_ib_used += n;
+    s_vn_conv += e.converted;
+    return n;
+}
