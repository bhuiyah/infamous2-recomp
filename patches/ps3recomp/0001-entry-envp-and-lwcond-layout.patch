+/* Create the device objects the packs need (render thread, once). */
+static int tp_rt_device_init(void)
+{
+    if (s_tp.dfence) return 0;
+    if (FAILED(s_tp.dev->lpVtbl->CreateFence(s_tp.dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&s_tp.dfence)) ||
+        FAILED(s_tp.dev->lpVtbl->CreateFence(s_tp.dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&s_tp.cfence))) {
+        tp_log("fence creation failed: texture packs off"); return -1;
+    }
+    D3D12_DESCRIPTOR_HEAP_DESC hd; memset(&hd, 0, sizeof hd);
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV; hd.NumDescriptors = TP_DESC_BLOCKS * TP_DV;
+    if (FAILED(s_tp.dev->lpVtbl->CreateDescriptorHeap(s_tp.dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_tp.cpu_heap))) {
+        tp_log("descriptor heap creation failed: texture packs off"); return -1;
+    }
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_tp.cpu_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_tp.cpu_heap, &h);
+    s_tp.cpu_base = h.ptr;
+    s_tp.inc = s_tp.dev->lpVtbl->GetDescriptorHandleIncrementSize(s_tp.dev, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    for (int i = 0; i < TP_DESC_BLOCKS; i++) s_tp.desc_free[i] = TP_DESC_BLOCKS - 1 - i;
+    s_tp.ndesc_free = TP_DESC_BLOCKS;
+    { D3D12_FEATURE_DATA_D3D12_OPTIONS8 o8; memset(&o8, 0, sizeof o8);   /* thin DXT textures (256x1) as DDS */
+      if (SUCCEEDED(s_tp.dev->lpVtbl->CheckFeatureSupport(s_tp.dev, D3D12_FEATURE_D3D12_OPTIONS8, &o8, sizeof o8)))
+          s_tp.unaligned_bc = o8.UnalignedBlockTexturesSupported ? 1 : 0; }
+    return 0;
+}
