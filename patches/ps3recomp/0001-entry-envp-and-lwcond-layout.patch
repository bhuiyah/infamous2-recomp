+    return p;
+}
+
+/* A pixel-aligned quad [x0,x1) x [y0,y1) at depth z: 6 vertices. */
+static void quad(float* v, float x0, float y0, float x1, float y1, float z)
+{
+    const float l = 2.0f * x0 / W - 1.0f, r = 2.0f * x1 / W - 1.0f;
+    const float t = 1.0f - 2.0f * y0 / H, b = 1.0f - 2.0f * y1 / H;
+    const float p[6][3] = { {l, t, z}, {r, t, z}, {l, b, z}, {l, b, z}, {r, t, z}, {r, b, z} };
+    memcpy(v, p, sizeof p);
+}
+
+int main(void)
+{
+    HRESULT hr;
