+         * changing (it parked with &info->ctx, or main with ppu_run's). */
+        at = tier = rv = 0;
+        num = obj = 0;
+        c = pput_live_ctx(t, tid, &s->p.ctx_src);
+        if (!c) return -1;                    /* main's slot without main's context */
+    }
+    s->ctx = c;
+    s->p.at = at;
+    s->p.tier = tier;
+    s->p.kind = at == SS_IN_WAIT ? num : 0;
+    s->p.num = at == SS_IN_WAIT ? 0 : num;
+    s->p.obj = obj;
+    if (at) {
+        const int sc = at == SS_AT_SC || (at == SS_IN_WAIT && ss_wait_is_syscall((int)num));
