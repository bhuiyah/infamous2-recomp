+static void ppu_sc_tick(void)
+{
+    s_sc_checks.fetch_add(t_sc_batch, std::memory_order_relaxed);
+    t_sc_batch = 0;
+    uint64_t due = s_sc_next_ms.load(std::memory_order_relaxed);
+    const uint64_t now = GetTickCount64();
