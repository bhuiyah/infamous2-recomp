+
+static void fill_env_ex(ovl_menu_env* e, int pad_kind, int with_adapter)
+{
+    static char adapter[96];
+    static int have_adapter;
+    if (with_adapter && !have_adapter && s_dev) {
+        have_adapter = 1;
+        LUID luid;
+        s_dev->lpVtbl->GetAdapterLuid(s_dev, &luid);    /* the C binding returns structs through a pointer */
+        IDXGIFactory4* f4 = NULL;
+        if (SUCCEEDED(CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&f4)) && f4) {
+            IDXGIAdapter1* ad = NULL;
+            if (SUCCEEDED(f4->lpVtbl->EnumAdapterByLuid(f4, luid, &IID_IDXGIAdapter1, (void**)&ad)) && ad) {
+                DXGI_ADAPTER_DESC1 dd;
+                if (SUCCEEDED(ad->lpVtbl->GetDesc1(ad, &dd)))
+                    WideCharToMultiByte(CP_UTF8, 0, dd.Description, -1, adapter, (int)sizeof adapter, NULL, NULL);
+                ad->lpVtbl->Release(ad);
+            }
+            f4->lpVtbl->Release(f4);
+        }
+    }
+    memset(e, 0, sizeof *e);
+    if (with_adapter) snprintf(e->adapter, sizeof e->adapter, "%s", adapter);
+    snprintf(e->title, sizeof e->title, "%s", g_rsx_title_base[0] ? g_rsx_title_base : "ps3recomp");
+    snprintf(e->host, sizeof e->host, "%s", s_host == 1 ? "DirectComposition (its own swap chain, composed by the desktop)"
+                                         : "the game's backbuffer (fallback)");
+    snprintf(e->build, sizeof e->build, "%s %s", __DATE__, __TIME__);
+    HMONITOR mon = MonitorFromWindow(s_top, MONITOR_DEFAULTTONEAREST);
+    MONITORINFOEXA mi;
+    memset(&mi, 0, sizeof mi);
+    mi.cbSize = sizeof mi;
+    if (GetMonitorInfoA(mon, (MONITORINFO*)&mi)) {
+        e->work_w = mi.rcWork.right - mi.rcWork.left;
+        e->work_h = mi.rcWork.bottom - mi.rcWork.top;
+        DEVMODEA dm;
+        memset(&dm, 0, sizeof dm);
+        dm.dmSize = sizeof dm;
+        if (EnumDisplaySettingsA(mi.szDevice, ENUM_CURRENT_SETTINGS, &dm) && dm.dmDisplayFrequency > 1)
+            e->refresh_hz = dm.dmDisplayFrequency;
+    }
+    EnumDisplayMonitors(NULL, NULL, env_mon, (LPARAM)e);
+    e->pad_kind = pad_kind;
+    e->paused = pause_reported();
+}
