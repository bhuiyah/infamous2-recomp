+#!/usr/bin/env python3
+"""Summarise a save-state census run (SS_CENSUS, runtime/savestate/ss_core.c).
+
+    py tools/ss_census.py [--log logs/run-X.log] [--chains ss_chains.txt]
+                          [--seed cont_seed.txt] [--min-attempts N] [--skip-first-s S]
+                          [--min-span-s S] [--baseline logs/run-Y.log] [--fps-ratio R]
+                          [--strict [--strict-min F] [--cont report.txt ...]
+                           [--missing list.txt]]
+
+--log     the run log (UTF-16 from run.ps1, or UTF-8): the "[ss] census #N" lines
+--chains  the chain file the run wrote (SS_CHAINS, default ss_chains.txt)
+--seed    write the distinct guest return sites seen in parked chains, grouped
+          by owning function -- the seed list for M3's --cont-list
+--baseline the same route run WITHOUT SS_CENSUS: the median FPS_LOG frame rate
+          of the census run (after --skip-first-s) must be at least --fps-ratio
+          (default 0.90) of the baseline's
+--min-span-s  the census lines must cover at least this many seconds (default 0)
+--strict  the strict-pass check (save-state engine M4a-0): would a strict save
+          have been accepted at each converged stop? Every parked PPU thread
+          must pass the walk a save runs (the engine's "  strict" line: every
+          frame has a continuation and agrees with the stack, up to the root),
+          be parked in a kind the resumers handle, outside a guest callback and
+          a libsre bridge; no straggler; every SPU parked at a drain hop or at an
+          audited host-wait pc (--spu-audited). Prints the pass share, the
+          blockers per thread, and the uncovered return addresses split by
+          image (libsre_ -> config/ss_cont_list_libsre.txt, the EBOOT ->
+          config/ss_cont_list.txt). --strict-min (default 0.95) is the verdict.
+--cont    (repeatable) the lifter's continuation reports
+          (generated/ppu/ppu_recomp_cont.txt, generated/prx/libsre_ns/
+          ppu_recomp_cont.txt): judges chains files written before the engine
+          printed "  strict" lines, by table membership and exit model only
+--missing write the uncovered return addresses in --cont-list form
+Prints convergence statistics, the M2 pass/fail verdict (>= 95% of attempts
+converge within 500 ms, at least --min-attempts attempts, chains written),
+straggler and refusal tallies, per-thread park tiers/times, link-check
+failures (a chain return address whose preceding word is not a call), and
+any "[ss] M0 CHECK" lines; a "[ss] WATCHDOG" line (a stop the coordinator
+never finished) fails the run. Exit status 0 = pass, 1 = fail, 2 = no data.
+"""
+import argparse
+import collections
+import os
+import re
+import sys
+
+
+def read_text(path):
+    data = open(path, "rb").read()
+    if data[:2] in (b"\xff\xfe", b"\xfe\xff") or data[1:2] == b"\x00":
+        return data.decode("utf-16", errors="replace")
+    return data.decode("utf-8", errors="replace")
+
+
+def pct(v, p):
+    if not v:
+        return 0.0
+    s = sorted(v)
+    return s[min(len(s) - 1, int(round(p * (len(s) - 1))))]
+
+
+CENSUS = re.compile(r"\[ss\] census #(\d+) t=([\d.]+)s (OK|FAIL)\s*(\S*)\s*ppu=([\d.]+)ms (\d+)/(\d+) parked"
+                    r".*?stop=([\d.]+)ms mixer=(\S+) audioq=(-?\d+)/(\d+)")
+FPS = re.compile(r"\[fps\] ([\d.]+) draws=\d+ t=(\d+)s")
+STRAG = re.compile(r"\[ss\]\s+STRAGGLER tid=(\d+) '([^']*)' in sc=(\d+) hle=(\S+).*?; (.*?); host:(.*)$")
+
+
+def fps_median(text, skip_s):
+    v = [float(m.group(1)) for m in FPS.finditer(text) if float(m.group(2)) >= skip_s]
+    return (pct(v, 0.5), len(v)) if v else (None, 0)
+
+
+def parse_log(text, skip_s):
+    att, strag, m0 = [], collections.Counter(), collections.Counter()
+    for line in text.splitlines():
+        m = CENSUS.search(line)
+        if m:
+            t = float(m.group(2))
+            if t < skip_s:
+                continue
+            att.append(dict(n=int(m.group(1)), t=t, ok=m.group(3) == "OK", why=m.group(4) or "",
+                            ppu=float(m.group(5)), parked=int(m.group(6)), total=int(m.group(7)),
+                            stop=float(m.group(8)), mixer=m.group(9),
+                            aq=int(m.group(10)), aqcap=int(m.group(11))))
+            continue
+        m = STRAG.search(line)
+        if m:
+            what = m.group(5)
+            what = re.sub(r"[\d.]+ms ago", "", what)
+            what = re.sub(r"lr=0x[0-9A-F]+", "", what)
+            strag[(m.group(1), m.group(2), m.group(3), m.group(4), what.strip(), m.group(6).strip())] += 1
+            continue
+        if "[ss] M0 CHECK" in line or "[ss] WARNING" in line or "[ss] WATCHDOG" in line:
+            m0[line.split("[ss]", 1)[1].strip()] += 1
+    return att, strag, m0
+
+
+def parse_chains(text):
+    censuses, cur, thr = [], None, None
+    for line in text.splitlines():
+        if line.startswith("census "):
+            cur = dict(head=line, threads=[], spus=[], stragglers=[])
+            cur["ok"] = "status=ok" in line
+            censuses.append(cur)
+        elif cur is None:
+            continue
+        elif line.startswith("thread "):
+            kv = dict(re.findall(r'(\w+)=("[^"]*"|\S+)', line))
+            thr = dict(tid=int(kv["tid"]), name=kv["name"].strip('"'), tier=int(kv["tier"]),
+                       at=kv["at"], ms=float(kv["ms"]), br=int(kv["br"]), cb=int(kv.get("cb", "0")),
+                       frames=[], ra0=None, end=None)
+            cur["threads"].append(thr)
+        elif line.startswith("  ra0 ") and thr is not None:
+            m = re.search(r"ra=0x([0-9A-F]+) (\S+) link=(\S+)", line)
+            if m:
+                thr["ra0"] = (int(m.group(1), 16), m.group(2), m.group(3))
+        elif line.startswith("  frame ") and thr is not None:
+            m = re.search(r"ra=0x([0-9A-F]+) (\S+) link=(\S+)", line)
+            if m:
+                thr["frames"].append((int(m.group(1), 16), m.group(2), m.group(3)))
+        elif line.startswith("  end ") and thr is not None:
+            thr["end"] = line.split()[1]
+        elif line.startswith("  strict ") and thr is not None:
+            # "  strict <verdict> frames=N end=<root> rec=0|1 [at=0x..] [missing=0x..,0x..]"
+            f = line.split()
+            kv = dict(x.split("=", 1) for x in f[2:] if "=" in x)
+            thr["strict"] = dict(verdict=f[1], at=kv.get("at"), rec=kv.get("rec"), end=kv.get("end"),
+                                 missing=[int(x, 16) for x in kv["missing"].split(",")] if kv.get("missing") else [])
+        elif line.startswith("straggler "):
+            cur["stragglers"].append(line)
+        elif line.startswith("spu "):
+            cur["spus"].append(line)
+    return censuses
+
+
+# ---- the strict-pass check (--strict) --------------------------------------
+# Park kinds the save-state resumers handle (engine design §4.4: re-issue for
+# the S1/S2 entries and most waits, remaining time for sleeps, an exact re-wait
+# for lwcond). A kind outside this set blocks a strict save.
+RESUMER_KINDS = {"sem", "equeue", "eflag", "join", "spu_join", "mutex", "lwmutex", "spinlock", "net",
+                 "usleep", "sleep", "lwcond", "lwcond_reacq", "cond"}
+# SPU host waits whose pc is exact or restartable (SPU study; census 2026-10-15).
+SPU_AUDITED = "41:ch-wait:0x1178,41:wait-signal:0xA70,2:stop-receive:0xFA08"
+LIBSRE_LO, LIBSRE_HI = 0x30000000, 0x30040000
+
+
+def load_cont_reports(paths):
+    """The lifter's <base>_cont.txt reports -> {ra: exit} ('returns', 'never', 'unknown', 'partial')."""
+    t = {}
+    for p in paths or []:
+        for line in open(p, encoding="utf-8", errors="replace"):
+            m = re.match(r"0x([0-9A-Fa-f]{8})\s+\S+\s+after ", line)
+            if not m:
+                continue
+            if "UNKNOWN" in line or "NOT A CALL" in line:
+                ex = "unknown"
+            elif "(partial" in line:
+                ex = "partial"
+            elif " never returns" in line:
+                ex = "never"
+            else:
+                ex = "returns"
+            t[int(m.group(1), 16)] = ex
+    return t
+
+
+def judge_by_table(thr, table):
+    """Coverage of a chain from the reports alone (no stack checks): ra0, then
+    the frames' return addresses until a continuation that never returns or
+    the root (0)."""
+    ra0 = thr["ra0"][0] if thr["ra0"] else 0
+    if not ra0:
+        return dict(verdict="no-ra", missing=[])
+    miss = []
+    for ra in [ra0] + [f[0] for f in thr["frames"]]:
+        if ra == 0:
+            break
+        ex = table.get(ra)
+        if ex is None:
+            miss.append(ra)
+            continue
+        if ex in ("unknown", "partial"):
+            return dict(verdict="not-covered:" + ("partial" if ex == "partial" else "unmodelled"), missing=miss)
+        if ex == "never" and not miss:
+            break
+    return dict(verdict="not-covered:missing" if miss else "ok", missing=miss)
+
+
+def strict_report(cs, a):
+    audited = set()
+    for tok in (a.spu_audited or "").split(","):
+        if tok.strip():
+            img, where, pc = tok.strip().split(":")
+            audited.add((int(img), where, int(pc, 16)))
+    table = load_cont_reports(a.cont) if a.cont else None
+    okc = [c for c in cs if c["ok"]]
+    have_engine = any("strict" in t for c in okc for t in c["threads"])
+    if not have_engine and table is None:
+        print("strict: the chains file has no '  strict' lines (a build before M4a-0): pass --cont reports")
+        return None
+    passed, reasons = 0, collections.Counter()
+    per = collections.defaultdict(lambda: dict(name="", parks=0, bad=0, why=collections.Counter()))
+    miss_by_ra = collections.defaultdict(lambda: [0, set()])
+    spu_bad = collections.Counter()
+    for c in okc:
+        why_stop = set()
+        if c["stragglers"]:
+            why_stop.add("straggler")
+        for t in c["threads"]:
+            p = per[t["tid"]]
+            p["name"] = t["name"]
+            p["parks"] += 1
+            st = t.get("strict") if have_engine else judge_by_table(t, table)
+            bad = []
+            if st is None:
+                bad.append("no-strict-line")
+            elif st["verdict"] != "ok":
+                bad.append(st["verdict"] + (" at=" + st["at"] if st.get("at") else ""))
+                for ra in st["missing"]:
+                    miss_by_ra[ra][0] += 1
+                    miss_by_ra[ra][1].add(f"{t['tid']} {t['name']}")
+            at = t["at"]
+            if at.startswith("wait:"):
+                kind = at.split(":")[1]
+                if kind not in RESUMER_KINDS:
+                    bad.append("no-resumer:" + kind)
+            elif not (at.startswith("sc:") or at.startswith("hle:")):
+                bad.append("park:" + at)
+            if t["br"] > 0:
+                bad.append("bridge")
+            if t.get("cb", 0) > 0:
+                bad.append("callback")
+            if bad:
+                p["bad"] += 1
+                for b in bad:
+                    p["why"][b] += 1
+                why_stop.add("ppu")
+        for s in c["spus"]:
+            kv = dict(re.findall(r"(\w+)=(\S+)", s))
+            parked = " parked " in s
+            where = kv.get("where", "-")
+            pc = int(kv.get("pc", "0"), 16)
+            img = int(kv.get("img", "0"))
+            if not parked:
+                spu_bad[f"tid={kv.get('tid')} not-parked"] += 1
+                why_stop.add("spu")
+            elif where != "hop" and (img, where, pc) not in audited:
+                spu_bad[f"tid={kv.get('tid')} {where} pc=0x{pc:X} img={img}"] += 1
+                why_stop.add("spu")
+        if why_stop:
+            for w in why_stop:
+                reasons[w] += 1
+        else:
+            passed += 1
+    n = len(okc)
+    share = passed / n if n else 0.0
+    src = "engine walk" if have_engine else "cont reports (no stack checks)"
+    print(f"strict-pass ({src}): {passed}/{n} converged stops would accept a strict save "
+          f"({100.0 * share:.1f}%)" + (f"; blocked by: " + ", ".join(f"{k} x{v}" for k, v in reasons.most_common())
+                                        if reasons else ""))
+    print("  tid name                       parks blocked  reasons")
+    for tid in sorted(per):
+        p = per[tid]
+        why = ", ".join(f"{k} x{v}" for k, v in p["why"].most_common(3))
+        print(f"  {tid:3d} {p['name'][:26]:26s} {p['parks']:5d} {p['bad']:7d}  {why}")
+    if spu_bad:
+        print("  SPU parks outside the audited pcs:", ", ".join(f"{k} x{v}" for k, v in spu_bad.most_common(8)))
+    if miss_by_ra:
+        print(f"  uncovered return addresses ({len(miss_by_ra)}):")
+        for ra, (k, who) in sorted(miss_by_ra.items(), key=lambda kv: -kv[1][0]):
+            img = "libsre" if LIBSRE_LO <= ra < LIBSRE_HI else "eboot"
+            print(f"    0x{ra:08X} {img:6s} x{k:<5d} {'; '.join(sorted(who))[:80]}")
+    if a.missing:
+        with open(a.missing, "w", newline="\n") as f:
+            f.write("# uncovered return addresses of parked chains (ss_census.py --strict)\n")
+            for lab, lo, hi in (("libsre_ -> config/ss_cont_list_libsre.txt", LIBSRE_LO, LIBSRE_HI),
+                                ("EBOOT -> config/ss_cont_list.txt", 0, LIBSRE_LO)):
+                ras = sorted(r for r in miss_by_ra if lo <= r < hi)
+                if ras:
+                    f.write(f"# {lab}\n")
+                    for ra in ras:
+                        k, who = miss_by_ra[ra]
+                        f.write(f"0x{ra:08X}   # x{k} {'; '.join(sorted(who))[:100]}\n")
+        print(f"  wrote {a.missing}")
+    return share
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--log")
+    ap.add_argument("--chains")
+    ap.add_argument("--seed")
+    ap.add_argument("--min-attempts", type=int, default=60)
+    ap.add_argument("--skip-first-s", type=float, default=0.0)
+    ap.add_argument("--min-span-s", type=float, default=0.0)
+    ap.add_argument("--baseline")
+    ap.add_argument("--fps-ratio", type=float, default=0.90)
+    ap.add_argument("--strict", action="store_true")
+    ap.add_argument("--strict-min", type=float, default=0.95)
+    ap.add_argument("--cont", action="append")
+    ap.add_argument("--missing")
+    ap.add_argument("--spu-audited", default=SPU_AUDITED,
+                    help="img:where:pc,... SPU host-wait parks a strict save accepts (default %(default)s)")
+    a = ap.parse_args()
+    if not a.log and not a.chains:
+        ap.print_help()
+        return 2
+    verdict = []
+    if a.log:
+        log_text = read_text(a.log)
+        att, strag, m0 = parse_log(log_text, a.skip_first_s)
+        n = len(att)
+        if not n:
+            print("log: no [ss] census lines (was SS_CENSUS set?)")
+            return 2
+        ok = [x for x in att if x["ok"]]
+        w500 = [x for x in ok if x["ppu"] <= 500.0]
+        fails = collections.Counter(x["why"] for x in att if not x["ok"])
+        print(f"attempts {n} (t={att[0]['t']:.0f}..{att[-1]['t']:.0f} s): ok {len(ok)} "
+              f"({100.0 * len(ok) / n:.1f}%), within 500 ms {len(w500)} ({100.0 * len(w500) / n:.1f}%)")
+        if fails:
+            print("  failures:", ", ".join(f"{k} x{v}" for k, v in fails.most_common()))
+        pv = [x["ppu"] for x in ok]
+        sv = [x["stop"] for x in ok]
+        print(f"  PPU convergence ms: p50 {pct(pv, .5):.1f}  p95 {pct(pv, .95):.1f}  max {max(pv) if pv else 0:.1f}")
+        print(f"  whole stop ms:      p50 {pct(sv, .5):.1f}  p95 {pct(sv, .95):.1f}  max {max(sv) if sv else 0:.1f}")
+        late = sum(1 for x in att if x["mixer"] == "LATE")
+        aq = [x["aq"] for x in att if x["aqcap"]]
+        print(f"  mixer late {late}; audio notify queue fill at park: max {max(aq) if aq else 0}"
+              f"/{max((x['aqcap'] for x in att), default=0)}")
+        if strag:
+            print("  stragglers (tid name sc hle what host):")
+            for k, v in strag.most_common(15):
+                print(f"    x{v:<4} tid={k[0]} '{k[1]}' sc={k[2]} hle={k[3]} | {k[4]} | host:{k[5]}")
+        for k, v in m0.items():
+            print(f"  [{v}x] {k}")
+        frac = len(w500) / n
+        verdict.append((frac >= 0.95, f">=95% of attempts converge within 500 ms: {100.0 * frac:.1f}%"))
+        verdict.append((n >= a.min_attempts, f"at least {a.min_attempts} attempts: {n}"))
+        span = att[-1]["t"] - att[0]["t"]
+        if a.min_span_s:
+            verdict.append((span >= a.min_span_s, f"census lines span at least {a.min_span_s:.0f} s: {span:.0f} s"))
+        wd = sum(v for k, v in m0.items() if k.startswith("WATCHDOG"))
+        verdict.append((wd == 0, f"no watchdog release (a stop left unfinished): {wd}"))
+        f_run, n_run = fps_median(log_text, a.skip_first_s)
+        if f_run is not None:
+            print(f"  fps (FPS_LOG) median {f_run:.2f} over {n_run} s")
+        if a.baseline:
+            f_base, n_base = fps_median(read_text(a.baseline), a.skip_first_s)
+            if f_run is None or f_base is None:
+                verdict.append((False, "fps comparison: FPS_LOG=1 lines missing in the run or the baseline"))
+            else:
+                r = f_run / f_base if f_base else 0.0
+                verdict.append((r >= a.fps_ratio, f"fps within noise: median {f_run:.2f} vs baseline "
+                                f"{f_base:.2f} ({100.0 * r:.1f}%, need >= {100.0 * a.fps_ratio:.0f}%)"))
+    if a.chains:
+        if not os.path.exists(a.chains):
+            verdict.append((False, f"chains file exists: {a.chains} missing"))
+        else:
+            cs = parse_chains(read_text(a.chains))
+            okc = [c for c in cs if c["ok"]]
+            verdict.append((len(okc) > 0, f"chains file has ok censuses: {len(okc)} of {len(cs)}"))
+            per = collections.defaultdict(lambda: dict(n=0, t1=0, ms=[], at=collections.Counter(),
+                                                       depth=collections.Counter(), name=""))
+            sites = collections.defaultdict(collections.Counter)
+            badlink, ends, bridges = collections.Counter(), collections.Counter(), 0
+            for c in okc:
+                for t in c["threads"]:
+                    p = per[t["tid"]]
+                    p["n"] += 1; p["name"] = t["name"]
+                    p["t1"] += t["tier"] == 1
+                    p["ms"].append(t["ms"])
+                    p["at"][re.sub(r":0x[0-9A-F]+$", "", t["at"]) if t["at"].startswith("wait") else t["at"]] += 1
+                    p["depth"][len(t["frames"])] += 1
+                    ends[t["end"]] += 1
+                    bridges += t["br"] > 0
+                    for ra, fn, link in ([t["ra0"]] if t["ra0"] else []) + t["frames"]:
+                        if fn.startswith("func_"):
+                            sites[fn.split("+")[0]][ra] += 1
+                        if link == "?" and ra:
+                            badlink[(t["tid"], fn)] += 1
+            print(f"chains: {len(cs)} census blocks, {len(okc)} ok; chain ends {dict(ends)}; "
+                  f"{bridges} thread-parks inside a libsre bridge")
+            print("  tid name                      parks tier1  ms p50/p95/max     at (top 3)                depth")
+            for tid in sorted(per):
+                p = per[tid]
+                ats = ", ".join(f"{k} x{v}" for k, v in p["at"].most_common(3))
+                dep = "/".join(str(d) for d in sorted(p["depth"]))
+                print(f"  {tid:3d} {p['name'][:24]:24s} {p['n']:6d} {p['t1']:5d}  "
+                      f"{pct(p['ms'], .5):6.1f}/{pct(p['ms'], .95):6.1f}/{max(p['ms']):6.1f}  {ats[:44]:44s} {dep}")
+            nsite = sum(len(v) for v in sites.values())
+            print(f"  distinct return sites {nsite} in {len(sites)} functions")
+            if badlink:
+                print(f"  link-check failures (return address not after a call): {sum(badlink.values())}")
+                for (tid, fn), v in badlink.most_common(10):
+                    print(f"    x{v} tid={tid} {fn}")
+            if a.seed:
+                with open(a.seed, "w", newline="\n") as f:
+                    f.write("# save-state continuation seed: functions owning return sites seen in parked\n"
+                            "# chains (ss_census.py). One function per line, its return addresses after.\n")
+                    for fn in sorted(sites):
+                        f.write(fn + " " + " ".join(f"0x{ra:08X}" for ra in sorted(sites[fn])) + "\n")
+                print(f"  wrote {a.seed}")
+            if a.strict:
+                share = strict_report(cs, a)
+                verdict.append((share is not None and share >= a.strict_min,
+                                f"strict-pass share >= {100.0 * a.strict_min:.0f}% of converged stops: "
+                                + ("n/a" if share is None else f"{100.0 * share:.1f}%")))
+    print("verdict:")
+    good = True
+    for ok, text in verdict:
+        good &= ok
+        print(f"  {'PASS' if ok else 'FAIL'}  {text}")
+    return 0 if good else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
