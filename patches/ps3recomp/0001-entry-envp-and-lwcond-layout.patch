+#pragma comment(lib, "winmm.lib")
+
+ppu_thread_info g_ppu_threads[PPU_THREAD_MAX];
+uint8_t* vm_base;
+/* sys_ppu_thread.c's PPUT hook; arming sets it to ss_core.c's park records */
+int (*g_ppu_ss_park_of)(unsigned tid, int* at, int* tier, uint32_t* num, uint32_t* obj,
+                        const ppu_context** ctx, struct ss_sr_root* root, int* root_valid);
+
+static int g_fail;
+#define CHECK(c, ...) do { if (!(c)) { g_fail++; printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+                                         printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static volatile LONG g_quit;
+static volatile LONG g_cb_stuck;          /* tid 6 stays inside its callback */
+static volatile LONG g_cbwait;            /* tid 7 waits on a CV inside a callback */
+static volatile LONG g_cbwait_iters;      /* its wait-loop iterations */
+static volatile LONG g_prog[8];           /* per fake PPU thread */
+static volatile LONG g_spu_prog[4];
+static volatile LONG g_mix_prog;
+static volatile LONG g_force_on, g_force_off;
+static volatile LONG g_spu3_quiet;        /* the unregistered SPU context stops hopping */
+static volatile LONG g_walk_all_ok;       /* the strict walk passes syscall parks too */
+static volatile LONG g_file_open;         /* the fake "file open for writing" check blocks */
+static HANDLE g_wake;
+static unsigned g_flip;                   /* the fake guest flip count */
+
+/* ---- fake guest memory: code with `bl` call sites, and per-thread stacks */
+#define CODE_BASE   0x00100000u
+#define STACK_BASE  0x01000000u
+#define STACK_SIZE  0x00010000u
+static void w32(uint32_t a, uint32_t v)
+{
+    vm_base[a] = (uint8_t)(v >> 24); vm_base[a + 1] = (uint8_t)(v >> 16);
+    vm_base[a + 2] = (uint8_t)(v >> 8); vm_base[a + 3] = (uint8_t)v;
+}
+/* function k lives at CODE_BASE + k*0x100; its call site to function k+1 is
+ * at +0x40, so the return address into function k is +0x44 */
+static uint32_t fn_addr(int k) { return CODE_BASE + (uint32_t)k * 0x100u; }
+static uint32_t ra_in(int k) { return fn_addr(k) + 0x44u; }
+static void build_code(void)
+{
+    for (int k = 0; k < 16; k++) {
+        const uint32_t site = fn_addr(k) + 0x40u, tgt = fn_addr(k + 1);
+        w32(site, 0x48000001u | ((tgt - site) & 0x03FFFFFCu));           /* bl fn(k+1) */
+    }
+}
+/* Three frames for thread `tid`: innermost function 3, called from 2, from 1,
+ * from 0, whose caller's frame is the root. Returns r1. */
+static uint32_t build_stack(unsigned tid)
+{
+    const uint32_t top = STACK_BASE + tid * STACK_SIZE + STACK_SIZE - 48;
+    const uint32_t f0 = top - 0x80, f1 = f0 - 0x80, f2 = f1 - 0x80, f3 = f2 - 0x80;
+    memset(vm_base + top - 0x400, 0, 0x400);
+    /* back chains */
+    w32(f3 + 4, f2); w32(f2 + 4, f1); w32(f1 + 4, f0); w32(f0 + 4, top); w32(top + 4, 0);
+    /* saved LRs at caller_sp + 0x10 (low word +0x14): f3's function returns into 2 ... */
+    w32(f2 + 0x14, ra_in(2)); w32(f1 + 0x14, ra_in(1)); w32(f0 + 0x14, ra_in(0)); w32(top + 0x14, 0);
+    return f3;
+}
+
+/* ---- fake ops ------------------------------------------------------------ */
+static uint32_t fake_func_start(uint32_t a)
+{
+    if (a < CODE_BASE || a >= CODE_BASE + 0x2000u) return 0;
+    return CODE_BASE + ((a - CODE_BASE) & ~0xFFu);
+}
+static int fake_is_code(uint32_t a) { return fake_func_start(a) != 0; }
+static void fake_icall(int* d, int* v) { *d = 3; *v = 1; }
+
+static uint32_t s_get = 0x1000, s_put = 0x1400;
+static int fake_walker_pass(void) { if (s_get < s_put) s_get += 0x100; return 1; }
+static void fake_walker_info(ss_walker_info* w)
+{
+    memset(w, 0, sizeof *w);
+    w->get = s_get; w->put = s_put; w->park_off = 0xFFFFFFFFu; w->acq_pos = 0xFFFFFFFFu;
+}
+static volatile LONG g_rebased;
+static void fake_rebase(unsigned long long ms) { (void)ms; InterlockedIncrement(&g_rebased); }
+static void fake_wake(void) { SetEvent(g_wake); }
+
+typedef struct { uint32_t pc, id; } fake_spu;
+static fake_spu g_spu[4] = { {0x100, 0x2000}, {0x200, 0x2001}, {0x300, 0x2002}, {0x400, 0x2FFF} };
+static void fake_describe(const void* c, ss_spu_desc* d)
+{
+    const fake_spu* s = (const fake_spu*)c;
+    memset(d, 0, sizeof *d);
+    d->pc = s->pc; d->spu_id = s->id; d->image_id = 7;
+}
+static void fake_force(int on) { if (on) InterlockedIncrement(&g_force_on); else InterlockedIncrement(&g_force_off); }
+static const ss_spu_ops k_spu_ops = { fake_describe, fake_force };
+
+/* ---- fake PPU threads ---------------------------------------------------- */
+typedef struct { unsigned tid; int kind; ppu_context ctx; } fthr;
+enum { K_MAIN, K_BLOCKER, K_CV, K_BUSY, K_SLEEPER, K_CALLBACK, K_CBWAIT };
+static HANDLE g_never;                    /* semaphore nobody posts */
+static CRITICAL_SECTION g_cs, g_cs2;
+static CONDITION_VARIABLE g_cvar, g_cvar2;
+static volatile int g_flag, g_flag2;
+
+static void spin_us(unsigned us)
+{
+    LARGE_INTEGER f, a, b;
+    QueryPerformanceFrequency(&f); QueryPerformanceCounter(&a);
+    do { QueryPerformanceCounter(&b); } while ((b.QuadPart - a.QuadPart) * 1000000 / f.QuadPart < us);
+}
+
+/* The census's strict walk (ss_sr_ops.walk; runtime/ppu/ppu_selfresume.cpp in
+ * the game): here it only checks that the thread's root record reached it --
+ * the record ss_root_enter keeps while a census is armed -- and answers "ok"
+ * for an HLE park, "not covered" (one missing return address) for a syscall. */
+static volatile LONG g_walks, g_walk_bad_root;
+static void fake_walk(const ppu_context* ctx, int at, const ss_sr_root* root, ss_sr_walk_out* o)
+{
+    memset(o, 0, sizeof *o);
+    InterlockedIncrement(&g_walks);
+    o->frames = 4;
+    const unsigned tid = (unsigned)ctx->thread_id;
+    if (!root || root->root_sp != (uint32_t)ctx->gpr[1] || root->stack_lo != STACK_BASE + tid * STACK_SIZE ||
+        root->stack_hi != STACK_BASE + tid * STACK_SIZE + STACK_SIZE) {
+        InterlockedIncrement(&g_walk_bad_root);
+        o->verdict = SS_SR_REFUSED_BASE + 11;
+        return;
+    }
+    if (at == SS_AT_HLE || g_walk_all_ok) { o->verdict = SS_SR_OK; o->root = 1; return; }
+    o->verdict = SS_SR_NOT_COVERED;
+    o->why = SS_SRW_MISSING;
+    o->err_ra = 0x00ABCDE0u;
+    o->nmiss = 1;
+    o->miss[0] = 0x00ABCDE0u;
+}
+static const char* fake_strerror(int e) { return e == 11 ? "root-sp" : "?"; }
+
+static DWORD WINAPI ppu_thread(LPVOID p)
+{
+    fthr* t = (fthr*)p;
+    ppu_context* c = &t->ctx;
+    static int s_jb_unused;                /* (P0 is not armed: the root's jmp_buf is never used) */
+    ss_root_enter(&s_jb_unused, c);        /* a census is armed: keeps the root record */
+    while (!g_quit) {
+        InterlockedIncrement(&g_prog[t->tid]);
+        switch (t->kind) {
+        case K_MAIN:
+            spin_us(200);
+            SS_SAFEPOINT(c, SS_AT_SC, 141, 0);
+            break;
+        case K_BUSY:
+            spin_us(300);
+            SS_SAFEPOINT(c, SS_AT_HLE, 0x1573DC3Fu, 0);
+            break;
+        case K_BLOCKER:
+            ss_wait_handle(c, g_never, 20, SS_W_SEM, 7);
+            break;
+        case K_CV:
+            EnterCriticalSection(&g_cs);
+            while (!g_flag && !g_quit) ss_sleep_cv_cs(c, &g_cvar, &g_cs, INFINITE, SS_W_EQUEUE, 3);
+            g_flag = 0;
+            LeaveCriticalSection(&g_cs);
+            break;
+        case K_SLEEPER:
+            SS_WAIT_POINT(c, SS_W_USLEEP, 1000);
+            Sleep(1);
+            break;
+        case K_CALLBACK:
+            ss_cb_enter();
+            do {
+                spin_us(100);
+                SS_SAFEPOINT(c, SS_AT_HLE, 0xC0FFEEu, 0);         /* refused: in a callback */
+                InterlockedIncrement(&g_prog[t->tid]);
+            } while (g_cb_stuck && !g_quit);
+            ss_cb_leave();
+            SS_SAFEPOINT(c, SS_AT_HLE, 0xBEEFu, 0);
+            break;
+        case K_CBWAIT:
+            if (!g_cbwait) { SS_WAIT_POINT(c, SS_W_USLEEP, 1000); Sleep(1); break; }
+            ss_cb_enter();
+            EnterCriticalSection(&g_cs2);
+            while (g_cbwait && !g_quit) {
+                InterlockedIncrement(&g_cbwait_iters);
+                while (!g_flag2 && !g_quit) {
+                    InterlockedIncrement(&g_cbwait_iters);
+                    ss_sleep_cv_cs(c, &g_cvar2, &g_cs2, INFINITE, SS_W_EQUEUE, 9);
+                }
+                g_flag2 = 0;
+            }
+            LeaveCriticalSection(&g_cs2);
+            ss_cb_leave();
+            break;
+        }
+    }
+    ss_root_leave();
+    return 0;
+}
+
+static DWORD WINAPI producer(LPVOID p)
+{
+    (void)p;
+    while (!g_quit) {
+        Sleep(3);
+        EnterCriticalSection(&g_cs);
+        g_flag = 1;
+        LeaveCriticalSection(&g_cs);
+        WakeAllConditionVariable(&g_cvar);
+        static int k;
+        if (++k % 2 == 0) {                   /* every ~6 ms for tid 7 */
+            EnterCriticalSection(&g_cs2);
+            g_flag2 = 1;
+            LeaveCriticalSection(&g_cs2);
+            WakeAllConditionVariable(&g_cvar2);
+        }
+    }
+    return 0;
+}
+
+static DWORD WINAPI spu_thread(LPVOID p)
+{
+    const int i = (int)(intptr_t)p;
+    fake_spu* s = &g_spu[i];
+    if (i < 3) ss_spu_thread_begin(s, s->id, 0x1000, SS_SPU_LIFTED, &k_spu_ops);
+    while (!g_quit) {
+        InterlockedIncrement(&g_spu_prog[i]);
+        if (i == 2) {                       /* sits in a channel wait */
+            Sleep(2);
+            if (SS_SPU_PENDING()) ss_spu_park_point(NULL, SS_SPU_W_CHANNEL);
+        } else {                            /* hops (#3 is not registered: foreign) */
+            spin_us(50);
+            s->pc += 4;
+            if (i == 3 && g_spu3_quiet) continue;
+            if (SS_SPU_PENDING()) ss_spu_park_point(s, SS_SPU_AT_HOP);
+        }
+    }
+    if (i < 3) ss_spu_thread_end();
+    return 0;
+}
+
+static DWORD WINAPI mixer_thread(LPVOID p)
+{
+    (void)p;
+    ss_mixer_present(1);
+    while (!g_quit) {
+        if (SS_UNLIKELY(g_ss_mix_req != 0)) ss_mixer_park_point(5, 8);
+        InterlockedIncrement(&g_mix_prog);
+        Sleep(2);
+    }
+    ss_mixer_present(0);
+    return 0;
+}
+
+/* ---- capture hook: nothing may move while the world is stopped ------------ */
+static volatile LONG g_captures, g_frozen_bad, g_park_recs, g_park_bad;
+static void on_capture(void* u)
+{
+    (void)u;
+    LONG a[8], b[8], sa[4], sb[4], ma, mb;
+    /* PPUT's view: every fake thread's park record, its own context */
+    for (unsigned tid = 1; tid <= 7 && g_ppu_ss_park_of; tid++) {
+        if (g_ppu_threads[tid - 1].state != PPU_THREAD_STATE_RUNNING) continue;
+        int at = 0, tier = 0, rv = 0;
+        uint32_t num = 0, obj = 0;
+        const ppu_context* c = NULL;
+        ss_sr_root root;
+        if (g_ppu_ss_park_of(tid, &at, &tier, &num, &obj, &c, &root, &rv) && c &&
+            c->thread_id == tid && at != SS_AT_NONE && (tier == 1 || tier == 2))
+            InterlockedIncrement(&g_park_recs);
+        else
+            InterlockedIncrement(&g_park_bad);
+    }
+    { int at, tier, rv; uint32_t num, obj; const ppu_context* c; ss_sr_root root;
+      if (g_ppu_ss_park_of && g_ppu_ss_park_of(8, &at, &tier, &num, &obj, &c, &root, &rv))
+          InterlockedIncrement(&g_park_bad); }       /* no thread 8: no record */
+    for (int i = 0; i < 8; i++) a[i] = g_prog[i];
+    for (int i = 0; i < 4; i++) sa[i] = g_spu_prog[i];
+    ma = g_mix_prog;
+    Sleep(15);
+    for (int i = 0; i < 8; i++) b[i] = g_prog[i];
+    for (int i = 0; i < 4; i++) sb[i] = g_spu_prog[i];
+    mb = g_mix_prog;
+    InterlockedIncrement(&g_captures);
+    for (int i = 1; i <= 7; i++)
+        if (a[i] != b[i]) { InterlockedIncrement(&g_frozen_bad); printf("  ppu tid %d moved during capture\n", i); }
+    for (int i = 0; i < 3; i++)
+        if (sa[i] != sb[i]) { InterlockedIncrement(&g_frozen_bad); printf("  spu %d moved during capture\n", i); }
+    if (ma != mb) { InterlockedIncrement(&g_frozen_bad); printf("  mixer moved during capture\n"); }
+}
+
+/* ---- a section of the test's own, TSTS (inert unless a phase-14 switch is
+ * set): its check() refuses g_tsec_refuse more stops (g_tsec_reason: the
+ * value it returns, one past the reasons = "no reason of its own"); its
+ * capture() writes a u64, and g_tsec_bytes of blob its size_hint never
+ * announces (an overflow). ----------------------------------------------- */
+static volatile LONG g_tsec_refuse, g_tsec_checks, g_tsec_captures;
+static int g_tsec_reason = SS_REASON__N + 7;
+static uint64_t g_tsec_bytes;
+static int tsec_check(char* why, size_t n)
+{
+    InterlockedIncrement(&g_tsec_checks);
+    if (g_tsec_refuse <= 0) return 0;
+    InterlockedDecrement(&g_tsec_refuse);
+    snprintf(why, n, "the fake object is half made");
+    return g_tsec_reason;
+}
+static int tsec_capture(ss_writer* w)
+{
+    InterlockedIncrement(&g_tsec_captures);
+    ss_write_u64(w, "captures", (uint64_t)g_tsec_captures);
+    if (g_tsec_bytes) {
+        ss_blob_begin(w, "big", 4096);
+        void* p = ss_blob_reserve(w, g_tsec_bytes);   /* NULL past the staging buffer's end: still counted */
+        if (p) memset(p, 0x5A, (size_t)g_tsec_bytes);
+        ss_blob_end(w);
+    }
+    return ss_writer_error(w);
+}
+static uint64_t tsec_hint(void) { return 4096; }
+static const ss_section_ops k_tsec_ops = {
+    SS_FOURCC('T', 'S', 'T', 'S'), 1, 0, SS_ORDER_TITLE + 50,
+    tsec_check, tsec_capture, NULL, NULL, NULL, "test section", NULL, tsec_hint,
+};
+SS_SECTION_REGISTER(k_tsec_ops)
+
+/* The renderer's GPU flush (ss_host_ops.gpu_idle): 0 idle at once, 1 "did
+ * not go idle", 2 stand until the stop's watchdog released the world (at
+ * most 6 s), 3 take 3.2 s -- longer than the watchdog's limit without its
+ * capture grace. */
+static volatile LONG g_gpu_mode, g_gpu_calls;
+static int fake_gpu_idle(void)
+{
+    InterlockedIncrement(&g_gpu_calls);
+    if (g_gpu_mode == 1) return -1;
+    if (g_gpu_mode == 2) {
+        const ULONGLONG end = GetTickCount64() + 6000;
+        while (g_ss_req && GetTickCount64() < end) Sleep(5);
+    }
+    if (g_gpu_mode == 3) Sleep(3200);
+    return 1;
+}
+
+static void run_clock(unsigned ms)
+{
+    const ULONGLONG end = GetTickCount64() + ms;
+    while (GetTickCount64() < end) {
+        WaitForSingleObject(g_wake, 2);
+        g_flip++;
+        ss_frame_tick(g_flip);
+    }
+    /* finish a stop in flight: nothing else ticks the coordinator */
+    for (int i = 0; i < 2000 && ss_stop_in_progress(); i++) {
+        WaitForSingleObject(g_wake, 2);
+        ss_frame_tick(++g_flip);
+    }
+}
+
+/* ---- requests ------------------------------------------------------------ */
+static volatile LONG g_done_n, g_done_ok, g_done_reason, g_done_user;
+static void on_done(int ok, int reason, void* user)
+{
+    g_done_ok = ok;
+    g_done_reason = reason;
+    g_done_user = (LONG)(intptr_t)user;
+    InterlockedIncrement(&g_done_n);
+}
+
+/* Submit one request and tick the coordinator (one flip per tick) until its
+ * done() ran or max_ms passed. Returns the submit result; *res = the result. */
+static int run_request(int purpose, double give_up_s, unsigned max_ms, ss_request_result* res)
+{
+    ss_request r;
+    memset(&r, 0, sizeof r);
+    r.purpose = purpose; r.slot = 3; r.give_up_s = give_up_s; r.done = on_done; r.user = (void*)(intptr_t)purpose;
+    const LONG n0 = g_done_n;
+    const int s = ss_request_submit(&r);
+    if (s != SS_R_QUEUED) return s;
+    const ULONGLONG end = GetTickCount64() + max_ms;
+    while (g_done_n == n0 && GetTickCount64() < end) {
+        WaitForSingleObject(g_wake, 2);
+        ss_frame_tick(++g_flip);
+    }
+    if (g_done_n == n0) { memset(res, 0, sizeof *res); res->reason = -1; return s; }
+    ss_last_request(res);
+    return s;
+}
+
+/* The added eligibility check: a "file open for writing" while g_file_open. */
+static int fake_file_check(char* what, unsigned n)
+{
+    if (!g_file_open) return 0;
+    snprintf(what, n, "/dev_hdd0/game/TEST/USRDIR/install.dat");
+    return 1;
+}
+
+static DWORD WINAPI clear_after(LPVOID p)
+{
+    Sleep((DWORD)(intptr_t)p);
+    InterlockedExchange(&g_file_open, 0);
+    return 0;
+}
+
+static volatile LONG g_race_go, g_race_queued, g_race_busy;
+static DWORD WINAPI race_submit(LPVOID p)
+{
+    (void)p;
+    while (!g_race_go) SwitchToThread();
+    ss_request r;
+    memset(&r, 0, sizeof r);
+    r.purpose = SS_P_LOAD; r.slot = 1; r.done = on_done;
+    const int s = ss_request_submit(&r);
+    if (s == SS_R_QUEUED) InterlockedIncrement(&g_race_queued);
+    else if (s == SS_R_BUSY) InterlockedIncrement(&g_race_busy);
+    return 0;
+}
+
+static int file_has(const char* path, const char* needle)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    static char buf[1 << 20];
+    size_t n = fread(buf, 1, sizeof buf - 1, f);
+    fclose(f);
+    buf[n] = 0;
+    return strstr(buf, needle) != NULL;
+}
+
+/* ---- a predicate that comes true with no wake --------------------------- */
+/* What a waiter sees after a wake it missed: its slice timed out, it left
+ * the CV's wait list, and the signaller changed the predicate and woke the
+ * CV before it re-took the lock. Here the "signaller" never wakes at all. */
+static CRITICAL_SECTION g_lw_cs;
+static CONDITION_VARIABLE g_lw_cv;
+static volatile LONG g_lw_flag, g_lw_seen;
+static DWORD WINAPI lost_wake_waiter(LPVOID p)
+{
+    (void)p;
+    ppu_context c; memset(&c, 0, sizeof c); c.thread_id = 0;   /* (no stop runs: never parks) */
+    EnterCriticalSection(&g_lw_cs);
+    while (!g_lw_flag) ss_sleep_cv_cs(&c, &g_lw_cv, &g_lw_cs, INFINITE, SS_W_EQUEUE, 1);
+    InterlockedExchange(&g_lw_seen, 1);
+    LeaveCriticalSection(&g_lw_cs);
+    return 0;
+}
+
+/* ---- child processes: what ss_init did at static init -------------------- */
+static int spawn_child(const char* mode)
+{
+    char self[MAX_PATH], q[MAX_PATH + 2];
+    GetModuleFileNameA(NULL, self, sizeof self);
+    snprintf(q, sizeof q, "\"%s\"", self);
+    fflush(stdout);
+    return (int)_spawnl(_P_WAIT, self, q, "--child", mode, NULL);
+}
+
+static int child_main(const char* mode)
+{
+    g_wake = CreateEventA(NULL, FALSE, FALSE, NULL);
+    if (!strcmp(mode, "killswitch")) {
+        /* started with SAVESTATES=0 and SS_CENSUS, SS_SAVE_AT, SS_SELFRESUME set */
+        CHECK(!g_ss_armed && !g_ss_sr_on && g_ss_sr_mask == 0, "armed at startup with SAVESTATES=0 (armed=%d sr=%d)",
+              g_ss_armed, g_ss_sr_on);
+        CHECK(ss_slice_ms(INFINITE) == INFINITE && ss_slice_ms(50) == 50, "waits sliced with SAVESTATES=0");
+        ss_request r; memset(&r, 0, sizeof r); r.purpose = SS_P_SAVE; r.done = on_done;
+        CHECK(ss_request_submit(&r) == SS_R_OFF && !ss_busy(), "SAVESTATES=0 took a request");
+        ppu_context c; memset(&c, 0, sizeof c); c.thread_id = 2;
+        static int jb;
+        ss_root_enter(&jb, &c);                       /* recorded nothing: P0 and the strict walk are off */
+        ss_root_leave();
+        ss_sr_stats sr; ss_sr_get_stats(0, &sr);
+        CHECK(sr.roots == 0 && sr.requests == 0, "a root was recorded with SAVESTATES=0 (%u)", sr.roots);
+        CRITICAL_SECTION cs; CONDITION_VARIABLE cv;
+        InitializeCriticalSection(&cs); InitializeConditionVariable(&cv);
+        EnterCriticalSection(&cs);
+        uint64_t dl = 0;
+        const ULONGLONG t0 = GetTickCount64();
+        const int ok = ss_sleep_cv_cs_dl(&c, &cv, &cs, 40, &dl, SS_W_EQUEUE, 1);   /* one plain 40 ms wait */
+        const DWORD le = GetLastError();
+        const ULONGLONG dt = GetTickCount64() - t0;
+        LeaveCriticalSection(&cs);
+        CHECK(!ok && le == ERROR_TIMEOUT && dl == 0 && dt >= 30, "unarmed timed CV wait: ok=%d dl=%llu dt=%llu",
+              ok, (unsigned long long)dl, dt);
+        ss_stats s0; ss_get_stats(&s0);
+        run_clock(400);                               /* (SS_CENSUS / SS_SAVE_AT would be due) */
+        ss_stats s1; ss_get_stats(&s1);
+        CHECK(s1.stops == 0 && s0.stops == 0 && !ss_busy(), "a stop ran with SAVESTATES=0 (%u)", s1.stops);
+    } else if (!strcmp(mode, "debugswitch")) {
+        /* started with PPU_THREADGATE: armed, but a save is refused at once, with no stop */
+        CHECK(g_ss_armed, "not armed with a debug switch");
+        ss_request_result res;
+        const int s = run_request(SS_P_SAVE, 2.0, 1500, &res);
+        CHECK(s == SS_R_QUEUED && !res.ok && res.reason == SS_REASON_DEBUG_SWITCH && res.attempts == 0 &&
+              res.waited_ms < 200 && !strcmp(res.detail, "PPU_THREADGATE"),
+              "debug switch: reason %s (%s), %u stop(s), waited %.0f ms", ss_reason_name(res.reason), res.detail,
+              res.attempts, res.waited_ms);
+        ss_stats st; ss_get_stats(&st);
+        CHECK(st.stops == 0, "a stop ran for a request a debug switch refuses (%u)", st.stops);
+    } else {
+        CHECK(0, "unknown child mode %s", mode);
+    }
+    printf("child %s: %s\n", mode, g_fail ? "FAIL" : "ok");
+    return g_fail ? 1 : 0;
+}
+
+int main(int argc, char** argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (argc > 2 && !strcmp(argv[1], "--child")) return child_main(argv[2]);
+    vm_base = (uint8_t*)VirtualAlloc(NULL, 0x04000000u, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    if (!vm_base) { printf("no memory\n"); return 2; }
+    build_code();
+    g_wake = CreateEventA(NULL, FALSE, FALSE, NULL);
+    g_never = CreateSemaphoreA(NULL, 0, 1, NULL);
+    InitializeCriticalSection(&g_cs);
+    InitializeConditionVariable(&g_cvar);
+    InitializeCriticalSection(&g_cs2);
+    InitializeConditionVariable(&g_cvar2);
+
+    /* ---- 0. always on: armed at startup (ss_init ran at static init), with
+     * no periodic stop: ticking the coordinator stops nothing ---------------- */
+    {
+        ss_config e;
+        if (!ss_config_from_env(&e)) printf("always-on: SAVESTATES is off in this environment -- skipped\n");
+        else {
+            CHECK(g_ss_armed, "not armed by default (always-on mode)");
+            CHECK(ss_slice_ms(INFINITE) == 10, "host waits not sliced at the default 10 ms (%lu)",
+                  ss_slice_ms(INFINITE));
+            ss_stats s0; ss_get_stats(&s0);
+            run_clock(300);
+            ss_stats s1; ss_get_stats(&s1);
+            CHECK(s1.stops == s0.stops && !ss_stop_in_progress() && !ss_busy(),
+                  "a stop ran with no request (%u -> %u)", s0.stops, s1.stops);
+            printf("always-on: armed, no periodic stop\n");
+        }
+        ss_config off; ss_default_config(&off);       /* .on = 0: disarmed */
+        ss_configure(&off);
+        _putenv_s("SAVESTATES", "");                  /* the phases below set it themselves */
+    }
+
+    /* ---- 1. unarmed: inert hooks, waits keep their meaning ---------------- */
+    {
+        ppu_context c; memset(&c, 0, sizeof c); c.thread_id = 9;
+        CHECK(!g_ss_armed, "still armed after ss_configure with .on = 0");
+        SS_SAFEPOINT(&c, SS_AT_SC, 1, 0);
+        CHECK(SS_WAIT_POINT(&c, SS_W_SEM, 1) == 0, "wait point did something unarmed");
+        const ULONGLONG t0 = GetTickCount64();
+        const DWORD r = ss_wait_handle(&c, g_never, 40, SS_W_SEM, 1);
+        const ULONGLONG dt = GetTickCount64() - t0;
+        CHECK(r == WAIT_TIMEOUT && dt >= 30 && dt < 200, "unarmed timed wait r=%lu dt=%llu", r, dt);
+        HANDLE s1 = CreateSemaphoreA(NULL, 1, 1, NULL);
+        CHECK(ss_wait_handle(&c, s1, INFINITE, SS_W_SEM, 1) == WAIT_OBJECT_0, "signalled wait");
+        CloseHandle(s1);
+        CHECK(ss_slice_ms(INFINITE) == INFINITE, "slice changed unarmed");
+        {   /* a timed CV wait unarmed: one plain wait, the deadline untouched */
+            EnterCriticalSection(&g_cs);
+            uint64_t dl = 0;
+            const ULONGLONG c0 = GetTickCount64();
+            const int ok = ss_sleep_cv_cs_dl(&c, &g_cvar, &g_cs, 40, &dl, SS_W_EQUEUE, 1);
+            const DWORD le = GetLastError();
+            const ULONGLONG cdt = GetTickCount64() - c0;
+            LeaveCriticalSection(&g_cs);
+            CHECK(!ok && le == ERROR_TIMEOUT && dl == 0 && cdt >= 30 && cdt < 200,
+                  "unarmed timed CV wait ok=%d dl=%llu dt=%llu", ok, (unsigned long long)dl, cdt);
+        }
+        printf("unarmed: ok\n");
+    }
+
+    /* ---- 1b. SAVESTATES=0, the kill switch: it wins over every other switch
+     * (SS_CENSUS, SS_SAVE_AT), and leaves everything inert ------------------- */
+    {
+        _putenv_s("SS_CENSUS", "1");
+        _putenv_s("SS_SAVE_AT", "5,1.5");
+        ss_config c;
+        CHECK(ss_config_from_env(&c) == 1 && c.on && c.period_s == 1.0 && c.n_save_at == 2 &&
+              c.save_at[0] == 5.0 && c.save_at[1] == 1.5, "switches not read (on=%d period=%.1f n=%d)",
+              c.on, c.period_s, c.n_save_at);
+        _putenv_s("SAVESTATES", "0");
+        CHECK(ss_config_from_env(&c) == 0 && !c.on && c.period_s == 0 && c.n_save_at == 0,
+              "SAVESTATES=0 did not turn everything off (on=%d period=%.1f n=%d)", c.on, c.period_s, c.n_save_at);
+        _putenv_s("SAVESTATES", "off");
+        CHECK(ss_config_from_env(&c) == 0, "SAVESTATES=off not read as off");
+        _putenv_s("SAVESTATES", "1");
+        CHECK(ss_config_from_env(&c) == 1 && c.on, "SAVESTATES=1 read as off");
+        _putenv_s("SAVESTATES", "0");
+        ss_config_from_env(&c);
+        ss_configure(&c);
+        _putenv_s("SAVESTATES", ""); _putenv_s("SS_CENSUS", ""); _putenv_s("SS_SAVE_AT", "");
+        CHECK(!g_ss_armed && ss_slice_ms(INFINITE) == INFINITE, "SAVESTATES=0 armed or sliced");
+        ss_request r; memset(&r, 0, sizeof r); r.purpose = SS_P_SAVE; r.done = on_done;
+        CHECK(ss_request_submit(&r) == SS_R_OFF && !ss_busy(), "SAVESTATES=0 took a request");
+        r.purpose = 99;
+        CHECK(ss_request_submit(&r) == SS_R_INVALID, "a bad purpose was not refused");
+        ppu_context pc; memset(&pc, 0, sizeof pc); pc.thread_id = 9;
+        CHECK(SS_WAIT_POINT(&pc, SS_W_SEM, 1) == 0, "wait point active with SAVESTATES=0");
+        ss_stats s0; ss_get_stats(&s0);
+        run_clock(200);
+        ss_stats s1; ss_get_stats(&s1);
+        CHECK(s1.stops == s0.stops, "a stop ran with SAVESTATES=0");
+        /* ... and at startup: ss_init, at static init, in a fresh process */
+        _putenv_s("SAVESTATES", "0"); _putenv_s("SS_CENSUS", "0.05"); _putenv_s("SS_SAVE_AT", "0.1");
+        _putenv_s("SS_SELFRESUME", "5");
+        CHECK(spawn_child("killswitch") == 0, "the kill-switch child failed");
+        _putenv_s("SAVESTATES", ""); _putenv_s("SS_CENSUS", ""); _putenv_s("SS_SAVE_AT", "");
+        _putenv_s("SS_SELFRESUME", "");
+        _putenv_s("PPU_THREADGATE", "1");
+        CHECK(spawn_child("debugswitch") == 0, "the debug-switch child failed");
+        _putenv_s("PPU_THREADGATE", "");
+        printf("SAVESTATES=0: inert\n");
+    }
+
+    /* ---- 2. arm with fast timings ----------------------------------------- */
+    char chains[MAX_PATH];
+    GetTempPathA(MAX_PATH, chains);
+    strcat(chains, "test_ss_chains.txt");
+    DeleteFileA(chains);
+    ss_config cfg;
+    ss_default_config(&cfg);
+    cfg.period_s = 0.05; cfg.tier1_ms = 30; cfg.timeout_ms = 300; cfg.spu_timeout_ms = 200;
+    cfg.slice_ms = 5; cfg.retries = 0; cfg.spu_expect = 3;
+    strcpy(cfg.chains_path, chains);
+    ss_configure(&cfg);
+    CHECK(g_ss_armed, "not armed");
+    CHECK(ss_slice_ms(INFINITE) == 5, "slice not applied");
+    { ss_host_ops h = { fake_walker_pass, fake_walker_info, fake_rebase, fake_wake }; ss_set_host_ops(&h); }
+    { ss_ppu_ops o; memset(&o, 0, sizeof o);
+      o.func_start = fake_func_start; o.is_code = fake_is_code; o.icall_state = fake_icall;
+      ss_set_ppu_ops(&o); }
+    { ss_sr_ops o; memset(&o, 0, sizeof o);           /* only the census walk: P0 stays off */
+      o.walk = fake_walk; o.strerror = fake_strerror;
+      ss_set_sr_ops(&o); }
+    g_ss_on_capture = on_capture;
+    ss_add_check(SS_REASON_FILE_WRITE, fake_file_check);   /* blocks only while g_file_open */
+
+    static fthr th[8];
+    const int kinds[8] = { -1, K_MAIN, K_BLOCKER, K_CV, K_BUSY, K_SLEEPER, K_CALLBACK, K_CBWAIT };
+    static const char* names[8] = { "", "main", "blocker", "cv", "busy", "sleeper", "callback", "cbwait" };
+    HANDLE hs[16]; int nh = 0;
+    for (unsigned tid = 1; tid <= 7; tid++) {
+        ppu_thread_info* ti = &g_ppu_threads[tid - 1];
+        th[tid].tid = tid; th[tid].kind = kinds[tid];
+        memset(&th[tid].ctx, 0, sizeof th[tid].ctx);
+        th[tid].ctx.thread_id = tid;
+        th[tid].ctx.gpr[1] = build_stack(tid);
+        th[tid].ctx.lr = ra_in(3);                        /* HLE: continues in function 3 */
+        th[tid].ctx.sc_ra = ra_in(3);
+        ti->state = PPU_THREAD_STATE_RUNNING;
+        strcpy(ti->name, names[tid]);
+        ti->stack_addr = STACK_BASE + tid * STACK_SIZE;
+        ti->stack_size = STACK_SIZE;
+        DWORD htid = 0;
+        hs[nh++] = CreateThread(NULL, 0, ppu_thread, &th[tid], 0, &htid);
+        ti->host_tid = htid;
+    }
+    hs[nh++] = CreateThread(NULL, 0, producer, NULL, 0, NULL);
+    for (int i = 0; i < 4; i++) hs[nh++] = CreateThread(NULL, 0, spu_thread, (LPVOID)(intptr_t)i, 0, NULL);
+    hs[nh++] = CreateThread(NULL, 0, mixer_thread, NULL, 0, NULL);
+    Sleep(50);
+
+    /* ---- 3. censuses converge ---------------------------------------------- */
+    run_clock(2500);
+    ss_stats st;
+    ss_get_stats(&st);
+    printf("phase 3: attempts=%u ok=%u censuses=%u ppu p50=%.1f p95=%.1f max=%.1f captures=%ld\n",
+           st.attempts, st.ok, st.censuses, st.ppu_p50, st.ppu_p95, st.ppu_max, g_captures);
+    CHECK(st.attempts >= 10, "too few attempts (%u)", st.attempts);
+    CHECK(st.ok == st.attempts, "%u of %u attempts failed", st.attempts - st.ok, st.attempts);
+    CHECK(st.within_500 == st.ok, "an ok census took over 500 ms");
+    CHECK(g_captures >= 10 && g_frozen_bad == 0, "world not frozen during capture (%ld bad)", g_frozen_bad);
+    CHECK(g_ppu_ss_park_of && g_park_recs >= 70 && g_park_bad == 0,
+          "PPUT park records: %ld ok, %ld wrong", g_park_recs, g_park_bad);
+    CHECK(g_force_on >= 10 && g_force_on == g_force_off, "force_hops on=%ld off=%ld", g_force_on, g_force_off);
+    CHECK(g_rebased >= 10, "walker never rebased");
+    { LONG p0[8]; for (int i = 0; i < 8; i++) p0[i] = g_prog[i];
+      Sleep(50);
+      for (int i = 1; i <= 7; i++)
+          if (i != 2) CHECK(g_prog[i] != p0[i], "tid %d did not run after release", i); }
+    CHECK(file_has(chains, "thread tid=2 name=\"blocker\" tier=1 at=wait:sem:0x7"), "blocker not parked in tier 1");
+    CHECK(file_has(chains, "thread tid=3 name=\"cv\" tier=1 at=wait:equeue:0x3"), "cv not parked in tier 1");
+    CHECK(file_has(chains, "thread tid=5 name=\"sleeper\" tier=1 at=wait:usleep"), "sleeper not parked in tier 1");
+    CHECK(file_has(chains, "thread tid=4 name=\"busy\" tier=2 at=hle:0x1573DC3F"), "busy not parked in tier 2");
+    CHECK(file_has(chains, "thread tid=1 name=\"main\" tier=2 at=sc:141"), "main not parked at S1 in tier 2");
+    CHECK(file_has(chains, "icall=3 vcall=1"), "icall state not recorded");
+    {
+        char want[160];
+        snprintf(want, sizeof want, "  ra0 ra=0x%08X func_%08X+0x44 link=bl", ra_in(3), fn_addr(3));
+        CHECK(file_has(chains, want), "innermost RA missing: %s", want);
+        snprintf(want, sizeof want, "ra=0x%08X func_%08X+0x44 link=bl calls=0x%08X", ra_in(2), fn_addr(2), fn_addr(3));
+        CHECK(file_has(chains, want), "frame 0 missing: %s", want);
+        snprintf(want, sizeof want, "ra=0x%08X func_%08X+0x44 link=bl calls=0x%08X", ra_in(0), fn_addr(0), fn_addr(1));
+        CHECK(file_has(chains, want), "frame 2 missing: %s", want);
+    }
+    CHECK(file_has(chains, "end root depth=4"), "chain did not end at the root");
+    /* the strict walk: one line per parked thread, the root record known */
+    CHECK(g_walks >= 10 && g_walk_bad_root == 0, "strict walks %ld, %ld without the right root record",
+          g_walks, g_walk_bad_root);
+    CHECK(file_has(chains, "  strict ok frames=4 end=lr rec=1"), "no strict ok line (busy, an HLE park)");
+    CHECK(file_has(chains, "  strict not-covered:missing frames=4 end=none rec=1 at=0x00ABCDE0 missing=0x00ABCDE0"),
+          "no strict not-covered line (a syscall park)");
+    /* (busy parks at an HLE entry, so does callback when it parks outside its callback) */
+    CHECK(file_has(chains, " strict=1/7") || file_has(chains, " strict=2/7"),
+          "census line without the strict tally");
+    CHECK(st.strict_stops == 0, "a stop counted strict-pass with threads not covered (%u)", st.strict_stops);
+    CHECK(file_has(chains, "spu tid=0x2002 group=0x1000 kind=lifted parked where=ch-wait"), "spu ch-wait not held");
+    CHECK(file_has(chains, "spu tid=0x2000 group=0x1000 kind=lifted parked where=hop"), "spu hop not parked");
+    CHECK(file_has(chains, "audioq=5/8"), "mixer fill not recorded");
+    {   /* SS_CENSUS's period now feeds census REQUESTS, one per census */
+        ss_request_stats rs;
+        ss_get_request_stats(SS_P_CENSUS, &rs);
+        printf("phase 3: census requests done=%u ok=%u stops=%u\n", rs.done, rs.ok, rs.attempts);
+        CHECK(rs.done >= 10 && rs.ok == rs.done && rs.attempts == rs.done,
+              "censuses not served as requests (done=%u ok=%u stops=%u)", rs.done, rs.ok, rs.attempts);
+        ss_get_request_stats(SS_P_SAVE, &rs);
+        CHECK(rs.done == 0, "a save request appeared from nowhere");
+    }
+
+    /* ---- 4. a thread stuck in a callback: straggler, then recovery --------- */
+    InterlockedExchange(&g_cb_stuck, 1);
+    Sleep(20);
+    const unsigned fail0 = st.fail_ppu;
+    run_clock(900);
+    ss_get_stats(&st);
+    printf("phase 4: attempts=%u ok=%u fail_ppu=%u\n", st.attempts, st.ok, st.fail_ppu);
+    CHECK(st.fail_ppu > fail0, "stuck callback did not fail an attempt");
+    CHECK(file_has(chains, "straggler tid=6 name=\"callback\""), "callback thread not named");
+    CHECK(file_has(chains, "refused=callback"), "refusal reason not recorded");
+    InterlockedExchange(&g_cb_stuck, 0);
+    const unsigned ok0 = st.ok;
+    run_clock(600);
+    ss_get_stats(&st);
+    printf("phase 4b: attempts=%u ok=%u\n", st.attempts, st.ok);
+    CHECK(st.ok > ok0, "no census succeeded after the callback ended");
+    CHECK(file_has(chains, "thread tid=7 name=\"cbwait\" tier=1 at=wait:usleep"), "cbwait not parked as a sleeper");
+
+    /* ---- 4c. a refused waiter (CV wait inside a callback): no park, no spin -- */
+    InterlockedExchange(&g_cbwait, 1);
+    Sleep(30);
+    const unsigned f0 = st.fail_ppu;
+    const LONG it0 = g_cbwait_iters;
+    const ULONGLONG c0 = GetTickCount64();
+    run_clock(800);
+    const double secs = (double)(GetTickCount64() - c0) / 1000.0;
+    const LONG its = g_cbwait_iters - it0;
+    ss_get_stats(&st);
+    printf("phase 4c: attempts=%u fail_ppu=%u, refused waiter looped %ld times in %.1f s\n",
+           st.attempts, st.fail_ppu, its, secs);
+    CHECK(st.fail_ppu > f0, "a waiter inside a callback did not fail an attempt");
+    CHECK(file_has(chains, "straggler tid=7 name=\"cbwait\""), "refused waiter not named a straggler");
+    CHECK(its < (LONG)(secs * 1000.0), "refused waiter spun (%ld loops in %.1f s)", its, secs);
+    InterlockedExchange(&g_cbwait, 0);
+    EnterCriticalSection(&g_cs2); g_flag2 = 1; LeaveCriticalSection(&g_cs2);
+    WakeAllConditionVariable(&g_cvar2);
+    const unsigned ok1 = st.ok;
+    run_clock(600);
+    ss_get_stats(&st);
+    CHECK(st.ok > ok1, "no census succeeded after the refused waiter left its callback");
+
+    /* ---- 6. always on, with the census period gone: no stop at all ---------- */
+    run_clock(300);                       /* let any census in flight finish */
+    ss_config on = cfg;
+    on.period_s = 0; on.on = 1;
+    strcpy(on.spu_audited, "7:ch-wait:0x300");   /* the fake channel wait, audited */
+    ss_configure(&on);
+    {
+        ss_stats s0; ss_get_stats(&s0);
+        const LONG c0 = g_captures;
+        run_clock(400);
+        ss_stats s1; ss_get_stats(&s1);
+        CHECK(g_ss_armed && s1.stops == s0.stops && g_captures == c0,
+              "always-on mode stopped the world with no request (%u -> %u stops)", s0.stops, s1.stops);
+        printf("phase 6: armed, %u stop(s) in 400 ms without a request\n", s1.stops - s0.stops);
+    }
+
+    /* ---- 6b. armed waits (slice 5 ms): a predicate that came true without a
+     * wake is seen within a slice or two; a timed CV wait keeps its deadline
+     * across its slices; a sliced sleep ends on time ------------------------ */
+    {
+        InitializeCriticalSection(&g_lw_cs);
+        InitializeConditionVariable(&g_lw_cv);
+        HANDLE h = CreateThread(NULL, 0, lost_wake_waiter, NULL, 0, NULL);
+        Sleep(30);                                    /* blocked in its wait by now */
+        EnterCriticalSection(&g_lw_cs);
+        InterlockedExchange(&g_lw_flag, 1);           /* ... and nobody wakes the CV */
+        LeaveCriticalSection(&g_lw_cs);
+        const DWORD r = WaitForSingleObject(h, 500);
+        CHECK(r == WAIT_OBJECT_0 && g_lw_seen, "a waiter whose predicate came true without a wake slept on");
+        if (r != WAIT_OBJECT_0) { WakeAllConditionVariable(&g_lw_cv); WaitForSingleObject(h, 2000); }
+        CloseHandle(h);
+
+        ppu_context c; memset(&c, 0, sizeof c);
+        LARGE_INTEGER f, a, b;
+        QueryPerformanceFrequency(&f);
+        EnterCriticalSection(&g_lw_cs);
+        uint64_t dl = 0;
+        int spurious = 0;
+        QueryPerformanceCounter(&a);
+        while (ss_sleep_cv_cs_dl(&c, &g_lw_cv, &g_lw_cs, 60, &dl, SS_W_EQUEUE, 1)) spurious++;
+        const DWORD le = GetLastError();
+        QueryPerformanceCounter(&b);
+        LeaveCriticalSection(&g_lw_cs);
+        const double dt = (double)(b.QuadPart - a.QuadPart) * 1e3 / (double)f.QuadPart;
+        CHECK(le == ERROR_TIMEOUT && dt >= 55.0 && dt < 200 && spurious >= 3,
+              "timed CV wait armed: %.1f ms, %d slice return(s), error %lu", dt, spurious, le);
+
+        timeBeginPeriod(1);                           /* as the game runs (main.cpp) */
+        QueryPerformanceCounter(&a);
+        ss_ppu_sleep_us(&c, 23500, SS_W_USLEEP);
+        QueryPerformanceCounter(&b);
+        timeEndPeriod(1);
+        const double us = (double)(b.QuadPart - a.QuadPart) * 1e6 / (double)f.QuadPart;
+        CHECK(us >= 23500 && us < 30000, "a sliced 23.5 ms sleep took %.0f us", us);
+        printf("phase 6b: lost wake seen, timed CV wait %.1f ms over %d slices, 23.5 ms sleep %.0f us\n",
+               dt, spurious, us);
+    }
+
+    ss_request_result res;
+    /* ---- 7. strict: refused while an extra SPU context is live -- retried no
+     * sooner than SS_RETRY_GAP (4) times the stop's length, so the game stood
+     * still at most half the window (a stop at every flip: nearly all of
+     * it) --, then a SAVE that passes every
+     * check is done ok, at its first stop ------------------------------------ */
+    InterlockedExchange(&g_walk_all_ok, 1);
+    {
+        run_request(SS_P_SAVE, 1.0, 3000, &res);
+        printf("phase 7a: save -> ok=%d reason=%s (%s) attempts=%u stopped=%.0f of %.0f ms: %s\n", res.ok,
+               ss_reason_name(res.reason), res.detail, res.attempts, res.stopped_ms, res.waited_ms, res.why);
+        CHECK(!res.ok && res.reason == SS_REASON_SPU_EXTRA && res.attempts >= 2,
+              "a live unregistered SPU context did not refuse a save (reason %s, attempts %u)",
+              ss_reason_name(res.reason), res.attempts);
+        CHECK(res.stopped_ms > 0 && res.stopped_ms <= 0.5 * res.waited_ms && res.waited_ms <= 1100,
+              "refused stops not spaced: stopped %.0f of %.0f ms in %u stops", res.stopped_ms, res.waited_ms,
+              res.attempts);
+        InterlockedExchange(&g_spu3_quiet, 1);
+        Sleep(20);
+        const LONG c0 = g_captures, bad0 = g_frozen_bad;
+        const int s = run_request(SS_P_SAVE, 0, 3000, &res);
+        printf("phase 7b: save -> ok=%d reason=%s attempts=%u eligible=%.1f ms waited=%.1f ms\n", res.ok,
+               ss_reason_name(res.reason), res.attempts, res.eligible_ms, res.waited_ms);
+        CHECK(s == SS_R_QUEUED && res.ok && res.reason == SS_REASON_OK && res.purpose == SS_P_SAVE &&
+              g_done_user == SS_P_SAVE, "an eligible save was not done ok (reason %s: %s)",
+              ss_reason_name(res.reason), res.why);
+        CHECK(res.attempts == 1 && res.eligible_ms >= 0 && res.eligible_ms <= res.waited_ms,
+              "eligible save: attempts %u, eligible after %.1f ms", res.attempts, res.eligible_ms);
+        CHECK(g_captures == c0 + 1 && g_frozen_bad == bad0, "the save's stop did not freeze the world");
+        ss_request_stats rs; ss_get_request_stats(SS_P_SAVE, &rs);
+        CHECK(rs.done == 2 && rs.ok == 1 && rs.refused == 1 && rs.by_reason[SS_REASON_SPU_EXTRA] == 1,
+              "save stats done=%u ok=%u refused=%u", rs.done, rs.ok, rs.refused);
