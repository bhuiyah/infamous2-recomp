+/* ---- hashing ---------------------------------------------------------- */
+
+#define RSX_P1 0x9E3779B185EBCA87ull
+#define RSX_P2 0xC2B2AE3D27D4EB4Full
+#define RSX_P3 0x165667B19E3779F9ull
+#define RSX_P4 0x85EBCA77C2B2AE63ull
+#define RSX_P5 0x27D4EB2F165667C5ull
+static inline u64 rsx_rotl64(u64 x, int r) { return (x << r) | (x >> (64 - r)); }
+static inline u64 rsx_xxr(u64 acc, u64 in) { acc += in * RSX_P2; acc = rsx_rotl64(acc, 31); return acc * RSX_P1; }
+static inline u64 rsx_xxm(u64 acc, u64 v) { v = rsx_xxr(0, v); acc ^= v; return acc * RSX_P1 + RSX_P4; }
+
+/* XXH64 (same rounds and finaliser; inputs read as host-endian words). */
+u64 rsx_vhash64(const u8* p, size_t len, u64 seed)
+{
+    const u8* const end = p + len;
+    u64 h;
+    if (len >= 32) {
+        const u8* const lim = end - 32;
+        u64 v1 = seed + RSX_P1 + RSX_P2, v2 = seed + RSX_P2, v3 = seed, v4 = seed - RSX_P1;
+        do {
+            u64 w[4]; memcpy(w, p, 32);
+            v1 = rsx_xxr(v1, w[0]); v2 = rsx_xxr(v2, w[1]);
+            v3 = rsx_xxr(v3, w[2]); v4 = rsx_xxr(v4, w[3]);
+            p += 32;
+        } while (p <= lim);
+        h = rsx_rotl64(v1, 1) + rsx_rotl64(v2, 7) + rsx_rotl64(v3, 12) + rsx_rotl64(v4, 18);
+        h = rsx_xxm(h, v1); h = rsx_xxm(h, v2); h = rsx_xxm(h, v3); h = rsx_xxm(h, v4);
+    } else {
+        h = seed + RSX_P5;
+    }
+    h += (u64)len;
+    while (p + 8 <= end) { u64 k; memcpy(&k, p, 8); h ^= rsx_xxr(0, k); h = rsx_rotl64(h, 27) * RSX_P1 + RSX_P4; p += 8; }
+    if (p + 4 <= end) { u32 k; memcpy(&k, p, 4); h ^= (u64)k * RSX_P1; h = rsx_rotl64(h, 23) * RSX_P2 + RSX_P3; p += 4; }
+    while (p < end) { h ^= (*p) * RSX_P5; h = rsx_rotl64(h, 11) * RSX_P1; p++; }
+    h ^= h >> 33; h *= RSX_P2; h ^= h >> 29; h *= RSX_P3; h ^= h >> 32;
+    return h;
+}
