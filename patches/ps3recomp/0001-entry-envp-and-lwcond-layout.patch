+/* ---------------------------------------------------------------------------
+ * Reporting
+ * -----------------------------------------------------------------------*/
+static void fmt_at(char* b, size_t n, int at, uint32_t num, uint32_t obj)
+{
+    switch (at) {
+    case SS_AT_SC:   snprintf(b, n, "sc:%u", num); break;
+    case SS_AT_HLE:  snprintf(b, n, "hle:0x%08X", num); break;
+    case SS_IN_WAIT: snprintf(b, n, "wait:%s:0x%X", ss_wait_name((int)num), obj); break;
+    default:         snprintf(b, n, "-"); break;
+    }
+}
+
+static void fmt_fn(char* b, size_t n, uint32_t a)
+{
+    const uint32_t s = s_ppu.func_start ? s_ppu.func_start(a) : 0;
+    if (s) snprintf(b, n, "func_%08X+0x%X", s, a - s);
+    else   snprintf(b, n, "0x%08X", a);
+}
+
+static int cmp_f(const void* a, const void* b)
+{
+    const float x = *(const float*)a, y = *(const float*)b;
+    return x < y ? -1 : x > y;
+}
+
+static double pct(const float* v, unsigned n, double p)
+{
+    if (!n) return 0;
+    static float tmp[SS_HIST];
+    memcpy(tmp, v, n * sizeof *v);
+    qsort(tmp, n, sizeof *tmp, cmp_f);
+    unsigned i = (unsigned)(p * (n - 1) + 0.5);
+    return tmp[i < n ? i : n - 1];
+}
+
+void ss_get_stats(ss_stats* o)
+{
+    memset(o, 0, sizeof *o);
+    o->attempts = s_st.attempts; o->ok = s_st.ok; o->fail_ppu = s_st.fail_ppu;
+    o->fail_spu = s_st.fail_spu; o->mixer_late = s_st.mixer_late; o->censuses = s_st.censuses;
+    o->within_500 = s_st.within_500;
+    o->strict_stops = s_st.strict_stops;
+    o->stops = s_st.stops;
+    o->watchdogs = (unsigned)s_watchdog_fired;
+    const unsigned n = s_st.n < SS_HIST ? s_st.n : SS_HIST;
+    o->ppu_p50 = pct(s_st.ppu, n, 0.5); o->ppu_p95 = pct(s_st.ppu, n, 0.95); o->ppu_max = pct(s_st.ppu, n, 1.0);
+    o->stop_p50 = pct(s_st.stop, n, 0.5); o->stop_p95 = pct(s_st.stop, n, 0.95); o->stop_max = pct(s_st.stop, n, 1.0);
+}
