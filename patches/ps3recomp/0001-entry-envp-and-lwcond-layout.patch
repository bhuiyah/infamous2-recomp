+/* The order a capture lists a registry in: its slots from just after an
+ * empty one, round the table. A load puts the records back in that order
+ * into the emptied registry, probing as lwm_sem / lwc_slot do, so each lands
+ * in the slot it had -- every slot between an entry's hash and its own was
+ * taken before it went in, and none of them lies past the empty one (from
+ * slot 0 instead, an entry that wrapped round the end would come back
+ * first and take another's slot) -- and the capture after the load lists
+ * them in the same order, which the fidelity check compares. */
+template <class Slot> static uint32_t lw_ss_first(const Slot* tab, uint32_t n)
+{
+    for (uint32_t i = 0; i < n; i++)
+        if (!tab[i].addr) return (i + 1) & (n - 1);
+    return 0;                                      /* (full: any start) */
+}
+/* Probe for addr from its hash in a table of n (a power of 2) slots, as the
+ * registries do: the free slot it goes in, or -1 if addr is there already
+ * or the table is full. at(i) is slot i's address (0 = free). */
+template <class At> static long lw_ss_probe(uint32_t n, uint32_t addr, At at)
+{
+    const uint32_t h = (addr * 2654435761u) & (n - 1);
+    for (uint32_t i = 0; i < n; i++) {
+        const uint32_t idx = (h + i) & (n - 1), a = at(idx);
+        if (a == addr) return -1;
+        if (!a) return (long)idx;
+    }
+    return -1;
+}
