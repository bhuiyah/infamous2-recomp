+static int rs_plumb(void) { return s_rs.on >= 1; }
+static int rs_factor(void) { return s_rs.on >= 2 ? s_rs.on : 1; }
+/* The host size of a guest w x h surface under the latched factor. */
+static void rs_host_dims(u32 w, u32 h, u32* hw, u32* hh)
+{
+    *hw = w; *hh = h;
+    if (!rs_plumb() || w != s_d3d.width || h != s_d3d.height) return;   /* main class only */
+    *hw = rsx_rs_host_len(w, (double)rs_factor());
+    *hh = rsx_rs_host_len(h, (double)rs_factor());
