+static void test_pm(void)
+{
+    rsx_pm_in in; rsx_pm_out o;
+    memset(&in, 0, sizeof in); in.present_window = 1;
+    rsx_pm_decide(&in, &o);
+    CHECK(!o.window_sized && !o.want_tearing && o.filter == RSX_UP_OFF && !o.vrr_bilinear, "pm.defaults: today's chain");
+    in.tearing = 1; rsx_pm_decide(&in, &o);
+    CHECK(!o.window_sized && o.want_tearing, "pm.tearing row alone: 1280x720, tearing-capable");
+    in.tearing = 0;
+    for (int f = RSX_UP_BILINEAR; f <= RSX_UP_LANCZOS; f++) {
+        in.upscale = f; rsx_pm_decide(&in, &o);
+        CHECK(o.window_sized && o.filter == f && !o.want_tearing, "pm.upscale %d at 1x: window-sized", f);
+    }
+    in.upscale = RSX_UP_OFF; in.vrr = 1; rsx_pm_decide(&in, &o);
+    CHECK(o.window_sized && o.filter == RSX_UP_BILINEAR && o.want_tearing && o.vrr_bilinear, "pm.vrr: bilinear, tearing");
+    in.upscale = RSX_UP_LANCZOS; rsx_pm_decide(&in, &o);
+    CHECK(o.window_sized && o.filter == RSX_UP_LANCZOS && o.want_tearing && !o.vrr_bilinear, "pm.vrr + lanczos");
+    in.vrr = 0; in.present_window = 0; rsx_pm_decide(&in, &o);
+    CHECK(!o.window_sized && o.filter == RSX_UP_OFF, "pm.RSX_RES_PRESENT=guest keeps 1280x720");
+    in.present_window = 1; in.upscale = RSX_UP_OFF; in.res_scale = 2; rsx_pm_decide(&in, &o);
+    CHECK(o.window_sized && o.filter == RSX_UP_OFF, "pm.x2 off: window-sized, today's box");
+    in.upscale = RSX_UP_BICUBIC; rsx_pm_decide(&in, &o);
+    CHECK(o.window_sized && o.filter == RSX_UP_BICUBIC, "pm.x2 bicubic: the downsample kernel");
+    in.res_scale = 1; in.upscale = RSX_UP_OFF; rsx_pm_decide(&in, &o);
+    CHECK(!o.window_sized, "pm.RES_SCALE=1 (plumbing) with off: as before");
+    in.res_scale = 3; in.present_window = 0; rsx_pm_decide(&in, &o);
+    CHECK(!o.window_sized, "pm.x3 guest present");
+    in.upscale = 7; in.res_scale = 0; in.present_window = 1; rsx_pm_decide(&in, &o);
+    CHECK(!o.window_sized && o.filter == RSX_UP_OFF, "pm.out-of-range filter = off");
+    /* the [present] classifier: the frames the kernel counted as flipped by our process against our presents */
+    CHECK(rsx_pm_classify(45, 45) == RSX_PM_INDEPENDENT, "pm.classify one flip per present: independent flip");
+    CHECK(rsx_pm_classify(60, 48) == RSX_PM_INDEPENDENT, "pm.classify a sample boundary: still independent");
+    CHECK(rsx_pm_classify(52, 0) == RSX_PM_COMPOSED, "pm.classify none of ours: composed");
+    CHECK(rsx_pm_classify(52, 3) == RSX_PM_COMPOSED, "pm.classify a stray flip: composed");
+    CHECK(rsx_pm_classify(60, 20) == RSX_PM_UNCLEAR, "pm.classify a switch inside the second: unclear");
+    CHECK(rsx_pm_classify(3, 0) == RSX_PM_UNCLEAR, "pm.classify a loading pause: unclear");
+    {   /* variable refresh: the display follows the frames (1.00 refreshes per frame) or keeps 75 Hz */
+        rsx_vrr_tally a, b, c;
+        memset(&a, 0, sizeof a); memset(&b, 0, sizeof b); memset(&c, 0, sizeof c);
+        int va = 0, vb = 0, vc = 0;
+        for (int i = 0; i < 8; i++) {
+            va = rsx_vrr_verdict(&a, 63.0, 1.00, 75.0);                 /* follows */
+            vb = rsx_vrr_verdict(&b, 63.0, 75.0 / 63.0, 75.0);          /* fixed: 1.19 */
+            vc = rsx_vrr_verdict(&c, 49.0, 75.0 / 49.0, 75.0);          /* below 80%: cannot decide */
+            if (i < 7) CHECK(va == RSX_VRR_UNKNOWN && vb == RSX_VRR_UNKNOWN, "vrr.verdict waits for 8 samples");
+        }
+        CHECK(va == RSX_VRR_ACTIVE && vb == RSX_VRR_FIXED && vc == RSX_VRR_UNKNOWN, "vrr.verdict active / fixed / unknown");
+        CHECK(rsx_vrr_verdict(&a, 74.5, 1.0, 75.0) == RSX_VRR_UNKNOWN, "vrr.verdict at the top: no sample (the caller keeps its verdict)");
+        CHECK(rsx_vrr_verdict(&a, 73.0, 1.0, 75.0) == RSX_VRR_UNKNOWN, "vrr.verdict 73 of 75: too close to decide");
+        {   /* the vrr row's own cap: 72 fps on 75 Hz decides (72 against 75 refreshes a second) */
+            rsx_vrr_tally d, e;
+            memset(&d, 0, sizeof d); memset(&e, 0, sizeof e);
+            int vd = 0, ve = 0;
+            for (int i = 0; i < 8; i++) {
+                vd = rsx_vrr_verdict(&d, 72.0, 1.0, 75.0);
+                ve = rsx_vrr_verdict(&e, 72.0, (i & 1) ? 74.0 / 72.0 : 76.0 / 72.0, 75.0);   /* +-1 refresh */
+            }
+            CHECK(vd == RSX_VRR_ACTIVE && ve == RSX_VRR_FIXED, "vrr.verdict at the 72 cap: active / fixed (%d %d)", vd, ve);
+        }
+        CHECK(rsx_vrr_verdict(&c, 72.0, 1.0, 0.0) == RSX_VRR_UNKNOWN, "vrr.verdict refresh unknown");
+    }
+}
+
+static int has(const rsx_vrr_set* s, int n, const char* k, const char* v)
+{
+    for (int i = 0; i < n; i++) if (!strcmp(s[i].key, k) && !strcmp(s[i].val, v)) return 1;
+    return 0;
+}
+static void test_vrr(void)
+{
+    CHECK(rsx_vrr_cap_hz(75) == 72, "vrr.cap 75 -> 72 (%d)", rsx_vrr_cap_hz(75));
+    CHECK(rsx_vrr_cap_hz(60) == 57, "vrr.cap 60"); CHECK(rsx_vrr_cap_hz(120) == 116, "vrr.cap 120");
+    CHECK(rsx_vrr_cap_hz(144) == 138, "vrr.cap 144"); CHECK(rsx_vrr_cap_hz(240) == 224, "vrr.cap 240");
+    CHECK(rsx_vrr_cap_hz(0) == 0 && rsx_vrr_cap_hz(29) == 0 && rsx_vrr_cap_hz(-5) == 0, "vrr.cap unknown");
+    rsx_vrr_set s[5], r[5];
+    char rec[96];
+    int n = rsx_vrr_plan(75, 0, "1", "0", "0", "off", "off", s);
+    CHECK(n == 4 && has(s, n, "vsync", "0") && has(s, n, "tearing", "1") && has(s, n, "fps_cap", "72") &&
+          has(s, n, "upscale", "bilinear"), "vrr.on from the defaults (%d)", n);
+    n = rsx_vrr_plan(75, 1, "1", "0", "0", "off", "off", s);
+    CHECK(n == 3 && !has(s, n, "upscale", "bilinear"), "vrr.on at 2x-4x leaves the downscale filter (%d)", n);
+    n = rsx_vrr_plan(75, 0, "1", "60", "0", "lanczos", "off", s);
+    CHECK(n == 2 && !has(s, n, "fps_cap", "72") && !has(s, n, "upscale", "bilinear"), "vrr.on keeps a lower limit, lanczos");
+    n = rsx_vrr_plan(75, 0, "1", "100", "1", "bicubic", "off", s);
+    CHECK(n == 2 && has(s, n, "fps_cap", "72") && has(s, n, "vsync", "0"), "vrr.on lowers a limit above the cap");
+    n = rsx_vrr_plan(75, 0, "0", "72", "1", "bilinear", "off", s);
+    CHECK(n == 0, "vrr.on, already set: nothing");
+    n = rsx_vrr_plan(75, 0, "0", "72", "1", "bilinear", "auto", s);
+    CHECK(n == 1 && has(s, n, "frame_pacing", "off") && !strcmp(s[0].old, "auto"), "vrr.on switches even frame pacing off");
+    n = rsx_vrr_plan(0, 0, "1", "0", "0", "off", "off", s);
+    CHECK(n == 3 && !has(s, n, "fps_cap", "0"), "vrr.on with the refresh unknown: no limit set");
+    /* the record: a user who already ran vsync 0 + tearing 1 uncapped, with even pacing at least 30 */
+    n = rsx_vrr_plan(75, 0, "0", "0", "1", "off", "auto:30", s);
+    rsx_vrr_record(s, n, rec, sizeof rec);
+    CHECK(n == 3 && !strcmp(rec, "fps_cap=0>72,upscale=off>bilinear,frame_pacing=auto:30>off"), "vrr.record (%s)", rec);
+    int m = rsx_vrr_unrecord(rec, r);
+    CHECK(m == 3 && !strcmp(r[0].key, "fps_cap") && !strcmp(r[0].old, "0") && !strcmp(r[0].val, "72") &&
+          !strcmp(r[2].key, "frame_pacing") && !strcmp(r[2].old, "auto:30") && !strcmp(r[2].val, "off"),
+          "vrr.unrecord: off restores the limit, upscale and pacing, never touches vsync / tearing (%d)", m);
+    CHECK(rsx_vrr_unrecord("", r) == 0 && rsx_vrr_unrecord("bogus=1>2,vsync,tearing=1", r) == 0,
+          "vrr.unrecord: empty, unknown and malformed entries");
+    CHECK(rsx_vrr_unrecord("vsync=1>0,tearing=0>1", r) == 2 && !strcmp(r[1].old, "0") && !strcmp(r[1].val, "1"),
+          "vrr.unrecord two");
+    CHECK(rsx_vrr_same("72", "72.0") && rsx_vrr_same("off", "off") && !rsx_vrr_same("72", "60") &&
+          !rsx_vrr_same("auto", "off") && !rsx_vrr_same(NULL, "0"), "vrr.same");
+    n = rsx_vrr_plan(75, 0, "4", "1000", "0", "off", "auto:30", s);   /* the longest record fits the row (96) */
+    rsx_vrr_record(s, n, rec, sizeof rec);
+    CHECK(n == 5 && strlen(rec) < 95 && rsx_vrr_unrecord(rec, r) == 5, "vrr.record longest fits (%u)",
+          (unsigned)strlen(rec));
+}
+
+int main(void)
+{
+    test_kernel();
+    test_taps();
+    test_sum();
+    test_identity_flat();
+    test_ring();
+    test_lin();
+    test_bars();
+    test_pm();
+    test_vrr();
+    printf("test_upscale: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_vcache_admit2.c b/libs/video/tests/test_vcache_admit2.c
new file mode 100644
index 0000000..e9bd0e7
--- /dev/null
+++ b/libs/video/tests/test_vcache_admit2.c
@@ -0,0 +1,332 @@
+/*
+ * ps3recomp - PF5 VCACHE_ADMIT2 / VCACHE_EVAC (rsx_vertex_fetch.h): the
+ * converted-vertex cache admits a range on its second sighting and empties a
+ * slab a few hot ranges keep -- the real cache code on a fake guest memory,
+ * without a GPU.
+ *
+ * Frames of 15 batches (the gate fight's count) draw ranges of five kinds,
+ * interleaved: hot (the same buffer and content every frame), one-shot (a new
+ * buffer every frame: a key never seen again), changing (the same buffer, new
+ * content every frame), walk (W new buffers a frame, each drawn in 4
+ * consecutive frames, then never again: geometry passed on a walk) and late
+ * (a new buffer every 4 frames, drawn every frame from then on: geometry that
+ * comes into view and stays). The region (8 slabs) and the table (512
+ * entries) are small, so that -- as inFamous 2's gate fight and busy street
+ * did with 256 MB and 32768 entries -- the old first-sighting admission fills
+ * every slab around hot ranges, the full table forgets hot entries and admits
+ * them again in other slabs, and the cache freezes with hot ranges outside
+ * it; so that the walk's cold entries fill the table (PF5's early builds: no
+ * room for a marker in the table, or slot 0 forgotten -- a hot entry among
+ * them -- at every admission); and so that each late range lands in the slab
+ * being filled among walk copies and keeps it from recycling for good: with
+ * admit2 alone the cache freezes again, the slabs being emptied keep it free.
+ * Checked, for the four combinations of admit2 and evac_on:
+ *   exactness   every range the cache serves (a hit, an admission or a move
+ *               out of a slab being emptied) is, in the arena, byte for byte
+ *               the reference conversion of the guest bytes now
+ *               (rsx_vfetch_convert);
+ *   GPU safety  at the end of every batch B, every draw served in B or B-1
+ *               still reads the bytes it was served (render_frame waits for
+ *               the GPU before it submits a batch: B-1 may run while B is
+ *               recorded, so neither may be overwritten);
+ *   both on     in the steady state nothing is nofit, every hot and late
+ *               draw and 99% of the walk ranges' third and fourth draws are
+ *               served from the cache (a key the filter lost, or a refused
+ *               admission, takes the stream path once more), no one-shot range
+ *               is ever admitted (each is held back once), slabs are recycled
+ *               and emptied;
+ *   admit2 only the late ranges' freeze (nofit in the last frames);
+ *   both off    (the old path) the freeze: hot draws nofit every frame;
+ *   and a range seen twice is admitted on its second sighting.
+ * And the VCACHE_VERIFY oracle agrees (0 differing, 0 unsafe) and catches two
+ * planted faults: a corrupted copy (DIFF) and a recycled slab the current
+ * batch reads (UNSAFE; its bytes also change under the independent check).
+ * Single-threaded; nothing else writes the guest buffers between draws.
+ *
+ * From external/ps3recomp:
+ *   clang-cl /nologo /O1 -msse4.1 -D_CRT_SECURE_NO_WARNINGS -I include -I libs/video
+ *     libs/video/tests/test_vcache_admit2.c libs/video/rsx_vertex_fetch.c /Fe:T/test_vcache_admit2.exe
+ */
+#include "rsx_vertex_fetch.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+u8* vm_base;
+u32 cellGcmResolveOffset(u32 offset) { return offset; }
+u32 cellGcmResolveLocated(int location, u32 offset) { (void)location; return offset; }
+
+static int s_fail;
+#define CHECK(c, ...) do { if (!(c)) { s_fail++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+#define GUEST_MB 64u
+#define NSLAB 8u                 /* region: 8 slabs of 1 MB               */
+#define NENT 512u                /* table entries                          */
+#define BPF 15u                  /* batches a frame                        */
+#define FRAMES 160u
+#define TAIL 20u
+#define NHOT 40u                 /* hot ranges, 16 KB each (640 KB)        */
+#define NONE 60u                 /* one-shot ranges a frame, 4 KB each     */
+#define NCHG 4u                  /* changing ranges, 4 KB each             */
+#define NWALK 24u                /* walk ranges begun a frame, 8 KB each, drawn 4 frames */
+#define LATE_EVERY 4u            /* a late range begun every 4 frames, 8 KB, drawn every frame after */
+#define HOT_V 1024u              /* vertices (x 16 bytes)                  */
+#define ONE_V 256u
+#define CHG_V 256u
+#define WALK_V 512u
+#define HOT_OFF(k)  (0x00100000u + (k) * 0x8000u)      /* .. 0x00240000     */
+#define CHG_OFF(k)  (0x00300000u + (k) * 0x2000u)
+#define ONE_OFF(j)  (0x00400000u + (j) * 0x400u)       /* .. +9.4 MB (overlapping buffers: new keys) */
+#define WALK_OFF(j) (0x01000000u + (j) * 0x800u)       /* .. +7.6 MB        */
+#define LATE_OFF(k) (0x01800000u + (k) * 0x2000u)      /* .. +320 KB        */
+#define BIG_OFF(k)  (0x02000000u + (k) * 0x10000u)     /* test 4            */
+
+enum { K_HOT, K_ONE, K_CHG, K_WALK, K_LATE };
+
+static rsx_state s_st;
+static u8* s_arena;
+static u8* s_ref;
+
+typedef struct { u64 g, bytes, h; u32 batch; } served_t;
+static served_t s_srv[2][8192];
+static u32 s_nsrv[2];
+
+static u64 fnv(const u8* p, u64 n)
+{
+    u64 h = 1469598103934665603ull;
+    for (u64 i = 0; i < n; i++) h = (h ^ p[i]) * 1099511628211ull;
+    return h;
+}
+
+static void attr_at(u32 off)   /* attribute 0: float4, 16-byte stride, at guest offset off */
+{
+    rsx_vertex_attrib* a = &s_st.vertex_attribs[0];
+    a->offset = off; a->stride = 16; a->size = 4; a->type = 2; a->frequency = 0; a->enabled = 1;
+}
+
+static void fill(u32 off, u32 nv, u32 seed)   /* big-endian guest floats */
+{
+    for (u32 i = 0; i < nv * 4u; i++) {
+        const float f = (float)((seed * 7919u + i) & 0xFFFFFu) * 0.25f;
+        u32 b; memcpy(&b, &f, 4);
+        u8* q = vm_base + off + i * 4u;
+        q[0] = (u8)(b >> 24); q[1] = (u8)(b >> 16); q[2] = (u8)(b >> 8); q[3] = (u8)b;
+    }
+}
+
+/* one: one-shot draws served; late / late_n: late ranges' draws (after their first two) served / made */
+typedef struct { u64 served, hits, admits, nofit, held, diff, chg, one, late, late_n; } tally_t;
+static void add(tally_t* a, const tally_t* b)
+{
+    a->served += b->served; a->hits += b->hits; a->admits += b->admits; a->nofit += b->nofit;
+    a->held += b->held; a->diff += b->diff; a->chg += b->chg; a->one += b->one;
+    a->late += b->late; a->late_n += b->late_n;
+}
+
+static rsx_vcache s_c;
+
+/* One draw of range [0, nv-1] of the buffer at guest offset off in batch b:
+ * 0 not served (stream path), 1 admitted, 2 a hit. */
+static int draw(u32 off, u32 nv, u32 b, tally_t* t)
+{
+    attr_at(off);
+    rsx_vfetch_plan p;
+    rsx_vfetch_plan_init(&p, &s_st, 1u, 0, nv - 1u);
+    const u64 h0 = s_c.hits, m0 = s_c.misses, n0 = s_c.nofit, k0 = s_c.held;
+    u64 g; int hit;
+    const int ok = rsx_vcache_get(&s_c, &p, 16u, s_arena, b, &g, &hit);
+    t->hits += s_c.hits - h0; t->admits += s_c.misses - m0; t->nofit += s_c.nofit - n0; t->held += s_c.held - k0;
+    if (!ok) return 0;
+    t->served++;
+    const u64 bytes = (u64)nv * 16u;
+    rsx_vfetch_convert(&p, NULL, 0, nv, s_ref, 16u);
+    if (memcmp(s_arena + g, s_ref, (size_t)bytes)) t->diff++;
+    served_t* s = &s_srv[b & 1u][s_nsrv[b & 1u]++];
+    s->g = g; s->bytes = bytes; s->h = fnv(s_arena + g, bytes); s->batch = b;
+    return hit ? 2 : 1;
+}
+
+/* The end of batch b: every draw of b and of b-1 still reads what it was served. */
+static void batch_end(u32 b, tally_t* t)
+{
+    for (u32 k = 0; k < 2u && k <= b; k++) {
+        const u32 bb = b - k;
+        for (u32 i = 0; i < s_nsrv[bb & 1u]; i++) {
+            const served_t* s = &s_srv[bb & 1u][i];
+            if (s->batch == bb && fnv(s_arena + s->g, s->bytes) != s->h) t->chg++;
+        }
+    }
+    s_nsrv[(b + 1u) & 1u] = 0;   /* batch b+1 reuses b-1's list */
+}
+
+static void cache_new(int admit2, int evac, int verify)
+{
+    memset(s_arena, 0, (size_t)NSLAB << 20);
+    CHECK(rsx_vcache_init(&s_c, 0, (u64)NSLAB << 20, NENT) == 1, "init");
+    CHECK(s_c.admit2 == 1 && s_c.evac_on == 1, "init: admit2 and evac_on default on");
+    s_c.admit2 = (u32)admit2;
+    s_c.evac_on = (u32)evac;
+    if (verify) CHECK(rsx_vcache_verify_on(&s_c) == 1, "verify_on");
+    s_nsrv[0] = s_nsrv[1] = 0;
+}
+
+/* FRAMES frames; *all over every frame, *last over the last TAIL, *walk34
+ * the walk ranges' third and fourth draws served from the cache in the last
+ * TAIL frames. */
+static void run(tally_t* all, tally_t* last, u64* walk34)
+{
+    memset(all, 0, sizeof *all); memset(last, 0, sizeof *last); *walk34 = 0;
+    u32 batch = 1;
+    for (u32 f = 0; f < FRAMES; f++) {
+        for (u32 k = 0; k < NCHG; k++) fill(CHG_OFF(k), CHG_V, 1000u + f * 31u + k);   /* new content */
+        const u32 nlate = f / LATE_EVERY + 1u;                    /* late ranges begun so far */
+        const u32 n = NHOT + NONE + NCHG + 4u * NWALK + nlate;
+        tally_t ft; memset(&ft, 0, sizeof ft);
+        u32 nh = 0, no = 0, nc = 0, nw = 0, nl = 0, cur = batch;
+        for (u32 i = 0; i < n; i++) {
+            const u32 b = batch + (i * BPF) / n;
+            if (b != cur) { batch_end(cur, &ft); cur = b; }
+            /* interleave the kinds in proportion */
+            int kind;
+            if (no < NONE && no * n <= i * NONE) kind = K_ONE;
+            else if (nc < NCHG && nc * n <= i * NCHG) kind = K_CHG;
+            else if (nw < 4u * NWALK && nw * n <= i * 4u * NWALK) kind = K_WALK;
+            else if (nl < nlate && nl * n <= i * nlate) kind = K_LATE;
+            else if (nh < NHOT) kind = K_HOT;
+            else kind = no < NONE ? K_ONE : nc < NCHG ? K_CHG : nw < 4u * NWALK ? K_WALK : K_LATE;
+            int r;
+            switch (kind) {
+            case K_ONE: if (draw(ONE_OFF(f * NONE + no), ONE_V, b, &ft)) ft.one++; no++; break;
+            case K_CHG: draw(CHG_OFF(nc), CHG_V, b, &ft); nc++; break;
+            case K_HOT: draw(HOT_OFF(nh), HOT_V, b, &ft); nh++; break;
+            case K_LATE: {                     /* begun in frame nl * LATE_EVERY */
+                r = draw(LATE_OFF(nl), WALK_V, b, &ft);
+                if (f >= nl * LATE_EVERY + 2u) { ft.late_n++; if (r) ft.late++; }
+                nl++;
+                break; }
+            default: {                         /* walk: age nw / NWALK frames */
+                const u32 age = nw / NWALK, j = nw % NWALK;
+                nw++;
+                if (f < age) break;
+                r = draw(WALK_OFF((f - age) * NWALK + j), WALK_V, b, &ft);
+                if (age >= 2u && r && f + TAIL >= FRAMES) (*walk34)++;
+                break; }
+            }
+        }
+        batch_end(cur, &ft);
+        batch += BPF;
+        add(all, &ft);
+        if (f + TAIL >= FRAMES) add(last, &ft);
+    }
+}
+
+int main(void)
+{
+    vm_base = (u8*)calloc(GUEST_MB, 1u << 20);
+    s_arena = (u8*)malloc((size_t)NSLAB << 20);
+    s_ref = (u8*)malloc(1u << 20);
+    if (!vm_base || !s_arena || !s_ref) { printf("FAIL: memory\n"); return 1; }
+    for (u32 k = 0; k < NHOT; k++) fill(HOT_OFF(k), HOT_V, k);
+    fill(ONE_OFF(0), (FRAMES * NONE * 0x400u + ONE_V * 16u) / 16u, 50000u);
+    fill(WALK_OFF(0), (FRAMES * NWALK * 0x800u + WALK_V * 16u) / 16u, 90000u);
+    fill(LATE_OFF(0), (FRAMES / LATE_EVERY + 2u) * 0x2000u / 16u, 70000u);
+
+    /* 1. the four combinations (m: bit 0 admit2, bit 1 evac_on), the oracle attached */
+    tally_t a[4], l[4]; u64 w34[4], rec[4], mv[4];
+    for (int m = 0; m < 4; m++) {
+        cache_new(m & 1, m >> 1, 1);
+        run(&a[m], &l[m], &w34[m]);
+        rec[m] = s_c.recycled; mv[m] = s_c.moved;
+        const rsx_vcache_ver* v = s_c.ver;
+        printf("admit2=%d evac=%d: %u frames: served %llu (hits %llu, admitted %llu, moved %llu), nofit %llu, held %llu,"
+               " slabs recycled %llu, emptied %llu | last %u frames: hits %llu (walk 3rd/4th draws served %llu of %u,"
+               " late draws %llu of %llu), admits %llu, nofit %llu, held %llu | copies differing %llu, changed under a"
+               " running batch %llu |"
+               " oracle: %llu compared, %llu differing, %llu writes, %llu unsafe\n", m & 1, m >> 1, FRAMES,
+               (unsigned long long)a[m].served, (unsigned long long)a[m].hits, (unsigned long long)a[m].admits,
+               (unsigned long long)mv[m], (unsigned long long)a[m].nofit, (unsigned long long)a[m].held,
+               (unsigned long long)rec[m], (unsigned long long)s_c.evacs, TAIL,
+               (unsigned long long)l[m].hits, (unsigned long long)w34[m], TAIL * 2u * NWALK,
+               (unsigned long long)l[m].late, (unsigned long long)l[m].late_n,
+               (unsigned long long)l[m].admits, (unsigned long long)l[m].nofit, (unsigned long long)l[m].held,
+               (unsigned long long)a[m].diff, (unsigned long long)a[m].chg, (unsigned long long)v->draws,
+               (unsigned long long)v->diff_draws, (unsigned long long)v->writes, (unsigned long long)v->unsafe_writes);
+        CHECK(a[m].diff == 0, "m%d: %llu served copies differ from the reference", m, (unsigned long long)a[m].diff);
+        CHECK(a[m].chg == 0, "m%d: %llu draws of B / B-1 changed while B was recorded", m, (unsigned long long)a[m].chg);
+        CHECK(v->draws == a[m].served && v->diff_draws == 0 && v->unsafe_writes == 0, "m%d: the oracle disagrees", m);
+    }
+    CHECK(l[0].nofit > 0, "both off: no nofit in the last frames (the scenario does not reproduce the old freeze)");
+    CHECK(l[1].nofit > 0, "admit2 only: no nofit in the last frames (the late ranges do not reproduce the freeze)");
+    CHECK(l[3].nofit == 0, "both on: %llu nofit in the last %u frames", (unsigned long long)l[3].nofit, TAIL);
+    CHECK(l[3].late == l[3].late_n, "both on: late draws served %llu of %llu",
+          (unsigned long long)l[3].late, (unsigned long long)l[3].late_n);
+    CHECK(l[3].hits >= TAIL * NHOT, "both on: %llu hits in the last frames, want >= %u",
+          (unsigned long long)l[3].hits, TAIL * NHOT);
+    CHECK(w34[3] * 100u >= TAIL * 2u * NWALK * 99u, "both on: walk ranges' 3rd / 4th draws served %llu of %u (a stall?)",
+          (unsigned long long)w34[3], TAIL * 2u * NWALK);
+    CHECK(rec[3] > 0 && mv[3] > 0, "both on: no slab recycled / no copy moved (the scenario does not exercise them)");
+    CHECK(a[3].held >= (u64)FRAMES * NONE, "both on: %llu held, want every one-shot (%u)",
+          (unsigned long long)a[3].held, FRAMES * NONE);
+    CHECK(a[1].one == 0 && a[3].one == 0, "admit2: %llu / %llu one-shot draws served from the cache",
+          (unsigned long long)a[1].one, (unsigned long long)a[3].one);
+    CHECK(a[0].one > 0 && a[2].one > 0, "admit2=0: no one-shot draw admitted (the scenario does not exercise it)");
+
+    /* 2. a range seen once is held; its second sighting admits it; then it hits */
+    {
+        cache_new(1, 1, 0);
+        tally_t t; memset(&t, 0, sizeof t);
+        CHECK(draw(HOT_OFF(0), HOT_V, 1, &t) == 0 && s_c.held == 1, "first sighting: held");
+        CHECK(draw(HOT_OFF(0), HOT_V, 1, &t) == 1 && s_c.misses == 1, "second sighting: admitted");
+        CHECK(draw(HOT_OFF(0), HOT_V, 2, &t) == 2 && s_c.hits == 1, "third sighting: a hit");
+        CHECK(t.diff == 0, "copy differs");
+        cache_new(0, 1, 0);
+        memset(&t, 0, sizeof t);
+        CHECK(draw(HOT_OFF(0), HOT_V, 1, &t) == 1 && s_c.held == 0, "admit2=0: admitted on sight");
+    }
+
+    /* 3. the oracle catches a corrupted copy */
+    {
+        cache_new(1, 1, 1);
+        tally_t t; memset(&t, 0, sizeof t);
+        draw(HOT_OFF(1), HOT_V, 1, &t); draw(HOT_OFF(1), HOT_V, 1, &t);   /* held, admitted */
+        CHECK(s_nsrv[1] == 1, "admitted");
+        s_arena[s_srv[1][0].g + 37u] ^= 0x40u;                        /* planted: a stale byte */
+        draw(HOT_OFF(1), HOT_V, 2, &t);                               /* a hit on it */
+        CHECK(s_c.ver->diff_draws == 1 && s_c.ver->diff_bytes == 1, "the oracle missed a corrupted copy (%llu / %llu)",
+              (unsigned long long)s_c.ver->diff_draws, (unsigned long long)s_c.ver->diff_bytes);
+        CHECK(t.diff == 1, "the test's own check missed it");
+    }
+
+    /* 4. the oracle catches a recycle under a running batch: a planted
+     * bookkeeping fault (every slab stamped "old") while batch B-1 read every
+     * slab; B then admits new ranges into recycled slabs */
+    {
+        const u32 nv = 4096u, nfill = (NSLAB << 20) / (nv * 16u) - 1u;   /* 64 KB ranges: the region but one */
+        for (u32 k = 0; k < nfill + 2u * NSLAB; k++) fill(BIG_OFF(k), nv, 300000u + k);
+        cache_new(1, 0, 1);
+        tally_t t; memset(&t, 0, sizeof t);
+        u32 b = 100;
+        for (u32 r = 0; r < 3; r++, b++) {                            /* held, admitted, hit: every slab read */
+            for (u32 k = 0; k < nfill; k++) draw(BIG_OFF(k), nv, b, &t);
+            batch_end(b, &t);
+        }
+        CHECK(s_c.misses == nfill && s_c.hits == nfill && t.chg == 0 && s_c.ver->unsafe_writes == 0,
+              "setup: %llu admitted, %llu hits", (unsigned long long)s_c.misses, (unsigned long long)s_c.hits);
+        for (u32 s = 0; s < NSLAB; s++) s_c.slab_last[s] = 0;         /* planted: every slab looks old */
+        s_c.nofree_batch = ~0u;
+        for (u32 k = nfill; k < nfill + 2u * NSLAB; k++) {             /* new ranges, seen twice: admitted */
+            draw(BIG_OFF(k), nv, b, &t);
+            draw(BIG_OFF(k), nv, b, &t);
+        }
+        batch_end(b, &t);
+        CHECK(s_c.ver->unsafe_writes > 0, "the oracle missed a recycle under a running batch");
+        CHECK(t.chg > 0, "the test's own check missed it");
+        printf("planted faults: a corrupted copy -> oracle 1 draw / 1 byte differing; slabs recycled under batch B-1"
+               " -> oracle %llu unsafe writes, %llu draws changed under the independent check\n",
+               (unsigned long long)s_c.ver->unsafe_writes, (unsigned long long)t.chg);
+    }
+
+    if (s_fail) { printf("%d check(s) FAILED\n", s_fail); return 1; }
+    printf("test_vcache_admit2: all passed\n");
+    return 0;
+}
diff --git a/libs/video/tests/test_videoout_gamma.c b/libs/video/tests/test_videoout_gamma.c
new file mode 100644
index 0000000..33488b5
--- /dev/null
+++ b/libs/video/tests/test_videoout_gamma.c
@@ -0,0 +1,181 @@
+/*
+ * ps3recomp - video-out gamma: cellVideoOutSetGamma validation and the
+ * display transfer the present pass applies (libs/video/rsx_videoout_gamma.h).
+ *
+ * Mechanism test. The rules it encodes and their tiers:
+ *  - range [0.8, 1.2], NaN out, PARAMETER_OUT_OF_RANGE then
+ *    UNSUPPORTED_VIDEO_OUT, a rejected value leaves the gamma alone: T5
+ *    (RPCS3) -- the upper bound is an open question (CryEngine 3: 1.25);
+ *  - transfer out = round(255 * (in/255)^(1/g)), 0 and 255 fixed, 1.0 the
+ *    identity, VIDEOOUT_GAMMA=inv the other direction: the display-gamma
+ *    convention (SDL 1.2 SDL_gamma.c), direction an open question;
+ *  - GetGamma stores the big-endian float bits at the guest address.
+ * The spot values were computed independently (Python, the same formula).
+ *
+ * From external/ps3recomp (clang-cl; cc works the same with -o):
+ *   clang-cl /nologo -DRSX_VOG_NO_D3D12 -I include -I libs/video -I libs/misc
+ *     libs/video/tests/test_videoout_gamma.c libs/video/rsx_videoout_gamma.c
+ *     libs/misc/cellAvconfExt.c /Fe:T/tvg.exe
+ *   T/tvg.exe                              (defaults)
+ *   set VIDEOOUT_GAMMA=0   && T/tvg.exe off
+ *   set VIDEOOUT_GAMMA=inv && T/tvg.exe inv
+ *   set VIDEOOUT_GAMMA_FORCE=0.9 && T/tvg.exe force
+ */
+#include "rsx_videoout_gamma.h"
+#include "cellAvconfExt.h"
+#include "cellVideoOut.h"
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ---- what cellAvconfExt.c's guest-memory helpers reach, stubbed ---------- */
+static uint8_t s_ram[0x1000];
+uint8_t* vm_base = s_ram;
+uint32_t g_ww_lo = 0, g_ww_hi = 0;
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
+int  g_resv_store_active = 0;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+int  spu_coh_is_reserved(uint32_t addr) { (void)addr; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_coh_notify_write(uint32_t addr) { (void)addr; }
+
+static int s_fail = 0, s_pass = 0;
+#define CHECK(c, ...) do { if (c) s_pass++; else { s_fail++; printf("[FAIL] %s:%d: ", __FILE__, __LINE__); \
+                           printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static void test_rules(void)
+{
+    /* Range, NaN included. */
+    CHECK(rsx_vog_in_range(0.8f) && rsx_vog_in_range(1.0f) && rsx_vog_in_range(1.2f), "0.8, 1.0, 1.2 accepted");
+    CHECK(!rsx_vog_in_range(0.7999f) && !rsx_vog_in_range(1.2001f) && !rsx_vog_in_range(0.0f) &&
+          !rsx_vog_in_range(-1.0f) && !rsx_vog_in_range(1.25f), "outside [0.8,1.2] rejected");
+    CHECK(!rsx_vog_in_range(nanf("")), "NaN rejected");
+
+    /* VIDEOOUT_GAMMA. */
+    int ok;
+    CHECK(rsx_vog_parse_mode(NULL, &ok) == RSX_VOG_ON && ok, "unset -> on");
+    CHECK(rsx_vog_parse_mode("1", &ok) == RSX_VOG_ON && ok, "1 -> on");
+    CHECK(rsx_vog_parse_mode("0", &ok) == RSX_VOG_OFF && ok, "0 -> off");
+    CHECK(rsx_vog_parse_mode("inv", &ok) == RSX_VOG_INV && ok, "inv");
+    CHECK(rsx_vog_parse_mode("bogus", &ok) == RSX_VOG_ON && !ok, "unknown -> reported, default kept");
+
+    /* Exponent per mode. */
+    CHECK(rsx_vog_exponent(1.2f, RSX_VOG_ON) == 1.0f / 1.2f, "on: 1/g");
+    CHECK(rsx_vog_exponent(1.2f, RSX_VOG_INV) == 1.2f, "inv: g");
+    CHECK(rsx_vog_exponent(1.2f, RSX_VOG_OFF) == 1.0f, "off: identity");
+    CHECK(rsx_vog_exponent(1.0f, RSX_VOG_ON) == 1.0f && rsx_vog_exponent(1.0f, RSX_VOG_INV) == 1.0f,
+          "1.0 is the identity in both readings");
+
+    /* The 8-bit transfer. */
+    int ident = 1, fixed = 1, mono = 1;
+    const float es[] = { 1.0f / 1.2f, 1.0f / 0.8f, 1.2f, 0.8f };
+    for (int v = 0; v < 256; v++) ident &= rsx_vog_apply8((uint8_t)v, 1.0f) == v;
+    for (int k = 0; k < 4; k++) {
+        fixed &= rsx_vog_apply8(0, es[k]) == 0 && rsx_vog_apply8(255, es[k]) == 255;
+        for (int v = 1; v < 256; v++) mono &= rsx_vog_apply8((uint8_t)v, es[k]) >= rsx_vog_apply8((uint8_t)(v - 1), es[k]);
+    }
+    CHECK(ident, "exponent 1 is the identity on all 256 codes");
+    CHECK(fixed, "0 and 255 are fixed points");
+    CHECK(mono, "monotonic");
+    static const uint8_t in[6] = { 1, 16, 64, 128, 192, 254 };
+    static const uint8_t g12[6]  = { 3, 25, 81, 144, 201, 254 };   /* g=1.2, on  */
+    static const uint8_t g08[6]  = { 0, 8, 45, 108, 179, 254 };    /* g=0.8, on  */
+    static const uint8_t g12i[6] = { 0, 9, 49, 112, 181, 254 };    /* g=1.2, inv */
+    for (int i = 0; i < 6; i++) {
+        CHECK(rsx_vog_apply8(in[i], rsx_vog_exponent(1.2f, RSX_VOG_ON)) == g12[i], "g=1.2 on: %u -> %u, want %u",
+              in[i], rsx_vog_apply8(in[i], rsx_vog_exponent(1.2f, RSX_VOG_ON)), g12[i]);
+        CHECK(rsx_vog_apply8(in[i], rsx_vog_exponent(0.8f, RSX_VOG_ON)) == g08[i], "g=0.8 on: %u -> %u, want %u",
+              in[i], rsx_vog_apply8(in[i], rsx_vog_exponent(0.8f, RSX_VOG_ON)), g08[i]);
+        CHECK(rsx_vog_apply8(in[i], rsx_vog_exponent(1.2f, RSX_VOG_INV)) == g12i[i], "g=1.2 inv: %u -> %u, want %u",
+              in[i], rsx_vog_apply8(in[i], rsx_vog_exponent(1.2f, RSX_VOG_INV)), g12i[i]);
+    }
+    CHECK(rsx_vog_apply8(128, rsx_vog_exponent(1.2f, RSX_VOG_ON)) > 128, "on: gamma > 1 brightens");
+    /* g then 1/g round-trips within one code. */
+    int rt = 1;
+    for (int v = 0; v < 256; v++) {
+        int w = rsx_vog_apply8(rsx_vog_apply8((uint8_t)v, 1.0f / 1.1f), 1.1f);
+        rt &= abs(w - v) <= 1;
+    }
+    CHECK(rt, "1/g then g round-trips within 1 code");
+}
+
+static uint32_t be32(const uint8_t* p) { return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3]; }
+static uint32_t fbits(float f) { uint32_t b; memcpy(&b, &f, 4); return b; }
+
+static void test_hle(void)
+{
+    CHECK(rsx_videoout_gamma_get() == 1.0f, "boot value 1.0");
+    CHECK(cellVideoOutSetGamma(CELL_VIDEO_OUT_PRIMARY, 1.1f) == CELL_OK && rsx_videoout_gamma_get() == 1.1f,
+          "1.1 accepted and stored");
+    CHECK(cellVideoOutSetGamma(CELL_VIDEO_OUT_PRIMARY, 1.3f) == CELL_VIDEO_OUT_ERROR_PARAMETER_OUT_OF_RANGE &&
+          rsx_videoout_gamma_get() == 1.1f, "1.3 rejected, gamma unchanged");
+    CHECK(cellVideoOutSetGamma(CELL_VIDEO_OUT_PRIMARY, nanf("")) == CELL_VIDEO_OUT_ERROR_PARAMETER_OUT_OF_RANGE &&
+          rsx_videoout_gamma_get() == 1.1f, "NaN rejected");
+    /* The garbage the integer adapter used to pass (-0.0) is out of range. */
+    CHECK(cellVideoOutSetGamma(CELL_VIDEO_OUT_PRIMARY, -0.0f) == CELL_VIDEO_OUT_ERROR_PARAMETER_OUT_OF_RANGE,
+          "-0.0 rejected");
+    CHECK(cellVideoOutSetGamma(CELL_VIDEO_OUT_SECONDARY, 1.0f) == CELL_VIDEO_OUT_ERROR_UNSUPPORTED_VIDEO_OUT &&
+          rsx_videoout_gamma_get() == 1.1f, "secondary output rejected");
+    CHECK(cellVideoOutSetGamma(CELL_VIDEO_OUT_SECONDARY, 2.0f) == CELL_VIDEO_OUT_ERROR_PARAMETER_OUT_OF_RANGE,
+          "range is checked before the output");
+    CHECK(cellVideoOutSetGamma(CELL_VIDEO_OUT_PRIMARY, 0.8f) == CELL_OK &&
+          cellVideoOutSetGamma(CELL_VIDEO_OUT_PRIMARY, 1.2f) == CELL_OK && rsx_videoout_gamma_get() == 1.2f,
+          "bounds accepted");
+    memset(s_ram, 0, sizeof s_ram);
+    CHECK(cellVideoOutGetGamma(CELL_VIDEO_OUT_PRIMARY, (float*)(uintptr_t)0x100) == CELL_OK &&
+          be32(s_ram + 0x100) == fbits(1.2f), "GetGamma: big-endian float at the guest address (0x%08X)",
+          be32(s_ram + 0x100));
+}
+
+static void test_mode(const char* mode)
+{
+    float g = 0.0f;
+    rsx_videoout_gamma_set(1.2f);
+    float e = rsx_videoout_gamma_exponent_now(&g);
+    if (!strcmp(mode, "off"))
+        CHECK(rsx_videoout_gamma_mode() == RSX_VOG_OFF && e == 1.0f && g == 1.2f, "VIDEOOUT_GAMMA=0: identity (e=%g)", (double)e);
+    else if (!strcmp(mode, "inv"))
+        CHECK(rsx_videoout_gamma_mode() == RSX_VOG_INV && e == 1.2f, "VIDEOOUT_GAMMA=inv: e=g (e=%g)", (double)e);
+    else if (!strcmp(mode, "force"))
+        CHECK(g == 0.9f && e == 1.0f / 0.9f, "VIDEOOUT_GAMMA_FORCE=0.9: g=%g e=%g", (double)g, (double)e);
+    else
+        CHECK(rsx_videoout_gamma_mode() == RSX_VOG_ON && g == 1.2f && e == 1.0f / 1.2f, "default: e=1/g (e=%g)", (double)e);
+}
+
+/* The PC brightness (settings store "brightness"): 1.0 leaves the exponent
+ * bit for bit; b divides it; out of [0.25, 4] or NaN means 1.0. */
+static void test_brightness(void)
+{
+    float g = 0.0f;
+    rsx_videoout_gamma_set(1.09091f);   /* inFamous 2's */
+    const float e0 = rsx_videoout_gamma_exponent_now(&g);
+    CHECK(rsx_videoout_gamma_brightness() == 1.0f, "brightness 1.0 at boot");
+    rsx_videoout_gamma_set_brightness(1.0f);
+    CHECK(fbits(rsx_videoout_gamma_exponent_now(&g)) == fbits(e0), "brightness 1.0: the exponent bit-identical");
+    rsx_videoout_gamma_set_brightness(1.3f);
+    CHECK(rsx_videoout_gamma_exponent_now(&g) == e0 / 1.3f, "brightness 1.3: e / 1.3");
+    CHECK(rsx_vog_apply8(128, rsx_videoout_gamma_exponent_now(&g)) > rsx_vog_apply8(128, e0), "1.3 brightens mid-grey");
+    rsx_videoout_gamma_set_brightness(0.8f);
+    CHECK(rsx_vog_apply8(128, rsx_videoout_gamma_exponent_now(&g)) < rsx_vog_apply8(128, e0), "0.8 darkens mid-grey");
+    rsx_videoout_gamma_set_brightness(9.0f);
+    CHECK(rsx_videoout_gamma_brightness() == 1.0f, "out of range -> 1.0");
+    rsx_videoout_gamma_set_brightness(nanf(""));
+    CHECK(rsx_videoout_gamma_brightness() == 1.0f && fbits(rsx_videoout_gamma_exponent_now(&g)) == fbits(e0),
+          "NaN -> 1.0, exponent unchanged");
+}
+
+int main(int argc, char** argv)
+{
+    const char* mode = argc > 1 ? argv[1] : "default";
+    if (!strcmp(mode, "default")) {
+        test_rules();
+        test_hle();
+        test_brightness();
+    }
+    test_mode(mode);
+    printf("test_videoout_gamma (%s): %d passed, %d failed\n", mode, s_pass, s_fail);
+    return s_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_videoout_gamma_d3d12.c b/libs/video/tests/test_videoout_gamma_d3d12.c
new file mode 100644
index 0000000..b5ee027
--- /dev/null
+++ b/libs/video/tests/test_videoout_gamma_d3d12.c
@@ -0,0 +1,159 @@
+/*
+ * ps3recomp - the video-out gamma present pass on a real D3D12 device.
+ *
+ * Runs rsx_videoout_gamma_d3d12() (libs/video/rsx_videoout_gamma.c) on a
+ * 256x4 R8G8B8A8 render target holding every 8-bit code (R = x, G = 255 - x,
+ * B = x, A = 255 - x), reads it back and compares it with the reference
+ * transfer rsx_vog_apply8: RGB within one code of round(255*(v/255)^e) (the
+ * shader computes pow in fp32; the reference in double), alpha untouched,
+ * every row identical. Uses the WARP adapter, so no GPU is needed.
+ *
+ * Windows only. From external/ps3recomp:
+ *   clang-cl /nologo -I include -I libs/video libs/video/tests/test_videoout_gamma_d3d12.c
+ *     libs/video/rsx_videoout_gamma.c d3d12.lib dxgi.lib d3dcompiler.lib dxguid.lib /Fe:T/tvgd.exe
+ *   set VIDEOOUT_GAMMA_FORCE=1.2 && T/tvgd.exe      (also 0.8; with VIDEOOUT_GAMMA=inv)
+ * Without VIDEOOUT_GAMMA_FORCE it uses gamma 1.0 and checks the pass is a
+ * no-op (identity: no draw).
+ */
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "rsx_videoout_gamma.h"
+
+void rsx_videoout_gamma_d3d12(ID3D12Device*, ID3D12GraphicsCommandList*, ID3D12Resource*,
+                              D3D12_CPU_DESCRIPTOR_HANDLE, UINT, UINT);
+
+#define W 256u
+#define H 4u
+#define PITCH 1024u   /* 256 * 4, already 256-aligned */
+
+static int fail(const char* what, HRESULT hr)
+{
+    printf("[FAIL] %s (0x%08lX)\n", what, (unsigned long)hr);
+    return 1;
+}
+
+int main(void)
+{
+    IDXGIFactory4* fac = NULL; IDXGIAdapter* warp = NULL; ID3D12Device* dev = NULL;
+    HRESULT hr = CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&fac);
+    if (FAILED(hr)) return fail("CreateDXGIFactory1", hr);
+    hr = fac->lpVtbl->EnumWarpAdapter(fac, &IID_IDXGIAdapter, (void**)&warp);
+    if (FAILED(hr)) return fail("EnumWarpAdapter", hr);
+    hr = D3D12CreateDevice((IUnknown*)warp, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&dev);
+    if (FAILED(hr)) return fail("D3D12CreateDevice(WARP)", hr);
+
+    D3D12_COMMAND_QUEUE_DESC qd = {0};
+    qd.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    ID3D12CommandQueue* q = NULL; ID3D12CommandAllocator* al = NULL; ID3D12GraphicsCommandList* cl = NULL;
+    ID3D12Fence* fence = NULL;
+    if (FAILED(hr = dev->lpVtbl->CreateCommandQueue(dev, &qd, &IID_ID3D12CommandQueue, (void**)&q)))
+        return fail("CreateCommandQueue", hr);
+    if (FAILED(hr = dev->lpVtbl->CreateCommandAllocator(dev, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                                        &IID_ID3D12CommandAllocator, (void**)&al)))
+        return fail("CreateCommandAllocator", hr);
+    if (FAILED(hr = dev->lpVtbl->CreateCommandList(dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, al, NULL,
+                                                   &IID_ID3D12GraphicsCommandList, (void**)&cl)))
+        return fail("CreateCommandList", hr);
+    if (FAILED(hr = dev->lpVtbl->CreateFence(dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&fence)))
+        return fail("CreateFence", hr);
+
+    /* The "backbuffer": a render target, plus an upload and a readback buffer. */
+    D3D12_HEAP_PROPERTIES hdef = {0}, hup = {0}, hrb = {0};
+    hdef.Type = D3D12_HEAP_TYPE_DEFAULT; hup.Type = D3D12_HEAP_TYPE_UPLOAD; hrb.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; td.Width = W; td.Height = H;
+    td.DepthOrArraySize = 1; td.MipLevels = 1; td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    td.SampleDesc.Count = 1; td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = (UINT64)PITCH * H; bd.Height = 1;
+    bd.DepthOrArraySize = 1; bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource *rt = NULL, *up = NULL, *rb = NULL;
+    if (FAILED(hr = dev->lpVtbl->CreateCommittedResource(dev, &hdef, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rt)))
+        return fail("render target", hr);
+    if (FAILED(hr = dev->lpVtbl->CreateCommittedResource(dev, &hup, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&up)))
+        return fail("upload buffer", hr);
+    if (FAILED(hr = dev->lpVtbl->CreateCommittedResource(dev, &hrb, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rb)))
+        return fail("readback buffer", hr);
+    uint8_t src[PITCH * H];
+    for (unsigned y = 0; y < H; y++)
+        for (unsigned x = 0; x < W; x++) {
+            uint8_t* p = src + y * PITCH + x * 4;
+            p[0] = (uint8_t)x; p[1] = (uint8_t)(255 - x); p[2] = (uint8_t)x; p[3] = (uint8_t)(255 - x);
+        }
+    { void* m = NULL; D3D12_RANGE nr = {0, 0};
+      up->lpVtbl->Map(up, 0, &nr, &m); memcpy(m, src, sizeof src); up->lpVtbl->Unmap(up, 0, NULL); }
+
+    D3D12_DESCRIPTOR_HEAP_DESC rhd = {0};
+    rhd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV; rhd.NumDescriptors = 1;
+    ID3D12DescriptorHeap* rh = NULL;
+    if (FAILED(hr = dev->lpVtbl->CreateDescriptorHeap(dev, &rhd, &IID_ID3D12DescriptorHeap, (void**)&rh)))
+        return fail("RTV heap", hr);
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv;
+    rh->lpVtbl->GetCPUDescriptorHandleForHeapStart(rh, &rtv);
+    dev->lpVtbl->CreateRenderTargetView(dev, rt, NULL, rtv);
+
+    D3D12_TEXTURE_COPY_LOCATION tl = {0}, bl = {0};
+    tl.pResource = rt; tl.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; tl.SubresourceIndex = 0;
+    bl.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    bl.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    bl.PlacedFootprint.Footprint.Width = W; bl.PlacedFootprint.Footprint.Height = H;
+    bl.PlacedFootprint.Footprint.Depth = 1; bl.PlacedFootprint.Footprint.RowPitch = PITCH;
+    bl.pResource = up;
+    cl->lpVtbl->CopyTextureRegion(cl, &tl, 0, 0, 0, &bl, NULL);
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; b.Transition.pResource = rt;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &b);
+
+    /* The pass under test: RENDER_TARGET in, RENDER_TARGET out. */
+    rsx_videoout_gamma_d3d12(dev, cl, rt, rtv, W, H);
+
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &b);
+    bl.pResource = rb;
+    cl->lpVtbl->CopyTextureRegion(cl, &bl, 0, 0, 0, &tl, NULL);
+    cl->lpVtbl->Close(cl);
+    q->lpVtbl->ExecuteCommandLists(q, 1, (ID3D12CommandList**)&cl);
+    q->lpVtbl->Signal(q, fence, 1);
+    { HANDLE ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+      fence->lpVtbl->SetEventOnCompletion(fence, 1, ev); WaitForSingleObject(ev, 10000); CloseHandle(ev); }
+    if (FAILED(hr = dev->lpVtbl->GetDeviceRemovedReason(dev))) return fail("device removed", hr);
+
+    uint8_t* out = NULL; D3D12_RANGE rr = {0, (SIZE_T)PITCH * H};
+    rb->lpVtbl->Map(rb, 0, &rr, (void**)&out);
+    float g = 0.0f;
+    const float e = rsx_videoout_gamma_exponent_now(&g);
+    unsigned exact = 0, off1 = 0, bad = 0, alpha_bad = 0, rows_bad = 0;
+    for (unsigned x = 0; x < W; x++) {
+        const uint8_t* p = out + x * 4;
+        const uint8_t want[3] = { rsx_vog_apply8((uint8_t)x, e), rsx_vog_apply8((uint8_t)(255 - x), e),
+                                  rsx_vog_apply8((uint8_t)x, e) };
+        for (int c = 0; c < 3; c++) {
+            int d = abs((int)p[c] - (int)want[c]);
+            if (d == 0) exact++; else if (d == 1) off1++; else {
+                if (bad++ < 8) printf("  x=%u ch%d: got %u want %u\n", x, c, p[c], want[c]);
+            }
+        }
+        if (p[3] != (uint8_t)(255 - x)) alpha_bad++;
+        for (unsigned y = 1; y < H; y++) if (memcmp(p, out + y * PITCH + x * 4, 4)) rows_bad++;
+    }
+    rb->lpVtbl->Unmap(rb, 0, NULL);
+    printf("gamma %g exponent %g: %u exact, %u off by one, %u worse; alpha changed %u; rows differ %u\n",
+           (double)g, (double)e, exact, off1, bad, alpha_bad, rows_bad);
+    int ok = bad == 0 && alpha_bad == 0 && rows_bad == 0 && off1 <= W * 3 / 32;
+    printf("test_videoout_gamma_d3d12: %s\n", ok ? "PASS" : "FAIL");
+    return ok ? 0 : 1;
+}
diff --git a/libs/video/tests/test_vpc_norm.c b/libs/video/tests/test_vpc_norm.c
new file mode 100644
index 0000000..6b2eb12
--- /dev/null
+++ b/libs/video/tests/test_vpc_norm.c
@@ -0,0 +1,220 @@
+/*
+ * ps3recomp - rsx_vpc_norm.h test (RSX_CAP_VPC lane sums, VPC_NORM)
+ *
+ * A  parsing of VPC_NORM / RSX_CAP_VPC values (defaults, every lane, bad input);
+ * B  a 5-tap separable blur bank laid out like inFamous 2's glow pyramid
+ *    (c[462..466] = offset.xy, weight; horizontal pass weights summing to 1,
+ *    vertical pass 2x that, as every capture measured): lane sums, and the
+ *    vertical pass normalized back onto the horizontal weights while the
+ *    offsets and the horizontal pass stay bit-identical;
+ * C  sums that must be left alone (already 1, zero, negative, NaN, inf);
+ * D  what that factor does to the pyramid: with the vertical pass at 2x the
+ *    20x11 level ends 32x as bright as the 320x180 source and the composite
+ *    (BLOOM_MULTIPLIERS 1, 0.25, 0.125, 0.25, 0.09375 over 320..20 levels)
+ *    has a gain of 11 instead of 1.72 -- a mid-grey glow source saturates;
+ * E  the sum gate (default @2): only the 2.0 vertical passes are rescaled,
+ *    never the horizontal passes (1.0) or the water-reflection blur (0.90),
+ *    which the same fragment program draws with a different VP.
+ *
+ * Build (clang-cl, from libs/video/tests):
+ *   clang-cl -O2 -I.. test_vpc_norm.c -Fe:test_vpc_norm.exe
+ */
+#include "rsx_vpc_norm.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+static int g_fail, g_checks;
+#define CHECK(c, ...) do { g_checks++; if (!(c)) { g_fail++; printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+                                                   printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static float bank[512 * 4];
+
+static void set_c(unsigned slot, float x, float y, float z, float w)
+{
+    bank[slot * 4 + 0] = x; bank[slot * 4 + 1] = y; bank[slot * 4 + 2] = z; bank[slot * 4 + 3] = w;
+}
+
+/* Taps as fitted from the captures (texel offsets 0, +-1.39, +-3.29; weights
+ * 0.183 / 0.295 / 0.1145, normalized). dir 0 = horizontal, 1 = vertical. */
+static const float k_off[5] = { 0.0f, 1.39f, -1.39f, 3.29f, -3.29f };
+static const float k_w[5]   = { 0.182f, 0.2955f, 0.2955f, 0.1135f, 0.1135f };
+static void blur_bank(int dir, float gain, float texel)
+{
+    memset(bank, 0, sizeof bank);
+    set_c(461, 0.0f, 1.0f, 0.0f, 0.0f);                      /* the program's literal */
+    for (int i = 0; i < 5; i++)
+        set_c(466u - (unsigned)i, dir ? 0.0f : k_off[i] * texel, dir ? k_off[i] * texel : 0.0f,
+              k_w[i] * gain, 0.0f);
+    set_c(467, 0.5f, -0.5f, 0.5f, 0.5f);                      /* uv = pos * xy + zw */
+}
+
+static void test_parse(void)
+{
+    rsx_vpc_norm_cfg c;
+    CHECK(rsx_vpc_norm_parse("62949BCC", &c) && c.fp_id == 0x62949BCCu && c.lo == 462 && c.hi == 466 &&
+          c.lane == 2, "defaults: id %08X %u-%u lane %u", c.fp_id, c.lo, c.hi, c.lane);
+    CHECK(rsx_vpc_norm_parse("62949bcc:456-467", &c) && c.lo == 456 && c.hi == 467 && c.lane == 2,
+          "range: %u-%u lane %u", c.lo, c.hi, c.lane);
+    const char* lanes = "xyzw";
+    for (unsigned l = 0; l < 4; l++) {
+        char s[64]; snprintf(s, sizeof s, "1:10-12.%c", lanes[l]);
+        CHECK(rsx_vpc_norm_parse(s, &c) && c.fp_id == 1 && c.lo == 10 && c.hi == 12 && c.lane == l,
+              "lane %c -> %u", lanes[l], c.lane);
+    }
+    static const char* bad[] = { "", "0", "zz", "62949BCC:", "62949BCC:466-462", "62949BCC:462",
+                                 "62949BCC:462-466.q", "62949BCC:462-466.zz", "62949BCC:1-600",
+                                 "62949BCC junk" };
+    for (unsigned i = 0; i < sizeof bad / sizeof bad[0]; i++)
+        CHECK(!rsx_vpc_norm_parse(bad[i], &c) && c.fp_id == 0, "accepted bad \"%s\"", bad[i]);
+    CHECK(!rsx_vpc_norm_parse(NULL, &c), "NULL accepted");
+
+    unsigned lo = 0, hi = 0;
+    CHECK(rsx_vpc_range_parse("456-467", &lo, &hi) && lo == 456 && hi == 467, "range %u-%u", lo, hi);
+    CHECK(rsx_vpc_range_parse("461", &lo, &hi) && lo == 461 && hi == 461, "single %u-%u", lo, hi);
+    CHECK(!rsx_vpc_range_parse("467-456", &lo, &hi), "reversed range accepted");
+    CHECK(!rsx_vpc_range_parse("1-512", &lo, &hi), "slot 512 accepted");
+    CHECK(!rsx_vpc_range_parse("x", &lo, &hi) && !rsx_vpc_range_parse("", &lo, &hi), "garbage accepted");
+}
+
+static void test_blur_bank(void)
+{
+    const float texel = 1.0f / 80.0f;
+    blur_bank(0, 1.0f, texel);
+    const float sh = rsx_vpc_lane_sum(bank, 462, 466, 2);
+    CHECK(fabsf(sh - 1.0f) < 1e-5f, "horizontal weights sum %f", sh);
+    float before[512 * 4]; memcpy(before, bank, sizeof bank);
+    CHECK(fabsf(rsx_vpc_normalize(bank, 462, 466, 2) - 1.0f) < 1e-5f &&
+          !memcmp(before, bank, sizeof bank), "a bank already summing to 1 was changed");
+
+    blur_bank(1, 2.0f, 1.0f / 45.0f);
+    float hz[5];
+    for (int i = 0; i < 5; i++) hz[i] = k_w[i];
+    const float sv = rsx_vpc_lane_sum(bank, 462, 466, 2);
+    CHECK(fabsf(sv - 2.0f) < 1e-5f, "vertical weights sum %f", sv);
+    memcpy(before, bank, sizeof bank);
+    const float got = rsx_vpc_normalize(bank, 462, 466, 2);
+    CHECK(fabsf(got - 2.0f) < 1e-5f, "normalize returned %f", got);
+    CHECK(fabsf(rsx_vpc_lane_sum(bank, 462, 466, 2) - 1.0f) < 1e-5f, "after: sum %f",
+          rsx_vpc_lane_sum(bank, 462, 466, 2));
+    for (int i = 0; i < 5; i++) {
+        const unsigned s = 466u - (unsigned)i;
+        CHECK(fabsf(bank[s * 4 + 2] - hz[i]) < 1e-6f, "tap %d weight %f, want %f", i, bank[s * 4 + 2], hz[i]);
+        CHECK(bank[s * 4 + 0] == before[s * 4 + 0] && bank[s * 4 + 1] == before[s * 4 + 1] &&
+              bank[s * 4 + 3] == before[s * 4 + 3], "tap %d: other lanes changed", i);
+    }
+    for (unsigned s = 0; s < 512; s++)
+        if (s < 462 || s > 466)
+            CHECK(!memcmp(&bank[s * 4], &before[s * 4], 16), "slot %u outside the range changed", s);
+}
+
+static void test_left_alone(void)
+{
+    static const float sums[] = { 0.0f, -1.0f };
+    for (unsigned k = 0; k < 2; k++) {
+        memset(bank, 0, sizeof bank);
+        bank[462 * 4 + 2] = sums[k];
+        float b[512 * 4]; memcpy(b, bank, sizeof bank);
+        rsx_vpc_normalize(bank, 462, 466, 2);
+        CHECK(!memcmp(b, bank, sizeof bank), "sum %f was rescaled", sums[k]);
+    }
+    memset(bank, 0, sizeof bank);
+    bank[463 * 4 + 2] = NAN;
+    rsx_vpc_normalize(bank, 462, 466, 2);
+    CHECK(isnan(bank[463 * 4 + 2]) && bank[462 * 4 + 2] == 0.0f, "NaN sum rescaled");
+    memset(bank, 0, sizeof bank);
+    bank[463 * 4 + 2] = INFINITY;
+    rsx_vpc_normalize(bank, 462, 466, 2);
+    CHECK(isinf(bank[463 * 4 + 2]), "inf sum rescaled");
+    CHECK(rsx_vpc_lane_sum(bank, 462, 466, 4) == 0.0f && rsx_vpc_lane_sum(NULL, 0, 1, 0) == 0.0f &&
+          rsx_vpc_lane_sum(bank, 5, 4, 0) == 0.0f, "bad lane / NULL / empty range not 0");
+}
+
+/* The pyramid as the captures run it: level 0 = 320x180 (the glow source S
+ * after its own H/V blur), each further level = 2:1 downsample (gain 1) +
+ * horizontal blur (sum h) + vertical blur (sum v). Composite =
+ * level0 * k0 + sum(level_n * k_n) (fp 1666FA8D added onto 0xE3C000). */
+static float pyramid_gain(float h, float v)
+{
+    static const float k[5] = { 1.0f, 0.25f, 0.125f, 0.25f, 0.09375f };   /* 320,160,80,40,20 */
+    float level = h * v, total = 0.0f;                                     /* 320x180 after its blur */
+    for (int n = 0; n < 5; n++) {
+        total += k[n] * level;
+        level *= h * v;                                                    /* next level's blur */
+    }
+    return total;
+}
+
+static void test_pyramid(void)
+{
+    const float g2 = pyramid_gain(1.0f, 2.0f), g1 = pyramid_gain(1.0f, 1.0f);
+    CHECK(fabsf(g2 - 11.0f) < 1e-4f, "2x vertical: composite gain %f, want 11", g2);
+    CHECK(fabsf(g1 - 1.71875f) < 1e-4f, "normalized: composite gain %f, want 1.71875", g1);
+    /* a glow source of 0.1 (scene 0.5 x glow mask 0.2) over a 0.5 scene */
+    CHECK(0.5f + 0.1f * g2 > 1.0f && 0.5f + 0.1f * g1 < 0.7f,
+          "saturation: %f vs %f", 0.5f + 0.1f * g2, 0.5f + 0.1f * g1);
+}
+
+/* E  the sum gate: by default VPC_NORM only rescales a sum near 2.0 (the
+ *    pyramid's vertical passes). The same fragment program blurs the 256x256
+ *    water reflection with a different VP (vertical gain measured 0.90) and
+ *    the horizontal passes sum to 1; neither may be touched, or the water the
+ *    experiment is judged on changes too. "@0" restores normalize-any. */
+static void test_gate(void)
+{
+    rsx_vpc_norm_cfg c;
+    CHECK(rsx_vpc_norm_parse("62949BCC", &c) && c.from == 2.0f, "default from %f", (double)c.from);
+    CHECK(rsx_vpc_norm_parse("62949BCC@0", &c) && c.from == 0.0f && c.lo == 462 && c.lane == 2,
+          "@0: from %f", (double)c.from);
+    CHECK(rsx_vpc_norm_parse("62949BCC:456-467.w@1.5", &c) && c.from == 1.5f && c.lo == 456 &&
+          c.hi == 467 && c.lane == 3, "range+lane+@: %u-%u lane %u from %f", c.lo, c.hi, c.lane, (double)c.from);
+    static const char* bad[] = { "62949BCC@", "62949BCC@-1", "62949BCC@x", "62949BCC@2junk",
+                                 "62949BCC@2@3", "62949BCC:462-466@" };
+    for (unsigned i = 0; i < sizeof bad / sizeof bad[0]; i++)
+        CHECK(!rsx_vpc_norm_parse(bad[i], &c) && c.fp_id == 0, "accepted bad \"%s\"", bad[i]);
+
+    rsx_vpc_norm_cfg two;
+    rsx_vpc_norm_parse("62949BCC", &two);
+    static const struct { float s; int want; } g2[] = {
+        { 2.0f, 1 }, { 1.999f, 1 }, { 1.95f, 1 }, { 2.05f, 1 },     /* the vertical passes (fits 1.9989..2.0000) */
+        { 1.0f, 0 }, { 0.8996f, 0 }, { 1.9f, 0 }, { 2.1f, 0 },      /* horizontal, reflection blur, near misses */
+        { 0.0f, 0 }, { -2.0f, 0 }, { 4.0f, 0 } };
+    for (unsigned i = 0; i < sizeof g2 / sizeof g2[0]; i++)
+        CHECK(rsx_vpc_norm_wants(&two, g2[i].s) == g2[i].want, "@2: sum %f -> %d", (double)g2[i].s,
+              rsx_vpc_norm_wants(&two, g2[i].s));
+    CHECK(!rsx_vpc_norm_wants(&two, NAN) && !rsx_vpc_norm_wants(&two, INFINITY) &&
+          !rsx_vpc_norm_wants(NULL, 2.0f), "NaN / inf / NULL cfg accepted");
+    rsx_vpc_norm_cfg any;
+    rsx_vpc_norm_parse("62949BCC@0", &any);
+    CHECK(rsx_vpc_norm_wants(&any, 0.8996f) && rsx_vpc_norm_wants(&any, 2.0f) &&
+          !rsx_vpc_norm_wants(&any, 1.0f) && !rsx_vpc_norm_wants(&any, 0.0f), "@0 gate");
+
+    /* One frame's 62949BCC draws as the gate sees them: reflection blur H/V,
+     * then the pyramid's H/V pairs. Only the 2.0 banks are rescaled. */
+    static const float frame[] = { 1.0f, 0.8996f, 1.0f, 2.0f, 1.0f, 2.0f, 1.0f, 2.0f };
+    int rescaled = 0;
+    for (unsigned i = 0; i < sizeof frame / sizeof frame[0]; i++) {
+        blur_bank((int)(i & 1u), frame[i], 1.0f / 80.0f);
+        float before[512 * 4]; memcpy(before, bank, sizeof bank);
+        const float s = rsx_vpc_lane_sum(bank, two.lo, two.hi, two.lane);
+        if (rsx_vpc_norm_wants(&two, s)) { rsx_vpc_normalize(bank, two.lo, two.hi, two.lane); rescaled++; }
+        const float after = rsx_vpc_lane_sum(bank, two.lo, two.hi, two.lane);
+        if (frame[i] == 2.0f)
+            CHECK(fabsf(after - 1.0f) < 1e-5f, "draw %u: vertical pass sum %f after", i, (double)after);
+        else
+            CHECK(!memcmp(before, bank, sizeof bank), "draw %u (sum %f) was changed", i, (double)frame[i]);
+    }
+    CHECK(rescaled == 3, "rescaled %d draws, want 3", rescaled);
+}
+
+int main(void)
+{
+    test_parse();
+    test_blur_bank();
+    test_left_alone();
+    test_pyramid();
+    test_gate();
+    printf("%s: %d checks, %d failed\n", g_fail ? "FAIL" : "PASS", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_winmenu.c b/libs/video/tests/test_winmenu.c
new file mode 100644
index 0000000..4ef68d1
--- /dev/null
+++ b/libs/video/tests/test_winmenu.c
@@ -0,0 +1,641 @@
+/*
+ * ps3recomp - the game window's menu bar (rsx_winmenu.c) on a real Win32
+ * window, with the real hotkey table and keyboard filter (cellPad.c) and the
+ * real save-state UI side (ss_ui.c). The window procedure below calls them in
+ * the backend's order (rsx_d3d12_backend.c d3d12_wndproc): rsx_winmenu_message,
+ * then cellPad_host_window_message, then its own modal-loop timer -- the
+ * backend's frame-clock tick inside menu loops -- then DefWindowProc.
+ *
+ * Covers: the four menus and their items (labels from slot files, key texts,
+ * greyed empty slots, busy greying, the Options hook), the client area keeping
+ * its size with the bar (one row), the bar off in "fullscreen" and back
+ * after with the same client size, menu commands and hotkeys queuing requests
+ * (exact modifiers, auto-repeat swallowed) and never running them, the stub's
+ * notice reaching the notice box (also from another thread), the FPS box, Exit,
+ * input hold on menu-loop enter/exit, the system menu left alone, the menu
+ * freed with the window (attached or not). Alt, F10, Alt+letter and direct
+ * SC_KEYMENU never start a menu loop.
+ * --menuloop also runs a real menu loop (the `menu` hotkey): keyboard/mouse
+ * input is held while it runs, the modal timer keeps ticking inside it (the
+ * game would keep running), and it ends cleanly. It enters a menu loop on this
+ * thread, so it is opt-in: run it while no other program is being driven with
+ * synthetic input.
+ *
+ * The window is never activated and sits outside every monitor; no input is
+ * synthesized system-wide (messages go to this window only). PAD_NO_HOST and
+ * PAD_NO_MOUSE keep controllers and the raw-mouse thread out.
+ *
+ *   test_winmenu <scratch dir> [--menuloop]
+ *
+ * Build and run (Windows, from external/ps3recomp):
+ *   clang-cl /std:c17 /O2 /MD -D_CRT_SECURE_NO_WARNINGS -I include -I libs/input -I libs/system
+ *            -I runtime/ppu -I libs/video libs/video/tests/test_winmenu.c libs/video/rsx_winmenu.c
+ *            runtime/savestate/ss_ui.c libs/input/cellPad.c libs/input/pad_host_win.c
+ *            libs/input/pad_hid_*.c libs/system/options.c runtime/diag/play_issues.c
+ *            user32.lib gdi32.lib /Fe:test_winmenu.exe
+ *   test_winmenu.exe %TEMP%\test_winmenu
+ */
+#include "rsx_winmenu.h"
+#include "cellPad.h"
+#include "pad_hotkeys.h"
+#include "../../runtime/savestate/ss_ui.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+#pragma comment(lib, "user32.lib")
+#pragma comment(lib, "gdi32.lib")
+
+/* --- what the runtime provides to ppu_memory.h's inline writers (cellPad.c) */
+uint8_t* vm_base;
+int      g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+int  spu_coh_is_reserved(uint32_t addr) { (void)addr; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_coh_notify_write(uint32_t addr) { (void)addr; }
+void spu_coh_ppu_atomic_note(uint32_t addr) { (void)addr; }
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
+
+static int g_fail, g_checks;
+#define CHECK(c, ...) do { g_checks++; if (!(c)) { g_fail++; printf("FAIL line %d: ", __LINE__); \
+                           printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+#define CW 1280
+#define CH 720
+#define MODAL_TIMER 0x44495350u
+#define WATCHDOG    0x57444F47u
+
+static const DWORD k_style = WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN;
+static const DWORD k_exstyle = WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW;
+static int g_offx, g_offy;                     /* outside every monitor */
+
+/* --- the window procedure (the backend's order) --------------------------- */
+static int g_keymenu, g_enter, g_exit, g_ticks, g_close, g_held_in_loop, g_inmenu_in_loop, g_end_after;
+static LRESULT CALLBACK wndproc(HWND h, UINT msg, WPARAM wp, LPARAM lp)
+{
+    if (msg == WM_SYSCOMMAND && (wp & 0xFFF0) == SC_KEYMENU) g_keymenu++;
+    intptr_t r = 0;
+    if (rsx_winmenu_message(h, msg, (uintptr_t)wp, (intptr_t)lp, &r)) return (LRESULT)r;
+    if (cellPad_host_window_message(h, msg, (uintptr_t)wp, (intptr_t)lp, &r)) return (LRESULT)r;
+    switch (msg) {
+    case WM_CLOSE: g_close++; return 0;        /* the backend quits; the test keeps the window */
+    case WM_ENTERMENULOOP:
+        g_enter++;
+        SetTimer(h, MODAL_TIMER, USER_TIMER_MINIMUM, NULL);
+        SetTimer(h, WATCHDOG, 3000, NULL);
+        break;
+    case WM_EXITMENULOOP:
+        g_exit++;
+        KillTimer(h, MODAL_TIMER);
+        KillTimer(h, WATCHDOG);
+        break;
+    case WM_TIMER:
+        if (wp == MODAL_TIMER) {               /* the frame clock's tick inside the loop */
+            g_ticks++;
+            if (cellPad_host_input_held()) g_held_in_loop++;
+            if (rsx_winmenu_in_menu()) g_inmenu_in_loop++;
+            if (g_end_after && g_ticks >= g_end_after) EndMenu();
+            return 0;
+        }
+        if (wp == WATCHDOG) { printf("watchdog: ending a menu loop\n"); EndMenu(); return 0; }
+        break;
+    }
+    return DefWindowProcW(h, msg, wp, lp);
+}
+
+/* --- the host: fullscreen as the backend does it, off screen ------------- */
+static int  g_fs;
+static RECT g_saved_rc;
+static LONG g_saved_style;
+static void host_toggle(void* hwnd)
+{
+    HWND h = (HWND)hwnd;
+    if (!g_fs) {
+        GetWindowRect(h, &g_saved_rc);
+        g_saved_style = GetWindowLongW(h, GWL_STYLE);
+        SetWindowLongW(h, GWL_STYLE, (g_saved_style & ~(LONG)WS_OVERLAPPEDWINDOW) | (LONG)WS_POPUP);
+        g_fs = 1;
+        rsx_winmenu_set_fullscreen(h, 1);
+        SetWindowPos(h, NULL, g_offx, g_offy, 2560, 1080, SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED);
+    } else {
+        g_fs = 0;
+        SetWindowLongW(h, GWL_STYLE, g_saved_style);
+        rsx_winmenu_set_fullscreen(h, 0);
+        SetWindowPos(h, NULL, g_saved_rc.left, g_saved_rc.top, g_saved_rc.right - g_saved_rc.left,
+                     g_saved_rc.bottom - g_saved_rc.top, SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED);
+    }
+}
+static int  host_is_fs(void) { return g_fs; }
+static void host_rect(void* hwnd, int* x, int* y, int* w, int* hh)
+{
+    RECT rc;
+    GetClientRect((HWND)hwnd, &rc);
+    *x = 0; *y = 0; *w = rc.right; *hh = rc.bottom;
+}
+static const rsx_winmenu_host k_host = { host_toggle, host_is_fs, host_rect };
+
+/* --- the options overlay's hooks ----------------------------------------- */
+static int g_opened, g_ovl_fps;
+static void ovl_open(void) { g_opened++; }
+static int  ovl_get_fps(void) { return g_ovl_fps; }
+static void ovl_set_fps(int on) { g_ovl_fps = on; }
+
+/* --- helpers ----------------------------------------------------------------- */
+static void pump(int ms)
+{
+    ULONGLONG end = GetTickCount64() + (ULONGLONG)ms;
+    do {
+        MSG m;
+        while (PeekMessageW(&m, NULL, 0, 0, PM_REMOVE)) { TranslateMessage(&m); DispatchMessageW(&m); }
+        Sleep(1);
+    } while (GetTickCount64() < end);
+}
+
+static HWND make_window(HMENU bar)
+{
+    RECT r = { 0, 0, CW, CH };
+    AdjustWindowRectEx(&r, k_style, bar != NULL, k_exstyle);
+    HWND h = CreateWindowExW(k_exstyle, L"test_winmenu", L"test_winmenu", k_style, g_offx, g_offy,
+                             r.right - r.left, r.bottom - r.top, NULL, bar, GetModuleHandleW(NULL), NULL);
+    if (h) ShowWindow(h, SW_SHOWNOACTIVATE);
+    return h;
+}
+
+static void client(HWND h, int* w, int* hh)
+{
+    RECT rc;
+    GetClientRect(h, &rc);
+    *w = rc.right;
+    *hh = rc.bottom;
+}
+
+/* Item text (UTF-8) and state of a popup's item, after a WM_INITMENUPOPUP. */
+static const char* item(HMENU m, int pos, UINT* state)
+{
+    static char out[4][300];
+    static int k;
+    k = (k + 1) & 3;
+    wchar_t w[300];
+    w[0] = 0;
+    GetMenuStringW(m, (UINT)pos, w, 300, MF_BYPOSITION);
+    WideCharToMultiByte(CP_UTF8, 0, w, -1, out[k], 300, NULL, NULL);
+    if (state) *state = GetMenuState(m, (UINT)pos, MF_BYPOSITION);
+    return out[k];
+}
+
+static HMENU open_popup(HWND h, int index)
+{
+    HMENU sub = GetSubMenu(GetMenu(h), index);
+    SendMessageW(h, WM_INITMENUPOPUP, (WPARAM)sub, MAKELPARAM(index, FALSE));
+    return sub;
+}
+
+static void set_mods(int ctrl, int shift, int alt)
+{
+    BYTE ks[256];
+    GetKeyboardState(ks);
+    ks[VK_CONTROL] = ks[VK_LCONTROL] = ctrl ? 0x80 : 0;
+    ks[VK_SHIFT] = ks[VK_LSHIFT] = shift ? 0x80 : 0;
+    ks[VK_MENU] = ks[VK_LMENU] = alt ? 0x80 : 0;
+    SetKeyboardState(ks);
+}
+
+static LPARAM key_lp(int vk, int alt, int repeat, int up)
+{
+    UINT sc = MapVirtualKeyW((UINT)vk, MAPVK_VK_TO_VSC);
+    LPARAM lp = 1 | ((LPARAM)sc << 16);
+    if (alt) lp |= 1 << 29;
+    if (repeat || up) lp |= 1 << 30;
+    if (up) lp |= (LPARAM)1 << 31;
+    return lp;
+}
+
+static void key(HWND h, int vk, int ctrl, int shift, int alt, int repeat)
+{
+    set_mods(ctrl, shift, alt);
+    const UINT down = (alt || vk == VK_F10) ? WM_SYSKEYDOWN : WM_KEYDOWN;
+    SendMessageW(h, down, (WPARAM)vk, key_lp(vk, alt, repeat, 0));
+    SendMessageW(h, down == WM_SYSKEYDOWN ? WM_SYSKEYUP : WM_KEYUP, (WPARAM)vk, key_lp(vk, alt, 0, 1));
+    set_mods(0, 0, 0);
+}
+
+/* This process's notice box (a running game has one of its own). */
+static HWND find_osd(void)
+{
+    HWND w = NULL;
+    while ((w = FindWindowExW(NULL, w, L"ps3recomp_osd", NULL)) != NULL) {
+        DWORD pid = 0;
+        GetWindowThreadProcessId(w, &pid);
+        if (pid == GetCurrentProcessId()) return w;
+    }
+    return NULL;
+}
+
+static long take(void)                         /* the queued request, then the stub's step */
+{
+    const long code = g_ss_ui_pending;
+    ss_ui_service(1);
+    return code;
+}
+#define REQ(op, slot) (((long)(op) << 8) | (long)((slot) + 1))
+
+/* Alt alone, F10 alone, Alt+S (with the WM_SYSCHAR TranslateMessage makes)
+ * and SC_KEYMENU sent directly, through the window procedure: SC_KEYMENU
+ * arrives, no menu loop starts, nothing is queued. A loop started by mistake
+ * ends by itself (g_end_after), so this cannot hang. */
+static void no_menu_from_keys(HWND h, const char* what)
+{
+    g_keymenu = g_enter = g_exit = g_ticks = 0;
+    g_end_after = 6;
+    key(h, VK_MENU, 0, 0, 1, 0);
+    key(h, VK_F10, 0, 0, 0, 0);
+    set_mods(0, 0, 1);
+    SendMessageW(h, WM_SYSKEYDOWN, 'S', key_lp('S', 1, 0, 0));
+    SendMessageW(h, WM_SYSCHAR, 's', key_lp('S', 1, 0, 0));
+    SendMessageW(h, WM_SYSKEYUP, 'S', key_lp('S', 1, 0, 1));
+    set_mods(0, 0, 0);
+    SendMessageW(h, WM_SYSCOMMAND, SC_KEYMENU, 0);
+    SendMessageW(h, WM_SYSCOMMAND, SC_KEYMENU, 'l');
+    pump(30);
+    printf("Alt / F10 / Alt+S / SC_KEYMENU (%s): %d SC_KEYMENU, %d menu loops\n", what, g_keymenu, g_enter);
+    CHECK(g_keymenu >= 2, "%s: SC_KEYMENU reached the window %d times", what, g_keymenu);
+    CHECK(g_enter == 0, "%s: but no menu loop started (%d)", what, g_enter);
+    CHECK(g_ss_ui_pending == 0, "%s: and nothing was queued", what);
+    g_end_after = 0;
+    g_enter = g_exit = g_ticks = 0;
+}
+
+static DWORD WINAPI notice_thread(LPVOID p)
+{
+    (void)p;
+    ss_ui_notify(4000, "from another thread");
+    return 0;
+}
+
+int main(int argc, char** argv)
+{
+    if (argc < 2) { printf("usage: test_winmenu <scratch dir> [--menuloop]\n"); return 2; }
+    const int menuloop = argc > 2 && !strcmp(argv[2], "--menuloop");
+    char dir[300], ini[400], env[500];
+    if (!GetFullPathNameA(argv[1], (DWORD)sizeof dir, dir, NULL)) return 2;
+    CreateDirectoryA(dir, NULL);
+    snprintf(env, sizeof env, "SS_DIR=%s\\states", dir);
+    _putenv(env);
+    snprintf(ini, sizeof ini, "%s\\input.ini", dir);
+    {
+        FILE* f = fopen(ini, "wb");
+        if (!f) { printf("cannot write %s\n", ini); return 2; }
+        fputs("[hotkeys]\noptions = F8\nmenu = Ctrl+M\n", f);
+        fclose(f);
+    }
+    snprintf(env, sizeof env, "PAD_CONFIG=%s", ini);
+    _putenv(env);
+    _putenv("PAD_NO_HOST=1");
+    _putenv("PAD_NO_MOUSE=1");
+
+    g_offx = GetSystemMetrics(SM_XVIRTUALSCREEN) + GetSystemMetrics(SM_CXVIRTUALSCREEN) + 2000;
+    g_offy = GetSystemMetrics(SM_YVIRTUALSCREEN) + 100;
+    HWND fg0 = GetForegroundWindow();
+
+    /* a slot with a state in it: slot 3 */
+    CHECK(ss_ui_ensure_dir(), "save-state folder %s", ss_ui_dir());
+    {
+        char p[400];
+        for (int s = 0; s <= SS_UI_UNDO; s++) {
+            if (ss_ui_slot_path(s, ".meta", p, sizeof p)) DeleteFileA(p);
+        }
+        ss_ui_slot_path(3, ".state", p, sizeof p);
+        FILE* f = fopen(p, "wb");
+        if (f) { fputs("x", f); fclose(f); }
+    }
+    const long long now = (long long)time(NULL);
+    CHECK(ss_ui_write_meta(3, now, "Pier", "slot3.state"), "write slot 3");
+    char today[64];
+    {
+        struct tm lt;
+        time_t tt = (time_t)now;
+        localtime_s(&lt, &tt);
+        snprintf(today, sizeof today, "today %02d:%02d", lt.tm_hour, lt.tm_min);
+    }
+
+    WNDCLASSEXW wc;
+    memset(&wc, 0, sizeof wc);
+    wc.cbSize = sizeof wc;
+    wc.lpfnWndProc = wndproc;
+    wc.hInstance = GetModuleHandleW(NULL);
+    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
+    wc.hbrBackground = (HBRUSH)GetStockObject(BLACK_BRUSH);
+    wc.lpszClassName = L"test_winmenu";
+    RegisterClassExW(&wc);
+
+    /* ---- the bar, the window, the client size ------------------------------ */
+    HMENU bar = (HMENU)rsx_winmenu_create();
+    CHECK(bar != NULL, "rsx_winmenu_create");
+    CHECK(rsx_winmenu_create() == bar, "one bar");
+    CHECK(GetMenuItemCount(bar) == 4, "%d menus", GetMenuItemCount(bar));
+    {
+        static const char* const names[4] = { "File", "Save", "Load", "View" };
+        for (int i = 0; i < 4; i++) {
+            const char* t = item(bar, i, NULL);
+            CHECK(!strcmp(t, names[i]), "menu %d is '%s'", i, t);
+        }
+    }
+    HWND h = make_window(bar);
+    CHECK(h != NULL, "window (error %lu)", (unsigned long)GetLastError());
+    if (!h) return 1;
+    rsx_winmenu_attach(h, &k_host, 0);
+    int w, hh;
+    client(h, &w, &hh);
+    CHECK(w == CW && hh == CH, "client %dx%d with the bar, want %dx%d", w, hh, CW, CH);
+    CHECK(GetMenu(h) == bar, "the bar is on the window");
+    {
+        RECT a, b;
+        CHECK(GetMenuItemRect(h, bar, 0, &a) && GetMenuItemRect(h, bar, 3, &b) && a.top == b.top,
+              "the bar is one row (the frame was sized for one)");
+        MENUBARINFO mbi;
+        memset(&mbi, 0, sizeof mbi);
+        mbi.cbSize = sizeof mbi;
+        if (GetMenuBarInfo(h, OBJID_MENU, 0, &mbi))
+            printf("menu bar: %ld px high at %d px client width\n", mbi.rcBar.bottom - mbi.rcBar.top, CW);
+    }
+
+    /* ---- the menus ---------------------------------------------------------- */
+    UINT st;
+    HMENU m = open_popup(h, 0);
+    CHECK(GetMenuItemCount(m) == 3, "File: %d items", GetMenuItemCount(m));
+    CHECK(!strcmp(item(m, 0, &st), "&Open Save State Folder") && !(st & MF_GRAYED), "'%s'", item(m, 0, NULL));
+    CHECK(!strcmp(item(m, 2, &st), "E&xit\tAlt+F4"), "'%s'", item(m, 2, NULL));
+
+    m = open_popup(h, 1);
+    CHECK(GetMenuItemCount(m) == 12, "Save: %d items", GetMenuItemCount(m));
+    CHECK(!strcmp(item(m, 0, &st), "&Quick Save\tF5") && !(st & MF_GRAYED), "'%s'", item(m, 0, NULL));
+    CHECK(GetMenuState(m, 1, MF_BYPOSITION) & MF_SEPARATOR, "separator");
+    CHECK(!strcmp(item(m, 2, &st), "Slot &1  -  (empty)\tCtrl+F1") && !(st & MF_GRAYED), "'%s'", item(m, 2, NULL));
+    {
+        char want[160];
+        snprintf(want, sizeof want, "Slot &3  -  %s  -  Pier\tCtrl+F3", today);
+        CHECK(!strcmp(item(m, 4, &st), want), "'%s', want '%s'", item(m, 4, NULL), want);
+    }
+    CHECK(!strcmp(item(m, 11, &st), "Slot 1&0  -  (empty)\tCtrl+F10") && !(st & MF_GRAYED), "'%s'", item(m, 11, NULL));
+
+    m = open_popup(h, 2);
+    CHECK(GetMenuItemCount(m) == 14, "Load: %d items", GetMenuItemCount(m));
+    /* M7b: Undo Last Load at the end, after a separator; greyed with nothing to undo */
+    CHECK(GetMenuState(m, 12, MF_BYPOSITION) & MF_SEPARATOR, "separator before Undo");
+    CHECK(!strcmp(item(m, 13, &st), "&Undo Last Load  -  (nothing to undo)\tCtrl+Shift+Z") && (st & MF_GRAYED), "'%s' %x",
+          item(m, 13, NULL), st);
+    CHECK(!strcmp(item(m, 0, &st), "Quick &Load  -  (empty)\tF9") && (st & MF_GRAYED), "'%s' %x", item(m, 0, NULL), st);
+    CHECK((GetMenuState(m, 2, MF_BYPOSITION) & MF_GRAYED), "empty slot 1 greyed");
+    {
+        char want[160];
+        snprintf(want, sizeof want, "Slot &3  -  %s  -  Pier\tCtrl+Shift+F3", today);
+        CHECK(!strcmp(item(m, 4, &st), want) && !(st & MF_GRAYED), "'%s', want '%s'", item(m, 4, NULL), want);
+    }
+    CHECK((GetMenuState(m, 5, MF_BYPOSITION) & MF_GRAYED), "empty slot 4 greyed");
+
+    m = open_popup(h, 3);
+    CHECK(GetMenuItemCount(m) == 5, "View: %d items", GetMenuItemCount(m));
+    CHECK(!strcmp(item(m, 0, &st), "&Fullscreen\tF11") && !(st & MF_CHECKED), "'%s'", item(m, 0, NULL));
+    CHECK(!strcmp(item(m, 1, &st), "Show F&PS") && !(st & MF_CHECKED), "'%s'", item(m, 1, NULL));
+    CHECK(!strcmp(item(m, 3, &st), "&Options...\tF8") && (st & MF_GRAYED), "'%s' greyed until a hook", item(m, 3, NULL));
+    /* F8 moved to options by this test's input.ini; no issues log in this process */
+    CHECK(!strcmp(item(m, 4, &st), "&Mark a Problem Here") && (st & MF_GRAYED), "'%s' greyed: no issues log", item(m, 4, NULL));
+
+    {   /* the system menu is not ours */
+        intptr_t r = 0;
+        CHECK(rsx_winmenu_message(h, WM_INITMENUPOPUP, (uintptr_t)GetSystemMenu(h, FALSE), 0, &r) == 0,
+              "system menu passed on");
+    }
+
+    /* ---- menu commands queue, never run ------------------------------------- */
+    SendMessageW(h, WM_COMMAND, MAKEWPARAM(RSX_WINMENU_ID_BASE + HK_SAVE_SLOT1 + 1, 0), 0);
+    CHECK(g_ss_ui_pending == REQ(SS_UI_OP_SAVE, 2), "Save > Slot 2 queued: %ld", (long)g_ss_ui_pending);
+    m = open_popup(h, 1);
+    CHECK((GetMenuState(m, 3, MF_BYPOSITION) & MF_GRAYED) && (GetMenuState(m, 0, MF_BYPOSITION) & MF_GRAYED),
+          "greyed while a request waits");
+    m = open_popup(h, 2);
+    CHECK((GetMenuState(m, 4, MF_BYPOSITION) & MF_GRAYED), "Load greyed too while busy");
+    ss_ui_service(10);
+    CHECK(g_ss_ui_pending == 0, "taken by the coordinator step");
+    pump(30);
+    {
+        char t[200];
+        CHECK(rsx_winmenu_osd_text(t, sizeof t) && !strcmp(t, "Save states are not available yet"),
+              "notice box '%s'", t);
+        HWND osd = find_osd();
+        CHECK(osd && GetWindow(osd, GW_OWNER) == h, "the box is owned by the game window");
+        LONG_PTR ex = osd ? GetWindowLongPtrW(osd, GWL_EXSTYLE) : 0;
+        CHECK((ex & WS_EX_TRANSPARENT) && (ex & WS_EX_NOACTIVATE) && (ex & WS_EX_LAYERED), "click-through, never active");
+        RECT orc, crc;
+        POINT o = { 0, 0 };
+        GetWindowRect(osd, &orc);
+        ClientToScreen(h, &o);
+        GetClientRect(h, &crc);
+        CHECK(orc.left > o.x && orc.top > o.y && orc.right < o.x + crc.right && orc.bottom < o.y + crc.bottom,
+              "inside the picture");
+    }
+    m = open_popup(h, 1);
+    CHECK(!(GetMenuState(m, 3, MF_BYPOSITION) & MF_GRAYED), "enabled again");
+    SendMessageW(h, WM_COMMAND, MAKEWPARAM(RSX_WINMENU_ID_BASE + HK_LOAD_SLOT1 + 2, 0), 0);
+    CHECK(take() == REQ(SS_UI_OP_LOAD, 3), "Load > Slot 3");
+    SendMessageW(h, WM_COMMAND, MAKEWPARAM(RSX_WINMENU_ID_BASE + HK_QUICK_SAVE, 0), 0);
+    CHECK(take() == REQ(SS_UI_OP_SAVE, SS_UI_QUICK), "Quick Save");
+    SendMessageW(h, WM_COMMAND, MAKEWPARAM(RSX_WINMENU_ID_EXIT, 0), 0);
+    pump(20);
+    CHECK(g_close == 1, "Exit closes the window (WM_CLOSE %d)", g_close);
+    CHECK(g_ss_ui_pending == 0, "nothing else queued");
+
+    /* ---- hotkeys --------------------------------------------------------------- */
+    key(h, VK_F5, 0, 0, 0, 0);
+    CHECK(take() == REQ(SS_UI_OP_SAVE, SS_UI_QUICK), "F5 quick save");
+    key(h, VK_F9, 0, 0, 0, 0);
+    CHECK(take() == REQ(SS_UI_OP_LOAD, SS_UI_QUICK), "F9 quick load");
+    key(h, VK_F5, 0, 0, 0, 1);
+    CHECK(g_ss_ui_pending == 0, "an auto-repeat is swallowed, not acted on");
+    key(h, VK_F3, 1, 0, 0, 0);
+    CHECK(take() == REQ(SS_UI_OP_SAVE, 3), "Ctrl+F3 save slot 3");
+    key(h, VK_F4, 1, 1, 0, 0);
+    CHECK(take() == REQ(SS_UI_OP_LOAD, 4), "Ctrl+Shift+F4 load slot 4");
+    key(h, VK_F10, 1, 0, 0, 0);
+    CHECK(take() == REQ(SS_UI_OP_SAVE, 10), "Ctrl+F10 (a system key) save slot 10");
+    key(h, VK_F10, 1, 1, 0, 0);
+    CHECK(take() == REQ(SS_UI_OP_LOAD, 10), "Ctrl+Shift+F10 load slot 10");
+    /* M7b: Undo Last Load (Ctrl+Shift+Z and the menu) -- with an undo point there */
+    {
+        char p[400];
+        ss_ui_slot_path(SS_UI_UNDO, ".state", p, sizeof p);
+        FILE* f = fopen(p, "wb");
+        if (f) { fputs("x", f); fclose(f); }
+        CHECK(ss_ui_write_meta(SS_UI_UNDO, now, "Pier", "undo.state"), "write the undo point");
+        HMENU lm = open_popup(h, 2);
+        char want[160];
+        snprintf(want, sizeof want, "&Undo Last Load  -  %s  -  Pier\tCtrl+Shift+Z", today);
+        CHECK(!strcmp(item(lm, 13, &st), want) && !(st & MF_GRAYED), "'%s', want '%s'", item(lm, 13, NULL), want);
+    }
+    key(h, 'Z', 1, 1, 0, 0);
+    CHECK(take() == REQ(SS_UI_OP_LOAD, SS_UI_UNDO), "Ctrl+Shift+Z undo last load");
+    key(h, 'Z', 1, 0, 0, 0);
+    CHECK(g_ss_ui_pending == 0, "Ctrl+Z alone is not the undo key (a load takes two modifiers)");
+    SendMessageW(h, WM_COMMAND, MAKEWPARAM(RSX_WINMENU_ID_BASE + HK_UNDO_LOAD, 0), 0);
+    CHECK(take() == REQ(SS_UI_OP_LOAD, SS_UI_UNDO), "Load > Undo Last Load");
+    key(h, 'Z', 0, 0, 0, 0);
+    CHECK(g_ss_ui_pending == 0, "a plain Z is not the undo key");
+    key(h, VK_F3, 0, 1, 0, 0);
+    key(h, VK_F3, 0, 0, 0, 0);
+    key(h, VK_F3, 1, 0, 1, 0);
+    CHECK(g_ss_ui_pending == 0, "Shift+F3, F3, Ctrl+Alt+F3: nothing (exact combinations)");
+    {
+        RECT before;
+        GetWindowRect(h, &before);
+        key(h, VK_F11, 0, 0, 0, 0);
+        client(h, &w, &hh);
+        CHECK(g_fs && GetMenu(h) == NULL && w == 2560 && hh == 1080, "F11: fullscreen, no bar, client %dx%d", w, hh);
+        m = GetSubMenu(bar, 3);
+        SendMessageW(h, WM_INITMENUPOPUP, (WPARAM)m, MAKELPARAM(3, FALSE));
+        CHECK(GetMenuState(m, 0, MF_BYPOSITION) & MF_CHECKED, "Fullscreen checked");
+        SendMessageW(h, WM_COMMAND, MAKEWPARAM(RSX_WINMENU_ID_BASE + HK_FULLSCREEN, 0), 0);
+        client(h, &w, &hh);
+        CHECK(!g_fs && GetMenu(h) == bar && w == CW && hh == CH, "View > Fullscreen: back, bar back, client %dx%d", w, hh);
+        RECT after;
+        GetWindowRect(h, &after);
+        CHECK(EqualRect(&before, &after), "the same window rectangle");
+    }
+
+    /* ---- Alt, F10, Alt+letter: no menu loop ------------------------------------ */
+    {   /* the filter itself: every keyboard activation of the bar is consumed */
+        intptr_t r = 1;
+        CHECK(cellPad_host_window_message(h, WM_SYSCOMMAND, SC_KEYMENU, 0, &r) == 1 && r == 0, "SC_KEYMENU consumed");
+        CHECK(cellPad_host_window_message(h, WM_SYSCOMMAND, SC_KEYMENU, 's', &r) == 1, "SC_KEYMENU 's' consumed");
+        CHECK(cellPad_host_window_message(h, WM_SYSCOMMAND, SC_KEYMENU | 3, 0, &r) == 1, "low bits ignored");
+        CHECK(cellPad_host_window_message(h, WM_SYSCOMMAND, SC_MOUSEMENU, 0, &r) == 0, "a click on the bar is not");
+        CHECK(cellPad_host_window_message(h, WM_SYSCOMMAND, SC_CLOSE, 0, &r) == 0, "Alt+F4 (SC_CLOSE) is not");
+    }
+    no_menu_from_keys(h, "inactive window");
+
+    /* ---- input hold around a menu loop (the messages alone) ------------------- */
+    CHECK(!cellPad_host_input_held() && !rsx_winmenu_in_menu(), "not held");
+    SendMessageW(h, WM_ENTERMENULOOP, FALSE, 0);
+    CHECK(cellPad_host_input_held() && rsx_winmenu_in_menu(), "held while a menu is open");
+    SendMessageW(h, WM_EXITMENULOOP, FALSE, 0);
+    CHECK(!cellPad_host_input_held() && !rsx_winmenu_in_menu(), "released after");
+    g_enter = g_exit = 0;
+
+    /* ---- the FPS box, notices from another thread ------------------------------ */
+    {
+        char t[200];
+        Sleep(10);
+        pump(10);
+        /* let the stub's notice run out first */
+        for (int i = 0; i < 400 && rsx_winmenu_osd_text(t, sizeof t); i++) pump(10);
+        CHECK(!rsx_winmenu_osd_text(t, sizeof t), "the notice went away");
+        SendMessageW(h, WM_COMMAND, MAKEWPARAM(RSX_WINMENU_ID_BASE + HK_SHOW_FPS, 0), 0);
+        CHECK(rsx_winmenu_osd_text(t, sizeof t) && !strcmp(t, "-- FPS"), "box '%s'", t);
+        rsx_winmenu_fps(59.6);
+        CHECK(rsx_winmenu_osd_text(t, sizeof t) && !strcmp(t, "60 FPS"), "box '%s'", t);
+        m = open_popup(h, 3);
+        CHECK(GetMenuState(m, 1, MF_BYPOSITION) & MF_CHECKED, "Show FPS checked");
+        HANDLE th = CreateThread(NULL, 0, notice_thread, NULL, 0, NULL);
+        WaitForSingleObject(th, 2000);
+        CloseHandle(th);
+        pump(30);
+        CHECK(rsx_winmenu_osd_text(t, sizeof t) && !strcmp(t, "60 FPS\nfrom another thread"), "box '%s'", t);
+        SendMessageW(h, WM_COMMAND, MAKEWPARAM(RSX_WINMENU_ID_BASE + HK_SHOW_FPS, 0), 0);
+        CHECK(rsx_winmenu_osd_text(t, sizeof t) && !strcmp(t, "from another thread"), "box '%s'", t);
+        key(h, VK_F8, 0, 0, 0, 0);                /* options = F8 (test input.ini), no overlay yet */
+        pump(30);
+        CHECK(rsx_winmenu_osd_text(t, sizeof t) && !strcmp(t, "Options are not available yet"), "box '%s'", t);
+    }
+
+    /* ---- the options overlay plugs in ------------------------------------------ */
+    {
+        rsx_winmenu_hooks hk;
+        memset(&hk, 0, sizeof hk);
+        hk.open_options = ovl_open;
+        hk.options_keys = "F1";
+        hk.get_show_fps = ovl_get_fps;
+        hk.set_show_fps = ovl_set_fps;
+        rsx_winmenu_set_hooks(&hk);
+        m = open_popup(h, 3);
+        CHECK(!strcmp(item(m, 3, &st), "&Options...\tF1") && !(st & MF_GRAYED), "'%s' enabled", item(m, 3, NULL));
+        SendMessageW(h, WM_COMMAND, MAKEWPARAM(RSX_WINMENU_ID_BASE + HK_OPTIONS, 0), 0);
+        key(h, VK_F8, 0, 0, 0, 0);
+        CHECK(g_opened == 2, "the hook opened the overlay %d times", g_opened);
+        SendMessageW(h, WM_COMMAND, MAKEWPARAM(RSX_WINMENU_ID_BASE + HK_SHOW_FPS, 0), 0);
+        CHECK(g_ovl_fps == 1, "Show FPS goes to the overlay");
+        m = open_popup(h, 3);
+        CHECK(GetMenuState(m, 1, MF_BYPOSITION) & MF_CHECKED, "checked from the overlay's state");
+        rsx_winmenu_set_hooks(NULL);
+        m = open_popup(h, 3);
+        CHECK(GetMenuState(m, 3, MF_BYPOSITION) & MF_GRAYED, "greyed again without the hook");
+    }
+
+    /* ---- a real menu loop (opt-in) ------------------------------------------- */
+    if (menuloop) {
+        /* A keyboard menu needs its window to be the thread's active window,
+         * as the game's is whenever it gets keys. In a background process
+         * this does not bring it to the front (checked below). */
+        SetActiveWindow(h);
+        CHECK(GetActiveWindow() == h, "active in its thread");
+        no_menu_from_keys(h, "active window");    /* now a loop COULD start: the filter stops it */
+        g_enter = g_exit = g_ticks = g_held_in_loop = g_inmenu_in_loop = 0;
+        g_end_after = 6;
+        key(h, 'M', 1, 0, 0, 0);                  /* menu = Ctrl+M: opens the bar from the keyboard */
+        pump(50);
+        printf("menu loop: %d enter, %d exit, %d modal ticks inside, held in %d, in-menu in %d\n",
+               g_enter, g_exit, g_ticks, g_held_in_loop, g_inmenu_in_loop);
+        CHECK(g_enter == 1 && g_exit == 1, "one menu loop, ended (%d/%d)", g_enter, g_exit);
+        CHECK(g_ticks >= 6, "the modal timer ticked inside it: the frame clock keeps running (%d)", g_ticks);
+        CHECK(g_held_in_loop == g_ticks && g_inmenu_in_loop == g_ticks, "input held throughout");
+        CHECK(!cellPad_host_input_held() && !rsx_winmenu_in_menu(), "released after the loop");
+        g_end_after = 0;
+    } else {
+        printf("menu loop: skipped (pass --menuloop)\n");
+    }
+    CHECK(GetForegroundWindow() != h, "the test window never came to the front");
+    CHECK(GetForegroundWindow() == fg0 || fg0 == NULL, "the foreground window did not change");
+
+    /* ---- the bar is freed with the window, attached or not ---------------------- */
+    key(h, VK_F11, 0, 0, 0, 0);
+    CHECK(g_fs && GetMenu(h) == NULL && IsMenu(bar), "detached in fullscreen");
+    DestroyWindow(h);
+    pump(10);
+    CHECK(!IsMenu(bar), "a detached bar is freed by WM_DESTROY");
+    g_fs = 0;
+    HMENU bar2 = (HMENU)rsx_winmenu_create();
+    CHECK(bar2 != NULL, "a new bar after the window went");
+    HWND h2 = make_window(bar2);
+    rsx_winmenu_attach(h2, &k_host, 1);           /* show_fps = 1 at startup */
+    {
+        char t[200];
+        CHECK(rsx_winmenu_osd_text(t, sizeof t) && !strcmp(t, "-- FPS"), "show_fps at startup: '%s'", t);
+    }
+    DestroyWindow(h2);
+    pump(10);
+    CHECK(!IsMenu(bar2), "an attached bar goes with its window");
+    CHECK(find_osd() == NULL, "the notice box went with it");
+
+    /* ---- no bar at all (menu_bar = 0): fullscreen never adds one --------------- */
+    HWND h3 = make_window(NULL);
+    rsx_winmenu_attach(h3, &k_host, 0);
+    client(h3, &w, &hh);
+    CHECK(w == CW && hh == CH && GetMenu(h3) == NULL, "no bar: client %dx%d", w, hh);
+    key(h3, VK_F11, 0, 0, 0, 0);
+    key(h3, VK_F11, 0, 0, 0, 0);
+    client(h3, &w, &hh);
+    CHECK(GetMenu(h3) == NULL && w == CW && hh == CH, "still no bar after fullscreen and back");
+    key(h3, VK_F5, 0, 0, 0, 0);
+    CHECK(take() == REQ(SS_UI_OP_SAVE, SS_UI_QUICK), "hotkeys work without the bar");
+    DestroyWindow(h3);
+    pump(10);
+
+    printf("%d checks, %d failed\n", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_ztex_pcf.c b/libs/video/tests/test_ztex_pcf.c
new file mode 100644
index 0000000..b1d61d3
--- /dev/null
+++ b/libs/video/tests/test_ztex_pcf.c
@@ -0,0 +1,784 @@
+/*
+ * Windows-only: the depth-compare filter of decompiled RSX fragment programs
+ * (rsx_ztex, rsx_fp_decompiler.c) against a double-precision reference, on the
+ * D3D11 WARP rasterizer AND on the hardware adapter.
+ *
+ * The program is hand-assembled: TXP R0, f[TEX0], TEX1 ; MOV R2, f[TEX0] --
+ * decompiled exactly as the D3D12 backend does it (rsx_fp_decompile_buffered_ex
+ * with unit 1 in DEPTH_PACKED or DEPTH mode, 32-bit exports, two targets), so
+ * t0 is rsx_ztex's result and t1 the very coordinate it was given. A 4096x1
+ * draw sweeps that coordinate across texel boundaries (1/1024-texel steps; x,
+ * y and diagonal, 32 offsets each) of a 1024x1024 depth map:
+ *   mode 1: an RGBA8 texture holding depth bits 23-16, 15-8, 7-0 in A, R, G
+ *           and a stencil byte in B (the backend's colour alias of a zeta
+ *           surface), mode 2: R32_FLOAT whose red is the depth.
+ * The reference is ARB_shadow's (T2) bilinear PCF in double: footprint
+ * floor(p), weights p - floor(p), p = uv * size - 0.5, each texel compared
+ * "texel OP r" by the ZFUNC (libgcm CELL_GCM_TEXTURE_ZFUNC_*), r clamped to
+ * [0,1]; CLAMP_TO_EDGE or BORDER (the sampler's border colour as a texel).
+ * NEAREST: the texel floor(uv * size).
+ *
+ * Checks, per device:
+ *   exact  (fp_texctl depth byte bits 5-6 = 0, the default): max |err| <= 1/64
+ *          for ZFUNC 1-7, linear and nearest, CLAMP and BORDER (edge sweeps
+ *          across u = 0 and u = 1), both modes, a two-level map (0.25/0.75,
+ *          r = 0.5) and a random 24-bit map with r ramping 0..1.
+ *   gather (= 1, the code before 2026-10-20): reported, not judged -- the
+ *          samples off by more than 1/64 (the seam band; 0 on WARP, hundreds
+ *          on an RTX 5080).
+ *   diff   (= 2): 1 exactly where gather and exact differ by more than 1/64.
+ *   SampleCmpLevelZero (the GPU's own comparison filter, R32_FLOAT, LESS =
+ *          libgcm GREATER): reported (its weights are 8-bit: ~1/150 off).
+ * Shadow filtering (rsx_fp_set_shadow_filter: rsx_ztexs, the Soft / Softer
+ * kernels), per device, the [SOFT] lines:
+ *   kernel  the same sweeps (r constant: a receiver facing the light) against
+ *           a double-precision reference built from rsx_fp_shadow_weights:
+ *           max |err| <= 1/64 for ZFUNC 1-7, CLAMP and BORDER, both modes,
+ *           both maps; NEAREST keeps the PS3 kernel; an r that ramps along a
+ *           1-pixel-high sweep (no 2-D receiver plane: degenerate) keeps the
+ *           PS3 kernel only with the ZTEX_SOFT_PLANE A/B -- the shipped
+ *           variants filter it with the soft kernel, as compared there.
+ *   sum     an all-lit map gives 1 and an all-shadowed one 0 (weights sum to
+ *           1; also the Poisson variant).
+ *   edge    a step in the map: monotone, ramping over 1 / 2 / 4 texels
+ *           (PS3 / Soft / Softer).
+ *   plane   a 256x256 target over a sloped receiver whose own depth is the
+ *           map, biased by just what the PS3's 2x2 needs (one texel of
+ *           slope): the PS3 kernel is lit everywhere; Soft / Softer without
+ *           the receiver-plane bias are not (acne, counted), with it lit
+ *           everywhere again -- also beyond the plane limit (the PS3
+ *           fallback) and with no limit; an occluder square drawn into that
+ *           map still shadows its inside fully.
+ * No game data: every map is generated here.
+ *
+ * Build, from this directory:
+ *   clang-cl -O2 -std:c17 -I../../../include -I.. test_ztex_pcf.c ../rsx_fp_decompiler.c
+ * (links d3d11.lib, dxgi.lib and dxguid.lib; D3DCompile comes from d3dcompiler_47.dll at run time).
+ * Run: test_ztex_pcf [warp|hw|both]   (default both: WARP, then every hardware
+ * adapter; none = SKIP)
+ */
+#define COBJMACROS
+#define _CRT_SECURE_NO_WARNINGS
+#include "../rsx_fp_decompiler.h"
+#include <windows.h>
+#include <d3d11.h>
+#include <d3dcompiler.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#pragma comment(lib, "d3d11.lib")
+#pragma comment(lib, "dxgi.lib")
+#pragma comment(lib, "dxguid.lib")
+#include "fp_pack_programs.h"
+
+#define NS 4096                    /* samples per sweep = render target width */
+#define MW 1024                    /* depth map size */
+#define REL(p) do { if (p) { (p)->lpVtbl->Release(p); (p) = NULL; } } while (0)
+
+typedef HRESULT (WINAPI *PFN_Compile)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*,
+                                      LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+static PFN_Compile s_compile;
+static ID3D11Device* s_dev;
+static ID3D11DeviceContext* s_ctx;
+static ID3D11VertexShader* s_vs;
+static ID3D11PixelShader* s_ps[3];        /* [1] mode 1 (packed), [2] mode 2 (red) */
+/* rsx_ztexs variants (rsx_fp_set_shadow_filter), [variant][mode] */
+/* the defaults (no receiver plane) first; ZV_SOFT_NP / ZV_SOFTER_NP name the PLANE variants' slots for the
+ * reduced case sets (v >= ZV_SOFT_NP) */
+enum { ZV_SOFT, ZV_SOFTER, ZV_SOFT_NP, ZV_SOFTER_NP, ZV_POISSON, ZV_SOFT_NOLIM, ZV_SOFTER_LOWER, ZV_N };
+static const u32 s_zv_filter[ZV_N] = { RSX_FP_SHADOW_SOFT, RSX_FP_SHADOW_SOFTER,
+                                       RSX_FP_SHADOW_SOFT | RSX_FP_SHADOW_PLANE,
+                                       RSX_FP_SHADOW_SOFTER | RSX_FP_SHADOW_PLANE,
+                                       RSX_FP_SHADOW_SOFTER | RSX_FP_SHADOW_POISSON,
+                                       RSX_FP_SHADOW_SOFT | RSX_FP_SHADOW_PLANE,
+                                       RSX_FP_SHADOW_SOFTER | RSX_FP_SHADOW_PLANE_LOWER };
+static const char* const s_zv_name[ZV_N] = { "soft", "softer", "soft, receiver plane", "softer, receiver plane",
+                                             "softer poisson", "soft, receiver plane, no limit",
+                                             "softer, lowering plane" };
+#define ZV_PLANE(v) ((s_zv_filter[v] & (RSX_FP_SHADOW_PLANE | RSX_FP_SHADOW_PLANE_LOWER)) != 0)
+static ID3D11PixelShader* s_pss[ZV_N][3];
+static ID3D11PixelShader* s_force_ps;     /* run_sweep / run_2d: this shader instead of s_ps[mode] */
+static ID3D11PixelShader* s_ps_cmp;       /* SampleCmpLevelZero */
+static ID3D11Texture2D *s_rt[2], *s_st[2];
+static ID3D11RenderTargetView* s_rtv[2];
+static ID3D11Buffer *s_vcb, *s_pcb;
+static u32 s_cb_slots = 1;
+static int s_fails, s_checks;
+
+static u32* s_map;                        /* 24-bit depths */
+
+/* VS: a quad over the 4096x1 target; tc0 runs from v_a (left edge) to v_b
+ * (right edge). Every other output is 0. */
+static const char s_vs_src[] =
+    "cbuffer V : register(b0) { float4 v_a; float4 v_b; };\n"
+    "struct VSOut { float4 position : SV_POSITION; float4 col0 : COLOR0; float4 col1 : COLOR1;\n"
+    "  float4 fog : FOG; float4 tc0:TEXCOORD0; float4 tc1:TEXCOORD1; float4 tc2:TEXCOORD2; float4 tc3:TEXCOORD3;\n"
+    "  float4 tc4:TEXCOORD4; float4 tc5:TEXCOORD5; float4 tc6:TEXCOORD6; float4 tc7:TEXCOORD7; };\n"
+    "VSOut main(uint id : SV_VertexID) { VSOut o = (VSOut)0;\n"
+    "  const float x = (id & 1) ? 1.0 : 0.0, y = (id & 2) ? 1.0 : 0.0;\n"
+    "  o.position = float4(x * 2 - 1, 1 - y * 2, 0, 1);\n"
+    "  o.tc0 = lerp(v_a, v_b, x);\n"
+    "  return o; }\n";
+
+/* The GPU's own comparison filter (info only): r from tc0.z. */
+static const char s_ps_cmp_src[] =
+    "Texture2D<float> t : register(t1);\n"
+    "SamplerComparisonState sc : register(s2);\n"
+    "struct PSIn { float4 position : SV_POSITION; float4 col0 : COLOR0; float4 col1 : COLOR1;\n"
+    "  float4 fog : FOG; float4 tc0:TEXCOORD0; };\n"
+    "struct PSOut { float4 t0 : SV_Target0; float4 t1 : SV_Target1; };\n"
+    "PSOut main(PSIn i) { PSOut o; o.t0 = (float4)t.SampleCmpLevelZero(sc, i.tc0.xy, saturate(i.tc0.z));\n"
+    "  o.t1 = i.tc0; return o; }\n";
+
+static ID3DBlob* compile(const char* src, const char* target)
+{
+    ID3DBlob *b = NULL, *e = NULL;
+    if (FAILED(s_compile(src, strlen(src), "x", NULL, NULL, "main", target, 0, 0, &b, &e))) {
+        printf("compile %s failed: %s\n", target, e ? (const char*)ID3D10Blob_GetBufferPointer(e) : "?");
+        REL(e);
+        return NULL;
+    }
+    REL(e);
+    return b;
+}
+
+/* TXP R0, f[TEX0], TEX1 ; MOV R2, f[TEX0] (END) */
+static u32 asm_program(u8* p)
+{
+    u32 o = 0;
+    o += fpt_ins(p + o, FPT_OPC(0x18u) | FPT_DST(0, 0, 0xFu) | FPT_INSRC(4) | FPT_TEXU(1),
+                 FPT_INPUT | FPT_XYZW | FPT_ALWAYS, 0, 0, NULL);
+    o += fpt_ins(p + o, FPT_OPC(0x01u) | FPT_DST(2, 0, 0xFu) | FPT_INSRC(4) | FPT_END,
+                 FPT_INPUT | FPT_XYZW | FPT_ALWAYS, 0, 0, NULL);
+    return o;
+}
+
+static char s_hlsl[256 * 1024];
+/* filter: rsx_fp_set_shadow_filter for this decompile (0 = PS3); lim: the plane limit (< 0: the default) */
+static int build_ps_f(u32 mode, u32 filter, double lim, ID3D11PixelShader** out)
+{
+    u8 prog[64];
+    const u32 size = asm_program(prog);
+    u32 nk = 0;
+    rsx_fp_set_min_targets(2);
+    rsx_fp_set_tex_modes(mode << 2);                  /* unit 1 */
+    rsx_fp_set_shadow_plane_max(lim < 0.0 ? RSX_FP_SHADOW_PLANE_MAX_DEFAULT : lim);
+    rsx_fp_set_shadow_filter(filter);
+    const int r = rsx_fp_decompile_buffered_ex(prog, size, 0x40u, 0, s_hlsl, sizeof s_hlsl, &nk);
+    rsx_fp_set_shadow_filter(RSX_FP_SHADOW_PS3);
+    rsx_fp_set_shadow_plane_max(RSX_FP_SHADOW_PLANE_MAX_DEFAULT);
+    rsx_fp_set_tex_modes(0);
+    rsx_fp_set_min_targets(1);
+    if (r <= 0 || !strstr(s_hlsl, "rsx_ztex(") || (filter && !strstr(s_hlsl, "rsx_ztexs(rsx_tex"))) {
+        printf("[FAIL] decompile (mode %u, filter %u)\n", mode, filter); return 1;
+    }
+    s_cb_slots = nk ? nk : 1u;
+    ID3DBlob* b = compile(s_hlsl, "ps_5_0");
+    if (!b) return 1;
+    ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(b), ID3D10Blob_GetBufferSize(b), NULL, out);
+    REL(b);
+    return *out ? 0 : 1;
+}
+static int build_ps(u32 mode, ID3D11PixelShader** out) { return build_ps_f(mode, RSX_FP_SHADOW_PS3, -1.0, out); }
+
+/* 2-D: tc0 = v_a + x * v_b + y * v_c over a 256x256 target (x, y in [0, 1] at its edges) */
+#define N2 256
+static const char s_vs2_src[] =
+    "cbuffer V : register(b0) { float4 v_a; float4 v_b; float4 v_c; float4 v_pad; };\n"
+    "struct VSOut { float4 position : SV_POSITION; float4 col0 : COLOR0; float4 col1 : COLOR1;\n"
+    "  float4 fog : FOG; float4 tc0:TEXCOORD0; float4 tc1:TEXCOORD1; float4 tc2:TEXCOORD2; float4 tc3:TEXCOORD3;\n"
+    "  float4 tc4:TEXCOORD4; float4 tc5:TEXCOORD5; float4 tc6:TEXCOORD6; float4 tc7:TEXCOORD7; };\n"
+    "VSOut main(uint id : SV_VertexID) { VSOut o = (VSOut)0;\n"
+    "  const float x = (id & 1) ? 1.0 : 0.0, y = (id & 2) ? 1.0 : 0.0;\n"
+    "  o.position = float4(x * 2 - 1, 1 - y * 2, 0, 1);\n"
+    "  o.tc0 = v_a + x * v_b + y * v_c;\n"
+    "  return o; }\n";
+static ID3D11VertexShader* s_vs2;
+static ID3D11Buffer* s_vcb2;
+static ID3D11Texture2D *s_rt2[2], *s_st2[2];
+static ID3D11RenderTargetView* s_rtv2[2];
+
+static int init_device(IDXGIAdapter* ad)
+{
+    D3D_FEATURE_LEVEL fl = D3D_FEATURE_LEVEL_11_0;
+    if (FAILED(D3D11CreateDevice(ad, ad ? D3D_DRIVER_TYPE_UNKNOWN : D3D_DRIVER_TYPE_WARP, NULL, 0, &fl, 1,
+                                 D3D11_SDK_VERSION, &s_dev, NULL, &s_ctx)))
+        return 1;
+    ID3DBlob* b = compile(s_vs_src, "vs_5_0");
+    if (!b) return 1;
+    ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(b), ID3D10Blob_GetBufferSize(b), NULL, &s_vs);
+    REL(b);
+    if (build_ps(RSX_FP_TEX_DEPTH_PACKED, &s_ps[1]) || build_ps(RSX_FP_TEX_DEPTH, &s_ps[2])) return 1;
+    for (int v = 0; v < ZV_N; v++)
+        for (u32 m = 1; m <= 2; m++)
+            if (build_ps_f(m, s_zv_filter[v], v == ZV_SOFT_NOLIM ? 0.0 : -1.0, &s_pss[v][m])) return 1;
+    b = compile(s_vs2_src, "vs_5_0");
+    if (!b) return 1;
+    ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(b), ID3D10Blob_GetBufferSize(b), NULL, &s_vs2);
+    REL(b);
+    for (int t2 = 0; t2 < 2; t2++) {
+        D3D11_TEXTURE2D_DESC td = {0}; td.Width = N2; td.Height = N2; td.MipLevels = td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R32G32B32A32_FLOAT; td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_DEFAULT;
+        td.BindFlags = D3D11_BIND_RENDER_TARGET;
+        ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &s_rt2[t2]);
+        ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource*)s_rt2[t2], NULL, &s_rtv2[t2]);
+        td.Usage = D3D11_USAGE_STAGING; td.BindFlags = 0; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &s_st2[t2]);
+    }
+    { D3D11_BUFFER_DESC bd2 = {0}; bd2.Usage = D3D11_USAGE_DEFAULT; bd2.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+      bd2.ByteWidth = 64; ID3D11Device_CreateBuffer(s_dev, &bd2, NULL, &s_vcb2); }
+    if (!s_vs2 || !s_vcb2 || !s_rtv2[0] || !s_rtv2[1]) return 1;
+    b = compile(s_ps_cmp_src, "ps_5_0");
+    if (!b) return 1;
+    ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(b), ID3D10Blob_GetBufferSize(b), NULL, &s_ps_cmp);
+    REL(b);
+    for (int t = 0; t < 2; t++) {
+        D3D11_TEXTURE2D_DESC td = {0}; td.Width = NS; td.Height = 1; td.MipLevels = td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R32G32B32A32_FLOAT; td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_DEFAULT;
+        td.BindFlags = D3D11_BIND_RENDER_TARGET;
+        ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &s_rt[t]);
+        ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource*)s_rt[t], NULL, &s_rtv[t]);
+        td.Usage = D3D11_USAGE_STAGING; td.BindFlags = 0; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &s_st[t]);
+    }
+    D3D11_BUFFER_DESC bd = {0}; bd.Usage = D3D11_USAGE_DEFAULT; bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    bd.ByteWidth = 32; ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_vcb);
+    bd.ByteWidth = 256; ID3D11Device_CreateBuffer(s_dev, &bd, NULL, &s_pcb);
+    return s_vs && s_ps_cmp && s_rtv[0] && s_rtv[1] && s_vcb && s_pcb ? 0 : 1;
+}
+
+static void free_device(void)
+{
+    if (s_ctx) ID3D11DeviceContext_ClearState(s_ctx);
+    for (int t = 0; t < 2; t++) { REL(s_rtv[t]); REL(s_rt[t]); REL(s_st[t]); }
+    for (int i = 0; i < 3; i++) REL(s_ps[i]);
+    for (int v = 0; v < ZV_N; v++) for (int i = 0; i < 3; i++) REL(s_pss[v][i]);
+    for (int t2 = 0; t2 < 2; t2++) { REL(s_rtv2[t2]); REL(s_rt2[t2]); REL(s_st2[t2]); }
+    REL(s_vs2); REL(s_vcb2);
+    REL(s_ps_cmp); REL(s_vs); REL(s_vcb); REL(s_pcb); REL(s_ctx); REL(s_dev);
+}
+
+/* The depth map as both SRVs: [0] RGBA8 alias (A,R,G = depth 23-16, 15-8,
+ * 7-0; B a stencil byte), [1] R32_FLOAT. */
+static ID3D11Texture2D* s_tex[2];
+static ID3D11ShaderResourceView* s_srv[2];
+static void upload_map(void)
+{
+    for (int i = 0; i < 2; i++) { REL(s_srv[i]); REL(s_tex[i]); }
+    u32* a = (u32*)malloc((size_t)MW * MW * 4);
+    float* f = (float*)malloc((size_t)MW * MW * 4);
+    for (u32 i = 0; i < (u32)MW * MW; i++) {
+        const u32 d = s_map[i] & 0xFFFFFFu, st = (i * 2654435761u) >> 24;
+        a[i] = ((d >> 8) & 0xFFu) | ((d & 0xFFu) << 8) | (st << 16) | ((d >> 16) << 24);   /* R, G, B, A bytes */
+        f[i] = (float)((double)d / 16777215.0);
+    }
+    D3D11_TEXTURE2D_DESC td = {0}; td.Width = td.Height = MW; td.MipLevels = td.ArraySize = 1;
+    td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_DEFAULT; td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    D3D11_SUBRESOURCE_DATA sd = {0}; sd.SysMemPitch = MW * 4;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM; sd.pSysMem = a;
+    ID3D11Device_CreateTexture2D(s_dev, &td, &sd, &s_tex[0]);
+    td.Format = DXGI_FORMAT_R32_FLOAT; sd.pSysMem = f;
+    ID3D11Device_CreateTexture2D(s_dev, &td, &sd, &s_tex[1]);
+    for (int i = 0; i < 2; i++)
+        ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource*)s_tex[i], NULL, &s_srv[i]);
+    free(a); free(f);
+}
+
+/* ---- the reference (double) ------------------------------------------- */
+static int s_border;          /* address mode BORDER (else CLAMP_TO_EDGE) */
+static u32 s_bdepth;          /* border texel's depth (24-bit) */
+static double texel_depth(int x, int y)
+{
+    if (s_border && (x < 0 || y < 0 || x >= MW || y >= MW)) return (double)s_bdepth / 16777215.0;
+    x = x < 0 ? 0 : x >= MW ? MW - 1 : x;
+    y = y < 0 ? 0 : y >= MW ? MW - 1 : y;
+    return (double)s_map[y * MW + x] / 16777215.0;
+}
+static double cmp(u32 zf, double d, double r)
+{
+    switch (zf) {
+    case 1: return d < r; case 2: return d == r; case 3: return d <= r; case 4: return d > r;
+    case 5: return d != r; case 6: return d >= r; case 7: return 1.0; default: return d;
+    }
+}
+/* A texel within 4e-7 of r compares either way in fp32 (the shader rebuilds
+ * the depth with a GPU division): such samples are left out (Stat.ties). */
+static int s_tie;
+static double tex_cmp(u32 zf, int x, int y, double r)
+{
+    const double d = texel_depth(x, y);
+    if (zf != 7u && fabs(d - r) < 4e-7) s_tie = 1;
+    return cmp(zf, d, r);
+}
+static double ref_pcf(double u, double v, double r, u32 zf, int linear)
+{
+    r = r < 0 ? 0 : r > 1 ? 1 : r;
+    s_tie = 0;
+    if (!linear) return tex_cmp(zf, (int)floor(u * MW), (int)floor(v * MW), r);
+    const double px = u * MW - 0.5, py = v * MW - 0.5, fx = floor(px), fy = floor(py);
+    const double wx = px - fx, wy = py - fy;
+    const int ix = (int)fx, iy = (int)fy;
+    const double a = tex_cmp(zf, ix, iy, r) * (1 - wx) + tex_cmp(zf, ix + 1, iy, r) * wx;
+    const double b = tex_cmp(zf, ix, iy + 1, r) * (1 - wx) + tex_cmp(zf, ix + 1, iy + 1, r) * wx;
+    return a * (1 - wy) + b * wy;
+}
+
+/* One sweep: tc0 from a to b over 4096 pixels. pcf 0/1/2 (fp_texctl bits
+ * 5-6), mode 1/2, or mode 0 = the SampleCmpLevelZero shader. out[i] =
+ * result, uvr[i] = the coordinate the shader saw. */
+static float s_out[NS * 4], s_uv[NS * 4];
+static int run_sweep(const float a[4], const float b[4], u32 mode, u32 zf, int linear, u32 pcf)
+{
+    const float vcb[8] = { a[0], a[1], a[2], a[3], b[0], b[1], b[2], b[3] };
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource*)s_vcb, 0, NULL, vcb, 0, 0);
+    u32 cb[64]; memset(cb, 0, sizeof cb);
+    cb[(s_cb_slots + 1u) * 4u] = (zf | (linear ? 8u : 0u) | (pcf << 5)) << 8;   /* fp_texctl.x, unit 1 */
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource*)s_pcb, 0, NULL, cb, 0, 0);
+    D3D11_SAMPLER_DESC sd = {0};
+    sd.Filter = linear ? D3D11_FILTER_MIN_MAG_LINEAR_MIP_POINT : D3D11_FILTER_MIN_MAG_MIP_POINT;
+    sd.AddressU = sd.AddressV = sd.AddressW = s_border ? D3D11_TEXTURE_ADDRESS_BORDER : D3D11_TEXTURE_ADDRESS_CLAMP;
+    sd.MaxLOD = 0; sd.ComparisonFunc = D3D11_COMPARISON_NEVER;
+    /* the border texel: for the alias the depth bytes in A, R, G; for R32F its red */
+    if (mode == RSX_FP_TEX_DEPTH_PACKED) {
+        sd.BorderColor[0] = (float)((s_bdepth >> 8) & 0xFFu) / 255.0f;
+        sd.BorderColor[1] = (float)(s_bdepth & 0xFFu) / 255.0f;
+        sd.BorderColor[3] = (float)(s_bdepth >> 16) / 255.0f;
+    } else sd.BorderColor[0] = (float)((double)s_bdepth / 16777215.0);
+    ID3D11SamplerState* smp = NULL; ID3D11Device_CreateSamplerState(s_dev, &sd, &smp);
+    D3D11_SAMPLER_DESC cd = sd;
+    cd.Filter = D3D11_FILTER_COMPARISON_MIN_MAG_LINEAR_MIP_POINT; cd.ComparisonFunc = D3D11_COMPARISON_LESS;
+    cd.BorderColor[0] = (float)((double)s_bdepth / 16777215.0);
+    ID3D11SamplerState* csm = NULL; ID3D11Device_CreateSamplerState(s_dev, &cd, &csm);
+    ID3D11SamplerState* ss[3] = { smp, smp, csm };
+    ID3D11ShaderResourceView* srv[2] = { NULL, s_srv[mode == RSX_FP_TEX_DEPTH_PACKED ? 0 : 1] };
+    const float clr[4] = { -7, -7, -7, -7 };
+    for (int t = 0; t < 2; t++) ID3D11DeviceContext_ClearRenderTargetView(s_ctx, s_rtv[t], clr);
+    D3D11_RASTERIZER_DESC rd = {0}; rd.FillMode = D3D11_FILL_SOLID; rd.CullMode = D3D11_CULL_NONE; rd.DepthClipEnable = TRUE;
+    ID3D11RasterizerState* rs = NULL; ID3D11Device_CreateRasterizerState(s_dev, &rd, &rs);
+    D3D11_VIEWPORT vp = { 0, 0, NS, 1, 0, 1 };
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 2, s_rtv, NULL);
+    ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+    ID3D11DeviceContext_RSSetState(s_ctx, rs);
+    ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+    ID3D11DeviceContext_VSSetShader(s_ctx, s_vs, NULL, 0);
+    ID3D11DeviceContext_VSSetConstantBuffers(s_ctx, 0, 1, &s_vcb);
+    ID3D11DeviceContext_PSSetShader(s_ctx, s_force_ps ? s_force_ps : mode ? s_ps[mode] : s_ps_cmp, NULL, 0);
+    ID3D11DeviceContext_PSSetConstantBuffers(s_ctx, 1, 1, &s_pcb);
+    if (!mode) srv[1] = s_srv[1];
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 2, srv);
+    ID3D11DeviceContext_PSSetSamplers(s_ctx, 0, 3, ss);
+    ID3D11DeviceContext_Draw(s_ctx, 4, 0);
+    int rc = 0;
+    for (int t = 0; t < 2; t++) {
+        ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource*)s_st[t], (ID3D11Resource*)s_rt[t]);
+        D3D11_MAPPED_SUBRESOURCE ms;
+        if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource*)s_st[t], 0, D3D11_MAP_READ, 0, &ms))) { rc = 1; continue; }
+        memcpy(t ? s_uv : s_out, ms.pData, sizeof s_out);
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource*)s_st[t], 0);
+    }
+    ID3D11DeviceContext_ClearState(s_ctx);
+    REL(rs); REL(smp); REL(csm);
+    return rc;
+}
+
+/* The soft kernels' reference (no receiver plane: r constant): the per-axis
+ * weights of rsx_fp_shadow_weights around k = round(p), each texel compared
+ * with r. */
+static double ref_soft(double u, double v, double r, u32 zf, u32 kernel)
+{
+    r = r < 0 ? 0 : r > 1 ? 1 : r;
+    s_tie = 0;
+    const double px = u * MW - 0.5, py = v * MW - 0.5, kx = floor(px + 0.5), ky = floor(py + 0.5);
+    double wx[5], wy[5], s = 0.0;
+    rsx_fp_shadow_weights(kernel, px - kx, wx);
+    rsx_fp_shadow_weights(kernel, py - ky, wy);
+    for (int j = 0; j < 5; j++)
+        for (int i = 0; i < 5; i++)
+            if (wx[i] * wy[j] != 0.0) s += wx[i] * wy[j] * tex_cmp(zf, (int)kx + i - 2, (int)ky + j - 2, r);
+    return s;
+}
+
+/* One 256x256 draw: tc0 = a + x b + y c (x, y over the target). out2 = t0 (the result), uv2 = t1 (the coordinate). */
+static float s_out2[N2 * N2 * 4], s_uv2[N2 * N2 * 4];
+static int run_2d(const float a[4], const float b[4], const float c[4], ID3D11PixelShader* ps, u32 mode, u32 zf)
+{
+    const float vcb[16] = { a[0], a[1], a[2], a[3], b[0], b[1], b[2], b[3], c[0], c[1], c[2], c[3], 0, 0, 0, 0 };
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource*)s_vcb2, 0, NULL, vcb, 0, 0);
+    u32 cb[64]; memset(cb, 0, sizeof cb);
+    cb[(s_cb_slots + 1u) * 4u] = (zf | 8u) << 8;                   /* fp_texctl.x, unit 1: linear, exact */
+    ID3D11DeviceContext_UpdateSubresource(s_ctx, (ID3D11Resource*)s_pcb, 0, NULL, cb, 0, 0);
+    D3D11_SAMPLER_DESC sd = {0};
+    sd.Filter = D3D11_FILTER_MIN_MAG_LINEAR_MIP_POINT;
+    sd.AddressU = sd.AddressV = sd.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    sd.MaxLOD = 0; sd.ComparisonFunc = D3D11_COMPARISON_NEVER;
+    ID3D11SamplerState* smp = NULL; ID3D11Device_CreateSamplerState(s_dev, &sd, &smp);
+    ID3D11SamplerState* ss[2] = { smp, smp };
+    ID3D11ShaderResourceView* srv[2] = { NULL, s_srv[mode == RSX_FP_TEX_DEPTH_PACKED ? 0 : 1] };
+    const float clr[4] = { -7, -7, -7, -7 };
+    for (int k = 0; k < 2; k++) ID3D11DeviceContext_ClearRenderTargetView(s_ctx, s_rtv2[k], clr);
+    D3D11_RASTERIZER_DESC rd = {0}; rd.FillMode = D3D11_FILL_SOLID; rd.CullMode = D3D11_CULL_NONE; rd.DepthClipEnable = TRUE;
+    ID3D11RasterizerState* rs = NULL; ID3D11Device_CreateRasterizerState(s_dev, &rd, &rs);
+    D3D11_VIEWPORT vp = { 0, 0, N2, N2, 0, 1 };
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 2, s_rtv2, NULL);
+    ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+    ID3D11DeviceContext_RSSetState(s_ctx, rs);
+    ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+    ID3D11DeviceContext_VSSetShader(s_ctx, s_vs2, NULL, 0);
+    ID3D11DeviceContext_VSSetConstantBuffers(s_ctx, 0, 1, &s_vcb2);
+    ID3D11DeviceContext_PSSetShader(s_ctx, ps, NULL, 0);
+    ID3D11DeviceContext_PSSetConstantBuffers(s_ctx, 1, 1, &s_pcb);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 2, srv);
+    ID3D11DeviceContext_PSSetSamplers(s_ctx, 0, 2, ss);
+    ID3D11DeviceContext_Draw(s_ctx, 4, 0);
+    int rc = 0;
+    for (int k = 0; k < 2; k++) {
+        ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource*)s_st2[k], (ID3D11Resource*)s_rt2[k]);
+        D3D11_MAPPED_SUBRESOURCE ms;
+        if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource*)s_st2[k], 0, D3D11_MAP_READ, 0, &ms))) { rc = 1; continue; }
+        for (int y = 0; y < N2; y++)
+            memcpy((k ? s_uv2 : s_out2) + (size_t)y * N2 * 4, (const char*)ms.pData + (size_t)y * ms.RowPitch, N2 * 16);
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource*)s_st2[k], 0);
+    }
+    ID3D11DeviceContext_ClearState(s_ctx);
+    REL(rs); REL(smp);
+    return rc;
+}
+
+typedef struct { double maxerr; long bad, n, ties; } Stat;
+static void stat_add(Stat* s, double got, double want)
+{
+    if (s_tie) { s->ties++; return; }
+    const double e = fabs(got - want);
+    if (!(e <= s->maxerr)) s->maxerr = e != e ? 9.0 : e;
+    if (!(e <= 1.0 / 64)) s->bad++;
+    s->n++;
+}
+
+/* The three sweep families (x, y, diagonal) x 32 offsets near the map centre,
+ * or (edge = 1) across u = 0 and u = 1 / v = 0 and v = 1 for the border. */
+static void sweep_coords(int fam, int k, int edge, int rramp, float a[4], float b[4])
+{
+    const double sh = k * 0.37 + 0.05, W = MW;
+    double u0, v0, du, dv;
+    if (!edge) {
+        const double x0 = W / 2 - 4, y0 = W / 2 - 4;
+        if (fam == 0)      { u0 = (x0 + 0.0) / W; v0 = (y0 + 2.3 + sh) / W; du = 4.0 / W; dv = 0; }
+        else if (fam == 1) { u0 = (x0 + 3.6 + sh) / W; v0 = (y0 - 2.0) / W; du = 0; dv = 4.0 / W; }
+        else               { u0 = (x0 + 1.0) / W; v0 = (y0 - 1.0 + sh) / W; du = 3.0 / W; dv = 3.0 / W; }
+    } else {                                   /* 4 texels centred on an edge */
+        const double e = (k & 1) ? 1.0 : 0.0, c = (100.0 + sh * 20.0) / W;
+        if (fam == 0)      { u0 = e - 2.0 / W; v0 = c; du = 4.0 / W; dv = 0; }
+        else if (fam == 1) { u0 = c; v0 = e - 2.0 / W; du = 0; dv = 4.0 / W; }
+        else               { u0 = e - 2.0 / W; v0 = e - 2.0 / W; du = 4.0 / W; dv = 4.0 / W; }
+    }
+    /* tc0 at the left and right EDGES of the target: pixel i's centre is at (i + 0.5) / NS */
+    a[0] = (float)u0; a[1] = (float)v0; b[0] = (float)(u0 + du); b[1] = (float)(v0 + dv);
+    a[2] = rramp ? 0.0f : 0.5f; b[2] = rramp ? 1.0f : 0.5f;
+    a[3] = b[3] = 1.0f;
+}
+
+static void check(const char* name, const Stat* s, double tol)
+{
+    const int ok = s->maxerr <= tol && s->n > 0;
+    printf("[%s] %s: max|err| %.6f, %ld of %ld samples > 1/64", ok ? "PASS" : "FAIL", name, s->maxerr, s->bad, s->n);
+    if (s->ties) printf(" (%ld near-tie samples left out)", s->ties);
+    printf("\n");
+    s_checks++; s_fails += !ok;
+}
+
+static void make_map(int random24)
+{
+    for (u32 y = 0; y < MW; y++)
+        for (u32 x = 0; x < MW; x++) {
+            const u32 h = ((x * 73856093u) ^ (y * 19349663u)) * 2654435761u;
+            s_map[y * MW + x] = random24 ? (h >> 8) & 0xFFFFFFu : ((h >> 31) ? 0xC00000u : 0x400000u);
+        }
+}
+
+static void check_soft(const char* name, int ok, const char* detail)
+{
+    printf("[SOFT] [%s] %s%s%s\n", ok ? "PASS" : "FAIL", name, detail && *detail ? ": " : "", detail ? detail : "");
+    s_checks++; s_fails += !ok;
+}
+
+/* The receiver-plane test map: depth = z0 + gx * x + gy * y (texel indices) + bias, an occluder square
+ * [o0, o1)^2 nearer by 0.05 when occ. */
+static void make_plane_map(double z0, double gx, double gy, double bias, int occ, int o0, int o1)
+{
+    for (int y = 0; y < MW; y++)
+        for (int x = 0; x < MW; x++) {
+            double d = z0 + gx * x + gy * y + bias;
+            if (occ && x >= o0 && x < o1 && y >= o0 && y < o1) d -= 0.05;
+            d = d < 0 ? 0 : d > 1 ? 1 : d;
+            s_map[y * MW + x] = (u32)floor(d * 16777215.0 + 0.5);
+        }
+}
+
+/* The soft kernels on this device (the [SOFT] lines; see the header). */
+static int run_soft(void)
+{
+    char nm[200], det[200];
+    /* kernel: sweeps against ref_soft, r constant (no plane); NEAREST and ramped r keep the PS3 kernel */
+    for (int map = 0; map < 2; map++) {
+        make_map(map);
+        upload_map();
+        for (int v = 0; v < ZV_N; v++) {
+            if (v == ZV_POISSON) continue;                         /* noise: not a deterministic reference */
+            const u32 kern = s_zv_filter[v] & RSX_FP_SHADOW_KERNEL;
+            for (u32 mode = 1; mode <= 2; mode++)
+            for (int border = 0; border < 2; border++) {
+                if (v >= ZV_SOFT_NP && (mode == 2 || border)) continue;   /* the variants: one case each */
+                s_border = border; s_bdepth = border ? 0xFFFFFFu : 0u;
+                Stat se = {0}, sn = {0}, sr = {0};
+                for (u32 zf = 1u; zf <= 7u; zf++) {
+                    if (v >= ZV_SOFT_NP && zf != 4u) continue;
+                    for (int f = 0; f < 3; f++)
+                        for (int k = 0; k < 32; k += (v >= ZV_SOFT_NP ? 4 : 1)) {
+                            float a[4], b[4];
+                            sweep_coords(f, k, border, 0, a, b);
+                            s_force_ps = s_pss[v][mode];
+                            if (run_sweep(a, b, mode, zf, 1, 0)) { s_force_ps = NULL; return 1; }
+                            for (int i = 0; i < NS; i++)
+                                stat_add(&se, s_out[i * 4], ref_soft(s_uv[i * 4], s_uv[i * 4 + 1], s_uv[i * 4 + 2], zf, kern));
+                            if (zf == 4u && f == 0) {                /* NEAREST: the PS3 kernel's texel */
+                                if (run_sweep(a, b, mode, zf, 0, 0)) { s_force_ps = NULL; return 1; }
+                                for (int i = 0; i < NS; i++)
+                                    stat_add(&sn, s_out[i * 4], ref_pcf(s_uv[i * 4], s_uv[i * 4 + 1], s_uv[i * 4 + 2], zf, 0));
+                            }
+                            if (zf == 4u && map == 1) {              /* r ramps, 1-pixel-high target: no 2-D plane */
+                                sweep_coords(f, k, border, 1, a, b);
+                                if (run_sweep(a, b, mode, zf, 1, 0)) { s_force_ps = NULL; return 1; }
+                                const int noplane = !ZV_PLANE(v);
+                                for (int i = 0; i < NS; i++) {
+                                    const double u = s_uv[i * 4], vv = s_uv[i * 4 + 1], r = s_uv[i * 4 + 2];
+                                    stat_add(&sr, s_out[i * 4], noplane ? ref_soft(u, vv, r, zf, kern) : ref_pcf(u, vv, r, zf, 1));
+                                }
+                            }
+                            s_force_ps = NULL;
+                        }
+                }
+                snprintf(nm, sizeof nm, "kernel %s, %s map, mode %u, %s, zfunc %s", s_zv_name[v],
+                         map ? "random-24" : "two-level", mode, border ? "BORDER (edges)" : "CLAMP",
+                         v >= ZV_SOFT_NP ? "4" : "1-7");
+                snprintf(det, sizeof det, "max|err| %.6f, %ld of %ld > 1/64 (%ld ties left out)", se.maxerr, se.bad, se.n, se.ties);
+                check_soft(nm, se.n > 0 && se.maxerr <= 1.0 / 64, det);
+                if (sn.n) {
+                    snprintf(det, sizeof det, "max|err| %.6f against the PS3 nearest texel", sn.maxerr);
+                    snprintf(nm, sizeof nm, "  nearest keeps the PS3 kernel (%s, mode %u)", s_zv_name[v], mode);
+                    check_soft(nm, sn.maxerr <= 1.0 / 64, det);
+                }
+                if (sr.n) {
+                    snprintf(det, sizeof det, "max|err| %.6f against %s", sr.maxerr,
+                             !ZV_PLANE(v) ? "the soft kernel at the pixel's r" : "the PS3 2x2");
+                    snprintf(nm, sizeof nm, "  r ramping on a 1-pixel-high sweep (degenerate plane) (%s, mode %u)",
+                             s_zv_name[v], mode);
+                    check_soft(nm, sr.maxerr <= 1.0 / 64, det);
+                }
+            }
+        }
+    }
+    s_border = 0; s_bdepth = 0;
+    /* sum: all lit (texel 0.75 > r 0.5, GREATER) = 1, all shadowed = 0 */
+    for (int lit = 1; lit >= 0; lit--) {
+        for (int i = 0; i < MW * MW; i++) s_map[i] = lit ? 0xC00000u : 0x400000u;
+        upload_map();
+        for (int v = 0; v < ZV_N; v++)
+            for (u32 mode = 1; mode <= 2; mode++) {
+                double worst = 0.0;
+                for (int f = 0; f < 3; f++)
+                    for (int k = 0; k < 32; k += 8) {
+                        float a[4], b[4];
+                        sweep_coords(f, k, 0, 0, a, b);
+                        s_force_ps = s_pss[v][mode];
+                        if (run_sweep(a, b, mode, 4, 1, 0)) { s_force_ps = NULL; return 1; }
+                        s_force_ps = NULL;
+                        for (int i = 0; i < NS; i++) {
+                            const double e = fabs(s_out[i * 4] - (lit ? 1.0 : 0.0));
+                            if (!(e <= worst)) worst = e != e ? 9.0 : e;
+                        }
+                    }
+                snprintf(nm, sizeof nm, "sum: all %s, %s, mode %u", lit ? "lit -> 1" : "shadowed -> 0", s_zv_name[v], mode);
+                snprintf(det, sizeof det, "max|err| %.2e", worst);
+                check_soft(nm, worst <= 1e-5, det);
+            }
+    }
+    /* edge: texels x < 512 at 0.25 (shadowed: GREATER fails), x >= 512 at 0.75 (lit); sweep x over 504..520 */
+    for (int y = 0; y < MW; y++) for (int x = 0; x < MW; x++) s_map[y * MW + x] = x < 512 ? 0x400000u : 0xC00000u;
+    upload_map();
+    for (int v = -1; v <= ZV_SOFTER; v++) {
+        float a[4] = { 504.0f / MW, 300.3f / MW, 0.5f, 1.0f }, b[4] = { 520.0f / MW, 300.3f / MW, 0.5f, 1.0f };
+        s_force_ps = v < 0 ? NULL : s_pss[v][1];
+        if (run_sweep(a, b, 1, 4, 1, 0)) { s_force_ps = NULL; return 1; }
+        s_force_ps = NULL;
+        int mono = 1; double lo = 1e9, hi = -1e9;
+        for (int i = 0; i < NS; i++) {
+            if (i && s_out[i * 4] < s_out[(i - 1) * 4] - 1e-6f) mono = 0;
+            const double px = s_uv[i * 4] * MW - 0.5;
+            if (s_out[i * 4] > 1e-6f && px < lo) lo = px;
+            if (s_out[i * 4] < 1.0f - 1e-6f && px > hi) hi = px;
+        }
+        const double want = v < 0 ? 1.0 : v == ZV_SOFT ? 2.0 : 4.0;
+        snprintf(nm, sizeof nm, "edge: %s monotone, ramp over %.0f texel(s)", v < 0 ? "ps3" : s_zv_name[v], want);
+        snprintf(det, sizeof det, "monotone %d, ramp %.4f texels (texel %.3f .. %.3f)", mono, hi - lo, lo, hi);
+        check_soft(nm, mono && fabs((hi - lo) - want) < 0.02, det);
+    }
+    /* plane: a sloped receiver over its own depth, biased for the PS3's 2x2 (one texel of slope) */
+    static const struct { double gx, gy, mag; int rot; const char* what; } pc[] = {
+        { 2.0e-4, 1.0e-4, 6.4, 0, "slope 3e-4 / texel, 6.4 px per texel (a close-up)" },
+        { -1.5e-4, 2.5e-4, 1.0, 1, "slope 4e-4 / texel, 1 px per texel, rotated 30 deg" },
+        { 1.2e-3, 0.0, 3.0, 0, "slope 1.2e-3 / texel (steeper than the plane limit), 3 px per texel" },
+    };
+    for (size_t c = 0; c < sizeof pc / sizeof pc[0]; c++) {
+        const double gx = pc[c].gx, gy = pc[c].gy, z0 = 0.5 - 512.0 * (gx + gy);   /* 0.5 at texel (512, 512) */
+        const double bias = 1.05 * (fabs(gx) + fabs(gy)) + 3.0 / 16777215.0;
+        for (int occ = 0; occ < 2; occ++) {
+            make_plane_map(z0, gx, gy, bias, occ, 500, 524);
+            upload_map();
+            /* the quad: N2 px over N2 / mag texels around texel (512, 512) */
+            const double span = N2 / pc[c].mag / MW, ang = pc[c].rot ? 0.5235987756 : 0.0;
+            const double cx = 512.0 / MW - span / 2 * (cos(ang) - sin(ang)), cy = 512.0 / MW - span / 2 * (sin(ang) + cos(ang));
+            const double bxu = span * cos(ang), bxv = span * sin(ang), byu = -span * sin(ang), byv = span * cos(ang);
+            /* r at a uv: the plane through the texel centres, uv * MW - 0.5 */
+            #define RPL(u, v) (z0 + gx * ((u) * MW - 0.5) + gy * ((v) * MW - 0.5))
+            const float a[4] = { (float)cx, (float)cy, (float)RPL(cx, cy), 1.0f };
+            const float bb[4] = { (float)bxu, (float)bxv, (float)(gx * bxu * MW + gy * bxv * MW), 0.0f };
+            const float cc[4] = { (float)byu, (float)byv, (float)(gx * byu * MW + gy * byv * MW), 0.0f };
+            #undef RPL
+            for (int v = -1; v < ZV_N; v++) {
+                if (v == ZV_SOFT_NOLIM && c != 2) continue;
+                ID3D11PixelShader* ps = v < 0 ? s_ps[1] : s_pss[v][1];
+                if (run_2d(a, bb, cc, ps, 1, 4)) return 1;
+                long dark = 0, n = 0, in_n = 0, in_lit = 0; double minv = 9.0;
+                for (int i = 0; i < N2 * N2; i++) {
+                    const double px = s_uv2[i * 4] * MW - 0.5, py = s_uv2[i * 4 + 1] * MW - 0.5;
+                    const int inside = px > 500 + 3 && px < 523 - 3 && py > 500 + 3 && py < 523 - 3;
+                    const int outside = px < 500 - 4 || px > 523 + 4 || py < 500 - 4 || py > 523 + 4;
+                    if (occ && inside) { in_n++; if (s_out2[i * 4] > 1.0f / 64) in_lit++; }
+                    if (occ && !outside) continue;
+                    n++;
+                    if (s_out2[i * 4] < 1.0f - 1.0f / 255) dark++;
+                    if (s_out2[i * 4] < minv) minv = s_out2[i * 4];
+                }
+                const int noplane = v >= 0 && !ZV_PLANE(v);
+                snprintf(nm, sizeof nm, "plane: %s, %s%s", v < 0 ? "ps3" : s_zv_name[v], pc[c].what,
+                         occ ? ", with an occluder square" : "");
+                snprintf(det, sizeof det, "%ld of %ld receiver pixels darker than 1 - 1/255 (min %.4f)%s", dark, n, minv,
+                         noplane ? " -- no receiver plane: the acne a wider reach brings on a minimal PS3 bias (not judged)" : "");
+                if (noplane) { printf("[SOFT] [INFO] %s: %s\n", nm, det); }
+                else check_soft(nm, n > 0 && dark == 0, det);
+                if (occ) {
+                    snprintf(det, sizeof det, "%ld of %ld pixels inside it lit", in_lit, in_n);
+                    snprintf(nm, sizeof nm, "  the occluder still shadows (%s, %s)", v < 0 ? "ps3" : s_zv_name[v], pc[c].what);
+                    check_soft(nm, in_n > 0 && in_lit == 0, det);
+                }
+            }
+        }
+    }
+    return 0;
+}
+
+static int run_device(IDXGIAdapter* hwad)
+{
+    if (init_device(hwad)) {
+        free_device();
+        printf("[FAIL] no %s\n", hwad ? "D3D11 device on a hardware adapter" : "WARP device"); s_fails++; return 1;
+    }
+    { IDXGIDevice* xd = NULL; IDXGIAdapter* ad = NULL; DXGI_ADAPTER_DESC desc;
+      if (SUCCEEDED(ID3D11Device_QueryInterface(s_dev, &IID_IDXGIDevice, (void**)&xd)) &&
+          SUCCEEDED(IDXGIDevice_GetAdapter(xd, &ad)) && SUCCEEDED(IDXGIAdapter_GetDesc(ad, &desc)))
+          printf("== device: %s (%ls)\n", hwad ? "hardware" : "WARP", desc.Description);
+      REL(ad); REL(xd); }
+    char nm[160];
+    for (int map = 0; map < 2; map++) {
+        make_map(map);
+        upload_map();
+        for (u32 mode = 1; mode <= 2; mode++)
+        for (int border = 0; border < 2; border++) {
+            s_border = border; s_bdepth = border ? 0xFFFFFFu : 0u;
+            /* centre sweeps for the map test; edge sweeps for the address mode */
+            const int edge = border;
+            const u32 zmax = (map || border) ? 4u : 7u;     /* + 6 and 7 always */
+            for (u32 zf = 1u; zf <= 7u; zf++) {
+                if (zf > zmax && zf != 6u && zf != 7u) continue;
+                for (int linear = 1; linear >= 0; linear--) {
+                    Stat se = {0}, sg = {0}; long dbad = 0, dn = 0;
+                    for (int f = 0; f < 3; f++)
+                        for (int k = 0; k < 32; k++) {
+                            float a[4], b[4];
+                            sweep_coords(f, k, edge, map, a, b);
+                            static float ex[NS], ga[NS];
+                            if (run_sweep(a, b, mode, zf, linear, 0)) { s_fails++; return 1; }
+                            for (int i = 0; i < NS; i++) {
+                                ex[i] = s_out[i * 4];
+                                stat_add(&se, ex[i], ref_pcf(s_uv[i * 4], s_uv[i * 4 + 1], s_uv[i * 4 + 2], zf, linear));
+                            }
+                            if (run_sweep(a, b, mode, zf, linear, 1)) { s_fails++; return 1; }
+                            for (int i = 0; i < NS; i++) {
+                                ga[i] = s_out[i * 4];
+                                stat_add(&sg, ga[i], ref_pcf(s_uv[i * 4], s_uv[i * 4 + 1], s_uv[i * 4 + 2], zf, linear));
+                            }
+                            if (run_sweep(a, b, mode, zf, linear, 2)) { s_fails++; return 1; }
+                            for (int i = 0; i < NS; i++) {
+                                const float want = fabsf(ex[i] - ga[i]) > 1.0f / 64.0f ? 1.0f : 0.0f;
+                                dbad += s_out[i * 4] != want; dn++;
+                            }
+                        }
+                    snprintf(nm, sizeof nm, "%s map, mode %u, %s, zfunc %u, %s: exact", map ? "random-24" : "two-level",
+                             mode, border ? "BORDER (edges)" : "CLAMP", zf, linear ? "linear" : "nearest");
+                    check(nm, &se, 1.0 / 64);
+                    printf("[INFO]   gather (pre-2026-10-20): max|err| %.6f, %ld of %ld samples > 1/64%s\n",
+                           sg.maxerr, sg.bad, sg.n, sg.bad ? "  <- the seam band" : "");
+                    { const int ok = dbad == 0;
+                      printf("[%s]   diff marks exactly the samples where gather and exact differ (%ld of %ld wrong)\n",
+                             ok ? "PASS" : "FAIL", dbad, dn);
+                      s_checks++; s_fails += !ok; }
+                }
+            }
+        }
+        /* The GPU's own comparison filter, GREATER (texel > r = D3D LESS), CLAMP. */
+        if (!map) {
+            s_border = 0; s_bdepth = 0;
+            Stat sh = {0};
+            for (int f = 0; f < 3; f++)
+                for (int k = 0; k < 32; k++) {
+                    float a[4], b[4];
+                    sweep_coords(f, k, 0, 0, a, b);
+                    if (run_sweep(a, b, 0, 4, 1, 0)) { s_fails++; return 1; }
+                    for (int i = 0; i < NS; i++)
+                        stat_add(&sh, s_out[i * 4], ref_pcf(s_uv[i * 4], s_uv[i * 4 + 1], s_uv[i * 4 + 2], 4, 1));
+                }
+            printf("[INFO] SampleCmpLevelZero (the GPU's comparison filter, zfunc 4, CLAMP): max|err| %.6f,"
+                   " %ld of %ld > 1/64\n", sh.maxerr, sh.bad, sh.n);
+        }
+    }
+    if (run_soft()) { s_fails++; printf("[FAIL] soft-kernel draws\n"); }
+    free_device();
+    for (int i = 0; i < 2; i++) { REL(s_srv[i]); REL(s_tex[i]); }
+    return 0;
+}
+
+int main(int argc, char** argv)
+{
+    HMODULE m = LoadLibraryA("d3dcompiler_47.dll");
+    s_compile = m ? (PFN_Compile)GetProcAddress(m, "D3DCompile") : NULL;
+    if (!s_compile) { printf("no d3dcompiler_47.dll\n"); return 2; }
+    s_map = (u32*)malloc((size_t)MW * MW * 4);
+    const char* which = argc > 1 ? argv[1] : "both";
+    if (strcmp(which, "hw")) run_device(NULL);
+    if (strcmp(which, "warp")) {                    /* every hardware adapter */
+        IDXGIFactory1* fac = NULL; int nhw = 0;
+        if (SUCCEEDED(CreateDXGIFactory1(&IID_IDXGIFactory1, (void**)&fac))) {
+            IDXGIAdapter1* ad = NULL;
+            for (UINT i = 0; IDXGIFactory1_EnumAdapters1(fac, i, &ad) != DXGI_ERROR_NOT_FOUND; i++) {
+                DXGI_ADAPTER_DESC1 d; IDXGIAdapter1_GetDesc1(ad, &d);
+                if (!(d.Flags & DXGI_ADAPTER_FLAG_SOFTWARE)) { run_device((IDXGIAdapter*)ad); nhw++; }
+                REL(ad);
+            }
+            REL(fac);
+        }
+        if (!nhw) printf("[SKIP] no hardware adapter\n");
+    }
+    printf("Results: %d checks, %d failed\n", s_checks, s_fails);
+    return s_fails ? 1 : 0;
+}
diff --git a/runtime/diag/play_issues.c b/runtime/diag/play_issues.c
new file mode 100644
index 0000000..f935ee8
--- /dev/null
+++ b/runtime/diag/play_issues.c
@@ -0,0 +1,1152 @@
+/*
+ * ps3recomp - the play-session issues log (see include/ps3emu/play_issues.h)
+ *
+ * Three parties, one direction of data:
+ *   render thread  pi_frame: frame statistics in memory only it touches (median of the last 16
+ *                  intervals as the "normal" frame, typical cost of each part as slow averages, the
+ *                  minute's and the session's 1-ms histograms). A frame that took too long joins a
+ *                  burst (hitches within a second of each other are one line); a finished burst, a
+ *                  minute, a slow stretch go into the queue.
+ *   any thread     pi_signal / pi_note / pi_mark: into the signal ring or the queue.
+ *   writer thread  every 2 s: formats and appends what the queue holds, reads what the log gained,
+ *                  notices frames that stopped coming, samples CPU / memory / video memory once a
+ *                  minute, notes settings changes. Lowest CPU and I/O priority, EcoQoS.
+ * The queue and the signal ring share one SRW lock, held for a copy and never while formatting or
+ * writing. The file is opened for appending only, so the crash filter can add its lines with one
+ * WriteFile whatever the writer is doing.
+ */
+#include "ps3emu/play_issues.h"
+#include "ps3emu/options.h"
+
+#include <math.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define COBJMACROS
+#include <windows.h>
+#include <dxgi1_4.h>
+#include <intrin.h>
+#include <psapi.h>
+#pragma comment(lib, "dxguid.lib")
+
+/* ------------------------------------------------------------------ state */
+
+enum { C_COMPILE, C_PIPELINE, C_READBACK, C_GPU, C_PRESENT, C_GAME, C_RENDER, C_RECORD, C_N };
+static const char* const k_cname[C_N] = {
+    "shader compiles", "pipeline creation", "GPU readback", "GPU busy", "display (Present)",
+    "game thread", "render thread", "render thread (other: draw commands, window messages, Windows)" };
+static const char* const k_ckey[C_N] = {
+    "shader-compile", "pipeline", "readback", "gpu", "present", "game", "render", "record" };
+
+enum { R_BURST = 1, R_MINUTE, R_SLOW, R_NOTE, R_MARK, R_FIRST };
+typedef struct {
+    double t1, worst, base, c[C_N], tex_mb, sig_t;
+    unsigned n, nst, nhi, nfr, compiles, pipelines, readbacks, tex_up, tex_new, targets;
+    long sig;
+    int bg, paused;
+} pi_burst;
+typedef struct {
+    int kind;
+    double t;
+    union {
+        pi_burst b;
+        struct { int idx; unsigned frames, nst, nhi, nfr; double avg_fps, low1_fps, worst; } m;
+        struct { double dur_s, avg_fps, min_fps, target; } s;
+        struct { int n; long sig; double sig_t; } k;
+    } u;
+    char text[240];
+} pi_rec;
+
+#define PI_QN   256
+#define PI_NSIG 32
+#define PI_HB   251                 /* 1-ms buckets 0..249, then 250+ */
+static SRWLOCK  s_lock = SRWLOCK_INIT;
+static pi_rec   s_q[PI_QN];
+static unsigned s_qh, s_qt, s_qdrop;
+static struct { char name[32]; double t; } s_sig[PI_NSIG];
+static volatile long s_sig_n;
+
+static volatile long s_on;          /* started and not ended */
+static HANDLE   s_fh = INVALID_HANDLE_VALUE, s_thread, s_wake, s_gpu_ev;
+static char     s_path[MAX_PATH], s_build[96], s_log_path[MAX_PATH];
+static LARGE_INTEGER s_qf, s_q0;
+static volatile double s_last_present_ms;  /* render thread writes, the writer reads (8-byte aligned: atomic) */
+static volatile long s_crashing;           /* the crash filter runs: take no lock that may never come free */
+static volatile long s_ending, s_ended, s_marks;
+static void (*s_mark_hook)(int, const char*);
+static IDXGIAdapter* s_adapter;
+static IDXGIAdapter3* s_adapter3;
+static HMODULE  s_dbghelp;
+static LPTOP_LEVEL_EXCEPTION_FILTER s_prev_filter;
+
+/* render thread */
+static struct {
+    double ring[16]; unsigned nr;               /* the last intervals: their median is "normal" */
+    double ema[C_N];                            /* typical per-frame cost of each part */
+    int    warm;
+    pi_burst b; double b_t0; int b_open;
+    unsigned mh[PI_HB], sh[PI_HB];              /* this minute's / the session's histograms */
+    unsigned mn, mst, mhi, mfr; double msum, mworst; int midx; double mt0;
+    double wt0, wsum; unsigned wn, wpaused;     /* the 10-s window */
+    int    slow; double slow_t0, slow_sum, slow_min, slow_target; unsigned slow_n;
+    unsigned long long frames; double ssum, sworst;
+    unsigned nst, nhi, nfr, nslow; double slow_s;
+    double last_t;
+} R;
+
+/* writer thread */
+static struct {
+    HANDLE lf; LONG64 loff; char carry[4096]; size_t ncarry;
+    struct { unsigned long long h; unsigned count; int level; char text[200]; double t; } tab[512];
+    unsigned nuniq, nerr, nwarn, m_err, m_warn, hidden;
+    int stall_lvl; double stall_seen;
+    unsigned cause_n[C_N + 2];                  /* slow-frame bursts by cause (+ texture streaming, unexplained) */
+    ULONG64 cpu_last, wall_last;
+    double next_mem_note;
+    unsigned gen; char (*snap)[72]; int nsnap;
+    int header_done;
+} W;
+
+static char s_root[MAX_PATH], s_profile[MAX_PATH], s_user[64], s_pc[64];
+
+static double now_ms(void)
+{
+    LARGE_INTEGER c; QueryPerformanceCounter(&c);
+    return (double)(c.QuadPart - s_q0.QuadPart) * 1000.0 / (double)s_qf.QuadPart;
+}
+
+/* ------------------------------------------------------------------ queue */
+
+static void q_push(const pi_rec* r)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    if (s_qt - s_qh < PI_QN) { s_q[s_qt % PI_QN] = *r; s_qt++; }
+    else s_qdrop++;
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+/* ------------------------------------------------------------------ text helpers */
+
+/* append to out[n] at *k; a cut-off append leaves *k at the end of the buffer */
+PI_PRINTF(4, 5) static void apf(char* out, size_t n, size_t* k, const char* fmt, ...)
+{
+    if (*k + 1 >= n) return;
+    va_list a; va_start(a, fmt);
+    const int w = vsnprintf(out + *k, n - *k, fmt, a);
+    va_end(a);
+    if (w < 0) return;
+    *k = (*k + (size_t)w < n) ? *k + (size_t)w : n - 1;
+}
+
+static int ieq_path(char a, char b)
+{
+    if (a == '/') a = '\\';
+    if (b == '/') b = '\\';
+    if (a >= 'A' && a <= 'Z') a = (char)(a - 'A' + 'a');
+    if (b >= 'A' && b <= 'Z') b = (char)(b - 'A' + 'a');
+    return a == b;
+}
+
+/* Replace every `pat` (case-insensitive, / and \ alike) in s with rep, in place. */
+static void replace_all(char* s, size_t cap, const char* pat, const char* rep)
+{
+    const size_t pl = strlen(pat), rl = strlen(rep);
+    if (pl < 3) return;
+    for (char* p = s; *p; ) {
+        size_t i = 0;
+        while (i < pl && p[i] && ieq_path(p[i], pat[i])) i++;
+        if (i < pl) { p++; continue; }
+        const size_t tail = strlen(p + pl);
+        if ((size_t)(p - s) + rl + tail + 1 > cap) return;
+        memmove(p + rl, p + pl, tail + 1);
+        memcpy(p, rep, rl);
+        p += rl;
+    }
+}
+
+/* No user or computer name leaves the machine in this file. */
+static void scrub(char* s, size_t cap)
+{
+    if (s_root[0])    replace_all(s, cap, s_root, ".");
+    if (s_profile[0]) replace_all(s, cap, s_profile, "%USERPROFILE%");
+    if (s_pc[0])      replace_all(s, cap, s_pc, "<pc>");      /* before the user name: "ALICE-PC" */
+    if (s_user[0])    replace_all(s, cap, s_user, "<user>");
+}
+
+static void fmt_time(char* out, size_t n, double t_ms)
+{
+    if (t_ms < 0) t_ms = 0;
+    const unsigned long long ds = (unsigned long long)(t_ms / 100.0);
+    snprintf(out, n, "[%02llu:%02llu:%02llu.%llu]", ds / 36000ull, ds / 600ull % 60ull, ds / 10ull % 60ull, ds % 10ull);
+}
+
+/* the writer's output buffer: one WriteFile per pass */
+static char   s_out[65536];
+static size_t s_outn;
+static void out_raw(const char* t, size_t n)
+{
+    if (s_outn + n > sizeof s_out) {
+        DWORD wr; if (s_fh != INVALID_HANDLE_VALUE) WriteFile(s_fh, s_out, (DWORD)s_outn, &wr, NULL);
+        s_outn = 0;
+        if (n > sizeof s_out) n = sizeof s_out;
+    }
+    memcpy(s_out + s_outn, t, n); s_outn += n;
+}
+static void out_flush(void)
+{
+    if (s_outn && s_fh != INVALID_HANDLE_VALUE) { DWORD wr; WriteFile(s_fh, s_out, (DWORD)s_outn, &wr, NULL); }
+    s_outn = 0;
+}
+PI_PRINTF(1, 2) static void outf(const char* fmt, ...)
+{
+    char b[1024];
+    va_list a; va_start(a, fmt);
+    int n = vsnprintf(b, sizeof b - 2, fmt, a);
+    va_end(a);
+    if (n < 0) return;
+    if (n > (int)sizeof b - 3) n = (int)sizeof b - 3;
+    b[n++] = '\r'; b[n++] = '\n';
+    out_raw(b, (size_t)n);
+}
+/* "[hh:mm:ss.d] KIND    text" */
+PI_PRINTF(3, 4) static void outl(double t, const char* kind, const char* fmt, ...)
+{
+    char ts[24], b[900];
+    fmt_time(ts, sizeof ts, t);
+    va_list a; va_start(a, fmt);
+    vsnprintf(b, sizeof b, fmt, a);
+    va_end(a);
+    outf("%s %-7s %s", ts, kind, b);
+}
+
+/* ------------------------------------------------------------------ context */
+
+static long sig_now(double* t)
+{
+    const long n = s_sig_n;
+    if (!n) { *t = 0; return -1; }
+    *t = s_sig[(n - 1) % PI_NSIG].t;
+    return n - 1;
+}
+
+static void ctx_text(char* out, size_t n, long sig, double sig_t, double t, int bg, int paused)
+{
+    char name[32] = "";
+    if (sig >= 0) {
+        if (s_crashing ? TryAcquireSRWLockShared(&s_lock) : (AcquireSRWLockShared(&s_lock), 1)) {
+            if (s_sig_n - sig <= PI_NSIG) memcpy(name, s_sig[sig % PI_NSIG].name, sizeof name);
+            ReleaseSRWLockShared(&s_lock);
+        }
+        name[sizeof name - 1] = 0;
+    }
+    size_t k = 0;
+    apf(out, n, &k, "%s", paused ? "game paused (menu open)" : "in game");
+    if (bg && k < n) apf(out, n, &k, ", window in the background");
+    if (name[0] && k < n) snprintf(out + k, n - k, "; last game event %s %.1f s before", name, (t - sig_t) / 1000.0);
+}
+
+static int window_is_ours(void)
+{
+    HWND f = GetForegroundWindow();
+    DWORD pid = 0;
+    if (f) GetWindowThreadProcessId(f, &pid);
+    return pid == GetCurrentProcessId();
+}
+
+/* ------------------------------------------------------------------ the render thread */
+
+static double median16(const double* r, unsigned n)
+{
+    double a[16];
+    memcpy(a, r, n * sizeof *a);
+    for (unsigned i = 1; i < n; i++) {
+        const double x = a[i]; unsigned j = i;
+        while (j && a[j - 1] > x) { a[j] = a[j - 1]; j--; }
+        a[j] = x;
+    }
+    return (n & 1) ? a[n / 2] : 0.5 * (a[n / 2 - 1] + a[n / 2]);
+}
+
+static double fps_target(void)
+{
+    static int env = -2; static opt_id id = -2;
+    if (env == -2) { const char* e = getenv("FPS_CAP"); env = e ? atoi(e) : -1; }
+    double v = env > 0 ? env : 0;
+    if (env < 0) { if (id == -2) id = opt_find("fps_cap"); v = id >= 0 ? opt_f(id) : 0; }
+    return v > 0 ? v : 30.0;              /* uncapped: the PS3's own 30 */
+}
+
+static int is_paused(void) { return options_intercepted(); }
+
+static void burst_close(void)
+{
+    if (!R.b_open) return;
+    pi_rec r; memset(&r, 0, sizeof r);
+    r.kind = R_BURST; r.t = R.b_t0; r.u.b = R.b;
+    q_push(&r);
+    R.b_open = 0;
+}
+
+static void slow_close(void)
+{
+    if (!R.slow) return;
+    pi_rec r; memset(&r, 0, sizeof r);
+    r.kind = R_SLOW; r.t = R.slow_t0;
+    r.u.s.dur_s = R.slow_sum / 1000.0;
+    r.u.s.avg_fps = R.slow_sum > 0 ? R.slow_n * 1000.0 / R.slow_sum : 0;
+    r.u.s.min_fps = R.slow_min; r.u.s.target = R.slow_target;
+    q_push(&r);
+    R.nslow++; R.slow_s += r.u.s.dur_s;
+    R.slow = 0;
+}
+
+static unsigned hist_bucket(double ms) { return ms >= PI_HB - 1 ? PI_HB - 1 : (unsigned)ms; }
+
+/* the frame time at or above which the slowest 1% of frames lie */
+static double hist_p99(const unsigned* h, unsigned n)
+{
+    if (!n) return 0;
+    unsigned want = n / 100 ? n / 100 : 1, acc = 0;
+    for (int b = PI_HB - 1; b >= 0; b--) { acc += h[b]; if (acc >= want) return b + 1.0; }
+    return 1.0;
+}
+
+static void minute_close(double t)
+{
+    if (!R.mn) { R.midx++; R.mt0 = t; return; }
+    pi_rec r; memset(&r, 0, sizeof r);
+    r.kind = R_MINUTE; r.t = t;
+    r.u.m.idx = ++R.midx; r.u.m.frames = R.mn;
+    r.u.m.avg_fps = R.msum > 0 ? R.mn * 1000.0 / R.msum : 0;
+    const double p99 = hist_p99(R.mh, R.mn);
+    r.u.m.low1_fps = p99 > 0 ? 1000.0 / p99 : 0;
+    r.u.m.worst = R.mworst; r.u.m.nst = R.mst; r.u.m.nhi = R.mhi; r.u.m.nfr = R.mfr;
+    q_push(&r);
+    memset(R.mh, 0, sizeof R.mh);
+    R.mn = R.mst = R.mhi = R.mfr = 0; R.msum = R.mworst = 0; R.mt0 = t;
+}
+
+void pi__frame_at(const pi_frame_info* f, double t);
+void pi__frame_at(const pi_frame_info* f, double t)
+{
+    if (!s_on) return;
+    const double iv = f->interval_ms;
+    R.last_t = t;
+    s_last_present_ms = t;
+    if (!R.frames++) {
+        pi_rec r; memset(&r, 0, sizeof r);
+        r.kind = R_FIRST; r.t = t; q_push(&r);
+        R.mt0 = R.wt0 = t;
+        return;                                  /* no interval yet */
+    }
+    /* parts of this frame, beyond what each part usually costs */
+    const double gpu = f->gpu_wait_ms, pres = f->present_ms, game = f->game_wait_ms;
+    double rend = f->render_ms - f->compile_ms - f->pipeline_ms - f->gpu_wait_ms;
+    if (rend < 0) rend = 0;
+    double rec = iv - f->render_ms - game - pres - f->pace_ms - f->readback_ms;
+    if (rec < 0) rec = 0;
+    const double raw[C_N] = { f->compile_ms, f->pipeline_ms, f->readback_ms, gpu, pres, game, rend, rec };
+
+    const double base = R.nr >= 4 ? median16(R.ring, R.nr) : iv;
+    int kind = 0;
+    if (R.warm >= 8 && iv >= 1.8 * base && iv - base >= 12.0)
+        kind = iv >= 500.0 ? 3 : iv >= 100.0 ? 2 : 1;
+    R.ring[R.nr < 16 ? R.nr++ : (R.frames % 16)] = iv;
+    if (R.warm < 8) R.warm++;
+
+    if (kind) {
+        if (R.b_open && (t - R.b.t1 > 1000.0 || t - R.b_t0 > 5000.0)) burst_close();
+        if (!R.b_open) {
+            memset(&R.b, 0, sizeof R.b);
+            R.b_open = 1; R.b_t0 = t - iv;
+            R.b.base = base;
+            R.b.sig = sig_now(&R.b.sig_t);
+            R.b.bg = !window_is_ours();
+            R.b.paused = is_paused();
+        }
+        pi_burst* b = &R.b;
+        b->t1 = t; b->n++;
+        if (iv > b->worst) b->worst = iv;
+        if (kind == 1) b->nst++; else if (kind == 2) b->nhi++; else b->nfr++;
+        for (int i = 0; i < C_N; i++) {
+            const double typ = (i == C_COMPILE || i == C_PIPELINE || i == C_READBACK) ? 0 : R.ema[i];
+            const double x = raw[i] - typ;
+            if (x > 0) b->c[i] += x;
+        }
+        b->compiles += f->compiles; b->pipelines += f->pipelines; b->readbacks += f->readbacks;
+        b->tex_up += f->tex_uploads; b->tex_new += f->tex_new; b->targets += f->new_targets;
+        b->tex_mb += f->tex_mb;
+        if (kind == 1) { R.mst++; R.nst++; } else if (kind == 2) { R.mhi++; R.nhi++; } else { R.mfr++; R.nfr++; }
+    } else {
+        for (int i = 0; i < C_N; i++) R.ema[i] += (raw[i] - R.ema[i]) * (1.0 / 16.0);
+        if (R.b_open && t - R.b.t1 > 1000.0) burst_close();
+    }
+
+    /* the minute, the session */
+    const unsigned hb = hist_bucket(iv);
+    R.mh[hb]++; R.sh[hb]++;
+    R.mn++; R.msum += iv; if (iv > R.mworst) R.mworst = iv;
+    R.ssum += iv; if (iv > R.sworst) R.sworst = iv;
+    if (t - R.mt0 >= 60000.0) minute_close(t);
+
+    /* 10-s windows below the target */
+    R.wn++; R.wsum += iv; R.wpaused += is_paused() ? 1u : 0u;
+    if (t - R.wt0 >= 10000.0) {
+        const double fps = R.wsum > 0 ? R.wn * 1000.0 / R.wsum : 0, tgt = fps_target();
+        const int low = R.wpaused * 2 < R.wn && fps < 0.9 * tgt;
+        if (low) {
+            if (!R.slow) { R.slow = 1; R.slow_t0 = R.wt0; R.slow_sum = 0; R.slow_n = 0; R.slow_min = fps; R.slow_target = tgt; }
+            R.slow_sum += R.wsum; R.slow_n += R.wn;
+            if (fps < R.slow_min) R.slow_min = fps;
+        } else slow_close();
+        R.wt0 = t; R.wn = 0; R.wsum = 0; R.wpaused = 0;
+    }
+}
+
+void pi_frame(const pi_frame_info* f)
+{
+    if (!s_on) return;
+    pi__frame_at(f, now_ms());
+}
+
+/* ------------------------------------------------------------------ any thread */
+
+void pi_signal(const char* name)
+{
+    if (!s_on || !name) return;
+    const double t = now_ms();
+    AcquireSRWLockExclusive(&s_lock);
+    const long n = s_sig_n;
+    snprintf(s_sig[n % PI_NSIG].name, sizeof s_sig[0].name, "%s", name);
+    s_sig[n % PI_NSIG].t = t;
+    s_sig_n = n + 1;
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+void pi_note(const char* fmt, ...)
+{
+    if (!s_on) return;
+    pi_rec r; memset(&r, 0, sizeof r);
+    r.kind = R_NOTE; r.t = now_ms();
+    va_list a; va_start(a, fmt);
+    vsnprintf(r.text, sizeof r.text, fmt, a);
+    va_end(a);
+    q_push(&r);
+    if (s_wake) SetEvent(s_wake);
+}
+
+static void shot_path(char* out, size_t n, int k)
+{
+    snprintf(out, n, "%s", s_path);
+    char* e = strstr(out, "-issues.txt");
+    if (!e) e = out + strlen(out);
+    snprintf(e, n - (size_t)(e - out), "-mark%d.png", k);
+}
+
+void pi_set_mark_hook(void (*hook)(int, const char*)) { s_mark_hook = hook; }
+
+int pi_mark(void)
+{
+    if (!s_on) return 0;
+    const int k = (int)InterlockedIncrement(&s_marks);
+    pi_rec r; memset(&r, 0, sizeof r);
+    r.kind = R_MARK; r.t = now_ms();
+    r.u.k.n = k; r.u.k.sig = sig_now(&r.u.k.sig_t);
+    q_push(&r);
+    if (s_mark_hook) {
+        char p[MAX_PATH + 16];
+        shot_path(p, sizeof p, k);
+        s_mark_hook(k, p);
+    }
+    if (s_wake) SetEvent(s_wake);
+    return k;
+}
+
+/* ------------------------------------------------------------------ the log */
+
+static const char* const k_err[] = { "error", "fail", "fatal", "crash", "exception", "assert", "abort", "panic",
+    "corrupt", "unhandled", "violation", "deadlock", "device removed", "device_removed", "out of memory", NULL };
+static const char* const k_warn[] = { "warn", "unimplemented", "not implemented", "unsupported", "rejected",
+    "refused", "timed out", "missing", "invalid", "mismatch", "cannot", "can't", "could not", "couldn't",
+    "overflow", "underrun", "dropped", "not found", "stuck", NULL };
+/* lines that match a word above and are known to be harmless */
+static const char* const k_benign[] = { "[sema]", "[spu-pic]", "caches dropped", "prewarm done", "'unknown')",
+    "(offline mode)", "ugc_message", "download_manifest", "[frametrace]", "[issues]", NULL };
+
+/* the word at p (length n) counts: not "0 failed", "no error", "errors=0" */
+static int word_counts(const char* line, const char* p, size_t n)
+{
+    if (p - line >= 2 && p[-1] == ' ' && p[-2] == '0' && (p - line == 2 || p[-3] < '0' || p[-3] > '9')) return 0;
+    if (p - line >= 3 && !memcmp(p - 3, "no ", 3)) return 0;
+    const char* e = p + n;
+    while ((*e >= 'a' && *e <= 'z') || *e == '_') e++;
+    if (*e == '=' || *e == ':') {
+        e++;
+        while (*e == ' ') e++;
+        if (e[0] == '0' && !(e[1] >= '0' && e[1] <= '9') && e[1] != 'x') return 0;
+    }
+    return 1;
+}
+
+int pi__classify(const char* line);
+int pi__classify(const char* line)
+{
+    char lo[320];
+    size_t n = 0;
+    for (; line[n] && n < sizeof lo - 1; n++) {
+        char c = line[n];
+        lo[n] = (c >= 'A' && c <= 'Z') ? (char)(c - 'A' + 'a') : c;
+    }
+    lo[n] = 0;
+    for (int i = 0; k_benign[i]; i++) if (strstr(lo, k_benign[i])) return 0;
+    for (int lvl = 2; lvl >= 1; lvl--) {
+        const char* const* w = lvl == 2 ? k_err : k_warn;
+        for (int i = 0; w[i]; i++)
+            for (const char* p = strstr(lo, w[i]); p; p = strstr(p + 1, w[i]))
+                if (word_counts(lo, p, strlen(w[i]))) return lvl;
+    }
+    return 0;
+}
+
+static unsigned long long norm_hash(const char* s)
+{
+    unsigned long long h = 1469598103934665603ull;
+    int in_num = 0;
+    for (; *s; s++) {
+        char c = *s;
+        const int digit = c >= '0' && c <= '9';
+        const int hexl = (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
+        if (digit || (in_num && (hexl || c == 'x'))) { if (!in_num) { h = (h ^ '#') * 1099511628211ull; in_num = 1; } continue; }
+        in_num = 0;
+        h = (h ^ (unsigned char)c) * 1099511628211ull;
+    }
+    return h;
+}
+
+static void log_line(char* line, double t)
+{
+    const int lvl = pi__classify(line);
+    if (!lvl) return;
+    if (lvl == 2) { W.nerr++; W.m_err++; } else { W.nwarn++; W.m_warn++; }
+    const unsigned long long h = norm_hash(line);
+    unsigned i = (unsigned)(h % 512u);
+    for (unsigned k = 0; k < 512; k++, i = (i + 1) % 512u) {
+        if (W.tab[i].h == h && W.tab[i].count) { W.tab[i].count++; return; }
+        if (!W.tab[i].count) break;
+    }
+    if (W.tab[i].count || W.nuniq >= 300) { W.hidden++; return; }
+    W.nuniq++;
+    W.tab[i].h = h; W.tab[i].count = 1; W.tab[i].level = lvl; W.tab[i].t = t;
+    scrub(line, 1024);
+    snprintf(W.tab[i].text, sizeof W.tab[i].text, "%s", line);
+    outl(t, lvl == 2 ? "LOG-ERR" : "LOG", "%s", W.tab[i].text);
+}
+
+void pi__log_text(const char* data, size_t n, double t);
+void pi__log_text(const char* data, size_t n, double t)
+{
+    for (size_t i = 0; i < n; i++) {
+        const char c = data[i];
+        if (c == '\n' || W.ncarry >= sizeof W.carry - 1) {
+            W.carry[W.ncarry] = 0;
+            if (W.ncarry && W.carry[W.ncarry - 1] == '\r') W.carry[W.ncarry - 1] = 0;
+            char line[1024];
+            snprintf(line, sizeof line, "%s", W.carry);
+            log_line(line, t);
+            W.ncarry = 0;
+            if (c == '\n') continue;
+        }
+        W.carry[W.ncarry++] = c;
+    }
+}
+
+static void log_poll(double t)
+{
+    if (!s_log_path[0]) return;
+    if (!W.lf || W.lf == INVALID_HANDLE_VALUE) {
+        W.lf = CreateFileA(s_log_path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                           NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (W.lf == INVALID_HANDLE_VALUE) return;
+    }
+    LARGE_INTEGER sz;
+    if (!GetFileSizeEx(W.lf, &sz) || sz.QuadPart <= W.loff) return;
+    static char buf[262144];
+    LONG64 want = sz.QuadPart - W.loff;
+    if (want > (LONG64)sizeof buf) {               /* more than 256 KB in 2 s: a log flood costs frames itself */
+        outl(t, "WARN", "the log grew by %.1f MB in 2 s -- that much logging can cost frame rate by itself",
+             (double)want / 1048576.0);
+        W.loff = sz.QuadPart - (LONG64)sizeof buf;
+        W.ncarry = 0;
+        want = sizeof buf;
+    }
+    LARGE_INTEGER o; o.QuadPart = W.loff;
+    SetFilePointerEx(W.lf, o, NULL, FILE_BEGIN);
+    DWORD got = 0;
+    if (!ReadFile(W.lf, buf, (DWORD)want, &got, NULL) || !got) return;
+    W.loff += got;
+    pi__log_text(buf, got, t);
+}
+
+/* ------------------------------------------------------------------ the header */
+
+static void utf8_of(const WCHAR* w, char* out, int n)
+{
+    if (!WideCharToMultiByte(CP_UTF8, 0, w, -1, out, n, NULL, NULL)) out[0] = 0;
+}
+
+static void cpu_text(char* out, size_t n)
+{
+    int r[4]; char brand[49] = "";
+    __cpuid(r, (int)0x80000000);
+    if ((unsigned)r[0] >= 0x80000004u) {
+        for (int i = 0; i < 3; i++) { __cpuid(r, (int)(0x80000002u + (unsigned)i)); memcpy(brand + 16 * i, r, 16); }
+        brand[48] = 0;
+    }
+    char* b = brand; while (*b == ' ') b++;
+    for (size_t k = strlen(b); k && b[k - 1] == ' '; k--) b[k - 1] = 0;
+    unsigned cores = 0, effc = 0; int hybrid = 0, cls0 = -1;
+    DWORD len = 0;
+    GetLogicalProcessorInformationEx(RelationProcessorCore, NULL, &len);
+    char* buf = len ? (char*)malloc(len) : NULL;
+    if (buf && GetLogicalProcessorInformationEx(RelationProcessorCore, (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX)buf, &len)) {
+        for (DWORD off = 0; off < len; ) {
+            PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX e = (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX)(buf + off);
+            cores++;
+            const int cls = e->Processor.EfficiencyClass;
+            if (cls0 < 0) cls0 = cls; else if (cls != cls0) hybrid = 1;
+            if (cls == 0) effc++;
+            off += e->Size;
+        }
+    }
+    free(buf);
+    const DWORD threads = GetActiveProcessorCount(ALL_PROCESSOR_GROUPS);
+    if (hybrid) snprintf(out, n, "%s (%u cores: %u performance + %u efficiency, %lu threads)", b[0] ? b : "unknown CPU",
+                         cores, cores - effc, effc, (unsigned long)threads);
+    else snprintf(out, n, "%s (%u cores, %lu threads)", b[0] ? b : "unknown CPU", cores, (unsigned long)threads);
+}
+
+static void os_text(char* out, size_t n)
+{
+    typedef LONG (WINAPI *rgv_fn)(PRTL_OSVERSIONINFOW);
+    RTL_OSVERSIONINFOW v; memset(&v, 0, sizeof v); v.dwOSVersionInfoSize = sizeof v;
+    rgv_fn f = (rgv_fn)(void*)GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "RtlGetVersion");
+    if (f && f(&v) == 0)
+        snprintf(out, n, "Windows %s (%lu.%lu.%lu)", (v.dwMajorVersion == 10 && v.dwBuildNumber >= 22000) ? "11" :
+                 v.dwMajorVersion == 10 ? "10" : "", (unsigned long)v.dwMajorVersion, (unsigned long)v.dwMinorVersion,
+                 (unsigned long)v.dwBuildNumber);
+    else snprintf(out, n, "Windows (version unknown)");
+}
+
+static void gpu_text(char* out, size_t n)
+{
+    if (!s_adapter) { snprintf(out, n, "unknown (the renderer did not report it)"); return; }
+    DXGI_ADAPTER_DESC d; memset(&d, 0, sizeof d);
+    char name[160];
+    if (FAILED(IDXGIAdapter_GetDesc(s_adapter, &d))) { snprintf(out, n, "unknown"); return; }
+    utf8_of(d.Description, name, sizeof name);
+    LARGE_INTEGER umd; umd.QuadPart = 0;
+    char drv[48] = "driver unknown";
+    if (SUCCEEDED(IDXGIAdapter_CheckInterfaceSupport(s_adapter, &IID_IDXGIDevice, &umd)))
+        snprintf(drv, sizeof drv, "driver %u.%u.%u.%u", (unsigned)HIWORD(umd.HighPart), (unsigned)LOWORD(umd.HighPart),
+                 (unsigned)HIWORD(umd.LowPart), (unsigned)LOWORD(umd.LowPart));
+    snprintf(out, n, "%s (%.1f GB video memory, %s)", name, (double)d.DedicatedVideoMemory / 1073741824.0, drv);
+}
+
+static void display_text(char* out, size_t n)
+{
+    DEVMODEW dm; memset(&dm, 0, sizeof dm); dm.dmSize = sizeof dm;
+    if (EnumDisplaySettingsW(NULL, ENUM_CURRENT_SETTINGS, &dm))
+        snprintf(out, n, "%lux%lu at %lu Hz (the main monitor)", (unsigned long)dm.dmPelsWidth,
+                 (unsigned long)dm.dmPelsHeight, (unsigned long)dm.dmDisplayFrequency);
+    else snprintf(out, n, "unknown");
+}
+
+static void settings_lines(void)
+{
+    /* "settings  key=value, key=value, ..." in lines of about 100 columns */
+    const int n = opt_count();
+    char line[256]; size_t k = 0; int lines = 0;
+    line[0] = 0;
+    for (int i = 0; i < n; i++) {
+        const opt_def* d = opt_def_of(i);
+        if (!d || opt_is_default(i)) continue;
+        char v[96]; opt_text(i, v, sizeof v);
+        scrub(v, sizeof v);
+        char item[200]; snprintf(item, sizeof item, "%s=%s", d->key, v);
+        if (k && k + strlen(item) + 2 > 88) { outf("%-9s %s,", lines++ ? "" : "settings", line); k = 0; line[0] = 0; }
+        apf(line, sizeof line, &k, "%s%s", k ? ", " : "", item);
+    }
+    if (k) outf("%-9s %s", lines++ ? "" : "settings", line);
+    if (!lines) outf("settings  all at their defaults");
+}
+
+static void snap_settings(void)
+{
+    const int n = opt_count();
+    if (!W.snap) { W.snap = (char (*)[72])calloc(256, sizeof *W.snap); if (!W.snap) return; }
+    W.nsnap = n < 256 ? n : 256;
+    for (int i = 0; i < W.nsnap; i++) opt_text(i, W.snap[i], sizeof W.snap[i]);
+    W.gen = opt_generation();
+}
+
+static void write_header(void)
+{
+    char t[256];
+    outf("inFamous 2 (ps3recomp) -- play session issues log");
+    outf("To report a problem, send this file. Pressing F8 while playing marks the moment (\"something looked wrong here\").");
+    outf("-------------------------------------------------------------------------------------------------");
+    outf("build     %s", s_build[0] ? s_build : "unknown");
+    SYSTEMTIME st; GetLocalTime(&st);
+    outf("started   %04u-%02u-%02u %02u:%02u (local time)", st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute);
+    cpu_text(t, sizeof t);     outf("cpu       %s", t);
+    MEMORYSTATUSEX ms; ms.dwLength = sizeof ms;
+    if (GlobalMemoryStatusEx(&ms))
+        outf("memory    %.0f GB (%.1f GB free at start)", (double)ms.ullTotalPhys / 1073741824.0,
+             (double)ms.ullAvailPhys / 1073741824.0);
+    gpu_text(t, sizeof t);     outf("gpu       %s", t);
+    os_text(t, sizeof t);      outf("os        %s", t);
+    display_text(t, sizeof t); outf("display   %s", t);
+    SYSTEM_POWER_STATUS ps;
+    if (GetSystemPowerStatus(&ps) && ps.BatteryFlag != 128 && ps.BatteryFlag != 255)
+        outf("power     %s", ps.ACLineStatus == 0 ? "ON BATTERY -- laptops slow down on battery" : "plugged in");
+    settings_lines();
+    snap_settings();
+    outf("-------------------------------------------------------------------------------------------------");
+    outf("Times are since the game started. STUTTER / HITCH / FREEZE: frames that took too long (under 0.1 s /");
+    outf("under 0.5 s / longer), with what they spent the time on. SLOW: stretches under the frame-rate target.");
+    outf("STALL: no new frame for seconds. MINUTE: each minute's frame rate. LOG: a problem line from the game's");
+    outf("log. MARK: F8 was pressed. CRASH: the game crashed. END: the session's summary.");
+    outf("-------------------------------------------------------------------------------------------------");
+    W.header_done = 1;
+}
+
+/* ------------------------------------------------------------------ formatting the queue */
+
+static int burst_cause(const pi_burst* b, char* out, size_t n)
+{
+    double excess = (b->worst - b->base) * (b->n ? 1.0 : 0.0);
+    double tot = 0; for (int i = 0; i < C_N; i++) tot += b->c[i];
+    if (excess < tot) excess = tot;
+    int order[C_N]; for (int i = 0; i < C_N; i++) order[i] = i;
+    for (int i = 1; i < C_N; i++) { int x = order[i], j = i; while (j && b->c[order[j - 1]] < b->c[x]) { order[j] = order[j - 1]; j--; } order[j] = x; }
+    size_t k = 0; int shown = 0;
+    out[0] = 0;
+    for (int r = 0; r < C_N && shown < 3; r++) {
+        const int i = order[r];
+        if (b->c[i] < 4.0 || b->c[i] < 0.15 * excess) break;
+        const unsigned cnt = i == C_COMPILE ? b->compiles : i == C_PIPELINE ? b->pipelines : i == C_READBACK ? b->readbacks : 0;
+        if (cnt) apf(out, n, &k, "%s%s %u (%.0f ms)", shown ? ", " : "", k_cname[i], cnt, b->c[i]);
+        else     apf(out, n, &k, "%s%s %.0f ms", shown ? ", " : "", k_cname[i], b->c[i]);
+        shown++;
+    }
+    if ((b->tex_mb >= 4.0 || b->tex_new >= 4) && k < n)
+        apf(out, n, &k, "%stexture uploads %u (%.1f MB, %u new)", shown ? ", " : "", b->tex_up, b->tex_mb, b->tex_new);
+    if (b->targets && k < n) apf(out, n, &k, "%s%u new render targets", (shown || b->tex_mb >= 4.0) ? ", " : "", b->targets);
+    /* the category the summary counts it under */
+    const int top = order[0];
+    /* uploads are not timed on their own (light trace): a render-thread frame that uploaded a lot is theirs */
+    if (top == C_RENDER && (b->tex_mb >= 8.0 || b->tex_new >= 8) && b->c[top] >= 0.3 * excess) return C_N;
+    if (b->c[top] >= 0.3 * excess && b->c[top] >= 4.0) return top;
+    if (b->tex_mb >= 8.0 || b->tex_new >= 8) return C_N;           /* texture streaming */
+    if (!shown && k < n) snprintf(out + k, n - k, "%snot in any measured part (Windows, another program, or the game's own threads)",
+                                  k ? "; otherwise " : "");
+    return C_N + 1;                                                /* unexplained */
+}
+
+static const char* cause_key(int c) { return c < C_N ? k_ckey[c] : c == C_N ? "texture" : "unexplained"; }
+static const char* cause_name(int c) { return c < C_N ? k_cname[c] : c == C_N ? "texture streaming" : "unexplained"; }
+
+static void sample_minute(char* out, size_t n)
+{
+    size_t k = 0;
+    FILETIME c0, e0, kt, ut, now;
+    GetSystemTimeAsFileTime(&now);
+    if (GetProcessTimes(GetCurrentProcess(), &c0, &e0, &kt, &ut)) {
+        const ULONG64 cpu = ((ULONG64)kt.dwHighDateTime << 32 | kt.dwLowDateTime) + ((ULONG64)ut.dwHighDateTime << 32 | ut.dwLowDateTime);
+        const ULONG64 wall = (ULONG64)now.dwHighDateTime << 32 | now.dwLowDateTime;
+        if (W.wall_last && wall > W.wall_last) {
+            const double pct = 100.0 * (double)(cpu - W.cpu_last) / ((double)(wall - W.wall_last) * GetActiveProcessorCount(ALL_PROCESSOR_GROUPS));
+            apf(out, n, &k, " | cpu %.0f%%", pct);
+        }
+        W.cpu_last = cpu; W.wall_last = wall;
+    }
+    MEMORYSTATUSEX ms; ms.dwLength = sizeof ms;
+    PROCESS_MEMORY_COUNTERS_EX pm; memset(&pm, 0, sizeof pm); pm.cb = sizeof pm;
+    const int have_pm = K32GetProcessMemoryInfo(GetCurrentProcess(), (PROCESS_MEMORY_COUNTERS*)&pm, sizeof pm);
+    if (GlobalMemoryStatusEx(&ms) && k < n) {
+        apf(out, n, &k, " | ram %.1f GB used by the game, %.1f GB free",
+                              have_pm ? (double)pm.PrivateUsage / 1073741824.0 : 0.0, (double)ms.ullAvailPhys / 1073741824.0);
+        if (ms.ullAvailPhys < ms.ullTotalPhys / 12 && R.last_t >= W.next_mem_note) {
+            W.next_mem_note = R.last_t + 600000.0;
+            pi_note("low on system memory (%.1f of %.0f GB free): Windows may page the game out -- expect stutter",
+                    (double)ms.ullAvailPhys / 1073741824.0, (double)ms.ullTotalPhys / 1073741824.0);
+        }
+    }
+    if (s_adapter3 && k < n) {
+        DXGI_QUERY_VIDEO_MEMORY_INFO vi;
+        if (SUCCEEDED(IDXGIAdapter3_QueryVideoMemoryInfo(s_adapter3, 0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &vi))) {
+            apf(out, n, &k, " | vram %.1f of %.1f GB budget", (double)vi.CurrentUsage / 1073741824.0,
+                                  (double)vi.Budget / 1073741824.0);
+            if (vi.CurrentUsage > vi.Budget && R.last_t >= W.next_mem_note) {
+                W.next_mem_note = R.last_t + 600000.0;
+                pi_note("video memory over budget (%.1f of %.1f GB): textures get paged -- expect stutter; a lower "
+                        "resolution scale or texture setting helps", (double)vi.CurrentUsage / 1073741824.0,
+                        (double)vi.Budget / 1073741824.0);
+            }
+        }
+    }
+}
+
+static void write_rec(const pi_rec* r)
+{
+    char ctx[200], cause[400];
+    switch (r->kind) {
+    case R_FIRST:
+        outl(r->t, "INFO", "first frame on screen");
+        break;
+    case R_BURST: {
+        const pi_burst* b = &r->u.b;
+        const int c = burst_cause(b, cause, sizeof cause);
+        W.cause_n[c]++;
+        ctx_text(ctx, sizeof ctx, b->sig, b->sig_t, r->t, b->bg, b->paused);
+        const char* kind = b->nfr ? "FREEZE" : b->nhi ? "HITCH" : "STUTTER";
+        if (b->n == 1)
+            outl(r->t, kind, "%.0f ms frame (normal %.0f ms) -- %s | %s {cause=%s worst=%.0f n=1 base=%.1f}",
+                 b->worst, b->base, cause, ctx, cause_key(c), b->worst, b->base);
+        else
+            outl(r->t, kind, "%u slow frames in %.1f s, worst %.0f ms (normal %.0f ms) -- %s | %s {cause=%s worst=%.0f n=%u base=%.1f}",
+                 b->n, (b->t1 - r->t) / 1000.0, b->worst, b->base, cause, ctx, cause_key(c), b->worst, b->n, b->base);
+        break;
+    }
+    case R_MINUTE: {
+        char smp[200]; smp[0] = 0;
+        sample_minute(smp, sizeof smp);
+        char lg[64] = "";
+        if (W.m_err || W.m_warn) snprintf(lg, sizeof lg, " | log +%u errors +%u warnings", W.m_err, W.m_warn);
+        W.m_err = W.m_warn = 0;
+        outl(r->t, "MINUTE", "%d: %.1f fps, 1%% low %.1f, worst %.0f ms, %u stutters %u hitches %u freezes%s%s",
+             r->u.m.idx, r->u.m.avg_fps, r->u.m.low1_fps, r->u.m.worst, r->u.m.nst, r->u.m.nhi, r->u.m.nfr, smp, lg);
+        break;
+    }
+    case R_SLOW:
+        outl(r->t, "SLOW", "%.0f s under the %.0f fps target: %.1f fps on average, %.1f at the lowest {dur=%.0f avg=%.1f target=%.0f}",
+             r->u.s.dur_s, r->u.s.target, r->u.s.avg_fps, r->u.s.min_fps, r->u.s.dur_s, r->u.s.avg_fps, r->u.s.target);
+        break;
+    case R_NOTE: {
+        char t[sizeof r->text];
+        memcpy(t, r->text, sizeof t);
+        scrub(t, sizeof t);
+        outl(r->t, "NOTE", "%s", t);
+        break;
+    }
+    case R_MARK: {
+        char p[MAX_PATH + 16];
+        shot_path(p, sizeof p, r->u.k.n);
+        const char* b = strrchr(p, '\\');
+        ctx_text(ctx, sizeof ctx, r->u.k.sig, r->u.k.sig_t, r->t, 0, 0);
+        outl(r->t, "MARK", "#%d: F8 pressed%s%s | %s", r->u.k.n, s_mark_hook ? " -- screenshot " : "",
+             s_mark_hook ? (b ? b + 1 : p) : "", ctx);
+        break;
+    }
+    }
+}
+
+static void drain(void)
+{
+    static pi_rec batch[64];
+    for (;;) {
+        unsigned n = 0, drop;
+        AcquireSRWLockExclusive(&s_lock);
+        while (s_qh != s_qt && n < 64) batch[n++] = s_q[s_qh++ % PI_QN];
+        drop = s_qdrop; s_qdrop = 0;
+        ReleaseSRWLockExclusive(&s_lock);
+        if (drop) outf("(%u entries were dropped: this log's writer fell behind)", drop);
+        for (unsigned i = 0; i < n; i++) write_rec(&batch[i]);
+        if (n < 64) break;
+    }
+}
+
+static void stall_check(double t)
+{
+    const double last = s_last_present_ms;
+    if (last <= 0) return;                         /* no frame yet: the boot */
+    if (last != W.stall_seen) { W.stall_seen = last; W.stall_lvl = 0; return; }
+    const double gap = t - last;
+    char ctx[200];
+    double st; const long sig = sig_now(&st);
+    if (gap >= 15000.0 && W.stall_lvl < 2) {
+        W.stall_lvl = 2;
+        ctx_text(ctx, sizeof ctx, sig, st, t, !window_is_ours(), is_paused());
+        outl(t, "STALL", "still no new frame after %.0f s -- the game may have frozen | %s {gap=%.0f}", gap / 1000.0, ctx, gap);
+    } else if (gap >= 3000.0 && W.stall_lvl < 1) {
+        W.stall_lvl = 1;
+        ctx_text(ctx, sizeof ctx, sig, st, t, !window_is_ours(), is_paused());
+        outl(t, "STALL", "no new frame for %.0f s so far | %s {gap=%.0f}", gap / 1000.0, ctx, gap);
+    }
+}
+
+static void settings_check(double t)
+{
+    if (!W.snap || opt_generation() == W.gen) return;
+    W.gen = opt_generation();
+    const int n = opt_count() < 256 ? opt_count() : 256;
+    for (int i = 0; i < n; i++) {
+        char v[72]; opt_text(i, v, sizeof v);
+        if (i < W.nsnap && !strcmp(v, W.snap[i])) continue;
+        const opt_def* d = opt_def_of(i);
+        char a[72], b[72];
+        snprintf(a, sizeof a, "%s", i < W.nsnap ? W.snap[i] : "");
+        snprintf(b, sizeof b, "%s", v);
+        scrub(a, sizeof a); scrub(b, sizeof b);
+        if (d) outl(t, "SETTING", "%s: %s -> %s", d->key, a, b);
+        memcpy(W.snap[i], v, sizeof W.snap[i]);
+    }
+    if (n > W.nsnap) W.nsnap = n;
+}
+
+void pi__pump(double t);
+void pi__pump(double t)
+{
+    if (!W.header_done) write_header();
+    drain();
+    log_poll(t);
+    stall_check(t);
+    settings_check(t);
+    out_flush();
+}
+
+static DWORD WINAPI writer_main(LPVOID p)
+{
+    (void)p;
+    /* lowest CPU, I/O and memory priority; efficiency cores (EcoQoS) where the CPU has them */
+    SetThreadPriority(GetCurrentThread(), THREAD_MODE_BACKGROUND_BEGIN);
+    {
+        typedef BOOL (WINAPI *sti_fn)(HANDLE, int, LPVOID, DWORD);
+        typedef HRESULT (WINAPI *std_fn)(HANDLE, PCWSTR);
+        HMODULE k = GetModuleHandleW(L"kernel32.dll");
+        sti_fn sti = (sti_fn)(void*)GetProcAddress(k, "SetThreadInformation");
+        struct { ULONG version, control, state; } eco = { 1, 1, 1 };      /* THREAD_POWER_THROTTLING_EXECUTION_SPEED */
+        if (sti) sti(GetCurrentThread(), 3 /* ThreadPowerThrottling */, &eco, sizeof eco);
+        std_fn sd = (std_fn)(void*)GetProcAddress(k, "SetThreadDescription");
+        if (sd) sd(GetCurrentThread(), L"play issues log");
+    }
+    WaitForSingleObject(s_gpu_ev, 8000);           /* the header names the GPU */
+    while (!s_ending) {
+        pi__pump(now_ms());
+        WaitForSingleObject(s_wake, 2000);
+    }
+    pi__pump(now_ms());
+    return 0;
+}
+
+/* ------------------------------------------------------------------ crashes */
+
+static char s_cbuf[4096];
+static void crash_write(const char* kind_text, const EXCEPTION_RECORD* er)
+{
+    if (s_fh == INVALID_HANDLE_VALUE) return;
+    size_t k = 0;
+    char ts[24]; fmt_time(ts, sizeof ts, now_ms());
+    apf(s_cbuf, sizeof s_cbuf, &k, "%s CRASH   %s", ts, kind_text);
+    if (er) {
+        HMODULE m = NULL; WCHAR wn[MAX_PATH]; char mn[MAX_PATH] = "?";
+        if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                               (LPCWSTR)er->ExceptionAddress, &m) && GetModuleFileNameW(m, wn, MAX_PATH)) {
+            const WCHAR* b = wcsrchr(wn, L'\\');
+            utf8_of(b ? b + 1 : wn, mn, sizeof mn);
+        }
+        apf(s_cbuf, sizeof s_cbuf, &k, " (0x%08lX) at %s+0x%llX", (unsigned long)er->ExceptionCode, mn,
+                              (unsigned long long)((ULONG_PTR)er->ExceptionAddress - (ULONG_PTR)m));
+        if (er->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && er->NumberParameters >= 2)
+            apf(s_cbuf, sizeof s_cbuf, &k, ", %s 0x%llX",
+                                  er->ExceptionInformation[0] == 1 ? "writing" : er->ExceptionInformation[0] == 8 ? "executing" : "reading",
+                                  (unsigned long long)er->ExceptionInformation[1]);
+    }
+    apf(s_cbuf, sizeof s_cbuf, &k, ", thread %lu\r\n", (unsigned long)GetCurrentThreadId());
+    char ctx[200]; double st; const long sig = sig_now(&st);
+    ctx_text(ctx, sizeof ctx, sig, st, now_ms(), 0, 0);
+    apf(s_cbuf, sizeof s_cbuf, &k, "             %s\r\n", ctx);
+    DWORD wr; WriteFile(s_fh, s_cbuf, (DWORD)k, &wr, NULL);
+}
+
+static void crash_dump(EXCEPTION_POINTERS* ep)
+{
+    typedef BOOL (WINAPI *mdw_fn)(HANDLE, DWORD, HANDLE, int, void*, void*, void*);
+    if (!s_dbghelp) return;
+    mdw_fn mdw = (mdw_fn)(void*)GetProcAddress(s_dbghelp, "MiniDumpWriteDump");
+    if (!mdw) return;
+    char p[MAX_PATH + 16];
+    snprintf(p, sizeof p, "%s", s_path);
+    char* e = strstr(p, "-issues.txt"); if (!e) e = p + strlen(p);
+    snprintf(e, sizeof p - (size_t)(e - p), "-crash.dmp");
+    HANDLE f = CreateFileA(p, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE) return;
+    struct { DWORD tid; EXCEPTION_POINTERS* ep; BOOL client; } mei = { GetCurrentThreadId(), ep, FALSE };
+    const int type = 0x00000000 /* Normal */ | 0x00001000 /* WithThreadInfo */ | 0x00000020 /* WithUnloadedModules */;
+    const BOOL ok = mdw(GetCurrentProcess(), GetCurrentProcessId(), f, type, ep ? &mei : NULL, NULL, NULL);
+    CloseHandle(f);
+    const char* b = strrchr(p, '\\');
+    size_t k = 0;
+    apf(s_cbuf, sizeof s_cbuf, &k, "             %s %s\r\n", ok ? "minidump:" : "no minidump (write failed):", b ? b + 1 : p);
+    DWORD wr; WriteFile(s_fh, s_cbuf, (DWORD)k, &wr, NULL);
+}
+
+static LONG WINAPI crash_filter(EXCEPTION_POINTERS* ep)
+{
+    static volatile long once;
+    if (s_on && !InterlockedExchange(&once, 1)) {
+        s_crashing = 1;
+        crash_write("the game crashed:", ep ? ep->ExceptionRecord : NULL);
+        crash_dump(ep);
+    }
+    return s_prev_filter ? s_prev_filter(ep) : EXCEPTION_CONTINUE_SEARCH;
+}
+
+static void on_abort(int sig)
+{
+    (void)sig;
+    static volatile long once;
+    if (s_on && !InterlockedExchange(&once, 1)) crash_write("the game stopped itself (abort)", NULL);
+    signal(SIGABRT, SIG_DFL);
+}
+
+/* ------------------------------------------------------------------ start / end */
+
+static void scrub_init(void)
+{
+    GetCurrentDirectoryA(sizeof s_root, s_root);
+    const char* e;
+    if ((e = getenv("USERPROFILE"))) snprintf(s_profile, sizeof s_profile, "%s", e);
+    if ((e = getenv("USERNAME")))    snprintf(s_user, sizeof s_user, "%s", e);
+    if ((e = getenv("COMPUTERNAME"))) snprintf(s_pc, sizeof s_pc, "%s", e);
+}
+
+static int open_file(const char* path)
+{
+    snprintf(s_path, sizeof s_path, "%s", path);
+    HANDLE h = CreateFileA(path, GENERIC_WRITE, FILE_SHARE_READ, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h == INVALID_HANDLE_VALUE) return 0;
+    CloseHandle(h);
+    s_fh = CreateFileA(path, FILE_APPEND_DATA | SYNCHRONIZE, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,
+                       FILE_ATTRIBUTE_NORMAL, NULL);
+    return s_fh != INVALID_HANDLE_VALUE;
+}
+
+static void pi_atexit(void) { pi_end("the game exited"); }
+
+int pi_start(const char* path, const char* build)
+{
+    if (s_on || s_ended || !path || !*path) return 0;
+    QueryPerformanceFrequency(&s_qf); QueryPerformanceCounter(&s_q0);
+    if (!open_file(path)) return 0;
+    snprintf(s_build, sizeof s_build, "%s", build ? build : "");
+    scrub_init();
+    s_wake = CreateEventW(NULL, FALSE, FALSE, NULL);
+    if (!s_gpu_ev) s_gpu_ev = CreateEventW(NULL, TRUE, s_adapter ? TRUE : FALSE, NULL);
+    s_dbghelp = LoadLibraryExW(L"dbghelp.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    s_on = 1;
+    s_prev_filter = SetUnhandledExceptionFilter(crash_filter);
+    signal(SIGABRT, on_abort);
+    atexit(pi_atexit);
+    s_thread = CreateThread(NULL, 64 * 1024, writer_main, NULL, STACK_SIZE_PARAM_IS_A_RESERVATION, NULL);
+    fprintf(stderr, "[issues] play session problems -> %s\n", path);
+    return 1;
+}
+
+int pi__test_start(const char* path, const char* root, const char* profile, const char* user, const char* pc);
+int pi__test_start(const char* path, const char* root, const char* profile, const char* user, const char* pc)
+{
+    QueryPerformanceFrequency(&s_qf); QueryPerformanceCounter(&s_q0);
+    if (!open_file(path)) return 0;
+    snprintf(s_build, sizeof s_build, "test");
+    snprintf(s_root, sizeof s_root, "%s", root); snprintf(s_profile, sizeof s_profile, "%s", profile);
+    snprintf(s_user, sizeof s_user, "%s", user); snprintf(s_pc, sizeof s_pc, "%s", pc);
+    s_on = 1;                                      /* no writer thread: the test pumps */
+    return 1;
+}
+
+int pi_active(void) { return s_on != 0; }
+
+void pi_set_log(const char* path)
+{
+    if (path) snprintf(s_log_path, sizeof s_log_path, "%s", path);
+}
+
+void pi_set_adapter(void* a)
+{
+    if (!a || s_adapter) return;
+    IUnknown* u = (IUnknown*)a;
+    if (FAILED(IUnknown_QueryInterface(u, &IID_IDXGIAdapter, (void**)&s_adapter))) { s_adapter = NULL; return; }
+    if (FAILED(IUnknown_QueryInterface(u, &IID_IDXGIAdapter3, (void**)&s_adapter3))) s_adapter3 = NULL;
+    if (!s_gpu_ev) s_gpu_ev = CreateEventW(NULL, TRUE, TRUE, NULL);
+    else SetEvent(s_gpu_ev);
+}
+
+static void hms(char* out, size_t n, double ms)
+{
+    const unsigned long long s = (unsigned long long)(ms / 1000.0);
+    if (s >= 3600) snprintf(out, n, "%llu h %02llu min", s / 3600, s / 60 % 60);
+    else snprintf(out, n, "%llu min %02llu s", s / 60, s % 60);
+}
+
+void pi_end(const char* how)
+{
+    if (!s_on || InterlockedExchange(&s_ended, 1)) return;
+    const double t = now_ms();
+    burst_close();
+    slow_close();
+    s_ending = 1;
+    if (s_thread) {                                /* the writer's last pass, then the summary here */
+        SetEvent(s_wake);
+        WaitForSingleObject(s_thread, 3000);
+    }
+    if (!W.header_done) write_header();
+    drain();
+    log_poll(t);
+    char d[48]; hms(d, sizeof d, t);
+    outl(t, "END", "%s, after %s", how ? how : "session ended", d);
+    const unsigned long long fr = R.frames > 1 ? R.frames - 1 : 0;
+    const double p99 = hist_p99(R.sh, (unsigned)(fr > 0xFFFFFFFFull ? 0xFFFFFFFFull : fr));
+    outf("             frames %llu, average %.1f fps, 1%% low %.1f fps, worst frame %.0f ms", fr,
+         R.ssum > 0 ? (double)fr * 1000.0 / R.ssum : 0.0, p99 > 0 ? 1000.0 / p99 : 0.0, R.sworst);
+    outf("             stutters %u, hitches %u, freezes %u, slow stretches %u (%.0f s), marks %ld", R.nst, R.nhi, R.nfr,
+         R.nslow, R.slow_s, s_marks);
+    {
+        char c[400]; size_t k = 0; c[0] = 0;
+        for (int i = 0; i < C_N + 2; i++)
+            if (W.cause_n[i]) apf(c, sizeof c, &k, "%s%s %u", k ? ", " : "", cause_name(i), W.cause_n[i]);
+        if (k) outf("             slow frames by cause: %s", c);
+    }
+    outf("             log: %u error lines, %u warning lines (%u kinds%s)", W.nerr, W.nwarn, W.nuniq,
+         W.hidden ? ", more not listed" : "");
+    /* the most repeated log problems */
+    for (int shown = 0; shown < 10; shown++) {
+        int best = -1;
+        for (int i = 0; i < 512; i++)
+            if (W.tab[i].count > 1 && (best < 0 || W.tab[i].count > W.tab[best].count)) best = i;
+        if (best < 0) break;
+        outf("             x%-6u %s", W.tab[best].count, W.tab[best].text);
+        W.tab[best].count = 1;
+    }
+    out_flush();
+    s_on = 0;
+    if (s_fh != INVALID_HANDLE_VALUE) { CloseHandle(s_fh); s_fh = INVALID_HANDLE_VALUE; }
+}
+
+#else  /* !_WIN32: not yet -- the hooks compile to nothing */
+int  pi_start(const char* path, const char* build) { (void)path; (void)build; return 0; }
+int  pi_active(void) { return 0; }
+void pi_set_log(const char* path) { (void)path; }
+void pi_set_adapter(void* a) { (void)a; }
+void pi_frame(const pi_frame_info* f) { (void)f; }
+void pi_signal(const char* name) { (void)name; }
+void pi_note(const char* fmt, ...) { (void)fmt; }
+int  pi_mark(void) { return 0; }
+void pi_set_mark_hook(void (*hook)(int, const char*)) { (void)hook; }
+void pi_end(const char* how) { (void)how; }
+#endif
diff --git a/runtime/diag/tests/test_play_issues.c b/runtime/diag/tests/test_play_issues.c
new file mode 100644
index 0000000..96b069c
--- /dev/null
+++ b/runtime/diag/tests/test_play_issues.c
@@ -0,0 +1,207 @@
+/*
+ * Host test for runtime/diag/play_issues.c: synthetic frames, log lines, signals and marks go in, the
+ * issues file comes out. No window, no GPU, no settings store (stubbed below), no writer thread (the
+ * test pumps it with its own clock).
+ *
+ *   clang-cl /std:c17 -I<ps3recomp>/include tests/test_play_issues.c play_issues.c user32.lib
+ */
+#include "ps3emu/play_issues.h"
+#include "ps3emu/options.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+
+/* the module's test entry points */
+int  pi__test_start(const char* path, const char* root, const char* profile, const char* user, const char* pc);
+void pi__frame_at(const pi_frame_info* f, double t);
+void pi__pump(double t);
+int  pi__classify(const char* line);
+void pi__log_text(const char* data, size_t n, double t);
+
+/* ---- settings store stubs: two rows, one changed from its default */
+static opt_def s_defs[2] = { { .key = "fps_cap" }, { .key = "texture_pack_dir" } };
+static char s_val[2][72] = { "0", "C:\\Users\\alice\\packs" };
+static unsigned s_gen = 1;
+int opt_count(void) { return 2; }
+const opt_def* opt_def_of(opt_id id) { return id >= 0 && id < 2 ? &s_defs[id] : NULL; }
+int opt_is_default(opt_id id) { return id == 0 && !strcmp(s_val[0], "0"); }
+int opt_text(opt_id id, char* buf, size_t n) { snprintf(buf, n, "%s", s_val[id]); return (int)strlen(buf); }
+unsigned opt_generation(void) { return s_gen; }
+opt_id opt_find(const char* key) { return strcmp(key, "fps_cap") ? -1 : 0; }
+double opt_f(opt_id id) { return atof(s_val[id]); }
+void options_set_intercepted(int on) { (void)on; }
+int options_intercepted(void) { return 0; }
+
+static int s_fail;
+#define CHECK(c, ...) do { if (!(c)) { printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); s_fail++; } } while (0)
+
+static double T;
+static void frame(double iv, const pi_frame_info* extra)
+{
+    pi_frame_info f;
+    if (extra) f = *extra; else memset(&f, 0, sizeof f);
+    f.interval_ms = iv;
+    if (!extra) { f.render_ms = 4; f.game_wait_ms = iv * 0.6; f.present_ms = 1; }
+    T += iv;
+    pi__frame_at(&f, T);
+}
+static void steady(double secs, double iv)
+{
+    for (double s = 0; s < secs * 1000.0; s += iv) frame(iv, NULL);
+}
+
+static char* slurp(const char* p)
+{
+    FILE* f = fopen(p, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
+    char* b = (char*)malloc((size_t)n + 1);
+    if (fread(b, 1, (size_t)n, f) != (size_t)n) n = 0;
+    b[n] = 0; fclose(f);
+    return b;
+}
+static const char* line_with(const char* text, const char* a, const char* b)
+{
+    for (const char* l = text; l && *l; ) {
+        const char* e = strchr(l, '\n');
+        size_t n = e ? (size_t)(e - l) : strlen(l);
+        char tmp[2048]; if (n >= sizeof tmp) n = sizeof tmp - 1;
+        memcpy(tmp, l, n); tmp[n] = 0;
+        if (strstr(tmp, a) && (!b || strstr(tmp, b))) return l;
+        l = e ? e + 1 : NULL;
+    }
+    return NULL;
+}
+static int count_lines(const char* text, const char* a)
+{
+    int c = 0;
+    for (const char* p = strstr(text, a); p; p = strstr(p + 1, a)) c++;
+    return c;
+}
+
+int main(int argc, char** argv)
+{
+    char path[512];
+    snprintf(path, sizeof path, "%s\\pi_test-issues.txt", argc > 1 ? argv[1] : ".");
+
+    /* ---- classification, before anything is started */
+    CHECK(pi__classify("[fs] open FAILED: x") == 2, "open FAILED is an error");
+    CHECK(pi__classify("[d3d12] Device removed: 0x887A0005") == 2, "device removed");
+    CHECK(pi__classify("[mfc] REJECTED malformed transfer") == 1, "rejected is a warning");
+    CHECK(pi__classify("[SEMA] 12 waits satisfied, 3 timed out") == 0, "SEMA stats are benign");
+    CHECK(pi__classify("[ss] census: 0 failed, 12 ok") == 0, "0 failed");
+    CHECK(pi__classify("[gcm] flip ok error=0") == 0, "error=0");
+    CHECK(pi__classify("[x] no error so far") == 0, "no error");
+    CHECK(pi__classify("[x] error=0x80004005") == 2, "error=0x... is an error");
+    CHECK(pi__classify("[x] 10 failed") == 2, "10 failed (not 0)");
+    CHECK(pi__classify("[cellNetCtl] GetState() -> error NOT_INITIALIZED (offline mode)") == 0, "offline mode benign");
+    CHECK(pi__classify("[gcm] fps_cap 60: flips paced to 16.667 ms") == 0, "plain line");
+
+    CHECK(pi__test_start(path, "C:\\Game\\Root", "C:\\Users\\alice", "alice", "ALICE-PC"), "start");
+    pi__pump(0);                                   /* the header */
+
+    /* ---- 20 s steady at 25 ms, then one compile hitch */
+    frame(0, NULL);                                /* the first present: no interval */
+    steady(20, 25);
+    pi_signal("PackLoaded");
+    { pi_frame_info f; memset(&f, 0, sizeof f);
+      f.render_ms = 95; f.compile_ms = 90; f.compiles = 3; f.game_wait_ms = 15; f.present_ms = 1;
+      frame(120, &f); }
+    steady(2, 25);
+    pi__pump(T);
+
+    /* ---- a burst: four 60 ms frames within a second, the game thread late */
+    for (int i = 0; i < 4; i++) {
+        pi_frame_info f; memset(&f, 0, sizeof f);
+        f.render_ms = 4; f.game_wait_ms = 50; f.present_ms = 1;
+        frame(60, &f);
+        frame(25, NULL); frame(25, NULL);
+    }
+    steady(2, 25);
+
+    /* ---- a freeze in none of the timed parts: the render thread's other work (or Windows) */
+    { pi_frame_info f; memset(&f, 0, sizeof f); f.render_ms = 4; f.game_wait_ms = 15; frame(700, &f); }
+    steady(2, 25);
+    /* ---- texture streaming */
+    { pi_frame_info f; memset(&f, 0, sizeof f); f.render_ms = 60; f.game_wait_ms = 15; f.present_ms = 1;
+      f.tex_uploads = 40; f.tex_new = 30; f.tex_mb = 48; frame(90, &f); }
+    steady(40, 25);                                /* past the first minute */
+    pi__pump(T);
+
+    /* ---- 30 s at 20 fps (under the 30 fps default target), then back */
+    steady(30, 50);
+    steady(25, 25);
+    pi__pump(T);
+
+    /* ---- log lines: classification, scrubbing, de-duplication */
+    const char* log =
+        "[fs] open FAILED: C:\\Game\\Root\\game\\disc\\missing.pak\r\n"
+        "[x] wrote C:/Users/alice/AppData/x.txt: error 5\r\n"
+        "[mfc] REJECTED malformed transfer: img=7 pc=0x1c cmd=0x40\r\n"
+        "[mfc] REJECTED malformed transfer: img=9 pc=0x2c cmd=0x41\r\n"
+        "[mfc] REJECTED malformed transfer: img=11 pc=0x3c cmd=0x42\r\n"
+        "[SEMA] 1 waits satisfied, 1 timed out\r\n"
+        "[pc] host ALICE-PC failed to resolve\r\n"
+        "[part";                                    /* an unfinished line waits for its end */
+    pi__log_text(log, strlen(log), T);
+    pi__log_text("ial] warning: half\n", 19, T);
+    pi_note("a note about C:\\Users\\alice\\Documents\\x");
+    CHECK(pi_mark() == 1, "first mark");
+    pi__pump(T);
+
+    /* ---- frames stop: a stall after 3 s, a freeze warning after 15 s */
+    const double last = T;
+    pi__pump(last + 500);                          /* sees the last present */
+    pi__pump(last + 4000);
+    pi__pump(last + 16000);
+
+    /* ---- a settings change */
+    snprintf(s_val[0], sizeof s_val[0], "60"); s_gen++;
+    pi__pump(last + 17000);
+    pi_end("test done");
+
+    char* out = slurp(path);
+    CHECK(out != NULL, "read %s", path);
+    if (!out) return 1;
+    printf("%s\n", out);
+
+    CHECK(strstr(out, "play session issues log") != NULL, "header");
+    CHECK(line_with(out, "settings ", "texture_pack_dir=%USERPROFILE%\\packs") != NULL, "settings line, scrubbed");
+    CHECK(line_with(out, "HITCH", "cause=shader-compile") != NULL, "compile hitch");
+    CHECK(line_with(out, "HITCH", "shader compiles 3") != NULL, "compile count");
+    CHECK(line_with(out, "HITCH", "PackLoaded") != NULL, "hitch context: last signal");
+    CHECK(line_with(out, "STUTTER", "4 slow frames") != NULL, "one line for the burst");
+    CHECK(line_with(out, "STUTTER", "cause=game") != NULL, "burst cause: game thread");
+    CHECK(line_with(out, "FREEZE", "cause=record") != NULL, "freeze outside the timed parts");
+    CHECK(line_with(out, "HITCH", "cause=texture") != NULL || line_with(out, "STUTTER", "cause=texture") != NULL ||
+          line_with(out, "texture uploads 40", NULL) != NULL, "texture streaming");
+    CHECK(line_with(out, "MINUTE", "1:") != NULL, "minute line");
+    CHECK(line_with(out, "SLOW", "under the 30 fps target") != NULL, "slow stretch");
+    CHECK(line_with(out, "LOG-ERR", ".\\game\\disc\\missing.pak") != NULL, "root path scrubbed");
+    CHECK(line_with(out, "LOG-ERR", "%USERPROFILE%/AppData") != NULL || line_with(out, "LOG-ERR", "%USERPROFILE%") != NULL, "profile scrubbed");
+    CHECK(count_lines(out, "REJECTED malformed") == 2, "one LOG line for three similar lines, plus the repeat count at END (%d)",
+          count_lines(out, "REJECTED malformed"));
+    CHECK(line_with(out, "x3", "REJECTED") != NULL, "repeat count");
+    CHECK(strstr(out, "[SEMA]") == NULL, "benign line skipped");
+    CHECK(line_with(out, "LOG", "<pc> failed") != NULL, "computer name scrubbed");
+    CHECK(line_with(out, "LOG", "[partial] warning: half") != NULL, "a line split across reads");
+    CHECK(line_with(out, "NOTE", "%USERPROFILE%\\Documents") != NULL, "note scrubbed");
+    CHECK(line_with(out, "MARK", "#1") != NULL, "mark");
+    CHECK(line_with(out, "STALL", "no new frame for") != NULL, "stall");
+    CHECK(line_with(out, "STALL", "may have frozen") != NULL, "long stall");
+    CHECK(line_with(out, "SETTING", "fps_cap: 0 -> 60") != NULL, "settings change");
+    CHECK(line_with(out, "END", "test done") != NULL, "end");
+    CHECK(line_with(out, "slow frames by cause", "shader compiles") != NULL, "summary causes");
+    CHECK(line_with(out, "frames ", "average") != NULL, "summary frames");
+    {
+        char low[65536]; size_t i = 0;
+        for (; out[i] && i < sizeof low - 1; i++) low[i] = (char)tolower((unsigned char)out[i]);
+        low[i] = 0;
+        CHECK(strstr(low, "alice") == NULL, "no user name anywhere");
+    }
+    free(out);
+    printf(s_fail ? "%d FAILED\n" : "all passed\n", s_fail);
+    return s_fail ? 1 : 0;
+}
diff --git a/runtime/platform/chain_trace.h b/runtime/platform/chain_trace.h
new file mode 100644
index 0000000..97e8641
--- /dev/null
+++ b/runtime/platform/chain_trace.h
@@ -0,0 +1,45 @@
+/*
+ * chain_trace.h -- the walker's side of CHAIN_TRACE (runtime/syscalls/sys_timer.c;
+ * NOTES 2026-10-27, PF1): the frame's PPU -> RSX -> SPU chain, one CSV row per
+ * main-thread kicker wait.
+ *
+ * The RSX walker (rsx_commands.c, cellGcmSys.c, rsx_d3d12_backend.c) stamps its
+ * readback, the back-end label after it, its present and its idle waits through
+ * this block, which sys_timer.c fills when CHAIN_TRACE is set. Header only: the
+ * block is a __declspec(selectany) definition (as guest_clock.h), so any file can
+ * include this without linking sys_timer.c (unit tests that build one file stay
+ * unchanged); with nothing installed every stamp is one load. Windows only.
+ */
+#ifndef PS3RECOMP_CHAIN_TRACE_H
+#define PS3RECOMP_CHAIN_TRACE_H
+
+#ifdef _WIN32
+#  ifdef __cplusplus
+extern "C" {
+#  endif
+typedef struct {
+    volatile int on;                     /* > 0: recording (set after the hooks) */
+    void (*note)(int kind);              /* 1 readback begin, 2 readback end, 3 a back-end label, 4 a present */
+    void (*idle)(int kind, double ms);   /* the walker's idle wait: 0 a semaphore acquire, 1 put, 2 other */
+} ps3_chain_hooks;
+__declspec(selectany) ps3_chain_hooks g_ps3_chain = { 0, 0, 0 };
+#  ifdef __cplusplus
+}
+#  endif
+
+static __inline int ps3_chain_on(void) { return g_ps3_chain.on > 0; }
+static __inline void ps3_chain_stamp(int kind)
+{
