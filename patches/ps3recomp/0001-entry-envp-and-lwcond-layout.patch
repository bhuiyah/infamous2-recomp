diff --git a/libs/system/opt_ini.h b/libs/system/opt_ini.h
new file mode 100644
index 0000000..672808c
--- /dev/null
+++ b/libs/system/opt_ini.h
@@ -0,0 +1,428 @@
+/*
+ * ps3recomp - comment-preserving editor for the project's "name = value" ini
+ * files (display.ini, input.ini, options.ini). OS-free and header-only, so the
+ * unit test (libs/system/tests/test_options_store.c) needs nothing else.
+ *
+ * Lexical rules are the ones display_cfg.h and pad_kbm.h already use: text
+ * after '#' or ';' is a comment, "[section]" lines, names compare ignoring
+ * case, spaces, '_' and '-'.
+ *
+ * ini_set() changes ONE key and leaves every other byte of the file alone:
+ *   1. an active line "key = v"            -> the value is replaced in place
+ *      (leading blanks, the name as written, the blanks around '=' and a
+ *      trailing comment keep their bytes; the comment keeps its column when
+ *      the new value fits). With several active lines the LAST one is edited
+ *      (the parsers keep the last value of a repeated key).
+ *   2. else a commented default "# key = d" -> uncommented and set (the "# "
+ *      goes; the line's own trailing comment stays)
+ *   3. else inserted after the last non-blank line of [section] (the section
+ *      is created at the end of the file when it is missing)
+ * With a section name, only lines inside that section count (options.ini);
+ * with NULL, every line does (display.ini / input.ini, whose parsers ignore
+ * sections).
+ * ini_reset() puts a key back the way the shipped files show defaults: each
+ * active line becomes "# key = <default>" again.
+ * Line endings: the file's own (CRLF if its first line ends in CRLF).
+ * ini_text_decode()/ini_text_encode() convert UTF-8 (with or without BOM) and
+ * UTF-16 LE/BE (with BOM, what PowerShell 5's '>' writes) to and from UTF-8
+ * losslessly, so every file round-trips byte for byte.
+ */
+#ifndef PS3RECOMP_OPT_INI_H
+#define PS3RECOMP_OPT_INI_H
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct { char* p; size_t n, cap; } ini_buf;
+
+static inline void ini_buf_put(ini_buf* b, const char* s, size_t n)
+{
+    if (b->n + n + 1 > b->cap) {
+        size_t c = b->cap ? b->cap : 256;
+        while (c < b->n + n + 1) c *= 2;
+        char* np = (char*)realloc(b->p, c);
+        if (!np) return;                     /* out of memory: the edit is dropped */
+        b->p = np;
+        b->cap = c;
+    }
+    if (n) memcpy(b->p + b->n, s, n);
+    b->n += n;
+    b->p[b->n] = 0;
+}
+static inline void ini_buf_puts(ini_buf* b, const char* s) { ini_buf_put(b, s, strlen(s)); }
+static inline void ini_buf_clear(ini_buf* b) { b->n = 0; ini_buf_put(b, "", 0); }
+static inline void ini_buf_free(ini_buf* b) { free(b->p); b->p = NULL; b->n = b->cap = 0; }
+
+static inline void ini_norm(const char* s, size_t n, char* out, size_t outn)
+{
+    size_t k = 0;
+    for (size_t i = 0; i < n && s[i] && k + 1 < outn; i++) {
+        char c = s[i];
+        if (c == ' ' || c == '\t' || c == '_' || c == '-') continue;
+        out[k++] = (char)tolower((unsigned char)c);
+    }
+    out[k] = 0;
+}
+
+/* One parsed line. All offsets index the line's own bytes (no EOL). */
+enum { INI_L_OTHER = 0, INI_L_SECTION = 1, INI_L_KEY = 2, INI_L_CKEY = 3 };
+typedef struct {
+    int kind;
+    size_t name_b, name_e;    /* name span */
+    size_t val_b, val_e;      /* value span (trimmed) */
+    size_t cmt_b;             /* end of the value before a trailing comment (== len: none) */
+    size_t hash_b, hash_e;    /* INI_L_CKEY: the "# " prefix to remove */
+    char norm[64];            /* normalised name, or section name */
+} ini_line;
+
+static inline int ini_is_name_ch(char c)
+{
+    return isalnum((unsigned char)c) || c == '_' || c == '-' || c == '.' || c == ':' || c == ' ' || c == '\t';
+}
+
+static inline void ini_parse_line(const char* s, size_t len, ini_line* L)
+{
+    memset(L, 0, sizeof *L);
+    L->cmt_b = len;
+    size_t i = 0;
+    while (i < len && (s[i] == ' ' || s[i] == '\t')) i++;
+    if (i < len && s[i] == '[') {
+        size_t e = i + 1;
+        while (e < len && s[e] != ']') e++;
+        L->kind = INI_L_SECTION;
+        ini_norm(s + i + 1, e - i - 1, L->norm, sizeof L->norm);
+        return;
+    }
+    int commented = 0;
+    size_t hb = i;
+    if (i < len && (s[i] == '#' || s[i] == ';')) {
+        /* "# key = value": one comment marker, then a name with no blanks
+         * inside it, then '='. Prose comments ("# Note: ...", "#   set X=1")
+         * fail the no-blank rule. */
+        commented = 1;
+        i++;
+        while (i < len && (s[i] == ' ' || s[i] == '\t')) i++;
+    }
+    size_t nb = i;
+    while (i < len && ini_is_name_ch(s[i])) i++;
+    size_t ne = i;
+    while (ne > nb && (s[ne - 1] == ' ' || s[ne - 1] == '\t')) ne--;
+    if (ne == nb || i >= len || s[i] != '=') return;
+    for (size_t k = nb; k < ne; k++) if (s[k] == ' ' || s[k] == '\t') return;
+    size_t vb = i + 1;
+    while (vb < len && (s[vb] == ' ' || s[vb] == '\t')) vb++;
+    size_t ve = vb;
+    while (ve < len && s[ve] != '#' && s[ve] != ';') ve++;
+    size_t hash = ve;                     /* where the trailing comment marker is (or len) */
+    while (ve > vb && (s[ve - 1] == ' ' || s[ve - 1] == '\t')) ve--;
+    L->kind = commented ? INI_L_CKEY : INI_L_KEY;
+    L->name_b = nb; L->name_e = ne; L->val_b = vb; L->val_e = ve;
+    L->cmt_b = hash < len ? ve : len;
+    L->hash_b = hb; L->hash_e = nb;
+    ini_norm(s + nb, ne - nb, L->norm, sizeof L->norm);
+}
+
+/* Next line: returns its successor; *len = bytes without EOL, *eol = EOL bytes. */
+static inline const char* ini_next_line(const char* p, const char* end, size_t* len, size_t* eol)
+{
+    const char* q = p;
+    while (q < end && *q != '\n' && *q != '\r') q++;
+    *len = (size_t)(q - p);
+    size_t e = 0;
+    if (q < end && *q == '\r') e++;
+    if (q + e < end && q[e] == '\n') e++;
+    *eol = e;
+    return q + e;
+}
+
+static inline const char* ini_detect_eol(const char* text)
+{
+    const char* r = strchr(text, '\n');
+    return (r && r > text && r[-1] == '\r') ? "\r\n" : "\n";
+}
+
+/* Is name (normalised) the key or one of its '|' separated aliases? */
+static inline int ini_name_is(const char* norm, const char* key_norm, const char* aliases)
+{
+    if (!strcmp(norm, key_norm)) return 1;
+    for (const char* p = aliases; p && *p; ) {
+        const char* e = strchr(p, '|');
+        size_t n = e ? (size_t)(e - p) : strlen(p);
+        char a[64];
+        ini_norm(p, n, a, sizeof a);
+        if (a[0] && !strcmp(norm, a)) return 1;
+        if (!e) break;
+        p = e + 1;
+    }
+    return 0;
+}
+
+/* The line with a new value (KEY or CKEY). uncomment: drop the "# ";
+ * add_hash: comment it out. */
+static inline void ini_emit_value(ini_buf* o, const char* s, size_t len, const ini_line* L,
+                                  const char* value, int uncomment, int add_hash)
+{
+    size_t from = 0;
+    if (uncomment) { ini_buf_put(o, s, L->hash_b); from = L->hash_e; }   /* keep indentation */
+    if (add_hash) {
+        size_t ind = 0;
+        while (ind < len && (s[ind] == ' ' || s[ind] == '\t')) ind++;
+        ini_buf_put(o, s, ind);
+        ini_buf_puts(o, "# ");
+        from = ind;
+    }
+    ini_buf_put(o, s + from, L->val_b - from);   /* name and " = " as written */
+    ini_buf_puts(o, value);
+    if (L->cmt_b < len) {
+        /* keep the trailing comment's column when the new value fits */
+        size_t gap = 0;
+        while (L->cmt_b + gap < len && (s[L->cmt_b + gap] == ' ' || s[L->cmt_b + gap] == '\t')) gap++;
+        size_t col = (L->cmt_b - L->val_b) + gap, w = strlen(value);
+        size_t pad = (w + 1 <= col) ? col - w : 1;
+        for (size_t k = 0; k < pad; k++) ini_buf_put(o, " ", 1);
+        ini_buf_put(o, s + L->cmt_b + gap, len - L->cmt_b - gap);
+    }
+}
+
+enum { INI_SET_UNCHANGED = 0, INI_SET_REPLACED = 1, INI_SET_UNCOMMENTED = 2, INI_SET_APPENDED = 3 };
+
+/* Set key to value in text (UTF-8, NUL-terminated). section: the section the
+ * key lives in ("display", no brackets), or NULL for a file whose sections do
+ * not matter. aliases ('|' separated, or NULL): other spellings a line may use
+ * -- the active line ini_get would read is edited (else the first commented
+ * one is uncommented), keeping its name. Returns the INI_SET_* action; *out
+ * receives the whole new text. */
+static inline int ini_set_a(const char* text, const char* section, const char* key, const char* aliases,
+                            const char* value, ini_buf* out)
+{
+    char want[64], sec[64];
+    ini_norm(key, strlen(key), want, sizeof want);
+    if (section) ini_norm(section, strlen(section), sec, sizeof sec); else sec[0] = 0;
+    const char* end = text + strlen(text);
+    const char* nl = ini_detect_eol(text);
+
+    long active_ln = -1, cmt_ln = -1, sec_last_ln = -1;
+    int in_sec = section ? (sec[0] == 0) : 1;   /* lines before any header: section "" */
+    long ln = 0;
+    for (const char* p = text; p < end; ln++) {
+        size_t len, eol;
+        const char* nx = ini_next_line(p, end, &len, &eol);
+        ini_line L;
+        ini_parse_line(p, len, &L);
+        int blank = 1;
+        for (size_t k = 0; k < len; k++) if (p[k] != ' ' && p[k] != '\t') { blank = 0; break; }
+        if (L.kind == INI_L_SECTION) {
+            in_sec = section ? !strcmp(L.norm, sec) : 1;
+            if (section && in_sec) sec_last_ln = ln;
+        } else if (in_sec) {
+            if (section && !blank) sec_last_ln = ln;
+            if (L.kind == INI_L_KEY && ini_name_is(L.norm, want, aliases)) active_ln = ln;
+            else if (L.kind == INI_L_CKEY && ini_name_is(L.norm, want, aliases) && cmt_ln < 0) cmt_ln = ln;
+        }
+        p = nx;
+    }
+
+    int action = -1;
+    ini_buf_clear(out);
+    ln = 0;
+    for (const char* p = text; p < end; ln++) {
+        size_t len, eol;
+        const char* nx = ini_next_line(p, end, &len, &eol);
+        ini_line L;
+        ini_parse_line(p, len, &L);
+        if (ln == active_ln) {
+            size_t w = strlen(value);
+            action = ((size_t)(L.val_e - L.val_b) == w && !memcmp(p + L.val_b, value, w))
+                     ? INI_SET_UNCHANGED : INI_SET_REPLACED;
+            ini_emit_value(out, p, len, &L, value, 0, 0);
+            ini_buf_put(out, p + len, eol);
+        } else if (active_ln < 0 && ln == cmt_ln) {
+            action = INI_SET_UNCOMMENTED;
+            ini_emit_value(out, p, len, &L, value, 1, 0);
+            ini_buf_put(out, p + len, eol);
+        } else {
+            ini_buf_put(out, p, len + eol);
+            if (active_ln < 0 && cmt_ln < 0 && ln == sec_last_ln) {
+                if (!eol) ini_buf_puts(out, nl);
+                ini_buf_puts(out, key); ini_buf_puts(out, " = "); ini_buf_puts(out, value);
+                ini_buf_puts(out, nl);
+                action = INI_SET_APPENDED;
+            }
+        }
+        p = nx;
+    }
+    if (action < 0) {                          /* no line, no section: append */
+        if (out->n && out->p[out->n - 1] != '\n') ini_buf_puts(out, nl);
+        if (section && sec[0]) {
+            if (out->n) ini_buf_puts(out, nl);
+            ini_buf_puts(out, "["); ini_buf_puts(out, section); ini_buf_puts(out, "]"); ini_buf_puts(out, nl);
+        }
+        ini_buf_puts(out, key); ini_buf_puts(out, " = "); ini_buf_puts(out, value); ini_buf_puts(out, nl);
+        action = INI_SET_APPENDED;
+    }
+    return action;
+}
+
+static inline int ini_set(const char* text, const char* section, const char* key, const char* value,
+                          ini_buf* out)
+{
+    return ini_set_a(text, section, key, NULL, value, out);
+}
+
+/* Back to the built-in default: every active line of key or one of its
+ * aliases (in section, or anywhere when NULL) becomes the commented default
+ * "# <name as written> = dflt". Returns the lines changed. */
+static inline int ini_reset_a(const char* text, const char* section, const char* key, const char* aliases,
+                              const char* dflt, ini_buf* out)
+{
+    char want[64], sec[64];
+    ini_norm(key, strlen(key), want, sizeof want);
+    if (section) ini_norm(section, strlen(section), sec, sizeof sec); else sec[0] = 0;
+    const char* end = text + strlen(text);
+    int changed = 0, in_sec = section ? (sec[0] == 0) : 1;
+    ini_buf_clear(out);
+    for (const char* p = text; p < end; ) {
+        size_t len, eol;
+        const char* nx = ini_next_line(p, end, &len, &eol);
+        ini_line L;
+        ini_parse_line(p, len, &L);
+        if (L.kind == INI_L_SECTION) in_sec = section ? !strcmp(L.norm, sec) : 1;
+        if (in_sec && L.kind == INI_L_KEY && ini_name_is(L.norm, want, aliases)) {
+            ini_emit_value(out, p, len, &L, dflt, 0, 1);
+            ini_buf_put(out, p + len, eol);
+            changed++;
+        } else {
+            ini_buf_put(out, p, len + eol);
+        }
+        p = nx;
+    }
+    return changed;
+}
+
+static inline int ini_reset(const char* text, const char* section, const char* key, const char* dflt,
+                            ini_buf* out)
+{
+    return ini_reset_a(text, section, key, NULL, dflt, out);
+}
+
+/* The value of the last active line of key (or an alias) -- in section, or
+ * anywhere when section is NULL, as the parsers read it; copies at most n-1
+ * bytes. Returns its 1-based line number, 0 if absent. */
+static inline int ini_get(const char* text, const char* section, const char* key, const char* aliases,
+                          char* val, size_t n)
+{
+    char want[64], sec[64];
+    ini_norm(key, strlen(key), want, sizeof want);
+    if (section) ini_norm(section, strlen(section), sec, sizeof sec); else sec[0] = 0;
+    const char* end = text + strlen(text);
+    int found = 0, ln = 0, in_sec = section ? (sec[0] == 0) : 1;
+    for (const char* p = text; p < end; ) {
+        size_t len, eol;
+        const char* nx = ini_next_line(p, end, &len, &eol);
+        ini_line L;
+        ini_parse_line(p, len, &L);
+        ln++;
+        if (L.kind == INI_L_SECTION) in_sec = section ? !strcmp(L.norm, sec) : 1;
+        else if (in_sec && L.kind == INI_L_KEY && ini_name_is(L.norm, want, aliases)) {
+            size_t w = L.val_e - L.val_b;
+            if (n) {
+                if (w >= n) w = n - 1;
+                memcpy(val, p + L.val_b, w);
+                val[w] = 0;
+            }
+            found = ln;
+        }
+        p = nx;
+    }
+    return found;
+}
+
+/* The lines of the sections keep(section_norm) accepts, section headers
+ * included, into out (lines before any header count as section ""). */
+static inline void ini_section_lines(const char* text, int (*keep)(const char* sec_norm), ini_buf* out)
+{
+    const char* end = text + strlen(text);
+    int in = keep("");
+    ini_buf_clear(out);
+    for (const char* p = text; p < end; ) {
+        size_t len, eol;
+        const char* nx = ini_next_line(p, end, &len, &eol);
+        ini_line L;
+        ini_parse_line(p, len, &L);
+        if (L.kind == INI_L_SECTION) in = keep(L.norm);
+        if (in) { ini_buf_put(out, p, len); ini_buf_puts(out, "\n"); }
+        p = nx;
+    }
+}
+
+/* ---- encodings ---------------------------------------------------------- */
+enum { INI_ENC_UTF8 = 0, INI_ENC_UTF8_BOM = 1, INI_ENC_UTF16LE = 2, INI_ENC_UTF16BE = 3 };
+
+static inline void ini_put_utf8(ini_buf* o, unsigned cp)
+{
+    char b[4]; size_t n;
+    if (cp < 0x80) { b[0] = (char)cp; n = 1; }
+    else if (cp < 0x800) { b[0] = (char)(0xC0 | (cp >> 6)); b[1] = (char)(0x80 | (cp & 0x3F)); n = 2; }
+    else if (cp < 0x10000) { b[0] = (char)(0xE0 | (cp >> 12)); b[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
+                             b[2] = (char)(0x80 | (cp & 0x3F)); n = 3; }
+    else { b[0] = (char)(0xF0 | (cp >> 18)); b[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
+           b[2] = (char)(0x80 | ((cp >> 6) & 0x3F)); b[3] = (char)(0x80 | (cp & 0x3F)); n = 4; }
+    ini_buf_put(o, b, n);
+}
+
+/* Raw file bytes -> UTF-8 text; returns the encoding found. */
+static inline int ini_text_decode(const unsigned char* u, size_t n, ini_buf* out)
+{
+    ini_buf_clear(out);
+    if (n >= 3 && u[0] == 0xEF && u[1] == 0xBB && u[2] == 0xBF) {
+        ini_buf_put(out, (const char*)u + 3, n - 3); return INI_ENC_UTF8_BOM;
+    }
+    if (n >= 2 && ((u[0] == 0xFF && u[1] == 0xFE) || (u[0] == 0xFE && u[1] == 0xFF))) {
+        int le = u[0] == 0xFF;
+        for (size_t i = 2; i + 1 < n; i += 2) {
+            unsigned c = le ? (unsigned)(u[i] | (u[i + 1] << 8)) : (unsigned)((u[i] << 8) | u[i + 1]);
+            if (c >= 0xD800 && c < 0xDC00 && i + 3 < n) {
+                unsigned d = le ? (unsigned)(u[i + 2] | (u[i + 3] << 8)) : (unsigned)((u[i + 2] << 8) | u[i + 3]);
+                if (d >= 0xDC00 && d < 0xE000) { c = 0x10000 + ((c - 0xD800) << 10) + (d - 0xDC00); i += 2; }
+            }
+            if (!c) break;
+            ini_put_utf8(out, c);
+        }
+        return le ? INI_ENC_UTF16LE : INI_ENC_UTF16BE;
+    }
+    for (size_t i = 0; i < n && u[i]; i++) ini_buf_put(out, (const char*)u + i, 1);
+    return INI_ENC_UTF8;
+}
+
+/* UTF-8 text -> file bytes in the given encoding (with its BOM). */
+static inline void ini_text_encode(const char* s, int enc, ini_buf* out)
+{
+    ini_buf_clear(out);
+    if (enc == INI_ENC_UTF8 || enc == INI_ENC_UTF8_BOM) {
+        if (enc == INI_ENC_UTF8_BOM) ini_buf_put(out, "\xEF\xBB\xBF", 3);
+        ini_buf_puts(out, s);
+        return;
+    }
+    int le = enc == INI_ENC_UTF16LE;
+    ini_buf_put(out, le ? "\xFF\xFE" : "\xFE\xFF", 2);
+    const unsigned char* p = (const unsigned char*)s;
+    while (*p) {
+        unsigned c = *p++;
+        if (c >= 0xF0 && p[0] && p[1] && p[2]) { c = ((c & 7) << 18) | ((p[0] & 0x3F) << 12) | ((p[1] & 0x3F) << 6) | (p[2] & 0x3F); p += 3; }
+        else if (c >= 0xE0 && p[0] && p[1]) { c = ((c & 15) << 12) | ((p[0] & 0x3F) << 6) | (p[1] & 0x3F); p += 2; }
+        else if (c >= 0xC0 && p[0]) { c = ((c & 31) << 6) | (p[0] & 0x3F); p += 1; }
+        unsigned units[2]; int nu = 1;
+        if (c >= 0x10000) { c -= 0x10000; units[0] = 0xD800 + (c >> 10); units[1] = 0xDC00 + (c & 0x3FF); nu = 2; }
+        else units[0] = c;
+        for (int k = 0; k < nu; k++) {
+            char b[2];
+            b[le ? 0 : 1] = (char)(units[k] & 0xFF);
+            b[le ? 1 : 0] = (char)(units[k] >> 8);
+            ini_buf_put(out, b, 2);
+        }
+    }
+}
+
+#endif /* PS3RECOMP_OPT_INI_H */
