+/* ---------------------------------------------------------------------------
+ * A save-state load (SPUC, whose ops are in lv2_register.c): this file's part
+ *
+ * A capture reads each context's engine without claiming one. A load's
+ * teardown frees every slot and the overflow engine: the contexts that held
+ * them are gone. Its restore claims an engine for each context whose engine
+ * the image had, with the tags it had -- a list parked at a stall-and-notify
+ * keeps its tag incomplete -- and that is the engine the context's next DMA
+ * finds, not a second claim; a context the image had no engine for gets none.
+ * And the decrementer: re-anchored to read the saved value now and count down
+ * from it at the timebase rate, or held as written when it was never armed.
+ * -----------------------------------------------------------------------*/
+static void test_load_rules(spu_context* const* held, int nheld, spu_context* ninth)
+{
+    uint32_t tags = 0, queued = 0, armed = 0;
+
+    /* (the table as main left it: full, the ninth context on the overflow engine) */
+    CHECK(spu_channels_ss_mfc(held[0], &tags, &queued) >= 0);
+    CHECK(spu_channels_ss_mfc(ninth, &tags, &queued) == -2);
+
+    spu_channels_ss_teardown();
+    int none = 1;
+    for (int i = 0; i < nheld; i++)
+        none &= spu_channels_ss_mfc(held[i], &tags, &queued) == -1 && tags == 0xFFFFFFFFu && queued == 0;
+    CHECK(none);
+    CHECK(spu_channels_ss_mfc(ninth, &tags, &queued) == -1);
+    CHECK(!s_mfc_fallback_init);
+
+    spu_context* a = (spu_context*)calloc(1, sizeof(spu_context));
+    spu_context* b = (spu_context*)calloc(1, sizeof(spu_context));
+    CHECK(a != NULL && b != NULL);
+    if (!a || !b) return;
+    spu_channels_ss_set_mfc(a, 0xFFFFFFF7u);          /* tag 3: a list parked at a stall */
+    const int slot = spu_channels_ss_mfc(a, &tags, &queued);
+    CHECK(slot >= 0 && slot < SPU_MAX_CONTEXTS);
+    CHECK(tags == 0xFFFFFFF7u && queued == 0);
+    CHECK(slot >= 0 && mfc_for(a) == &s_mfc_slots[slot].mfc);
+    CHECK(mfc_for(a)->tag_completed == 0xFFFFFFF7u);
+    CHECK(spu_channels_ss_mfc(b, &tags, &queued) == -1);
+    spu_mfc_release(a);
+
+    spu_channels_ss_set_dec(b, 1000u, 1);
+    CHECK(b->dec_base_ns != 0);
+    CHECK(spu_channels_ss_dec(b, b->dec_base_ns, &armed) == 1000u && armed == 1);
+    CHECK(spu_channels_ss_dec(b, b->dec_base_ns + 1000000u, &armed) == 1000u - 79800u);   /* 1 ms at 79.8 MHz */
+    spu_channels_ss_set_dec(b, 5u, 0);
+    CHECK(b->dec_base_ns == 0);
+    CHECK(spu_channels_ss_dec(b, 123456789u, &armed) == 5u && armed == 0);
