+}
+
+static void test_bars(void)
+{
+    const struct { int cw, ch; double a; int w, h; } c[] = {
+        { 2560, 1080, 64.0 / 27, 2560, 1080 },   /* fullscreen ultrawide, Hor+ 64:27: no bars */
+        { 1707, 720, 64.0 / 27, 1707, 720 },     /* the default 64:27 window */
+        { 2560, 1080, 16.0 / 9, 1920, 1080 },    /* IF2_ASPECT=off on the ultrawide: side bars */
+        { 1920, 1080, 64.0 / 27, 1920, 810 },    /* 64:27 on a 16:9 monitor: top / bottom bars */
+        { 3440, 1440, 64.0 / 27, 3413, 1440 },   /* 43:18 monitor, 64:27 picture */
+        { 1280, 720, 16.0 / 9, 1280, 720 },
+        { 1600, 675, 64.0 / 27, 1600, 675 },
+        { 1000, 1000, 16.0 / 9, 1000, 563 },
+        { 2561, 1080, 64.0 / 27, 2561, 1080 },   /* within 2 px: snapped, no 1-px bar */
+    };
+    for (unsigned i = 0; i < sizeof c / sizeof c[0]; i++) {
+        int x, y, w, h;
+        dcfg_fit_rect(c[i].cw, c[i].ch, c[i].a, &x, &y, &w, &h);
+        CHECK(w == c[i].w && h == c[i].h, "bars.size %dx%d at %.4f: %dx%d (want %dx%d)", c[i].cw, c[i].ch, c[i].a, w, h,
+              c[i].w, c[i].h);
+        CHECK(abs((c[i].cw - w) - 2 * x) <= 1 && abs((c[i].ch - h) - 2 * y) <= 1, "bars.symmetric %dx%d", c[i].cw,
+              c[i].ch);
+        CHECK(fabs((double)w / h - c[i].a) * h <= 1.0 + 1e-9 || (w == c[i].cw && h == c[i].ch), "bars.aspect %dx%d",
+              c[i].cw, c[i].ch);
+        /* the window pass maps the 1280x720 source onto exactly this rectangle, edge to edge */
+        for (int k = 0; k < 3; k++) {
+            const rsx_up_axis ax = rsx_up_axis_of(k_filters[k], 1280, (unsigned)w);
+            const rsx_up_axis ay = rsx_up_axis_of(k_filters[k], 720, (unsigned)h);
+            CHECK(fabs(rsx_up_centre(&ax, 0) - 0.5 * ax.ratio) < 1e-12 &&
+                  fabs(rsx_up_centre(&ax, (unsigned)w - 1) - (1280.0 - 0.5 * ax.ratio)) < 1e-9 &&
+                  fabs(rsx_up_centre(&ay, (unsigned)h - 1) - (720.0 - 0.5 * ay.ratio)) < 1e-9,
+                  "bars.edge to edge %dx%d", w, h);
+        }
+    }
+    /* present = stretch: no view; the swap chain is the whole client (the picture fills it) */
+    { int x, y, w, h; dcfg_fit_rect(2560, 1080, 0.0, &x, &y, &w, &h);
+      CHECK(x == 0 && y == 0 && w == 2560 && h == 1080, "bars.stretch: the whole client"); }
+}
