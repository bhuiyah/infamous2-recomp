+                (va->offset & 0x80000000u) ? "MAIN" : "local", va->frequency,
+                (nw->enabled && nw->stride) ? "READS THE ARRAY" : "register",
+                (double)st->vertex_data4f[a][0], (double)st->vertex_data4f[a][1],
+                (double)st->vertex_data4f[a][2], (double)st->vertex_data4f[a][3]);
+    }
+    if (tr && tr->verts) {
+        for (u32 k = 0; k < tr->nverts && k < 64u; k++) {
+            char line[1024]; int lp = 0; line[0] = 0;
+            for (int a = 0; a < 16; a++) if (vs_in & (1u << a))
+                IMMD_APPEND(" a%d=(%g %g %g %g)", a,
+                            (double)tr->verts[k][a][0], (double)tr->verts[k][a][1],
+                            (double)tr->verts[k][a][2], (double)tr->verts[k][a][3]);
+            fprintf(stderr, "[IMMDIAG]  v%u register%s\n", k, line);
+        }
+    }
+    /* What the GPU reads: this entry's vertices (the tail of the record) in the
+     * record's layout (vmask ascending, float4 each) -- VCOMPACT: through its
+     * indices into the arena; the old path (VCOMPACT=0): the expanded 256-byte
+     * records at vb_byte_offset. */
+    const int lin = !dr->is_idx;
+    if (s_d3d.vp_vb_mapped && dr->vstride >= 16u && dr->vertex_count >= emitted &&
+        (lin || s_d3d.vp_ib_mapped)) {
+        const u32* ib = lin ? NULL : (const u32*)s_d3d.vp_ib_mapped + (u64)s_d3d.vp_parity * VP_IB_HALF
+                                      + dr->ib_start + (dr->vertex_count - emitted);
+        const u8* lb = !lin ? NULL : (const u8*)s_d3d.vp_vb_mapped + (u64)s_d3d.vp_parity * MAX_VERTICES * 256u
+                                     + dr->vb_byte_offset + (u64)(dr->vertex_count - emitted) * 256u;
+        for (u32 j = 0; j < emitted && j < 96u; j++) {
+            const u32 idx = lin ? j : ib[j];
+            const float* vf = lin ? (const float*)(lb + (u64)j * 256u)
+                                  : (const float*)((const u8*)s_d3d.vp_vb_mapped + (u64)idx * dr->vstride);
+            char line[1024]; int lp = 0; line[0] = 0;
+            u32 slot = 0;
+            for (int a = 0; a < 16; a++) {
+                if (!(dr->vmask & (1u << a))) continue;
+                if ((vs_in & (1u << a)) && (slot + 1u) * 16u <= dr->vstride)
+                    IMMD_APPEND(" a%d=(%g %g %g %g)", a,
+                                (double)vf[slot * 4], (double)vf[slot * 4 + 1],
+                                (double)vf[slot * 4 + 2], (double)vf[slot * 4 + 3]);
+                slot++;
+            }
+            fprintf(stderr, "[IMMDIAG]  tri %u.%u idx=%u%s\n", j / 3u, j % 3u, idx, line);
+        }
+    }
+    if (tr) {
+        const u32 stale_read = vs_in & ~tr->pushed_mask & tr->stale_mask & ~tr->reg_mask;
+        if (stale_read || tr->ndropped)
