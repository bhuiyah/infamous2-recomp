+        PhKnown k = ph_known_copy(np, &found);
+        CHECK(found && k.retry_at == 0, "an unknown collection stops being retried");
+        const char* fp = "\\\\?\\hid#padhost-test-failed";
+        for (int i = 1; i <= 6; i++)
+            ph_known_note(fp, KN_FAILED, "open failed", PADHOST_BUS_USB, 0x1234, 0x9999, 1, 5, "x", 31);
+        k = ph_known_copy(fp, &found);
+        CHECK(found && k.retry_at == 0, "a failing device waits for a replug");
+        known_drop("padhost-test-");
+    }
+
+    /* query-remove: the device lets go (motors off, port freed, handle closed)
+     * before the callback returns, and its path is left alone for a while */
+    {
+        HANDLE srv;
+        const char* qp = "\\\\?\\hid#vid_1234&pid_9999#padhost-test-q#{4d1e55b2-f16f-11cf-88cb-001111000030}";
+        PhDev* q = pipe_device_drv(&stub_drv, "\\\\.\\pipe\\padhost_test_q", &srv, qp);
+        CHECK(q != NULL && wait_state(0, 1, 1000), "pipe device on port 0");
+        unsigned char m[64];
+        pipe_read_msg(srv, m, sizeof m, 1000);          /* its LED output */
+        padhost_set_actuator(0, 1, 90);
+        int n = pipe_read_msg(srv, m, sizeof m, 1000);
+        CHECK(n == 4 && m[1] == 1 && m[2] == 90, "rumbling");
+        /* s_lock held shared: the device thread lets go of the handle before it
+         * needs the lock to finish, and the reaper cannot free q meanwhile */
+        AcquireSRWLockShared(&s_lock);
+        ULONGLONG t0 = GetTickCount64();
+        DWORD r = ph_cm_handle_callback(NULL, q, CM_NOTIFY_ACTION_DEVICEQUERYREMOVE, NULL, 0);
+        ULONGLONG took = GetTickCount64() - t0;
+        int closed = q->pub.handle == NULL;
+        ReleaseSRWLockShared(&s_lock);
+        CHECK(r == ERROR_SUCCESS && took < 1000, "callback returns promptly (%llu ms), never vetoes", took);
+        CHECK(closed, "the handle is closed when the callback returns");
+        n = pipe_read_msg(srv, m, sizeof m, 500);
+        CHECK(n == 4 && m[1] == 0 && m[2] == 0 && m[3] == 0xFF, "close(): motors off first (%d)", n);
+        DWORD avail = 0;
+        BOOL peek = PeekNamedPipe(srv, NULL, 0, NULL, &avail, NULL);
+        CHECK(!peek && GetLastError() == ERROR_BROKEN_PIPE, "handle closed when the callback returned");
+        CHECK(wait_state(0, 0, 1000), "port released");
+        int found = 0;
+        PhKnown k;
+        ULONGLONG end = GetTickCount64() + 2000;
+        do { k = ph_known_copy(qp, &found); if (!found) Sleep(5); } while (!found && GetTickCount64() < end);
+        CHECK(found && k.status == KN_NOACCESS && !strcmp(k.why, "being removed") &&
+              k.retry_at > t0 + 1500 && k.retry_at <= GetTickCount64() + PH_QREMOVE_HOLD_MS,
+              "held off for %d ms (found %d, why %s)", PH_QREMOVE_HOLD_MS, found, k.why);
+        CloseHandle(srv);
+        known_drop("padhost-test-");
+        /* QUERYREMOVEFAILED (someone else vetoed): only a rescan request */
+        CHECK(ph_cm_handle_callback(NULL, NULL, CM_NOTIFY_ACTION_DEVICEQUERYREMOVEFAILED, NULL, 0) == ERROR_SUCCESS,
+              "query-remove-failed");
+    }
+
+    /* a driver that declines a device: listed as not used, never retried */
+    {
+        HANDLE srv;
+        const char* dp = "\\\\?\\hid#vid_1234&pid_9999#padhost-test-decl#{4d1e55b2-f16f-11cf-88cb-001111000030}";
