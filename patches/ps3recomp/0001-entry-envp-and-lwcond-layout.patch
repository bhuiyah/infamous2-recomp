+    "float4 rsx_unn(float4 c, Texture2D t) { uint w, h; t.GetDimensions(w, h); return float4(c.xy / float2(w, h), c.zw); }\n";
+
+/* wrap_texproc, plus a SIGNED unit's conversion: rsx_texsx gets the raw
+ * sample and the processed one and picks, per channel, the two's-complement
+ * reading where the unit's control byte marks the channel signed. Returns 1
+ * when it emitted rsx_texsx. With mode != SIGNED the text is exactly
+ * wrap_texproc's. */
+static int wrap_texproc_mode(char* rhs, size_t n, u32 unit, int bx2, u32 mode)
+{
+    if (mode != RSX_FP_TEX_SIGNED) { wrap_texproc(rhs, n, unit, bx2); return 0; }
+    char raw[1024], tmp[2048];
+    snprintf(raw, sizeof raw, "%s", rhs);
+    snprintf(tmp, sizeof tmp, "rsx_texsx(%s, %s(%s, %uu), %uu)", raw,
+             bx2 ? "rsx_texproc_bx2" : "rsx_texproc", raw, unit, unit);
+    snprintf(rhs, n, "%s", tmp);
+    return 1;
+}
+
+/* A DEPTH unit (RSX_FP_TEX_DEPTH[_PACKED]) of a 2D sample: the comparison /
+ * depth read, coordinate a (projected when proj). Returns 0 for a cube unit,
+ * which samples as before; 1 for rsx_ztex, 2 for rsx_ztexs (soft: the
+ * shadow-filter setting's kernel, rsx_fp_set_shadow_filter). */
+static int emit_ztex(char* rhs, size_t n, u32 unit, u32 cube_mask, u32 mode, const char* a, int proj, int soft)
+{
+    if ((cube_mask >> unit) & 1u) return 0;
+    char tn[32];
+    snprintf(tn, sizeof tn, cube_mask ? "rsx_tex%u" : "rsx_tex[%u]", unit);
+    if (soft) {
+        snprintf(rhs, n, "rsx_ztexs(%s, rsx_samp[%u], %uu, %uu, (%s), %uu, input.position.xy)", tn, unit, unit,
+                 mode, a, proj ? 1u : 0u);
+        return 2;
+    }
+    snprintf(rhs, n, "rsx_ztex(%s, rsx_samp[%u], %uu, %uu, (%s), %uu)", tn, unit, unit, mode, a,
+             proj ? 1u : 0u);
+    return 1;
+}
+
+/* SIGNED channels (TEXTURE_FILTER bits 28-31 after the crossbar; rsx_texture_
+ * texproc): the 8-bit two's-complement reading max(s / 127, -1) of the
+ * fetched byte (RPCS3 _sext_unorm8x4). Exact for point sampling; a filtered
+ * fetch blends the unsigned bytes first, as RPCS3's does. */
+static const char s_fp_texsx_hlsl[] =
+    "float4 rsx_texsx(float4 raw, float4 c, uint u) {\n"
+    "    const uint w = u < 4u ? fp_texctl.x : (u < 8u ? fp_texctl.y : (u < 12u ? fp_texctl.z : fp_texctl.w));\n"
+    "    const uint m = (w >> ((u & 3u) * 8u)) & (w >> ((u & 3u) * 8u + 4u)) & 0xFu;\n"
+    "    if (m == 0u) return c;\n"
+    "    const float4 v = round(saturate(raw) * 255.0);\n"
+    "    const float4 s = max((v >= 128.0 ? v - 256.0 : v) / 127.0, -1.0);\n"
+    "    return bool4((m & 1u) != 0u, (m & 2u) != 0u, (m & 4u) != 0u, (m & 8u) != 0u) ? s : c;\n"
+    "}\n";
+
+/* Depth textures (DEPTH24_D8, DEPTH16 and their FLOAT forms). The 2x2
+ * footprint of a bilinear fetch at uv is gathered (x,y,z,w = lower-left,
+ * lower-right, upper-right, upper-left), each texel's depth is compared with
+ * the reference r (coordinate z, or z/w for TXP; clamped to [0,1] as for any
+ * fixed-point depth format, ARB_shadow) by the unit's ZFUNC --
+ * libgcm CELL_GCM_TEXTURE_ZFUNC_* name the TEXEL's relation to r: 1 LESS
+ * (texel < r), 2 EQUAL, 3 LEQUAL, 4 GREATER, 5 NOTEQUAL, 6 GEQUAL, 7 ALWAYS
+ * (nouveau's RCOMP encodes the same values as "r OP texel": GREATER = 1 ...)
+ * -- and the 0/1 results are blended with the bilinear weights (NVIDIA's
+ * hardware PCF) when the unit filters linearly, else the nearest one is
+ * taken. ZFUNC 0 (NEVER) is no comparison: the depth itself, filtered the
+ * same way. mode 1: the SRV is RGBA8 holding depth bits 23-16, 15-8, 7-0 in
+ * A, R, G (a zeta surface's colour alias / an A8R8G8B8 target); mode 2: its
+ * red is the depth. Control byte: ZFUNC bits 0-2, linear bit 3, footprint
+ * bits 5-6 (the D3D12 backend's ZTEX_PCF):
+ *   0 exact -- one fp32 position p = uv * size - 0.5 gives both the 2x2
+ *     footprint floor(p) and the weights p - floor(p), and the footprint is
+ *     gathered at its own centre (floor(p) + 1) / size, half a texel from any
+ *     footprint boundary, so the GPU cannot fetch another 2x2 than the one
+ *     the weights describe (ARB_shadow, T2: one footprint per sample). The
+ *     sampler still applies the address mode (CLAMP, BORDER, WRAP, MIRROR).
+ *   1 gather -- the 2x2 gathered at uv itself with the weights frac(p): the
+ *     code before 2026-10-20. Within about 1/512 texel before every texel
+ *     boundary a GPU whose Gather snaps to its 8-bit sub-texel grid has
+ *     already moved to the next footprint while frac(p) still says ~1, and
+ *     the result is off by up to 1.0 -- isolated lit/shadowed pixels along
+ *     shadow edges (RTX 5080; tests/test_ztex_pcf.c measures it).
+ *   2 diff (diagnostic) -- 1 where exact and gather differ by more than
+ *     1/64, else 0. */
+static const char s_fp_ztex_hlsl[] =
+    "float rsx_zpcf(Texture2D t, SamplerState s, uint mode, uint b, float zr, float2 q, float2 g) {\n"
+    "    float4 d;\n"
+    "    if (mode == 1u)\n"
+    "        d = (round(t.GatherAlpha(s, g) * 255.0) * 65536.0 + round(t.GatherRed(s, g) * 255.0) * 256.0 +\n"
+    "             round(t.GatherGreen(s, g) * 255.0)) / 16777215.0;\n"
+    "    else\n"
+    "        d = t.GatherRed(s, g);\n"
+    "    const uint f = b & 7u;\n"
+    "    if (f != 0u) {\n"
+    "        const bool4 lt = d < zr, eq = d == zr;\n"
+    "        d = (float4)(f == 1u ? lt : f == 2u ? eq : f == 3u ? (lt || eq) : f == 4u ? !(lt || eq) :\n"
+    "                     f == 5u ? !eq : f == 6u ? !lt : (bool4)true);\n"
+    "    }\n"
+    "    return (b & 8u) != 0u ? lerp(lerp(d.w, d.z, q.x), lerp(d.x, d.y, q.x), q.y)\n"
+    "                          : (q.y < 0.5 ? (q.x < 0.5 ? d.w : d.z) : (q.x < 0.5 ? d.x : d.y));\n"
+    "}\n"
+    "float4 rsx_ztex(Texture2D t, SamplerState s, uint u, uint mode, float4 c, uint proj) {\n"
+    "    const uint w = u < 4u ? fp_texctl.x : (u < 8u ? fp_texctl.y : (u < 12u ? fp_texctl.z : fp_texctl.w));\n"
+    "    const uint b = (w >> ((u & 3u) * 8u)) & 0xFFu;\n"
+    "    const float2 uv = proj != 0u ? c.xy / c.w : c.xy;\n"
+    "    const float zr = saturate(proj != 0u ? c.z / c.w : c.z);   /* r is clamped to the depth range */\n"
+    "    uint tw, th; t.GetDimensions(tw, th);\n"
+    "    const float2 sz = float2(tw, th), p = uv * sz - 0.5, f = floor(p);\n"
+    "    const uint pcf = (b >> 5) & 3u;\n"
+    "    if (pcf == 1u) return (float4)rsx_zpcf(t, s, mode, b, zr, frac(p), uv);\n"
+    "    const float r = rsx_zpcf(t, s, mode, b, zr, p - f, (f + 1.0) / sz);   /* exact */\n"
+    "    if (pcf == 0u) return (float4)r;\n"
+    "    return (float4)(abs(r - rsx_zpcf(t, s, mode, b, zr, frac(p), uv)) > 1.0 / 64.0 ? 1.0 : 0.0);\n"
+    "}\n";
+
+/* ---- Shadow filtering (rsx_fp_set_shadow_filter; the header has the rules) ----
+ * rsx_ztexs replaces rsx_ztex at a depth unit the program samples once. Its
+ * texels come in 2x2 blocks, each gathered at the block's own centre (i + 1) /
+ * size as the exact footprint above (so the sampler's address mode applies),
+ * each texel compared with its own reference, the blocks weighted per axis
+ * (rsx_fp_shadow_weights is the CPU twin): with k = round(p), d = p - k,
+ *   SOFT   texels k-1, k, k+1:  (1/2 - d)^2 / 2, 3/4 - d^2, (1/2 + d)^2 / 2
+ *          = a tent of 1-texel radius integrated over each texel's square
+ *          (bilinear PCF is the box of one texel over the same squares, so
+ *          this is that box once more: the quadratic B-spline), 4 blocks;
+ *   SOFTER texels k-2 .. k+2:   (1/2 - d)^2 / 8, (1 - d) / 4, 7/16 - d^2 / 4,
+ *          (1 + d) / 4, (1/2 + d)^2 / 8 = a tent of 2-texel radius over the
+ *          squares, 9 blocks;
+ *   POISSON (with SOFTER, diagnostic) 12 bilinear PCF taps of a Poisson disc
+ *          of 2-texel radius, rotated per pixel (interleaved gradient noise).
+ * The edge of a step in the map ramps over 1 texel with the PS3's 2x2, 2 with
+ * SOFT and 4 with SOFTER, monotonically (every weight >= 0). Receiver plane
+ * (RSX_FP_SHADOW_PLANE[_LOWER], an A/B; without it pl = 0 and every texel is
+ * compared with r, as the PS3's 2x2 does): the reference of the texel at
+ * offset o (texels) from p is saturate(r + pl.o), pl = d r / d(texel) solved
+ * from ddx / ddy of (p, r); a constant r (a receiver facing the light) is
+ * pl = 0 whatever the derivatives; a degenerate or steeper plane than the
+ * limit returns rsx_ztex (the PS3 kernel). */
+static u32 s_fp_zfilt;                        /* RSX_FP_SHADOW_*: once, before the first decompile */
+static double s_fp_zplane_max = RSX_FP_SHADOW_PLANE_MAX_DEFAULT;
+static char s_fp_zsoft_hlsl[6144];            /* rsx_ztexs and its helpers for that setting (fp_zsoft_build) */
+/* rsx_zblk's plane term (its %s): two-sided, or (RSX_FP_SHADOW_PLANE_LOWER) only toward lit */
+static const char s_fp_zsoft_term2[] = "pl.x * ox + pl.y * oy";
+static const char s_fp_zsoft_term1[] = "min(pl.x * ox + pl.y * oy, 0.0)";
+static const char s_fp_zsoft_common_hlsl[] =
+    "float4 rsx_zcmp4(Texture2D t, SamplerState s, uint mode, uint f, float2 i, float2 sz, float4 zr) {\n"
+    "    const float2 g = (i + 1.0) / sz;   /* the texels i .. i + 1, gathered at their centre */\n"
+    "    float4 d;\n"
+    "    if (mode == 1u)\n"
+    "        d = (round(t.GatherAlpha(s, g) * 255.0) * 65536.0 + round(t.GatherRed(s, g) * 255.0) * 256.0 +\n"
+    "             round(t.GatherGreen(s, g) * 255.0)) / 16777215.0;\n"
+    "    else\n"
+    "        d = t.GatherRed(s, g);\n"
+    "    const bool4 lt = d < zr, eq = d == zr;\n"
+    "    return (float4)(f == 1u ? lt : f == 2u ? eq : f == 3u ? (lt || eq) : f == 4u ? !(lt || eq) :\n"
+    "                    f == 5u ? !eq : f == 6u ? !lt : (bool4)true);\n"
+    "}\n"
+    "float rsx_zblk(Texture2D t, SamplerState s, uint mode, uint f, float2 i, float2 sz, float2 p, float zr,\n"
+    "               float2 pl, float2 wx, float2 wy) {   /* wx: columns i.x, i.x + 1; wy: rows i.y, i.y + 1 */\n"
+    "    const float4 ox = i.x + float4(0.0, 1.0, 1.0, 0.0) - p.x, oy = i.y + float4(1.0, 1.0, 0.0, 0.0) - p.y;\n"
+    "    const float4 r = rsx_zcmp4(t, s, mode, f, i, sz, saturate(zr + %s));\n"
+    "    return dot(r, float4(wx.x * wy.y, wx.y * wy.y, wx.y * wy.x, wx.x * wy.x));\n"
+    "}\n"
+    "float4 rsx_ztexs(Texture2D t, SamplerState s, uint u, uint mode, float4 c, uint proj, float2 sp) {\n"
+    "    const uint w = u < 4u ? fp_texctl.x : (u < 8u ? fp_texctl.y : (u < 12u ? fp_texctl.z : fp_texctl.w));\n"
+    "    const uint b = (w >> ((u & 3u) * 8u)) & 0xFFu;\n"
+    "    const float2 uv = proj != 0u ? c.xy / c.w : c.xy;\n"
+    "    const float zr = saturate(proj != 0u ? c.z / c.w : c.z);\n"
+    "    uint tw, th; t.GetDimensions(tw, th);\n"
+    "    const float2 sz = float2(tw, th), p = uv * sz - 0.5;\n";
+/* the receiver plane; one %s: the steepest trusted plane (depth per texel) */
+static const char s_fp_zsoft_plane_hlsl[] =
+    "    const float2 px = ddx(p), py = ddy(p);   /* receiver plane (Isidoro 2006): d r / d texel */\n"
+    "    const float zx = ddx(zr), zy = ddy(zr), det = px.x * py.y - px.y * py.x;\n"
+    "    const bool flat = zx == 0.0 && zy == 0.0;\n"
+    "    const float2 pl = flat ? (float2)0.0 :\n"
+    "                      float2(py.y * zx - px.y * zy, px.x * zy - py.x * zx) / (abs(det) > 1e-30 ? det : 1e-30);\n"
+    "    const bool steep = !flat && !(abs(det) > 1e-30 && abs(pl.x) + abs(pl.y) <= %s);\n";
+static const char s_fp_zsoft_noplane_hlsl[] =
+    "    const float2 pl = (float2)0.0;\n"
+    "    const bool steep = false;\n";
+static const char s_fp_zsoft_guard_hlsl[] =
+    "    if ((b & 7u) == 0u || (b & 8u) == 0u || (b & 0x60u) != 0u || steep) return rsx_ztex(t, s, u, mode, c, proj);\n"
+    "    const uint f = b & 7u;\n"
+    "    const float2 k = floor(p + 0.5), d = p - k, a = 0.5 - d, e = 0.5 + d;\n";
+static const char s_fp_zsoft_soft_hlsl[] =
+    "    const float2 w0 = a * a * 0.5, w1 = 0.75 - d * d, w2 = e * e * 0.5;   /* texels k - 1, k, k + 1 */\n"
+    "    const float2 x0 = float2(w0.x, w1.x), x1 = float2(w2.x, 0.0), y0 = float2(w0.y, w1.y), y1 = float2(w2.y, 0.0);\n"
+    "    float r = rsx_zblk(t, s, mode, f, k + float2(-1.0, -1.0), sz, p, zr, pl, x0, y0);\n"
+    "    r += rsx_zblk(t, s, mode, f, k + float2( 1.0, -1.0), sz, p, zr, pl, x1, y0);\n"
+    "    r += rsx_zblk(t, s, mode, f, k + float2(-1.0,  1.0), sz, p, zr, pl, x0, y1);\n"
+    "    r += rsx_zblk(t, s, mode, f, k + float2( 1.0,  1.0), sz, p, zr, pl, x1, y1);\n"
+    "    return (float4)(r >= 0.999999 ? 1.0 : (r <= 0.000001 ? 0.0 : r));   /* exact 0 / 1 as the PS3 kernel */\n"
+    "}\n";
+static const char s_fp_zsoft_softer_hlsl[] =
+    "    const float2 wa = a * a * 0.125, wb = (1.0 - d) * 0.25, wc = 0.4375 - d * d * 0.25, wd = (1.0 + d) * 0.25,\n"
+    "                 we = e * e * 0.125;   /* texels k - 2 .. k + 2 */\n"
+    "    const float2 x0 = float2(wa.x, wb.x), x1 = float2(wc.x, wd.x), x2 = float2(we.x, 0.0);\n"
+    "    const float2 y0 = float2(wa.y, wb.y), y1 = float2(wc.y, wd.y), y2 = float2(we.y, 0.0);\n"
+    "    float r = rsx_zblk(t, s, mode, f, k + float2(-2.0, -2.0), sz, p, zr, pl, x0, y0);\n"
+    "    r += rsx_zblk(t, s, mode, f, k + float2( 0.0, -2.0), sz, p, zr, pl, x1, y0);\n"
+    "    r += rsx_zblk(t, s, mode, f, k + float2( 2.0, -2.0), sz, p, zr, pl, x2, y0);\n"
+    "    r += rsx_zblk(t, s, mode, f, k + float2(-2.0,  0.0), sz, p, zr, pl, x0, y1);\n"
+    "    r += rsx_zblk(t, s, mode, f, k + float2( 0.0,  0.0), sz, p, zr, pl, x1, y1);\n"
+    "    r += rsx_zblk(t, s, mode, f, k + float2( 2.0,  0.0), sz, p, zr, pl, x2, y1);\n"
+    "    r += rsx_zblk(t, s, mode, f, k + float2(-2.0,  2.0), sz, p, zr, pl, x0, y2);\n"
+    "    r += rsx_zblk(t, s, mode, f, k + float2( 0.0,  2.0), sz, p, zr, pl, x1, y2);\n"
+    "    r += rsx_zblk(t, s, mode, f, k + float2( 2.0,  2.0), sz, p, zr, pl, x2, y2);\n"
+    "    return (float4)(r >= 0.999999 ? 1.0 : (r <= 0.000001 ? 0.0 : r));   /* exact 0 / 1 as the PS3 kernel */\n"
+    "}\n";
+static const char s_fp_zsoft_poisson_hlsl[] =
+    "    static const float2 o[12] = { float2(-0.326212, -0.405810), float2(-0.840144, -0.073580),\n"
+    "        float2(-0.695914, 0.457137), float2(-0.203345, 0.620716), float2(0.962340, -0.194983),\n"
+    "        float2(0.473434, -0.480026), float2(0.519456, 0.767022), float2(0.185461, -0.893124),\n"
+    "        float2(0.507431, 0.064425), float2(0.896420, 0.412458), float2(-0.321940, -0.932615),\n"
+    "        float2(-0.791559, -0.597710) };\n"
+    "    const float an = 6.2831853 * frac(52.9829189 * frac(dot(sp, float2(0.06711056, 0.00583715))));\n"
+    "    const float cs = 2.0 * cos(an), sn = 2.0 * sin(an);\n"
+    "    float r = 0.0;\n"
+    "    [unroll] for (int j = 0; j < 12; j++) {\n"
+    "        const float2 q = p + float2(cs * o[j].x - sn * o[j].y, sn * o[j].x + cs * o[j].y), fq = floor(q), tq = q - fq;\n"
+    "        r += rsx_zblk(t, s, mode, f, fq, sz, p, zr, pl, float2(1.0 - tq.x, tq.x), float2(1.0 - tq.y, tq.y));\n"
+    "    }\n"
+    "    r /= 12.0;\n"
+    "    return (float4)(r >= 0.999999 ? 1.0 : (r <= 0.000001 ? 0.0 : r));   /* exact 0 / 1 as the PS3 kernel */\n"
+    "}\n";
+static void fp_zsoft_put(size_t* o, const char* s)
+{
+    const size_t n = strlen(s);
+    if (*o + n + 1 > sizeof s_fp_zsoft_hlsl) { s_fp_zsoft_hlsl[0] = 0; *o = sizeof s_fp_zsoft_hlsl; return; }
+    memcpy(s_fp_zsoft_hlsl + *o, s, n + 1);
+    *o += n;
+}
+/* rsx_ztexs for the current setting into s_fp_zsoft_hlsl ("" at PS3: no unit
+ * gets it). */
+static void fp_zsoft_build(void)
+{
+    const u32 k = s_fp_zfilt & RSX_FP_SHADOW_KERNEL;
+    size_t o = 0;
+    s_fp_zsoft_hlsl[0] = 0;
+    if (k != RSX_FP_SHADOW_SOFT && k != RSX_FP_SHADOW_SOFTER) return;
+    {   /* the common part, with the plane term (two-sided or lowering only) */
+        char txt[sizeof s_fp_zsoft_common_hlsl + 64];
+        snprintf(txt, sizeof txt, s_fp_zsoft_common_hlsl,
+                 (s_fp_zfilt & RSX_FP_SHADOW_PLANE_LOWER) ? s_fp_zsoft_term1 : s_fp_zsoft_term2);
+        fp_zsoft_put(&o, txt);
+    }
+    if (!(s_fp_zfilt & (RSX_FP_SHADOW_PLANE | RSX_FP_SHADOW_PLANE_LOWER))) fp_zsoft_put(&o, s_fp_zsoft_noplane_hlsl);
+    else {
+        char lim[48], txt[sizeof s_fp_zsoft_plane_hlsl + 48];
+        snprintf(lim, sizeof lim, "%.9g", s_fp_zplane_max > 0.0 ? s_fp_zplane_max : 1e30);
+        snprintf(txt, sizeof txt, s_fp_zsoft_plane_hlsl, lim);
+        fp_zsoft_put(&o, txt);
+    }
+    fp_zsoft_put(&o, s_fp_zsoft_guard_hlsl);
+    fp_zsoft_put(&o, k == RSX_FP_SHADOW_SOFT ? s_fp_zsoft_soft_hlsl :
+                     (s_fp_zfilt & RSX_FP_SHADOW_POISSON) ? s_fp_zsoft_poisson_hlsl : s_fp_zsoft_softer_hlsl);
+}
+void rsx_fp_set_shadow_filter(u32 filter)
+{
+    s_fp_zfilt = filter & (RSX_FP_SHADOW_KERNEL | RSX_FP_SHADOW_POISSON | RSX_FP_SHADOW_PLANE |
+                           RSX_FP_SHADOW_PLANE_LOWER);
+    fp_zsoft_build();
+}
+u32 rsx_fp_shadow_filter(void) { return s_fp_zfilt; }
+void rsx_fp_set_shadow_plane_max(double max_per_texel)
+{
+    s_fp_zplane_max = max_per_texel;
+    fp_zsoft_build();
+}
+void rsx_fp_shadow_weights(u32 kernel, double d, double w[5])
+{
+    const double a = 0.5 - d, e = 0.5 + d;
+    for (int i = 0; i < 5; i++) w[i] = 0.0;
+    switch (kernel & RSX_FP_SHADOW_KERNEL) {
+    case RSX_FP_SHADOW_SOFT:
+        w[1] = a * a * 0.5; w[2] = 0.75 - d * d; w[3] = e * e * 0.5;
+        break;
+    case RSX_FP_SHADOW_SOFTER:
+        w[0] = a * a * 0.125; w[1] = (1.0 - d) * 0.25; w[2] = 0.4375 - d * d * 0.25;
+        w[3] = (1.0 + d) * 0.25; w[4] = e * e * 0.125;
+        break;
+    default:   /* the PS3's bilinear pair: floor(p) and floor(p) + 1 */
+        w[2] = 1.0 - (d < 0.0 ? -d : d);
+        if (d < 0.0) w[1] = -d; else w[3] = d;
+        break;
+    }
+}
+
+/* TEX_bx2 (FP_EXP_TEX) in a buffered program. fp_alpha.w carries, as raw
+ * bits, one nibble per texture unit 0-7 (R,G,B,A = bits 0-3): the channels a
+ * _bx2 sample of that unit expands -- the ones its crossbar reads from the
+ * texture and that are not signed, and only for formats whose hardware has
+ * the expansion (RPCS3 get_format_features: BIASED_RENORMALIZATION, i.e. not
+ * the float formats or HILO_S8). A zero nibble (any backend that leaves
+ * fp_alpha.w at 0, FP_BX2=0, or units 8-15) samples exactly as before.
