+void ss_configure(const ss_config* c)
+{
+    if (co.st != CO_IDLE || g_ss_req || g_ss_spu_req || g_ss_mix_req) release_all();
+    s_cfg = *c;
+    if (s_cfg.period_s > 0 || s_cfg.n_save_at > 0 || s_cfg.n_dump_at > 0 ||
+        s_cfg.selftest_every_s > 0 || s_cfg.selftest_ab_s > 0) s_cfg.on = 1;   /* a request source arms */
+    if (s_cfg.slice_ms == 0) s_cfg.slice_ms = 1;
+    if (s_cfg.timeout_ms < s_cfg.tier1_ms) s_cfg.tier1_ms = s_cfg.timeout_ms;
+    if (s_cfg.n_save_at < 0) s_cfg.n_save_at = 0;
+    if (s_cfg.n_save_at > SS_SAVE_AT_MAX) s_cfg.n_save_at = SS_SAVE_AT_MAX;
+    if (s_cfg.n_dump_at < 0) s_cfg.n_dump_at = 0;
+    if (s_cfg.n_dump_at > SS_SAVE_AT_MAX) s_cfg.n_dump_at = SS_SAVE_AT_MAX;
+    qsort(s_cfg.save_at, (size_t)s_cfg.n_save_at, sizeof s_cfg.save_at[0], cmp_d);
+    qsort(s_cfg.dump_at, (size_t)s_cfg.n_dump_at, sizeof s_cfg.dump_at[0], cmp_d);
+    audit_configure(s_cfg.spu_audited);
+    co.t_init = ss_now_us();
+    co.t_next = co.t_init;
+    co.t_census = co.t_init + (uint64_t)(s_cfg.start_s * 1e6);
+    co.t_selftest = co.t_init + (uint64_t)(s_cfg.selftest_start_s * 1e6);
+    co.ab_phase = 0;
+    co.sat_next = 0;
+    co.dump_next = 0;
+    co.st = CO_IDLE;
+    s_cfg_set = 1;
+    if (!s_cfg.on) rq_cancel(SS_REASON_OFF);
+    g_ss_armed = s_cfg.on ? 1 : 0;
+    if (s_cfg.on) g_ppu_ss_park_of = ppu_park_of;    /* PPUT saves the park records */
+}
+
+int ss_enable(void)
+{
+    if (!s_cfg_set) {
+        ss_config c;
+        ss_default_config(&c);
+        c.on = 1;
+        ss_configure(&c);
+    }
+    s_cfg.on = 1;
+    g_ss_armed = 1;
+    /* The capture's staging buffer: its address range (no memory) and the
+     * margin committed; it grows before a save, outside its stop. */
+    static int s_state_on;
+    if (!s_state_on) { s_state_on = 1; ss_state_enable(); }
+    g_ppu_ss_park_of = ppu_park_of;                  /* PPUT saves the park records */
+    return 1;
+}
+
+void ss_init(void)
+{
+    if (InterlockedCompareExchange(&s_inited, 1, 0) != 0) return;
+    ss_config c;
+    if (!ss_config_from_env(&c)) {
+        /* The kill switch: not even P0 (SS_SELFRESUME) arms. */
+        fprintf(stderr, "[ss] save states OFF (SAVESTATES=0, or enabled = 0 in savestates.ini): nothing armed, no slicing, no thread"
+                        " roots; every request is refused\n");
+        fflush(stderr);
+        return;
+    }
+    sr_init_env();                                    /* P0: SS_SELFRESUME */
+    if (getenv("PPU_THREADGATE")) s_debug_switch = "PPU_THREADGATE";      /* gated threads never park */
+    else if (getenv("RD_SPU_INTERP")) s_debug_switch = "RD_SPU_INTERP";   /* an equeue re-issue side effect */
+    ss_configure(&c);
+    ss_enable();
+    atexit(rq_atexit);                                /* the request summary (exit() only) */
+    fprintf(stderr, "[ss] save states armed (always on; SAVESTATES=0 turns them off): no periodic stop,"
+                    " host waits sliced at %u ms; a stop: tier 1 %u ms, give up at %u ms, spu %s (%u ms),"
+                    " bridge parks %s%s%s\n",
+            c.slice_ms, c.tier1_ms, c.timeout_ms, c.spu ? "on" : "off", c.spu_timeout_ms,
+            c.bridge_park ? "allowed" : "refused", s_debug_switch ? "; saves refused: " : "",
+            s_debug_switch ? s_debug_switch : "");
+    if (c.period_s > 0)
+        fprintf(stderr, "[ss] census armed: every %.1f s from t=%.1f s; tier 1 %u ms, give up at %u ms"
+                        " (%d retr%s), spu %s (%u ms, expect %d threads), host waits sliced at %u ms,"
+                        " bridge parks %s, chains -> %s\n",
+                c.period_s, c.start_s, c.tier1_ms, c.timeout_ms, c.retries, c.retries == 1 ? "y" : "ies",
+                c.spu ? "on" : "off", c.spu_timeout_ms, c.spu_expect, c.slice_ms,
+                c.bridge_park ? "allowed" : "refused", c.chains_path[0] ? c.chains_path : "(none)");
+    if (c.n_save_at > 0) {
+        char b[512];
+        int p = 0;
+        b[0] = 0;
+        for (int i = 0; i < s_cfg.n_save_at && p < (int)sizeof b - 16; i++)
+            p += snprintf(b + p, sizeof b - p, "%s%.1f", i ? "," : "", s_cfg.save_at[i]);
+        fprintf(stderr, "[ss] SS_SAVE_AT: a save request at t=%s s (strict check, capture to RAM)\n", b);
+    }
+    if (c.n_dump_at > 0) {
+        char b[512];
+        int p = 0;
+        b[0] = 0;
+        for (int i = 0; i < s_cfg.n_dump_at && p < (int)sizeof b - 16; i++)
+            p += snprintf(b + p, sizeof b - p, "%s%.1f", i ? "," : "", s_cfg.dump_at[i]);
+        fprintf(stderr, "[ss] SS_DUMP: a save request at t=%s s, its image written raw to %s\\dump-<n>.p3ssraw\n",
+                b, ss_ui_dir());
+    }
+    if (c.selftest_every_s > 0 || c.selftest_ab_s > 0)
+        fprintf(stderr, "[ss] selftest (M4c): %s%.1f s%s, from t=%.1f s; fidelity check %s\n",
+                c.selftest_every_s > 0 ? "a round trip (capture A, load A) every " : "capture A, play ",
+                c.selftest_every_s > 0 ? c.selftest_every_s : c.selftest_ab_s,
+                c.selftest_every_s > 0 ? "" : ", load A, play, again", c.selftest_start_s,
+                c.verify == 0 ? "off (SS_VERIFY=0)" : "on");
+    if (getenv("PPU_THREADGATE"))
+        fprintf(stderr, "[ss] WARNING: PPU_THREADGATE is set -- gated (suspended) threads never park\n");
+    fflush(stderr);
+}
