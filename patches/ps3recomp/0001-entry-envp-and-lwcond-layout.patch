+/* Save states (M4c; engine design 4.3 step 5): start a lifted SPU thread
+ * from its restored context in resume mode -- group_start minus
+ * spu_lifted_thread_setup: sctx is the image's (SPUC's restore), the host
+ * thread waits at the load gate and then runs from ctx->pc with the
+ * context's interrupt state kept (spu_lifted_thread_resume). The old host
+ * thread's handle (a discarded thread, gone) is closed. */
+static int spu_thread_start_resumed(spu_thread_t* t)
+{
+#ifdef _WIN32
+    if (!t->sctx) return -1;
+    if (t->host_thread) { CloseHandle(t->host_thread); t->host_thread = NULL; }
+    t->running = 1;
+    t->live_ctx = NULL;
+    ss_transition_begin(SS_TR_SPU_THREAD);   /* until the thread registers */
+    if (!t->finish_event)
+        t->finish_event = CreateEventA(NULL, TRUE, FALSE, NULL);
+    else
+        ResetEvent(t->finish_event);
+    t->host_thread = CreateThread(NULL, spu_host_stack_bytes(), spu_resume_thread_proc, t,
+                                  STACK_SIZE_PARAM_IS_A_RESERVATION, NULL);
+    if (!t->host_thread) {
+        ss_transition_end(SS_TR_SPU_THREAD);
+        t->running = 0;
+        return -1;
+    }
+    return 0;
+#else
+    (void)t;
+    return -1;
+#endif
+}
+
+/* RECREATE (ss_set_spu_recreate): every lv2 SPU thread the restored tables
+ * say runs on its own lifted context, started in resume mode, its lock-line
+ * reservation dropped first (spu_channels_ss_resume: after the fidelity
+ * check, which compared the context as captured). A running thread with no
+ * context (a PPU-fallback or interpreter run) cannot be resumed -- a load
+ * refuses a stop with one (it has no discard root), so the image of a strict
+ * save never holds one (SPUG's check_image refuses it too). Returns the
+ * threads started. */
+static int lv2_spu_ss_recreate(char* why, size_t n)
+{
+    int started = 0;
+    for (int i = 0; i < MAX_SPU_THREADS; i++) {
+        spu_thread_t* t = &s_spu_threads[i];
+        if (!t->in_use || !t->running) continue;
+        if (!t->sctx) {
+            snprintf(why, n, "SPU 0x%X runs with no lifted context (a PPU-fallback run): not resumable", t->tid);
+            return -1;
+        }
+        spu_channels_ss_resume(t->sctx);
+        if (spu_thread_start_resumed(t) != 0) {
+            snprintf(why, n, "SPU 0x%X: its host thread could not be created", t->tid);
+            return -1;
+        }
+        started++;
+    }
+    return started;
+}
