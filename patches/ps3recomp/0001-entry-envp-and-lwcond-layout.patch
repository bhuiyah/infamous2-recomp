+/*
+ * ps3recomp - texture packs: Windows image and file I/O (WIC PNG, our own DDS,
+ * bounded file reads, atomic writes), and the decode of a pack file into the
+ * subresources of a replacement. No D3D12 and no backend state: the runtime
+ * (rsx_texpack_rt.h), tools/texpack and libs/video/tests/test_texpack_io.c all
+ * use it.
+ *
+ * WIC on a test PC (design probe): the PNG encoder takes 32bppBGRA (not RGBA),
+ * 8bppGray, 16bppGray and 64bppRGBA, and every one of them round-trips
+ * exactly. The DDS encoder only takes BC1-3 2D textures, so DDS files are
+ * written and read by our own code (rsx_texpack.h); WIC's DDS encoder is used
+ * only by the tool, for BC1-3 compression.
+ */
+#ifndef PS3RECOMP_RSX_TEXPACK_IO_H
+#define PS3RECOMP_RSX_TEXPACK_IO_H
+#ifdef _WIN32
+
+#include "rsx_texpack.h"
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <objbase.h>
+#ifndef COBJMACROS
+#define COBJMACROS
+#define TP_UNDEF_COBJMACROS
+#endif
+#include <wincodec.h>
+#ifdef TP_UNDEF_COBJMACROS
+#undef COBJMACROS
+#undef TP_UNDEF_COBJMACROS
+#endif
+#pragma comment(lib, "windowscodecs.lib")
+#pragma comment(lib, "ole32.lib")
+#pragma comment(lib, "uuid.lib")
+
+/* Caps on untrusted input (critique M7). A 16x replacement of a 512x512
+ * texture is 8192x8192: allowed as a block-compressed file (~90 MB with mips),
+ * refused as RGBA8 (358 MB). */
+#ifndef TP_MAX_FILE_BYTES     /* (the authoring tool raises them for its intermediate images) */
+#define TP_MAX_FILE_BYTES   (512ull << 20)
+#endif
+#ifndef TP_MAX_REP_DIM
+#define TP_MAX_REP_DIM      8192u
+#endif
+#ifndef TP_MAX_REP_BYTES
+#define TP_MAX_REP_BYTES    (320ull << 20)
+#endif
+
+/* ---------------------------------------------------------------------------
+ * WIC factory, one per thread (COM MTA)
+ * -----------------------------------------------------------------------*/
+static __declspec(thread) IWICImagingFactory* t_tp_wic;
+TP_FN IWICImagingFactory* tp_wic(void)
+{
+    if (t_tp_wic) return t_tp_wic;
+    HRESULT hr = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    if (FAILED(hr) && hr != RPC_E_CHANGED_MODE) return NULL;
+    IWICImagingFactory* f = NULL;
+    if (FAILED(CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER,
+                                &IID_IWICImagingFactory, (void**)&f)))
+        return NULL;
+    t_tp_wic = f;
+    return f;
+}
+
+/* ---------------------------------------------------------------------------
+ * Files
+ * -----------------------------------------------------------------------*/
+/* Read a whole file of at most `cap` bytes. NULL on failure (err set). */
+TP_FN uint8_t* tp_read_file(const wchar_t* path, uint64_t cap, size_t* n, const char** err)
+{
+    *n = 0;
+    HANDLE f = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                           OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+    if (f == INVALID_HANDLE_VALUE) { *err = "cannot open"; return NULL; }
+    LARGE_INTEGER sz;
+    if (!GetFileSizeEx(f, &sz) || sz.QuadPart <= 0 || (uint64_t)sz.QuadPart > cap) {
+        CloseHandle(f); *err = sz.QuadPart <= 0 ? "empty file" : "file too large"; return NULL;
+    }
+    uint8_t* b = (uint8_t*)malloc((size_t)sz.QuadPart);
+    if (!b) { CloseHandle(f); *err = "out of memory"; return NULL; }
+    uint64_t got = 0;
+    while (got < (uint64_t)sz.QuadPart) {
+        DWORD want = (DWORD)(((uint64_t)sz.QuadPart - got) > (1u << 30) ? (1u << 30) : ((uint64_t)sz.QuadPart - got)), r = 0;
+        if (!ReadFile(f, b + got, want, &r, NULL) || !r) break;
+        got += r;
+    }
+    CloseHandle(f);
+    if (got != (uint64_t)sz.QuadPart) { free(b); *err = "short read"; return NULL; }
+    *n = (size_t)got;
+    return b;
+}
+
+/* Create every directory of `dir` (wide, '\\' separated). */
+TP_FN void tp_mkdirs(const wchar_t* dir)
+{
+    wchar_t b[1024];
+    if (wcslen(dir) >= 1024) return;
+    wcscpy(b, dir);
+    for (wchar_t* p = b; *p; p++)
+        if ((*p == L'\\' || *p == L'/') && p > b && p[-1] != L':') {
+            const wchar_t c = *p; *p = 0; CreateDirectoryW(b, NULL); *p = c;
+        }
+    CreateDirectoryW(b, NULL);
+}
+
+/* Write `n` bytes to a temporary file next to `path` and rename it into
+ * place. With replace = 0 an existing file wins (another process dumped the
+ * same texture first): returns 1 then, 0 when written, -1 on failure. */
+TP_FN int tp_write_atomic(const wchar_t* path, const void* d, size_t n, int replace)
+{
+    wchar_t tmp[1100];
+    if (swprintf(tmp, 1100, L"%ls.%lu.tmp", path, (unsigned long)GetCurrentProcessId()) < 0) return -1;
+    HANDLE f = CreateFileW(tmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE) return -1;
+    size_t put = 0; int ok = 1;
+    while (put < n) {
+        DWORD w = 0, want = (DWORD)((n - put) > (1u << 30) ? (1u << 30) : (n - put));
+        if (!WriteFile(f, (const uint8_t*)d + put, want, &w, NULL) || !w) { ok = 0; break; }
+        put += w;
+    }
+    CloseHandle(f);
+    if (!ok) { DeleteFileW(tmp); return -1; }
+    if (!MoveFileExW(tmp, path, replace ? MOVEFILE_REPLACE_EXISTING : 0)) {
+        const DWORD e = GetLastError();
+        DeleteFileW(tmp);
+        return (e == ERROR_ALREADY_EXISTS || e == ERROR_FILE_EXISTS) ? 1 : -1;
+    }
+    return 0;
+}
+TP_FN int tp_file_exists(const wchar_t* p) { return GetFileAttributesW(p) != INVALID_FILE_ATTRIBUTES; }
+TP_FN void tp_widen(const char* s, wchar_t* out, int n)
+{
+    if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, s, -1, out, n))
+        if (!MultiByteToWideChar(CP_ACP, 0, s, -1, out, n)) out[0] = 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * PNG through WIC
+ * -----------------------------------------------------------------------*/
+/* Encode one frame (pf = GUID_WICPixelFormat32bppBGRA / 8bppGray /
+ * 16bppGray / 64bppRGBA) to memory. Returns a malloc'd buffer or NULL. */
+TP_FN uint8_t* tp_png_encode(const GUID* pf, uint32_t w, uint32_t h, uint32_t stride, const void* px, size_t* out_n)
+{
+    IWICImagingFactory* F = tp_wic();
+    *out_n = 0;
+    if (!F) return NULL;
+    IStream* ms = NULL; IWICBitmapEncoder* enc = NULL; IWICBitmapFrameEncode* fr = NULL; IPropertyBag2* bag = NULL;
+    uint8_t* out = NULL;
+    HRESULT hr = CreateStreamOnHGlobal(NULL, TRUE, &ms);
+    if (SUCCEEDED(hr)) hr = IWICImagingFactory_CreateEncoder(F, &GUID_ContainerFormatPng, NULL, &enc);
+    if (SUCCEEDED(hr)) hr = IWICBitmapEncoder_Initialize(enc, ms, WICBitmapEncoderNoCache);
+    if (SUCCEEDED(hr)) hr = IWICBitmapEncoder_CreateNewFrame(enc, &fr, &bag);
+    if (SUCCEEDED(hr)) hr = IWICBitmapFrameEncode_Initialize(fr, bag);
+    if (SUCCEEDED(hr)) hr = IWICBitmapFrameEncode_SetSize(fr, w, h);
+    WICPixelFormatGUID got = *pf;
+    if (SUCCEEDED(hr)) hr = IWICBitmapFrameEncode_SetPixelFormat(fr, &got);
+    if (SUCCEEDED(hr) && memcmp(&got, pf, sizeof got)) hr = E_FAIL;    /* no silent conversion */
+    if (SUCCEEDED(hr)) hr = IWICBitmapFrameEncode_WritePixels(fr, h, stride, stride * h, (BYTE*)px);
+    if (SUCCEEDED(hr)) hr = IWICBitmapFrameEncode_Commit(fr);
+    if (SUCCEEDED(hr)) hr = IWICBitmapEncoder_Commit(enc);
+    if (SUCCEEDED(hr)) {
+        STATSTG st; LARGE_INTEGER z = {0};
+        if (SUCCEEDED(ms->lpVtbl->Stat(ms, &st, STATFLAG_NONAME)) && st.cbSize.QuadPart > 0 &&
+            st.cbSize.QuadPart < (1ll << 31) && SUCCEEDED(ms->lpVtbl->Seek(ms, z, STREAM_SEEK_SET, NULL))) {
+            out = (uint8_t*)malloc((size_t)st.cbSize.QuadPart);
+            ULONG r = 0;
+            if (out && SUCCEEDED(ms->lpVtbl->Read(ms, out, (ULONG)st.cbSize.QuadPart, &r)) && r == (ULONG)st.cbSize.QuadPart)
+                *out_n = r;
+            else { free(out); out = NULL; }
+        }
+    }
+    if (bag) bag->lpVtbl->Release(bag);
+    if (fr) IWICBitmapFrameEncode_Release(fr);
+    if (enc) IWICBitmapEncoder_Release(enc);
+    if (ms) ms->lpVtbl->Release(ms);
+    return out;
+}
+
+/* Decode an image file in memory to the pixel format `want` with `bpp` bytes
+ * per pixel (32bppRGBA 4, 8bppGray 1, 16bppGray 2, 64bppRGBA 8), through
+ * WIC's converter. Dimensions are checked against the caps before decoding.
+ * Returns a malloc'd tightly packed image or NULL (err set). */
+TP_FN uint8_t* tp_img_decode(const uint8_t* data, size_t n, const GUID* want, uint32_t bpp,
+                             uint32_t* w, uint32_t* h, const char** err)
+{
+    IWICImagingFactory* F = tp_wic();
+    if (!F) { *err = "no WIC"; return NULL; }
+    if (n > 0xFFFFFFFFu) { *err = "file too large"; return NULL; }
+    { uint32_t iw, ih; int dep, ct;     /* a PNG: refuse a huge one from its header */
+      if (!tp_png_ihdr(data, n, &iw, &ih, &dep, &ct) &&
+          (iw > TP_MAX_REP_DIM || ih > TP_MAX_REP_DIM || (uint64_t)iw * ih * bpp > TP_MAX_REP_BYTES)) {
+          *err = "image too large"; return NULL; } }
+    IWICStream* st = NULL; IWICBitmapDecoder* dec = NULL; IWICBitmapFrameDecode* fr = NULL; IWICFormatConverter* cv = NULL;
+    uint8_t* out = NULL;
+    HRESULT hr = IWICImagingFactory_CreateStream(F, &st);
+    if (SUCCEEDED(hr)) hr = IWICStream_InitializeFromMemory(st, (BYTE*)data, (DWORD)n);
+    if (SUCCEEDED(hr)) hr = IWICImagingFactory_CreateDecoderFromStream(F, (IStream*)st, NULL, WICDecodeMetadataCacheOnDemand, &dec);
+    if (SUCCEEDED(hr)) hr = IWICBitmapDecoder_GetFrame(dec, 0, &fr);
+    UINT W = 0, H = 0;
+    if (SUCCEEDED(hr)) hr = IWICBitmapFrameDecode_GetSize(fr, &W, &H);
+    if (SUCCEEDED(hr) && (!W || !H || W > TP_MAX_REP_DIM || H > TP_MAX_REP_DIM ||
+                          (uint64_t)W * H * bpp > TP_MAX_REP_BYTES)) { *err = "image too large"; hr = E_FAIL; }
+    if (SUCCEEDED(hr)) hr = IWICImagingFactory_CreateFormatConverter(F, &cv);
+    if (SUCCEEDED(hr)) hr = IWICFormatConverter_Initialize(cv, (IWICBitmapSource*)fr, want, WICBitmapDitherTypeNone,
+                                                           NULL, 0.0, WICBitmapPaletteTypeCustom);
+    if (SUCCEEDED(hr)) {
+        out = (uint8_t*)malloc((size_t)W * H * bpp);
+        if (!out) hr = E_OUTOFMEMORY;
+        else hr = IWICFormatConverter_CopyPixels(cv, NULL, W * bpp, W * H * bpp, out);
+    }
+    if (FAILED(hr)) { free(out); out = NULL; if (!*err) *err = "image decode failed"; }
+    else { *w = W; *h = H; }
+    if (cv) IWICFormatConverter_Release(cv);
+    if (fr) IWICBitmapFrameDecode_Release(fr);
+    if (dec) IWICBitmapDecoder_Release(dec);
+    if (st) IWICStream_Release(st);
+    return out;
+}
+
+/* ---------------------------------------------------------------------------
+ * A replacement image in memory: the subresources a D3D12 texture is built
+ * from (face f, level m at f * levels + m), tightly packed rows.
+ * -----------------------------------------------------------------------*/
+typedef struct {
+    uint32_t dxgi;                 /* the resource's format (UNORM/SNORM, never _SRGB) */
+    uint32_t w, h, levels, faces;
+    uint8_t* sub[TP_MAX_SUB];      /* NULL-terminated use: faces * levels entries      */
+    uint32_t row_bytes[16], rows[16];
+    uint8_t* own[2 * TP_MAX_SUB + 2]; /* buffers to free                                 */
+    int nown;
+} tp_img;
+TP_FN void tp_img_free(tp_img* im)
+{
+    for (int i = 0; i < im->nown; i++) free(im->own[i]);
+    memset(im, 0, sizeof *im);
+}
+TP_FN uint64_t tp_img_bytes(const tp_img* im)
+{
+    uint64_t b = 0;
+    for (uint32_t m = 0; m < im->levels; m++) b += (uint64_t)im->row_bytes[m] * im->rows[m];
+    return b * im->faces;
+}
+static inline int tp_img_own(tp_img* im, uint8_t* p)
+{
+    if (im->nown >= (int)(sizeof im->own / sizeof im->own[0])) { free(p); return -1; }
+    im->own[im->nown++] = p;
+    return 0;
+}
+
+/* Generate levels 1.. for an uncompressed 8/16-bit image that has only some
+ * of them (linear: average colour in linear light; R8G8_SNORM data is
+ * averaged as signed bytes). 0 = ok. */
+TP_FN int tp_img_gen_mips(tp_img* im, uint32_t want_levels, int linear)
+{
+    int blk; const uint32_t sz = tp_dxgi_size(im->dxgi, &blk);
+    if (blk || !sz) return 0;                       /* block-compressed: what the file has */
+    uint32_t ch = 0, w16 = 0;
+    switch (im->dxgi) {
+    case TP_DXGI_R8G8B8A8_UNORM: ch = 4; break;
+    case TP_DXGI_R8G8_UNORM: case TP_DXGI_R8G8_SNORM: ch = 2; break;
+    case TP_DXGI_R8_UNORM: ch = 1; break;
+    case TP_DXGI_R16_UNORM: ch = 1; w16 = 1; break;
+    case TP_DXGI_R16G16_UNORM: ch = 2; w16 = 1; break;
+    default: return 0;                              /* floats: what the file has */
+    }
+    const uint32_t full = tp_full_levels(im->w, im->h);
+    if (want_levels > full) want_levels = full;
+    if (im->levels >= want_levels) return 0;
+    if ((uint64_t)im->faces * want_levels > TP_MAX_SUB) return -1;
+    /* each face keeps its levels and gets the missing ones appended, so the
+     * subresource array (face * levels + level) is rebuilt */
+    uint8_t* nsub[TP_MAX_SUB] = {0};
+    const uint32_t old = im->levels;
+    for (uint32_t f = 0; f < im->faces; f++) {
+        for (uint32_t m = 0; m < old; m++) nsub[f * want_levels + m] = im->sub[f * old + m];
+        for (uint32_t m = old; m < want_levels; m++) {
+            const uint32_t pw = (im->w >> (m - 1)) ? (im->w >> (m - 1)) : 1u, ph = (im->h >> (m - 1)) ? (im->h >> (m - 1)) : 1u;
+            const uint32_t lw = (im->w >> m) ? (im->w >> m) : 1u, lh = (im->h >> m) ? (im->h >> m) : 1u;
+            uint8_t* d = (uint8_t*)malloc((size_t)lw * lh * sz);
+            if (!d || tp_img_own(im, d)) return -1;
+            const uint8_t* s = nsub[f * want_levels + m - 1];
+            if (w16) tp_mip_down16((const uint16_t*)s, pw, ph, ch, (uint16_t*)d);
+            else if (im->dxgi == TP_DXGI_R8G8_SNORM) {
+                /* signed bytes: offset binary, average, back */
+                const size_t pn = (size_t)pw * ph * ch;
+                uint8_t* t = (uint8_t*)malloc(pn);
+                if (!t) return -1;
+                for (size_t i = 0; i < pn; i++) t[i] = (uint8_t)(s[i] ^ 0x80u);
+                tp_mip_down8(t, pw, ph, ch, d, 0);
+                for (size_t i = 0; i < (size_t)lw * lh * ch; i++) d[i] ^= 0x80u;
+                free(t);
+            } else tp_mip_down8(s, pw, ph, ch, d, linear && ch == 4);
+            nsub[f * want_levels + m] = d;
+        }
+    }
+    memcpy(im->sub, nsub, sizeof nsub);
+    for (uint32_t m = 0; m < want_levels; m++) {
+        const uint32_t lw = (im->w >> m) ? (im->w >> m) : 1u, lh = (im->h >> m) ? (im->h >> m) : 1u;
+        tp_dxgi_level_bytes(im->dxgi, lw, lh, &im->row_bytes[m], &im->rows[m]);
+    }
+    im->levels = want_levels;
+    return 0;
+}
+
+/* Decode a pack file (PNG or DDS bytes) for a guest texture of class `cls`.
+ * Fills `im` with a full mip chain where it can be generated. Returns 0, or
+ * -1 with *err set. `data` must outlive `im` (DDS subresources point into it). */
+TP_FN int tp_img_load(const uint8_t* data, size_t n, int kind, int cls, int mip_linear, tp_img* im, const char** err)
+{
+    memset(im, 0, sizeof *im);
+    if (kind == TP_KIND_DDS) {
+        tp_dds_info di;
+        if (tp_dds_parse(data, n, &di)) { *err = di.err; return -1; }
+        if (!tp_class_accepts_dxgi(cls, di.dxgi)) { *err = "DDS format does not fit the texture's class"; return -1; }
+        if (di.w > TP_MAX_REP_DIM || di.h > TP_MAX_REP_DIM) { *err = "image too large"; return -1; }
+        im->w = di.w; im->h = di.h; im->levels = di.levels; im->faces = di.faces;
+        im->dxgi = tp_dxgi_unorm(di.dxgi);
+        for (uint32_t m = 0; m < di.levels; m++) { im->row_bytes[m] = di.row_bytes[m]; im->rows[m] = di.rows[m]; }
+        for (uint32_t i = 0; i < di.faces * di.levels; i++) im->sub[i] = (uint8_t*)(data + di.off[i]);
+        if (im->dxgi == TP_DXGI_B8G8R8A8_UNORM || im->dxgi == TP_DXGI_B8G8R8X8_UNORM) {
+            const int x = im->dxgi == TP_DXGI_B8G8R8X8_UNORM;
+            for (uint32_t i = 0; i < di.faces * di.levels; i++) {
+                const uint32_t m = i % di.levels;
+                const size_t nb = (size_t)im->row_bytes[m] * im->rows[m];
+                uint8_t* c = (uint8_t*)malloc(nb);
+                if (!c) { tp_img_free(im); *err = "out of memory"; return -1; }
+                if (tp_img_own(im, c)) { tp_img_free(im); *err = "out of memory"; return -1; }
+                for (size_t k = 0; k < nb; k += 4) {
+                    c[k] = im->sub[i][k + 2]; c[k + 1] = im->sub[i][k + 1]; c[k + 2] = im->sub[i][k];
+                    c[k + 3] = x ? 255 : im->sub[i][k + 3];
+                }
+                im->sub[i] = c;
+            }
+            im->dxgi = TP_DXGI_R8G8B8A8_UNORM;
+        }
+        if (tp_img_bytes(im) > TP_MAX_REP_BYTES) { tp_img_free(im); *err = "image too large"; return -1; }
+        if (tp_img_gen_mips(im, tp_full_levels(im->w, im->h), mip_linear)) { tp_img_free(im); *err = "out of memory"; return -1; }
+        return 0;
+    }
+    if (kind != TP_KIND_PNG) { *err = "unknown file kind"; return -1; }
+    const GUID* pf; uint32_t bpp, dxgi;
+    switch (cls) {
+    case TP_CLS_RGBA8: case TP_CLS_BC1: case TP_CLS_BC2: case TP_CLS_BC3:
+        pf = &GUID_WICPixelFormat32bppRGBA; bpp = 4; dxgi = TP_DXGI_R8G8B8A8_UNORM; break;
+    case TP_CLS_R8G8: case TP_CLS_R8G8S:
+        pf = &GUID_WICPixelFormat32bppRGBA; bpp = 4; dxgi = cls == TP_CLS_R8G8S ? TP_DXGI_R8G8_SNORM : TP_DXGI_R8G8_UNORM; break;
+    case TP_CLS_R8:     pf = &GUID_WICPixelFormat8bppGray;  bpp = 1; dxgi = TP_DXGI_R8_UNORM; break;
+    case TP_CLS_R16:    pf = &GUID_WICPixelFormat16bppGray; bpp = 2; dxgi = TP_DXGI_R16_UNORM; break;
+    case TP_CLS_R16G16: pf = &GUID_WICPixelFormat64bppRGBA; bpp = 8; dxgi = TP_DXGI_R16G16_UNORM; break;
+    default: *err = "PNG cannot replace this class (floats need DDS)"; return -1;
+    }
+    uint32_t w = 0, h = 0;
+    uint8_t* px = tp_img_decode(data, n, pf, bpp, &w, &h, err);
+    if (!px) return -1;
+    if (tp_img_own(im, px)) { *err = "out of memory"; return -1; }
+    if (cls == TP_CLS_R8G8 || cls == TP_CLS_R8G8S) {          /* (R, G) of RGBA */
+        uint8_t* rg = (uint8_t*)malloc((size_t)w * h * 2);
+        if (!rg) { tp_img_free(im); *err = "out of memory"; return -1; }
+        for (size_t i = 0; i < (size_t)w * h; i++) { rg[i * 2] = px[i * 4]; rg[i * 2 + 1] = px[i * 4 + 1]; }
+        if (tp_img_own(im, rg)) { tp_img_free(im); *err = "out of memory"; return -1; }
+        px = rg;
+    } else if (cls == TP_CLS_R16G16) {                          /* (R, G) of RGBA64 */
+        uint16_t* rg = (uint16_t*)malloc((size_t)w * h * 4);
+        if (!rg) { tp_img_free(im); *err = "out of memory"; return -1; }
+        const uint16_t* s = (const uint16_t*)px;
+        for (size_t i = 0; i < (size_t)w * h; i++) { rg[i * 2] = s[i * 4]; rg[i * 2 + 1] = s[i * 4 + 1]; }
+        if (tp_img_own(im, (uint8_t*)rg)) { tp_img_free(im); *err = "out of memory"; return -1; }
+        px = (uint8_t*)rg;
+    }
+    im->dxgi = dxgi; im->w = w; im->h = h; im->levels = 1; im->faces = 1;
+    tp_dxgi_level_bytes(dxgi, w, h, &im->row_bytes[0], &im->rows[0]);
+    im->sub[0] = px;
+    if (tp_img_gen_mips(im, tp_full_levels(w, h), mip_linear)) { tp_img_free(im); *err = "out of memory"; return -1; }
+    return 0;
+}
+
+/* Checks a decoded image against the texture it replaces: aspect and a
+ * power-of-two scale (s), cube faces, a block-compressed top level in whole
+ * blocks unless `unaligned_bc` (the device takes BC textures whose top level
+ * is not whole blocks: D3D12 OPTIONS8, which the backend's own uploads of
+ * such guest textures, e.g. a 256x1 DXT1, rely on). 0 = ok. */
+TP_FN int tp_img_fits_ex(const tp_img* im, uint32_t ow, uint32_t oh, int cube, int unaligned_bc, int* s, const char** err)
+{
+    if ((im->faces == 6) != (cube != 0)) { *err = cube ? "a cube texture needs a 6-face DDS" : "a cube DDS for a 2D texture"; return -1; }
+    if (!tp_scale_log2(ow, oh, im->w, im->h, s)) { *err = "size is not the original's times a power of two (1/4 .. 16)"; return -1; }
+    int blk; tp_dxgi_size(im->dxgi, &blk);
+    if (blk && !unaligned_bc && ((im->w & 3u) || (im->h & 3u))) { *err = "block-compressed size not a multiple of 4 (the device needs whole blocks)"; return -1; }
+    return 0;
+}
+TP_FN int tp_img_fits(const tp_img* im, uint32_t ow, uint32_t oh, int cube, int* s, const char** err)
+{
+    return tp_img_fits_ex(im, ow, oh, cube, 0, s, err);
+}
+
+#endif /* _WIN32 */
+#endif /* PS3RECOMP_RSX_TEXPACK_IO_H */
diff --git a/libs/video/rsx_texpack_rt.h b/libs/video/rsx_texpack_rt.h
