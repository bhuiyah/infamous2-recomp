diff --git a/runtime/syscalls/wait_events.h b/runtime/syscalls/wait_events.h
new file mode 100644
index 0000000..99e3335
--- /dev/null
+++ b/runtime/syscalls/wait_events.h
@@ -0,0 +1,139 @@
+/*
+ * ps3recomp - event-driven guest poll waits (WAIT_EVENTS)
+ *
+ * A guest poll loop -- `while (!cond) sys_timer_usleep(N)` -- re-reads guest
+ * memory after every sleep. Sub-millisecond sleeps are a SwitchToThread + QPC
+ * spin in this runtime (sys_timer.c), so such a loop burns a host core for as
+ * long as it waits, and a long period (a 900 us poll) only notices the change
+ * up to a period late.
+ *
+ * A "site" names one such loop by the address of its `sc` (ppu_context.sc_ra)
+ * AND the values ctx->lr can have there (the loop's own call sites, or its
+ * callers' when it makes no call) -- sc_ra alone can be stale: code lifted
+ * without the sc_ra store (libsre_ns: its spin lock at 0x3000BF10 sleeps with
+ * usleep(100)) leaves the LAST recorded `sc` in it, so a thread that polled a
+ * site and then sleeps in such code would look like the site with unrelated
+ * registers. The site supplies two callbacks:
+ *   arm(ctx, usec, w)  on the waiting thread, at the usleep: read the guest
+ *                      registers, fill `w` with the guest memory the loop
+ *                      re-checks (ranges) and whatever ready() needs (p[]).
+ *                      Return 0 to leave this call alone (plain sleep).
+ *   ready(w)           1 once the loop's condition would pass. Guest memory
+ *                      reads only, no side effects; called on the waiter and
+ *                      on whatever thread just wrote guest memory.
+ * The usleep then blocks on a host event instead of spinning, and the writers
+ * -- an SPU PUT/PUTLLC/PUTLLUC landing in a watched range, the RSX walker
+ * writing a label into one, a PPU thread entering lv2 (its stores precede the
+ * `sc`) -- evaluate ready() and wake it. The sleep ends at the latest after
+ * the original period rounded up to the host timer slice
+ * (WAIT_EVENTS_SLICE_US), so a missed wake costs one poll, never a hang; it
+ * ends early only when ready() holds. After waking the guest
+ * re-reads memory exactly as before: what it computes is unchanged; only how
+ * many times it polls (already timing-dependent) and how much host CPU the
+ * wait costs change. A call whose ready() is already true sleeps the plain
+ * way -- the guest wants more than the site's predicate checks, so it gets
+ * today's poll period.
+ *
+ * Sites are title-specific (the title registers them at startup, after the
+ * EBOOT is mapped). WAIT_EVENTS=0 turns everything off (today's spin).
+ */
+#ifndef PS3RECOMP_WAIT_EVENTS_H
+#define PS3RECOMP_WAIT_EVENTS_H
+
+#include <stdint.h>
+#include <string.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Writer classes (bit index = slot mask index). */
+#define WEV_SRC_PPU 0x1u   /* a guest PPU thread entered lv2_syscall */
+#define WEV_SRC_SPU 0x2u   /* an SPU PUT / PUTLLC / PUTLLUC committed to main memory */
+#define WEV_SRC_RSX 0x4u   /* the RSX walker (or a GCM HLE call) wrote a label */
+#define WEV_SRC_ALL 0x7u
+
+#define WEV_MAX_RANGES 4
+#define WEV_MAX_PARAMS 12
+#define WEV_MAX_SCRA   4
+#define WEV_MAX_LR     4
+
+typedef struct wev_watch {
+    uint32_t src;                      /* writer classes that can make ready() true
+                                        * (preset WEV_SRC_ALL; arm() may narrow it --
+                                        * a class left out is noticed at the timeout) */
+    uint32_t n;                        /* ranges used (0..WEV_MAX_RANGES) */
+    uint32_t ea[WEV_MAX_RANGES];       /* guest ranges whose SPU/RSX writes are worth a look */
+    uint32_t len[WEV_MAX_RANGES];
+    uint32_t p[WEV_MAX_PARAMS];        /* site parameters (guest addresses, targets) */
+} wev_watch;
+
+struct ppu_context;
+
+typedef struct wev_site {
+    const char* name;
+    uint32_t    sc_ra[WEV_MAX_SCRA];   /* ctx->sc_ra of each `sc` of the loop; 0 = unused */
+    int  (*arm)(const struct ppu_context* ctx, uint64_t usec, wev_watch* w);
+    int  (*ready)(const wev_watch* w);
+    uint32_t    lr[WEV_MAX_LR];        /* ctx->lr values at those `sc`s; all 0 = any
+                                        * (a call with another lr sleeps the plain way) */
+} wev_site;
+
+/* Register a site (static storage; the table keeps the pointer). Returns 1 if
+ * it is active, 0 if WAIT_EVENTS=0 or the table is full. Call before the
+ * guest runs. */
+int wev_register(const wev_site* site);
+
+/* 1 when WAIT_EVENTS is on (reads the environment on the first call). */
+int wev_enabled(void);
+
+/* 1 once a site is registered (WAIT_EVENTS on); never changes after boot. */
+extern volatile uint32_t g_wev_on;
+/* Slots blocked right now (bit i = slot i): any class, and per class. */
+extern volatile uint32_t g_wev_any;
+extern volatile uint32_t g_wev_mask[3];
+
+/* Slow path: some waiter is blocked. [ea, ea+size) is the guest range
+ * written (ignored for WEV_SRC_PPU, which has no range). */
+void wev_poke(uint32_t src, uint32_t ea, uint32_t size);
+
+/* Writer hook, after the guest store. WAIT_EVENTS off: one load. On: a
+ * PPU / RSX note first orders its store before the look at g_wev_any
+ * (StoreLoad), so a waiter publishing at the same instant either sees the
+ * store on its re-check or is seen here -- no missed wake; SPU notes skip
+ * the fence (hot path; a race costs one slice), and wev_note_fenced is for
+ * callers that just executed a locked instruction (the PUTLLC commit). */
+static inline void wev_note_fenced(uint32_t src, uint32_t ea, uint32_t size)
+{
+    if (__builtin_expect(__atomic_load_n(&g_wev_any, __ATOMIC_RELAXED) != 0u, 0))
+        wev_poke(src, ea, size);
+}
+static inline void wev_note(uint32_t src, uint32_t ea, uint32_t size)
+{
+    if (__builtin_expect(__atomic_load_n(&g_wev_on, __ATOMIC_RELAXED) != 0u, 0)) {
+        if (src != WEV_SRC_SPU) __atomic_thread_fence(__ATOMIC_SEQ_CST);
+        wev_note_fenced(src, ea, size);
+    }
+}
+
+/* Big-endian guest reads for ready() callbacks (vm_base: runtime/memory/vm.h;
+ * every 32-bit guest offset is mapped -- the host demand-commits on fault).
+ * Raw loads: none of the guest accessor's side effects, so a watch must never
+ * name a word whose guest load does something (the GCM ref register's
+ * read-driven fence publication, the raw-SPU problem-state window). */
+extern uint8_t* vm_base;
+static inline uint32_t wev_rd32(uint32_t ea)
+{
+    uint32_t v; memcpy(&v, vm_base + ea, 4); return __builtin_bswap32(v);
+}
+static inline uint32_t wev_rd16(uint32_t ea)
+{
+    uint16_t v; memcpy(&v, vm_base + ea, 2); return (uint32_t)__builtin_bswap16(v);
+}
+static inline uint32_t wev_rd8(uint32_t ea) { return vm_base[ea]; }
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_WAIT_EVENTS_H */
diff --git a/runtime/syscalls/wait_events.inc b/runtime/syscalls/wait_events.inc
new file mode 100644
index 0000000..7d89898
--- /dev/null
+++ b/runtime/syscalls/wait_events.inc
@@ -0,0 +1,463 @@
+/*
+ * ps3recomp - event-driven guest poll waits: implementation (WAIT_EVENTS).
+ * Included by sys_timer.c (no translation unit of its own, so no build-file
+ * change), after ensure_qpc_init / s_qpc_freq. Interface and contract:
+ * wait_events.h.
+ *
+ * One wait, host side:
+ *   1. the usleep's ctx->sc_ra AND ctx->lr name a registered site (sc_ra
+ *      alone can be stale, see wait_events.h); arm() captures what the loop
+ *      re-checks. If ready() already holds, the call sleeps the plain way: the
+ *      guest wants more than the predicate checks, so it keeps today's poll
+ *      period.
+ *   2. the thread's slot publishes the watch (seqlock) and sets its bit in
+ *      g_wev_mask[class] for each writer class it listens to and in
+ *      g_wev_any (locked RMWs = full fences), then
+ *      looks once more -- a write that landed between arm() and the publish
+ *      was not poked about -- then blocks on its event and its high-resolution
+ *      timer.
+ *   3. a writer that sees the bit filters on the watched range, evaluates
+ *      ready() on a consistent copy of the watch and, if it holds, tags
+ *      `woken` with THAT watch's generation and signals the event (SetEvent;
+ *      ~4-8 us to the waiter running on this host). The waiter only ends early
+ *      on its own generation: a writer that evaluated an earlier watch of the
+ *      slot (its wait already over) cannot end the next one -- the waiter
+ *      drops that tag and looks at ready() itself.
+ *   4. the timer bounds the block at max(period, WAIT_EVENTS_SLICE_US), so a
+ *      missed or racing wake costs one poll, never a hang; a block nothing
+ *      woke never ends before the guest's own period (the timer, asked for
+ *      30 us less, can fire at its due time: the rest is the plain spin).
+ *      Either way the call returns and the guest re-reads memory itself.
+ * A wake only ever ENDS a sleep early when ready() holds -- when the guest's
+ * next check is about to pass -- so a loop polls at most as often as it does
+ * today (plus the poll a wrong predicate costs), never more; unlike
+ * USLEEP_CLAMP, which multiplies the polls of side-effecting loops.
+ *
+ * Writer-side ordering: a writer's guest store must be visible before it
+ * looks at g_wev_any, or a waiter publishing in the same few tens of
+ * nanoseconds misses both the store (on its re-check) and the poke. PPU and
+ * RSX notes fence (wev_note); the SPU PUTLLC / PUTLLUC commits note after a
+ * locked exchange (wev_note_fenced); plain SPU PUTs are left open on purpose
+ * -- a fence there would tax every DMA on the busiest threads -- and step 4
+ * covers them.
+ *
+ * Short-period loops (usec < WAIT_EVENTS_SPIN_US) keep today's spin for the
+ * first WAIT_EVENTS_SPIN_US of each episode (consecutive calls at one site),
+ * so a barrier that clears within microseconds never pays a block and a wake.
+ * Long-period loops block from the first call.
+ *
+ * Env (read once, at the first registration):
+ *   WAIT_EVENTS=0|1           off / on (default: on, or the build's
+ *                             -DWEV_DEFAULT_ON=0|1); off = today's spin
+ *   WAIT_EVENTS_SLICE_US=<n>  block bound for short periods (default 500)
+ *   WAIT_EVENTS_SPIN_US=<n>   spin-first window (default 20, 0 = never spin)
+ *   WAIT_EVENTS_SITES=a,b     only the named sites (default: all registered)
+ *   WAIT_EVENTS_STATS=1       per-site report every 2 s ([wev] lines; 'missed' =
+ *                             blocks that timed out with ready() already true:
+ *                             the pokes' failure rate. A long wait times out
+ *                             once per slice by design, so 'timeout' alone
+ *                             says little; 'stale-sc_ra' = calls whose sc_ra
+ *                             named the site but whose lr did not)
+ *   WAIT_EVENTS_GCMPOKE=0|1   while a waiter is blocked, writer pokes also run
+ *                             the usleep-entry hook (default 1; see wev_poke)
+ *   WAIT_EVENTS_BOOST=0|1     block at THREAD_PRIORITY_HIGHEST (default 0):
+ *                             the wake then preempts a busy normal-priority
+ *                             thread instead of queueing behind it on an
+ *                             oversubscribed host; the thread's own priority
+ *                             is back before the guest runs again
+ */
+#include "wait_events.h"
+
+#ifndef WEV_DEFAULT_ON
+#define WEV_DEFAULT_ON 1
+#endif
+
+#ifdef _WIN32
+
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+
+#define WEV_MAX_SITES 16
+#define WEV_MAX_SLOTS 8
+
+static const wev_site* s_wev_site[WEV_MAX_SITES];
+static volatile LONG   s_wev_nsites;
+static volatile LONG   s_wev_cfg = -1;           /* -1 = env not read yet, 0 off, 1 on */
+static unsigned s_wev_slice_us = 500, s_wev_spin_us = 20;
+static int s_wev_stats_on;
+static int s_wev_boost = 0, s_wev_gcmpoke = 1;
+static const char* s_wev_only;                   /* WAIT_EVENTS_SITES */
+
+volatile uint32_t g_wev_on;
+volatile uint32_t g_wev_any;
+volatile uint32_t g_wev_mask[3];
+
+typedef struct wev_stat {
+    volatile LONG64 calls, plain_ready, plain_spin, noarm, lr_miss, blocks;
+    volatile LONG64 w_signal, w_timeout, w_late, w_missed, stale;
+    volatile LONG64 qpc_blocked, qpc_lat, n_lat;
+    volatile LONG64 poke_eval, poke_hit;
+} wev_stat;
+static wev_stat s_wev_st[WEV_MAX_SITES];
+
+/* One per waiting guest thread, each on its own cache lines: the owner
+ * rewrites it at every block while writers on other cores read it. */
+typedef struct __attribute__((aligned(128))) wev_slot {
+    volatile LONG     seq;        /* seqlock over site / w / lo / hi: odd while rewritten */
+    volatile LONG     woken;      /* 0 while blocked; the waking poke stores the
+                                   * generation it evaluated (its even seq | 1) */
+    volatile LONG     site_ix;
+    volatile uint32_t lo, hi;     /* hull of the watched ranges: the writers' first filter */
+    const wev_site*   site;
+    wev_watch         w;
+    HANDLE            ev, timer;
+    volatile LONGLONG t_poke;     /* QPC of the waking poke (stats) */
+    /* owner-only */
+    int               ep_site;    /* episode: site index, -1 none */
+    LONGLONG          ep_start, ep_last;
+} wev_slot;
+static wev_slot s_wev_slot[WEV_MAX_SLOTS];
+static volatile LONG s_wev_nslots;
+static volatile signed char s_wev_tid_slot[256];  /* guest tid -> slot + 1; -1 = none available */
+
+static void wev_cfg_init(void)
+{
+    if (s_wev_cfg >= 0) return;
+    const char* e = getenv("WAIT_EVENTS");
+    const int on = e && *e ? (*e != '0') : WEV_DEFAULT_ON;
+    const char* s = getenv("WAIT_EVENTS_SLICE_US");
+    if (s) { long v = atol(s); if (v < 50) v = 50; if (v > 20000) v = 20000; s_wev_slice_us = (unsigned)v; }
+    s = getenv("WAIT_EVENTS_SPIN_US");
+    if (s) { long v = atol(s); if (v < 0) v = 0; if (v > 2000) v = 2000; s_wev_spin_us = (unsigned)v; }
+    s = getenv("WAIT_EVENTS_STATS"); s_wev_stats_on = (s && *s && *s != '0');
+    s = getenv("WAIT_EVENTS_BOOST"); if (s && *s) s_wev_boost = (*s != '0');
+    s = getenv("WAIT_EVENTS_GCMPOKE"); if (s && *s) s_wev_gcmpoke = (*s != '0');
+    s_wev_only = getenv("WAIT_EVENTS_SITES");
+    ensure_qpc_init();
+    InterlockedExchange(&s_wev_cfg, on);   /* racing first callers compute the same values */
+}
+
+int wev_enabled(void) { wev_cfg_init(); return s_wev_cfg > 0; }
+
+static int wev_name_listed(const char* name)
+{
+    if (!s_wev_only || !*s_wev_only) return 1;
+    const size_t n = strlen(name);
+    for (const char* p = s_wev_only; *p; ) {
+        const char* q = p; while (*q && *q != ',') q++;
+        if ((size_t)(q - p) == n && strncmp(p, name, n) == 0) return 1;
+        p = *q ? q + 1 : q;
+    }
+    return 0;
+}
+
+int wev_register(const wev_site* site)
+{
+    if (!wev_enabled() || !site || !site->arm || !site->ready || !site->name) return 0;
+    if (!wev_name_listed(site->name)) return 0;
+    const LONG i = InterlockedIncrement(&s_wev_nsites) - 1;
+    if (i >= WEV_MAX_SITES) { InterlockedDecrement(&s_wev_nsites); return 0; }
+    s_wev_site[i] = site;
+    InterlockedExchange((volatile LONG*)&g_wev_on, 1);
+    fprintf(stderr, "[wev] WAIT_EVENTS site %s active (sc_ra %08X %08X %08X %08X lr %08X %08X %08X %08X) "
+                    "slice=%uus spin=%uus boost=%d gcmpoke=%d\n",
+            site->name, site->sc_ra[0], site->sc_ra[1], site->sc_ra[2], site->sc_ra[3],
+            site->lr[0], site->lr[1], site->lr[2], site->lr[3],
+            s_wev_slice_us, s_wev_spin_us, s_wev_boost, s_wev_gcmpoke);
+    return 1;
+}
+
+static int wev_find_site(uint32_t ra)
+{
+    const LONG n = s_wev_nsites;
+    if (!ra) return -1;
+    for (LONG i = 0; i < n && i < WEV_MAX_SITES; i++)
+        for (int j = 0; j < WEV_MAX_SCRA; j++)
+            if (s_wev_site[i]->sc_ra[j] == ra) return (int)i;
+    return -1;
+}
+
+/* ctx->lr is one the site's loop can have at its `sc` (no list: any). A stale
+ * sc_ra -- a syscall from code lifted without the sc_ra store -- comes with
+ * that code's lr. */
+static int wev_lr_ok(const wev_site* site, uint32_t lr)
+{
+    if (!site->lr[0]) return 1;
+    for (int j = 0; j < WEV_MAX_LR; j++)
+        if (site->lr[j] && site->lr[j] == lr) return 1;
+    return 0;
+}
+
+static wev_slot* wev_slot_for(uint32_t tid)
+{
+    if (tid >= 256) return NULL;
+    const int v = s_wev_tid_slot[tid];
+    if (v > 0) return &s_wev_slot[v - 1];
+    if (v < 0) return NULL;
+    /* first wait of this guest thread: only it ever writes its entry */
+    const LONG i = InterlockedIncrement(&s_wev_nslots) - 1;
+    if (i >= WEV_MAX_SLOTS) { s_wev_tid_slot[tid] = -1; return NULL; }
+    wev_slot* sl = &s_wev_slot[i];
+    sl->ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+    sl->timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    if (!sl->timer) sl->timer = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+    sl->ep_site = -1;
+    if (!sl->ev || !sl->timer) { s_wev_tid_slot[tid] = -1; return NULL; }
+    s_wev_tid_slot[tid] = (signed char)(i + 1);
+    return sl;
+}
+
+static int wev_overlap(const wev_watch* w, uint32_t ea, uint32_t size)
+{
+    for (uint32_t i = 0; i < w->n && i < WEV_MAX_RANGES; i++)
+        if (ea < w->ea[i] + w->len[i] && w->ea[i] < ea + size) return 1;
+    return 0;
+}
+
+extern void (*g_lv2_usleep_hook)(void);   /* sys_timer.c, below */
+
+void wev_poke(uint32_t src, uint32_t ea, uint32_t size)
+{
+    /* A blocked waiter no longer enters sys_timer_usleep tens of thousands
+     * of times a second, and each entry ran g_lv2_usleep_hook: the GCM FIFO
+     * walker's fast wake for a word it idles on that nothing pokes about
+     * (`put` after a plain PPU store, a label an SPU atomic writes; see
+     * cellGcm_fifo_poke -- a load and a compare unless the walker is idle
+     * on a watch). Run it here instead, at the writes, while anyone is
+     * blocked: the walker's wakes come no later than with the spin. */
+    if (s_wev_gcmpoke && src != WEV_SRC_RSX) {
+        void (*h)(void) = g_lv2_usleep_hook;
+        if (h) h();
+    }
+    const uint32_t k = src == WEV_SRC_PPU ? 0u : src == WEV_SRC_SPU ? 1u : 2u;
+    uint32_t m = __atomic_load_n(&g_wev_mask[k], __ATOMIC_ACQUIRE);
+    while (m) {
+        const unsigned i = (unsigned)__builtin_ctz(m);
+        m &= m - 1u;
+        wev_slot* sl = &s_wev_slot[i];
+        if (__atomic_load_n(&sl->woken, __ATOMIC_RELAXED)) continue;
+        const LONG s0 = __atomic_load_n(&sl->seq, __ATOMIC_ACQUIRE);
+        if (s0 & 1) continue;                    /* being rewritten: the owner looks itself */
+        if (k != 0 && (ea >= sl->hi || ea + size <= sl->lo)) continue;   /* not near it */
+        const wev_site* site = sl->site;
+        const LONG six = sl->site_ix;
+        wev_watch w;
+        memcpy(&w, (const void*)&sl->w, sizeof w);
+        __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        if (__atomic_load_n(&sl->seq, __ATOMIC_RELAXED) != s0 || !site) continue;
+        if (k != 0 && !wev_overlap(&w, ea, size)) continue;
+        if (s_wev_stats_on) InterlockedIncrement64(&s_wev_st[six].poke_eval);
+        if (!site->ready(&w)) continue;
+        if (s_wev_stats_on) {
+            LARGE_INTEGER t; QueryPerformanceCounter(&t); sl->t_poke = t.QuadPart;
+            InterlockedIncrement64(&s_wev_st[six].poke_hit);
+        }
+        /* Tag the wake with the generation whose watch said ready: if that
+         * wait is already over, the waiter's next wait drops the tag. */
+        if (InterlockedCompareExchange(&sl->woken, s0 | 1, 0) == 0) SetEvent(sl->ev);
+    }
+}
+
+static void wev_report(LONGLONG now)
+{
+    static volatile LONGLONG t_win;
+    const LONGLONG t0 = t_win;
+    if (!t0) { InterlockedCompareExchange64(&t_win, now, 0); return; }
+    if ((double)(now - t0) < 2.0 * (double)s_qpc_freq.QuadPart) return;
+    if (InterlockedCompareExchange64(&t_win, now, t0) != t0) return;
+    const double win = (double)(now - t0) / (double)s_qpc_freq.QuadPart;
+    const double tick_us = 1e6 / (double)s_qpc_freq.QuadPart;
+    const LONG n = s_wev_nsites;
+    for (LONG i = 0; i < n && i < WEV_MAX_SITES; i++) {
+        wev_stat* st = &s_wev_st[i];
+        const LONG64 calls = InterlockedExchange64(&st->calls, 0);
+        const LONG64 blocks = InterlockedExchange64(&st->blocks, 0);
+        const LONG64 ws = InterlockedExchange64(&st->w_signal, 0), wt = InterlockedExchange64(&st->w_timeout, 0);
+        const LONG64 wl = InterlockedExchange64(&st->w_late, 0), stale = InterlockedExchange64(&st->stale, 0);
+        const LONG64 wm = InterlockedExchange64(&st->w_missed, 0);
+        const LONG64 pr = InterlockedExchange64(&st->plain_ready, 0), ps = InterlockedExchange64(&st->plain_spin, 0);
+        const LONG64 na = InterlockedExchange64(&st->noarm, 0), lm = InterlockedExchange64(&st->lr_miss, 0);
+        const LONG64 qb = InterlockedExchange64(&st->qpc_blocked, 0);
+        const LONG64 ql = InterlockedExchange64(&st->qpc_lat, 0), nl = InterlockedExchange64(&st->n_lat, 0);
+        const LONG64 pe = InterlockedExchange64(&st->poke_eval, 0), ph = InterlockedExchange64(&st->poke_hit, 0);
+        if (!calls && !pe && !lm) continue;
+        fprintf(stderr, "[wev] %.2fs %-13s calls/s %7.0f | blocked %6.0f/s %6.1f ms/s wake: signal %3.0f%% timeout %3.0f%% "
+                        "(missed %4.1f%%) late %3.0f%% poke->run %5.1f us | plain: ready %5.0f/s spin %6.0f/s no-arm %4.0f/s "
+                        "stale-sc_ra %4.0f/s | pokes eval %7.0f/s hit %5.0f/s stale %lld\n",
+                win, s_wev_site[i]->name, calls / win, blocks / win, qb * tick_us / 1000.0 / win,
+                blocks ? 100.0 * ws / blocks : 0.0, blocks ? 100.0 * wt / blocks : 0.0,
+                blocks ? 100.0 * wm / blocks : 0.0, blocks ? 100.0 * wl / blocks : 0.0,
+                nl ? ql * tick_us / nl : 0.0, pr / win, ps / win, na / win, lm / win, pe / win, ph / win,
+                (long long)stale);
+    }
+    fflush(stderr);
+}
+
+/* sys_timer_usleep's hook: 1 = this call was waited here, 0 = sleep the plain way. */
+static int wev_usleep(ppu_context* ctx, uint64_t usec)
+{
+    if (__builtin_expect(s_wev_nsites == 0, 1) || usec == 0) return 0;
+    const int six = wev_find_site(ctx->sc_ra);
+    if (six < 0) return 0;
+    const wev_site* site = s_wev_site[six];
+    wev_stat* st = &s_wev_st[six];
+    if (!wev_lr_ok(site, (uint32_t)ctx->lr)) {   /* a stale sc_ra: not this loop */
+        if (s_wev_stats_on) InterlockedIncrement64(&st->lr_miss);
+        return 0;
+    }
+    /* Save states (armed by default since M4a) need no guard here: a usleep
+     * longer than one save-state slice never gets this far (sys_timer.c
+     * sleeps it in slices with park points), and a shorter one had its park
+     * point at the start of the usleep (SS_WAIT_POINT) and blocks below for at
+     * most max(usec, WAIT_EVENTS_SLICE_US) -- within one slice, the same delay
+     * a sliced wait gives a stop. */
+    wev_slot* sl = wev_slot_for((uint32_t)ctx->thread_id);
+    if (!sl) return 0;
+    LARGE_INTEGER t0; QueryPerformanceCounter(&t0);
+    const LONGLONG f = s_qpc_freq.QuadPart;
+    if (s_wev_stats_on) { InterlockedIncrement64(&st->calls); wev_report(t0.QuadPart); }
+
+    /* Episode: consecutive calls at this site (the previous one ended less
+     * than max(period, slice) + 200 us ago). Short polls spin through its start. */
+    {
+        const uint64_t per = usec > s_wev_slice_us ? usec : s_wev_slice_us;
+        const LONGLONG gap = (LONGLONG)(per + 200u) * f / 1000000;
+        if (sl->ep_site != six || t0.QuadPart - sl->ep_last > gap) {
+            sl->ep_site = six; sl->ep_start = t0.QuadPart;
+        }
+        if (usec < s_wev_spin_us &&
+            t0.QuadPart - sl->ep_start < (LONGLONG)s_wev_spin_us * f / 1000000) {
+            sl->ep_last = t0.QuadPart + (LONGLONG)usec * f / 1000000;   /* when the plain sleep ends */
+            if (s_wev_stats_on) InterlockedIncrement64(&st->plain_spin);
+            return 0;
+        }
+    }
+
+    wev_watch w;
+    memset(&w, 0, sizeof w);
+    w.src = WEV_SRC_ALL;
+    if (!site->arm((const struct ppu_context*)ctx, usec, &w) || !(w.src & WEV_SRC_ALL) ||
+        w.n > WEV_MAX_RANGES) {
+        if (s_wev_stats_on) InterlockedIncrement64(&st->noarm);
+        sl->ep_last = t0.QuadPart;
+        return 0;
+    }
+    if (site->ready(&w)) {
+        if (s_wev_stats_on) InterlockedIncrement64(&st->plain_ready);
+        sl->ep_last = t0.QuadPart + (LONGLONG)usec * f / 1000000;
+        return 0;
+    }
+    uint32_t lo = 0xFFFFFFFFu, hi = 0;
+    for (uint32_t r = 0; r < w.n; r++) {
+        if (w.ea[r] < lo) lo = w.ea[r];
+        if (w.ea[r] + w.len[r] > hi) hi = w.ea[r] + w.len[r];
+    }
+
+    /* publish the watch, then the mask bits (locked RMWs: full fences) */
+    InterlockedIncrement(&sl->seq);                      /* odd: rewriting */
+    sl->site = site; sl->site_ix = six; sl->w = w; sl->lo = lo; sl->hi = hi;
+    const LONG tag = InterlockedIncrement(&sl->seq) | 1; /* even: stable; this wait's wake tag */
+    InterlockedExchange(&sl->woken, 0);
+    const uint32_t bit = 1u << (uint32_t)(sl - s_wev_slot);
+    for (uint32_t k = 0; k < 3; k++)
+        if (w.src & (1u << k)) InterlockedOr((volatile LONG*)&g_wev_mask[k], (LONG)bit);
+    InterlockedOr((volatile LONG*)&g_wev_any, (LONG)bit);
+
+    int how;   /* 0 signal, 1 timeout, 2 ready after the publish, 3 no timer (sleep the plain way) */
+    if (site->ready(&w)) how = 2;
+    else {
+        /* The HR timer fires on the first 0.5 ms tick AFTER the due time on
+         * this host (10..480 us -> ~520 us, 500 / 900 us -> ~1.0 ms), so ask
+         * for 30 us less: a 500 us bound then ends at ~520 us, not ~1 ms. */
+        const uint64_t tmo_us = usec > s_wev_slice_us ? usec : s_wev_slice_us;
+        const uint64_t due_us = tmo_us > 60u ? tmo_us - 30u : tmo_us;
+        LARGE_INTEGER due; due.QuadPart = -(LONGLONG)(due_us * 10u);   /* 100 ns units, relative */
+        how = 3;
+        if (SetWaitableTimer(sl->timer, &due, 0, NULL, NULL, FALSE)) {
+            how = 1;
+            int prio = THREAD_PRIORITY_ERROR_RETURN;   /* WAIT_EVENTS_BOOST */
+            if (s_wev_boost) {
+                prio = GetThreadPriority(GetCurrentThread());
+                if (prio == THREAD_PRIORITY_ERROR_RETURN || prio >= THREAD_PRIORITY_HIGHEST ||
+                    !SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST))
+                    prio = THREAD_PRIORITY_ERROR_RETURN;
+            }
+            HANDLE hs[2] = { sl->ev, sl->timer };
+            const DWORD cap_ms = (DWORD)(tmo_us / 1000u) + 50u;          /* the timer ends it; never forever */
+            for (;;) {
+                const DWORD r = WaitForMultipleObjects(2, hs, FALSE, cap_ms);
+                if (r == WAIT_OBJECT_0) {
+                    const LONG v = __atomic_load_n(&sl->woken, __ATOMIC_ACQUIRE);
+                    if (v == tag) { how = 0; break; }
+                    /* A late poke of an earlier wait. If it left its tag, drop
+                     * it, then look: a writer that saw the tag skipped us. */
+                    if (s_wev_stats_on) InterlockedIncrement64(&st->stale);
+                    if (v != 0) {
+                        InterlockedCompareExchange(&sl->woken, 0, v);
+                        if (site->ready(&w)) { how = 2; break; }
+                    }
+                    continue;
+                }
+                if (r == WAIT_FAILED) how = 3;                           /* sleep the plain way */
+                break;                                                   /* timer or cap: return */
+            }
+            if (prio != THREAD_PRIORITY_ERROR_RETURN) SetThreadPriority(GetCurrentThread(), prio);
+            if (how == 1) {
+                /* The timer can fire right at its due time, i.e. up to the 30 us
+                 * early asked for above: a wait nothing woke never ends before
+                 * the guest's own period (the plain sleep would not), so no poll
+                 * comes sooner than today's. The rest (<= 30 us) is a pause
+                 * spin -- not SwitchToThread, which on a busy host can hand the
+                 * core away for a whole quantum. */
+                const LONGLONG end = t0.QuadPart + (LONGLONG)((usec * (uint64_t)f) / 1000000u);
+                LARGE_INTEGER n; QueryPerformanceCounter(&n);
+                while (n.QuadPart < end) {
+                    if (__atomic_load_n(&sl->woken, __ATOMIC_ACQUIRE) == tag) { how = 0; break; }
+                    YieldProcessor();
+                    QueryPerformanceCounter(&n);
+                }
+            }
+        }
+    }
+    /* Stats: a timeout with ready() already true and no poke under way -- a
+     * wake that never came (checked while still published, so a write racing
+     * the timer, whose poke is in flight, is not counted). */
+    const int missed = how == 1 && s_wev_stats_on && __atomic_load_n(&sl->woken, __ATOMIC_ACQUIRE) != tag &&
+                       site->ready(&w);
+    InterlockedAnd((volatile LONG*)&g_wev_any, (LONG)~bit);
+    for (uint32_t k = 0; k < 3; k++)
+        if (w.src & (1u << k)) InterlockedAnd((volatile LONG*)&g_wev_mask[k], (LONG)~bit);
+
+    LARGE_INTEGER t1; QueryPerformanceCounter(&t1);
+    sl->ep_last = t1.QuadPart;
+    if (how == 3) {                              /* no timer / wait failed: never block unbounded */
+        if (s_wev_stats_on) InterlockedIncrement64(&st->noarm);
+        return 0;
+    }
+    if (s_wev_stats_on) {
+        InterlockedIncrement64(&st->blocks);
+        InterlockedExchangeAdd64(&st->qpc_blocked, t1.QuadPart - t0.QuadPart);
+        if (how == 0) {
+            InterlockedIncrement64(&st->w_signal);
+            const LONGLONG tp = sl->t_poke;
+            if (tp && t1.QuadPart >= tp) { InterlockedExchangeAdd64(&st->qpc_lat, t1.QuadPart - tp); InterlockedIncrement64(&st->n_lat); }
+        } else if (how == 1) {
+            InterlockedIncrement64(&st->w_timeout);
+            if (missed) InterlockedIncrement64(&st->w_missed);
+        }
+        else InterlockedIncrement64(&st->w_late);
+    }
+    return 1;
+}
+
+#else  /* !_WIN32: the interface links; nothing ever blocks */
+
+volatile uint32_t g_wev_on;
+volatile uint32_t g_wev_any;
+volatile uint32_t g_wev_mask[3];
+int  wev_enabled(void) { return 0; }
+int  wev_register(const wev_site* site) { (void)site; return 0; }
+void wev_poke(uint32_t src, uint32_t ea, uint32_t size) { (void)src; (void)ea; (void)size; }
+
+#endif /* _WIN32 */
