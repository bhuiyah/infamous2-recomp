+/* ---------------------------------------------------------------------------
+ * Save states: the SUTL and MISC sections (runtime/savestate/ss_state.h,
+ * engine design 5.2 and 6.2), and GCM_ and AUDI (end of file)
+ *
+ * The sysutil band's two sections are registered here, in the one system
+ * library with no test of its own -- and, for the same reason, cellGcmSys's
+ * and cellAudio's, whose files have host tests that build them alone. Every
+ * other library only describes its part -- field lists, record iterators, a
+ * check -- and calls nothing of the save-state engine, so the tests that
+ * build those files alone still link (a registration is a static-init
+ * constructor: the linker keeps it, and everything it reaches, whatever
+ * dead-strips).
+ * Both are captured with every guest thread parked and the GPU idle; no part
+ * allocates or takes a lock.
+ *   SUTL  cellSysutil.c: the sysutil statics, the registered callbacks, the
+ *         event ring, the completion list
+ *   MISC  in this order: cellGame (boot check, content-check session),
+ *         cellSysmodule (the loaded set, below), cellMsgDialog (an open
+ *         dialog), cellSaveData (the PARAM.SFO text the title last wrote or
+ *         loaded), sceNpTrophy (contexts, handles), cellHttp (clients and
+ *         transactions, restored offline), cellNetCtl (handlers),
+ *         cellVideoOut (mode, gamma), cellResc, cellOskDialog (loaded, the
+ *         result it will hand back), and the other imported libraries'
+ *         init state: cellCamera, cellGem, cellSsl, cellHttps, sceNp (its
+ *         manager callback)
+ * Strict-save blockers (design 4.2): SUTL refuses while the completion list
+ * is being changed; MISC while cellSaveData is inside an operation (the
+ * game is saving), which ppu_loader.cpp's ss_add_check also reads before the
+ * stop. A part's record iterator: called with i = 0, 1, 2, ... in order; -1
+ * past the end, 0 nothing at i, 1 = *rec is record i's struct, keyed *key.
+ * -----------------------------------------------------------------------*/
+typedef int (*sysmod_ss_rec_fn)(uint32_t i, uint32_t* key, const void** rec);
+
+/* cellSysutil.c */
+extern const ss_list cellSysutil_ss_list, cellSysutil_ss_callbacks_list,
+                     cellSysutil_ss_events_list, cellSysutil_ss_completions_list;
+void cellSysutil_ss_prepare(void);
