+        t = _RC_EXIT.sub(share(v), st.text)
+        t = t.replace("@F@ ", flush(v)).replace("@R@", reload(v))
+        body.append(t)
+    for (fs, tail), lab in sorted(exits.items(), key=lambda kv: int(kv[1][4:])):
+        body.append(f"{lab}:")
+        body.append("".join(f"ctx->gpr[{r}] = SPU_RU(_r{r}); " for r in fs) + tail)
+    decls = []
+    if allregs:
+        decls.append("spu_reg " + ", ".join(f"_r{r}" for r in sorted(allregs)) + ";")
+    if uses_ls:
+        decls.append("uint8_t* _ls = ctx->ls; int _lsg = spu_ls_gate(ctx);")
+    if uses_pic:
+        decls.append("uint32_t _picb = ctx->pic_bias;")
+    if wins:
+        decls += ["#if SPU_WIN_ENABLE", "int _wn = g_spu_win_tries;", "#endif"]
+    loads = {}
+    ents = entries if entries is not None else [None]
+    # Each entry loads exactly the registers live at it (in its switch case):
+    # regions are entered at every call and trampoline hop, and one shared
+    # load of the union of all entries' live-ins cost hop-heavy code more
+    # than it saved in code size.
+    for e, s in zip(ents, starts):
+        loads[e] = "".join(f"_r{r} = SPU_RV(ctx->gpr[{r}]); " for r in sorted(lin[s])).rstrip()
+    return decls, loads, body
