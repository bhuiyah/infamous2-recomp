+    uint32_t count_ptr = (uint32_t)ctx->gpr[6];
+    if (fd < 0 || fd >= FS_MAX || !g_dirs[fd]) { ctx->gpr[3] = (uint64_t)(int64_t)CELL_FS_EBADF; return; }
+    const uint32_t kEntry = 0x138, max = size / kEntry;
+    uint32_t n = 0;
+    while (n < max) {
