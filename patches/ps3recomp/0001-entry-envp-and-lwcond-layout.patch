index 0000000..f3ad733
--- /dev/null
+++ b/runtime/spu/tests/test_spu_helpers_simd.c
@@ -0,0 +1,263 @@
+/* The SIMD fast paths of spu_helpers.h must return exactly what their scalar
+ * references (*_ref) return, lane for lane, in every MXCSR mode the SPU host
+ * threads can run with (SPU_FPMODE: round-to-nearest / toward zero, with and
+ * without FTZ+DAZ). Vectors mix all-ordinary lanes (the fast path) with
+ * exponent-255, denormal, zero, boundary and cancellation lanes (the
+ * fallback), so both sides of every check are exercised. Build it once per
+ * ISA level the helpers have paths for, and once more with
+ * -DSPU_HELPERS_FP_RZDAZ (then only rz+ftz/daz is run), e.g. from this directory:
+ *   clang-cl /O2 -I.. -I../../../include [-msse4.1 | /arch:AVX2] test_spu_helpers_simd.c
+ *   clang -O2 -I.. -I../../../include [-msse4.1 | -march=x86-64-v3] test_spu_helpers_simd.c
+ *   test_spu_helpers_simd [vectors-per-op-per-mode]   (default 2000000) */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xmmintrin.h>
+
+static uint64_t g_s = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd32(void) { g_s ^= g_s << 13; g_s ^= g_s >> 7; g_s ^= g_s << 17; return (uint32_t)(g_s >> 32); }
+
+static const uint32_t SPECIAL[] = {
+    0x00000000u, 0x80000000u, 0x00000001u, 0x80000001u, 0x007FFFFFu, 0x807FFFFFu,
+    0x00400000u, 0x00800000u, 0x80800000u, 0x00800001u, 0x00FFFFFFu, 0x01000000u,
+    0x3F800000u, 0xBF800000u, 0x40000000u, 0xC0000000u, 0x3F000000u, 0xBF000000u,
+    0x3F7FFFFFu, 0x3F800001u, 0x7F7FFFFFu, 0xFF7FFFFFu, 0x7F000000u, 0x7F7FFFFEu,
+    0x7F800000u, 0xFF800000u, 0x7F800001u, 0x7FC00000u, 0xFFC00000u, 0x7FFFFFFFu,
+    0xFFFFFFFFu, 0x7FFFFFFEu, 0x7FBFFFFFu, 0x5F800000u, 0x1F800000u, 0x20000000u,
+    0x1F7FFFFFu, 0x3F7FFFFEu, 0x4B000000u, 0x4F000000u, 0xCF000000u, 0x4F800000u,
+    0x0D800000u, 0x71800000u, 0x7E800000u, 0xFE800000u, 0x00C00000u, 0x80C00000u,
+};
+#define NSPECIAL (sizeof SPECIAL / sizeof SPECIAL[0])
+
+static uint32_t gen_any(void) {           /* fxtest.c's generator: specials included */
+    uint32_t k = rnd32() % 8, s = rnd32() & 0x80000000u, m = rnd32() & 0x7FFFFFu;
+    switch (k) {
+    case 0: case 1: return rnd32();
+    case 2: return SPECIAL[rnd32() % NSPECIAL];
+    case 3: { static const uint32_t ex[] = {0,0,1,1,2,3,125,126,127,128,129,130,251,252,253,254,254,255,255,255};
+              return s | (ex[rnd32() % 20] << 23) | m; }
+    case 4: return s | ((100u + rnd32() % 55u) << 23) | m;
+    case 5: return s | (0xFFu << 23) | m;
+    case 6: return s | ((rnd32() % 4) << 23) | m;
+    default: return s | ((rnd32() % 256u) << 23) | (m & ~0xFFFFu);
+    }
+}
+static uint32_t gen_ord(void) {           /* ordinary game-like values (fast path) */
+    uint32_t s = rnd32() & 0x80000000u, m = rnd32() & 0x7FFFFFu;
+    switch (rnd32() % 6) {
+    case 0: return 0;
+    case 1: return s | ((110u + rnd32() % 36u) << 23) | (m & ~0x3FFFu);   /* short mantissas */
+    case 2: return s | ((1u + rnd32() % 254u) << 23) | m;                 /* whole normal range */
+    default: return s | ((115u + rnd32() % 25u) << 23) | m;
+    }
+}
+static uint32_t perturb(uint32_t v) {
+    uint32_t d = rnd32() % 5, r = v;
+    switch (rnd32() % 4) { case 0: r = v + d; break; case 1: r = v - d; break; case 2: r = v ^ (rnd32() & 0xFFu); break; default: break; }
+    if (rnd32() & 1) r ^= 0x80000000u;
+    return r;
+}
+/* one vector: all lanes ordinary 3/4 of the time, one odd lane 1/8, any 1/8 */
+static u128 gen_vec(void) {
+    u128 r; uint32_t k = rnd32() % 8;
+    for (int i = 0; i < 4; i++) r._u32[i] = gen_ord();
+    if (k == 6) r._u32[rnd32() % 4] = gen_any();
+    else if (k == 7) for (int i = 0; i < 4; i++) r._u32[i] = gen_any();
+    return r;
+}
+static u128 near_neg(u128 x) {            /* lanes ~ -x: cancellation */
+    u128 r; for (int i = 0; i < 4; i++) r._u32[i] = (rnd32() % 3) ? perturb(x._u32[i]) : gen_ord(); return r;
+}
+static u128 near_prod(u128 a, u128 b) {   /* lanes ~ +-a*b: fused cancellation */
+    u128 r;
+    for (int i = 0; i < 4; i++) {
+        if (rnd32() % 4 == 0) { r._u32[i] = gen_ord(); continue; }
+        r._u32[i] = perturb(spu__d2fx(spu__fx2d(a._u32[i]) * spu__fx2d(b._u32[i])));
+    }
+    return r;
+}
+static u128 rand_bytes(void) { u128 r; for (int i = 0; i < 4; i++) r._u32[i] = rnd32(); return r; }
+
+/* Edge generators: results at the flush boundary (2^-126), the saturation
+ * boundary (FLT_MAX / 2^128), and fused results within 2^-46 of a float
+ * halfway point (where a double-rounding emulation would go wrong). */
+static uint32_t edge_target(void) {
+    uint32_t s = rnd32() & 0x80000000u, d = rnd32() % 7;
+    uint32_t t = (rnd32() & 1) ? 0x00800000u : 0x7F7FFFFFu;   /* 2^-126 or FLT_MAX */
+    return s | (t + d - 3);
+}
+static void gen_edge_mul(u128* a, u128* b) {       /* a*b ~ edge (per lane) */
+    for (int i = 0; i < 4; i++) {
+        uint32_t x = gen_ord() | 0x00800000u, t = edge_target();
+        if (!(x & 0x7F800000u)) x |= 0x3F800000u;
+        a->_u32[i] = x;
+        b->_u32[i] = perturb(spu__d2fx(spu__fx2d(t) / spu__fx2d(x))) & 0xFFFFFFFFu;
+        if (rnd32() & 1) b->_u32[i] &= 0x7FFFFFFFu;
+    }
+}
+static void gen_edge_add(u128* a, u128* b) {       /* a+b ~ edge (per lane) */
+    for (int i = 0; i < 4; i++) {
+        const uint32_t t = edge_target(), s = t & 0x80000000u;
+        const uint32_t e = (t & 0x7FFFFFFFu) >= 0x7F000000u ? 250u + rnd32() % 5u : 1u + rnd32() % 5u;
+        const uint32_t x = s | (e << 23) | (rnd32() & 0x7FFFFFu);   /* same sign, near the edge */
+        a->_u32[i] = x;
+        b->_u32[i] = perturb(spu__d2fx(spu__fx2d(t) - spu__fx2d(x)));
+        if (rnd32() & 1) b->_u32[i] = (b->_u32[i] & 0x7FFFFFFFu) | (spu__d2fx(spu__fx2d(t) - spu__fx2d(x)) & 0x80000000u);
+    }
+}
+static void gen_near_half(u128* a, u128* b, u128* c) {   /* c +- ulp(c)/2 * (1 -+ 2^-46) */
+    for (int i = 0; i < 4; i++) {
+        uint32_t cv = (rnd32() & 0x80000000u) | ((30u + rnd32() % 190u) << 23) | (rnd32() & 0x7FFFFFu);
+        uint32_t e = (cv >> 23) & 0xFFu;                       /* half ulp of c = 2^(e-127-24) */
+        c->_u32[i] = cv;
+        a->_u32[i] = (rnd32() & 0x80000000u) | ((e - 24u) << 23) | (rnd32() % 3);
+        b->_u32[i] = (rnd32() & 0x80000000u) | ((rnd32() & 1) ? 0x3F7FFFFEu - rnd32() % 3 : 0x3F800000u + rnd32() % 3);
+    }
+}
+
+static long g_bad, g_n;
+static int check(const char* op, u128 got, u128 ref, const u128* in, int nin) {
+    g_n++;
+    if (!memcmp(&got, &ref, 16)) return 0;
+    if (g_bad++ < 12) {
+        printf("  MISMATCH %s:", op);
+        for (int k = 0; k < nin; k++) printf(" in%d=%08X.%08X.%08X.%08X", k, in[k]._u32[0], in[k]._u32[1], in[k]._u32[2], in[k]._u32[3]);
+        printf(" got=%08X.%08X.%08X.%08X ref=%08X.%08X.%08X.%08X\n", got._u32[0], got._u32[1], got._u32[2], got._u32[3],
+               ref._u32[0], ref._u32[1], ref._u32[2], ref._u32[3]);
+    }
+    return 1;
+}
+#define CHK2(op, a, b) do { const u128 x_ = (a), y_ = (b); u128 in_[2] = {x_, y_}; check(#op, op(x_, y_), op##_ref(x_, y_), in_, 2); } while (0)
+#define CHK3(op, a, b, c) do { const u128 x_ = (a), y_ = (b), z_ = (c); u128 in_[3] = {x_, y_, z_}; check(#op, op(x_, y_, z_), op##_ref(x_, y_, z_), in_, 3); } while (0)
+#define CHKI(op, a, i) do { const u128 x_ = (a); const int i_ = (i); u128 in_[2] = {x_, spu_splat_u32((uint32_t)i_)}; check(#op, op(x_, i_), op##_ref(x_, i_), in_, 2); } while (0)
+
+static int pick_i8(int base, int span) {
+    switch (rnd32() % 4) {
+    case 0: return base;
+    case 1: return (int)(rnd32() % 256);
+    default: return base - span / 2 + (int)(rnd32() % (uint32_t)span);
+    }
+}
+
+__attribute__((noinline)) static void run(long n) {
+    for (long it = 0; it < n; it++) {
+        u128 a = gen_vec(), b = gen_vec(), c = gen_vec();
+        u128 bc = (it & 3) == 0 ? near_neg(a) : b;
+        CHK2(spu_fa, a, bc);
+        CHK2(spu_fs, a, (it & 3) == 1 ? a : bc);
+        CHK2(spu_fm, a, b);
+        u128 cp = (it & 1) ? near_prod(a, b) : c;
+        CHK3(spu_fma, a, b, cp);
+        CHK3(spu_fms, a, b, cp);
+        CHK3(spu_fnms, a, b, cp);
+        { u128 ea, eb, ec, one = spu_splat_u32(0x3F800000u), z = spu_zero();
+          gen_edge_mul(&ea, &eb);
+          CHK2(spu_fm, ea, eb); { u128 cc = (it & 1) ? z : gen_vec(); CHK3(spu_fma, ea, eb, cc); } CHK3(spu_fnms, ea, eb, z);
+          gen_edge_add(&ea, &eb);
+          CHK2(spu_fa, ea, eb); CHK2(spu_fs, ea, spu_xor(eb, spu_splat_u32(0x80000000u)));
+          CHK3(spu_fma, eb, one, ea); CHK3(spu_fms, eb, one, spu_xor(ea, spu_splat_u32(0x80000000u)));
+          CHK3(spu_fnms, eb, spu_splat_u32(0xBF800000u), ea);
+          gen_near_half(&ea, &eb, &ec);
+          CHK3(spu_fma, ea, eb, ec); CHK3(spu_fms, ea, eb, ec); CHK3(spu_fnms, ea, eb, ec); }
+        CHK2(spu_fceq, a, (it & 1) ? bc : b);
+        CHK2(spu_fcgt, a, (it & 1) ? bc : b);
+        CHK2(spu_fcmeq, a, (it & 1) ? bc : b);
+        CHK2(spu_fcmgt, a, (it & 1) ? bc : b);
+        /* conversions */
+        { int i8 = pick_i8(173, 64); CHKI(spu_cflts, a, i8); CHKI(spu_cfltu, a, i8); }
+        { u128 v = rand_bytes();
+          for (int i = 0; i < 4; i++) if (rnd32() & 1) v._u32[i] >>= rnd32() % 32;
+          if (it & 1) for (int i = 0; i < 4; i++) v._u32[i] = (uint32_t)(int32_t)(int16_t)v._u32[i];
+          int j8 = pick_i8(155, 64); CHKI(spu_csflt, v, j8); CHKI(spu_cuflt, v, j8); }
+        /* fi with estimate-shaped and arbitrary second operands */
+        { u128 x = (it & 3) == 3 ? rand_bytes() : a, y;
+          switch (rnd32() % 3) {
+          case 0: y = spu_frest(x); break;
+          case 1: { u128 ax = x; for (int i = 0; i < 4; i++) ax._u32[i] &= 0x7FFFFFFFu; y = spu_frsqest(ax); x = ax; break; }
+          default: y = (it & 1) ? rand_bytes() : gen_vec(); break;
+          }
+          CHK2(spu_fi, x, y); }
+        /* bytes */
+        { u128 p = rand_bytes(), q = rand_bytes(), s = rand_bytes();
+          if (it & 1) for (int i = 0; i < 16; i++) s._u8[i] &= (rnd32() & 1) ? 0x1F : 0xFF;   /* mostly plain selectors */
+          CHK3(spu_shufb, p, q, s);
+          CHK3(spu_selb, p, q, s);
+          u128 cnt = rand_bytes();
+          if (it & 1) cnt._u32[0] &= 0xFF;
+          CHK2(spu_rotqby, p, cnt); CHK2(spu_shlqby, p, cnt); CHK2(spu_rotqbybi, p, cnt); CHK2(spu_shlqbybi, p, cnt);
+          CHK2(spu_rotqmby, p, cnt); CHK2(spu_rotqmbybi, p, cnt);
+          int imm = (int)(rnd32() % 192) - 64;
+          CHKI(spu_rotqbyi, p, imm); CHKI(spu_shlqbyi, p, imm); CHKI(spu_rotqmbyi, p, imm);
+          int pos = (it & 1) ? (int)rnd32() : (int)(rnd32() % 64) - 16;
+          { u128 in_[1] = {spu_splat_u32((uint32_t)pos)};
+            check("spu_cbd_pos", spu_cbd_pos(pos), spu_cbd_pos_ref(pos), in_, 1);
+            check("spu_chd_pos", spu_chd_pos(pos), spu_chd_pos_ref(pos), in_, 1);
+            check("spu_cwd_pos", spu_cwd_pos(pos), spu_cwd_pos_ref(pos), in_, 1);
+            check("spu_cdd_pos", spu_cdd_pos(pos), spu_cdd_pos_ref(pos), in_, 1); } }
+    }
+}
+
+/* Constant counts fold to constant pshufb controls: check every immediate. */
+__attribute__((noinline)) static void run_imm(void) {
+    for (int it = 0; it < 2000; it++) {
+        u128 p = rand_bytes();
+#define IMM(k) do { CHKI(spu_rotqbyi, p, k); CHKI(spu_shlqbyi, p, k); CHKI(spu_rotqmbyi, p, k); } while (0)
+        IMM(0); IMM(1); IMM(2); IMM(3); IMM(4); IMM(5); IMM(7); IMM(8); IMM(11); IMM(12); IMM(15); IMM(16);
+        IMM(17); IMM(31); IMM(32); IMM(-1); IMM(-3); IMM(-4); IMM(-8); IMM(-12); IMM(-15); IMM(-16); IMM(-17); IMM(-31); IMM(-64);
+        IMM(63); IMM(64);
+#undef IMM
+        u128 v = gen_vec(), w = rand_bytes();
+        CHKI(spu_cflts, v, 173); CHKI(spu_cfltu, v, 173); CHKI(spu_cflts, v, 141); CHKI(spu_cfltu, v, 141);
+        CHKI(spu_cflts, v, 150); CHKI(spu_cfltu, v, 158); CHKI(spu_cflts, v, 0); CHKI(spu_cfltu, v, 255);
+        CHKI(spu_csflt, w, 155); CHKI(spu_cuflt, w, 155); CHKI(spu_csflt, w, 123); CHKI(spu_cuflt, w, 123);
+        CHKI(spu_csflt, w, 140); CHKI(spu_cuflt, w, 140); CHKI(spu_csflt, w, 0); CHKI(spu_cuflt, w, 255);
+        CHKI(spu_csflt, w, 252); CHKI(spu_cuflt, w, 252); CHKI(spu_csflt, w, 28); CHKI(spu_cuflt, w, 28);
+    }
+}
+
+int main(int argc, char** argv) {
+    long n = argc > 1 ? atol(argv[1]) : 2000000;
+    static const unsigned modes[4] = { 0x1F80u, 0x7F80u, 0x9FC0u, 0xFFC0u };
+    static const char* names[4] = { "rn", "rz", "rn+ftz/daz", "rz+ftz/daz" };
+    printf("test_spu_helpers_simd: SSSE3=%d SSE4.1=%d AVX2=%d FMA=%d SIMD=%d\n",
+#ifdef __SSSE3__
+           1,
+#else
+           0,
+#endif
+#ifdef __SSE4_1__
+           1,
+#else
+           0,
+#endif
+#ifdef __AVX2__
+           1,
+#else
+           0,
+#endif
+#ifdef __FMA__
+           1,
+#else
+           0,
+#endif
+           SPU_SIMD_X86);
+    long total = 0;
+    /* An SPU_HELPERS_FP_RZDAZ build is defined for rz+ftz/daz (MXCSR 0xFFC0) only */
+#if defined(SPU_HELPERS_FP_RZDAZ)
+    const int m0 = 3;
+#else
+    const int m0 = 0;
+#endif
+    for (int m = m0; m < 4; m++) {
+        unsigned saved = _mm_getcsr();
+        _mm_setcsr(modes[m]);
+        g_bad = 0; g_n = 0;
+        run(n); run_imm();
+        _mm_setcsr(saved);
+        printf("  %-11s %ld checks, %ld mismatches\n", names[m], g_n, g_bad);
+        total += g_bad;
+    }
+    puts(total ? "test_spu_helpers_simd: FAIL" : "test_spu_helpers_simd: ok");
+    return total != 0;
+}
diff --git a/runtime/spu/tests/test_spu_helpers_simd2.c b/runtime/spu/tests/test_spu_helpers_simd2.c
new file mode 100644
index 0000000..b91f61c
--- /dev/null
+++ b/runtime/spu/tests/test_spu_helpers_simd2.c
@@ -0,0 +1,214 @@
+/* The integer SIMD helpers added to spu_helpers.h (frest, frsqest, clz, cntb,
+ * the multiplies, quadword bit shifts, sign extensions, gather-bits, variable
+ * word shifts, byte/halfword immediate compares, sumb) must return exactly
+ * what their scalar references (*_ref) return. Unary word functions are
+ * checked on all 2^32 inputs; the rest on random vectors plus every shift
+ * count / immediate. MXCSR-independent (no float arithmetic), but run under
+ * two modes anyway (clz and the int -> float conversions use the FP unit).
+ * An x86-64-v4 SPU_HELPERS_FP_RZDAZ build (SPU__AVX512) is defined for
+ * rz+ftz/daz only -- its csflt/cuflt convert in the rounding mode -- so it
+ * runs that mode alone, exhaustive sweep included; every other build still
+ * runs both.
+ * Also: the double-precision helpers give the same bits with and without
+ * DAZ/FTZ (dp_modes).
+ *   clang-cl /O2 -I.. -I../../../include [/arch:AVX2 | -msse4.1 | ] test_spu_helpers_simd2.c
+ *   test_spu_helpers_simd2 [random-vectors] [exhaustive: 1|0] */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xmmintrin.h>
+
+static uint64_t g_s = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd32(void) { g_s ^= g_s << 13; g_s ^= g_s >> 7; g_s ^= g_s << 17; return (uint32_t)(g_s >> 32); }
+static u128 rnd_vec(void) {
+    u128 r;
+    for (int i = 0; i < 4; i++) {
+        uint32_t v = rnd32();
+        switch (rnd32() % 8) {                 /* small, large, sign-boundary values too */
+        case 0: v >>= rnd32() % 32; break;
+        case 1: v = (uint32_t)-(int32_t)(v >> (rnd32() % 32)); break;
+        case 2: v = (rnd32() & 1) ? 0x80000000u : 0x7FFFFFFFu; v += rnd32() % 3 - 1; break;
+        case 3: v &= 0x0000FFFFu; break;
+        case 4: v |= 0xFFFF0000u; break;
+        default: break;
+        }
+        r._u32[i] = v;
+    }
+    return r;
+}
+static long long g_bad, g_n;
+static void check(const char* op, u128 got, u128 ref, u128 a, u128 b, long imm) {
+    g_n++;
+    if (!memcmp(&got, &ref, 16)) return;
+    if (g_bad++ < 20)
+        printf("  MISMATCH %s a=%08X.%08X.%08X.%08X b=%08X.%08X.%08X.%08X imm=%ld got=%08X.%08X.%08X.%08X ref=%08X.%08X.%08X.%08X\n",
+               op, a._u32[0], a._u32[1], a._u32[2], a._u32[3], b._u32[0], b._u32[1], b._u32[2], b._u32[3], imm,
+               got._u32[0], got._u32[1], got._u32[2], got._u32[3], ref._u32[0], ref._u32[1], ref._u32[2], ref._u32[3]);
+}
+#define C1(op, a)        check(#op, op(a), op##_ref(a), a, a, 0)
+#define C2(op, a, b)     check(#op, op(a, b), op##_ref(a, b), a, b, 0)
+#define C3(op, a, b, c)  check(#op, op(a, b, c), op##_ref(a, b, c), a, b, 0)
+#define CI(op, a, i)     check(#op, op(a, i), op##_ref(a, i), a, a, (long)(i))
+
+/* all 2^32 inputs of the per-word unary functions, four per vector; lanes
+ * rotate so every input visits every lane over the sweep */
+__attribute__((noinline)) static void exhaustive(void) {
+    long long bad0 = g_bad;
+    for (uint64_t x = 0; x < (1ull << 32); x += 4) {
+        u128 a;
+        const unsigned k = (unsigned)(x >> 2) & 3;
+        for (int i = 0; i < 4; i++) a._u32[(i + k) & 3] = (uint32_t)(x + (uint64_t)i);
+        u128 g1 = spu_frest(a), r1 = spu_frest_ref(a);
+        u128 g2 = spu_frsqest(a), r2 = spu_frsqest_ref(a);
+        u128 g3 = spu_clz(a), r3 = spu_clz_ref(a);
+        u128 g4 = spu_xshw(a), r4 = spu_xshw_ref(a);
+        u128 g5 = spu_xsbh(a), r5 = spu_xsbh_ref(a);
+        u128 g6 = spu_cntb(a), r6 = spu_cntb_ref(a);
+        u128 g7 = spu_cuflt(a, 123), r7 = spu_cuflt_ref(a, 123);     /* int -> float: the AVX2 path */
+        u128 g8 = spu_csflt(a, 155), r8 = spu_csflt_ref(a, 155);
+        u128 g9 = spu_cuflt(a, 250), r9 = spu_cuflt_ref(a, 250);
+        g_n += 9;
+        if (memcmp(&g1, &r1, 16) | memcmp(&g2, &r2, 16) | memcmp(&g3, &r3, 16) |
+            memcmp(&g4, &r4, 16) | memcmp(&g5, &r5, 16) | memcmp(&g6, &r6, 16) |
+            memcmp(&g7, &r7, 16) | memcmp(&g8, &r8, 16) | memcmp(&g9, &r9, 16)) {
+            g_n -= 9;
+            C1(spu_frest, a); C1(spu_frsqest, a); C1(spu_clz, a); C1(spu_xshw, a); C1(spu_xsbh, a); C1(spu_cntb, a);
+            CI(spu_cuflt, a, 123); CI(spu_csflt, a, 155); CI(spu_cuflt, a, 250);
+        }
+    }
+    printf("  exhaustive 2^32 x {frest frsqest clz xshw xsbh cntb cuflt/123 csflt/155 cuflt/250}: %lld mismatches\n", g_bad - bad0);
+}
+
+__attribute__((noinline)) static void randomized(long n) {
+    for (long it = 0; it < n; it++) {
+        u128 a = rnd_vec(), b = rnd_vec(), c = rnd_vec();
+        C2(spu_mpy, a, b); C3(spu_mpya, a, b, c); C2(spu_mpyu, a, b); C2(spu_mpyh, a, b);
+        C2(spu_mpyhh, a, b); C2(spu_mpys, a, b);
+        { int32_t imm = (int32_t)(rnd32() % 1024) - 512; if (it & 1) imm = (int32_t)(int16_t)rnd32();
+          CI(spu_mpyi, a, imm); CI(spu_mpyui, a, imm); }
+        C1(spu_xswd, a); C1(spu_gb, a); C1(spu_gbh, a); C1(spu_gbb, a);
+        C2(spu_sumb, a, b);
+        { u128 cnt = b;
+          if (it & 1) for (int i = 0; i < 4; i++) cnt._u32[i] = rnd32() % 80u;            /* around 32 and 64 */
+          if ((it & 3) == 2) for (int i = 0; i < 4; i++) cnt._u32[i] = (uint32_t)-(int32_t)(rnd32() % 80u);
+          C2(spu_shl, a, cnt); C2(spu_rot, a, cnt); C2(spu_rotm, a, cnt); C2(spu_rotma, a, cnt);
+          C2(spu_shlqbi, a, cnt); C2(spu_rotqbi, a, cnt); C2(spu_rotqmbi, a, cnt); }
+        { const int imm = (int)(rnd32() % 512) - 256;
+          CI(spu_shlqbii, a, imm); CI(spu_rotqbii, a, imm); CI(spu_rotqmbii, a, imm);
+          u128 e = a;                                              /* lanes equal to the immediate too */
+          for (int i = 0; i < 16; i++) if (rnd32() & 1) e._u8[i] = (uint8_t)imm;
+          CI(spu_ceqbi, e, imm); CI(spu_cgtbi, e, imm); CI(spu_clgtbi, e, imm);
+          for (int i = 0; i < 8; i++) if (rnd32() & 1) e._u16[i] = (uint16_t)imm;
+          CI(spu_ceqhi, e, imm); CI(spu_cgthi, e, imm); CI(spu_clgthi, e, imm); }
+        { const int i8 = (int)(rnd32() % 256u); CI(spu_cuflt, a, i8); CI(spu_csflt, a, i8); }
+    }
+}
+/* every constant count (they fold to immediates after inlining) */
+__attribute__((noinline)) static void constants(void) {
+    for (int it = 0; it < 4000; it++) {
+        u128 a = rnd_vec();
+#define K(k) do { CI(spu_shlqbii, a, k); CI(spu_rotqbii, a, k); CI(spu_rotqmbii, a, k); } while (0)
+        K(0); K(1); K(2); K(3); K(4); K(5); K(6); K(7); K(8); K(9); K(15); K(-1); K(-2); K(-3); K(-4); K(-5); K(-6); K(-7); K(-8);
+#undef K
+#define M(k) do { CI(spu_mpyi, a, k); CI(spu_mpyui, a, k); CI(spu_ceqbi, a, k); CI(spu_cgtbi, a, k); CI(spu_clgtbi, a, k); \
+                  CI(spu_ceqhi, a, k); CI(spu_cgthi, a, k); CI(spu_clgthi, a, k); } while (0)
+        M(0); M(1); M(-1); M(2); M(44); M(127); M(128); M(255); M(-128); M(-129); M(511); M(-512); M(32767); M(-32768); M(65535);
+#undef M
+    }
+}
+
+/* The double-precision helpers (and fesd/frds) must not depend on DAZ/FTZ:
+ * an SPU_HELPERS_FP_RZDAZ build runs SPU threads with both set, and these
+ * must still give what they give without (the default "rz" mode). Same
+ * header, two modes, operands full of denormals and results that land in
+ * the denormal range. */
+static uint64_t gen_dbits(void) {
+    const uint64_t s = (uint64_t)(rnd32() & 1u) << 63, m = ((uint64_t)rnd32() << 32 | rnd32()) & 0xFFFFFFFFFFFFFull;
+    switch (rnd32() % 8) {
+    case 0: return s | m;                                              /* denormal */
+    case 1: return s | (1ull << 52) | m;                               /* smallest normals */
+    case 2: return s;                                                  /* zero */
+    case 3: return s | ((uint64_t)(1 + rnd32() % 60) << 52) | m;       /* tiny: products underflow */
+    case 4: return s | ((uint64_t)(870 + rnd32() % 40) << 52) | m;     /* frds: float denormal range */
+    case 5: return s | (0x7FFull << 52) | ((rnd32() & 1) ? 0 : m);     /* inf / NaN */
+    default: return s | ((uint64_t)(990 + rnd32() % 60) << 52) | m;
+    }
+}
+static u128 gen_dvec(void) {
+    u128 r;
+    for (int i = 0; i < 2; i++) { const uint64_t d = gen_dbits(); r._u32[2 * i] = (uint32_t)(d >> 32); r._u32[2 * i + 1] = (uint32_t)d; }
+    if (rnd32() & 1) { r._u32[0] = (rnd32() & 0x80000000u) | (rnd32() & 0x807FFFFFu); }   /* fesd: a denormal single in word 0 */
+    return r;
+}
+__attribute__((noinline)) static long long dp_modes(long n) {
+    static const unsigned with[2] = { 0xFFC0u, 0x9FC0u }, without[2] = { 0x7F80u, 0x1F80u };
+    const unsigned saved = _mm_getcsr();
+    long long bad = 0, chk = 0;
+    for (long it = 0; it < n; it++) {
+        const u128 a = gen_dvec(), b = (it & 3) ? gen_dvec() : a, c = gen_dvec();
+        for (int m = 0; m < 2; m++) {
+            u128 r[2][13];
+            for (int k = 0; k < 2; k++) {
+                _mm_setcsr(k ? with[m] : without[m]);
+                r[k][0] = spu_dfa(a, b); r[k][1] = spu_dfs(a, b); r[k][2] = spu_dfm(a, b);
+                r[k][3] = spu_dfma(a, b, c); r[k][4] = spu_dfms(a, b, c); r[k][5] = spu_dfnms(a, b, c); r[k][6] = spu_dfnma(a, b, c);
+                r[k][7] = spu_dfceq(a, b); r[k][8] = spu_dfcmeq(a, b); r[k][9] = spu_dfcgt(a, b); r[k][10] = spu_dfcmgt(a, b);
+                r[k][11] = spu_fesd(a); r[k][12] = spu_frds(a);
+                if ((_mm_getcsr() & ~0x3Fu) != (k ? with[m] : without[m])) bad++;   /* mode restored */
+            }
+            for (int j = 0; j < 13; j++) {
+                chk++;
+                if (memcmp(&r[0][j], &r[1][j], 16) && bad++ < 10)
+                    printf("  MISMATCH dp op %d (%s): a=%08X%08X.%08X%08X b=%08X%08X.%08X%08X\n", j, m ? "rn" : "rz",
+                           a._u32[0], a._u32[1], a._u32[2], a._u32[3], b._u32[0], b._u32[1], b._u32[2], b._u32[3]);
+            }
+        }
+    }
+    _mm_setcsr(saved);
+    printf("  double precision with vs without DAZ/FTZ: %lld checks, %lld mismatches\n", chk, bad);
+    return bad;
+}
+
+int main(int argc, char** argv) {
+    long n = argc > 1 ? atol(argv[1]) : 2000000;
+    int ex = argc > 2 ? atoi(argv[2]) : 1;
+    printf("test_spu_helpers_simd2: SSSE3=%d SSE4.1=%d AVX2=%d SIMD=%d\n",
+#ifdef __SSSE3__
+           1,
+#else
+           0,
+#endif
+#ifdef __SSE4_1__
+           1,
+#else
+           0,
+#endif
+#ifdef __AVX2__
+           1,
+#else
+           0,
+#endif
+           SPU_SIMD_X86);
+    static const unsigned modes[2] = { 0x1F80u, 0xFFC0u };
+    static const char* names[2] = { "rn", "rz+ftz/daz" };
+    long long total = 0;
+#if defined(SPU_HELPERS_FP_RZDAZ) && SPU__AVX512
+    const int m0 = 1;
+#else
+    const int m0 = 0;
+#endif
+    for (int m = m0; m < 2; m++) {
+        unsigned saved = _mm_getcsr();
+        _mm_setcsr(modes[m]);
+        g_bad = 0; g_n = 0;
+        if (ex == 2 || (ex && m == m0)) exhaustive();
+        randomized(n); constants();
+        _mm_setcsr(saved);
+        printf("  %-11s %lld checks, %lld mismatches\n", names[m], g_n, g_bad);
+        total += g_bad;
+    }
+    total += dp_modes(n);
+    puts(total ? "test_spu_helpers_simd2: FAIL" : "test_spu_helpers_simd2: ok");
+    return total != 0;
+}
diff --git a/runtime/spu/tests/test_spu_helpers_vx.c b/runtime/spu/tests/test_spu_helpers_vx.c
new file mode 100644
index 0000000..c54a90f
--- /dev/null
+++ b/runtime/spu/tests/test_spu_helpers_vx.c
@@ -0,0 +1,265 @@
+/* The fallback of the fa/fs/fm/fma/fms/fnms fast paths (spu_<op>_vx, what
+ * SPU__SLOW2/3 run with AVX2+FMA3) must return exactly what the scalar
+ * references spu_<op>_ref return, lane for lane, in every MXCSR mode the SPU
+ * host threads can run with: round to nearest / toward zero, each with no
+ * FTZ/DAZ, FTZ only, DAZ only and FTZ+DAZ (the toward-zero modes take the
+ * fallback's double-only path, the others its general one). The public
+ * helpers (fast path + fallback) are checked against the reference too, in
+ * the modes the build is defined for (only rz+ftz+daz with
+ * -DSPU_HELPERS_FP_RZDAZ). Parts:
+ *   A  the decode/encode pieces, exhaustively: spu__fx2d_v vs spu__fx2d on
+ *      all 2^32 words (a zero operand decodes as +0); spu__d2fx_v vs
+ *      spu__d2fx on all 2^32 high dwords of a double (random low dword) and
+ *      the low-dword edges over the exponent window that matters
+ *   B  random vectors: SPU specials, exponent 255, denormals, zeros, range
+ *      edges, cancellation, and reciprocal/rsqrt Newton steps on vectors
+ *      with zero lanes (frest/frsqest + fi of 0: the fallback's main
+ *      customer in game code)
+ *   C  all pairs of a structured set (every exponent class edge x mantissa
+ *      edges x sign, plus random values), as a, b and c
+ *   D  compile-time constant operands (each slot, and all of them) inlined
+ *      into spu_<op>_vx vs the reference on the same values from memory:
+ *      no float op of the fallback may be folded (clang folds with
+ *      round-to-nearest and IEEE denormals)
+ * Build (from this directory), with the flags of lifted SPU TUs:
+ *   clang-cl /O2 /arch:AVX2 /clang:-ffp-contract=off [-DSPU_HELPERS_FP_RZDAZ] -I.. -I../../../include test_spu_helpers_vx.c
+ *   test_spu_helpers_vx [random-vectors-per-mode] [structured-set-extra] [skip-part-A]
+ * (part A takes ~10 s; without AVX2+FMA3 the test has nothing to check.) */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <xmmintrin.h>
+
+#if SPU_SIMD_X86 && defined(__AVX2__) && defined(__FMA__)
+
+#if defined(_MSC_VER) && !defined(__clang__)
+#  define NOINL __declspec(noinline)
+#else
+#  define NOINL __attribute__((noinline))
+#endif
+
+static uint64_t g_s = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd32(void) { g_s ^= g_s << 13; g_s ^= g_s >> 7; g_s ^= g_s << 17; return (uint32_t)(g_s >> 32); }
+
+static const uint32_t SPECIAL[] = {
+    0x00000000u, 0x80000000u, 0x00000001u, 0x80000001u, 0x007FFFFFu, 0x807FFFFFu,
+    0x00400000u, 0x00800000u, 0x80800000u, 0x00800001u, 0x00FFFFFFu, 0x01000000u,
+    0x3F800000u, 0xBF800000u, 0x40000000u, 0xC0000000u, 0x3F000000u, 0xBF000000u,
+    0x3F7FFFFFu, 0x3F800001u, 0x7F7FFFFFu, 0xFF7FFFFFu, 0x7F000000u, 0x7F7FFFFEu,
+    0x7F800000u, 0xFF800000u, 0x7F800001u, 0x7FC00000u, 0xFFC00000u, 0x7FFFFFFFu,
+    0xFFFFFFFFu, 0x7FFFFFFEu, 0x7FBFFFFFu, 0x5F800000u, 0x1F800000u, 0x20000000u,
+    0x1F7FFFFFu, 0x3F7FFFFEu, 0x4B000000u, 0x4F000000u, 0xCF000000u, 0x4F800000u,
+    0x0D800000u, 0x71800000u, 0x7E800000u, 0xFE800000u, 0x00C00000u, 0x80C00000u,
+    0x7F7FFFFDu, 0x7FFFFFFDu, 0x00800002u, 0x01000001u, 0x3FFFFFFFu, 0x7F000001u,
+};
+#define NSPECIAL (sizeof SPECIAL / sizeof SPECIAL[0])
+
+static uint32_t gen_any(void) {
+    uint32_t k = rnd32() % 10, s = rnd32() & 0x80000000u, m = rnd32() & 0x7FFFFFu;
+    switch (k) {
+    case 0: case 1: return rnd32();
+    case 2: return SPECIAL[rnd32() % NSPECIAL];
+    case 3: { static const uint32_t ex[] = {0,0,1,1,2,3,125,126,127,128,129,130,251,252,253,254,254,255,255,255};
+              return s | (ex[rnd32() % 20] << 23) | m; }
+    case 4: return s | ((100u + rnd32() % 55u) << 23) | m;
+    case 5: return s | (0xFFu << 23) | m;                                /* exponent 255 */
+    case 6: return s | ((rnd32() % 4) << 23) | m;                        /* zero / denormal / tiny */
+    case 7: return (rnd32() & 3) ? 0 : 0x80000000u;                      /* zeros */
+    case 8: return s | ((rnd32() % 256u) << 23) | (m & ~0xFFFFu);        /* short mantissas */
+    default: return s | ((rnd32() % 256u) << 23) | m;
+    }
+}
+static uint32_t perturb(uint32_t v) {
+    uint32_t d = rnd32() % 5, r = v;
+    switch (rnd32() % 4) { case 0: r = v + d; break; case 1: r = v - d; break; case 2: r = v ^ (rnd32() & 0xFFu); break; default: break; }
+    if (rnd32() & 1) r ^= 0x80000000u;
+    return r;
+}
+
+/* MXCSR: all exceptions masked; RC nearest / toward zero; FTZ 0x8000, DAZ 0x40 */
+static const unsigned MODES[8] = { 0x1F80u, 0x7F80u, 0x9F80u, 0xFF80u, 0x1FC0u, 0x7FC0u, 0x9FC0u, 0xFFC0u };
+static const char* MNAME[8] = { "rn", "rz", "rn+ftz", "rz+ftz", "rn+daz", "rz+daz", "rn+ftz+daz", "rz+ftz+daz" };
+
+static long g_fail, g_checked;
+static void report(const char* what, const char* mode, const u128* in, int nin, u128 got, u128 ref) {
+    if (++g_fail <= 30) {
+        printf("FAIL %s [%s]", what, mode);
+        for (int k = 0; k < nin; k++) printf(" %08X.%08X.%08X.%08X", in[k]._u32[0], in[k]._u32[1], in[k]._u32[2], in[k]._u32[3]);
+        printf(" got %08X.%08X.%08X.%08X ref %08X.%08X.%08X.%08X\n", got._u32[0], got._u32[1], got._u32[2], got._u32[3],
+               ref._u32[0], ref._u32[1], ref._u32[2], ref._u32[3]);
+    }
+}
+static int neq(u128 a, u128 b) { return memcmp(&a, &b, 16) != 0; }
+
+/* the fallback bodies, out of line as in lifted code */
+#define VX2(op) static NOINL u128 op##_vxo(u128 a, u128 b) { return spu__u(op##_vx(spu__v(a), spu__v(b))); }
+#define VX3(op) static NOINL u128 op##_vxo(u128 a, u128 b, u128 c) { return spu__u(op##_vx(spu__v(a), spu__v(b), spu__v(c))); }
+VX2(spu_fa) VX2(spu_fs) VX2(spu_fm) VX3(spu_fma) VX3(spu_fms) VX3(spu_fnms)
+
+static int g_public_ok;     /* are the public helpers defined in the current mode? */
+static void check_all(const char* mode, u128 a, u128 b, u128 c) {
+    const u128 in[3] = { a, b, c };
+#define C2(op) do { const u128 r = op##_ref(a, b), g = op##_vxo(a, b); g_checked++; if (neq(g, r)) report(#op "_vx", mode, in, 2, g, r); \
+                    if (g_public_ok) { const u128 p = op(a, b); if (neq(p, r)) report(#op, mode, in, 2, p, r); } } while (0)
+#define C3(op) do { const u128 r = op##_ref(a, b, c), g = op##_vxo(a, b, c); g_checked++; if (neq(g, r)) report(#op "_vx", mode, in, 3, g, r); \
+                    if (g_public_ok) { const u128 p = op(a, b, c); if (neq(p, r)) report(#op, mode, in, 3, p, r); } } while (0)
+    C2(spu_fa); C2(spu_fs); C2(spu_fm); C3(spu_fma); C3(spu_fms); C3(spu_fnms);
+#undef C2
+#undef C3
+}
+
+static u128 V4(uint32_t x, uint32_t y, uint32_t z, uint32_t w) { u128 r; r._u32[0] = x; r._u32[1] = y; r._u32[2] = z; r._u32[3] = w; return r; }
+static u128 genv(void) { return V4(gen_any(), gen_any(), gen_any(), gen_any()); }
+
+static void part_a(void) {
+    long bad = 0;
+    for (uint64_t x0 = 0; x0 < (1ull << 32); x0 += 4) {
+        const __m256d d = spu__fx2d_v(_mm_add_epi32(_mm_set1_epi32((int)(uint32_t)x0), _mm_setr_epi32(0, 1, 2, 3)));
+        double dd[4]; memcpy(dd, &d, 32);
+        for (int l = 0; l < 4; l++) {
+            const double r = spu__fx2d((uint32_t)x0 + (uint32_t)l);
+            /* the same bits, but a zero operand decodes as +0 (its sign cannot
+             * reach a result: see spu_<op>_vx) */
+            if (memcmp(&dd[l], &r, 8) != 0 && !(r == 0.0 && dd[l] == 0.0 && !signbit(dd[l])) && ++bad <= 10)
+                printf("FAIL fx2d %08X\n", (uint32_t)x0 + (uint32_t)l);
+        }
+    }
+    printf("A  fx2d: all 2^32 words, %ld mismatches\n", bad); g_fail += bad; bad = 0;
+    for (uint64_t h0 = 0; h0 < (1ull << 32); h0 += 4) {
+        if (((h0 >> 20) & 0x7FF) == 0x7FF) continue;               /* inf/NaN: never an input */
+        uint64_t q[4];
+        for (int l = 0; l < 4; l++) q[l] = ((h0 + (uint64_t)l) << 32) | rnd32();
+        __m256d d; memcpy(&d, q, 32);
+        const u128 g = spu__u(spu__d2fx_v(d));
+        for (int l = 0; l < 4; l++) {
+            double x; memcpy(&x, &q[l], 8);
+            const uint32_t r = spu__d2fx(x);
+            if (g._u32[l] != r && ++bad <= 10) printf("FAIL d2fx %016llX got %08X ref %08X\n", (unsigned long long)q[l], g._u32[l], r);
+        }
+    }
+    static const uint32_t lows[] = { 0, 1, 0x1FFFFFFFu, 0x20000000u, 0xFFFFFFFFu, 0xE0000000u };
+    for (uint32_t de = 850; de <= 1200; de++)
+        for (int k = 0; k < 6; k++)
+            for (int t = 0; t < 4096; t++) {
+                const uint64_t q = ((uint64_t)(rnd32() & 1) << 63) | ((uint64_t)de << 52) | ((uint64_t)(rnd32() & 0xFFFFFu) << 32) | lows[k];
+                double x; memcpy(&x, &q, 8);
+                const uint32_t g = (uint32_t)_mm_cvtsi128_si32(spu__d2fx_v(_mm256_castsi256_pd(_mm256_set1_epi64x((long long)q)))), r = spu__d2fx(x);
+                if (g != r && ++bad <= 10) printf("FAIL d2fx %016llX got %08X ref %08X\n", (unsigned long long)q, g, r);
+            }
+    printf("A  d2fx: all 2^32 high dwords + low-dword edges, %ld mismatches\n", bad); g_fail += bad;
+}
+
+static uint32_t* g_set; static int g_nset;
+static void build_set(int extra) {
+    static const uint32_t ex[] = { 0, 1, 2, 3, 23, 24, 25, 63, 64, 100, 125, 126, 127, 128, 129, 150, 190, 191, 192, 230, 231, 232, 252, 253, 254, 255 };
+    static const uint32_t mt[] = { 0, 1, 2, 0x3FFFFF, 0x400000, 0x400001, 0x7FFFFE, 0x7FFFFF, 0x555555, 0x2AAAAA, 0x100000, 0x7FF000 };
+    g_set = (uint32_t*)malloc(sizeof(uint32_t) * (size_t)(2 * 26 * 12 + extra));
+    for (int s = 0; s < 2; s++) for (int e = 0; e < 26; e++) for (int m = 0; m < 12; m++)
+        g_set[g_nset++] = ((uint32_t)s << 31) | (ex[e] << 23) | mt[m];
+    for (int i = 0; i < extra; i++) g_set[g_nset++] = gen_any();
+}
+
+/* ---- D: constant operands. One function per (op, constant slots, constant);
+ * the reference sees the constant through memory. ---- */
+#define CONSTS(X) X(0, 0x00000000u) X(1, 0x80000000u) X(2, 0x3F800000u) X(3, 0xBF800000u) X(4, 0x00800000u) \
+    X(5, 0x00000001u) X(6, 0x807FFFFFu) X(7, 0x7F7FFFFFu) X(8, 0x7F800000u) X(9, 0x7FFFFFFFu) X(10, 0xFFFFFFFFu) \
+    X(11, 0x0C000001u) X(12, 0x3F000000u) X(13, 0x7F000001u)
+static const u128* volatile g_launder;
+static u128 opq(u128 x) { u128 t = x; g_launder = &t; return *g_launder; }
+#define K(c) spu_splat_u32(c)
+#define D2(op, ci, c) \
+    static NOINL void d_##op##_a_##ci(const u128* v, u128* g, u128* r)  { *g = spu__u(op##_vx(spu__v(K(c)), spu__v(v[0]))); *r = op##_ref(opq(K(c)), v[0]); } \
+    static NOINL void d_##op##_b_##ci(const u128* v, u128* g, u128* r)  { *g = spu__u(op##_vx(spu__v(v[0]), spu__v(K(c)))); *r = op##_ref(v[0], opq(K(c))); } \
+    static NOINL void d_##op##_ab_##ci(const u128* v, u128* g, u128* r) { (void)v; *g = spu__u(op##_vx(spu__v(K(c)), spu__v(K(c)))); *r = op##_ref(opq(K(c)), opq(K(c))); }
+#define D3(op, ci, c) \
+    static NOINL void d_##op##_a_##ci(const u128* v, u128* g, u128* r)  { *g = spu__u(op##_vx(spu__v(K(c)), spu__v(v[0]), spu__v(v[1]))); *r = op##_ref(opq(K(c)), v[0], v[1]); } \
+    static NOINL void d_##op##_b_##ci(const u128* v, u128* g, u128* r)  { *g = spu__u(op##_vx(spu__v(v[0]), spu__v(K(c)), spu__v(v[1]))); *r = op##_ref(v[0], opq(K(c)), v[1]); } \
+    static NOINL void d_##op##_c_##ci(const u128* v, u128* g, u128* r)  { *g = spu__u(op##_vx(spu__v(v[0]), spu__v(v[1]), spu__v(K(c)))); *r = op##_ref(v[0], v[1], opq(K(c))); } \
+    static NOINL void d_##op##_abc_##ci(const u128* v, u128* g, u128* r) { (void)v; *g = spu__u(op##_vx(spu__v(K(c)), spu__v(K(c ^ 0x00400000u)), spu__v(K(c ^ 0x80000001u)))); \
+                                                                          *r = op##_ref(opq(K(c)), opq(K(c ^ 0x00400000u)), opq(K(c ^ 0x80000001u))); }
+#define DDEFS(ci, c) D2(spu_fa, ci, c) D2(spu_fs, ci, c) D2(spu_fm, ci, c) D3(spu_fma, ci, c) D3(spu_fms, ci, c) D3(spu_fnms, ci, c)
+CONSTS(DDEFS)
+typedef void (*dfn)(const u128*, u128*, u128*);
+static const dfn g_dfn[] = {
+#define E2(op, ci) d_##op##_a_##ci, d_##op##_b_##ci, d_##op##_ab_##ci,
+#define E3(op, ci) d_##op##_a_##ci, d_##op##_b_##ci, d_##op##_c_##ci, d_##op##_abc_##ci,
+#define DENT(ci, c) E2(spu_fa, ci) E2(spu_fs, ci) E2(spu_fm, ci) E3(spu_fma, ci) E3(spu_fms, ci) E3(spu_fnms, ci)
+    CONSTS(DENT)
+};
+static void part_d(const char* mode) {
+    for (size_t f = 0; f < sizeof g_dfn / sizeof g_dfn[0]; f++)
+        for (int i = 0; i < g_nset; i += 2) {
+            const u128 v[2] = { V4(g_set[i], g_set[(i + 1) % g_nset], g_set[(i + 7) % g_nset], g_set[(i + 13) % g_nset]),
+                                V4(g_set[(i + 3) % g_nset], g_set[(i + 5) % g_nset], g_set[(i + 11) % g_nset], g_set[(i + 17) % g_nset]) };
+            u128 g, r;
+            g_dfn[f](v, &g, &r);
+            g_checked++;
+            if (neq(g, r)) report("const-operand vx", mode, v, 2, g, r);
+        }
+}
+
+int main(int argc, char** argv) {
+    const long NR = argc > 1 ? atol(argv[1]) : 300000;
+    const int NS = argc > 2 ? atoi(argv[2]) : 200;
+    const int skip_a = argc > 3 && atoi(argv[3]) != 0;
+    const unsigned saved = _mm_getcsr();
+    if (!skip_a) part_a();
+    build_set(NS);
+    printf("structured set: %d values\n", g_nset);
+    for (int m = 0; m < 8; m++) {
+#if defined(SPU_HELPERS_FP_RZDAZ)
+        g_public_ok = (MODES[m] == 0xFFC0u);
+#else
+        g_public_ok = 1;
+#endif
+        const long f0 = g_fail, c0 = g_checked;
+        g_s = 0x9E3779B97F4A7C15ull + (uint64_t)m;
+        _mm_setcsr(MODES[m]);
+        for (long n = 0; n < NR; n++) {                                  /* B */
+            u128 a = genv(), b = genv(), c = genv();
+            switch (rnd32() % 8) {
+            case 0: for (int l = 0; l < 4; l++) b._u32[l] = perturb(a._u32[l]); break;          /* fa/fs cancellation */
+            case 1: for (int l = 0; l < 4; l++) c._u32[l] = perturb(spu__d2fx(spu__fx2d(a._u32[l]) * spu__fx2d(b._u32[l]))); break;
+            case 2: {   /* Newton steps on vectors with zero / denormal lanes */
+                u128 x = genv();
+                for (int l = 0; l < 4; l++) if (rnd32() & 1) x._u32[l] = (rnd32() & 1) ? 0 : (rnd32() & 0x807FFFFFu);
+                const u128 y = spu_fi(x, spu_frest(x)), one = spu_splat_u32(0x3F800000u);
+                const u128 ax = spu_and(x, spu_splat_u32(0x7FFFFFFFu)), z = spu_fi(ax, spu_frsqest(ax));
+                switch (rnd32() % 4) { case 0: a = x; b = y; c = one; break; case 1: a = y; b = y; c = genv(); break;
+                                       case 2: a = ax; b = z; c = one; break; default: a = genv(); b = z; c = y; break; }
+                break; }
+            case 3:     /* products near the range edges */
+                for (int l = 0; l < 4; l++) {
+                    const int ea = (int)((a._u32[l] >> 23) & 0xFF);
+                    int tgt = (rnd32() & 1) ? 254 + 127 - ea + (int)(rnd32() % 4) - 1 : 128 - ea + (int)(rnd32() % 3) - 1;
+                    if (tgt < 0) tgt = 0;
+                    if (tgt > 255) tgt = 255;
+                    b._u32[l] = (rnd32() & 0x80000000u) | ((uint32_t)tgt << 23) | (rnd32() & 0x7FFFFFu);
+                }
+                break;
+            default: break;
+            }
+            check_all(MNAME[m], a, b, c);
+        }
+        for (int i = 0; i < g_nset; i++)                                 /* C */
+            for (int j = 0; j < g_nset; j += 4) {
+                const u128 a = V4(g_set[i], g_set[i], g_set[i], g_set[i]);
+                const u128 b = V4(g_set[j], g_set[(j + 1) % g_nset], g_set[(j + 2) % g_nset], g_set[(j + 3) % g_nset]);
+                const u128 c = V4(g_set[rnd32() % g_nset], g_set[rnd32() % g_nset], g_set[(i + j) % g_nset], g_set[rnd32() % g_nset]);
+                check_all(MNAME[m], a, b, c);
+                check_all(MNAME[m], b, a, c);
+                check_all(MNAME[m], c, b, a);
+            }
+        part_d(MNAME[m]);                                                /* D */
+        _mm_setcsr(saved);
+        printf("  %-11s %10ld vector checks, %ld failures\n", MNAME[m], g_checked - c0, g_fail - f0);
+    }
+    _mm_setcsr(saved);
+    printf("test_spu_helpers_vx: %s (%ld vector checks, %ld failures)\n", g_fail ? "FAIL" : "ok", g_checked, g_fail);
+    return g_fail != 0;
+}
+#else
+int main(void) { printf("test_spu_helpers_vx: needs AVX2+FMA3 (the fallback is the scalar reference otherwise): skipped\n"); return 0; }
+#endif
diff --git a/runtime/spu/tests/test_spu_helpers_win.c b/runtime/spu/tests/test_spu_helpers_win.c
new file mode 100644
index 0000000..c335762
--- /dev/null
+++ b/runtime/spu/tests/test_spu_helpers_win.c
@@ -0,0 +1,252 @@
+/* Exactness of the speculative-window forms of spu_helpers.h (spu_lifter.py
+ * --reg-cache, _rc_windows). A window commits its fast copy only when every
+ * leaf passes; this checks, op by op, on random and special operands in all
+ * four MXCSR modes (rz, rn, rz+ftz/daz, rn+ftz/daz -- the lifted code runs in
+ * rz+ftz/daz, the others must hold too: a window never changes a result in
+ * any mode), that
+ *   1. a float op's leaf passes exactly when its helper keeps its fast path
+ *      (|f| <= 0x7F7FFFFE), and then the window form returns the helper's
+ *      bits; the raw form (no +0) returns the same bits but for the sign of a
+ *      zero, and the same leaf;
+ *   2. fcgt/fceq/cflts/cfltu: with every operand passing spu_wchk (no
+ *      exponent-255 lane) the window form returns the helper's bits, and
+ *      spu_wchk fails exactly on an exponent-255 lane;
+ *   3. the ops a raw (unnormalized) result may feed -- fa/fs/fm/fma/fms/fnms
+ *      (both forms), fcgt/fceq, cflts/cfltu -- give the same leaf and the
+ *      same bits (float ops: up to the sign of a zero result) when a +0
+ *      operand lane is replaced by -0;
+ *   4. shufb_k: a zero guard means the literal path equals spu_shufb;
+ *   5. spu_w_ok over a tree of leaves is the AND of the per-leaf tests.
+ * Build (x86-64, FMA3; the forms exist only with SPU_HELPERS_FP_RZDAZ):
+ *   clang-cl /O2 -I.. -I../../../include /arch:AVX2 -DSPU_HELPERS_FP_RZDAZ test_spu_helpers_win.c
+ *   clang-cl /O2 -I.. -I../../../include /arch:AVX512 -DSPU_HELPERS_FP_RZDAZ test_spu_helpers_win.c */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if !SPU_WIN_ENABLE
+int main(void) { printf("SPU_WIN_ENABLE is 0 in this configuration: nothing to test\n"); return 0; }
+#else
+int g_spu_win_tries = 4;
+static uint64_t g_s = 0x2545F4914F6CDD1Dull;
+static uint32_t rnd32(void) { g_s ^= g_s << 13; g_s ^= g_s >> 7; g_s ^= g_s << 17; return (uint32_t)(g_s >> 32); }
+static const uint32_t g_sp[] = { 0x00000000u, 0x80000000u, 0x00000001u, 0x807FFFFFu, 0x00800000u, 0x80800000u,
+    0x3F800000u, 0xBF800000u, 0x7F7FFFFEu, 0x7F7FFFFFu, 0xFF7FFFFFu, 0x7F800000u, 0xFF800000u, 0x7FC00000u,
+    0x7FFFFFFFu, 0xFFFFFFFFu, 0x5F800000u, 0xDF800000u, 0x1F800000u, 0x20000000u, 0x60000000u, 0x00012345u };
+static uint32_t word(void) {
+    const uint32_t k = rnd32() % 16u;
+    if (k < 4) return g_sp[rnd32() % (sizeof g_sp / 4)];
+    if (k < 6) return rnd32();                                            /* raw bits */
+    if (k < 8) return (rnd32() & 0x807FFFFFu) | ((uint32_t)(rnd32() % 3u + 252u) << 23);   /* near overflow */
+    if (k < 10) return (rnd32() & 0x807FFFFFu) | ((uint32_t)(rnd32() % 4u) << 23);         /* near underflow */
+    return (rnd32() & 0x807FFFFFu) | ((uint32_t)(rnd32() % 60u + 98u) << 23);              /* ordinary */
+}
+static u128 rq(void) { u128 r; for (int i = 0; i < 4; i++) r._u32[i] = word(); return r; }
+static u128 opq(u128 v) { volatile u128 t = v; return t; }
+static long long g_bad, g_n, g_fast;
+static void fail(const char* what, int mode, u128 a, u128 b, u128 c, u128 got, u128 want) {
+    if (g_bad++ < 30)
+        printf("MISMATCH %s mode %d a=%08X%08X%08X%08X b=%08X%08X%08X%08X c=%08X%08X%08X%08X got=%08X%08X%08X%08X want=%08X%08X%08X%08X\n",
+               what, mode, a._u32[0], a._u32[1], a._u32[2], a._u32[3], b._u32[0], b._u32[1], b._u32[2], b._u32[3],
+               c._u32[0], c._u32[1], c._u32[2], c._u32[3], got._u32[0], got._u32[1], got._u32[2], got._u32[3],
+               want._u32[0], want._u32[1], want._u32[2], want._u32[3]);
+}
+static int same(u128 x, u128 y) { return !memcmp(&x, &y, 16); }
+static int same_but_zero_sign(u128 x, u128 y) {
+    for (int i = 0; i < 4; i++)
+        if (x._u32[i] != y._u32[i] && !((x._u32[i] | y._u32[i]) == 0x80000000u && (x._u32[i] & y._u32[i] & 0x7FFFFFFFu) == 0)) return 0;
+    return 1;
+}
+static int leaf_ok(__m128i l) { return spu_w_ok(l, _mm_setzero_si128(), _mm_setzero_si128()); }
+static int helper_fast(__m128 f) {   /* the RZDAZ result test: every |f| <= 0x7F7FFFFE */
+    u128 r; memcpy(&r, &f, 16);
+    for (int i = 0; i < 4; i++) if ((r._u32[i] & 0x7FFFFFFFu) > 0x7F7FFFFEu) return 0;
+    return 1;
+}
+static int no_e255(u128 x) { for (int i = 0; i < 4; i++) if ((x._u32[i] & 0x7F800000u) == 0x7F800000u) return 0; return 1; }
+static __m128 hostf(int op, u128 a, u128 b, u128 c) {    /* the helpers' fast-path value before the +0 */
+    __m128 x = spu__f(spu__v(a)), y = spu__f(spu__v(b)), z = spu__f(spu__v(c));
+    __asm__("" : "+x"(x), "+x"(y), "+x"(z));
+    switch (op) {
+    case 0: return _mm_add_ps(x, y);
+    case 1: return _mm_sub_ps(x, y);
+    case 2: return _mm_mul_ps(x, y);
+    case 3: return _mm_fmadd_ps(x, y, z);
+    case 4: return _mm_fmsub_ps(x, y, z);
+    default: return _mm_fnmadd_ps(x, y, z);
+    }
+}
+static const char* g_fname[6] = { "fa", "fs", "fm", "fma", "fms", "fnms" };
+static u128 helper(int op, u128 a, u128 b, u128 c) {
+    switch (op) {
+    case 0: return spu_fa(a, b);
+    case 1: return spu_fs(a, b);
+    case 2: return spu_fm(a, b);
+    case 3: return spu_fma(a, b, c);
+    case 4: return spu_fms(a, b, c);
+    default: return spu_fnms(a, b, c);
+    }
+}
+static u128 wform(int op, int raw, u128 a, u128 b, u128 c, __m128i* l) {
+    switch (op * 2 + raw) {
+    case 0: return spu_wfa(a, b, l);       case 1: return spu_wfa_r(a, b, l);
+    case 2: return spu_wfs(a, b, l);       case 3: return spu_wfs_r(a, b, l);
+    case 4: return spu_wfm(a, b, l);       case 5: return spu_wfm_r(a, b, l);
+    case 6: return spu_wfma(a, b, c, l);   case 7: return spu_wfma_r(a, b, c, l);
+    case 8: return spu_wfms(a, b, c, l);   case 9: return spu_wfms_r(a, b, c, l);
+    case 10: return spu_wfnms(a, b, c, l); default: return spu_wfnms_r(a, b, c, l);
+    }
+}
+static u128 leafu(__m128i l) { return spu__u(l); }
+
+static void float_ops(int mode, u128 a, u128 b, u128 c) {
+    for (int op = 0; op < 6; op++) {
+        const u128 h = helper(op, a, b, c);
+        const int fast = helper_fast(hostf(op, a, b, c));
+        __m128i l0, l1;
+        const u128 w0 = wform(op, 0, a, b, c, &l0), w1 = wform(op, 1, a, b, c, &l1);
+        g_n++;
+        if (leaf_ok(l0) != fast) fail(g_fname[op], mode, a, b, c, leafu(l0), h);
+        if (!same(leafu(l0), leafu(l1))) fail("raw leaf", mode, a, b, c, leafu(l1), leafu(l0));
+        if (fast) {
+            g_fast++;
+            if (!same(w0, h)) fail(g_fname[op], mode, a, b, c, w0, h);
+            if (!same_but_zero_sign(w1, h)) fail("raw", mode, a, b, c, w1, h);
+        }
+    }
+}
+static void cmp_cvt(int mode, u128 a, u128 b) {
+    const int ok = no_e255(a) && no_e255(b);
+    const int chk = spu_w_ok(_mm_setzero_si128(), _mm_max_epu32(spu_wchk(a), spu_wchk(b)), _mm_setzero_si128());
+    g_n++;
+    if (chk != ok) fail("wchk", mode, a, b, b, spu__u(spu_wchk(a)), spu__u(spu_wchk(b)));
+    if (!ok) return;
+    u128 g, w;
+    if (!same(g = spu_wfcgt(a, b), w = spu_fcgt(a, b))) fail("fcgt", mode, a, b, b, g, w);
+    if (!same(g = spu_wfceq(a, b), w = spu_fceq(a, b))) fail("fceq", mode, a, b, b, g, w);
+#define CVT(i8) \
+    if (!same(g = spu_wcflts(a, i8), w = spu_cflts(a, i8))) fail("cflts " #i8, mode, a, b, b, g, w); \
+    if (!same(g = spu_wcfltu(a, i8), w = spu_cfltu(a, i8))) fail("cfltu " #i8, mode, a, b, b, g, w);
+    CVT(173) CVT(165) CVT(155) CVT(150) CVT(100) CVT(46) CVT(30) CVT(240) CVT(0) CVT(255)
+#undef CVT
+}
+/* 3: a raw result may be -0 where the normalized one is +0 */
+static u128 negz(u128 x, uint32_t m) {
+    for (int i = 0; i < 4; i++) if ((m >> i) & 1 && x._u32[i] == 0) x._u32[i] = 0x80000000u;
+    return x;
+}
+static u128 denz(u128 x, uint32_t m) {    /* zero lanes -> a denormal of either sign */
+    for (int i = 0; i < 4; i++)
+        if ((x._u32[i] & 0x7FFFFFFFu) == 0)
+            x._u32[i] = ((m >> i) & 1 ? 0x80000000u : 0u) | (1u + rnd32() % 0x7FFFFFu);
+    return x;
+}
+static void zero_sign(int mode, u128 a, u128 b, u128 c) {
+    for (int i = 0; i < 4; i++) {           /* plant some zeros */
+        if (rnd32() % 3 == 0) a._u32[i] = 0;
+        if (rnd32() % 3 == 0) b._u32[i] = 0;
+        if (rnd32() % 3 == 0) c._u32[i] = 0;
+    }
+    const uint32_t m = rnd32();
+    const u128 a2 = negz(a, m), b2 = negz(b, m >> 4), c2 = negz(c, m >> 8);
+    for (int op = 0; op < 6; op++)
+        for (int raw = 0; raw < 2; raw++) {
+            __m128i l1, l2;
+            const u128 w1 = wform(op, raw, a, b, c, &l1), w2 = wform(op, raw, a2, b2, c2, &l2);
+            g_n++;
+            /* a window commits only when the leaf passes: then the leaf and
+             * the result must not depend on the zero signs (a failing leaf --
+             * an inf/NaN or overflow lane -- may: e.g. a NaN's sign) */
+            if (leaf_ok(l1) != leaf_ok(l2)) fail("zero-sign leaf", mode, a2, b2, c2, leafu(l2), leafu(l1));
+            else if (leaf_ok(l1)) {
+                if (!same(leafu(l1), leafu(l2))) fail("zero-sign leaf bits", mode, a2, b2, c2, leafu(l2), leafu(l1));
+                if (raw ? !same_but_zero_sign(w1, w2) : !same(w1, w2)) fail("zero-sign op", mode, a2, b2, c2, w2, w1);
+            }
+        }
+    if (no_e255(a) && no_e255(b)) {
+        if (!same(spu_wfcgt(a, b), spu_wfcgt(a2, b2))) fail("zero-sign fcgt", mode, a2, b2, b2, spu_wfcgt(a2, b2), spu_wfcgt(a, b));
+        if (!same(spu_wfceq(a, b), spu_wfceq(a2, b2))) fail("zero-sign fceq", mode, a2, b2, b2, spu_wfceq(a2, b2), spu_wfceq(a, b));
+        if (!same(spu_wcflts(a, 173), spu_wcflts(a2, 173))) fail("zero-sign cflts", mode, a2, b2, b2, a2, a);
+        if (!same(spu_wcfltu(a, 165), spu_wcfltu(a2, 165))) fail("zero-sign cfltu", mode, a2, b2, b2, a2, a);
+    }
+    /* 3b (DAZ modes, the only ones lifted code runs in): a raw result may also
+     * be a DENORMAL where the statement's is +0 -- clang folds x*1, x-0 and
+     * x+(-0) to x, so a denormal operand passes through a raw form unflushed
+     * (the +0 of the normalized form flushes it under DAZ) */
+    if (mode >= 2) {
+        const u128 a3 = denz(a, m), b3 = denz(b, m >> 4), c3 = denz(c, m >> 8);
+        for (int op = 0; op < 6; op++)
+            for (int raw = 0; raw < 2; raw++) {
+                __m128i l1, l3;
+                const u128 w1 = wform(op, raw, a, b, c, &l1), w3 = wform(op, raw, a3, b3, c3, &l3);
+                g_n++;
+                if (leaf_ok(l1) != leaf_ok(l3)) fail("denormal leaf", mode, a3, b3, c3, leafu(l3), leafu(l1));
+                else if (leaf_ok(l1)) {
+                    if (!same(leafu(l1), leafu(l3))) fail("denormal leaf bits", mode, a3, b3, c3, leafu(l3), leafu(l1));
+                    if (raw ? !same_but_zero_sign(w1, w3) : !same(w1, w3)) fail("denormal op", mode, a3, b3, c3, w3, w1);
+                }
+            }
+        if (no_e255(a) && no_e255(b)) {
+            if (!same(spu_wfcgt(a, b), spu_wfcgt(a3, b3))) fail("denormal fcgt", mode, a3, b3, b3, spu_wfcgt(a3, b3), spu_wfcgt(a, b));
+            if (!same(spu_wfceq(a, b), spu_wfceq(a3, b3))) fail("denormal fceq", mode, a3, b3, b3, spu_wfceq(a3, b3), spu_wfceq(a, b));
+            for (int i8 = 0; i8 < 256; i8 += 51) {
+                if (!same(spu_wcflts(a, i8), spu_wcflts(a3, i8))) fail("denormal cflts", mode, a3, b3, b3, a3, a);
+                if (!same(spu_wcfltu(a, i8), spu_wcfltu(a3, i8))) fail("denormal cfltu", mode, a3, b3, b3, a3, a);
+            }
+        }
+    }
+}
+static void shuf(int mode) {
+    static const uint32_t ks[][4] = { { 0x10111213u, 0x10111213u, 0x10111213u, 0x10111213u },
+        { 0x00010203u, 0x08090A0Bu, 0x14151617u, 0x1C1D1E1Fu }, { 0x80031380u, 0x80071780u, 0x800B1B80u, 0x800F1F80u },
+        { 0xC0E0801Fu, 0x01020304u, 0x1E1D1C1Bu, 0xFFFFFFFFu } };
+    for (int k = 0; k < 4; k++) {
+        const u128 a = opq(rq()), b = opq(rq());
+        u128 c; memcpy(&c, ks[k], 16);
+        if (rnd32() & 1) c._u8[rnd32() % 16] ^= (uint8_t)(1u << (rnd32() % 8));
+        c = opq(c);
+        const __m128i g = spu_wguard(c, ks[k][0], ks[k][1], ks[k][2], ks[k][3]);
+        g_n++;
+        if (spu_w_ok(_mm_setzero_si128(), _mm_setzero_si128(), g) != same(c, *(const u128*)ks[k])) fail("guard", mode, a, b, c, spu__u(g), c);
+        if (_mm_testz_si128(g, g)) {
+            const u128 w = spu_wshufb_k(a, b, ks[k][0], ks[k][1], ks[k][2], ks[k][3]), r = spu_shufb_ref(a, b, c);
+            if (!same(w, r)) fail("shufb_k", mode, a, b, c, w, r);
+        }
+    }
+}
+static void tree(int mode) {   /* 5: max-tree + ok == AND of the per-leaf tests */
+    __m128i acc = _mm_setzero_si128(), oacc = _mm_setzero_si128();
+    int all = 1, oall = 1;
+    const int n = 1 + (int)(rnd32() % 12u);
+    for (int i = 0; i < n; i++) {
+        const u128 a = opq(rq()), b = opq(rq());
+        __m128i l;
+        (void)spu_wfm(a, b, &l);
+        all &= helper_fast(hostf(2, a, b, b));
+        acc = _mm_max_epu32(acc, l);
+        oacc = _mm_max_epu32(oacc, spu_wchk(a));
+        oall &= no_e255(a);
+    }
+    g_n++;
+    if (spu_w_ok(acc, oacc, _mm_setzero_si128()) != (all && oall)) fail("tree", mode, spu__u(acc), spu__u(oacc), spu__u(oacc), spu__u(acc), spu__u(oacc));
+}
+int main(int argc, char** argv) {
+    const long iters = argc > 1 ? atol(argv[1]) : 200000;
+    static const unsigned modes[4] = { 0x7F80u, 0x1F80u, 0xFFC0u, 0x9FC0u };
+    const unsigned saved = _mm_getcsr();
+    for (int m = 0; m < 4; m++) {
+        _mm_setcsr(modes[m]);
+        for (long i = 0; i < iters; i++) {
+            const u128 a = opq(rq()), b = opq(rq()), c = opq(rq());
+            float_ops(m, a, b, c);
+            cmp_cvt(m, a, b);
+            zero_sign(m, a, b, c);
+            if ((i & 15) == 0) { shuf(m); tree(m); }
+        }
+        _mm_setcsr(saved);
+    }
+    printf("%lld checks (%lld float-op cases on the fast path), %lld mismatches\n", g_n, g_fast, g_bad);
+    return g_bad != 0;
+}
+#endif
diff --git a/runtime/spu/tests/test_spu_interp_unlifted_call.c b/runtime/spu/tests/test_spu_interp_unlifted_call.c
new file mode 100644
index 0000000..99faabb
--- /dev/null
+++ b/runtime/spu/tests/test_spu_interp_unlifted_call.c
@@ -0,0 +1,458 @@
+/*
+ * A lifted call into code that has no lift returns to its lifted caller once.
+ *
+ * SPU_INTERP_UNLIFTED=1 lets spu_indirect_branch's unlifted-branch guard run
+ * code that has no lifted function -- a module the title loads at runtime, or
+ * a block of a lifted function that the lift never learned was a branch
+ * target (a jump-table case: inFamous 2's JobChain job 0x008A0900 reaches
+ * +0xED4 / +0xEE0 / +0xF64 / +0x1050 only through `bi $r2` off a four-entry
+ * PC-relative table, and none of them is a lifted entry). The interpreter
+ * runs until it reaches lifted code or `ctx->drain_ret_pc`, the return
+ * address of the innermost lifted frame still live on the host stack.
+ *
+ * That stop is what keeps the caller's continuation from running twice. The
+ * caller's code after the call is in local store as well as lifted; if the
+ * interpreter does not stop at the call's return address it runs on through
+ * that continuation, and the caller's host frame -- still waiting in its
+ * call bracket -- runs it again when the bracket's drain comes back to the
+ * return address (job-chain bookkeeping twice per job: list appends, DMA
+ * puts, atomic updates). So each scenario below counts every piece of guest
+ * code in local store as it runs, interpreted or lifted, and checks:
+ *
+ *   A  a lifted `bisl` into an unlifted function, in a loop (the JobChain
+ *      policy module's job-call shape): every piece runs once per pass;
+ *   B  the same call two lifted frames below a policy-module bracket: the
+ *      interpreter must stop at the INNER call's link, not at the bracket's
+ *      return, and both lifted callers resume in their own frames;
+ *   C  a lifted callee's computed `bi` into an unlifted block of its own
+ *      function, which then rejoins a lifted block that returns (the
+ *      jump-table shape above);
+ *   D  an unlifted callee that itself calls a lifted helper (the interpreter's
+ *      host-call bracket) before returning.
+ *
+ * Every lifted function here is written out as the lifter's lowering of the
+ * guest code next to it (spu_lifter.py: brsl / bisl brackets, SPU_RET,
+ * computed `bi`, `stop`). `bisl` stores the call's return address in
+ * ctx->drain_ret_pc before dispatching, as spu_lifter.py lowers it.
+ *
+ * Negative control (A, second copy): the same program with the `bisl`
+ * lowered WITHOUT that store -- what spu_lifter.py emitted for lifts made
+ * without --regions. drain_ret_pc then names no live frame (0 here: nothing
+ * has drained yet), the interpreter runs the caller's continuation, and the
+ * caller's frame runs it again: the continuation counter reads 3 for 2
+ * passes. The check asserts that, so a runtime change that makes the guard
+ * stop correctly on its own shows up here (update the expectation then); it
+ * is also what shows the counters can see a double execution at all. (In the
+ * guard's old no-stop mode, SPU_INTERP_UNLIFTED_NOSTOP=1, which main() clears,
+ * A, B and D fail: the interpreter runs every caller's continuation itself.)
+ *
+ * No game code: every program below is assembled here from a dozen opcodes.
+ *
+ * Build (Windows, clang-cl; from the toolkit root, the runtime's own flags):
+ *   clang-cl /O2 /std:c17 -MD -msse4.1 -fno-strict-aliasing -ffp-contract=off \
+ *       -I include -I runtime/spu -I runtime/platform \
+ *       runtime/spu/tests/test_spu_interp_unlifted_call.c \
+ *       runtime/spu/spu_channels.c runtime/spu/spu_drain.c runtime/spu/spu_interp.c \
+ *       runtime/spu/spu_coherency.c runtime/spu/spu_lockstep.c \
+ *       runtime/spu/spu_workload.c runtime/spu/spurs_policy.c runtime/spu/spurs_job.c \
+ *       runtime/spu/spu_tsp_weak.c runtime/spu/spu_vm_pagemap.c \
+ *       runtime/spu/spurs_policy_blob_weak.c runtime/platform/win32_compat.c \
+ *       /Fe:test_spu_interp_unlifted_call.exe
+ *
+ * Exit code: 0 if all passed, 1 if any failed. Final line prints a summary.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "spu_context.h"
+#include "spu_helpers.h"
+
+typedef void (*test_spu_fn)(spu_context*);
+void spu_begin_image(int image_id);
+void spu_register_function(uint32_t addr, test_spu_fn fn);
+int  spu_run_with_halt(void (*entry)(spu_context*), spu_context* ctx);
+void spu_stop(spu_context* ctx);
+
+/* Guest memory: nothing here issues a DMA. */
+uint8_t* vm_base = NULL;
+uint32_t ppu_vm_size = 0;
+
+#define TEST_IMG 61   /* the image every lifted function below registers under */
+
+/* ---------------------------------------------------------------------------
+ * Harness
+ * -----------------------------------------------------------------------*/
+static int g_pass, g_fail;
+static void check(int ok, const char* what)
+{
+    if (ok) { g_pass++; return; }
+    g_fail++;
+    printf("  FAIL: %s\n", what);
+}
+
+/* A guest counter: the preferred word of its quadword. */
+static uint32_t cnt(const spu_context* c, uint32_t a) { return spu_ls_read32(c, a); }
+
+/* ---------------------------------------------------------------------------
+ * A dozen SPU opcodes, assembled straight into local store
+ * -----------------------------------------------------------------------*/
+static spu_context* T;   /* the context being assembled into */
+static uint32_t at;      /* LS address of the next instruction */
+
+static uint32_t ri10(uint32_t op8, unsigned rt, unsigned ra, int i10)
+{ return op8 << 24 | ((uint32_t)i10 & 0x3FFu) << 14 | (ra & 0x7Fu) << 7 | (rt & 0x7Fu); }
+static uint32_t ri16(uint32_t op9, unsigned rt, uint32_t i16)
+{ return op9 << 23 | (i16 & 0xFFFFu) << 7 | (rt & 0x7Fu); }
+static uint32_t ri18(uint32_t op7, unsigned rt, uint32_t i18)
+{ return op7 << 25 | (i18 & 0x3FFFFu) << 7 | (rt & 0x7Fu); }
+static uint32_t rr(uint32_t op11, unsigned rt, unsigned ra, unsigned rb)
+{ return op11 << 21 | (rb & 0x7Fu) << 14 | (ra & 0x7Fu) << 7 | (rt & 0x7Fu); }
+
+static void org(uint32_t a)  { at = a; }
+static void emit(uint32_t w) { spu_ls_write32(T, at, w); at += 4; }
+static uint32_t rel(uint32_t target) { return (uint32_t)((int32_t)(target - at) >> 2); }
+
+static void lqa(unsigned rt, uint32_t a)            { emit(ri16(0x061, rt, a >> 2)); }
+static void stqa(unsigned rt, uint32_t a)           { emit(ri16(0x041, rt, a >> 2)); }
+static void ai(unsigned rt, unsigned ra, int i)     { emit(ri10(0x1C, rt, ra, i)); }
+static void ori(unsigned rt, unsigned ra, int i)    { emit(ri10(0x04, rt, ra, i)); }
+static void clgti(unsigned rt, unsigned ra, int i)  { emit(ri10(0x5C, rt, ra, i)); }
+static void ila(unsigned rt, uint32_t v)            { emit(ri18(0x21, rt, v)); }
+static void bi(unsigned ra)                         { emit(rr(0x1A8, 0, ra, 0)); }
+static void bisl(unsigned rt, unsigned ra)          { emit(rr(0x1A9, rt, ra, 0)); }
+static void br(uint32_t t)                          { emit(ri16(0x064, 0, rel(t))); }
+static void brsl(unsigned rt, uint32_t t)           { emit(ri16(0x066, rt, rel(t))); }
+static void brz(unsigned rt, uint32_t t)            { emit(ri16(0x040, rt, rel(t))); }
+static void stop(uint32_t code)                     { emit(code & 0x3FFFu); }
+/* counter++ through register r: lqa / ai 1 / stqa */
+static void inc(unsigned r, uint32_t c)             { lqa(r, c); ai(r, r, 1); stqa(r, c); }
+
+/* ---------------------------------------------------------------------------
+ * The lifter's lowering of the same instructions
+ * -----------------------------------------------------------------------*/
+static void l_inc(spu_context* c, unsigned r, uint32_t a)
+{
+    c->gpr[r] = spu_ls_read128(c, a);
+    c->gpr[r] = spu_ai(c->gpr[r], 1);
+    spu_ls_write128(c, a, c->gpr[r]);
+}
+
+/* bisl rt, ra -- an indirect call. `publish` = the --regions lowering, which
+ * stores the return address in drain_ret_pc before the dispatch. */
+#define L_BISL(c, link_rt, tgt_rt, link, publish) do {                          \
+        (c)->gpr[link_rt] = spu_link(link);                                     \
+        { int32_t _si = (int32_t)(c)->image_id;                                 \
+          (c)->pc = (c)->gpr[tgt_rt]._u32[0]; (c)->host_depth++;                \
+          if (publish) (c)->drain_ret_pc = (link);                              \
+          spu_indirect_branch(c); spu_drain_call((c), (link));                  \
+          (c)->host_depth--; spu_img_restore((c), _si); }                       \
+    } while (0)
+
+/* brsl rt, f -- a direct call into a lifted function */
+#define L_BRSL(c, link_rt, f, link) do {                                        \
+        (c)->gpr[link_rt] = spu_link(link);                                     \
+        { int32_t _si = (int32_t)(c)->image_id; (c)->host_depth++;              \
+          f(c); spu_drain_call((c), (link));                                    \
+          (c)->host_depth--; spu_img_restore((c), _si); }                       \
+    } while (0)
+
+#define L_STOP(c, code) do {                                                    \
+        (c)->stop_code = (code); (c)->status = SPU_STATUS_STOPPED_BY_STOP;      \
+        spu_stop(c); return;                                                    \
+    } while (0)
+
+static spu_context* new_ctx(void)
+{
+    spu_context* c = (spu_context*)calloc(1, sizeof *c);
+    if (!c) { printf("out of memory\n"); exit(2); }
+    spu_context_init(c, 0);
+    c->image_id = TEST_IMG;
+    c->status = SPU_STATUS_RUNNING;
+    T = c;
+    return c;
+}
+
+/* ---------------------------------------------------------------------------
+ * A: lifted bisl into an unlifted function, twice round a loop
+ *
+ *   base+0x00  loop: counter ITER++          (r20)
+ *   base+0x0C        ila  r3, base+0x100
+ *   base+0x10        bisl r0, r3             link base+0x14
+ *   base+0x14        counter CONT++          (r21)
+ *   base+0x20        clgti r22, r21, 1
+ *   base+0x24        brz  r22, loop
+ *   base+0x28        stop 0x123
+ *   base+0x100 X:    counter X++ (r30) ; bi r0      -- not lifted
+ *
+ * Copy 0 lowers the bisl as --regions does; copy 1 is the negative control.
+ * -----------------------------------------------------------------------*/
+static const uint32_t A_BASE[2] = { 0x20000, 0x24000 };
+static const uint32_t A_ITER[2] = { 0x30000, 0x30040 };
+static const uint32_t A_CONT[2] = { 0x30010, 0x30050 };
+static const uint32_t A_X[2]    = { 0x30020, 0x30060 };
+static int a_lifted_cont[2];
+
+static void a_asm(int v)
+{
+    const uint32_t b = A_BASE[v];
+    org(b);
+    inc(20, A_ITER[v]);
+    ila(3, b + 0x100);
+    bisl(0, 3);
+    inc(21, A_CONT[v]);
+    clgti(22, 21, 1);
+    brz(22, b);
+    stop(0x123);
+    org(b + 0x100);
+    inc(30, A_X[v]);
+    bi(0);
+}
+
+static void a_body(spu_context* c, int v)
+{
+    const uint32_t b = A_BASE[v];
+loop:
+    l_inc(c, 20, A_ITER[v]);
+    c->gpr[3] = spu_splat_u32(b + 0x100);
+    L_BISL(c, 0, 3, b + 0x14, v == 0);
+    l_inc(c, 21, A_CONT[v]); a_lifted_cont[v]++;
+    c->gpr[22] = spu_clgti(c->gpr[21], 1);
+    if (c->gpr[22]._u32[0] == 0) { c->pc = b; goto loop; }
+    L_STOP(c, 0x123);
+}
+static void a_P0(spu_context* c) { a_body(c, 0); }
+static void a_P1(spu_context* c) { a_body(c, 1); }
+
+static void test_loop_call(void)
+{
+    for (int v = 0; v < 2; v++) {
+        spu_context* c = new_ctx();
+        a_asm(v);
+        spu_run_with_halt(v ? a_P1 : a_P0, c);
+        if (v == 0) {
+            check(c->status == SPU_STATUS_STOPPED_BY_STOP && c->stop_code == 0x123,
+                  "A: the looped call runs to its stop");
+            check(cnt(c, A_ITER[0]) == 2 && cnt(c, A_X[0]) == 2,
+                  "A: the unlifted callee runs once per pass");
+            check(cnt(c, A_CONT[0]) == 2,
+                  "A: the caller's continuation runs once per pass (no double execution)");
+            check(a_lifted_cont[0] == 2,
+                  "A: the interpreter stops at the link -- the continuation runs lifted, in the caller's frame");
+        } else {
+            printf("  negative control (bisl lowered without drain_ret_pc): CONT=%u X=%u lifted=%d\n",
+                   cnt(c, A_CONT[1]), cnt(c, A_X[1]), a_lifted_cont[1]);
+            check(cnt(c, A_CONT[1]) == 3 && a_lifted_cont[1] == 2,
+                  "A negative control: without its return address the interpreter runs the "
+                  "continuation and the caller's frame runs it again (3 for 2 passes)");
+        }
+        free(c);
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * B: the call two lifted frames below a policy-module bracket
+ *
+ *   0x21000 PM:  ila r3, J ; bisl r0, r3 (link R = 0x21008)
+ *   0x21008      counter PM++ (r20) ; stop 0x124
+ *   0x21100 J:   ori r81, r0, 0 ; brsl r0, F (link 0x21108)
+ *   0x21108      counter J++ (r21) ; ori r0, r81, 0 ; bi r0
+ *   0x21200 F:   ori r80, r0, 0 ; ila r3, X ; bisl r0, r3 (link 0x2120C)
+ *   0x2120C      counter F++ (r22) ; ori r0, r80, 0 ; bi r0
+ *   0x21300 X:   counter X++ (r30) ; bi r0          -- not lifted
+ * -----------------------------------------------------------------------*/
+enum { B_PM = 0x21000, B_J = 0x21100, B_F = 0x21200, B_X = 0x21300,
+       BC_PM = 0x30100, BC_J = 0x30110, BC_F = 0x30120, BC_X = 0x30130 };
+static int b_lifted[3];
+
+static void b_asm(void)
+{
+    org(B_PM); ila(3, B_J); bisl(0, 3); inc(20, BC_PM); stop(0x124);
+    org(B_J);  ori(81, 0, 0); brsl(0, B_F); inc(21, BC_J); ori(0, 81, 0); bi(0);
+    org(B_F);  ori(80, 0, 0); ila(3, B_X); bisl(0, 3); inc(22, BC_F); ori(0, 80, 0); bi(0);
+    org(B_X);  inc(30, BC_X); bi(0);
+}
+static void b_F(spu_context* c)
+{
+    c->gpr[80] = spu_ori(c->gpr[0], 0);
+    c->gpr[3] = spu_splat_u32(B_X);
+    L_BISL(c, 0, 3, B_F + 0xC, 1);
+    l_inc(c, 22, BC_F); b_lifted[2]++;
+    c->gpr[0] = spu_ori(c->gpr[80], 0);
+    SPU_RET(c);
+}
+static void b_J(spu_context* c)
+{
+    c->gpr[81] = spu_ori(c->gpr[0], 0);
+    L_BRSL(c, 0, b_F, B_J + 8);
+    l_inc(c, 21, BC_J); b_lifted[1]++;
+    c->gpr[0] = spu_ori(c->gpr[81], 0);
+    SPU_RET(c);
+}
+static void b_PM(spu_context* c)
+{
+    c->gpr[3] = spu_splat_u32(B_J);
+    L_BISL(c, 0, 3, B_PM + 8, 1);
+    l_inc(c, 20, BC_PM); b_lifted[0]++;
+    L_STOP(c, 0x124);
+}
+
+static void test_nested_call(void)
+{
+    spu_context* c = new_ctx();
+    b_asm();
+    spu_run_with_halt(b_PM, c);
+    check(c->status == SPU_STATUS_STOPPED_BY_STOP && c->stop_code == 0x124,
+          "B: the policy bracket runs to its stop");
+    check(cnt(c, BC_X) == 1 && cnt(c, BC_F) == 1 && cnt(c, BC_J) == 1 && cnt(c, BC_PM) == 1,
+          "B: every piece of guest code runs exactly once");
+    check(b_lifted[2] == 1 && b_lifted[1] == 1 && b_lifted[0] == 1,
+          "B: the interpreter stops at the inner call's link, not the bracket's -- "
+          "both lifted callers resume in their own frames");
+    check(c->host_depth == 0, "B: every call bracket unwound");
+    free(c);
+}
+
+/* ---------------------------------------------------------------------------
+ * C: a lifted callee's computed branch into an unlifted block of its own
+ *    function (the jump-table shape), which rejoins a lifted block
+ *
+ *   0x22000 C:  brsl r0, G (link 0x22004)
+ *   0x22004     counter C++ (r20) ; stop 0x125
+ *   0x22100 G:  ila r2, 0x22140 ; bi r2   (stands in for the table load)
+ *   0x22140 B:  counter B++ (r30) ; br K           -- not lifted
+ *   0x22180 K:  counter K++ (r31) ; bi r0          -- a lifted block of G
+ * -----------------------------------------------------------------------*/
+enum { C_C = 0x22000, C_G = 0x22100, C_B = 0x22140, C_K = 0x22180,
+       CC_C = 0x30200, CC_B = 0x30210, CC_K = 0x30220 };
+static int c_lifted[2];
+
+static void c_asm(void)
+{
+    org(C_C); brsl(0, C_G); inc(20, CC_C); stop(0x125);
+    org(C_G); ila(2, C_B); bi(2);
+    org(C_B); inc(30, CC_B); br(C_K);
+    org(C_K); inc(31, CC_K); bi(0);
+}
+static void c_G(spu_context* c)
+{
+    c->gpr[2] = spu_splat_u32(C_B);
+    c->pc = c->gpr[2]._u32[0]; g_spu_trampoline_fn = spu_indirect_branch;
+}
+static void c_K(spu_context* c) { l_inc(c, 31, CC_K); c_lifted[1]++; SPU_RET(c); }
+static void c_C(spu_context* c)
+{
+    L_BRSL(c, 0, c_G, C_C + 4);
+    l_inc(c, 20, CC_C); c_lifted[0]++;
+    L_STOP(c, 0x125);
+}
+
+static void test_jump_table_block(void)
+{
+    spu_context* c = new_ctx();
+    c_asm();
+    spu_run_with_halt(c_C, c);
+    check(c->status == SPU_STATUS_STOPPED_BY_STOP && c->stop_code == 0x125,
+          "C: the caller runs to its stop");
+    check(cnt(c, CC_B) == 1 && cnt(c, CC_K) == 1 && cnt(c, CC_C) == 1,
+          "C: the unlifted block, the lifted block it rejoins and the caller's continuation run once each");
+    check(c_lifted[1] == 1 && c_lifted[0] == 1,
+          "C: the interpreter hands the rejoin to the lifted block and the caller resumes lifted");
+    free(c);
+}
+
+/* ---------------------------------------------------------------------------
+ * D: an unlifted callee that calls a lifted helper
+ *
+ *   0x23000 D:  ila r3, X ; bisl r0, r3 (link 0x23008)
+ *   0x23008     counter D++ (r20) ; stop 0x126
+ *   0x23100 X:  ori r79, r0, 0 ; brsl r0, H (link 0x23108)
+ *   0x23108     counter X++ (r30) ; ori r0, r79, 0 ; bi r0   -- not lifted
+ *   0x23200 H:  counter H++ (r31) ; bi r0
+ * -----------------------------------------------------------------------*/
+enum { D_D = 0x23000, D_X = 0x23100, D_H = 0x23200,
+       DC_D = 0x30300, DC_X = 0x30310, DC_H = 0x30320 };
+static int d_lifted[2];
+
+static void d_asm(void)
+{
+    org(D_D); ila(3, D_X); bisl(0, 3); inc(20, DC_D); stop(0x126);
+    org(D_X); ori(79, 0, 0); brsl(0, D_H); inc(30, DC_X); ori(0, 79, 0); bi(0);
+    org(D_H); inc(31, DC_H); bi(0);
+}
+static void d_H(spu_context* c) { l_inc(c, 31, DC_H); d_lifted[1]++; SPU_RET(c); }
+static void d_D(spu_context* c)
+{
+    c->gpr[3] = spu_splat_u32(D_X);
+    L_BISL(c, 0, 3, D_D + 8, 1);
+    l_inc(c, 20, DC_D); d_lifted[0]++;
+    L_STOP(c, 0x126);
+}
+
+static void test_callee_calls_lifted(void)
+{
+    spu_context* c = new_ctx();
+    d_asm();
+    spu_run_with_halt(d_D, c);
+    check(c->status == SPU_STATUS_STOPPED_BY_STOP && c->stop_code == 0x126,
+          "D: the caller runs to its stop");
+    check(cnt(c, DC_H) == 1 && cnt(c, DC_X) == 1 && cnt(c, DC_D) == 1,
+          "D: helper, unlifted callee and caller's continuation run once each");
+    check(d_lifted[1] == 1 && d_lifted[0] == 1,
+          "D: the helper runs lifted and the caller resumes lifted");
+    free(c);
+}
+
+int main(void)
+{
+    printf("SPU interpreter fallback: lifted call into unlifted code\n");
+#ifdef _WIN32
+    _putenv("SPU_INTERP_UNLIFTED=1");
+    _putenv("SPU_INTERP_UNLIFTED_NOSTOP=");
+#else
+    setenv("SPU_INTERP_UNLIFTED", "1", 1);
+    unsetenv("SPU_INTERP_UNLIFTED_NOSTOP");
+#endif
+    spu_begin_image(TEST_IMG);
+    spu_register_function(A_BASE[0], a_P0);
+    spu_register_function(A_BASE[1], a_P1);
+    spu_register_function(B_PM, b_PM);
+    spu_register_function(B_J, b_J);
+    spu_register_function(B_F, b_F);
+    spu_register_function(C_C, c_C);
+    spu_register_function(C_G, c_G);
+    spu_register_function(C_K, c_K);
+    spu_register_function(D_D, d_D);
+    spu_register_function(D_H, d_H);
+    spu_begin_image(0);
+
+    test_loop_call();
+    test_nested_call();
+    test_jump_table_block();
+    test_callee_calls_lifted();
+
+    printf("%d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * The rest of the program the runtime files reach for. None is reached here.
+ * -----------------------------------------------------------------------*/
+static void unexpected(const char* f) { fprintf(stderr, "unexpected call: %s\n", f); exit(3); }
+uint32_t g_barrier_sync_watch = 0;
+uint32_t g_spu_image_ls_start = 0, g_spu_image_span = 0, g_spu_image_src_ea = 0;
+uint32_t g_ydkj_real_spurs_ea = 0, g_ydkj_real_taskid = 0, g_ydkj_real_taskset_ea = 0;
+uint32_t lv2_spu_bound_queue(const void* s, uint32_t n) { (void)s; (void)n; unexpected("lv2_spu_bound_queue"); return 0; }
+int sys_event_queue_receive_for_spu(uint32_t q, int b, void* o) { (void)q; (void)b; (void)o; unexpected("sys_event_queue_receive_for_spu"); return 0; }
+uint64_t ps3_guest_dilate_ns(uint64_t a, uint64_t b) { return b - a; }
+unsigned long long ps3_ms_now(void) { return 0; }
+void spurs_ef_set_from_spu(void) { unexpected("spurs_ef_set_from_spu"); }
+void spurs_pm_build_context(void) { unexpected("spurs_pm_build_context"); }
+void ydkj_wake_all_event_flags(void) { unexpected("ydkj_wake_all_event_flags"); }
+/* ppu_memory.h's store hooks (spu_workload.c's guest stores) */
+int g_resv_store_active = 0;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+uint32_t g_ww_lo = 0, g_ww_hi = 0;
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
diff --git a/runtime/spu/tests/test_spu_lockline_peer.c b/runtime/spu/tests/test_spu_lockline_peer.c
index 4bf0869..97f7741 100644
--- a/runtime/spu/tests/test_spu_lockline_peer.c
