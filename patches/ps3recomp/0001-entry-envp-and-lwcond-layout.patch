+def _cont_call_kind(raw, addr: int):
+    """The call at `addr` that a return address addr+4 follows: (kind, branch
+    target). Kinds match runtime/ppu/ppu_resume.h PPU_CONT_CALL_*: 1 bl,
+    2 indirect (bctrl, bcctrl, blrl, bclrl), 3 sc, 4 bcl; 0 = not a call."""
+    if raw is None:
+        return 0, 0
+    d = _cont_decode(raw, addr)
+    if d and d[0] == "sc":
+        return 3, 0
+    if d and d[0] == "call":
+        if d[1] is None:
+            return 2, 0
+        return (1 if (raw >> 26) == 18 else 4), d[1]
+    return 0, 0
+
