+/* Joystick-class devices: an axis counts once it has been seen at rest. */
+static void test_rest_guard(void)
+{
+    PadHostDevice d;
+    PadHostPortState st;
+    char m[640];
+    cfg_clear();
+
+    /* A wheel with its pedals on Generic Desktop Y / Rz, released = maximum. */
+    desc_reset();
+    add_value(GEN_PAGE_GD, 0x30, 0, 16, 0, 65535, 0, 0);   /* wheel */
+    add_value(GEN_PAGE_GD, 0x31, 0, 8, 0, 255, 0, 0);      /* accelerator */
+    add_value(GEN_PAGE_GD, 0x35, 0, 8, 0, 255, 0, 0);      /* brake */
+    add_value(GEN_PAGE_GD, 0x39, 0, 4, 0, 7, 1, 0);
+    add_buttons(GEN_PAGE_BUTTON, 1, 12, 0);
+    dev_init(&d, 0x046D, 0xC24F);
+    d.usage = 4;
+    CHECK_EQ(padhost_drv_generic.open(&d), 0);
+    CHECK_EQ(gen_priv(&d)->rest_guard, 1);
+    map_of(&d, m, sizeof m);
+    CHECK_STR(m, "Cross=b2 Circle=b3 Square=b1 Triangle=b4 L1=b5 R1=b6 L2=b7 R2=b8 L3=b11 R3=b12 "
+                 "Start=b10 Select=b9 Dpad=h0 LX=a0 LY=a1 RY=a5");
+    set_raw(GEN_PAGE_GD, 0x30, 32768); set_raw(GEN_PAGE_GD, 0x31, 255); set_raw(GEN_PAGE_GD, 0x35, 255);
+    set_raw(GEN_PAGE_GD, 0x39, 8);
+    press(GEN_PAGE_BUTTON, NULL, 0);
+    for (int i = 0; i < 3; i++) {
+        CHECK_EQ(parse_id(&d, 0, &st), 1);
+        CHECK_EQ(st.lx, 128); CHECK_EQ(st.ly, 128); CHECK_EQ(st.ry, 128);   /* pedals at rest: nothing held */
+        CHECK_EQ(st.buttons, 0);
+    }
+    set_raw(GEN_PAGE_GD, 0x30, 0);              /* the wheel turns: live from the start */
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 0);
+    set_raw(GEN_PAGE_GD, 0x31, 128);            /* a pedal pushed to the middle counts from then on */
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.ly, 128);
+    set_raw(GEN_PAGE_GD, 0x31, 255);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.ly, 255);
+    CHECK_EQ(st.ry, 128);                       /* the brake still never has */
+
+    /* The same pedals mapped as triggers, reversed (released = max = 0 % travel). */
+    cfg_set("map.046D:C24F", "R2=a1~ L2=a5~ LY=none RY=none");
+    dev_init(&d, 0x046D, 0xC24F);
+    d.usage = 4;
+    CHECK_EQ(padhost_drv_generic.open(&d), 0);
+    set_raw(GEN_PAGE_GD, 0x31, 255); set_raw(GEN_PAGE_GD, 0x35, 255);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.press[PADHOST_PRESS_L2], 0); CHECK_EQ(st.press[PADHOST_PRESS_R2], 0);
+    set_raw(GEN_PAGE_GD, 0x31, 0);              /* floored */
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.press[PADHOST_PRESS_R2], 255);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_R2);
+    cfg_clear();
+
+    /* ... and a pedal that starts floored (held at plug-in) reads released until let go */
+    cfg_set("map.046D:C24F", "R2=a1~ LY=none");
+    dev_init(&d, 0x046D, 0xC24F);
+    d.usage = 4;
+    padhost_drv_generic.open(&d);
+    set_raw(GEN_PAGE_GD, 0x31, 0);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.press[PADHOST_PRESS_R2], 0);
+    set_raw(GEN_PAGE_GD, 0x31, 250);
+    parse_id(&d, 0, &st);
+    set_raw(GEN_PAGE_GD, 0x31, 0);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.press[PADHOST_PRESS_R2], 255);
+    cfg_clear();
+
+    /* A flight stick: X/Y, Rz twist, a Slider throttle -- the throttle feeds no stick. */
+    desc_reset();
+    add_value(GEN_PAGE_GD, 0x30, 0, 10, 0, 1023, 0, 0);
+    add_value(GEN_PAGE_GD, 0x31, 0, 10, 0, 1023, 0, 0);
+    add_value(GEN_PAGE_GD, 0x35, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x36, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x39, 0, 4, 0, 7, 1, 0);
+    add_buttons(GEN_PAGE_BUTTON, 1, 12, 0);
+    dev_init(&d, 0x044F, 0xB10A);
+    d.usage = 4;
+    CHECK_EQ(padhost_drv_generic.open(&d), 0);
+    map_of(&d, m, sizeof m);
+    CHECK_STR(m, "Cross=b2 Circle=b3 Square=b1 Triangle=b4 L1=b5 R1=b6 L2=b7 R2=b8 L3=b11 R3=b12 "
+                 "Start=b10 Select=b9 Dpad=h0 LX=a0 LY=a1 RY=a5");
+    set_raw(GEN_PAGE_GD, 0x30, 512); set_raw(GEN_PAGE_GD, 0x31, 511);
+    set_raw(GEN_PAGE_GD, 0x35, 128); set_raw(GEN_PAGE_GD, 0x36, 255);   /* throttle at full */
+    set_raw(GEN_PAGE_GD, 0x39, 8);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 128); CHECK_EQ(st.ly, 128); CHECK_EQ(st.rx, 128); CHECK_EQ(st.ry, 128);
+
+    /* A Joystick-class pad held over at plug-in: centre until it has been let go. */
+    desc_reset();
+    add_value(GEN_PAGE_GD, 0x30, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x31, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x32, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x35, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x39, 0, 4, 0, 7, 1, 0);
+    add_buttons(GEN_PAGE_BUTTON, 1, 12, 0);
+    dev_init(&d, 0x0079, 0x0006);
+    d.usage = 4;
+    padhost_drv_generic.open(&d);
+    set_raw(GEN_PAGE_GD, 0x30, 0); set_raw(GEN_PAGE_GD, 0x31, 128);
+    set_raw(GEN_PAGE_GD, 0x32, 128); set_raw(GEN_PAGE_GD, 0x35, 128);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 128); CHECK_EQ(st.ly, 128);
+    set_raw(GEN_PAGE_GD, 0x30, 128);
+    parse_id(&d, 0, &st);
+    set_raw(GEN_PAGE_GD, 0x30, 0);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 0);
+    /* a null (out of range) value counts as at rest */
+    dev_init(&d, 0x0079, 0x0006);
+    d.usage = 4;
+    padhost_drv_generic.open(&d);
+    set_raw(GEN_PAGE_GD, 0x30, 0);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 128);
+    gen_priv(&d)->rest[0] = 0;
+    g_desc.values[0].lmin = 1;                  /* make 0 a null value for this device */
+    gen_priv(&d)->desc.values[0].lmin = 1;
+    parse_id(&d, 0, &st);
+    set_raw(GEN_PAGE_GD, 0x30, 1);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 0);
+    /* the same pad as a Gamepad collection: no guard, a held stick reads at once */
+    desc_reset();
+    add_value(GEN_PAGE_GD, 0x30, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x31, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x39, 0, 4, 0, 7, 1, 0);
+    add_buttons(GEN_PAGE_BUTTON, 1, 12, 0);
+    dev_init(&d, 0x0079, 0x0006);
+    padhost_drv_generic.open(&d);
+    CHECK_EQ(gen_priv(&d)->rest_guard, 0);
+    set_raw(GEN_PAGE_GD, 0x30, 0); set_raw(GEN_PAGE_GD, 0x31, 128);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 0);
+}
+
+int main(void)
+{
+    s_gen_ops = &fake_ops;
+    test_ds4_layout();
+    test_xbox_dinput_layout();
+    test_axis_normalisation();
+    test_report_ids();
+    test_special_usages();
+    test_config();
+    test_override_applied_and_roundtrip();
+    test_match_and_open();
+    test_rest_guard();
+    printf("%s: %d checks, %d failed\n", g_fail ? "FAILED" : "OK", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
