+#!/usr/bin/env python3
+"""ss_inspect.py -- read a raw save-state image (SS_DUMP's dump-<n>.p3ssraw).
+
+The image is runtime/savestate/ss_state.h's raw layout: a 256-byte header, a
+section table, a chunk table, the data. Every section is a stream of
+self-describing records (FIELDS, RECS, BLOB, TEXT, U64 or a type of the
+section's own), and FIELDS / RECS carry their fields' names and sizes, so
+this tool prints any section without knowing it. On top of that it knows the
+foundation sections (TIME, MAPS, GMEM, CHNS) and summarises the record
+arrays other sections add -- "threads 24 (park kind: lwcond 10, ...)" -- from
+the field names alone (see FIELD_ENUMS / SUMMARY below). The image has no
+field types, so an integer with its top bit set is shown signed too ("-1
+(0xFFFFFFFF)"), an 8-byte one as its two u32 words as well, and a field
+named like a float (FLOAT_NAMES) as the float (FieldInt below).
+
+    ss_inspect.py dump-1.p3ssraw                 header, sections, summaries
+    ss_inspect.py dump-1.p3ssraw --records 5     + the first 5 records of each array
+    ss_inspect.py dump-1.p3ssraw --section PPUT  one section in full
+    ss_inspect.py dump-1.p3ssraw --json          everything as JSON
+    ss_inspect.py dump-1.p3ssraw --crc all       also the GMEM chunks' CRC32C (slow: ~15 MB/s)
+
+Checks the header CRC (header + both tables) and, by default, the CRC32C of
+every chunk except GMEM's (pure Python; --crc all / none). Exit status: 0
+read, 1 a CRC or structure error, 2 usage / not an image.
+"""
+import argparse
+import collections
+import json
+import mmap
+import os
+import re
+import struct
+import sys
+
+MAGIC = b"P3SSRAW\x1a"
+HDR = struct.Struct("<8sIIQIIQQQQQQIIII64s96s")      # 256 bytes
+SEC = struct.Struct("<IIIiQQQIIII8x")                # 64 bytes
+CHK = struct.Struct("<QII")                          # 16 bytes
+REC = struct.Struct("<IHHIIQ")                       # 24 bytes
+FLH = struct.Struct("<QIIII")                        # 24 bytes
+FLD = struct.Struct("<IIII")                         # 16 bytes
+assert HDR.size == 256 and SEC.size == 64 and CHK.size == 16 and REC.size == 24 and FLH.size == 24
+
+SEC_FLAGS = {1: "optional", 2: "info", 4: "no-verify"}
+# Enumerations by FIELD NAME, wherever a RECS / FIELDS record uses that name
+# (runtime/savestate/ss_core.h). Name a field like this and it decodes here.
+WAIT_KINDS = ["none", "sem", "equeue", "eflag", "join", "usleep", "sleep", "spu_join", "mutex", "cond",
+              "lwmutex", "lwcond", "lwcond_reacq", "spinlock", "net"]
+FIELD_ENUMS = {
+    "wait_kind": WAIT_KINDS, "park_kind": WAIT_KINDS, "kind": None,   # "kind": decoded only in PPUT
+    "at": ["none", "sc", "hle", "wait"],                 # SS_AT_*
+    "where": ["-", "hop", "ch-wait", "wait-signal", "stop-receive"],   # SS_SPU_AT_HOP / SS_SPU_W_*
+}
+PPUT_KIND = WAIT_KINDS
+# Fields worth a histogram in a record array (small categorical values).
+HIST_NAMES = re.compile(r"(^|_)(kind|state|at|where|type|status|table|mode|park|used|flags|prio(rity)?)$")
+
+
+def fourcc_str(v):
+    return "".join(chr(b) if 32 <= b < 127 else "?" for b in struct.pack("<I", v))
+
+
+# ---- CRC32C (Castagnoli, reflected 0x82F63B78), table-driven ---------------
+_T = []
+for _i in range(256):
+    _c = _i
+    for _k in range(8):
+        _c = (_c >> 1) ^ (0x82F63B78 if _c & 1 else 0)
+    _T.append(_c)
+
+
+def crc32c(data, crc=0):
+    c = crc ^ 0xFFFFFFFF
+    t = _T
+    for b in data:
+        c = (c >> 8) ^ t[(c ^ b) & 0xFF]
+    return c ^ 0xFFFFFFFF
+
+
+def align8(v):
+    return (v + 7) & ~7
+
+
+class ImageError(Exception):
+    pass
+
+
+class Image:
+    def __init__(self, buf):
+        self.buf = buf
+        if len(buf) < HDR.size:
+            raise ImageError("shorter than a header")
+        f = HDR.unpack_from(buf, 0)
+        (self.magic, self.version, self.hdr_size, self.file_size, self.nsections, self.nchunks, self.sec_off,
+         self.chunk_off, self.data_off, self.data_size, self.layout_hash, self.created_unix_ms, self.chunk_bytes,
+         self.flags, self.seq, self.hdr_crc, build, _) = f
+        self.build = build.split(b"\0")[0].decode("ascii", "replace")
+        if self.magic != MAGIC:
+            raise ImageError("not a raw save-state image (magic %r)" % self.magic)
+        if self.version != 1 or self.hdr_size != 256:
+            raise ImageError("image version %d (this tool reads 1)" % self.version)
+        if self.file_size > len(buf):
+            raise ImageError("truncated: %d of %d bytes" % (len(buf), self.file_size))
+        if (self.sec_off + self.nsections * SEC.size > len(buf) or
+                self.chunk_off + self.nchunks * CHK.size > len(buf) or self.data_off + self.data_size > len(buf)):
+            raise ImageError("table bounds")
+        self.sections = []
+        for i in range(self.nsections):
+            (fc, ver, flags, order, lh, off, size, c0, nc, recs, cap_us) = SEC.unpack_from(buf, self.sec_off + i * SEC.size)
+            self.sections.append(dict(fourcc=fc, name=fourcc_str(fc), version=ver, flags=flags, order=order,
+                                      layout_hash=lh, offset=off, size=size, chunk0=c0, nchunks=nc, records=recs,
+                                      capture_us=cap_us))
+        self.chunks = [CHK.unpack_from(buf, self.chunk_off + i * CHK.size) for i in range(self.nchunks)]
+        hdr0 = bytearray(buf[0:HDR.size])
+        struct.pack_into("<I", hdr0, 92, 0)           # hdr_crc (offset 92)
+        crc = crc32c(bytes(hdr0))
+        crc = crc32c(buf[self.sec_off:self.sec_off + self.nsections * SEC.size], crc)
+        crc = crc32c(buf[self.chunk_off:self.chunk_off + self.nchunks * CHK.size], crc)
+        self.hdr_crc_ok = crc == self.hdr_crc
+
+    def data(self, off, n):
+        a = self.data_off + off
+        return self.buf[a:a + n]
+
+    def section(self, name):
+        for s in self.sections:
+            if s["name"] == name:
+                return s
+        return None
+
+    def verify_chunks(self, s):
+        """(checked, bad list) for section s."""
+        bad = []
+        for c in range(s["chunk0"], s["chunk0"] + s["nchunks"]):
+            off, size, crc = self.chunks[c]
+            if crc32c(self.data(off, size)) != crc:
+                bad.append(c - s["chunk0"])
+        return s["nchunks"], bad
+
+    def records(self, s):
+        """Every record of section s as a dict (payload as a memoryview)."""
+        base = self.data_off + s["offset"]
+        end = s["size"]
+        out = []
+        off = 0
+        mv = memoryview(self.buf)
+        while off < end:
+            if off + REC.size > end:
+                raise ImageError("%s: a record header past the section end" % s["name"])
+            typ, nlen, flags, skip, _r, ln = REC.unpack_from(self.buf, base + off)
+            pay = off + REC.size + skip
+            if nlen + 1 > skip or pay + ln > end:
+                raise ImageError("%s: record at +0x%X runs past the section" % (s["name"], off))
+            name = bytes(self.buf[base + off + REC.size:base + off + REC.size + nlen]).decode("utf-8", "replace")
+            out.append(dict(type=fourcc_str(typ), name=name, flags=flags, len=ln, off=off,
+                            payload=mv[base + pay:base + pay + ln]))
+            off = align8(pay + ln)
+        return out
+
+
+def parse_fields(rec):
+    """A FIELDS / RECS payload: (layout hash, fields [(name, size, data_off)], rec_size, records [(key, bytes)])."""
+    p = rec["payload"]
+    lh, nf, names_len, rec_size, count = FLH.unpack_from(p, 0)
+    descs = [FLD.unpack_from(p, FLH.size + i * FLD.size) for i in range(nf)]
+    names_at = FLH.size + nf * FLD.size
+    names = bytes(p[names_at:names_at + names_len])
+    fields = []
+    for (nh, size, noff, doff) in descs:
+        nm = names[noff:names.index(b"\0", noff)].decode("utf-8", "replace")
+        fields.append((nm, size, doff))
+    recs_at = names_at + names_len
+    if recs_at + rec_size * count > len(p):
+        raise ImageError("'%s': the field list runs past its record" % rec["name"])
+    recs = []
+    for i in range(count):
+        r = bytes(p[recs_at + i * rec_size:recs_at + (i + 1) * rec_size])
+        recs.append((struct.unpack_from("<I", r, 0)[0], r))
+    return lh, fields, rec_size, recs
+
+
+TEXT_NAMES = re.compile(r"(name|tag|str|path|label|title|text)$")
+# 4-byte fields that are floats by name (cellVideoOut's gamma, an audio port's level, cellResc's
+# aspect_h / aspect_v): shown as the float when their bits are a normal one.
+FLOAT_NAMES = re.compile(r"(^|[._])(gamma|level|volume|scale|aspect_[hv])$")
+# ... and fields named like a guest address or a size, never shown signed (0xD0001000 is a stack).
+ADDR_NAMES = re.compile(r"(addr|_ea|ea$|ptr|base|_off|offset|size|_lo$|_hi$|_sp$|bump|next)", re.I)
+
+
+class FieldInt(int):
+    """A 1/2/4/8-byte field: its unsigned little-endian value -- what the enum decoding, the
+    figures and --json use -- and how to show it. The image keeps no field types, only names
+    and sizes, so a 2- or 4-byte value with the top bit set is shown signed too, a small
+    negative as itself (-1, not 4294967295), an 8-byte one as its two u32 words as well (a
+    struct of two words would read as one number with them swapped), and a float-named one
+    (FLOAT_NAMES) as the float."""
+    def __new__(cls, v, n, name):
+        o = int.__new__(cls, v)
+        o.n, o.fname = n, name
+        return o
+
+    def signed(self):
+        b = self.n * 8
+        v = int(self)
+        return v - (1 << b) if v >> (b - 1) else v
+
+    def as_float(self):
+        v = int(self)
+        if self.n != 4 or not FLOAT_NAMES.search(self.fname) or ((v >> 23) & 0xFF) in (0, 0xFF):
+            return None
+        return struct.unpack("<f", v.to_bytes(4, "little"))[0]
+
+    def small_negative(self):
+        s = self.signed()
+        return self.n >= 2 and -65536 <= s < 0
+
+    def __str__(self):                               # histograms
+        f = self.as_float()
+        if f is not None:
+            return "%g" % f
+        return str(self.signed()) if self.small_negative() else str(int(self))
+
+    def pretty(self):                                # FIELDS lines and --records
+        v = int(self)
+        f = self.as_float()
+        if f is not None:
+            return "%g (0x%08X, float)" % (f, v)
+        if self.small_negative():
+            return "%d (0x%X)" % (self.signed(), v)
+        out = "%d (0x%X)" % (v, v) if v > 9 else str(v)
+        if self.n in (2, 4) and self.signed() < 0 and not ADDR_NAMES.search(self.fname):
+            out = "%d (0x%X = %d signed)" % (v, v, self.signed())
+        if self.n == 8 and (v >> 32) and (v & 0xFFFFFFFF):
+            out += " [u32 words 0x%08X, 0x%08X]" % (v & 0xFFFFFFFF, v >> 32)
+        return out
+
+    __repr__ = int.__repr__
+
+
+def value(raw, name=""):
+    """A field's bytes for display: an integer (FieldInt), a string, or hex.
+    A field named like text (name, tag, path, ...) reads as a string at any
+    size."""
+    n = len(raw)
+    s = raw.split(b"\0")[0]
+    text = s and all(32 <= b < 127 for b in s) and all(b == 0 for b in raw[len(s):])
+    if text and (n not in (1, 2, 4, 8) or TEXT_NAMES.search(name)):
+        return s.decode("ascii")
+    if n in (1, 2, 4, 8):
+        return FieldInt(int.from_bytes(raw, "little"), n, name)
+    if not any(raw):
+        return "0 x %d" % n
+    return raw[:32].hex() + ("..." if n > 32 else "") + " (%d bytes)" % n
+
+
+def decode(sec, name, v):
+    if not isinstance(v, int):
+        return v
+    names = FIELD_ENUMS.get(name)
+    if name == "kind" and sec == "PPUT":
+        names = PPUT_KIND
+    if names and 0 <= v < len(names):
+        return names[v]
+    return v
+
+
+def fmt_val(v):
+    if isinstance(v, FieldInt):
+        return v.pretty()
+    if isinstance(v, int):
+        return "%d (0x%X)" % (v, v) if v > 9 else str(v)
+    return str(v)
+
+
+def mb(n):
+    return n / 1048576.0
+
+
+# ---- the foundation sections ---------------------------------------------------
+def fields_dict(rec, sec):
+    lh, fields, rs, recs = parse_fields(rec)
+    if not recs:
+        return {}
+    r = recs[0][1]
+    return {nm: decode(sec, nm, value(r[doff:doff + size], nm)) for (nm, size, doff) in fields}
+
+
+def recs_list(rec, sec):
+    lh, fields, rs, recs = parse_fields(rec)
+    out = []
+    for key, r in recs:
+        d = {"_key": key}
+        for (nm, size, doff) in fields:
+            d[nm] = decode(sec, nm, value(r[doff:doff + size], nm))
+        out.append(d)
+    return out
+
+
+def summarise_chains(text):
+    """CHNS: the census block -- threads by park kind, stragglers, SPUs by where."""
+    kinds = collections.Counter()
+    spu = collections.Counter()
+    strict = collections.Counter()
+    threads = stragglers = 0
+    for ln in text.splitlines():
+        if ln.startswith("thread "):
+            threads += 1
+            m = re.search(r" at=(\S+)", ln)
+            at = m.group(1) if m else "?"
+            if at.startswith("wait:"):
+                kinds[at.split(":")[1]] += 1
+            elif at.startswith("sc:"):
+                kinds["sc"] += 1
+            elif at.startswith("hle:"):
+                kinds["hle"] += 1
+            else:
+                kinds[at] += 1
+        elif ln.startswith("straggler "):
+            stragglers += 1
+        elif ln.startswith("spu "):
+            m = re.search(r" where=(\S+)", ln)
+            spu[(m.group(1) if m else "?") + ("" if " parked " in ln else " (not parked)")] += 1
+        elif ln.startswith("  strict "):
+            strict[ln.split()[1]] += 1
+    first = text.splitlines()[0] if text else ""
+    return dict(census=first, threads=threads, stragglers=stragglers, park_kinds=dict(kinds.most_common()),
+                spu=dict(spu.most_common()), strict=dict(strict.most_common()))
+
+
+def summarise_section(img, s, recs):
+    """A per-section summary dict: every RECS array's count and categorical
+    histograms, FIELDS values, and the foundation sections' own figures."""
+    name = s["name"]
+    out = collections.OrderedDict()
+    arrays = collections.OrderedDict()
+    fields = collections.OrderedDict()
+    blobs = collections.OrderedDict()
+    for r in recs:
+        if r["type"] == "RECS":
+            lst = recs_list(r, name)
+            hist = collections.OrderedDict()
+            if lst:
+                for k in lst[0]:
+                    if k == "_key" or not HIST_NAMES.search(k):
+                        continue
+                    c = collections.Counter(str(d[k]) for d in lst)
+                    if len(c) <= 16:
+                        hist[k] = dict(c.most_common())
+            arrays[r["name"]] = dict(count=len(lst), histograms=hist)
+        elif r["type"] == "FLDS":
+            fields[r["name"]] = fields_dict(r, name)
+        elif r["type"] in ("BLOB", "TEXT"):
+            blobs[r["name"]] = r["len"]
+        elif r["type"] == "U64 ":
+            fields.setdefault("u64", {})[r["name"]] = int.from_bytes(bytes(r["payload"]), "little")
+    out["arrays"] = arrays
+    out["fields"] = fields
+    out["blobs"] = blobs
+    if name == "TIME" and "time" in fields:
+        t = fields["time"]
+        out["time"] = dict(guest_s=t.get("guest_ns", 0) / 1e9, play_s=t.get("play_ms", 0) / 1e3,
+                           flips=t.get("flip_count"), unix_ms=t.get("unix_ms"))
+        anc = [r for r in recs if r["type"] == "RECS" and r["name"] == "anchors"]
+        out["anchors"] = {d["name"]: d["value"] for d in recs_list(anc[0], name)} if anc else {}
+    if name == "MAPS" and "maps" in fields:
+        m = fields["maps"]
+        out["memory"] = dict(arena_mb=mb(m.get("arena", 0)), committed_mb=mb(m.get("committed", 0)),
+                             nonzero_mb=mb(m.get("nonzero", 0)), unreadable_mb=mb(m.get("unreadable", 0)),
+                             regions=m.get("regions"), pages=m.get("pages"), scan_ms=m.get("scan_us", 0) / 1e3)
+        ar = [r for r in recs if r["type"] == "RECS" and r["name"] == "areas"]
+        if ar:
+            out["areas"] = [dict(name=d["name"], lo="0x%08X" % d["lo"], committed_mb=mb(d["committed"]),
+                                 nonzero_mb=mb(d["nonzero"]), unreadable_mb=mb(d["unreadable"]))
+                            for d in recs_list(ar[0], name)]
+    if name == "GMEM" and "gmem" in fields:
+        g = fields["gmem"]
+        out["memory"] = dict(pages=g.get("pages"), mb=mb(g.get("bytes", 0)), copy_ms=g.get("copy_us", 0) / 1e3)
+    if name == "CHNS":
+        txt = [r for r in recs if r["type"] == "TEXT" and r["name"] == "chains"]
+        if txt:
+            out["chains"] = summarise_chains(bytes(txt[0]["payload"]).decode("utf-8", "replace"))
+    return out
+
+
+def counts_line(summ):
+    """The one-line overview: threads with park kinds, SPU parks, every array's count."""
+    parts = []
+    ch = summ.get("CHNS", {}).get("chains")
+    if ch:
+        kinds = ", ".join("%s %d" % kv for kv in ch["park_kinds"].items())
+        parts.append("threads %d (%s)%s" % (ch["threads"], kinds,
+                                             ", %d straggler(s)" % ch["stragglers"] if ch["stragglers"] else ""))
+        if ch["spu"]:
+            parts.append("SPU %d (%s)" % (sum(ch["spu"].values()), ", ".join("%s %d" % kv for kv in ch["spu"].items())))
+    for sec, s in summ.items():
+        for an, a in s.get("arrays", {}).items():
+            if sec in ("MAPS", "TIME") and an in ("regions", "areas", "anchors"):
+                continue
+            h = ""
+            for hk, hv in a["histograms"].items():
+                if len(hv) > 1 or hk in ("kind", "wait_kind", "park_kind", "state", "where"):
+                    h = " (%s: %s)" % (hk, ", ".join("%s %d" % kv for kv in hv.items()))
+                    break
+            parts.append("%s.%s %d%s" % (sec, an, a["count"], h))
+    return "; ".join(parts)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("image")
+    ap.add_argument("--json", action="store_true", help="everything as JSON")
+    ap.add_argument("--section", help="one section in full (its fourcc)")
+    ap.add_argument("--records", type=int, default=0, help="print the first N records of each array")
+    ap.add_argument("--crc", choices=["none", "small", "all"], default="small",
+                    help="chunk CRCs to check: none, every section but GMEM (default), all")
+    a = ap.parse_args()
+    try:
+        f = open(a.image, "rb")
+    except OSError as e:
+        print("ss_inspect: %s" % e, file=sys.stderr)
+        return 2
+    with f:
+        buf = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
+        try:
+            img = Image(buf)
+        except ImageError as e:
+            print("ss_inspect: %s: %s" % (a.image, e), file=sys.stderr)
+            return 2
+        status = 0 if img.hdr_crc_ok else 1
+        summ = collections.OrderedDict()
+        sec_out = []
+        for s in img.sections:
+            entry = dict((k, v) for k, v in s.items())
+            entry["flags_text"] = ",".join(v for k, v in SEC_FLAGS.items() if s["flags"] & k) or "-"
+            if a.crc == "all" or (a.crc == "small" and s["name"] != "GMEM"):
+                n, bad = img.verify_chunks(s)
+                entry["crc"] = "ok" if not bad else "BAD chunk(s) %s" % bad
+                if bad:
+                    status = 1
+            else:
+                entry["crc"] = "not checked"
+            try:
+                recs = img.records(s)
+                if len(recs) != s["records"]:
+                    entry["structure"] = "%d records, the table says %d" % (len(recs), s["records"])
+                    status = 1
+                summ[s["name"]] = summarise_section(img, s, recs)
+                entry["record_list"] = [dict(type=r["type"], name=r["name"], len=r["len"]) for r in recs]
+                if a.records or a.section == s["name"] or a.json:
+                    full = []
+                    for r in recs:
+                        if r["type"] == "RECS":
+                            lst = recs_list(r, s["name"])
+                            full.append(dict(name=r["name"], records=lst if a.json else lst[:a.records or len(lst)]))
+                    entry["arrays_full"] = full
+                if a.section == s["name"]:
+                    txt = [r for r in recs if r["type"] == "TEXT"]
+                    entry["texts"] = {r["name"]: bytes(r["payload"]).decode("utf-8", "replace") for r in txt}
+            except ImageError as e:
+                entry["structure"] = str(e)
+                status = 1
+            sec_out.append(entry)
+
+        if a.json:
+            for e in sec_out:
+                e["layout_hash"] = "%016X" % e["layout_hash"]
+                e["fourcc"] = e.pop("name")
+            out = dict(file=os.path.abspath(a.image), header=dict(
+                version=img.version, file_size=img.file_size, nsections=img.nsections, nchunks=img.nchunks,
+                data_off=img.data_off, data_size=img.data_size, layout_hash="%016X" % img.layout_hash,
+                created_unix_ms=img.created_unix_ms, chunk_bytes=img.chunk_bytes, flags=img.flags, seq=img.seq,
+                build=img.build, header_crc="ok" if img.hdr_crc_ok else "BAD"),
+                sections=sec_out, summary=summ, counts=counts_line(summ))
+            print(json.dumps(out, indent=1, default=str))
+            return status
+
+        print("%s: raw save-state image v%d, %.1f MB (data %.1f MB in %d sections, %d chunks of %d KB), request #%d,"
+              " header CRC %s" % (a.image, img.version, mb(img.file_size), mb(img.data_size), img.nsections,
+                                  img.nchunks, img.chunk_bytes // 1024, img.seq, "ok" if img.hdr_crc_ok else "BAD"))
+        print("  layout hash %016X, flags 0x%X%s, build '%s'" % (img.layout_hash, img.flags,
+                                                               " (no guest arena)" if img.flags & 1 else "", img.build))
+        print("\n  %-5s %4s %-20s %6s %12s %8s %7s %9s  %s" % ("sect", "ver", "flags", "order", "bytes", "records",
+                                                              "chunks", "capture", "crc"))
+        for e in sec_out:
+            print("  %-5s %4d %-20s %6d %12d %8d %7d %7.2fms  %s%s" % (e["name"], e["version"], e["flags_text"], e["order"],
+                                                                     e["size"], e["records"], e["nchunks"],
+                                                                     e["capture_us"] / 1000.0, e["crc"],
+                                                                     "  " + e["structure"] if "structure" in e else ""))
+        print("\n  counts: %s" % counts_line(summ))
+        for e in sec_out:
+            name = e["name"]
+            if a.section and a.section != name:
+                continue
+            s = summ.get(name, {})
+            print("\n== %s (%s)" % (name, ", ".join("%s %s %d B" % (r["type"].strip(), r["name"], r["len"])
+                                                   for r in e.get("record_list", []))))
+            if "time" in s:
+                t = s["time"]
+                print("  guest time %.3f s, play time %.1f s, %s flips; anchors: %s" % (
+                    t["guest_s"], t["play_s"], t["flips"],
+                    ", ".join("%s=%d" % kv for kv in s.get("anchors", {}).items()) or "none"))
+            if name == "MAPS" and "memory" in s:
+                m = s["memory"]
+                print("  arena %.0f MB: %.1f MB committed in %s regions, %.1f MB non-zero (%s pages), %.1f MB"
+                      " unreadable; scan %.1f ms" % (m["arena_mb"], m["committed_mb"], m["regions"], m["nonzero_mb"],
+                                                      m["pages"], m["unreadable_mb"], m["scan_ms"]))
+                for ar in s.get("areas", []):
+                    print("    %-11s %s  committed %8.1f MB  non-zero %8.1f MB%s" % (
+                        ar["name"], ar["lo"], ar["committed_mb"], ar["nonzero_mb"],
+                        "  unreadable %.1f MB" % ar["unreadable_mb"] if ar["unreadable_mb"] else ""))
+            if name == "GMEM" and "memory" in s:
+                m = s["memory"]
+                print("  %s non-zero pages, %.1f MB, copied in %.1f ms" % (m["pages"], m["mb"], m["copy_ms"]))
+            if "chains" in s:
+                ch = s["chains"]
+                print("  %s" % ch["census"])
