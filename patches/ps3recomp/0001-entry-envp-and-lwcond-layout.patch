+/* Everything a VP record captures besides its vertices -- the same capture as
+ * the record blocks of the old paths in d3d12_draw_arrays/_indexed. */
+static void vnew_fill_record(D3D12DrawRecord* dr, const rsx_state* st)
+{
+    dr->topology       = RSX_TOPOLOGY_TRIANGLES;
+    dr->textured       = s_d3d.tex_bound;
+    dr->is_vp          = 1;
+    dr->fp_addr = st->shader_program;
+    dr->rpt_skip = rsx_report_skip_mask();
+    dr->rplan_mask = rsx_report_unit_plans(&dr->rplan_first);   /* PF6 REPORT_GPU */
+    dr->fp_exp32 = (st->shader_control & 0x40) != 0;
+    dr->cull = rsx_cull_key(st);
+    { const rsx_vertex_attrib* _a0 = &st->vertex_attribs[0];
+      dr->va0 = _a0->enabled ? _a0->offset : 0;
+      dr->va0_type = _a0->type | (_a0->size << 4) | (_a0->stride << 8); }
+    dr->begin_epoch = st->begin_epoch;
+    { u32 _cm = st->color_mask;
+      dr->cmask = ((_cm & 0x00010000) ? 1u : 0u)   /* R */
+                | ((_cm & 0x00000100) ? 2u : 0u)   /* G */
+                | ((_cm & 0x00000001) ? 4u : 0u)   /* B */
+                | ((_cm & 0x01000000) ? 8u : 0u);  /* A */ }
+    dr->cmask |= rsx_mrt_cmask(st);  /* targets B..D */
+    dr->alpha_ctl = ((st->alpha_test_enable ? 1u : 0u) << 16)
+                  | ((st->alpha_func & 0xFFu) << 8)
+                  | (st->alpha_ref & 0xFFu);
+    for (int _u = 0; _u < RSX_DRAW_TEX_UNITS; _u++) {
+        dr->tex[_u].off   = s_d3d.cur_texs[_u].off;
+        dr->tex[_u].raw   = s_d3d.cur_texs[_u].raw;
+        dr->tex[_u].w     = s_d3d.cur_texs[_u].w;
+        dr->tex[_u].h     = s_d3d.cur_texs[_u].h;
+        dr->tex[_u].fmt   = s_d3d.cur_texs[_u].fmt;
+        dr->tex[_u].ctrl1 = s_d3d.cur_texs[_u].ctrl1;
+        dr->tex[_u].addr  = s_d3d.cur_texs[_u].addr;
+        dr->tex[_u].filt  = s_d3d.cur_texs[_u].filt;
+        dr->tex[_u].cube  = s_d3d.cur_texs[_u].cube;
+        dr->tex[_u].mips  = s_d3d.cur_texs[_u].mips;
+        dr->tex[_u].ctrl0 = s_d3d.cur_texs[_u].ctrl0;
+        dr->tex[_u].pitch = s_d3d.cur_texs[_u].pitch; dr->tex[_u].fword = s_d3d.cur_texs[_u].fword;
+        dr->tex[_u].set   = s_d3d.cur_texs[_u].set;
+        dr->tex_rt[_u]    = -1;
