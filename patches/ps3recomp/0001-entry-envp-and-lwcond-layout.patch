+/*
+ * test_ss_fsfd -- save states M4c: FSFD (the open files of the three fd
+ * tables) through a LOAD, on the real sys_fs.c, ppu_fs.cpp, cellFs.c and
+ * ss_state.c, each table driven through its own handlers on a fake guest
+ * arena over a scratch directory of files:
+ *
+ *   A   every table holds files and directories at known positions: a plain
+ *       file (all three), an EDAT served from its cache (ppu_fs, sys_fs), an
+ *       sdata container decrypted into a tmpfile (ppu_fs), a directory part
+ *       read (all three); one AIO request moved ppu_fs's id counter. SAVE,
+ *       held.
+ *   B   every table changed: fds closed, other files opened at A's numbers
+ *       and at new ones, positions moved, more entries read, the AIO counter
+ *       moved again.
+ *   LOAD A  check_image, teardown (every table empty), restore; the fidelity
+ *       check (capture again, compare: FSFD equal); then each fd reads on
+ *       from A's position, each directory hands out A's next entry, the fds
+ *       only B had are gone, the next AIO id is A's.
+ *   refusals  check_image refuses, by fd and path, a file whose last write
+ *       or size changed, an EDAT whose cache went stale, a directory now
+ *       shorter than the guest has read, an sdata container that decrypts
+ *       to another size, a record whose key is not its own, an image with a
+ *       file open for writing; and accepts A again once each is undone.
+ *   moved   the tree copied elsewhere (times kept) and every root pointed at
+ *       the copy: the same state loads from there and verifies equal (the
+ *       host path is the one host-only field).
+ *   layout  (SS1) FSFD's lists hold ppu_fs's fields from static init, before
+ *       ppu_fs_register, and that registration does not move the section's
+ *       layout hash: a SS_LOAD reader checking a state's layouts during boot
+ *       sees the final one.
+ *
+ * Build and run from external/ps3recomp (ppu_fs.cpp compiles against the
+ * project's generated/ppu/ppu_recomp.h, as ppu_sysprx.cpp does for the other
+ * load tests):
+ *   clang-cl /nologo /c /O1 /w /EHsc -std:c++20 -D_CRT_SECURE_NO_WARNINGS -Iinclude
+ *            -I../../generated/ppu -Iruntime/ppu -Iruntime/syscalls runtime/ppu/ppu_fs.cpp
+ *   clang-cl /nologo /c /O1 /w -D_CRT_SECURE_NO_WARNINGS -Iinclude runtime/syscalls/sys_fs.c
+ *            libs/filesystem/cellFs.c runtime/savestate/ss_state.c
+ *   clang-cl /nologo /O1 /w /EHsc -std:c++20 -D_CRT_SECURE_NO_WARNINGS -Iinclude -Iruntime/ppu
+ *            runtime/savestate/tests/test_ss_fsfd.cpp ppu_fs.obj sys_fs.obj cellFs.obj ss_state.obj
+ *            /Fe:test_ss_fsfd.exe
+ *   test_ss_fsfd.exe <an empty scratch directory>
+ * Exit status 0 = pass.
+ */
