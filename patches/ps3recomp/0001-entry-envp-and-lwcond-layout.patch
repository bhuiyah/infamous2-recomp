+/*
+ * test_ss_core -- the save-state stop-the-world protocol (runtime/savestate/
+ * ss_core.c) driven by fake threads, with no game, no lifted code and no rest
+ * of the runtime: ss_core.c alone plus the globals it reads or sets
+ * (g_ppu_threads, vm_base, g_ppu_ss_park_of), defined here.
+ *
+ *   clang-cl /nologo /O2 /MD -D_CRT_SECURE_NO_WARNINGS
+ *            runtime/savestate/tests/test_ss_core.c runtime/savestate/ss_core.c
+ *            runtime/savestate/ss_state.c runtime/savestate/ss_ui.c
+ *            /Fe:test_ss_core.exe && test_ss_core.exe
+ * (ss_state.c: an eligible SAVE now captures its sections -- with no guest
+ * arena declared here, MAPS / GMEM are empty and the image is small.)
+ *
+ * Fake PPU threads, one of each way a real one idles or runs:
+ *   tid 2  blocker   blocks in ss_wait_handle on a semaphore nobody posts
+ *   tid 3  cv        blocks in ss_sleep_cv_cs; a producer flips its flag
+ *   tid 4  busy      never blocks, calls an HLE-style S2 safepoint each loop
+ *   tid 5  sleeper   usleep-style S3 park point + 1 ms sleeps
+ *   tid 6  callback  spends most of its time inside ss_cb_enter/leave
+ *   tid 7  cbwait    a sleeper; in phase 4c it blocks in a CV wait INSIDE a
+ *                    callback (refused: must neither park nor spin)
+ *   tid 1  main      busy, like tid 4, S1-style safepoints
+ * plus two lifted-SPU threads that hop, one that sits in a channel wait, one
+ * unregistered SPU context, and a mixer. Every thread bumps a progress
+ * counter; the capture hook checks that none moves while the world is stopped.
+ *
+ * Checks: save states are armed by default (always on, M4a) with no periodic
+ * stop; SAVESTATES=0 leaves everything inert (no arming, no slicing, every
+ * request refused) -- also at startup, in a child process started with
+ * SAVESTATES=0 and every other switch set ("--child killswitch"); unarmed
+ * hooks are inert and the wrapped waits keep their timeouts; armed, a CV
+ * waiter whose predicate came true without a wake (the wake a waiter misses
+ * while it re-takes the lock after a slice) sees it within a slice, a timed
+ * CV wait keeps its deadline across slices, a long sleep ends on time;
+ * censuses -- now census REQUESTS from SS_CENSUS's period --
+ * converge with blocking threads parked in tier 1 and busy ones in tier 2;
+ * nothing runs during capture and everything runs again after; the chains
+ * file holds the fake guest back chains with their `bl` links; a thread
+ * stuck inside a callback makes the attempt fail with that thread named a
+ * straggler (refused=callback), and the next attempt after it leaves
+ * succeeds; the SPU ops are asked to force hops on and back off; an
+ * unregistered SPU context is counted, never waited for.
+ * Requests (M4a): armed with no census there is no stop; a SAVE becomes
+ * eligible once every check passes (strict walk ok, SPUs at hops or audited
+ * waits, no extra SPU context) and is done ok; one refused at its stops (an
+ * extra SPU context, a thread in a callback) retries no sooner than
+ * SS_RETRY_GAP times the stop's length, so the game stands still a fraction
+ * of the window, and gives up with that reason; one blocked by what needs no
+ * stop (a file open for writing -- an added check --, a busy table, booting)
+ * runs NO stop and gives up with that reason, and one whose blocker goes
+ * away meanwhile succeeds at its first stop; an unpaired transition end
+ * leaves the counter at zero; a debug switch refuses at once with no stop
+ * ("--child debugswitch"); a second submit while one waits is BUSY, also
+ * from eight threads at once; a LOAD is lenient (a chain with no
+ * continuation and an unaudited SPU wait do not refuse it) and, like
+ * SELFTEST and HOLD, ends "not yet"; SS_SAVE_AT and SS_CENSUS both feed the
+ * one request slot, and the census figures count census stops only;
+ * disarming refuses a waiting request.
+ * The capture (M4b), with a section of the test's own (TSTS) and a fake GPU
+ * flush: an eligible save is captured -- an image that verifies, with its
+ * size and pause --; a section whose check() refuses one stop is captured at
+ * the next, one that refuses every stop gives up with SS_REASON_SECTION and
+ * the section named; a capture larger than the staging buffer is refused,
+ * the buffer grown, the retry captured; a GPU that does not go idle refuses
+ * (SS_REASON_GPU) with no section checked; SS_RQ_DUMP's raw file parses and
+ * verifies; with no capture grace the stop's watchdog releases the world
+ * during a long GPU flush and the save is refused (watchdog) with nothing
+ * checked or captured, and with the grace the same flush is captured.
+ */
+#include "../ss_core.h"
+#include "../ss_state.h"
+#include "../ss_ui.h"
+#include "../../ppu/ppu_context.h"
+#include "../../syscalls/sys_ppu_thread.h"
