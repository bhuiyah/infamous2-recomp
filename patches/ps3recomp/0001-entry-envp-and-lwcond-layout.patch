+        psync_latch();
+        printf("[present] vsync: swap interval %d%s\n", s_psync, s_psync_env >= 0 ? " (PRESENT_SYNC)" : "");
+        fflush(stdout);
+    } else if (!strcmp(k, "anisotropy")) {
+        aniso_latch();
+    } else if (!strcmp(k, "brightness")) {
+        brightness_latch();
+    } else if (!strcmp(k, "aa") || !strcmp(k, "sharpen")) {
+        pfx_latch();
+    } else if (!strcmp(k, "texture_packs")) {
+        rsx_texpack_set_packs(atoi(new_v) != 0);
+    } else if (!strcmp(k, "texture_dump")) {
+        rsx_texpack_set_dump(atoi(new_v) != 0);
