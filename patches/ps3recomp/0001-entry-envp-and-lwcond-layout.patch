+/* Constant operands must not be folded: clang folds a float op whose inputs
+ * are all compile-time constants with round-to-nearest, while SPU host threads
+ * run round-toward-zero (SPU_FPMODE=rz), so a folded fa/fm/fma can differ from
+ * the run-time result in the last bit. Lifted code does build such operands
+ * (ilhu/iohl constants, e.g. a polynomial evaluated at x = 1.0), and with the
+ * helpers inlined their stores to ctx->gpr can be forwarded straight into the
+ * op. An empty asm on one operand makes it opaque: no instruction, no fold. */
+#  if defined(__clang__) || defined(__GNUC__)
+#    define SPU__OPAQUE(v) __asm__("" : "+x"(v))
+#  else
+#    define SPU__OPAQUE(v) ((void)0)
+#  endif
