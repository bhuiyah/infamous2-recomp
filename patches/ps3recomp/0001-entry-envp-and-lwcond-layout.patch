+ * address test and load, without its HOTREAD tick, so a checked build does
+ * not perturb the hot-read detector or any read watchpoint. */
+static int ppu_sc_guest_read(uint32_t ea, unsigned width, uint64_t* out)
+{
+    if (!VM_FAST_RD_OK(ea) || !VM_FAST_RD_OK(ea + width - 1)) return 0;
+    if (ppu_vm_size && (uint64_t)ea + width > ppu_vm_size) return 0;
