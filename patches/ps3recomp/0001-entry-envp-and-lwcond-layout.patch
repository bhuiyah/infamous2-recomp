+      vm_base = NULL; g_tp_on = 0; }
+
+    /* I. live setters called BEFORE the backend's tp_rt_startup (a settings store applying its
+     *    saved values at launch) still apply at the first batch; "no change" stays no change.
+     *    (TEXPACK / TEXDUMP unset here; the thread handle stand-in keeps tp_rt_start_threads
+     *    from starting the real loader / dump threads.) */
+    { s_tp.packs = 0; s_tp.dump = 0; s_tp.dead = 0; s_tp.ab = 0; s_tp.started = 0; g_tp_on = 0;
+      s_tp.set_packs = s_tp.set_dump = s_tp.set_vram = s_tp.set_reload = 0;
+      rsx_texpack_set_packs(1); rsx_texpack_set_vram_mb(300);
+      CHECK(g_tp_on == 2);
+      tp_rt_startup(D, Q);
+      CHECK(g_tp_on == 2 && s_tp.packs == 0 && s_tp.set_packs == 2 && s_tp.set_vram == 301 && s_tp.set_dump == 0);
+      s_tp.th_loader = (HANDLE)(uintptr_t)1;
+      tp_rt_batch_begin(1, 0, 0);
+      CHECK(g_tp_on == 1 && s_tp.packs == 1 && s_tp.dump == 0 && s_tp.vram_budget == (300ull << 20));
+      CHECK(s_tp.set_packs == 0 && s_tp.set_vram == 0 && s_tp.set_dump == 0);
+      tp_rt_batch_begin(2, 1, 0);                                 /* nothing pending: nothing changes */
+      CHECK(s_tp.packs == 1 && s_tp.vram_budget == (300ull << 20));
+      rsx_texpack_set_packs(0); tp_rt_batch_begin(3, 2, 0);
+      CHECK(s_tp.packs == 0 && g_tp_on == 1);
+      s_tp.th_loader = NULL; g_tp_on = 0; }
+
+    if (iq) {
+        const UINT64 n = iq->lpVtbl->GetNumStoredMessages(iq);
+        unsigned errors = 0;
+        for (UINT64 i = 0; i < n; i++) {
+            SIZE_T len = 0; iq->lpVtbl->GetMessage(iq, i, NULL, &len);
