+
+    def reload(i):
+        s = "".join(f"_r{r} = SPU_RV(ctx->gpr[{r}]); " for r in sorted(lout[i] - stmts[i].post_defs))
+        if uses_ls:
+            s += "_ls = ctx->ls; _lsg = spu_ls_gate(ctx); "
+        if uses_pic:
