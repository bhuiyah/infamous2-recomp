+void cellPad_host_intercept(int on, int report_flag)
+{
+    static int ab = -1;   /* PAD_INTERCEPT_FLAG=0: neutral input, never the flag (A/B) */
+    if (ab < 0) { const char* e = getenv("PAD_INTERCEPT_FLAG"); ab = (e && *e == '0') ? 0 : 1; }
+    on = on ? 1 : 0;
+    const int flag = on && report_flag && ab;
+    if (on) {
+        /* neutral first: by the time the title sees the flag, input is gone */
+        InterlockedExchange(&s_icpt, 1);
+        InterlockedExchange(&s_icpt_flag, flag);
+#if PAD_BACKEND_HOST
+        for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) padhost_set_actuator(i, 0, 0);
+#endif
+    } else {
+#if PAD_BACKEND_HOST
+        /* a button still held -- the Cross or Circle that closed a menu --
+         * stays away from the title until it is released */
+        for (int i = 0; i < PAD_MAX_HOST_PORTS && i < CELL_PAD_MAX_PORT_NUM; i++) {
+            PadHostPortState st;
+            padhost_get(i, &st);
+            InterlockedExchange(&s_icpt_hold[i], st.connected ? (LONG)st.buttons : 0);
+        }
+#endif
+        InterlockedExchange(&s_icpt_flag, 0);
+        InterlockedExchange(&s_icpt, 0);
+#if PAD_BACKEND_HOST
+        for (int i = 0; i < PAD_MAX_HOST_PORTS; i++)
+            if (s_act_set[i]) padhost_set_actuator(i, s_act[i][0], s_act[i][1]);
+#endif
+    }
+    printf("[cellPad] system intercept %s%s\n", on ? "ON: every port neutral" : "off",
+           on ? (flag ? ", system_info = CELL_PAD_INFO_INTERCEPTED (the title may pause)"
+                      : (ab ? ", flag not reported (pause_mode = off)" : ", flag not reported (PAD_INTERCEPT_FLAG=0)"))
+              : "");
+    fflush(stdout);
+}
+
+int cellPad_host_intercepted(void) { return (int)s_icpt; }
