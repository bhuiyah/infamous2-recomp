+static void test_sfo_json(void)
+{
+    uint8_t s[256]; memset(s, 0, sizeof s);
+    s[1] = 'P'; s[2] = 'S'; s[3] = 'F'; s[4] = 1; s[5] = 1;
+    tp_wr32le(s + 8, 0x14 + 2 * 16);        /* key table */
+    tp_wr32le(s + 12, 0x14 + 2 * 16 + 32);  /* data table */
+    tp_wr32le(s + 16, 2);
+    /* entry 0: CATEGORY "DG", entry 1: TITLE_ID "BCUS98125" */
+    s[0x14] = 0; s[0x14 + 1] = 0; tp_wr32le(s + 0x14 + 4, 3); tp_wr32le(s + 0x14 + 8, 4); tp_wr32le(s + 0x14 + 12, 0);
+    s[0x24] = 9; s[0x24 + 1] = 0; tp_wr32le(s + 0x24 + 4, 10); tp_wr32le(s + 0x24 + 8, 16); tp_wr32le(s + 0x24 + 12, 4);
+    memcpy(s + 0x34, "CATEGORY\0TITLE_ID\0", 18);
+    memcpy(s + 0x54, "DG\0\0BCUS98125\0", 14);
+    char out[64];
+    CHECK(!tp_sfo_string(s, sizeof s, "TITLE_ID", out, sizeof out) && !strcmp(out, "BCUS98125"));
+    CHECK(!tp_sfo_string(s, sizeof s, "CATEGORY", out, sizeof out) && !strcmp(out, "DG"));
+    CHECK(tp_sfo_string(s, sizeof s, "TITLE", out, sizeof out) != 0);
+    CHECK(tp_sfo_string(s, 0x30, "TITLE_ID", out, sizeof out) != 0);       /* entries cut off */
+    tp_wr32le(s + 0x24 + 12, 0xFFFFFF00u);
+    CHECK(tp_sfo_string(s, sizeof s, "TITLE_ID", out, sizeof out) != 0);   /* data outside */
+    s[0] = 1; CHECK(tp_sfo_string(s, sizeof s, "TITLE_ID", out, sizeof out) != 0);
+    /* index.jsonl fields */
+    const char* line = "{\"hash\":\"c095f01e9261e877\",\"h0\":\"00000000000000aa\",\"w\":512,\"fmt\":\"DXT45\",\"dec\":1,\"file\":\"DXT45/a \\\"b\\\".png\"}";
+    uint64_t h; long long v; char str[64];
+    CHECK(!tp_json_hex64(line, "hash", &h) && h == 0xc095f01e9261e877ull);
+    CHECK(!tp_json_hex64(line, "h0", &h) && h == 0xaa);
+    CHECK(!tp_json_int(line, "w", &v) && v == 512);
+    CHECK(!tp_json_str(line, "fmt", str, sizeof str) && !strcmp(str, "DXT45"));
+    CHECK(!tp_json_str(line, "file", str, sizeof str) && !strcmp(str, "DXT45/a \"b\".png"));
+    CHECK(tp_json_hex64(line, "missing", &h) != 0 && tp_json_str("{\"x\":\"unterminated", "x", str, sizeof str) != 0);
+    CHECK(tp_json_str(line, "file", str, 4) != 0);                           /* too long for the buffer */
+    CHECK(tp_json_hex64("{\"hash\":\"c095f01e9261e87\"}", "hash", &h) != 0); /* 15 digits */
+    /* key set */
+    tp_hset hs; memset(&hs, 0, sizeof hs);
+    for (uint64_t i = 0; i < 5000; i++) CHECK(tp_hset_add(&hs, i * 0x9E3779B97F4A7C15ull) == 1);
+    CHECK(tp_hset_add(&hs, 0) == 0 && tp_hset_has(&hs, 1) && tp_hset_has(&hs, 4999 * 0x9E3779B97F4A7C15ull) && !tp_hset_has(&hs, 12345));
+    tp_hset_free(&hs);
+}
