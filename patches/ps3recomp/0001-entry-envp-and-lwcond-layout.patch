+static int capture(char* why, size_t n)
+{
+    static unsigned seq;
+    ss_capture_info ci;
+    memset(&ci, 0, sizeof ci);
+    ci.seq = ++seq;
+    ci.purpose = SS_P_SAVE;
+    uint32_t fc = 0;
+    if (ss_state_prepare(why, n) != SS_OK) return SS_E_NOMEM;
+    const int r = ss_state_capture(&ci, why, n, &fc);
+    if (r == SS_OK) ss_state_seal();
+    return r;
+}
+static const uint32_t k_mine[4] = {
+    SS_FOURCC('A', 'U', 'D', 'I'), SS_FOURCC('P', 'A', 'D', '_'), SS_FOURCC('S', 'U', 'T', 'L'),
+    SS_FOURCC('M', 'I', 'S', 'C'),
+};
+/* records of a RECS list (any field list of that name will do: count only) */
+static int nrecs(const ss_image* img, uint32_t fourcc, const char* list)
+{
+    const ss_section_ops* o = ss_section_find(fourcc);
+    for (int i = 0; o && o->lists && o->lists[i]; i++) {
+        if (strcmp(o->lists[i]->name, list)) continue;
+        ss_reader r;
+        ss_recs_it it;
+        if (ss_reader_open(&r, img, fourcc) != SS_OK || ss_recs_open(&r, o->lists[i], &it) != SS_OK) return -1;
+        return (int)it.count;
+    }
+    return -2;
+}
+/* LOAD img through the four sections' ops: check_image, every teardown
+ * (then a capture: every library at its boot state), every restore, the
+ * fidelity check, every after_release */
+static void load(const ss_image* img, const char* tag)
+{
+    char why[256] = "";
+    const ss_section_ops* ops[4];
+    for (int i = 0; i < 4; i++) {
+        ops[i] = ss_section_find(k_mine[i]);
+        ss_reader r;
+        int e = ss_reader_open(&r, img, k_mine[i]);
+        if (!e) e = ops[i]->check_image(&r);
+        CHECK(e == SS_OK, "%s: check_image %.4s: %d %s", tag, (const char*)&k_mine[i], e, ss_reader_what(&r));
+    }
+    freeze(1);
+    for (int i = 0; i < 4; i++) ops[i]->teardown();
+    CHECK(capture(why, sizeof why) == SS_OK, "%s: capture after teardown: %s", tag, why);
+    const ss_image* t = ss_image_captured();
+    CHECK(nrecs(t, k_mine[0], "ports") == 0 && nrecs(t, k_mine[0], "notify_queues") == 0 &&
+          nrecs(t, k_mine[1], "keyboards") == 0 && nrecs(t, k_mine[1], "mice") == 0 &&
+          nrecs(t, k_mine[2], "callbacks") == 0 && nrecs(t, k_mine[2], "events") == 0 &&
+          nrecs(t, k_mine[2], "completions") == 0 && nrecs(t, k_mine[3], "trophy_contexts") == 0 &&
+          nrecs(t, k_mine[3], "http_transactions") == 0 && nrecs(t, k_mine[3], "netctl_handlers") == 0,
+          "%s: teardown leaves every table empty", tag);
+    for (int i = 0; i < 4; i++) {
+        ss_reader r;
+        int e = ss_reader_open(&r, img, k_mine[i]);
+        if (!e) e = ops[i]->restore(&r);
+        CHECK(e == SS_OK, "%s: restore %.4s: %d %s", tag, (const char*)&k_mine[i], e, ss_reader_what(&r));
+    }
+    CHECK(capture(why, sizeof why) == SS_OK, "%s: the fidelity check's capture: %s", tag, why);
+    static ss_verify_result v;
+    ss_state_verify(img, ss_image_captured(), &v);
+    int compared = 0;
+    for (unsigned i = 0; i < v.n; i++)
+        for (int k = 0; k < 4; k++)
+            if (v.sec[i].fourcc == k_mine[k]) {
+                compared++;
+                CHECK(v.sec[i].diffs == 0, "%s: verify %.4s: %u difference(s), first: %s", tag,
+                      (const char*)&k_mine[k], v.sec[i].diffs, v.sec[i].first);
+            }
+    CHECK(compared == 4, "%s: the four sections compared (%d)", tag, compared);
+    freeze(0);
+    for (int i = 0; i < 4; i++) if (ops[i]->after_release) ops[i]->after_release();
+    printf("%s: loaded; verify: %u section(s) compared, %u differ (GCM_ / TIME are not this test's)\n", tag,
+           v.compared, v.differ);
+}
