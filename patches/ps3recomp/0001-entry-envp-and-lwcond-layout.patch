+    s_ss_userdata = (uint32_t)(uintptr_t)s_userdata;
+    s_ss_nobutton_left_ms = !s_nobutton_deadline ? 0
+                          : s_nobutton_deadline > now ? (uint64_t)(s_nobutton_deadline - now) : 1;
