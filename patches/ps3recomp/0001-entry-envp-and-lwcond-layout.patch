+/* ---------------------------------------------------------------------------
+ * Render thread: release list, descriptors, index snapshot, reps
+ * -----------------------------------------------------------------------*/
+static void tp_release_later(ID3D12Resource* r, uint64_t cval)
+{
+    if (!r) return;
+    struct tp_rel e; e.r = r; e.dval = s_tp.dval; e.cval = cval;
+    if (tp_push((void**)&s_tp.rel, &s_tp.nrel, &s_tp.caprel, &e, sizeof e)) {
+        static int w = 0; if (!w++) tp_log("release list full: leaking a replacement texture");
+    }
+}
+static void tp_release_drain(void)
+{
+    if (!s_tp.nrel) return;
+    const uint64_t dd = s_tp.dfence->lpVtbl->GetCompletedValue(s_tp.dfence);
+    const uint64_t cd = s_tp.cfence->lpVtbl->GetCompletedValue(s_tp.cfence);
+    int k = 0;
+    for (int i = 0; i < s_tp.nrel; i++) {
+        if (s_tp.rel[i].dval <= dd && s_tp.rel[i].cval <= cd) s_tp.rel[i].r->lpVtbl->Release(s_tp.rel[i].r);
+        else s_tp.rel[k++] = s_tp.rel[i];
+    }
+    s_tp.nrel = k;
+}
+
+static void tp_rep_drop(tp_rep* r)       /* give the resource back (evict / superseded / removed) */
+{
+    if (!r->res) return;
+    tp_release_later(r->res, 0);           /* its upload's copy fence passed when it became usable */
+    r->res = NULL;
+    s_tp.vram_used -= r->bytes < s_tp.vram_used ? r->bytes : s_tp.vram_used;
+    r->bytes = 0;
+    if (r->desc >= 0) { s_tp.desc_free[s_tp.ndesc_free++] = r->desc; r->desc = -1; }
+    for (int i = 0; i < TP_DV; i++) r->dv[i].valid = 0;
+    for (int i = 0; i < s_tp.nlive; i++) if (s_tp.live[i] == r) { s_tp.live[i] = s_tp.live[--s_tp.nlive]; break; }
+}
+
+/* CPU descriptor for a view of the replacement (created on first use; cached
+ * per (mapping, cube, levels) in the replacement's own block, so the slot's
+ * own SRV variants are never disturbed). 0 when none can be had. */
+static SIZE_T tp_rt_rep_view(tp_rep* r, UINT mapping, int cube, uint32_t levels)
+{
+    if (!r->res) return 0;
+    if (r->desc < 0) {
+        if (!s_tp.ndesc_free) {   /* every block holds a resident replacement: tp_evict frees stale ones */
+            static int w = 0;
+            if (!w++) tp_log("all %d replacement views in use: a replacement shows the original until stale ones are evicted",
+                             TP_DESC_BLOCKS);
+            s_tp.st_held++;
+            return 0;
+        }
+        r->desc = s_tp.desc_free[--s_tp.ndesc_free];
+        for (int i = 0; i < TP_DV; i++) r->dv[i].valid = 0;
+    }
+    int k = 0;
+    while (k < TP_DV && !(r->dv[k].valid && r->dv[k].map == mapping && r->dv[k].cube == cube && r->dv[k].levels == levels)) k++;
+    if (k == TP_DV) {
+        k = (int)(r->dv_next++ % TP_DV);
+        D3D12_SHADER_RESOURCE_VIEW_DESC sv; memset(&sv, 0, sizeof sv);
+        sv.Format = (DXGI_FORMAT)r->dxgi;
+        sv.Shader4ComponentMapping = mapping;
+        if (cube) {
+            sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURECUBE;
+            sv.TextureCube.MipLevels = levels;
+        } else {
+            sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+            sv.Texture2D.MipLevels = levels;
+        }
+        D3D12_CPU_DESCRIPTOR_HANDLE h; h.ptr = s_tp.cpu_base + (SIZE_T)((uint32_t)r->desc * TP_DV + (uint32_t)k) * s_tp.inc;
+        s_tp.dev->lpVtbl->CreateShaderResourceView(s_tp.dev, r->res, &sv, h);
+        r->dv[k].map = mapping; r->dv[k].cube = cube; r->dv[k].levels = levels; r->dv[k].valid = 1;
+    }
+    return s_tp.cpu_base + (SIZE_T)((uint32_t)r->desc * TP_DV + (uint32_t)k) * s_tp.inc;
+}
+
+static int tp_entry_better(const tp_entry* a, const tp_entry* b)   /* a wins over b */
+{
+    if (a->prio != b->prio) return a->prio < b->prio;
+    if (a->kind != b->kind) return a->kind == TP_KIND_DDS;
+    return 0;
+}
+
+/* Take the loader's newest pack-folder snapshot: new files, changed files
+ * (version bump, reloaded while the old one stays bound), removed files. */
+static void tp_apply_snapshot(tp_srec* recs, int n)
+{
+    for (int i = 0; i < s_tp.nent; i++) s_tp.ent[i]->seen = 0;
+    int added = 0, changed = 0, removed = 0;
+    for (int i = 0; i < n; i++) {
+        tp_srec* r = &recs[i];
+        tp_entry* e = (tp_entry*)tp_map_get(&s_tp.by_path, r->pkey);
+        if (!e) {
+            e = (tp_entry*)calloc(1, sizeof *e);
+            if (!e) { free(r->path); continue; }
+            e->path = r->path; r->path = NULL;
+            e->pkey = r->pkey;
+            if (tp_push((void**)&s_tp.ent, &s_tp.nent, &s_tp.capent, &e, sizeof e)) { free(e->path); free(e); continue; }
+            tp_map_put(&s_tp.by_path, e->pkey, e);
+            e->version = 1; added++;
+        } else {
+            free(r->path); r->path = NULL;
+            if (e->removed || e->mtime != r->mtime || e->size != r->size) { e->version++; changed += !e->removed; added += e->removed; }
+        }
+        e->hash = r->ni.hash; e->h0 = r->h0; e->w = r->ni.w; e->h = r->ni.h; e->fmt = r->ni.fmt;
+        e->ln = r->ni.ln; e->cube = r->ni.cube; e->kind = r->ni.kind; e->prio = r->prio;
+        e->mtime = r->mtime; e->size = r->size; e->vbytes = r->vbytes; e->removed = 0; e->seen = 1;
+        if (e->rep && e->rep->loaded_version != e->version) { e->rep->failed = 0; }
+    }
+    free(recs);
+    for (int i = 0; i < s_tp.nent; i++) {
+        tp_entry* e = s_tp.ent[i];
+        if (!e->seen && !e->removed) { e->removed = 1; removed++; if (e->rep) tp_rep_drop(e->rep); }
+    }
+    tp_map_clear(&s_tp.by_hash); tp_map_clear(&s_tp.by_h0);
+    s_tp.has_h0 = 0; s_tp.npack_files = 0;
+    for (int i = 0; i < s_tp.nent; i++) {
+        tp_entry* e = s_tp.ent[i];
+        if (e->removed) continue;
+        s_tp.npack_files++;
+        tp_entry* o = (tp_entry*)tp_map_get(&s_tp.by_hash, e->hash);
+        if (!o || tp_entry_better(e, o)) tp_map_put(&s_tp.by_hash, e->hash, e);
+        if (e->h0) {
+            s_tp.has_h0 = 1;
+            o = (tp_entry*)tp_map_get(&s_tp.by_h0, e->h0);
+            if (!o || tp_entry_better(e, o)) tp_map_put(&s_tp.by_h0, e->h0, e);
+        }
+    }
+    s_tp.gen++;
+    s_tp.snap_seq++;
+    if (s_tp.snap_seq == 1 || added || changed || removed)
+        tp_log("pack index: %d files (%d new, %d changed, %d removed)%s", s_tp.npack_files, added, changed, removed,
+               s_tp.has_h0 ? ", level-0 hashes known" : "");
+}
+
+/* What an entry's load will hold in video memory, for the budget gate: the
+ * scan's estimate, else a guess (a DDS its file size, a PNG 4x its file). */
+static uint64_t tp_load_estimate(const tp_entry* e)
+{
+    return e->vbytes ? e->vbytes : e->kind == TP_KIND_DDS ? e->size : e->size * 4u;
+}
+
+/* Ask the loader for a replacement's file (render thread; never waits). */
+static void tp_request(tp_rep* r, const tp_slot* ts, const tp_desc* d, uint32_t off)
+{
+    (void)ts;
+    if (r->inflight || r->failed || s_tp.dead) return;
+    tp_req q; memset(&q, 0, sizeof q);
+    q.rep = r; q.version = r->e->version;
+    q.path = _wcsdup(r->e->path);
+    if (!q.path) return;
+    q.kind = r->e->kind; q.cls = tp_class_of(d->fmt); q.ow = d->w; q.oh = d->h; q.cube = d->cube;
+    q.d = *d; q.off = off;
+    AcquireSRWLockExclusive(&s_tp.lk);
+    const int bad = tp_push((void**)&s_tp.req, &s_tp.nreq, &s_tp.capreq, &q, sizeof q);
+    ReleaseSRWLockExclusive(&s_tp.lk);
+    if (bad) { free(q.path); return; }
+    WakeConditionVariable(&s_tp.cv);
+    r->inflight = 1;
+    r->pend = tp_load_estimate(r->e);   /* counted against the budget until the loader says */
+    s_tp.vram_pending += r->pend;
+}
+
+/* Finished uploads: take those whose copy fence has passed. */
+static void tp_take_results(uint32_t batch)
+{
+    AcquireSRWLockExclusive(&s_tp.lk);
+    for (int i = 0; i < s_tp.nres; i++) tp_push((void**)&s_tp.arr, &s_tp.narr, &s_tp.caparr, &s_tp.res[i], sizeof s_tp.res[i]);
+    s_tp.nres = 0;
+    ReleaseSRWLockExclusive(&s_tp.lk);
+    if (!s_tp.narr) return;
+    const uint64_t cd = s_tp.cfence->lpVtbl->GetCompletedValue(s_tp.cfence);
+    int k = 0;
+    for (int i = 0; i < s_tp.narr; i++) {
+        tp_res* x = &s_tp.arr[i];
+        if (x->ok && x->cval > cd) { s_tp.arr[k++] = *x; continue; }
+        tp_rep* r = x->rep;
+        r->inflight = 0;
+        s_tp.vram_pending -= r->pend < s_tp.vram_pending ? r->pend : s_tp.vram_pending;
+        r->pend = 0;
+        if (!x->ok) {
+            r->failed = 1; s_tp.st_fail++;
+            static int nl = 0;
+            if (nl++ < 64) tp_log("cannot use %ls: %s", r->e->path, x->err);
+            continue;
+        }
+        if (x->version != r->e->version || r->e->removed || !s_tp.packs) {   /* superseded (or packs off) while loading */
+            tp_release_later(x->res, x->cval);
+            continue;
+        }
+        if (r->res) { tp_rep_drop(r); s_tp.st_reload++; }
+        r->res = x->res; r->dxgi = x->dxgi; r->w = x->w; r->h = x->h; r->levels = x->levels; r->faces = x->faces;
+        r->s = x->s; r->bytes = x->bytes; r->loaded_version = x->version; r->last_bound = batch; r->last_frame = s_tp.frame;
+        s_tp.vram_used += x->bytes;
+        tp_push((void**)&s_tp.live, &s_tp.nlive, &s_tp.caplive, &r, sizeof r);
+        s_tp.st_load++; s_tp.st_loadbytes += x->bytes; s_tp.st_ms_decode += x->ms_read + x->ms_decode; s_tp.st_ms_upload += x->ms_upload;
+        static int nl = 0;
+        if (nl++ < tp_cfg_log()) tp_log("loaded %ls: %ux%u%s x%d, %u levels, dxgi %u, %.1f MB (read %.1f + decode %.1f + upload %.1f ms)",
+                                        r->e->path, x->w, x->h, x->faces == 6 ? " cube" : "", 1 << (x->s > 0 ? x->s : 0), x->levels,
+                                        x->dxgi, (double)x->bytes / 1048576.0, x->ms_read, x->ms_decode, x->ms_upload);
+    }
+    s_tp.narr = k;
+}
+
+static int tp_live_cmp(const void* a, const void* b)
+{
+    const tp_rep* x = *(tp_rep* const*)a; const tp_rep* y = *(tp_rep* const*)b;
+    if (x->last_frame != y->last_frame) return x->last_frame < y->last_frame ? -1 : 1;
+    return x->last_bound < y->last_bound ? -1 : x->last_bound > y->last_bound;
+}
+/* VRAM budget: least recently bound first; nothing bound in the last two
+ * presented frames is evicted (a frame is many batches here: a batch-based
+ * window would evict what every frame binds and reload it, over and over, on
+ * a small budget). Runs when the use is over the budget (down to 90% of it),
+ * or when a load was held back for want of room (tp_rt_bind: down to what
+ * leaves room for the largest one), or when the replacement views (one block
+ * of TP_DESC_BLOCKS per resident replacement) run low -- many small
+ * replacements under a large budget would otherwise use them all up and
+ * every texture seen after that would keep its original (down to twice
+ * TP_DESC_LOW free). A slot that loses its replacement falls back to the
+ * original and asks again the next time it is bound. */
+static void tp_evict(uint32_t batch)
+{
+    (void)batch;
+    const uint64_t want = s_tp.evict_want;
+    s_tp.evict_want = 0;
+    const int desc_low = s_tp.ndesc_free < TP_DESC_LOW;
+    if (!s_tp.nlive || (s_tp.vram_used <= s_tp.vram_budget && !want && !desc_low)) return;
+    uint64_t target = s_tp.vram_budget / 10u * 9u;
+    if (want) {
+        const uint64_t taken = s_tp.vram_pending + want;
+        const uint64_t room = taken < s_tp.vram_budget ? s_tp.vram_budget - taken : 0u;
+        if (room < target) target = room;
+    }
+    if (s_tp.vram_used <= target && !desc_low) return;
+    /* a sorted copy: tp_rep_drop reorders s_tp.live */
+    tp_rep** order = (tp_rep**)malloc((size_t)s_tp.nlive * sizeof *order);
+    if (!order) return;
+    const int n = s_tp.nlive;
+    memcpy(order, s_tp.live, (size_t)n * sizeof *order);
+    qsort(order, (size_t)n, sizeof *order, tp_live_cmp);
+    for (int i = 0; i < n && (s_tp.vram_used > target || s_tp.ndesc_free < 2 * TP_DESC_LOW); i++) {
+        if (order[i]->last_frame + 2u >= s_tp.frame) break;     /* everything after it is newer */
+        tp_rep_drop(order[i]);
+        s_tp.st_evict++;
+    }
+    free(order);
+}
+
+/* Start of a texture batch (tc_batch_begin). `frame` is the backend's frame
+ * counter, `perf` prints the [TEXPACK] line every 20 batches. */
+static void tp_rt_batch_begin(uint32_t batch, uint64_t frame, int perf)
+{
+    if (g_tp_on == 2) tp_rt_activate();
+    if (g_tp_on != 1) return;
+    /* everything submitted before this point is covered by this value */
+    s_tp.dq->lpVtbl->Signal(s_tp.dq, s_tp.dfence, ++s_tp.dval);
+    /* s_tp.frame: presented frames, monotonic. The backend's counter is its
+     * once-a-second fps count (it goes back to 0 every second), so its
+     * changes are counted: +n when it grew by n, +1 when it was reset (one
+     * frame was counted, then the counter cleared). */
+    { static uint64_t last; static int have;
+      if (!have) { have = 1; s_tp.frame = 1; }
+      else if (frame != last) s_tp.frame += frame > last ? frame - last : frame + 1u;
+      last = frame; }
+    s_tp.relookups = 0;
+    { static uint64_t budget_frame;          /* the dump's copy budget is per presented frame */
+      if (budget_frame != s_tp.frame) { budget_frame = s_tp.frame; s_tp.dbatch_bytes = 0; } }
+    /* live settings */
+    { const LONG p = InterlockedExchange(&s_tp.set_packs, 0) - 1;
+      if (p >= 0 && p != s_tp.packs) { s_tp.packs = p; s_tp.gen++; tp_log("packs %s", p ? "on" : "off");
+          if (!p) while (s_tp.nlive) tp_rep_drop(s_tp.live[0]); } }
+    { const LONG d = InterlockedExchange(&s_tp.set_dump, 0) - 1;
+      if (d >= 0 && d != s_tp.dump) { s_tp.dump = d; s_tp.gen++; tp_log("dump %s", d ? "on" : "off"); } }
+    { const LONG v = InterlockedExchange(&s_tp.set_vram, 0) - 1;
+      if (v >= 0) s_tp.vram_budget = v ? (uint64_t)v << 20 : tp_auto_budget(); }
+    if (InterlockedExchange(&s_tp.set_reload, 0)) {
+        AcquireSRWLockExclusive(&s_tp.lk); s_tp.rescan = 1; ReleaseSRWLockExclusive(&s_tp.lk);
+        WakeConditionVariable(&s_tp.cv);
+    }
+    if (s_tp.ab && (s_tp.frame / (uint64_t)s_tp.ab) % 2u != (uint64_t)!s_tp.packs) {
+        s_tp.packs = !s_tp.packs; s_tp.gen++;
+        static int nl = 0; if (nl++ < 2000) tp_log("TEXPACK_AB: packs %s at frame %llu", s_tp.packs ? "on" : "off", (unsigned long long)s_tp.frame);
+    }
+    /* pack-folder snapshot */
+    { tp_srec* recs = NULL; int n = 0, have = 0;
+      AcquireSRWLockExclusive(&s_tp.lk);
+      if (s_tp.snap_ready) { recs = s_tp.snap; n = s_tp.nsnap; s_tp.snap = NULL; s_tp.nsnap = 0; s_tp.snap_ready = 0; have = 1; }
+      ReleaseSRWLockExclusive(&s_tp.lk);
+      if (have) tp_apply_snapshot(recs, n); }
+    tp_take_results(batch);
+    tp_evict(batch);
+    tp_release_drain();
+    /* the last batch's usage tuples: one hand-over (swap, or append) */
+    if (s_tp.ndul) {
+        AcquireSRWLockExclusive(&s_tp.dlk);
+        if (!s_tp.ndu) {
+            tp_duse* t = s_tp.du; const int c = s_tp.capdu;
+            s_tp.du = s_tp.dul; s_tp.ndu = s_tp.ndul; s_tp.capdu = s_tp.capdul;
+            s_tp.dul = t; s_tp.capdul = c;
+        } else if (s_tp.ndu < 65536)
+            for (int i = 0; i < s_tp.ndul; i++) tp_push((void**)&s_tp.du, &s_tp.ndu, &s_tp.capdu, &s_tp.dul[i], sizeof *s_tp.dul);
+        ReleaseSRWLockExclusive(&s_tp.dlk);
+        s_tp.ndul = 0;
+        WakeConditionVariable(&s_tp.dcv);
+    }
+    /* dump thread messages */
+    { AcquireSRWLockExclusive(&s_tp.dlk);
+      uint64_t* done = s_tp.ddone; const int nd = s_tp.nddone;
+      tp_dretry* rt = s_tp.dret; const int nr = s_tp.ndret;
+      const int ready = s_tp.dready_posted;
+      s_tp.ddone = NULL; s_tp.nddone = s_tp.capddone = 0;
+      s_tp.dret = NULL; s_tp.ndret = s_tp.capdret = 0;
+      ReleaseSRWLockExclusive(&s_tp.dlk);
+      for (int i = 0; i < nd; i++) tp_hset_add(&s_tp.dumped, done[i]);
+      if (ready) s_tp.dumped_ready = 1;
+      free(done);
+      /* a write raced the copy: the slot (if it still holds those bytes) settles again */
+      for (int i = 0; i < nr; i++)
+          if (rt[i].ts->hash == rt[i].hash && (rt[i].ts->flags & TP_F_DQUEUED))
+              rt[i].ts->flags = (rt[i].ts->flags & ~TP_F_DQUEUED) | TP_F_DPENDING;
+      s_tp.st_retry += (uint32_t)nr;
+      free(rt); }
+    if (perf && batch % 20u == 0) {
+        tp_log("index %d files | lookups %u, hits %u (+%u level-0), binds %u, TXL kept original %u, relookups %u | loaded %u"
+               " (%.1f MB, decode %.1f ms, upload %.1f ms), failed %u, reloaded %u | VRAM %.1f/%.0f MB, %d resident, evicted %u, held back %u |"
+               " dump: queued %u (%.1f MB), written %ld, retried %u | vetoed %u, rsx-made %u, uniform %u, dynamic %u",
+               s_tp.npack_files, s_tp.st_lookup, s_tp.st_hit, s_tp.st_hit0, s_tp.st_bind, s_tp.st_txl, s_tp.st_relook,
+               s_tp.st_load, (double)s_tp.st_loadbytes / 1048576.0, s_tp.st_ms_decode, s_tp.st_ms_upload, s_tp.st_fail,
+               s_tp.st_reload, (double)s_tp.vram_used / 1048576.0, (double)s_tp.vram_budget / 1048576.0, s_tp.nlive,
+               s_tp.st_evict, s_tp.st_held, s_tp.st_dumpq, (double)s_tp.st_dumpbytes / 1048576.0, (long)InterlockedExchange(&s_tp.st_written, 0),
+               s_tp.st_retry, s_tp.st_veto, s_tp.st_rsx, s_tp.st_uni, s_tp.st_dyn);
+        s_tp.st_lookup = s_tp.st_hit = s_tp.st_hit0 = s_tp.st_bind = s_tp.st_txl = s_tp.st_relook = s_tp.st_load = 0;
+        s_tp.st_fail = s_tp.st_reload = s_tp.st_evict = s_tp.st_dumpq = s_tp.st_retry = s_tp.st_veto = 0;
+        s_tp.st_rsx = s_tp.st_uni = s_tp.st_dyn = s_tp.st_held = 0;
+        s_tp.st_loadbytes = s_tp.st_dumpbytes = 0; s_tp.st_ms_decode = s_tp.st_ms_upload = 0.0;
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * RSX-written ranges (critique C2/M11). NV3089 / NV309E / NV308A copies and
+ * the backend's readbacks write guest memory with content our renderer made;
+ * a texture uploaded from such bytes is neither dumped nor replaced. Only
+ * writes since the slot's previous upload count (for a new slot: the last 600
+ * frames), so memory an RSX copy wrote long ago and the CPU has since refilled
+ * is not marked for good.
+ * -----------------------------------------------------------------------*/
+static void tp_rt_note_rsx_write(uint32_t ea, uint32_t len)
+{
+    if (!g_tp_on || !len) return;
+    const uint64_t end = (uint64_t)ea + len;
+    const uint32_t hi = end > 0xFFFFFFFFull ? 0xFFFFFFFFu : (uint32_t)end;
+    /* consecutive writes (an inline transfer's words, a blit's rows) extend one entry */
+    const LONG last = s_tp.rsxw_n & 255;
+    if (s_tp.rsxw[last].frame && ea >= s_tp.rsxw[last].lo && ea <= s_tp.rsxw[last].hi) {
+        if (hi > s_tp.rsxw[last].hi) s_tp.rsxw[last].hi = hi;
+        s_tp.rsxw[last].frame = s_tp.frame + 1u;
+        return;
+    }
+    const LONG i = InterlockedIncrement(&s_tp.rsxw_n) & 255;
+    s_tp.rsxw[i].lo = ea; s_tp.rsxw[i].hi = hi; s_tp.rsxw[i].frame = s_tp.frame + 1u;
+}
+static int tp_rsx_overlaps(uint32_t off, uint64_t span, uint64_t since)
+{
+    const uint64_t end = (uint64_t)off + span;
+    for (int i = 0; i < 256; i++)
+        if (s_tp.rsxw[i].frame && s_tp.rsxw[i].frame >= since && s_tp.rsxw[i].lo < end && s_tp.rsxw[i].hi > off) return 1;
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Slot hooks (render thread). The backend glue calls these.
+ * -----------------------------------------------------------------------*/
+static tp_rep* tp_rep_of(tp_entry* e)
+{
+    if (!e->rep) {
+        tp_rep* r = (tp_rep*)calloc(1, sizeof *r);
+        if (!r) return NULL;
+        r->e = e; r->desc = -1;
+        e->rep = r;
+    }
+    return e->rep;
+}
+
+/* Look the slot's identity up in the pack index. */
+static void tp_lookup(tp_slot* ts, const tp_desc* d, const tp_layout* L, const uint8_t* src)
+{
+    ts->rep = NULL;
+    ts->gen = s_tp.gen;
+    if (!s_tp.packs || (ts->flags & TP_F_NOREPLACE) || !s_tp.npack_files) return;
+    s_tp.st_lookup++;
+    tp_entry* e = (tp_entry*)tp_map_get(&s_tp.by_hash, ts->hash);
+    const uint32_t bf = d->fmt & 0x9Fu; const int ln = (d->fmt & 0x20u) ? 1 : 0;
+    if (e && (e->removed || e->w != d->w || e->h != d->h || e->fmt != bf || e->ln != ln || e->cube != d->cube)) {
+        static int nl = 0;
+        if (nl++ < 16) tp_log("%ls names %ux%u %s%s%s but the texture with that hash is %ux%u %s%s%s: not used", e->path,
+                              e->w, e->h, tp_fmt_name(e->fmt), e->ln ? " ln" : "", e->cube ? " cube" : "",
+                              d->w, d->h, tp_fmt_name(bf), ln ? " ln" : "", d->cube ? " cube" : "");
+        e = NULL;
+    }
+    int via0 = 0;
+    if (!e && s_tp.l0 && s_tp.has_h0) {
+        if (!ts->hash0 && L && src) tp_hashes(L, src, NULL, &ts->hash0);
+        tp_entry* e0 = ts->hash0 ? (tp_entry*)tp_map_get(&s_tp.by_h0, ts->hash0) : NULL;
+        if (e0 && !e0->removed && e0->w == d->w && e0->h == d->h && e0->fmt == bf && e0->ln == ln && e0->cube == d->cube) { e = e0; via0 = 1; }
+    }
+    if (!e) return;
+    ts->rep = tp_rep_of(e);
+    s_tp.st_hit++; s_tp.st_hit0 += (uint32_t)via0;
+}
+
+/* Identity of the bytes a slot just uploaded (or, lazily, holds): both
+ * hashes, the content flags, the dynamic count, the dump decision, the pack
+ * lookup. `cache_hash` is the cache's own hash of exactly the canonical stream
+ * when it can be reused (the backend glue decides: contiguous, v2, all guest
+ * levels uploaded, write watch), else 0. `uploaded` = 1 after an upload, 0 for
+ * a lazy identification of a resident slot. */
+static void tp_rt_identify(tp_slot* ts, int newkey, const tp_desc* d, const uint8_t* src, uint32_t off,
+                           uint64_t cache_hash, uint64_t cache_span, uint32_t batch, uint64_t frame, int uploaded)
+{
+    if (newkey) { memset(ts, 0, sizeof *ts); }
+    const uint64_t old = (ts->flags & TP_F_HASHED) ? ts->hash : 0;
+    const uint32_t keep = ts->flags & (TP_F_DYNAMIC);
+    const uint64_t prev_frame = ts->up_frame;
+    ts->flags = keep;
+    ts->hash0 = 0;
+    tp_layout L;
+    const char* veto = tp_reg_veto(d->fmt, 0);
+    if (veto || tp_layout_of(d, &L)) {
+        ts->flags |= TP_F_NOREPLACE | TP_F_NODUMP | TP_F_HASHED; ts->hash = 0; ts->rep = NULL; ts->gen = s_tp.gen;
+        s_tp.st_veto++;
+        return;
+    }
+    if (cache_hash && L.contiguous && cache_span == L.stream_bytes) ts->hash = cache_hash;
+    else if (tp_hashes(&L, src, &ts->hash, NULL)) { ts->flags |= TP_F_NOREPLACE | TP_F_NODUMP; ts->rep = NULL; return; }
+    ts->flags |= TP_F_HASHED;
+    if (uploaded) {
+        if (old && old != ts->hash && ++ts->changes >= 2u && !(ts->flags & TP_F_DYNAMIC)) { ts->flags |= TP_F_DYNAMIC; s_tp.st_dyn++; }
+        ts->up_batch = batch; ts->up_frame = frame;
+    } else if (!ts->up_frame) { ts->up_batch = batch; ts->up_frame = frame; }
+    if (tp_is_uniform(&L, d, src)) { ts->flags |= TP_F_UNIFORM | TP_F_NOREPLACE | TP_F_NODUMP; s_tp.st_uni++; }
+    { const uint64_t since = (!newkey && prev_frame) ? prev_frame : (frame > 600u ? frame - 600u : 0u);
+      if (tp_rsx_overlaps(off, L.guest_span, since)) { ts->flags |= TP_F_RSXMADE | TP_F_NOREPLACE | TP_F_NODUMP; s_tp.st_rsx++; } }
+    const int cls = tp_class_of(d->fmt);
+    if (!tp_class_is_color(cls) && !s_tp.dump_all) ts->flags |= TP_F_NODUMP;
+    if (ts->flags & TP_F_DYNAMIC) ts->flags |= TP_F_NODUMP;
+    if (s_tp.dump && !(ts->flags & TP_F_NODUMP) && !tp_hset_has(&s_tp.dumped, tp_dump_key(ts->hash))) ts->flags |= TP_F_DPENDING;
+    tp_lookup(ts, d, &L, src);
+}
+
+/* Settle rule + the budgeted copy (render thread, at a bind). The copy is
+ * the guest bytes of every guest level (the canonical stream's source); the
+ * dump thread re-hashes it, so a write racing the copy is caught there. */
+static void tp_rt_dump_check(tp_slot* ts, const tp_desc* d, const uint8_t* src, uint32_t off, uint32_t batch, uint64_t frame)
+{
+    if (!s_tp.dumped_ready) return;
+    if (tp_hset_has(&s_tp.dumped, tp_dump_key(ts->hash))) { ts->flags &= ~TP_F_DPENDING; return; }
+    if (batch - ts->up_batch < 8u || frame - ts->up_frame < 2u) return;
+    tp_layout L;
+    if (tp_layout_of(d, &L)) { ts->flags &= ~TP_F_DPENDING; return; }
+    if (s_tp.dbatch_bytes + L.guest_span > s_tp.dump_budget && s_tp.dbatch_bytes) return;   /* next frame */
+    if ((uint64_t)InterlockedAdd64(&s_tp.dinflight, 0) > (256ull << 20)) return;
+    if (L.guest_span > (256ull << 20) || (uint64_t)off + L.guest_span > 0x100000000ull) { ts->flags &= ~TP_F_DPENDING; return; }
+    tp_djob j; memset(&j, 0, sizeof j);
+    j.buf = (uint8_t*)malloc((size_t)L.guest_span);
+    if (!j.buf) return;
+    memcpy(j.buf, src, (size_t)L.guest_span);
+    j.bytes = (uint32_t)L.guest_span; j.d = *d; j.d.levels = L.glv; j.hash = ts->hash; j.ts = ts;
+    j.raw = s_tp.raw; j.argb = rsx_texture_argb_is_rgba(); j.frame = frame; j.t = tc_now() - s_tp.t0;
+    { const char* c = s_tp.ctx_fn ? s_tp.ctx_fn() : s_tp.ctx_default;
+      snprintf(j.ctx, sizeof j.ctx, "%s", c ? c : ""); }
+    AcquireSRWLockExclusive(&s_tp.dlk);
+    const int bad = tp_push((void**)&s_tp.dj, &s_tp.ndj, &s_tp.capdj, &j, sizeof j);
+    ReleaseSRWLockExclusive(&s_tp.dlk);
+    if (bad) { free(j.buf); return; }
+    InterlockedAdd64(&s_tp.dinflight, (LONG64)j.bytes);
+    WakeConditionVariable(&s_tp.dcv);
+    s_tp.dbatch_bytes += L.guest_span;
+    s_tp.st_dumpq++; s_tp.st_dumpbytes += L.guest_span;
+    ts->flags = (ts->flags & ~TP_F_DPENDING) | TP_F_DQUEUED;
+}
+
+/* A usage record for the dump index (how the texture is sampled). */
+static void tp_rt_note_use(tp_slot* ts, uint32_t fp_id, uint32_t unit, uint32_t fmt, uint32_t ctrl1, uint32_t addr,
+                           uint32_t filt, int txl, int at_en, uint32_t at_func, uint32_t at_ref)
+{
+    uint64_t k = ts->hash;
+    k = tp_hset_mix(k ^ ((uint64_t)fp_id << 32 | unit)); k = tp_hset_mix(k ^ ((uint64_t)ctrl1 << 32 | addr));
+    k = tp_hset_mix(k ^ ((uint64_t)filt << 8 | (uint64_t)(txl ? 2 : 0) | (uint64_t)(at_en ? 1 : 0)));
+    if (k == ts->use_key) return;
+    ts->use_key = k;
+    if (tp_hset_add(&s_tp.useseen, k) != 1) return;
+    tp_duse u; u.hash = ts->hash; u.fp_id = fp_id; u.unit = unit; u.fmt = fmt; u.ctrl1 = ctrl1; u.addr = addr; u.filt = filt;
+    u.txl = (uint8_t)(txl ? 1 : 0); u.at_en = (uint8_t)(at_en ? 1 : 0); u.at_func = (uint8_t)at_func; u.at_ref = (uint8_t)at_ref;
+    if (s_tp.ndul < 65536) tp_push((void**)&s_tp.dul, &s_tp.ndul, &s_tp.capdul, &u, sizeof u);   /* handed over at the next batch */
+}
+
+/* The replacement to bind for a slot, or NULL for the original. Handles the
+ * register veto (3D, border), lazy identification / relookup after a pack
+ * change (bounded per batch, critique M10), the dump's settle check and the
+ * load request. `fword` is the unit's SET_TEXTURE_FORMAT word. */
+static tp_rep* tp_rt_bind(tp_slot* ts, const tp_desc* d, const uint8_t* src, uint32_t off, uint32_t fword,
+                          uint32_t batch, uint64_t frame)
+{
+    if (!s_tp.packs && !s_tp.dump) return NULL;
+    /* the format byte's vetoes (depth, UN, unknown) were decided when the slot
+     * was identified (TP_F_NOREPLACE | TP_F_NODUMP); the format WORD's are
+     * per binding (tp_reg_veto): a 3D texture, a border texture */
+    if (fword && (((fword >> 4) & 0xFu) == 3u || !(fword & 8u))) return NULL;
+    if (!(ts->flags & TP_F_HASHED) || ts->gen != s_tp.gen) {
+        if (s_tp.relookups >= TP_RELOOKUP_PER_BATCH) return NULL;     /* the original this batch */
