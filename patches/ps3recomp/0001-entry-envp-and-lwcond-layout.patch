+/* A "HID" device whose handle is the client end of a message-mode named pipe:
+ * the real overlapped ReadFile / WriteFile / CancelIoEx paths of the device
+ * thread, with reports written and output read through the server end. */
+static int pipe_read_msg(HANDLE srv, unsigned char* buf, int cap, int timeout_ms)
+{
+    ULONGLONG end = GetTickCount64() + (ULONGLONG)timeout_ms;
+    for (;;) {
+        DWORD avail = 0;
+        if (PeekNamedPipe(srv, NULL, 0, NULL, &avail, NULL) && avail) {
+            DWORD r = 0;
+            ReadFile(srv, buf, (DWORD)cap, &r, NULL);
+            return (int)r;
+        }
+        if (GetTickCount64() > end) return -1;
+        Sleep(1);
+    }
+}
+
+static PhDev* pipe_device(const char* pipename, HANDLE* srv_out, const char* fake_path)
+{
+    HANDLE srv = CreateNamedPipeA(pipename, PIPE_ACCESS_DUPLEX, PIPE_TYPE_MESSAGE | PIPE_READMODE_MESSAGE | PIPE_WAIT,
+                                  1, 4096, 4096, 0, NULL);
+    HANDLE cli = CreateFileA(pipename, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+    if (srv == INVALID_HANDLE_VALUE || cli == INVALID_HANDLE_VALUE) return NULL;
+    DWORD mode = PIPE_READMODE_MESSAGE;
+    SetNamedPipeHandleState(cli, &mode, NULL, NULL);
+    PhDev* d = ph_dev_new(&stub_drv, 64);
+    d->pub.handle = cli;
+    d->can_write = 1;
+    d->pub.bus = PADHOST_BUS_USB; d->pub.vid = 0x1234; d->pub.pid = 0x9999;
+    d->pub.usage_page = 1; d->pub.usage = 5;
+    d->pub.in_len = 64; d->pub.out_len = 4; d->pub.feat_len = 8;
+    snprintf(d->pathbuf, sizeof d->pathbuf, "%s", fake_path);
+    snprintf(d->pub.name, sizeof d->pub.name, "pipe pad");
+    AcquireSRWLockExclusive(&s_lock);
+    ph_dev_add(d);
+    ReleaseSRWLockExclusive(&s_lock);
+    ph_dev_start(d);
+    *srv_out = srv;
+    return d;
+}
+
+static int wait_state(int port, int connected, int ms)
+{
+    PadHostPortState st;
+    ULONGLONG end = GetTickCount64() + (ULONGLONG)ms;
+    while (padhost_get(port, &st) != connected && GetTickCount64() < end) Sleep(1);
+    return padhost_get(port, &st) == connected;
+}
