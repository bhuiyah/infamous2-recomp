+static void post_cmd(int cmd, int arg)
+{
+    if (s_top) PostMessageA(s_top, WM_APP_OVL, (WPARAM)cmd, (LPARAM)arg);
+}
+
+static DWORD WINAPI open_folder_thread(LPVOID p)
+{
+    (void)p;
+    int ex = 0;
+    const char* path = opt_file_path(&ex);
+    char dir[1024];
+    if (path && path[0]) snprintf(dir, sizeof dir, "%s", path);
+    else GetFullPathNameA("config", sizeof dir, dir, NULL);
+    char* slash = strrchr(dir, '\\');
+    if (slash && path && path[0]) *slash = 0;
+    wchar_t w[1024];
+    MultiByteToWideChar(CP_UTF8, 0, dir, -1, w, 1024);
+    HRESULT ci = CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+    ShellExecuteW(NULL, L"open", w, NULL, NULL, SW_SHOWNORMAL);
+    if (SUCCEEDED(ci)) CoUninitialize();
+    return 0;
+}
+
+static void handle_act(int act)
+{
+    if (act == OVL_ACT_CLOSE) post_cmd(OVL_CMD_CLOSE, 0);
+    else if (act == OVL_ACT_QUIT) {
+        /* the same as the window's close button: the main loop lets a save finish, then ends the process */
+        ovl_logf("quit from the options menu");
+        post_cmd(OVL_CMD_CLOSE, 0);
+        if (s_top) PostMessageW(s_top, WM_CLOSE, 0, 0);
+    } else if (act == OVL_ACT_OPEN_FOLDER) {
+        HANDLE t = CreateThread(NULL, 0, open_folder_thread, NULL, 0, NULL);
+        if (t) CloseHandle(t);
+    }
+}
