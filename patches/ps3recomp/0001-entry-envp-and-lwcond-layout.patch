+static int g_fail, g_checks;
+#define CHECK(cond) do { g_checks++; if (!(cond)) { g_fail++; \
+    printf("  FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); } } while (0)
+#define CHECK_EQ(a, b) do { long _a = (long)(a), _b = (long)(b); g_checks++; if (_a != _b) { g_fail++; \
+    printf("  FAIL %s:%d: %s == %ld, expected %ld\n", __FILE__, __LINE__, #a, _a, _b); } } while (0)
+
+static int same_bytes(const u8* a, const u8* b, int n, const char* what)
+{
+    for (int i = 0; i < n; i++)
+        if (a[i] != b[i]) { printf("  %s differs at byte %d: %02X vs expected %02X\n", what, i, a[i], b[i]); return 0; }
+    return 1;
+}
+static int zero_from(const u8* a, int from, int to)
+{
+    for (int i = from; i < to; i++) if (a[i]) return 0;
+    return 1;
+}
