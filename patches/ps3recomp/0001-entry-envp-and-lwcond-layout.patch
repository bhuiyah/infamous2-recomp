diff --git a/libs/video/tests/test_ovl_host.c b/libs/video/tests/test_ovl_host.c
new file mode 100644
index 0000000..63443aa
--- /dev/null
+++ b/libs/video/tests/test_ovl_host.c
@@ -0,0 +1,279 @@
+/*
+ * ps3recomp - the options overlay's host (libs/video/ovl.c + ovl_dcomp.cpp) in
+ * a window shaped like the game's: a top-level window with a child "view"
+ * that owns a 1280x720 flip swap chain presented every frame, the window
+ * procedure handing every message to ovl_wndproc first, as the D3D12 backend
+ * does. No game, no game data; the window sits off screen and never takes
+ * the focus (the overlay is still composed by DWM, just not visible).
+ *
+ * Checks (the host's state through ovl_test_state):
+ *   - nothing exists until the menu first opens (no thread, no composition);
+ *   - F1 opens it: thread running, host = DirectComposition, composed, the
+ *     surface at the client size; the system intercept is on;
+ *   - a resize to 2560x1080 and back (what F11 does) resizes the surface
+ *     (ResizeBuffers repeats FRAME_LATENCY_WAITABLE_OBJECT, or it fails);
+ *   - minimised and restored: no 0x0 surface, still composed afterwards;
+ *   - a screen grab's ovl_capture_begin hides it (returns 1, not composed),
+ *     ovl_capture_end shows it again;
+ *   - F1 closes it: the intercept ends and the composition objects are
+ *     released within a second (nothing above the game's picture); this held
+ *     after the resizes too (it did not, once: the regression this guards);
+ *   - the FPS counter alone (fps_counter = on) composes again, and turning
+ *     it off releases it again.
+ *
+ * Windows. From external/ps3recomp:
+ *   clang-cl /nologo /W3 -D_CRT_SECURE_NO_WARNINGS -I include -I libs/system -I libs/video -I libs/input
+ *     libs/video/tests/test_ovl_host.c libs/video/ovl.c libs/video/ovl_menu.c libs/video/ovl_dcomp.cpp
+ *     libs/system/options.c d3d12.lib dxgi.lib d3dcompiler.lib dxguid.lib gdi32.lib user32.lib
+ *     /Fe:T/toh.exe
+ *   T/toh.exe            (OVL_HOST=backbuffer is not covered here: it needs the game's frame)
+ */
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ovl.h"
+#include "ps3emu/overlay.h"
+#include "ps3emu/options.h"
+#include "pad_host.h"
+
+/* ---- what ovl.c needs from the rest of the toolkit (cellPad, pad host, the backend) */
+char g_rsx_title_base[128] = "ovl host test";
+static int g_icpt;
+void cellPad_host_intercept(int on, int report_flag) { (void)report_flag; g_icpt = on; }
+int  cellPad_host_intercepted(void) { return g_icpt; }
+int  cellPad_host_mouse_release(void) { return 0; }
+void cellPad_host_mouse_capture(void* hwnd) { (void)hwnd; }
+int  cellPad_kbm_unbind_key(int vk) { (void)vk; return 0; }
+void cellPad_host_set_system_hook(void (*fn)(int port, int what)) { (void)fn; }
+void cellPad_host_set_menu_combo(unsigned buttons, unsigned hold_ms) { (void)buttons; (void)hold_ms; }
+int  padhost_get(int port, PadHostPortState* out) { (void)port; memset(out, 0, sizeof *out); return 0; }
+
+static int g_fail, g_checks;
+#define CHECK(c, ...) do { g_checks++; if (!(c)) { g_fail++; printf("FAIL line %d: ", __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static ID3D12Device* g_dev;
+static ID3D12CommandQueue* g_q;
+static IDXGISwapChain3* g_sc;
+static ID3D12CommandAllocator* g_al;
+static ID3D12GraphicsCommandList* g_cl;
+static ID3D12DescriptorHeap* g_rtv;
+static UINT g_rtv_inc;
+static ID3D12Fence* g_fence;
+static UINT64 g_fval;
+static HANDLE g_fev;
+static HWND g_top, g_view;
+
+static LRESULT CALLBACK top_proc(HWND h, UINT m, WPARAM w, LPARAM l)
+{
+    LRESULT r = 0;
+    if (ovl_wndproc(h, m, w, l, &r)) return r;
+    if (m == WM_SIZE && g_view) MoveWindow(g_view, 0, 0, LOWORD(l), HIWORD(l), TRUE);
+    return DefWindowProcA(h, m, w, l);
+}
+
+static void game_frame(void)
+{
+    const UINT idx = g_sc->lpVtbl->GetCurrentBackBufferIndex(g_sc);
+    ID3D12Resource* bb = NULL;
+    g_sc->lpVtbl->GetBuffer(g_sc, idx, &IID_ID3D12Resource, (void**)&bb);
+    g_al->lpVtbl->Reset(g_al);
+    g_cl->lpVtbl->Reset(g_cl, g_al, NULL);
+    D3D12_RESOURCE_BARRIER b; memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; b.Transition.pResource = bb;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT; b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g_cl->lpVtbl->ResourceBarrier(g_cl, 1, &b);
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv; g_rtv->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_rtv, &rtv);
+    rtv.ptr += idx * g_rtv_inc;
+    const float c[4] = { 0.2f, 0.35f, 0.5f, 1.0f };
+    g_cl->lpVtbl->ClearRenderTargetView(g_cl, rtv, c, 0, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET; b.Transition.StateAfter = D3D12_RESOURCE_STATE_PRESENT;
+    g_cl->lpVtbl->ResourceBarrier(g_cl, 1, &b);
+    g_cl->lpVtbl->Close(g_cl);
+    g_q->lpVtbl->ExecuteCommandLists(g_q, 1, (ID3D12CommandList**)&g_cl);
+    g_sc->lpVtbl->Present(g_sc, 0, 0);
+    ovl_note_present();
+    g_q->lpVtbl->Signal(g_q, g_fence, ++g_fval);
+    if (g_fence->lpVtbl->GetCompletedValue(g_fence) < g_fval) {
+        g_fence->lpVtbl->SetEventOnCompletion(g_fence, g_fval, g_fev);
+        WaitForSingleObject(g_fev, 2000);
+    }
+    bb->lpVtbl->Release(bb);
+}
+
+/* Pump and draw "game" frames for ms milliseconds (the backend's window thread). */
+static void run_for(unsigned ms)
+{
+    const ULONGLONG t0 = GetTickCount64();
+    while (GetTickCount64() - t0 < ms) {
+        MSG msg;
+        while (PeekMessageA(&msg, NULL, 0, 0, PM_REMOVE)) { TranslateMessage(&msg); DispatchMessageA(&msg); }
+        game_frame();
+        Sleep(10);
+    }
+}
+
+static int init(void)
+{
+    if (FAILED(D3D12CreateDevice(NULL, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&g_dev))) {
+        IDXGIFactory4* f = NULL; IDXGIAdapter* warp = NULL;
+        if (FAILED(CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&f)) ||
+            FAILED(f->lpVtbl->EnumWarpAdapter(f, &IID_IDXGIAdapter, (void**)&warp)) ||
+            FAILED(D3D12CreateDevice((IUnknown*)warp, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&g_dev)))
+            return 0;
+        printf("(WARP)\n");
+    }
+    D3D12_COMMAND_QUEUE_DESC qd; memset(&qd, 0, sizeof qd);
+    g_dev->lpVtbl->CreateCommandQueue(g_dev, &qd, &IID_ID3D12CommandQueue, (void**)&g_q);
+    g_dev->lpVtbl->CreateCommandAllocator(g_dev, D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator, (void**)&g_al);
+    g_dev->lpVtbl->CreateCommandList(g_dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, g_al, NULL, &IID_ID3D12GraphicsCommandList, (void**)&g_cl);
+    g_cl->lpVtbl->Close(g_cl);
+    g_dev->lpVtbl->CreateFence(g_dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&g_fence);
+    g_fev = CreateEventA(NULL, FALSE, FALSE, NULL);
+
+    WNDCLASSEXA wc; memset(&wc, 0, sizeof wc);
+    wc.cbSize = sizeof wc; wc.lpfnWndProc = top_proc; wc.hInstance = GetModuleHandleA(NULL);
+    wc.hCursor = LoadCursor(NULL, IDC_ARROW); wc.lpszClassName = "ovl_host_test";
+    wc.hbrBackground = (HBRUSH)GetStockObject(BLACK_BRUSH);
+    RegisterClassExA(&wc);
+    WNDCLASSEXA vc = wc; vc.lpfnWndProc = DefWindowProcA; vc.lpszClassName = "ovl_host_test_view";
+    RegisterClassExA(&vc);
+    RECT r = { 0, 0, 1707, 720 };
+    AdjustWindowRect(&r, WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN, FALSE);
+    g_top = CreateWindowExA(WS_EX_NOACTIVATE, "ovl_host_test", "ovl host test", WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN,
+                            -6000, -3000, r.right - r.left, r.bottom - r.top, NULL, NULL, wc.hInstance, NULL);
+    if (!g_top) return 0;
+    g_view = CreateWindowExA(0, "ovl_host_test_view", "", WS_CHILD | WS_VISIBLE | WS_DISABLED, 0, 0, 1707, 720,
+                             g_top, NULL, wc.hInstance, NULL);
+    ShowWindow(g_top, SW_SHOWNOACTIVATE);
+
+    IDXGIFactory2* fac = NULL;
+    CreateDXGIFactory1(&IID_IDXGIFactory2, (void**)&fac);
+    DXGI_SWAP_CHAIN_DESC1 d; memset(&d, 0, sizeof d);
+    d.Width = 1280; d.Height = 720; d.Format = DXGI_FORMAT_R8G8B8A8_UNORM; d.SampleDesc.Count = 1;
+    d.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT; d.BufferCount = 3; d.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    d.Scaling = DXGI_SCALING_STRETCH;
+    IDXGISwapChain1* sc1 = NULL;
+    if (FAILED(fac->lpVtbl->CreateSwapChainForHwnd(fac, (IUnknown*)g_q, g_view, &d, NULL, NULL, &sc1))) return 0;
+    sc1->lpVtbl->QueryInterface(sc1, &IID_IDXGISwapChain3, (void**)&g_sc);
+    sc1->lpVtbl->Release(sc1);
+    fac->lpVtbl->Release(fac);
+    D3D12_DESCRIPTOR_HEAP_DESC hd = { D3D12_DESCRIPTOR_HEAP_TYPE_RTV, 3, D3D12_DESCRIPTOR_HEAP_FLAG_NONE, 0 };
+    g_dev->lpVtbl->CreateDescriptorHeap(g_dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&g_rtv);
+    g_rtv_inc = g_dev->lpVtbl->GetDescriptorHandleIncrementSize(g_dev, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    D3D12_CPU_DESCRIPTOR_HANDLE h; g_rtv->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_rtv, &h);
+    for (UINT i = 0; i < 3; i++) {
+        ID3D12Resource* b = NULL;
+        g_sc->lpVtbl->GetBuffer(g_sc, i, &IID_ID3D12Resource, (void**)&b);
+        D3D12_CPU_DESCRIPTOR_HANDLE hi = h; hi.ptr += i * g_rtv_inc;
+        g_dev->lpVtbl->CreateRenderTargetView(g_dev, b, NULL, hi);
+        b->lpVtbl->Release(b);
+    }
+    return 1;
+}
+
+static void client_size(int w, int h)
+{
+    RECT r = { 0, 0, w, h };
+    AdjustWindowRect(&r, WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN, FALSE);
+    SetWindowPos(g_top, NULL, 0, 0, r.right - r.left, r.bottom - r.top, SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+}
+
+static void key(int vk)
+{
+    PostMessageA(g_top, WM_KEYDOWN, (WPARAM)vk, 1);
+    PostMessageA(g_top, WM_KEYUP, (WPARAM)vk, 0xC0000001);
+}
+
+static void state(int* ts, int* host, int* comp, int* w, int* h) { ovl_test_state(ts, host, comp, w, h); }
+
+/* wait (pumping) until composed == want, at most ms; returns the time it took or -1 */
+static int wait_composed(int want, unsigned ms)
+{
+    const ULONGLONG t0 = GetTickCount64();
+    for (;;) {
+        int comp = 0;
+        state(NULL, NULL, &comp, NULL, NULL);
+        if (comp == want) return (int)(GetTickCount64() - t0);
+        if (GetTickCount64() - t0 > ms) return -1;
+        run_for(20);
+    }
+}
+
+int main(void)
+{
+    _putenv("OPTIONS_CONFIG=none"); _putenv("DISPLAY_CONFIG=none"); _putenv("PAD_CONFIG=none");
+    _putenv("OVL_LOG=1");
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (!init()) { printf("FAIL: no D3D12 window / swap chain\n"); return 1; }
+    CHECK(ovl_install(g_dev, g_top) == 1, "install");
+    run_for(300);
+    int ts = 0, host = 0, comp = 0, w = 0, h = 0;
+    state(&ts, &host, &comp, &w, &h);
+    CHECK(ts == 0 && host == 0 && comp == 0, "nothing before the first open: thread %d host %d composed %d", ts, host, comp);
+
+    key(VK_F1);
+    int t = wait_composed(1, 3000);
+    state(&ts, &host, &comp, &w, &h);
+    CHECK(t >= 0 && ts == 2 && host == 1, "F1: composed after %d ms, thread %d host %d", t, ts, host);
+    CHECK(w == 1707 && h == 720, "surface = client 1707x720: %dx%d", w, h);
+    CHECK(ovl_options_open() && options_intercepted() && g_icpt, "open + intercept on");
+    run_for(300);
+
+    client_size(2560, 1080);
+    run_for(500);
+    state(NULL, NULL, &comp, &w, &h);
+    { RECT cr; GetClientRect(g_top, &cr);   /* the desktop may clip the height */
+      CHECK(comp && w == cr.right && h == cr.bottom && w > 1707, "larger client %ldx%ld: composed %d surface %dx%d",
+            cr.right, cr.bottom, comp, w, h); }
+    client_size(1707, 720);
+    run_for(500);
+    state(NULL, NULL, &comp, &w, &h);
+    CHECK(comp && w == 1707 && h == 720, "back to 1707x720: composed %d surface %dx%d", comp, w, h);
+
+    ShowWindow(g_top, SW_SHOWMINNOACTIVE);
+    run_for(400);
+    state(NULL, NULL, NULL, &w, &h);
+    CHECK(w > 0 && h > 0, "minimised: no 0x0 surface (%dx%d)", w, h);
+    ShowWindow(g_top, SW_SHOWNOACTIVATE);
+    run_for(400);
+    state(NULL, NULL, &comp, &w, &h);
+    CHECK(comp && w == 1707 && h == 720, "restored: composed %d surface %dx%d", comp, w, h);
+
+    {   /* a screen grab, called on the window thread as kbm_inject's registered message is: this thread
+         * pumps nothing meanwhile, so the overlay thread must not need it to hide */
+        const int got = ovl_capture_begin(1000);
+        int during = -1;
+        state(NULL, NULL, &during, NULL, NULL);
+        CHECK(got == 1 && during == 0, "capture: hidden %d, composed during %d", got, during);
+        ovl_capture_end();
+        t = wait_composed(1, 2000);
+        CHECK(t >= 0, "after the capture: composed again (%d ms)", t);
+    }
+
+    key(VK_F1);
+    t = wait_composed(0, 1500);
+    CHECK(t >= 0, "F1 closes: composition released after %d ms", t);
+    CHECK(!ovl_options_open() && !options_intercepted() && !g_icpt, "closed + intercept off");
+    state(&ts, NULL, NULL, NULL, NULL);
+    CHECK(ts == 2, "the thread stays (thread %d)", ts);
+
+    ovl_set_show_fps(1);
+    t = wait_composed(1, 3000);
+    CHECK(t >= 0 && ovl_get_show_fps(), "FPS counter on: composed after %d ms", t);
+    run_for(600);
+    ovl_set_show_fps(0);
+    t = wait_composed(0, 1500);
+    CHECK(t >= 0, "FPS counter off: released after %d ms", t);
+
+    ovl_shutdown();
+    printf("%s: %d checks, %d failures\n", g_fail ? "FAILED" : "PASSED", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_ovl_menu.c b/libs/video/tests/test_ovl_menu.c
new file mode 100644
index 0000000..7883456
--- /dev/null
+++ b/libs/video/tests/test_ovl_menu.c
@@ -0,0 +1,613 @@
+/*
+ * ps3recomp - the options overlay's menu (libs/video/ovl_menu.c) on the
+ * settings store (libs/system/options.c): layout at many window sizes and
+ * DPIs, the tabs and rows the store's table gives, keyboard / controller
+ * navigation, every widget's value changes (selector, choice list, slider,
+ * toggle), env-locked rows, reset, reset-all confirmation, presets, mouse hit
+ * tests and drags. No window, no GPU, no game data: the store runs with
+ * OPTIONS_CONFIG / DISPLAY_CONFIG / PAD_CONFIG = none and two env locks.
+ *
+ * Windows (the glyph atlas is GDI's). From external/ps3recomp:
+ *   clang-cl /nologo /W3 -D_CRT_SECURE_NO_WARNINGS -I include -I libs/system -I libs/video -I libs/input
+ *     libs/video/tests/test_ovl_menu.c libs/video/ovl_menu.c libs/system/options.c gdi32.lib user32.lib
+ *     /Fe:T/tom.exe
+ *   T/tom.exe
+ */
+#include "ovl_menu.h"
+#include "pad_host.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <windows.h>
+
+/* options.c's system pause calls into cellPad: not part of this test */
+void cellPad_host_intercept(int on, int report_flag) { (void)on; (void)report_flag; }
+int  cellPad_host_intercepted(void) { return 0; }
+
+static int g_fail, g_checks;
+#define CHECK(c) do { g_checks++; if (!(c)) { printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #c); g_fail++; } } while (0)
+#define CHECK_STR(a, b) do { g_checks++; if (strcmp((a), (b))) { printf("FAIL %s:%d  \"%s\" != \"%s\"\n", __FILE__, __LINE__, (a), (b)); g_fail++; } } while (0)
+
+static ovl_font g_font[4];
+static float g_font_s[4];
+static int g_nfont;
+
+static const ovl_font* font_for(float s)
+{
+    for (int i = 0; i < g_nfont; i++) if (fabsf(g_font_s[i] - s) < 0.001f) return &g_font[i];
+    if (g_nfont == 4) { ovl_font_free(&g_font[0]); memmove(g_font, g_font + 1, 3 * sizeof g_font[0]);
+                        memmove(g_font_s, g_font_s + 1, 3 * sizeof g_font_s[0]); g_nfont = 3; }
+    int faces[OVL_NFACE][2];
+    ovl_menu_faces(s, faces);
+    ovl_font* F = &g_font[g_nfont];
+    if (!ovl_font_build(F, "Segoe UI", (const int (*)[2])faces, OVL_NFACE, s)) { printf("font build failed\n"); exit(2); }
+    g_font_s[g_nfont++] = s;
+    return F;
+}
+
+static ovl_list g_L;
+
+static void draw(ovl_menu* m, int W, int H, unsigned dpi)
+{
+    const float s = ovl_menu_scale(W, H, dpi, 1.0f);
+    ovl_begin(&g_L, W, H, font_for(s));
+    ovl_menu_draw(m, &g_L, s);
+}
+
+static int text_of(ovl_menu* m, const char* key, char* out, size_t n)
+{
+    opt_id id = opt_find(key);
+    if (id < 0) { out[0] = 0; return 0; }
+    opt_text(id, out, n);
+    return 1;
+}
+
+static int find_item(ovl_menu* m, const char* key)
+{
+    opt_id id = opt_find(key);
+    for (int i = 0; i < m->nitems; i++) if (m->items[i].kind == OVL_IT_SETTING && m->items[i].id == id) return i;
+    return -1;
+}
+
+static void go_tab(ovl_menu* m, const char* name)
+{
+    for (int k = 0; k < 12 && strcmp(ovl_menu_tab_name(m), name); k++) ovl_menu_nav(m, OVL_NAV_TAB_NEXT, 0);
+    draw(m, 1707, 720, 96);
+}
+
+static void focus_item(ovl_menu* m, const char* key)
+{
+    int want = find_item(m, key);
+    for (int k = 0; k < 64 && want >= 0 && m->focus[m->tab] != want; k++) ovl_menu_nav(m, OVL_NAV_DOWN, 0);
+    draw(m, 1707, 720, 96);
+}
+
+int main(void)
+{
+    _putenv("OPTIONS_CONFIG=none");
+    _putenv("DISPLAY_CONFIG=none");
+    _putenv("PAD_CONFIG=none");
+    _putenv("PRESENT_SYNC=1");          /* locks vsync (ENV) */
+    _putenv("IF2_ASPECT=off");          /* a title row's own variable */
+    static const opt_def title_rows[] = {
+        { "aspect", NULL, "display", "display", "Display", "Screen", "Aspect ratio (field of view)", "tip",
+          OPT_TEXT, OPT_RESTART, NULL, NULL, 0, 0, 0, "auto", "IF2_ASPECT", "DISPLAY_CFG",
+          { NULL, NULL, NULL, NULL, NULL }, OPT_F_ENHANCEMENT, "if2", NULL },
+        { "detail", "detail_distance", "options", "graphics", "Graphics", "Detail", "Detail distance", "tip",
+          OPT_FLOAT, OPT_LIVE, NULL, NULL, 0.5, 2.0, 0.05, "1.0", "IF2_DETAIL", NULL,
+          { "1.0", "0.75", "1.0", "1.0", "1.25" }, OPT_F_ENHANCEMENT, "if2", NULL },
+        { "fps_counter", NULL, "options", "overlay", "Frame", "Counter", "FPS counter", "tip",
+          OPT_ENUM, OPT_LIVE, "off|on|detailed", "Off|On|Detailed", 0, 0, 0, "off", NULL, NULL,
+          { NULL, NULL, NULL, NULL, NULL }, OPT_F_ENHANCEMENT, "overlay", NULL },
+        { "secret", NULL, "options", "x", "Frame", "Counter", "Hidden row", "tip",
+          OPT_BOOL, OPT_LIVE, NULL, NULL, 0, 0, 0, "0", NULL, NULL, { NULL, NULL, NULL, NULL, NULL },
+          OPT_F_HIDDEN, "test", NULL },
+        { "mystery", NULL, "options", "x", "Experiments", "Lab", "A sibling's row", "tip",
+          OPT_BOOL, OPT_LIVE, NULL, NULL, 0, 0, 0, "0", NULL, NULL, { NULL, NULL, NULL, NULL, NULL }, 0, "test", NULL },
+    };
+    for (unsigned i = 0; i < sizeof title_rows / sizeof title_rows[0]; i++) CHECK(opt_register(&title_rows[i]) >= 0);
+
+    /* ---- the scale rule and the faces */
+    CHECK(fabsf(ovl_menu_scale(1280, 720, 96, 1) - 0.80f) < 1e-4f);
+    CHECK(fabsf(ovl_menu_scale(2560, 1080, 96, 1) - 1.00f) < 1e-4f);
+    CHECK(fabsf(ovl_menu_scale(3840, 2160, 96, 1) - 2.00f) < 1e-4f);
+    CHECK(fabsf(ovl_menu_scale(1707, 720, 144, 1) - 1.20f) < 1e-4f);
+    CHECK(fabsf(ovl_menu_scale(2560, 1080, 96, 1.25f) - 1.25f) < 1e-4f);
+    {
+        int faces[OVL_NFACE][2];
+        ovl_menu_faces(0.5f, faces);
+        for (int i = 0; i < OVL_NFACE; i++) CHECK(faces[i][0] >= 11);
+    }
+
+    ovl_menu m;
+    ovl_menu_init(&m);
+    m.env.refresh_hz = 75;
+    m.env.work_w = 2560; m.env.work_h = 1400;
+    m.env.nmon = 1; m.env.mon[0].w = 2560; m.env.mon[0].h = 1080; m.env.mon[0].primary = 1;
+    m.env.paused = 1;
+    snprintf(m.env.title, sizeof m.env.title, "inFamous 2 (ps3recomp)");
+    ovl_menu_opened(&m);
+    draw(&m, 1707, 720, 96);
+
+    /* ---- tabs: the six fixed ones, then a sibling's own tab */
+    CHECK(m.ntab == 7);
+    CHECK_STR(m.tabs[0], "Display");  CHECK_STR(m.tabs[1], "Graphics"); CHECK_STR(m.tabs[2], "Frame");
+    CHECK_STR(m.tabs[3], "Controls"); CHECK_STR(m.tabs[4], "Audio");    CHECK_STR(m.tabs[5], "System");
+    CHECK_STR(m.tabs[6], "Experiments");
+
+    /* ---- layout at many sizes: the panel inside the canvas, every vertex inside it, faces >= 11 px */
+    {
+        static const int sz[][3] = { {1280, 720, 96}, {1707, 720, 96}, {2560, 1080, 96}, {3440, 1440, 96},
+                                     {5120, 1440, 96}, {1024, 768, 96}, {3840, 2160, 192}, {1707, 720, 144},
+                                     {1920, 1080, 120}, {800, 600, 96} };
+        for (unsigned k = 0; k < sizeof sz / sizeof sz[0]; k++) {
+            for (int t = 0; t < m.ntab; t++) {
+                m.tab = t;
+                ovl_menu_opened(&m);
+                draw(&m, sz[k][0], sz[k][1], (unsigned)sz[k][2]);
+                CHECK(!g_L.oom && g_L.nv > 0);
+                CHECK(m.px >= 0 && m.py >= 0 && m.px + m.pw <= sz[k][0] && m.py + m.ph <= sz[k][1]);
+                int out = 0;
+                for (unsigned v = 0; v < g_L.nv; v++) {
+                    const ovl_vtx* x = &g_L.v[v];
+                    if ((int)x->mode != OVL_M_TEXT) continue;   /* shapes may pad 1 px for AA */
+                    if (x->x < -0.5f || x->y < -0.5f || x->x > sz[k][0] + 0.5f || x->y > sz[k][1] + 0.5f) out++;
+                }
+                CHECK(out == 0);
+                /* every text quad of a row stays inside the panel */
+                int outside = 0;
+                for (unsigned v = 0; v < g_L.nv; v++) {
+                    const ovl_vtx* x = &g_L.v[v];
+                    if ((int)x->mode != OVL_M_TEXT) continue;
+                    if (x->x < m.px - 1 || x->x > m.px + m.pw + 1 || x->y < m.py - 1 || x->y > m.py + m.ph + 1) outside++;
+                }
+                CHECK(outside == 0);
+                /* rows: the label ends before the control starts */
+                for (int i = 0; i < m.nitems; i++) {
+                    const ovl_item* it = &m.items[i];
+                    if (it->kind != OVL_IT_SETTING) continue;
+                    CHECK(it->cx0 > it->x0 && it->cx1 <= it->x1 && it->cx1 > it->cx0 + 60);
+                    /* ... and so do its badges (ENV + RESTART on the env-locked aspect row) */
+                    if (it->y1 >= m.ly0 && it->y0 <= m.ly1 && it->bx1 > it->cx0) {
+                        printf("FAIL badges reach the control: %s %ux%u: bx1 %.0f > cx0 %.0f\n",
+                               it->label, sz[k][0], sz[k][1], it->bx1, it->cx0);
+                        g_fail++;
+                    }
+                    g_checks++;
+                }
+            }
+            CHECK(g_L.font->face[OVL_F_TINY].px >= 11);
+        }
+    }
+
+    /* ---- Display: hidden rows are absent, the env-locked aspect row is greyed and refuses */
+    m.tab = 0; ovl_menu_opened(&m); draw(&m, 1707, 720, 96);
+    CHECK(find_item(&m, "fullscreen") >= 0 && find_item(&m, "aspect") >= 0 && find_item(&m, "window") >= 0);
+    CHECK(find_item(&m, "secret") < 0);
+    {
+        char before[64], after[64];
+        text_of(&m, "aspect", before, sizeof before);
+        focus_item(&m, "aspect");
+        ovl_menu_nav(&m, OVL_NAV_RIGHT, 0);
+        text_of(&m, "aspect", after, sizeof after);
+        CHECK_STR(before, after);
+        CHECK(strstr(m.msg, "IF2_ASPECT") != NULL);
+        char vt[96];
+        ovl_menu_value_text(&m, opt_find("aspect"), vt, sizeof vt);
+        CHECK_STR(vt, "16:9 (PS3)");
+    }
+    /* window mode: a selector Windowed / Borderless fullscreen */
+    {
+        char vt[96];
+        ovl_menu_value_text(&m, opt_find("fullscreen"), vt, sizeof vt);
+        CHECK_STR(vt, "Windowed");
+        focus_item(&m, "fullscreen");
+        ovl_menu_nav(&m, OVL_NAV_RIGHT, 0);
+        ovl_menu_value_text(&m, opt_find("fullscreen"), vt, sizeof vt);
+        CHECK_STR(vt, "Borderless fullscreen");
+        ovl_menu_nav(&m, OVL_NAV_RESET, 0);
+        ovl_menu_value_text(&m, opt_find("fullscreen"), vt, sizeof vt);
+        CHECK_STR(vt, "Windowed");
+    }
