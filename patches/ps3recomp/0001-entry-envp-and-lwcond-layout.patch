+    "mutex", "cond", "lwmutex", "lwcond", "lwcond_reacq", "spinlock", "net",
+};
+const char* ss_wait_name(int k) { return (k >= 0 && k < SS_W__COUNT) ? k_wait_name[k] : "?"; }
+int ss_wait_is_syscall(int k) { return k >= SS_W_SEM && k <= SS_W_COND; }
