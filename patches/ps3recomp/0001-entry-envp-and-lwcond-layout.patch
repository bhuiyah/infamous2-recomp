--- /dev/null
+++ b/runtime/spu/spu_context_ss.inc
@@ -0,0 +1,115 @@
+/*
+ * ps3recomp - the SPU context as the save state records it (SPUC, M4b;
+ * engine design 5.2 / 6.2): one SS_CTX(member) line per spu_context member
+ * a context is captured and restored by, in spu_context.h's order. The
+ * includer defines the three macros (spu_channels.c, k_spuc_ctx_fields):
+ *     SS_CTX(m)       captured, written back on a load
+ *     SS_CTX_NR(m)    captured for inspection and M4c's capture(restore(S))
+ *                     check, never written back: it must come back by itself
+ *     SS_CTX_HOST(m)  captured for inspection, never written back, and not
+ *                     compared by that check: a host value (a statistic, a
+ *                     host frame's depth or pc, a clock's host anchor) that
+ *                     differs between two captures of the same guest state
+ * A member that is not listed is not saved, on purpose:
+ *   ls_store          its own blob, "ls.<tid>" (256 KB, page aligned)
+ *   ls                a host pointer: ls_store again (a raw SPU's guest
+ *                     window is refused by SPUC's check)
+ *   ch_*.lock         the channel spinlocks: host state, 0 at rest
+ *   dec_base_ns       host clock: the decrementer is saved as its current
+ *                     value instead (SPUC's "context_state" record)
+ *   ch_wait_cv / ch_wait_lock, irq_frame
+ *                     host CONDITION_VARIABLE / SRWLOCK storage and a host
+ *                     frame: zero on a recreated context
+ *   res_gen, ibc_ggen, ib_ret, ib_dep, ibc[]
+ *                     the computed-branch dispatch cache (host function
+ *                     pointers): flushed on a recreated context
+ * What M4c rebuilds instead of copying (engine design 6.2; lv2_register.c's
+ * SPUC restore): a fresh context (spu_context_init: ls := ls_store, the
+ * locks, condition variable, irq_frame, the dispatch cache all zero) with the
+ * listed members read into it and ls_store from the blob; host_depth and
+ * drain_ret_pc stay 0 (the resume variant of spu_run_with_halt dispatches pc
+ * with an empty host stack); decrementer := context_state.dec_now and
+ * dec_base_ns := now when dec_armed, with the guest clock frozen at the
+ * snapshot's instant: dec_now is the value at TIME's host.qpc (the capture's
+ * one instant), so the SPU and PPU clocks go on together; the MFC engine
+ * claimed again with context_state's completed tags. At RECREATE, just
+ * before the thread resumes (spu_channels_ss_resume): resv_valid := 0 with
+ * SPU_EVENT_LR raised (losing a reservation is always legal, and the parked
+ * GETLLAR loop re-reserves) -- after the fidelity check, which compares the
+ * context as captured.
+ * Channels are recorded as they stand -- head, count and the queue -- so a
+ * restored ring reads back exactly; `value` is also what a read of an empty
+ * channel returns (spu_channel_read), so it is kept with count 0 too.
+ * Changing a member's meaning without its name or size: bump SPUC's version.
+ */
+SS_CTX(gpr)
+SS_CTX(pc)
+SS_CTX(status)
+SS_CTX(stop_code)
+SS_CTX(spu_id)
+SS_CTX(spu_group_id)
+SS_CTX(image_id)
+SS_CTX(park_on_empty_inmbox)
+SS_CTX_HOST(decrementer)            /* the latched WrDec value: with dec_base_ns, the host's form of
+                                     * context_state.dec_now, which restores and is compared */
+SS_CTX(srr0)
+SS_CTX(event_status)
+SS_CTX(event_mask)
+SS_CTX(ch_out_mbox.value)
+SS_CTX(ch_out_mbox.count)
+SS_CTX(ch_out_mbox.q)
+SS_CTX(ch_out_mbox.head)
+SS_CTX(ch_in_mbox.value)
+SS_CTX(ch_in_mbox.count)
+SS_CTX(ch_in_mbox.q)
+SS_CTX(ch_in_mbox.head)
+SS_CTX(rcv_evt)
+SS_CTX(rcv_evt_n)
+SS_CTX(rcv_evt_i)
+SS_CTX(ch_out_intr_mbox.value)
+SS_CTX(ch_out_intr_mbox.count)
+SS_CTX(ch_out_intr_mbox.q)
+SS_CTX(ch_out_intr_mbox.head)
+SS_CTX(ch_sig_notify[0].value)
+SS_CTX(ch_sig_notify[0].count)
+SS_CTX(ch_sig_notify[0].q)
+SS_CTX(ch_sig_notify[0].head)
+SS_CTX(ch_sig_notify[1].value)
+SS_CTX(ch_sig_notify[1].count)
+SS_CTX(ch_sig_notify[1].q)
+SS_CTX(ch_sig_notify[1].head)
+SS_CTX(mfc_lsa)
+SS_CTX(mfc_eah)
+SS_CTX(mfc_eal)
+SS_CTX(mfc_size)
+SS_CTX(mfc_tag)
+SS_CTX(mfc_tag_mask)
+SS_CTX(mfc_tag_status)
+SS_CTX(resv_ea)
+SS_CTX(resv_valid)                  /* dropped (Lr raised) at RECREATE: see above */
+SS_CTX(atomic_stat)
+SS_CTX_HOST(dbg_getllar)            /* a statistic */
+SS_CTX(resv_line)
+SS_CTX(policy_mode)
+SS_CTX(resident_ovl)
+SS_CTX(resident_code)               /* lsa, size, source_ea, image_id, pic_base, content_ea: guest values and ids */
+SS_CTX(resident_task)
+SS_CTX_HOST(host_depth)             /* live host frames at the park: 0 on a resume */
+SS_CTX(steps)                       /* tells a job's first entry at LS 0 from a return there */
+SS_CTX(module_img_a00)
+SS_CTX_HOST(lockstep_quantum_ctr)   /* SPU_LOCKSTEP only (a save refuses while it is armed) */
+SS_CTX_HOST(lockstep_release_tb)
+SS_CTX_HOST(dec_start_tb)
+SS_CTX(int_enable)
+SS_CTX(list_stall_mask)
+SS_CTX(list_stall_stat)
+SS_CTX(list_stall_elem_lsa)
+SS_CTX(list_stall_remaining)
+SS_CTX(list_stall_dest_lsa)
+SS_CTX(list_stall_ea_base)
+SS_CTX(list_stall_cmd)
+SS_CTX(irq_saved)                   /* 0 at every accepted stop (SPUC's check) */
+SS_CTX(irq_resume_pc)
+SS_CTX(irq_gpr)
+SS_CTX_HOST(drain_ret_pc)           /* the innermost spu_drain_call's return pc: a host frame's */
+SS_CTX(pic_bias)
