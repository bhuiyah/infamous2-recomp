+
+    printf("SPU save-state load (SPUG, SPUC, SPUH): %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * The runtime beyond the SPU, lv2 SPU and save-state engine layers, stubbed:
+ * the other syscall families, the PPU's helpers, the save-state coordinator's
