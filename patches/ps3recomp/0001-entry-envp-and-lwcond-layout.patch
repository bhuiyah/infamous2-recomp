+        if (s_tc.ring) { s_tc.ring->lpVtbl->Release(s_tc.ring); s_tc.ring = NULL; s_tc.ring_map = NULL; }
+        s_tc.ring_size = ns;
+    }
+    s_tc.ring_want = 0;
+    s_tc.ring_off = 0;
+    if (perf_on() && s_tc.batch % 20u == 0) {
+        int resident = 0;
+        for (int i = 0; i < VP_TEX_SLOTS; i++) resident += s_d3d.vp_tex[i].mapped;
+        fprintf(stderr, "[TEXCACHE] %s | binds %u (repeat-in-batch %u) | valid %u clean, %u re-hashed same,"
+                        " %u checksummed | uploads %u (%u new, %u evicted, %u re-created, %.1f MB, %u ring overflow,"
+                        " %u failed) | validate %.1f ms (hashed %.1f MB) upload %.1f ms | harvest %u x %.2f ms,"
+                        " dirty pages %u tracked / %u other, %u resets, %u hot kept, %u kept for the RSX's copies"
+                        " | resident %d, ring %llu MB | report-record binds %u%c",
+                s_tc.ww ? "ww" : "csum", s_tc.st_bind, s_tc.st_dedup, s_tc.st_clean, s_tc.st_rehash_same,
+                s_tc.st_csum, s_tc.st_upload, s_tc.st_miss, s_tc.st_evict, s_tc.st_recreate,
+                (double)s_tc.st_upbytes / 1048576.0, s_tc.st_overflow, s_tc.st_fail,
+                s_tc.st_val_s * 1e3, (double)s_tc.st_hashbytes / 1048576.0, s_tc.st_up_s * 1e3,
+                s_tcw.harvests, s_tcw.harvests ? s_tcw.harvest_s * 1e3 / s_tcw.harvests : 0.0,
+                s_tcw.dirty_tracked, s_tcw.dirty_other, s_tcw.resets, s_tcw.hot_kept, s_tcw.rsx_kept,
+                resident, (unsigned long long)(s_tc.ring_size >> 20), s_tc.st_vol, 10);
