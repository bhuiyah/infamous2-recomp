diff --git a/runtime/platform/guest_clock.h b/runtime/platform/guest_clock.h
new file mode 100644
index 0000000..ac44d9a
--- /dev/null
+++ b/runtime/platform/guest_clock.h
@@ -0,0 +1,86 @@
+/*
+ * ps3recomp - the one guest clock (save states M4c; engine design 6.4)
+ *
+ * Every clock the guest can read is derived from one count, the GUEST QPC:
+ * the host's QueryPerformanceCounter plus a bias. Routed through it: the PPU
+ * time base (ppu_timebase_now, sys_timer.c), sys_time_get_system_time
+ * (ppu_sysprx.cpp), sys_time_get_current_time (sys_timer.c), the GCM
+ * timestamps and the flip time (cellGcmSys.c, rsx_report.c), cellAudio's
+ * start time, cellMsgDialog's deadlines and the SPU decrementers
+ * (spu_channels.c). GUEST_TIME_SCALE's dilation (sys_timer.c) applies on top,
+ * to the guest QPC.
+ *
+ * The bias is 0 in a session that never saves or loads: the guest QPC is the
+ * host's, every clock reads what it read before this header existed. Two
+ * things move it, both on the save-state coordinator with every guest thread
+ * parked (sys_timer.c's ps3_guest_clock_* do the arithmetic):
+ *   a SAVE  freezes the guest QPC from its capture to its release, then goes
+ *           on from the frozen instant -- the bias takes the frozen span, so
+ *           the game sees no jump (before M4c each save moved guest time on
+ *           by its pause, ~60 ms);
+ *   a LOAD  freezes it at the instant the snapshot's time base reads, and at
+ *           the release goes on from there: guest time continues from the
+ *           snapshot, earlier or later than the session's own.
+ * Host waits and deadlines (lv2 timeouts, slices, the frame clock) stay on
+ * the host's QPC: they measure how long the host waits, not guest time.
+ *
+ * Header only: the two words are __declspec(selectany) definitions, so any
+ * file can include this without linking a particular object (unit tests that
+ * build one runtime file stay unchanged). Windows only; the POSIX branches of
+ * the clocks keep reading clock_gettime.
+ */
+#ifndef PS3RECOMP_GUEST_CLOCK_H
+#define PS3RECOMP_GUEST_CLOCK_H
+
+#ifdef _WIN32
+#  include <windows.h>
+
+#  ifdef __cplusplus
+extern "C" {
+#  endif
+/* The guest QPC is QPC + g_guest_qpc_bias, or g_guest_qpc_frozen while that
+ * is non-zero (a save's capture to its release, a load's restore to its
+ * release). Written by sys_timer.c's ps3_guest_clock_* only: the bias first,
+ * then the frozen word, so a reader that sees frozen == 0 sees the new bias. */
+__declspec(selectany) volatile long long g_guest_qpc_bias = 0;
+__declspec(selectany) volatile long long g_guest_qpc_frozen = 0;
+#  ifdef __cplusplus
+}
+#  endif
+
+static __inline long long ps3_guest_qpc(void)
+{
+    const long long f = g_guest_qpc_frozen;
+    if (f) return f;
+    LARGE_INTEGER q;
+    QueryPerformanceCounter(&q);
+    return q.QuadPart + g_guest_qpc_bias;
+}
+
+/* The QPC frequency (constant for the life of the system). */
+static __inline long long ps3_guest_qpc_freq(void)
+{
+    static volatile long long s_f;
+    long long f = s_f;
+    if (!f) {
+        LARGE_INTEGER q;
+        QueryPerformanceFrequency(&q);
+        s_f = f = q.QuadPart;
+    }
+    return f;
+}
+
+/* The guest QPC in nanoseconds / milliseconds (split divides: count * 1e9
+ * wraps a u64 within hours of uptime). Not dilated: deadlines and elapsed
+ * guest time, as the waits measure them. */
+static __inline unsigned long long ps3_guest_qpc_to_ns(long long q)
+{
+    const unsigned long long f = (unsigned long long)ps3_guest_qpc_freq();
+    const unsigned long long c = (unsigned long long)q;
+    return (c / f) * 1000000000ull + (c % f) * 1000000000ull / f;
+}
+static __inline unsigned long long ps3_guest_ns(void) { return ps3_guest_qpc_to_ns(ps3_guest_qpc()); }
+static __inline unsigned long long ps3_guest_ms(void) { return ps3_guest_ns() / 1000000ull; }
+#endif /* _WIN32 */
+
+#endif /* PS3RECOMP_GUEST_CLOCK_H */
diff --git a/runtime/platform/host_placement.h b/runtime/platform/host_placement.h
new file mode 100644
index 0000000..13fe8e0
--- /dev/null
+++ b/runtime/platform/host_placement.h
@@ -0,0 +1,48 @@
+/*
+ * host_placement.h -- opting a host thread out of HOST_PLACEMENT's restriction.
+ *
+ * HOST_PLACEMENT (runtime/syscalls/lv2_register.c, NOTES 2026-10-27 PF1) gives
+ * the frame clock and the SPU workers cores of their own and confines every
+ * other thread of the process to the remaining cores (the process's default CPU
+ * sets). A pool the game waits for -- the save-state codec workers (ss_file.c)
+ * -- calls this at its start to run on every core again (its own CPU sets
+ * override the default), so a load reads as fast as before. No default set
+ * (placement off, or not decided yet): nothing to do. Placement only.
+ */
+#ifndef PS3_HOST_PLACEMENT_H
+#define PS3_HOST_PLACEMENT_H
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <stdlib.h>
+
+static inline void ps3_host_unplace_thread(void)
+{
+    ULONG n = 0;
+    if (!GetProcessDefaultCpuSets(GetCurrentProcess(), NULL, 0, &n) && GetLastError() != ERROR_INSUFFICIENT_BUFFER)
+        return;
+    if (!n) return;                                  /* no default set: the thread runs anywhere already */
+    ULONG len = 0;
+    GetSystemCpuSetInformation(NULL, 0, &len, GetCurrentProcess(), 0);
+    unsigned char* buf = len ? (unsigned char*)malloc(len) : NULL;
+    if (!buf) return;
+    if (GetSystemCpuSetInformation((PSYSTEM_CPU_SET_INFORMATION)buf, len, &len, GetCurrentProcess(), 0)) {
+        ULONG ids[256]; ULONG k = 0;
+        for (ULONG o = 0; o < len && k < 256; ) {
+            const SYSTEM_CPU_SET_INFORMATION* si = (const SYSTEM_CPU_SET_INFORMATION*)(buf + o);
+            if (!si->Size) break;
+            if (si->Type == CpuSetInformation) ids[k++] = si->CpuSet.Id;
+            o += si->Size;
+        }
+        if (k) SetThreadSelectedCpuSets(GetCurrentThread(), ids, k);
+    }
+    free(buf);
+}
+#else
+static inline void ps3_host_unplace_thread(void) {}
+#endif
+
+#endif /* PS3_HOST_PLACEMENT_H */
