+/* A VP draw (QUADS / TRIANGLES / TRIANGLE_STRIP / TRIANGLE_FAN, indexed or
+ * not): record + vertices + indices. TRIANGLES entries of one BEGIN/END extend
+ * the previous record (RSX concatenates them before assembling primitives --
+ * see d3d12_draw_arrays); here that is just appending indices. */
+static void vnew_draw(u32 primitive, u32 first, u32 count, int indexed)
+{
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (primitive == RSX_PRIMITIVE_TRIANGLES) { s_req_verts += count; s_req_draws++; }
+    if (!st || !vm_base || !s_d3d.vp_vb_mapped || !s_d3d.vp_ib_mapped) return;
+    if (!st->vertex_attribs[0].enabled) return;
+    if (!rsx_vexpand_count(primitive, count)) return;
+    /* The entry's guest index lines (non-indexed: the head of its vertex
+     * arrays) start on their way now and arrive while the record below is
+     * built -- hints only, nothing is read (rsx_vemit_prefetch). */
+    rsx_vemit_prefetch(st, primitive, first, count, indexed);
+    { static int va = -1; if (va < 0) va = getenv("VP_ATTRS") ? 1 : 0;
+      if (va) vp_attrs_dbg(st); }
+    batch_capacity_check(count);
+
+    D3D12DrawRecord* dr = NULL;
+    int merge = 0;
+    if (primitive == RSX_PRIMITIVE_TRIANGLES && s_d3d.merge_prev_draw && s_d3d.draw_count > 0 &&
+        s_d3d.merge_first_end == first) {
+        D3D12DrawRecord* pv = &s_d3d.draws[s_d3d.draw_count - 1];
+        if (pv->is_vp && pv->is_idx && !pv->is_clear && pv->topology == RSX_TOPOLOGY_TRIANGLES &&
+            pv->fp_addr == st->shader_program && pv->begin_epoch == st->begin_epoch &&
+            pv->ib_start + pv->vertex_count == s_d3d.vp_ib_used) { dr = pv; merge = 1; }
+    }
+    if (!merge) {
+        if (s_d3d.draw_count >= MAX_DRAWS) return;
+        dr = &s_d3d.draws[s_d3d.draw_count];
+        vnew_fill_record(dr, st);
+        /* Vertex layout: what the record's VS reads -- but only when it will
+         * draw through a guest-FP pipeline (keyed on vmask); a record that can
+         * only take the built-in fallback keeps all 16 slots. */
+        static int fpoff = -1; if (fpoff < 0) fpoff = getenv("FP_OFF") ? 1 : 0;
+        u32 mask = 0xFFFFu;
+        if (!fpoff && dr->fp_addr && dr->fp_shash && !fp_prog_failed(dr->fp_shash) &&
+            dr->vs_idx >= 0 && dr->vs_idx < s_d3d.vp_vs_n)
+            mask = s_d3d.vp_vs[dr->vs_idx].in_mask & 0xFFFFu;
+        if (!mask) mask = 1u;   /* reads no attribute: still one slot */
+        u32 n = 0;
+        for (u32 m = mask; m; m &= m - 1u) n++;
+        dr->vmask = mask; dr->vstride = 16u * n;
+        dr->is_idx = 1; dr->ib_start = s_d3d.vp_ib_used; dr->vertex_count = 0;
+        dr->vb_byte_offset = s_d3d.vp_vb_offset;   /* informational */
+        rsx_vdedupe_reset(&s_vdd); s_vdd_sig = 0;  /* a new record's own table */
+    }
+    /* PERF 'vtx' times the vertex work only, as it always did (the record
+     * capture above -- constant bank, FP scan -- was never part of it). */
+    const double t0 = perf_on() ? perf_now() : 0.0;
+    const double ftv0 = FTR_T0_FULL();
+    const u32 emitted = vnew_upload(dr, st, primitive, first, count, indexed);
+    FTR_ADD_FULL(vtx, ftv0);
+    if (perf_on()) { s_perf_vtx += perf_now() - t0; s_perf_nverts += emitted; }
+    s_vn_idx += emitted;
+    if (!emitted) return;
+    dr->vertex_count += emitted;
+    if (!merge) s_d3d.draw_count++;
+    s_d3d.merge_prev_draw = (primitive == RSX_PRIMITIVE_TRIANGLES);
+    s_d3d.merge_first_end = first + count;
+    imm_diag(dr, st, primitive, first, count, indexed, emitted);
+}
