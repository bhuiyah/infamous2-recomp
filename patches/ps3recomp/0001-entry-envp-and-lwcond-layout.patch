+            rd->filt = dr->tex[u].filt; rd->mode = (dr->fp_tkey >> (2u * (u32)u)) & 3u;
+            rd->off = dr->tex[u].raw; rd->w = dr->tex[u].w; rd->h = dr->tex[u].h; rd->fmt = dr->tex[u].fmt;
+            rd->main_mem = dr->tex[u].off && dr->tex[u].off < 0xC0000000u;
+            rd->unnorm = dr->fp_shash && ((dr->fp_tunorm >> u) & 1u);
+            if ((kind == RSX_RCZ_SRC_OFFRT || kind == RSX_RCZ_SRC_DBSNAP) && dr->tex_rt[u] >= 0) {
+                const OffRT* r = &s_d3d.off_rt[dr->tex_rt[u]];
+                rd->off = r->off; rd->w = r->w; rd->h = r->h; rd->fmt = r->rsx_fmt;
             }
-            if (cnt) fprintf(stderr, "[TEXAVG] raw=0x%08X %4ux%-4u fmt=0x%02X"
-                                     " avgRGBA=(%3u,%3u,%3u,%3u) alpha[%u..%u]%c",
-                             key_off, w, h, fmt, (u32)(sr/cnt), (u32)(sg/cnt),
-                             (u32)(sb/cnt), (u32)(sa/cnt), amin, amax, 10);
+            op.nread++;
+        }
+        rsx_rcz_op_feed(&op);
