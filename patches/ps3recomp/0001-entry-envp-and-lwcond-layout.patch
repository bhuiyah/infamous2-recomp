+/*
+ * ps3recomp - PPU continuations: the continuation table, chain validation and
+ * the resume dispatcher (save states, M3). See ppu_resume.h.
+ *
+ * Part of the PPU boot scaffold: a port compiles it beside ppu_loader.cpp
+ * (the game's CMakeLists lists it in PS3RECOMP_SCAFFOLD). The scaffold does
+ * not depend on it -- ppu_loader.cpp / ppu_hle.cpp only call the optional
+ * g_ppu_resume_probe hook, which stays null unless this file installs it --
+ * but a lift made with --cont-list registers its table here, so such a lift
+ * needs this file in the build.
+ *
+ * Diagnostic (off by default):
+ *   PPU_RESUME_CHECK_EVERY=<n>   every n-th HLE call / syscall a guest thread
+ *                                makes, walk its guest chain as a resume would
+ *                                (nothing is resumed) and tally the verdicts;
+ *                                logs the first chains that validate, every
+ *                                return address that has no continuation (in
+ *                                --cont-list form, ready to paste into the
+ *                                list), the first refusals with their chains,
+ *                                and a summary every 10 s and at exit.
+ *   PPU_RESUME_LOG=1             also print the table registrations.
+ *
+ * The regression test (runtime/ppu/tests/test_cont_resume.cpp) #includes this
+ * file after defining PPU_RESUME_HAVE_CONTEXT and its own ppu_context.
+ */
+#ifndef PPU_RESUME_HAVE_CONTEXT
+#  include "ppu_tls.h"      /* PPU_THREAD_LOCAL */
+#  include "ppu_recomp.h"   /* ppu_context, function_table (the generated header) */
+#  define PPU_RESUME_HAVE_FUNCTION_TABLE 1
+#endif
+#include "ppu_resume.h"
+
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <atomic>
+#include <chrono>
+#include <mutex>
+#ifdef _WIN32
+#  ifndef WIN32_LEAN_AND_MEAN
+#    define WIN32_LEAN_AND_MEAN
+#  endif
