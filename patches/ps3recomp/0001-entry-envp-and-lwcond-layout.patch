@@ -0,0 +1,280 @@
+/*
+ * ps3recomp - the options overlay's D3D12 renderer (header-only; included by
+ * libs/video/ovl.c and the WARP test only).
+ *
+ * One root signature (2 root constants + 1 SRV table), one PSO (premultiplied
+ * alpha ONE / INV_SRC_ALPHA, no depth), the R8 glyph atlas and an upload
+ * vertex buffer. It records an ovl_list into any render target view: the
+ * overlay's DirectComposition swap chain (window size, B8G8R8A8), the game's
+ * backbuffer (the fallback host: the list's canvas is the picture's size on
+ * screen and is squeezed into the 1280x720 buffer by the viewport), or an
+ * offscreen texture (tests). Colours blend in UNORM (gamma) space, as GDI's
+ * coverage is meant.
+ */
+#ifndef PS3RECOMP_OVL_GPU_H
+#define PS3RECOMP_OVL_GPU_H
+
+#include <d3d12.h>
+#include <d3dcompiler.h>
+#include <limits.h>
+#include <stdio.h>
+#include "ovl_draw.h"
+
+static const char s_ovl_hlsl[] =
+"cbuffer C : register(b0) { float2 vp; };\n"
+"Texture2D<float> atlas : register(t0);\n"
+"struct VI { float2 pos:POSITION; float2 uv:TEXCOORD0; float2 lc:TEXCOORD1; float2 hs:TEXCOORD2;\n"
+"            float4 col:COLOR; float4 prm:TEXCOORD3; };\n"
+"struct VO { float4 pos:SV_Position; float2 uv:TEXCOORD0; float2 lc:TEXCOORD1;\n"
+"            nointerpolation float2 hs:TEXCOORD2; float4 col:COLOR; nointerpolation float4 prm:TEXCOORD3; };\n"
+"VO vs_main(VI i) { VO o; o.pos = float4(i.pos.x / vp.x * 2 - 1, 1 - i.pos.y / vp.y * 2, 0, 1);\n"
+"  o.uv = i.uv; o.lc = i.lc; o.hs = i.hs; o.col = i.col; o.prm = i.prm; return o; }\n"
+"float sd_rrect(float2 p, float2 b, float r) { r = min(r, min(b.x, b.y));\n"
+"  float2 q = abs(p) - b + r; return length(max(q, 0)) + min(max(q.x, q.y), 0) - r; }\n"
+"float sd_tri(float2 p, float r) { const float k = 1.7320508; p.x = abs(p.x) - r; p.y = p.y + r / k;\n"
+"  if (p.x + k * p.y > 0) p = float2(p.x - k * p.y, -k * p.x - p.y) / 2;\n"
+"  p.x -= clamp(p.x, -2 * r, 0); return -length(p) * sign(p.y); }\n"
+"float4 ps_main(VO i) : SV_Target {\n"
+"  int mode = (int)(i.prm.z + 0.5);\n"
+"  if (mode == 1) return i.col * atlas.Load(int3(int2(floor(i.uv)), 0));\n"
+"  if (mode == 2) { float f = i.prm.w; float d = sd_rrect(i.lc, i.hs - f, i.prm.x);\n"
+"                   return i.col * (1 - smoothstep(-f, f, d)); }\n"
+"  float d;\n"
+"  if (mode == 3) { int dir = (int)(i.prm.w + 0.5); float2 q = i.lc; float2 p;\n"
+"    if (dir == 0) p = float2(q.x, -q.y); else if (dir == 2) p = q;\n"
+"    else if (dir == 1) p = float2(q.y, q.x); else p = float2(q.y, -q.x);\n"
+"    d = sd_tri(p, i.hs.x * 0.86); }\n"
+"  else d = sd_rrect(i.lc, i.hs, i.prm.x);\n"
+"  float a = saturate(0.5 - d);\n"
+"  if (i.prm.y > 0) a *= saturate(0.5 + d + i.prm.y);\n"
+"  return i.col * a; }\n";
+
+typedef struct {
+    ID3D12Device*         dev;
+    ID3D12RootSignature*  rs;
+    ID3D12PipelineState*  pso;
+    ID3D12DescriptorHeap* heap;       /* 1 shader-visible SRV: the atlas */
+    ID3D12Resource*       atlas;
+    int                   atlas_w, atlas_h;
+    ID3D12Resource*       old[8];     /* replaced atlases, released later (a frame may still use one) */
+    int                   nold;
+    ID3D12Resource*       vb;
+    void*                 vb_map;
+    unsigned              vb_bytes;
+} ovl_gpu;
+
+static int ovl_gpu_fail(const char* what, HRESULT hr)
+{
+    printf("[ovl] %s failed 0x%08lX\n", what, (unsigned long)hr);
+    fflush(stdout);
+    return 0;
+}
+
+static inline void ovl_gpu_release(ovl_gpu* G)
+{
+#define OVL_REL(p) do { if (p) { (p)->lpVtbl->Release(p); (p) = NULL; } } while (0)
+    if (G->vb && G->vb_map) G->vb->lpVtbl->Unmap(G->vb, 0, NULL);
+    G->vb_map = NULL;
+    OVL_REL(G->vb); OVL_REL(G->atlas); OVL_REL(G->heap); OVL_REL(G->pso); OVL_REL(G->rs);
+    for (int i = 0; i < G->nold; i++) OVL_REL(G->old[i]);
+    G->nold = 0;
+#undef OVL_REL
+}
+
+static inline int ovl_gpu_vb(ovl_gpu* G, unsigned bytes)
+{
+    if (G->vb && bytes <= G->vb_bytes) return 1;
+    unsigned want = G->vb_bytes ? G->vb_bytes : (2u << 20);
+    while (want < bytes) want *= 2;
+    if (G->vb) { G->vb->lpVtbl->Unmap(G->vb, 0, NULL); G->vb->lpVtbl->Release(G->vb); G->vb = NULL; G->vb_map = NULL; }
+    D3D12_HEAP_PROPERTIES hpu = { D3D12_HEAP_TYPE_UPLOAD };
+    D3D12_RESOURCE_DESC bd; memset(&bd, 0, sizeof bd);
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; bd.Width = want;
+    HRESULT hr = G->dev->lpVtbl->CreateCommittedResource(G->dev, &hpu, D3D12_HEAP_FLAG_NONE, &bd,
+                                                         D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                                                         &IID_ID3D12Resource, (void**)&G->vb);
+    if (FAILED(hr)) { G->vb_bytes = 0; return ovl_gpu_fail("vertex buffer", hr); }
+    G->vb->lpVtbl->Map(G->vb, 0, NULL, &G->vb_map);
+    G->vb_bytes = want;
+    return G->vb_map != NULL;
+}
+
+static inline int ovl_gpu_init(ovl_gpu* G, ID3D12Device* dev, DXGI_FORMAT rtfmt)
+{
+    memset(G, 0, sizeof *G);
+    G->dev = dev;
+    ID3DBlob *vs = NULL, *ps = NULL, *err = NULL, *sig = NULL;
+    HRESULT hr = D3DCompile(s_ovl_hlsl, sizeof s_ovl_hlsl - 1, "ovl", NULL, NULL, "vs_main", "vs_5_0", 0, 0, &vs, &err);
+    if (FAILED(hr)) { if (err) printf("%s\n", (const char*)err->lpVtbl->GetBufferPointer(err)); return ovl_gpu_fail("D3DCompile vs", hr); }
+    hr = D3DCompile(s_ovl_hlsl, sizeof s_ovl_hlsl - 1, "ovl", NULL, NULL, "ps_main", "ps_5_0", 0, 0, &ps, &err);
+    if (FAILED(hr)) { if (err) printf("%s\n", (const char*)err->lpVtbl->GetBufferPointer(err)); vs->lpVtbl->Release(vs); return ovl_gpu_fail("D3DCompile ps", hr); }
+
+    D3D12_DESCRIPTOR_RANGE range = { D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 0, 0, 0 };
+    D3D12_ROOT_PARAMETER rp[2]; memset(rp, 0, sizeof rp);
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[0].Constants.ShaderRegister = 0; rp[0].Constants.Num32BitValues = 2;
+    rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    rp[1].DescriptorTable.NumDescriptorRanges = 1; rp[1].DescriptorTable.pDescriptorRanges = &range;
+    rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC rd = { 2, rp, 0, NULL, D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT };
+    hr = D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+    if (SUCCEEDED(hr)) {
+        hr = dev->lpVtbl->CreateRootSignature(dev, 0, sig->lpVtbl->GetBufferPointer(sig), sig->lpVtbl->GetBufferSize(sig),
+                                              &IID_ID3D12RootSignature, (void**)&G->rs);
+        sig->lpVtbl->Release(sig);
+    }
+    if (FAILED(hr)) { vs->lpVtbl->Release(vs); ps->lpVtbl->Release(ps); return ovl_gpu_fail("root signature", hr); }
+
+    D3D12_INPUT_ELEMENT_DESC il[] = {
+        { "POSITION", 0, DXGI_FORMAT_R32G32_FLOAT,       0, 0,  D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT,       0, 8,  D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 1, DXGI_FORMAT_R32G32_FLOAT,       0, 16, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 2, DXGI_FORMAT_R32G32_FLOAT,       0, 24, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+        { "COLOR",    0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 32, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+        { "TEXCOORD", 3, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 48, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0 },
+    };
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd; memset(&pd, 0, sizeof pd);
+    pd.pRootSignature = G->rs;
+    pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs); pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+    pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps); pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    pd.InputLayout.pInputElementDescs = il; pd.InputLayout.NumElements = 6;
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID; pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    D3D12_RENDER_TARGET_BLEND_DESC* b = &pd.BlendState.RenderTarget[0];
+    b->BlendEnable = TRUE;
+    b->SrcBlend = D3D12_BLEND_ONE; b->DestBlend = D3D12_BLEND_INV_SRC_ALPHA; b->BlendOp = D3D12_BLEND_OP_ADD;
+    b->SrcBlendAlpha = D3D12_BLEND_ONE; b->DestBlendAlpha = D3D12_BLEND_INV_SRC_ALPHA; b->BlendOpAlpha = D3D12_BLEND_OP_ADD;
+    b->RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = UINT_MAX;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1; pd.RTVFormats[0] = rtfmt; pd.SampleDesc.Count = 1;
+    hr = dev->lpVtbl->CreateGraphicsPipelineState(dev, &pd, &IID_ID3D12PipelineState, (void**)&G->pso);
+    vs->lpVtbl->Release(vs); ps->lpVtbl->Release(ps);
+    if (FAILED(hr)) return ovl_gpu_fail("pipeline state", hr);
+
+    D3D12_DESCRIPTOR_HEAP_DESC hd = { D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV, 1, D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE, 0 };
+    hr = dev->lpVtbl->CreateDescriptorHeap(dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&G->heap);
+    if (FAILED(hr)) return ovl_gpu_fail("descriptor heap", hr);
+    return ovl_gpu_vb(G, 2u << 20);
+}
+
+/* Upload a new atlas on queue q and wait for it (a few ms, on the caller's
+ * thread -- the overlay's own). The previous atlas is kept until later. */
+static inline int ovl_gpu_set_atlas(ovl_gpu* G, const ovl_font* F, ID3D12CommandQueue* q)
+{
+    ID3D12Device* dev = G->dev;
+    ID3D12Resource *tex = NULL, *up = NULL;
+    ID3D12CommandAllocator* al = NULL;
+    ID3D12GraphicsCommandList* cl = NULL;
+    ID3D12Fence* fe = NULL;
+    HANDLE ev = NULL;
+    int ok = 0;
+    D3D12_HEAP_PROPERTIES hpd = { D3D12_HEAP_TYPE_DEFAULT }, hpu = { D3D12_HEAP_TYPE_UPLOAD };
+    D3D12_RESOURCE_DESC td; memset(&td, 0, sizeof td);
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; td.Width = (UINT64)F->w; td.Height = (UINT)F->h;
+    td.DepthOrArraySize = 1; td.MipLevels = 1; td.Format = DXGI_FORMAT_R8_UNORM; td.SampleDesc.Count = 1;
+    const unsigned pitch = (unsigned)((F->w + 255) & ~255);
+    D3D12_RESOURCE_DESC bd; memset(&bd, 0, sizeof bd);
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; bd.Width = (UINT64)pitch * F->h;
+    if (FAILED(dev->lpVtbl->CreateCommittedResource(dev, &hpd, D3D12_HEAP_FLAG_NONE, &td, D3D12_RESOURCE_STATE_COPY_DEST,
+                                                    NULL, &IID_ID3D12Resource, (void**)&tex)) ||
+        FAILED(dev->lpVtbl->CreateCommittedResource(dev, &hpu, D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ,
+                                                    NULL, &IID_ID3D12Resource, (void**)&up)) ||
+        FAILED(dev->lpVtbl->CreateCommandAllocator(dev, D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator, (void**)&al)) ||
+        FAILED(dev->lpVtbl->CreateCommandList(dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, al, NULL,
+                                              &IID_ID3D12GraphicsCommandList, (void**)&cl)) ||
+        FAILED(dev->lpVtbl->CreateFence(dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&fe)) ||
+        !(ev = CreateEventA(NULL, FALSE, FALSE, NULL))) {
+        ovl_gpu_fail("atlas resources", E_FAIL);
+        goto done;
+    }
+    {
+        unsigned char* m = NULL;
+        up->lpVtbl->Map(up, 0, NULL, (void**)&m);
+        if (!m) goto done;
+        for (int y = 0; y < F->h; y++) memcpy(m + (size_t)y * pitch, F->pix + (size_t)y * F->w, (size_t)F->w);
+        up->lpVtbl->Unmap(up, 0, NULL);
+        D3D12_TEXTURE_COPY_LOCATION dst, src;
+        memset(&dst, 0, sizeof dst); memset(&src, 0, sizeof src);
+        dst.pResource = tex; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        src.pResource = up; src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        src.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8_UNORM;
+        src.PlacedFootprint.Footprint.Width = (UINT)F->w; src.PlacedFootprint.Footprint.Height = (UINT)F->h;
+        src.PlacedFootprint.Footprint.Depth = 1; src.PlacedFootprint.Footprint.RowPitch = pitch;
+        cl->lpVtbl->CopyTextureRegion(cl, &dst, 0, 0, 0, &src, NULL);
+        D3D12_RESOURCE_BARRIER br; memset(&br, 0, sizeof br);
+        br.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; br.Transition.pResource = tex;
+        br.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        br.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+        br.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        cl->lpVtbl->ResourceBarrier(cl, 1, &br);
+        cl->lpVtbl->Close(cl);
+        q->lpVtbl->ExecuteCommandLists(q, 1, (ID3D12CommandList**)&cl);
+        q->lpVtbl->Signal(q, fe, 1);
+        if (fe->lpVtbl->GetCompletedValue(fe) < 1) {
+            fe->lpVtbl->SetEventOnCompletion(fe, 1, ev);
+            WaitForSingleObject(ev, 5000);
+        }
+    }
+    if (G->atlas) {
+        if (G->nold == 8) { G->old[0]->lpVtbl->Release(G->old[0]); memmove(G->old, G->old + 1, 7 * sizeof G->old[0]); G->nold = 7; }
+        G->old[G->nold++] = G->atlas;
+    }
+    G->atlas = tex; tex = NULL;
+    G->atlas_w = F->w; G->atlas_h = F->h;
+    {
+        D3D12_SHADER_RESOURCE_VIEW_DESC sd; memset(&sd, 0, sizeof sd);
+        sd.Format = DXGI_FORMAT_R8_UNORM; sd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING; sd.Texture2D.MipLevels = 1;
+        D3D12_CPU_DESCRIPTOR_HANDLE ch; G->heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(G->heap, &ch);
+        dev->lpVtbl->CreateShaderResourceView(dev, G->atlas, &sd, ch);
+    }
+    ok = 1;
+done:
+    if (tex) tex->lpVtbl->Release(tex);
+    if (up) up->lpVtbl->Release(up);
+    if (cl) cl->lpVtbl->Release(cl);
+    if (al) al->lpVtbl->Release(al);
+    if (fe) fe->lpVtbl->Release(fe);
+    if (ev) CloseHandle(ev);
+    return ok;
+}
+
+/* Record L into rtv (target in RENDER_TARGET state). The list's canvas (L->W x
+ * L->H) maps onto the viewport rectangle (vx, vy, vw, vh) of the target. The
+ * vertex buffer is rewritten: the previous recording must have executed. */
+static inline void ovl_gpu_record(ovl_gpu* G, ID3D12GraphicsCommandList* cl, const ovl_list* L,
+                                  D3D12_CPU_DESCRIPTOR_HANDLE rtv, float vx, float vy, float vw, float vh)
+{
+    if (!G->atlas || !L->nv || !L->W || !L->H) return;
+    unsigned bytes = L->nv * (unsigned)sizeof(ovl_vtx);
+    if (!ovl_gpu_vb(G, bytes)) return;
+    memcpy(G->vb_map, L->v, bytes);
+    D3D12_VERTEX_BUFFER_VIEW vbv = { G->vb->lpVtbl->GetGPUVirtualAddress(G->vb), bytes, (UINT)sizeof(ovl_vtx) };
+    float vp[2] = { (float)L->W, (float)L->H };
+    cl->lpVtbl->SetGraphicsRootSignature(cl, G->rs);
+    cl->lpVtbl->SetPipelineState(cl, G->pso);
+    cl->lpVtbl->SetDescriptorHeaps(cl, 1, &G->heap);
+    D3D12_GPU_DESCRIPTOR_HANDLE gh; G->heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(G->heap, &gh);
+    cl->lpVtbl->SetGraphicsRoot32BitConstants(cl, 0, 2, vp, 0);
+    cl->lpVtbl->SetGraphicsRootDescriptorTable(cl, 1, gh);
+    cl->lpVtbl->OMSetRenderTargets(cl, 1, &rtv, FALSE, NULL);
+    D3D12_VIEWPORT v = { vx, vy, vw, vh, 0, 1 };
+    cl->lpVtbl->RSSetViewports(cl, 1, &v);
+    cl->lpVtbl->IASetPrimitiveTopology(cl, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    cl->lpVtbl->IASetVertexBuffers(cl, 0, 1, &vbv);
+    const float sx = vw / (float)L->W, sy = vh / (float)L->H;
+    for (int i = 0; i < L->ncmd; i++) {
+        const ovl_cmd* c = &L->cmd[i];
+        if (!c->count) continue;
+        D3D12_RECT sc = { (LONG)floorf(vx + c->x0 * sx), (LONG)floorf(vy + c->y0 * sy),
+                          (LONG)ceilf(vx + c->x1 * sx), (LONG)ceilf(vy + c->y1 * sy) };
+        cl->lpVtbl->RSSetScissorRects(cl, 1, &sc);
+        cl->lpVtbl->DrawInstanced(cl, c->count, 1, c->first, 0);
+    }
+}
+
+#endif /* PS3RECOMP_OVL_GPU_H */
diff --git a/libs/video/ovl_menu.c b/libs/video/ovl_menu.c
