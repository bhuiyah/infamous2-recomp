+/* FRAME_LIMIT=<hz> | auto[:<min hz>] | off (default off: flips are paced as
+ * before, by FPS_CAP and vsync alone; unset, the settings store's frame_pacing row is read).
+ * An even frame rate on a fixed-refresh display.
+ * The guest's flip request -- inFamous 2 times its frame with mftb right after
+ * it (func_00085014), so this is the game's dt -- is released on the display's
+ * own vblank grid (DwmGetCompositionTimingInfo: the last vblank and the refresh
+ * period, re-read every flip), once every k vblanks, 0.5 ms after the vblank;
+ * the backend then presents with sync interval k from a frame-latency waitable
+ * swap chain that queues at most one frame (rsx_d3d12_backend.c,
+ * PRESENT_LATENCY). Every frame's dt is exactly k refresh periods, every frame
+ * stays on screen for k vblanks, and nothing piles up in the present queue
+ * between the game and the display (input lag). A rate within 0.5% of
+ * refresh/k picks that k: 75, 37.5, 25 on a 75 Hz display. Any other
+ * rate (60 on 75 Hz) is a plain QPC cadence, which a fixed-refresh display can
+ * only show as a mix of 1- and 2-vblank frames (said once in the log; even
+ * only with VRR). auto: k = the fewest vblanks the guest's frame fits with a
+ * 1.5 ms margin, 1..3 (auto:<min hz>: down to refresh/k >= min hz, e.g. auto:30
+ * = 75 or 37.5 on 75 Hz): one step up at once when 2 of the last 10 frames
+ * missed k, one step down after 150 frames in a row that fitted k-1. A frame
+ * that misses its vblank is released at the next one (dt one period longer,
+ * as the display shows it; no catch-up burst). The pacer only ever waits.
+ * FRAME_LIMIT_LOG=1: [pace] lines once a second (k, misses, waits). */
+volatile int g_pace_k;                   /* vblanks per frame now (0: not vblank-locked) */
+static int    s_pace_mode = -1;          /* -1 unparsed, 0 off, 1 fixed rate, 2 auto */
+static double s_pace_hz;                 /* fixed: the rate; auto: the lowest rate (0: k <= 3) */
+static void pace_parse(void)
+{
+    if (s_pace_mode >= 0) return;
+    s_pace_mode = 0;
+    const char* e = getenv("FRAME_LIMIT");
+    static char sv[32];
+    if (!e || !*e) {                     /* the settings store's frame_pacing (options menu; restart) */
+        const opt_id id = opt_find("frame_pacing");
+        if (id >= 0 && opt_text(id, sv, sizeof sv) > 0) e = sv;
+    }
+    if (!e || !*e || !strcmp(e, "off") || !strcmp(e, "0")) return;
+    char* end = NULL;
+    if (!strncmp(e, "auto", 4) && (!e[4] || e[4] == ':')) {
+        const double m = e[4] ? strtod(e + 5, &end) : 0.0;
+        if (e[4] && (end == e + 5 || *end || m < 1.0 || m > 1000.0)) {
+            fprintf(stderr, "[pace] FRAME_LIMIT=%s: auto:<min hz> wants a rate in 1..1000; auto%c", e, 10);
+            s_pace_hz = 0.0;
+        } else s_pace_hz = m;
+        s_pace_mode = 2;
+        return;
+    }
+    const double v = strtod(e, &end);
+    if (end == e || *end || v < 1.0 || v > 1000.0) {
+        fprintf(stderr, "[pace] FRAME_LIMIT=%s is not off | auto[:<min hz>] | <hz>: off%c", e, 10);
+        return;
+    }
+    s_pace_hz = v; s_pace_mode = 1;
+}
+/* The backend asks at swap-chain creation (one queued frame when pacing). */
+int cellGcm_frame_limit_on(void) { pace_parse(); return s_pace_mode > 0; }
+
+#ifdef _WIN32
+#include <dwmapi.h>
+typedef HRESULT (WINAPI *pace_dwm_fn)(HWND, DWM_TIMING_INFO*);
+/* The last vblank and the refresh period (QPC ticks); 0 when DWM has none. */
+static int pace_vblank(LONGLONG* vb, LONGLONG* per)
+{
+    static pace_dwm_fn fn; static int tried;
+    if (!tried) {
+        tried = 1;
+        HMODULE m = LoadLibraryA("dwmapi.dll");
+        if (m) fn = (pace_dwm_fn)(void*)GetProcAddress(m, "DwmGetCompositionTimingInfo");
+    }
+    if (!fn) return 0;
+    DWM_TIMING_INFO ti; memset(&ti, 0, sizeof ti); ti.cbSize = sizeof ti;
+    if (FAILED(fn(NULL, &ti)) || !ti.qpcRefreshPeriod || !ti.qpcVBlank) return 0;
+    *vb = (LONGLONG)ti.qpcVBlank; *per = (LONGLONG)ti.qpcRefreshPeriod;
+    return 1;
+}
+#endif
