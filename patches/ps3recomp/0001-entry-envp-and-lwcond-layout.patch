+    const u32 x_hi = cx1 <= out_x ? 0u : (cx1 - out_x < out_w ? cx1 - out_x : out_w);
+    const u32 y_lo = cy0 > out_y ? cy0 - out_y : 0u;
+    const u32 y_hi = cy1 <= out_y ? 0u : (cy1 - out_y < out_h ? cy1 - out_y : out_h);
