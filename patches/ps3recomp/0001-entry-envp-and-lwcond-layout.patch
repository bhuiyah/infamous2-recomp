+/* ---------------------------------------------------------------------------
+ * Save states: cellMsgDialog's part of the MISC section (runtime/savestate/
+ * ss_state.h), written by cellSysmodule.c, which registers the section: an
+ * open dialog (a progress bar, or a no-button notice under
+ * MSGDIALOG_NOBUTTON_WAITS) -- its type, callback (OPD) and userdata, the
+ * progress bars -- and the no-button deadline as the time left (0: not
+ * armed), a relative value a load adds to its own clock. A dialog already
+ * answered is not here: its callback is a completion in SUTL.
+ * -----------------------------------------------------------------------*/
+static uint32_t s_ss_callback, s_ss_userdata;    /* capture scratch: the guest values */
