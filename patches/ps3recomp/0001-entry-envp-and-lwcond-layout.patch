+static void test_mouse_small_motion(void)
+{
+    KbmConfig c;
+    kbm_config_defaults(&c);                           /* anti-deadzone 0.20 */
+    KbmRuntime rt;
+    KbmOut o;
+    kbm_runtime_reset(&rt);
+    keys_clear();
+    kbm_eval(&c, &rt, fake_down, NULL, 0.0, 0, 0, 0, &o);
+    kbm_eval(&c, &rt, fake_down, NULL, 16.0, 1, 0, 0, &o);      /* a single count */
+    CHECK(kbm_axis_u8(o.rx) >= kbm_axis_u8(0.20f));             /* past the game's deadzone */
+    CHECK(kbm_axis_u8(o.rx) <= kbm_axis_u8(0.21f));             /* but barely */
+    CHECK(o.r_active);
+    kbm_eval(&c, &rt, fake_down, NULL, 32.0, 0, -1, 0, &o);     /* up, a count */
+    CHECK(o.ry < 0.0f);
+    /* with no anti-deadzone a single count is a tiny deflection */
+    c.anti_deadzone = 0.0f;
+    kbm_runtime_reset(&rt);
+    kbm_eval(&c, &rt, fake_down, NULL, 0.0, 0, 0, 0, &o);
+    kbm_eval(&c, &rt, fake_down, NULL, 16.0, 1, 0, 0, &o);
+    CHECK(o.rx > 0.0f && o.rx < 0.02f);
+    /* curve < 1 lifts small deflections, keeps full ones */
+    c.curve = 0.5f;
+    kbm_runtime_reset(&rt);
+    kbm_eval(&c, &rt, fake_down, NULL, 0.0, 0, 0, 0, &o);
+    kbm_eval(&c, &rt, fake_down, NULL, 16.0, 1, 0, 0, &o);
+    CHECK(o.rx > 0.1f);
+    Run r = mouse_run(&c, 16.0, 10, 24, 0, 0);
+    CHECK_EQ(r.last_rx, 255);
+}
