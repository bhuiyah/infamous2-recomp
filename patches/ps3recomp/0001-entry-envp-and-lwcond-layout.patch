+        CHECK(wait_state(0, 0, 100), "port 0 free again");
+        InterlockedExchange(&s_cfg.backends, obk);
+        InterlockedExchange(&s_cfg.enabled, oe);
+        s_x.get = og; s_x.set = os; s_x.batt = ob; s_x.caps_ex = oc;
+    }
+
+    /* rumble: a number is a percentage, only the words mean on/off */
+    CHECK(padhost_config_set("rumble", "1") == 1 && s_cfg.rumble_pct == 1, "rumble=1 is 1 %% (%ld)", s_cfg.rumble_pct);
+    CHECK(padhost_config_set("rumble", "yes") == 1 && s_cfg.rumble_pct == 100, "rumble=yes");
+    CHECK(padhost_config_set("rumble", "0") == 1 && s_cfg.rumble_pct == 0, "rumble=0");
+    CHECK(padhost_config_set("rumble", "true") == 1 && s_cfg.rumble_pct == 100, "rumble=true");
+
+    /* a section is ours when its name starts with controller / gamepad (pad_kbm.h's test) */
+    int bad = padhost_config_parse_text("[Controller settings]\nrumble = 40\n[keyboard]\nrumble = 90\n", 0, warn_collect);
+    CHECK(bad == 0 && s_cfg.rumble_pct == 40, "[Controller settings] is ours (bad %d, rumble %ld)", bad, s_cfg.rumble_pct);
+    bad = padhost_config_parse_text("[Gamepads]\nrumble = 60\n", 0, warn_collect);
+    CHECK(bad == 0 && s_cfg.rumble_pct == 60, "[Gamepads]");
+    bad = padhost_config_parse_text("[pads]\nrumble = 70\n", 0, warn_collect);
