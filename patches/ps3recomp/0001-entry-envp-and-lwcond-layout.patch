+/* ------------------------------------------------------------------------ */
+/* Guest memory reads that cannot fault                                      */
+/* ------------------------------------------------------------------------ */
+static int guest_copy(uint32_t ea, void* out, unsigned n)
+{
+    if (ea < 0x10000u) return 0;
+    const uint64_t lim = ppu_vm_size ? (uint64_t)ppu_vm_size : 0x100000000ull;
+    if ((uint64_t)ea + n > lim || !vm_base) return 0;
+#ifdef _WIN32
+    __try { memcpy(out, vm_base + ea, n); }
+    __except (EXCEPTION_EXECUTE_HANDLER) { return 0; }
+#else
+    memcpy(out, vm_base + ea, n);
+#endif
+    return 1;
+}
+
+static int rd64(uint32_t ea, uint64_t* v)
+{
+    uint8_t b[8];
+    if (!guest_copy(ea, b, 8)) return 0;
+    uint64_t x = 0;
+    for (int i = 0; i < 8; i++) x = (x << 8) | b[i];
+    *v = x;
+    return 1;
+}
+
+static int rd32(uint32_t ea, uint32_t* v)
+{
+    uint8_t b[4];
+    if (!guest_copy(ea, b, 4)) return 0;
+    *v = ((uint32_t)b[0] << 24) | ((uint32_t)b[1] << 16) | ((uint32_t)b[2] << 8) | b[3];
+    return 1;
+}
