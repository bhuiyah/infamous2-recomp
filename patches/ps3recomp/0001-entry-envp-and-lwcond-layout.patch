+static void test_lin(void)
+{
+    CHECK(!rsx_up_linear(1, 1280, 720, 2560, 1080), "lin.upscale gamma space");
+    CHECK(rsx_up_linear(1, 2560, 1440, 2560, 1080), "lin.one axis shrinks");
+    CHECK(rsx_up_linear(1, 3840, 2160, 2560, 1080), "lin.downsample");
