+static int decl_open(PadHostDevice* d) { (void)d; return PADHOST_OPEN_DECLINED; }
+static const PadHostDriver decl_drv = { "decline", PADHOST_KIND_GENERIC, stub_match, decl_open, stub_parse, stub_build, stub_close };
+static const PadHostDriver stub_ds_drv = { "stub-ds", PADHOST_KIND_DUALSENSE, stub_match, stub_open, stub_parse, stub_build, stub_close };
+
+static int vprep(const PadHostDriver* drv, const char* serial, u16 usage)
+{
+    int id = padhost_virtual_prepare(drv, PADHOST_BUS_USB, drv == &stub_ds_drv ? 0x054C : 0x044F,
+                                     drv == &stub_ds_drv ? 0x0CE6 : 0xB10A, serial, 64, 64);
+    if (id < 0) return -1;
+    PhDev* d = ph_virt_get(id);
+    if (d) d->pub.usage = usage;
+    return padhost_virtual_start(id) == 0 ? id : -1;
+}
+
+static PhKnown ph_known_copy(const char* path, int* found)
+{
+    PhKnown k;
+    memset(&k, 0, sizeof k);
+    AcquireSRWLockShared(&s_lock);
+    PhKnown* f = ph_known_find(path);
+    if (f) k = *f;
+    ReleaseSRWLockShared(&s_lock);
+    *found = f != NULL;
+    return k;
+}
+
+static void known_drop(const char* needle)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    int w = 0;
+    for (int i = 0; i < s_nknown; i++)
+        if (!strstr(s_known[i].path, needle)) s_known[w++] = s_known[i];
+    s_nknown = w;
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+static PhDev* pipe_device_drv(const PadHostDriver* drv, const char* pipename, HANDLE* srv_out, const char* fake_path)
+{
+    HANDLE srv = CreateNamedPipeA(pipename, PIPE_ACCESS_DUPLEX, PIPE_TYPE_MESSAGE | PIPE_READMODE_MESSAGE | PIPE_WAIT,
+                                  1, 4096, 4096, 0, NULL);
+    HANDLE cli = CreateFileA(pipename, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+    if (srv == INVALID_HANDLE_VALUE || cli == INVALID_HANDLE_VALUE) return NULL;
+    DWORD mode = PIPE_READMODE_MESSAGE;
+    SetNamedPipeHandleState(cli, &mode, NULL, NULL);
+    PhDev* d = ph_dev_new(drv, 64);
+    d->pub.handle = cli;
+    d->can_write = 1;
+    d->pub.bus = PADHOST_BUS_USB; d->pub.vid = 0x1234; d->pub.pid = 0x9999;
+    d->pub.usage_page = 1; d->pub.usage = 5;
+    d->pub.in_len = 64; d->pub.out_len = 4; d->pub.feat_len = 8;
+    snprintf(d->pathbuf, sizeof d->pathbuf, "%s", fake_path);
+    snprintf(d->pub.name, sizeof d->pub.name, "pipe pad");
+    AcquireSRWLockExclusive(&s_lock);
+    ph_dev_add(d);
+    ReleaseSRWLockExclusive(&s_lock);
+    ph_watch_handle(d);                             /* a pipe has no device node: stays unregistered */
+    ph_dev_start(d);
+    *srv_out = srv;
+    return d;
+}
