+/* Save states (KOBJ, M4b; engine design 4.2): the title creates no sys_mutex,
+ * so the section saves none and asserts the table empty -- a save waits while
+ * one is live. Returns the live count, naming the first in why. Unlocked read
+ * (ppu_sysprx.cpp calls it with every guest thread parked). */
+int sys_mutex_ss_live(char* why, size_t n)
+{
+    int live = 0, first = -1;
+    for (int i = 0; i < SYS_MUTEX_MAX; i++)
+        if (g_sys_mutexes[i].active) { if (first < 0) first = i; live++; }
