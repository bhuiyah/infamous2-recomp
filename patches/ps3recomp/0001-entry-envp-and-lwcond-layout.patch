+int edat_license_check(const char* host_path, const uint8_t klic[16], char* content_id, size_t cap)
+{
+    if (content_id && cap) content_id[0] = 0;
+    FILE* f = fopen(host_path, "rb");
+    if (!f) return -1;
+    uint8_t hdr[0x100];
+    size_t n = fread(hdr, 1, sizeof hdr, f);
+    fclose(f);
+    if (n < 0x80) return -1;
+    if (!(hdr[0] == 'N' && hdr[1] == 'P' && hdr[2] == 'D' && hdr[3] == 0)) return 1;
+    if (content_id && cap) {
+        size_t k = 0;
+        for (; k + 1 < cap && k < 0x30 && hdr[0x10 + k]; k++) content_id[k] = (char)hdr[0x10 + k];
+        content_id[k] = 0;
+    }
+    if (n >= 0x90 && (be32(hdr + 0x80) & SDAT_FLAG)) return 0;      /* SDAT: keyed by its own header */
+    /* The header is authenticated by CMAC(klicensee ^ NP_OMAC_KEY_2) over its first 0x60 bytes. */
+    uint8_t ck[16], mac[16];
+    for (int i = 0; i < 16; i++) ck[i] = (uint8_t)(klic[i] ^ NP_OMAC_KEY_2[i]);
+    aes128_cmac(ck, hdr, 0x60, mac);
+    if (memcmp(mac, hdr + 0x60, 16) != 0) return -2;
+    if ((be32(hdr + 0x08) & 3) == 3) return 0;                      /* free content: the klicensee is the key */
+    uint8_t rif[16];
+    return edat_rif_key(host_path, rif) ? 0 : -3;
+}
