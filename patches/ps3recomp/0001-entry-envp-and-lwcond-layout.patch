+static void check_round_trip(const ss_image* img)
+{
+    ss_reader r;
+    CHECK(ss_reader_open(&r, img, FOURCC_A) == SS_OK, "no FAKA");
+    const int ai = a_int;
+    const double ad = a_dbl;
+    a_int = 0; a_dbl = 0; memset(a_name, 0, sizeof a_name); memset(a_arr, 0, sizeof a_arr);
+    CHECK(ss_read_fields(&r, &k_a_list) == SS_OK, "read FAKA: %s", ss_reader_what(&r));
+    CHECK(a_int == ai && a_dbl == ad && !strcmp(a_name, "kernel-a") && a_arr[3] == 0xDEADBEEFCAFEull,
+          "FAKA statics back: %d %f '%s' %llx", a_int, a_dbl, a_name, (unsigned long long)a_arr[3]);
+    ss_recs_it it;
+    CHECK(ss_recs_open(&r, &k_obj_list, &it) == SS_OK && it.count == 3, "objects: %s count %u", ss_reader_what(&r),
+          it.count);
+    obj o;
+    uint32_t key;
+    int seen = 0;
+    for (;;) {
+        memset(&o, 0, sizeof o);
+        o.host = (void*)&o;                               /* not in the list: must stay */
+        if (ss_recs_next(&it, &key, &o) != 1) break;
+        const obj* src = NULL;
+        for (int i = 0; i < 8; i++) if (g_objs[i].used && g_objs[i].id == key) src = &g_objs[i];
+        CHECK(src && o.id == src->id && o.value == src->value && !strcmp(o.tag, src->tag) && o.host == (void*)&o &&
+              o.used == 0, "object %u back wrong (host %p)", key, o.host);
+        seen++;
+    }
+    CHECK(seen == 3, "objects: %d seen", seen);
+    CHECK(ss_reader_open(&r, img, FOURCC_B) == SS_OK, "no FAKB");
+    uint8_t ring[3000];
+    uint64_t n = 0;
+    CHECK(ss_read_blob(&r, "ring", ring, sizeof ring, &n) == SS_OK && n == 3000 && !memcmp(ring, g_ring, 3000),
+          "ring back: %s", ss_reader_what(&r));
+    uint8_t shortbuf[100];
+    CHECK(ss_read_blob(&r, "ring", shortbuf, sizeof shortbuf, &n) == SS_E_SIZE && n == 3000,
+          "a short buffer not refused");
+    uint64_t v = 0;
+    CHECK(ss_read_u64(&r, "head", &v) == SS_OK && v == 1234567890123ull, "u64 head: %llu", (unsigned long long)v);
+    const char* t = NULL;
+    CHECK(ss_find_text(&r, "log", &t, &n) == SS_OK && n == 17 && !memcmp(t, "hello 42 world x\n", 17),
+          "text: %.*s", (int)n, t ? t : "");
+    ss_rec rec;
+    CHECK(ss_rec_find(&r, SS_FOURCC('X', 'Y', 'Z', 'W'), "custom", &rec) == SS_OK && rec.len == 3 &&
+          !memcmp(rec.data, "abc", 3), "tlv");
+    CHECK(ss_rec_find(&r, SS_REC_BLOB, "nope", &rec) == SS_E_NOT_FOUND, "a missing record found");
+    ss_time_info ti;
+    CHECK(ss_time_read(img, &ti) == SS_OK && ti.guest_tb == fake_tb() && ti.tb_freq == 79800000ull &&
+          ti.guest_ns == 5000100000ull && ti.flip_count == 1234 && ti.play_ms == 98765 &&
+          ti.unix_ms == 1792512191000ull, "TIME: tb %llu ns %llu flips %u play %llu", (unsigned long long)ti.guest_tb,
+          (unsigned long long)ti.guest_ns, ti.flip_count, (unsigned long long)ti.play_ms);
+    typedef struct anc { char name[32]; uint64_t value; } anc;
+    static const ss_field k_af[] = { SS_MEMBER(anc, name), SS_MEMBER(anc, value) };
+    static const ss_list k_al = SS_LIST("anchors", k_af);
+    CHECK(ss_reader_open(&r, img, SS_FOURCC('T', 'I', 'M', 'E')) == SS_OK && ss_recs_open(&r, &k_al, &it) == SS_OK &&
+          it.count == 1, "anchors: %s", ss_reader_what(&r));
+    anc a;
+    CHECK(ss_recs_next(&it, NULL, &a) == 1 && !strcmp(a.name, "test.anchor") && a.value == 0xC0FFEEull, "anchor back");
+    /* TIME's host instant is the one every later section was handed (FAKA's,
+     * 300 orders later): one instant for every time source in the image */
+    typedef struct hst { uint64_t qpc, qpc_freq; } hst;
+    static const ss_field k_hf[] = { SS_MEMBER(hst, qpc), SS_MEMBER(hst, qpc_freq) };   /* (no NO_RESTORE: read back) */
+    static const ss_list k_hl = SS_LIST("host", k_hf);
+    hst hq = { 0, 0 };
+    CHECK(ss_read_fields_at(&r, &k_hl, &hq) == SS_OK && hq.qpc && hq.qpc == g_a_qpc && hq.qpc_freq,
+          "TIME host.qpc %llu, FAKA saw %llu (%s)", (unsigned long long)hq.qpc, (unsigned long long)g_a_qpc,
+          ss_reader_what(&r));
+    uint64_t cur = 0;
+    int nrec = 0;
+    while (ss_rec_next(&r, &cur, &rec) == 1) nrec++;
+    CHECK(nrec == 3, "TIME: %d records", nrec);
+}
