+/* An lwmutex's host semaphore (count 1 = free): 1 if taken. */
+static int lwm_ss_taken(HANDLE s)
+{
+    if (!s) return 0;
+    if (WaitForSingleObject(s, 0) != WAIT_OBJECT_0) return 1;   /* count 0 */
+    ReleaseSemaphore(s, 1, NULL);               /* it was free: give the token back */
