+def _rc_windows(stmts: list, out_items: list, succ: list) -> dict:
+    """Speculative windows (see spu_helpers.h): {first statement index: the
+    window's lines, other member index: None}. A run is a maximal sequence of
+    consecutive window statements (_rc_win_stmt) with no label between them,
+    on a cycle of the statement graph (windows outside loops would double the
+    code for one pass each). Statements that sync with ctx->gpr
+    (written-through registers, r0) are not plain assignments and end a run.
+    Then, measured on inFamous 2's hot loops (Zen 5):
+      - a run with fewer than SPU_LIFT_WIN_BIG (default 64) float ops is split
+        at its estimate ops (frest/frsqest/fi: table lookups with no test to
+        defer), which run between the windows: kept inside, they made the
+        Newton-step loop of jobmod_c6e7383dc013 at 0x7300 7% slower than with
+        no windows (split there: 5% faster), while splitting the few huge
+        windows of the plugins (80+ float ops) costs them 3-6%;
+      - a window ends at its last float op, float compare or float->int
+        conversion: the statements after it have no test to defer and only
+        lengthen the time the replay's inputs stay live (plug_00820400's hot
+        loop: -23% instead of -20%);
+      - it must still hold SPU_LIFT_WIN_MIN (default 4) float ops."""
+    if os.environ.get("SPU_LIFT_WINDOWS", "1") in ("", "0"):
+        return {}
+    minf = int(os.environ.get("SPU_LIFT_WIN_MIN", "4"))
+    big = int(os.environ.get("SPU_LIFT_WIN_BIG", "64"))
+    cyc = _rc_cyclic(succ)
+    runs, cur = [], []
+    for kind, v in out_items:
+        p = None if kind == "L" else _rc_win_stmt(stmts[v].text)
+        if p is not None and cyc[v] and not stmts[v].flush and not stmts[v].reload:
+            cur.append((v, p))
+            continue
+        if cur:
+            runs.append(cur)
+        cur = []
+    if cur:
+        runs.append(cur)
+
+    def nfloat(run):
+        return sum(1 for _, p in run if p != "nop" and p[1] in _WIN_FLOAT)
+    shaped = []
+    for run in runs:
+        parts = [run]
+        if nfloat(run) < big:
+            parts, cur = [], []
+            for v, p in run:
+                if p != "nop" and p[1] in _WIN_EST:
+                    if cur:
+                        parts.append(cur)
+                    cur = []
+                else:
+                    cur.append((v, p))
+            if cur:
+                parts.append(cur)
+        for part in parts:
+            last = max((i for i, (_, p) in enumerate(part)
+                        if p != "nop" and p[1] in _WIN_INSENS), default=-1)
+            shaped.append(part[:last + 1])
+    out = {}
+    k = 0
+    for run in shaped:
+        if nfloat(run) < minf:
+            continue
+        try:
+            lines = _rc_win_emit(k + 1, [(stmts[v].text, p) for v, p in run])
+        except RCacheUnsupported:
+            continue
+        k += 1
+        out[run[0][0]] = lines
+        for v, _ in run[1:]:
+            out[v] = None
+    return out
