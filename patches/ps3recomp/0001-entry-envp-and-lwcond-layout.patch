+SPU_FORCEINLINE __m256d spu__dneg(__m256d x) { return _mm256_xor_pd(x, _mm256_set1_pd(-0.0)); }
+/* the sum ops: f = the host op, the double path's two-sum operands u, v */
+#    define SPU__FX_VXSUM(f, den, u, v)                                                  \
+    if (SPU_HLP_UNLIKELY(!spu__fx_rz())) return spu__fxpick((f), (den), spu__d2fx2_v((u), (v))); \
