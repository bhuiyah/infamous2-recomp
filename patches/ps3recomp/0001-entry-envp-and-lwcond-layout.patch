+static PadHostDevice* new_dev(u16 pid, int bus, int in_len, int out_len, int feat_len)
+{
+    static PadHostDevice d;
+    memset(&d, 0, sizeof d);
+    d.vid = 0x054C; d.pid = pid; d.bus = bus;
+    d.usage_page = 0x01; d.usage = 0x05;
+    d.in_len = in_len; d.out_len = out_len; d.feat_len = feat_len;
+    d.port = -1;
+    d.path = "mock";
+    return &d;
+}
