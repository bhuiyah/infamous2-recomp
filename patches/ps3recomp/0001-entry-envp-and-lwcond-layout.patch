+static void test_pipe_hid(void)
+{
+    printf("-- overlapped I/O, removal by rescan, read errors (named-pipe device)\n");
+    /* HID scanning on (so a rescan can notice the fake interface is missing),
+     * but no XInput and no drivers linked here: real pads only show as unclaimed. */
+    padhost_config_set("backends", "all,-xinput");
+    padhost_config_set("controllers", "1");
+    Sleep(300);
+    CHECK(connected_ports() == 0, "real pads stay unclaimed in this test");
+
+    HANDLE srv;
+    PhDev* d = pipe_device("\\\\.\\pipe\\padhost_test_a", &srv,
+                           "\\\\?\\hid#vid_1234&pid_9999#padhost-test-a#{4d1e55b2-f16f-11cf-88cb-001111000030}");
+    CHECK(d != NULL, "pipe device");
+    if (!d) return;
+    CHECK(wait_state(0, 1, 1000), "pipe device on port 0");
+    unsigned char m[64];
+    int n = pipe_read_msg(srv, m, sizeof m, 1000);
+    CHECK(n == 4 && m[0] == 5 && m[1] == 0 && m[2] == 0 && m[3] == 0, "LED output written through WriteFile (%d)", n);
+
+    unsigned char r[64];
+    report(r, 0x2000, 10, 20, 30, 40, 66);
+    DWORD w;
+    WriteFile(srv, r, 64, &w, NULL);
+    PadHostPortState st;
+    ULONGLONG end = GetTickCount64() + 1000;
+    while (padhost_get(0, &st) && st.buttons != 0x2000 && GetTickCount64() < end) Sleep(1);
+    CHECK(st.buttons == 0x2000 && st.lx == 10 && st.ry == 40 && st.battery == 66, "report read through overlapped ReadFile");
+
+    padhost_set_actuator(0, 1, 77);
+    n = pipe_read_msg(srv, m, sizeof m, 1000);
+    CHECK(n == 4 && m[1] == 1 && m[2] == 77, "rumble output (%d: %u %u)", n, m[1], m[2]);
+
+    unsigned g = padhost_generation();
+    SetEvent(s_ev_rescan);                         /* its "interface" is not in the HID list */
+    CHECK(wait_state(0, 0, 2000), "a rescan that no longer finds the interface releases the port");
+    n = pipe_read_msg(srv, m, sizeof m, 1000);
+    CHECK(n == 4 && m[1] == 0 && m[2] == 0 && m[3] == 0xFF, "close() turned the motors off on removal (%d)", n);
+    CHECK(padhost_generation() != g, "generation bumped");
+    CloseHandle(srv);
+
+    /* read error: the other end goes away */
+    PhDev* e = pipe_device("\\\\.\\pipe\\padhost_test_b", &srv,
+                           "\\\\?\\hid#vid_1234&pid_9999#padhost-test-b#{4d1e55b2-f16f-11cf-88cb-001111000030}");
+    CHECK(e != NULL && wait_state(0, 1, 1000), "second pipe device on port 0");
+    pipe_read_msg(srv, m, sizeof m, 1000);         /* its LED output */
+    LONG closes = s_close_calls;
+    CloseHandle(srv);
+    CHECK(wait_state(0, 0, 2000), "read error (broken pipe) = disconnect");
+    CHECK(s_close_calls == closes, "no close() on a device that is gone");
+
+    padhost_config_set("controllers", "0");
+    padhost_config_set("backends", "all");
+    Sleep(200);
+}
