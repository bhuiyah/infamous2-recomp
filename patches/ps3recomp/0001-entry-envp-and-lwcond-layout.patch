+    case WM_DISPLAYCHANGE:
+        if (s_fullscreen) disp_cover_monitor(hwnd);
+        break;
+    case WM_ENTERSIZEMOVE: case WM_ENTERMENULOOP:
+        disp_modal_enter(hwnd);
+        break;
+    case WM_EXITSIZEMOVE: case WM_EXITMENULOOP:
