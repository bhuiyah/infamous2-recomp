+int  padhost_dev_set_feature(PadHostDevice* d, const unsigned char* b, int l) { (void)d; (void)b; (void)l; return -1; }
+int  padhost_log_enabled(void) { return 0; }
+void padhost_logf(const char* fmt, ...) { (void)fmt; }
+void padhost_init(void) {}
+void padhost_shutdown(void) {}
+int  padhost_get(int port, PadHostPortState* out) { (void)port; if (out) padhost_state_neutral(out); return 0; }
+void padhost_set_actuator(int port, u8 s, u8 l) { (void)port; (void)s; (void)l; }
+unsigned padhost_generation(void) { return 0; }
+int  padhost_port_describe(int port, char* buf, int n) { (void)port; if (buf && n > 0) buf[0] = 0; return 0; }
