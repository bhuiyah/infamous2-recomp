+        if (a->frequency > 1u) {
+            if (st->frequency_divider_op & (1u << i)) { elo = 0; ehi = a->frequency - 1u; }
+            else { elo = lo / a->frequency; ehi = hi / a->frequency; }
+        }
+        const int loc = (a->offset & 0x80000000u) ? 0 : 1;
+        const u32 off = a->offset & 0x7FFFFFFFu;
+        const u64 o0 = (u64)off + (u64)elo * a->stride, o1 = (u64)off + (u64)ehi * a->stride + bytes;
+        if (o1 - o0 > (8u << 20) || o1 > 0x7FFFFFFFu) { s_vr.skipped++; continue; }
