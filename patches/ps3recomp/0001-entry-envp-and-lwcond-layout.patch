+/* ---------------- lv2_syscall / ps3_hle_call (the scaffold's shape) ---------------- */
+extern "C" void lv2_syscall(ppu_context* ctx)
+{
+    SS_SAFEPOINT(ctx, SS_AT_SC, (uint32_t)ctx->gpr[11], g_trampoline_fn != nullptr);
+    struct ScGuard { ppu_context* c; ~ScGuard() { if (g_ss_sr_on || g_ss_armed) c->sc_ra = 0; } } g{ ctx };
+    lv2_syscall_dispatch(&g_lv2_syscalls, ctx);
+}
+
+struct HleFn { uint32_t nid; const char* name; void (*fn)(ppu_context*); };
+static HleFn s_hle[512];
+static int s_nhle;
+static PPU_THREAD_LOCAL uint32_t t_hle_nid;
+extern "C" void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*))
+{
+    if (s_nhle < (int)(sizeof s_hle / sizeof s_hle[0])) s_hle[s_nhle++] = { nid, name, fn };
+}
+static const HleFn* hle_by_name(const char* name)
+{
+    for (int i = 0; i < s_nhle; i++) if (!strcmp(s_hle[i].name, name)) return &s_hle[i];
+    printf("no HLE function %s\n", name);
+    exit(2);
+}
+extern "C" void ps3_hle_call(uint32_t nid, ppu_context* ctx)
+{
+    SS_SAFEPOINT(ctx, SS_AT_HLE, nid, g_trampoline_fn != nullptr);
+    t_hle_nid = nid;
+    for (int i = 0; i < s_nhle; i++)
+        if (s_hle[i].nid == nid) { s_hle[i].fn(ctx); return; }
+    printf("unregistered NID 0x%08X\n", nid);
+    abort();
+}
+static uint32_t hle_nid_now(void) { return t_hle_nid; }
+
+/* ---------------- guest code: frames, stubs, continuations ---------------- */
+#define R(n) ctx->gpr[n]
+static void drain(ppu_context* ctx) { while (g_trampoline_fn) { auto f = g_trampoline_fn; g_trampoline_fn = 0; f(ctx); } }
+static void frame_push(ppu_context* ctx)
+{
+    vm_write64(R(1) - 0x80, R(1));
+    R(1) -= 0x80;
+    vm_write64(R(1) + 0x90, ctx->lr);
+    for (int k = 0; k < 4; k++) vm_write64(R(1) + 0x60 + 8 * k, R(28 + k));
+}
+static void frame_pop(ppu_context* ctx)
+{
+    for (int k = 0; k < 4; k++) R(28 + k) = vm_read64(R(1) + 0x60 + 8 * k);
+    ctx->lr = vm_read64(R(1) + 0x90);
+    R(1) += 0x80;
+}
+/* G_SC: `sc` in a frame of its own; its continuation is the epilogue. */
+static void gsc_tail(ppu_context* ctx) { ctx->lr = vm_read64(R(1) + 0x90); R(1) += 0x80; }
+static void gsc(ppu_context* ctx)
+{
+    vm_write64(R(1) - 0x80, R(1));
+    R(1) -= 0x80;
+    vm_write64(R(1) + 0x90, ctx->lr);
+    ctx->sc_ra = G_SC_RA;
+    lv2_syscall(ctx);
+    gsc_tail(ctx);
+}
+/* a call site: SC(num, ra) / HLE(name, ra), each followed by its label */
+#define SC(num, ra)     do { R(11) = (num); ctx->lr = (ra); gsc(ctx); } while (0)
+#define HLE(fnp, ra)    do { ctx->lr = (ra); ps3_hle_call((fnp)->nid, ctx); } while (0)
+
+/* The continuation table, built before the first thread starts (sorted). */
+static ppu_cont_entry s_ct[256];
+static int s_nct;
+static void ct_add(uint32_t ra, uint32_t owner, void (*fn)(ppu_context*), uint32_t callee, int sc)
+{
+    ppu_cont_entry e;
+    memset(&e, 0, sizeof e);
+    e.ra = ra; e.owner = owner; e.fn = fn; e.callee = callee;
+    e.r1_off = 0x80; e.lr_off = 0x90;
+    e.call_kind = sc ? PPU_CONT_CALL_SC : PPU_CONT_CALL_BL;
+    e.exit_kind = PPU_CONT_EXIT_RETURNS;
+    s_ct[s_nct++] = e;
+}
+template <void (*B)(ppu_context*, uint32_t), uint32_t RA> void cont_at(ppu_context* c) { B(c, RA); }
+static void ct_register(void)
+{
+    ct_add(G_SC_RA, G_SC, gsc_tail, 0, 1);
+    for (int i = 1; i < s_nct; i++)                       /* insertion sort by ra */
+        for (int j = i; j > 0 && s_ct[j - 1].ra > s_ct[j].ra; j--) { ppu_cont_entry t = s_ct[j]; s_ct[j] = s_ct[j - 1]; s_ct[j - 1] = t; }
+    if (!ppu_cont_register(s_ct, (uint32_t)s_nct, (uint32_t)sizeof(ppu_cont_entry), PPU_CONT_ABI, "test")) {
+        printf("continuation table refused\n");
+        exit(2);
+    }
+}
+/* Guest entry points -> host functions (the thread trampoline's table). */
+struct Entry { uint32_t addr; void (*fn)(ppu_context*); };
+static Entry s_entry[64];
+static int s_nentry;
+static void entry_add(uint32_t addr, void (*fn)(ppu_context*)) { s_entry[s_nentry++] = { addr, fn }; }
+static void test_trampoline(ppu_context* ctx)
+{
+    for (int i = 0; i < s_nentry; i++)
+        if (s_entry[i].addr == (uint32_t)ctx->cia) { g_active_ctx = ctx; s_entry[i].fn(ctx); drain(ctx); return; }
+    printf("no entry 0x%08X\n", (uint32_t)ctx->cia);
+    abort();
+}
+
+/* ---------------- host-side calls (setup and producers: tid 80, never parks) ---------------- */
+enum : uint32_t { HOST_TID = 80 };
+static int64_t hsc(int64_t (*fn)(ppu_context*), uint64_t a0 = 0, uint64_t a1 = 0, uint64_t a2 = 0,
+                   uint64_t a3 = 0, uint64_t a4 = 0, uint64_t a5 = 0, uint64_t a6 = 0)
+{
+    ppu_context c;
+    memset(&c, 0, sizeof c);
+    c.thread_id = HOST_TID;
+    c.gpr[3] = a0; c.gpr[4] = a1; c.gpr[5] = a2; c.gpr[6] = a3; c.gpr[7] = a4; c.gpr[8] = a5; c.gpr[9] = a6;
+    return fn(&c);
+}
+static uint64_t hhle(const HleFn* f, uint64_t a0 = 0, uint64_t a1 = 0, uint64_t a2 = 0)
+{
+    ppu_context c;
+    memset(&c, 0, sizeof c);
+    c.thread_id = HOST_TID;
+    c.gpr[3] = a0; c.gpr[4] = a1; c.gpr[5] = a2;
+    f->fn(&c);
+    return c.gpr[3];
+}
+enum : uint32_t { ID_OUT = DATA + 0x7F00, TID_OUT = DATA + 0x7F08, NAMES = DATA + 0x7000, ATTR = DATA + 0x7E00 };
+static uint32_t mk(int64_t (*create)(ppu_context*), uint64_t a1 = 0, uint64_t a2 = 0, uint64_t a3 = 0)
+{
+    vm_write32(ID_OUT, 0);
+    const int64_t r = hsc(create, ID_OUT, a1, a2, a3);
+    if (r != 0) { printf("create failed: 0x%llX\n", (unsigned long long)r); exit(2); }
+    return vm_read32(ID_OUT);
+}
+static unsigned spawn(uint32_t entry, uint64_t arg, const char* name)
+{
+    static int n;
+    const uint32_t nm = NAMES + 32u * (uint32_t)(n++ % 64);
+    memset(vm_base + nm, 0, 32);
+    for (int i = 0; i < 31 && name[i]; i++) vm_write8(nm + i, (uint8_t)name[i]);
+    vm_write64(TID_OUT, 0);
+    const int64_t r = hsc(sys_ppu_thread_create, TID_OUT, entry, arg, 1000, 0x10000, 0, nm);
+    if (r != 0) { printf("thread create failed: 0x%llX\n", (unsigned long long)r); exit(2); }
+    return (unsigned)vm_read64(TID_OUT);
+}
+static int thread_state(unsigned tid) { return g_ppu_threads[tid - 1].state; }
+/* Wait for tid to finish (its slot FINISHED), then join it (the slot is freed). */
+static int finish(unsigned tid, unsigned ms)
+{
+    const uint64_t end = now_ms() + ms;
+    while (thread_state(tid) != PPU_THREAD_STATE_FINISHED) {
+        if (now_ms() > end) return 0;
+        Sleep(2);
+    }
+    hsc(sys_ppu_thread_join, tid, 0);
+    return 1;
+}
