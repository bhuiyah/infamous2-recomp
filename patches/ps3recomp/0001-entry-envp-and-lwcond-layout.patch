+static void test_ports(void)
+{
+    printf("-- ports, hotplug, snapshots\n");
+    unsigned g0 = padhost_generation();
+    CHECK(connected_ports() == 0, "nothing connected");
+
+    int a = attach("A", 0, 0);
+    CHECK(a > 0 && padhost_virtual_port(a) == 0, "A on port 0 (%d)", padhost_virtual_port(a));
+    CHECK(padhost_generation() != g0, "generation bumped");
+    PadHostPortState st;
+    CHECK(padhost_get(0, &st) == 1 && st.kind == PADHOST_KIND_GENERIC && st.bus == PADHOST_BUS_BT &&
+          st.vid == 0x1234 && st.pid == 0x5678, "snapshot identity");
+    CHECK(st.lx == 128 && st.ry == 128 && st.sensor_x == 512 && st.sensor_y == 399 && st.sensor_g == 512 &&
+          st.battery == 255 && st.buttons == 0, "neutral until the first report");
+    unsigned char last[4];
+    int c = wait_outputs(a, 1, 500, last);
+    CHECK(c == 1 && last[0] == 5 && last[3] == 0, "LED output for port 0 on assignment (count %d port %u)", c, last[3]);
+    unsigned char fs[4];
+    int fc = 0;
+    padhost_virtual_last_feature_set(a, fs, 4, &fc);
+    CHECK(fc == 1 && fs[0] == 0x13 && fs[1] == 1, "open() set its feature");
+
+    unsigned char r[64];
+    u32 seq0 = st.seq;
+    report(r, 0x4008, 133, 128, 255, 0, 80);
+    r[3] = 1;
+    CHECK(padhost_virtual_feed(a, r, 30) == 0, "feed");
+    padhost_get(0, &st);
+    CHECK(st.buttons == 0x4008 && st.ps == 1 && st.lx == 133 && st.rx == 255 && st.ry == 0 && st.battery == 80,
+          "published (deadzone 0): btn %04X lx %u rx %u ry %u bat %u", st.buttons, st.lx, st.rx, st.ry, st.battery);
+    CHECK(st.seq == seq0 + 1, "seq +1 per report (%u -> %u)", seq0, st.seq);
+    CHECK(st.sensor_x == 512 && st.sensor_y == 399, "no motion -> neutral sensors");
+
+    r[9] = 3;   /* motion + pressure */
+    r[10] = 0x34; r[11] = 0x02; r[12] = 0x80; r[13] = 0x01; r[14] = 0x00; r[15] = 0x02; r[16] = 0xF0; r[17] = 0x01;
+    r[18] = 7; r[29] = 99;
+    padhost_virtual_feed(a, r, 64);
+    padhost_get(0, &st);
+    CHECK(st.has_motion && st.sensor_x == 0x234 && st.sensor_y == 0x180 && st.sensor_z == 0x200 && st.sensor_g == 0x1F0,
+          "motion passes through");
+    CHECK(st.has_pressure && st.press[0] == 7 && st.press[11] == 99, "pressure passes through");
+    unsigned char p2[2] = { 0x02, 42 };
+    padhost_virtual_feed(a, p2, 2);
+    padhost_get(0, &st);
+    CHECK(st.battery == 42 && st.buttons == 0x4008 && st.sensor_x == 0x234, "partial report keeps the rest");
+
+    padhost_config_set("deadzone", "8");
+    report(r, 0, 133, 128, 255, 0, 80);
+    padhost_virtual_feed(a, r, 64);
+    padhost_get(0, &st);
+    CHECK(st.lx == 128 && st.ly == 128 && st.rx == 255 && st.ry == 0, "deadzone 8 %%: (%u,%u) (%u,%u)", st.lx, st.ly, st.rx, st.ry);
+    padhost_config_set("deadzone", "0");
+
+    /* focus-only: this console process is not the foreground window owner */
+    report(r, 0x0010, 20, 128, 128, 128, 80);
+    padhost_virtual_feed(a, r, 64);
+    padhost_config_set("focus_only", "1");
+    padhost_get(0, &st);
+    CHECK(st.connected && st.buttons == 0 && st.lx == 128 && st.battery == 80, "focus-only: neutral but connected");
+    padhost_config_set("focus_only", "0");
+    padhost_get(0, &st);
+    CHECK(st.buttons == 0x0010 && st.lx == 20, "focus-only off");
+
+    int b = attach("B", 0, 0), cc = attach("C", 0, 0);
+    CHECK(padhost_virtual_port(b) == 1 && padhost_virtual_port(cc) == 2, "B 1, C 2");
+    CHECK(connected_ports() == 3, "three connected");
+
+    unsigned g1 = padhost_generation();
+    padhost_virtual_detach(a);
+    CHECK(padhost_get(0, &st) == 0 && st.lx == 128 && st.buttons == 0, "A unplugged: port 0 empty and neutral");
+    CHECK(padhost_generation() != g1, "generation bumped on unplug");
+    CHECK(padhost_virtual_port(b) == 1 && padhost_virtual_port(cc) == 2, "others keep their ports");
+
+    int d = attach("D", 0, 0);
+    CHECK(padhost_virtual_port(d) == 0, "new device takes the lowest free port (%d)", padhost_virtual_port(d));
+    int a2 = attach("A", 0, 0);
+    CHECK(padhost_virtual_port(a2) == 3, "A back, old port taken -> lowest free (%d)", padhost_virtual_port(a2));
+
+    padhost_virtual_detach(b);
+    padhost_virtual_detach(cc);
+    int c2 = attach("C", 0, 0);
+    CHECK(padhost_virtual_port(c2) == 2, "C back -> its old port 2 although 1 is free (%d)", padhost_virtual_port(c2));
+    int b2 = attach("B", 0, 0);
+    CHECK(padhost_virtual_port(b2) == 1, "B back -> 1 (%d)", padhost_virtual_port(b2));
+
+    /* the same pad on another bus: identity from the serial the driver sets */
+    int e = attach(NULL, 0, 0x77), f = attach(NULL, 0, 0), g = attach(NULL, 0, 0);
+    CHECK(padhost_virtual_port(e) == 4 && padhost_virtual_port(f) == 5 && padhost_virtual_port(g) == 6, "4 5 6");
+    CHECK(connected_ports() == 7, "all seven ports");
+    int h = attach("H", 0, 0);
+    CHECK(h > 0 && padhost_virtual_port(h) == -1, "8th device waits (%d)", padhost_virtual_port(h));
+    CHECK(connected_ports() == 7, "still seven");
+    unsigned g2 = padhost_generation();
+    padhost_virtual_detach(c2);
+    CHECK(padhost_virtual_port(h) == 2, "the waiting device takes the freed port (%d)", padhost_virtual_port(h));
+    CHECK(padhost_generation() - g2 >= 2, "unbind + bind both counted");
+    c = wait_outputs(h, 1, 500, last);
+    CHECK(c >= 1 && last[3] == 2, "LEDs for the port it got (%u)", last[3]);
+
+    padhost_virtual_detach(e);
+    int e2 = attach(NULL, 0, 0x77);
+    CHECK(padhost_virtual_port(e2) == 4, "identity from driver-set serial: old port 4 back (%d)", padhost_virtual_port(e2));
+
+    /* a failed open takes no port */
+    unsigned g3 = padhost_generation();
+    int bad = padhost_virtual_prepare(&stub_drv, PADHOST_BUS_USB, 1, 2, "X", 64, 64);
+    unsigned char fail[2] = { 0x12, 0xEE };
+    padhost_virtual_set_feature(bad, fail, 2);
+    CHECK(padhost_virtual_start(bad) == -1, "open failure reported");
+    CHECK(padhost_generation() == g3, "no port change for a failed open");
+
+    int ids[] = { a2, b2, d, e2, f, g, h };
+    for (unsigned i = 0; i < sizeof ids / sizeof ids[0]; i++) padhost_virtual_detach(ids[i]);
+    CHECK(connected_ports() == 0, "all unplugged");
+}
