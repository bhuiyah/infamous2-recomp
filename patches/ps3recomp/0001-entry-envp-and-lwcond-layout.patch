+++ b/libs/video/rsx_d3d12_glight.c
@@ -0,0 +1,616 @@
+/* rsx_d3d12_glight.c -- GL1: a title's SPU deferred-lighting job on the GPU (see the header).
+ *
+ * Per new parameter snapshot (one a guest frame): the prepass of the first
+ * draw that samples either buffer copies both input planes (guest memory, or
+ * the verify input) and the parameters into an upload slot; the replay of that
+ * draw records one dispatch (a 256-thread group per 32x40 tile) into a UAV
+ * buffer laid out as the two textures, then two copies into the textures the
+ * prepass bound. Later draws of the frame bind the same textures.
+ *
+ * The shader is the job's arithmetic in the job's order (decoded with
+ * scratch symspu.py, checked by a C model against SPU dumps: 98.5% of pixels
+ * byte-identical, the rest +-1 from the SPU's estimate instructions). */
+#include <windows.h>
+#include <d3d12.h>
+#include <d3dcompiler.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include "rsx_d3d12_glight.h"
+
+static const char k_gl_cs[] =
+"ByteAddressBuffer gin : register(t0);\n"
+"ByteAddressBuffer prm : register(t1);\n"
+"RWByteAddressBuffer gout : register(u0);\n"
+"cbuffer C : register(b0) { uint nl; uint rgba; uint pitch; uint plane; uint gsrc; };\n"
+"uint gl(uint o) { uint u = gin.Load(o); return gsrc != 0u ? ((u << 8) | (u >> 24)) : u; }\n"
+"uint bs(uint w) { return (w >> 24) | ((w >> 8) & 0xFF00u) | ((w << 8) & 0xFF0000u) | (w << 24); }\n"
+"float pf(uint o) { return asfloat(bs(prm.Load(o))); }\n"
+"uint pu(uint o) { return bs(prm.Load(o)); }\n"
+"float4 pv(uint o) { return float4(pf(o), pf(o + 4), pf(o + 8), pf(o + 12)); }\n"
+"float ph(uint o) {\n"
+"  uint w = prm.Load(o & ~3u);\n"
+"  uint h = (o & 2u) ? ((((w >> 16) & 0xFFu) << 8) | ((w >> 24) & 0xFFu)) : (((w & 0xFFu) << 8) | ((w >> 8) & 0xFFu));\n"
+"  uint s = (h & 0x8000u) << 16, e = (h >> 10) & 31u, m = h & 0x3FFu;\n"
+"  return asfloat(e == 0u ? s : (s | ((e + 112u) << 23) | (m << 13)));\n"
+"}\n"
+"uint ordf(float f) { uint u = asuint(f); return (u & 0x80000000u) ? ~u : (u | 0x80000000u); }\n"
+"float unordf(uint u) { return asfloat((u & 0x80000000u) ? (u & 0x7FFFFFFFu) : ~u); }\n"
+"groupshared uint gmn[3];\n"
+"groupshared uint gmx[3];\n"
+"groupshared uint glit;\n"
+"float3 corner(float4 B0, float4 B1, float4 B3, float xn, float yn) { float4 h = B0 * xn + B1 * yn + B3; return h.xyz / h.w; }\n"
+"float3 tplane(float3 a, float3 b) {\n"
+"  float3 e = float3(b.x * a.y - a.x * b.y, b.y * a.z - a.y * b.z, b.z * a.x - a.z * b.x);\n"
+"  float3 n = float3(e.y, e.z, e.x); return n * (1.0 / sqrt(dot(n, n)));\n"
+"}\n"
+"[numthreads(32, 8, 1)]\n"
+"void main(uint3 gid : SV_GroupID, uint3 gt : SV_GroupThreadID, uint gi : SV_GroupIndex) {\n"
+"  if (gi < 3u) { gmn[gi] = 0xFFFFFFFFu; gmx[gi] = 0u; }\n"
+"  if (gi == 0u) glit = 0u;\n"
+"  GroupMemoryBarrierWithGroupSync();\n"
+"  float4 A0 = pv(0x10), A1 = pv(0x20), A2 = pv(0x30), A3 = pv(0x40);\n"
+"  float4 B0 = pv(0x50), B1 = pv(0x60), B3 = pv(0x80);\n"
+"  float cscale = pf(0x98);\n"
+"  uint px = gid.x * 32u + gt.x;\n"
+"  float3 P[5]; float3 N[5]; float G[5]; uint oo[5];\n"
+"  float3 lmn = float3(3e38, 3e38, 3e38), lmx = float3(-3e38, -3e38, -3e38);\n"
+"  [unroll] for (uint k = 0; k < 5u; k++) {\n"
+"    uint py = gid.y * 40u + gt.y + 8u * k;\n"
+"    uint o = py * pitch + px * 4u; oo[k] = o;\n"
+"    uint w0 = gl(o), w1 = gl(plane + o);\n"
+"    uint d24 = bs(w1) >> 8;\n"
+"    float u = (float)px / 1280.0, v = (float)py / 720.0, z = (float)d24 * 5.96046448e-08;\n"
+"    float4 h = A0 * u + A1 * v + A2 * z + A3;\n"
+"    P[k] = h.xyz / h.w;\n"
+"    if (d24 != 0xFFFFFFu) { lmn = min(lmn, P[k]); lmx = max(lmx, P[k]); }\n"
+"    float3 n = float3((float)((w0 >> 8) & 0xFFu), (float)((w0 >> 16) & 0xFFu), (float)(w0 >> 24)) / 256.0 * 2.00784326 - 1.0;\n"
+"    N[k] = n * (1.0 / sqrt(dot(n, n)));\n"
+"    G[k] = exp2((float)(w0 & 0xFFu) / 256.0 * 8.03137302 - 0.888960004);\n"
+"  }\n"
+"  InterlockedMin(gmn[0], ordf(lmn.x)); InterlockedMin(gmn[1], ordf(lmn.y)); InterlockedMin(gmn[2], ordf(lmn.z));\n"
+"  InterlockedMax(gmx[0], ordf(lmx.x)); InterlockedMax(gmx[1], ordf(lmx.y)); InterlockedMax(gmx[2], ordf(lmx.z));\n"
+"  GroupMemoryBarrierWithGroupSync();\n"
+"  float3 mn = float3(unordf(gmn[0]), unordf(gmn[1]), unordf(gmn[2]));\n"
+"  float3 mx = float3(unordf(gmx[0]), unordf(gmx[1]), unordf(gmx[2]));\n"
+"  bool valid = mx.x > mn.x && mx.y > mn.y && mx.z > mn.z;\n"
+"  float4 acc[5];\n"
+"  [unroll] for (uint k2 = 0; k2 < 5u; k2++) acc[k2] = float4(0, 0, 0, 0);\n"
+"  uint anyp = 0u;\n"
+"  if (valid) {\n"
+"    float3 c00 = corner(B0, B1, B3, 2.0 * (float)gid.x / 40.0 - 1.0, 1.0 - 2.0 * (float)gid.y / 18.0);\n"
+"    float3 c10 = corner(B0, B1, B3, 2.0 * (float)(gid.x + 1u) / 40.0 - 1.0, 1.0 - 2.0 * (float)gid.y / 18.0);\n"
+"    float3 c01 = corner(B0, B1, B3, 2.0 * (float)gid.x / 40.0 - 1.0, 1.0 - 2.0 * (float)(gid.y + 1u) / 18.0);\n"
+"    float3 c11 = corner(B0, B1, B3, 2.0 * (float)(gid.x + 1u) / 40.0 - 1.0, 1.0 - 2.0 * (float)(gid.y + 1u) / 18.0);\n"
+"    float3 pl0 = tplane(c11, c10), pl1 = tplane(c01, c11), pl2 = tplane(c00, c01), pl3 = tplane(c10, c00);\n"
+"    float3 C = (mn + mx) * 0.5; float3 ex = mx - mn; float R = 0.5 * sqrt(dot(ex, ex));\n"
+"    for (uint l = 0; l < nl; l++) {\n"
+"      uint rec = 256u + 48u * l;\n"
+"      uint type = pu(rec + 20u);\n"
+"      if (type != 1u && type != 2u) continue;\n"
+"      float3 pos = float3(pf(rec), pf(rec + 4u), pf(rec + 8u));\n"
+"      float outer = ph(rec + 34u), inner = ph(rec + 32u);\n"
+"      if (0.0 > pl0.x * pos.x + outer + pl0.y * pos.y + pl0.z * pos.z) continue;\n"
+"      if (0.0 > pl1.x * pos.x + outer + pl1.y * pos.y + pl1.z * pos.z) continue;\n"
+"      if (0.0 > pl2.x * pos.x + outer + pl2.y * pos.y + pl2.z * pos.z) continue;\n"
+"      if (0.0 > pl3.x * pos.x + outer + pl3.y * pos.y + pl3.z * pos.z) continue;\n"
+"      float3 cl = min(max(pos, mn), mx); float3 dd = pos - cl;\n"
+"      if (!(outer * outer > dot(dd, dd))) continue;\n"
+"      float cA = ph(rec + 36u), cB = ph(rec + 38u), nearc = ph(rec + 46u);\n"
+"      float3 dir = float3(ph(rec + 40u), ph(rec + 42u), ph(rec + 44u));\n"
+"      if (type == 2u) {\n"
+"        float3 vv = C - pos; float d2 = dot(vv, vv);\n"
+"        if (d2 > (R + outer) * (R + outer)) continue;\n"
+"        if (!(R * R > d2)) {\n"
+"          float d = sqrt(d2); float3 vh = vv / d;\n"
+"          float sa = R / d, ca2 = 1.0 - sa * sa, ca = ca2 > 1.17549435e-38 ? sqrt(ca2) : 0.0;\n"
+"          float tl = ca * d;\n"
+"          float cosA = (tl > outer) ? (outer * outer + d2 - R * R) / (2.0 * d * outer) : ca;\n"
+"          float s2 = (1.0 - cosA * cosA) * (1.0 - cB * cB); float sinAC = s2 > 1.17549435e-38 ? sqrt(s2) : 0.0;\n"
+"          if (!(dot(dir, vh) > cosA * cB - sinAC)) continue;\n"
+"        }\n"
+"      }\n"
+"      float3 col = float3(ph(rec + 12u), ph(rec + 14u), ph(rec + 16u)) * cscale;\n"
+"      float clen = sqrt(dot(col, col));\n"
+"      float ird = 1.0 / (outer - inner);\n"
+"      [unroll] for (uint k3 = 0; k3 < 5u; k3++) {\n"
+"        float3 Lv = pos - P[k3]; float d2 = dot(Lv, Lv);\n"
+"        float id = 1.0 / sqrt(d2), d = d2 * id;\n"
+"        float att = saturate((outer - d) * ird);\n"
+"        if (type == 1u) { if (outer * outer > d2) anyp = 1u; }\n"
+"        else {\n"
+"          float cosv = dot(Lv, -dir) * id;\n"
+"          if (outer > d && cosv > cB) anyp = 1u;\n"
+"          att = (d > nearc) ? att : 0.0;\n"
+"          att *= saturate(cosv * (-cA) + cA * cB);\n"
+"        }\n"
+"        float ndl = dot(N[k3], Lv) * id;\n"
+"        float diff = max(ndl, 0.0) * (att * att);\n"
+"        float ip = 1.0 / sqrt(dot(P[k3], P[k3]));\n"
+"        float3 Hh = Lv * id - P[k3] * ip;\n"
+"        float ndh = dot(N[k3], Hh) / sqrt(dot(Hh, Hh));\n"
+"        float t = 1.0 + G[k3] * (1.0 - max(ndh, 0.0)); float t4 = (t * t) * (t * t);\n"
+"        float spec = (1.0 / (t4 * t4)) * (1.0 + 0.92592591 * G[k3]);\n"
+"        acc[k3] += float4(col * diff, spec * (diff * clen));\n"
+"      }\n"
+"    }\n"
+"  }\n"
+"  if (anyp) InterlockedOr(glit, 1u);\n"
+"  GroupMemoryBarrierWithGroupSync();\n"
+"  bool lit = valid && glit != 0u;\n"
+"  [unroll] for (uint k4 = 0; k4 < 5u; k4++) {\n"
+"    uint o0 = 0u, o1 = 0u;\n"
+"    if (lit) {\n"
+"      float4 s = float4(acc[k4].x > 1.17549435e-38 ? sqrt(acc[k4].x) : 0.0, acc[k4].y > 1.17549435e-38 ? sqrt(acc[k4].y) : 0.0,\n"
+"                        acc[k4].z > 1.17549435e-38 ? sqrt(acc[k4].z) : 0.0, acc[k4].w > 1.17549435e-38 ? sqrt(acc[k4].w) : 0.0);\n"
+"      float m = max(max(s.x, s.y), s.z) * 0.353553385; if (!(m > 0.353553385)) m = 0.353553385;\n"
+"      uint a = min(255u, (uint)(m * 0.99609375 * 256.0));\n"
+"      float sc = 0.353553385 / ((float)a / 256.0 * 1.00392163);\n"
+"      uint r = min(255u, (uint)max(s.x * sc * 0.99609375 * 256.0, 0.0));\n"
+"      uint g = min(255u, (uint)max(s.y * sc * 0.99609375 * 256.0, 0.0));\n"
+"      uint b = min(255u, (uint)max(s.z * sc * 0.99609375 * 256.0, 0.0));\n"
+"      uint sp = min(255u, (uint)max(s.w * 0.353553385 * 0.99609375 * 256.0, 0.0));\n"
+"      if (rgba) { o0 = a | (r << 8) | (g << 16) | (b << 24); o1 = sp; }\n"
+"      else      { o0 = r | (g << 8) | (b << 16) | (a << 24); o1 = sp << 24; }\n"
+"    }\n"
+"    gout.Store(oo[k4], o0); gout.Store(plane + oo[k4], o1);\n"
+"  }\n"
+"}\n"
+/* ---- the SSAO job (job 224): five passes, each its own entry point. The
+ * parameters (guest 0x00A94980..0x00A94AB0) follow the lights at PRM_AO:
+ * +0 pass 1 (a, b), +0x10 pass 2 (256 B: 12-sample kernel, normal matrix,
+ * scales), +0x110 blurs (30, 0.1, 0.6), +0x120 upsample (a, b, 40). Scratch
+ * after the two lighting planes in gout: the full-res AO bytes, then the
+ * half-res linear depth (float), then two half-res AO planes (one uint per
+ * pixel). The job's own order of operations, as in scratch ref224.c. */
+"#define HW 640u\n"
+"#define HH 360u\n"
+"#define PRM_AO 12544u\n"
+"float aop(uint o) { return pf(PRM_AO + o); }\n"
+"uint offB8() { return plane * 2u; }\n"
+"uint offZH() { return plane * 2u + 921600u; }\n"
+"uint offA1() { return plane * 2u + 921600u * 2u; }\n"
+"uint offA2() { return plane * 2u + 921600u * 3u; }\n"
+"float zh(int x, int y) { x = clamp(x, 0, (int)HW - 1); y = clamp(y, 0, (int)HH - 1); return asfloat(gout.Load(offZH() + 4u * ((uint)y * HW + (uint)x))); }\n"
+"uint aoa(uint base, int x, int y) { x = clamp(x, 0, (int)HW - 1); y = clamp(y, 0, (int)HH - 1); return gout.Load(base + 4u * ((uint)y * HW + (uint)x)); }\n"
+"float linz(uint d24, float a, float b) { return 1.0 / ((float)d24 * (a * asfloat(0x33800001u)) + b); }\n"
+"[numthreads(64, 1, 1)]\n"
+"void ao_depth(uint3 id : SV_DispatchThreadID) {\n"
+"  if (id.x >= HW * HH) return;\n"
+"  uint x = id.x % HW, y = id.x / HW;\n"
+"  uint d24 = bs(gl(plane + ((2u * y) * 1280u + 2u * x) * 4u)) >> 8;\n"
+"  gout.Store(offZH() + 4u * id.x, asuint(linz(d24, aop(0), aop(4))));\n"
+"}\n"
+"[numthreads(64, 1, 1)]\n"
+"void ao_main(uint3 id : SV_DispatchThreadID) {\n"
+"  if (id.x >= HW * HH) return;\n"
+"  int x = (int)(id.x % HW), y = (int)(id.x / HW);\n"
+"  uint w0 = gl(((2u * (uint)y) * 1280u + 2u * (uint)x) * 4u);\n"
+"  float R = (float)((w0 >> 8) & 0xFFu) / 256.0 * 2.00784326 - 1.0;\n"
+"  float Gc = (float)((w0 >> 16) & 0xFFu) / 256.0 * 2.00784326 - 1.0;\n"
+"  float B = (float)(w0 >> 24) / 256.0 * 2.00784326 - 1.0;\n"
+"  float3 M0 = float3(aop(0xA0), aop(0xA4), aop(0xA8)), M1 = float3(aop(0xB0), aop(0xB4), aop(0xB8)), M2 = float3(aop(0xC0), aop(0xC4), aop(0xC8));\n"
+"  float3 n = B * M2 + (Gc * M1 + R * M0);\n"
+"  float nrm = aop(0xE0), sx = aop(0xE4), sy = aop(0xE8), sz = aop(0xEC);\n"
+"  float c19 = aop(0xF0), c20 = aop(0xF4), zlo = aop(0xF8), zhi = aop(0xFC);\n"
+"  float z = zh(x, y); float zc = z > zlo ? z : zlo; if (z > zhi) zc = zhi;\n"
+"  float iz = 1.0 / zc, t13 = z * iz;\n"
+"  float t14 = n.z * t13 + z, t19 = c19 * (1.0 / t13), t20 = c20 * t13;\n"
+"  float sum = 0.0;\n"
+"  [unroll] for (uint s = 0; s < 12u; s++) {\n"
+"    uint grp = s / 4u, lane = s % 4u;\n"
+"    float kx = aop(0x10 + 16u * grp + 4u * lane), ky = aop(0x10 + 16u * (3u + grp) + 4u * lane), kz = aop(0x10 + 16u * (6u + grp) + 4u * lane);\n"
+"    float fx = kx * (sx * iz) + (n.x * iz + ((float)x + 0.5));\n"
+"    float fy = ky * (sy * iz) + (n.y * iz + ((float)y + 0.5));\n"
+"    float zs = zh((int)floor(fx), (int)floor(fy));\n"
+"    float w = kz * (sz * t13);\n"
+"    float d = (zs - (t14 - w)) * 0.5;\n"
+"    float cl = d > 0.0 ? d : 0.0; if (d > w) cl = w;\n"
+"    sum += saturate(d * t19 + t20) * w + cl;\n"
+"  }\n"
+"  float v = sum * (1.0 / (nrm * t13));\n"
+"  float o = saturate(v * aop(0x100) + aop(0x104)); if (o >= 1.0) o = 0.99999994;\n"
+"  gout.Store(offA1() + 4u * id.x, min(255u, (uint)(o * 0.99609375 * 256.0)));\n"
+"}\n"
+"uint blur(uint src, int x, int y, int dx, int dy) {\n"
+"  float zc = zh(x, y), k = aop(0x110) * (1.0 / zc);\n"
+"  float ws = 1.0, acc = (float)aoa(src, x, y);\n"
+"  [unroll] for (int t = -2; t <= 2; t++) {\n"
+"    if (t == 0) continue;\n"
+"    int xx = x + t * dx, yy = y + t * dy;\n"
+"    float w = 1.0 - abs(zh(xx, yy) - zc) * k; w = max(w, 0.0); w *= (t == -1 || t == 1) ? aop(0x118) : aop(0x114);\n"
+"    ws += w; acc += w * (float)aoa(src, xx, yy);\n"
+"  }\n"
+"  float v = acc * (1.0 / ws); return min(255u, (uint)max(v, 0.0));\n"
+"}\n"
+"[numthreads(64, 1, 1)]\n"
+"void ao_blur_h(uint3 id : SV_DispatchThreadID) {\n"
+"  if (id.x >= HW * HH) return;\n"
+"  gout.Store(offA2() + 4u * id.x, blur(offA1(), (int)(id.x % HW), (int)(id.x / HW), 1, 0));\n"
+"}\n"
+"[numthreads(64, 1, 1)]\n"
+"void ao_blur_v(uint3 id : SV_DispatchThreadID) {\n"
+"  if (id.x >= HW * HH) return;\n"
+"  gout.Store(offA1() + 4u * id.x, blur(offA2(), (int)(id.x % HW), (int)(id.x / HW), 0, 1));\n"
+"}\n"
+"uint upsample(uint X, uint Y) {\n"
+"  uint d24 = bs(gl(plane + (Y * 1280u + X) * 4u)) >> 8;\n"
+"  float zf = linz(d24, aop(0x120), aop(0x124));\n"
+"  int i = (int)(X >> 1), j = (int)(Y >> 1);\n"
+"  int x1 = (X & 1u) ? i + 1 : i - 1, y1 = (Y & 1u) ? j + 1 : j - 1;\n"
+"  int xs[4] = { i, x1, i, x1 }; int ys[4] = { j, j, y1, y1 }; float bw[4] = { 9.0, 3.0, 3.0, 1.0 };\n"
+"  float k = aop(0x128) * (1.0 / zf), ws = 0.0, acc = 0.0;\n"
+"  [unroll] for (uint q = 0; q < 4u; q++) {\n"
+"    float w = 1.0 - abs(zh(xs[q], ys[q]) - zf) * k; w = max(w, 0.0);\n"
+"    w = w * bw[q] + bw[q] * 1e-4; ws += w; acc += w * (float)aoa(offA1(), xs[q], ys[q]);\n"
+"  }\n"
+"  float v = acc * (1.0 / ws); return min(255u, (uint)max(v, 0.0));\n"
+"}\n"
+"[numthreads(64, 1, 1)]\n"
+"void ao_up(uint3 id : SV_DispatchThreadID) {\n"
+"  if (id.x >= 320u * 720u) return;\n"
+"  uint X = (id.x % 320u) * 4u, Y = id.x / 320u;\n"
+"  uint p = upsample(X, Y) | (upsample(X + 1u, Y) << 8) | (upsample(X + 2u, Y) << 16) | (upsample(X + 3u, Y) << 24);\n"
+"  gout.Store(offB8() + Y * 1280u + X, p);\n"
+"}\n";
+
+#define GL_SLOTS 3u
+#define GL_LIGHTS_CAP 256u
+#define GL_PRM_AO 12544u                   /* PRM_AO in the shader: after the constants and the lights */
+#define GL_AO_PARAM_BYTES 0x130u
+#define GL_NPSO 6
+
+static rsx_glight_cfg s_cfg;
+static int s_cfg_on, s_ao_on;
+static volatile LONG s_ok;                 /* 0 not started, 2 building, 1 ready, -1 unavailable */
+static ID3D12Device* s_dev;
+static ID3D12RootSignature* s_rs;
+static ID3D12PipelineState* s_pso[GL_NPSO];   /* lighting, ao_depth, ao_main, ao_blur_h, ao_blur_v, ao_up */
+static ID3D12Resource* s_up;               /* GL_SLOTS x slot (UPLOAD, mapped) */
+static uint8_t* s_upm;
+static ID3D12Resource* s_out;              /* lighting planes, AO bytes, AO scratch (DEFAULT, UAV) */
+static D3D12_RESOURCE_STATES s_out_st;
+static ID3D12Resource* s_tex[3];           /* diffuse, specular (RGBA8), AO (R8) */
+static D3D12_RESOURCE_STATES s_tex_st[3];
+static ID3D12Resource* s_vrb;              /* verify: the outputs read back */
+static uint8_t* s_vexp;                    /* verify: the SPU's outputs of the pending generation */
+static uint32_t s_plane, s_slot_bytes, s_in_bytes, s_out_bytes, s_ao_plane;
+static uint32_t s_seq_done, s_gen, s_pending, s_pending_slot, s_pending_nl, s_rgba;
+static uint32_t s_vgen_recorded;           /* verify: the generation whose output s_vrb holds */
+/* GPU capture of the two G-buffer copies (rsx_glight_capture_*): the walker's
+ * 2D copies out of the surfaces land in s_gin on the GPU, in the surfaces'
+ * RGBA8 byte order (the shader rotates each word into the guest's), and
+ * neither the readback nor the CPU copies run. GLIGHT_GBUF_GPU=1 (opt-in: measured no fps change on 6-16 threads; the readback path is the default). */
+static ID3D12Resource* s_gin;               /* both planes (DEFAULT) */
+static ID3D12CommandAllocator* s_cap_alloc[4];
+static ID3D12GraphicsCommandList* s_cap_list;
+static ID3D12Fence* s_cap_fence;
+static HANDLE s_cap_ev;
+static UINT64 s_cap_val[4], s_cap_next = 1;
+static uint32_t s_cap_i, s_cap_mask, s_pending_gpu;
+static int s_cap_on;
+static void (*s_wait_gpu)(void);
+static int s_verify;
+
+void rsx_glight_configure(const rsx_glight_cfg* cfg)
+{
+    if (!cfg) { s_cfg_on = 0; return; }
+    s_cfg = *cfg;
+    s_cfg_on = cfg->w == 1280 && cfg->h == 720 && cfg->pitch == 5120 && cfg->params_seq && cfg->params_copy;
+    s_ao_on = s_cfg_on && cfg->ea_ao != 0;
+    s_verify = cfg->verify_input != NULL;
+}
+int rsx_glight_enabled(void) { return s_cfg_on; }
+void rsx_glight_set_wait(void (*wait_gpu)(void)) { s_wait_gpu = wait_gpu; }
+
+static ID3D12Resource* gl_buffer(UINT64 bytes, D3D12_HEAP_TYPE ht, D3D12_RESOURCE_FLAGS fl, D3D12_RESOURCE_STATES st)
+{
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = ht;
+    D3D12_RESOURCE_DESC rd; memset(&rd, 0, sizeof rd);
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; rd.Width = bytes; rd.Height = 1; rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1; rd.Format = DXGI_FORMAT_UNKNOWN; rd.SampleDesc.Count = 1;
+    rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; rd.Flags = fl;
+    ID3D12Resource* r = NULL;
+    if (FAILED(s_dev->lpVtbl->CreateCommittedResource(s_dev, &hp, D3D12_HEAP_FLAG_NONE, &rd, st, NULL,
+                                                      &IID_ID3D12Resource, (void**)&r))) return NULL;
+    return r;
+}
+
+static int gl_init(void)
+{
+    static const char* const k_entry[GL_NPSO] = { "main", "ao_depth", "ao_main", "ao_blur_h", "ao_blur_v", "ao_up" };
+    D3D12_ROOT_PARAMETER rp[4]; memset(rp, 0, sizeof rp);
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; rp[0].Descriptor.ShaderRegister = 0;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; rp[1].Descriptor.ShaderRegister = 1;
+    rp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV; rp[2].Descriptor.ShaderRegister = 0;
+    rp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[3].Constants.ShaderRegister = 0; rp[3].Constants.Num32BitValues = 5;
+    for (int i = 0; i < 4; i++) rp[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_ROOT_SIGNATURE_DESC rsd; memset(&rsd, 0, sizeof rsd);
+    rsd.NumParameters = 4; rsd.pParameters = rp;
+    ID3DBlob* sig = NULL; ID3DBlob* err = NULL;
+    HRESULT hr = D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+    if (err) err->lpVtbl->Release(err);
+    if (FAILED(hr) || !sig) return 0;
+    hr = s_dev->lpVtbl->CreateRootSignature(s_dev, 0, sig->lpVtbl->GetBufferPointer(sig), sig->lpVtbl->GetBufferSize(sig),
+                                            &IID_ID3D12RootSignature, (void**)&s_rs);
+    sig->lpVtbl->Release(sig);
+    if (FAILED(hr) || !s_rs) return 0;
+    for (int k = 0; k < GL_NPSO; k++) {
+        if (k && !s_ao_on) break;
+        ID3DBlob* cb = NULL; ID3DBlob* e = NULL;
+        hr = D3DCompile(k_gl_cs, sizeof(k_gl_cs) - 1, "glight_cs", NULL, NULL, k_entry[k], "cs_5_0",
+                        D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &cb, &e);
+        if (FAILED(hr) || !cb) {
+            fprintf(stderr, "[GLIGHT] shader %s failed: %s%c", k_entry[k],
+                    e ? (const char*)e->lpVtbl->GetBufferPointer(e) : "?", 10);
+            if (e) e->lpVtbl->Release(e);
+            return 0;
+        }
+        if (e) e->lpVtbl->Release(e);
+        D3D12_COMPUTE_PIPELINE_STATE_DESC pd; memset(&pd, 0, sizeof pd);
+        pd.pRootSignature = s_rs;
+        pd.CS.pShaderBytecode = cb->lpVtbl->GetBufferPointer(cb);
+        pd.CS.BytecodeLength = cb->lpVtbl->GetBufferSize(cb);
+        hr = s_dev->lpVtbl->CreateComputePipelineState(s_dev, &pd, &IID_ID3D12PipelineState, (void**)&s_pso[k]);
+        cb->lpVtbl->Release(cb);
+        if (FAILED(hr) || !s_pso[k]) return 0;
+    }
+    s_plane = s_cfg.pitch * s_cfg.h;
+    s_ao_plane = s_cfg.w * s_cfg.h;                       /* the full-res AO, one byte a pixel */
+    s_in_bytes = 2u * s_plane;
+    s_out_bytes = s_in_bytes + (s_ao_on ? 4u * 921600u : 0u);   /* + AO bytes, half depth, two AO planes */
+    s_slot_bytes = s_in_bytes + GL_PRM_AO + GL_AO_PARAM_BYTES;
+    s_slot_bytes = (s_slot_bytes + 65535u) & ~65535u;
+    s_up = gl_buffer((UINT64)s_slot_bytes * GL_SLOTS, D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_FLAG_NONE,
+                     D3D12_RESOURCE_STATE_GENERIC_READ);
+    s_out = gl_buffer(s_out_bytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+                      D3D12_RESOURCE_STATE_COMMON);
+    s_out_st = D3D12_RESOURCE_STATE_COMMON;
+    if (!s_up || !s_out) return 0;
+    D3D12_RANGE nr = {0, 0};
+    if (FAILED(s_up->lpVtbl->Map(s_up, 0, &nr, (void**)&s_upm)) || !s_upm) return 0;
+    for (int i = 0; i < (s_ao_on ? 3 : 2); i++) {
+        D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC td; memset(&td, 0, sizeof td);
+        td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        td.Width = s_cfg.w; td.Height = s_cfg.h; td.DepthOrArraySize = 1; td.MipLevels = 1;
+        td.Format = i == 2 ? DXGI_FORMAT_R8_UNORM : DXGI_FORMAT_R8G8B8A8_UNORM;
+        td.SampleDesc.Count = 1; td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+        if (FAILED(s_dev->lpVtbl->CreateCommittedResource(s_dev, &hp, D3D12_HEAP_FLAG_NONE, &td,
+                D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_tex[i]))) return 0;
+        s_tex_st[i] = D3D12_RESOURCE_STATE_COPY_DEST;
+    }
+    { const char* ge = getenv("GLIGHT_GBUF_GPU"); s_cap_on = !s_verify && ge && *ge == '1'; }
+    if (s_cap_on) {
+        s_gin = gl_buffer(s_in_bytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COMMON);
+        for (int i = 0; i < 4 && s_gin; i++)
+            if (FAILED(s_dev->lpVtbl->CreateCommandAllocator(s_dev, D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator,
+                                                            (void**)&s_cap_alloc[i]))) s_cap_on = 0;
+        if (!s_gin || !s_cap_on ||
+            FAILED(s_dev->lpVtbl->CreateCommandList(s_dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, s_cap_alloc[0], NULL,
+                                                   &IID_ID3D12GraphicsCommandList, (void**)&s_cap_list)) ||
+            FAILED(s_dev->lpVtbl->CreateFence(s_dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&s_cap_fence)))
+            s_cap_on = 0;
+        else { s_cap_list->lpVtbl->Close(s_cap_list); s_cap_ev = CreateEventA(NULL, FALSE, FALSE, NULL); }
+    }
+    if (s_verify) {
+        s_vrb = gl_buffer(s_out_bytes, D3D12_HEAP_TYPE_READBACK, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST);
+        s_vexp = (uint8_t*)malloc(s_in_bytes + s_ao_plane);
+        if (!s_vrb || !s_vexp) return 0;
+    }
+    return 1;
+}
+
+static void gl_publish(const char* where)
+{
+    LARGE_INTEGER f, t0, t1;
+    QueryPerformanceFrequency(&f); QueryPerformanceCounter(&t0);
+    const int ok = s_dev && gl_init();
+    QueryPerformanceCounter(&t1);
+    const double ms = (double)(t1.QuadPart - t0.QuadPart) * 1000.0 / (double)f.QuadPart;
+    if (ok)
+        fprintf(stderr, "[GLIGHT] the SPU %s on the GPU (GLIGHT=0: on the SPUs): ready in %.1f ms (%s)%s%c",
+                s_ao_on ? "lighting and SSAO jobs run" : "lighting job runs", ms, where, s_verify ? ", GLIGHT_VERIFY on" : "", 10);
+    else {
+        fprintf(stderr, "[GLIGHT] the lighting pipeline is unavailable (%.1f ms, %s): the SPU jobs run as before%c", ms, where, 10);
+        if (s_cfg.unavailable) s_cfg.unavailable();
+    }
+    InterlockedExchange(&s_ok, ok ? 1 : -1);
+}
+static DWORD WINAPI gl_thread(LPVOID p) { (void)p; gl_publish("its own thread, at device init"); return 0; }
+
+void rsx_glight_prewarm(void* device)
+{
+    if (!s_cfg_on || !device || InterlockedCompareExchange(&s_ok, 2, 0) != 0) return;
+    s_dev = (ID3D12Device*)device;
+    HANDLE th = CreateThread(NULL, 0, gl_thread, NULL, 0, NULL);
+    if (th) CloseHandle(th); else gl_publish("inline: no thread");
+}
+
+int rsx_glight_match(uint32_t ea, uint32_t fmt, uint32_t w, uint32_t h, uint32_t pitch)
+{
+    if (!s_cfg_on || s_ok != 1 || w != s_cfg.w || h != s_cfg.h) return -1;
+    const uint32_t bf = fmt & 0x9Fu;
+    if (bf == 0x85u && (!pitch || pitch == s_cfg.pitch))
+        return ea == s_cfg.ea_c0 ? 0 : ea == s_cfg.ea_c1 ? 1 : -1;
+    if (bf == 0x81u && s_ao_on && ea == s_cfg.ea_ao && (!pitch || pitch == s_cfg.w)) return 2;
+    return -1;
+}
+
+static void gl_hist_line(const char* nm, long (*h)[6], int c0, int nc, long n)
+{
+    char b[512]; int o = snprintf(b, sizeof b, "%s", nm);
+    for (int c = c0; c < c0 + nc; c++)
+        o += snprintf(b + o, sizeof b - (size_t)o, " %ld/%ld/%ld(>4 %ld)", h[c][0], h[c][1], n - h[c][0] - h[c][1], h[c][5]);
+    fprintf(stderr, "%s%c", b, 10);
+}
+
+/* verify: the previous generation's outputs (read back by the list that made
+ * them) against what the SPU wrote for it */
+static void gl_verify_compare(void)
+{
+    if (!s_vgen_recorded || !s_vrb || !s_wait_gpu) return;
+    s_wait_gpu();
+    uint8_t* mp = NULL; D3D12_RANGE rr = {0, (SIZE_T)s_out_bytes};
+    if (FAILED(s_vrb->lpVtbl->Map(s_vrb, 0, &rr, (void**)&mp)) || !mp) return;
+    long hist[6][6]; memset(hist, 0, sizeof hist); long exact = 0, n = (long)s_cfg.w * s_cfg.h;
+    for (long i = 0; i < n; i++) {
+        const uint8_t* g0 = mp + 4 * i; const uint8_t* g1 = mp + s_plane + 4 * i;
+        const uint8_t* e0 = s_vexp + 4 * i; const uint8_t* e1 = s_vexp + s_plane + 4 * i;
+        uint8_t ga[5];
+        if (s_rgba) { ga[0] = g0[0]; ga[1] = g0[1]; ga[2] = g0[2]; ga[3] = g0[3]; ga[4] = g1[0]; }
+        else        { ga[0] = g0[3]; ga[1] = g0[0]; ga[2] = g0[1]; ga[3] = g0[2]; ga[4] = g1[3]; }
+        const uint8_t ea[5] = { e0[0], e0[1], e0[2], e0[3], e1[0] };
+        int ex = 1;
+        for (int c = 0; c < 5; c++) { int d = abs((int)ga[c] - (int)ea[c]); hist[c][d > 4 ? 5 : d]++; if (d) ex = 0; }
+        if (s_ao_on) { int d = abs((int)mp[s_in_bytes + i] - (int)s_vexp[s_in_bytes + i]); hist[5][d > 4 ? 5 : d]++; }
+        exact += ex;
+    }
+    {   /* GLIGHT_VERIFY_DUMP=<prefix>: one pair of outputs (gpu, spu) */
+        static int done = 0; const char* dp = getenv("GLIGHT_VERIFY_DUMP");
+        if (dp && !done && s_vgen_recorded >= 10) {
+            done = 1; char p[600]; FILE* f;
+            snprintf(p, sizeof p, "%s_gpu.bin", dp); if ((f = fopen(p, "wb"))) { fwrite(mp, 1, s_in_bytes + s_ao_plane, f); fclose(f); }
+            snprintf(p, sizeof p, "%s_spu.bin", dp); if ((f = fopen(p, "wb"))) { fwrite(s_vexp, 1, s_in_bytes + s_ao_plane, f); fclose(f); }
+        }
+    }
+    D3D12_RANGE wr = {0, 0}; s_vrb->lpVtbl->Unmap(s_vrb, 0, &wr);
+    static int nlog = 0;
+    if (nlog++ < 40) {
+        char nm[96]; snprintf(nm, sizeof nm, "[GLIGHT-VERIFY] gen %u: lighting px exact %ld/%ld; 0/1/>1 A R G B S:", s_vgen_recorded, exact, n);
+        gl_hist_line(nm, hist, 0, 5, n);
+        if (s_ao_on) gl_hist_line("[GLIGHT-VERIFY]   SSAO 0/1/>1:", hist, 5, 1, n);
+    }
+    s_vgen_recorded = 0;
+}
+
+void* rsx_glight_texture(int which, int argb_is_rgba)
+{
+    extern uint8_t* vm_base;
+    if (s_ok != 1 || which < 0 || which > 2 || (which == 2 && !s_ao_on) || !vm_base) return NULL;
+    const uint32_t seq = s_cfg.params_seq();
+    if (seq && seq != s_seq_done && !s_pending) {
+        if (s_verify) gl_verify_compare();
+        const uint32_t slot = (s_gen + 1u) % GL_SLOTS;
+        uint8_t* dst = s_upm + (size_t)slot * s_slot_bytes;
+        uint32_t nl = 0, seq2 = 0;
+        if (!s_cfg.params_copy(dst + s_in_bytes, dst + s_in_bytes + 256u, GL_LIGHTS_CAP,
+                               dst + s_in_bytes + GL_PRM_AO, &nl, &seq2) || !seq2)
+            return s_seq_done ? s_tex[which] : NULL;
+        if (s_verify) {
+            if (!s_cfg.verify_input(dst, s_in_bytes, seq2)) return NULL;
+            memcpy(s_vexp, vm_base + s_cfg.ea_c0, s_plane);            /* the SPU's outputs of this frame */
+            memcpy(s_vexp + s_plane, vm_base + s_cfg.ea_c1, s_plane);
+            if (s_ao_on) memcpy(s_vexp + s_in_bytes, vm_base + s_cfg.ea_ao, s_ao_plane);
+        } else if (s_cap_on && s_cap_mask == 3u) {
+            s_pending_gpu = 1u;                                         /* captured on the GPU */
+        } else {
+            s_pending_gpu = 0u;
+            memcpy(dst, vm_base + s_cfg.ea_c0, s_plane);                /* the G-buffer copies */
+            memcpy(dst + s_plane, vm_base + s_cfg.ea_c1, s_plane);
+        }
+        s_cap_mask = 0u;
+        s_gen++; s_seq_done = seq2; s_pending = 1; s_pending_slot = slot; s_pending_nl = nl;
+        s_rgba = argb_is_rgba ? 1u : 0u;
+    }
+    if (!s_seq_done) return NULL;
+    return s_tex[which];
+}
+
+static void gl_bar(ID3D12GraphicsCommandList* cl, ID3D12Resource* r, D3D12_RESOURCE_STATES* cur, D3D12_RESOURCE_STATES to)
+{
+    if (*cur == to) return;
+    D3D12_RESOURCE_BARRIER b; memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; b.Transition.pResource = r;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = *cur; b.Transition.StateAfter = to;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &b);
+    *cur = to;
+}
+static void gl_uav(ID3D12GraphicsCommandList* cl)
+{
+    D3D12_RESOURCE_BARRIER b; memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV; b.UAV.pResource = s_out;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &b);
+}
+
+void rsx_glight_record(void* cmd_list)
+{
+    ID3D12GraphicsCommandList* cl = (ID3D12GraphicsCommandList*)cmd_list;
+    if (!s_pending || s_ok != 1 || !cl) return;
+    s_pending = 0;
+    const D3D12_GPU_VIRTUAL_ADDRESS base = s_up->lpVtbl->GetGPUVirtualAddress(s_up) + (UINT64)s_pending_slot * s_slot_bytes;
+    gl_bar(cl, s_out, &s_out_st, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    cl->lpVtbl->SetComputeRootSignature(cl, s_rs);
+    cl->lpVtbl->SetComputeRootShaderResourceView(cl, 0, s_pending_gpu ? s_gin->lpVtbl->GetGPUVirtualAddress(s_gin) : base);
+    cl->lpVtbl->SetComputeRootShaderResourceView(cl, 1, base + s_in_bytes);
+    cl->lpVtbl->SetComputeRootUnorderedAccessView(cl, 2, s_out->lpVtbl->GetGPUVirtualAddress(s_out));
+    const UINT k[5] = { s_pending_nl, s_rgba, s_cfg.pitch, s_plane, s_pending_gpu };
+    cl->lpVtbl->SetComputeRoot32BitConstants(cl, 3, 5, k, 0);
+    cl->lpVtbl->SetPipelineState(cl, s_pso[0]);
+    cl->lpVtbl->Dispatch(cl, s_cfg.w / 32u, s_cfg.h / 40u, 1);
+    if (s_ao_on) {   /* the SSAO job's five passes, each reading the one before */
+        const UINT half = (640u * 360u + 63u) / 64u, up = (320u * 720u + 63u) / 64u;
+        const UINT groups[5] = { half, half, half, half, up };
+        for (int p = 0; p < 5; p++) {
+            cl->lpVtbl->SetPipelineState(cl, s_pso[1 + p]);
+            cl->lpVtbl->Dispatch(cl, groups[p], 1, 1);
+            if (p < 4) gl_uav(cl);
+        }
+    }
+    gl_bar(cl, s_out, &s_out_st, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    for (int i = 0; i < (s_ao_on ? 3 : 2); i++) {
+        gl_bar(cl, s_tex[i], &s_tex_st[i], D3D12_RESOURCE_STATE_COPY_DEST);
+        D3D12_TEXTURE_COPY_LOCATION dl, sl; memset(&dl, 0, sizeof dl); memset(&sl, 0, sizeof sl);
+        dl.pResource = s_tex[i]; dl.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; dl.SubresourceIndex = 0;
+        sl.pResource = s_out; sl.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        sl.PlacedFootprint.Offset = (UINT64)i * s_plane;   /* plane 2 (the AO bytes) starts at 2 * s_plane */
+        sl.PlacedFootprint.Footprint.Format = i == 2 ? DXGI_FORMAT_R8_UNORM : DXGI_FORMAT_R8G8B8A8_UNORM;
+        sl.PlacedFootprint.Footprint.Width = s_cfg.w; sl.PlacedFootprint.Footprint.Height = s_cfg.h;
+        sl.PlacedFootprint.Footprint.Depth = 1;
+        sl.PlacedFootprint.Footprint.RowPitch = i == 2 ? s_cfg.w : s_cfg.pitch;
+        cl->lpVtbl->CopyTextureRegion(cl, &dl, 0, 0, 0, &sl, NULL);
+        gl_bar(cl, s_tex[i], &s_tex_st[i],
+               D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    }
+    if (s_verify && s_vrb) {
+        cl->lpVtbl->CopyBufferRegion(cl, s_vrb, 0, s_out, 0, s_out_bytes);
+        s_vgen_recorded = s_gen;
+    }
+    /* buffers decay to COMMON when their list ends: say so explicitly, so the
+     * next pass (a later list) starts from the state the buffer really has */
+    gl_bar(cl, s_out, &s_out_st, D3D12_RESOURCE_STATE_COMMON);
+}
+
+/* ---- GPU capture of the G-buffer copies (backend: the walker's NV3089 copy) */
+int rsx_glight_capture_plane(uint32_t dst_ea, uint32_t w, uint32_t h)
+{
+    if (!s_cap_on || s_ok != 1 || w != s_cfg.w || h != s_cfg.h) return -1;
+    return dst_ea == s_cfg.ea_c0 ? 0 : dst_ea == s_cfg.ea_c1 ? 1 : -1;
+}
+void* rsx_glight_gin(uint64_t* plane_bytes) { if (plane_bytes) *plane_bytes = s_plane; return s_gin; }
+void* rsx_glight_capture_begin(void)
+{
+    const uint32_t i = s_cap_i & 3u;
+    if (s_cap_val[i] && s_cap_fence->lpVtbl->GetCompletedValue(s_cap_fence) < s_cap_val[i]) {
+        s_cap_fence->lpVtbl->SetEventOnCompletion(s_cap_fence, s_cap_val[i], s_cap_ev);
+        WaitForSingleObject(s_cap_ev, 2000);
+    }
+    s_cap_alloc[i]->lpVtbl->Reset(s_cap_alloc[i]);
+    s_cap_list->lpVtbl->Reset(s_cap_list, s_cap_alloc[i], NULL);
+    return s_cap_list;
+}
+void rsx_glight_capture_end(void* queue, int plane)
+{
+    ID3D12CommandQueue* q = (ID3D12CommandQueue*)queue;
+    const uint32_t i = s_cap_i & 3u;
+    s_cap_list->lpVtbl->Close(s_cap_list);
+    ID3D12CommandList* lists[] = { (ID3D12CommandList*)s_cap_list };
+    q->lpVtbl->ExecuteCommandLists(q, 1, lists);
+    s_cap_val[i] = s_cap_next++;
+    q->lpVtbl->Signal(q, s_cap_fence, s_cap_val[i]);
+    s_cap_i++;
+    if (plane >= 0) s_cap_mask |= 1u << plane;
+}
diff --git a/libs/video/rsx_d3d12_glight.h b/libs/video/rsx_d3d12_glight.h
new file mode 100644
index 0000000..3a227b5
--- /dev/null
+++ b/libs/video/rsx_d3d12_glight.h
@@ -0,0 +1,58 @@
+/* rsx_d3d12_glight.h -- GL1: a title's SPU deferred-lighting job done on the GPU.
+ *
+ * inFamous 2 lights its G-buffer on the SPUs: the walker copies the normals
+ * (ARGB8) and depth (Z24S8) surfaces to two 1280x720 main-memory buffers, a
+ * job module rewrites both in place with tiled deferred lighting (diffuse RGB
+ * with a shared scale in the first, specular in the second's high byte), and
+ * later draws sample them as textures. With GL1 the title replaces the job's
+ * per-tile kernel with a stub that only snapshots its parameters (the job's
+ * synchronisation still runs), and this module computes the same two images
+ * in a compute pass right before the first draw that samples them, binding
+ * its own textures in place of the guest upload.
+ *
+ * The title supplies where the buffers are and a parameter snapshot; the
+ * shader is the job's arithmetic (docs/NOTES.md "GL1"). Verify mode: the
+ * title keeps the SPU kernel running and supplies the kernel's own input;
+ * the module compares its output with the SPU's (GLIGHT_VERIFY). */
+#ifndef RSX_D3D12_GLIGHT_H
+#define RSX_D3D12_GLIGHT_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+    uint32_t ea_c0, ea_c1;   /* normals in / diffuse out; depth in / specular out */
+    uint32_t w, h, pitch;    /* 1280, 720, 5120 */
+    uint32_t ea_ao;          /* the SSAO job's full-res B8 output (0: the lighting job only) */
+    /* the job's parameters: returns the snapshot's sequence (0: none yet);
+     * copies the 256-byte constant block and up to cap lights (48 B each) */
+    uint32_t (*params_seq)(void);
+    int (*params_copy)(uint8_t* consts256, uint8_t* lights, uint32_t cap, uint8_t* ao_params /* 0x130 B */,
+                       uint32_t* nlights, uint32_t* seq);
+    /* verify mode only (NULL otherwise): the kernel's own input, both planes */
+    int (*verify_input)(uint8_t* dst, uint32_t bytes, uint32_t seq);
+    /* the pipeline could not be built: put the SPU kernel back */
+    void (*unavailable)(void);
+} rsx_glight_cfg;
+
+/* Title: before the device is made. */
+void rsx_glight_configure(const rsx_glight_cfg* cfg);
+int  rsx_glight_enabled(void);
+
+/* Backend: */
+void rsx_glight_prewarm(void* device);                 /* at device init, on a thread */
+int  rsx_glight_match(uint32_t ea, uint32_t fmt, uint32_t w, uint32_t h, uint32_t pitch);  /* 0/1 lighting, 2 AO, -1 */
+void* rsx_glight_texture(int which, int argb_is_rgba); /* ID3D12Resource*, NULL: guest path */
+void rsx_glight_record(void* cmd_list);                /* the pass, if one is pending */
+void rsx_glight_set_wait(void (*wait_gpu)(void));      /* verify: the backend's full GPU wait */
+/* the walker's 2D copy of a G-buffer surface into a lighting input: done on the GPU */
+int  rsx_glight_capture_plane(uint32_t dst_ea, uint32_t w, uint32_t h);   /* 0/1, -1: not ours */
+void* rsx_glight_gin(uint64_t* plane_bytes);           /* ID3D12Resource*: both planes */
+void* rsx_glight_capture_begin(void);                  /* a reset command list */
+void rsx_glight_capture_end(void* queue, int plane);   /* executed on the queue; the plane is current */
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/video/rsx_d3d12_report.c b/libs/video/rsx_d3d12_report.c
new file mode 100644
index 0000000..d29e28b
--- /dev/null
+++ b/libs/video/rsx_d3d12_report.c
@@ -0,0 +1,639 @@
+/*
+ * ps3recomp - the D3D12 half of exact ZPASS reports (occlusion queries) and of
+ * copy-on-sample for a draw that samples its own colour target. The policy
+ * (segments, delivery, the texture-cache epoch) is platform-neutral in
+ * rsx_report.c; rsx_d3d12_backend.c calls these around its replay.
+ *
+ * One query heap of `capacity` occlusion queries and one readback buffer. The
+ * backend runs one command list at a time (render_frame waits for the previous
+ * one before recording), so a single readback buffer is enough: resolve before
+ * Close, collect after the next GPU wait, before the next resolve.
+ */
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <d3d12.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <d3dcompiler.h>
+
+#include "rsx_report.h"
+#include "rsx_d3d12_report.h"
+#include "rsx_res_scale.h"   /* rsx_rs_norm_count (RES_SCALE) */
+#include "rsx_texture_layout.h"   /* PF6 REPORT_GPU: the CPU upload's layout and decode */
+
+static ID3D12QueryHeap* s_zq_heap;
+static ID3D12Resource*  s_zq_rb;
+static uint32_t* s_zq_seg;       /* segment of each query of the list being recorded */
+static uint32_t* s_zq_rseg;      /* ... of the list resolved into s_zq_rb */
+static uint32_t* s_zq_div;       /* RES_SCALE: host samples per guest pixel of each query (1) */
+static uint32_t* s_zq_rdiv;      /* ... of the resolved list */
+static uint32_t  s_zq_cap, s_zq_n, s_zq_resolved;
+static int       s_zq_ok = -1;
+
+int rsx_zpass_init(ID3D12Device* dev, uint32_t capacity)
+{
+    if (s_zq_ok >= 0) return s_zq_ok;
+    s_zq_ok = 0;
+    if (!dev || !capacity) return 0;
+    D3D12_QUERY_HEAP_DESC qd;
+    memset(&qd, 0, sizeof qd);
+    qd.Type = D3D12_QUERY_HEAP_TYPE_OCCLUSION;
+    qd.Count = capacity;
+    D3D12_HEAP_PROPERTIES hp;
+    memset(&hp, 0, sizeof hp);
+    hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd;
+    memset(&bd, 0, sizeof bd);
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    bd.Width = (UINT64)capacity * 8u; bd.Height = 1; bd.DepthOrArraySize = 1;
+    bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    s_zq_seg = (uint32_t*)calloc(capacity, sizeof(uint32_t));
+    s_zq_rseg = (uint32_t*)calloc(capacity, sizeof(uint32_t));
+    s_zq_div = (uint32_t*)calloc(capacity, sizeof(uint32_t));
+    s_zq_rdiv = (uint32_t*)calloc(capacity, sizeof(uint32_t));
+    if (!s_zq_seg || !s_zq_rseg || !s_zq_div || !s_zq_rdiv ||
+        FAILED(dev->lpVtbl->CreateQueryHeap(dev, &qd, &IID_ID3D12QueryHeap, (void**)&s_zq_heap)) ||
+        FAILED(dev->lpVtbl->CreateCommittedResource(dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+               D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_zq_rb))) {
+        fprintf(stderr, "[ZPASS] occlusion queries unavailable: ZPASS reports carry 0%c", 10);
+        return 0;
+    }
+    s_zq_cap = capacity;
+    s_zq_ok = 1;
+    return 1;
+}
+
+int rsx_zpass_begin(ID3D12GraphicsCommandList* cl, uint32_t seg)
+{
+    if (s_zq_ok != 1 || !seg) return -1;
+    if (s_zq_n >= s_zq_cap) {
+        static int n = 0; if (n++ < 2)
+            fprintf(stderr, "[ZPASS] more than %u counted draws in one list: the rest uncounted%c",
+                    s_zq_cap, 10);
+        return -1;
+    }
+    const uint32_t q = s_zq_n++;
+    s_zq_seg[q] = seg;
+    s_zq_div[q] = 1u;
+    cl->lpVtbl->BeginQuery(cl, s_zq_heap, D3D12_QUERY_TYPE_OCCLUSION, q);
+    return (int)q;
+}
+
+void rsx_zpass_set_div(int q, uint32_t div)
+{
+    if (q >= 0 && (uint32_t)q < s_zq_n && div) s_zq_div[q] = div;
+}
+
+void rsx_zpass_end(ID3D12GraphicsCommandList* cl, int q)
+{
+    if (q >= 0) cl->lpVtbl->EndQuery(cl, s_zq_heap, D3D12_QUERY_TYPE_OCCLUSION, (UINT)q);
+}
+
+void rsx_zpass_resolve(ID3D12GraphicsCommandList* cl)
+{
+    if (!s_zq_n) return;
+    if (s_zq_resolved) {   /* never collected: the GPU wait was skipped somewhere */
+        static int n = 0; if (n++ < 2)
+            fprintf(stderr, "[ZPASS] %u counts dropped: the previous list was not collected%c",
+                    s_zq_resolved, 10);
+    }
+    cl->lpVtbl->ResolveQueryData(cl, s_zq_heap, D3D12_QUERY_TYPE_OCCLUSION, 0, s_zq_n, s_zq_rb, 0);
+    memcpy(s_zq_rseg, s_zq_seg, (size_t)s_zq_n * sizeof(uint32_t));
+    memcpy(s_zq_rdiv, s_zq_div, (size_t)s_zq_n * sizeof(uint32_t));
+    s_zq_resolved = s_zq_n;
+    s_zq_n = 0;
+}
+
+uint32_t rsx_zpass_resolved(void) { return s_zq_resolved; }
+
+uint32_t rsx_zpass_collect(void)
+{
+    if (!s_zq_resolved) return 0;
+    const uint32_t n = s_zq_resolved;
+    s_zq_resolved = 0;
+    UINT64* c = NULL;
+    D3D12_RANGE rr = {0, (SIZE_T)n * 8u};
+    if (FAILED(s_zq_rb->lpVtbl->Map(s_zq_rb, 0, &rr, (void**)&c)) || !c) {
+        fprintf(stderr, "[ZPASS] query readback could not be mapped: %u draws uncounted%c", n, 10);
+        return 0;
+    }
+    for (uint32_t i = 0; i < n; i++)   /* RES_SCALE: a scaled target's count in guest pixels */
+        rsx_report_add_samples(s_zq_rseg[i], rsx_rs_norm_count((uint64_t)c[i], s_zq_rdiv[i]));
+    D3D12_RANGE wr = {0, 0};
+    s_zq_rb->lpVtbl->Unmap(s_zq_rb, 0, &wr);
+    return n;
+}
+
+uint32_t rsx_zpass_reset(void)
+{
+    const uint32_t n = s_zq_n + s_zq_resolved;
+    s_zq_n = 0;
+    s_zq_resolved = 0;
+    return n;
+}
+
+static void barrier(ID3D12GraphicsCommandList* cl, ID3D12Resource* r,
+                    D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to)
+{
+    if (from == to) return;
+    D3D12_RESOURCE_BARRIER b;
+    memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = r;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = from;
+    b.Transition.StateAfter = to;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &b);
+}
+
+/* ---- PF6 REPORT_GPU: a planned unit's record texels, composed on the GPU ----
+ * What the CPU path does for the consumer of a pending report: wait for the
+ * list holding its draws, add each query's count to its segment, write the
+ * record {u64 timer, u32 sat32(folded + segments), u32 0} big-endian, then
+ * upload the 4xh Y16_X16 texture over it -- rsx_texture_decode swaps each
+ * word's 16-bit halves into an R16G16_UNORM texel. Here, in the list of the
+ * draw itself: this list's queries are resolved into s_rg_q, a compute pass
+ * (one thread a texel) adds the counts of this list's queries recorded before
+ * the draw whose segment is in the row's range -- each query's segment and
+ * divisor are uploaded beside its count, and each count is normalised as
+ * rsx_zpass_collect does (rsx_rs_norm_count); no order is assumed -- to the
+ * samples already collected (the plan's base: every earlier list was
+ * collected at this render_frame's start), saturates as deliver_n does and
+ * writes (W << 16 | W >> 16) for each big-endian word W into a staging
+ * footprint, and CopyTextureRegion moves it into a pool texture of the CPU
+ * upload's shape (R16G16_UNORM, 4 x h, 1 level).
+ * Resource states: s_rg_q and s_rg_stage are buffers, created in COMMON; a
+ * buffer decays to COMMON when the list that used it has run, so each list
+ * starts them at COMMON (rsx_rgpu_list_begin) and every transition names the
+ * state it really is in. The pool textures (not simultaneous-access) keep the
+ * state their explicit transitions leave (PIXEL_SHADER_RESOURCE between
+ * composes); the upload buffers stay GENERIC_READ, the readback COPY_DEST.
+ * The pipeline and its ~140 resources are made on a thread of their own when
+ * the device comes up (rsx_rgpu_prewarm); until it is done a consumer takes
+ * the old delivery -- no hitch at the first lamp. */
+#define RG_K      32u                 /* pool textures per row count h (1..4) */
+#define RG_STAGE  64u                 /* staging footprints, 1 KB each (4 rows at RowPitch 256) */
+#define RG_PLANB  512u                /* plan data per compose */
+#define RG_RING   (RG_PLANB * 512u)   /* a list's plan data: more than the composes one list can hold */
+#define RG_VMAX   256u                /* composes read back per list (REPORT_GPU_VERIFY) */
+static volatile LONG s_rg_ok;         /* 0 untried, 2 being made, 1 ready, -1 unavailable */
+static ID3D12RootSignature* s_rg_rs;
+static ID3D12PipelineState* s_rg_pso;
+static ID3D12Resource* s_rg_q;        /* this list's counts, 8 B a query (DEFAULT) */
+static D3D12_RESOURCE_STATES s_rg_qst;
+static uint32_t s_rg_qwm;             /* queries of this list resolved into it */
+static ID3D12Resource* s_rg_qinfo;    /* each query's segment and RES_SCALE divisor, 8 B (UPLOAD, mapped) */
+static uint32_t* s_rg_qinfom;
+static uint32_t s_rg_iwm;             /* queries of this list whose segment / divisor are written */
+static ID3D12Resource* s_rg_stage;    /* staging footprints (DEFAULT, UAV) */
+static D3D12_RESOURCE_STATES s_rg_sst;
+static uint32_t s_rg_snext;
+static ID3D12Resource* s_rg_up;       /* plan data (UPLOAD, mapped) */
+static uint8_t* s_rg_upm;
+static uint32_t s_rg_upo;
+static ID3D12Resource* s_rg_pool[4][RG_K];
+static D3D12_RESOURCE_STATES s_rg_pst[4][RG_K];
+static uint32_t s_rg_done[4][RG_K];   /* the plan composed into the slot in this list (0 none) */
+static unsigned long long s_rg_n, s_rg_lists, s_rg_bug;
+static ID3D12Resource* s_rg_vrb;      /* REPORT_GPU_VERIFY: the staging footprints read back */
+typedef struct { uint32_t id, h, fmt; rsx_rplan_row row[4]; } RgVer;
+static RgVer s_rg_ver[RG_VMAX];
+static uint32_t s_rg_vn, s_rg_vpend;
+static unsigned long long s_rg_vrows, s_rg_vbad, s_rg_vunk, s_rg_vskip, s_rg_vlists;
+typedef struct { ID3D12Device* dev; uint32_t nq; int verify; } RgInit;
+static RgInit s_rg_init;              /* the init's arguments (the thread reads them) */
+
+static const char k_rg_cs[] =
+    "ByteAddressBuffer Q : register(t0);\n"          /* this list's counts: UINT64 a query */
+    "ByteAddressBuffer P : register(t1);\n"          /* the plan: 64 B a row */
+    "ByteAddressBuffer D : register(t2);\n"          /* each query's segment, divisor */
+    "RWByteAddressBuffer O : register(u0);\n"        /* staging: row r at oofs + 256 r */
+    "cbuffer K : register(b0) { uint oofs; uint h; uint k2; uint k3; };\n"
+    "uint2 add64(uint2 a, uint2 b) { uint lo = a.x + b.x; return uint2(lo, a.y + b.y + (lo < a.x ? 1u : 0u)); }\n"
+    "uint2 div64(uint2 n, uint d) {\n"
+    "    uint qh = n.y / d; uint r = n.y - qh * d; uint ql = 0u;\n"
+    "    for (int i = 31; i >= 0; i--) {\n"
+    "        uint top = r >> 31;\n"
+    "        r = (r << 1) | ((n.x >> (uint)i) & 1u);\n"
+    "        ql = ql << 1;\n"
+    "        if (top != 0u || r >= d) { r -= d; ql |= 1u; }\n"
+    "    }\n"
+    "    return uint2(ql, qh);\n"
+    "}\n"
+    "[numthreads(4, 4, 1)]\n"
+    "void main(uint3 t : SV_GroupThreadID) {\n"
+    "    if (t.y >= h) return;\n"
+    "    uint b = t.y * 64u;\n"
+    "    uint mode = P.Load(b);\n"
+    "    uint W;\n"
+    "    if (mode != 0u || t.x != 2u) W = P.Load(b + 4u + t.x * 4u);\n"
+    "    else {\n"
+    "        uint2 s = uint2(P.Load(b + 20u), P.Load(b + 24u));\n"
+    "        uint qa = P.Load(b + 28u), qb = P.Load(b + 32u), lo = P.Load(b + 36u), hi = P.Load(b + 40u);\n"
+    "        for (uint q = qa; q < qb; q++) {\n"
+    "            uint2 m = D.Load2(q * 8u);\n"
+    "            if (m.x < lo || m.x > hi) continue;\n"
+    "            uint2 c = Q.Load2(q * 8u);\n"
+    "            if (m.y > 1u) {\n"
+    "                uint2 n = div64(add64(c, uint2(m.y >> 1, 0u)), m.y);\n"
+    "                c = ((c.x | c.y) != 0u && (n.x | n.y) == 0u) ? uint2(1u, 0u) : n;\n"
+    "            }\n"
+    "            s = add64(s, c);\n"
+    "        }\n"
+    "        W = s.y != 0u ? 0xFFFFFFFFu : s.x;\n"
+    "    }\n"
+    "    O.Store(oofs + t.y * 256u + t.x * 4u, (W << 16) | (W >> 16));\n"
+    "}\n";
+
+static ID3D12Resource* rg_buffer(ID3D12Device* dev, UINT64 bytes, D3D12_HEAP_TYPE ht, D3D12_RESOURCE_FLAGS fl,
+                                 D3D12_RESOURCE_STATES st)
+{
+    D3D12_HEAP_PROPERTIES hp;
+    memset(&hp, 0, sizeof hp);
+    hp.Type = ht;
+    D3D12_RESOURCE_DESC rd;
+    memset(&rd, 0, sizeof rd);
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; rd.Width = bytes; rd.Height = 1; rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1; rd.Format = DXGI_FORMAT_UNKNOWN; rd.SampleDesc.Count = 1;
+    rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; rd.Flags = fl;
+    ID3D12Resource* r = NULL;
+    if (FAILED(dev->lpVtbl->CreateCommittedResource(dev, &hp, D3D12_HEAP_FLAG_NONE, &rd, st, NULL,
+                                                    &IID_ID3D12Resource, (void**)&r))) return NULL;
+    return r;
+}
+
+static void rg_bar(ID3D12GraphicsCommandList* cl, ID3D12Resource* r, D3D12_RESOURCE_STATES* cur,
+                   D3D12_RESOURCE_STATES to)
+{
+    if (*cur == to) return;
+    barrier(cl, r, *cur, to);
+    *cur = to;
+}
+
+/* Two transitions in one call (each skipped when already in place). */
+static void rg_bar2(ID3D12GraphicsCommandList* cl, ID3D12Resource* a, D3D12_RESOURCE_STATES* acur,
+                    D3D12_RESOURCE_STATES ato, ID3D12Resource* b, D3D12_RESOURCE_STATES* bcur,
+                    D3D12_RESOURCE_STATES bto)
+{
+    D3D12_RESOURCE_BARRIER rb[2];
+    UINT n = 0;
+    memset(rb, 0, sizeof rb);
+    if (*acur != ato) {
+        rb[n].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; rb[n].Transition.pResource = a;
+        rb[n].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        rb[n].Transition.StateBefore = *acur; rb[n].Transition.StateAfter = ato; n++; *acur = ato;
+    }
+    if (*bcur != bto) {
+        rb[n].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; rb[n].Transition.pResource = b;
+        rb[n].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        rb[n].Transition.StateBefore = *bcur; rb[n].Transition.StateAfter = bto; n++; *bcur = bto;
+    }
+    if (n) cl->lpVtbl->ResourceBarrier(cl, n, rb);
+}
+
+/* The CPU upload's shape for this texture: R16G16 texels, linear rows of 16
+ * bytes (rsx_texture_layout_pitched, as vp_upload_tex_slot's chain has it). */
+static int rg_shape_ok(uint32_t fmt, uint32_t w, uint32_t h)
+{
+    if (w != 4u || h < 1u || h > 4u) return 0;
+    rsx_tex_layout tl;
+    rsx_texture_layout_pitched(fmt, w, h, 16u, &tl);
+    return tl.fmt == RSX_TEXFMT_R16G16 && !tl.compressed && !tl.swizzled && tl.row_bytes == 16u &&
+           tl.bytes_per_texel == 4u && tl.dst_bytes_per_texel == 4u;
+}
+
+/* The pipeline and its resources (any thread: ID3D12Device is free-threaded,
+ * D3DCompile is thread-safe; nothing here is read before s_rg_ok says 1). */
+static int rg_init(ID3D12Device* dev, uint32_t nq, int verify)
+{
+    ID3DBlob* cb = NULL; ID3DBlob* e = NULL;
+    HRESULT hr = D3DCompile(k_rg_cs, sizeof(k_rg_cs) - 1, "rgpu_cs", NULL, NULL, "main", "cs_5_0", 0, 0, &cb, &e);
+    if (FAILED(hr) || !cb) {
+        fprintf(stderr, "[REPORT-GPU] compose shader failed: %s -- reports delivered as before%c",
+                e ? (const char*)e->lpVtbl->GetBufferPointer(e) : "?", 10);
+        if (e) e->lpVtbl->Release(e);
+        return 0;
+    }
+    D3D12_ROOT_PARAMETER rp[5];
+    memset(rp, 0, sizeof rp);
+    for (int i = 0; i < 3; i++) { rp[i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; rp[i].Descriptor.ShaderRegister = (UINT)i; }
+    rp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV; rp[3].Descriptor.ShaderRegister = 0;
+    rp[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[4].Constants.ShaderRegister = 0; rp[4].Constants.Num32BitValues = 4;
+    for (int i = 0; i < 5; i++) rp[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_ROOT_SIGNATURE_DESC rsd;
+    memset(&rsd, 0, sizeof rsd);
+    rsd.NumParameters = 5; rsd.pParameters = rp;
+    ID3DBlob* sig = NULL; ID3DBlob* err = NULL;
+    hr = D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+    if (err) err->lpVtbl->Release(err);
+    if (FAILED(hr) || !sig) { cb->lpVtbl->Release(cb); return 0; }
+    hr = dev->lpVtbl->CreateRootSignature(dev, 0, sig->lpVtbl->GetBufferPointer(sig), sig->lpVtbl->GetBufferSize(sig),
+                                          &IID_ID3D12RootSignature, (void**)&s_rg_rs);
+    sig->lpVtbl->Release(sig);
+    if (FAILED(hr) || !s_rg_rs) { cb->lpVtbl->Release(cb); return 0; }
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pd;
+    memset(&pd, 0, sizeof pd);
+    pd.pRootSignature = s_rg_rs;
+    pd.CS.pShaderBytecode = cb->lpVtbl->GetBufferPointer(cb);
+    pd.CS.BytecodeLength = cb->lpVtbl->GetBufferSize(cb);
+    hr = dev->lpVtbl->CreateComputePipelineState(dev, &pd, &IID_ID3D12PipelineState, (void**)&s_rg_pso);
+    cb->lpVtbl->Release(cb);
+    if (FAILED(hr) || !s_rg_pso) return 0;
+    if (!nq) nq = 1u;
+    s_rg_q = rg_buffer(dev, (UINT64)nq * 8u, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_NONE,
+                       D3D12_RESOURCE_STATE_COMMON);
+    s_rg_qst = D3D12_RESOURCE_STATE_COMMON;
+    s_rg_qinfo = rg_buffer(dev, (UINT64)nq * 8u, D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_FLAG_NONE,
+                           D3D12_RESOURCE_STATE_GENERIC_READ);
+    s_rg_stage = rg_buffer(dev, (UINT64)RG_STAGE * 1024u, D3D12_HEAP_TYPE_DEFAULT,
+                           D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
+    s_rg_sst = D3D12_RESOURCE_STATE_COMMON;
+    s_rg_up = rg_buffer(dev, RG_RING, D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_FLAG_NONE,
+                        D3D12_RESOURCE_STATE_GENERIC_READ);
+    if (verify)
+        s_rg_vrb = rg_buffer(dev, (UINT64)RG_VMAX * 1024u, D3D12_HEAP_TYPE_READBACK, D3D12_RESOURCE_FLAG_NONE,
+                             D3D12_RESOURCE_STATE_COPY_DEST);
+    if (!s_rg_q || !s_rg_qinfo || !s_rg_stage || !s_rg_up || (verify && !s_rg_vrb)) return 0;
+    D3D12_RANGE nr = {0, 0};
+    if (FAILED(s_rg_qinfo->lpVtbl->Map(s_rg_qinfo, 0, &nr, (void**)&s_rg_qinfom)) || !s_rg_qinfom ||
+        FAILED(s_rg_up->lpVtbl->Map(s_rg_up, 0, &nr, (void**)&s_rg_upm)) || !s_rg_upm) return 0;
+    /* the pool: the descriptor vp_upload_tex_slot creates for this texture
+     * (DEFAULT heap, TEXTURE2D, w x h, one level, R16G16_UNORM, no flags) */
+    for (uint32_t h = 1; h <= 4u; h++)
+        for (uint32_t k = 0; k < RG_K; k++) {
+            D3D12_HEAP_PROPERTIES hp;
+            memset(&hp, 0, sizeof hp);
+            hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+            D3D12_RESOURCE_DESC td;
+            memset(&td, 0, sizeof td);
+            td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+            td.Width = 4; td.Height = h; td.DepthOrArraySize = 1; td.MipLevels = 1;
+            td.Format = DXGI_FORMAT_R16G16_UNORM; td.SampleDesc.Count = 1;
+            td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+            if (FAILED(dev->lpVtbl->CreateCommittedResource(dev, &hp, D3D12_HEAP_FLAG_NONE, &td,
+                    D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_rg_pool[h - 1u][k])))
+                return 0;
+            s_rg_pst[h - 1u][k] = D3D12_RESOURCE_STATE_COPY_DEST;
+        }
+    return 1;
+}
+
+/* Init and publish: 1 ready, -1 not (logged), with how long it took. */
+static void rg_init_publish(const char* where)
+{
+    LARGE_INTEGER f, t0, t1;
+    QueryPerformanceFrequency(&f); QueryPerformanceCounter(&t0);
+    const int ok = s_rg_init.dev && rg_init(s_rg_init.dev, s_rg_init.nq, s_rg_init.verify);
+    QueryPerformanceCounter(&t1);
+    const double ms = (double)(t1.QuadPart - t0.QuadPart) * 1000.0 / (double)f.QuadPart;
+    if (ok)
+        fprintf(stderr, "[REPORT-GPU] a consumer's record texels are composed on the GPU (REPORT_GPU=1; =0 the flush and"
+                        " wait per consumer): ready in %.1f ms (%s)%s%c", ms, where,
+                s_rg_init.verify ? ", REPORT_GPU_VERIFY on" : "", 10);
+    else
+        fprintf(stderr, "[REPORT-GPU] the compose pipeline is unavailable (%.1f ms, %s): reports delivered as before%c",
+                ms, where, 10);
+    InterlockedExchange(&s_rg_ok, ok ? 1 : -1);
+}
+static DWORD WINAPI rg_init_thread(LPVOID p)
+{
+    (void)p;
+    rg_init_publish("its own thread, at device init");
+    return 0;
+}
+
+void rsx_rgpu_prewarm(ID3D12Device* dev, uint32_t capacity)
+{
+    if (!dev || InterlockedCompareExchange(&s_rg_ok, 2, 0) != 0) return;   /* started already */
+    s_rg_init.dev = dev; s_rg_init.nq = capacity; s_rg_init.verify = rsx_report_gpu_verify();
+    HANDLE th = CreateThread(NULL, 0, rg_init_thread, NULL, 0, NULL);
+    if (th) CloseHandle(th);
+    else rg_init_publish("inline: no thread");
+}
+
+int rsx_rgpu_ready(ID3D12Device* dev, uint32_t fmt, uint32_t w, uint32_t h)
+{
+    if (!rg_shape_ok(fmt, w, h) || s_zq_ok != 1) return 0;
+    const LONG st = s_rg_ok;
+    if (st == 1) return 1;
+    if (st == 0 && dev && InterlockedCompareExchange(&s_rg_ok, 2, 0) == 0) {   /* no prewarm (tests): here */
+        s_rg_init.dev = dev; s_rg_init.nq = s_zq_cap; s_rg_init.verify = rsx_report_gpu_verify();
+        rg_init_publish("on first use");
+        return s_rg_ok == 1;
+    }
+    return 0;          /* being made on its thread (the old delivery meanwhile), or unavailable */
+}
+
+/* The texture a live plan composes into, its rows obtainable (the prepass
+ * binds only then, so the replay's compose cannot fail); NULL otherwise. */
+ID3D12Resource* rsx_rgpu_texture(uint32_t id, uint32_t* ea, uint32_t* fmt)
+{
+    if (s_rg_ok != 1) return NULL;
+    rsx_rplan_row row[4];
+    const int h = rsx_report_plan_rows(id, row, ea, fmt);
+    if (h < 1 || h > 4) return NULL;
+    return s_rg_pool[h - 1][id % RG_K];
+}
+
+void rsx_rgpu_list_begin(void)
+{
+    if (s_rg_ok != 1) return;
+    s_rg_qwm = 0; s_rg_iwm = 0; s_rg_upo = 0; s_rg_snext = 0; s_rg_vn = 0;
+    s_rg_qst = s_rg_sst = D3D12_RESOURCE_STATE_COMMON;   /* buffers: COMMON once their last list ran */
+    memset(s_rg_done, 0, sizeof s_rg_done);
+}
+
+void rsx_rgpu_list_end(ID3D12GraphicsCommandList* cl)
+{
+    (void)cl;
+    if (s_rg_ok != 1) return;
+    s_rg_vpend = s_rg_vn;
+    if (s_rg_upo) s_rg_lists++;
+}
+
+void rsx_rgpu_reset(void)
+{
+    s_rg_qwm = s_rg_iwm = s_rg_upo = s_rg_snext = s_rg_vn = s_rg_vpend = 0;
+    s_rg_qst = s_rg_sst = D3D12_RESOURCE_STATE_COMMON;
+    memset(s_rg_done, 0, sizeof s_rg_done);
+}
+
+/* The span [qa, qb) of this list's queries recorded so far that holds every
+ * query of segments lo..hi (the shader sums only those inside it: no order is
+ * assumed); [0, 0) when there is none. */
+static void rg_seg_span(uint32_t lo, uint32_t hi, uint32_t* qa, uint32_t* qb)
+{
+    uint32_t a = 0, b = 0;
+    int any = 0;
+    for (uint32_t q = 0; q < s_zq_n; q++)
+        if (s_zq_seg[q] >= lo && s_zq_seg[q] <= hi) { if (!any) a = q; b = q + 1u; any = 1; }
+    *qa = any ? a : 0u; *qb = any ? b : 0u;
+}
+
+int rsx_rgpu_compose(ID3D12GraphicsCommandList* cl, uint32_t id)
+{
+    if (s_rg_ok != 1) { s_rg_bug++; return -1; }
+    rsx_rplan_row row[4];
+    uint32_t ea = 0, fmt = 0;
+    const int h = rsx_report_plan_rows(id, row, &ea, &fmt);
+    if (h < 1 || h > 4) { s_rg_bug++; return -1; }
+    const uint32_t k = id % RG_K;
+    if (s_rg_done[h - 1][k] == id) return 0;
+    if (s_rg_upo + RG_PLANB > RG_RING) {                 /* more composes than live plans: cannot happen */
+        s_rg_bug++;
+        static int n = 0; if (n++ < 4) fprintf(stderr, "[REPORT-GPU] BUG: plan data full in one list%c", 10);
+        return -1;
+    }
+    uint8_t* pd = s_rg_upm + s_rg_upo;
+    memset(pd, 0, RG_PLANB);
+    for (int r = 0; r < h; r++) {
+        uint32_t* o = (uint32_t*)(pd + 64 * r);
+        o[0] = row[r].mode;
+        o[1] = row[r].w[0]; o[2] = row[r].w[1]; o[3] = row[r].w[2]; o[4] = row[r].w[3];
+        if (row[r].mode == 0) {
+            o[5] = (uint32_t)row[r].base; o[6] = (uint32_t)(row[r].base >> 32);
+            rg_seg_span(row[r].lo, row[r].hi, &o[7], &o[8]);
+            o[9] = row[r].lo; o[10] = row[r].hi;
+        }
+    }
+    /* this list's queries so far: counts resolved, segments and divisors written */
+    if (s_zq_n > s_rg_qwm) {
+        rg_bar(cl, s_rg_q, &s_rg_qst, D3D12_RESOURCE_STATE_COPY_DEST);
+        cl->lpVtbl->ResolveQueryData(cl, s_zq_heap, D3D12_QUERY_TYPE_OCCLUSION, s_rg_qwm, s_zq_n - s_rg_qwm,
+                                     s_rg_q, (UINT64)s_rg_qwm * 8u);
+        s_rg_qwm = s_zq_n;
+    }
+    for (; s_rg_iwm < s_zq_n; s_rg_iwm++) {
+        s_rg_qinfom[2u * s_rg_iwm] = s_zq_seg[s_rg_iwm];
+        s_rg_qinfom[2u * s_rg_iwm + 1u] = s_zq_div[s_rg_iwm];
+    }
+    rg_bar2(cl, s_rg_q, &s_rg_qst, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+            s_rg_stage, &s_rg_sst, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    const uint32_t slot = s_rg_snext++ % RG_STAGE;
+    cl->lpVtbl->SetComputeRootSignature(cl, s_rg_rs);
+    cl->lpVtbl->SetPipelineState(cl, s_rg_pso);
+    cl->lpVtbl->SetComputeRootShaderResourceView(cl, 0, s_rg_q->lpVtbl->GetGPUVirtualAddress(s_rg_q));
+    cl->lpVtbl->SetComputeRootShaderResourceView(cl, 1, s_rg_up->lpVtbl->GetGPUVirtualAddress(s_rg_up) + s_rg_upo);
+    cl->lpVtbl->SetComputeRootShaderResourceView(cl, 2, s_rg_qinfo->lpVtbl->GetGPUVirtualAddress(s_rg_qinfo));
+    cl->lpVtbl->SetComputeRootUnorderedAccessView(cl, 3, s_rg_stage->lpVtbl->GetGPUVirtualAddress(s_rg_stage));
+    const uint32_t kc[4] = { slot * 1024u, (uint32_t)h, 0u, 0u };
+    cl->lpVtbl->SetComputeRoot32BitConstants(cl, 4, 4, kc, 0);
+    cl->lpVtbl->Dispatch(cl, 1, 1, 1);
+    ID3D12Resource* pool = s_rg_pool[h - 1][k];
+    rg_bar2(cl, s_rg_stage, &s_rg_sst, D3D12_RESOURCE_STATE_COPY_SOURCE, pool, &s_rg_pst[h - 1][k],
+            D3D12_RESOURCE_STATE_COPY_DEST);
+    D3D12_TEXTURE_COPY_LOCATION dst, src;
+    memset(&dst, 0, sizeof dst); memset(&src, 0, sizeof src);
+    dst.pResource = pool; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; dst.SubresourceIndex = 0;
+    src.pResource = s_rg_stage; src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    src.PlacedFootprint.Offset = (UINT64)slot * 1024u;
+    src.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R16G16_UNORM;
+    src.PlacedFootprint.Footprint.Width = 4; src.PlacedFootprint.Footprint.Height = (UINT)h;
+    src.PlacedFootprint.Footprint.Depth = 1; src.PlacedFootprint.Footprint.RowPitch = 256;
+    cl->lpVtbl->CopyTextureRegion(cl, &dst, 0, 0, 0, &src, NULL);
+    if (s_rg_vrb) {                                      /* REPORT_GPU_VERIFY: the footprint read back */
+        if (s_rg_vn < RG_VMAX) {
+            cl->lpVtbl->CopyBufferRegion(cl, s_rg_vrb, (UINT64)s_rg_vn * 1024u, s_rg_stage, (UINT64)slot * 1024u, 1024u);
+            RgVer* v = &s_rg_ver[s_rg_vn++];
+            v->id = id; v->h = (uint32_t)h; v->fmt = fmt;
+            memcpy(v->row, row, sizeof row);
+        } else s_rg_vskip++;
+    }
+    rg_bar2(cl, pool, &s_rg_pst[h - 1][k], D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, s_rg_stage, &s_rg_sst,
+            D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    s_rg_upo += RG_PLANB;
+    s_rg_done[h - 1][k] = id;
+    s_rg_n++;
+    return 1;
+}
+
+/* REPORT_GPU_VERIFY, after the GPU ran the list: each composed row against what
+ * the exact path gives at that draw -- the record bytes (the timer, the value
+ * by deliver_n's own formula over the now complete segments, or the delivered
+ * value; the raw words for a row with nothing pending) through the CPU
+ * upload's decoder -- and each composed value against the value the report's
+ * delivery writes (rsx_report_verify_gpu_value). */
+void rsx_rgpu_collected(void)
+{
+    if (!s_rg_vpend || !s_rg_vrb) { s_rg_vpend = 0; return; }
+    const uint32_t nv = s_rg_vpend;
+    s_rg_vpend = 0;
+    const uint8_t* m = NULL;
+    D3D12_RANGE rr = {0, (SIZE_T)nv * 1024u};
+    if (FAILED(s_rg_vrb->lpVtbl->Map(s_rg_vrb, 0, &rr, (void**)&m)) || !m) return;
+    for (uint32_t i = 0; i < nv; i++) {
+        const RgVer* v = &s_rg_ver[i];
+        for (uint32_t r = 0; r < v->h; r++) {
+            const rsx_rplan_row* w = &v->row[r];
+            uint32_t W[4];
+            if (w->mode == 2) memcpy(W, w->w, sizeof W);
+            else {
+                uint32_t val = 0;
+                if (!rsx_report_seq_value(w->seq, &val)) { s_rg_vunk++; continue; }
+                W[0] = w->w[0]; W[1] = w->w[1]; W[2] = val; W[3] = 0;
+            }
+            uint8_t be[16], want[16];
+            for (int k = 0; k < 4; k++) {
+                be[4 * k] = (uint8_t)(W[k] >> 24); be[4 * k + 1] = (uint8_t)(W[k] >> 16);
+                be[4 * k + 2] = (uint8_t)(W[k] >> 8); be[4 * k + 3] = (uint8_t)W[k];
+            }
+            rsx_tex_layout tl;
+            rsx_texture_layout_pitched(v->fmt, 4u, 1u, 16u, &tl);
+            rsx_texture_decode(want, 16u, be, 4u, 1u, &tl, 0);
+            const uint8_t* got = m + (size_t)i * 1024u + (size_t)r * 256u;
+            s_rg_vrows++;
+            if (memcmp(got, want, 16)) {
+                s_rg_vbad++;
+                static int n = 0; if (n++ < 16)
+                    fprintf(stderr, "[RPTVER] MISMATCH plan %u row %u (mode %u, report #%u): composed "
+                                    "%02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X, the exact"
+                                    " path's texels %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X%c",
+                            v->id, r, w->mode, w->seq,
+                            got[0], got[1], got[2], got[3], got[4], got[5], got[6], got[7],
+                            got[8], got[9], got[10], got[11], got[12], got[13], got[14], got[15],
+                            want[0], want[1], want[2], want[3], want[4], want[5], want[6], want[7],
+                            want[8], want[9], want[10], want[11], want[12], want[13], want[14], want[15], 10);
+            }
+            if (w->mode != 2) {                          /* the composed value word, back from its texel */
+                const uint32_t t = (uint32_t)got[8] | ((uint32_t)got[9] << 8) | ((uint32_t)got[10] << 16) |
+                                   ((uint32_t)got[11] << 24);
+                rsx_report_verify_gpu_value(w->seq, (t << 16) | (t >> 16));
+            }
+        }
+    }
+    D3D12_RANGE wr = {0, 0};
+    s_rg_vrb->lpVtbl->Unmap(s_rg_vrb, 0, &wr);
+    if (++s_rg_vlists % 120u == 1u || s_rg_vbad) {
+        static unsigned long long last_bad = ~0ull;
+        if (s_rg_vlists % 120u == 1u || s_rg_vbad != last_bad) {
+            unsigned long long dc = 0, db = 0;
+            rsx_report_verify_counts(&dc, &db);
+            fprintf(stderr, "[RPTVER] %llu lists with composes (%llu in all): %llu composes, %llu rows compared with the exact path's"
+                            " texels, %llu differ, %llu not comparable, %llu not read back; delivered values compared"
+                            " with the GPU's %llu, %llu differ; bugs %llu%c",
+                    s_rg_vlists, s_rg_lists, s_rg_n, s_rg_vrows, s_rg_vbad, s_rg_vunk, s_rg_vskip, dc, db, s_rg_bug, 10);
+            last_bad = s_rg_vbad;
+        }
+    }
+}
+
+void rsx_d3d12_snapshot_copy(ID3D12GraphicsCommandList* cl,
+                             ID3D12Resource* dst, D3D12_RESOURCE_STATES* dst_state,
+                             ID3D12Resource* src, D3D12_RESOURCE_STATES src_state)
+{
+    barrier(cl, src, src_state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    barrier(cl, dst, *dst_state, D3D12_RESOURCE_STATE_COPY_DEST);
+    cl->lpVtbl->CopyResource(cl, dst, src);
+    barrier(cl, dst, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    barrier(cl, src, D3D12_RESOURCE_STATE_COPY_SOURCE, src_state);
+    *dst_state = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+}
+#else
+typedef int rsx_d3d12_report_not_built;   /* D3D12 only: an empty unit elsewhere */
+#endif /* _WIN32 */
diff --git a/libs/video/rsx_d3d12_report.h b/libs/video/rsx_d3d12_report.h
new file mode 100644
index 0000000..0dfcf37
--- /dev/null
+++ b/libs/video/rsx_d3d12_report.h
@@ -0,0 +1,76 @@
+/*
+ * ps3recomp - the D3D12 half of exact ZPASS reports and copy-on-sample
+ * (rsx_d3d12_report.c). rsx_d3d12_backend.c calls these around its replay;
+ * libs/video/tests/test_report_d3d12.c runs them on WARP.
+ */
+#ifndef RSX_D3D12_REPORT_H
+#define RSX_D3D12_REPORT_H
+
+#ifdef _WIN32
+#include <stdint.h>
+#include <d3d12.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Occlusion queries, one per counted draw: D3D12_QUERY_TYPE_OCCLUSION is the
+ * exact number of samples that pass the depth and stencil tests (one sample per
+ * pixel without MSAA), what the RSX's ZPASS counter counts. */
+int  rsx_zpass_init(ID3D12Device* dev, uint32_t capacity);   /* 1 ready, 0 unavailable (logged once) */
+int  rsx_zpass_begin(ID3D12GraphicsCommandList* cl, uint32_t seg);   /* query index, -1 = full / unavailable */
+void rsx_zpass_end(ID3D12GraphicsCommandList* cl, int q);
+/* RES_SCALE: query q (this list) counts a target scaled by kx * ky = div; its
+ * count is normalised to guest pixels at collect (rsx_rs_norm_count). */
+void rsx_zpass_set_div(int q, uint32_t div);
+/* Before the list closes: its queries into the readback buffer. */
+void rsx_zpass_resolve(ID3D12GraphicsCommandList* cl);
+/* Queries resolved into the readback buffer and not yet collected. */
+uint32_t rsx_zpass_resolved(void);
+/* Once the GPU has run that list: each query's count to its segment
+ * (rsx_report_add_samples). Returns the number collected. */
+uint32_t rsx_zpass_collect(void);
+/* A save-state load (rsx_d3d12_backend_ss_reset, the GPU idle): drop every
+ * query recorded or resolved and not collected -- their counts belong to the
+ * state being thrown away, whose report segments GCM_'s restore replaces.
+ * Returns how many were dropped. */
+uint32_t rsx_zpass_reset(void);
+
+/* ---- PF6 REPORT_GPU (rsx_report.h): a planned unit's record texels ---------
+ * composed on the GPU in the command list of the draw that samples them. */
+/* At device init (REPORT_GPU): make the compose pipeline and its resources on
+ * a thread of their own (capacity: the query heap's), so the first lamp does
+ * not wait for D3DCompile and ~140 resources. */
+void rsx_rgpu_prewarm(ID3D12Device* dev, uint32_t capacity);
+/* 1 when a 4 x h texture of format byte fmt can be composed now (the CPU
+ * upload would make it R16G16_UNORM, linear rows of 16 bytes, 1 level); 0
+ * while the pipeline is still being made (the old delivery meanwhile) or if it
+ * could not be (logged). Without a prewarm it is made here, on first use. */
+int  rsx_rgpu_ready(ID3D12Device* dev, uint32_t fmt, uint32_t w, uint32_t h);
+/* The texture plan `id` is composed into (the prepass binds the unit's view to
+ * it); NULL if the plan is not live or its rows cannot be had -- then the
+ * prepass falls back. *ea / *fmt: the plan's texture. */
+ID3D12Resource* rsx_rgpu_texture(uint32_t id, uint32_t* ea, uint32_t* fmt);
+/* A new command list; its end (before rsx_zpass_resolve); after the GPU ran it
+ * and its queries were collected (REPORT_GPU_VERIFY reads its composes back). */
+void rsx_rgpu_list_begin(void);
+void rsx_rgpu_list_end(ID3D12GraphicsCommandList* cl);
+void rsx_rgpu_collected(void);
+/* Before the draw of a record that samples plan `id`: compose its texels
+ * unless this list already did. 1 = a compute pass was recorded (the caller's
+ * graphics pipeline must be set again), 0 = nothing to do, -1 = a bug (counted). */
+int  rsx_rgpu_compose(ID3D12GraphicsCommandList* cl, uint32_t id);
+/* A save-state load (the GPU idle): nothing composed, nothing to verify. */
+void rsx_rgpu_reset(void);
+
+/* Copy-on-sample: dst := src. src is left in src_state (a bound render target:
+ * RENDER_TARGET), dst ends in PIXEL_SHADER_RESOURCE (*dst_state tracks it). */
+void rsx_d3d12_snapshot_copy(ID3D12GraphicsCommandList* cl,
+                             ID3D12Resource* dst, D3D12_RESOURCE_STATES* dst_state,
+                             ID3D12Resource* src, D3D12_RESOURCE_STATES src_state);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* _WIN32 */
+#endif /* RSX_D3D12_REPORT_H */
diff --git a/libs/video/rsx_display.h b/libs/video/rsx_display.h
new file mode 100644
index 0000000..3d40ff5
--- /dev/null
+++ b/libs/video/rsx_display.h
@@ -0,0 +1,48 @@
+/*
+ * ps3recomp - display configuration and presentation aspect (host window)
+ *
+ * The presenting backend (rsx_d3d12_backend.c; stubs elsewhere) reads
+ * display.ini the way cellPad reads input.ini:
+ *   DISPLAY_CONFIG=<file> (or "none"), else the first of .\display.ini,
+ *   .\config\display.ini and display.ini next to the exe; then
+ *   DISPLAY_CFG="name=value|name=value" overrides single settings, and
+ *   RSX_FULLSCREEN / RSX_WINDOW / RSX_MONITOR override those three.
+ * Backend keys: fullscreen, window, monitor, present, dpi_aware. Any other
+ * key is kept for the title (e.g. aspect, hud, lod, fmv) and read with
+ * rsx_display_cfg_get().
+ *
+ * Content aspect: the guest renders a fixed-size image (1280x720). A title
+ * that renders it anamorphically -- a wider (or narrower) field of view
+ * squeezed into the same buffer -- tells the backend the aspect the image
+ * really has; the window is then sized to it and the image is shown at that
+ * aspect, with black bars when the window's shape differs. Never called:
+ * the buffer's own aspect, exactly the old presentation.
+ */
+#ifndef PS3RECOMP_RSX_DISPLAY_H
+#define PS3RECOMP_RSX_DISPLAY_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Raw value of a display.ini setting (after env overrides), or NULL. */
+const char* rsx_display_cfg_get(const char* key);
+
+/* Override a setting (a title's own env variable, e.g. IF2_ASPECT). Takes
+ * effect for the window only when called before the backend creates it. */
+void rsx_display_cfg_set(const char* key, const char* value);
+
+/* Width/height of the monitor the game window opens on (display.ini
+ * "monitor", default the primary monitor), or 0 when unknown. Fills the
+ * monitor's pixel size when w/h are not NULL. */
+double rsx_display_target_aspect(int* w, int* h);
+
+/* The aspect the guest image represents; <= 0 restores the buffer's own.
+ * Callable at any time: before the window exists it also sets the window's
+ * default shape; afterwards it re-lays the image out in the window. */
+void rsx_display_set_content_aspect(double aspect);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* PS3RECOMP_RSX_DISPLAY_H */
