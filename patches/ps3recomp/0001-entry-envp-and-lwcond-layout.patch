+int ss_config_from_env(ss_config* c)
+{
+    ss_default_config(c);
+    if (env_off("SAVESTATES")) return 0;              /* everything stays off */
+    if (!ss_ui_cfg_int("enabled", 1)) return 0;       /* savestates.ini: enabled = 0 (M5), the same */
+    c->on = 1;
+    { const char* e = getenv("SS_CENSUS"); if (e && *e && atof(e) > 0) c->period_s = atof(e); }
+    { const char* s = getenv("SS_CENSUS_START"); if (s && *s) c->start_s = atof(s); }
+    c->tier1_ms       = env_u("SS_TIER1_MS", c->tier1_ms);
+    c->timeout_ms     = env_u("SS_TIMEOUT_MS", c->timeout_ms);
+    c->spu_timeout_ms = env_u("SS_SPU_TIMEOUT_MS", c->spu_timeout_ms);
+    c->capture_grace_ms = env_u("SS_CAPTURE_GRACE_MS", c->capture_grace_ms);
+    c->slice_ms       = env_u("SS_SLICE_MS", c->slice_ms);
+    c->retries        = (int)env_u("SS_RETRIES", (unsigned)c->retries);
+    c->retry_gap      = env_u("SS_RETRY_GAP", c->retry_gap);
+    c->bridge_park    = (int)env_u("SS_BRIDGE_PARK", (unsigned)c->bridge_park);
+    c->spu            = (int)env_u("SS_SPU", (unsigned)c->spu);
+    c->spu_expect     = (int)env_u("SS_SPU_EXPECT", (unsigned)c->spu_expect);
+    c->verbose        = (int)env_u("SS_VERBOSE", 0);
+    { const char* p = getenv("SS_CHAINS");
+      if (p && *p) {
+          if (!strcmp(p, "-")) c->chains_path[0] = 0;
+          else { strncpy(c->chains_path, p, sizeof c->chains_path - 1);
+                 c->chains_path[sizeof c->chains_path - 1] = 0; }
+      } }
+    parse_times(getenv("SS_SAVE_AT"), c->save_at, &c->n_save_at);
+    parse_times(getenv("SS_DUMP"), c->dump_at, &c->n_dump_at);
+    { const char* e = getenv("SS_SELFTEST_EVERY"); if (e && *e && atof(e) > 0) c->selftest_every_s = atof(e); }
+    { const char* e = getenv("SS_SELFTEST_AB");    if (e && *e && atof(e) > 0) c->selftest_ab_s = atof(e); }
+    { const char* e = getenv("SS_SELFTEST_START"); if (e && *e) c->selftest_start_s = atof(e); }
+    { const char* e = getenv("SS_VERIFY");         if (e && *e) c->verify = atoi(e) ? 1 : 0; }
+    c->discard_ms = env_u("SS_DISCARD_MS", c->discard_ms);
+    c->fatal_box  = !env_off("SS_FATAL_BOX");
+    { const char* p = getenv("SS_SPU_AUDITED");
+      if (p && *p) { strncpy(c->spu_audited, p, sizeof c->spu_audited - 1);
+                     c->spu_audited[sizeof c->spu_audited - 1] = 0; } }
+    return 1;
+}
