+static void test_outputs(void)
+{
+    printf("-- actuators\n");
+    unsigned char last[4];
+    int a = attach("R", 0, 0);
+    int p = padhost_virtual_port(a);
+    CHECK(p == 0, "port 0");
+    int c = wait_outputs(a, 1, 500, last);
+    padhost_set_actuator(p, 1, 200);
+    c = wait_outputs(a, 2, 500, last);
+    CHECK(c == 2 && last[1] == 1 && last[2] == 200 && last[3] == 0, "rumble sent (%d: %u %u)", c, last[1], last[2]);
+    padhost_set_actuator(p, 1, 200);
+    padhost_set_actuator(p, 1, 200);
+    Sleep(150);
+    CHECK(outputs(a, last) == 2, "unchanged values send nothing");
+    padhost_set_actuator(p, 7, 10);                 /* any non-zero small = on */
+    padhost_set_actuator(p, 1, 20);                 /* within PH_OUT_MIN_MS of each other */
+    Sleep(60);
+    c = outputs(a, last);
+    CHECK(c >= 3 && c <= 4 && last[1] == 1 && last[2] == 20, "rate-limited, last value wins (%d: %u %u)", c, last[1], last[2]);
+    padhost_config_set("rumble", "50");
+    padhost_set_actuator(p, 0, 200);
+    c = wait_outputs(a, c + 1, 500, last);
+    CHECK(last[1] == 0 && last[2] == 100, "rumble=50 halves the large motor (%u)", last[2]);
+    padhost_config_set("rumble", "0");
+    padhost_set_actuator(p, 1, 255);
+    Sleep(150);
+    outputs(a, last);
+    CHECK(last[1] == 0 && last[2] == 0, "rumble=0: motors stay off (%u %u)", last[1], last[2]);
+    padhost_config_set("rumble", "100");
+    padhost_set_actuator(p, 0, 0);
+    Sleep(50);
+    padhost_virtual_detach(a);
+
+    /* periodic refresh for devices that stop rumbling on their own */
+    a = attach("S", 30, 0);
+    p = padhost_virtual_port(a);
+    wait_outputs(a, 1, 500, last);
+    padhost_set_actuator(p, 0, 90);
+    int c0 = wait_outputs(a, 2, 500, last);
+    Sleep(320);
+    int c1 = outputs(a, last);
+    CHECK(c1 - c0 >= 6 && c1 - c0 <= 13, "refresh every 30 ms while running (%d in 320 ms)", c1 - c0);
+    padhost_set_actuator(p, 0, 0);
+    Sleep(60);
+    c0 = outputs(a, last);
+    Sleep(200);
+    c1 = outputs(a, last);
+    CHECK(c1 == c0 && last[2] == 0, "no refresh once stopped (%d -> %d)", c0, c1);
+    padhost_virtual_detach(a);
+}
