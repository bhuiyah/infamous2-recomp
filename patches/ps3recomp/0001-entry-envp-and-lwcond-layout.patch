+    s_sc_nfuncs.store(0); s_sc_checks.store(0); s_sc_mismatches.store(0);
+    t_sc_batch = 0; t_sc_last_func = 0; t_sc_last_slot = 0;
+    s_sc_state.store(0);
+}
