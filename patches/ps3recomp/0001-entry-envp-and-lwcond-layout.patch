+/* DS4 over USB: 0x02 calibration in the USB order with an accel bias. */
+static void test_ds4_usb(void)
+{
+    printf("DS4 USB: open (calibration 0x02, MAC 0x12), full report, output 0x05\n");
+    mock_reset();
+    u8 cal[37] = { 0x02 };
+    const short calv[17] = { 5, 0, 0,  9000, -9000, 9000, -9000, 9000, -9000,  540, 540,
+                             8300, -8100, 8192, -8192, 8192, -8192 };
+    for (int i = 0; i < 17; i++) { cal[1 + 2 * i] = (u8)calv[i]; cal[2 + 2 * i] = (u8)((u16)calv[i] >> 8); }
+    mock_feature(cal, 37, 1);                          /* first read fails: retried */
+    const u8 pair[16] = { 0x12, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66 };
+    mock_feature(pair, 16, 0);
+    PadHostDevice* d = new_dev(0x09CC, PADHOST_BUS_USB, 64, 32, 64);
+    CHECK_EQ(padhost_drv_ds4.open(d), 0);
+    CHECK_EQ(g_get_calls[0x02], 2);
+    CHECK(!strcmp(d->serial, "665544332211"));
+    CHECK_EQ(g_writes, 0);
+
+    u8 rep[64] = { 0x01 };
+    u8* c = rep + 1;
+    c[0] = 0; c[1] = 255; c[2] = 128; c[3] = 1;
+    c[4] = 0x10 | 0x80 | 0x07;            /* square, triangle, hat up-left */
+    c[5] = 0x02 | 0x04 | 0x10 | 0x40;     /* R1, L2, Share, L3 */
+    c[6] = 0x00;
+    c[7] = 0x7F; c[8] = 0x00;
+    /* gyro yaw 1010 counts * 1080/18000 = 60.6 deg/s -> 512 - 82.82 = 429.18 */
+    c[14] = (u8)(1010 & 0xFF); c[15] = (u8)(1010 >> 8);
+    /* accel x 8300 = +1 g with bias 100 -> 399; y 0 -> 512; z -8192 = -1 g -> 625 */
+    c[18] = (u8)(8300 & 0xFF); c[19] = (u8)(8300 >> 8);
+    c[22] = 0x00; c[23] = 0xE0;
+    c[29] = 0x10 | 0x04;                  /* cable, level 4 -> 45 % */
+    PadHostPortState st; fresh(&st);
+    CHECK_EQ(padhost_drv_ds4.parse(d, rep, 64, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_SQUARE | CELL_PAD_CTRL_TRIANGLE | CELL_PAD_CTRL_UP | CELL_PAD_CTRL_LEFT |
+                         CELL_PAD_CTRL_R1 | CELL_PAD_CTRL_L2 | CELL_PAD_CTRL_SELECT | CELL_PAD_CTRL_L3);
+    CHECK_EQ(st.ps, 0);
+    CHECK_EQ(st.lx, 0); CHECK_EQ(st.ly, 255); CHECK_EQ(st.rx, 128); CHECK_EQ(st.ry, 1);
+    CHECK_EQ(st.press[PADHOST_PRESS_L2], 0x7F); CHECK_EQ(st.press[PADHOST_PRESS_R2], 0);
+    CHECK_EQ(st.press[PADHOST_PRESS_SQUARE], 255); CHECK_EQ(st.press[PADHOST_PRESS_CROSS], 0);
+    CHECK_EQ(st.press[PADHOST_PRESS_UP], 255); CHECK_EQ(st.press[PADHOST_PRESS_R1], 255);
+    CHECK_EQ(st.has_pressure, 0); CHECK_EQ(st.has_motion, 1);
+    CHECK_EQ(st.sensor_x, 399); CHECK_EQ(st.sensor_y, 512); CHECK_EQ(st.sensor_z, 625);
+    CHECK_EQ(st.sensor_g, 429);
+    CHECK_EQ(st.battery, 45);
+
+    u8 out[64]; memset(out, 0xEE, sizeof out);
+    int n = padhost_drv_ds4.build_output(d, 1, 0x80, 0, out, (int)sizeof out);
+    CHECK_EQ(n, 32);
+    CHECK(same_bytes(out, vec_ds4_usb_out_p0, 32, "DS4 USB output"));
+
+    padhost_drv_ds4.close(d);
+    CHECK_EQ(g_writes, 1);
+    CHECK_EQ(g_last_write[4], 0); CHECK_EQ(g_last_write[5], 0);   /* motors off */
+}
