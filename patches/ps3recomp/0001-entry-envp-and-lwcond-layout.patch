diff --git a/libs/network/cellHttp.c b/libs/network/cellHttp.c
index d39d88d..49f4bd7 100644
--- a/libs/network/cellHttp.c
+++ b/libs/network/cellHttp.c
@@ -11,6 +11,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
+#include "../../runtime/savestate/ss_state.h"   /* field lists: this file's part of MISC */
 
 /* ---------------------------------------------------------------------------
  * Platform socket abstraction
@@ -900,3 +901,150 @@ s32 cellHttpAbortTransaction(CellHttpTransId transId)
     printf("[cellHttp] AbortTransaction(trans=%u)\n", transId);
     return CELL_OK;
 }
+
+/* ---------------------------------------------------------------------------
+ * Save states: cellHttp's part of the MISC section (runtime/savestate/
+ * ss_state.h), written by cellSysmodule.c, which registers the section.
+ *
+ * Restored offline (engine design 6.2): the clients and transactions keep
+ * their ids and everything the guest set -- method, URI, port, timeouts,
+ * request headers and content length, the status and length of a response
+ * already read -- but no connection. A socket is a host handle and never in
+ * the image, so a transaction that was connected comes back as one whose
+ * connection dropped: the next RecvResponse answers CONNECTION_FAILED, as a
+ * lost link would. (No strict stop catches a thread inside a socket call: a
+ * blocking send / recv is no safepoint, so that thread never parks.) The
+ * receive progress is in the image for inspection only (host-flagged: after
+ * a load it is 0, the fidelity check skips it); the header bytes read but
+ * not parsed yet go with the connection.
+ * -----------------------------------------------------------------------*/
+static const ss_field k_http_ss_fields[] = { SS_FIELD(s_http_initialized) };
+const ss_list cellHttp_ss_list = SS_LIST("http", k_http_ss_fields);
+static const ss_field k_http_ss_client_fields[] = {
+    SS_MEMBER(HttpClientSlot, resolve_timeout), SS_MEMBER(HttpClientSlot, connect_timeout),
+    SS_MEMBER(HttpClientSlot, send_timeout), SS_MEMBER(HttpClientSlot, recv_timeout),
+};
+const ss_list cellHttp_ss_clients_list = SS_LIST("http_clients", k_http_ss_client_fields);
+static const ss_field k_http_ss_trans_fields[] = {
+    SS_MEMBER(HttpTransSlot, client), SS_MEMBER(HttpTransSlot, method),
+    SS_MEMBER(HttpTransSlot, url), SS_MEMBER(HttpTransSlot, hostname),
+    SS_MEMBER(HttpTransSlot, path), SS_MEMBER(HttpTransSlot, port),
+    SS_MEMBER(HttpTransSlot, status_code), SS_MEMBER(HttpTransSlot, content_length),
+    SS_MEMBER(HttpTransSlot, content_length_known), SS_MEMBER(HttpTransSlot, request_content_length),
+    SS_MEMBER(HttpTransSlot, request_content_length_set), SS_MEMBER(HttpTransSlot, aborted),
+    SS_MEMBER(HttpTransSlot, custom_headers), SS_MEMBER(HttpTransSlot, custom_header_count),
+    SS_MEMBER_F(HttpTransSlot, headers_parsed, SS_FF_NO_RESTORE | SS_FF_HOST),
+    SS_MEMBER_F(HttpTransSlot, body_received, SS_FF_NO_RESTORE | SS_FF_HOST),
+    SS_MEMBER_F(HttpTransSlot, conn_close, SS_FF_NO_RESTORE | SS_FF_HOST),
+    SS_MEMBER_F(HttpTransSlot, eof_reached, SS_FF_NO_RESTORE | SS_FF_HOST),
+};
+const ss_list cellHttp_ss_transactions_list = SS_LIST("http_transactions", k_http_ss_trans_fields);
+
+/* The record iterators: i = 0, 1, 2, ...; -1 past the end, 0 a free slot,
+ * 1 = *rec is the slot, keyed by its id. */
+int cellHttp_ss_client(uint32_t i, uint32_t* key, const void** rec)
+{
+    if (i >= CELL_HTTP_MAX_CLIENTS) return -1;
+    if (!s_clients[i].in_use) return 0;
+    *key = i;
+    *rec = &s_clients[i];
+    return 1;
+}
+
+int cellHttp_ss_transaction(uint32_t i, uint32_t* key, const void** rec)
+{
+    if (i >= CELL_HTTP_MAX_TRANSACTIONS) return -1;
+    if (!s_transactions[i].in_use) return 0;
+    *key = i;
+    *rec = &s_transactions[i];
+    return 1;
+}
+
+/* At most what the records above take (staging sizing, outside a stop). */
+uint64_t cellHttp_ss_size(void)
+{
+    uint64_t n = 0;
+    for (u32 i = 0; i < CELL_HTTP_MAX_TRANSACTIONS; i++)
+        if (s_transactions[i].in_use) n += sizeof(HttpTransSlot);
+    return n + sizeof(s_clients);
+}
+
+/* A load (M4c; cellSysmodule.c reads the image, ss_read_fields writes the
+ * "http" list back). Teardown, every guest thread gone: the old state's
+ * sockets closed, no client, no transaction, not initialised. Winsock stays
+ * started (host). */
+void cellHttp_ss_teardown(void)
+{
+    for (u32 i = 0; i < CELL_HTTP_MAX_TRANSACTIONS; i++)
+        if (s_transactions[i].in_use) http_close_slot_socket(&s_transactions[i]);
+    memset(s_clients, 0, sizeof(s_clients));
+    memset(s_transactions, 0, sizeof(s_transactions));
+    for (u32 i = 0; i < CELL_HTTP_MAX_TRANSACTIONS; i++)
+        s_transactions[i].sock = HTTP_INVALID_SOCKET;
+    s_http_initialized = 0;
+}
+
+/* After the "http" list is back: an initialised state in a session that
+ * never started Winsock starts it (cellHttpInit's host side). */
+void cellHttp_ss_apply(void)
+{
+#ifdef _WIN32
+    if (s_http_initialized && !s_wsa_initialized) {
+        WSADATA wsa;
+        if (WSAStartup(MAKEWORD(2, 2), &wsa) == 0) s_wsa_initialized = 1;
+        else printf("[cellHttp] save state: WSAStartup failed -- the restored transactions cannot connect\n");
+    }
+#endif
+}
+
+/* The records' puts (i: the record's place, unused; rec: a zeroed copy of
+ * the struct with the listed members, so the receive state reads 0). A
+ * client: an id the guest holds; a transaction: an id, its client's id and a
+ * header count within their tables, the strings ending inside their buffers
+ * on apply -- restored offline (the comment above): no socket, nothing
+ * received. 0, or -1 with why. */
+const uint32_t cellHttp_ss_client_size      = (uint32_t)sizeof(HttpClientSlot);
+const uint32_t cellHttp_ss_transaction_size = (uint32_t)sizeof(HttpTransSlot);
+
+int cellHttp_ss_client_put(uint32_t i, uint32_t key, const void* rec, int apply, char* why, size_t n)
+{
+    (void)i;
+    if (key >= CELL_HTTP_MAX_CLIENTS) {
+        snprintf(why, n, "no client %u (%d clients)", key, CELL_HTTP_MAX_CLIENTS);
+        return -1;
+    }
+    if (!apply) return 0;
+    s_clients[key] = *(const HttpClientSlot*)rec;
+    s_clients[key].in_use = 1;
+    return 0;
+}
+
+int cellHttp_ss_transaction_put(uint32_t i, uint32_t key, const void* rec, int apply, char* why, size_t n)
+{
+    const HttpTransSlot* t = (const HttpTransSlot*)rec;
+    (void)i;
+    if (key >= CELL_HTTP_MAX_TRANSACTIONS || t->client >= CELL_HTTP_MAX_CLIENTS ||
+        t->custom_header_count > CELL_HTTP_MAX_CUSTOM_HEADERS) {
+        snprintf(why, n, "transaction %u, client %u, %u custom headers: outside the tables (%d, %d, %d)", key,
+                 (unsigned)t->client, t->custom_header_count, CELL_HTTP_MAX_TRANSACTIONS, CELL_HTTP_MAX_CLIENTS,
+                 CELL_HTTP_MAX_CUSTOM_HEADERS);
+        return -1;
+    }
+    if (!apply) return 0;
+    HttpTransSlot* s = &s_transactions[key];
+    *s = *t;
+    s->in_use = 1;
+    s->sock = HTTP_INVALID_SOCKET;
+    s->body_overflow = NULL;
+    s->body_overflow_len = 0;
+    s->hdr_buf_len = 0;
+    s->method[sizeof s->method - 1] = '\0';
+    s->url[sizeof s->url - 1] = '\0';
+    s->hostname[sizeof s->hostname - 1] = '\0';
+    s->path[sizeof s->path - 1] = '\0';
+    for (u32 h = 0; h < CELL_HTTP_MAX_CUSTOM_HEADERS; h++) {
+        s->custom_headers[h].name[sizeof s->custom_headers[h].name - 1] = '\0';
+        s->custom_headers[h].value[sizeof s->custom_headers[h].value - 1] = '\0';
+    }
+    return 0;
+}
