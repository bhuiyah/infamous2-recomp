+    void* mp = NULL;
+    D3D12_RANGE rr0 = {0, (SIZE_T)s_gp_rb_size};
+    if (ok && s_gp_nsub && (FAILED(s_gp_rb->lpVtbl->Map(s_gp_rb, 0, &rr0, &mp)) || !mp)) { ok = 0; mp = NULL; }
+    gp_rt_rec rr;
+    ss_recs_begin(w, &k_gp_rt_list);
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (!r->res) continue;
+        memset(&rr, 0, sizeof rr);
+        rr.off = r->off; rr.w = r->w; rr.h = r->h; rr.dxgi = r->dxgi; rr.st = (u32)r->st;
+        rr.used = (u32)r->used; rr.gpu_dirty = (u32)r->gpu_dirty; rr.rsx_fmt = r->rsx_fmt;
+        rr.guessed = (u32)r->guessed; rr.stamp = r->stamp; rr.hw = r->hw; rr.hh = r->hh;
+        rr.at = ok ? s_gp_rt_at[i] : GP_NONE;
+        ss_recs_add(w, (uint32_t)i, &rr);
+    }
+    ss_recs_end(w);
+    gp_z_rec zr;
+    ss_recs_begin(w, &k_gp_z_list);
+    for (int i = 0; i < MAX_ZETA; i++) {
+        const ZetaSurf* z = &s_zeta[i];
+        if (!z->res) continue;
+        memset(&zr, 0, sizeof zr);
+        zr.off = z->off; zr.w = z->w; zr.h = z->h; zr.stamp = z->stamp; zr.hw = z->hw; zr.hh = z->hh;
+        zr.rb_dirty = (u32)z->rb_dirty;
+        zr.at = ok ? s_gp_z_at[i] : GP_NONE;
+        ss_recs_add(w, (uint32_t)i, &zr);
+    }
+    ss_recs_end(w);
+    ss_blob_begin(w, "planes", 64);
+    if (mp) {
+        for (int k = 0; k < s_gp_nsub; k++) {
+            const gp_sub* s = &s_gp_sub[k];
+            for (u32 y = 0; y < s->rows; y++) {
+                void* d = ss_blob_reserve(w, s->row);
+                if (d) memcpy(d, (const u8*)mp + s->fp.Offset + (u64)y * s->fp.Footprint.RowPitch, (size_t)s->row);
+            }
+        }
+        D3D12_RANGE nw = {0, 0};
+        s_gp_rb->lpVtbl->Unmap(s_gp_rb, 0, &nw);
+    }
+    ss_blob_end(w);
+    return ss_writer_error(w);
+}
+
+/* A load's records into s_gp_in_* and the planes in place, every surface's
+ * dims, format and plane checked against the blob. Shared by check_image
+ * (nothing live written) and the restore. */
+typedef struct gp_parts { const u8* planes; uint64_t nplanes, rs_on; } gp_parts;
+static int gp_dxgi_ok(u32 f)
+{
+    return f == DXGI_FORMAT_R8G8B8A8_UNORM || f == DXGI_FORMAT_R16G16B16A16_FLOAT ||
+           f == DXGI_FORMAT_R32G32B32A32_FLOAT || f == DXGI_FORMAT_R32_FLOAT;
+}
+static int gp_dims_ok(u32 w, u32 h, u32 hw, u32 hh)
+{
+    return w && h && hw >= w && hh >= h && hw <= 16384u && hh <= 16384u;
+}
+/* A target's resource state as a barrier may name it: read states, or one write state alone. */
+static int gp_state_ok(u32 st)
+{
+    const u32 rd = (u32)(D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE |
+                         D3D12_RESOURCE_STATE_COPY_SOURCE);
+    const u32 wr = (u32)(D3D12_RESOURCE_STATE_RENDER_TARGET | D3D12_RESOURCE_STATE_UNORDERED_ACCESS |
+                         D3D12_RESOURCE_STATE_COPY_DEST);
+    if (st & ~(rd | wr)) return 0;
+    const u32 w = st & wr;
+    return !w || (st == w && !(w & (w - 1u)));
+}
+static int gp_parts_read(ss_reader* r, gp_parts* p)
+{
+    ss_recs_it it;
+    uint32_t key;
+    int e, k;
+    const void* pl = NULL;
+    memset(s_gp_in_rt_on, 0, sizeof s_gp_in_rt_on);
+    memset(s_gp_in_z_on, 0, sizeof s_gp_in_z_on);
+    if ((e = ss_find_blob(r, "planes", &pl, &p->nplanes)) != 0) return e;
+    p->planes = (const u8*)pl;
+    if ((e = ss_read_u64(r, "res_scale", &p->rs_on)) != 0) return e;
+    if ((e = ss_recs_open(r, &k_gp_rt_list, &it)) != 0) return e;
+    gp_rt_rec rr;
+    while ((k = ss_recs_next(&it, &key, &rr)) == 1) {
+        if (key >= MAX_OFF_RTS || s_gp_in_rt_on[key])
+            return ss_reader_fail(r, SS_E_CORRUPT, "targets: slot %u out of range or twice", key);
+        if (!gp_dxgi_ok(rr.dxgi) || !gp_dims_ok(rr.w, rr.h, rr.hw, rr.hh))
+            return ss_reader_fail(r, SS_E_CORRUPT, "targets[%u]: 0x%X %ux%u (host %ux%u) format %u", key,
+                                  rr.off, rr.w, rr.h, rr.hw, rr.hh, rr.dxgi);
+        if (!gp_state_ok(rr.st))
+            return ss_reader_fail(r, SS_E_CORRUPT, "targets[%u]: resource state 0x%X", key, rr.st);
+        if (rr.at != GP_NONE && (rr.at > p->nplanes ||
+                                 (u64)rr.hw * rr.hh * dxgi_bpp(rr.dxgi) > p->nplanes - rr.at))
+            return ss_reader_fail(r, SS_E_CORRUPT, "targets[%u]: plane at %llu past the planes (%llu bytes)", key,
+                                  (unsigned long long)rr.at, (unsigned long long)p->nplanes);
+        s_gp_in_rt[key] = rr; s_gp_in_rt_on[key] = 1;
+    }
+    if (k < 0) return k;
+    if ((e = ss_recs_open(r, &k_gp_z_list, &it)) != 0) return e;
+    gp_z_rec zr;
+    while ((k = ss_recs_next(&it, &key, &zr)) == 1) {
+        if (key >= MAX_ZETA || s_gp_in_z_on[key])
+            return ss_reader_fail(r, SS_E_CORRUPT, "zeta: slot %u out of range or twice", key);
+        if (!gp_dims_ok(zr.w, zr.h, zr.hw, zr.hh))
+            return ss_reader_fail(r, SS_E_CORRUPT, "zeta[%u]: 0x%X %ux%u (host %ux%u)", key, zr.off, zr.w, zr.h,
+                                  zr.hw, zr.hh);
+        if (zr.at != GP_NONE && (zr.at > p->nplanes || (u64)zr.hw * zr.hh * 5u > p->nplanes - zr.at))
+            return ss_reader_fail(r, SS_E_CORRUPT, "zeta[%u]: plane at %llu past the planes (%llu bytes)", key,
+                                  (unsigned long long)zr.at, (unsigned long long)p->nplanes);
+        s_gp_in_z[key] = zr; s_gp_in_z_on[key] = 1;
+    }
+    return k < 0 ? k : SS_OK;
+}
+static int gp_check_image(ss_reader* r)
+{
+    gp_parts p;
+    return gp_parts_read(r, &p);
+}
+
+/* As off_rt_get makes a target (resource in COPY_DEST, its RTV and SRV), at slot i. */
+static int gp_make_rt(int i, const gp_rt_rec* q)
+{
+    OffRT* r = &s_d3d.off_rt[i];
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td;
+    gp_desc(&td, q->hw, q->hh, q->dxgi);
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    if (q->hw != q->w || q->hh != q->h) td.Flags |= D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    D3D12_CLEAR_VALUE cv = {0};
+    cv.Format = td.Format;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+                   D3D12_RESOURCE_STATE_COPY_DEST, &cv, &IID_ID3D12Resource, (void**)&r->res))) {
+        r->res = NULL;
+        return 0;
+    }
+    { wchar_t nm[48]; swprintf(nm, 48, L"offrt_%X_%ux%u", q->off, q->w, q->h);
+      r->res->lpVtbl->SetName(r->res, nm); }
+    r->up = NULL;
+    r->off = q->off; r->w = q->w; r->h = q->h; r->dxgi = q->dxgi; r->hw = q->hw; r->hh = q->hh;
+    r->st = D3D12_RESOURCE_STATE_COPY_DEST;
+    r->used = (int)q->used; r->gpu_dirty = (int)q->gpu_dirty; r->rsx_fmt = q->rsx_fmt;
+    r->guessed = (int)q->guessed; r->stamp = q->stamp;
+    s_d3d.device->lpVtbl->CreateRenderTargetView(s_d3d.device, r->res, NULL, off_rt_rtv(i));
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = td.Format;
+    sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sv.Texture2D.MipLevels = 1;
+    D3D12_CPU_DESCRIPTOR_HANDLE sh;
+    s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &sh);
+    sh.ptr += (u64)(RT_SRV_BASE + i) * s_d3d.srv_inc;
+    s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, r->res, &sv, sh);
+    return 1;
+}
+/* As zeta_get_h makes a zeta (DEPTH_WRITE, its DSV and the depth / stencil
+ * SRVs of its alias slots), at slot i, not cleared. */
+static int gp_make_z(int i, const gp_z_rec* q)
+{
+    if (!s_zeta_heap) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        hd.NumDescriptors = MAX_ZETA;
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_DSV;
+        if (FAILED(s_d3d.device->lpVtbl->CreateDescriptorHeap(s_d3d.device, &hd, &IID_ID3D12DescriptorHeap,
+                                                               (void**)&s_zeta_heap)) || !s_zeta_heap) {
+            s_zeta_heap = NULL; return 0; }
+        s_zeta_inc = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(s_d3d.device,
+                                                                             D3D12_DESCRIPTOR_HEAP_TYPE_DSV);
+    }
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd;
+    gp_desc(&rd, q->hw, q->hh, DXGI_FORMAT_R24G8_TYPELESS);
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+    D3D12_CLEAR_VALUE cv = {0};
+    cv.Format = DXGI_FORMAT_D24_UNORM_S8_UINT; cv.DepthStencil.Depth = 1.0f;
+    ID3D12Resource* res = NULL;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                   D3D12_RESOURCE_STATE_DEPTH_WRITE, &cv, &IID_ID3D12Resource, (void**)&res)) || !res)
+        return 0;
+    D3D12_DEPTH_STENCIL_VIEW_DESC dv = {0};
+    dv.Format = DXGI_FORMAT_D24_UNORM_S8_UINT; dv.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2D;
+    s_d3d.device->lpVtbl->CreateDepthStencilView(s_d3d.device, res, &dv, zeta_dsv(i));
+    for (u32 k = 0; k < ZALIAS_PER_ZETA; k++) {
+        D3D12_CPU_DESCRIPTOR_HANDLE sh;
+        s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &sh);
+        sh.ptr += (SIZE_T)(ZCONV_BASE + 3u * ((u32)i * ZALIAS_PER_ZETA + k)) * s_d3d.srv_inc;
+        D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+        sv.Format = DXGI_FORMAT_R24_UNORM_X8_TYPELESS;
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        sv.Texture2D.MipLevels = 1;
+        s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, res, &sv, sh);
+        sh.ptr += s_d3d.srv_inc;
+        sv.Format = DXGI_FORMAT_X24_TYPELESS_G8_UINT;
+        sv.Texture2D.PlaneSlice = 1;
+        s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, res, &sv, sh);
+    }
+    ZetaSurf* z = &s_zeta[i];
+    memset(z, 0, sizeof *z);
+    z->res = res; z->off = q->off; z->w = q->w; z->h = q->h; z->hw = q->hw; z->hh = q->hh;
+    z->stamp = q->stamp; z->rb_dirty = (int)q->rb_dirty;
+    for (int k = 0; k < ZALIAS_PER_ZETA; k++) z->dirty[k] = 1;
+    s_zeta_rsgen[i] = s_rs_zgen;
+    return 1;
+}
+
+/* A LOAD, after rsx_d3d12_backend_ss_reset dropped the pool (the GPU idle, the
+ * frame-clock thread): the gate, redirect table and memw back, then every
+ * surface with a plane made again and its pixels uploaded in one list. */
+static int gp_restore(ss_reader* r)
+{
+    rt_drain();   /* R1 */
+    gp_parts p;
+    int e = gp_parts_read(r, &p);
+    if (e) return e;
+    if ((e = ss_read_fields(r, &k_gp_list)) != 0) return e;
+    if (s_rd_n < 0 || s_rd_n > (int)(sizeof s_rd_off / sizeof s_rd_off[0]) || s_memw_n < 0 || s_memw_n > MEMW_MAX) {
+        fprintf(stderr, "[D3D12] save-state load: redirect table %d / memw %d entries out of range -- both"
+                        " relearned%c", s_rd_n, s_memw_n, 10);   /* (a damaged image: never index with them) */
+        s_rd_n = 0; s_memw_n = 0;
+    }
+    static int on = -1;
+    if (on < 0) { const char* v = getenv("GPUP_RESTORE"); on = (v && *v == '0') ? 0 : 1; }
+    gp_probe_arm(0);
+    if (!on || !s_d3d.initialized || !s_d3d.rt_rtv_heap || !s_d3d.srv_heap || !rb_prepare(0)) {
+        /* the drop: no surfaces, and a gate / redirect table without them would point at nothing */
+        memset(&s_pgate, 0, sizeof s_pgate);
+        s_rd_n = 0; s_memw_n = 0;
+        return SS_OK;
+    }
+    LARGE_INTEGER qf, q0, q1;
+    QueryPerformanceFrequency(&qf); QueryPerformanceCounter(&q0);
+    unsigned n_rt = 0, n_z = 0, n_skip = 0;
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        if (!s_gp_in_rt_on[i]) continue;
+        const gp_rt_rec* q = &s_gp_in_rt[i];
+        u32 hw, hh;
+        rs_host_dims(q->w, q->h, &hw, &hh);
+        if (q->at == GP_NONE || hw != q->hw || hh != q->hh) { n_skip++; continue; }
+        if (gp_make_rt(i, q)) n_rt++; else n_skip++;
+    }
+    for (int i = 0; i < MAX_ZETA; i++) {
+        if (!s_gp_in_z_on[i]) continue;
+        const gp_z_rec* q = &s_gp_in_z[i];
+        const int scaled = q->hw != q->w || q->hh != q->h;
+        if (q->at == GP_NONE || (scaled && p.rs_on != (uint64_t)(u32)s_rs.on)) { n_skip++; continue; }
+        if (gp_make_z(i, q)) n_z++; else n_skip++;
+    }
+    if (n_z) s_zeta_gen++;
+    /* the planes: one upload buffer laid out as the readback was */
+    const u64 need = gp_plan();
+    ID3D12Resource* up = NULL;
+    u64 bytes = 0;
+    if (need) {
+        D3D12_HEAP_PROPERTIES hu = {0}; hu.Type = D3D12_HEAP_TYPE_UPLOAD;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        bd.Width = need; bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+        bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        void* mp = NULL;
+        D3D12_RANGE nr = {0, 0};
+        if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hu, D3D12_HEAP_FLAG_NONE, &bd,
+                       D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&up)) || !up ||
+            FAILED(up->lpVtbl->Map(up, 0, &nr, &mp)) || !mp) {
+            if (up) up->lpVtbl->Release(up);
+            up = NULL;
+        } else {
+            /* gp_plan put each surface's planes at the next "planes" offset; the
+             * image's offsets are the capture's: copy each surface from its own */
+            for (int k = 0; k < s_gp_nsub; k++) {
+                const gp_sub* s = &s_gp_sub[k];
+                u64 src = GP_NONE, first = GP_NONE;
+                for (int i = 0; i < MAX_OFF_RTS && src == GP_NONE; i++)
+                    if (s_d3d.off_rt[i].res == s->res) { src = s_gp_in_rt[i].at; first = s_gp_rt_at[i]; }
+                for (int i = 0; i < MAX_ZETA && src == GP_NONE; i++)
+                    if (s_zeta[i].res == s->res) { src = s_gp_in_z[i].at; first = s_gp_z_at[i]; }
+                if (src == GP_NONE || first == GP_NONE) continue;
+                const u64 at = src + (s->at - first);
+                if (at > p.nplanes || (u64)s->rows * s->row > p.nplanes - at) continue;
+                for (u32 y = 0; y < s->rows; y++)
+                    memcpy((u8*)mp + s->fp.Offset + (u64)y * s->fp.Footprint.RowPitch,
+                           p.planes + at + (u64)y * s->row, (size_t)s->row);
+                bytes += (u64)s->rows * s->row;
+            }
+            up->lpVtbl->Unmap(up, 0, NULL);
+        }
+    }
+    s_rb_alloc->lpVtbl->Reset(s_rb_alloc);
+    s_rb_list->lpVtbl->Reset(s_rb_list, s_rb_alloc, NULL);
+    D3D12_RESOURCE_BARRIER b[MAX_OFF_RTS + MAX_ZETA];
+    int nb = 0;
+    for (int i = 0; i < MAX_ZETA; i++) {
+        if (!s_zeta[i].res) continue;
+        memset(&b[nb], 0, sizeof b[nb]);
+        b[nb].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[nb].Transition.pResource = s_zeta[i].res;
+        b[nb].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[nb].Transition.StateBefore = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+        b[nb].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        nb++;
+    }
+    if (nb) s_rb_list->lpVtbl->ResourceBarrier(s_rb_list, (UINT)nb, b);
+    if (up) {
+        for (int k = 0; k < s_gp_nsub; k++) {
+            const gp_sub* s = &s_gp_sub[k];
+            D3D12_TEXTURE_COPY_LOCATION dl = {0}, sl = {0};
+            dl.pResource = s->res;
+            dl.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+            dl.SubresourceIndex = s->sub;
+            sl.pResource = up;
+            sl.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+            sl.PlacedFootprint = s->fp;
+            s_rb_list->lpVtbl->CopyTextureRegion(s_rb_list, &dl, 0, 0, 0, &sl, NULL);
+        }
+    }
+    for (int i = 0; i < nb; i++) {
+        b[i].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+        b[i].Transition.StateAfter = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    }
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        OffRT* q = &s_d3d.off_rt[i];
+        const D3D12_RESOURCE_STATES want = (D3D12_RESOURCE_STATES)s_gp_in_rt[i].st;
+        if (!q->res || want == D3D12_RESOURCE_STATE_COPY_DEST) continue;
+        memset(&b[nb], 0, sizeof b[nb]);
+        b[nb].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[nb].Transition.pResource = q->res;
+        b[nb].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[nb].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+        b[nb].Transition.StateAfter = want;
+        q->st = want;
+        nb++;
+    }
+    if (nb) s_rb_list->lpVtbl->ResourceBarrier(s_rb_list, (UINT)nb, b);
+    s_rb_list->lpVtbl->Close(s_rb_list);
+    ID3D12CommandList* lists[] = { (ID3D12CommandList*)s_rb_list };
+    s_d3d.cmd_queue->lpVtbl->ExecuteCommandLists(s_d3d.cmd_queue, 1, lists);
+    wait_for_gpu();
+    if (up) up->lpVtbl->Release(up);
+    if (!up && (n_rt || n_z))
+        fprintf(stderr, "[D3D12] save-state load: no upload buffer for the surface pool (%llu bytes):"
+                        " %u targets and %u zeta surfaces made without their pixels%c",
+                (unsigned long long)need, n_rt, n_z, 10);
+    gp_prepare();                                    /* (the fidelity check's capture reads them back) */
+    QueryPerformanceCounter(&q1);
+    fprintf(stderr, "[D3D12] save-state load: surface pool restored (%u render targets, %u zeta surfaces,"
+                    " %.1f MB of pixels, %u left to rebuild) in %.1f ms%c", n_rt, n_z,
+            (double)bytes / (1024.0 * 1024.0), n_skip,
+            (double)(q1.QuadPart - q0.QuadPart) * 1000.0 / (double)qf.QuadPart, 10);
+    return SS_OK;
+}
+
+static const ss_section_ops k_gp_ops = {
+    SS_FOURCC('G', 'P', 'U', 'P'), 1, SS_SEC_OPTIONAL, SS_ORDER_GPU,
+    NULL, gp_capture, NULL, gp_restore, NULL,
+    "renderer surface pool", k_gp_lists, gp_size_hint,
+    NULL, gp_check_image,              /* verify: the generic compare (planes byte for byte) */
+};
+SS_SECTION_REGISTER(k_gp_ops)
+
+/* 1 while the window runs a modal loop (a size / move drag, a menu): a
+ * save-state load waits until it is over (no teardown inside DispatchMessage). */
+int rsx_d3d12_backend_in_modal(void)
+{
+    return s_modal_depth > 0 || s_in_modal_tick;
