+
+    u8 rep[78]; memset(rep, 0, sizeof rep);
+    rep[0] = 0x01; rep[1] = 0x81; rep[2] = 0x7F; rep[3] = 0x81; rep[4] = 0x7F;
+    rep[5] = 0x10 | 0x08; rep[6] = 0x00; rep[7] = 0x02; rep[8] = 0x00; rep[9] = 0x00;   /* square, touchpad */
+    PadHostPortState st; fresh(&st);
+    CHECK_EQ(padhost_drv_dualsense.parse(d, rep, 78, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_SQUARE | CELL_PAD_CTRL_SELECT);
+    CHECK_EQ(st.has_motion, 0);
+
+    memcpy(rep, vec_ds5_bt_in, 78);
+    fresh(&st);
+    CHECK_EQ(padhost_drv_dualsense.parse(d, rep, 78, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_TRIANGLE | CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_LEFT |
+                         CELL_PAD_CTRL_SELECT | CELL_PAD_CTRL_L3);
+    CHECK_EQ(st.lx, 0x00); CHECK_EQ(st.ly, 0xFF); CHECK_EQ(st.rx, 0x40); CHECK_EQ(st.ry, 0xC0);
+    CHECK_EQ(st.press[PADHOST_PRESS_L2], 0x33);
+    /* accel x -8192: (-8192 - 4) * 2 / 16396 = -0.99976 g -> 624.97; gyro yaw 2000 * 1080/17653 = 122.36 deg/s -> 344.77 */
+    CHECK_EQ(st.sensor_x, 624); CHECK_EQ(st.sensor_g, 344);
+    CHECK_EQ(st.battery, 35);
+
+    rep[20] ^= 0x40;
+    PadHostPortState st2 = st;
+    CHECK_EQ(padhost_drv_dualsense.parse(d, rep, 78, &st2), 0);
+    CHECK(!memcmp(&st, &st2, sizeof st));
+
+    u8 out[100];
+    int n = padhost_drv_dualsense.build_output(d, 0, 0x99, 3, out, (int)sizeof out);
+    CHECK_EQ(n, 78);
+    CHECK(same_bytes(out, vec_ds5_bt_out_p3_v1_seq1, 78, "DualSense BT output"));
+    /* sequence advances, CRC still valid */
+    n = padhost_drv_dualsense.build_output(d, 0, 0x99, 3, out, (int)sizeof out);
+    CHECK_EQ(out[1], 0x20);
+    {
+        u8 seed = 0xA2;
+        unsigned crc = padhost_crc32(padhost_crc32(0, &seed, 1), out, 74);
+        CHECK_EQ(crc, out[74] | (out[75] << 8) | (out[76] << 16) | ((unsigned)out[77] << 24));
+    }
+}
+
+static void test_ds5_edge_config(void)
+{
+    printf("DualSense Edge + config: paddles, touchpad -> start, mute -> ps, lightbar off, player LEDs off\n");
+    mock_reset();
+    mock_cfg("dualsense_edge_left_paddle", "l3");
+    mock_cfg("dualsense_edge_right_paddle", "cross+r1");
+    mock_cfg("dualsense_touchpad", "start");
+    mock_cfg("dualsense_mute", "ps");
+    mock_cfg("dualsense_lightbar", "off");
+    mock_cfg("dualsense_player_leds", "off");
+    PadHostDevice* d = new_dev(0x0DF2, PADHOST_BUS_USB, 64, 48, 64);
+    CHECK_EQ(padhost_drv_dualsense.open(d), 0);       /* no feature replies at all: still opens */
+    CHECK(!strcmp(d->name, "DualSense Edge"));
+    u8 rep[64] = { 0x01, 0x80, 0x80, 0x80, 0x80 };
+    rep[8] = 0x08;
+    rep[10] = 0x40 | 0x80 | 0x02 | 0x04;
+    PadHostPortState st; fresh(&st);
+    CHECK_EQ(padhost_drv_dualsense.parse(d, rep, 64, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_L3 | CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_R1 | CELL_PAD_CTRL_START);
+    CHECK_EQ(st.ps, 1);
+    CHECK_EQ(st.press[PADHOST_PRESS_CROSS], 255);
+    u8 out[64];
+    int n = padhost_drv_dualsense.build_output(d, 0, 0, 1, out, (int)sizeof out);
+    CHECK_EQ(n, 48);
+    CHECK_EQ(out[1 + 0], 0x02);                        /* Edge: v2 only */
+    CHECK_EQ(out[1 + 38], 0x04);
+    CHECK_EQ(out[1 + 43], 0); CHECK_EQ(out[1 + 44], 0); CHECK_EQ(out[1 + 45], 0); CHECK_EQ(out[1 + 46], 0);
+    /* Every port gets its own player pattern and colour. */
+    mock_reset();
+    d = new_dev(0x0CE6, PADHOST_BUS_USB, 64, 48, 64);
+    padhost_drv_dualsense.open(d);
+    static const u8 pl[7] = { 0x04, 0x0A, 0x15, 0x1B, 0x1F, 0x17, 0x1D };
+    for (int port = 0; port < 7; port++) {
+        u8 r, g, b; padhost_port_color(port, &r, &g, &b);
+        padhost_drv_dualsense.build_output(d, 0, 0, port, out, (int)sizeof out);
+        CHECK_EQ(out[1 + 43], pl[port]);
+        CHECK_EQ(out[1 + 44], r); CHECK_EQ(out[1 + 45], g); CHECK_EQ(out[1 + 46], b);
+        CHECK_EQ(out[1 + 0], 0x03); CHECK_EQ(out[1 + 38], 0x04);   /* no fw info: v1 + v2 */
+    }
+}
