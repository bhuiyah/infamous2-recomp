+/* window = auto | max | WxH, or a new monitor: the window as create_window
+ * would open it now. In fullscreen a monitor change covers the new monitor;
+ * a size change waits for windowed mode. */
+static void disp_apply_geometry(HWND h, int new_monitor)
+{
+    if (!h || IsIconic(h)) return;
+    HMONITOR mon = disp_target_monitor();
+    MONITORINFO mi;
+    mi.cbSize = sizeof mi;
+    if (!GetMonitorInfoA(mon, &mi)) return;
+    if (s_fullscreen) {
+        if (new_monitor)
+            SetWindowPos(h, HWND_TOP, mi.rcMonitor.left, mi.rcMonitor.top,
+                         mi.rcMonitor.right - mi.rcMonitor.left, mi.rcMonitor.bottom - mi.rcMonitor.top,
+                         SWP_NOOWNERZORDER | SWP_FRAMECHANGED | SWP_SHOWWINDOW);
+        return;
+    }
+    if (IsZoomed(h)) ShowWindow(h, SW_RESTORE);
+    const UINT dpi = disp_monitor_dpi(mon);
+    const DWORD style = WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN;   /* create_window's */
+    RECT fr = {0, 0, 0, 0};
+    disp_adjust_rect(&fr, style, GetMenu(h) != NULL, dpi);   /* the menu bar is part of the frame */
+    const int fw = fr.right - fr.left, fh = fr.bottom - fr.top;
+    const int ww = mi.rcWork.right - mi.rcWork.left, wh = mi.rcWork.bottom - mi.rcWork.top;
+    const double a = disp_content_aspect();
+    int cw = 0, ch = 0, cfg_w = 0, cfg_h = 0;
+    const int wmode = dcfg_parse_size(dcfg_get(&s_dcfg, "window"), &cfg_w, &cfg_h);
+    if (wmode == DCFG_SIZE_EXACT) { cw = cfg_w; ch = cfg_h; }
+    else if (wmode == DCFG_SIZE_MAX) { int dx, dy; dcfg_fit_rect(ww - fw, wh - fh, a, &dx, &dy, &cw, &ch); }
+    else dcfg_default_client(a, (int)s_d3d.height, dpi / 96.0, ww - fw, wh - fh, &cw, &ch);
+    int x = mi.rcWork.left + (ww - (cw + fw)) / 2, y = mi.rcWork.top + (wh - (ch + fh)) / 2;
+    if (x < mi.rcWork.left) x = mi.rcWork.left;
+    if (y < mi.rcWork.top)  y = mi.rcWork.top;
+    SetWindowPos(h, NULL, x, y, cw + fw, ch + fh, SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER);
