+def rcache_function(items: list, entries: list, image=None):
+    """Rewrite one lifted function body for register caching.
+
+    items: the body as emitted -- labels ("loc_XXXXXXXX:") and statements.
+    entries: entry labels (a region's switch cases); None = the function
+    starts at its first statement.
+    image: addr-text -> the 16 lifted-image bytes a constant-address load
+    reads, or None (constant shufb controls, _rc_shufb_consts).
+    Returns (decls, entry_loads, body) where entry_loads maps each entry label
+    to the load statements for it (None key for a plain function)."""
