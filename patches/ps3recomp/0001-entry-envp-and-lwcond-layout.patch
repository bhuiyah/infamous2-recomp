+        const char* p = getenv("SPU_MISS_DUMP_PCMIN"); s_pcmin = p ? (uint32_t)strtoul(p,0,0) : 0; }
+      static int _n=0;
+      uint32_t misspc = ctx->pc & SPU_LS_MASK;
+      if ((s_img < 0 || ctx->image_id == s_img) && misspc >= s_pcmin && _n++ < 2) {
+        fprintf(stderr, "[SPU] branch-to-0 lr=0x%05X r1=0x%05X\n",
+                ctx->gpr[0]._u32[0] & SPU_LS_MASK, ctx->gpr[1]._u32[0] & SPU_LS_MASK);
+#ifdef _WIN32
+        void* frames[24]; unsigned short fn = RtlCaptureStackBackTrace(0, 24, frames, NULL);
+        char* base = (char*)GetModuleHandleA(NULL);
+        fprintf(stderr, "[SPU] host bt RVAs:");
+        for (unsigned short i = 0; i < fn; i++)
+            fprintf(stderr, " 0x%zX", (size_t)((char*)frames[i] - base));
+        fprintf(stderr, "\n");
+#endif
+        /* State-diff oracle: dump full LS + all GPRs at the branch-to-0 so it can
+         * be compared byte-for-byte against the RPCS3 savestate LS of the same
+         * (cri_mpv) task. Path from YDKJ_SPU_LSDUMP, else ./recomp_spu_ls.bin. */
+        const char* dp = getenv("YDKJ_SPU_LSDUMP");
+        if (!dp || !*dp) dp = "recomp_spu_ls.bin";
+        FILE* lf = fopen(dp, "wb");
+        if (lf) { fwrite(ctx->ls, 1, SPU_LS_SIZE, lf); fclose(lf);
+                  fprintf(stderr, "[SPU] dumped 256KB LS -> %s\n", dp); }
+        fprintf(stderr, "[SPU] image_id=%d  GPR dump (r0..r127, hi64:lo64 of each quadword, preferred slot = _u32[0]):\n", ctx->image_id);
+        for (int g = 0; g < 128; g++) {
+            fprintf(stderr, " r%-3d=%08X %08X %08X %08X", g,
+                    ctx->gpr[g]._u32[0], ctx->gpr[g]._u32[1],
+                    ctx->gpr[g]._u32[2], ctx->gpr[g]._u32[3]);
+            if ((g & 1) == 1) fprintf(stderr, "\n");
+        }
+        fprintf(stderr, "\n");
+        /* echo the dispatch chain values the way func_00026DE0 computes them */
+        { uint32_t bec0 = ctx->ls[0xBEC0]<<24 | ctx->ls[0xBEC1]<<16 | ctx->ls[0xBEC2]<<8 | ctx->ls[0xBEC3];
+          fprintf(stderr, "[SPU] LS[0xBEC0].w0=0x%08X  LS[0x2d4e0:16]=%02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X %02X%02X%02X%02X\n",
+            bec0,
+            ctx->ls[0x2d4e0],ctx->ls[0x2d4e1],ctx->ls[0x2d4e2],ctx->ls[0x2d4e3],
+            ctx->ls[0x2d4e4],ctx->ls[0x2d4e5],ctx->ls[0x2d4e6],ctx->ls[0x2d4e7],
+            ctx->ls[0x2d4e8],ctx->ls[0x2d4e9],ctx->ls[0x2d4ea],ctx->ls[0x2d4eb],
+            ctx->ls[0x2d4ec],ctx->ls[0x2d4ed],ctx->ls[0x2d4ee],ctx->ls[0x2d4ef]); }
+    } }
+    ctx->status = SPU_STATUS_STOPPED_BY_HALT;
+}
+
+/* ===========================================================================
+ * Execution trace (for §3 validation: diff vs RPCS3 SPU interpreter)
+ *
+ * When the lifter is invoked with --trace, every emitted instruction is
+ * surrounded by spu_trace_pc(ctx, PC) before execution and spu_trace_rt(
+ * ctx, RT) after, for instructions whose destination is the rt slot. The
+ * output is one line per event:
+ *
+ *     <PC-5hex>                          - PC about to execute
+ *       r<rt> <hi-64hex> <lo-64hex>      - register written, post-state
+ *
+ * Direct to stderr by default; call spu_trace_init(path) once at startup
+ * to redirect to a file. The format is intentionally minimal and stable
+ * so a small converter can line it up against an RPCS3.log SPU trace.
+ * ===========================================================================*/
+static FILE* s_trace_fp = NULL;
+
+void spu_trace_init(const char* path)
+{
+    if (!path || !*path) { s_trace_fp = stderr; return; }
+    s_trace_fp = fopen(path, "w");
+    if (!s_trace_fp) s_trace_fp = stderr;
+}
+
+/* Bounded by design: a --trace lift emits one call PER INSTRUCTION, so an image
+ * that spins (a persistent SPURS policy module polling its job queue never
+ * returns) would otherwise write stderr until the disk fills. The cap keeps the
+ * useful part -- the entry path plus enough revolutions to show what the loop
+ * tests -- and the tail IS the loop. SPU_TRACE_MAX=0 restores unbounded.
+ * SPU_TRACE_FILE redirects off stderr so the trace does not interleave with the
+ * boot log. */
+/* Trace output is OPT-IN at runtime: a --trace lift bakes the calls into the
+ * generated C forever, so a trace-lifted image shipped in a title build (LBP's
+ * job kernel, kept from the WWS verification) would otherwise spew the
+ * per-instruction log into every boot. Enable with SPU_TRACE=1 (stderr) or
+ * SPU_TRACE_FILE=<path>. */
+static long long s_trace_left = -1;     /* -1 uninit, -2 unbounded, 0 off */
+/* Set when spu_trace_pc suppressed its line (gates below): the paired
+ * spu_trace_rt call for the same instruction must also stay silent. */
+static SPU_THREAD_LOCAL int s_trace_suppress;
+
+void spu_trace_pc(spu_context* ctx, uint32_t pc)
+{
+    (void)ctx;
+    /* SPU_TRACE_AT_WALL=1: hold the trace until the PPU's job-barrier probe
+     * arms g_barrier_sync_watch, so the budget covers the post-ticket claim/
+     * stage pass instead of boot-time idle polling. */
+    { static int s_aw = -1;
+      if (s_aw < 0) s_aw = getenv("SPU_TRACE_AT_WALL") ? 1 : 0;
+      if (s_aw) { extern uint32_t g_barrier_sync_watch;
+                  if (!g_barrier_sync_watch) { s_trace_suppress = 1; return; } } }
+    /* SPU_TRACE_FLOWCTX=1: trace ONLY the run the SPURS_PM_FLOW tracer armed
+     * (the stalled queue's spu0 dispatch) -- post-wall idle dispatches of the
+     * other 13 jobmanager wids otherwise exhaust the budget in under a second. */
+    { static int s_fc = -1;
+      if (s_fc < 0) s_fc = getenv("SPU_TRACE_FLOWCTX") ? 1 : 0;
+      if (s_fc) { extern void* volatile g_pm_flow_ctx;
+                  if (g_pm_flow_ctx != (void*)ctx) { s_trace_suppress = 1; return; } } }
+    /* SPU_TRACE_IMG=<n>: trace only contexts running image n (e.g. 1 = the
+     * WWS job binary, to catch the crt corrupting the job's r3/r4 args). */
+    { static int64_t s_ti = -2;
+      if (s_ti == -2) { const char* e = getenv("SPU_TRACE_IMG");
+                        s_ti = e ? atoll(e) : -1; }
+      if (s_ti >= 0 && ctx->image_id != (int)s_ti) { s_trace_suppress = 1; return; } }
+    s_trace_suppress = 0;
+    if (s_trace_left < 0) {
+        if (s_trace_left == -1) {
+            const char* p = getenv("SPU_TRACE_FILE");
+            if ((!p || !*p) && !getenv("SPU_TRACE")) { s_trace_left = 0; return; }
+            if (p && *p && !s_trace_fp) spu_trace_init(p);
+            const char* m = getenv("SPU_TRACE_MAX");
+            s_trace_left = (m && *m) ? atoll(m) : 200000;
+            if (s_trace_left == 0) s_trace_left = -2;   /* -2 = unbounded */
+        }
+    }
+    if (!s_trace_fp) s_trace_fp = stderr;
+    if (s_trace_left == 0) return;
+    if (s_trace_left > 0 && --s_trace_left == 0) {
+        fprintf(s_trace_fp, "-- SPU_TRACE_MAX reached; trace stopped --\n");
+        fflush(s_trace_fp);
+        return;
+    }
+    fprintf(s_trace_fp, "%05X\n", pc & SPU_LS_MASK);
+}
+
+void spu_trace_rt(spu_context* ctx, uint32_t rt)
+{
+    if (s_trace_suppress) return;          /* paired _pc line was gated out */
+    if (s_trace_left == 0) return;         /* tracing off/stopped (see _pc) */
+    if (!s_trace_fp) s_trace_fp = stderr;
+    u128 v = ctx->gpr[rt & 0x7F];
+    fprintf(s_trace_fp, "  r%-3u %016llX %016llX\n",
+            (unsigned)(rt & 0x7F),
+            (unsigned long long)v._u64[0],
+            (unsigned long long)v._u64[1]);
+}
+
+/* ===========================================================================
+ * Save state: SPUC, the SPU contexts -- this file's part (runtime/savestate/
+ * ss_state.h; engine design 5.2 / 6.2)
+ *
+ * The section itself -- its ops, every record it writes and reads -- is in
+ * lv2_register.c beside SPUG, whose thread table owns the contexts (the way
+ * cellSysmodule.c holds GCM_ and AUDI for their files). This file only
+ * describes its part: the context field by field (spu_context_ss.inc, which
+ * also says what is left out and what a load rebuilds instead), and what it
+ * keeps for a context beside spu_context -- the decrementer's clock, the MFC
+ * engine, the lifted-image tables a context's image ids index -- as plain
+ * functions, with no call into the save-state engine: the SPU host tests
+ * that compile this file in (test_spu_mfc_slots.c, test_spu_lockline_peer.c)
+ * link without it.
+ *
+ * A capture reads with every SPU host thread parked -- at a drain hop or an
+ * audited host wait, outside the lock-line lock and every channel lock -- so
+ * nothing on that side takes a lock or allocates. A load writes with every
+ * SPU host thread gone (discarded), before RECREATE starts the image's.
+ * ===========================================================================*/
+static const ss_field k_spuc_ctx_fields[] = {
+#define SS_CTX(m)      SS_MEMBER(spu_context, m),
+#define SS_CTX_NR(m)   SS_MEMBER_F(spu_context, m, SS_FF_NO_RESTORE),
+#define SS_CTX_HOST(m) SS_MEMBER_F(spu_context, m, SS_FF_NO_RESTORE | SS_FF_HOST),
+#include "spu_context_ss.inc"
+#undef SS_CTX
+#undef SS_CTX_NR
+#undef SS_CTX_HOST
+};
+const ss_list spu_channels_ss_contexts_list = SS_LIST("contexts", k_spuc_ctx_fields);
+
+/* The engine mfc_for would hand ctx, without claiming one: its own slot's;
+ * the overflow engine when no slot is free and that exists; else NULL, a
+ * fresh engine (every tag complete) on its next DMA. */
+static const mfc_engine* spuc_mfc_peek(const spu_context* ctx, int* slot)
+{
+    int any_free = 0;
+    for (int i = 0; i < SPU_MAX_CONTEXTS; i++) {
+        if (s_mfc_owner[i] == ctx) { *slot = i; return &s_mfc_slots[i].mfc; }
+        if (!s_mfc_owner[i]) any_free = 1;
+    }
+    if (!any_free && s_mfc_fallback_init) { *slot = -2; return &s_mfc_fallback; }
+    *slot = -1;
+    return NULL;
+}
+
+/* This file's modes that keep SPU state outside the contexts (SPUC's strict
+ * check, and a load's check_image: a session in one of them has state a load
+ * would not replace): a debug mode that runs SPU code off the drain loop
+ * (SPU_LOCKSTEP's token ring, an SPU_JOB_VERIFY clone in flight) and a raw
+ * SPU (its local store is the guest window and its host thread no lv2 SPU
+ * thread's). 0, or an ss_reason with the blocker in why. */
+int spu_channels_ss_check(char* why, size_t n)
+{
+    if (g_yz_lockstep_on == 1) { snprintf(why, n, "SPU_LOCKSTEP is on"); return SS_REASON_DEBUG_SWITCH; }
+    if (g_spu_sbx_live) { snprintf(why, n, "an SPU_JOB_VERIFY run in flight"); return SS_REASON_DEBUG_SWITCH; }
+    if (g_spu_force_ch_block) { snprintf(why, n, "a raw SPU"); return SS_REASON_SPU_EXTRA; }
+    return 0;
+}
+
+/* One lv2 context's strict eligibility: not inside an interrupt handler (its
+ * saved register file and handler frame are mid-flight), not on a guest
+ * local-store window, no MFC command queued. */
+int spu_channels_ss_check_ctx(const spu_context* c, uint32_t tid, char* why, size_t n)
+{
+    if (c->irq_saved) {
+        snprintf(why, n, "SPU 0x%X inside an interrupt handler (pc 0x%05X, returns to 0x%05X)", tid,
+                 (unsigned)(c->pc & SPU_LS_MASK), (unsigned)(c->irq_resume_pc & SPU_LS_MASK));
+        return SS_REASON_SPU_BUSY;
+    }
+    if (c->ls != c->ls_store) {
+        snprintf(why, n, "SPU 0x%X runs on a guest local-store window", tid);
+        return SS_REASON_SPU_EXTRA;
+    }
+    int slot;
+    const mfc_engine* e = spuc_mfc_peek(c, &slot);
+    if (e && e->queue_count) {
+        snprintf(why, n, "SPU 0x%X: %u MFC commands queued", tid, e->queue_count);
+        return SS_REASON_SPU_BUSY;
+    }
+    return 0;
+}
+
+/* The capture's one instant (ss_capture_info's guest QPC, TIME's host.qpc)
+ * on the decrementers' clock; 0: now. Every decrementer is read at it, not
+ * at SPUC's turn: MAPS and GMEM run in between (~20 ms, more for a larger
+ * image), and a load re-bases the guest clock and these together, so a later
+ * instant would put every SPU clock that far ahead of the PPU timebase. */
+uint64_t spu_channels_ss_now(uint64_t qpc, uint64_t qpc_freq)
+{
+#ifdef _WIN32
+    if (qpc && qpc_freq) return spu_qpc_ns(qpc, qpc_freq);
+#else
+    (void)qpc; (void)qpc_freq;
+#endif
+    return spu_host_ns();
+}
+
+/* The decrementer as SPU_RdDec reads it at `now`; *armed: dec_base_ns is set
+ * (a WrDec or a read), else it reads `decrementer` as written. */
+uint32_t spu_channels_ss_dec(const spu_context* c, uint64_t now, uint32_t* armed)
+{
+    *armed = c->dec_base_ns != 0;
+    return *armed ? c->decrementer - spu_dec_ticks(c->dec_base_ns, now) : c->decrementer;
+}
+
+/* ctx's MFC engine as mfc_for would hand it, without claiming one: returns
+ * its slot (-1 none yet: a fresh engine on its next DMA; -2 the shared
+ * overflow engine), with its completed tag groups (~0 for a fresh one) and
+ * its queued commands (DMA completes synchronously: 0 at a stop). */
+int spu_channels_ss_mfc(const spu_context* c, uint32_t* tags, uint32_t* queued)
+{
+    int slot;
+    const mfc_engine* e = spuc_mfc_peek(c, &slot);
+    *tags = e ? e->tag_completed : 0xFFFFFFFFu;
+    *queued = e ? e->queue_count : 0u;
+    return slot;
+}
+
+/* A fingerprint of the tables a context's image ids index (image_id,
+ * resident_ovl / _code / _task, module_img_a00): every lifted function's LS
+ * address and image in registration order, every overlay source's EA and
+ * image. Static constructors hand the ids out in that order, so two builds
+ * -- or two runs of one -- agree on what an id names iff they agree on this
+ * (FNV-1a over the values; the registry is complete before any SPU thread
+ * runs, so it is read without a lock). */
+uint64_t spu_channels_ss_image_table(void)
+{
+    uint64_t h = 0xCBF29CE484222325ull;
+#define SPUC_MIX(v) (h = (h ^ (uint64_t)(uint32_t)(v)) * 0x100000001B3ull)
+    SPUC_MIX(s_registry_count);
+    for (uint32_t i = 0; i < s_registry_count; i++) {
+        SPUC_MIX(s_registry[i].addr);
+        SPUC_MIX(s_registry[i].image_id);
+    }
+    SPUC_MIX(s_ovl_src_count);
+    for (int i = 0; i < s_ovl_src_count; i++) {
+        SPUC_MIX(s_ovl_src[i].src_ea);
+        SPUC_MIX(s_ovl_src[i].image_id);
+    }
+#undef SPUC_MIX
+    return h;
+}
+
+/* A load (SPUC's restore; every SPU host thread gone): the decrementer reads
+ * `value` and counts down from here (armed), or holds it as written. The
+ * guest clock is frozen at the snapshot's instant until the release, so the
+ * count goes on from exactly where the snapshot's was. */
+void spu_channels_ss_set_dec(spu_context* c, uint32_t value, int armed)
+{
+    c->decrementer = value;
+    c->dec_base_ns = 0;
+    if (armed) {
+        const uint64_t now = spu_host_ns();
+        c->dec_base_ns = now ? now : 1;   /* (0 reads as never armed) */
+    }
+}
+
+/* A load: ctx's MFC engine, claimed as its first DMA would claim one (a free
+ * slot, else the overflow engine), with the image's completed tag groups --
+ * a list parked at a stall-and-notify element keeps its tag incomplete until
+ * its MFC_WrListStallAck. Nothing is queued: a save refuses queued commands. */
+void spu_channels_ss_set_mfc(spu_context* c, uint32_t tags)
+{
+    mfc_engine* e = mfc_for(c);
+    e->tag_completed = tags;
+    e->queue_count = 0;
+}
+
+/* A load's TEARDOWN, after lv2_register.c has freed every context: no engine
+ * has an owner and the overflow engine is gone, as at boot (a claim
+ * initialises the engine it hands out). Every SPU host thread is gone, so
+ * nothing holds the claim lock. */
+void spu_channels_ss_teardown(void)
+{
+    AcquireSRWLockExclusive(&s_mfc_claim_lock);
+    for (int i = 0; i < SPU_MAX_CONTEXTS; i++) s_mfc_owner[i] = NULL;
+    s_mfc_fallback_init = 0;
+    ReleaseSRWLockExclusive(&s_mfc_claim_lock);
+}
+
+/* RECREATE, just before a restored context's thread resumes: its lock-line
+ * reservation is dropped the way a write to the line by another agent drops
+ * one (spu_coh_notify_write: resv_valid 0, SPU_EVENT_LR raised). The notify
+ * registry that delivers such a write is not in the image, and losing a
+ * reservation is always legal: a SPURS kernel parked on its Lr wait (LS
+ * 0x1178) wakes, takes the line again and waits again. Lr is raised whatever
+ * event_mask says, as the notify raises it: a reservation lost with no event
+ * would leave an Lr wait the SPU arms later with nothing to end it. Done here
+ * and not in the restore, so the fidelity check right after the restore
+ * compares the context exactly as captured. */
+void spu_channels_ss_resume(spu_context* c)
+{
+    if (!c->resv_valid) return;
+    c->resv_valid = 0;
+    c->event_status |= SPU_EVENT_LR;
+}
+
+#ifdef __cplusplus
+}
 #endif
\ No newline at end of file
