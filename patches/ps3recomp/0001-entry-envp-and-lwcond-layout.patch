+    dr->tex_slot = -1;
+    dr->vs_idx = vp_get_vs(st);
+    dr->vs_hash_rec = (dr->vs_idx >= 0 && dr->vs_idx < s_d3d.vp_vs_n) ? s_d3d.vp_vs[dr->vs_idx].hash : 0;
+    dr->is_clear = 0;
+    dr->blend = st->blend_enable;
+    dr->blend_key = rsx_blend_key(st, dr->blend);
