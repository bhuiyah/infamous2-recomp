+static int s_fail, s_pass, s_skip;
+#define CHECK(c, ...) do { if (c) s_pass++; else { s_fail++; printf("[FAIL] " __VA_ARGS__); printf("\n"); } } while (0)
+
+static ID3D12Device* s_dev;
+static ID3D12CommandQueue* s_q;
+static ID3D12CommandAllocator* s_al;
+static ID3D12GraphicsCommandList* s_cl;
+static ID3D12Fence* s_fence;
+static UINT64 s_fv;
+static HANDLE s_ev;
+static ID3D12RootSignature* s_rs;
+static ID3DBlob* s_vs;
+static ID3D12DescriptorHeap* s_rtv_heap;
+static UINT s_rtv_inc;
+
+#define REL(p) do { if (p) { (p)->lpVtbl->Release(p); (p) = NULL; } } while (0)
+
+static void submit_wait(void)
+{
+    s_cl->lpVtbl->Close(s_cl);
+    ID3D12CommandList* l[1] = { (ID3D12CommandList*)s_cl };
+    s_q->lpVtbl->ExecuteCommandLists(s_q, 1, l);
+    s_q->lpVtbl->Signal(s_q, s_fence, ++s_fv);
+    if (s_fence->lpVtbl->GetCompletedValue(s_fence) < s_fv) {
+        s_fence->lpVtbl->SetEventOnCompletion(s_fence, s_fv, s_ev);
+        WaitForSingleObject(s_ev, INFINITE);
+    }
+    s_al->lpVtbl->Reset(s_al);
+    s_cl->lpVtbl->Reset(s_cl, s_al, NULL);
+}
+
+static void barrier(ID3D12Resource* r, D3D12_RESOURCE_STATES a, D3D12_RESOURCE_STATES b)
+{
+    D3D12_RESOURCE_BARRIER br;
+    memset(&br, 0, sizeof br);
+    br.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    br.Transition.pResource = r;
+    br.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    br.Transition.StateBefore = a; br.Transition.StateAfter = b;
+    s_cl->lpVtbl->ResourceBarrier(s_cl, 1, &br);
+}
+
+static ID3D12Resource* buffer(D3D12_HEAP_TYPE type, UINT64 size, D3D12_RESOURCE_STATES st)
+{
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = type;
+    D3D12_RESOURCE_DESC bd; memset(&bd, 0, sizeof bd);
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = size; bd.Height = 1; bd.DepthOrArraySize = 1;
+    bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* r = NULL;
+    if (FAILED(s_dev->lpVtbl->CreateCommittedResource(s_dev, &hp, D3D12_HEAP_FLAG_NONE, &bd, st, NULL,
+                                                      &IID_ID3D12Resource, (void**)&r))) return NULL;
+    return r;
+}
+
+/* A render target of w x h texels of bpp bytes, filled from init (tight rows),
+ * left in RENDER_TARGET; its RTV in slot. */
+typedef struct { ID3D12Resource* rt; DXGI_FORMAT fmt; UINT w, h, bpp; D3D12_CPU_DESCRIPTOR_HANDLE rtv; } Tgt;
+
+static int target(Tgt* t, DXGI_FORMAT fmt, UINT w, UINT h, UINT bpp, int slot, const void* init)
+{
+    memset(t, 0, sizeof *t);
+    t->fmt = fmt; t->w = w; t->h = h; t->bpp = bpp;
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td; memset(&td, 0, sizeof td);
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; td.Width = w; td.Height = h; td.DepthOrArraySize = 1;
+    td.MipLevels = 1; td.Format = fmt; td.SampleDesc.Count = 1; td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    if (FAILED(s_dev->lpVtbl->CreateCommittedResource(s_dev, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&t->rt))) return 0;
+    D3D12_CPU_DESCRIPTOR_HANDLE h0;
+    s_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_rtv_heap, &h0);
+    t->rtv.ptr = h0.ptr + (SIZE_T)slot * s_rtv_inc;
+    s_dev->lpVtbl->CreateRenderTargetView(s_dev, t->rt, NULL, t->rtv);
+    const UINT pitch = (w * bpp + 255u) & ~255u;
+    ID3D12Resource* up = buffer(D3D12_HEAP_TYPE_UPLOAD, (UINT64)pitch * h, D3D12_RESOURCE_STATE_GENERIC_READ);
+    if (!up) return 0;
+    unsigned char* p = NULL;
+    up->lpVtbl->Map(up, 0, NULL, (void**)&p);
+    for (UINT y = 0; y < h; y++) memcpy(p + (size_t)y * pitch, (const unsigned char*)init + (size_t)y * w * bpp, w * bpp);
+    up->lpVtbl->Unmap(up, 0, NULL);
+    D3D12_TEXTURE_COPY_LOCATION dst, src;
+    memset(&dst, 0, sizeof dst); memset(&src, 0, sizeof src);
+    dst.pResource = t->rt; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = up; src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    src.PlacedFootprint.Footprint.Format = fmt; src.PlacedFootprint.Footprint.Width = w;
+    src.PlacedFootprint.Footprint.Height = h; src.PlacedFootprint.Footprint.Depth = 1;
+    src.PlacedFootprint.Footprint.RowPitch = pitch;
+    s_cl->lpVtbl->CopyTextureRegion(s_cl, &dst, 0, 0, 0, &src, NULL);
+    barrier(t->rt, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    submit_wait();
+    up->lpVtbl->Release(up);
+    return 1;
+}
+
+static void readback(Tgt* t, void* out)
+{
+    const UINT pitch = (t->w * t->bpp + 255u) & ~255u;
+    ID3D12Resource* rb = buffer(D3D12_HEAP_TYPE_READBACK, (UINT64)pitch * t->h, D3D12_RESOURCE_STATE_COPY_DEST);
+    barrier(t->rt, D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    D3D12_TEXTURE_COPY_LOCATION dst, src;
+    memset(&dst, 0, sizeof dst); memset(&src, 0, sizeof src);
+    src.pResource = t->rt; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = t->fmt; dst.PlacedFootprint.Footprint.Width = t->w;
+    dst.PlacedFootprint.Footprint.Height = t->h; dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    s_cl->lpVtbl->CopyTextureRegion(s_cl, &dst, 0, 0, 0, &src, NULL);
+    barrier(t->rt, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    submit_wait();
+    unsigned char* p = NULL;
+    D3D12_RANGE rr = { 0, (SIZE_T)pitch * t->h };
+    rb->lpVtbl->Map(rb, 0, &rr, (void**)&p);
+    for (UINT y = 0; y < t->h; y++) memcpy((unsigned char*)out + (size_t)y * t->w * t->bpp, p + (size_t)y * pitch, t->w * t->bpp);
+    rb->lpVtbl->Unmap(rb, 0, NULL);
+    rb->lpVtbl->Release(rb);
+}
+
+static ID3DBlob* compile(const char* src, const char* target_profile)
+{
+    ID3DBlob *b = NULL, *e = NULL;
+    HRESULT hr = D3DCompile(src, strlen(src), "rop", NULL, NULL, "main", target_profile, 0, 0, &b, &e);
+    if (FAILED(hr)) {
+        printf("compile failed: %s\n%s\n", e ? (const char*)e->lpVtbl->GetBufferPointer(e) : "?", src);
+        REL(e); return NULL;
+    }
+    REL(e);
+    return b;
+}
+
+/* Two full-screen triangles per 6 vertices (SV_PrimitiveID 0, 1, ...). */
+static const char s_vs_src[] =
+    "struct VSOut { float4 pos : SV_Position; };\n"
+    "VSOut main(uint id : SV_VertexID) {\n"
+    "    VSOut o; const uint k = id % 3u;\n"
+    "    const float2 p = k == 0u ? float2(-1, -1) : (k == 1u ? float2(-1, 3) : float2(3, -1));\n"
+    "    o.pos = float4(p, 0.0, 1.0); return o; }\n";   /* depth 0: exact in D24 */
+
+/* A decompiler-shaped program: the tail rsx_rop_apply_epilogue patches. */
+static void ps_single(char* out, size_t n, const char* expr)
+{
+    snprintf(out, n,
+        "struct PSInput { float4 position : SV_Position; };\n"
+        "float4 main(PSInput input, uint prim : SV_PrimitiveID) : SV_TARGET {\n"
+        "    const float x = floor(input.position.x), y = floor(input.position.y);\n"
+        "    float4 _o = %s;\n"
+        "    return (_o == _o) ? _o : (float4)0;\n}\n", expr);
+}
+static void ps_mrt4(char* out, size_t n, const char* expr)
+{
+    snprintf(out, n,
+        "struct PSInput { float4 position : SV_Position; };\n"
+        "struct PSOutput {\n    float4 t0 : SV_TARGET0;\n    float4 t1 : SV_TARGET1;\n"
+        "    float4 t2 : SV_TARGET2;\n    float4 t3 : SV_TARGET3;\n};\n"
+        "PSOutput main(PSInput input) {\n"
+        "    PSOutput _out;\n"
+        "    _out.t0 = %s;\n    _out.t1 = _out.t0;\n    _out.t2 = _out.t0;\n    _out.t3 = _out.t0;\n"
+        "    return _out;\n}\n", expr);
+}
+
+/* The first version's negative-pass rule (relax LESS/GREATER always, no
+ * stencil writes, pass P untouched) -- kept here only as the W10-W13 contrast. */
+static void old_fill_ds_pass_n(D3D12_DEPTH_STENCIL_DESC* ds)
+{
+    ds->DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ZERO;
+    if (ds->DepthFunc == D3D12_COMPARISON_FUNC_LESS) ds->DepthFunc = D3D12_COMPARISON_FUNC_LESS_EQUAL;
+    else if (ds->DepthFunc == D3D12_COMPARISON_FUNC_GREATER) ds->DepthFunc = D3D12_COMPARISON_FUNC_GREATER_EQUAL;
+    ds->StencilWriteMask = 0;
+}
+
+/* The backend's pipeline for (key, rop) and this pixel shader; ds = the
+ * guest's depth/stencil state (NULL: none bound), old_rule = the contrast. */
+static ID3D12PipelineState* pso_ds(const char* ps_src, uint32_t key, uint32_t rop, int nrt, DXGI_FORMAT fmt,
+                                   const D3D12_DEPTH_STENCIL_DESC* ds, int old_rule)
+{
+    static char hlsl[16384];
+    snprintf(hlsl, sizeof hlsl, "%s", ps_src);
+    if (rop && rsx_rop_apply_epilogue(hlsl, sizeof hlsl, rop) < 0) { printf("epilogue failed\n"); return NULL; }
+    ID3DBlob* ps = compile(hlsl, "ps_5_0");
+    if (!ps) return NULL;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+    memset(&pd, 0, sizeof pd);
+    pd.pRootSignature = s_rs;
+    pd.VS.pShaderBytecode = s_vs->lpVtbl->GetBufferPointer(s_vs); pd.VS.BytecodeLength = s_vs->lpVtbl->GetBufferSize(s_vs);
+    pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps); pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    rsx_rop_fill_blend(&pd.BlendState, key, rop, nrt, 0xFFFFu);
+    if (ds) {
+        pd.DepthStencilState = *ds;
+        pd.DSVFormat = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    } else {
+        pd.DepthStencilState.DepthEnable = FALSE;
+        pd.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_LESS;
+    }
+    if (old_rule) { if (rsx_rop_pass(rop) == 2) old_fill_ds_pass_n(&pd.DepthStencilState); }
+    else if (rsx_rop_pass(rop)) rsx_rop_fill_ds(&pd.DepthStencilState, rop);
+    pd.SampleMask = UINT_MAX;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = (UINT)nrt;
+    for (int r = 0; r < nrt; r++) pd.RTVFormats[r] = fmt;
+    pd.SampleDesc.Count = 1;
+    ID3D12PipelineState* p = NULL;
+    HRESULT hr = s_dev->lpVtbl->CreateGraphicsPipelineState(s_dev, &pd, &IID_ID3D12PipelineState, (void**)&p);
+    ps->lpVtbl->Release(ps);
+    if (FAILED(hr)) { printf("CreateGraphicsPipelineState failed 0x%08lX\n", (unsigned long)hr); return NULL; }
+    return p;
+}
+static ID3D12PipelineState* pso(const char* ps_src, uint32_t key, uint32_t rop, int nrt, DXGI_FORMAT fmt)
+{
+    return pso_ds(ps_src, key, rop, nrt, fmt, NULL, 0);
+}
+
+/* A D24S8 depth/stencil target for W10-W13 (its DSV in s_dsv). */
+static ID3D12DescriptorHeap* s_dsv_heap;
+static D3D12_CPU_DESCRIPTOR_HANDLE s_dsv;
+static ID3D12Resource* zbuffer(UINT w, UINT h, float depth, UINT8 stencil)
+{
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td; memset(&td, 0, sizeof td);
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; td.Width = w; td.Height = h; td.DepthOrArraySize = 1;
+    td.MipLevels = 1; td.Format = DXGI_FORMAT_D24_UNORM_S8_UINT; td.SampleDesc.Count = 1;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+    D3D12_CLEAR_VALUE cv; memset(&cv, 0, sizeof cv);
+    cv.Format = DXGI_FORMAT_D24_UNORM_S8_UINT; cv.DepthStencil.Depth = depth; cv.DepthStencil.Stencil = stencil;
+    ID3D12Resource* z = NULL;
+    if (FAILED(s_dev->lpVtbl->CreateCommittedResource(s_dev, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_DEPTH_WRITE, &cv, &IID_ID3D12Resource, (void**)&z))) return NULL;
+    if (!s_dsv_heap) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd; memset(&hd, 0, sizeof hd);
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_DSV; hd.NumDescriptors = 1;
+        s_dev->lpVtbl->CreateDescriptorHeap(s_dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_dsv_heap);
+        s_dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_dsv_heap, &s_dsv);
+    }
+    s_dev->lpVtbl->CreateDepthStencilView(s_dev, z, NULL, s_dsv);
+    s_cl->lpVtbl->ClearDepthStencilView(s_cl, s_dsv, D3D12_CLEAR_FLAG_DEPTH | D3D12_CLEAR_FLAG_STENCIL,
+                                        depth, stencil, 0, NULL);
+    submit_wait();
+    return z;
+}
+
+/* Draw nverts through the plan's pipelines (two for a signed blend), like
+ * the backend's replay; with ds, against the zbuffer in s_dsv. */
+static int draw_ds(Tgt* t, int nrt, const char* ps_src, const rsx_rop_plan* pl, const float bf[4], UINT nverts,
+                   const D3D12_DEPTH_STENCIL_DESC* ds, int old_rule, UINT sref)
+{
+    ID3D12PipelineState* p0 = pso_ds(ps_src, pl->key, pl->rop, nrt, t[0].fmt, ds, old_rule);
+    ID3D12PipelineState* p1 = rsx_rop_pass(pl->rop) == 1
+        ? pso_ds(ps_src, pl->key, rsx_rop_pass_n(pl->rop), nrt, t[0].fmt, ds, old_rule) : NULL;
+    if (!p0 || (rsx_rop_pass(pl->rop) == 1 && !p1)) { REL(p0); REL(p1); return 0; }
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv[4];
+    for (int r = 0; r < nrt; r++) rtv[r] = t[r].rtv;
+    D3D12_VIEWPORT vp = { 0.0f, 0.0f, (float)t[0].w, (float)t[0].h, 0.0f, 1.0f };
+    D3D12_RECT sc = { 0, 0, (LONG)t[0].w, (LONG)t[0].h };
+    s_cl->lpVtbl->SetGraphicsRootSignature(s_cl, s_rs);
+    s_cl->lpVtbl->RSSetViewports(s_cl, 1, &vp);
+    s_cl->lpVtbl->RSSetScissorRects(s_cl, 1, &sc);
+    s_cl->lpVtbl->OMSetRenderTargets(s_cl, (UINT)nrt, rtv, FALSE, ds ? &s_dsv : NULL);
+    if (ds) s_cl->lpVtbl->OMSetStencilRef(s_cl, sref);
+    if (bf) s_cl->lpVtbl->OMSetBlendFactor(s_cl, bf);
+    s_cl->lpVtbl->IASetPrimitiveTopology(s_cl, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    s_cl->lpVtbl->SetPipelineState(s_cl, p0);
+    s_cl->lpVtbl->DrawInstanced(s_cl, nverts, 1, 0, 0);
+    if (p1) {
+        s_cl->lpVtbl->SetPipelineState(s_cl, p1);
+        s_cl->lpVtbl->DrawInstanced(s_cl, nverts, 1, 0, 0);
+    }
+    submit_wait();
+    REL(p0); REL(p1);
+    return 1;
+}
+static int draw(Tgt* t, int nrt, const char* ps_src, const rsx_rop_plan* pl, const float bf[4], UINT nverts)
+{
+    return draw_ds(t, nrt, ps_src, pl, bf, nverts, NULL, 0, 0);
+}
+
+/* ---- the hardware rules (docs/GROUND_TRUTH.md 5.1), written out here ---- */
+static int u8_of(double v) { v = v != v ? 0.0 : v < 0 ? 0 : v > 1 ? 1 : v; return (int)floor(v * 255.0 + 0.5); }
+static int s8_of(int u) { return u >= 128 ? u - 256 : u; }
+static int clamp8(int v) { return v < 0 ? 0 : v > 255 ? 255 : v; }
+
+static rsx_rop_cfg cfg_new(void)
+{
+    rsx_rop_cfg c; memset(&c, 0, sizeof c);
+    c.mrt = 1; c.sgn = 1; c.f32off = 1; c.round8 = 1;
+    return c;
+}
+static rsx_rop_in in_of(uint32_t en, uint32_t mrt, uint32_t sf, uint32_t df, uint32_t eq, uint32_t fmt)
+{
+    rsx_rop_in i; i.blend_enable = en; i.blend_enable_mrt = mrt; i.sfactor = sf; i.dfactor = df;
+    i.equation = eq; i.surface_format = fmt; return i;
+}
+
+#define N 256u
+static unsigned char s_init[N * N * 4], s_out[N * N * 4];
+
+static void init_dst_x(unsigned char a_override, int use_a)
+{
+    for (UINT y = 0; y < N; y++) for (UINT x = 0; x < N; x++) {
+        unsigned char* p = &s_init[(y * N + x) * 4];
+        p[0] = p[1] = p[2] = (unsigned char)x; p[3] = use_a ? a_override : (unsigned char)x;
+    }
+}
+
+/* The source codes of the exhaustive pixel shader, per channel and row. */
+static int src_code(int ch, int y)
+{
+    switch (ch) { case 0: return y; case 1: return 255 - y; case 2: return (y * 37) % 256; default: return y; }
+}
+/* ...slightly off the codes: the rounding to 8 bits is part of the rule */
+static const char s_expr_codes[] =
+    "(float4(y, 255.0 - y, fmod(y * 37.0, 256.0), y) + float4(0.3, -0.3, 0.2, 0.0)) / 255.0";
+
+/* W1-W3: a signed equation over every (destination, source) code pair. */
+static void signed_case(const char* name, uint32_t sf, uint32_t df, uint32_t eq, int sub, const rsx_rop_cfg* cfg,
+                        int expect_exact)
+{
+    char ps[2048];
+    ps_single(ps, sizeof ps, s_expr_codes);
+    init_dst_x(0, 0);
+    Tgt t;
+    if (!target(&t, DXGI_FORMAT_R8G8B8A8_UNORM, N, N, 4, 0, s_init)) { CHECK(0, "%s: target", name); return; }
+    const rsx_rop_in in = in_of(1, 0, sf, df, eq, RSX_ROP_FMT_A8R8G8B8);
+    const rsx_rop_plan pl = rsx_rop_make_plan(&in, cfg);
+    if (!draw(&t, 1, ps, &pl, NULL, 3)) { CHECK(0, "%s: draw", name); REL(t.rt); return; }
+    readback(&t, s_out);
+    int bad = 0, shown = 0;
+    for (int y = 0; y < (int)N; y++) for (int x = 0; x < (int)N; x++) for (int c = 0; c < 4; c++) {
+        const int u = src_code(c, y);
+        const int want = clamp8(sub ? x - s8_of(u) : x + s8_of(u));
+        const int got = s_out[((size_t)y * N + (size_t)x) * 4 + (size_t)c];
+        if (got != want) { bad++; if (expect_exact && shown++ < 4)
+            printf("  %s: dst %d src %d ch %d: got %d, want %d\n", name, x, u, c, got, want); }
+    }
+    if (expect_exact)
+        CHECK(bad == 0, "%s: %d of %u texel channels differ from the RSX rule", name, bad, N * N * 4u);
+    else {
+        printf("  %s (old mapping): %d of %u texel channels differ from the RSX rule, e.g. dst 128 src 253 -> %d"
+               " (RSX 125)\n", name, bad, N * N * 4u, s_out[((size_t)(255 - 253) * N + 128) * 4 + 1]);
+        CHECK(bad > 0, "%s: the old mapping should differ", name);
+    }
+    REL(t.rt);
+}
+
+/* W4: two overlapping primitives in one draw: -5 (u8 251) then +3. */
+static void overlap_case(void)
+{
+    char ps[2048];
+    ps_single(ps, sizeof ps, "(prim == 0u ? 251.0 : 3.0).xxxx / 255.0");
+    init_dst_x(0, 0);
+    Tgt t;
+    if (!target(&t, DXGI_FORMAT_R8G8B8A8_UNORM, N, 4, 4, 0, s_init)) { CHECK(0, "W4: target"); return; }
+    const rsx_rop_cfg c = cfg_new();
+    const rsx_rop_in in = in_of(1, 0, 0x00010001, 0x00010001, 0xF006F006, RSX_ROP_FMT_A8R8G8B8);
+    const rsx_rop_plan pl = rsx_rop_make_plan(&in, &c);
+    if (!draw(&t, 1, ps, &pl, NULL, 6)) { CHECK(0, "W4: draw"); REL(t.rt); return; }
+    readback(&t, s_out);
+    int bad_in = 0, diff_out = 0;
+    for (int x = 0; x < (int)N; x++) {
+        const int hw = clamp8(clamp8(x - 5) + 3);                     /* primitive order */
+        const int got = s_out[(size_t)x * 4];
+        if (x >= 5 && x <= 252) { if (got != hw) bad_in++; }
+        else if (got != hw) diff_out++;
+    }
+    CHECK(bad_in == 0, "W4: %d destinations in [5,252] differ from the primitive-order result", bad_in);
+    printf("  W4: outside [5,252] (an intermediate sum saturates) %d of 8 destinations differ -- the"
+           " documented two-pass approximation\n", diff_out);
+    REL(t.rt);
+}
+
+/* W5: per-target blend enables on four targets: dst 128, src 64, ADD ONE/ONE. */
+static void mrt_case(uint32_t m, const rsx_rop_cfg* cfg, const char* name, const int want[4])
+{
+    char ps[2048];
+    ps_mrt4(ps, sizeof ps, "(64.0 / 255.0).xxxx");
+    static unsigned char init[64 * 4 * 4];
+    memset(init, 128, sizeof init);
+    Tgt t[4];
+    for (int r = 0; r < 4; r++)
+        if (!target(&t[r], DXGI_FORMAT_R8G8B8A8_UNORM, 64, 4, 4, r, init)) { CHECK(0, "%s: target", name); return; }
+    const rsx_rop_in in = in_of(m & 1u, m & 0xEu, 0x00010001, 0x00010001, 0x80068006, RSX_ROP_FMT_A8R8G8B8);
+    const rsx_rop_plan pl = rsx_rop_make_plan(&in, cfg);
+    if (!draw(t, 4, ps, &pl, NULL, 3)) { CHECK(0, "%s: draw", name); return; }
+    int got[4];
+    for (int r = 0; r < 4; r++) { readback(&t[r], s_out); got[r] = s_out[0]; REL(t[r].rt); }
+    CHECK(got[0] == want[0] && got[1] == want[1] && got[2] == want[2] && got[3] == want[3],
+          "%s: targets %d %d %d %d, want %d %d %d %d", name, got[0], got[1], got[2], got[3],
+          want[0], want[1], want[2], want[3]);
+}
+
+/* W6: XRGB. dst = (x, x, x, 0x33), src = (200, 100, 50, 153)/255. */
+static void xrgb_case(const char* name, uint32_t fmt, uint32_t en, uint32_t sf, uint32_t df, int xrgb,
+                      int want_alpha, int mode)
+{
+    char ps[2048];
+    ps_single(ps, sizeof ps, "float4(200.0, 100.0, 50.0, 153.0) / 255.0");
+    init_dst_x(0x33, 1);
+    Tgt t;
+    if (!target(&t, DXGI_FORMAT_R8G8B8A8_UNORM, N, 2, 4, 0, s_init)) { CHECK(0, "%s: target", name); return; }
+    rsx_rop_cfg c = cfg_new(); c.xrgb = xrgb;
+    const rsx_rop_in in = in_of(en, 0, sf, df, 0x80068006, fmt);
+    const rsx_rop_plan pl = rsx_rop_make_plan(&in, &c);
+    if (!draw(&t, 1, ps, &pl, NULL, 3)) { CHECK(0, "%s: draw", name); REL(t.rt); return; }
+    readback(&t, s_out);
+    static const int src[3] = { 200, 100, 50 };
+    int bad = 0, abad = 0;
+    for (int x = 0; x < (int)N; x++) {
+        for (int ch = 0; ch < 3; ch++) {
+            int want;
+            if (mode == 0) want = x;                                        /* (1-DA)*src + DA*dst, DA = 1 */
+            else if (mode == 1) want = (int)floor((src[ch] * 153 + x * (255 - 153)) / 255.0 + 0.5);
+            else want = src[ch];                                            /* no blend */
+            if (abs(s_out[(size_t)x * 4 + (size_t)ch] - want) > (mode == 1 ? 0 : 0)) bad++;
+        }
+        if (want_alpha >= 0 && s_out[(size_t)x * 4 + 3] != want_alpha) abad++;
+    }
+    CHECK(bad == 0 && abad == 0, "%s: %d colour, %d alpha texels wrong (alpha[0]=%d)", name, bad, abad, s_out[3]);
+    REL(t.rt);
+}
+
+/* W10-W13: a guest depth/stencil state for the signed draw and the marker. */
+static D3D12_DEPTH_STENCIL_DESC ds_desc(int depth, D3D12_COMPARISON_FUNC zf, int zwrite, int stencil,
+                                        D3D12_COMPARISON_FUNC sf, D3D12_STENCIL_OP pass_op, UINT8 swmask)
+{
+    D3D12_DEPTH_STENCIL_DESC d; memset(&d, 0, sizeof d);
+    d.DepthEnable = depth ? TRUE : FALSE;
+    d.DepthWriteMask = zwrite ? D3D12_DEPTH_WRITE_MASK_ALL : D3D12_DEPTH_WRITE_MASK_ZERO;
+    d.DepthFunc = zf;
+    d.StencilEnable = stencil ? TRUE : FALSE;
+    d.StencilReadMask = 0xFF; d.StencilWriteMask = swmask;
+    d.FrontFace.StencilFailOp = D3D12_STENCIL_OP_KEEP; d.FrontFace.StencilDepthFailOp = D3D12_STENCIL_OP_KEEP;
+    d.FrontFace.StencilPassOp = pass_op; d.FrontFace.StencilFunc = sf;
+    d.BackFace = d.FrontFace;
+    return d;
+}
+
+/* ADD_SIGNED over the W1 code grid (depth 0 everywhere) under ds, against a
+ * zbuffer cleared to (zclear, sclear); then, with mark, a plain magenta draw
+ * under mark that must cover every texel (it checks what the signed draw left
+ * in depth/stencil). Returns the texel channels that differ from the RSX rule
+ * (want_drawn: the RSX blends these fragments), or -1. */
+static int signed_ds_case(const D3D12_DEPTH_STENCIL_DESC* ds, float zclear, UINT8 sclear, UINT sref, int want_drawn,
+                          int old_rule, const D3D12_DEPTH_STENCIL_DESC* mark, UINT mref, int* mark_bad)
+{
+    char ps[2048];
+    ps_single(ps, sizeof ps, s_expr_codes);
+    init_dst_x(0, 0);
+    Tgt t;
+    if (!target(&t, DXGI_FORMAT_R8G8B8A8_UNORM, N, N, 4, 0, s_init)) return -1;
+    ID3D12Resource* z = zbuffer(N, N, zclear, sclear);
+    if (!z) { REL(t.rt); return -1; }
+    const rsx_rop_cfg c = cfg_new();
+    const rsx_rop_in in = in_of(1, 0, 0x00010001, 0x00010001, 0xF006F006, RSX_ROP_FMT_A8R8G8B8);
+    const rsx_rop_plan pl = rsx_rop_make_plan(&in, &c);
+    if (!draw_ds(&t, 1, ps, &pl, NULL, 3, ds, old_rule, sref)) { REL(z); REL(t.rt); return -1; }
+    readback(&t, s_out);
+    int bad = 0;
+    for (int y = 0; y < (int)N; y++) for (int x = 0; x < (int)N; x++) for (int ch = 0; ch < 4; ch++) {
+        const int want = want_drawn ? clamp8(x + s8_of(src_code(ch, y))) : x;
+        if (s_out[((size_t)y * N + (size_t)x) * 4 + (size_t)ch] != want) bad++;
+    }
+    if (mark && mark_bad) {
+        char pm[1024];
+        ps_single(pm, sizeof pm, "float4(1.0, 0.0, 1.0, 1.0)");
+        rsx_rop_plan none; memset(&none, 0, sizeof none);
+        *mark_bad = -1;
+        if (draw_ds(&t, 1, pm, &none, NULL, 3, mark, 0, mref)) {
+            readback(&t, s_out);
+            *mark_bad = 0;
+            for (size_t i = 0; i < (size_t)N * N; i++)
+                if (s_out[i * 4] != 255 || s_out[i * 4 + 1] != 0 || s_out[i * 4 + 2] != 255) (*mark_bad)++;
+        }
+    }
+    REL(z); REL(t.rt);
+    return bad;
+}
+
+/* WD: rsx_rop_fill_ds field by field (no device). */
+static void fill_ds_case(void)
+{
+    const uint32_t rp = RSX_ROP_PASS_P | RSX_ROP_SGN_RGB, rn = rsx_rop_pass_n(rp);
+    D3D12_DEPTH_STENCIL_DESC g = ds_desc(1, D3D12_COMPARISON_FUNC_LESS, 1, 1, D3D12_COMPARISON_FUNC_EQUAL,
+                                         D3D12_STENCIL_OP_INCR_SAT, 0xFF), d = g;
+    rsx_rop_fill_ds(&d, 0);
+    CHECK(!memcmp(&d, &g, sizeof d), "WD: no pass leaves the state alone");
+    d = g; rsx_rop_fill_ds(&d, RSX_ROP_ROUND8);
+    CHECK(!memcmp(&d, &g, sizeof d), "WD: round8 alone leaves the state alone");
+    d = g; rsx_rop_fill_ds(&d, rp);
+    CHECK(d.StencilWriteMask == 0 && d.DepthWriteMask == D3D12_DEPTH_WRITE_MASK_ALL &&
+          d.DepthFunc == D3D12_COMPARISON_FUNC_LESS && d.StencilEnable, "WD: P tests and writes depth, no stencil writes");
+    d = g; rsx_rop_fill_ds(&d, rn);
+    CHECK(d.StencilWriteMask == 0xFF && d.DepthWriteMask == D3D12_DEPTH_WRITE_MASK_ZERO &&
+          d.DepthFunc == D3D12_COMPARISON_FUNC_LESS_EQUAL && d.FrontFace.StencilPassOp == D3D12_STENCIL_OP_INCR_SAT,
+          "WD: N does the stencil ops, no depth writes, LESS -> LESS_EQUAL");
+    d = ds_desc(1, D3D12_COMPARISON_FUNC_LESS, 0, 0, D3D12_COMPARISON_FUNC_ALWAYS, D3D12_STENCIL_OP_KEEP, 0xFF);
+    rsx_rop_fill_ds(&d, rn);
+    CHECK(d.DepthFunc == D3D12_COMPARISON_FUNC_LESS, "WD: N without depth writes keeps LESS");
+    d = ds_desc(1, D3D12_COMPARISON_FUNC_GREATER, 1, 0, D3D12_COMPARISON_FUNC_ALWAYS, D3D12_STENCIL_OP_KEEP, 0xFF);
+    rsx_rop_fill_ds(&d, rn);
+    CHECK(d.DepthFunc == D3D12_COMPARISON_FUNC_GREATER_EQUAL, "WD: GREATER -> GREATER_EQUAL");
+    d = ds_desc(1, D3D12_COMPARISON_FUNC_NOT_EQUAL, 1, 0, D3D12_COMPARISON_FUNC_ALWAYS, D3D12_STENCIL_OP_KEEP, 0xFF);
+    rsx_rop_fill_ds(&d, rn);
+    CHECK(d.DepthFunc == D3D12_COMPARISON_FUNC_ALWAYS, "WD: NOT_EQUAL with depth writes -> ALWAYS");
+    d = ds_desc(1, D3D12_COMPARISON_FUNC_EQUAL, 1, 0, D3D12_COMPARISON_FUNC_ALWAYS, D3D12_STENCIL_OP_KEEP, 0xFF);
+    rsx_rop_fill_ds(&d, rn);
+    CHECK(d.DepthFunc == D3D12_COMPARISON_FUNC_EQUAL, "WD: EQUAL kept");
+}
+
+/* W0: with every toggle off, rsx_rop_fill_blend builds exactly the blend
+ * description the backend built before (RT0 from the key, mirrored to every
+ * target, the write masks per target). */
+static void legacy_desc_case(void)
+{
+    static const uint32_t f[] = { 0x0000, 0x0001, 0x0302, 0x0303, 0x0304, 0x0305, 0x0306, 0x0308, 0x8001, 0x8004 };
+    static const uint32_t e[] = { 0x8006, 0x8007, 0x800A, 0x800B, 0xF006 };
+    rsx_rop_cfg co; memset(&co, 0, sizeof co);
+    int bad = 0, n = 0;
+    for (int en = 0; en < 2; en++) for (int a = 0; a < 10; a++) for (int b = 0; b < 10; b++)
+    for (int q = 0; q < 5; q++) for (int nrt = 1; nrt <= 4; nrt++) {
+        const uint32_t sf = f[a] | (f[(a + 1) % 10] << 16), df = f[b] | (f[(b + 3) % 10] << 16);
+        const uint32_t eq = e[q] | (e[(q + 2) % 5] << 16), wc = 0x7F3Fu >> (en + q);
+        const rsx_rop_in in = in_of((uint32_t)en, 0, sf, df, eq, RSX_ROP_FMT_A8R8G8B8);
+        const uint32_t key = rsx_rop_make_plan(&in, &co).key;
+        D3D12_BLEND_DESC want, got;
+        memset(&want, 0, sizeof want); memset(&got, 0, sizeof got);
+        D3D12_RENDER_TARGET_BLEND_DESC* r0 = &want.RenderTarget[0];   /* the old vp_get_fp_pso code */
+        const uint32_t blend = key;
+        r0->BlendEnable    = (blend & 1) ? TRUE : FALSE;
+        r0->SrcBlend       = (blend & 1) ? (D3D12_BLEND)((blend >> 1)  & 0x1F) : D3D12_BLEND_ONE;
+        r0->DestBlend      = (blend & 1) ? (D3D12_BLEND)((blend >> 6)  & 0x1F) : D3D12_BLEND_ZERO;
+        r0->BlendOp        = (blend & 1) ? (D3D12_BLEND_OP)((blend >> 21) & 0x7) : D3D12_BLEND_OP_ADD;
+        r0->SrcBlendAlpha  = (blend & 1) ? (D3D12_BLEND)((blend >> 11) & 0x1F) : D3D12_BLEND_ONE;
+        r0->DestBlendAlpha = (blend & 1) ? (D3D12_BLEND)((blend >> 16) & 0x1F) : D3D12_BLEND_ZERO;
+        r0->BlendOpAlpha   = (blend & 1) ? (D3D12_BLEND_OP)((blend >> 24) & 0x7) : D3D12_BLEND_OP_ADD;
+        r0->RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+        for (int r = 0; r < nrt; r++) want.RenderTarget[r] = want.RenderTarget[0];
+        want.IndependentBlendEnable = nrt > 1 ? TRUE : FALSE;
+        for (int r = 0; r < nrt; r++) want.RenderTarget[r].RenderTargetWriteMask = (UINT8)((wc >> (4 * r)) & 0xF);
+        rsx_rop_fill_blend(&got, key, 0, nrt, wc);
+        n++;
+        if (memcmp(&want, &got, sizeof want)) { if (bad++ < 3) printf("  W0 sf=%08X df=%08X eq=%08X nrt=%d\n", sf, df, eq, nrt); }
+    }
+    CHECK(bad == 0, "W0 legacy blend description: %d of %d differ from the old code", bad, n);
+}
+
+int main(void)
+{
+    legacy_desc_case();
+    fill_ds_case();
+    IDXGIFactory4* fac = NULL; IDXGIAdapter* warp = NULL;
+    if (FAILED(CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&fac)) ||
+        FAILED(fac->lpVtbl->EnumWarpAdapter(fac, &IID_IDXGIAdapter, (void**)&warp)) ||
+        FAILED(D3D12CreateDevice((IUnknown*)warp, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&s_dev))) {
+        printf("[FAIL] no WARP D3D12 device\n"); return 1;
+    }
+    D3D12_COMMAND_QUEUE_DESC qd; memset(&qd, 0, sizeof qd); qd.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    s_dev->lpVtbl->CreateCommandQueue(s_dev, &qd, &IID_ID3D12CommandQueue, (void**)&s_q);
+    s_dev->lpVtbl->CreateCommandAllocator(s_dev, D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator, (void**)&s_al);
+    s_dev->lpVtbl->CreateCommandList(s_dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, s_al, NULL,
+                                     &IID_ID3D12GraphicsCommandList, (void**)&s_cl);
+    s_dev->lpVtbl->CreateFence(s_dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&s_fence);
+    s_ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+    D3D12_DESCRIPTOR_HEAP_DESC hd; memset(&hd, 0, sizeof hd);
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV; hd.NumDescriptors = 8;
+    s_dev->lpVtbl->CreateDescriptorHeap(s_dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_rtv_heap);
+    s_rtv_inc = s_dev->lpVtbl->GetDescriptorHandleIncrementSize(s_dev, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    {
+        D3D12_ROOT_SIGNATURE_DESC rd; memset(&rd, 0, sizeof rd);
+        ID3DBlob *sig = NULL, *err = NULL;
+        if (FAILED(D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err))) {
+            printf("[FAIL] root signature\n"); return 1; }
+        s_dev->lpVtbl->CreateRootSignature(s_dev, 0, sig->lpVtbl->GetBufferPointer(sig), sig->lpVtbl->GetBufferSize(sig),
+                                           &IID_ID3D12RootSignature, (void**)&s_rs);
+        REL(sig); REL(err);
+    }
+    s_vs = compile(s_vs_src, "vs_5_0");
+    if (!s_vs || !s_rs) { printf("[FAIL] setup\n"); return 1; }
+
+    const rsx_rop_cfg cn = cfg_new();
+    rsx_rop_cfg co; memset(&co, 0, sizeof co);              /* every toggle off: the old mapping */
+
+    /* W1-W3 */
+    signed_case("W1 ADD_SIGNED ONE/ONE", 0x00010001, 0x00010001, 0xF006F006, 0, &cn, 1);
+    signed_case("W1 ADD_SIGNED, BLEND_SIGNED=0", 0x00010001, 0x00010001, 0xF006F006, 0, &co, 0);
+    signed_case("W2 ADD_SIGNED SRC_ALPHA/1-SRC_ALPHA", 0x03020302, 0x03030303, 0xF006F006, 0, &cn, 1);
+    signed_case("W3 REVERSE_SUBTRACT_SIGNED", 0x00010001, 0x00010001, 0xF005F005, 1, &cn, 1);
+    /* W4 */
+    overlap_case();
+    /* W5: target 0 SET_BLEND_ENABLE, MRT 1-3 SET_BLEND_ENABLE_MRT (title values) */
+    { const int w9[4] = { 192, 64, 64, 192 }, w8[4] = { 64, 64, 64, 192 }, w3[4] = { 192, 192, 64, 64 },
+                w9old[4] = { 192, 192, 192, 192 };
+      mrt_case(0x9, &cn, "W5 MRT 0x9", w9);
+      mrt_case(0x8, &cn, "W5 MRT 0x8", w8);
+      mrt_case(0x3, &cn, "W5 MRT 0x3", w3);
+      mrt_case(0x9, &co, "W5 MRT 0x9, BLEND_MRT=0 (old mirror)", w9old); }
+    /* W6 */
+    xrgb_case("W6 X8R8G8B8_Z 1-DST_ALPHA/DST_ALPHA", RSX_ROP_FMT_X8R8G8B8_Z8R8G8B8, 1, 0x03050305, 0x03040304, 1, 0, 0);
+    xrgb_case("W6 X8R8G8B8_O SRC_ALPHA/1-SRC_ALPHA (X kept)", RSX_ROP_FMT_X8R8G8B8_O8R8G8B8, 1, 0x03020302, 0x03030303, 1,
+              0x33, 1);
+    xrgb_case("W6 X8R8G8B8_O no blend", RSX_ROP_FMT_X8R8G8B8_O8R8G8B8, 0, 0, 0, 1, 255, 2);
+    xrgb_case("W6 X8R8G8B8_Z no blend", RSX_ROP_FMT_X8R8G8B8_Z8R8G8B8, 0, 0, 0, 1, 0, 2);
+    xrgb_case("W6 A8R8G8B8 no blend keeps the shader alpha", RSX_ROP_FMT_A8R8G8B8, 0, 0, 0, 1, 153, 2);
+    /* W7: fp32 */
+    {
+        char ps[1024];
+        ps_single(ps, sizeof ps, "(0.25).xxxx");
+        static float init[64 * 4];
+        for (int i = 0; i < 64 * 4; i++) init[i] = 0.5f;
+        for (int pass = 0; pass < 2; pass++) {
+            Tgt t;
+            if (!target(&t, DXGI_FORMAT_R32G32B32A32_FLOAT, 64, 1, 16, 0, init)) { CHECK(0, "W7 target"); break; }
+            const rsx_rop_in in = in_of(1, 0, 0x00010001, 0x00010001, 0x80068006, RSX_ROP_FMT_F_W32Z32Y32X32);
+            const rsx_rop_plan pl = rsx_rop_make_plan(&in, pass ? &co : &cn);
+            static float out[64 * 4];
+            if (draw(&t, 1, ps, &pl, NULL, 3)) readback(&t, out);
+            if (!pass) CHECK(out[0] == 0.25f && out[255] == 0.25f, "W7 fp32: not blended (%g)", (double)out[0]);
+            else CHECK(out[0] == 0.75f, "W7 fp32, BLEND_F32=0: blended (%g)", (double)out[0]);
+            REL(t.rt);
+        }
+    }
+    /* W8: CONSTANT_COLOR / ONE_MINUS_CONSTANT_ALPHA, K = 0xCC336699 = (0.2, 0.4, 0.6, 0.8) */
+    {
+        D3D12_FEATURE_DATA_D3D12_OPTIONS13 o13; memset(&o13, 0, sizeof o13);
+        const int af = SUCCEEDED(s_dev->lpVtbl->CheckFeatureSupport(s_dev, D3D12_FEATURE_D3D12_OPTIONS13, &o13, sizeof o13))
+                       && o13.AlphaBlendFactorSupported;
+        printf("  W8: D3D12_BLEND_ALPHA_FACTOR %s on this device\n", af ? "supported" : "NOT supported");
+        for (int pass = 0; pass < 2; pass++) {
+            if (!pass && !af) { s_skip++; printf("[SKIP] W8 with ALPHA_FACTOR\n"); continue; }
+            char ps[1024];
+            ps_single(ps, sizeof ps, "(1.0).xxxx");
+            init_dst_x(0, 0);
+            Tgt t;
+            if (!target(&t, DXGI_FORMAT_R8G8B8A8_UNORM, N, 2, 4, 0, s_init)) { CHECK(0, "W8 target"); break; }
+            rsx_rop_cfg c = cfg_new(); c.alpha_factor = !pass;
+            const rsx_rop_in in = in_of(1, 0, 0x00018001, 0x00008004, 0x80068006, RSX_ROP_FMT_A8R8G8B8);
+            const rsx_rop_plan pl = rsx_rop_make_plan(&in, &c);
+            float k[4];
+            const int ca = 1, cc = 1;
+            rsx_rop_blend_constant(0xCC336699u, 0, RSX_ROP_FMT_A8R8G8B8, 0, ca && !cc && !c.alpha_factor, k);
+            if (!draw(&t, 1, ps, &pl, k, 3)) { CHECK(0, "W8 draw"); REL(t.rt); break; }
+            readback(&t, s_out);
+            static const int kc[3] = { 0x33, 0x66, 0x99 };
+            int bad = 0;
+            for (int x = 0; x < (int)N; x++) for (int ch = 0; ch < 3; ch++) {
+                const int want = (int)floor(kc[ch] + x * (255 - 0xCC) / 255.0 + 0.5);
+                if (abs(s_out[(size_t)x * 4 + (size_t)ch] - want) > 1) bad++;
+            }
+            if (!pass) CHECK(bad == 0 && (pl.notes & RSX_ROP_NOTE_KCONFLICT) == 0,
+                             "W8 ALPHA_FACTOR: %d texel channels off by more than 1", bad);
+            else { printf("  W8 without ALPHA_FACTOR (old): %d of %u texel channels wrong (noted: %s)\n", bad, N * 3u,
+                          (pl.notes & RSX_ROP_NOTE_KCONFLICT) ? "yes" : "no");
+                   CHECK(bad > 0 && (pl.notes & RSX_ROP_NOTE_KCONFLICT), "W8 old path differs and is noted"); }
+            REL(t.rt);
+        }
+    }
+    /* W9a: the round8 epilogue itself, read back exactly through an fp32
+     * target: every export becomes floor(x * 255 + 0.5) / 255 (x = code +
+     * 0.45 -> code, code + 0.55 -> code + 1, 255.3 -> 255, -0.2 -> 0). */
+    {
+        char ps[1024];
+        ps_single(ps, sizeof ps, "float4(x + 0.45, x + 0.55, x * 1.5 - 64.2, 255.3) / 255.0");
+        static float init[N * 4];
+        memset(init, 0, sizeof init);
+        Tgt t;
+        if (target(&t, DXGI_FORMAT_R32G32B32A32_FLOAT, N, 1, 16, 0, init)) {
+            rsx_rop_plan pl; memset(&pl, 0, sizeof pl);
+            pl.rop = RSX_ROP_ROUND8;                      /* no blend: the epilogue alone */
+            static float out[N * 4];
+            int bad = 0;
+            if (draw(&t, 1, ps, &pl, NULL, 3)) {
+                readback(&t, out);
+                for (int x = 0; x < (int)N; x++) {
+                    const double in4[4] = { x + 0.45, x + 0.55, x * 1.5 - 64.2, 255.3 };
+                    for (int ch = 0; ch < 4; ch++) {
+                        const int code = u8_of(in4[ch] / 255.0);
+                        if (fabs(out[x * 4 + ch] - code / 255.0) > 1e-6) bad++;
+                    }
+                }
+            } else bad = -1;
+            CHECK(bad == 0, "W9a round8 epilogue: %d of %u exports not on the 8-bit code", bad, N * 4u);
+            REL(t.rt);
+        } else CHECK(0, "W9a target");
+    }
+    /* W9b: SRC_ALPHA / ONE_MINUS_SRC_ALPHA on an 8-bit target with the source
+     * just off the codes. The RSX blends the rounded operands; how the device
+     * rounds the blend itself is its own (WARP: within 1 of the exact rule) --
+     * the case reports both and checks +-1 and that round8 never hurts. */
+    {
+        char ps[1024];
+        ps_single(ps, sizeof ps, "float4((y + 0.45).xxx, fmod(y * 7.0, 256.0) + 0.45) / 255.0");
+        int exact[2] = { 0, 0 }, off1[2] = { 0, 0 };
+        static unsigned char keep[N * N * 4];
+        for (int pass = 0; pass < 2; pass++) {
+            init_dst_x(0, 0);
+            Tgt t;
+            if (!target(&t, DXGI_FORMAT_R8G8B8A8_UNORM, N, N, 4, 0, s_init)) { CHECK(0, "W9b target"); break; }
+            rsx_rop_cfg c = cfg_new(); c.round8 = !pass;
+            const rsx_rop_in in = in_of(1, 0, 0x03020302, 0x03030303, 0x80068006, RSX_ROP_FMT_A8R8G8B8);
+            const rsx_rop_plan pl = rsx_rop_make_plan(&in, &c);
+            if (!draw(&t, 1, ps, &pl, NULL, 3)) { CHECK(0, "W9b draw"); REL(t.rt); break; }
+            readback(&t, pass ? s_out : keep);
+            const unsigned char* o = pass ? s_out : keep;
+            for (int y = 0; y < (int)N; y++) for (int x = 0; x < (int)N; x++) {
+                const int u = u8_of((y + 0.45) / 255.0), a = u8_of((((y * 7) % 256) + 0.45) / 255.0);
+                const int want = (int)floor((u * a + x * (255 - a)) / 255.0 + 0.5);
+                const int d = abs((int)o[((size_t)y * N + (size_t)x) * 4] - want);
+                if (d == 0) exact[pass]++; else if (d == 1) off1[pass]++;
+            }
+            REL(t.rt);
+        }
+        const int tot = (int)(N * N);
+        printf("  W9b alpha blend vs the exact 8-bit rule: round8 %d exact, %d off by 1, %d worse;"
+               " unrounded source %d exact, %d off by 1, %d worse; identical outputs: %s\n",
+               exact[0], off1[0], tot - exact[0] - off1[0], exact[1], off1[1], tot - exact[1] - off1[1],
+               memcmp(keep, s_out, sizeof keep) ? "no" : "yes (this device rounds the source to the target first)");
+        CHECK(exact[0] + off1[0] == tot, "W9b round8: every texel within 1 of the rule");
+        CHECK(exact[0] >= exact[1], "W9b round8 is never further from the rule than the unrounded source");
+    }
+    /* W10-W13: the signed draw's two passes under depth/stencil states
+     * (rsx_rop_fill_ds); the first version's rule for contrast. */
+    {
+        const D3D12_DEPTH_STENCIL_DESC st = ds_desc(0, D3D12_COMPARISON_FUNC_ALWAYS, 0, 1, D3D12_COMPARISON_FUNC_EQUAL,
+                                                    D3D12_STENCIL_OP_INCR_SAT, 0xFF);
+        const D3D12_DEPTH_STENCIL_DESC st_mark = ds_desc(0, D3D12_COMPARISON_FUNC_ALWAYS, 0, 1,
+                                                         D3D12_COMPARISON_FUNC_EQUAL, D3D12_STENCIL_OP_KEEP, 0);
+        const D3D12_DEPTH_STENCIL_DESC z_less_ro = ds_desc(1, D3D12_COMPARISON_FUNC_LESS, 0, 0,
+                                                           D3D12_COMPARISON_FUNC_ALWAYS, D3D12_STENCIL_OP_KEEP, 0);
+        const D3D12_DEPTH_STENCIL_DESC z_less_w = ds_desc(1, D3D12_COMPARISON_FUNC_LESS, 1, 0,
+                                                          D3D12_COMPARISON_FUNC_ALWAYS, D3D12_STENCIL_OP_KEEP, 0);
+        const D3D12_DEPTH_STENCIL_DESC z_ne_w = ds_desc(1, D3D12_COMPARISON_FUNC_NOT_EQUAL, 1, 0,
+                                                        D3D12_COMPARISON_FUNC_ALWAYS, D3D12_STENCIL_OP_KEEP, 0);
+        const D3D12_DEPTH_STENCIL_DESC z_mark = ds_desc(1, D3D12_COMPARISON_FUNC_EQUAL, 0, 0,
+                                                        D3D12_COMPARISON_FUNC_ALWAYS, D3D12_STENCIL_OP_KEEP, 0);
+        int mk = 0, mko = 0;
+        int b = signed_ds_case(&st, 1.0f, 0, 0, 1, 0, &st_mark, 1, &mk);
+        CHECK(b == 0 && mk == 0, "W10 stencil EQUAL 0 / INCR: %d channels off the rule, %d texels with stencil != 1",
+              b, mk);
+        int bo = signed_ds_case(&st, 1.0f, 0, 0, 1, 1, &st_mark, 1, &mko);
+        printf("  W10 first-version rule: %d channels off the rule (the negative pass tested the incremented"
+               " stencil), %d texels with stencil != 1\n", bo, mko);
+        CHECK(bo > 0, "W10 contrast: the first version's rule should differ");
+        b = signed_ds_case(&z_less_ro, 0.0f, 0, 0, 0, 0, NULL, 0, NULL);
+        CHECK(b == 0, "W11 LESS, no depth writes, stored depth equal: %d channels changed (none should)", b);
+        bo = signed_ds_case(&z_less_ro, 0.0f, 0, 0, 0, 1, NULL, 0, NULL);
+        printf("  W11 first-version rule: %d channels changed (its negative pass tested LESS_EQUAL)\n", bo);
+        CHECK(bo > 0, "W11 contrast: the first version's rule should differ");
+        b = signed_ds_case(&z_less_w, 1.0f, 0, 0, 1, 0, &z_mark, 0, &mk);
+        CHECK(b == 0 && mk == 0, "W12 LESS with depth writes: %d channels off the rule, %d texels with depth != 0", b, mk);
+        b = signed_ds_case(&z_ne_w, 1.0f, 0, 0, 1, 0, &z_mark, 0, &mk);
+        CHECK(b == 0 && mk == 0, "W13 NOT_EQUAL with depth writes: %d channels off the rule, %d texels with depth != 0",
+              b, mk);
+        bo = signed_ds_case(&z_ne_w, 1.0f, 0, 0, 1, 1, NULL, 0, NULL);
+        printf("  W13 first-version rule: %d channels off the rule (its negative pass failed NOT_EQUAL)\n", bo);
+        CHECK(bo > 0, "W13 contrast: the first version's rule should differ");
+    }
+
+    printf("test_rop_warp: %d passed, %d failed, %d skipped\n", s_pass, s_fail, s_skip);
+    return s_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_rsx_imm.c b/libs/video/tests/test_rsx_imm.c
new file mode 100644
index 0000000..3bf28f8
--- /dev/null
+++ b/libs/video/tests/test_rsx_imm.c
@@ -0,0 +1,299 @@
+/*
+ * ps3recomp - immediate-mode (SET_VERTEX_DATA* inside BEGIN/END) assembly test
+ *
+ * What a backend's draw_arrays is handed for an immediate-mode primitive, read
+ * back the way the D3D12 VCOMPACT path reads it (rsx_vfetch_plan_init +
+ * rsx_vfetch_convert) and the way the per-attribute path does
+ * (rsx_fetch_attrib):
+ *
+ *   A  a 12-vertex fan around the screen centre whose per-vertex weight goes
+ *      to attribute 8 with SET_VERTEX_DATA1F_M, position with DATA2F_M, while
+ *      the guest still has an attribute-8 array enabled from an earlier draw
+ *      (the shape of inFamous 2's depth-of-field composite);
+ *   B  an attribute the primitive never pushes (register set with 4F before
+ *      BEGIN) while its array is still enabled;
+ *   C  DATA1F / DATA3F / DATA_SCALED4S as register writes;
+ *   D  DATA3F position and DATA_SCALED4S attribute inside a primitive;
+ *   E  the IMM_DIAG trace (rsx_imm_trace_current) of A;
+ *   F  an attribute pushed after the vertex's attribute 0 (each vertex takes
+ *      the previous one's value; IMM_DIAG's late mask flags it).
+ *
+ * IMM_FIX (rsx_commands.h) selects the behaviour under test; the expectations
+ * follow it, so the same binary checks the fix (default) and documents the old
+ * behaviour (IMM_FIX=0). Built against a rsx_commands.h without the fix it
+ * checks the old behaviour. run: test_rsx_imm.exe; IMM_FIX=0 test_rsx_imm.exe;
+ * IMM_DIAG=1 test_rsx_imm.exe.
+ *
+ * Build (clang-cl, from libs/video/tests):
+ *   clang-cl -O2 -msse4.1 -I.. -I../../../include test_rsx_imm.c ../rsx_commands.c
+ *            ../rsx_vertex_fetch.c ../rsx_report.c -Fe:test_rsx_imm.exe
+ */
+#include "rsx_commands.h"
+#include "rsx_vertex_fetch.h"
+
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* --- the runtime pieces rsx_commands.c / rsx_vertex_fetch.c link against --- */
+uint8_t* vm_base;
+uint32_t ppu_hle_inject_base = 0x20000000u;
+void ps3_ms(const char* key) { (void)key; }
+void vm_write32(uint32_t a, uint32_t v) { (void)a; (void)v; }
+/* rsx_report.c (reports; this test issues none) */
+uint32_t vm_read32(uint64_t a) { (void)a; return 0; }
+u32 cellGcmResolveIO(u32 offset) { (void)offset; return 0; }
+/* Two windows of "local memory": the immediate-mode scratch block at the top
+ * of 256 MB and a stale vertex array at 0x02000000. Linear inside each 1 MB
+ * page, as rsx_vf_linear requires. */
+#define EA_SCRATCH 0x00100000u
+#define EA_STALE   0x00200000u
+#define OFF_STALE  0x02000000u
+u32 cellGcmResolveLocated(int location, u32 offset)
+{
+    if (location == 1 && offset >= 0x0FF00000u && offset < 0x10000000u) return EA_SCRATCH + (offset - 0x0FF00000u);
+    if (location == 1 && offset >= OFF_STALE && offset < OFF_STALE + 0x100000u) return EA_STALE + (offset - OFF_STALE);
+    return 0x00080000u;   /* anything else: a zero page */
+}
+u32 cellGcmResolveOffset(u32 offset) { return cellGcmResolveLocated(1, offset & 0x7FFFFFFFu); }
+
+static int failures;
+#define CHECK(cond, ...) do { if (!(cond)) { failures++; printf("[FAIL] "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+/* --- recording backend ---------------------------------------------------- */
+static const rsx_state* g_st;
+static int   g_calls;
+static u32   g_prim, g_first, g_count;
+static float g_plan[64][2][4];
+static float g_ref[64][16][4];
+static int   g_have_trace;
+#ifdef RSX_IMM_TRACE_WORDS
+static rsx_imm_trace g_tr;
+#endif
+static u32 g_mask = 0x0101u;     /* the attributes the "vertex program" reads */
+
+static void rb_set_vertex_attribs(void* ud, const rsx_state* s) { (void)ud; g_st = s; }
+static void rb_draw_arrays(void* ud, u32 prim, u32 first, u32 count)
+{
+    (void)ud;
+    g_calls++; g_prim = prim; g_first = first; g_count = count;
+    if (!g_st || count > 64) return;
+    /* VCOMPACT: a plan over the VS inputs, converted to float4 slots */
+    rsx_vfetch_plan p;
+    rsx_vfetch_plan_init(&p, g_st, g_mask, first, first + count - 1u);
+    float out[64][2][4];
+    rsx_vfetch_convert(&p, NULL, first, count, out, (u32)sizeof out[0]);
+    memcpy(g_plan, out, sizeof out);
+    /* per-attribute reference */
+    for (u32 v = 0; v < count; v++)
+        for (int a = 0; a < 16; a++) rsx_fetch_attrib(g_st, a, first + v, g_ref[v][a]);
+    g_have_trace = 0;
+#ifdef RSX_IMM_TRACE_WORDS
+    const rsx_imm_trace* t = rsx_imm_trace_current();
+    if (t) { g_tr = *t; g_have_trace = 1; }
+#endif
+}
+
+static rsx_backend g_be;
+static rsx_state   g_state;
+
+static void m(u32 method, u32 data) { rsx_process_method(&g_state, method, data); }
+static u32 fbits(float f) { u32 u; memcpy(&u, &f, 4); return u; }
+static int feq(float a, float b) { return fabsf(a - b) <= 1e-6f * (1.0f + fabsf(b)); }
+
+#define M_BEGIN_END   0x1808u
+#define M_FMT(i)      (0x1740u + 4u * (i))
+#define M_OFF(i)      (0x1680u + 4u * (i))
+#define M_2F(i, w)    (0x1880u + 8u * (i) + 4u * (w))
+#define M_4F(i, w)    (0x1C00u + 16u * (i) + 4u * (w))
+#define M_1F(i)       (0x1E40u + 4u * (i))
+#define M_3F(i, w)    (0x1500u + 16u * (i) + 4u * (w))
+#define M_S4S(i, w)   (0x0A80u + 8u * (i) + 4u * (w))
+
+static void be32f(u8* p, float f) { u32 u = fbits(f); p[0] = (u8)(u >> 24); p[1] = (u8)(u >> 16); p[2] = (u8)(u >> 8); p[3] = (u8)u; }
+
+/* attribute 8 left on a float2 array of 16 elements at OFF_STALE, as an
+ * earlier mesh's texcoords would be: element k = (3 + k, 10 + k) */
+static void enable_stale_attr8(void)
+{
+    for (int k = 0; k < 16; k++) {
+        be32f(vm_base + EA_STALE + 8u * (u32)k + 0, 3.0f + (float)k);
+        be32f(vm_base + EA_STALE + 8u * (u32)k + 4, 10.0f + (float)k);
+    }
+    m(M_FMT(8), 0x2u | (2u << 4) | (8u << 8));   /* float32 x2, stride 8 */
+    m(M_OFF(8), OFF_STALE);                       /* bit 31 clear: local   */
+}
+
+int main(void)
+{
+    vm_base = (uint8_t*)calloc(1, 0x00400000u);
+    if (!vm_base) return 2;
+    rsx_state_init(&g_state);
+    g_be.set_vertex_attribs = rb_set_vertex_attribs;
+    g_be.draw_arrays = rb_draw_arrays;
+    rsx_set_backend(&g_be);
+#ifdef RSX_IMM_TRACE_WORDS
+    const int fix = rsx_imm_fix();
+#else
+    const int fix = 0;           /* built against the header without the fix */
+#endif
+    const int diag = getenv("IMM_DIAG") != NULL;
+    printf("IMM_FIX=%d IMM_DIAG=%d\n", fix, diag);
+
+    /* ---- A: the depth-of-field fan ----------------------------------- */
+    {
+        static const float X[5] = { 640, 0, 1280, 1280, 0 }, Y[5] = { 360, 0, 0, 720, 720 };
+        static const float W[5] = { 0.0f, 0.75f, 0.75f, 0.75f, 0.75f };   /* centre sharp, corners blurred */
+        static const int tri[12] = { 0, 1, 2,  0, 2, 3,  0, 3, 4,  0, 4, 1 };
+        enable_stale_attr8();
+        m(M_FMT(0), 0x2u | (3u << 4) | (12u << 8));  /* attribute 0 also left on an array */
+        m(M_OFF(0), OFF_STALE + 0x1000u);
+        g_calls = 0;
+        m(M_BEGIN_END, 5);
+        for (int v = 0; v < 12; v++) {
+            const int c = tri[v];
+            m(M_1F(8), fbits(W[c]));                  /* weight first, then the position */
+            m(M_2F(0, 0), fbits(X[c]));
+            m(M_2F(0, 1), fbits(Y[c]));
+        }
+        m(M_BEGIN_END, 0);
+        CHECK(g_calls == 1, "A: one draw_arrays (got %d)", g_calls);
+        CHECK(g_prim == 5 && g_first == 0 && g_count == 12, "A: prim 5 first 0 count 12 (got %u %u %u)", g_prim, g_first, g_count);
+        int bad_pos = 0, bad_w = 0, mism = 0;
+        for (int v = 0; v < 12 && g_count == 12; v++) {
+            const int c = tri[v];
+            const float* p0 = g_plan[v][0]; const float* p8 = g_plan[v][1];
+            if (!feq(p0[0], X[c]) || !feq(p0[1], Y[c]) || !feq(p0[2], 0) || !feq(p0[3], 1)) bad_pos++;
+            float e8[4];
+            if (fix & 1) { e8[0] = W[c]; e8[1] = 0; e8[2] = 0; e8[3] = 1; }
+            else if (fix & 2) { e8[0] = 0; e8[1] = 0; e8[2] = 0; e8[3] = 1; }   /* 1F dropped: the register */
+            else {        /* old: 1F dropped, attribute 8 = stale array element v */
+                e8[0] = 3.0f + (float)v; e8[1] = 10.0f + (float)v; e8[2] = 0; e8[3] = 1;
+            }
+            if (!feq(p8[0], e8[0]) || !feq(p8[1], e8[1]) || !feq(p8[2], e8[2]) || !feq(p8[3], e8[3])) {
+                if (bad_w++ < 3) printf("  A v%d a8 got (%g %g %g %g) want (%g %g %g %g)\n", v,
+                                        p8[0], p8[1], p8[2], p8[3], e8[0], e8[1], e8[2], e8[3]);
+            }
+            for (int k = 0; k < 4; k++) if (!feq(g_ref[v][0][k], p0[k]) || !feq(g_ref[v][8][k], p8[k])) mism++;
+        }
+        CHECK(!bad_pos, "A: positions of the fan (%d bad)", bad_pos);
+        CHECK(!bad_w, "A: attribute 8 per vertex %s (%d bad)", (fix & 1) ? "= the pushed weights" :
+          (fix & 2) ? "= the register (1F dropped)" : "= the stale array (old behaviour)", bad_w);
+        CHECK(!mism, "A: VCOMPACT plan and rsx_fetch_attrib agree (%d lanes differ)", mism);
+        /* E: the trace of this primitive */
+#ifdef RSX_IMM_TRACE_WORDS
+        if (diag) {
+            CHECK(g_have_trace, "E: trace live during draw_arrays");
+            if (g_have_trace) {
+                CHECK(g_tr.primitive == 5 && g_tr.nverts == 12, "E: prim/nverts (%u/%u)", g_tr.primitive, g_tr.nverts);
+                CHECK(g_tr.nwords_total == 36, "E: 36 vertex-data words seen (%u)", g_tr.nwords_total);
+                CHECK(g_tr.ndropped == ((fix & 1) ? 0u : 12u), "E: dropped words %u", g_tr.ndropped);
+                CHECK(g_tr.pushed_mask == ((fix & 1) ? 0x0101u : 0x0001u), "E: pushed 0x%X", g_tr.pushed_mask);
+                CHECK(g_tr.stale_mask == ((fix & 1) ? 0u : 0x0100u), "E: stale 0x%X", g_tr.stale_mask);
+                CHECK(g_tr.guest_arrays[8].offset == OFF_STALE, "E: guest array of a8 recorded");
+                CHECK(g_tr.verts && feq(g_tr.verts[1][0][0], 0.0f) && feq(g_tr.verts[2][0][0], 1280.0f), "E: register snapshots");
+                if (g_tr.nwords) CHECK(g_tr.method[0] == M_1F(8) && g_tr.dropped[0] == ((fix & 1) ? 0 : 1),
+                                       "E: first word 0x%04X dropped=%u", g_tr.method[0], g_tr.dropped[0]);
+                CHECK(g_tr.late_mask == 0, "E: no attribute written after the last vertex (late 0x%X)", g_tr.late_mask);
+            }
+        } else
+            CHECK(!g_have_trace, "E: no trace without IMM_DIAG");
+#endif
+    }
+
+    /* ---- B: attribute never pushed, array still enabled ------------------ */
+    {
+        enable_stale_attr8();
+        m(M_4F(8, 0), fbits(0.25f)); m(M_4F(8, 1), 0); m(M_4F(8, 2), 0); m(M_4F(8, 3), fbits(1.0f));
+        g_calls = 0;
+        m(M_BEGIN_END, 5);
+        for (int v = 0; v < 3; v++) { m(M_2F(0, 0), fbits(10.0f * (float)v)); m(M_2F(0, 1), fbits(5.0f)); }
+        m(M_BEGIN_END, 0);
+        CHECK(g_calls == 1 && g_count == 3, "B: one 3-vertex draw");
+        int bad = 0;
+        for (int v = 0; v < 3; v++) {
+            const float* p8 = g_plan[v][1];
+            const float want = (fix & 2) ? 0.25f : 3.0f + (float)v;
+            if (!feq(p8[0], want)) { bad++; printf("  B v%d a8.x got %g want %g\n", v, p8[0], want); }
+        }
+        CHECK(!bad, "B: unpushed attribute 8 reads %s", (fix & 2) ? "the register" : "the stale array (old behaviour)");
+        /* the guest's array state is back after the draw */
+        CHECK(g_state.vertex_attribs[8].enabled && g_state.vertex_attribs[8].offset == OFF_STALE,
+              "B: guest array state restored after the flush");
+    }
+
+    /* ---- C: register writes with 1F / 3F / SCALED4S ---------------------- */
+    {
+        m(M_1F(3), fbits(2.5f));
+        m(M_3F(5, 0), fbits(1.0f)); m(M_3F(5, 1), fbits(2.0f)); m(M_3F(5, 2), fbits(3.0f));
+        m(M_S4S(6, 0), (u32)(u16)16384 | ((u32)(u16)(s16)-32767 << 16));
+        m(M_S4S(6, 1), 0u | ((u32)(u16)32767 << 16));
+        const float* r3 = g_state.vertex_data4f[3];
+        const float* r5 = g_state.vertex_data4f[5];
+        const float* r6 = g_state.vertex_data4f[6];
+        if (fix & 1) {
+            CHECK(feq(r3[0], 2.5f) && feq(r3[1], 0) && feq(r3[2], 0) && feq(r3[3], 1), "C: 1F register (%g %g %g %g)", r3[0], r3[1], r3[2], r3[3]);
+            CHECK(feq(r5[0], 1) && feq(r5[1], 2) && feq(r5[2], 3) && feq(r5[3], 1), "C: 3F register (%g %g %g %g)", r5[0], r5[1], r5[2], r5[3]);
+            CHECK(feq(r6[0], 16384.0f / 32767.0f) && feq(r6[1], -1) && feq(r6[2], 0) && feq(r6[3], 1),
+                  "C: SCALED4S register (%g %g %g %g)", r6[0], r6[1], r6[2], r6[3]);
+        } else {
+            CHECK(feq(r3[0], 0) && feq(r5[0], 0) && feq(r6[0], 0), "C: undecoded (old behaviour)");
+        }
+    }
+
+    /* ---- D: DATA3F position, SCALED4S attribute inside a primitive ------- */
+    {
+        g_mask = 0x0005u;          /* a0 + a2 */
+        m(M_FMT(8), 0); m(M_FMT(0), 0);   /* no arrays left over */
+        g_calls = 0;
+        m(M_BEGIN_END, 5);
+        for (int v = 0; v < 3; v++) {
+            m(M_S4S(2, 0), (u32)(u16)(s16)(v * 1000) | ((u32)(u16)(s16)-1000 << 16));
+            m(M_S4S(2, 1), 0u | ((u32)(u16)32767 << 16));
+            m(M_3F(0, 0), fbits((float)v)); m(M_3F(0, 1), fbits(2.0f)); m(M_3F(0, 2), fbits(0.5f));
+        }
+        m(M_BEGIN_END, 0);
+        if (fix & 1) {
+            CHECK(g_calls == 1 && g_count == 3, "D: 3F position emits 3 vertices (calls %d count %u)", g_calls, g_count);
+            int bad = 0;
+            for (int v = 0; v < 3 && g_count == 3; v++) {
+                const float* p0 = g_plan[v][0]; const float* p2 = g_plan[v][1];
+                if (!feq(p0[0], (float)v) || !feq(p0[1], 2) || !feq(p0[2], 0.5f) || !feq(p0[3], 1)) bad++;
+                if (!feq(p2[0], (float)(v * 1000) / 32767.0f) || !feq(p2[1], -1000.0f / 32767.0f) ||
+                    !feq(p2[2], 0) || !feq(p2[3], 1)) bad++;
+            }
+            CHECK(!bad, "D: 3F position + SCALED4S attribute per vertex (%d bad)", bad);
+        } else
+            CHECK(g_calls == 0, "D: 3F position emits nothing (old behaviour)");
+        g_mask = 0x0101u;
+    }
+
+    /* ---- F: attribute pushed AFTER the vertex's attribute 0 --------------- */
+    /* The snapshot at the attribute-0 write gives each vertex the value the
+     * attribute had BEFORE it -- the previous vertex's. IMM_DIAG flags it. */
+    {
+        m(M_4F(8, 0), fbits(-7.0f)); m(M_4F(8, 1), 0); m(M_4F(8, 2), 0); m(M_4F(8, 3), fbits(1.0f));
+        g_calls = 0;
+        m(M_BEGIN_END, 5);
+        for (int v = 0; v < 3; v++) {
+            m(M_2F(0, 0), fbits((float)v)); m(M_2F(0, 1), fbits(1.0f));
+            m(M_4F(8, 0), fbits(0.5f * (float)v)); m(M_4F(8, 1), 0); m(M_4F(8, 2), 0); m(M_4F(8, 3), fbits(1.0f));
+        }
+        m(M_BEGIN_END, 0);
+        CHECK(g_calls == 1 && g_count == 3, "F: one 3-vertex draw");
+        for (int v = 0; v < 3 && g_count == 3; v++) {
+            const float want = v ? 0.5f * (float)(v - 1) : -7.0f;   /* the previous vertex's value */
+            CHECK(feq(g_plan[v][1][0], want), "F: v%d a8.x %g (snapshot) want %g", v, g_plan[v][1][0], want);
+        }
+#ifdef RSX_IMM_TRACE_WORDS
+        if (diag && g_have_trace)
+            CHECK(g_tr.late_mask == 0x0100u, "F: late mask 0x%X (want 0x100)", g_tr.late_mask);
+#endif
+    }
+
+    printf("%s (%d failure%s)\n", failures ? "FAILED" : "PASSED", failures, failures == 1 ? "" : "s");
+    free(vm_base);
+    return failures ? 1 : 0;
+}
diff --git a/libs/video/tests/test_rsx_report.c b/libs/video/tests/test_rsx_report.c
new file mode 100644
index 0000000..c3a4710
--- /dev/null
+++ b/libs/video/tests/test_rsx_report.c
@@ -0,0 +1,867 @@
+/*
+ * ps3recomp - RSX reports, RENDER_ENABLE, zcull binding and the copy-on-sample
+ * policy (libs/video/rsx_report.c), without a GPU.
+ *
+ * Encodes the hardware rules (rsx_report.h; T2 PSL1GHT libgcm inline
+ * commands, T4 Mesa nouveau nv30_query.c) and replays inFamous 2's own method
+ * stream (T3: SET_CONTEXT_DMA_REPORT 0xFEED0001 at 0x4EF5DC/0x1326B0;
+ * func_00131A80: CLEAR_REPORT_VALUE(1), ZPASS enable, a box, GET_REPORT
+ * (1 << 24 | 0x14080), ZPASS disable; then the same box with the depth test
+ * off into 0x14090; func_000E43AC binds the two records as a 4x2 Y16_X16
+ * texture). Guest memory, the IO map and the backend's sample counter are
+ * fakes here; test_report_d3d12.c does the counting on a real D3D12 device.
+ *
+ * From external/ps3recomp:
+ *   clang-cl /nologo -I include -I libs/video libs/video/tests/test_rsx_report.c
+ *            libs/video/rsx_report.c /Fe:T/test_rsx_report.exe
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include "rsx_report.h"
+#include "rsx_commands.h"
+#include "../../../runtime/savestate/ss_state.h"   /* the GCM_ section's "rsx_report" field list */
+
+/* rsx_report.c's save-state part (cellSysmodule.c's GCM_ glue declares them the same way) */
+extern const ss_list g_ss_list_gcm_report;
+const void* rsx_report_ss_record(void);
+void  rsx_report_ss_teardown(void);
+void* rsx_report_ss_scratch(void);
+int   rsx_report_ss_validate(const void* rec, char* why, size_t n);
+int   rsx_report_ss_restore(const void* rec, char* why, size_t n);
+
+/* ---- fakes: guest memory windows, IO map ----------------------------------- */
+uint32_t ppu_hle_inject_base = 0x20000000u;
+#define WIN 0x100000u
+static struct { uint32_t base; uint8_t* mem; } s_win[] = {
+    {0x40400000u, NULL},   /* cellGcmInit ioAddress: IO 0.. */
+    {0x20000000u, NULL},   /* HLE inject window (local report area at +0x60000) */
+    {0xC0000000u, NULL},   /* RSX local memory */
+    {0x30000000u, NULL},   /* main memory the test maps at IO 0x0E000000 */
+};
+static int s_main_mapped = 0;
+static uint8_t* host(uint64_t ea)
+{
+    for (size_t i = 0; i < sizeof s_win / sizeof s_win[0]; i++)
+        if (ea >= s_win[i].base && ea + 4 <= (uint64_t)s_win[i].base + WIN) return s_win[i].mem + (ea - s_win[i].base);
+    return NULL;
+}
+static unsigned s_bad_access;
+uint32_t vm_read32(uint64_t a)
+{
+    const uint8_t* p = host(a);
+    if (!p) { s_bad_access++; return 0; }
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+void vm_write32(uint64_t a, uint32_t v)
+{
+    uint8_t* p = host(a);
+    if (!p) { s_bad_access++; return; }
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+uint32_t cellGcmResolveIO(uint32_t io)
+{
+    if (io < 0x07900000u) return io < WIN ? 0x40400000u + io : 0u;   /* only the first MB is backed */
+    if (s_main_mapped && io >= 0x0E000000u && io < 0x0E000000u + WIN) return 0x30000000u + (io - 0x0E000000u);
+    return 0;
+}
+uint32_t cellGcmResolveLocated(int local, uint32_t off)
+{
+    return local ? 0xC0000000u + off : cellGcmResolveIO(off);
+}
+
+/* ---- fake backend: draws with known sample counts ------------------------ */
+typedef struct { uint32_t seg; uint64_t samples; int done; } FakeDraw;
+static FakeDraw s_draws[64]; static int s_ndraws;
+static int s_measures;
+static int fake_measure(void* ud, uint32_t seg_hi)
+{
+    (void)ud;
+    s_measures++;
+    for (int i = 0; i < s_ndraws; i++)
+        if (!s_draws[i].done && s_draws[i].seg <= seg_hi) {
+            rsx_report_add_samples(s_draws[i].seg, s_draws[i].samples);
+            s_draws[i].done = 1;
+        }
+    return 1;
+}
+static int s_breaks;
+static void fake_break(void* ud) { (void)ud; s_breaks++; }
+/* draw_reads: the units the next draw's program samples (REPORT_PRECISE) */
+static int s_reads_known; static uint32_t s_reads_mask; static int s_reads_calls;
+static int fake_draw_reads(void* ud, const struct rsx_state* st, uint32_t* mask)
+{
+    (void)ud; (void)st;
+    s_reads_calls++;
+    if (!s_reads_known) return 0;
+    *mask = s_reads_mask;
+    return 1;
+}
+/* plan_ok (PF6 REPORT_GPU): whether the backend can compose a planned unit */
+static int s_plan_ok = 1, s_plan_ok_calls, s_plan_ok_unit = -1;
+static uint32_t s_plan_ok_ea;
+static int fake_plan_ok(void* ud, int unit, uint32_t ea, uint32_t fmt, uint32_t w, uint32_t h)
+{
+    (void)ud; (void)fmt; (void)w; (void)h;
+    s_plan_ok_calls++; s_plan_ok_unit = unit; s_plan_ok_ea = ea;
+    return s_plan_ok;
+}
+/* The GPU compose of plan row r, modelled: its base plus the samples of the draws not yet measured (the
+ * list being recorded) in its segments, saturated. */
+static uint32_t compose_row(const rsx_rplan_row* row)
+{
+    if (row->mode != 0) return row->w[2];
+    uint64_t v = row->base;
+    for (int i = 0; i < s_ndraws; i++)
+        if (!s_draws[i].done && s_draws[i].seg >= row->lo && s_draws[i].seg <= row->hi) v += s_draws[i].samples;
+    return v > 0xFFFFFFFFull ? 0xFFFFFFFFu : (uint32_t)v;
+}
+static void draw(uint64_t samples)
+{
+    const uint32_t seg = rsx_report_draw_tag();
+    if (seg && s_ndraws < 64) { s_draws[s_ndraws].seg = seg; s_draws[s_ndraws].samples = samples;
+                                s_draws[s_ndraws].done = 0; s_ndraws++; }
+}
+
+static int s_pass, s_fail;
+#define CHECK(c, ...) do { if (c) s_pass++; else { s_fail++; printf("[FAIL] line %d: ", __LINE__); \
+                           printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static void env(const char* kv)
+{
+#ifdef _WIN32
+    _putenv(kv);
+#else
+    putenv((char*)kv);
+#endif
+}
+static void fresh(void)
+{
+    for (size_t i = 0; i < sizeof s_win / sizeof s_win[0]; i++) memset(s_win[i].mem, 0, WIN);
+    s_ndraws = 0; s_measures = 0; s_breaks = 0; s_bad_access = 0;
+    rsx_report_reset();
+    rsx_report_backend be = { fake_measure, fake_break, NULL };
+    rsx_report_set_backend(&be);
+}
+static uint32_t rd(uint32_t ea, int word) { return vm_read32((uint64_t)ea + 4u * (uint32_t)word); }
+static void m(uint32_t method, uint32_t data) { rsx_report_method(method, data); }
+
+/* The save-state record (a private struct) through its field list: its size, a field by name,
+ * and the first field two records differ in -- SS_FF_HOST fields skipped, as the load's
+ * fidelity check does. */
+static size_t ss_rec_size(void)
+{
+    size_t n = 0;
+    for (uint32_t i = 0; i < g_ss_list_gcm_report.n; i++) {
+        const size_t e = (size_t)(uintptr_t)g_ss_list_gcm_report.f[i].at + g_ss_list_gcm_report.f[i].size;
+        if (e > n) n = e;
+    }
+    return n;
+}
+static uint8_t* ss_rec_field(uint8_t* rec, const char* name)
+{
+    for (uint32_t i = 0; i < g_ss_list_gcm_report.n; i++)
+        if (!strcmp(g_ss_list_gcm_report.f[i].name, name)) return rec + (uintptr_t)g_ss_list_gcm_report.f[i].at;
+    return NULL;
+}
+static const char* ss_rec_diff(const uint8_t* a, const uint8_t* b)
+{
+    for (uint32_t i = 0; i < g_ss_list_gcm_report.n; i++) {
+        const ss_field* f = &g_ss_list_gcm_report.f[i];
+        if (f->flags & SS_FF_HOST) continue;
+        if (memcmp(a + (uintptr_t)f->at, b + (uintptr_t)f->at, f->size)) return f->name;
+    }
+    return NULL;
+}
+
+/* The texture func_00131924 builds over the report pair: format 0x0001F52A
+ * (location 2 = main, Y16_X16 | LN | UN, 1 level), 4x2, pitch 16, enabled. */
+static void bind_report_texture(rsx_state* st, uint32_t io)
+{
+    memset(st, 0, sizeof *st);
+    st->textures[0].offset = io;
+    st->textures[0].format = 0x0001F52Au;
+    st->textures[0].control0 = 0x80078000u;
+    st->textures[0].image_rect = (4u << 16) | 2u;
+    st->textures[0].control3 = (1u << 20) | 16u;
+}
+
+int main(void)
+{
+    for (size_t i = 0; i < sizeof s_win / sizeof s_win[0]; i++) s_win[i].mem = (uint8_t*)calloc(1, WIN);
+    env("REPORT_LOG=0");
+
+    /* 1. The record: big-endian {u64 timer, u32 value, u32 0}. */
+    { uint8_t r[16]; rsx_report_encode(r, 0x0102030405060708ull, 0xA1B2C3D4u);
+      static const uint8_t want[16] = {1,2,3,4,5,6,7,8, 0xA1,0xB2,0xC3,0xD4, 0,0,0,0};
+      CHECK(!memcmp(r, want, 16), "CellGcmReportData encoding"); }
+
+    /* 2. Sinks: HOST_BUFFER = IO offset, REPORT_MAIN = IO 0x0E000000 + offset,
+     * REPORT_LOCAL = the 2048-record area, FRAME_BUFFER = local memory. */
+    fresh();
+    CHECK(rsx_report_sink_ea(RSX_DMA_HOST_BUFFER, 0x14080u) == 0x40414080u, "HOST_BUFFER 0x14080 -> 0x%08X",
+          rsx_report_sink_ea(RSX_DMA_HOST_BUFFER, 0x14080u));
+    CHECK(rsx_report_sink_ea(RSX_DMA_REPORT_MAIN, 0x14080u) == RSX_REPORT_NO_EA, "MAIN without IO 0x0E000000 mapped");
+    s_main_mapped = 1;
+    CHECK(rsx_report_sink_ea(RSX_DMA_REPORT_MAIN, 0x14080u) == 0x30014080u, "MAIN 0x14080 -> 0x%08X",
+          rsx_report_sink_ea(RSX_DMA_REPORT_MAIN, 0x14080u));
+    s_main_mapped = 0;
+    CHECK(rsx_report_sink_ea(RSX_DMA_REPORT_LOCAL, 16u * 5u) == rsx_report_local_base() + 80u, "LOCAL index 5");
+    CHECK(rsx_report_sink_ea(RSX_DMA_REPORT_LOCAL, 16u * 2048u) == RSX_REPORT_NO_EA, "LOCAL index 2048 is out of range");
+    CHECK(rsx_report_sink_ea(RSX_DMA_FRAME_BUFFER, 0x100u) == 0xC0000100u, "FRAME_BUFFER");
+    CHECK(rsx_report_sink_ea(0x12345678u, 0) == RSX_REPORT_NO_EA, "unknown DMA handle");
+
+    /* 3. inFamous 2's two queries, then the consumer draw. Nothing is in
+     * memory until something can read it; one measurement serves both. */
+    fresh();
+    rsx_state st;
+    m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
+    m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+    draw(1234);                                   /* the box, depth-tested */
+    m(RSX_M_GET_REPORT, (1u << 24) | 0x14080u);
+    m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+    m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+    draw(5000);                                   /* the same box, depth test off */
+    m(RSX_M_GET_REPORT, (1u << 24) | 0x14090u);
+    m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+    CHECK(rsx_report_pending() == 2 && rd(0x40414080u, 2) == 0 && s_measures == 0,
+          "lazy: 2 pending, nothing written yet (pending %d, measures %d)", rsx_report_pending(), s_measures);
+    memset(&st, 0, sizeof st);                    /* an unrelated draw: no texture over the sink */
+    st.textures[0].offset = 0x100000u; st.textures[0].format = 0x0001F52Au; st.textures[0].control0 = 0x80000000u;
+    st.textures[0].image_rect = (4u << 16) | 2u; st.textures[0].control3 = 16u;
+    rsx_report_begin(&st);
+    CHECK(rsx_report_pending() == 2, "a draw not reading the sink delivers nothing");
+    bind_report_texture(&st, 0x14080u);
+    rsx_report_begin(&st);                        /* func_000E43AC's draw samples it */
+    CHECK(rsx_report_pending() == 0 && s_measures == 1, "consumer draw: delivered with one measurement (%d)", s_measures);
+    CHECK(rd(0x40414080u, 2) == 1234u && rd(0x40414080u, 3) == 0u, "report 0 value %u", rd(0x40414080u, 2));
+    CHECK(rd(0x40414090u, 2) == 5000u && rd(0x40414090u, 3) == 0u, "report 1 value %u", rd(0x40414090u, 2));
+    CHECK(rd(0x40414080u, 0) | rd(0x40414080u, 1), "timer written");
+    CHECK(rsx_report_draw_allowed() == 1, "no RENDER_ENABLE: draws");
+    CHECK(s_breaks >= 6, "segment breaks reported to the backend (%d)", s_breaks);
+
+    /* 4. The counter accumulates until CLEAR_REPORT_VALUE; disabled draws do
+     * not count. */
+    fresh();
+    m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
+    m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+    draw(100);
+    m(RSX_M_GET_REPORT, (1u << 24) | 0x100u);
+    draw(50);
+    m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+    draw(999);                                    /* counting off */
+    CHECK(rsx_report_draw_tag() == 0, "no segment while counting is off");
+    m(RSX_M_GET_REPORT, (1u << 24) | 0x110u);
+    m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+    m(RSX_M_CLEAR_REPORT_VALUE, 1);
+    draw(7);
+    m(RSX_M_GET_REPORT, (1u << 24) | 0x120u);
+    rsx_report_sync("label");
+    CHECK(rd(0x40400100u, 2) == 100u, "first report 100, got %u", rd(0x40400100u, 2));
+    CHECK(rd(0x40400110u, 2) == 150u, "no clear: 150, got %u", rd(0x40400110u, 2));
+    CHECK(rd(0x40400120u, 2) == 7u, "after a clear: 7, got %u", rd(0x40400120u, 2));
+
+    /* 5. A report whose range recorded no draw is known at once. */
+    fresh();
+    m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
+    m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+    vm_write32(0x40400208u, 0xDEADBEEFu);
+    m(RSX_M_GET_REPORT, (1u << 24) | 0x200u);
+    CHECK(rsx_report_pending() == 0 && s_measures == 0 && rd(0x40400200u, 2) == 0u,
+          "no draws: written at once without the GPU (value %u)", rd(0x40400200u, 2));
+
+    /* 6. REPORT_SYNC=0: measured and written at GET_REPORT. */
+    env("REPORT_SYNC=0"); fresh();
+    m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
+    m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+    draw(42);
+    m(RSX_M_GET_REPORT, (1u << 24) | 0x300u);
+    CHECK(rsx_report_pending() == 0 && s_measures == 1 && rd(0x40400300u, 2) == 42u, "REPORT_SYNC=0");
+    env("REPORT_SYNC=1");
+
+    /* 7. RENDER_ENABLE: 0x01000000 always; 0x02000000|off while the report at
+     * off is non-zero -- after delivering a pending report there. */
+    fresh();
+    m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
+    m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+    draw(0);                                      /* fully occluded */
+    m(RSX_M_GET_REPORT, (1u << 24) | 0x400u);
+    m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+    m(RSX_M_RENDER_ENABLE, 0x02000000u | 0x400u);
+    rsx_report_begin(NULL);
+    CHECK(rsx_report_pending() == 0 && rsx_report_draw_allowed() == 0, "occluded: conditional draw skipped");
+    m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+    draw(3);
+    m(RSX_M_GET_REPORT, (1u << 24) | 0x400u);
+    m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+    rsx_report_begin(NULL);
+    CHECK(rsx_report_draw_allowed() == 1 && rd(0x40400400u, 2) == 3u, "visible: conditional draw drawn");
+    m(RSX_M_RENDER_ENABLE, 0x01000000u);
+    rsx_report_begin(NULL);
+    CHECK(rsx_report_draw_allowed() == 1, "RENDER_ENABLE 0x01000000: always");
