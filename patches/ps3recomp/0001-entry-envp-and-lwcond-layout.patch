+def _rc_ends_in_transfer(m: str) -> bool:
+    """Does (masked) code m end in an unconditional transfer of control?"""
+    items = _rc_items(m)
+    if not items:
+        return False
+    last = items[-1]
+    if last == "return;" or re.fullmatch(r"goto loc_[0-9A-F]{8};", last):
