+static void pfx_set_ids(unsigned* dst, int* nd, const unsigned* ids, int n)
+{
+    if (!ids || n < 0) n = 0;
+    if (n > PFX_IDS) n = PFX_IDS;
+    for (int i = 0; i < n; i++) dst[i] = ids[i];
+    *nd = n;
+    pfx_watch_update();
