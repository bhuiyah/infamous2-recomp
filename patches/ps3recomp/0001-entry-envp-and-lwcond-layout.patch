diff --git a/libs/video/rsx_rthread.h b/libs/video/rsx_rthread.h
new file mode 100644
index 0000000..a3ddd45
--- /dev/null
+++ b/libs/video/rsx_rthread.h
@@ -0,0 +1,124 @@
+/* rsx_rthread.h -- R1's render thread: one job in flight, handed over by one producer (the FIFO walker) and drained
+ * by it (rsx_d3d12_backend.c RENDER_THREAD; tests/test_rthread.c).
+ *
+ * The producer writes the job's inputs, then rtt_kick: SetEvent publishes every write before it to the thread,
+ * which runs fn(arg) once per kick. rtt_drain returns only when no job is in flight; the thread's writes made in
+ * fn are visible to the producer after it (the thread's interlocked release of `busy`, the producer's interlocked
+ * read). The producer never kicks while a job is in flight (it drains first). rtt_stop drains, stops and joins. No
+ * job runs after rtt_stop; a thread that cannot be made leaves rtt_start returning 0 (the caller runs the job
+ * itself). Windows only.
+ *
+ * `done` is an auto-reset event the thread sets after every job, after it released `busy`; the drain waits on it
+ * only while `busy` reads 1 and re-reads `busy` after every wake. A late SetEvent of the previous job (the producer
+ * saw busy 0, kicked, and the thread's SetEvent came after) is one spurious wake of the next drain, never a missed
+ * one: every release of `busy` is followed by a SetEvent.
+ *
+ * The producer owns the game window. A Present on the thread may, in some DXGI modes (an exclusive-fullscreen or
+ * mode change -- the backend uses neither), send a message to the window's thread and wait for it; a drain that
+ * only waited would then never return. So a drain that has waited RTT_PUMP_MS with the job still in flight waits
+ * with MsgWaitForMultipleObjectsEx and dispatches SENT messages only (PeekMessage PM_QS_SENDMESSAGE): no posted
+ * message -- input, hotkeys, menu commands, the modal timer that ticks the frame clock -- is taken from the queue,
+ * so nothing re-enters the frame loop from inside a drain. A normal drain (a replay and its Present end within a
+ * few ms) dispatches nothing, as before; `n_pumped` counts the drains that reached the pumping wait. */
+#ifndef RSX_RTHREAD_H
+#define RSX_RTHREAD_H
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#ifndef RTT_PUMP_MS
+#define RTT_PUMP_MS 50
+#endif
+
+typedef struct {
+    HANDLE th, go, done;
+    volatile LONG busy, stop;
+    void (*fn)(void* arg);
+    void* arg;
+    volatile double busy_s;        /* seconds in fn (the thread's own count; never reset: read and diffed) */
+    volatile unsigned long long jobs;   /* jobs run (the thread's) */
+    unsigned long long n_wait;     /* drains that found a job in flight (the producer's) */
+    double wait_s;                 /* seconds the producer waited in those */
+    unsigned long long n_pumped;   /* drains that waited RTT_PUMP_MS and pumped sent messages */
+    LARGE_INTEGER qf;
+} RtThread;
+
+static double rtt_now(const RtThread* t)
+{
+    LARGE_INTEGER c; QueryPerformanceCounter(&c);
+    return (double)c.QuadPart / (double)t->qf.QuadPart;
+}
+static DWORD WINAPI rtt_main(LPVOID p)
+{
+    RtThread* t = (RtThread*)p;
+    for (;;) {
+        WaitForSingleObject(t->go, INFINITE);
+        if (InterlockedCompareExchange(&t->stop, 0, 0)) break;
+        const double t0 = rtt_now(t);
+        t->fn(t->arg);
+        t->busy_s = t->busy_s + (rtt_now(t) - t0);   /* aligned 8-byte stores: the producer reads whole values */
+        t->jobs = t->jobs + 1;
+        InterlockedExchange(&t->busy, 0);   /* release: fn's writes before it */
+        SetEvent(t->done);                  /* after the release (auto-reset: a late one is one spurious wake) */
+    }
+    return 0;
+}
+/* 1 when the thread runs (or already ran); 0: the caller runs its jobs itself */
+static int rtt_start(RtThread* t, void (*fn)(void*), void* arg, const wchar_t* name, int prio)
+{
+    if (t->th) return 1;
+    QueryPerformanceFrequency(&t->qf);
+    t->fn = fn; t->arg = arg; t->busy = 0; t->stop = 0;
+    t->go = CreateEventA(NULL, FALSE, FALSE, NULL);
+    t->done = CreateEventA(NULL, FALSE, FALSE, NULL);   /* auto-reset */
+    if (t->go && t->done) t->th = CreateThread(NULL, 0, rtt_main, t, 0, NULL);
+    if (!t->th) {
+        if (t->go) CloseHandle(t->go);
+        if (t->done) CloseHandle(t->done);
+        t->go = t->done = NULL;
+        return 0;
+    }
+    SetThreadPriority(t->th, prio);
+    {   typedef HRESULT (WINAPI *SetDesc)(HANDLE, PCWSTR);
+        SetDesc sd = (SetDesc)(void*)GetProcAddress(GetModuleHandleA("kernel32.dll"), "SetThreadDescription");
+        if (sd && name) sd(t->th, name); }
+    return 1;
+}
+static int rtt_busy(RtThread* t) { return t->th && InterlockedCompareExchange(&t->busy, 0, 0) != 0; }
+/* The producer: no job in flight when this returns. A short spin first (a replay ends within ~1-2 ms), then the
+ * event; past RTT_PUMP_MS, the event or a sent message (dispatched here, see above). */
+static void rtt_drain(RtThread* t)
+{
+    if (!t->th || !InterlockedCompareExchange(&t->busy, 0, 0)) return;
+    const double t0 = rtt_now(t);
+    for (int i = 0; i < 4000 && InterlockedCompareExchange(&t->busy, 0, 0); i++) YieldProcessor();
+    int pumped = 0;
+    while (InterlockedCompareExchange(&t->busy, 0, 0)) {
+        if (!pumped) {
+            const double left_ms = RTT_PUMP_MS - 1e3 * (rtt_now(t) - t0);
+            if (left_ms > 0.0) { WaitForSingleObject(t->done, (DWORD)left_ms + 1u); continue; }
+            pumped = 1; t->n_pumped++;
+        }
+        const DWORD r = MsgWaitForMultipleObjectsEx(1, &t->done, INFINITE, QS_SENDMESSAGE, MWMO_INPUTAVAILABLE);
+        if (r == WAIT_OBJECT_0 + 1) { MSG m; PeekMessageW(&m, NULL, 0, 0, PM_NOREMOVE | PM_QS_SENDMESSAGE); }
+    }
+    t->n_wait++; t->wait_s += rtt_now(t) - t0;
+}
+/* The producer, with no job in flight (drained): run fn(arg) on the thread. */
+static void rtt_kick(RtThread* t)
+{
+    if (InterlockedCompareExchange(&t->busy, 0, 0)) rtt_drain(t);   /* (never: the caller drained) */
+    InterlockedExchange(&t->busy, 1);
+    SetEvent(t->go);                                                  /* publishes the inputs */
+}
+static void rtt_stop(RtThread* t)
+{
+    if (!t->th) return;
+    rtt_drain(t);
+    InterlockedExchange(&t->stop, 1);
+    SetEvent(t->go);
+    WaitForSingleObject(t->th, 5000);
+    CloseHandle(t->th); CloseHandle(t->go); CloseHandle(t->done);
+    t->th = t->go = t->done = NULL;
+}
+#endif /* RSX_RTHREAD_H */
diff --git a/libs/video/rsx_shader_async.h b/libs/video/rsx_shader_async.h
new file mode 100644
index 0000000..19a713a
--- /dev/null
+++ b/libs/video/rsx_shader_async.h
@@ -0,0 +1,302 @@
+/*
+ * rsx_shader_async.h -- the D3D12 backend's shader compile workers
+ * (rsx_d3d12_backend.c: SHADER_ASYNC, the shader list's prewarm, record-time
+ * kicks). Header-only, static, Windows.
+ *
+ * The on-disk DXBC cache names a compiled shader by its content: two
+ * independent 64-bit hashes of (target, 0, HLSL source). sc_build compiles
+ * (D3DCompile, flags 0) and writes the file as a temp file renamed into
+ * place; sc_file_read accepts only a DXBC blob of its recorded size. The pool
+ * runs sc_build on worker threads (below-normal priority; a record-time kick
+ * runs at normal). A thread that needs a source a worker is building calls
+ * sc_job_wait: a job still queued is taken back (the caller compiles it
+ * itself, as it would have without the pool), a running one is waited for,
+ * its worker raised to above-normal priority, after which the cache file is
+ * there. A source compiles to the same DXBC whichever thread compiles it, so
+ * the pool changes when a shader is compiled, never what it compiles to.
+ *
+ * Test: tests/test_shader_async.c (real D3DCompile; build line there).
+ */
+#ifndef RSX_SHADER_ASYNC_H
+#define RSX_SHADER_ASYNC_H
+
+#include <windows.h>
+#include <d3dcompiler.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../../runtime/platform/host_placement.h"   /* the compile workers run on every core */
+
+/* The cache file of (source, target): FNV-1a 64 and a multiply-rotate hash,
+ * both over (target, 0, source). */
+static void sc_path(const char* dir, const char* src, size_t len, const char* target, char* path, size_t cap)
+{
+    unsigned long long h1 = 1469598103934665603ull, h2 = 0x9E3779B97F4A7C15ull ^ (unsigned long long)len;
+    for (const char* t = target; ; t++) {
+        unsigned char c = (unsigned char)*t;
+        h1 = (h1 ^ c) * 1099511628211ull;
+        h2 = ((h2 ^ c) * 0xFF51AFD7ED558CCDull); h2 ^= h2 >> 29;
+        if (!c) break;
+    }
+    for (size_t i = 0; i < len; i++) {
+        unsigned char c = (unsigned char)src[i];
+        h1 = (h1 ^ c) * 1099511628211ull;
+        h2 = ((h2 ^ c) * 0xFF51AFD7ED558CCDull); h2 ^= h2 >> 29;
+    }
+    snprintf(path, cap, "%s\\%016llX%016llX_%s.dxbc", dir, h1, h2, target);
+}
+
+/* A cache file that is a DXBC blob of its recorded size, or nothing. */
+static int sc_file_read(const char* path, ID3DBlob** out)
+{
+    HANDLE f = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (f == INVALID_HANDLE_VALUE) return 0;
+    LARGE_INTEGER sz; ID3DBlob* b = NULL; DWORD got = 0;
+    if (GetFileSizeEx(f, &sz) && sz.QuadPart >= 32 && sz.QuadPart < (16 << 20) &&
+        SUCCEEDED(D3DCreateBlob((SIZE_T)sz.QuadPart, &b)) && b) {
+        unsigned char* p = (unsigned char*)b->lpVtbl->GetBufferPointer(b);
+        if (ReadFile(f, p, (DWORD)sz.QuadPart, &got, NULL) && got == (DWORD)sz.QuadPart &&
+            p[0] == 'D' && p[1] == 'X' && p[2] == 'B' && p[3] == 'C' &&
+            (p[24] | (p[25] << 8) | (p[26] << 16) | ((unsigned)p[27] << 24)) == (unsigned)sz.QuadPart) {
+            CloseHandle(f); *out = b;
+            return 1;
+        }
+        b->lpVtbl->Release(b);
+    }
+    CloseHandle(f);
+    return 0;
+}
+
+/* D3DCompile, then the cache file (path "" = no cache): a temp file renamed
+ * into place, so a crash or a second writer never leaves a partial entry. */
+static HRESULT sc_build(const char* src, size_t len, const char* name, const char* target,
+                        const char* path, ID3DBlob** out, ID3DBlob** err)
+{
+    HRESULT hr = D3DCompile(src, len, name, NULL, NULL, "main", target, 0, 0, out, err);
+    if (path[0] && SUCCEEDED(hr) && *out) {
+        char tmp[MAX_PATH + 112];
+        snprintf(tmp, sizeof tmp, "%s.%lu.tmp", path, (unsigned long)GetCurrentThreadId());
+        HANDLE f = CreateFileA(tmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+        if (f != INVALID_HANDLE_VALUE) {
+            DWORD n = (DWORD)(*out)->lpVtbl->GetBufferSize(*out), put = 0;
+            BOOL ok = WriteFile(f, (*out)->lpVtbl->GetBufferPointer(*out), n, &put, NULL) && put == n;
+            CloseHandle(f);
+            if (!ok || !MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) DeleteFileA(tmp);
+        }
+    }
+    return hr;
+}
+
+#define SC_JOBS_MAX 256
+typedef struct {
+    char* src; size_t len;
+    const char* name; char target[8];
+    char path[MAX_PATH + 96];
+    volatile LONG refs;            /* the slot's + each waiter's */
+    int state;                     /* 0 queued, 1 running (under s_scp.lk) */
+    int hi;                        /* a record-time kick: before prewarm work */
+    unsigned seq;
+    HANDLE done;                   /* manual reset: compiled (or failed) */
+    HANDLE worker;                 /* the thread running it */
+} ScJob;
+static struct {
+    int on;                        /* -1 unknown, 0 off, 1 on (the backend's sc_async_on) */
+    SRWLOCK lk;
+    HANDLE sem;
+    ScJob* slot[SC_JOBS_MAX];      /* queued and running jobs */
+    volatile int n_lo, n_hi;       /* queued (read unlocked as a hint) */
+    unsigned seq;
+    int threads;
+    volatile LONG built, failed, taken, waited, kicked;
+} s_scp = { -1 };
+
+static void sc_job_release(ScJob* j)
+{
+    if (InterlockedDecrement(&j->refs) == 0) {
+        free(j->src);
+        if (j->done) CloseHandle(j->done);
+        free(j);
+    }
+}
+
+static DWORD WINAPI sc_worker(LPVOID arg)
+{
+    (void)arg;
+    ps3_host_unplace_thread();   /* compile bursts (a cold cache) must not crowd the shared cores the game waits on */
+    HANDLE self = NULL;                          /* a real handle, for sc_job_wait's boost */
+    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &self,
+                    THREAD_SET_INFORMATION | THREAD_QUERY_INFORMATION, FALSE, 0);
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    for (;;) {
+        WaitForSingleObject(s_scp.sem, INFINITE);
+        ScJob* j = NULL;
+        AcquireSRWLockExclusive(&s_scp.lk);
+        int best = -1;
+        for (int i = 0; i < SC_JOBS_MAX; i++) {
+            const ScJob* q = s_scp.slot[i];
+            if (!q || q->state != 0) continue;
+            if (best < 0 || q->hi > s_scp.slot[best]->hi ||
+                (q->hi == s_scp.slot[best]->hi && (int)(q->seq - s_scp.slot[best]->seq) < 0)) best = i;
+        }
+        if (best >= 0) {
+            j = s_scp.slot[best]; j->state = 1; j->worker = self;
+            if (j->hi) s_scp.n_hi--; else s_scp.n_lo--;
+        }
+        ReleaseSRWLockExclusive(&s_scp.lk);
+        if (!j) continue;                       /* taken back by sc_job_wait */
+        if (j->hi) SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_NORMAL);
+        ID3DBlob *o = NULL, *e = NULL;
+        const HRESULT hr = sc_build(j->src, j->len, j->name, j->target, j->path, &o, &e);
+        if (o) o->lpVtbl->Release(o);
+        if (e) e->lpVtbl->Release(e);
+        InterlockedIncrement(SUCCEEDED(hr) ? &s_scp.built : &s_scp.failed);
+        AcquireSRWLockExclusive(&s_scp.lk);
+        for (int i = 0; i < SC_JOBS_MAX; i++) if (s_scp.slot[i] == j) { s_scp.slot[i] = NULL; break; }
+        ReleaseSRWLockExclusive(&s_scp.lk);
+        SetEvent(j->done);
+        SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+        sc_job_release(j);                      /* the slot's reference */
+    }
+    return 0;
+}
+
+/* Start n workers (1..16); the number started (0: the pool is off). */
+static int sc_pool_start(int n)
+{
+    InitializeSRWLock(&s_scp.lk);
+    s_scp.sem = CreateSemaphoreA(NULL, 0, 0x7FFFFFFF, NULL);
+    if (!s_scp.sem) { s_scp.on = 0; return 0; }
+    if (n < 1) n = 1;
+    if (n > 16) n = 16;
+    for (int i = 0; i < n; i++) {
+        HANDLE h = CreateThread(NULL, 4u << 20, sc_worker, NULL, STACK_SIZE_PARAM_IS_A_RESERVATION, NULL);
+        if (!h) break;
+        CloseHandle(h);
+        s_scp.threads++;
+    }
+    s_scp.on = s_scp.threads ? 1 : 0;
+    return s_scp.threads;
+}
+
+/* Hand a compile to the workers; 0 = not queued (the pool is off, the same
+ * file is already queued or running, or every slot is in use). */
+static int sc_submit(const char* src, size_t len, const char* name, const char* target, const char* path, int hi)
+{
+    if (s_scp.on != 1) return 0;
+    ScJob* j = (ScJob*)calloc(1, sizeof *j);
+    if (!j) return 0;
+    j->src = (char*)malloc(len + 1);
+    j->done = CreateEventA(NULL, TRUE, FALSE, NULL);
+    if (!j->src || !j->done) { free(j->src); if (j->done) CloseHandle(j->done); free(j); return 0; }
+    memcpy(j->src, src, len); j->src[len] = 0; j->len = len;
+    j->name = name; snprintf(j->target, sizeof j->target, "%s", target);
+    snprintf(j->path, sizeof j->path, "%s", path);
+    j->refs = 1; j->hi = hi;
+    int put = 0;
+    AcquireSRWLockExclusive(&s_scp.lk);
+    int free_i = -1, dup = 0;
+    for (int i = 0; i < SC_JOBS_MAX; i++) {
+        if (!s_scp.slot[i]) { if (free_i < 0) free_i = i; continue; }
+        if (!strcmp(s_scp.slot[i]->path, path)) { dup = 1; break; }
+    }
+    if (!dup && free_i >= 0) {
+        j->seq = s_scp.seq++;
+        s_scp.slot[free_i] = j;
+        if (hi) s_scp.n_hi++; else s_scp.n_lo++;
+        put = 1;
+    }
+    ReleaseSRWLockExclusive(&s_scp.lk);
+    if (!put) { sc_job_release(j); return 0; }
+    ReleaseSemaphore(s_scp.sem, 1, NULL);
+    return 1;
+}
+
+/* The caller needs `path`: 1 = a worker was building it and has finished
+ * (read the file); 0 = compile it yourself (no job, or a queued one, which
+ * this takes back). */
+static int sc_job_wait(const char* path)
+{
+    if (s_scp.on != 1) return 0;
+    ScJob *j = NULL, *tk = NULL;
+    AcquireSRWLockExclusive(&s_scp.lk);
+    for (int i = 0; i < SC_JOBS_MAX; i++) {
+        ScJob* q = s_scp.slot[i];
+        if (!q || strcmp(q->path, path)) continue;
+        if (q->state == 0) {                     /* not started: the caller's */
+            s_scp.slot[i] = NULL; tk = q;
+            if (q->hi) s_scp.n_hi--; else s_scp.n_lo--;
+        } else { j = q; InterlockedIncrement(&j->refs); }
+        break;
+    }
+    ReleaseSRWLockExclusive(&s_scp.lk);
+    if (tk) { InterlockedIncrement(&s_scp.taken); sc_job_release(tk); return 0; }
+    if (!j) return 0;
+    if (j->worker) SetThreadPriority(j->worker, THREAD_PRIORITY_ABOVE_NORMAL);
+    WaitForSingleObject(j->done, INFINITE);
+    sc_job_release(j);
+    InterlockedIncrement(&s_scp.waited);
+    return 1;
+}
+
+/* ST1 (PSO_PREWARM, rsx_pso_list.h): DXBC blobs held in memory by their cache
+ * file's name. The pipeline prewarm reads the shaders of the pipelines it
+ * makes from the cache files on its own threads and puts them here;
+ * sc_compile looks a source's file name up here before it opens the file, so
+ * a shader the prewarm read costs the walker no disk read. A blob here is
+ * the file's bytes as sc_file_read accepted them -- the blob sc_compile would
+ * have read. Empty (nothing ever put) with PSO_PREWARM=0. */
+#define SC_MEM_SLOTS 32768                       /* power of two; half full at most */
+typedef struct { unsigned long long h; char name[48]; ID3DBlob* b; } ScMemEnt;
+static struct { SRWLOCK lk; ScMemEnt* e; int n; unsigned long long bytes; } s_scm;   /* (zero = SRWLOCK_INIT) */
+static unsigned long long sc_mem_hash(const char* s)
+{
+    unsigned long long h = 1469598103934665603ull;
+    for (; *s; s++) h = (h ^ (unsigned char)*s) * 1099511628211ull;
+    return h ? h : 1ull;
+}
+/* The blob held for this file name (AddRef'd), or NULL. */
+static ID3DBlob* sc_mem_find(const char* name)
+{
+    if (!s_scm.e) return NULL;                   /* (a first look; checked again under the lock: sc_mem_clear) */
+    const unsigned long long h = sc_mem_hash(name);
+    ID3DBlob* b = NULL;
+    AcquireSRWLockShared(&s_scm.lk);
+    for (unsigned i = (unsigned)(h ^ (h >> 31)) & (SC_MEM_SLOTS - 1u); s_scm.e && s_scm.e[i].h; i = (i + 1u) & (SC_MEM_SLOTS - 1u))
+        if (s_scm.e[i].h == h && !strcmp(s_scm.e[i].name, name)) { b = s_scm.e[i].b; b->lpVtbl->AddRef(b); break; }
+    ReleaseSRWLockShared(&s_scm.lk);
+    return b;
+}
+/* Hold blob b (sc_file_read's) under its file name (its own reference). */
+static void sc_mem_put(const char* name, ID3DBlob* b)
+{
+    if (strlen(name) >= sizeof s_scm.e[0].name) return;
+    const unsigned long long h = sc_mem_hash(name);
+    AcquireSRWLockExclusive(&s_scm.lk);
+    if (!s_scm.e) s_scm.e = (ScMemEnt*)calloc(SC_MEM_SLOTS, sizeof *s_scm.e);
+    if (s_scm.e && s_scm.n < (int)(SC_MEM_SLOTS / 2)) {
+        unsigned i = (unsigned)(h ^ (h >> 31)) & (SC_MEM_SLOTS - 1u);
+        for (; s_scm.e[i].h; i = (i + 1u) & (SC_MEM_SLOTS - 1u))
+            if (s_scm.e[i].h == h && !strcmp(s_scm.e[i].name, name)) break;
+        if (!s_scm.e[i].h) {
+            s_scm.e[i].h = h;
+            memcpy(s_scm.e[i].name, name, strlen(name) + 1);
+            s_scm.e[i].b = b; b->lpVtbl->AddRef(b);
+            s_scm.n++;
+            s_scm.bytes += b->lpVtbl->GetBufferSize(b);
+        }
+    }
+    ReleaseSRWLockExclusive(&s_scm.lk);
+}
+/* Shutdown (ST1 review): every blob held released and the map emptied; a later init starts with none. */
+static void sc_mem_clear(void)
+{
+    AcquireSRWLockExclusive(&s_scm.lk);
+    if (s_scm.e) {
+        for (unsigned i = 0; i < SC_MEM_SLOTS; i++) if (s_scm.e[i].b) s_scm.e[i].b->lpVtbl->Release(s_scm.e[i].b);
+        free(s_scm.e);
+    }
+    s_scm.e = NULL; s_scm.n = 0; s_scm.bytes = 0;
+    ReleaseSRWLockExclusive(&s_scm.lk);
+}
+
+#endif /* RSX_SHADER_ASYNC_H */
