+/* ---------------------------------------------------------------- the menu */
+
+void ovl_menu_faces(float s, int faces[OVL_NFACE][2])
+{
+    static const int base[OVL_NFACE][2] = {
+        { 19, 400 }, { 16, 400 }, { 25, 600 }, { 34, 700 }, { 19, 600 }, { 13, 700 }, { 18, 600 } };
+    for (int i = 0; i < OVL_NFACE; i++) {
+        int px = (int)(base[i][0] * s + 0.5f);
+        if (px < 11) px = 11;
+        faces[i][0] = px;
+        faces[i][1] = base[i][1];
+    }
+}
+
+float ovl_menu_scale(int cw, int ch, unsigned dpi, float user)
+{
+    (void)cw;
+    float s = (float)ch / 1080.0f;
+    if (s < 0.8f) s = 0.8f;
+    const float sd = 0.8f * (float)(dpi ? dpi : 96) / 96.0f;
+    if (s < sd) s = sd;
+    if (user > 0.1f) s *= user;
+    s = floorf(s * 20.0f + 0.5f) / 20.0f;
+    if (s < 0.5f) s = 0.5f;
+    if (s > 4.0f) s = 4.0f;
+    return s;
+}
+
+void ovl_menu_init(ovl_menu* m)
+{
+    memset(m, 0, sizeof *m);
+    m->drag_item = -1;
+    m->hover_item = -1;
+    m->s = 1.0f;
+}
+
+void ovl_menu_opened(ovl_menu* m)
+{
+    build_tabs(m);
+    build_items(m);
+    m->dd_open = 0;
+    m->drag_item = -1;
+    m->hover_item = -1;
+    m->msg[0] = 0;
+    m->msg_until = 0;
+    m->confirm_until = 0;
+    m->confirm_what = 0;
+    m->dirty = 1;
+}
+
+double ovl_menu_next_wake(const ovl_menu* m)
+{
+    double t = 0;
+    if (m->msg_until > m->now) t = m->msg_until;
+    if (m->mouse_in && m->hover_item >= 0 && m->hover_since + 0.55 > m->now) {
+        double h = m->hover_since + 0.55;
+        if (!t || h < t) t = h;
+    }
+    if (m->confirm_until > m->now && (!t || m->confirm_until < t)) t = m->confirm_until;
+    return t;
+}
+
+static void draw_row(ovl_menu* m, ovl_list* L, int i, int focus)
+{
+    ovl_item* it = &m->items[i];
+    const float rh = it->y1 - it->y0;
+    const float cy = it->y0 + (rh - S(m, 4)) / 2;
+    const float x0 = it->x0, x1 = it->x1;
+    const opt_def* d = it->kind == OVL_IT_SETTING ? opt_def_of(it->id) : NULL;
+    const char* env = NULL;
+    const int locked = d ? opt_locked(it->id, &env) : 0;
+    if (focus) {
+        ovl_rect(L, x0, it->y0, x1, it->y1 - S(m, 4), ovl_col(C_ACCENT, 0.14f), S(m, 8));
+        ovl_rect(L, x0, it->y0 + S(m, 8), x0 + S(m, 3), it->y1 - S(m, 12), ovl_col(C_ACCENT, 1), S(m, 1.5f));
+    } else if (i % 2) {
+        ovl_rect(L, x0, it->y0, x1, it->y1 - S(m, 4), ovl_col(0xFFFFFF, 0.025f), S(m, 8));
+    }
+    const ovl_rgba tc = locked ? ovl_col(C_TEXT3, 1) : ovl_col(focus ? C_TEXT : 0xD3D9E2, 1);
+    const float lx = x0 + S(m, 14);
+    float badges_w = 0;   /* the label gives way to its badges, so they never reach the control */
+    if (d && locked) badges_w += badge_w(m, L, "ENV") + S(m, 6);
+    if (d && d->apply == OPT_RESTART) badges_w += badge_w(m, L, "RESTART") + S(m, 6);
+    const float label_max = it->cx0 - lx - S(m, 16) - (badges_w > 0 ? badges_w + S(m, 4) : 0);
+    if (it->kind == OVL_IT_INFO) {
+        ovl_text_fit(L, OVL_F_SMALL, lx, base_c(L, OVL_F_SMALL, cy), it->label, ovl_col(C_TEXT3, 1), S(m, 150));
+        ovl_text_fit(L, OVL_F_SMALL, lx + S(m, 160), base_c(L, OVL_F_SMALL, cy), it->info, ovl_col(C_TEXT2, 1),
+                     x1 - lx - S(m, 170));
+        return;
+    }
+    if (it->kind == OVL_IT_ACTION) {
+        const float bw = ovl_text_w(L, OVL_F_BODY, it->label) + S(m, 36);
+        const int armed = it->action == m->confirm_what && m->now < m->confirm_until;
+        const unsigned col = armed ? C_AMBER : C_ACCENT;
+        ovl_rect(L, lx, cy - S(m, 16), lx + bw, cy + S(m, 16), ovl_col(col, focus ? 0.30f : 0.14f), S(m, 8));
+        ovl_frame(L, lx, cy - S(m, 16), lx + bw, cy + S(m, 16), ovl_col(col, 0.7f), S(m, 8), S(m, 1));
+        ovl_text(L, OVL_F_BODY, lx + S(m, 18), base_c(L, OVL_F_BODY, cy),
+                 armed ? "Press again to confirm" : it->label, ovl_col(C_TEXT, 1));
+        it->bx0 = it->bx1 = 0;
+        return;
+    }
+    float lw = ovl_text_fit(L, OVL_F_BODY, lx, base_c(L, OVL_F_BODY, cy), it->label, tc, label_max);
+    /* badges */
+    float bx = lx + lw + S(m, 10);
+    it->bx0 = bx;
+    if (d && locked) bx += badge(m, L, bx, cy, "ENV", C_ENV, 0) + S(m, 6);
+    if (d && d->apply == OPT_RESTART)   /* filled while a change waits for the next launch */
+        bx += badge(m, L, bx, cy, "RESTART", C_AMBER, opt_restart_pending_row(it->id)) + S(m, 6);
+    it->bx1 = bx;
+    /* the control */
+    const float c0 = it->cx0, c1 = it->cx1;
+    char vt[96];
+    if (it->kind == OVL_IT_PRESET) {
+        const int p = opt_preset_current();
+        snprintf(vt, sizeof vt, "%s", p < 0 ? "Custom" : s_preset_names[p]);
+    } else ovl_menu_value_text(m, it->id, vt, sizeof vt);
+    const ovl_rgba ac = locked ? ovl_col(C_TEXT3, 0.6f) : focus ? ovl_col(C_ACCENT, 1) : ovl_col(C_TEXT3, 1);
+    if (it->ui == UI_SELECT) {
+        ovl_tri(L, c0 + S(m, 10), cy, S(m, 6), 3, ac, 0);
+        ovl_tri(L, c1 - S(m, 10), cy, S(m, 6), 1, ac, 0);
+        const float maxw = c1 - c0 - S(m, 48);
+        float w = ovl_text_w(L, OVL_F_BODY, vt);
+        if (w > maxw) w = maxw;
+        ovl_text_fit(L, OVL_F_BODY, (c0 + c1) / 2 - w / 2, base_c(L, OVL_F_BODY, cy), vt, locked ? ovl_col(C_TEXT3, 1) : ovl_col(C_TEXT, 1), maxw);
+    } else if (it->ui == UI_SLIDER && d) {
+        slider_t sl;
+        slider_of(d, &sl);
+        const float vw = S(m, 64);
+        const float t0 = c0, t1 = c1 - vw - S(m, 14);
+        const float h = S(m, 6);
+        const float t = (float)slider_pos(d, it->id, &sl);
+        ovl_rect(L, t0, cy - h / 2, t1, cy + h / 2, ovl_col(C_TRACK, 1), h / 2);
+        const float k = t0 + (t1 - t0) * t;
+        ovl_rect(L, t0, cy - h / 2, k, cy + h / 2, locked ? ovl_col(C_TEXT3, 1) : ovl_col(C_ACCENT, 1), h / 2);
+        if (sl.word_stop) {   /* a tick for the word stop */
+            const float wx = t0 + (t1 - t0) * 0.0f;
+            ovl_rect(L, wx - S(m, 1), cy - S(m, 7), wx + S(m, 1), cy + S(m, 7), ovl_col(C_TEXT3, 1), 0);
+        }
+        if (focus && !locked) ovl_circle(L, k, cy, S(m, 13), ovl_col(C_ACCENT, 0.25f), 0);
+        ovl_circle(L, k, cy, S(m, 8), locked ? ovl_col(C_TEXT3, 1) : ovl_col(0xF4F7FB, 1), 0);
+        const float w = ovl_text_w(L, OVL_F_BODY, vt);
+        ovl_text(L, OVL_F_BODY, c1 - w, base_c(L, OVL_F_BODY, cy), vt, locked ? ovl_col(C_TEXT3, 1) : ovl_col(C_TEXT, 1));
+    } else if (it->ui == UI_TOGGLE && d) {
+        const int on = opt_i(it->id) != 0;
+        const float w = S(m, 44), h = S(m, 24);
+        ovl_rect(L, c1 - w, cy - h / 2, c1, cy + h / 2,
+                 locked ? ovl_col(C_TRACK, 1) : on ? ovl_col(C_ACCENT, 1) : ovl_col(C_TRACK, 1), h / 2);
+        if (focus && !locked)
+            ovl_frame(L, c1 - w - S(m, 3), cy - h / 2 - S(m, 3), c1 + S(m, 3), cy + h / 2 + S(m, 3),
+                      ovl_col(C_ACCENT, 0.6f), h / 2 + S(m, 3), S(m, 1.5f));
+        const float kx = on ? c1 - h / 2 : c1 - w + h / 2;
+        ovl_circle(L, kx, cy, h / 2 - S(m, 3), locked ? ovl_col(C_TEXT3, 1) : ovl_col(0xF4F7FB, 1), 0);
+        ovl_text(L, OVL_F_BODY, c1 - w - S(m, 12) - ovl_text_w(L, OVL_F_BODY, vt), base_c(L, OVL_F_BODY, cy), vt,
+                 ovl_col(C_TEXT2, 1));
+    }
+}
+
+static void draw_info(ovl_menu* m, ovl_list* L, float y0, float y1)
+{
+    if (m->ix1 - m->ix0 < S(m, 200)) return;
+    ovl_rect(L, m->ix0, y0, m->ix1, y1, ovl_col(0xFFFFFF, 0.035f), S(m, 10));
+    const int f = m->focus[m->tab];
+    if (f < 0 || f >= m->nitems) return;
+    const ovl_item* it = &m->items[f];
+    const float x = m->ix0 + S(m, 22), maxw = m->ix1 - m->ix0 - S(m, 44);
+    float y = y0 + S(m, 40);
+    ovl_text_fit(L, OVL_F_HEAD, x, y, it->kind == OVL_IT_ACTION ? "Settings" : it->label, ovl_col(C_TEXT, 1), maxw);
+    y += S(m, 34);
+    const char* tip = "";
+    char tipbuf[400];
+    const opt_def* d = it->kind == OVL_IT_SETTING ? opt_def_of(it->id) : NULL;
+    if (d) tip = d->tip ? d->tip : "";
+    else if (it->kind == OVL_IT_PRESET)
+        tip = "Sets the graphics rows that belong to a preset together (anisotropic filtering, detail distance, and "
+              "more as they are added). PS3 Original is the PS3's own picture; Custom: the rows differ from every preset.";
+    else if (it->kind == OVL_IT_ACTION && it->action == OVL_ACTION_RESET_ALL)
+        tip = "Every setting back to the built-in default (or to what config\\display.ini and config\\input.ini say). "
+              "Settings fixed by an environment variable stay as they are.";
+    else if (it->kind == OVL_IT_ACTION && it->action == OVL_ACTION_OPEN_FOLDER)
+        tip = "Opens the folder that holds options.ini, display.ini and input.ini in Explorer.";
+    snprintf(tipbuf, sizeof tipbuf, "%s", tip);
+    char lines[12][200];
+    const int n = wrap(L, OVL_F_BODY, tipbuf, maxw, lines, 12);
+    const float lh = S(m, 25);
+    for (int i = 0; i < n && y < y1 - S(m, 120); i++) { ovl_text(L, OVL_F_BODY, x, y, lines[i], ovl_col(C_TEXT2, 1)); y += lh; }
+    if (!d) return;
+    y += S(m, 14);
+    ovl_rect(L, x, y - S(m, 10), m->ix1 - S(m, 22), y - S(m, 9), ovl_col(0xFFFFFF, 0.08f), 0);
+    y += S(m, 18);
+    const float kx = x, vx = x + S(m, 128);
+    const float vmax = m->ix1 - S(m, 22) - vx;
+    char v[200];
+    /* default, shown as the control shows values */
+    {
+        const char* dl = d->dflt;
+        char dv[96];
+        snprintf(dv, sizeof dv, "%s", dl);
+        if (it->ui == UI_SELECT || it->ui == UI_TOGGLE) {
+            char (*val)[48] = (char (*)[48])malloc(OVL_MAXCHOICE * 48);
+            char (*lab)[80] = (char (*)[80])malloc(OVL_MAXCHOICE * 80);
+            if (val && lab) {
+                int k = choices(m, it, val, lab, OVL_MAXCHOICE);
+                for (int i = 0; i < k; i++)
+                    if (choice_is(d, val[i], dl)) { snprintf(dv, sizeof dv, "%s", lab[i]); break; }
+            }
+            free(val); free(lab);
+        } else if (it->ui == UI_SLIDER) {
+            slider_t sl;
+            slider_of(d, &sl);
+            char* e;
+            const double x = strtod(dl, &e);
+            if (e != dl && !*e) snprintf(dv, sizeof dv, sl.fmt ? sl.fmt : "%g", x);
+            else { snprintf(dv, sizeof dv, "%s", dl); if (dv[0] >= 'a' && dv[0] <= 'z') dv[0] = (char)(dv[0] - 'a' + 'A'); }
+        }
+        ovl_text(L, OVL_F_SMALL, kx, y, (d->flags & OPT_F_ENHANCEMENT) ? "Default (PS3)" : "Default", ovl_col(C_TEXT3, 1));
+        ovl_text_fit(L, OVL_F_SMALL, vx, y, dv, ovl_col(C_TEXT, 1), vmax);
+        y += S(m, 26);
+    }
+    {
+        ovl_text(L, OVL_F_SMALL, kx, y, "Takes effect", ovl_col(C_TEXT3, 1));
+        const unsigned c = d->apply == OPT_RESTART ? C_AMBER : d->apply == OPT_LIVE ? C_GREEN : C_ACCENT;
+        ovl_circle(L, vx + S(m, 4), y - S(m, 5), S(m, 4), ovl_col(c, 1), 0);
+        ovl_text(L, OVL_F_SMALL, vx + S(m, 14), y, apply_text(d->apply), ovl_col(C_TEXT, 1));
+        y += S(m, 26);
+    }
+    {
+        const char* where = "";
+        int line = 0;
+        const opt_source_kind sk = opt_source(it->id, &where, &line);
+        const char* base = where;
+        for (const char* p = where; p && *p; p++) if (*p == '\\' || *p == '/') base = p + 1;
+        switch (sk) {
+        case OPT_SRC_HOME: snprintf(v, sizeof v, "%s, line %d", base, line); break;
+        case OPT_SRC_FILE: snprintf(v, sizeof v, "%s, line %d", base, line); break;
+        case OPT_SRC_MENU: snprintf(v, sizeof v, "Changed in this menu"); break;
+        case OPT_SRC_ENV:  snprintf(v, sizeof v, "Environment variable %s (locked)", where); break;
+        default:           snprintf(v, sizeof v, "Built-in default"); break;
+        }
+        ovl_text(L, OVL_F_SMALL, kx, y, "Value from", ovl_col(C_TEXT3, 1));
+        ovl_text_fit(L, OVL_F_SMALL, vx, y, v, ovl_col(sk == OPT_SRC_ENV ? C_AMBER : C_TEXT, 1), vmax);
+        y += S(m, 26);
+    }
+    {
+        int ex = 0;
+        const char* p = opt_file_path(&ex);
+        const char* base = p;
+        for (const char* q = p; q && *q; q++) if (*q == '\\' || *q == '/') base = q + 1;
+        if (p && *p) {
+            /* config\options.ini when it is under a config folder */
+            const char* cfg = strstr(p, "config\\");
+            snprintf(v, sizeof v, "%s", cfg ? cfg : base);
+        } else snprintf(v, sizeof v, "Not saved (OPTIONS_CONFIG=none)");
+        ovl_text(L, OVL_F_SMALL, kx, y, "Saved in", ovl_col(C_TEXT3, 1));
+        ovl_text_fit(L, OVL_F_SMALL, vx, y, v, ovl_col(C_TEXT, 1), vmax);
+    }
+}
+
+static void draw_footer(ovl_menu* m, ovl_list* L, float fy)
+{
+    const float x = m->px + S(m, 32);
+    float r = m->px + m->pw - S(m, 32);
+    /* hints, right to left */
+    const int pad = m->input_pad;
+    struct { const char* what; int glyph; const char* key; } h[] = {
+        { "Close", -2, "F1" }, { "Default", 2, "R" }, { "Back", 1, "Esc" }, { "Select", 0, "Enter" },
+        { "Quit game", 3, "Ctrl+Q" } };
+    for (int i = 0; i < 5; i++) {
+        float w = ovl_text_w(L, OVL_F_SMALL, h[i].what);
+        r -= w;
+        ovl_text(L, OVL_F_SMALL, r, base_c(L, OVL_F_SMALL, fy), h[i].what, ovl_col(C_TEXT2, 1));
+        r -= S(m, 8);
+        if (pad) {
+            if (h[i].glyph >= 0) { r -= S(m, 22); pad_button(m, L, r, fy, h[i].glyph); }
+            else { const char* t = m->env.pad_kind == PADHOST_KIND_XINPUT ? "MENU" : "START";
+                   float kw = ovl_text_w(L, OVL_F_TINY, t) + S(m, 14); r -= kw; shoulder(m, L, r, fy, t); }
+        } else {
+            float kw = ovl_text_w(L, OVL_F_SMALL, h[i].key) + S(m, 14);
+            r -= kw;
+            key_cap(m, L, r, fy, h[i].key);
+        }
+        r -= S(m, 24);
+    }
+    /* left: message, pending restarts, pause state */
+    const float maxw = r - x - S(m, 12);
+    if (m->msg[0] && m->now < m->msg_until) {
+        ovl_text_fit(L, OVL_F_SMALL, x, base_c(L, OVL_F_SMALL, fy), m->msg, ovl_col(m->msg_col, 1), maxw);
+        return;
+    }
+    const int pend = opt_restart_pending();
+    char t[120];
+    if (pend) {
+        snprintf(t, sizeof t, pend == 1 ? "1 change applies after a restart" : "%d changes apply after a restart", pend);
+        ovl_text_fit(L, OVL_F_SMALL, x, base_c(L, OVL_F_SMALL, fy), t, ovl_col(C_AMBER, 1), maxw);
+        return;
+    }
+    if (m->env.paused) {
+        ovl_circle(L, x + S(m, 4), fy, S(m, 4), ovl_col(C_GREEN, 1), 0);
+        ovl_text_fit(L, OVL_F_SMALL, x + S(m, 16), base_c(L, OVL_F_SMALL, fy), "Game paused", ovl_col(C_TEXT2, 1), maxw);
+    } else {
+        ovl_circle(L, x + S(m, 4), fy, S(m, 4), ovl_col(C_AMBER, 1), 0);
+        ovl_text_fit(L, OVL_F_SMALL, x + S(m, 16), base_c(L, OVL_F_SMALL, fy), "The game keeps running (pause off)",
+                     ovl_col(C_TEXT2, 1), maxw);
+    }
+}
+
+static void draw_dropdown(ovl_menu* m, ovl_list* L)
+{
+    if (!m->dd_open || m->dd_item < 0 || m->dd_item >= m->nitems) return;
+    const ovl_item* it = &m->items[m->dd_item];
+    const float ih = S(m, 36), pad = S(m, 6);
+    float w = it->cx1 - it->cx0;
+    for (int i = 0; i < m->dd_n; i++) {
+        float tw = ovl_text_w(L, OVL_F_BODY, m->dd_lab[i]) + S(m, 48);
+        if (tw > w) w = tw;
+    }
+    if (w > m->pw - S(m, 40)) w = m->pw - S(m, 40);
+    float x0 = it->cx1 - w;
+    if (x0 < m->px + S(m, 20)) x0 = m->px + S(m, 20);
+    int vis = m->dd_n;
+    const float below = (m->py + m->ph - S(m, 12)) - it->y1, above = it->y0 - (m->py + S(m, 12));
+    int fit_b = (int)((below - 2 * pad) / ih), fit_a = (int)((above - 2 * pad) / ih);
+    int up = 0;
+    if (vis > fit_b && fit_a > fit_b) up = 1;
+    int fit = up ? fit_a : fit_b;
+    if (fit < 3) fit = 3;
+    if (vis > fit) vis = fit;
+    m->dd_vis = vis;
+    if (m->dd_sel < m->dd_first) m->dd_first = m->dd_sel;
+    if (m->dd_sel >= m->dd_first + vis) m->dd_first = m->dd_sel - vis + 1;
+    if (m->dd_first > m->dd_n - vis) m->dd_first = m->dd_n - vis;
+    if (m->dd_first < 0) m->dd_first = 0;
+    const float h = vis * ih + 2 * pad;
+    const float y0 = up ? it->y0 - h - S(m, 2) : it->y1 - S(m, 2);
+    m->dd_x0 = x0; m->dd_x1 = x0 + w; m->dd_y0 = y0; m->dd_y1 = y0 + h; m->dd_ih = ih;
+    ovl_shadow(L, x0, y0 + S(m, 6), x0 + w, y0 + h + S(m, 6), ovl_col(0, 0.55f), S(m, 10), S(m, 14));
+    ovl_rect(L, x0, y0, x0 + w, y0 + h, ovl_col(0x1D2129, 0.99f), S(m, 10));
+    ovl_frame(L, x0, y0, x0 + w, y0 + h, ovl_col(C_ACCENT, 0.45f), S(m, 10), S(m, 1));
+    int cur = current_choice(m, (ovl_item*)it, m->dd_val, m->dd_n);
+    for (int k = 0; k < vis; k++) {
+        const int i = m->dd_first + k;
+        const float ry = y0 + pad + k * ih;
+        if (i == m->dd_sel) ovl_rect(L, x0 + pad, ry, x0 + w - pad, ry + ih, ovl_col(C_ACCENT, 0.22f), S(m, 6));
+        if (i == cur) ovl_circle(L, x0 + S(m, 20), ry + ih / 2, S(m, 4), ovl_col(C_ACCENT, 1), 0);
+        ovl_text_fit(L, OVL_F_BODY, x0 + S(m, 34), base_c(L, OVL_F_BODY, ry + ih / 2), m->dd_lab[i],
+                     ovl_col(i == m->dd_sel ? C_TEXT : 0xD3D9E2, 1), w - S(m, 48));
+    }
+    if (m->dd_first > 0) ovl_tri(L, x0 + w - S(m, 16), y0 + S(m, 12), S(m, 5), 0, ovl_col(C_TEXT3, 1), 0);
+    if (m->dd_first + vis < m->dd_n) ovl_tri(L, x0 + w - S(m, 16), y0 + h - S(m, 12), S(m, 5), 2, ovl_col(C_TEXT3, 1), 0);
+}
+
+void ovl_menu_draw(ovl_menu* m, ovl_list* L, float s)
+{
+    m->s = s;
+    m->W = L->W; m->H = L->H;
+    m->dirty = 0;
+    if (!m->ntab || m->rows_seen != opt_count()) { build_tabs(m); build_items(m); }
+    const float W = (float)L->W, H = (float)L->H;
+    /* dim the game */
+    ovl_rect(L, -2, -2, W + 2, H + 2, ovl_col(0x05070B, 0.55f), 0);
+    /* the panel */
+    float pw = S(m, 1240), ph = S(m, 840);
+    const float mg = S(m, 16);
+    if (pw > W - 2 * mg) pw = W - 2 * mg;
+    if (ph > H - 2 * mg) ph = H - 2 * mg;
+    const float px = floorf((W - pw) / 2), py = floorf((H - ph) / 2);
+    m->px = px; m->py = py; m->pw = pw; m->ph = ph;
+    ovl_shadow(L, px, py + S(m, 10), px + pw, py + ph + S(m, 10), ovl_col(0, 0.6f), S(m, 16), S(m, 24));
+    ovl_rect_v(L, px, py, px + pw, py + ph, ovl_col(0x161922, 0.95f), ovl_col(0x0E1015, 0.95f), S(m, 14));
+    ovl_frame(L, px, py, px + pw, py + ph, ovl_col(0xFFFFFF, 0.07f), S(m, 14), S(m, 1));
+
+    /* header */
+    const float hx = px + S(m, 32), hy = py + S(m, 50);
+    ovl_text(L, OVL_F_TITLE, hx, hy, "OPTIONS", ovl_col(C_TEXT, 1));
+    const float tw = ovl_text_w(L, OVL_F_TITLE, "OPTIONS");
+    ovl_text_fit(L, OVL_F_SMALL, hx + tw + S(m, 16), hy - S(m, 2), m->env.title[0] ? m->env.title : "ps3recomp",
+                 ovl_col(C_TEXT3, 1), pw - tw - S(m, 140));
+    m->close_r = S(m, 16);
+    m->close_cx = px + pw - S(m, 36);
+    m->close_cy = hy - S(m, 10);
+    {
+        const int hov = m->mouse_in && (m->mx - m->close_cx) * (m->mx - m->close_cx) +
+                        (m->my - m->close_cy) * (m->my - m->close_cy) <= m->close_r * m->close_r;
+        ovl_circle(L, m->close_cx, m->close_cy, m->close_r, ovl_col(0xFFFFFF, hov ? 0.14f : 0.06f), 0);
+        const char* x = "\xC3\x97";
+        ovl_text(L, OVL_F_HEAD, m->close_cx - ovl_text_w(L, OVL_F_HEAD, x) / 2, base_c(L, OVL_F_HEAD, m->close_cy), x,
+                 ovl_col(C_TEXT2, 1));
+    }
+
+    /* tabs */
+    const float ty = py + S(m, 100);
+    m->tab_y0 = ty - S(m, 24); m->tab_y1 = ty + S(m, 18);
+    {
+        float x = hx - S(m, 4);
+        const char* lp = m->input_pad ? "L1" : "Q";
+        x += (m->input_pad ? shoulder(m, L, x, ty - S(m, 7), lp) : key_cap(m, L, x, ty - S(m, 7), lp)) + S(m, 18);
+        float gap = S(m, 30);
+        float total = 0;
+        for (int t = 0; t < m->ntab; t++) total += ovl_text_w(L, OVL_F_BODYB, m->tabs[t]);
+        const float room = (px + pw - S(m, 90)) - x;
+        if (total + gap * (m->ntab - 1) > room && m->ntab > 1) gap = (room - total) / (m->ntab - 1);
+        if (gap < S(m, 10)) gap = S(m, 10);
+        for (int t = 0; t < m->ntab; t++) {
+            const float w = ovl_text_w(L, OVL_F_BODYB, m->tabs[t]);
+            const int hov = m->mouse_in && m->my >= m->tab_y0 && m->my < m->tab_y1 && m->mx >= x - gap / 2 && m->mx < x + w + gap / 2;
+            ovl_text(L, OVL_F_BODYB, x, ty, m->tabs[t], t == m->tab ? ovl_col(C_TEXT, 1) : ovl_col(hov ? 0xD3D9E2 : C_TEXT2, 1));
+            if (t == m->tab) ovl_rect(L, x, ty + S(m, 10), x + w, ty + S(m, 13), ovl_col(C_ACCENT, 1), S(m, 1.5f));
+            m->tab_x0[t] = x - gap / 2; m->tab_x1[t] = x + w + gap / 2;
+            x += w + gap;
+        }
+        const char* rp = m->input_pad ? "R1" : "E";
+        x += S(m, 4) - gap + S(m, 14);
+        if (m->input_pad) shoulder(m, L, x, ty - S(m, 7), rp); else key_cap(m, L, x, ty - S(m, 7), rp);
+    }
+    ovl_rect(L, px + S(m, 20), ty + S(m, 15), px + pw - S(m, 20), ty + S(m, 16), ovl_col(0xFFFFFF, 0.08f), 0);
+
+    /* list and info pane */
+    const float top = ty + S(m, 30), bottom = py + ph - S(m, 62);
+    const int info = pw >= S(m, 900);
+    m->lx0 = px + S(m, 28);
+    m->lx1 = info ? px + floorf(pw * 0.60f) : px + pw - S(m, 28);
+    m->ix0 = info ? m->lx1 + S(m, 24) : 0;
+    m->ix1 = info ? px + pw - S(m, 28) : 0;
+    m->ly0 = top; m->ly1 = bottom;
+    /* layout pass: positions in content space, then scrolled */
+    float y = 0;
+    const float rh = S(m, 46);
+    for (int i = 0; i < m->nitems; i++) {
+        ovl_item* it = &m->items[i];
+        float h = rh;
+        if (it->kind == OVL_IT_GROUP) h = (i ? S(m, 12) : S(m, 2)) + S(m, 28);
+        else if (it->kind == OVL_IT_INFO) h = S(m, 30);
+        it->x0 = m->lx0; it->x1 = m->lx1;
+        it->y0 = y; it->y1 = y + h;
+        it->cx0 = m->lx0 + floorf((m->lx1 - m->lx0) * 0.50f);
+        it->cx1 = m->lx1 - S(m, 14);
+        y += h;
+    }
+    m->content_h = y;
+    float* sc = &m->scroll[m->tab];
+    const float maxs = y - (bottom - top);
+    if (*sc > maxs) *sc = maxs;
+    if (*sc < 0) *sc = 0;
+    for (int i = 0; i < m->nitems; i++) { m->items[i].y0 += top - *sc; m->items[i].y1 += top - *sc; }
+
+    ovl_scissor(L, (int)px, (int)top, (int)(px + pw), (int)bottom);
+    const int f = m->focus[m->tab];
+    for (int i = 0; i < m->nitems; i++) {
+        ovl_item* it = &m->items[i];
+        if (it->y1 < top || it->y0 > bottom) continue;
+        if (it->kind == OVL_IT_GROUP) {
+            char caps[96];
+            size_t k = 0;
+            for (const char* p = it->label; *p && k + 1 < sizeof caps; p++)
+                caps[k++] = (*p >= 'a' && *p <= 'z') ? (char)(*p - 'a' + 'A') : *p;
+            caps[k] = 0;
+            ovl_text(L, OVL_F_TINY, it->x0 + S(m, 14), it->y1 - S(m, 9), caps, ovl_col(C_GROUP, 0.9f));
+            continue;
+        }
+        draw_row(m, L, i, i == f);
+    }
+    /* scroll hints */
+    if (*sc > 0) ovl_tri(L, m->lx1 - S(m, 8), top + S(m, 6), S(m, 5), 0, ovl_col(C_TEXT3, 1), 0);
+    if (*sc < maxs - 1) ovl_tri(L, m->lx1 - S(m, 8), bottom - S(m, 6), S(m, 5), 2, ovl_col(C_TEXT3, 1), 0);
+    ovl_scissor(L, 0, 0, L->W, L->H);
+    if (info) draw_info(m, L, top, bottom - S(m, 6));
+
+    /* footer */
+    const float fy = py + ph - S(m, 30);
+    ovl_rect(L, px + S(m, 20), fy - S(m, 24), px + pw - S(m, 20), fy - S(m, 23), ovl_col(0xFFFFFF, 0.08f), 0);
+    draw_footer(m, L, fy);
+
+    draw_dropdown(m, L);
+
+    /* tooltip: a badge, a locked row, or any row while the info pane is hidden */
+    if (m->mouse_in && !m->dd_open && m->hover_item >= 0 && m->hover_item < m->nitems &&
+        m->now - m->hover_since >= 0.5) {
+        const ovl_item* it = &m->items[m->hover_item];
+        const opt_def* d = it->kind == OVL_IT_SETTING ? opt_def_of(it->id) : NULL;
+        char t[400];
+        t[0] = 0;
+        const char* env = NULL;
+        if (d && opt_locked(it->id, &env))
+            snprintf(t, sizeof t, "Set by the environment variable %s. Unset it to change this setting here.", env ? env : "?");
+        else if (d && m->hover_badge && d->apply == OPT_RESTART)
+            snprintf(t, sizeof t, "Applies the next time the game starts.");
+        else if (d && !info && d->tip)
+            snprintf(t, sizeof t, "%s", d->tip);
+        if (t[0]) tooltip(m, L, (float)m->mx, (float)m->my, t);
+    }
+}
+
+/* ---------------------------------------------------------------- OSD and notices */
+
+void ovl_draw_osd(ovl_list* L, float s, int corner, const float rect[4], const char* line1, const char* line2)
+{
+    ovl_menu tmp;
+    tmp.s = s;
+    const ovl_menu* m = &tmp;
+    const float pad = S(m, 10), lh = S(m, 22);
+    float w = ovl_text_w(L, OVL_F_OSD, line1);
+    if (line2 && *line2) { float w2 = ovl_text_w(L, OVL_F_SMALL, line2); if (w2 > w) w = w2; }
+    const float bw = w + 2 * pad, bh = (line2 && *line2 ? 2 : 1) * lh + 2 * pad - S(m, 6);
+    const float mg = S(m, 12);
+    const float rx0 = rect ? rect[0] : 0, ry0 = rect ? rect[1] : 0;
+    const float rx1 = rect ? rect[2] : (float)L->W, ry1 = rect ? rect[3] : (float)L->H;
+    float x0 = (corner & 1) ? rx1 - mg - bw : rx0 + mg;
+    float y0 = (corner & 2) ? ry1 - mg - bh : ry0 + mg;
+    ovl_rect(L, x0, y0, x0 + bw, y0 + bh, ovl_col(0x0B0D11, 0.72f), S(m, 6));
+    ovl_text(L, OVL_F_OSD, x0 + pad, y0 + pad + S(m, 13), line1, ovl_col(0x9EF0B4, 1));
+    if (line2 && *line2) ovl_text(L, OVL_F_SMALL, x0 + pad, y0 + pad + S(m, 13) + lh, line2, ovl_col(C_TEXT2, 1));
+}
+
+void ovl_draw_notice(ovl_list* L, float s, const char* text, float alpha)
+{
+    ovl_menu tmp;
+    tmp.s = s;
+    const ovl_menu* m = &tmp;
+    const float w = ovl_text_w(L, OVL_F_BODY, text) + S(m, 36), h = S(m, 40);
+    const float x0 = floorf((L->W - w) / 2), y0 = S(m, 28);
+    ovl_shadow(L, x0, y0 + S(m, 4), x0 + w, y0 + h + S(m, 4), ovl_col(0, 0.45f * alpha), S(m, 10), S(m, 12));
+    ovl_rect(L, x0, y0, x0 + w, y0 + h, ovl_col(0x1A1D24, 0.94f * alpha), S(m, 10));
+    ovl_frame(L, x0, y0, x0 + w, y0 + h, ovl_col(C_ACCENT, 0.5f * alpha), S(m, 10), S(m, 1));
+    ovl_text(L, OVL_F_BODY, x0 + S(m, 18), base_c(L, OVL_F_BODY, y0 + h / 2), text, ovl_col(C_TEXT, alpha));
+}
diff --git a/libs/video/ovl_menu.h b/libs/video/ovl_menu.h
new file mode 100644
index 0000000..2d43403
--- /dev/null
+++ b/libs/video/ovl_menu.h
@@ -0,0 +1,165 @@
+/*
+ * ps3recomp - the options overlay's menu: model, layout, drawing and
+ * navigation (libs/video/ovl_menu.c). OS-free apart from the GDI font types;
+ * it reads and writes settings only through include/ps3emu/options.h, and
+ * knows the world only through ovl_menu_env, so a test can drive it with no
+ * window and no GPU (libs/video/tests/test_ovl_menu.c).
+ *
+ * Tabs and rows come from the store's table (opt_def tab / group / label /
+ * tip / type / values): a row registered by any module shows up in its tab
+ * with no change here; rows nobody registered (render scale, AA, texture
+ * packs before their engines land) simply are not there. The fixed tabs are
+ * Display, Graphics, Frame, Controls, Audio, System; another tab name gets a
+ * tab of its own after them.
+ *
+ * All coordinates are canvas pixels (the overlay's surface: the window's
+ * client area, or the picture for the backbuffer host); s is the UI scale.
+ * The host owns time (seconds), input routing and the draw list's GPU side.
+ */
+#ifndef PS3RECOMP_OVL_MENU_H
+#define PS3RECOMP_OVL_MENU_H
+
+#include "ovl_draw.h"
+#include "ps3emu/options.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Faces of the atlas, in this order (ovl_menu_faces gives their sizes). */
+enum { OVL_F_BODY, OVL_F_SMALL, OVL_F_HEAD, OVL_F_TITLE, OVL_F_BODYB, OVL_F_TINY, OVL_F_OSD, OVL_NFACE };
+void ovl_menu_faces(float s, int faces[OVL_NFACE][2]);
+
+/* UI scale for a canvas: max(h/1080, 0.8, 0.8*dpi/96) * user (1 = auto),
+ * rounded to 0.05 (one atlas per step). */
+float ovl_menu_scale(int canvas_w, int canvas_h, unsigned dpi, float user);
+
+typedef struct {
+    double refresh_hz;             /* the window's monitor (0 = unknown) */
+    int    work_w, work_h;         /* that monitor's work area, for the window size choices */
+    int    nmon;
+    struct { int w, h, primary; } mon[8];
+    int    pad_kind;               /* the pad that navigated last (pad_host.h PADHOST_KIND_*), 0 none */
+    int    paused;                 /* the game was told the system has the pad (flag on) */
+    char   title[96];              /* "inFamous 2 (ps3recomp)" */
+    char   host[96];               /* "DirectComposition ..." / "the game's backbuffer (fallback)" */
+    char   adapter[96];            /* the GPU */
+    char   build[48];
+} ovl_menu_env;
+
+typedef enum {
+    OVL_NAV_UP, OVL_NAV_DOWN, OVL_NAV_LEFT, OVL_NAV_RIGHT, OVL_NAV_LEFT_BIG, OVL_NAV_RIGHT_BIG,
+    OVL_NAV_ACCEPT, OVL_NAV_BACK, OVL_NAV_TAB_PREV, OVL_NAV_TAB_NEXT, OVL_NAV_RESET,
+    OVL_NAV_HOME, OVL_NAV_END, OVL_NAV_PAGE_UP, OVL_NAV_PAGE_DOWN, OVL_NAV_CLOSE,
+    OVL_NAV_QUIT                   /* Triangle / Y, Ctrl+Q: quit the game (pressed twice) */
+} ovl_nav;
+
+/* What the host has to do after an input. */
+enum { OVL_ACT_NONE = 0, OVL_ACT_CLOSE, OVL_ACT_OPEN_FOLDER, OVL_ACT_QUIT };
+
+enum { OVL_IT_GROUP, OVL_IT_SETTING, OVL_IT_PRESET, OVL_IT_ACTION, OVL_IT_INFO };
+enum { OVL_ACTION_RESET_ALL = 1, OVL_ACTION_OPEN_FOLDER, OVL_ACTION_QUIT };
+
+#define OVL_MAXTAB   10
+#define OVL_MAXITEM  96
+#define OVL_MAXCHOICE 48
+
+typedef struct {
+    int    kind;
+    opt_id id;                     /* OVL_IT_SETTING */
+    int    action;                 /* OVL_IT_ACTION */
+    char   label[96];
+    char   info[200];              /* OVL_IT_INFO: its value */
+    /* layout of the last frame (canvas pixels, scrolled) */
+    float  x0, y0, x1, y1;
+    float  cx0, cx1;               /* the control */
+    float  bx0, bx1;               /* the badges after the label */
+    int    ui;                     /* widget: OVL_UI_* (ovl_menu.c) */
+} ovl_item;
+
+typedef struct ovl_menu {
+    ovl_menu_env env;
+    double now;                    /* seconds, set by the host */
+    float  s;                      /* UI scale of the font in use */
+    int    W, H;
+    /* tabs */
+    int    ntab, tab;
+    char   tabs[OVL_MAXTAB][24];
+    int    focus[OVL_MAXTAB];
+    float  scroll[OVL_MAXTAB];
+    /* the current tab's items */
+    ovl_item items[OVL_MAXITEM];
+    int    nitems;
+    int    rows_seen;              /* opt_count() when the items were built */
+    /* layout */
+    float  px, py, pw, ph;
+    float  lx0, lx1, ly0, ly1;     /* the list viewport */
+    float  ix0, ix1;               /* the info pane (ix1 <= ix0: hidden) */
+    float  tab_x0[OVL_MAXTAB], tab_x1[OVL_MAXTAB], tab_y0, tab_y1;
+    float  close_cx, close_cy, close_r;
+    float  content_h;
+    /* the choice list (dropdown) */
+    int    dd_open, dd_item, dd_sel, dd_first, dd_n, dd_vis;
+    char   dd_val[OVL_MAXCHOICE][48], dd_lab[OVL_MAXCHOICE][80];
+    float  dd_x0, dd_y0, dd_x1, dd_y1, dd_ih;
+    /* mouse */
+    int    mx, my, mouse_in, drag_item, hover_item, hover_badge;
+    double hover_since;
+    int    input_pad;              /* the last navigation came from a controller (button hints) */
+    /* footer message */
+    char   msg[200];
+    unsigned msg_col;
+    double msg_until;
+    double confirm_until;          /* "reset all" / "quit": the second press before this */
+    int    confirm_what;           /* which: OVL_ACTION_RESET_ALL or OVL_ACTION_QUIT */
+    int    dirty;                  /* something changed: draw again */
+} ovl_menu;
+
+void ovl_menu_init(ovl_menu* m);
+/* The menu was opened: keep the tab, re-check the rows. */
+void ovl_menu_opened(ovl_menu* m);
+/* Lay out and draw the open menu into L (canvas L->W x L->H, font L->font
+ * at scale s). */
+void ovl_menu_draw(ovl_menu* m, ovl_list* L, float s);
+
+int  ovl_menu_nav(ovl_menu* m, ovl_nav nav, int from_pad);       /* OVL_ACT_* */
+int  ovl_menu_mouse_move(ovl_menu* m, int x, int y);
+int  ovl_menu_mouse_button(ovl_menu* m, int button, int down, int x, int y);  /* 0 left, 1 right */
+int  ovl_menu_mouse_wheel(ovl_menu* m, int delta, int x, int y);              /* +120 = away */
+void ovl_menu_mouse_leave(ovl_menu* m);
+/* A tooltip or a message expires at this time (0: nothing pending). */
+double ovl_menu_next_wake(const ovl_menu* m);
+
+/* Small boxes the host draws without the menu: the FPS counter and notices. */
+void ovl_draw_osd(ovl_list* L, float s, int corner, const float rect[4], const char* line1, const char* line2);
+void ovl_draw_notice(ovl_list* L, float s, const char* text, float alpha);
+
+/* Tests: the label of the value a row shows, and the current tab's name. */
+void ovl_menu_value_text(ovl_menu* m, opt_id id, char* out, size_t n);
+const char* ovl_menu_tab_name(const ovl_menu* m);
+
+/* Another front end of this model: a title's own menu, drawn by the game (the inFamous 2 port's
+ * src/if2_menu.cpp puts these rows in the game's own Options screen). It walks the same tabs and rows
+ * (m->tabs / m->ntab, and m->items after ovl_menu_select_tab), offers the same choices and slider stops
+ * with the same labels, and changes values through the same setters (an env-locked row is refused, a
+ * RESTART row noted; m->msg says so), so both front ends read and write the store alike and a change
+ * made in one shows in the other.
+ *   ovl_menu_row_positions: the positions row id takes, in order -- a selector's or a toggle's choices,
+ *     a slider's stops (its word stop, then lo..hi by the step, thinned to fit max; the current value is
+ *     always one of them), the presets for OVL_ROW_PRESET -- with their labels (UTF-8); *cur = the
+ *     current one (-1: none, a preset row on "custom"). 0 = no such row.
+ *   ovl_menu_row_choose: set position pos of that list (the same max): OPT_SET_CHANGED, OPT_SET_SAME,
+ *     or OPT_SET_REFUSED (env-locked, or no such position). */
+#define OVL_ROW_PRESET (-2)
+void ovl_menu_select_tab(ovl_menu* m, int tab);
+int  ovl_menu_row_positions(ovl_menu* m, opt_id id, char (*lab)[80], int max, int* cur);
