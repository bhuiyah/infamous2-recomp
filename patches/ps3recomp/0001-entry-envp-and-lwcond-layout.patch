+/* SAVESTATES=0 (or off / no / false): the kill switch. */
+static int env_off(const char* n)
+{
+    const char* e = getenv(n);
+    if (!e || !*e) return 0;
+    char v[8];
+    size_t k = 0;
+    for (; e[k] && k + 1 < sizeof v; k++) v[k] = (char)((e[k] >= 'A' && e[k] <= 'Z') ? e[k] + 32 : e[k]);
+    v[k] = 0;
+    return !strcmp(v, "0") || !strcmp(v, "off") || !strcmp(v, "no") || !strcmp(v, "false");
+}
