diff --git a/tools/eboot_map.py b/tools/eboot_map.py
new file mode 100644
index 0000000..c38c224
--- /dev/null
+++ b/tools/eboot_map.py
@@ -0,0 +1,652 @@
+"""eboot_map.py - map code and data addresses between two builds of the same PPU executable.
+
+A title update (or another region's build) moves almost every function and global: code is
+inserted, the data segment shifts, the TOC moves. Title-specific hooks written against one build
+(function entry points, global variables, call sites) need the matching addresses in the other.
+This tool derives them from the two ELFs alone -- no symbols, no game knowledge:
+
+  1. functions are matched by an instruction signature that ignores everything a relink changes
+     (branch displacements, the 16-bit halves of address materialisation and load/store offsets),
+     first where a signature is unique in both builds, then in address order between those anchors
+     (both builds come from the same source and link order), then by size + similarity;
+  2. data addresses are mapped by voting: wherever a matched function materialises an address
+     (lis + addi/ori/load/store, or a TOC-relative load), the same instruction in its match gives
+     the new address;
+  3. an address that is never materialised directly (a field of a global object) is mapped
+     through the nearest mapped address below it in the same segment, and reported as such.
+
+Usage:
+  eboot_map.py build OLD.elf OLD_functions.json NEW.elf NEW_functions.json -o map.json
+  eboot_map.py query map.json 0x96EF88 func_00085014 0x3374F0 ...
+  eboot_map.py rewrite map.json FILE...      (print each address-looking token with its mapping)
+  eboot_map.py translate map.json IN OUT     (carry an address list, e.g. a --cont-list, over)
+
+functions.json: the find_functions.py output ([{"start": "0x..", "end": "0x.."}, ...]).
+map.manual.json (beside map.json, optional): {"0xOLD": {"new": "0xNEW" | null, "why": "..."}} -- hand
+mappings for what the votes cannot reach (code the update changed, pool slots of relinked pools); they
+override the map, and those whose "why" starts with "function" also seed the data votes at build time.
+Standard library only.
+"""
+import bisect
+import difflib
+import hashlib
+import json
+import os
+import re
+import struct
+import sys
+from collections import Counter, defaultdict
+
+
+# ----------------------------------------------------------------------------- ELF
+class Elf:
+    def __init__(self, path):
+        d = open(path, "rb").read()
+        if d[:4] != b"\x7fELF" or d[4] != 2 or d[5] != 2:
+            raise SystemExit("%s: not a 64-bit big-endian ELF" % path)
+        phoff = struct.unpack(">Q", d[0x20:0x28])[0]
+        phentsz, phnum = struct.unpack(">HH", d[0x36:0x3A])
+        self.segs = []
+        for i in range(phnum):
+            t, fl, off, va, pa, fs, ms, al = struct.unpack(">IIQQQQQQ", d[phoff + i * phentsz:phoff + i * phentsz + 56])
+            if t == 1 and ms:
+                self.segs.append((va, va + ms, off, fs, fl))
+        self.d = d
+        self.entry = struct.unpack(">Q", d[0x18:0x20])[0]
+
+    def seg_of(self, a):
+        for s in self.segs:
+            if s[0] <= a < s[1]:
+                return s
+        return None
+
+    def words(self, start, end):
+        s = self.seg_of(start)
+        if not s or end > s[0] + s[3]:
+            return []
+        o = s[2] + (start - s[0])
+        n = (end - start) // 4
+        return list(struct.unpack(">%dI" % n, self.d[o:o + n * 4]))
+
+    def u32(self, a):
+        s = self.seg_of(a)
+        if not s or a + 4 > s[0] + s[3]:
+            return None
+        o = s[2] + (a - s[0])
+        return struct.unpack(">I", self.d[o:o + 4])[0]
+
+
+# ----------------------------------------------------------------------- normalise
+ADDR_IMM_OPS = {14, 15, 24, 25} | set(range(32, 56)) | {58, 62}   # addi addis ori oris, loads/stores, ld/std
+
+
+def norm(w):
+    op = w >> 26
+    if op == 18:
+        return w & 0xFC000003            # b/bl: keep AA/LK, drop the displacement
+    if op == 16:
+        return w & 0xFFFF0003            # bc: keep BO/BI/AA/LK, drop BD
+    if op in ADDR_IMM_OPS:
+        return w & 0xFFFF0000            # the immediate may be (half of) an address or a TOC offset
+    return w
+
+
+def sig(words):
+    h = hashlib.blake2b(digest_size=12)
+    for w in words:
+        h.update(struct.pack(">I", norm(w)))
+    return h.hexdigest()
+
+
+def load_funcs(path):
+    f = json.load(open(path))
+    items = f if isinstance(f, list) else f.get("functions", [])
+    out = []
+    for it in items:
+        s, e = int(it["start"], 16), int(it["end"], 16)
+        if e > s:
+            out.append((s, e))
+    out.sort()
+    return out
+
+
+# ---------------------------------------------------------------- function matching
+def match_functions(eo, fo, en, fn):
+    wo = {s: eo.words(s, e) for s, e in fo}
+    wn = {s: en.words(s, e) for s, e in fn}
+    so = {s: sig(w) for s, w in wo.items()}
+    sn = {s: sig(w) for s, w in wn.items()}
+    co, cn = Counter(so.values()), Counter(sn.values())
+    by_new = defaultdict(list)
+    for s, h in sn.items():
+        by_new[h].append(s)
+    # 1. unique-in-both anchors, then keep only an increasing chain (longest increasing subsequence)
+    pairs = sorted((s, by_new[h][0]) for s, h in so.items() if co[h] == 1 and cn.get(h) == 1 and len(wo[s]) >= 4)
+    tails, prev, idx = [], [-1] * len(pairs), []
+    import bisect
+    for i, (_, b) in enumerate(pairs):
+        k = bisect.bisect_left(tails, b)
+        if k == len(tails):
+            tails.append(b); idx.append(i)
+        else:
+            tails[k] = b; idx[k] = i
+        prev[i] = idx[k - 1] if k else -1
+    chain = []
+    i = idx[-1] if idx else -1
+    while i >= 0:
+        chain.append(pairs[i]); i = prev[i]
+    chain.reverse()
+    m = dict(chain)
+    how = {a: "unique" for a in m}
+    # 2. between consecutive anchors: equal signatures in order, then similar sizes/similar code in order
+    olist = [s for s, _ in fo]
+    nlist = [s for s, _ in fn]
+    oi = {s: i for i, s in enumerate(olist)}
+    ni = {s: i for i, s in enumerate(nlist)}
+    bounds = [(-1, -1)] + [(oi[a], ni[b]) for a, b in chain] + [(len(olist), len(nlist))]
+    for (a0, b0), (a1, b1) in zip(bounds, bounds[1:]):
+        gold = olist[a0 + 1:a1]
+        gnew = nlist[b0 + 1:b1]
+        if not gold or not gnew:
+            continue
+        sm = difflib.SequenceMatcher(None, [so[s] for s in gold], [sn[s] for s in gnew], autojunk=False)
+        for tag, i0, i1, j0, j1 in sm.get_opcodes():
+            if tag == "equal":
+                for k in range(i1 - i0):
+                    m[gold[i0 + k]] = gnew[j0 + k]; how[gold[i0 + k]] = "ordered"
+            elif tag == "replace":
+                for k in range(min(i1 - i0, j1 - j0)):
+                    a, b = gold[i0 + k], gnew[j0 + k]
+                    x, y = [norm(w) for w in wo[a]], [norm(w) for w in wn[b]]
+                    if not x or not y:
+                        continue
+                    r = difflib.SequenceMatcher(None, x, y, autojunk=False).ratio() if max(len(x), len(y)) < 4000 else 0.0
+                    if r >= 0.80:
+                        m[a] = b; how[a] = "similar %.2f" % r
+    # 3. call sites: a matched pair with the same normalised code calls the same callees at the same
+    #    instruction, so a callee that changed (and failed every test above) is still found through its callers.
+    for _round in range(3):
+        votes = defaultdict(Counter)
+        for a, b in list(m.items()):
+            x, y = wo[a], wn[b]
+            if len(x) != len(y) or [norm(w) for w in x] != [norm(w) for w in y]:
+                continue
+            for i, (w0, w1) in enumerate(zip(x, y)):
+                if (w0 >> 26) == 18 and (w0 & 3) == 1:            # bl (relative, link)
+                    def tgt(w, pc):
+                        li = w & 0x03FFFFFC
+                        if li & 0x02000000:
+                            li -= 0x04000000
+                        return (pc + li) & 0xFFFFFFFF
+                    c0, c1 = tgt(w0, a + 4 * i), tgt(w1, b + 4 * i)
+                    if c0 in wo and c1 in wn and c0 not in m:
+                        votes[c0][c1] += 1
+        taken = set(m.values())
+        added = 0
+        for c0, c in votes.items():
+            c1, n = c.most_common(1)[0]
+            if c1 not in taken and n >= 1 and n * 2 > sum(c.values()) - 0:
+                m[c0] = c1; how[c0] = "callsite %d/%d" % (n, sum(c.values())); taken.add(c1); added += 1
+        if not added:
+            break
+    return m, how, wo, wn
+
+
+# -------------------------------------------------------------------- data mapping
+STORES = (36, 37, 38, 39, 44, 45, 47, 52, 53, 54, 55, 62)
+# primary opcodes that write no GPR (VMX, compares, branches, sc, FP loads/arith); the update forms write rA
+_NO_GPR = (4, 10, 11, 16, 17, 18, 19, 48, 50, 59, 63)
+_UPDATE = (37, 39, 45, 49, 51, 53, 55)
+# opcode 31 extended opcodes: no GPR written (stores, compares, cache ops, VMX and FP loads, mt*) ...
+_X_NONE = {0, 32, 4, 68, 54, 86, 246, 278, 470, 1014, 982, 598, 854, 150, 214, 151, 149, 215, 407, 662, 918, 663, 727,
+           983, 231, 487, 135, 167, 199, 647, 679, 903, 935, 103, 359, 7, 39, 71, 6, 38, 519, 551, 775, 807, 535, 599,
+           467, 144, 146, 178}
+# ... the update forms (rA only) ...
+_X_UPDATE = {183, 181, 247, 439, 695, 759, 567, 631}
+# ... and the logical / shift / extend group, whose destination is rA (rS is the field rT occupies elsewhere)
+_X_RA = {28, 60, 444, 124, 316, 284, 412, 476, 24, 536, 792, 824, 27, 539, 794, 26, 58, 922, 954, 986, 826, 827}
+
+
+def gpr_written(w):
+    """The GPR an instruction writes, or None (stores, VMX/FP/CR ops, branches)."""
+    op, rt, ra = w >> 26, (w >> 21) & 31, (w >> 16) & 31
+    if op in _UPDATE or (op == 62 and w & 3 == 1):
+        return ra
+    if op in STORES or op in _NO_GPR:
+        return None
+    if op in (20, 21, 23, 24, 25, 26, 27, 28, 29, 30):     # rlw*, ori/oris/xori/xoris/andi./andis., rld*
+        return ra
+    if op == 31:
+        xo = (w >> 1) & 0x3FF
+        if xo in _X_NONE:
+            return None
+        if xo in _X_UPDATE:
+            return ra
+        if xo in _X_RA:
+            return ra
+    return rt
+
+
+def addr_refs(words, base):
+    """(instruction index, reference) for every address a function materialises:
+         int                  lis + addi/ori, or lis + load/store displacement (an absolute address)
+         ("toc", off)         a load/store at off(r2): the TOC slot itself
+         ("tocf", off, d)     a field d(rX) or addi rY, rX, d of a pointer rX loaded from off(r2)"""
+    hi, tp, out = {}, {}, []
+    for i, w in enumerate(words):
+        op = w >> 26
+        rt, ra = (w >> 21) & 31, (w >> 16) & 31
+        imm = w & 0xFFFF
+        simm = imm - 0x10000 if imm & 0x8000 else imm
+        mem = 32 <= op <= 55 or op in (58, 62)
+        d = (simm & ~3) if op in (58, 62) else simm
+        if op == 15 and ra == 0:                              # lis rt, imm
+            hi[rt] = (imm << 16) & 0xFFFFFFFF
+            tp.pop(rt, None)
+            continue
+        if op in (14, 24) and ra in hi:                       # addi / ori rt, ra, imm
+            out.append((i, (hi[ra] + (simm if op == 14 else imm)) & 0xFFFFFFFF))
+        elif mem and ra in hi:                                # load/store d(ra)
+            out.append((i, (hi[ra] + d) & 0xFFFFFFFF))
+        elif mem and ra == 2:                                 # TOC slot
+            out.append((i, ("toc", d)))
+        elif ra in tp and (mem or op == 14):                  # field of a TOC-loaded object pointer
+            out.append((i, ("tocf", tp[ra], d if mem else simm)))
+        # register bookkeeping: what rt holds after this instruction
+        if (op == 32 or op == 58) and ra == 2:
+            tp[rt] = d
+            hi.pop(rt, None)
+        else:
+            # (VMX ops name vector registers and lfs/lfd and float ops FPRs in the same fields: no GPR is written)
+            dst = gpr_written(w)
+            if dst is not None:
+                hi.pop(dst, None)
+                tp.pop(dst, None)
+    return out
+
+
+def _resolve(e, toc, r):
+    if isinstance(r, int):
+        return r
+    if toc is None:
+        return None
+    if r[0] == "toc":
+        return (toc + r[1]) & 0xFFFFFFFF                      # the slot address
+    base = e.u32((toc + r[1]) & 0xFFFFFFFF)
+    return None if not base else (base + r[2]) & 0xFFFFFFFF
+
+
+def map_data(eo, en, m, wo, wn, toc_o, toc_n, tocs_o=None, tocs_n=None):
+    """Vote old -> new for every address both sides materialise at corresponding instructions. Identical
+    (normalised) functions correspond index by index; changed ones through the equal blocks of an
+    instruction-level alignment."""
+    votes = defaultdict(Counter)
+    so_ = sorted(tocs_o) if tocs_o else []
+    sn_ = sorted(tocs_n) if tocs_n else []
+    for a, b in m.items():
+        x, y = wo.get(a, []), wn.get(b, [])
+        if not x or not y:
+            continue
+        ta = toc_for(so_, tocs_o, a, toc_o) if tocs_o else toc_o
+        tb = toc_for(sn_, tocs_n, b, toc_n) if tocs_n else toc_n
+        nx, ny = [norm(w) for w in x], [norm(w) for w in y]
+        if nx == ny:
+            pairs = None
+        elif max(len(x), len(y)) <= 6000:
+            sm = difflib.SequenceMatcher(None, nx, ny, autojunk=False)
+            pairs = {}
+            for blk in sm.get_matching_blocks():
+                for k in range(blk.size):
+                    pairs[blk.a + k] = blk.b + k
+        else:
+            continue
+        rn = dict(addr_refs(y, b))
+        for i, ro in addr_refs(x, a):
+            j = i if pairs is None else pairs.get(i)
+            if j is None or j not in rn:
+                continue
+            r1 = rn[j]
+            # (a tocf field offset may differ: the corresponding instruction reads a constant pool the update
+            # relinked, e.g. one word inserted before the field)
+            if type(ro) != type(r1) or (isinstance(ro, tuple) and ro[0] != r1[0]):
+                continue
+            o, n = _resolve(eo, ta, ro), _resolve(en, tb, r1)
+            if o is None or n is None:
+                continue
+            votes[o][n] += 1
+            if isinstance(ro, tuple) and ro[0] == "tocf" and (x[i] >> 26) in (32, 58):
+                vo, vn = eo.u32(o), en.u32(n)                   # a pointer read from a table in .data
+                if vo and vn and eo.seg_of(vo) and en.seg_of(vn) and not (eo.seg_of(vo)[4] & 1):
+                    votes[vo][vn] += 1
+            if isinstance(ro, tuple) and ro[0] == "toc":          # the slot's content: a global's address
+                vo, vn = eo.u32(o), en.u32(n)
+                if vo and vn:
+                    votes[vo][vn] += 1
+    # pointer slots: a data word whose own address is mapped and which points into a data segment maps its
+    # target too (vtables, registries, static pointer tables the code indexes at run time)
+    for _round in range(2):
+        add = defaultdict(Counter)
+        for ao, c in list(votes.items()):
+            an = c.most_common(1)[0][0]
+            so, sn = eo.seg_of(ao), en.seg_of(an)
+            if not so or not sn or so[4] & 1 or sn[4] & 1 or ao & 3 or an & 3:
+                continue
+            vo, vn = eo.u32(ao), en.u32(an)
+            if not vo or not vn:
+                continue
+            to, tn = eo.seg_of(vo), en.seg_of(vn)
+            if to and tn and not (to[4] & 1) and not (tn[4] & 1) and vo not in votes:
+                add[vo][vn] += 1
+        if not add:
+            break
+        for k, c in add.items():
+            votes[k].update(c)
+    data = {}
+    for ao, c in votes.items():
+        an, k = c.most_common(1)[0]
+        data[ao] = (an, k, sum(c.values()))
+    return data
+
+
+def find_tocs(e):
+    """{code entry: toc} from every OPD descriptor (entry in an executable segment, toc in a data segment)."""
+    out = {}
+    for va, end, off, fs, fl in e.segs:
+        if fl & 1:
+            continue
+        n = fs // 4
+        words = struct.unpack(">%dI" % n, e.d[off:off + n * 4])
+        start = (-(va) // 4) % 2                     # descriptors are 8-byte aligned {u32 entry, u32 toc}
+        for k in range(start, n - 1, 2):
+            f, t = words[k], words[k + 1]
+            sf, st = e.seg_of(f), e.seg_of(t)
+            if f & 3 or t & 3 or not sf or not (sf[4] & 1) or not st or st[4] & 1:
+                continue
+            out.setdefault(f, t)
+    # a real TOC is shared by the functions of its module; a value seen once is a coincidence
+    cnt = Counter(out.values())
+    return {f: t for f, t in out.items() if cnt[t] >= 2}
+
+
+def toc_for(tocs_sorted, tocs, func, default):
+    import bisect
+    if func in tocs:
+        return tocs[func]
+    i = bisect.bisect_right(tocs_sorted, func) - 1
+    return tocs[tocs_sorted[i]] if i >= 0 else default
+
+
+def find_toc(e, funcs):
+    """The TOC base: r2 as the OPD entries give it (the second word of an OPD descriptor)."""
+    c = Counter()
+    for va, end, off, fs, fl in e.segs:
+        if fl & 1:
+            continue                                      # executable: not the OPD
+        n = fs // 8
+        for k in range(0, n - 1, 2):
+            a = va + k * 8
+            f, t = e.u32(a), e.u32(a + 4)
+            if f and t and e.seg_of(f) and e.seg_of(f)[4] & 1 and e.seg_of(t):
+                c[t] += 1
+    return c.most_common(1)[0][0] if c else None
+
+
+# --------------------------------------------------------------------------- main
+def build(argv):
+    o_elf, o_fn, n_elf, n_fn = argv[:4]
+    out = argv[argv.index("-o") + 1] if "-o" in argv else "eboot_map.json"
+    eo, en = Elf(o_elf), Elf(n_elf)
+    fo, fn = load_funcs(o_fn), load_funcs(n_fn)
+    print("old: %d functions, new: %d functions" % (len(fo), len(fn)))
+    m, how, wo, wn = match_functions(eo, fo, en, fn)
+    # function pairs matched by hand (<out>.manual.json, "why": "function ...") join the automatic ones, so
+    # the data their code materialises gets votes too
+    import os
+    mp = os.path.splitext(out)[0] + ".manual.json"
+    if os.path.exists(mp):
+        for k, v in json.load(open(mp)).items():
+            a, b = int(k, 16), int(v["new"], 16) if v.get("new") else None
+            if b is not None and v.get("why", "").startswith("function") and a in wo and b in wn and a not in m:
+                m[a], how[a] = b, "manual"
+    kinds = Counter(h.split()[0] for h in how.values())
+    print("matched %d of %d old functions (%s)" % (len(m), len(fo), ", ".join("%s %d" % kv for kv in kinds.items())))
+    toc_o, toc_n = find_toc(eo, fo), find_toc(en, fn)
+    print("TOC: old 0x%X, new 0x%X" % (toc_o or 0, toc_n or 0))
+    tocs_o, tocs_n = find_tocs(eo), find_tocs(en)
+    # PS3 executables have one module TOC; only trust per-descriptor TOCs that serve >= 100 functions each
+    def real(tc):
+        c = Counter(tc.values())
+        keep = {v for v, k in c.items() if k >= 100}
+        return {f: v for f, v in tc.items() if v in keep} if len(keep) > 1 else None
+    tocs_o, tocs_n = real(tocs_o), real(tocs_n)
+    print("per-function TOCs: %s" % ("yes" if tocs_o and tocs_n else "no (one module TOC)"))
+    data = map_data(eo, en, m, wo, wn, toc_o, toc_n, tocs_o, tocs_n)
+    print("data addresses mapped by vote: %d" % len(data))
+    fe = {s: e for s, e in fo}
+    j = {
+        "old": o_elf, "new": n_elf, "toc": ["0x%X" % (toc_o or 0), "0x%X" % (toc_n or 0)],
+        "segments": {"old": [["0x%X" % s[0], "0x%X" % s[1]] for s in eo.segs], "new": [["0x%X" % s[0], "0x%X" % s[1]] for s in en.segs]},
+        "functions": {"0x%08X" % a: {"new": "0x%08X" % b, "how": how[a], "size": fe[a] - a} for a, b in sorted(m.items())},
+        "old_functions": [["0x%08X" % s, "0x%08X" % e] for s, e in fo],
+        "new_functions": [["0x%08X" % s, "0x%08X" % e] for s, e in fn],
+        "data": {"0x%08X" % a: {"new": "0x%08X" % b, "votes": n, "of": t} for a, (b, n, t) in sorted(data.items())},
+    }
+    json.dump(j, open(out, "w"), indent=0)
+    print("wrote", out)
+
+
+class Map:
+    def __init__(self, path):
+        j = json.load(open(path))
+        self.j = j
+        self._eo = self._en = None
+        import os
+        mp = os.path.splitext(path)[0] + ".manual.json"
+        self.manual = {}
+        if os.path.exists(mp):
+            for k, v in json.load(open(mp)).items():
+                self.manual[int(k, 16)] = (int(v["new"], 16) if v.get("new") else None, v.get("why", "manual"))
+        eo = Elf(j["old"])
+        self.oxseg = [(s[0], s[1]) for s in eo.segs if s[4] & 1]
+        self.f = {int(k, 16): (int(v["new"], 16), v["how"], v["size"]) for k, v in j["functions"].items()}
+        self.d = {int(k, 16): (int(v["new"], 16), v["votes"], v["of"]) for k, v in j["data"].items()}
+        self.fs = sorted(self.f)
+        self.ds = sorted(self.d)
+        self.oseg = [(int(a, 16), int(b, 16)) for a, b in j["segments"]["old"]]
+        self.ofs = [int(s, 16) for s, e in j.get("old_functions", [])]
+        self.ofe = [int(e, 16) for s, e in j.get("old_functions", [])]
+        self.nfe = {int(s, 16): int(e, 16) for s, e in j.get("new_functions", [])}
+        tc = j.get("toc")
+        self.toc = (int(tc[0], 16), int(tc[1], 16)) if tc and int(tc[0], 16) else None
+
+    def window(self, a, half=8, reach=0x8000):
+        """A code address the function map cannot place (outside every known function, inside an unmatched
+        one): the 2*half instructions around it, normalised, must occur exactly once in the new build within
+        +-reach of where the nearest matched function below has moved."""
+        k = bisect.bisect_right(self.fs, a) - 1
+        if k < 0:
+            return None
+        sh = self.f[self.fs[k]][0] - self.fs[k]
+        eo, en = self.elfs()
+        x = [norm(w) for w in eo.words(a - 4 * half, a + 4 * half)]
+        if len(x) < 2 * half or len(set(x)) < half:            # too short or too repetitive to be unique
+            return None
+        lo = max(0x10000, (a + sh - reach) & ~3)
+        y = [norm(w) for w in en.words(lo, a + sh + reach)]
+        hits = [lo + 4 * i + 4 * half for i in range(len(y) - len(x) + 1) if y[i] == x[0] and y[i:i + len(x)] == x]
+        return hits[0] if len(hits) == 1 else None
+
+    def lookup(self, a):
+        b, why = self._lookup(a)
+        if b is None and why.startswith(("code outside", "inside")) and not a & 3:
+            w = self.window(a)
+            if w is not None:
+                return w, "code window match (%s)" % why
+        return b, why
+
+    def _lookup(self, a):
+        if a in self.manual:
+            b, why = self.manual[a]
+            return b, "MANUAL: " + why
+        if a in self.f:
+            b, how, _ = self.f[a]
+            return b, "function entry (%s)" % how
+        if any(s[0] <= a < s[1] for s in self.oxseg):          # code: only through its function, never by data rules
+            k = bisect.bisect_right(self.ofs, a) - 1
+            if k < 0 or a >= self.ofe[k]:
+                return None, "code outside any known function"
+            base = self.ofs[k]
+            if base not in self.f:
+                return None, "inside func_%08X+0x%X, which has no match" % (base, a - base)
+            b, how, _ = self.f[base]
+            eo, en = self.elfs()
+            x, y = eo.words(base, self.ofe[k]), en.words(b, b + 4 * 0x4000)
+            nb = self.nfe.get(b)
+            y = en.words(b, nb) if nb else y
+            nx, ny = [norm(w) for w in x], [norm(w) for w in y]
+            idx = (a - base) // 4
+            if nx == ny:
+                return b + (a - base), "inside func_%08X+0x%X (identical; %s)" % (base, a - base, how)
+            sm = difflib.SequenceMatcher(None, nx, ny, autojunk=False)
+            for blk in sm.get_matching_blocks():
+                if blk.a <= idx < blk.a + blk.size:
+                    j = blk.b + (idx - blk.a)
+                    return b + 4 * j + (a - base) % 4, "inside func_%08X+0x%X (aligned in a changed function; %s)" % (base, a - base, how)
+            return None, "inside func_%08X+0x%X: that instruction changed in the update" % (base, a - base)
+        if a in self.d:
+            b, n, t = self.d[a]
+            return b, "data, %d/%d votes" % (n, t)
+        if self.toc and a == self.toc[0]:
+            return self.toc[1], "TOC base"
+        j = bisect.bisect_right(self.ds, a) - 1
+        seg = next((s for s in self.oseg if s[0] <= a < s[1]), None)
+        if j >= 0 and seg:
+            lo = self.ds[j]
+            hi = self.ds[j + 1] if j + 1 < len(self.ds) else None
+            slo = self.d[lo][0] - lo
+            if hi is not None and seg[0] <= lo and hi < seg[1] and self.d[hi][0] - hi == slo:
+                return a + slo, "data between 0x%08X and 0x%08X (both shifted by %+#x)" % (lo, hi, slo)
+            if seg[0] <= lo and a - lo < 0x1000:
+                return a + slo, "data via 0x%08X+0x%X (nearest mapped below; CHECK)" % (lo, a - lo)
+        return None, "unmapped"
+
+    def elfs(self):
+        if self._eo is None:
+            self._eo, self._en = Elf(self.j["old"]), Elf(self.j["new"])
+        return self._eo, self._en
+
+    def confirm(self, a, b, why, radius=0x2000):
+        """Check a data mapping by content: a constant keeps its value, a pointer slot points at the mapped
+        target. A guess that fails is replaced by the unique match within +-radius, if there is one."""
+        eo, en = self.elfs()
+        vo = eo.u32(a)
+        if vo is None:
+            return b, why + " [bss: no content to confirm]"
+        seg = eo.seg_of(vo)
+        exp = None
+        if vo and seg and vo >= 0x10000:
+            vb, _ = self.lookup(vo)
+            exp = vb
+        else:
+            exp = vo
+        if exp is None:
+            return b, why + " [pointer target unmapped]"
+        if b is not None and en.u32(b) == exp:
+            return b, why + " [content confirmed]"
+        base = b if b is not None else a
+        hits = [x for x in range(max(0x10000, (base - radius) & ~3), base + radius, 4) if en.u32(x) == exp]
+        if len(hits) == 1:
+            return hits[0], "content match within +-0x%X (value 0x%08X)" % (radius, exp)
+        return b, why + " [content NOT confirmed: %d candidates]" % len(hits)
+
+
+def query(argv):
+    mp = Map(argv[0])
+    for tok in argv[1:]:
+        t = tok[5:] if tok.startswith("func_") else tok
+        a = int(t, 16)
+        b, why = mp.lookup(a)
+        if not why.startswith(("function", "inside", "MANUAL", "code window")):   # hand entries are not guesses
+            b, why = mp.confirm(a, b, why)
+        print("%-16s -> %-12s %s" % (tok, ("0x%08X" % b) if b is not None else "?", why))
+
+
+TOKEN = re.compile(r"\bfunc_([0-9A-Fa-f]{8})\b|\b0x([0-9A-Fa-f]{5,8})\b")
+
+
+def rewrite(argv):
+    mp = Map(argv[0])
+    for path in argv[1:]:
+        seen = set()
+        for ln, line in enumerate(open(path, encoding="utf-8", errors="replace"), 1):
+            for mt in TOKEN.finditer(line):
+                tok = mt.group(0)
+                if tok in seen:
+                    continue
+                seen.add(tok)
+                a = int(mt.group(1) or mt.group(2), 16)
+                if a < 0x10000 or not any(s[0] <= a < s[1] for s in mp.oseg):
+                    continue
+                b, why = mp.lookup(a)
+                if not why.startswith(("function", "inside", "MANUAL", "code window")):
+                    b, why = mp.confirm(a, b, why)
+                print("%s:%d  %-16s -> %-12s %s" % (path, ln, tok, ("0x%08X" % b) if b is not None else "?", why))
+
+
+CONT_TOKEN = re.compile(r"(?<![A-Za-z0-9_])func_([0-9A-Fa-f]{8})(?:\+(0x[0-9A-Fa-f]+|\d+))?\b|\b0x([0-9A-Fa-f]{5,8})\b")
+
+
+def _is_call(w):
+    return w is not None and ((w >> 26) == 18 and w & 1 or (w & 0xFC0007FF) == 0x4C000421)   # bl / bctrl
+
+
+def translate(argv):
+    """translate MAP IN OUT: carry an address list over to the new build (e.g. a lifter --cont-list): every
+    func_X, func_X+off and 0xADDR outside '#' comments is mapped; a return address (one that follows a call
+    in the old build) must follow a call in the new one too. Prefixed names (libsre_func_X: another module)
+    and comments are kept. Tokens that do not map are dropped and listed at the end of OUT."""
+    mp = Map(argv[0])
+    eo, en = mp.elfs()
+    nfs = sorted(mp.nfe)
+    dropped, n = [], 0
+
+    def new_func_of(b):
+        k = bisect.bisect_right(nfs, b) - 1
+        return nfs[k] if k >= 0 and b < mp.nfe[nfs[k]] else None
+
+    def one(m):
+        nonlocal n
+        tok = m.group(0)
+        if m.group(1) and m.group(2) is None:                 # a function start (the lifter's, maybe not the map's)
+            b, why = mp.lookup(int(m.group(1), 16))
+            if b is None:
+                dropped.append(tok); return ""
+            n += 1
+            return "func_%08X" % b
+        a = int(m.group(1), 16) + int(m.group(2), 0) if m.group(1) else int(m.group(3), 16)
+        b, why = mp.lookup(a)
+        if b is None or (_is_call(eo.u32(a - 4)) and not _is_call(en.u32(b - 4))):
+            dropped.append(tok); return ""
+        n += 1
+        if m.group(1):
+            f = new_func_of(b)
+            return "func_%08X+0x%X" % (f, b - f) if f is not None else "0x%08X" % b
+        return "0x%08X" % b
+
+    out = []
+    for line in open(argv[1], encoding="utf-8"):
+        body, sep, cmt = line.rstrip("\n").partition("#")
+        body = CONT_TOKEN.sub(one, body)
+        out.append(re.sub(r"[ \t]{2,}", " ", body).rstrip() + (" " + sep + cmt if sep and body.strip() else sep + cmt))
+    out.append("# translated by eboot_map.py from %s (%s -> %s): %d tokens, %d dropped%s" % (
+        os.path.basename(argv[1]), mp.j["old"], mp.j["new"], n, len(dropped), ":" if dropped else ""))
+    for k in range(0, len(dropped), 8):
+        out.append("#   " + " ".join(dropped[k:k + 8]))
+    open(argv[2], "w", encoding="utf-8", newline="\n").write("\n".join(out) + "\n")
+    print("%s: %d tokens mapped, %d dropped" % (argv[2], n, len(dropped)))
+
+
+if __name__ == "__main__":
+    if len(sys.argv) < 3:
+        print(__doc__); sys.exit(1)
+    {"build": build, "query": query, "rewrite": rewrite, "translate": translate}[sys.argv[1]](sys.argv[2:])
