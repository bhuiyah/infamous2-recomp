+      rsx_ss_written(&c, 1);
+      rsx_ss_barrier(&c, 1);
+      CHECK(rsx_ss_decide(&c, 1, 2, 1, 8) == RSX_SS_COPY, "written then cleared: copy (the writer misses the clear)");
+      CHECK(!rsx_ss_takes_writer(&c, 1), "a barred copy records no writer");
+      rsx_ss_written(&c, 1);
+      CHECK(rsx_ss_decide(&c, 1, 2, 1, 8) == RSX_SS_COPY, "barred, then written: still copy");
+      rsx_ss_copied(&c, 1, 7);
+      CHECK(rsx_ss_decide(&c, 1, 2, 0, 8) == RSX_SS_REUSE && !c.bar && c.wfirst == 7u, "a new copy: clean");
+      rsx_ss_barrier(&c, 1);
+      CHECK(rsx_ss_decide(&c, 1, 2, 0, 8) == RSX_SS_COPY, "clean then cleared: copy");
+      rsx_ss_copied(&c, 1, 7);
+      rsx_ss_barrier(&c, 2);
+      CHECK(rsx_ss_decide(&c, 1, 2, 0, 8) == RSX_SS_REUSE, "another loop's barrier leaves it");
+      rsx_ss_written(&c, 0);
+      CHECK(rsx_ss_decide(&c, 1, 2, 1, 8) == RSX_SS_COPY && !rsx_ss_takes_writer(&c, 1),
