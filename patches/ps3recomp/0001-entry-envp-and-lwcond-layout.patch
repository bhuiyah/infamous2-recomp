+/* spu__d2fx of 4 doubles: the SPU single in the low dword of each qword;
+ * *tiny gets the flushed lanes (|d| < 2^-126), *mag |d|. */
+SPU_FORCEINLINE __m256i spu__d2fx_q(__m256d d, __m256i* tiny, __m256d* mag) {
+    const __m256d a = _mm256_and_pd(d, _mm256_castsi256_pd(_mm256_set1_epi64x(0x7FFFFFFFFFFFFFFFll)));
