+/* Slot i's park record, context and chain into s (s->live 0: nothing to
+ * write for it). Returns 0, or -1 for a live thread with no context. */
+static int pput_resolve(int i, struct pput_scr* s)
+{
+    const ppu_thread_info* t = &g_ppu_threads[i];
+    const unsigned tid = (unsigned)i + 1;
+    memset(&s->p, 0, sizeof s->p);
+    s->ctx = NULL;
+    s->live = pput_live(t);
+    if (!s->live) return 0;
+    int at = 0, tier = 0, rv = 0;
+    uint32_t num = 0, obj = 0;
+    const ppu_context* c = NULL;
+    ss_sr_root root;
+    memset(&root, 0, sizeof root);
+    if (g_ppu_ss_park_of && g_ppu_ss_park_of(tid, &at, &tier, &num, &obj, &c, &root, &rv) && c) {
