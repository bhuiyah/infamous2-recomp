+/* --- every hardware format (rsx_texture_format_known) -------------------- */
+
+/* libgcm's texture formats, PSL1GHT GCM_TEXTURE_FORMAT_* | 0x80. */
+static const u32 k_all_formats[] = {
+    0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x8B, 0x8D, 0x8E, 0x8F,
+    0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x97, 0x98, 0x99, 0x9A, 0x9B, 0x9C,
+    0x9D, 0x9E, 0x9F };
+
+static void test_format_known(void)
+{
+    for (unsigned i = 0; i < sizeof k_all_formats / sizeof k_all_formats[0]; i++) {
+        const u32 f = k_all_formats[i];
+        CHECK(rsx_texture_format_known(f));
+        CHECK(rsx_texture_format_known(f | FMT_LN));
+        CHECK(rsx_texture_format_known(f | 0x40u));          /* UN */
+        CHECK(rsx_texture_format_known(f | FMT_LN | 0x40u));
+        CHECK_EQ(rsx_texture_format_is_depth(f), f >= 0x90u && f <= 0x93u);
+        /* every one has a real layout: a compressed block or a source and a
+         * decoded texel size, and the source span covers the image */
+        rsx_tex_layout L;
+        rsx_texture_layout(f | FMT_LN, 16, 8, &L);
+        if (L.compressed) CHECK(L.block_bytes == 8 || L.block_bytes == 16);
+        else {
+            CHECK(L.bytes_per_texel >= 1 && L.dst_bytes_per_texel >= 1);
+            CHECK(L.face_bytes >= 16u * 8u * L.bytes_per_texel);
+        }
+    }
+    /* not formats: 0x8C (the old, wrong HILO8 code), 0x89, 0x8A, 0x96, 0x80 */
+    const u32 bad[] = { 0x80, 0x89, 0x8A, 0x8C, 0x96, 0x00, 0x01, 0x05 };
+    for (unsigned i = 0; i < sizeof bad / sizeof bad[0]; i++) {
+        CHECK(!rsx_texture_format_known(bad[i]));
+        CHECK(!rsx_texture_format_is_depth(bad[i]));
+    }
+}
