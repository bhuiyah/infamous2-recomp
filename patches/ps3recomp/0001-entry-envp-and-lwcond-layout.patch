+    ss_transition_end(SS_TR_SPU_THREAD);
+    run_request(SS_P_SAVE, 1.0, 3000, &res);
+    CHECK(res.ok, "a save failed after the transitions ended (%s: %s)", ss_reason_name(res.reason), res.why);
+
+    /* ---- 11b. booting (no flip yet): no stop, given up with that reason ----- */
+    {
+        ss_request r; memset(&r, 0, sizeof r);
+        r.purpose = SS_P_SAVE; r.give_up_s = 0.6; r.done = on_done;
+        const LONG n0 = g_done_n;
+        ss_stats s0; ss_get_stats(&s0);
+        CHECK(ss_request_submit(&r) == SS_R_QUEUED, "submit while booting");
+        for (int i = 0; i < 1500 && g_done_n == n0; i++) { WaitForSingleObject(g_wake, 2); ss_frame_tick(0); }
+        ss_stats s1; ss_get_stats(&s1);
+        ss_last_request(&res);
+        CHECK(g_done_n == n0 + 1 && res.reason == SS_REASON_BOOTING && res.attempts == 0 && s1.stops == s0.stops,
