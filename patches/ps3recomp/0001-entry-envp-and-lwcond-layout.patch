+    /* 15. The gate's sun glow, ten lights (logs run-20261021-230755): per light
+     * box 1 (depth-tested) -> GET 0x14080, box 2 (untested) -> GET 0x14090,
+     * then the consumer samples both records as unit 0. From the second light
+     * on, unit 0 is still bound to the record texture while the boxes draw,
+     * but the box program samples no unit. The old rule (any enabled unit)
+     * delivers before every box 2 as well: 1 + 2 x 9 = 19 measurements. The
+     * precise rule (only units the program samples) leaves box 2 alone and
+     * delivers both records at the consumer: 10, with the same bytes. */
+    { uint32_t vals_old[10][2], vals_new[10][2];
+      for (int arm = 0; arm < 4; arm++) {
+          /* arm 0: no draw_reads (old rule); 1: precise; 2: draw_reads cannot
