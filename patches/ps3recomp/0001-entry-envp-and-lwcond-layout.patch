+/*
+ * cellPad.c (patched) on top of the real pad host (pad_host_win.c) and the
+ * real drivers, driven through the guest-facing API exactly as a title calls
+ * it: cellPadInit / SetPortSetting / GetInfo / GetInfo2 / PeriphGetInfo /
+ * GetData / SetActDirect / End, with guest structures in a fake guest memory
+ * (big-endian, through ppu_memory.h's vm_write*).
+ *
+ * Controllers are virtual devices (padhost_virtual_*): a DualSense on USB and
+ * a DUALSHOCK 3 on its raw HID layout, fed synthesized input reports, their
+ * output reports captured. PAD_NO_HOST=1 keeps every physical controller out
+ * (the real DualSense on this machine is never opened), PAD_NO_KEYBOARD=1
+ * keeps the keyboard out; PAD_CONFIG points at a test input.ini whose
+ * [controller] section must reach the pad host (deadzone 0, touchpad =
+ * START) while the keyboard parser skips it. Also: the system intercept (a
+ * PS3 XMB / the options menu: INTERCEPTED flag, neutral ports, motors held
+ * and replayed, buttons held at its end kept until released) and the
+ * system's buttons (the PS button and the held L3 + R3 reach the menu's hook,
+ * not the title). The window's notice box
+ * (ss_ui_notify, runtime/savestate/ss_ui.c in the game) is replaced by a
+ * recorder: once the window is up, player 1's controller is announced.
+ *
+ * Build and run (Windows, from external/ps3recomp):
+ *   clang-cl /std:c17 /O2 /MD -D_CRT_SECURE_NO_WARNINGS -I include -I libs/input -I libs/system -I runtime/ppu
+ *            libs/input/tests/test_cellpad_host.c libs/input/cellPad.c libs/input/pad_host_win.c
+ *            libs/input/pad_hid_*.c libs/system/options.c /Fe:test_cellpad_host.exe
+ * (libs/system/options.c: the settings store cellPad reads input.ini's
+ * options.ini layer from; OPTIONS_CONFIG=none here.)
+ */
+#include "cellPad.h"
+#include "pad_host.h"
+#include "ppu_memory.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+s32 cellPadGetInfo(CellPadInfo2* info);   /* v1 entry point, not in cellPad.h */
+
+/* --- what the runtime provides to ppu_memory.h's inline writers ---------- */
+uint8_t* vm_base;
+int      g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+int  spu_coh_is_reserved(uint32_t addr) { (void)addr; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_coh_notify_write(uint32_t addr) { (void)addr; }
+void spu_coh_ppu_atomic_note(uint32_t addr) { (void)addr; }
+void ps3_ww_report_inline(uint32_t addr, uint64_t val, int width) { (void)addr; (void)val; (void)width; }
+
+/* --- the window's notice box (ss_ui.c in the game): recorded ------------- */
+static char g_notices[4096];
+void ss_ui_notify(unsigned ms, const char* fmt, ...)
+{
+    char t[200];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(t, sizeof t, fmt, ap);
+    va_end(ap);
+    printf("[ss-ui] notice (%u ms): %s\n", ms, t);
+    size_t l = strlen(g_notices);
+    snprintf(g_notices + l, sizeof g_notices - l, "%s\n", t);
+}
+
+static int g_fail, g_checks;
+#define CHECK(c, ...) do { g_checks++; if (!(c)) { g_fail++; fprintf(stderr, "FAIL line %d: ", __LINE__); \
+                           fprintf(stderr, __VA_ARGS__); fprintf(stderr, "\n"); } } while (0)
+
+#define G_DATA   0x1000u
+#define G_INFO2  0x2000u
+#define G_ACT    0x3000u
+#define G_INFO1  0x4000u
+#define G_PERIPH 0x5000u
+
+static unsigned be16(uint32_t a) { return (unsigned)(vm_base[a] << 8 | vm_base[a + 1]); }
+static unsigned be32(uint32_t a) { return (unsigned)vm_base[a] << 24 | (unsigned)vm_base[a + 1] << 16 | (unsigned)vm_base[a + 2] << 8 | vm_base[a + 3]; }
+
+typedef struct { int len; unsigned b[CELL_PAD_MAX_CODES]; } Data;
+
+static Data get_data(u32 port)
+{
+    Data d;
+    memset(vm_base + G_DATA, 0xEE, 4 + 2 * CELL_PAD_MAX_CODES);
+    s32 rc = cellPadGetData(port, (CellPadData*)(uintptr_t)G_DATA);
+    if (rc != 0) fprintf(stderr, "GetData(%u) = %d\n", port, rc);
+    d.len = (int)be32(G_DATA);
+    for (int i = 0; i < CELL_PAD_MAX_CODES; i++) d.b[i] = be16(G_DATA + 4 + 2u * (unsigned)i);
+    return d;
+}
+
+static unsigned info2_status(int port) { return be32(G_INFO2 + 12 + 4u * (unsigned)port); }
+
+static void info2(void)
+{
+    memset(vm_base + G_INFO2, 0xEE, sizeof(CellPadInfo2));
+    CHECK(cellPadGetInfo2((CellPadInfo2*)(uintptr_t)G_INFO2) == 0, "GetInfo2");
+}
+
+/* GetTickCount64 granularity is ~15.6 ms: wait past the 4 ms poll gate. */
+static void next_report(void) { Sleep(40); }
+
+
+/* cellPad_host_set_system_hook: what reached it (polling thread) */
+static volatile int g_hook_n, g_hook_port[8], g_hook_what[8];
+static void sys_hook_rec(int port, int what)
+{
+    const int k = g_hook_n;
+    if (k < 8) { g_hook_port[k] = port; g_hook_what[k] = what; }
+    g_hook_n = k + 1;
+}
+
+/* Buttons held when an intercept ends are kept from the title until released:
+ * release everything on both pads, then press the same again. */
+static void release_and_press(int ds5, const unsigned char* rep, int ds3, const unsigned char* ds3_rep)
+{
+    unsigned char up[64], d3[49];
+    memcpy(up, rep, sizeof up);
+    up[8] = 0x08; up[9] = 0;                                     /* hat released, no buttons */
+    memcpy(d3, ds3_rep, sizeof d3);
+    d3[3] = 0; d3[24] = 0;
+    g_checks++;
+    if (padhost_virtual_feed(ds5, up, 64) || padhost_virtual_feed(ds3, d3, 49)) { g_fail++; fputs("FAIL: feed released\n", stderr); }
+    next_report();
+    get_data(0); get_data(1);
+    g_checks++;
+    if (padhost_virtual_feed(ds5, rep, 64) || padhost_virtual_feed(ds3, ds3_rep, 49)) { g_fail++; fputs("FAIL: feed pressed\n", stderr); }
+    next_report();
+}
+
+static int last_out(int id, unsigned char* buf, int* count)
+{
+    memset(buf, 0, 1024);
+    return padhost_virtual_last_output(id, buf, 1024, count);
+}
+
+int main(void)
+{
+    /* stdout -> file, so the log lines can be checked; echoed at the end. */
+    char outpath[MAX_PATH], inipath[MAX_PATH];
+    GetFullPathNameA("test_cellpad_host.stdout.txt", MAX_PATH, outpath, NULL);
+    GetFullPathNameA("test_cellpad_host.ini", MAX_PATH, inipath, NULL);
+    {
+        FILE* f = fopen(inipath, "wb");
+        fputs("# test input.ini\r\n[bindings]\r\nCross = Space\r\n\r\n[controller]\r\n"
+              "deadzone = 0\r\ndualsense_touchpad = start   # touchpad click = START\r\n"
+              "bogus_setting = 1\r\n\r\n[options]\r\nmerge_with_controller = 1\r\n", f);
+        fclose(f);
+    }
+    char env[MAX_PATH + 16];
+    snprintf(env, sizeof env, "PAD_CONFIG=%s", inipath);
+    _putenv(env);
+    _putenv("PAD_NO_HOST=1");
+    _putenv("PAD_NO_KEYBOARD=1");
+    _putenv("OPTIONS_CONFIG=none");     /* the settings store: no options.ini */
+    _putenv("DISPLAY_CONFIG=none");
+    if (!freopen(outpath, "w", stdout)) { fprintf(stderr, "freopen failed\n"); return 2; }
+
+    vm_base = (uint8_t*)calloc(1, 0x10000);
+
+    /* ---- init, no controller: port 0 is the virtual pad ---------------- */
+    CHECK(cellPadInit(2) == 0, "cellPadInit");
+    CHECK(cellPadSetPortSetting(0, CELL_PAD_SETTING_PRESS_ON | CELL_PAD_SETTING_SENSOR_ON) == 0, "SetPortSetting 0");
+    CHECK(cellPadSetPortSetting(1, CELL_PAD_SETTING_PRESS_ON | CELL_PAD_SETTING_SENSOR_ON) == 0, "SetPortSetting 1");
+    next_report();
+    info2();
+    CHECK(be32(G_INFO2 + 0) == 2, "max_connect %u", be32(G_INFO2));
+    CHECK(be32(G_INFO2 + 4) == 1, "now_connect %u", be32(G_INFO2 + 4));
+    CHECK(info2_status(0) == CELL_PAD_STATUS_CONNECTED, "virtual port 0 status %u", info2_status(0));
+    CHECK(info2_status(1) == CELL_PAD_STATUS_DISCONNECTED, "port 1 status %u", info2_status(1));
+    cellPad_host_window_created(NULL);     /* the game window is up: notices are seen */
+
+    Data d = get_data(0);
+    CHECK(d.len == CELL_PAD_LEN_CHANGE_SENSOR_ON, "len %d", d.len);
+    CHECK(d.b[0] == 0 && d.b[1] == (0x70 | 14), "button[0..1] %X %X", d.b[0], d.b[1]);
+    CHECK(d.b[2] == 0 && d.b[3] == 0, "no buttons %X %X", d.b[2], d.b[3]);
+    CHECK(d.b[4] == 128 && d.b[5] == 128 && d.b[6] == 128 && d.b[7] == 128, "sticks centred");
+    CHECK(d.b[20] == 512 && d.b[21] == 399 && d.b[22] == 512 && d.b[23] == 512,
+          "neutral sensors %u %u %u %u", d.b[20], d.b[21], d.b[22], d.b[23]);
+    d = get_data(0);
+    CHECK(d.len == 0, "second read of the same report: len %d (one packet per report)", d.len);
+    d = get_data(1);
+    CHECK(d.len == 0, "empty port 1: len %d", d.len);
+
+    /* ---- a DualSense on USB arrives: port 0 ---------------------------- */
+    int ds5 = padhost_virtual_attach(&padhost_drv_dualsense, PADHOST_BUS_USB, 0x054C, 0x0CE6, "", 64, 48);
+    CHECK(ds5 > 0, "attach DualSense");
+    CHECK(padhost_virtual_port(ds5) == 0, "DualSense port %d", padhost_virtual_port(ds5));
+    Sleep(60);
+    unsigned char out[1024];
+    int count = 0, n = last_out(ds5, out, &count);
+    CHECK(count >= 2, "reset + LED reports, %d writes", count);
+    CHECK(n == 48 && out[0] == 0x02, "USB output report 0x02 (%d bytes, id %02X)", n, out[0]);
+    CHECK(out[1 + 1] == 0x14, "lightbar + player LED enable %02X", out[2]);
+    CHECK(out[1 + 43] == 0x04, "player LED for port 0: %02X", out[44]);
+    CHECK(out[1 + 44] == 0x00 && out[1 + 45] == 0x00 && out[1 + 46] == 0x40, "port 0 blue %02X%02X%02X",
+          out[45], out[46], out[47]);
+
+    unsigned char rep[64];
+    memset(rep, 0, sizeof rep);
+    rep[0] = 0x01;
+    rep[1] = 10; rep[2] = 250; rep[3] = 200; rep[4] = 60;   /* lx ly rx ry */
+    rep[5] = 100; rep[6] = 0;                               /* L2 / R2 analog */
+    rep[8] = 0x08 | 0x20;                                   /* hat released, CROSS */
+    rep[9] = 0x04;                                          /* L2 digital */
+    rep[10] = 0x02;                                         /* touchpad click */
+    rep[24] = 0x00; rep[25] = 0x20;                         /* accel y = +8192 (1 g) */
+    rep[26] = 0x00; rep[27] = 0xF0;                         /* accel z = -4096 */
+    rep[53] = 0x05;                                         /* battery 55 % */
+    CHECK(padhost_virtual_feed(ds5, rep, 64) == 0, "feed");
+    next_report();
+
+    info2();
+    CHECK(info2_status(0) == (CELL_PAD_STATUS_CONNECTED | CELL_PAD_STATUS_ASSIGN_CHANGES),
+          "port 0 after the DualSense arrived: %u", info2_status(0));
+    info2();
+    CHECK(info2_status(0) == CELL_PAD_STATUS_CONNECTED, "ASSIGN_CHANGES reported once: %u", info2_status(0));
+
+    d = get_data(0);
+    CHECK(d.len == CELL_PAD_LEN_CHANGE_SENSOR_ON, "len %d", d.len);
+    CHECK(d.b[2] == CELL_PAD_CTRL_START, "DIGITAL1 %X (touchpad -> START from input.ini)", d.b[2]);
+    CHECK(d.b[3] == ((CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_L2) >> 8), "DIGITAL2 %X", d.b[3]);
+    CHECK(d.b[6] == 10 && d.b[7] == 250 && d.b[4] == 200 && d.b[5] == 60,
+          "raw sticks with deadzone 0 from input.ini: l=(%u,%u) r=(%u,%u)", d.b[6], d.b[7], d.b[4], d.b[5]);
+    CHECK(d.b[CELL_PAD_BTN_OFFSET_PRESS_CROSS] == 255, "cross pressure %u", d.b[CELL_PAD_BTN_OFFSET_PRESS_CROSS]);
+    CHECK(d.b[CELL_PAD_BTN_OFFSET_PRESS_L2] == 100, "L2 keeps its analog travel: %u", d.b[CELL_PAD_BTN_OFFSET_PRESS_L2]);
+    CHECK(d.b[CELL_PAD_BTN_OFFSET_PRESS_R2] == 0, "R2 %u", d.b[CELL_PAD_BTN_OFFSET_PRESS_R2]);
+    CHECK(d.b[CELL_PAD_BTN_OFFSET_PRESS_SQUARE] == 0, "square %u", d.b[CELL_PAD_BTN_OFFSET_PRESS_SQUARE]);
+    CHECK(d.b[20] == 512 && (d.b[21] == 398 || d.b[21] == 399) && d.b[22] == 568 && d.b[23] == 512,
+          "DualSense motion %u %u %u %u", d.b[20], d.b[21], d.b[22], d.b[23]);
+    {
+        PadHostPortState st;
+        CHECK(padhost_get(0, &st) && st.kind == PADHOST_KIND_DUALSENSE && st.battery == 55,
+              "snapshot kind %d battery %u", st.kind, st.battery);
+    }
+    /* motion = 0 (input.ini [controller] / PAD_HOST): the pad reads as lying still */
+    CHECK(padhost_config_set("motion", "0") == 1, "motion=0 accepted");
+    CHECK(padhost_virtual_feed(ds5, rep, 64) == 0, "feed");
+    next_report();
+    d = get_data(0);
+    CHECK(d.b[20] == 512 && d.b[21] == 399 && d.b[22] == 512 && d.b[23] == 512,
+          "motion off: neutral sensors %u %u %u %u", d.b[20], d.b[21], d.b[22], d.b[23]);
+    CHECK(padhost_config_set("motion", "1") == 1, "motion=1 accepted");
+    CHECK(padhost_virtual_feed(ds5, rep, 64) == 0, "feed");
+    next_report();
+    d = get_data(0);
+    CHECK(d.b[22] == 568, "motion back on: z %u", d.b[22]);
+
+    /* ---- the window's notice says who is player 1 (once it held 300 ms) -- */
+    for (int i = 0; i < 12; i++) { next_report(); get_data(0); }
+    CHECK(strstr(g_notices, "Controller: DualSense (USB) on player 1\n") == g_notices,
+          "player-1 notice, and no other before it: \"%s\"", g_notices);
+    for (int i = 0; i < 4; i++) { next_report(); get_data(0); }
+    CHECK(strstr(g_notices + 1, "Controller:") == NULL, "said once: \"%s\"", g_notices);
+    {
+        char who[96];
+        CHECK(padhost_port_describe(0, who, (int)sizeof who) == 1 && !strcmp(who, "DualSense (USB)"),
+              "padhost_port_describe(0) = %s", who);
+        CHECK(padhost_port_describe(5, who, (int)sizeof who) == 0 && !who[0], "an empty port");
+    }
+
+    /* ---- rumble ---------------------------------------------------------- */
+    vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_SMALL] = 1;
+    vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_LARGE] = 200;
+    CHECK(cellPadSetActDirect(0, (CellPadActParam*)(uintptr_t)G_ACT) == 0, "SetActDirect");
+    Sleep(60);
+    n = last_out(ds5, out, &count);
+    CHECK(out[0] == 0x02 && out[1 + 2] == 255 && out[1 + 3] == 200, "DualSense motors weak %u strong %u",
+          out[3], out[4]);
+    CHECK((out[1] & 0x02) && out[1 + 43] == 0x04, "haptics select + player LED kept (%02X %02X)", out[1], out[44]);
+    {
+        int before = count;
+        CHECK(cellPadSetActDirect(0, (CellPadActParam*)(uintptr_t)G_ACT) == 0, "SetActDirect again");
+        Sleep(40);
+        last_out(ds5, out, &count);
+        CHECK(count == before, "unchanged motors are not re-sent (%d -> %d)", before, count);
+    }
+    vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_SMALL] = 0;
+    vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_LARGE] = 0;
+    cellPadSetActDirect(0, (CellPadActParam*)(uintptr_t)G_ACT);
+    Sleep(40);
+    last_out(ds5, out, &count);
+    CHECK(out[1 + 2] == 0 && out[1 + 3] == 0, "motors off %u %u", out[3], out[4]);
+    CHECK(cellPadSetActDirect(1, (CellPadActParam*)(uintptr_t)G_ACT) == 0, "SetActDirect on an empty port is OK");
+
+    /* ---- a DUALSHOCK 3 (raw HID) on port 1: real pressure, sensors ------- */
+    unsigned char ds3_rep[49];              /* its report (the intercept test below feeds it again) */
+    int ds3 = padhost_virtual_attach(&padhost_drv_ds3, PADHOST_BUS_USB, 0x054C, 0x0268, "", 49, 49);
+    CHECK(ds3 > 0, "attach DS3");
+    CHECK(padhost_virtual_port(ds3) == 1, "DS3 port %d", padhost_virtual_port(ds3));
+    {
+        unsigned char r[49];
+        memset(r, 0, sizeof r);
+        r[0] = 0x01;
+        r[3] = 0x40 | 0x10;                 /* CROSS + TRIANGLE */
+        r[6] = r[7] = r[8] = r[9] = 128;
+        r[24] = 0x40;                       /* cross pressure 64 */
+        r[22] = 0;                          /* triangle: bit set, pressure 0 */
+        r[30] = 3;                          /* battery 50 % */
+        r[41] = 600 >> 8; r[42] = 600 & 0xFF;   /* x (mirrored: 1024 - 600 = 424) */
+        r[43] = 512 >> 8; r[44] = 512 & 0xFF;   /* z */
+        r[45] = 399 >> 8; r[46] = 399 & 0xFF;   /* y */
+        r[47] = 520 >> 8; r[48] = 520 & 0xFF;   /* g */
+        CHECK(padhost_virtual_feed(ds3, r, 49) == 0, "feed DS3");
+        memcpy(ds3_rep, r, sizeof ds3_rep);
+    }
+    next_report();
+    info2();
+    CHECK(be32(G_INFO2 + 4) == 2, "now_connect %u", be32(G_INFO2 + 4));
+    CHECK(info2_status(0) == CELL_PAD_STATUS_CONNECTED, "port 0 unchanged: %u", info2_status(0));
+    CHECK(info2_status(1) == (CELL_PAD_STATUS_CONNECTED | CELL_PAD_STATUS_ASSIGN_CHANGES), "port 1 %u", info2_status(1));
+    CHECK(be32(G_INFO2 + 96 + 4) == CELL_PAD_DEV_TYPE_STANDARD, "device type");
+    d = get_data(1);
+    CHECK(d.len == CELL_PAD_LEN_CHANGE_SENSOR_ON, "port 1 len %d", d.len);
+    CHECK(d.b[3] == 0x50 && d.b[2] == 0, "DS3 buttons %X %X", d.b[2], d.b[3]);
+    CHECK(d.b[CELL_PAD_BTN_OFFSET_PRESS_CROSS] == 0x40, "DS3 real cross pressure %u", d.b[CELL_PAD_BTN_OFFSET_PRESS_CROSS]);
+    CHECK(d.b[CELL_PAD_BTN_OFFSET_PRESS_TRIANGLE] == 255, "pressed with no pressure reading -> 255: %u",
+          d.b[CELL_PAD_BTN_OFFSET_PRESS_TRIANGLE]);
+    CHECK(d.b[20] == 424 && d.b[21] == 399 && d.b[22] == 512 && d.b[23] == 520,
+          "DS3 sensors %u %u %u %u", d.b[20], d.b[21], d.b[22], d.b[23]);
+    vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_SMALL] = 1;
+    vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_LARGE] = 0;
+    cellPadSetActDirect(1, (CellPadActParam*)(uintptr_t)G_ACT);
+    Sleep(60);
+    n = last_out(ds3, out, &count);
+    CHECK(n == 49 && out[0] == 0x01 && out[3] == 1 && out[5] == 0 && out[10] == 0x04,
+          "DS3 output: weak %u strong %u LEDs %02X (port 1 = LED 2)", out[3], out[5], out[10]);
+
+    /* ---- the system intercepts the controllers (a PS3's XMB; the settings
+     * store's options_set_intercepted): system_info = INTERCEPTED in all three
+     * info calls, every port neutral and still connected, motors off; a motor
+     * request meanwhile is kept and sent when it ends ----------------------- */
+    {
+        CHECK(padhost_virtual_feed(ds5, rep, 64) == 0, "feed");          /* CROSS + L2 + sticks held */
+        vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_SMALL] = 1;
+        vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_LARGE] = 180;
+        cellPadSetActDirect(0, (CellPadActParam*)(uintptr_t)G_ACT);
+        Sleep(60);
+        last_out(ds5, out, &count);
+        CHECK(out[1 + 2] == 255 && out[1 + 3] == 180, "rumbling before %u %u", out[3], out[4]);
+        info2();
+        CHECK(be32(G_INFO2 + 8) == 0, "system_info 0 before: %u", be32(G_INFO2 + 8));
+
+        cellPad_host_intercept(1, 1);
+        CHECK(cellPad_host_intercepted(), "intercepted");
+        Sleep(60);
+        last_out(ds5, out, &count);
+        CHECK(out[1 + 2] == 0 && out[1 + 3] == 0, "intercepted: motors off %u %u", out[3], out[4]);
+        next_report();
+        info2();
+        CHECK(be32(G_INFO2 + 8) == CELL_PAD_INFO_INTERCEPTED, "GetInfo2 system_info %u", be32(G_INFO2 + 8));
+        CHECK((info2_status(0) & CELL_PAD_STATUS_CONNECTED) && (info2_status(1) & CELL_PAD_STATUS_CONNECTED),
+              "still connected: %u %u", info2_status(0), info2_status(1));
+        memset(vm_base + G_INFO1, 0xEE, 0x210);
+        CHECK(cellPadGetInfo((CellPadInfo2*)(uintptr_t)G_INFO1) == 0, "GetInfo");
+        CHECK(be32(G_INFO1 + 8) == CELL_PAD_INFO_INTERCEPTED, "GetInfo (v1) system_info %u", be32(G_INFO1 + 8));
+        memset(vm_base + G_PERIPH, 0xEE, sizeof(CellPadPeriphInfo));
+        CHECK(cellPadPeriphGetInfo((CellPadPeriphInfo*)(uintptr_t)G_PERIPH) == 0, "PeriphGetInfo");
+        CHECK(be32(G_PERIPH + 8) == CELL_PAD_INFO_INTERCEPTED, "PeriphGetInfo system_info %u", be32(G_PERIPH + 8));
+        for (u32 port = 0; port < 2; port++) {
+            d = get_data(port);
+            CHECK(d.len == CELL_PAD_LEN_CHANGE_SENSOR_ON, "port %u intercepted: len %d (packets go on)", port, d.len);
+            CHECK(d.b[2] == 0 && d.b[3] == 0, "port %u: no buttons %X %X", port, d.b[2], d.b[3]);
+            CHECK(d.b[4] == 128 && d.b[5] == 128 && d.b[6] == 128 && d.b[7] == 128, "port %u: sticks centred", port);
+            int pz = 1;
+            for (int k = CELL_PAD_BTN_OFFSET_PRESS_RIGHT; k <= CELL_PAD_BTN_OFFSET_PRESS_R2; k++) pz &= d.b[k] == 0;
+            CHECK(pz, "port %u: no pressure", port);
+            CHECK(d.b[20] == 512 && d.b[21] == 399 && d.b[22] == 512 && d.b[23] == 512, "port %u: lying still", port);
+        }
+        vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_SMALL] = 0;           /* the title asks meanwhile */
+        vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_LARGE] = 90;
+        cellPadSetActDirect(0, (CellPadActParam*)(uintptr_t)G_ACT);
+        Sleep(60);
+        last_out(ds5, out, &count);
+        CHECK(out[1 + 2] == 0 && out[1 + 3] == 0, "intercepted: the request is held %u %u", out[3], out[4]);
+
+        cellPad_host_intercept(0, 0);
+        CHECK(!cellPad_host_intercepted(), "released");
+        Sleep(60);
+        last_out(ds5, out, &count);
+        CHECK(out[1 + 2] == 0 && out[1 + 3] == 90, "released: the last request is sent %u %u", out[3], out[4]);
+        CHECK(padhost_virtual_feed(ds5, rep, 64) == 0, "feed");
+        next_report();
+        info2();
+        CHECK(be32(G_INFO2 + 8) == 0, "system_info 0 after: %u", be32(G_INFO2 + 8));
+        /* buttons still held when it ends (the Cross that closed a menu) stay away from the title until
+         * they are released, on every port; the sticks are back at once */
+        d = get_data(0);
+        CHECK(d.b[3] == 0 && d.b[6] == 10, "held at the end: kept until released: %X l.x %u", d.b[3], d.b[6]);
+        d = get_data(1);
+        CHECK(d.b[3] == 0, "DS3 held at the end: kept until released: %X", d.b[3]);
+        release_and_press(ds5, rep, ds3, ds3_rep);
+        d = get_data(0);
+        CHECK(d.b[3] == ((CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_L2) >> 8) && d.b[6] == 10,
+              "input back after a release: %X l.x %u", d.b[3], d.b[6]);
+
+        /* pause_mode = off: neutral input, no flag (the game keeps running) */
+        cellPad_host_intercept(1, 0);
+        next_report();
+        info2();
+        CHECK(be32(G_INFO2 + 8) == 0, "no flag reported: %u", be32(G_INFO2 + 8));
+        d = get_data(0);
+        CHECK(d.b[3] == 0 && d.b[6] == 128, "but neutral: %X %u", d.b[3], d.b[6]);
+        cellPad_host_intercept(0, 0);
+        release_and_press(ds5, rep, ds3, ds3_rep);                       /* held again at its end */
+        vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_SMALL] = 0;
+        vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_LARGE] = 0;
+        cellPadSetActDirect(0, (CellPadActParam*)(uintptr_t)G_ACT);
+    }
+
+    /* ---- the system's buttons (an options menu's): the PS button and the menu combination held
+     * (L3 + R3) call the hook on the polling thread, once per press / hold; while the whole
+     * combination is down its buttons are kept from the title, a lone L3 is the title's ------------ */
+    {
+        unsigned char r2[64];
+        memcpy(r2, rep, sizeof r2);
+        r2[8] = 0x08; r2[9] = 0; r2[10] = 0;                              /* nothing pressed */
+        g_hook_n = 0;
+        cellPad_host_set_system_hook(sys_hook_rec);
+        cellPad_host_set_menu_combo(CELL_PAD_CTRL_L3 | CELL_PAD_CTRL_R3, 200);
+        CHECK(padhost_virtual_feed(ds5, r2, 64) == 0, "feed");
+        next_report(); get_data(0);
+        CHECK(g_hook_n == 0, "no hook at rest: %d", g_hook_n);
+        r2[10] = 0x01;                                                    /* PS */
+        CHECK(padhost_virtual_feed(ds5, r2, 64) == 0, "feed PS");
+        next_report(); d = get_data(0); get_data(0);
+        CHECK(g_hook_n == 1 && g_hook_port[0] == 0 && g_hook_what[0] == 1, "PS: hook %d (port %d what %d)",
+              g_hook_n, g_hook_port[0], g_hook_what[0]);
+        CHECK(d.b[2] == 0 && d.b[3] == 0, "PS is not the title's: %X %X", d.b[2], d.b[3]);
+        r2[10] = 0;
+        CHECK(padhost_virtual_feed(ds5, r2, 64) == 0, "feed PS up");
+        next_report(); get_data(0);
+        r2[9] = 0x40;                                                     /* L3 alone */
+        CHECK(padhost_virtual_feed(ds5, r2, 64) == 0, "feed L3");
+        next_report(); d = get_data(0);
+        CHECK((d.b[2] & CELL_PAD_CTRL_L3) != 0, "a lone L3 is the title's: %X", d.b[2]);
+        r2[9] = 0x40 | 0x80;                                              /* L3 + R3 */
+        CHECK(padhost_virtual_feed(ds5, r2, 64) == 0, "feed L3+R3");
+        next_report(); d = get_data(0);
+        CHECK((d.b[2] & (CELL_PAD_CTRL_L3 | CELL_PAD_CTRL_R3)) == 0 && g_hook_n == 1,
+              "L3+R3 down: kept from the title %X, no hook before the hold %d", d.b[2], g_hook_n);
+        Sleep(250); d = get_data(0); get_data(0);
+        CHECK(g_hook_n == 2 && g_hook_what[1] == 2 && (d.b[2] & (CELL_PAD_CTRL_L3 | CELL_PAD_CTRL_R3)) == 0,
+              "held 200 ms: hook %d what %d, still kept %X", g_hook_n, g_hook_what[1], d.b[2]);
+        r2[9] = 0x40;                                                     /* R3 up, L3 still down */
+        CHECK(padhost_virtual_feed(ds5, r2, 64) == 0, "feed R3 up");
+        next_report(); d = get_data(0);
+        CHECK((d.b[2] & CELL_PAD_CTRL_L3) == 0, "kept until all are up: %X", d.b[2]);
+        r2[9] = 0;
+        CHECK(padhost_virtual_feed(ds5, r2, 64) == 0, "feed all up");
+        next_report(); get_data(0);
+        r2[9] = 0x40;
+        CHECK(padhost_virtual_feed(ds5, r2, 64) == 0, "feed L3 again");
+        next_report(); d = get_data(0);
+        CHECK((d.b[2] & CELL_PAD_CTRL_L3) != 0 && g_hook_n == 2, "L3 the title's again: %X (hooks %d)", d.b[2], g_hook_n);
+        cellPad_host_set_menu_combo(0, 500);
+        cellPad_host_set_system_hook(NULL);
+        CHECK(padhost_virtual_feed(ds5, rep, 64) == 0, "feed");
+        next_report(); get_data(0);
+    }
+
+    /* GetInfo (v1): CELL_MAX_PADS-sized arrays, DS3 ids, status bytes */
+    memset(vm_base + G_INFO1, 0xEE, 0x210);
+    CHECK(cellPadGetInfo((CellPadInfo2*)(uintptr_t)G_INFO1) == 0, "GetInfo");
+    CHECK(be32(G_INFO1 + 4) == 2, "v1 now_connect %u", be32(G_INFO1 + 4));
+    CHECK(be16(G_INFO1 + 0x0C + 2) == 0x054C && be16(G_INFO1 + 0x10A + 2) == 0x0268, "v1 port 1 ids");
+    CHECK(vm_base[G_INFO1 + 0x208] == 1 && vm_base[G_INFO1 + 0x209] == 1, "v1 status %u %u",
+          vm_base[G_INFO1 + 0x208], vm_base[G_INFO1 + 0x209]);
+
+    /* ---- the DualSense leaves: port 0 is the virtual pad again ----------- */
+    padhost_virtual_detach(ds5);
+    next_report();
+    memset(vm_base + G_PERIPH, 0xEE, sizeof(CellPadPeriphInfo));
+    CHECK(cellPadPeriphGetInfo((CellPadPeriphInfo*)(uintptr_t)G_PERIPH) == 0, "PeriphGetInfo");
+    CHECK(be32(G_PERIPH + 12) == (CELL_PAD_STATUS_CONNECTED | CELL_PAD_STATUS_ASSIGN_CHANGES),
+          "periph port 0 after unplug: %u", be32(G_PERIPH + 12));
+    CHECK(be32(G_PERIPH + 16) == CELL_PAD_STATUS_CONNECTED, "periph port 1: %u", be32(G_PERIPH + 16));
+    d = get_data(0);
+    CHECK(d.len == CELL_PAD_LEN_CHANGE_SENSOR_ON && d.b[2] == 0 && d.b[3] == 0, "virtual pad: len %d buttons %X %X",
+          d.len, d.b[2], d.b[3]);
+    CHECK(d.b[4] == 128 && d.b[5] == 128 && d.b[6] == 128 && d.b[7] == 128, "virtual pad sticks centred");
+    CHECK(d.b[20] == 512 && d.b[21] == 399 && d.b[22] == 512 && d.b[23] == 512, "virtual pad sensors neutral again");
+    d = get_data(1);
+    CHECK(d.len == CELL_PAD_LEN_CHANGE_SENSOR_ON && d.b[3] == 0x50, "DS3 unaffected: len %d %X", d.len, d.b[3]);
+
+    /* ---- it comes back: lowest free port, and one ASSIGN_CHANGES --------- */
+    int ds5b = padhost_virtual_attach(&padhost_drv_dualsense, PADHOST_BUS_USB, 0x054C, 0x0CE6, "", 64, 48);
+    CHECK(padhost_virtual_port(ds5b) == 0, "DualSense back on port %d", padhost_virtual_port(ds5b));
+    next_report();
+    info2();
+    CHECK(info2_status(0) == (CELL_PAD_STATUS_CONNECTED | CELL_PAD_STATUS_ASSIGN_CHANGES), "port 0 %u", info2_status(0));
+
+    /* ---- cellPadEnd stops the motors, keeps the manager ------------------- */
+    vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_SMALL] = 1;
+    vm_base[G_ACT + CELL_PAD_ACTUATOR_PARAM_LARGE] = 255;
+    cellPadSetActDirect(1, (CellPadActParam*)(uintptr_t)G_ACT);
+    Sleep(40);
+    last_out(ds3, out, &count);
+    CHECK(out[3] == 1 && out[5] == 255, "DS3 rumbling %u %u", out[3], out[5]);
+    CHECK(cellPadEnd() == 0, "cellPadEnd");
+    Sleep(60);
+    last_out(ds3, out, &count);
+    CHECK(out[3] == 0 && out[5] == 0, "cellPadEnd: DS3 motors off %u %u", out[3], out[5]);
+    CHECK(cellPadGetData(0, (CellPadData*)(uintptr_t)G_DATA) == CELL_PAD_ERROR_NOT_OPENED, "closed");
+    CHECK(cellPadInit(2) == 0, "cellPadInit again");
+    next_report();
+    info2();
+    CHECK(be32(G_INFO2 + 4) == 2 && info2_status(1) == (CELL_PAD_STATUS_CONNECTED | CELL_PAD_STATUS_ASSIGN_CHANGES),
+          "controllers kept across End/Init, reported once more after the new Init: %u", info2_status(1));
+    info2();
+    CHECK(info2_status(1) == CELL_PAD_STATUS_CONNECTED, "then plain CONNECTED: %u", info2_status(1));
+
+    /* v1 GetInfo never reports ASSIGN_CHANGES (CellPadInfo.status is 0/1), but consumes it */
+    {
+        int id = padhost_virtual_attach(&padhost_drv_dualsense, PADHOST_BUS_USB, 0x054C, 0x0CE6, "V1", 64, 48);
+        int p = padhost_virtual_port(id);
+        CHECK(p == 2, "third pad on port %d", p);
+        cellPadEnd();
+        CHECK(cellPadInit(3) == 0, "cellPadInit(3)");
+        next_report();
+        memset(vm_base + G_INFO1, 0xEE, 0x210);
+        CHECK(cellPadGetInfo((CellPadInfo2*)(uintptr_t)G_INFO1) == 0, "GetInfo");
+        CHECK(vm_base[G_INFO1 + 0x208] == 1 && vm_base[G_INFO1 + 0x209] == 1 && vm_base[G_INFO1 + 0x20A] == 1,
+              "v1 status after Init with pads: %u %u %u (never 3)", vm_base[G_INFO1 + 0x208], vm_base[G_INFO1 + 0x209],
+              vm_base[G_INFO1 + 0x20A]);
+        info2();
+        CHECK(info2_status(2) == CELL_PAD_STATUS_CONNECTED, "consumed by GetInfo: %u", info2_status(2));
+
+        /* unplug + replug with no cellPad call in between still reports ASSIGN_CHANGES */
+        padhost_virtual_detach(id);
+        id = padhost_virtual_attach(&padhost_drv_dualsense, PADHOST_BUS_USB, 0x054C, 0x0CE6, "V2", 64, 48);
+        CHECK(padhost_virtual_port(id) == 2, "replugged on port %d", padhost_virtual_port(id));
+        next_report();
+        info2();
+        CHECK(info2_status(2) == (CELL_PAD_STATUS_CONNECTED | CELL_PAD_STATUS_ASSIGN_CHANGES),
+              "replug between polls reported: %u", info2_status(2));
+        info2();
+        CHECK(info2_status(2) == CELL_PAD_STATUS_CONNECTED, "once: %u", info2_status(2));
+        padhost_virtual_detach(id);
+    }
+
+    /* ---- shutdown: close() runs (DualSense releases its LEDs) ------------ */
+    padhost_shutdown();
+    {
+        PadHostPortState st;
+        CHECK(!padhost_get(0, &st) && !padhost_get(1, &st), "no ports after shutdown");
+    }
+
+    /* ---- the log --------------------------------------------------------- */
+    fflush(stdout);
+    freopen("CONOUT$", "w", stdout);
+    FILE* f = fopen(outpath, "rb");
+    static char logbuf[1 << 20];
+    size_t ln = f ? fread(logbuf, 1, sizeof logbuf - 1, f) : 0;
+    if (f) fclose(f);
+    logbuf[ln] = 0;
+    fputs(logbuf, stderr);
+    CHECK(strstr(logbuf, "[padhost] controllers (startup)") != NULL, "startup device list printed");
+    CHECK(strstr(logbuf, "[padhost] controllers (hotplug)") != NULL, "hotplug device list printed");
+    CHECK(strstr(logbuf, "unknown controller setting \"bogus_setting\"") != NULL, "bad [controller] line reported");
+    CHECK(strstr(logbuf, "unknown name") == NULL, "the keyboard parser skipped the [controller] section");
+    CHECK(strstr(logbuf, "keyboard/mouse input off (PAD_NO_KEYBOARD)") != NULL, "PAD_NO_KEYBOARD honoured");
+    CHECK(strstr(logbuf, "[padhost] Controller: none on player 1 (port 0)") != NULL, "startup list: no controller");
+    CHECK(strstr(logbuf, "[padhost] Controller: DualSense (USB) on player 1") != NULL, "hotplug list: player 1");
+    CHECK(strstr(logbuf, "[ss-ui] notice (5000 ms): Controller: DualSense (USB) on player 1") != NULL, "notice logged");
+
+    fprintf(stderr, "\ntest_cellpad_host: %d checks, %d failed\n", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/input/tests/test_input_ini.c b/libs/input/tests/test_input_ini.c
new file mode 100644
index 0000000..fb5e9bb
--- /dev/null
+++ b/libs/input/tests/test_input_ini.c
@@ -0,0 +1,144 @@
+/*
+ * config/input.ini (patched) through all three of its readers, the way
+ * cellPad.c's kbm_read_file feeds it: pad_kbm.h's kbm_parse_text
+ * (keyboard/mouse), pad_host.h's padhost_config_parse_text (controllers) and
+ * pad_hotkeys.h's hk_parse_text (window hotkeys, [hotkeys]). Once as shipped
+ * (every setting commented out) and once with every documented
+ * "# name = value" line of every section uncommented: every reader must
+ * accept all of it, and each must leave the others' lines alone. Then the
+ * uncommented controller values must read back through padhost_config_get as
+ * documented, and the uncommented [hotkeys] lines must give exactly the
+ * built-in hotkey defaults (the file documents them).
+ *
+ *   test_input_ini <path to input.ini>
+ *
+ * Build (Windows, from external/ps3recomp):
+ *   clang-cl /std:c17 /O2 /MD -D_CRT_SECURE_NO_WARNINGS -I include -I libs/input
+ *            libs/input/tests/test_input_ini.c libs/input/pad_host_win.c /Fe:test_input_ini.exe
+ *   test_input_ini.exe ../../config/input.ini
+ */
+#include "pad_kbm.h"
+#include "pad_hotkeys.h"
+#include "pad_host.h"
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int g_fail, g_checks, g_warn;
+#define CHECK(c, ...) do { g_checks++; if (!(c)) { g_fail++; printf("FAIL line %d: ", __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static void kwarn(const void* ctx, const char* msg) { g_warn++; printf("  kbm warning (%s): %s\n", (const char*)ctx, msg); }
+static void hwarn(const char* msg) { g_warn++; printf("  padhost warning: %s\n", msg); }
+
+/* "# name = value ..." -> "name = value ..." for every documented setting line. */
+static void uncomment(const char* in, char* out, size_t cap)
+{
+    size_t o = 0;
+    const char* p = in;
+    while (*p && o + 1 < cap) {
+        const char* e = strchr(p, '\n');
+        size_t n = e ? (size_t)(e - p + 1) : strlen(p);
+        const char* s = p;
+        if (s[0] == '#' && s[1] == ' ' && isalpha((unsigned char)s[2])) {
+            const char* q = s + 2;
+            while (*q && *q != '\n' && *q != '=' && *q != '#' && *q != '(' && *q != ',') q++;
+            int setting = *q == '=';
+            for (const char* r = s + 2; setting && r < q; r++)      /* a name: no spaces inside */
+                if (*r == ' ' && r[1] != ' ' && r[1] != '=') setting = 0;
+            if (setting) { s += 2; n -= 2; }
+        }
+        if (o + n >= cap) break;
+        memcpy(out + o, s, n);
+        o += n;
+        p += (s - p) + n;
+    }
+    out[o] = 0;
+}
+
+static HkConfig g_hk;
+
+static int run(const char* text, const char* what)
+{
+    KbmConfig c;
+    kbm_config_defaults(&c);
+    hk_config_defaults(&g_hk);
+    g_warn = 0;
+    int kbad = kbm_parse_text(&c, text, 0, kwarn, what);
+    int hbad = padhost_config_parse_text(text, 0, hwarn);
+    int xbad = hk_parse_text(&g_hk, text, 0, kwarn, what);
+    printf("%s: keyboard parser %d bad line(s), controller parser %d bad line(s), hotkey parser %d bad line(s),"
+           " %d warning(s)\n", what, kbad, hbad, xbad, g_warn);
+    return kbad + hbad + xbad + g_warn;
+}
+
+/* g_hk == the built-in hotkey defaults, combination by combination. */
+static int hk_is_default(void)
+{
+    HkConfig d;
+    hk_config_defaults(&d);
+    int same = 1;
+    for (int a = HK_NONE + 1; a < HK_COUNT; a++) {
+        if (g_hk.n[a] != d.n[a]) same = 0;
+        for (int i = 0; i < g_hk.n[a] && i < d.n[a]; i++)
+            if (g_hk.c[a][i].vk != d.c[a][i].vk || g_hk.c[a][i].mods != d.c[a][i].mods) same = 0;
+        if (!same) {
+            char nm[24], t1[40], t2[40];
+            printf("  hotkey %s: file %s, default %s\n", hk_action_name(a, nm, sizeof nm),
+                   hk_action_text(&g_hk, a, t1, sizeof t1), hk_action_text(&d, a, t2, sizeof t2));
+            return 0;
+        }
+    }
+    return 1;
+}
+
+int main(int argc, char** argv)
+{
+    if (argc < 2) { printf("usage: test_input_ini <input.ini>\n"); return 2; }
+    FILE* f = fopen(argv[1], "rb");
+    if (!f) { printf("cannot open %s\n", argv[1]); return 2; }
+    static char raw[65536], text[65536];
+    size_t n = fread(raw, 1, sizeof raw - 1, f);
+    fclose(f);
+    const char* t = kbm_text_prepare(raw, n);
+
+    CHECK(run(t, "as shipped") == 0, "the shipped file parses cleanly");
+    CHECK(padhost_config_get("switch_layout") == NULL, "nothing set while commented out");
+    CHECK(hk_is_default(), "no hotkey set while commented out");
+
+    uncomment(t, text, sizeof text);
+    CHECK(strstr(text, "\nquick_save") != NULL, "the [hotkeys] lines were uncommented");
+    CHECK(run(text, "everything uncommented") == 0, "every documented line is accepted by its reader");
+    CHECK(hk_is_default(), "the documented [hotkeys] lines are the built-in defaults");
+
+    const char* v;
+    v = padhost_config_get("switch_layout");       CHECK(v && !strcmp(v, "position"), "switch_layout = %s", v ? v : "(null)");
+    v = padhost_config_get("switch_home_led");     CHECK(v && !strcmp(v, "40"), "switch_home_led = %s", v ? v : "(null)");
+    v = padhost_config_get("dualsense_lightbar");  CHECK(v && !strcmp(v, "port"), "dualsense_lightbar = %s", v ? v : "(null)");
+    v = padhost_config_get("ds4_touchpad");        CHECK(v && !strcmp(v, "select"), "ds4_touchpad = %s", v ? v : "(null)");
+    v = padhost_config_get("dualsense_vibration"); CHECK(v && !strcmp(v, "auto"), "dualsense_vibration = %s", v ? v : "(null)");
+    v = padhost_config_get("map.0079:0006");
+    CHECK(v && !strcmp(v, "Triangle=b1 Circle=b2 Cross=b3 Square=b4 RX=a3 RY=a2"), "map.0079:0006 = %s", v ? v : "(null)");
+    v = padhost_config_get("map.0810:0001");       CHECK(v && !strcmp(v, "ignore"), "map.0810:0001 = %s", v ? v : "(null)");
+    v = padhost_config_get("deadzone");            CHECK(v && !strcmp(v, "auto"), "deadzone = %s", v ? v : "(null)");
+    v = padhost_config_get("deadzone_right");      CHECK(v && !strcmp(v, "auto"), "deadzone_right = %s", v ? v : "(null)");
+    v = padhost_config_get("readonly");            CHECK(v && !strcmp(v, "0"), "readonly = %s", v ? v : "(null)");
+    v = padhost_config_get("rumble");              CHECK(v && !strcmp(v, "100"), "rumble = %s", v ? v : "(null)");
+    v = padhost_config_get("backends");            CHECK(v && !strcmp(v, "all"), "backends = %s", v ? v : "(null)");
+    v = padhost_config_get("motion");              CHECK(v && !strcmp(v, "1"), "motion = %s", v ? v : "(null)");
+    v = padhost_config_get("prefer_physical");     CHECK(v && !strcmp(v, "1"), "prefer_physical = %s", v ? v : "(null)");
+    {
+        /* the documented [options] arbitration lines are the keyboard parser's defaults */
+        KbmConfig d, c;
+        kbm_config_defaults(&d);
+        kbm_config_defaults(&c);
+        c.last_device_wins = -1; c.mouse_takeover = -1.0f;
+        kbm_parse_text(&c, text, 0, kwarn, "uncommented");
+        CHECK(c.last_device_wins == d.last_device_wins && c.mouse_takeover == d.mouse_takeover,
+              "last_device_wins %d mouse_takeover %.1f", c.last_device_wins, c.mouse_takeover);
+    }
+
+    printf("%d checks, %d failed\n", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/input/tests/test_pad_hid_generic.c b/libs/input/tests/test_pad_hid_generic.c
new file mode 100644
index 0000000..f6a4815
--- /dev/null
+++ b/libs/input/tests/test_pad_hid_generic.c
@@ -0,0 +1,827 @@
+/*
+ * ps3recomp - tests for the generic HID gamepad driver (pad_hid_generic.c)
+ *
+ * Windows only (the driver is). From external/ps3recomp:
+ *   clang-cl /nologo /std:c17 -D_CRT_SECURE_NO_WARNINGS -I include -I libs\input
+ *            libs\input\tests\test_pad_hid_generic.c /Fe:test_pad_hid_generic.exe && test_pad_hid_generic.exe
+ *
+ * The driver source is included directly and its HidP layer (GenHidOps) is
+ * swapped for a fake caps table, so classification, the default layout,
+ * normalisation, report-ID routing and the map.VID:PID lines are tested
+ * without a device; padhost_config_get / padhost_logf are stand-ins with the
+ * pad host's documented behaviour. Covers: DS4-style and Xbox-DirectInput-
+ * style layouts, signed / unsigned / broken / null-state axes, 8-, 4- and
+ * 9-value hats, buttons and axes in different reports, HID d-pad and home
+ * usages, a second X/Y pair, simulation pedals, the mapping-line syntax and
+ * its errors, the logged mapping parsing back to itself, match() (XInput
+ * paths, Xbox pads, non-gamepads, "ignore", Multi-axis only when mapped) and
+ * open(); on Joystick-class devices, axes that rest at one end (wheel pedals,
+ * a throttle) holding nothing down, and no Slider on a stick.
+ */
+#if defined(_WIN32)
+
+#include "../pad_hid_generic.c"
+
+#include <stdarg.h>
+#include <stdio.h>
+
+static int g_fail = 0, g_checks = 0;
+
+#define CHECK(cond)                                                            \
+    do { g_checks++;                                                           \
+         if (!(cond)) { printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #cond); \
+                        g_fail++; } } while (0)
+
+#define CHECK_EQ(got, want)                                                    \
+    do { long _g = (long)(got), _w = (long)(want); g_checks++;                 \
+         if (_g != _w) { printf("FAIL %s:%d  %s = %ld, want %ld\n",            \
+                                __FILE__, __LINE__, #got, _g, _w);             \
+                         g_fail++; } } while (0)
+
+#define CHECK_STR(got, want)                                                   \
+    do { g_checks++;                                                           \
+         if (strcmp((got), (want))) { printf("FAIL %s:%d\n   got  \"%s\"\n   want \"%s\"\n", \
+                                             __FILE__, __LINE__, (got), (want)); \
+                                      g_fail++; } } while (0)
+
+/* ---- the pad host's side ------------------------------------------------- */
+
+/* padhost_config_get: keys compared ignoring case, spaces, '_', '-', '.',
+ * with an optional controller(s)/gamepad(s) prefix, as pad_host_win.c does. */
+static struct { char key[64]; char val[256]; } g_cfg[16];
+static int g_ncfg;
+
+static void host_key(const char* in, char* out, size_t n)
+{
+    char k[96];
+    size_t o = 0;
+    for (; *in && o + 1 < sizeof k; in++) {
+        char c = *in;
+        if (c == ' ' || c == '\t' || c == '_' || c == '-' || c == '.') continue;
+        k[o++] = (char)tolower((unsigned char)c);
+    }
+    k[o] = 0;
+    static const char* pre[] = { "controllers", "controller", "gamepads", "gamepad" };
+    for (int i = 0; i < 4; i++) {
+        size_t l = strlen(pre[i]);
+        if (!strncmp(k, pre[i], l) && k[l]) { snprintf(out, n, "%s", k + l); return; }
+    }
+    snprintf(out, n, "%s", k);
+}
+
+static void cfg_set(const char* key, const char* val)
+{
+    snprintf(g_cfg[g_ncfg].key, sizeof g_cfg[g_ncfg].key, "%s", key);
+    host_key(key, g_cfg[g_ncfg].key, sizeof g_cfg[g_ncfg].key);
+    snprintf(g_cfg[g_ncfg].val, sizeof g_cfg[g_ncfg].val, "%s", val);
+    g_ncfg++;
+}
+
+static void cfg_clear(void) { g_ncfg = 0; }
+
+const char* padhost_config_get(const char* key)
+{
+    char k[64];
+    host_key(key, k, sizeof k);
+    for (int i = g_ncfg - 1; i >= 0; i--)
+        if (!strcmp(g_cfg[i].key, k)) return g_cfg[i].val;
+    return NULL;
+}
+
+static char g_last_log[1024];
+void padhost_logf(const char* fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(g_last_log, sizeof g_last_log, fmt, ap);
+    va_end(ap);
+    printf("[padhost] %s\n", g_last_log);
+}
+
+/* ---- fake HidP layer ----------------------------------------------------- */
+
+static GenDesc g_desc;
+static u32     g_raw[GEN_MAX_VALUES];
+static u16     g_down[3][64];           /* per page: button, GD, consumer */
+static int     g_ndown[3];
+static int     g_describe_rc;
+
+static int page_slot(u16 page) { return page == GEN_PAGE_BUTTON ? 0 : page == GEN_PAGE_GD ? 1 : 2; }
+
+static int desc_has_ids(void)
+{
+    for (int i = 0; i < g_desc.nvalues; i++) if (g_desc.values[i].report_id) return 1;
+    for (int i = 0; i < g_desc.nbr; i++) if (g_desc.br[i].report_id) return 1;
+    return 0;
+}
+
+static int fake_describe(PadHostDevice* d, GenDesc* g, char* name, int cap)
+{
+    (void)d;
+    *g = g_desc;
+    snprintf(name, (size_t)cap, "Fake Pad");
+    return g_describe_rc;
+}
+
+static int fake_get_value(PadHostDevice* d, const GenValue* v, const unsigned char* rep, int len, u32* raw)
+{
+    (void)d; (void)len;
+    for (int i = 0; i < g_desc.nvalues; i++) {
+        const GenValue* f = &g_desc.values[i];
+        if (f->page != v->page || f->usage != v->usage || f->link != v->link || f->report_id != v->report_id) continue;
+        if (desc_has_ids() && rep[0] != f->report_id) return 1;
+        *raw = g_raw[i];
+        return 0;
+    }
+    return -1;
+}
+
+static int fake_get_usages(PadHostDevice* d, u16 page, const unsigned char* rep, int len, u16* usages, int cap)
+{
+    (void)d; (void)len;
+    int found = 0;
+    for (int i = 0; i < g_desc.nbr; i++)
+        if (g_desc.br[i].page == page && (!desc_has_ids() || g_desc.br[i].report_id == rep[0])) found = 1;
+    if (!found) return -1;
+    int s = page_slot(page), k = 0;
+    for (int i = 0; i < g_ndown[s] && k < cap; i++) usages[k++] = g_down[s][i];
+    return k;
+}
+
+static const GenHidOps fake_ops = { fake_describe, fake_get_value, fake_get_usages };
+
+static void desc_reset(void)
+{
+    memset(&g_desc, 0, sizeof g_desc);
+    memset(g_raw, 0, sizeof g_raw);
+    memset(g_ndown, 0, sizeof g_ndown);
+    g_describe_rc = 0;
+}
+
+static int add_value(u16 page, u16 usage, u8 rid, u8 bits, s32 lmin, s32 lmax, int has_null, u16 link)
+{
+    GenValue* v = &g_desc.values[g_desc.nvalues];
+    v->page = page; v->usage = usage; v->report_id = rid; v->bits = bits;
+    v->lmin = lmin; v->lmax = lmax; v->has_null = (u8)has_null; v->link = link;
+    return g_desc.nvalues++;
+}
+
+static void add_buttons(u16 page, u16 umin, u16 umax, u8 rid)
+{
+    GenBtnRange* r = &g_desc.br[g_desc.nbr++];
+    r->page = page; r->umin = umin; r->umax = umax; r->report_id = rid;
+}
+
+static void set_raw(u16 page, u16 usage, u32 raw)
+{
+    for (int i = 0; i < g_desc.nvalues; i++)
+        if (g_desc.values[i].page == page && g_desc.values[i].usage == usage) { g_raw[i] = raw; return; }
+}
+
+static void press(u16 page, const u16* list, int n)
+{
+    int s = page_slot(page);
+    g_ndown[s] = n;
+    for (int i = 0; i < n; i++) g_down[s][i] = list[i];
+}
+
+static void dev_init(PadHostDevice* d, u16 vid, u16 pid)
+{
+    memset(d, 0, sizeof *d);
+    d->vid = vid; d->pid = pid;
+    d->usage_page = 1; d->usage = 5;
+    d->in_len = 16;
+    d->bus = PADHOST_BUS_USB;
+    d->path = "\\\\?\\hid#vid_0001&pid_0002#7&123&0&0000#{4d1e55b2-f16f-11cf-88cb-001111000030}";
+    d->port = -1;
+}
+
+static int parse_id(PadHostDevice* d, u8 rid, PadHostPortState* st)
+{
+    u8 rep[16];
+    memset(rep, 0, sizeof rep);
+    rep[0] = rid;
+    return padhost_drv_generic.parse(d, rep, 4, st);   /* short: padded to in_len */
+}
+
+static void map_of(PadHostDevice* d, char* out, size_t n) { gen_map_str(&gen_priv(d)->map, out, n); }
+
