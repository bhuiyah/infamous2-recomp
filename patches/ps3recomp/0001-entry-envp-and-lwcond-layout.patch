+static uint32_t pput_rd32(uint32_t a)
+{
+    const uint8_t* p = vm_base + a;
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+
+/* The ELFv1 back chain from the context's r1, with the census's bounds
+ * (ss_core.c walk_chain): the slot's stack range, or for main -- which has
+ * none recorded -- the megabyte above r1. Reads guest memory only. */
+static void pput_walk(struct pput_scr* s, const ppu_thread_info* t)
+{
+    const uint32_t lo = (uint32_t)s->ctx->gpr[1];
+    uint32_t hi;
+    if (t->stack_size && lo >= t->stack_addr && lo < t->stack_addr + t->stack_size)
+        hi = t->stack_addr + t->stack_size;
+    else {
+        hi = lo + 0x100000u;
+        if (lo < 0x10000000u && hi > 0x10000000u) hi = 0x10000000u;
+    }
+    s->p.frames = 0;
+    s->p.chain_end = PPUT_END_DEPTH;
+    if (!VM_READY) { s->p.chain_end = PPUT_END_NO_VM; return; }
+    uint32_t sp = lo;
+    for (int d = 0; d < PPUT_CHAIN_MAX; d++) {
+        if (!sp || (sp & 7u) || sp + 8u > hi) { s->p.chain_end = PPUT_END_RANGE; return; }
+        const uint32_t bhi = pput_rd32(sp), back = pput_rd32(sp + 4);
+        if (!back && !bhi) { s->p.chain_end = PPUT_END_ROOT; return; }
+        if (bhi || back <= sp || back + 0x18u > hi || back - sp > 0x100000u) {
+            s->p.chain_end = PPUT_END_BAD_BACK;
+            return;
+        }
+        s->sp[s->p.frames] = sp;
+        s->ra[s->p.frames] = pput_rd32(back + 0x14);   /* the callee's saved LR, low word */
+        s->p.frames++;
+        sp = back;
+    }
