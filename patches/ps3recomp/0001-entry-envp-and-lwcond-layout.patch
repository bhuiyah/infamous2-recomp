+    /* Test 18: the shape of inFamous 2's G-buffer character materials
+     * (fp_pack_programs.h fpt_gbuffer; Cole's head program 6004A381 has the
+     * same sequence). The albedo leaves through PKG R0.x, H4 (linear -> sRGB,
+     * 4 x unorm8) ; UPB H0.xyz, R0, and the texel is linearised through
+     * PKB R0.x, H2 ; UPG R3.xyz, R0. All four were "unhandled FP opcode ?":
+     * h0 kept the mask texel TEX H0.y had put there => green heads. The
+     * normal map is a TEX_bx2. */
+    {
+        u8 p[FPT_GBUFFER_BYTES];
+        const u32 sz = fpt_gbuffer(p);
+        u32 k[8][4]; u32 slot[8]; u32 size = 0, tm = 0; u64 h = 0;
+        const int n = rsx_fp_scan_program_slots(p, sz, 0, k, 8, &size, &h, &tm, slot);
+        check_true("gbuf_scan", sz == FPT_GBUFFER_BYTES && n == 1 && size == sz && h != 0);
+        check_true("gbuf_scan_slot", slot[0] == 0x40u);
+        check_true("gbuf_texmask_units_0_1_7", tm == 0x83u);
+
+        /* The constant slots located the way RPCS3's
+         * fragment_program_utils::analyse_fragment_program walks: raw
+         * little-endian words, is_any_src_constant = (word & 0x300) == 0x200
+         * on any source word, END = word0 bit 8 -- branches included, as in
+         * rsx_fp_scan_program_slots. */
+        u32 ref_slot[8]; int nref = 0;
+        for (u32 off = 0; off + 16 <= sz; off += 16) {
+            u32 w[4];
+            for (int i = 0; i < 4; i++)
+                w[i] = (u32)p[off + 4*i] | ((u32)p[off + 4*i + 1] << 8) |
+                       ((u32)p[off + 4*i + 2] << 16) | ((u32)p[off + 4*i + 3] << 24);
+            const int end = (w[0] >> 8) & 1u;
+            if ((w[1] & 0x300u) == 0x200u || (w[2] & 0x300u) == 0x200u || (w[3] & 0x300u) == 0x200u) {
+                if (nref < 8) ref_slot[nref] = off + 16;
+                nref++;
+                off += 16;
+            }
+            if (end) break;
+        }
+        check_true("gbuf_slots_match_rpcs3_walk", nref == n && ref_slot[0] == slot[0]);
+
+        u32 nk = 0;
+        rsx_fp_set_min_targets(4);
+        const int ni = rsx_fp_decompile_buffered_ex(p, sz, CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+        rsx_fp_set_min_targets(1);
+        check_true("gbuf_decompiles", ni == 8 && nk == 1);
+        check_absent("gbuf_all_handled", hlsl, "unhandled FP opcode");
+        check("gbuf_pkb", hlsl, "{ float4 _v = (float4)(rsx_pkb((h[2]).xyzx)); r[0].x = _v.x; }");
+        check("gbuf_upg", hlsl, "{ float4 _v = (float4)(rsx_upg(((r[0]).xyzw).x)); r[3].xyz = _v.xyz; }");
+        check("gbuf_pkg", hlsl, "{ float4 _v = (float4)(rsx_pkg((h[4]).xyzx)); r[0].x = _v.x; }");
+        /* H registers store fp16 (FP_HROUND, NV_fragment_program 3.11.4.1) */
+        check("gbuf_bx2", hlsl, "{ float4 _v = (float4)(rsx_texproc_bx2(rsx_tex[1].Sample(rsx_samp[1], "
+                                "((input.tc0).xyzw).xy), 1u)); h[6].yw = rsx_h16(_v).yw; }");
+        check("gbuf_mask_plain", hlsl, "rsx_texproc(rsx_tex[7].Sample(rsx_samp[7], ((input.tc0).xyzw).xy), 7u)");
+        static const char albedo[] = "{ float4 _v = (float4)(rsx_upb(((r[0]).xyzw).x)); h[0].xyz = rsx_h16(_v).xyz; }";
+        const char* mask_tex = strstr(hlsl, "rsx_tex[7].Sample");
+        const char* final_albedo = strstr(hlsl, albedo);
+        check("gbuf_albedo_unpacked", hlsl, albedo);
+        check_true("gbuf_albedo_after_mask_texel", mask_tex && final_albedo && final_albedo > mask_tex);
+        check("gbuf_export_h0", hlsl, "    float4 _o0 = h[0];\n");
+        check("gbuf_export_h6", hlsl, "    float4 _o2 = h[6];\n");
+        check("gbuf_decl_pkg", hlsl, "float rsx_pkg(float4 v) { return rsx_pkb(rsx_l2s(v)); }\n");
+        check("gbuf_decl_upg", hlsl, "float4 rsx_upg(float v) { return rsx_s2l(rsx_upb(v)); }\n");
+        check("gbuf_decl_bx2", hlsl, "float4 rsx_texproc_bx2(float4 c, uint u) {\n");
+        const char* l2s = strstr(hlsl, "float4 rsx_l2s(");
+        const char* s2l = strstr(hlsl, "float4 rsx_s2l(");
+        const char* pkb = strstr(hlsl, "float rsx_pkb(");
+        const char* upb = strstr(hlsl, "float4 rsx_upb(");
+        const char* pkg = strstr(hlsl, "float rsx_pkg(");
+        const char* upg = strstr(hlsl, "float4 rsx_upg(");
+        check_true("gbuf_decl_order", l2s && s2l && pkb && upb && pkg && upg &&
+                                      l2s < pkg && pkb < pkg && s2l < upg && upb < upg);
+        check_absent("gbuf_only_used_helpers", hlsl, "rsx_pk2(");
+        check_absent("gbuf_only_used_helpers2", hlsl, "rsx_up16(");
+        check_true("gbuf_decl_before_main", pkg && pkg < strstr(hlsl, "PSOutput main("));
+        /* The alpha-test patch anchors on the LAST "    return ": still main's. */
+        const char* last_ret = NULL;
+        for (const char* q = strstr(hlsl, "    return "); q; q = strstr(q + 1, "    return "))
+            last_ret = q;
+        check_true("gbuf_last_return_is_mains", last_ret && strncmp(last_ret, "    return _out;", 16) == 0);
+    }
