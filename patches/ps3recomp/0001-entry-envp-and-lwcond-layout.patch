+/* ---------------------------------------------------------------------------
+ * Save states: the PAD_ section (runtime/savestate/ss_state.h, engine design
+ * 6.2) -- the guest state of cellPad, cellKb and cellMouse
+ *
+ * Registered here, not in cellPad.c: cellPad.c and cellMouse.c only describe
+ * their parts (a field list, a record iterator) and call nothing of the
+ * save-state engine, so they still build without it (cellPad's host test);
+ * this file has no test of its own. Captured with every guest thread parked;
+ * none of these tables has a lock. Records, in order:
+ *   pad        cellPad: initialised, max_connect, the port settings (press /
+ *              sensor modes), the title's last motor request per port
+ *   kb         initialised, max_connect
+ *   keyboards  per port (keyed by it): read mode, code type, modifier and
+ *              LED state, the keys held and the packets not yet read
+ *   mouse      initialised, max_connect
+ *   mice       per port: mode, buttons, the motion not yet read, the ring
+ * No strict-save blocker: none of the three libraries has anything in flight.
+ * A load (M4c): check_image refuses, before anything stops, a port count or
+ * a record no port has; teardown leaves the three libraries at their boot
+ * state; restore writes the lists back (ss_read_fields: the statics as they
+ * were) and every port record, then lets cellPad start its reports over
+ * (cellPad_ss_restore_done: the latches, the motion, the motors). The host
+ * side -- the controllers, the keyboard/mouse table, the capture -- is kept;
+ * cellPad's backend is opened at the release if the loaded state needs it
+ * and this session never initialised the pad. Nothing here is host-only:
+ * every listed value comes back as it was, and the fidelity check compares
+ * all of it.
+ * -----------------------------------------------------------------------*/
+extern const ss_list cellPad_ss_list;                    /* cellPad.c */
+void cellPad_ss_teardown(void);
+int  cellPad_ss_restore_done(char* why, size_t n);
+void cellPad_ss_after_release(void);
+extern const ss_list cellMouse_ss_list, cellMouse_ss_mice_list;   /* cellMouse.c */
+int cellMouse_ss_mouse(uint32_t i, uint32_t* key, const void** rec);
+extern const uint32_t cellMouse_ss_mouse_size;
+void cellMouse_ss_teardown(void);
+int  cellMouse_ss_mouse_put(uint32_t i, uint32_t key, const void* rec, int apply, char* why, size_t n);
+int  cellMouse_ss_restore_done(char* why, size_t n);
+/* libs/system/cellSysmodule.c: a part's records through its put(), a field
+ * of a statics list as the image holds it (the load's shared helpers). */
+typedef int (*sysmod_ss_put_fn)(uint32_t i, uint32_t key, const void* rec, int apply, char* why, size_t n);
+int cellSysmodule_ss_recs_put(ss_reader* r, const ss_list* l, uint32_t size, sysmod_ss_put_fn put, int apply);
+int cellSysmodule_ss_peek(ss_reader* r, const ss_list* l, const char* field, void* out, uint32_t size);
+
+static const ss_field k_kb_ss_fields[] = {
+    SS_FIELD(s_kb_initialized), SS_FIELD(s_kb_max_connect),
+};
+static const ss_list k_kb_ss_list = SS_LIST("kb", k_kb_ss_fields);
+static const ss_field k_kb_ss_port_fields[] = {
+    SS_MEMBER(KbPortState, connected), SS_MEMBER(KbPortState, rmode),
+    SS_MEMBER(KbPortState, codetype), SS_MEMBER(KbPortState, mkey),
+    SS_MEMBER(KbPortState, led), SS_MEMBER(KbPortState, key_state),
+    SS_MEMBER(KbPortState, event_buf), SS_MEMBER(KbPortState, event_count),
+};
+static const ss_list k_kb_ss_port_list = SS_LIST("keyboards", k_kb_ss_port_fields);
+static const ss_list* const k_pad_ss_lists[] = {
+    &cellPad_ss_list, &k_kb_ss_list, &k_kb_ss_port_list, &cellMouse_ss_list,
+    &cellMouse_ss_mice_list, NULL
+};
+
+static int pad_ss_capture(ss_writer* w)
+{
+    ss_write_fields(w, &cellPad_ss_list);
+    ss_write_fields(w, &k_kb_ss_list);
+    ss_recs_begin(w, &k_kb_ss_port_list);
+    for (u32 i = 0; s_kb_initialized && i < CELL_KB_MAX_KEYBOARDS; i++)
+        ss_recs_add(w, i, &s_kb_ports[i]);
+    ss_recs_end(w);
+    ss_write_fields(w, &cellMouse_ss_list);
+    ss_recs_begin(w, &cellMouse_ss_mice_list);
+    uint32_t key;
+    const void* rec;
+    for (uint32_t i = 0;; i++) {
+        const int r = cellMouse_ss_mouse(i, &key, &rec);
+        if (r < 0) break;
+        if (r) ss_recs_add(w, key, rec);
+    }
+    ss_recs_end(w);
+    return ss_writer_error(w);
+}
+
+/* A "keyboards" record for port `key` (a zeroed KbPortState with the listed
+ * members, all of them): a port this library has, a read mode and code type
+ * cellKbSetReadMode / SetCodeType accept, a packet count within the buffer;
+ * with apply, stored. */
+static int kb_ss_port_put(uint32_t i, uint32_t key, const void* rec, int apply, char* why, size_t n)
+{
+    const KbPortState* k = (const KbPortState*)rec;
+    (void)i;
+    if (key >= CELL_KB_MAX_KEYBOARDS) {
+        snprintf(why, n, "no keyboard port %u (%d ports)", key, CELL_KB_MAX_KEYBOARDS);
+        return -1;
+    }
+    if ((k->rmode != CELL_KB_RMODE_INPUTCHAR && k->rmode != CELL_KB_RMODE_PACKET) ||
+        (k->codetype != CELL_KB_CODETYPE_RAW && k->codetype != CELL_KB_CODETYPE_ASCII)) {
+        snprintf(why, n, "rmode %u / codetype %u: not a mode cellKb accepts", k->rmode, k->codetype);
+        return -1;
+    }
+    if (k->event_count < 0 || k->event_count > CELL_KB_MAX_KEYCODES) {
+        snprintf(why, n, "event_count %d outside the buffer's 0..%d", k->event_count, CELL_KB_MAX_KEYCODES);
+        return -1;
+    }
+    if (apply) s_kb_ports[key] = *k;
+    return 0;
+}
+
+/* Before the stop, the world running: what restore() will need, read from
+ * the image only (the statics are the running game's). */
+static int pad_ss_check_image(ss_reader* r)
+{
+    uint32_t v = 0;
+    int e;
+    if ((e = cellSysmodule_ss_peek(r, &cellPad_ss_list, "s_max_connect", &v, 4)) != 0) return e;
+    if (v > CELL_PAD_MAX_PORT_NUM)
+        return ss_reader_fail(r, SS_E_CORRUPT, "pad.s_max_connect: %u above the %d ports", v, CELL_PAD_MAX_PORT_NUM);
+    if ((e = cellSysmodule_ss_peek(r, &k_kb_ss_list, "s_kb_max_connect", &v, 4)) != 0) return e;
+    if (v > CELL_KB_MAX_KEYBOARDS)
+        return ss_reader_fail(r, SS_E_CORRUPT, "kb.s_kb_max_connect: %u above the %d ports", v, CELL_KB_MAX_KEYBOARDS);
+    if ((e = cellSysmodule_ss_peek(r, &cellMouse_ss_list, "s_mouse_max_connect", &v, 4)) != 0) return e;
+    if (v > CELL_MOUSE_MAX_MICE)
+        return ss_reader_fail(r, SS_E_CORRUPT, "mouse.s_mouse_max_connect: %u above the %d ports", v,
+                              CELL_MOUSE_MAX_MICE);
+    if ((e = cellSysmodule_ss_recs_put(r, &k_kb_ss_port_list, (uint32_t)sizeof(KbPortState), kb_ss_port_put, 0)))
+        return e;
+    return cellSysmodule_ss_recs_put(r, &cellMouse_ss_mice_list, cellMouse_ss_mouse_size, cellMouse_ss_mouse_put, 0);
+}
+
+/* Every guest thread gone: the three libraries at their boot state. */
+static void pad_ss_teardown(void)
+{
+    cellPad_ss_teardown();
+    s_kb_initialized = 0;
+    s_kb_max_connect = 0;
+    memset(s_kb_ports, 0, sizeof(s_kb_ports));
+    cellMouse_ss_teardown();
+}
+
+static int pad_ss_restore(ss_reader* r)
+{
+    int e = ss_read_fields(r, &cellPad_ss_list);
+    if (!e) e = ss_read_fields(r, &k_kb_ss_list);
+    if (!e) e = cellSysmodule_ss_recs_put(r, &k_kb_ss_port_list, (uint32_t)sizeof(KbPortState), kb_ss_port_put, 1);
+    if (!e) e = ss_read_fields(r, &cellMouse_ss_list);
+    if (!e) e = cellSysmodule_ss_recs_put(r, &cellMouse_ss_mice_list, cellMouse_ss_mouse_size,
+                                          cellMouse_ss_mouse_put, 1);
+    if (e) return e;
+    char why[160] = "";
+    if (s_kb_max_connect > CELL_KB_MAX_KEYBOARDS)
+        return ss_reader_fail(r, SS_E_CORRUPT, "kb.s_kb_max_connect: %u above the %d ports", s_kb_max_connect,
+                              CELL_KB_MAX_KEYBOARDS);
+    if (cellMouse_ss_restore_done(why, sizeof why) || cellPad_ss_restore_done(why, sizeof why))
+        return ss_reader_fail(r, SS_E_CORRUPT, "%s", why);
+    return SS_OK;
+}
+
+static const ss_section_ops k_pad_ss_ops = {
+    SS_FOURCC('P', 'A', 'D', '_'), 1, 0, SS_ORDER_PAD,
+    NULL, pad_ss_capture, pad_ss_teardown, pad_ss_restore, cellPad_ss_after_release,
+    "cellPad, cellKb, cellMouse", k_pad_ss_lists, NULL,
+    NULL, pad_ss_check_image,
+};
+SS_SECTION_REGISTER(k_pad_ss_ops)
