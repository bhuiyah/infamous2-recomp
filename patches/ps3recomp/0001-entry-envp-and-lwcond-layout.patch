+static void test_review_fixes(void)
+{
+    printf("-- review fixes\n");
+
+    /* XInput turned off at run time: a rumbling pad is stopped before its
+     * slot is released (nothing would stop it later). The manager is not
+     * told (no reconfig), so no real XInput thread starts. */
+    {
+        PFN_XGetState og = s_x.get;
+        PFN_XSetState os = s_x.set;
+        PFN_XGetBattery ob = s_x.batt;
+        PFN_XGetCapsEx oc = s_x.caps_ex;
+        LONG oe = s_cfg.enabled, obk = s_cfg.backends;
+        s_x.get = fx_get; s_x.set = fx_set; s_x.batt = NULL; s_x.caps_ex = NULL;
+        InterlockedExchange(&s_cfg.enabled, 1);
+        InterlockedExchange(&s_cfg.backends, 1L << PADHOST_KIND_XINPUT);
+        InterlockedExchange(&s_x.probe_now, 1);
+        ph_xinput_poll(GetTickCount64());
+        int xp = s_x.slot[0].port;
+        CHECK(s_x.slot[0].connected && xp == 0, "fake XInput pad on port %d", xp);
+        /* unplugged and plugged in again: the port is freed, and the pad gets it back
+         * (the freed port used to go straight back to the slot that was leaving) */
+        unsigned gen = padhost_generation();
+        s_fx_present = 0;
+        ph_xinput_poll(GetTickCount64());
+        PadHostPortState xs;
+        CHECK(!s_x.slot[0].connected && s_x.slot[0].port < 0 && !padhost_get(0, &xs) && ph_port_free(0),
+              "unplugged XInput pad: port 0 free (slot port %d, xslot %d)", s_x.slot[0].port, s_port[0].xslot);
+        CHECK(padhost_generation() != gen, "generation bumped");
+        s_fx_present = 1;
+        InterlockedExchange(&s_x.probe_now, 1);
+        ph_xinput_poll(GetTickCount64());
+        CHECK(s_x.slot[0].connected && s_x.slot[0].port == 0 && padhost_get(0, &xs) && xs.kind == PADHOST_KIND_XINPUT,
+              "plugged in again: port %d", s_x.slot[0].port);
+        padhost_set_actuator(xp, 1, 200);
+        ph_xinput_poll(GetTickCount64());
+        CHECK(s_fx_vib.wLeftMotorSpeed == 200 * 257 && s_fx_vib.wRightMotorSpeed == 0xFFFF, "rumbling (%u %u)",
+              s_fx_vib.wLeftMotorSpeed, s_fx_vib.wRightMotorSpeed);
+        int sets = s_fx_sets;
+        InterlockedExchange(&s_cfg.backends, 0);
+        ph_xinput_poll(GetTickCount64());
+        CHECK(!s_x.slot[0].connected && s_fx_sets == sets + 1 && !s_fx_vib.wLeftMotorSpeed && !s_fx_vib.wRightMotorSpeed,
