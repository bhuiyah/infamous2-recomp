+/* A DualShock 4 / DualSense in plain HID mode. */
+static void make_ds4(void)
+{
+    desc_reset();
+    add_value(GEN_PAGE_GD, 0x30, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x31, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x32, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x35, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x33, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x34, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x39, 0, 4, 0, 7, 1, 0);
+    add_buttons(GEN_PAGE_BUTTON, 1, 14, 0);
+}
+
+static void test_ds4_layout(void)
+{
+    PadHostDevice d;
+    PadHostPortState st;
+    make_ds4();
+    dev_init(&d, 0x054C, 0x05C4);
+    CHECK_EQ(padhost_drv_generic.open(&d), 0);
+    GenPriv* p = gen_priv(&d);
+    CHECK_EQ(p->nslots, 6);
+    CHECK_EQ(p->nhats, 1);
+    CHECK_EQ(p->nbuttons, 14);
+    CHECK_EQ(p->has_ids, 0);
+    char m[640];
+    map_of(&d, m, sizeof m);
+    CHECK_STR(m, "Cross=b2 Circle=b3 Square=b1 Triangle=b4 L1=b5 R1=b6 L2=a3/b7 R2=a4/b8 L3=b11 R3=b12 "
+                 "Start=b10 Select=b9 PS=b13 Dpad=h0 LX=a0 LY=a1 RX=a2 RY=a5");
+
+    /* before any report: at rest */
+    memset(&st, 0, sizeof st);
+    set_raw(GEN_PAGE_GD, 0x30, 128); set_raw(GEN_PAGE_GD, 0x31, 127);
+    set_raw(GEN_PAGE_GD, 0x32, 128); set_raw(GEN_PAGE_GD, 0x35, 128);
+    set_raw(GEN_PAGE_GD, 0x33, 0);   set_raw(GEN_PAGE_GD, 0x34, 0);
+    set_raw(GEN_PAGE_GD, 0x39, 8);              /* null: centred */
+    press(GEN_PAGE_BUTTON, NULL, 0);
+    CHECK_EQ(parse_id(&d, 0, &st), 1);
+    CHECK_EQ(st.connected, 1);
+    CHECK_EQ(st.kind, PADHOST_KIND_GENERIC);
+    CHECK_EQ(st.vid, 0x054C);
+    CHECK_EQ(st.buttons, 0);
+    CHECK_EQ(st.lx, 128); CHECK_EQ(st.ly, 128); CHECK_EQ(st.rx, 128); CHECK_EQ(st.ry, 128);
+    for (int i = 0; i < 12; i++) CHECK_EQ(st.press[i], 0);
+    CHECK_EQ(st.has_motion, 0); CHECK_EQ(st.has_pressure, 0);
+    CHECK_EQ(st.sensor_y, 399); CHECK_EQ(st.battery, 255);
+    CHECK_EQ(st.seq, 0);                        /* the pad host's to bump */
+
+    set_raw(GEN_PAGE_GD, 0x30, 0);   set_raw(GEN_PAGE_GD, 0x31, 255);
+    set_raw(GEN_PAGE_GD, 0x32, 255); set_raw(GEN_PAGE_GD, 0x35, 0);
+    set_raw(GEN_PAGE_GD, 0x33, 30);  set_raw(GEN_PAGE_GD, 0x34, 255);
+    set_raw(GEN_PAGE_GD, 0x39, 1);              /* up-right */
+    { u16 b[] = { 2, 13, 6 }; press(GEN_PAGE_BUTTON, b, 3); }
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 0); CHECK_EQ(st.ly, 255); CHECK_EQ(st.rx, 255); CHECK_EQ(st.ry, 0);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_R1 | CELL_PAD_CTRL_R2 |
+                         CELL_PAD_CTRL_UP | CELL_PAD_CTRL_RIGHT);
+    CHECK_EQ(st.ps, 1);
+    CHECK_EQ(st.press[10], 30);                 /* L2 below the threshold: value, no bit */
+    CHECK_EQ(st.press[11], 255);
+    CHECK_EQ(st.press[6], 255);                 /* cross */
+    CHECK_EQ(st.press[0], 255);                 /* right */
+    CHECK_EQ(st.press[2], 255);                 /* up */
+    CHECK_EQ(st.press[3], 0);
+
+    set_raw(GEN_PAGE_GD, 0x33, 41);             /* just past it */
+    set_raw(GEN_PAGE_GD, 0x39, 4);
+    press(GEN_PAGE_BUTTON, NULL, 0);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_L2 | CELL_PAD_CTRL_R2 | CELL_PAD_CTRL_DOWN);
+    CHECK_EQ(st.ps, 0);
+    set_raw(GEN_PAGE_GD, 0x39, 7);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.buttons & 0xF0, CELL_PAD_CTRL_UP | CELL_PAD_CTRL_LEFT);
+
+    /* intermediate stick values */
+    set_raw(GEN_PAGE_GD, 0x30, 64); set_raw(GEN_PAGE_GD, 0x31, 192);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 64); CHECK_EQ(st.ly, 192);
+    set_raw(GEN_PAGE_GD, 0x30, 126); set_raw(GEN_PAGE_GD, 0x31, 129);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 126); CHECK_EQ(st.ly, 129);   /* identity off-centre */
+    set_raw(GEN_PAGE_GD, 0x30, 127);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 128);                       /* 127 and 128 are both the centre */
+}
