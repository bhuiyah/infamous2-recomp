+                print("  SPU: %s; strict walks: %s" % (", ".join("%s %d" % kv for kv in ch["spu"].items()) or "none",
+                                                       ", ".join("%s %d" % kv for kv in ch["strict"].items()) or "none"))
+            for fn, fd in s.get("fields", {}).items():
+                if name in ("TIME", "MAPS", "GMEM") and not a.section:
+                    continue
+                items = list(fd.items())
+                shown = items if a.section == name else items[:12]
+                print("  %s: %s%s" % (fn, ", ".join("%s=%s" % (k, fmt_val(v)) for k, v in shown),
+                                      " ... (%d fields)" % len(items) if len(shown) < len(items) else ""))
+            for an, ad in s.get("arrays", {}).items():
+                if name in ("TIME", "MAPS") and not a.section:
+                    continue
+                print("  %s: %d record(s)%s" % (an, ad["count"], "".join(
+                    "; %s: %s" % (hk, ", ".join("%s %d" % kv for kv in hv.items())) for hk, hv in ad["histograms"].items())))
+            for arr in e.get("arrays_full", []):
+                for d in arr["records"][:a.records or len(arr["records"])]:
+                    print("    %s[%d] %s" % (arr["name"], d["_key"], ", ".join("%s=%s" % (k, fmt_val(v))
+                                                                          for k, v in d.items() if k != "_key")))
+            for tn, tx in e.get("texts", {}).items():
+                print("  --- %s (%d bytes) ---" % (tn, len(tx)))
+                print(tx.rstrip())
+        if status:
+            print("\nss_inspect: problems found (see crc / structure above)", file=sys.stderr)
+        return status
+
+
+if __name__ == "__main__":
