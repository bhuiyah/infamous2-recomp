+/* Does any 4-byte word at offsets 0, 4, 8, ... (o + 4 <= size) hold the bytes
+ * C7 08 C7 08 (0xC708C708 big-endian)? The POISON-DMA detector's scan. */
+static inline int mfc_scan_poison(const uint8_t* p, uint32_t size)
+{
+    uint32_t o = 0;
+#if MFC_HAVE_SSE2
+    const __m128i pat = _mm_set1_epi32(0x08C708C7);
+    for (; o + 64 <= size; o += 64) {
+        const __m128i a = _mm_cmpeq_epi32(_mm_loadu_si128((const __m128i*)(p + o)), pat);
+        const __m128i b = _mm_cmpeq_epi32(_mm_loadu_si128((const __m128i*)(p + o + 16)), pat);
+        const __m128i c = _mm_cmpeq_epi32(_mm_loadu_si128((const __m128i*)(p + o + 32)), pat);
+        const __m128i d = _mm_cmpeq_epi32(_mm_loadu_si128((const __m128i*)(p + o + 48)), pat);
+        if (_mm_movemask_epi8(_mm_or_si128(_mm_or_si128(a, b), _mm_or_si128(c, d)))) return 1;
+    }
+    for (; o + 16 <= size; o += 16)
+        if (_mm_movemask_epi8(_mm_cmpeq_epi32(_mm_loadu_si128((const __m128i*)(p + o)), pat)))
+            return 1;
+#endif
+    for (; o + 4 <= size; o += 4) {
+        uint32_t w; memcpy(&w, p + o, 4);
+        if (w == 0x08C708C7u) return 1;   /* 0xC708C708 BE in LS bytes */
+    }
+    return 0;
