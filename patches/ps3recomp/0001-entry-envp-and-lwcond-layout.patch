+ * registration that runs before this file's own dynamic initializers is safe. */
+enum { MAX_IMAGES = 8 };
+struct ContImage { const ppu_cont_entry* t; uint32_t n; const char* name; };
+static ContImage s_img[MAX_IMAGES];
