+/* ---- VCOMPACT: the vertex path of vnew_draw ---------------------------------
+ * A VP draw used to convert all 16 attributes of every EXPANDED vertex (each
+ * index, each strip/fan/quad corner again) through rsx_fetch_attrib into a
+ * 256-byte record -- ~1.7 M records, ~435 MB of write-combined upload memory
+ * per inFamous 2 frame. Now:
+ *   (a) only the attributes the compiled VS reads (its DXBC input signature)
+ *       are converted, packed in a vmask-specific layout, through a per-draw
+ *       fetch plan (rsx_vfetch_*: one resolve per array, then load/swap/store);
+ *   (b) each distinct guest vertex of a draw record is converted once and the
+ *       primitive expansion is done in a u32 index buffer (DrawIndexed);
+ *   (c) a draw's planned vertex range is kept, converted, in a cache region of
+ *       the arena and reused while its guest bytes hash the same
+ *       (rsx_vcache_*; VCACHE_MB, default 256, 0 = off). inFamous 2's busy New Marais
+ *       street overflowed 64 MB (2.9k hits vs 45k "nofit" per 20 frames: those draws
+ *       convert every frame); 256 MB: 41.6 -> 49.5 game loops/s, walker 23.6 -> 19.3 ms
+ *       per frame (1024: 49.9, within noise), other views unchanged (2026-10-21).
+ * VCOMPACT=0 restores the old path. Diagnostics that read or write vp_vb as
+ * 256-byte expanded records force it off (vnew_wanted). VFETCH_CHECK=1
+ * re-fetches every converted vertex the old way and reports mismatches. */
+#define VP_VB_HALF ((u64)MAX_VERTICES * 256u)   /* one parity half of vp_vb */
+#define VP_IB_HALF (4u << 20)                   /* u32 indices per vp_ib half */
+static rsx_vdedupe s_vdd;        /* unique-vertex table: one record's scope */
+static u64 s_vdd_sig;            /* plan signature + stride the table belongs to */
+static rsx_vcache s_vc;          /* cross-batch converted-vertex cache */
+static u64 s_vn_conv, s_vn_idx, s_vn_skip;   /* PERF: converted / emitted / skipped */
+static int vnew_wanted(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("VCOMPACT");
+        v = !(e && *e == '0');
+        static const char* const dbg[] = {
+            "VB_CLIP_ID", "VB_SKIP_WNEG", "FRAMELIST", "VP_TESTTRI", "RSX_DBG_VTX",
+            "RSX_DBG_SCALE", "RSX_DBG_TRACK", "VTX_DUMP", "VPOS_STATS", "IDX_DBG",
+            "IDXDBG", "VTX_POS" };
+        for (unsigned i = 0; v && i < sizeof dbg / sizeof dbg[0]; i++)
+            if (getenv(dbg[i])) {
+                v = 0;
+                fprintf(stderr, "[VCOMPACT] off: %s reads vp_vb as 256-byte expanded records%c", dbg[i], 10);
+            }
+    }
+    return v;
+}
+static int vnew_on(void) { return vnew_wanted() && s_d3d.vp_ib_mapped != NULL; }
+/* VCACHE_STATS=<n> (diagnostic; 1 = 60): every n presents a census of the
+ * converted-vertex cache (rsx_vcache_census_run) -- which slabs the frames
+ * keep from recycling, by how many ranges they still hit in each, how much of
+ * the region is dead and why -- with the cache's events since the last one:
+ *   [VCSTAT] <presents> b<batch> | slabs <used>/<all>: <recyclable> recyclable,
+ *     <pinned> pinned (hot ranges 0 / 1 / 2-4 / 5+: ...; hot KB p50 / p90) |
+ *     MB used / hot / cold (never hit) / orphaned | entries live / hot, keys
+ *     in admit2's filter |
+ *     since: hits, admits (first sighting / second (admit2) / content changed
+ *     / copy recycled / forgotten), held and refused (admit2), nofit (first sighting /
+ *     later), bypassed, slabs recycled, live entries forgotten, copies replaced
+ *     unhit / hit | the slab being emptied (evac: its live KB), copies moved
+ *     out, slabs chosen | keys (seen once before this window, MB of their
