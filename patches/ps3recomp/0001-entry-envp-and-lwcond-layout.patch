+      m(RSX_M_INVALIDATE_TEXTURE_CACHE, 1); m(RSX_M_INVALIDATE_TEXTURE_CACHE, 2);
+      CHECK(rsx_report_tex_epoch() == e0 + 2u, "0x1FD8 bumps the epoch"); }
