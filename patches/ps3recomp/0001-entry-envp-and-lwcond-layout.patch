+/* Flush the batch when the next draw might not fit -- vertex buffer, draw
+ * records, b1 constant ring -- instead of truncating or dropping it. The menu's
+ * and the tutorial's G-buffer passes ran past MAX_VERTICES every frame
+ * (FRAMESTAT v=393216), so their last draws -- the sky dome among them -- never
+ * reached the screen. Same mechanism as a readback flush. need: 3 vertices per
+ * index covers the worst expansion (strips/fans, then quads). BATCH_SPLIT=0
+ * restores the old clamp. */
+static void batch_capacity_check(u32 count)
+{
+    /* TX1 TEX_FENCE: a record after the pending batch's fence starts the next
+     * batch, so every record of a fenced batch precedes the fence. */
+    if (s_tc.fz.batch && s_tc.fz.batch == s_tc.batch + 1u && s_d3d.draw_count &&
+        !s_rf_flush && s_d3d.initialized) {
+        tex_fence_split();
+        return;
+    }
+    static int en = -1;
+    if (en < 0) { const char* e = getenv("BATCH_SPLIT"); en = (e && *e == '0') ? 0 : 1; }
+    if (!en || s_rf_flush || !s_d3d.initialized || s_d3d.draw_count == 0) return;
+    const u64 need = (u64)count * 3u;
+    const u64 used = s_d3d.vp_vb_offset / VP_VERT_STRIDE;
+    /* VCOMPACT counts bytes: at most `count` distinct vertices of at most 256
+     * bytes (+ one stride of alignment), and at most 3 indices per entry. */
+    const int vnew = vnew_on();
+    const int vb_full = vnew ? (u64)s_d3d.vp_vb_offset + (u64)count * 256u + 256u > VP_VB_HALF
+                             : used + need > MAX_VERTICES;
+    const int ib_full = vnew && (u64)s_d3d.vp_ib_used + need > VP_IB_HALF;
+    const char* why = NULL;
+    if (vb_full)                                 why = "vb-full";
+    else if (ib_full)                            why = "ib-full";
+    else if (s_d3d.draw_count + 2u >= MAX_DRAWS)  why = "draws-full";
+    else if (s_d3d.vp_fpcb_used + 40000u > VP_FPCB_HALF) why = "b1-full";
+    if (!why) return;
+    /* Inside a BEGIN/END triangle stream (chunks of up to 256 indices, merged
+     * into one record, 256 not a multiple of 3) a flush must keep the triangle
+     * phase: the record's trailing vertex_count % 3 vertices move to a copy of
+     * that record at the start of the next batch, which the next chunk then
+     * extends. Mid-stream, flush only when the chunk really does not fit. */
+    D3D12DrawRecord carry_rec; u32 carry = 0;
+    VPSlot carry_v[2][16];
+    const int mid = s_d3d.merge_prev_draw && s_d3d.draw_count > 0;
+    if (mid) {
+        if (!vb_full && !ib_full && s_d3d.draw_count + 2u < MAX_DRAWS &&
+            s_d3d.vp_fpcb_used + 40000u <= VP_FPCB_HALF) return;
+        D3D12DrawRecord* pv = &s_d3d.draws[s_d3d.draw_count - 1];
+        if (pv->is_vp && !pv->is_clear && pv->topology == RSX_TOPOLOGY_TRIANGLES) {
+            carry = pv->vertex_count % 3u;
+            if (carry && pv->is_idx) {
+                /* the carried indices' vertices, wherever in the arena */
+                const u32* cib = (const u32*)s_d3d.vp_ib_mapped + (u64)s_d3d.vp_parity * VP_IB_HALF
+                                 + pv->ib_start + pv->vertex_count - carry;
+                for (u32 k = 0; k < carry; k++)
+                    memcpy(carry_v[k], (const u8*)s_d3d.vp_vb_mapped + (u64)cib[k] * pv->vstride,
+                           pv->vstride);
+                pv->vertex_count -= carry;
+                carry_rec = *pv;
+            } else if (carry) {
+                const u8* src = (const u8*)s_d3d.vp_vb_mapped
+                    + (u64)s_d3d.vp_parity * MAX_VERTICES * VP_VERT_STRIDE
+                    + pv->vb_byte_offset + (u64)(pv->vertex_count - carry) * VP_VERT_STRIDE;
+                memcpy(carry_v, src, (size_t)carry * VP_VERT_STRIDE);
+                pv->vertex_count -= carry;
+                carry_rec = *pv;
+            }
+        }
+    }
+    { static int n = 0; if (n++ < 6)
+        fprintf(stderr, "[SPLIT] batch flushed early (%s: %llu verts, %u ops, carry %u)%c",
+                why, (unsigned long long)used, s_d3d.draw_count, carry, 10); }
+    const char* prev = s_rf_reason;
+    s_rf_flush = 1; s_present_this_frame = 0; s_rf_reason = why;
+    render_frame();
+    s_rf_flush = 0; s_present_this_frame = 1; s_rf_reason = prev;
+    if (carry && s_d3d.draw_count == 0 && carry_rec.is_idx) {
+        /* VCOMPACT: copy the carried vertices into the new half and index
+         * them afresh (the old half is reused two batches from now). */
+        const u32 vs = carry_rec.vstride;
+        const u64 half0 = (u64)s_d3d.vp_parity * VP_VB_HALF;
+        const u64 g0 = ((half0 + vs - 1u) / vs) * vs;
+        u32* nib = (u32*)s_d3d.vp_ib_mapped + (u64)s_d3d.vp_parity * VP_IB_HALF;
+        for (u32 k = 0; k < carry; k++) {
+            memcpy((u8*)s_d3d.vp_vb_mapped + g0 + (u64)k * vs, carry_v[k], vs);
+            nib[k] = (u32)(g0 / vs) + k;
+        }
+        s_d3d.vp_vb_offset = (u32)(g0 + (u64)carry * vs - half0);
+        s_d3d.vp_ib_used = carry;
+        D3D12DrawRecord* nr = &s_d3d.draws[0];
+        *nr = carry_rec;
+        nr->ib_start = 0; nr->vb_byte_offset = (u32)(g0 - half0);
+        nr->vertex_count = carry; nr->cb_slot = 0;
+        nr->fp_shash = 0;                         /* vp_record_fp re-lays b1 */
+        vp_record_cb(0, nr->vs_idx, nr);          /* constants of the same BEGIN/END */
+        s_d3d.draw_count = 1;
+    } else if (carry && s_d3d.draw_count == 0) {
+        /* render_frame flipped vp_parity: this is the new half, idle since the
+         * wait at the start of that render_frame. */
+        u8* dst = (u8*)s_d3d.vp_vb_mapped + (u64)s_d3d.vp_parity * MAX_VERTICES * VP_VERT_STRIDE;
+        memcpy(dst, carry_v, (size_t)carry * VP_VERT_STRIDE);
+        s_d3d.vp_vb_offset = carry * VP_VERT_STRIDE;
+        D3D12DrawRecord* nr = &s_d3d.draws[0];
+        *nr = carry_rec;
+        nr->vb_byte_offset = 0; nr->vertex_count = carry; nr->cb_slot = 0;
+        nr->fp_shash = 0;                         /* vp_record_fp re-lays b1 */
+        vp_record_cb(0, nr->vs_idx, nr);          /* constants of the same BEGIN/END */
+        s_d3d.draw_count = 1;
+        /* merge_prev_draw / merge_first_end stay: the next chunk extends nr */
+    } else
+        s_d3d.merge_prev_draw = 0;
+    /* PF6 REPORT_GPU: a carried record of an earlier SET_BEGIN_END keeps no
+     * plan (its plans die with the replay above; its 1-2 dangling vertices
+     * draw nothing, as the next BEGIN cannot extend them) */
+    if (carry && s_d3d.draw_count == 1 && s_d3d.draws[0].rplan_mask && s_d3d.current_rsx_state &&
+        s_d3d.draws[0].begin_epoch != s_d3d.current_rsx_state->begin_epoch)
+        s_d3d.draws[0].rplan_mask = 0;
+}
