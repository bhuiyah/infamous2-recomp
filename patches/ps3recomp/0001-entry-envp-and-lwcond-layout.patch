+int main(int argc, char** argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    char dir[MAX_PATH];
+    if (argc > 1) snprintf(dir, sizeof dir, "%s", argv[1]);
+    else GetTempPathA(sizeof dir, dir);
+    build_arena();
+    a_int = -42; a_dbl = 2.5; strcpy(a_name, "kernel-a"); a_arr[3] = 0xDEADBEEFCAFEull;
+    for (int i = 0; i < 8; i++) {
+        g_objs[i].id = 0x100 + (uint32_t)i;
+        g_objs[i].value = i * 1000 - 3;
+        g_objs[i].used = (i == 1 || i == 4 || i == 6);
+        snprintf(g_objs[i].tag, sizeof g_objs[i].tag, "obj%d", i);
+        g_objs[i].host = &g_objs[i];
+    }
+    for (int i = 0; i < 3000; i++) g_ring[i] = (uint8_t)(i ^ 0x5C);
+
+    /* ---- registration ---------------------------------------------------- */
+    CHECK(ss_section_register(&k_b_ops) == 1, "FAKB not registered");
+    CHECK(ss_section_register(&k_b_ops) == 0, "FAKB registered twice");
+    CHECK(ss_section_register(&k_b_dup) == 0, "another FAKB registered");
+    CHECK(ss_section_register(&k_c_ops) == 1, "FAKC not registered");
+    CHECK(ss_section_register(NULL) == 0, "NULL registered");
+    CHECK(ss_section_count() == 6, "%d sections (TIME MAPS GMEM FAKA FAKB FAKC)", ss_section_count());
+    {   static const uint32_t want[] = { SS_FOURCC('T', 'I', 'M', 'E'), FOURCC_MAPS, FOURCC_GMEM, FOURCC_A, FOURCC_B,
+                                         FOURCC_C };
+        for (int i = 0; i < 6; i++) {
+            char b[5], c[5];
+            const ss_section_ops* o = ss_section_at(i);
+            CHECK(o && o->fourcc == want[i], "capture order %d: %s, want %s", i, o ? ss_fourcc_str(o->fourcc, b) : "-",
+                  ss_fourcc_str(want[i], c));
+        } }
+    CHECK(ss_section_find(FOURCC_A) == &k_a_ops && !ss_section_find(SS_FOURCC('N', 'O', 'P', 'E')), "find");
+
+    /* ---- CRC32C ----------------------------------------------------------- */
+    CHECK(ss_crc32c(0, "123456789", 9) == 0xE3069283u, "CRC32C check value %08X", ss_crc32c(0, "123456789", 9));
+    {   static uint8_t big[100003];
+        for (unsigned i = 0; i < sizeof big; i++) big[i] = (uint8_t)(i * 31 + (i >> 7));
+        const uint32_t one = ss_crc32c(0, big, sizeof big);
+        CHECK(ss_crc32c(ss_crc32c(0, big, 777), big + 777, sizeof big - 777) == one, "CRC32C does not chain"); }
+
+    /* ---- a check() refuses -------------------------------------------------- */
+    ss_state_set_arena(g_arena, ARENA_SIZE);
+    ss_time_set_guest_clock(fake_tb, 79800000ull);
+    CHECK(ss_time_anchor_add(&k_anchor) == 1, "anchor");
+    ss_state_set_margin(8u * MB_);
+    CHECK(ss_state_enable(), "enable");
+    char why[256];
+    uint32_t fc = 0;
+    g_a_refuse = 1;
+    CHECK(ss_state_check(why, sizeof why, &fc) == 9 && fc == FOURCC_A && strstr(why, "object 3"),
+          "check: fourcc %08X why %s", fc, why);
+    g_a_refuse = 0;
+    CHECK(ss_state_check(why, sizeof why, &fc) == 0 && fc == 0, "check after the refusal");
+
+    /* ---- capture ----------------------------------------------------------- */
+    int r = capture(1, why, sizeof why, &fc);
+    CHECK(r == SS_OK, "capture 1: %s", why);
+    const ss_image* img = ss_image_last();
+    CHECK(img && img->hdr.nsections == 6 && img->hdr.flags == 0 && img->hdr.seq == 1, "image 1");
+    if (!img) { printf("test_ss_state: FAIL (no image)\n"); return 1; }
+    printf("capture 1: %.1f KB in %u sections, %u chunks, %.2f ms (staging %.0f MB)\n",
+           (double)img->hdr.file_size / 1024.0, img->hdr.nsections, img->hdr.nchunks, ss_state_capture_ms(),
+           (double)ss_state_staging_bytes() / MB_);
+    CHECK(ss_image_verify(img, why, sizeof why) == SS_OK, "verify: %s", why);
+    CHECK(ss_image_validate(img, why, sizeof why) == SS_OK, "validate: %s", why);
+    for (uint32_t i = 0; i < img->hdr.nsections; i++) CHECK((img->sec[i].offset & 4095u) == 0, "section %u unaligned", i);
+    check_memory(img);
+    check_round_trip(img);
+    check_layouts(img);
+
+    /* ---- CRC in RAM ---------------------------------------------------------- */
+    {   const ss_sec_ent* e = ss_image_section(img, FOURCC_B);
+        uint8_t* p = (uint8_t*)img->data + e->offset + 100;
+        *p ^= 0x10;
+        CHECK(ss_image_verify(img, why, sizeof why) == SS_E_CORRUPT && strstr(why, "FAKB"), "a flipped byte: %s", why);
+        *p ^= 0x10;
+        CHECK(ss_image_verify(img, why, sizeof why) == SS_OK, "verify after the repair: %s", why); }
+
+    /* ---- the raw file ------------------------------------------------------------ */
+    char path[MAX_PATH + 32];
+    snprintf(path, sizeof path, "%stest_ss_state.p3ssraw", dir);
+    double ms = 0;
+    CHECK(ss_image_write_file(img, path, &ms, why, sizeof why) == SS_OK, "write: %s", why);
+    uint64_t fn = 0;
+    uint8_t* fb = (uint8_t*)read_file(path, &fn);
+    CHECK(fb && fn == img->hdr.file_size, "file of %llu bytes, header says %llu", (unsigned long long)fn,
+          (unsigned long long)img->hdr.file_size);
+    if (fb) {
+        ss_image fi;
+        CHECK(ss_image_parse(&fi, fb, fn, why, sizeof why) == SS_OK, "parse: %s", why);
+        CHECK(ss_image_verify(&fi, why, sizeof why) == SS_OK, "verify the file: %s", why);
+        CHECK(ss_image_validate(&fi, why, sizeof why) == SS_OK, "validate the file: %s", why);
+        check_round_trip(&fi);
+        const ss_sec_ent* e = ss_image_section(&fi, FOURCC_GMEM);
+        fb[fi.hdr.data_off + e->offset + 4096 * 2 + 7] ^= 1;
+        CHECK(ss_image_verify(&fi, why, sizeof why) == SS_E_CORRUPT && strstr(why, "GMEM"), "a file byte: %s", why);
+        fb[fi.hdr.data_off + e->offset + 4096 * 2 + 7] ^= 1;
+        fb[offsetof(ss_img_hdr, build) + 3] ^= 1;          /* a byte no bound check looks at */
+        CHECK(ss_image_parse(&fi, fb, fn, why, sizeof why) == SS_E_CORRUPT && strstr(why, "header CRC"),
+              "a header byte: %s", why);
+        fb[offsetof(ss_img_hdr, build) + 3] ^= 1;
+        CHECK(ss_image_parse(&fi, fb, fn - 1, why, sizeof why) == SS_E_CORRUPT, "a truncated file parsed");
+        CHECK(ss_image_parse(&fi, fb, fn, why, sizeof why) == SS_OK, "parse again: %s", why);
+        /* an unknown mandatory section: FAKA's fourcc renamed in the table --
+         * which the header CRC covers, so first refused as corrupt, then
+         * (the CRC recomputed: header with hdr_crc 0, then both tables)
+         * refused by name */
+        ss_sec_ent* se = (ss_sec_ent*)(fb + fi.hdr.sec_off);
+        for (uint32_t i = 0; i < fi.hdr.nsections; i++) if (se[i].fourcc == FOURCC_A) se[i].fourcc = SS_FOURCC('Z', 'Z', 'Z', 'Z');
+        CHECK(ss_image_parse(&fi, fb, fn, why, sizeof why) == SS_E_CORRUPT, "a section table change parsed");
+        ss_img_hdr h;
+        memcpy(&h, fb, sizeof h);
+        h.hdr_crc = 0;
+        uint32_t crc = ss_crc32c(0, &h, sizeof h);
+        crc = ss_crc32c(crc, fb + h.sec_off, (size_t)h.nsections * sizeof(ss_sec_ent));
+        crc = ss_crc32c(crc, fb + h.chunk_off, (size_t)h.nchunks * sizeof(ss_chunk_ent));
+        memcpy(fb + offsetof(ss_img_hdr, hdr_crc), &crc, 4);
+        CHECK(ss_image_parse(&fi, fb, fn, why, sizeof why) == SS_OK, "parse after the CRC fix: %s", why);
+        CHECK(ss_image_validate(&fi, why, sizeof why) == SS_E_LAYOUT && strstr(why, "ZZZZ is unknown"),
+              "an unknown section: %s", why);
+        check_crafted(fb, fn);
+        free(fb);
+    }
+    DeleteFileA(path);
+
+    /* ---- validation: a version changed under the image ---------------------- */
+    k_c_ops.version = 2;
+    CHECK(ss_image_validate(img, why, sizeof why) == SS_E_LAYOUT && strstr(why, "FAKC"), "version change: %s", why);
+    k_c_ops.version = 1;
+
+    /* ---- compression estimate --------------------------------------------------- */
+    {   ss_compress_est e;
+        CHECK(ss_image_estimate_compressed(img, FOURCC_GMEM, 32, &e) == SS_OK && e.chunks == 1 && e.of == 1 &&
+              e.ratio > 0.0 && e.ratio <= 1.0, "estimate: %u of %u chunks ratio %.3f", e.chunks, e.of, e.ratio);
+        printf("estimate: GMEM %u of %u chunk(s), %.1f%% (%.0f MB/s)\n", e.chunks, e.of, 100.0 * e.ratio, e.mb_s); }
+
+    /* ---- misuse ---------------------------------------------------------------- */
+    {   static const int modes[] = { 1, 2, 3 };
+        static const int errs[] = { SS_E_STATE, SS_E_ARG, SS_E_CORRUPT };
+        static const char* const what[] = { "left open", "member offset", "returned" };
+        for (int k = 0; k < 3; k++) {
+            g_c_mode = modes[k];
+            r = capture(10 + (unsigned)k, why, sizeof why, &fc);
+            CHECK(r == errs[k] && fc == FOURCC_C && strstr(why, what[k]) && !ss_image_last(),
+                  "misuse %d: %d (%s) fourcc %08X", modes[k], r, why, fc);
+        }
+        g_c_mode = 0;
+        CHECK(ss_write_u64(g_c_saved, "late", 1) == SS_E_STATE, "a write after the capture was taken"); }
+
+    /* ---- overflow ------------------------------------------------------------- */
+    g_big = 64u * MB_;
+    const uint64_t cap0 = ss_state_staging_bytes();
+    r = capture(20, why, sizeof why, &fc);
+    CHECK(r == SS_E_OVERFLOW && fc == FOURCC_B && strstr(why, "full") && !ss_image_last() &&
+          ss_state_need() > 64u * MB_, "overflow: %d (%s) fourcc %08X need %llu", r, why, fc,
+          (unsigned long long)ss_state_need());
+    r = capture(21, why, sizeof why, &fc);                 /* prepare grew to what was counted */
+    img = ss_image_last();
+    CHECK(r == SS_OK && img && ss_state_staging_bytes() > cap0 && ss_state_staging_bytes() >= ss_state_need(),
+          "after the growth: %d (%s), staging %llu -> %llu", r, why, (unsigned long long)cap0,
+          (unsigned long long)ss_state_staging_bytes());
+    if (img) {
+        ss_reader rd;
+        const void* p = NULL;
+        uint64_t n = 0;
+        ss_reader_open(&rd, img, FOURCC_B);
+        CHECK(ss_find_blob(&rd, "big", &p, &n) == SS_OK && n == 64u * MB_ && ((const uint8_t*)p)[n - 1] == 0xA5,
+              "the big blob");
+        CHECK(ss_image_verify(img, why, sizeof why) == SS_OK, "verify the big image: %s", why);
+        check_memory(img);
+        printf("capture 21: %.1f MB, %u chunks, %.2f ms, staging %.0f MB\n", (double)img->hdr.file_size / MB_,
+               img->hdr.nchunks, ss_state_capture_ms(), (double)ss_state_staging_bytes() / MB_);
+        if (argc > 2) {                                    /* "keep": an image for tools/ss_inspect.py */
+            snprintf(path, sizeof path, "%stest_ss_state_keep.p3ssraw", dir);
+            CHECK(ss_image_write_file(img, path, &ms, why, sizeof why) == SS_OK, "keep: %s", why);
+            printf("kept %s\n", path);
+        }
+    }
+
+    /* ---- no arena ---------------------------------------------------------------- */
+    g_big = 0;
+    ss_state_set_arena(NULL, 0);
+    r = capture(30, why, sizeof why, &fc);
+    img = ss_image_last();
+    CHECK(r == SS_OK && img && (img->hdr.flags & SS_IMG_NO_ARENA), "no arena: %d flags %u", r, img ? img->hdr.flags : 0);
+
+    /* ---- the capture order under concurrent first use (SS1; last: it adds sections) ----
+     * Each registration makes the order be built again at its next use, as at
+     * boot; 8 threads then ask for it at once. Orders spread over the bands, in
+     * no relation to the registration order, so the sort moves entries. */
+    {   static ss_section_ops race_ops[40];
+        const int n0 = ss_section_count();
+        int rounds = 0;
+        CHECK(ss_state_order_check(why, sizeof why) == 0, "the order before the race: %s", why);
+        for (int k = 0; k < 40 && n0 + k + 1 <= SS_SECTION_MAX; k++) {
+            ss_section_ops* o = &race_ops[k];
+            memset(o, 0, sizeof *o);
+            o->fourcc = SS_FOURCC('R', 'C', (char)('0' + k / 10), (char)('0' + k % 10));
+            o->version = 1;
+            o->order = (int)((unsigned)(k * 7919) % 1600u);
+            o->name = "race";
+            if (ss_section_register(o) != 1) { CHECK(0, "race section %d not registered", k); break; }
+            g_race_want = n0 + k + 1;                        /* (no ss_section_count here: it would sort) */
+            InterlockedExchange(&g_race_go, 0);
+            InterlockedExchange(&g_race_in, 0);
+            HANDLE th[RACE_THREADS];
+            int nt = 0;
+            for (int t = 0; t < RACE_THREADS; t++)
+                if ((th[nt] = CreateThread(NULL, 0, race_thread, NULL, 0, NULL)) != NULL) nt++;
+            while (g_race_in < nt) YieldProcessor();
+            InterlockedExchange(&g_race_go, 1);
+            WaitForMultipleObjects((DWORD)nt, th, TRUE, INFINITE);
+            for (int t = 0; t < nt; t++) CloseHandle(th[t]);
+            rounds++;
+        }
+        CHECK(g_race_bad == 0, "%ld thread(s) of %d rounds x %d were handed a broken capture order (first: %s)",
+              g_race_bad, rounds, RACE_THREADS, g_race_what);
+        CHECK(ss_section_count() == n0 + rounds, "%d sections after the race, want %d", ss_section_count(), n0 + rounds);
+        CHECK(ss_state_order_check(why, sizeof why) == 0, "the order after the race: %s", why);
+        printf("capture order under concurrent first use: %d rounds x %d threads, %ld broken\n", rounds, RACE_THREADS,
+               g_race_bad);
+    }
+
+    /* ---- the order check refuses a broken order (the SS1 review) ---- */
+    {   const ss_section_ops* ord[SS_SECTION_MAX];
+        static ss_section_ops stranger;
+        stranger.fourcc = SS_FOURCC('S', 'T', 'R', 'G');
+        const int n = ss_section_count();
+        for (int i = 0; i < n; i++) ord[i] = ss_section_at(i);
+        CHECK(n >= 3 && ss_state_order_check_list(ord, n, why, sizeof why) == 0, "the order as built (%d): %s", n, why);
+        CHECK(ss_state_order_check_list(ord, n - 1, why, sizeof why) && strstr(why, "holds"), "one missing: '%s'", why);
+        const ss_section_ops* keep = ord[1];
+        ord[1] = ord[0];
+        CHECK(ss_state_order_check_list(ord, n, why, sizeof why) && strstr(why, "twice"), "one twice: '%s'", why);
+        ord[1] = &stranger;
+        CHECK(ss_state_order_check_list(ord, n, why, sizeof why) && strstr(why, "no registered"), "unknown: '%s'", why);
+        ord[1] = keep;
+        int i = 1;
+        while (i < n && ord[i - 1]->order == ord[i]->order) i++;
+        CHECK(i < n, "no two sections of different order");
+        if (i < n) {
+            const ss_section_ops* t = ord[i - 1];
+            ord[i - 1] = ord[i];
+            ord[i] = t;
+            CHECK(ss_state_order_check_list(ord, n, why, sizeof why) && strstr(why, "out of"), "swapped: '%s'", why);
+            ord[i] = ord[i - 1];
+            ord[i - 1] = t;
+        }
+        CHECK(ss_state_order_check_list(ord, n, why, sizeof why) == 0, "restored: %s", why);
+        CHECK(ss_state_order_check(why, sizeof why) == 0, "the live order after the refusals: %s", why);
+        printf("capture order check: a section missing, twice, unknown and out of order refused\n");
+    }
+
+    printf("test_ss_state: %s\n", g_fail ? "FAIL" : "PASS");
+    return g_fail ? 1 : 0;
+}
diff --git a/runtime/savestate/tests/test_ss_ui.c b/runtime/savestate/tests/test_ss_ui.c
new file mode 100644
index 0000000..0ea66c6
--- /dev/null
+++ b/runtime/savestate/tests/test_ss_ui.c
@@ -0,0 +1,573 @@
+/*
+ * ps3recomp - tests for the save-state UI side (runtime/savestate/ss_ui.c)
+ *
+ * What the window menu and the hotkeys rely on, without a window and without
+ * a guest: the request mailbox (one request at a time, refused while one
+ * waits or runs, also when eight threads ask at once), the coordinator's
+ * hand-over (the stub's "not available yet", and an engine that starts,
+ * refuses, completes and fails; requests from another thread than the
+ * coordinator never put a second request on the engine), the notices each
+ * step shows, the slot
+ * paths, the .meta reader and writer (BOM, CRLF, comments, junk, a missing
+ * or misplaced data file, a missing time), the "when" texts across day,
+ * month and year ends, the menu labels ('&' doubled, empty / damaged /
+ * unloadable, a loadable slot's tag "(older build)", the undo point's
+ * "Undo last load"), an engine's own slot reader, "Undo last load" (its
+ * request, notices and refusals), and another folder.
+ *
+ *   test_ss_ui <scratch dir>     (created; its slot files are replaced)
+ *
+ * Build and run (Windows, from external/ps3recomp):
+ *   clang-cl /std:c17 /O2 /MD -D_CRT_SECURE_NO_WARNINGS -I include
+ *            runtime/savestate/tests/test_ss_ui.c runtime/savestate/ss_ui.c /Fe:test_ss_ui.exe
+ *   test_ss_ui.exe %TEMP%\test_ss_ui
+ */
+#include "../ss_ui.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <io.h>
+#include <fcntl.h>
+
+static int g_fail, g_checks;
+#define CHECK(c, ...) do { g_checks++; if (!(c)) { g_fail++; printf("FAIL line %d: ", __LINE__); \
+                           printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+/* --- notices --------------------------------------------------------------- */
+static volatile LONG g_notices;
+static char g_notice[256];
+static unsigned g_notice_ms;
+static void sink(const char* text, unsigned ms, void* user)
+{
+    (void)user;
+    InterlockedIncrement(&g_notices);
+    snprintf(g_notice, sizeof g_notice, "%s", text);
+    g_notice_ms = ms;
+}
+static void notice_reset(void) { g_notices = 0; g_notice[0] = 0; g_notice_ms = 0; }
+
+/* --- files ----------------------------------------------------------------- */
+static char g_dir[300];
+
+static void put_file(const char* name, const char* text)
+{
+    char p[400];
+    snprintf(p, sizeof p, "%s\\%s", g_dir, name);
+    FILE* f = fopen(p, "wb");
+    if (f) { fputs(text, f); fclose(f); }
+}
+
+static void del_file(const char* name)
+{
+    char p[400];
+    snprintf(p, sizeof p, "%s\\%s", g_dir, name);
+    DeleteFileA(p);
+}
+
+static int ends_with(const char* s, const char* tail)
+{
+    size_t a = strlen(s), b = strlen(tail);
+    return a >= b && !_stricmp(s + a - b, tail);
+}
+
+/* --- an engine --------------------------------------------------------------- */
+static int g_eng_calls, g_eng_answer;
+static ss_ui_request g_req;
+static const char* g_eng_why;
+static int engine(const ss_ui_request* r, char* why, unsigned why_n, void* user)
+{
+    (void)user;
+    g_eng_calls++;
+    g_req = *r;
+    if (g_eng_answer != SS_UI_ENGINE_STARTED && g_eng_why) snprintf(why, why_n, "%s", g_eng_why);
+    return g_eng_answer;
+}
+
+/* --- an engine's slot reader ------------------------------------------------- */
+static int g_undo_there;
+static int reader(int slot, ss_slot_info* in, void* user)
+{
+    (void)user;
+    if (slot == 7) { in->used = 1; in->time = (long long)time(NULL); snprintf(in->note, sizeof in->note, "Flood Town"); }
+    if (slot == 8) { in->time = (long long)time(NULL) - 3 * 86400; snprintf(in->reason, sizeof in->reason, "made by another build"); }
+    if (slot == 9) { in->damaged = 1; }
+    if (slot == 10) { in->used = 1; in->time = (long long)time(NULL); snprintf(in->tag, sizeof in->tag, "older build"); }
+    if (slot == SS_UI_UNDO && g_undo_there) { in->used = 1; in->time = (long long)time(NULL); }
+    return in->used;
+}
+
+/* --- eight threads at once -------------------------------------------------- */
+static HANDLE g_go;
+static volatile LONG g_queued, g_busy;
+static DWORD WINAPI racer(LPVOID p)
+{
+    WaitForSingleObject(g_go, INFINITE);
+    int r = ss_ui_request_save((int)(intptr_t)p);
+    if (r == SS_UI_QUEUED) InterlockedIncrement(&g_queued);
+    else if (r == SS_UI_BUSY) InterlockedIncrement(&g_busy);
+    return 0;
+}
+
+static void test_when(void)
+{
+    char b[40];
+    /* struct tm fields: year-1900, month 0-11 */
+    ss_ui_format_when(126, 9, 20, 14, 3, 126, 9, 20, b, sizeof b);
+    CHECK(!strcmp(b, "today 14:03"), "%s", b);
+    ss_ui_format_when(126, 9, 19, 21, 40, 126, 9, 20, b, sizeof b);
+    CHECK(!strcmp(b, "yesterday 21:40"), "%s", b);
+    ss_ui_format_when(126, 9, 18, 9, 12, 126, 9, 20, b, sizeof b);
+    CHECK(!strcmp(b, "2026-10-18 09:12"), "%s", b);
+    ss_ui_format_when(126, 11, 31, 23, 59, 127, 0, 1, b, sizeof b);      /* across a year end */
+    CHECK(!strcmp(b, "yesterday 23:59"), "%s", b);
+    ss_ui_format_when(128, 1, 29, 0, 0, 128, 2, 1, b, sizeof b);         /* 2028-02-29 -> 03-01 */
+    CHECK(!strcmp(b, "yesterday 00:00"), "%s", b);
+    ss_ui_format_when(127, 1, 28, 8, 5, 127, 2, 1, b, sizeof b);         /* 2027 is no leap year */
+    CHECK(!strcmp(b, "yesterday 08:05"), "%s", b);
+    ss_ui_format_when(126, 9, 21, 8, 0, 126, 9, 20, b, sizeof b);        /* a clock set back: the date */
+    CHECK(!strcmp(b, "2026-10-21 08:00"), "%s", b);
+}
+
+static void test_meta_parse(void)
+{
+    ss_meta_fields m;
+    CHECK(ss_ui_parse_meta("format = 1\ntime = 1792512191\nnote = New Marais\ndata = slot3.state\n", &m) == 1, "plain");
+    CHECK(m.format == 1 && m.time == 1792512191LL, "format %d time %lld", m.format, m.time);
+    CHECK(!strcmp(m.note, "New Marais") && !strcmp(m.data, "slot3.state"), "note '%s' data '%s'", m.note, m.data);
+    CHECK(ss_ui_parse_meta("\xEF\xBB\xBF# c\r\nTime=5\r\n  NOTE  =  a\tb  \r\n", &m) == 1, "BOM + CRLF");
+    CHECK(m.time == 5 && !strcmp(m.note, "a b"), "time %lld note '%s'", m.time, m.note);
+    CHECK(ss_ui_parse_meta("", &m) == 1, "empty counts (the engine writes the meta last)");
+    CHECK(ss_ui_parse_meta("# only a comment\n", &m) == 1, "comments only");
+    CHECK(ss_ui_parse_meta("garbage\nmore garbage\n", &m) == 0, "junk is not a meta");
+    CHECK(ss_ui_parse_meta("\x01\x02\x03 binary", &m) == 0, "binary is not a meta");
+    CHECK(ss_ui_parse_meta("time = -4\nslot = 3\n", &m) == 1 && m.time == 0, "a bad time is no time");
+    /* a long UTF-8 note is cut on a character boundary */
+    char t[300];
+    snprintf(t, sizeof t, "note = %s\n", "\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9"
+                                        "\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9"
+                                        "\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9");
+    CHECK(ss_ui_parse_meta(t, &m) == 1, "utf-8 note");
+    size_t n = strlen(m.note);
+    CHECK(n < sizeof m.note && n % 2 == 0 && n > 0, "cut inside a character: %u bytes", (unsigned)n);
+}
+
+static void test_labels(void)
+{
+    ss_slot_info in;
+    memset(&in, 0, sizeof in);
+    in.slot = 3;
+    ss_ui_format_label(&in);
+    CHECK(!strcmp(in.label, "Slot 3  -  (empty)"), "%s", in.label);
+    in.used = 1; in.time = 1; snprintf(in.when, sizeof in.when, "today 14:03");
+    snprintf(in.note, sizeof in.note, "Cole & Zeke");
+    ss_ui_format_label(&in);
+    CHECK(!strcmp(in.label, "Slot 3  -  today 14:03  -  Cole && Zeke"), "%s", in.label);
+    in.used = 0; snprintf(in.reason, sizeof in.reason, "made by another build");
+    ss_ui_format_label(&in);
+    CHECK(!strcmp(in.label, "Slot 3  -  today 14:03  -  (made by another build)"), "%s", in.label);
+    in.reason[0] = 0; in.damaged = 1; in.time = 0;
+    ss_ui_format_label(&in);
+    CHECK(!strcmp(in.label, "Slot 3  -  (damaged)"), "%s", in.label);
+    memset(&in, 0, sizeof in);
+    in.slot = SS_UI_QUICK; in.used = 1;
+    ss_ui_format_label(&in);
+    CHECK(!strcmp(in.label, "Quick slot  -  saved"), "%s", in.label);
+    /* M7b: another build's slot that loads carries its tag; a tag on a slot that cannot load is not shown */
+    memset(&in, 0, sizeof in);
+    in.slot = 4; in.used = 1; in.time = 1; snprintf(in.when, sizeof in.when, "today 14:03");
+    snprintf(in.note, sizeof in.note, "Pier"); snprintf(in.tag, sizeof in.tag, "older build");
+    ss_ui_format_label(&in);
+    CHECK(!strcmp(in.label, "Slot 4  -  today 14:03  -  Pier  (older build)"), "%s", in.label);
+    in.note[0] = 0;
+    ss_ui_format_label(&in);
+    CHECK(!strcmp(in.label, "Slot 4  -  today 14:03  (older build)"), "%s", in.label);
+    in.used = 0; snprintf(in.reason, sizeof in.reason, "another build: layout changed");
+    ss_ui_format_label(&in);
+    CHECK(!strcmp(in.label, "Slot 4  -  today 14:03  -  (another build: layout changed)"), "%s", in.label);
+    /* the undo point */
+    memset(&in, 0, sizeof in);
+    in.slot = SS_UI_UNDO;
+    ss_ui_format_label(&in);
+    CHECK(!strcmp(in.label, "Undo last load  -  (nothing to undo)"), "%s", in.label);
+    in.used = 1; in.time = 1; snprintf(in.when, sizeof in.when, "today 09:15");
+    ss_ui_format_label(&in);
+    CHECK(!strcmp(in.label, "Undo last load  -  today 09:15"), "%s", in.label);
+}
+
+static void test_slots(void)
+{
+    char p[320];
+    CHECK(ss_ui_ensure_dir() == 1, "folder %s", ss_ui_dir());
+    CHECK(!_stricmp(ss_ui_dir(), g_dir), "dir %s, want %s", ss_ui_dir(), g_dir);
+    CHECK(ss_ui_slot_path(3, ".meta", p, sizeof p) && ends_with(p, "\\slot3.meta"), "%s", p);
+    CHECK(ss_ui_slot_path(10, ".state", p, sizeof p) && ends_with(p, "\\slot10.state"), "%s", p);
+    CHECK(ss_ui_slot_path(SS_UI_QUICK, ".meta", p, sizeof p) && ends_with(p, "\\quick.meta"), "%s", p);
+    CHECK(ss_ui_slot_path(SS_UI_UNDO, ".meta", p, sizeof p) && ends_with(p, "\\undo.meta"), "undo: %s", p);
+    CHECK(!ss_ui_slot_path(SS_UI_UNDO + 1, ".meta", p, sizeof p), "slot 12");
+    CHECK(!ss_ui_slot_path(-1, ".meta", p, sizeof p), "slot -1");
+    CHECK(!ss_ui_slot_path(3, ".meta", p, 8), "a buffer too small");
+
+    ss_slot_info in;
+    for (int s = 0; s <= SS_UI_SLOTS; s++) {
+        char nm[24];
+        snprintf(nm, sizeof nm, s ? "slot%d.meta" : "quick.meta", s);
+        del_file(nm);
+        CHECK(ss_ui_slot_info(s, &in) == 0 && !in.used && !in.damaged, "slot %d empty", s);
+    }
+    ss_ui_slot_info(4, &in);
+    CHECK(!strcmp(in.label, "Slot 4  -  (empty)"), "%s", in.label);
+    ss_ui_slot_info(SS_UI_QUICK, &in);
+    CHECK(!strcmp(in.label, "Quick slot  -  (empty)"), "%s", in.label);
+    CHECK(ss_ui_slot_info(SS_UI_UNDO + 1, &in) == 0 && !strcmp(in.label, "?"), "bad slot");
+    del_file("undo.meta");
+    CHECK(ss_ui_slot_info(SS_UI_UNDO, &in) == 0 && !strcmp(in.label, "Undo last load  -  (nothing to undo)"), "%s",
+          in.label);
+
+    /* written by the engine: the data file named, not there yet -> damaged */
+    const long long now = (long long)time(NULL);
+    del_file("slot3.state");
+    CHECK(ss_ui_write_meta(3, now, "New Marais & docks", "slot3.state") == 1, "write_meta");
+    CHECK(ss_ui_slot_info(3, &in) == 0 && in.damaged && !strcmp(in.reason, "damaged"), "data missing");
+    put_file("slot3.state", "x");
+    CHECK(ss_ui_slot_info(3, &in) == 1 && !in.damaged && in.time == now, "used, time %lld", in.time);
+    {
+        struct tm lt;
+        time_t tt = (time_t)now;
+        localtime_s(&lt, &tt);
+        char want[112];
+        snprintf(want, sizeof want, "Slot 3  -  today %02d:%02d  -  New Marais && docks", lt.tm_hour, lt.tm_min);
+        CHECK(!strcmp(in.label, want), "label '%s', want '%s'", in.label, want);
+    }
+    /* the .tmp of the atomic write is gone */
+    snprintf(p, sizeof p, "%s\\slot3.meta.tmp", g_dir);
+    CHECK(GetFileAttributesA(p) == INVALID_FILE_ATTRIBUTES, "no %s left", p);
+    /* overwrite: the newer meta wins */
+    CHECK(ss_ui_write_meta(3, now - 2 * 86400, NULL, NULL) == 1, "rewrite");
+    CHECK(ss_ui_slot_info(3, &in) == 1 && in.time == now - 2 * 86400 && !in.note[0], "rewritten");
+    CHECK(strchr(in.when, '-') != NULL, "two days ago is a date: %s", in.when);
+
+    /* no time line: the file's own time */
+    put_file("slot5.meta", "format = 1\n");
+    CHECK(ss_ui_slot_info(5, &in) == 1 && in.time > now - 120 && strstr(in.when, "today"), "mtime: %s", in.when);
+    /* junk: damaged; a data name that leaves the folder: damaged */
+    put_file("slot6.meta", "this is not\na meta file\n");
+    CHECK(ss_ui_slot_info(6, &in) == 0 && in.damaged, "junk");
+    put_file("slot7.meta", "data = ..\\slot3.state\n");
+    CHECK(ss_ui_slot_info(7, &in) == 0 && in.damaged, "traversal");
+    put_file("slot8.meta", "data = sub/slot3.state\n");
+    CHECK(ss_ui_slot_info(8, &in) == 0 && in.damaged, "subfolder");
+    put_file("slot9.meta", "data = C:slot3.state\n");
+    CHECK(ss_ui_slot_info(9, &in) == 0 && in.damaged, "drive");
+    for (int s = 5; s <= 9; s++) { char nm[24]; snprintf(nm, sizeof nm, "slot%d.meta", s); del_file(nm); }
+}
+
+static void test_requests(void)
+{
+    ss_ui_set_notice_sink(sink, NULL);
+    ss_ui_set_engine(NULL, NULL);
+    notice_reset();
+
+    /* no engine: queued, then the stub answers at the coordinator's step */
+    CHECK(!ss_ui_busy() && g_ss_ui_pending == 0, "idle");
+    CHECK(ss_ui_request_save(3) == SS_UI_QUEUED, "save 3");
+    CHECK(g_ss_ui_pending == ((SS_UI_OP_SAVE << 8) | 4), "mailbox %ld", (long)g_ss_ui_pending);
+    CHECK(ss_ui_busy(), "busy while queued");
+    CHECK(g_notices == 0, "no notice at the click");
