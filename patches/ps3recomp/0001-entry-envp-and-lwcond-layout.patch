+    rep[1 + 20] = 0x00; rep[1 + 21] = 0x20;                                       /* accel y 8192 */
+    fresh(&st);
+    CHECK_EQ(padhost_drv_ds4.parse(d, rep, 64, &st), 1);
+    CHECK_EQ(g_get_calls[0x02], 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CROSS);
+    CHECK_EQ(st.sensor_y, 399); CHECK_EQ(st.sensor_g, 648);
+}
