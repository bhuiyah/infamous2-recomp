+/* SDK directory names are upper-case letters, digits, '-' and '_'. Only what
+ * would escape the savedata directory or collide with the service's own
+ * ".NAME.tmp" / ".NAME.old" work directories is refused here. */
+static int savedata_dirname_ok(const char* name)
+{
+    size_t len = strnlen(name, CELL_SAVEDATA_DIRNAME_SIZE);
+    return len && len < CELL_SAVEDATA_DIRNAME_SIZE && name[0] != '.' &&
+           !strchr(name, '/') && !strchr(name, '\\') && !strchr(name, ':');
+}
+
+/* The entries of one directory, read up front so callers may delete or rename
+ * while they walk them. */
+typedef struct savedata_names {
+    char (*v)[260];
+    u8*  dir;
+    u32  n, cap;
+} savedata_names;
+
+static int names_add(savedata_names* s, const char* name, int is_dir)
+{
+    if (s->n == s->cap) {
+        u32 cap = s->cap ? s->cap * 2 : 16;
+        char (*v)[260] = (char (*)[260])realloc(s->v, cap * sizeof *s->v);
+        if (!v) return -1;
+        s->v = v;
+        u8* d = (u8*)realloc(s->dir, cap);
+        if (!d) return -1;
+        s->dir = d;
+        s->cap = cap;
+    }
+    snprintf(s->v[s->n], sizeof s->v[0], "%s", name);
+    s->dir[s->n++] = (u8)(is_dir != 0);
+    return 0;
+}
+
+static void names_free(savedata_names* s)
+{
+    free(s->v); free(s->dir);
+    memset(s, 0, sizeof *s);
+}
