+/* Sizes per format, the ones a backend's view format has to agree with. */
+static void test_format_classes(void)
+{
+    rsx_tex_layout L;
+    rsx_texture_layout(FMT_HILO8 | FMT_LN, 8, 8, &L);
+    CHECK_EQ(L.fmt, RSX_TEXFMT_R8G8); CHECK_EQ(L.bytes_per_texel, 2);
+    rsx_texture_layout(FMT_HILO_S8, 8, 8, &L);
+    CHECK_EQ(L.fmt, RSX_TEXFMT_R8G8); CHECK(L.swizzled);
+    rsx_texture_layout(FMT_R6G5B5, 8, 8, &L);
+    CHECK_EQ(L.fmt, RSX_TEXFMT_R8G8B8A8); CHECK_EQ(L.bytes_per_texel, 2);
+    CHECK_EQ(L.dst_bytes_per_texel, 4);
+    rsx_texture_layout(FMT_DEPTH24F | FMT_LN, 8, 8, &L);
+    CHECK_EQ(L.fmt, RSX_TEXFMT_R32F); CHECK_EQ(L.bytes_per_texel, 4);
+    rsx_texture_layout(FMT_DEPTH16F | FMT_LN, 8, 8, &L);
+    CHECK_EQ(L.fmt, RSX_TEXFMT_R32F); CHECK_EQ(L.bytes_per_texel, 2);
+    CHECK_EQ(L.dst_bytes_per_texel, 4); CHECK_EQ(L.row_bytes, 16); CHECK_EQ(L.dst_row_bytes, 32);
+    rsx_texture_layout(FMT_DEPTH16 | FMT_LN, 8, 8, &L);
+    CHECK_EQ(L.fmt, RSX_TEXFMT_R16);
+    /* 4:2:2: a word per two texels, never swizzled */
+    rsx_texture_layout(FMT_B8R8_G8R8, 4, 4, &L);   /* POT, LN clear */
+    CHECK(!L.swizzled);
+    CHECK_EQ(L.row_bytes, 8); CHECK_EQ(L.dst_row_bytes, 16); CHECK_EQ(L.face_bytes, 32);
+    rsx_texture_layout(FMT_R8B8_R8G8 | FMT_LN, 5, 2, &L);
+    CHECK_EQ(L.row_bytes, 12);                     /* ceil(5 / 2) words */
+    rsx_texture_layout_pitched(FMT_R8B8_R8G8 | FMT_LN, 5, 2, 64, &L);
+    CHECK_EQ(L.row_bytes, 64);
+}
