+const char* cellSysutil_lang_key(s32 lang)
+{
+    return lang >= 0 && lang < CELL_SYSUTIL_LANG_COUNT ? s_lang_keys[lang] : NULL;
+}
+
+s32 cellSysutil_lang_from_key(const char* key)
+{
