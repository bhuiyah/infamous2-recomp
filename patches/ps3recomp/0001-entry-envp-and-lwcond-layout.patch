+int main(int argc, char** argv)
+{
+    if (argc < 2) { printf("usage: test_ss_libs <an empty scratch directory>\n"); return 2; }
+    setvbuf(stdout, NULL, _IONBF, 0);
+    _putenv("PAD_NO_HOST=1");
+    _putenv("PAD_NO_KEYBOARD=1");
+    _putenv("PAD_CONFIG=none");
+    _putenv("OPTIONS_CONFIG=none");
+    _putenv("MSGDIALOG_NOBUTTON_WAITS=1");
+    vm_base = (uint8_t*)VirtualAlloc(NULL, 1ull << 32, MEM_RESERVE, PAGE_READWRITE);
+    CHECK(vm_base && VirtualAlloc(vm_base, 16u << 20, MEM_COMMIT, PAGE_READWRITE), "the guest arena");
+    ppu_vm_size = 0xFFFFFFFFu;
+    char trophies[MAX_PATH];
+    snprintf(trophies, sizeof trophies, "%s\\trophies", argv[1]);
+    for (int i = 0; i < 4; i++) {
+        const ss_section_ops* o = ss_section_find(k_mine[i]);
+        CHECK(o && o->teardown && o->restore && o->check_image, "%.4s has teardown, restore and check_image",
+              (const char*)&k_mine[i]);
+        if (!o || !o->teardown || !o->restore || !o->check_image) return 1;
+    }
+    ss_state_set_arena(NULL, 0);
+    CHECK(ss_state_enable(), "enable");
+    char why[256];
+
+    /* ================= Z: nothing initialised ================= */
+    freeze(1);
+    CHECK(capture(why, sizeof why) == SS_OK, "Z: capture: %s", why);
+    freeze(0);
+    const ss_image* Z = ss_image_hold();
+    CHECK(cellAudioInit() == 0, "Z: cellAudioInit");
+    CHECK(port_open(2, 8) == 0, "Z: a port");
+    Sleep(20);
+    CHECK(s_mixers == 1, "Z: one mixer (%ld)", (long)s_mixers);
+    load(Z, "LOAD Z");
+    CHECK(cellAudioPortGetStatus(0, EA(G_OUT)) != 0 && s_mixers == 1,
+          "LOAD Z: cellAudio not initialised, the session's mixer kept (%ld)", (long)s_mixers);
+    CHECK(cellAudioInit() == 0, "LOAD Z: the guest's cellAudioInit succeeds (the state had none)");
+    Sleep(20);
+    CHECK(s_mixers == 1, "LOAD Z: still one mixer after the guest's init (%ld)", (long)s_mixers);
+
+    /* ================= A ================= */
+    CHECK(port_open(2, 8) == 0 && port_open(8, 16) == 1, "A: ports 0 and 1");
+    CHECK(cellAudioSetNotifyEventQueue(0x77) == 0, "A: a notify key");
+    CHECK(cellPadInit(2) == 0, "A: cellPadInit");
+    CHECK(cellPadSetPortSetting(0, 2 | 4) == 0, "A: pad 0 press + sensor modes");
+    memset(vm_base + G_ACT, 0, 8);
+    vm_base[G_ACT] = 1; vm_base[G_ACT + 1] = 200;
+    CHECK(cellPadSetActDirect(0, EA(G_ACT)) == 0, "A: a motor request");
+    CHECK(cellKbInit(2) == 0 && cellKbSetReadMode(1, 1) == 0, "A: keyboard 1 in packet mode");
+    cellKb_keyEvent(1, 0x04, 1);
+    CHECK(cellMouseInit(1) == 0, "A: mouse");
+    cellMouse_moveEvent(0, 5, -3);
+    cellSysmoduleLoadModule(0x0001);
+    cellSysmoduleLoadModule(0xF035);
+    cellSysutilRegisterCallback(1, EA(0x10001234), EA(0x2000));
+    cellSysutilQueueEvent(1, 0x0101, 7);
+    cellSysutilQueueEvent(1, 0x0102, 8);
+    cellSysutilQueueEvent(0, 0x0103, 9);
+    cellSysutilQueueGuestCallback(0x3000, 1, 2);
+    cellSysutilQueueGuestCallback(0x3004, 3, 4);
+    cellDiscGameRegisterDiscChangeCallback((void (*)(void*))(uintptr_t)0x4444, EA(0x5555));
+    CHECK(cellMsgDialogOpen2(0x01, NULL, EA(0x6000), EA(0x7000), NULL) == 0, "A: a no-button dialog");
+    str(G_STR + 0x200, trophies);                     /* (a guest path: GUEST_PTR) */
+    sceNpTrophySetStoragePath((const char*)EA(G_STR + 0x200));
+    CHECK(sceNpTrophyInit(NULL, 0, 0, 0) == 0, "A: trophy init");
+    memset(vm_base + G_COMM, 0, 16);
+    memcpy(vm_base + G_COMM, "NPWR01234", 9);
+    CHECK(sceNpTrophyCreateContext(EA(G_OUT), EA(G_COMM), EA(G_COMM + 0x20), 0) == 0 && rd32(G_OUT) == 1,
+          "A: trophy context 1");
+    CHECK(sceNpTrophyCreateHandle(EA(G_OUT)) == 0, "A: trophy handle");
+    CHECK(cellHttpInit(NULL, 0) == 0 && cellHttpCreateClient(EA(G_OUT)) == 0, "A: http client");
+    str(G_STR, "GET");
+    str(G_STR + 0x10, "http");
+    str(G_STR + 0x20, "example.invalid");
+    str(G_STR + 0x40, "/a");
+    memset(vm_base + G_URI, 0, 24);
+    wr32(G_URI, G_STR + 0x10); wr32(G_URI + 4, G_STR + 0x20); wr32(G_URI + 8, G_STR + 0x40); wr32(G_URI + 20, 80);
+    CHECK(cellHttpCreateTransaction(EA(G_OUT), 0, (const char*)EA(G_STR), EA(G_URI)) == 0 && rd32(G_OUT) == 0,
+          "A: http transaction 0");
+    CHECK(cellNetCtlInit() == 0 && cellNetCtlAddHandler(EA(0x8000), EA(0x9000), EA(G_OUT)) == 0, "A: netctl handler");
+    rsx_videoout_gamma_set(1.1f);
+    memset(vm_base + G_RESC, 0, 32);
+    CHECK(cellRescInit(EA(G_RESC)) == 0 && cellRescSetDisplayMode(4) == 0, "A: resc");
+    str(G_STR + 0x80, "BCUS98125DATA");
+    cellGameDataCheck(1, (const char*)EA(G_STR + 0x80), NULL);
+    freeze(1);
+    why[0] = 0;
+    for (int i = 0; i < 4; i++) {
+        const ss_section_ops* o = ss_section_find(k_mine[i]);
+        CHECK(!o->check || o->check(why, sizeof why) == 0, "A: check %.4s: %s", (const char*)&k_mine[i], why);
+    }
+    CHECK(capture(why, sizeof why) == SS_OK, "A: capture: %s", why);
+    freeze(0);
+    const ss_image* A = ss_image_hold();
+    CHECK(A != NULL, "A held");
+    CHECK(nrecs(A, k_mine[0], "ports") == 2 && nrecs(A, k_mine[2], "completions") == 2 &&
+          nrecs(A, k_mine[2], "events") == 3 && nrecs(A, k_mine[3], "http_transactions") == 1,
+          "A: the records A expects");
+
+    /* ================= B ================= */
+    CHECK(cellAudioPortStart(0) == 0 && cellAudioPortClose(1) == 0 && port_open(2, 32) == 1 &&
+          port_open(8, 8) == 2, "B: port 0 runs, 1 reopened, 2 opened");
+    CHECK(cellPadSetPortSetting(0, 0) == 0, "B: pad modes off");
+    cellKb_keyEvent(1, 0x05, 1);
+    cellKb_keyEvent(1, 0x06, 1);
+    cellMouse_moveEvent(0, -20, 20);
+    cellSysmoduleUnloadModule(0x0001);
+    cellSysmoduleLoadModule(0x0010);
+    cellSysutilUnregisterCallback(1);
+    cellSysutilRegisterCallback(2, EA(0x10005678), EA(0x2100));
+    cellSysutilQueueEvent(2, 0x0201, 1);
+    cellSysutilQueueGuestCallback(0x3008, 5, 6);
+    CHECK(cellMsgDialogClose(0.0f) == 0, "B: the dialog closed");   /* (queues its completion) */
+    CHECK(sceNpTrophyDestroyContext(1) == 0, "B: trophy context 1 gone");
+    memcpy(vm_base + G_COMM, "NPWR05678", 9);
+    CHECK(sceNpTrophyCreateContext(EA(G_OUT), EA(G_COMM), EA(G_COMM + 0x20), 0) == 0, "B: another context");
+    CHECK(cellHttpDestroyTransaction(0) == 0, "B: transaction 0 gone");
+    str(G_STR + 0x40, "/b");
+    CHECK(cellHttpCreateTransaction(EA(G_OUT), 0, (const char*)EA(G_STR), EA(G_URI)) == 0, "B: another transaction");
+    CHECK(cellNetCtlDelHandler(0) == 0, "B: the handler removed");
+    rsx_videoout_gamma_set(0.9f);
+    cellRescSetDisplayMode(1);
+    str(G_STR + 0x80, "OTHERDATA");
+    cellGameDataCheck(2, (const char*)EA(G_STR + 0x80), NULL);
+    Sleep(30);                                        /* the mixer runs port 0 */
+    CHECK(port_status(0) == 2, "B: port 0 runs");
+
+    /* ================= LOAD A ================= */
+    load(A, "LOAD A");
+    CHECK(port_status(0) == 1 && port_status(1) == 1 && port_status(2) == 0, "LOAD A: ports 0, 1 ready, 2 closed");
+    CHECK(cellAudioInit() != 0, "LOAD A: cellAudio initialised (ALREADY_INIT)");
+    Sleep(20);
+    CHECK(s_mixers == 1, "LOAD A: one mixer (%ld)", (long)s_mixers);
+    memset(vm_base + G_KB, 0, 0x100);
+    CHECK(cellKbGetData(1, EA(G_KB)) == 0 && rd32(G_KB + 8) == 1, "LOAD A: keyboard 1 has A's one packet (%u)",
+          rd32(G_KB + 8));
+    CHECK(cellSysmoduleIsLoaded(0x0001) == 0 && cellSysmoduleIsLoaded(0x0010) != 0, "LOAD A: A's modules");
+    CHECK(rsx_videoout_gamma_get() == 1.1f, "LOAD A: A's gamma (%g)", (double)rsx_videoout_gamma_get());
+    CHECK(cellMsgDialogProgressBarInc(0, 0) == 0, "LOAD A: A's dialog is open again");
+    CHECK(cellRescGetDisplayMode(EA(G_OUT)) == 0 && rd32(G_OUT) == 4, "LOAD A: A's display mode");
+    g_ps3_guest_caller = recorder;
+    s_ncalled = 0;
+    cellSysutilCheckCallback();
+    CHECK(s_ncalled == 4 && s_called[0][0] == 0x3000 && s_called[1][0] == 0x3004 &&
+          s_called[2][0] == 0x10001234 && s_called[2][1] == 0x0101 && s_called[3][1] == 0x0102,
+          "LOAD A: A's completions, then A's events to A's callback (%d calls)", s_ncalled);
+    g_ps3_guest_caller = NULL;
+
+    /* ================= Q: the host side gone, LOAD A again ================= */
+    CHECK(cellAudioQuit() == 0, "Q: cellAudioQuit");
+    CHECK(s_mixers == 0, "Q: no mixer (%ld)", (long)s_mixers);
+    load(A, "LOAD A (no host side)");
+    Sleep(20);
+    CHECK(s_mixers == 1 && port_status(1) == 1, "LOAD A (no host side): the mixer started at the release (%ld)",
+          (long)s_mixers);
+
+    /* ================= refusals ================= */
+    /* the puts check_image runs (apply 0), on A's own records made to lie */
+    {
+        extern const ss_list cellAudio_ss_ports_list, cellSysutil_ss_events_list;
+        extern const uint32_t cellAudio_ss_port_size, cellSysutil_ss_event_size;
+        extern int cellAudio_ss_port_put(uint32_t, uint32_t, const void*, int, char*, size_t);
+        extern int cellSysutil_ss_event_put(uint32_t, uint32_t, const void*, int, char*, size_t);
+        static uint8_t rec[1024];
+        uint32_t key = 0, off = 0;
+        ss_reader r;
+        ss_recs_it it;
+        memset(rec, 0, sizeof rec);
+        CHECK(cellAudio_ss_port_size <= sizeof rec && ss_reader_open(&r, A, k_mine[0]) == SS_OK &&
+              ss_recs_open(&r, &cellAudio_ss_ports_list, &it) == SS_OK && ss_recs_next(&it, &key, rec) == 1,
+              "A's first port record");
+        why[0] = 0;
+        CHECK(cellAudio_ss_port_put(0, key, rec, 0, why, sizeof why) == 0, "A's port record passes: %s", why);
+        CHECK(cellAudio_ss_port_put(0, 9, rec, 0, why, sizeof why) != 0 && strstr(why, "no port 9"),
+              "a port number no port has is refused: %s", why);
+        for (uint32_t i = 0; i < cellAudio_ss_ports_list.n; i++)
+            if (!strcmp(cellAudio_ss_ports_list.f[i].name, "port_addr")) off = (uint32_t)(uintptr_t)cellAudio_ss_ports_list.f[i].at;
+        uint64_t ea;
+        memcpy(&ea, rec + off, 8);
+        ea += 0x200000u;                                  /* the next port's windows */
+        memcpy(rec + off, &ea, 8);
+        why[0] = 0;
+        CHECK(cellAudio_ss_port_put(0, key, rec, 0, why, sizeof why) != 0 && strstr(why, "port_addr"),
+              "a port record whose windows are another port's is refused: %s", why);
+        memset(rec, 0, sizeof rec);
+        CHECK(ss_reader_open(&r, A, k_mine[2]) == SS_OK && ss_recs_open(&r, &cellSysutil_ss_events_list, &it) == SS_OK &&
+              ss_recs_next(&it, &key, rec) == 1 && key == 0, "A's first event");
+        why[0] = 0;
+        CHECK(cellSysutil_ss_event_put(1, key, rec, 0, why, sizeof why) != 0 && strstr(why, "not the ring in order"),
+              "an event out of the ring's order is refused: %s", why);
+        CHECK(cellSysutil_ss_event_put(31, 31, rec, 0, why, sizeof why) != 0,
+              "an event past the ring's 31 entries is refused");
+    }
+
+    ss_image_release();
+    printf("test_ss_libs: %s\n", g_fail ? "FAIL" : "PASS");
+    fflush(stdout);
+    ExitProcess(g_fail);   /* (the pad host's threads, the mixer: not joined) */
+}
diff --git a/runtime/savestate/tests/test_ss_resumers.cpp b/runtime/savestate/tests/test_ss_resumers.cpp
new file mode 100644
index 0000000..1cf7e12
--- /dev/null
+++ b/runtime/savestate/tests/test_ss_resumers.cpp
@@ -0,0 +1,614 @@
+/*
+ * test_ss_resumers -- save states M4c: every S3 park kind a load resumes,
+ * against an uninterrupted reference, on the REAL kernel objects (the world
+ * of ss_test_world.inc: sys_semaphore / sys_event / sys_mutex / sys_cond /
+ * sys_timer / sys_ppu_thread, ppu_sysprx.cpp's lwmutex / lwcond / spinlock /
+ * net HLE, the save-state core and the PPU resume path).
+ *
+ * Each scenario runs twice. A guest thread W makes one blocking call (a few
+ * set it up first: an lwmutex taken twice before an lwcond wait); a producer
+ * on the host satisfies it. The REFERENCE runs that as is. The LOAD run takes
+ * a SELFTEST while W is blocked -- a round trip: capture, discard every guest
+ * thread (W longjmps to its root from inside the wait), restore, verify,
+ * recreate W in resume mode from its park record, release -- and the
+ * producer acts only after it. W's results (r3, the registers and memory the
+ * call writes, the object's state after) must equal the reference's, the
+ * stop must have seen W parked in the scenario's kind, the fidelity check
+ * must find every section equal, and W must have been recreated.
+ *
+ *   SEM, SEM timed     re-issue (the waiter count undone before the park)
+ *   EQUEUE             re-issue; the event arrives in r4..r7 and in memory
+ *   EFLAG              re-issue; the pattern into result_addr, AND|CLEAR
+ *   JOIN               re-issue, the target itself resumed from a usleep
+ *   USLEEP, SLEEP      the remaining time (not the whole sleep again)
+ *   LWMUTEX            re-issue (the NID S2 recorded)
+ *   LWCOND             the exact rule (critique B2): no early return -- W
+ *                      stays blocked until the real signal -- and owner and
+ *                      recursion (2) back as they were
+ *   LWCOND_REACQ       woken, parked re-taking its mutex: owner back, r3 0
+ *   LWCOND_REACQ tmo   a timed-out wait parked re-taking the mutex: r3 is
+ *                      still ETIMEDOUT
+ *   SPINLOCK, NET      re-issue
+ * MUTEX and COND are not resumable through a load in this build (a save
+ * refuses while a sys_mutex / sys_cond exists, and a load refuses a thread in
+ * sys_cond_wait: its waiter record is on the host stack the discard throws
+ * away), so they are checked one level down: W parks in a census stop, the
+ * stop's park record is checked against the call's entry (the audit: no
+ * argument register written before the park), and the record's resume --
+ * the re-issue, or COND's resumer -- runs on a fresh host thread and must
+ * give the reference's result; and a SELFTEST with W in sys_cond_wait is
+ * refused (not-resumable).
+ * SPU_JOIN (lv2_register.c) is not linked here; the game's round trips park
+ * two threads in it at every stop.
+ *
+ * Build and run from external/ps3recomp (the ppu_sysprx.cpp line first: it
+ * compiles against the lifter's generated header, the project's
+ * generated/ppu/ppu_recomp.h):
+ *   clang-cl /nologo /c /O1 /w /EHsc -std:c++20 -D_CRT_SECURE_NO_WARNINGS -Iinclude
+ *            -I../../generated/ppu -Iruntime/ppu -Iruntime/syscalls runtime/ppu/ppu_sysprx.cpp
+ *   clang-cl /nologo /O1 /w /EHsc -std:c++20 -D_CRT_SECURE_NO_WARNINGS -Iinclude
+ *            runtime/savestate/tests/test_ss_resumers.cpp ppu_sysprx.obj
+ *            runtime/syscalls/sys_ppu_thread.c runtime/syscalls/sys_semaphore.c
+ *            runtime/syscalls/sys_mutex.c runtime/syscalls/sys_cond.c runtime/syscalls/sys_timer.c
+ *            runtime/syscalls/sys_event.c runtime/savestate/ss_core.c runtime/savestate/ss_state.c
+ *            runtime/savestate/ss_ui.c /Fe:test_ss_resumers.exe && test_ss_resumers.exe
+ * (the .c files compile as C: clang-cl picks the language by extension).
+ * Exit status 0 = pass.
+ */
+#include "ss_test_world.inc"
+
+/* ---------------- the scenarios' guest memory ---------------- */
+enum { NSCN = 16 };
+static uint32_t PRM(uint32_t k, int i) { return DATA + 0x1000u + 0x40u * k + 8u * (uint32_t)i; }
+static uint32_t RES(uint32_t k, int i) { return DATA + 0x3000u + 0x80u * k + 8u * (uint32_t)i; }
+static uint32_t LWM(uint32_t k) { return DATA + 0x5000u + 0x40u * k; }
+static uint32_t LWC(uint32_t k) { return DATA + 0x5800u + 0x40u * k; }
+static uint32_t SPIN(uint32_t k) { return DATA + 0x6000u + 0x40u * k; }
+static uint32_t EVT(uint32_t k) { return DATA + 0x6400u + 0x40u * k; }
+static uint32_t FRES(uint32_t k) { return DATA + 0x6800u + 0x40u * k; }
+enum { RS_R3 = 0, RS_O1, RS_O2, RS_O3, RS_O4, RS_T0, RS_T1, RS_N, RS_V, RS_X };   /* RES slots */
+#define K ((uint32_t)R(31))
+#define P(i) vm_read64(PRM(K, i))
+#define PUT(i, v) vm_write64(RES(K, i), (uint64_t)(v))
+
+static const HleFn *F_LOCK, *F_UNLOCK, *F_LWC_WAIT, *F_LWC_SIGNAL, *F_LWM_CREATE, *F_LWC_CREATE,
+                   *F_SPIN_INIT, *F_SPIN_LOCK, *F_SPIN_UNLOCK, *F_NET_POLL;
+
+/* ---------------- the bodies (guest functions; r31 = the scenario) ---------------- */
+enum : uint32_t {
+    B_SC1 = G_BODY, B_LWM = G_BODY + 0x1000, B_LWC = G_BODY + 0x2000, B_SPIN = G_BODY + 0x3000,
+    B_NET = G_BODY + 0x4000, B_MUTEX = G_BODY + 0x5000, B_COND = G_BODY + 0x6000, B_JOINT = G_BODY + 0x7000,
+};
+
+/* one syscall: p0 = its number, p1..p5 = r3..r7; r3..r7 after it to RES */
+static void body_sc1(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) { case 0: break; case B_SC1 + 0x10: goto L1; default: abort(); }
+    frame_push(ctx);
+    R(31) = R(3);
+    PUT(RS_T0, now_ms());
+    R(3) = P(1); R(4) = P(2); R(5) = P(3); R(6) = P(4); R(7) = P(5);
+    SC(P(0), B_SC1 + 0x10);
+L1:
+    PUT(RS_T1, now_ms());
+    PUT(RS_R3, R(3)); PUT(RS_O1, R(4)); PUT(RS_O2, R(5)); PUT(RS_O3, R(6)); PUT(RS_O4, R(7));
+    frame_pop(ctx);
+}
+/* lwmutex_lock(LWM, p1 timeout); owner and recursion; unlock */
+static void body_lwm(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) { case 0: break; case B_LWM + 0x10: goto L1; case B_LWM + 0x20: goto L2; default: abort(); }
+    frame_push(ctx);
+    R(31) = R(3);
+    R(3) = LWM(K); R(4) = P(1);
+    HLE(F_LOCK, B_LWM + 0x10);
+L1:
+    PUT(RS_R3, R(3)); PUT(RS_O1, vm_read32(LWM(K) + 0x00)); PUT(RS_O2, vm_read32(LWM(K) + 0x0C));
+    R(3) = LWM(K);
+    HLE(F_UNLOCK, B_LWM + 0x20);
+L2:
+    PUT(RS_O3, R(3));
+    frame_pop(ctx);
+}
+/* lock, lock (recursion 2), lwcond_wait(LWC, p1 timeout); owner and
+ * recursion after it; unlock twice */
+static void body_lwc(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) {
+    case 0: break; case B_LWC + 0x10: goto L1; case B_LWC + 0x20: goto L2; case B_LWC + 0x30: goto L3;
+    case B_LWC + 0x40: goto L4; case B_LWC + 0x50: goto L5; default: abort();
+    }
+    frame_push(ctx);
+    R(31) = R(3);
+    R(3) = LWM(K); R(4) = 0;
+    HLE(F_LOCK, B_LWC + 0x10);
+L1:
+    R(3) = LWM(K); R(4) = 0;
+    HLE(F_LOCK, B_LWC + 0x20);
+L2:
+    PUT(RS_T0, now_ms());
+    R(3) = LWC(K); R(4) = P(1);
+    HLE(F_LWC_WAIT, B_LWC + 0x30);
+L3:
+    PUT(RS_T1, now_ms());
+    PUT(RS_R3, R(3)); PUT(RS_O1, vm_read32(LWM(K) + 0x00)); PUT(RS_O2, vm_read32(LWM(K) + 0x0C));
+    R(3) = LWM(K);
+    HLE(F_UNLOCK, B_LWC + 0x40);
+L4:
+    R(3) = LWM(K);
+    HLE(F_UNLOCK, B_LWC + 0x50);
+L5:
+    PUT(RS_O3, vm_read32(LWM(K) + 0x00));
+    frame_pop(ctx);
+}
+/* spinlock_lock(SPIN); the word; unlock */
+static void body_spin(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) { case 0: break; case B_SPIN + 0x10: goto L1; case B_SPIN + 0x20: goto L2; default: abort(); }
+    frame_push(ctx);
+    R(31) = R(3);
+    R(3) = SPIN(K);
+    HLE(F_SPIN_LOCK, B_SPIN + 0x10);
+L1:
+    PUT(RS_O1, vm_read32(SPIN(K)) != 0);
+    R(3) = SPIN(K);
+    HLE(F_SPIN_UNLOCK, B_SPIN + 0x20);
+L2:
+    PUT(RS_R3, 0);
+    frame_pop(ctx);
+}
+/* 20 x poll(no fds, 50 ms): the results summed, the count */
+static void body_net(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) { case 0: break; case B_NET + 0x10: goto L1; default: abort(); }
+    frame_push(ctx);
+    R(31) = R(3); R(30) = 0; R(29) = 0;
+    while (R(30) < 20) {
+        R(3) = 0; R(4) = 0; R(5) = 50;
+        HLE(F_NET_POLL, B_NET + 0x10);
+L1:
+        R(29) += R(3);
+        R(30)++;
+    }
+    PUT(RS_R3, R(29)); PUT(RS_N, R(30));
+    frame_pop(ctx);
+}
+/* sys_mutex_lock(p1); r3; unlock: r3 (0 only if it owned the mutex) */
+static void body_mutex(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) { case 0: break; case B_MUTEX + 0x10: goto L1; case B_MUTEX + 0x20: goto L2; default: abort(); }
+    frame_push(ctx);
+    R(31) = R(3);
+    R(3) = P(1); R(4) = 0;
+    SC(SYS_MUTEX_LOCK, B_MUTEX + 0x10);
+L1:
+    PUT(RS_R3, R(3));
+    R(3) = P(1);
+    SC(SYS_MUTEX_UNLOCK, B_MUTEX + 0x20);
+L2:
+    PUT(RS_O1, R(3));
+    frame_pop(ctx);
+}
+/* sys_mutex_lock(p1); sys_cond_wait(p2); r3; unlock: r3 */
+static void body_cond(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) {
+    case 0: break; case B_COND + 0x10: goto L1; case B_COND + 0x20: goto L2; case B_COND + 0x30: goto L3;
+    default: abort();
+    }
+    frame_push(ctx);
+    R(31) = R(3);
+    R(3) = P(1); R(4) = 0;
+    SC(SYS_MUTEX_LOCK, B_COND + 0x10);
+L1:
+    R(3) = P(2); R(4) = 0;
+    SC(SYS_COND_WAIT, B_COND + 0x20);
+L2:
+    PUT(RS_R3, R(3));
+    R(3) = P(1);
+    SC(SYS_MUTEX_UNLOCK, B_COND + 0x30);
+L3:
+    PUT(RS_O1, R(3));
+    frame_pop(ctx);
+}
+/* the JOIN target: usleep(p1), then return 0x77 (its exit status) */
+static void body_joint(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) { case 0: break; case B_JOINT + 0x10: goto L1; default: abort(); }
+    frame_push(ctx);
+    R(31) = R(3);
+    R(3) = P(1);
+    SC(SYS_TIMER_USLEEP, B_JOINT + 0x10);
+L1:
+    frame_pop(ctx);
+    R(3) = 0x77;
+}
+
+static void bodies_register(void)
+{
+    entry_add(B_SC1, [](ppu_context* c) { body_sc1(c, 0); });
+    entry_add(B_LWM, [](ppu_context* c) { body_lwm(c, 0); });
+    entry_add(B_LWC, [](ppu_context* c) { body_lwc(c, 0); });
+    entry_add(B_SPIN, [](ppu_context* c) { body_spin(c, 0); });
+    entry_add(B_NET, [](ppu_context* c) { body_net(c, 0); });
+    entry_add(B_MUTEX, [](ppu_context* c) { body_mutex(c, 0); });
+    entry_add(B_COND, [](ppu_context* c) { body_cond(c, 0); });
+    entry_add(B_JOINT, [](ppu_context* c) { body_joint(c, 0); });
+    ct_add(B_SC1 + 0x10, B_SC1, cont_at<body_sc1, B_SC1 + 0x10>, G_SC, 0);
+    ct_add(B_LWM + 0x10, B_LWM, cont_at<body_lwm, B_LWM + 0x10>, G_HLE, 0);
+    ct_add(B_LWM + 0x20, B_LWM, cont_at<body_lwm, B_LWM + 0x20>, G_HLE, 0);
+    ct_add(B_LWC + 0x10, B_LWC, cont_at<body_lwc, B_LWC + 0x10>, G_HLE, 0);
+    ct_add(B_LWC + 0x20, B_LWC, cont_at<body_lwc, B_LWC + 0x20>, G_HLE, 0);
+    ct_add(B_LWC + 0x30, B_LWC, cont_at<body_lwc, B_LWC + 0x30>, G_HLE, 0);
+    ct_add(B_LWC + 0x40, B_LWC, cont_at<body_lwc, B_LWC + 0x40>, G_HLE, 0);
+    ct_add(B_LWC + 0x50, B_LWC, cont_at<body_lwc, B_LWC + 0x50>, G_HLE, 0);
+    ct_add(B_SPIN + 0x10, B_SPIN, cont_at<body_spin, B_SPIN + 0x10>, G_HLE, 0);
+    ct_add(B_SPIN + 0x20, B_SPIN, cont_at<body_spin, B_SPIN + 0x20>, G_HLE, 0);
+    ct_add(B_NET + 0x10, B_NET, cont_at<body_net, B_NET + 0x10>, G_HLE, 0);
+    ct_add(B_MUTEX + 0x10, B_MUTEX, cont_at<body_mutex, B_MUTEX + 0x10>, G_SC, 0);
+    ct_add(B_MUTEX + 0x20, B_MUTEX, cont_at<body_mutex, B_MUTEX + 0x20>, G_SC, 0);
+    ct_add(B_COND + 0x10, B_COND, cont_at<body_cond, B_COND + 0x10>, G_SC, 0);
+    ct_add(B_COND + 0x20, B_COND, cont_at<body_cond, B_COND + 0x20>, G_SC, 0);
+    ct_add(B_COND + 0x30, B_COND, cont_at<body_cond, B_COND + 0x30>, G_SC, 0);
+    ct_add(B_JOINT + 0x10, B_JOINT, cont_at<body_joint, B_JOINT + 0x10>, G_SC, 0);
+}
+
+/* ---------------- one scenario, twice ---------------- */
+static const char* g_scn;
+static int g_k;                                      /* the RES / PRM slot of the run in progress */
+static uint64_t res(int i) { return vm_read64(RES((uint32_t)g_k, i)); }
+static void prm(int i, uint64_t v) { vm_write64(PRM((uint32_t)g_k, i), v); }
+static void res_clear(void) { memset(vm_base + RES((uint32_t)g_k, 0), 0, 0x80); }
+
+/* The round trip, with W (and the JOIN target) blocked: a SELFTEST, verified.
+ * Checks that it loaded, every section equal, and the park kinds seen. */
+static void round_trip(unsigned w, int kind, unsigned w2 = 0, int kind2 = 0)
+{
+    seen_clear();
+    ss_request_result o;
+    memset(&o, 0, sizeof o);
+    const int r = request(SS_P_SELFTEST, SS_RQ_VERIFY, nullptr, 5.0, &o);
+    CHECK(r == 0, "%s: the round trip was refused (%d %s: %s)", g_scn, r, ss_reason_name(r), o.why);
+    if (r) return;
+    CHECK(o.verified && o.verify_compared > 0 && o.verify_differ == 0,
+          "%s: fidelity check %s (%u of %u sections differ)", g_scn, o.verified ? "ran" : "did not run",
+          o.verify_differ, o.verify_compared);
+    CHECK(o.ppu_recreated >= (w2 ? 2u : 1u), "%s: %u PPU threads recreated", g_scn, o.ppu_recreated);
+    CHECK(g_seen[w].valid && g_seen[w].at == SS_IN_WAIT && (int)g_seen[w].num == kind,
+          "%s: W parked at=%d num=%u, not in a %s wait", g_scn, g_seen[w].at, g_seen[w].num, ss_wait_name(kind));
+    if (w2)
+        CHECK(g_seen[w2].valid && g_seen[w2].at == SS_IN_WAIT && (int)g_seen[w2].num == kind2,
+              "%s: tid %u parked at=%d num=%u, not in a %s wait", g_scn, w2, g_seen[w2].at, g_seen[w2].num,
+              ss_wait_name(kind2));
+    printf("  [%s] round trip: pause %.1f ms (discard %.1f, restore %.1f, verify %.1f, recreate %.1f),"
+           " %u PPU thread(s) recreated, %u sections equal\n", g_scn, o.pause_ms, o.discard_ms, o.restore_ms,
+           o.verify_ms, o.recreate_ms, o.ppu_recreated, o.verify_compared);
+}
+
+typedef struct { uint64_t v[RS_X]; } Outcome;
+static Outcome outcome(void) { Outcome o; for (int i = 0; i < RS_X; i++) o.v[i] = res(i); return o; }
+static void same(const Outcome& a, const Outcome& b, const int* slots, int n)
+{
+    for (int i = 0; i < n; i++)
+        CHECK(a.v[slots[i]] == b.v[slots[i]], "%s: result slot %d: 0x%llX in the reference, 0x%llX after the round trip",
+              g_scn, slots[i], (unsigned long long)a.v[slots[i]], (unsigned long long)b.v[slots[i]]);
+}
+
+/* SEM: wait on a semaphore at 0; posted. SEM timed: a 250 ms timeout, never posted. */
+static Outcome scn_sem(int load, int timed)
+{
+    const uint32_t s = mk(sys_semaphore_create, ATTR, 0, 4);
+    res_clear();
+    prm(0, SYS_SEMAPHORE_WAIT); prm(1, s); prm(2, timed ? 250000 : 0);
+    const unsigned w = spawn(B_SC1, (uint64_t)g_k, "W sem");
+    Sleep(80);
+    if (load) round_trip(w, SS_W_SEM);
+    if (!timed) { Sleep(30); CHECK(hsc(sys_semaphore_post, s, 1) == 0, "%s: post", g_scn); }
+    CHECK(finish(w, 3000), "%s: W did not finish", g_scn);
+    vm_write32(ID_OUT, 0xFFFF);
+    hsc(sys_semaphore_get_value, s, ID_OUT);
+    vm_write64(RES((uint32_t)g_k, RS_V), vm_read32(ID_OUT));        /* the value after */
+    return outcome();
+}
+/* EQUEUE: receive on a queue, a port connected; sent after. */
+static Outcome scn_equeue(int load)
+{
+    const uint32_t q = mk(sys_event_queue_create, ATTR, 0x1234, 16);
+    vm_write32(ID_OUT, 0);
+    hsc(sys_event_port_create, ID_OUT, 1 /* local */, 0x50525444ull);
+    const uint32_t port = vm_read32(ID_OUT);
+    CHECK(hsc(sys_event_port_connect_local, port, q) == 0, "%s: connect", g_scn);
+    res_clear();
+    memset(vm_base + EVT((uint32_t)g_k), 0, 32);
+    prm(0, SYS_EVENT_QUEUE_RECEIVE); prm(1, q); prm(2, EVT((uint32_t)g_k)); prm(3, 0);
+    const unsigned w = spawn(B_SC1, (uint64_t)g_k, "W equeue");
+    Sleep(80);
+    if (load) round_trip(w, SS_W_EQUEUE);
+    Sleep(30);
+    CHECK(hsc(sys_event_port_send, port, 0x11, 0x22, 0x33) == 0, "%s: send", g_scn);
+    CHECK(finish(w, 3000), "%s: W did not finish", g_scn);
+    vm_write64(RES((uint32_t)g_k, RS_N), vm_read64(EVT((uint32_t)g_k) + 8));   /* the event in memory: data1 */
+    return outcome();
+}
+/* EFLAG: wait for bit 0x4 (AND | CLEAR); 0x14 set after: result 0x14, 0x10 left. */
+static Outcome scn_eflag(int load)
+{
+    const uint32_t f = mk(sys_event_flag_create, ATTR, 0);
+    res_clear();
+    vm_write64(FRES((uint32_t)g_k), 0);
+    prm(0, SYS_EVENT_FLAG_WAIT); prm(1, f); prm(2, 0x4); prm(3, 0x01 | 0x10); prm(4, FRES((uint32_t)g_k)); prm(5, 0);
+    const unsigned w = spawn(B_SC1, (uint64_t)g_k, "W eflag");
+    Sleep(80);
+    if (load) round_trip(w, SS_W_EFLAG);
+    Sleep(30);
+    CHECK(hsc(sys_event_flag_set, f, 0x14) == 0, "%s: set", g_scn);
+    CHECK(finish(w, 3000), "%s: W did not finish", g_scn);
+    vm_write64(RES((uint32_t)g_k, RS_N), vm_read64(FRES((uint32_t)g_k)));
+    vm_write64(FRES((uint32_t)g_k), 0xFFFF);
+    hsc(sys_event_flag_get, f, FRES((uint32_t)g_k));
+    vm_write64(RES((uint32_t)g_k, RS_V), vm_read64(FRES((uint32_t)g_k)));   /* the pattern after */
+    return outcome();
+}
+/* USLEEP 500 ms (round trip at 250 ms) / SLEEP 1 s (at 500 ms): the elapsed
+ * time is the sleep plus the pause -- not a second whole sleep from the load. */
+static Outcome scn_sleep(int load, int secs)
+{
+    res_clear();
+    if (secs) { prm(0, SYS_TIMER_SLEEP); prm(1, 1); }
+    else      { prm(0, SYS_TIMER_USLEEP); prm(1, 500000); }
+    const unsigned w = spawn(B_SC1, (uint64_t)g_k, secs ? "W sleep" : "W usleep");
+    Sleep(secs ? 500 : 250);
+    double pause = 0;
+    if (load) {
+        round_trip(w, secs ? SS_W_SLEEP : SS_W_USLEEP);
+        ss_request_result o;
+        ss_last_request(&o);
+        pause = o.stopped_ms;
+    }
+    CHECK(finish(w, 4000), "%s: W did not finish", g_scn);
+    const double el = (double)(res(RS_T1) - res(RS_T0)), want = secs ? 1000.0 : 500.0;
+    printf("  [%s] %s: slept %.0f ms (the sleep %.0f ms, the pause %.0f ms)\n", g_scn, load ? "round trip" : "reference",
+           el, want, pause);
+    CHECK(el >= want - 5 && el <= want + pause + 120, "%s: slept %.0f ms for a %.0f ms sleep (pause %.0f ms)",
+          g_scn, el, want, pause);
+    return outcome();
+}
+/* JOIN: the target sleeps 300 ms and returns 0x77; W joins it. */
+static Outcome scn_join(int load)
+{
+    res_clear();
+    const uint32_t kt = (uint32_t)g_k + 1;               /* the target's own parameter slot */
+    vm_write64(PRM(kt, 1), 300000);
+    const unsigned t = spawn(B_JOINT, kt, "T joined");
+    prm(0, SYS_PPU_THREAD_JOIN); prm(1, t); prm(2, FRES((uint32_t)g_k));
+    vm_write64(FRES((uint32_t)g_k), 0);
+    const unsigned w = spawn(B_SC1, (uint64_t)g_k, "W join");
+    Sleep(100);
+    if (load) round_trip(w, SS_W_JOIN, t, SS_W_USLEEP);
+    CHECK(finish(w, 3000), "%s: W did not finish", g_scn);
+    vm_write64(RES((uint32_t)g_k, RS_N), vm_read64(FRES((uint32_t)g_k)));   /* the exit status joined */
+    return outcome();
+}
+/* LWMUTEX: the producer holds it; W blocks; released after. */
+static Outcome scn_lwmutex(int load)
+{
+    hhle(F_LWM_CREATE, LWM((uint32_t)g_k), 0);
+    CHECK(hhle(F_LOCK, LWM((uint32_t)g_k), 0) == 0, "%s: the producer's lock", g_scn);
+    res_clear();
+    prm(1, 0);
+    const unsigned w = spawn(B_LWM, (uint64_t)g_k, "W lwmutex");
+    Sleep(80);
+    if (load) round_trip(w, SS_W_LWMUTEX);
+    Sleep(30);
+    hhle(F_UNLOCK, LWM((uint32_t)g_k));
+    CHECK(finish(w, 3000), "%s: W did not finish", g_scn);
+    vm_write64(RES((uint32_t)g_k, RS_O1), res(RS_O1) == w);   /* the owner: W itself (1) */
+    return outcome();
+}
+/* LWCOND, three ways (mode): 0 W waits for a signal (the round trip in the
+ * wait; then 150 ms must pass with W still blocked -- no spurious return --
+ * before the producer signals); 1 W was signalled while the producer holds
+ * the mutex, so it is parked re-taking it (REACQ); 2 a 100 ms timed wait
+ * timed out while the producer holds the mutex (REACQ, the result ETIMEDOUT). */
+static Outcome scn_lwcond(int load, int mode)
+{
+    const uint32_t m = LWM((uint32_t)g_k), c = LWC((uint32_t)g_k);
+    hhle(F_LWM_CREATE, m, 0);
+    hhle(F_LWC_CREATE, c, m);
+    res_clear();
+    prm(1, mode == 2 ? 100000 : 0);
+    const unsigned w = spawn(B_LWC, (uint64_t)g_k, "W lwcond");
+    Sleep(80);                                            /* W waits; the mutex released */
+    if (mode == 1) {
+        CHECK(hhle(F_LOCK, m, 0) == 0, "%s: the producer's lock", g_scn);
+        hhle(F_LWC_SIGNAL, c);
+        Sleep(80);                                        /* W woke, blocked re-taking the mutex */
+    } else if (mode == 2) {
+        CHECK(hhle(F_LOCK, m, 0) == 0, "%s: the producer's lock", g_scn);
+        Sleep(250);                                       /* W timed out, blocked re-taking it */
+    }
+    if (load) round_trip(w, mode == 0 ? SS_W_LWCOND : SS_W_LWCOND_REACQ);
+    if (mode == 0) {
+        Sleep(150);
+        CHECK(thread_state(w) == PPU_THREAD_STATE_RUNNING && res(RS_T1) == 0,
+              "%s: W returned from its wait with no signal (state %d)", g_scn, thread_state(w));
+        CHECK(hhle(F_LOCK, m, 0) == 0, "%s: the producer's lock", g_scn);
+        hhle(F_LWC_SIGNAL, c);
+    }
+    hhle(F_UNLOCK, m);
+    CHECK(finish(w, 3000), "%s: W did not finish", g_scn);
+    vm_write64(RES((uint32_t)g_k, RS_O1), res(RS_O1) == w);   /* the owner: W itself (1) */
+    return outcome();
+}
+/* SPINLOCK: held by the producer; W spins (and parks); released after. */
+static Outcome scn_spin(int load)
+{
+    const uint32_t s = SPIN((uint32_t)g_k);
+    hhle(F_SPIN_INIT, s);
+    hhle(F_SPIN_LOCK, s);
+    res_clear();
+    const unsigned w = spawn(B_SPIN, (uint64_t)g_k, "W spinlock");
+    Sleep(80);
+    if (load) round_trip(w, SS_W_SPINLOCK);
+    Sleep(30);
+    hhle(F_SPIN_UNLOCK, s);
+    CHECK(finish(w, 3000), "%s: W did not finish", g_scn);
+    return outcome();
+}
+/* NET: 20 idle polls of 50 ms. */
+static Outcome scn_net(int load)
+{
+    res_clear();
+    const unsigned w = spawn(B_NET, (uint64_t)g_k, "W net");
+    Sleep(300);
+    if (load) round_trip(w, SS_W_NET);
+    CHECK(finish(w, 4000), "%s: W did not finish", g_scn);
+    return outcome();
+}
+
+static void run(const char* name, int k, Outcome (*f)(int), const int* slots, int n)
+{
+    g_scn = name;
+    g_k = k;
+    const Outcome ref = f(0);
+    g_k = k + 1;
+    const Outcome got = f(1);
+    same(ref, got, slots, n);
+    printf("[%s] r3 0x%llX / 0x%llX (reference / round trip)\n", name, (unsigned long long)ref.v[RS_R3],
+           (unsigned long long)got.v[RS_R3]);
+}
+
+/* ---------------- MUTEX and COND, one level down ---------------- */
+/* Run a census stop with W blocked and return W's park record. */
+static SeenPark park_in_census(unsigned w)
+{
+    seen_clear();
+    ss_request_result o;
+    const int r = request(SS_P_CENSUS, 0, nullptr, 3.0, &o);
+    CHECK(r == 0, "%s: census refused (%d: %s)", g_scn, r, o.why);
+    return g_seen[w];
+}
+/* The park record's resume on a fresh host thread (what a recreated thread
+ * runs after the gate, ss_root_load_run -> run_wait), from W's own root. */
+struct ResumeArgs { SeenPark p; };
+static unsigned __stdcall resume_proc(void* a)
+{
+    ResumeArgs* r = (ResumeArgs*)a;
+    ppu_context c = r->p.ctx;
+    g_active_ctx = &c;
+    sr_run_wait(&c, (int)r->p.num, r->p.obj, &r->p.rec, &r->p.root);
+    return 0;
+}
+static void resume_record(const SeenPark& p, void (*while_blocked)(void))
+{
+    ResumeArgs a;
+    a.p = p;
+    HANDLE h = (HANDLE)_beginthreadex(NULL, 0, resume_proc, &a, 0, NULL);
+    Sleep(80);
+    if (while_blocked) while_blocked();
+    CHECK(WaitForSingleObject(h, 3000) == WAIT_OBJECT_0, "%s: the resumed call did not return", g_scn);
+    CloseHandle(h);
+}
+static uint32_t g_mx, g_cv;
+static void unlock_mx(void) { hsc(sys_mutex_unlock, g_mx); }
+static void signal_cv(void) { hsc(sys_mutex_lock, g_mx, 0); hsc(sys_cond_signal, g_cv); hsc(sys_mutex_unlock, g_mx); }
+
+static void level_b(void)
+{
+    /* MUTEX: re-issue. W blocks in sys_mutex_lock behind the producer. */
+    g_scn = "MUTEX"; g_k = 14;
+    g_mx = mk(sys_mutex_create, ATTR);
+    CHECK(hsc(sys_mutex_lock, g_mx, 0) == 0, "MUTEX: the producer's lock");
+    res_clear();
+    prm(1, g_mx);
+    unsigned w = spawn(B_MUTEX, (uint64_t)g_k, "W mutex");
+    Sleep(80);
+    SeenPark p = park_in_census(w);
+    CHECK(p.valid && p.at == SS_IN_WAIT && p.num == SS_W_MUTEX, "MUTEX: parked at=%d num=%u", p.at, p.num);
+    CHECK(p.rec.nid_or_sc == SYS_MUTEX_LOCK && p.ctx.gpr[11] == SYS_MUTEX_LOCK && p.ctx.gpr[3] == g_mx &&
+          p.ctx.gpr[4] == 0 && p.ctx.sc_ra == G_SC_RA,
+          "MUTEX: the park is not the call's entry (r11 %llu, r3 0x%llX, r4 0x%llX, payload %u)",
+          (unsigned long long)p.ctx.gpr[11], (unsigned long long)p.ctx.gpr[3], (unsigned long long)p.ctx.gpr[4],
+          p.rec.nid_or_sc);
+    unlock_mx();
+    CHECK(finish(w, 3000), "MUTEX: W did not finish");
+    const Outcome ref = outcome();
+    res_clear();
+    CHECK(hsc(sys_mutex_lock, g_mx, 0) == 0, "MUTEX: the producer's lock");
+    resume_record(p, unlock_mx);
+    const Outcome got = outcome();
+    { static const int s[] = { RS_R3, RS_O1 }; same(ref, got, s, 2); }
+    CHECK(ref.v[RS_R3] == 0 && ref.v[RS_O1] == 0, "MUTEX: reference lock 0x%llX unlock 0x%llX",
+          (unsigned long long)ref.v[RS_R3], (unsigned long long)ref.v[RS_O1]);
+    printf("[MUTEX] park record = the call's entry; its re-issue returns what the call returned\n");
+
+    /* COND: the resumer (a spurious wakeup with the mutex taken back); a
+     * load refuses a thread parked here. */
+    g_scn = "COND"; g_k = 15;
+    g_cv = mk(sys_cond_create, g_mx, ATTR);
+    res_clear();
+    prm(1, g_mx); prm(2, g_cv);
+    w = spawn(B_COND, (uint64_t)g_k, "W cond");
+    Sleep(80);
+    seen_clear();
+    ss_request_result o;
+    const int r = request(SS_P_SELFTEST, SS_RQ_VERIFY, nullptr, 0.3, &o);
+    CHECK(r == SS_REASON_NOT_RESUMABLE, "COND: a selftest with W in sys_cond_wait ended %d (%s), not"
+          " not-resumable", r, o.why);
+    p = g_seen[w];
+    CHECK(p.valid && p.at == SS_IN_WAIT && p.num == SS_W_COND && p.rec.a == g_mx && p.rec.b == 1 &&
+          p.rec.nid_or_sc == SYS_COND_WAIT, "COND: park at=%d num=%u payload {%u, %u, %u}", p.at, p.num,
+          p.rec.nid_or_sc, p.rec.a, p.rec.b);
+    signal_cv();
+    CHECK(finish(w, 3000), "COND: W did not finish");
+    const Outcome cref = outcome();
+    res_clear();
+    resume_record(p, nullptr);                            /* (the resumer needs no signal) */
+    const Outcome cgot = outcome();
+    { static const int s[] = { RS_R3, RS_O1 }; same(cref, cgot, s, 2); }
+    CHECK(cref.v[RS_R3] == 0 && cref.v[RS_O1] == 0, "COND: reference wait 0x%llX unlock 0x%llX",
+          (unsigned long long)cref.v[RS_R3], (unsigned long long)cref.v[RS_O1]);
+    printf("[COND] a load refuses it; its resumer takes the mutex back and returns CELL_OK, as the wait did\n");
+}
+
+int main(int argc, char** argv)
+{
+    (void)argc; (void)argv;
+    setvbuf(stdout, NULL, _IONBF, 0);
+    _putenv_s("PS3_LWCOND_SAFETY_MS", "0");      /* lwcond waits wait for their signal (no 500 ms escape) */
+    bodies_register();
+    world_start();
+    F_LOCK = hle_by_name("sys_lwmutex_lock");     F_UNLOCK = hle_by_name("sys_lwmutex_unlock");
+    F_LWC_WAIT = hle_by_name("sys_lwcond_wait");  F_LWC_SIGNAL = hle_by_name("sys_lwcond_signal");
+    F_LWM_CREATE = hle_by_name("sys_lwmutex_create"); F_LWC_CREATE = hle_by_name("sys_lwcond_create");
+    F_SPIN_INIT = hle_by_name("sys_spinlock_initialize"); F_SPIN_LOCK = hle_by_name("sys_spinlock_lock");
+    F_SPIN_UNLOCK = hle_by_name("sys_spinlock_unlock"); F_NET_POLL = hle_by_name("sys_net_bnet_poll");
+    Sleep(50);                                    /* (the clock has flipped: not "booting") */
+
+    static const int R3[] = { RS_R3 };
+    static const int SEMS[] = { RS_R3, RS_V };
+    static const int EVS[] = { RS_R3, RS_O1, RS_O2, RS_O3, RS_O4, RS_N };
+    static const int FLG[] = { RS_R3, RS_N, RS_V };
+    static const int JN[] = { RS_R3, RS_N };
+    static const int LW[] = { RS_R3, RS_O1, RS_O2, RS_O3 };
+    static const int SP[] = { RS_R3, RS_O1 };
+    static const int NT[] = { RS_R3, RS_N };
+    run("SEM", 0, [](int l) { return scn_sem(l, 0); }, SEMS, 2);
+    run("SEM timed", 2, [](int l) { return scn_sem(l, 1); }, SEMS, 2);
+    run("EQUEUE", 4, scn_equeue, EVS, 6);
+    run("EFLAG", 6, scn_eflag, FLG, 3);
+    run("USLEEP", 8, [](int l) { return scn_sleep(l, 0); }, R3, 1);
+    run("SLEEP", 10, [](int l) { return scn_sleep(l, 1); }, R3, 1);
+    run("JOIN", 12, scn_join, JN, 2);                 /* (slots 12-15: W, target; 14-17 below reuse) */
+    run("LWMUTEX", 0, scn_lwmutex, LW, 3);
+    run("LWCOND", 2, [](int l) { return scn_lwcond(l, 0); }, LW, 4);
+    run("LWCOND_REACQ", 4, [](int l) { return scn_lwcond(l, 1); }, LW, 4);
+    run("LWCOND_REACQ timed out", 6, [](int l) { return scn_lwcond(l, 2); }, LW, 4);
+    run("SPINLOCK", 8, scn_spin, SP, 2);
+    run("NET", 10, scn_net, NT, 2);
+    level_b();
+    world_stop();
+    printf("%s: S3 resumers (%d failure%s)\n", g_fail ? "FAIL" : "PASS", g_fail, g_fail == 1 ? "" : "s");
+    fflush(stdout);
+    _exit(g_fail ? 1 : 0);                        /* (threads of the runtime still wait: no static teardown) */
+}
diff --git a/runtime/savestate/tests/test_ss_roundtrip.cpp b/runtime/savestate/tests/test_ss_roundtrip.cpp
new file mode 100644
index 0000000..720983c
--- /dev/null
+++ b/runtime/savestate/tests/test_ss_roundtrip.cpp
@@ -0,0 +1,765 @@
+/*
+ * test_ss_roundtrip -- save states M4c: the in-process load end to end, on
+ * synthetic guest threads over the REAL kernel objects and thread table (the
+ * world of ss_test_world.inc), with guest main and an SPU host thread:
+ *
+ *   rt  ROUND TRIPS while the world runs: guest main (tid 1, on the host
+ *       thread that plays the process's main thread) and a consumer pass
+ *       values through a semaphore and an event queue; two threads hand off
+ *       through an lwmutex and two lwconds; a third sleeps in short usleeps;
+ *       an SPU host thread counts in guest memory. A SELFTEST is taken again
+ *       and again (capture A, discard every thread -- main to its root and
+ *       the load gate, the SPU to its discard root --, restore, verify,
+ *       recreate, release). Every one must load, its fidelity check find
+ *       every section equal, and the computation end exactly as an
+ *       uninterrupted run does (the results are worked out here, in C).
+ *   ab  SAVE A, RUN TO B, LOAD A: main and a second thread take turns through
+ *       a word in guest memory, polling with usleep; a sleeper and the SPU
+ *       count. A is saved and held; the world runs on to B; A is loaded
+ *       (verified). Compared: the fidelity check (the state right after the
+ *       restore is A's: every section equal); the progress at B is past A's
+ *       and the iterations between them run twice (main's host-side count);
+ *       and the results at the end are an uninterrupted run's. Only guest
+ *       memory and the thread table carry state here (no kernel object whose
+ *       restore is not written yet), so the load is exact.
+ *   kobj SAVE A, CHANGE EVERY KERNEL OBJECT, LOAD A (KOBJ / KMEM's teardown
+ *       and restore): at A a semaphore holds 2, an event queue 3 events with
+ *       its ring's head moved on, a port is connected, an event flag holds
+ *       0x5, one lwmutex is taken and another free (and lwmutex / lwcond
+ *       registry entries wrap round the end of their tables), and a thread
+ *       waits in sys_lwcond_wait (registered as a waiter). Between A and B all of that
+ *       changes -- values, events, the lwmutex holders, the waiter woken and
+ *       gone -- and new objects appear: a semaphore, a queue, an lwmutex
+ *       taken at a new address, an lwcond, a thread, and the ones a save
+ *       refuses (a running lv2 timer, a sys_mutex held, a sys_cond). After
+ *       the load (verified: every section equal): A's values, A's events in
+ *       order, A's holders, the new objects gone (the timer's thread
+ *       stopped), the allocators where A left them (the lwcond id, the stack
+ *       bump), and the waiter resumes in its exact wait: one signal (which
+ *       only reaches a registered waiter) ends it with the value then given.
+ * The default runs all three, each in a child process.
+ *
+ * Build and run from external/ps3recomp (the ppu_sysprx.cpp line first: it
+ * compiles against the lifter's generated header, the project's
+ * generated/ppu/ppu_recomp.h):
+ *   clang-cl /nologo /c /O1 /w /EHsc -std:c++20 -D_CRT_SECURE_NO_WARNINGS -Iinclude
+ *            -I../../generated/ppu -Iruntime/ppu -Iruntime/syscalls runtime/ppu/ppu_sysprx.cpp
+ *   clang-cl /nologo /O1 /w /EHsc -std:c++20 -D_CRT_SECURE_NO_WARNINGS -Iinclude
+ *            runtime/savestate/tests/test_ss_roundtrip.cpp ppu_sysprx.obj
+ *            runtime/syscalls/sys_ppu_thread.c runtime/syscalls/sys_semaphore.c
+ *            runtime/syscalls/sys_mutex.c runtime/syscalls/sys_cond.c runtime/syscalls/sys_timer.c
+ *            runtime/syscalls/sys_event.c runtime/savestate/ss_core.c runtime/savestate/ss_state.c
+ *            runtime/savestate/ss_ui.c /Fe:test_ss_roundtrip.exe && test_ss_roundtrip.exe
+ * Exit status 0 = pass.
+ */
+#include "ss_test_world.inc"
+#include <setjmp.h>
+
+/* ---------------- guest memory ---------------- */
+enum : uint32_t {
+    PARAM = DATA + 0x0000,          /* sem, port, queue, N, N2, N3, LWM, CF, CE */
+    H_MAIN = DATA + 0x0100, H_CONS = DATA + 0x0108, H_LW = DATA + 0x0110, SLEEPS = DATA + 0x0118,
+    PROG = DATA + 0x0120, TURN = DATA + 0x0128, X = DATA + 0x0130, Y = DATA + 0x0138,
+    FLAG = DATA + 0x0140, VAL = DATA + 0x0148, SPU_CNT = DATA + 0x0150, SPU_DONE = DATA + 0x0158,
+    EVTBUF = DATA + 0x0200, LWM_EA = DATA + 0x0300, CF_EA = DATA + 0x0340, CE_EA = DATA + 0x0380,
+    /* kobj */
+    STAGE = DATA + 0x0160, WREADY = DATA + 0x0168, FLAG2 = DATA + 0x0170, VAL2 = DATA + 0x0178, X2 = DATA + 0x0180,
+    LWM1_EA = DATA + 0x03C0, LWM3_EA = DATA + 0x0400, LWM5_EA = DATA + 0x0440, CB_EA = DATA + 0x0480,
+    CC_EA = DATA + 0x04C0, EVTBUF2 = DATA + 0x0600,
+    /* five lwmutexes whose registry hash is the last slot but three (0xFFFC), so the fifth wraps round to
+     * slot 0; five lwconds the same in theirs (0xFFC) -- 0x10000 / 0x1000 apart, same hash */
+    WRAP_LWM = 0x008142BCu, WRAP_LWC = 0x008602BCu,
+};
+static uint64_t PRMV(int i) { return vm_read64(PARAM + 8u * (uint32_t)i); }
+enum { P_SEM, P_PORT, P_QUEUE, P_N, P_N2, P_N3, P_NAB };
+static const uint64_t FNV = 0x100000001B3ull;
+static const HleFn *F_LOCK, *F_UNLOCK, *F_WAIT, *F_SIGNAL;
+
+/* ---------------- the bodies ---------------- */
+enum : uint32_t {
+    B_PROD = G_BODY, B_CONS = G_BODY + 0x1000, B_LWCONS = G_BODY + 0x2000, B_LWPROD = G_BODY + 0x3000,
+    B_SLEEP = G_BODY + 0x4000, B_PING = G_BODY + 0x5000, B_PONG = G_BODY + 0x6000,
+    B_IDLE = G_BODY + 0x7000, B_LWWAIT = G_BODY + 0x8000,
+};
+/* rt, guest main: for i < N: sem_wait; h = h*31 + i + 1; send(i, h); usleep(500) */
+static void body_prod(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) {
+    case 0: break; case B_PROD + 0x10: goto L1; case B_PROD + 0x20: goto L2; case B_PROD + 0x30: goto L3;
+    default: abort();
+    }
+    frame_push(ctx);
+    R(30) = 0; R(29) = 0;
+    while (R(30) < PRMV(P_N)) {
+        R(3) = PRMV(P_SEM); R(4) = 0;
+        SC(SYS_SEMAPHORE_WAIT, B_PROD + 0x10);
+L1:
+        R(29) = R(29) * 31 + R(30) + 1;
+        vm_write64(PROG, R(30) + 1);
+        R(3) = PRMV(P_PORT); R(4) = R(30); R(5) = R(29); R(6) = 0;
+        SC(SYS_EVENT_PORT_SEND, B_PROD + 0x20);
+L2:
+        R(3) = 500;
+        SC(SYS_TIMER_USLEEP, B_PROD + 0x30);
+L3:
+        R(30)++;
+    }
+    vm_write64(H_MAIN, R(29));
+    frame_pop(ctx);
+}
+/* rt, consumer: for i < N: receive (i, h) in r5, r6; fold; sem_post */
+static void body_cons(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) { case 0: break; case B_CONS + 0x10: goto L1; case B_CONS + 0x20: goto L2; default: abort(); }
+    frame_push(ctx);
+    R(30) = 0; R(29) = 0;
+    while (R(30) < PRMV(P_N)) {
+        R(3) = PRMV(P_QUEUE); R(4) = EVTBUF; R(5) = 0;
+        SC(SYS_EVENT_QUEUE_RECEIVE, B_CONS + 0x10);
+L1:
+        R(29) = (R(29) ^ R(5)) * FNV + R(6);
+        R(3) = PRMV(P_SEM); R(4) = 1;
+        SC(SYS_SEMAPHORE_POST, B_CONS + 0x20);
+L2:
+        R(30)++;
+    }
+    vm_write64(H_CONS, R(29));
+    frame_pop(ctx);
+}
+/* rt, the lwcond hand-off: the consumer takes VAL when FLAG is 1 ... */
+static void body_lwcons(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) {
+    case 0: break; case B_LWCONS + 0x10: goto L1; case B_LWCONS + 0x20: goto L2; case B_LWCONS + 0x30: goto L3;
+    case B_LWCONS + 0x40: goto L4; default: abort();
+    }
+    frame_push(ctx);
+    R(30) = 0; R(29) = 0;
+    while (R(30) < PRMV(P_N2)) {
+        R(3) = LWM_EA; R(4) = 0;
+        HLE(F_LOCK, B_LWCONS + 0x10);
+L1:
+        while (vm_read32(FLAG) != 1) {
+            R(3) = CF_EA; R(4) = 0;
+            HLE(F_WAIT, B_LWCONS + 0x20);
+L2:         ;
+        }
+        R(29) = R(29) * 131 + vm_read32(VAL);
+        vm_write32(FLAG, 0);
+        R(3) = CE_EA;
+        HLE(F_SIGNAL, B_LWCONS + 0x30);
+L3:
+        R(3) = LWM_EA;
+        HLE(F_UNLOCK, B_LWCONS + 0x40);
+L4:
+        R(30)++;
+    }
+    vm_write64(H_LW, R(29));
+    frame_pop(ctx);
+}
+/* ... the producer puts i*7+1 there when FLAG is 0 */
+static void body_lwprod(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) {
+    case 0: break; case B_LWPROD + 0x10: goto L1; case B_LWPROD + 0x20: goto L2; case B_LWPROD + 0x30: goto L3;
+    case B_LWPROD + 0x40: goto L4; default: abort();
+    }
+    frame_push(ctx);
+    R(30) = 0;
+    while (R(30) < PRMV(P_N2)) {
+        R(3) = LWM_EA; R(4) = 0;
+        HLE(F_LOCK, B_LWPROD + 0x10);
+L1:
+        while (vm_read32(FLAG) != 0) {
+            R(3) = CE_EA; R(4) = 0;
+            HLE(F_WAIT, B_LWPROD + 0x20);
+L2:         ;
+        }
+        vm_write32(VAL, (uint32_t)(R(30) * 7 + 1));
+        vm_write32(FLAG, 1);
+        R(3) = CF_EA;
+        HLE(F_SIGNAL, B_LWPROD + 0x30);
+L3:
+        R(3) = LWM_EA;
+        HLE(F_UNLOCK, B_LWPROD + 0x40);
+L4:
+        R(30)++;
+    }
+    frame_pop(ctx);
+}
+/* the sleeper: N3 x usleep(700) */
+static void body_sleep(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) { case 0: break; case B_SLEEP + 0x10: goto L1; default: abort(); }
+    frame_push(ctx);
+    R(30) = 0;
+    while (R(30) < PRMV(P_N3)) {
+        R(3) = 700;
+        SC(SYS_TIMER_USLEEP, B_SLEEP + 0x10);
+L1:
+        R(30)++;
+        vm_write64(SLEEPS, R(30));
+    }
+    frame_pop(ctx);
+}
+/* ab, guest main: for i < NAB: wait for TURN 0 (usleep polling); X = X*31 + i + 1; TURN = 1 */
+static volatile LONG g_ping_iters;                    /* host-side: survives a load (the rewind shows) */
+static void body_ping(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) { case 0: break; case B_PING + 0x10: goto L1; default: abort(); }
+    frame_push(ctx);
+    R(30) = 0;
+    while (R(30) < PRMV(P_NAB)) {
+        while (vm_read64(TURN) != 0) {
+            R(3) = 300;
+            SC(SYS_TIMER_USLEEP, B_PING + 0x10);
+L1:         ;
+        }
+        vm_write64(X, vm_read64(X) * 31 + R(30) + 1);
+        InterlockedIncrement(&g_ping_iters);
+        R(30)++;
+        vm_write64(PROG, R(30));
+        vm_write64(TURN, 1);
+    }
+    frame_pop(ctx);
+}
+/* ab: for i < NAB: wait for TURN 1; Y = (Y ^ X) * FNV + i; TURN = 0 */
+static void body_pong(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) { case 0: break; case B_PONG + 0x10: goto L1; default: abort(); }
+    frame_push(ctx);
+    R(30) = 0;
+    while (R(30) < PRMV(P_NAB)) {
+        while (vm_read64(TURN) != 1) {
+            R(3) = 300;
+            SC(SYS_TIMER_USLEEP, B_PONG + 0x10);
+L1:         ;
+        }
+        vm_write64(Y, (vm_read64(Y) ^ vm_read64(X)) * FNV + R(30));
+        R(30)++;
+        vm_write64(TURN, 0);
+    }
+    frame_pop(ctx);
+}
+/* kobj, guest main: idle (usleep polling) until STAGE is 1 */
+static void body_idle(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) { case 0: break; case B_IDLE + 0x10: goto L1; default: abort(); }
+    frame_push(ctx);
+    while (vm_read64(STAGE) != 1) {
+        R(3) = 300;
+        SC(SYS_TIMER_USLEEP, B_IDLE + 0x10);
+L1:     ;
+    }
+    frame_pop(ctx);
+}
+/* kobj, the waiter: lock; WREADY; wait on the lwcond until FLAG2 is 1; X2 = VAL2; FLAG2 = 0; unlock */
+static void body_lwwait(ppu_context* ctx, uint32_t ra)
+{
+    switch (ra) {
+    case 0: break; case B_LWWAIT + 0x10: goto L1; case B_LWWAIT + 0x20: goto L2; case B_LWWAIT + 0x30: goto L3;
+    default: abort();
+    }
+    frame_push(ctx);
+    R(3) = LWM_EA; R(4) = 0;
+    HLE(F_LOCK, B_LWWAIT + 0x10);
+L1:
+    vm_write32(WREADY, 1);
+    while (vm_read32(FLAG2) != 1) {
+        R(3) = CF_EA; R(4) = 0;
+        HLE(F_WAIT, B_LWWAIT + 0x20);
+L2:     ;
+    }
+    vm_write32(X2, vm_read32(VAL2));
+    vm_write32(FLAG2, 0);
+    R(3) = LWM_EA;
+    HLE(F_UNLOCK, B_LWWAIT + 0x30);
+L3:
+    frame_pop(ctx);
+}
+
+static void bodies_register(void)
+{
+    entry_add(B_CONS, [](ppu_context* c) { body_cons(c, 0); });
+    entry_add(B_LWCONS, [](ppu_context* c) { body_lwcons(c, 0); });
+    entry_add(B_LWPROD, [](ppu_context* c) { body_lwprod(c, 0); });
+    entry_add(B_SLEEP, [](ppu_context* c) { body_sleep(c, 0); });
+    entry_add(B_PONG, [](ppu_context* c) { body_pong(c, 0); });
+    ct_add(B_PROD + 0x10, B_PROD, cont_at<body_prod, B_PROD + 0x10>, G_SC, 0);
+    ct_add(B_PROD + 0x20, B_PROD, cont_at<body_prod, B_PROD + 0x20>, G_SC, 0);
+    ct_add(B_PROD + 0x30, B_PROD, cont_at<body_prod, B_PROD + 0x30>, G_SC, 0);
+    ct_add(B_CONS + 0x10, B_CONS, cont_at<body_cons, B_CONS + 0x10>, G_SC, 0);
+    ct_add(B_CONS + 0x20, B_CONS, cont_at<body_cons, B_CONS + 0x20>, G_SC, 0);
+    ct_add(B_LWCONS + 0x10, B_LWCONS, cont_at<body_lwcons, B_LWCONS + 0x10>, G_HLE, 0);
+    ct_add(B_LWCONS + 0x20, B_LWCONS, cont_at<body_lwcons, B_LWCONS + 0x20>, G_HLE, 0);
+    ct_add(B_LWCONS + 0x30, B_LWCONS, cont_at<body_lwcons, B_LWCONS + 0x30>, G_HLE, 0);
+    ct_add(B_LWCONS + 0x40, B_LWCONS, cont_at<body_lwcons, B_LWCONS + 0x40>, G_HLE, 0);
+    ct_add(B_LWPROD + 0x10, B_LWPROD, cont_at<body_lwprod, B_LWPROD + 0x10>, G_HLE, 0);
+    ct_add(B_LWPROD + 0x20, B_LWPROD, cont_at<body_lwprod, B_LWPROD + 0x20>, G_HLE, 0);
+    ct_add(B_LWPROD + 0x30, B_LWPROD, cont_at<body_lwprod, B_LWPROD + 0x30>, G_HLE, 0);
+    ct_add(B_LWPROD + 0x40, B_LWPROD, cont_at<body_lwprod, B_LWPROD + 0x40>, G_HLE, 0);
+    ct_add(B_SLEEP + 0x10, B_SLEEP, cont_at<body_sleep, B_SLEEP + 0x10>, G_SC, 0);
+    ct_add(B_PING + 0x10, B_PING, cont_at<body_ping, B_PING + 0x10>, G_SC, 0);
+    ct_add(B_PONG + 0x10, B_PONG, cont_at<body_pong, B_PONG + 0x10>, G_SC, 0);
+    entry_add(B_LWWAIT, [](ppu_context* c) { body_lwwait(c, 0); });
+    ct_add(B_IDLE + 0x10, B_IDLE, cont_at<body_idle, B_IDLE + 0x10>, G_SC, 0);
+    ct_add(B_LWWAIT + 0x10, B_LWWAIT, cont_at<body_lwwait, B_LWWAIT + 0x10>, G_HLE, 0);
+    ct_add(B_LWWAIT + 0x20, B_LWWAIT, cont_at<body_lwwait, B_LWWAIT + 0x20>, G_HLE, 0);
+    ct_add(B_LWWAIT + 0x30, B_LWWAIT, cont_at<body_lwwait, B_LWWAIT + 0x30>, G_HLE, 0);
+}
+
+/* ---------------- guest main: the process's main thread (ppu_loader.cpp's root) ---------------- */
+static ppu_context g_main_ctx;
+static jmp_buf g_main_root;
+static void (*g_main_body)(ppu_context*, uint32_t);
+static volatile LONG g_main_discards;
+static unsigned __stdcall main_proc(void*)
+{
+    ppu_thread_register_main();
+    memset(&g_main_ctx, 0, sizeof g_main_ctx);
+    g_main_ctx.thread_id = 1;
+    g_main_ctx.gpr[1] = MAIN_SP;
+    g_ppu_main_ctx = &g_main_ctx;
+    set_ppu_ops(GetCurrentThreadId());
+    g_active_ctx = &g_main_ctx;
+    ss_root_enter(&g_main_root, &g_main_ctx);
+    switch (setjmp(g_main_root)) {
+    case 0:
+        g_main_body(&g_main_ctx, 0);
+        drain(&g_main_ctx);
+        break;
+    case SS_ROOT_DISCARD:                 /* a load: wait at the gate, resume from the image's record */
+        InterlockedIncrement(&g_main_discards);
+        g_trampoline_fn = 0;
+        g_ppu_bridge_depth = 0;
+        g_active_ctx = &g_main_ctx;
+        ss_root_load_run(1);
+        break;
+    default:
+        abort();                          /* (P0 is not armed here) */
+    }
+    ss_root_leave();
+    ss_transition_begin(SS_TR_PPU_THREAD);
+    g_ppu_threads[0].state = PPU_THREAD_STATE_FINISHED;
+    ss_transition_end(SS_TR_PPU_THREAD);
+    return 0;
+}
+
+/* ---------------- an SPU host thread (lv2_register.c's shape) ---------------- */
+struct FakeSpu { uint32_t id; };
+static FakeSpu g_spu = { 0x2000 };
+static volatile LONG g_spu_threads;
+static void spu_describe(const void* c, ss_spu_desc* d)
+{
+    memset(d, 0, sizeof *d);
+    d->spu_id = ((const FakeSpu*)c)->id;
+    d->pc = vm_read32(SPU_CNT) & 0x3FFFC;
+    d->image_id = 7;
+}
+static void spu_force(int) {}
+static const ss_spu_ops k_spu_ops = { spu_describe, spu_force };
+static uint32_t g_spu_n;
+static unsigned __stdcall spu_proc(void* resumed)
+{
+    InterlockedIncrement(&g_spu_threads);
+    ss_spu_thread_begin(&g_spu, g_spu.id, 0x1000, SS_SPU_LIFTED, &k_spu_ops);
+    ss_transition_end(SS_TR_SPU_THREAD);
+    jmp_buf discard;
+    if (setjmp(discard) == SS_ROOT_DISCARD) return 0;    /* (ss_core unregistered it) */
+    ss_spu_set_root(&discard);
+    if (resumed) ss_load_gate_wait();
+    for (;;) {
+        const uint32_t n = vm_read32(SPU_CNT);
+        if (n >= g_spu_n) break;
+        vm_write32(SPU_CNT, n + 1);                        /* its work: a count in guest memory */
+        const uint64_t t = ps3_qpc_us();
+        while (ps3_qpc_us() - t < 200) YieldProcessor();
+        if (SS_SPU_PENDING()) ss_spu_park_point(&g_spu, SS_SPU_AT_HOP);
+    }
+    ss_spu_set_root(NULL);
+    ss_transition_begin(SS_TR_SPU_THREAD);
+    vm_write32(SPU_DONE, 1);
+    ss_spu_thread_end();
+    ss_transition_end(SS_TR_SPU_THREAD);
+    return 0;
+}
+static void spu_start(int resumed)
+{
+    ss_transition_begin(SS_TR_SPU_THREAD);                /* until it registers */
+    HANDLE h = (HANDLE)_beginthreadex(NULL, 0, spu_proc, (void*)(intptr_t)resumed, 0, NULL);
+    if (h) CloseHandle(h);
+}
+/* RECREATE (ss_set_spu_recreate): the SPU the restored guest memory says runs */
+static int spu_recreate(char* why, size_t n)
+{
+    (void)why; (void)n;
+    if (vm_read32(SPU_DONE)) return 0;
+    spu_start(1);
+    return 1;
+}
+
+/* ---------------- the modes ---------------- */
+static int wait_until(uint64_t (*pred)(void), unsigned ms)
+{
+    const uint64_t end = now_ms() + ms;
+    while (!pred()) { if (now_ms() > end) return 0; Sleep(2); }
+    return 1;
+}
+static int g_tids[8], g_nt;
+static uint64_t all_done(void)
+{
+    for (int i = 0; i < g_nt; i++) if (thread_state((unsigned)g_tids[i]) != PPU_THREAD_STATE_FINISHED) return 0;
+    return g_ppu_threads[0].state == PPU_THREAD_STATE_FINISHED && vm_read32(SPU_DONE);
+}
+static void join_all(void) { for (int i = 0; i < g_nt; i++) hsc(sys_ppu_thread_join, (uint64_t)g_tids[i], 0); }
+static uint64_t sleeps_expected(void) { return PRMV(P_N3); }
+
+static int mode_rt(void)
+{
+    const uint64_t N = 3000, N2 = 100000, N3 = 3000;    /* (about 3 s each) */
+    g_spu_n = 15000;
+    vm_write64(PARAM + 8 * P_N, N); vm_write64(PARAM + 8 * P_N2, N2); vm_write64(PARAM + 8 * P_N3, N3);
+    vm_write64(PARAM + 8 * P_SEM, mk(sys_semaphore_create, ATTR, 1, 1));
+    const uint32_t q = mk(sys_event_queue_create, ATTR, 0x77, 64);
+    vm_write32(ID_OUT, 0);
+    hsc(sys_event_port_create, ID_OUT, 1, 0x5254ull);
+    const uint32_t port = vm_read32(ID_OUT);
+    CHECK(hsc(sys_event_port_connect_local, port, q) == 0, "connect");
+    vm_write64(PARAM + 8 * P_PORT, port); vm_write64(PARAM + 8 * P_QUEUE, q);
+    hhle(hle_by_name("sys_lwmutex_create"), LWM_EA, 0);
+    hhle(hle_by_name("sys_lwcond_create"), CF_EA, LWM_EA);
+    hhle(hle_by_name("sys_lwcond_create"), CE_EA, LWM_EA);
+
+    g_main_body = body_prod;
+    HANDLE hm = (HANDLE)_beginthreadex(NULL, 0, main_proc, NULL, 0, NULL);
+    Sleep(20);
+    g_tids[g_nt++] = (int)spawn(B_CONS, 0, "consumer");
+    g_tids[g_nt++] = (int)spawn(B_LWCONS, 0, "lw consumer");
+    g_tids[g_nt++] = (int)spawn(B_LWPROD, 0, "lw producer");
+    g_tids[g_nt++] = (int)spawn(B_SLEEP, 0, "sleeper");
+    spu_start(0);
+
+    int loads = 0, refused = 0, bad = 0;
+    unsigned spu_rec = 0;
+    double pmax = 0, psum = 0;
+    while (!all_done() && vm_read64(PROG) + 40 < N) {
+        ss_request_result o;
+        memset(&o, 0, sizeof o);
+        const int r = request(SS_P_SELFTEST, SS_RQ_VERIFY, nullptr, 2.0, &o);
+        if (r == 0) {
+            loads++;
+            spu_rec += o.spu_recreated;
+            psum += o.pause_ms;
+            if (o.pause_ms > pmax) pmax = o.pause_ms;
+            CHECK(o.verified && o.verify_differ == 0, "round trip %d: fidelity check: %u of %u sections differ",
+                  loads, o.verify_differ, o.verify_compared);
+            if (!o.verified || o.verify_differ) bad++;
+        } else {
+            refused++;
+            CHECK(r == SS_REASON_THREAD_BUSY || r == SS_REASON_TRANSITION,
+                  "round trip refused for an unexpected reason %d (%s): %s", r, ss_reason_name(r), o.why);
+        }
+        Sleep(30);
+    }
+    printf("[rt] %d round trips loaded (%d refused), pause avg %.1f ms max %.1f ms; main discarded %ld time(s),"
+           " the SPU recreated %u time(s)\n", loads, refused, loads ? psum / loads : 0.0, pmax, g_main_discards,
+           spu_rec);
+    CHECK(wait_until(all_done, 30000), "the world did not finish (main %d, SPU done %u)",
+          g_ppu_threads[0].state, vm_read32(SPU_DONE));
+    WaitForSingleObject(hm, 5000);
+    uint64_t hm1 = 0, hc = 0, hl = 0;
+    for (uint64_t i = 0; i < N; i++) { hm1 = hm1 * 31 + i + 1; hc = (hc ^ i) * FNV + hm1; }
+    for (uint64_t i = 0; i < N2; i++) hl = hl * 131 + (i * 7 + 1);
+    CHECK(vm_read64(H_MAIN) == hm1, "main's hash 0x%llX, not 0x%llX", (unsigned long long)vm_read64(H_MAIN),
+          (unsigned long long)hm1);
+    CHECK(vm_read64(H_CONS) == hc, "the consumer's hash 0x%llX, not 0x%llX", (unsigned long long)vm_read64(H_CONS),
+          (unsigned long long)hc);
+    CHECK(vm_read64(H_LW) == hl, "the lwcond hash 0x%llX, not 0x%llX", (unsigned long long)vm_read64(H_LW),
+          (unsigned long long)hl);
+    CHECK(vm_read64(SLEEPS) == sleeps_expected(), "%llu sleeps, not %llu", (unsigned long long)vm_read64(SLEEPS),
+          (unsigned long long)sleeps_expected());
+    CHECK(vm_read32(SPU_CNT) == g_spu_n, "the SPU counted %u, not %u", vm_read32(SPU_CNT), g_spu_n);
+    CHECK(loads >= 10, "only %d round trips loaded", loads);
+    CHECK(g_main_discards == loads, "main was discarded %ld times for %d loads", g_main_discards, loads);
+    CHECK(spu_rec >= 1 && (long)spu_rec + 1 == g_spu_threads, "the SPU recreated %u times, %ld host threads",
+          spu_rec, g_spu_threads);
+    join_all();
+    printf("[rt] results: main 0x%016llX consumer 0x%016llX lwcond 0x%016llX sleeps %llu spu %u -- %s\n",
+           (unsigned long long)vm_read64(H_MAIN), (unsigned long long)vm_read64(H_CONS),
+           (unsigned long long)vm_read64(H_LW), (unsigned long long)vm_read64(SLEEPS), vm_read32(SPU_CNT),
+           g_fail ? "WRONG" : "as an uninterrupted run");
+    return g_fail;
+}
+
+static uint64_t g_prog_cap;                           /* PROG at the last stop's capture hook */
+static void on_capture_ab(void* u) { on_capture(u); g_prog_cap = vm_read64(PROG); }
+static uint64_t g_wait_prog;
+static uint64_t prog_reached(void) { return vm_read64(PROG) >= g_wait_prog; }
+
+static int mode_ab(void)
+{
+    const uint64_t NAB = 1500, N3 = 1500;
+    g_spu_n = 8000;
+    vm_write64(PARAM + 8 * P_NAB, NAB); vm_write64(PARAM + 8 * P_N3, N3);
+    g_ss_on_capture = on_capture_ab;
+    g_main_body = body_ping;
+    HANDLE hm = (HANDLE)_beginthreadex(NULL, 0, main_proc, NULL, 0, NULL);
+    Sleep(20);
+    g_tids[g_nt++] = (int)spawn(B_PONG, 0, "pong");
+    g_tids[g_nt++] = (int)spawn(B_SLEEP, 0, "sleeper");
+    spu_start(0);
+
+    /* A: saved and held at a quarter of the way */
+    g_wait_prog = NAB / 4;
+    CHECK(wait_until(prog_reached, 20000), "no progress to A");
+    ss_request_result o;
+    memset(&o, 0, sizeof o);
+    int r = request(SS_P_SAVE, SS_RQ_HOLD, nullptr, 5.0, &o);
+    CHECK(r == 0 && ss_image_held(), "SAVE A: %d (%s) %s", r, ss_reason_name(r), o.why);
+    const uint64_t prog_a = g_prog_cap;
+    /* B: half way */
+    g_wait_prog = NAB / 2;
+    CHECK(wait_until(prog_reached, 20000), "no progress to B");
+    memset(&o, 0, sizeof o);
+    r = request(SS_P_LOAD, SS_RQ_VERIFY, ss_image_held(), 5.0, &o);
+    const uint64_t prog_b = g_prog_cap;
+    CHECK(r == 0, "LOAD A: %d (%s) %s", r, ss_reason_name(r), o.why);
+    CHECK(o.verified && o.verify_compared > 0 && o.verify_differ == 0,
+          "LOAD A: fidelity check %s, %u of %u sections differ", o.verified ? "ran" : "did not run",
+          o.verify_differ, o.verify_compared);
+    CHECK(o.ppu_recreated >= 2 && g_main_discards == 1, "LOAD A: %u PPU threads recreated, main discarded %ld",
+          o.ppu_recreated, g_main_discards);
+    CHECK(prog_b > prog_a, "B (%llu) is not past A (%llu)", (unsigned long long)prog_b, (unsigned long long)prog_a);
+    printf("[ab] A saved at iteration %llu, loaded at B = %llu: pause %.1f ms (discard %.1f, teardown %.1f,"
+           " restore %.1f, verify %.1f, recreate %.1f); %u PPU + %u SPU thread(s) recreated, %u sections equal\n",
+           (unsigned long long)prog_a, (unsigned long long)prog_b, o.pause_ms, o.discard_ms, o.teardown_ms,
+           o.restore_ms, o.verify_ms, o.recreate_ms, o.ppu_recreated, o.spu_recreated, o.verify_compared);
+    CHECK(wait_until(all_done, 30000), "the world did not finish after the load (main %d)", g_ppu_threads[0].state);
+    WaitForSingleObject(hm, 5000);
+    uint64_t x = 0, y = 0;
+    for (uint64_t i = 0; i < NAB; i++) { x = x * 31 + i + 1; y = (y ^ x) * FNV + i; }
+    CHECK(vm_read64(X) == x && vm_read64(Y) == y, "X 0x%llX Y 0x%llX, not 0x%llX 0x%llX",
+          (unsigned long long)vm_read64(X), (unsigned long long)vm_read64(Y), (unsigned long long)x,
+          (unsigned long long)y);
+    CHECK(vm_read64(SLEEPS) == N3, "%llu sleeps, not %llu", (unsigned long long)vm_read64(SLEEPS),
+          (unsigned long long)N3);
+    CHECK(vm_read32(SPU_CNT) == g_spu_n, "the SPU counted %u, not %u", vm_read32(SPU_CNT), g_spu_n);
+    /* main ran every iteration once, and those between A and B twice */
+    const long again = (long)g_ping_iters - (long)NAB;
+    CHECK(again >= (long)(prog_b - prog_a) - 1 && again <= (long)(prog_b - prog_a) + 1,
+          "main ran %ld iterations, %ld more than %llu; B - A = %llu", (long)g_ping_iters, again,
+          (unsigned long long)NAB, (unsigned long long)(prog_b - prog_a));
+    join_all();
+    printf("[ab] results: X 0x%016llX Y 0x%016llX sleeps %llu spu %u; main ran %ld iterations (%ld again: B - A"
+           " = %llu) -- %s\n", (unsigned long long)vm_read64(X), (unsigned long long)vm_read64(Y),
+           (unsigned long long)vm_read64(SLEEPS), vm_read32(SPU_CNT), (long)g_ping_iters, again,
+           (unsigned long long)(prog_b - prog_a), g_fail ? "WRONG" : "as an uninterrupted run");
+    return g_fail;
+}
+
+/* ---------------- kobj: every kernel object changed between A and B ---------------- */
+extern "C" {
+int64_t sys_event_queue_tryreceive(ppu_context*);
+int64_t sys_timer_create(ppu_context*);  int64_t sys_timer_connect_event_queue(ppu_context*);
+int64_t sys_timer_start(ppu_context*);   int64_t sys_timer_stop(ppu_context*);
+}
+static const int64_t K_ESRCH = (int64_t)(int32_t)CELL_ESRCH;
+/* an HLE call as guest thread `tid` (a second "host" holder for the lwmutexes) */
+static uint64_t hhle_as(unsigned tid, const HleFn* f, uint64_t a0 = 0, uint64_t a1 = 0)
+{
+    ppu_context c;
+    memset(&c, 0, sizeof c);
+    c.thread_id = tid;
+    c.gpr[3] = a0; c.gpr[4] = a1;
+    f->fn(&c);
+    return c.gpr[3];
+}
+static int64_t sem_value(uint32_t sem)
+{
+    vm_write32(ID_OUT, 0xDEADu);
+    const int64_t r = hsc(sys_semaphore_get_value, sem, ID_OUT);
+    return r ? r : (int64_t)(int32_t)vm_read32(ID_OUT);
+}
+/* events taken from queue q (up to 8, into EVTBUF2): how many, or the error */
+static int64_t take_events(uint32_t q, int32_t max)
+{
+    vm_write32(ID_OUT, 0);
+    const int64_t r = hsc(sys_event_queue_tryreceive, q, EVTBUF2, (uint64_t)max, ID_OUT);
+    return r ? r : (int64_t)vm_read32(ID_OUT);
+}
+static unsigned g_wtid, g_t2;
+static uint64_t waiter_ready(void) { return vm_read32(WREADY); }
+static uint64_t waiter_done(void) { return thread_state(g_wtid) == PPU_THREAD_STATE_FINISHED; }
+static uint64_t t2_done(void) { return thread_state(g_t2) == PPU_THREAD_STATE_FINISHED; }
+
+static int mode_kobj(void)
+{
+    const HleFn* F_CREATE = hle_by_name("sys_lwmutex_create");
+    const HleFn* F_TRY = hle_by_name("sys_lwmutex_trylock");
+    const HleFn* F_CCREATE = hle_by_name("sys_lwcond_create");
+    vm_write32(SPU_DONE, 1);                              /* (no SPU in this mode: nothing to recreate) */
+    g_main_body = body_idle;
+    HANDLE hm = (HANDLE)_beginthreadex(NULL, 0, main_proc, NULL, 0, NULL);
+    Sleep(20);
+
+    /* ---- A ---- */
+    const uint32_t sem = mk(sys_semaphore_create, ATTR, 1, 5);
+    hsc(sys_semaphore_post, sem, 1);                                       /* value 2 */
+    const uint32_t q = mk(sys_event_queue_create, ATTR, 0x99, 8);
+    vm_write32(ID_OUT, 0);
+    hsc(sys_event_port_create, ID_OUT, 1, 0x4B4Full);
+    const uint32_t port = vm_read32(ID_OUT);
+    CHECK(hsc(sys_event_port_connect_local, port, q) == 0, "connect");
+    for (uint64_t i = 0; i < 5; i++) hsc(sys_event_port_send, port, 100 + i, 200 + i, 300 + i);
+    CHECK(take_events(q, 2) == 2, "two events taken at A");               /* head 2, count 3 */
+    const uint32_t flag = mk(sys_event_flag_create, ATTR, 0x5);
+    hhle(F_CREATE, LWM1_EA, 0);
+    CHECK(hhle(F_LOCK, LWM1_EA, 0) == 0, "M1 taken at A");                /* held by tid 80 */
+    hhle(F_CREATE, LWM_EA, 0);                                             /* the waiter's mutex */
+    hhle(F_CREATE, LWM3_EA, 0);                                            /* free at A */
+    hhle(F_CCREATE, CF_EA, LWM_EA);
+    const uint32_t lwc_id_a = vm_read32(CF_EA + 4);
+    /* registry entries that wrap round the end of the table (the capture's order must put each back
+     * in its slot, or the capture after the load lists them differently): the odd ones taken */
+    for (uint32_t i = 0; i < 5; i++) {
+        hhle(F_CREATE, WRAP_LWM + 0x10000u * i, 0);
+        if (i & 1) CHECK(hhle(F_LOCK, WRAP_LWM + 0x10000u * i, 0) == 0, "wrap lwmutex %u taken", i);
+        hhle(F_SIGNAL, WRAP_LWC + 0x1000u * i);                           /* (a registry entry, no waiter) */
+    }
+    g_wtid = spawn(B_LWWAIT, 0, "lwcond waiter");
+    CHECK(wait_until(waiter_ready, 5000), "the waiter did not start");
+    Sleep(60);                                                             /* (into its lwcond wait) */
+    const vm_stack_alloc stacks_a = g_vm_stack_alloc;
+    seen_clear();
+    ss_request_result o;
+    memset(&o, 0, sizeof o);
+    int r = request(SS_P_SAVE, SS_RQ_HOLD, nullptr, 5.0, &o);
+    CHECK(r == 0 && ss_image_held(), "SAVE A: %d (%s) %s", r, ss_reason_name(r), o.why);
+    CHECK(g_seen[g_wtid].valid && g_seen[g_wtid].at == SS_IN_WAIT && g_seen[g_wtid].num == SS_W_LWCOND,
+          "the waiter is not parked in its lwcond wait at A (at %d, kind %u)", g_seen[g_wtid].at, g_seen[g_wtid].num);
+
+    /* ---- B: every one of them changed, and new ones ---- */
+    hsc(sys_semaphore_post, sem, 3);                                       /* value 5 */
+    const uint32_t sem2 = mk(sys_semaphore_create, ATTR, 0, 3);
+    CHECK(take_events(q, 8) == 3, "A's three events at B");
+    hsc(sys_event_port_send, port, 900, 901, 902);
+    const uint32_t q2 = mk(sys_event_queue_create, ATTR, 0x9A, 4);
+    hsc(sys_event_flag_set, flag, 0xF0);
+    hhle(F_UNLOCK, LWM1_EA);                                               /* M1 free */
+    CHECK(hhle(F_LOCK, LWM3_EA, 0) == 0, "M3 taken at B");                /* M3 held */
+    hhle(F_CREATE, LWM5_EA, 0);
+    CHECK(hhle(F_LOCK, LWM5_EA, 0) == 0, "M5 taken at B");                /* a new registry slot, taken */
+    hhle(F_CCREATE, CB_EA, LWM3_EA);                                       /* the lwcond id moves on */
+    vm_write32(VAL2, 7);
+    vm_write32(FLAG2, 1);
+    hhle(F_SIGNAL, CF_EA);                                                 /* the waiter ends */
+    CHECK(wait_until(waiter_done, 5000), "the waiter did not finish at B");
+    CHECK(vm_read32(X2) == 7, "X2 %u at B, not 7", vm_read32(X2));
+    vm_write64(PARAM + 8 * P_N3, 3);
+    g_t2 = spawn(B_SLEEP, 0, "B's thread");                               /* a thread (and a stack) more */
+    CHECK(wait_until(t2_done, 5000), "B's thread did not finish");
+    const uint32_t tm = mk(sys_timer_create);
+    hsc(sys_timer_connect_event_queue, tm, q2, 1, 2);
+    CHECK(hsc(sys_timer_start, tm, 0, 1000) == 0, "the timer did not start");
+    const uint32_t mx = mk(sys_mutex_create, ATTR);
+    CHECK(hsc(sys_mutex_lock, mx, 0) == 0, "the sys_mutex not taken");
+    const uint32_t cx = mk(sys_cond_create, mx, ATTR);
+    Sleep(20);
+    CHECK(g_vm_stack_alloc.next_addr != stacks_a.next_addr, "B's thread took no stack");
+
+    /* ---- LOAD A ---- */
+    memset(&o, 0, sizeof o);
+    r = request(SS_P_LOAD, SS_RQ_VERIFY, ss_image_held(), 5.0, &o);
+    CHECK(r == 0, "LOAD A: %d (%s) %s", r, ss_reason_name(r), o.why);
+    CHECK(o.verified && o.verify_compared > 0 && o.verify_differ == 0,
+          "LOAD A: fidelity check %s, %u of %u sections differ", o.verified ? "ran" : "did not run",
+          o.verify_differ, o.verify_compared);
+    printf("[kobj] loaded A: pause %.1f ms (teardown %.1f, restore %.1f, verify %.1f); %u PPU thread(s) recreated,"
+           " %u sections equal\n", o.pause_ms, o.teardown_ms, o.restore_ms, o.verify_ms, o.ppu_recreated,
+           o.verify_compared);
+
+    /* A's values */
+    CHECK(sem_value(sem) == 2, "semaphore %u holds %lld, not A's 2", sem, (long long)sem_value(sem));
+    CHECK(sem_value(sem2) == K_ESRCH, "B's semaphore %u is still there (%lld)", sem2, (long long)sem_value(sem2));
+    const int64_t ne = take_events(q, 8);
+    CHECK(ne == 3, "queue %u hands out %lld event(s), not A's 3", q, (long long)ne);
+    for (uint32_t i = 0; i < 3 && ne == 3; i++) {
+        const uint32_t b = EVTBUF2 + 32u * i;
+        CHECK(vm_read64(b) == 0x4B4Full && vm_read64(b + 8) == 102 + i && vm_read64(b + 16) == 202 + i &&
+              vm_read64(b + 24) == 302 + i, "event %u: %llX %llu %llu %llu", i, (unsigned long long)vm_read64(b),
+              (unsigned long long)vm_read64(b + 8), (unsigned long long)vm_read64(b + 16),
+              (unsigned long long)vm_read64(b + 24));
+    }
+    CHECK(take_events(q2, 8) == K_ESRCH, "B's queue %u is still there", q2);
+    vm_write64(ID_OUT, 0);
+    CHECK(hsc(sys_event_flag_get, flag, ID_OUT) == 0 && vm_read64(ID_OUT) == 0x5, "the event flag holds 0x%llX",
+          (unsigned long long)vm_read64(ID_OUT));
+    /* A's lwmutex holders: M1 taken (by tid 80), M3 free; M5 (B's) gone with its slot */
+    CHECK(hhle_as(81, F_TRY, LWM1_EA) != 0, "M1 is free after the load");
+    CHECK(hhle_as(81, F_TRY, LWM3_EA) == 0, "M3 is still taken after the load");
+    CHECK(hhle_as(81, F_TRY, LWM5_EA) == 0, "M5's slot kept B's count");
+    hhle_as(81, F_UNLOCK, LWM3_EA);
+    hhle_as(81, F_UNLOCK, LWM5_EA);
+    for (uint32_t i = 0; i < 5; i++) {
+        const uint64_t t = hhle_as(81, F_TRY, WRAP_LWM + 0x10000u * i);
+        CHECK((t != 0) == ((i & 1) != 0), "wrap lwmutex %u: %s after the load", i, t ? "taken" : "free");
+        if (!t) hhle_as(81, F_UNLOCK, WRAP_LWM + 0x10000u * i);
+    }
+    /* the allocators where A left them */
+    hhle(F_CCREATE, CC_EA, LWM3_EA);
+    CHECK(vm_read32(CC_EA + 4) == lwc_id_a + 1, "lwcond id 0x%X, not A's next 0x%X", vm_read32(CC_EA + 4),
+          lwc_id_a + 1);
+    CHECK(g_vm_stack_alloc.next_addr == stacks_a.next_addr, "the stack bump 0x%X, not A's 0x%X",
+          g_vm_stack_alloc.next_addr, stacks_a.next_addr);
+    CHECK(thread_state(g_t2) == PPU_THREAD_STATE_FREE, "B's thread's slot is %d", thread_state(g_t2));
+    /* what a save refuses is gone: the timer (its thread stopped), the sys_mutex, the sys_cond */
+    CHECK(hsc(sys_timer_stop, tm) == K_ESRCH, "the timer %u is still there", tm);
+    CHECK(hsc(sys_mutex_lock, mx, 1000) == K_ESRCH, "the sys_mutex %u is still there", mx);
+    CHECK(hsc(sys_cond_signal, cx) == K_ESRCH, "the sys_cond %u is still there", cx);
+
+    /* the waiter is back in its wait, registered: one signal ends it */
+    CHECK(thread_state(g_wtid) == PPU_THREAD_STATE_RUNNING, "the waiter's slot is %d", thread_state(g_wtid));
+    vm_write32(VAL2, 9);
+    vm_write32(FLAG2, 1);
+    hhle(F_SIGNAL, CF_EA);
+    CHECK(wait_until(waiter_done, 5000), "the waiter did not resume and finish (its registration lost?)");
+    CHECK(vm_read32(X2) == 9, "X2 %u, not 9", vm_read32(X2));
+    vm_write64(STAGE, 1);
+    WaitForSingleObject(hm, 5000);
+    CHECK(g_ppu_threads[0].state == PPU_THREAD_STATE_FINISHED, "main did not finish");
+    hsc(sys_ppu_thread_join, g_wtid, 0);
+    printf("[kobj] results: semaphore 2, A's 3 events, flag 0x5, M1 taken, M3 free, B's objects gone, the waiter"
+           " resumed and got 9 -- %s\n", g_fail ? "WRONG" : "as at A");
+    return g_fail;
+}
+
+int main(int argc, char** argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    const char* mode = argc > 1 ? argv[1] : "all";
+    if (!strcmp(mode, "all")) {
+        int f = 0;
+        for (const char* m : { "rt", "ab", "kobj" }) {
+            const intptr_t rc = _spawnl(_P_WAIT, argv[0], argv[0], m, NULL);
+            printf("[test] %s -> exit %d\n", m, (int)rc);
+            f += rc != 0;
+        }
+        printf("%s: in-process load round trips and A-B (%d mode(s) failed)\n", f ? "FAIL" : "PASS", f);
+        return f ? 1 : 0;
+    }
+    _putenv_s("PS3_LWCOND_SAFETY_MS", "0");
+    bodies_register();
+    entry_add(B_PROD, [](ppu_context* c) { body_prod(c, 0); });
+    entry_add(B_PING, [](ppu_context* c) { body_ping(c, 0); });
+    world_start();
+    F_LOCK = hle_by_name("sys_lwmutex_lock");  F_UNLOCK = hle_by_name("sys_lwmutex_unlock");
+    F_WAIT = hle_by_name("sys_lwcond_wait");   F_SIGNAL = hle_by_name("sys_lwcond_signal");
+    ss_set_spu_recreate(spu_recreate);
+    Sleep(50);
+    const int f = !strcmp(mode, "rt") ? mode_rt() : !strcmp(mode, "ab") ? mode_ab() :
+                  !strcmp(mode, "kobj") ? mode_kobj() : 1;
+    world_stop();
+    printf("%s: %s (%d failure%s)\n", f ? "FAIL" : "PASS", mode, g_fail, g_fail == 1 ? "" : "s");
+    fflush(stdout);
+    _exit(f ? 1 : 0);
+}
diff --git a/runtime/savestate/tests/test_ss_selfresume.cpp b/runtime/savestate/tests/test_ss_selfresume.cpp
new file mode 100644
index 0000000..55f77b1
--- /dev/null
+++ b/runtime/savestate/tests/test_ss_selfresume.cpp
@@ -0,0 +1,565 @@
+/*
+ * Regression test for save states P0, per-thread SELF-RESUME in process:
+ * runtime/savestate/ss_core.c (requests, eligibility at the S1/S2 entries,
+ * thread roots, the longjmp, the restore, the counters) with
+ * runtime/ppu/ppu_selfresume.cpp (the chain check, re-issue + continuations)
+ * and runtime/ppu/ppu_resume.cpp, on the continuation proof-of-concept guest
+ * of runtime/ppu/tests/test_cont_resume.cpp: two guest threads run a frame
+ * barrier through an HLE call (main, whose chain goes through a vtable call
+ * made from a tail fragment) and an inline `sc` (worker), 400000 rounds,
+ * folding every result into two hashes.
+ *
+ * Each guest thread runs under a ROOT built the way the scaffold builds one
+ * (ss_root_enter + switch (setjmp) + ss_root_resume), and its HLE / syscall
+ * entries call SS_SAFEPOINT as ps3_hle_call / lv2_syscall do. A requester
+ * asks both threads to resume again and again; each time a thread throws away
+ * its whole host stack, comes back to its root, and continues from its guest
+ * stack alone. The final hashes must still be the study's reference values
+ * (main CBE47D7BB88F303D, worker 02AD1D424229760D, counter 400000).
+ *
+ * Modes (the default, "all", runs the first four in child processes):
+ *   off        P0 not armed, SS_SAFEPOINT in place: the reference, no request
+ *   on         armed; a requester asks both threads continuously: thousands
+ *              of resumes, every one of the chain's frames rebuilt, no
+ *              refusal, the context unchanged between park and root, the
+ *              root's host frame never moving
+ *   timer      armed with SS_SELFRESUME's own timer (1 ms): resumes happen
+ *   neg        the check on captured entry contexts (resumable; no
+ *              continuation; no return address; wrong root r1; a corrupted
+ *              back chain; with real guest code, a stale saved LR), and every
+ *              reason a requested thread at an S1/S2 entry must NOT resume
+ *              (inside a callback, a trampoline pending, inside a libsre
+ *              bridge, not on its root's context, not covered, refused, no
+ *              return address) -- it stays requested; unarmed hooks inert
+ *   on-legacy  (tools/test_ppu_cont.py, guest lifted with --legacy-indirect-lr,
+ *              which stores neither LR before a bctrl nor sc_ra before an sc)
+ *              the main thread's saved LR is stale: it must be REFUSED
+ *              (stale-lr) every time and never resume; the worker's syscall
+ *              has no return address (no-ra); the result is still the
+ *              reference -- the plan's negative control
+ *
+ * Build and run from external/ps3recomp (the guest is hand-written unless
+ * -DCONT_TEST_LIFTED, which tools/test_ppu_cont.py sets with its lift):
+ *   clang-cl /nologo /std:c++20 /EHsc /O1 /w -D_CRT_SECURE_NO_WARNINGS
+ *            runtime\savestate\tests\test_ss_selfresume.cpp
+ *            runtime\savestate\tests\test_ss_selfresume_glue.c
+ *            runtime\savestate\ss_core.c runtime\savestate\ss_state.c
+ *            runtime\savestate\ss_ui.c /Fe:test_ss_selfresume.exe
+ *   test_ss_selfresume.exe [scratch-dir]
+ * Exit status 0 = pass.
+ */
+#define CONT_TEST_NO_MAIN 1
+#include "../../ppu/tests/test_cont_resume.cpp"
+#include "../../ppu/ppu_selfresume.cpp"
+#include <setjmp.h>
+
+extern "C" void ss_test_thread(unsigned tid, unsigned stack_lo, unsigned stack_hi, const char* name);
+
+static const char* ref_line(char* b, size_t n)
+{
+    snprintf(b, n, "frame=%u main=%016llX worker=%016llX counter=%u", (unsigned)ITER,
+             (unsigned long long)REF_MAIN, (unsigned long long)REF_WORKER, (unsigned)ITER);
+    return b;
+}
+
+/* ---- the scaffold's shape: safepoint at the entries, roots -------------- */
+static void sp_hook(ppu_context* ctx, int kind, uint32_t nid)
+{
+    SS_SAFEPOINT(ctx, kind == PPU_PARK_SC ? SS_AT_SC : SS_AT_HLE, nid, g_trampoline_fn != nullptr);
+}
+
+static jmp_buf g_jb[NT];
+static std::atomic<int> g_root_entries[NT];
+
+static void rooted_thread(int idx, uint32_t entry, uint32_t sp, uint64_t r3)
+{
+    t_idx = idx;
+    ppu_context* ctx = &g_ctx[idx];
+    memset(ctx, 0, sizeof *ctx);
+    ctx->gpr[1] = sp; ctx->gpr[3] = r3; ctx->thread_id = (uint64_t)idx + 1; ctx->lr = 0;
+    g_active_ctx = ctx;
+    ss_root_enter(&g_jb[idx], ctx);
+    switch (setjmp(g_jb[idx])) {
+    case 0: {
+        g_root_entries[idx]++;
+        guest_fn f = lookup_fn(entry);
+        if (!f) abort();
+        f(ctx);
+        drain(ctx);
+        break; }
+    case SS_ROOT_RESUME:
+        g_trampoline_fn = 0;          /* the scaffold's thread-root reset */
+        g_ppu_bridge_depth = 0;
+        ss_root_resume();             /* returns when the entry function returns */
+        break;
+    default:
+        abort();
+    }
+    ss_root_leave();
+}
+
+static void world_threads(void)
+{
+    ss_test_thread(1, MAIN_STACK_LO, MAIN_SP + 48, "main");
+    ss_test_thread(2, WORKER_STACK_LO, WORKER_SP + 48, "worker");
+}
+
+static void print_stats(const char* tag, unsigned tid)
+{
+    ss_sr_stats s;
+    ss_sr_get_stats(tid, &s);
+    printf("[%s] tid=%u requests=%u resumed=%u roots=%u overdue=%u not-covered=%u no-ra=%u callback=%u"
+           " trampoline=%u bridge=%u no-root=%u refused=%u (stale-lr=%u frame-shape=%u root-sp=%u)"
+           " ctx-changed=%u host-sp-drift=%llu frames avg=%.2f max=%d lat-max=%.2fms\n",
+           tag, tid, s.requests, s.resumes, s.roots, s.overdue, s.skip[SS_SR_NOT_COVERED],
+           s.skip[SS_SR_NO_RA], s.skip[SS_SR_CALLBACK], s.skip[SS_SR_TRAMP], s.skip[SS_SR_BRIDGE],
+           s.skip[SS_SR_NO_ROOT], s.skip[SS_SR_REFUSED], s.refused[PPU_RESUME_ERR_LINK],
+           s.refused[PPU_RESUME_ERR_FRAME_SHAPE], s.refused[PPU_RESUME_ERR_ROOT], s.ctx_changed,
+           s.host_sp_drift, s.frames_avg, s.frames_max, s.lat_max_ms);
+    fflush(stdout);
+}
+
+/* ---- off / on / timer / on-legacy -------------------------------------- */
+static int run_mode(const std::string& mode, const char* result_path)
+{
+    init_world();
+    world_threads();
+    std::atomic<bool> done{false};
+    std::thread req;
+    if (mode == "on" || mode == "on-legacy") {
+        ss_sr_configure(0, ~0ull, 0.0, 3);          /* armed, no timer requests: we raise them */
+        req = std::thread([&] {
+            while (!done.load()) {
+                ss_sr_request(1);
+                ss_sr_request(2);
+                const auto t = std::chrono::steady_clock::now();
+                while (std::chrono::steady_clock::now() - t < std::chrono::microseconds(40)) {}
+            }
+        });
+    } else if (mode == "timer") {
+        ss_sr_configure(1, ~0ull, 0.0, 3);          /* SS_SELFRESUME=1 */
+    }
+    /* The scaffold's reservation breakers (ppu_resv_break_store / _line_range:
+     * any other thread's store or SPU commit to a reserved line) write
+     * reserve_addr in EVERY registered context, at any time. Not the thread's
+     * own doing, so never "the context changed between park and root". (The
+     * guest here takes no reservation, so the scribbles change nothing else.) */
+    std::thread resv;
+    if (mode == "on")
+        resv = std::thread([&] {
+            for (uint64_t n = 1; !done.load(); n++)
+                for (int i = 0; i < NT; i++) {
+                    ((volatile uint64_t*)&g_ctx[i].reserve_addr)[0] = 0x10000u + (n & 0xFFF0u);
+                    ((volatile int*)&g_ctx[i].reserve_valid)[0] = (int)(n & 1);
+                }
+        });
+    g_test_entry_hook = sp_hook;
+    const auto t0 = std::chrono::steady_clock::now();
+    std::thread th[NT];
+    th[0] = std::thread(rooted_thread, 0, MAIN_ENTRY, (uint32_t)MAIN_SP, (uint64_t)OBJ);
+    th[1] = std::thread(rooted_thread, 1, WORKER_ENTRY, (uint32_t)WORKER_SP, (uint64_t)0);
+    for (auto& t : th) t.join();
+    if (mode == "atroot-reuse") {
+        /* The kernel hands an exited thread's tid to the next thread it creates
+         * (in game: tid 24 "Splash movie Installation" exits, tid 24 "Game State
+         * Thread" starts). Run the world again on NEW host threads with the same
+         * tids, 64 KB deeper on their host stacks: each resumes once at its root,
+         * and the host-frame drift check must compare a thread's resumes with its
+         * own only -- not with the old thread's stack (it read ~1 MB in game). */
+        g_frame = 0;
+        g_arrived = 0;
+        init_world();
+        for (auto& e : g_root_entries) e = 0;
+        auto deeper = [](int idx, uint32_t entry, uint32_t sp, uint64_t r3) {
+            volatile char pad[65536];
+            pad[0] = 1;
+            pad[sizeof pad - 1] = pad[0];
+            rooted_thread(idx, entry, sp, r3);
+        };
+        th[0] = std::thread(deeper, 0, MAIN_ENTRY, (uint32_t)MAIN_SP, (uint64_t)OBJ);
+        th[1] = std::thread(deeper, 1, WORKER_ENTRY, (uint32_t)WORKER_SP, (uint64_t)0);
+        for (auto& t : th) t.join();
+    }
+    done = true;
+    if (req.joinable()) req.join();
+    if (resv.joinable()) resv.join();
+    const double ms = (double)std::chrono::duration_cast<std::chrono::milliseconds>(
+                          std::chrono::steady_clock::now() - t0).count();
+    finish(result_path);
+    char line[200], want[200];
+    snprintf(line, sizeof line, "frame=%u main=%016llX worker=%016llX counter=%u", g_frame,
+             (unsigned long long)vm_read64(MAIN_HASH), (unsigned long long)vm_read64(WORKER_HASH),
+             vm_read32(OBJ_COUNTER));
+    CHECK(strcmp(line, ref_line(want, sizeof want)) == 0);
+    print_stats(mode.c_str(), 1);
+    print_stats(mode.c_str(), 2);
+    ss_sr_stats m, w;
+    ss_sr_get_stats(1, &m);
+    ss_sr_get_stats(2, &w);
+    printf("[%s] %.0f ms, %u resumes\n", mode.c_str(), ms, m.resumes + w.resumes);
+    CHECK(g_root_entries[0] == 1 && g_root_entries[1] == 1);   /* the entries ran once */
+    if (mode == "off") {
+        CHECK(m.requests == 0 && m.resumes == 0 && w.requests == 0 && w.resumes == 0);
+    } else if (mode == "atroot") {
+        /* armed from the environment (orchestrate_sr): SS_SELFRESUME_ATROOT=1,
+         * only the worker selected, the timer too slow to ever fire -- the one
+         * request is the one raised as the worker entered its root, and it
+         * resumes once, at its first eligible syscall */
+        CHECK(g_ss_sr_on);
+        CHECK(m.requests == 0 && m.resumes == 0);
+        CHECK(w.requests == 1 && w.resumes == 1 && w.skip[SS_SR_REFUSED] == 0);
+        CHECK(w.ctx_changed == 0 && w.roots == 1);
+    } else if (mode == "atroot-reuse") {
+        /* two threads with tid 2, one after the other: one root request and one
+         * resume each, and no host-frame drift across them */
+        CHECK(g_ss_sr_on);
+        CHECK(m.requests == 0 && m.resumes == 0);
+        CHECK(w.requests == 2 && w.resumes == 2 && w.skip[SS_SR_REFUSED] == 0);
+        CHECK(w.ctx_changed == 0 && w.roots == 2);
+        CHECK(w.host_sp_drift == 0);
+    } else if (mode == "on-legacy") {
+        /* A --legacy-indirect-lr lift stores neither LR before a bctrl nor
+         * sc_ra before an sc: main's chain holds a stale saved LR (refused,
+         * every time), the worker's syscall has no return address. Nothing
+         * resumes, and the run is untouched. */
+        CHECK(m.resumes == 0 && m.refused[PPU_RESUME_ERR_LINK] > 0);
+        CHECK(w.resumes == 0 && w.skip[SS_SR_NO_RA] > 0);
+    } else {
+        const unsigned want_n = mode == "on" ? 200 : 2;
+        CHECK(m.resumes >= want_n && w.resumes >= want_n);
+        CHECK(m.skip[SS_SR_REFUSED] == 0 && w.skip[SS_SR_REFUSED] == 0);
+        CHECK(m.skip[SS_SR_NOT_COVERED] == 0 && w.skip[SS_SR_NOT_COVERED] == 0);
+        CHECK(m.ctx_changed == 0 && w.ctx_changed == 0);
+        CHECK(m.host_sp_drift == 0 && w.host_sp_drift == 0);
+        CHECK(m.frames_max == 3 && w.frames_max == 2);
+        /* the run ended through the continuations: each entry "returned" once, from them */
+        CHECK(m.roots == 1 && w.roots == 1);
+    }
+    printf("[%s] %s (%d failure%s)\n", mode.c_str(), g_fail ? "FAIL" : "pass", g_fail, g_fail == 1 ? "" : "s");
+    fflush(stdout);
+    return g_fail ? 1 : 0;
+}
+
+/* ---- neg ----------------------------------------------------------------- */
+static void neg_safepoint_reasons(const ParkRec& m, const ParkRec& w, int* fail)
+{
+    /* tid 3: a root on main's stack range, entered with LR 0 and main's r1 */
+    ppu_context rc;
+    memset(&rc, 0, sizeof rc);
+    rc.thread_id = 3; rc.gpr[1] = MAIN_SP; rc.lr = 0;
+    static jmp_buf jb;
+    volatile int resumed = 0;
+    ss_root_enter(&jb, &rc);
+    switch (setjmp(jb)) {
+    case 0: break;
+    case SS_ROOT_RESUME: resumed = 1; break;   /* must never happen here */
+    default: abort();
+    }
+    if (!resumed) {
+        ss_sr_request(3);
+        rc = m.ctx; rc.thread_id = 3;
+        ss_cb_enter();
+        SS_SAFEPOINT(&rc, SS_AT_HLE, m.nid, 0);                /* inside a guest callback */
+        ss_cb_leave();
+        SS_SAFEPOINT(&rc, SS_AT_HLE, m.nid, 1);                /* a trampoline pending */
+        ss_bridge_enter(1, 2, 3, 4);
+        SS_SAFEPOINT(&rc, SS_AT_HLE, m.nid, 0);                /* inside a libsre bridge */
+        ss_bridge_leave();
+        ppu_context other = rc;
+        SS_SAFEPOINT(&other, SS_AT_HLE, m.nid, 0);             /* not the root's context */
+        rc.lr = 0x00010004;
+        SS_SAFEPOINT(&rc, SS_AT_HLE, m.nid, 0);                /* no continuation */
+        rc.lr = m.ctx.lr;
+        rc.gpr[1] += 4;
+        SS_SAFEPOINT(&rc, SS_AT_HLE, m.nid, 0);                /* refused: r1 misaligned */
+        rc.gpr[1] -= 4;
+        rc = w.ctx; rc.thread_id = 3; rc.sc_ra = 0;
+        SS_SAFEPOINT(&rc, SS_AT_SC, w.nid, 0);                 /* no return address */
+    }
+    ss_sr_stats s;
+    ss_sr_get_stats(3, &s);
+    print_stats("neg", 3);
+    int f = 0;
+#define NCHECK(c) do { if (!(c)) { printf("FAIL line %d: %s\n", __LINE__, #c); f++; } } while (0)
+    NCHECK(!resumed && s.resumes == 0 && s.requests == 1);
+    NCHECK(s.skip[SS_SR_CALLBACK] == 1 && s.skip[SS_SR_TRAMP] == 1 && s.skip[SS_SR_BRIDGE] == 1);
+    NCHECK(s.skip[SS_SR_NO_ROOT] == 1 && s.skip[SS_SR_NOT_COVERED] == 1 && s.skip[SS_SR_NO_RA] == 1);
+    NCHECK(s.skip[SS_SR_REFUSED] == 1 && s.refused[PPU_RESUME_ERR_SP] == 1);
+    NCHECK((g_ss_sr_mask & (1ull << 2)) != 0);                /* still requested */
+    ss_root_leave();
+    NCHECK((g_ss_sr_mask & (1ull << 2)) == 0);                /* a thread leaving drops its request */
+#undef NCHECK
+    *fail += f;
+}
+
+static void fake_cont(ppu_context*) { abort(); }   /* checked, never run */
+
+static int neg_mode(void)
+{
+    init_world();
+    world_threads();
+    ss_test_thread(3, MAIN_STACK_LO, MAIN_SP + 48, "probe");
+    /* Unarmed: the hooks are inert. */
+    {
+        ppu_context c;
+        memset(&c, 0, sizeof c);
+        c.thread_id = 3; c.gpr[1] = MAIN_SP;
+        static jmp_buf jb;
+        ss_root_enter(&jb, &c);                                /* no-op */
+        ss_sr_request(3);                                      /* no-op */
+        CHECK(g_ss_sr_mask == 0);
+        SS_SAFEPOINT(&c, SS_AT_HLE, 1, 0);                     /* one test of two zero globals */
+        ss_root_leave();
+        ss_sr_stats s;
+        ss_sr_get_stats(0, &s);
+        CHECK(!g_ss_sr_on && s.requests == 0 && s.resumes == 0 && s.skip[SS_SR_NO_ROOT] == 0);
+    }
+    /* Both threads parked at their call ENTRIES (test_cont_resume's capture). */
+    g_capture = true;
+    std::thread th[NT];
+    start_fresh(th);
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    request_snapshot();
+    { std::unique_lock<std::mutex> lk(g_mx); g_captured_cv.wait(lk, [] { return g_captured; }); }
+    const ParkRec m = g_park[0], w = g_park[1];
+    CHECK(m.valid && w.valid && m.kind == PPU_PARK_HLE && w.kind == PPU_PARK_SC);
+    ss_sr_configure(0, ~0ull, 0.0, 0);
+
+    /* The check on its own. */
+    const ss_sr_root rm = { 0, MAIN_SP, MAIN_STACK_LO, MAIN_SP + 48 };
+    const ss_sr_root rw = { 0, WORKER_SP, WORKER_STACK_LO, WORKER_SP + 48 };
+    int frames = 0;
+    CHECK(sr_check(&m.ctx, SS_AT_HLE, m.nid, &rm, &frames) == SS_SR_OK && frames == 3);
+    CHECK(sr_check(&w.ctx, SS_AT_SC, w.nid, &rw, &frames) == SS_SR_OK && frames == 2);
+    ppu_context c = m.ctx;
+    c.lr = 0x00010004;
+    CHECK(sr_check(&c, SS_AT_HLE, m.nid, &rm, &frames) == SS_SR_NOT_COVERED);
+    CHECK(seen_has(0x00010004u));                             /* reported once, then the fast path */
+    CHECK(sr_check(&c, SS_AT_HLE, m.nid, &rm, &frames) == SS_SR_NOT_COVERED);
+    c = w.ctx;
+    c.sc_ra = 0;
+    CHECK(sr_check(&c, SS_AT_SC, w.nid, &rw, &frames) == SS_SR_NO_RA);
+    ss_sr_root bad = rm;
+    bad.root_sp += 0x10;                                       /* LR 0 reached at the wrong r1 */
+    CHECK(sr_check(&m.ctx, SS_AT_HLE, m.nid, &bad, &frames) == SS_SR_REFUSED_BASE + PPU_RESUME_ERR_ROOT);
+    const uint32_t sp0 = (uint32_t)m.ctx.gpr[1];
+    const uint64_t bc0 = vm_read64(sp0);
+    vm_write64(sp0, bc0 + 0x10);                               /* a corrupted back chain */
+    CHECK(sr_check(&m.ctx, SS_AT_HLE, m.nid, &rm, &frames) ==
+          SS_SR_REFUSED_BASE + PPU_RESUME_ERR_FRAME_SHAPE);
+    vm_write64(sp0, bc0);
+    if (HAVE_CODE) {
+        /* a STALE saved LR: the slot names the last bl's return site (into a leaf) */
+        const ppu_cont_entry* stale = nullptr;
+        for (int k = 0; k < s_nimg && !stale; k++)
+            for (uint32_t i = 0; i < s_img[k].n; i++)
+                if (s_img[k].t[i].call_kind == PPU_CONT_CALL_BL && s_img[k].t[i].callee == 0x00010200u &&
+                    s_img[k].t[i].owner == 0x00010100u)
+                    stale = &s_img[k].t[i];
+        CHECK(stale != nullptr);
+        if (stale) {
+            const uint32_t slot = sp0 + 0x90 + 0x10;
+            const uint64_t saved = vm_read64(slot);
+            vm_write64(slot, stale->ra);
+            CHECK(sr_check(&m.ctx, SS_AT_HLE, m.nid, &rm, &frames) ==
+                  SS_SR_REFUSED_BASE + PPU_RESUME_ERR_LINK);
+            vm_write64(slot, saved);
+        }
+    }
+    CHECK(sr_check(&m.ctx, SS_AT_HLE, m.nid, &rm, &frames) == SS_SR_OK);   /* all restored */
+
+    /* Only the parked syscall itself can follow an `sc`: an HLE park whose LR
+     * does, or a SAVED LR that does, is stale (an `sc` pushes no frame). */
+    c = m.ctx;
+    c.lr = w.ctx.sc_ra;
+    CHECK(sr_check(&c, SS_AT_HLE, m.nid, &rm, &frames) ==
+          SS_SR_REFUSED_BASE + PPU_RESUME_ERR_CALL_MISMATCH);
+    {
+        const uint32_t slot = sp0 + 0x90 + 0x10;               /* frame 1's return address */
+        const uint64_t saved = vm_read64(slot);
+        vm_write64(slot, w.ctx.sc_ra);
+        CHECK(sr_check(&m.ctx, SS_AT_HLE, m.nid, &rm, &frames) ==
+              SS_SR_REFUSED_BASE + PPU_RESUME_ERR_CALL_MISMATCH);
+        vm_write64(slot, saved);
+    }
+    CHECK(sr_check(&m.ctx, SS_AT_HLE, m.nid, &rm, &frames) == SS_SR_OK);
+
+    /* A PARTIAL exit model (the lifter did not follow every path from that
+     * return address) checks out against the stack, but a resume cannot trust
+     * it: not resumable through it. Two frameless frames in front of main's
+     * chain, their LR in a scratch word below r1; the same but partial. */
+    static const ppu_cont_entry fake[] = {
+        { 0x00FFFF10u, 0x00FFFE00u, fake_cont, 0, 0, -0x100, PPU_CONT_CALL_INDIRECT, PPU_CONT_EXIT_RETURNS, 0, 0 },
+        { 0x00FFFF20u, 0x00FFFE00u, fake_cont, 0, 0, -0x100, PPU_CONT_CALL_INDIRECT, PPU_CONT_EXIT_RETURNS,
+          PPU_CONT_F_PARTIAL, 0 } };
+    CHECK(ppu_cont_register(fake, 2, (uint32_t)sizeof(ppu_cont_entry), PPU_CONT_ABI, "fake") == 1);
+    vm_write64(sp0 - 0x100, m.ctx.lr);
+    c = m.ctx;
+    c.lr = 0x00FFFF10u;
+    CHECK(sr_check(&c, SS_AT_HLE, m.nid, &rm, &frames) == SS_SR_OK && frames == 4);
+    c.lr = 0x00FFFF20u;
+    CHECK(sr_check(&c, SS_AT_HLE, m.nid, &rm, &frames) == SS_SR_NOT_COVERED);
+    CHECK(seen_has(0x00FFFF20u));                              /* reported once */
+    /* A chain whose first return address is covered but a deeper one is not:
+     * the verdict is kept for that first return address for the next 63 asks
+     * (a requested thread asks at every HLE call / syscall), then it is walked
+     * again -- and now resumes. */
+    c.lr = 0x00FFFF10u;
+    vm_write64(sp0 - 0x100, 0x00010004u);                      /* no continuation */
+    CHECK(sr_check(&c, SS_AT_HLE, m.nid, &rm, &frames) == SS_SR_NOT_COVERED);
+    vm_write64(sp0 - 0x100, m.ctx.lr);                         /* covered again */
+    {
+        int nc = 0, ok_at = -1;
+        for (int i = 0; i < 100 && ok_at < 0; i++) {
+            const int r = sr_check(&c, SS_AT_HLE, m.nid, &rm, &frames);
+            if (r == SS_SR_NOT_COVERED) nc++;
+            else if (r == SS_SR_OK) ok_at = i;
+        }
+        CHECK(nc == 63 && ok_at == 63 && frames == 4);
+    }
+    CHECK(sr_check(&c, SS_AT_HLE, m.nid, &rm, &frames) == SS_SR_OK);   /* no memo after a resumable walk */
+
+    /* The census's strict walk (sr_walk, ss_sr_ops.walk): sr_check's verdicts,
+     * no side effects, every missing return address listed. */
+    {
+        ss_sr_walk_out o;
+        sr_walk(&m.ctx, SS_AT_HLE, &rm, &o);
+        CHECK(o.verdict == SS_SR_OK && o.frames == 3 && o.root == PPU_RESUME_ROOT_LR && o.nmiss == 0);
+        sr_walk(&w.ctx, SS_AT_SC, &rw, &o);
+        CHECK(o.verdict == SS_SR_OK && o.frames == 2 && o.root == PPU_RESUME_ROOT_LR);
+        sr_walk(&w.ctx, SS_AT_SC, nullptr, &o);                /* no root record: ends at LR 0 */
+        CHECK(o.verdict == SS_SR_OK && o.frames == 2);
+        c = w.ctx;
+        c.sc_ra = 0;
+        sr_walk(&c, SS_AT_SC, &rw, &o);
+        CHECK(o.verdict == SS_SR_NO_RA);
+        c = m.ctx;
+        c.lr = 0x00010008u;                                    /* never seen before */
+        sr_walk(&c, SS_AT_HLE, &rm, &o);
+        CHECK(o.verdict == SS_SR_NOT_COVERED && o.why == SS_SRW_MISSING && o.nmiss == 1 &&
+              o.miss[0] == 0x00010008u && o.err_ra == 0x00010008u);
+        CHECK(!seen_has(0x00010008u));                         /* nothing reported, nothing memoised */
+        sr_walk(&m.ctx, SS_AT_HLE, &bad, &o);
+        CHECK(o.verdict == SS_SR_REFUSED_BASE + PPU_RESUME_ERR_ROOT);
+        c = m.ctx;
+        c.lr = 0x00FFFF20u;                                    /* the partial exit model above */
+        sr_walk(&c, SS_AT_HLE, &rm, &o);
+        CHECK(o.verdict == SS_SR_NOT_COVERED && o.why == SS_SRW_PARTIAL && o.err_ra == 0x00FFFF20u);
+    }
+
+    /* The SPURS handler threads (libsre, census 2026-10-15): each parks in a
+     * syscall (sys_event_queue_receive / sys_spu_thread_group_join) made by
+     * its entry function itself, entered with LR 0 -- a chain of ONE frame
+     * whose next return address is the root's 0. Before libsre was relifted
+     * with the sc_ra stores that syscall had no return address (no-ra, the
+     * critique's B1). Two entries in lifted shape: the equeue handler, whose
+     * entry function returns (static 0x30-byte frame, LR slot at +0x40), and
+     * the join handler, whose main loop never returns. */
+    {
+        enum : uint32_t { H_LO = 0x00C00000, H_ROOT_SP = 0x00C80000, H_SP = H_ROOT_SP - 0x30,
+                          RA_EQ = 0x00FFFF44, RA_JOIN = 0x00FFFF64, RA_NONE = 0x00FFFF84 };
+        static const ppu_cont_entry spurs[] = {
+            { RA_EQ, 0x00FFFF30u, fake_cont, 0, 0x30, 0x40, PPU_CONT_CALL_SC, PPU_CONT_EXIT_RETURNS, 0, 0 },
+            { RA_JOIN, 0x00FFFF50u, fake_cont, 0, 0x30, 0x40, PPU_CONT_CALL_SC, PPU_CONT_EXIT_NORETURN, 0, 0 } };
+        CHECK(ppu_cont_register(spurs, 2, (uint32_t)sizeof(ppu_cont_entry), PPU_CONT_ABI, "spurs") == 1);
+        vm_write32(RA_EQ - 4, 0x44000002u);                    /* the `sc` before each return address */
+        vm_write32(RA_JOIN - 4, 0x44000002u);
+        vm_write32(RA_NONE - 4, 0x44000002u);
+        vm_write64(H_SP, H_ROOT_SP);                           /* back chain -> the root's r1 */
+        vm_write64(H_SP + 0x40, 0);                            /* saved LR: the root's 0 */
+        const ss_sr_root rh = { 0, H_ROOT_SP, H_LO, H_ROOT_SP + 0x100 };
+        ppu_context h;
+        memset(&h, 0, sizeof h);
+        h.thread_id = 3; h.gpr[1] = H_SP; h.lr = 0; h.gpr[11] = 130;
+        h.sc_ra = RA_EQ;
+        ss_sr_walk_out o;
+        sr_walk(&h, SS_AT_SC, &rh, &o);
+        CHECK(o.verdict == SS_SR_OK && o.frames == 1 && o.root == PPU_RESUME_ROOT_LR);
+        CHECK(sr_check(&h, SS_AT_SC, 130, &rh, &frames) == SS_SR_OK && frames == 1);   /* P0 agrees */
+        ss_sr_root rbad = rh;
+        rbad.root_sp += 0x10;
+        sr_walk(&h, SS_AT_SC, &rbad, &o);
+        CHECK(o.verdict == SS_SR_REFUSED_BASE + PPU_RESUME_ERR_ROOT);
+        h.lr = RA_EQ;
+        sr_walk(&h, SS_AT_HLE, &rh, &o);                       /* an HLE park whose LR follows an sc */
+        CHECK(o.verdict == SS_SR_REFUSED_BASE + PPU_RESUME_ERR_CALL_MISMATCH);
+        h.lr = 0;
+        h.sc_ra = 0;                                           /* the unrelifted libsre */
+        sr_walk(&h, SS_AT_SC, &rh, &o);
+        CHECK(o.verdict == SS_SR_NO_RA);
+        h.sc_ra = RA_JOIN; h.gpr[11] = 178;
+        sr_walk(&h, SS_AT_SC, &rh, &o);
+        CHECK(o.verdict == SS_SR_OK && o.frames == 1 && o.root == PPU_RESUME_ROOT_NORETURN);
+        CHECK(sr_check(&h, SS_AT_SC, 178, &rh, &frames) == SS_SR_OK && frames == 1);
+        h.sc_ra = RA_NONE;                                     /* a call site not in the list */
+        sr_walk(&h, SS_AT_SC, &rh, &o);
+        CHECK(o.verdict == SS_SR_NOT_COVERED && o.nmiss == 1 && o.miss[0] == RA_NONE);
+        CHECK(!seen_has(RA_NONE));
+    }
+
+    /* Every reason a requested thread at an S1/S2 entry must not resume. */
+    std::thread probe(neg_safepoint_reasons, std::cref(m), std::cref(w), &g_fail);
+    probe.join();
+    printf("[neg] %s (%d failure%s)\n", g_fail ? "FAIL" : "pass", g_fail, g_fail == 1 ? "" : "s");
+    fflush(stdout);
+    _exit(g_fail ? 1 : 0);                                     /* the captured threads stay parked */
+}
+
+static int orchestrate_sr(const std::string& dir)
+{
+    auto P = [&](const char* n) { return dir + "/" + n; };
+    char want[200];
+    ref_line(want, sizeof want);
+    for (const char* mode : { "off", "on", "timer" }) {
+        const std::string out = P((std::string("sr_") + mode + ".txt").c_str());
+        remove(out.c_str());
+        CHECK(spawn({ mode, out }) == 0);
+        const std::string got = slurp(out);
+        printf("[test] %s -> %s\n", mode, got.c_str());
+        CHECK(got == want);
+    }
+    CHECK(spawn({ "neg" }) == 0);
+    {
+        /* SS_SELFRESUME_ATROOT, armed through the environment as in the game */
+        auto setenv_ = [](const char* n, const char* v) {
+#ifdef _WIN32
+            _putenv_s(n, v);
+#else
+            if (*v) setenv(n, v, 1); else unsetenv(n);
+#endif
+        };
+        setenv_("SS_SELFRESUME", "600000");
+        setenv_("SS_SELFRESUME_START", "100000");
+        setenv_("SS_SELFRESUME_TID", "2");
+        setenv_("SS_SELFRESUME_ATROOT", "1");
+        const std::string out = P("sr_atroot.txt");
+        remove(out.c_str());
+        CHECK(spawn({ "atroot", out }) == 0);
+        const std::string out2 = P("sr_atroot_reuse.txt");
+        remove(out2.c_str());
+        CHECK(spawn({ "atroot-reuse", out2 }) == 0);
+        const std::string got2 = slurp(out2);
+        printf("[test] atroot-reuse -> %s\n", got2.c_str());
+        CHECK(got2 == want);
+        for (const char* n : { "SS_SELFRESUME", "SS_SELFRESUME_START", "SS_SELFRESUME_TID", "SS_SELFRESUME_ATROOT" })
+            setenv_(n, "");
+        const std::string got = slurp(out);
+        printf("[test] atroot -> %s\n", got.c_str());
+        CHECK(got == want);
+    }
+    printf("%s: self-resume (%d failure%s)\n", g_fail ? "FAIL" : "PASS", g_fail, g_fail == 1 ? "" : "s");
+    return g_fail ? 1 : 0;
+}
+
+int main(int argc, char** argv)
+{
+    g_self = argv[0];
+    vm_base = (uint8_t*)calloc(1, VM_SIZE);
+    const std::string mode = argc > 1 ? argv[1] : "all";
+    if (mode == "off" || mode == "on" || mode == "timer" || mode == "on-legacy" || mode == "atroot" ||
+        mode == "atroot-reuse")
+        return run_mode(mode, argc > 2 ? argv[2] : nullptr);
+    if (mode == "neg") return neg_mode();
+    const std::string dir = argc > 2 ? argv[2] : (mode == "all" ? "." : mode);
+    return orchestrate_sr(dir);
+}
diff --git a/runtime/savestate/tests/test_ss_selfresume_glue.c b/runtime/savestate/tests/test_ss_selfresume_glue.c
new file mode 100644
index 0000000..a4865fb
--- /dev/null
+++ b/runtime/savestate/tests/test_ss_selfresume_glue.c
@@ -0,0 +1,23 @@
+/*
+ * C half of test_ss_selfresume.cpp: the guest thread table ss_core.c reads
+ * (g_ppu_threads). The C++ half cannot declare it -- its ppu_context may come
+ * from a lifter-generated header, which cannot share a TU with
+ * runtime/syscalls/sys_ppu_thread.h.
+ */
+#include "../../syscalls/sys_ppu_thread.h"
+#include <string.h>
+
+ppu_thread_info g_ppu_threads[PPU_THREAD_MAX];
+/* sys_ppu_thread.c's PPUT hook (arming sets it) */
+int (*g_ppu_ss_park_of)(unsigned tid, int* at, int* tier, uint32_t* num, uint32_t* obj,
+                        const ppu_context** ctx, struct ss_sr_root* root, int* root_valid);
+
+void ss_test_thread(unsigned tid, unsigned stack_lo, unsigned stack_hi, const char* name)
+{
+    if (tid == 0 || tid > PPU_THREAD_MAX) return;
+    ppu_thread_info* t = &g_ppu_threads[tid - 1];
+    t->state = PPU_THREAD_STATE_RUNNING;
+    t->stack_addr = stack_lo;
+    t->stack_size = stack_hi - stack_lo;
+    strncpy(t->name, name, sizeof t->name - 1);
+}
diff --git a/runtime/savestate/tests/test_ss_state.c b/runtime/savestate/tests/test_ss_state.c
new file mode 100644
index 0000000..29ce5c7
--- /dev/null
+++ b/runtime/savestate/tests/test_ss_state.c
@@ -0,0 +1,747 @@
+/*
+ * test_ss_state -- the save-state image (runtime/savestate/ss_state.c) with
+ * no game and no rest of the runtime: ss_state.c alone, a fake guest arena
+ * and three fake sections.
+ *
+ *   clang-cl /nologo /O2 /MD -D_CRT_SECURE_NO_WARNINGS
+ *            runtime/savestate/tests/test_ss_state.c runtime/savestate/ss_state.c
+ *            /Fe:test_ss_state.exe && test_ss_state.exe [scratch-dir]
+ *
+ * The fake arena is 64 MB reserved with a few committed regions: patterned
+ * pages, an all-zero region, a PAGE_NOACCESS guard page between two non-zero
+ * pages, a page whose only non-zero byte is its last. The sections:
+ *   FAKA  (C, static init, SS_SECTION_REGISTER) the statics of a "kernel" as
+ *         FIELDS and its object table as RECS (a host pointer in the struct
+ *         is not in the list); a check() that refuses on demand
+ *   FAKB  (registered at run time) a blob, a u64, a text, a TLV of its own
+ *         type, and on demand a 64 MB blob its size_hint does not announce
+ *   FAKC  (non-const ops) misuse on demand: a record left open, a member
+ *         list written as statics, an error returned, a write after the
+ *         capture; its version is changed under the image
+ * Checks: registration (static init and later, a duplicate refused, capture
+ * order by `order`); CRC32C (the standard check value, chained); a check()
+ * refusal returns the section's reason, blocker and fourcc; the capture of
+ * TIME / MAPS / GMEM / FAKA / FAKB: committed, non-zero and unreadable bytes,
+ * the regions, both bitmaps, GMEM's pages equal the arena's non-zero pages
+ * in address order, the guard page never read; the reader round trip
+ * (statics, records with their keys, blob, u64, text, TLV, TIME with the
+ * guest clock, play time, flips and an anchor, and its host instant the one
+ * a later section was handed); layout changes detected by
+ * name (a size, a field dropped, a field added; SS_FF_OPTIONAL accepted;
+ * nothing written on a refused read; the section layout hash moves); CRC
+ * (an in-RAM byte flipped, a file byte flipped, a header byte flipped); the
+ * raw file round trip; image validation (a version changed under it, an
+ * unknown mandatory section); crafted files whose offsets wrap a u64 sum
+ * (the section table, the data region, a section, a chunk past its
+ * section, a bogus chunk size) refused; the compression estimate; misuse refused
+ * with SS_E_STATE / SS_E_ARG and no image; overflow: counted, refused with
+ * the section named, grown by the next prepare, then captured; the capture
+ * order under concurrent first use (SS1): 8 threads released at once after
+ * each of 40 registrations all see every section once, by order, and
+ * ss_state_order_check agrees; ss_state_order_check_list refuses an order
+ * with a section missing, twice, out of order or not registered.
+ */
+#include "../ss_state.h"
+
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int g_fail;
+#define CHECK(c, ...) do { if (!(c)) { g_fail++; printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+                                         printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+/* ---- the capture order under concurrent first use (SS1) -----------------------
+ * The order is built on its first use. At a launch with SS_LOAD that use came
+ * from two threads at once -- the state's reader (ss_file_load) and the window
+ * menu's slot reader (ss_slots_read_info), both released by the EBOOT hash --
+ * and the in-place sort of the one left the other's order with a section twice
+ * and others missing: the load then tore down and restored without PPUT / SPUC
+ * and died past its point of no return. Each racing thread checks the order it
+ * is handed: the count it expects, every section once, by `order`. */
+#define RACE_THREADS 8
+static volatile LONG g_race_go, g_race_in, g_race_bad;
+static int  g_race_want;
+static char g_race_what[160];
+static DWORD WINAPI race_thread(LPVOID p)
+{
+    (void)p;
+    InterlockedIncrement(&g_race_in);
+    while (!g_race_go) YieldProcessor();
+    const int n = ss_section_count();
+    uint32_t seen[SS_SECTION_MAX];
+    int prev = -2147483647 - 1, bad = n != g_race_want ? 1 : 0, at = -1;
+    for (int i = 0; !bad && i < n && i < SS_SECTION_MAX; i++) {
+        const ss_section_ops* o = ss_section_at(i);
+        if (!o || o->order < prev) { bad = 2; at = i; break; }
+        prev = o->order;
+        for (int k = 0; k < i; k++) if (seen[k] == o->fourcc) { bad = 3; at = i; }
+        seen[i] = o->fourcc;
+    }
+    if (bad && InterlockedIncrement(&g_race_bad) == 1)
+        snprintf(g_race_what, sizeof g_race_what, "%s at %d (%d sections, %d expected)",
+                 bad == 1 ? "a wrong count" : bad == 2 ? "out of order" : "a section twice", at, n, g_race_want);
+    return 0;
+}
+
+#define MB_ (1024u * 1024u)
+#define FOURCC_A SS_FOURCC('F', 'A', 'K', 'A')
+#define FOURCC_B SS_FOURCC('F', 'A', 'K', 'B')
+#define FOURCC_C SS_FOURCC('F', 'A', 'K', 'C')
+#define FOURCC_GMEM SS_FOURCC('G', 'M', 'E', 'M')
+#define FOURCC_MAPS SS_FOURCC('M', 'A', 'P', 'S')
+
+/* ---- the fake arena ------------------------------------------------------ */
+#define ARENA_SIZE (64u * MB_)
+static uint8_t* g_arena;
+static uint32_t g_nz[16];                 /* the non-zero pages, in address order */
+static int      g_nnz;
+
+static void commit(uint32_t off, uint32_t n)
+{
+    if (!VirtualAlloc(g_arena + off, n, MEM_COMMIT, PAGE_READWRITE)) { printf("commit failed\n"); exit(2); }
+}
+static void mark(uint32_t off, uint8_t v, uint32_t at) { g_arena[off + at] = v; }
+
+static void build_arena(void)
+{
+    g_arena = (uint8_t*)VirtualAlloc(NULL, ARENA_SIZE, MEM_RESERVE, PAGE_READWRITE);
+    if (!g_arena) { printf("no arena\n"); exit(2); }
+    commit(0, 1u * MB_);                                   /* 1 MB: four patterned pages */
+    for (int i = 0; i < 4096; i++) g_arena[i] = (uint8_t)(i * 7 + 1);
+    mark(0x1000, 0x5A, 17);
+    mark(0x5000, 0x01, 0);
+    mark(0xFF000, 0x80, 2048);
+    commit(16u * MB_, 256u * 1024u);                       /* 256 KB, all zero */
+    commit(32u * MB_, 128u * 1024u);                       /* non-zero, guard, non-zero */
+    mark(32u * MB_, 0x11, 100);
+    mark(32u * MB_ + 0x1000, 0x22, 5);                     /* (non-zero, but protected below) */
+    mark(32u * MB_ + 0x2000, 0x33, 4095);
+    DWORD old;
+    VirtualProtect(g_arena + 32u * MB_ + 0x1000, 0x1000, PAGE_NOACCESS, &old);
+    commit(48u * MB_ + 0x10000, 0x1000);                   /* one page, its last byte set */
+    mark(48u * MB_ + 0x10000, 0x44, 4095);
+    const uint32_t nz[] = { 0x0, 0x1000, 0x5000, 0xFF000, 32u * MB_, 32u * MB_ + 0x2000, 48u * MB_ + 0x10000 };
+    for (unsigned i = 0; i < sizeof nz / sizeof nz[0]; i++) g_nz[g_nnz++] = nz[i];
+}
+#define COMMITTED (1u * MB_ + 256u * 1024u + 128u * 1024u + 0x1000u)
+
+/* ---- FAKA: a "kernel": statics and an object table ------------------------ */
+static int      a_int;
+static double   a_dbl;
+static char     a_name[16];
+static uint64_t a_arr[4];
+static const ss_field k_a_fields[] = { SS_FIELD(a_int), SS_FIELD(a_dbl), SS_FIELD(a_name), SS_FIELD(a_arr) };
+static const ss_list k_a_list = SS_LIST("fake_a", k_a_fields);
+typedef struct obj { uint32_t id; int32_t value; uint8_t used; char tag[8]; void* host; } obj;
+static obj g_objs[8];
+static const ss_field k_obj_fields[] = { SS_MEMBER(obj, id), SS_MEMBER(obj, value), SS_MEMBER(obj, tag) };
+static const ss_list k_obj_list = SS_LIST("objects", k_obj_fields);
+static const ss_list* const k_a_lists[] = { &k_a_list, &k_obj_list, NULL };
+static int g_a_refuse;
+static uint64_t g_a_qpc;                  /* the capture's instant as FAKA's capture saw it */
+
+static int a_check(char* why, size_t n)
+{
+    if (!g_a_refuse) return 0;
+    snprintf(why, n, "object 3 is being created");
+    return 9;                                              /* "a reason of its own" */
+}
+static int a_capture(ss_writer* w)
+{
+    g_a_qpc = ss_writer_info(w)->qpc;
+    ss_write_fields(w, &k_a_list);
+    ss_recs_begin(w, &k_obj_list);
+    for (int i = 0; i < 8; i++) if (g_objs[i].used) ss_recs_add(w, g_objs[i].id, &g_objs[i]);
+    ss_recs_end(w);
+    return ss_writer_error(w);
+}
+static const ss_section_ops k_a_ops = {
+    FOURCC_A, 1, 0, SS_ORDER_KERNEL, a_check, a_capture, NULL, NULL, NULL, "fake kernel", k_a_lists, NULL,
+};
+SS_SECTION_REGISTER(k_a_ops)
+
+/* ---- FAKB: blobs, text, a TLV, an unannounced big blob --------------------- */
+static uint8_t  g_ring[3000];
+static uint64_t g_big;                    /* bytes of the "big" blob; 0 none */
+static int b_capture(ss_writer* w)
+{
+    ss_write_blob(w, "ring", g_ring, sizeof g_ring);
+    ss_write_u64(w, "head", 1234567890123ull);
+    ss_text_begin(w, "log");
+    ss_text_printf(w, "hello %d", 42);
+    ss_text_printf(w, " world %s\n", "x");
+    ss_text_end(w);
+    ss_write_tlv(w, SS_FOURCC('X', 'Y', 'Z', 'W'), "custom", "abc", 3);
+    if (g_big) {
+        ss_blob_begin(w, "big", 4096);
+        for (uint64_t k = 0; k < g_big; k += MB_) {
+            void* d = ss_blob_reserve(w, MB_);            /* NULL once full: keep going (it counts) */
+            if (d) memset(d, 0xA5, MB_);
+        }
+        ss_blob_end(w);
+    }
+    return ss_writer_error(w);
+}
+static uint64_t b_hint(void) { return 64u * 1024u; }      /* (does not announce the big blob) */
+static const ss_section_ops k_b_ops = {
+    FOURCC_B, 2, SS_SEC_OPTIONAL, SS_ORDER_GCM, NULL, b_capture, NULL, NULL, NULL, "fake blobs", NULL, b_hint,
+};
+static const ss_section_ops k_b_dup = {
+    FOURCC_B, 3, 0, SS_ORDER_GCM, NULL, b_capture, NULL, NULL, NULL, "fake blobs again", NULL, NULL,
+};
+
+/* ---- FAKC: misuse on demand ---------------------------------------------- */
+static int g_c_mode;
+static ss_writer* g_c_saved;
+static int c_capture(ss_writer* w)
+{
+    g_c_saved = w;
+    switch (g_c_mode) {
+    case 1: ss_blob_begin(w, "open", 0); ss_blob_put(w, "x", 1); return 0;      /* left open */
+    case 2: return ss_write_fields(w, &k_obj_list);                               /* member offsets as statics */
+    case 3: ss_write_u64(w, "v", 1); return SS_E_CORRUPT;                         /* its own error */
+    default: return ss_write_u64(w, "v", 7);
+    }
+}
+static ss_section_ops k_c_ops = {
+    FOURCC_C, 1, 0, SS_ORDER_SYSUTIL, NULL, c_capture, NULL, NULL, NULL, "fake misuse", NULL, NULL,
+};
+
+/* ---- guest clock and an anchor -------------------------------------------- */
+static uint64_t fake_tb(void) { return 79800000ull * 5 + 7980ull; }   /* 5 s + 100 us */
+static uint64_t g_anchor_v = 0xC0FFEEull;
+static uint64_t anchor_read(void) { return g_anchor_v; }
+static const ss_time_anchor k_anchor = { "test.anchor", anchor_read, NULL };
+
+static const ss_capture_info* info(unsigned seq)
+{
+    static ss_capture_info ci;
+    memset(&ci, 0, sizeof ci);
+    ci.seq = seq;
+    ci.purpose = 2;
+    ci.flip_count = 1234;
+    ci.play_ms = 98765;
+    ci.unix_ms = 1792512191000ull;
+    return &ci;
+}
+
+static int capture(unsigned seq, char* why, size_t n, uint32_t* fc)
+{
+    if (ss_state_prepare(why, n) != SS_OK) return SS_E_NOMEM;
+    const int r = ss_state_capture(info(seq), why, n, fc);
+    if (r == SS_OK) ss_state_seal();
+    return r;
+}
+
+/* ---- checks ------------------------------------------------------------- */
+static void check_memory(const ss_image* img)
+{
+    ss_mem_stats m;
+    ss_state_mem_stats(&m);
+    CHECK(m.arena == ARENA_SIZE && m.committed == COMMITTED && m.unreadable == 0x1000 && m.pages == (uint32_t)g_nnz &&
+          m.nonzero == (uint64_t)g_nnz * 4096u && m.regions == 6,
+          "mem stats: arena %llu committed %llu unreadable %llu pages %u regions %u", (unsigned long long)m.arena,
+          (unsigned long long)m.committed, (unsigned long long)m.unreadable, m.pages, m.regions);
+    ss_reader r;
+    CHECK(ss_reader_open(&r, img, FOURCC_GMEM) == SS_OK, "no GMEM");
+    const void* p = NULL;
+    uint64_t n = 0;
+    CHECK(ss_find_blob(&r, "pages", &p, &n) == SS_OK && n == (uint64_t)g_nnz * 4096u, "GMEM pages: %llu bytes",
+          (unsigned long long)n);
+    CHECK(p && ((uintptr_t)p & 4095u) == 0, "GMEM pages not 4096-aligned in the image");
+    for (int i = 0; p && i < g_nnz; i++)
+        CHECK(!memcmp((const uint8_t*)p + (size_t)i * 4096u, g_arena + g_nz[i], 4096), "GMEM page %d (0x%X) differs",
+              i, g_nz[i]);
+    CHECK(ss_reader_open(&r, img, FOURCC_MAPS) == SS_OK, "no MAPS");
+    static uint8_t bits[(ARENA_SIZE / 4096u) / 8u];
+    uint64_t bl = 0;
+    CHECK(ss_read_blob(&r, "nonzero_4k", bits, sizeof bits, &bl) == SS_OK && bl == sizeof bits, "nonzero_4k: %s",
+          ss_reader_what(&r));
+    int nset = 0;
+    for (uint32_t pg = 0; pg < ARENA_SIZE / 4096u; pg++) {
+        const int set = (bits[pg / 8] >> (pg % 8)) & 1;
+        nset += set;
+        int want = 0;
+        for (int i = 0; i < g_nnz; i++) want |= g_nz[i] / 4096u == pg;
+        if (set != want) { CHECK(0, "nonzero_4k bit for page 0x%X is %d", pg * 4096u, set); break; }
+    }
+    CHECK(nset == g_nnz, "nonzero_4k: %d bits", nset);
+    uint8_t blk[(ARENA_SIZE / 0x10000u) / 8u];
+    CHECK(ss_read_blob(&r, "committed_64k", blk, sizeof blk, &bl) == SS_OK, "committed_64k");
+    int nblk = 0;
+    for (unsigned b = 0; b < ARENA_SIZE / 0x10000u; b++) nblk += (blk[b / 8] >> (b % 8)) & 1;
+    CHECK(nblk == 16 + 4 + 2 + 1 && (blk[0] & 1) && ((blk[769 / 8] >> (769 % 8)) & 1), "committed_64k: %d blocks", nblk);
+    typedef struct region { uint64_t guest, size; uint32_t protect, type; } region;
+    static const ss_field k_rf[] = {
+        SS_MEMBER(region, guest), SS_MEMBER(region, size), SS_MEMBER(region, protect), SS_MEMBER(region, type),
+    };
+    static const ss_list k_rl = SS_LIST("regions", k_rf);
+    ss_recs_it it;
+    CHECK(ss_recs_open(&r, &k_rl, &it) == SS_OK && it.count == 6, "regions: %s (%u)", ss_reader_what(&r), it.count);
+    region g;
+    uint32_t key;
+    int guard = 0;
+    while (ss_recs_next(&it, &key, &g) == 1)
+        guard |= g.guest == 32u * MB_ + 0x1000 && g.size == 0x1000 && g.protect == PAGE_NOACCESS;
+    CHECK(guard, "the guard page is not a region of its own");
+}
