diff --git a/runtime/spu/tests/test_spu_task_residency.c b/runtime/spu/tests/test_spu_task_residency.c
new file mode 100644
index 0000000..579790c
--- /dev/null
+++ b/runtime/spu/tests/test_spu_task_residency.c
@@ -0,0 +1,357 @@
+/*
+ * test_spu_task_residency.c -- a SPURS taskset task's residency across a
+ * syscall the taskset policy module answers, and the overlay a policy resume
+ * drops (SPU_TASKSET_LLE; NOTES 2026-10-27, PF4).
+ *
+ * With the policy module running a task's syscalls (SPU_TASKSET_LLE=1), a
+ * syscall that does not switch the task -- POLL, YIELD with nothing else
+ * ready, a WAIT_SIGNAL whose signal is already latched -- is policy code below
+ * the task region (0x3000) that returns straight into the task's
+ * continuation. Policy code runs with no task resident (resident_task 0), so
+ * the task came back with its residency cleared, and its next computed branch
+ * took the "the policy resumed a saved task" path (a longjmp to depth 0 over
+ * its own live frames): inFamous 2's psarc task then branched to LS 0 at the
+ * end of every cold boot's world load. spu_indirect_branch now runs the
+ * syscall as a nested call (spu_taskset_pm_call) that gives the task its
+ * residency back when the policy returns -- whatever the call's shape: a
+ * brsl to a wrapper that tail-branches to 0xA70 (the task's POLL) or a bisl
+ * straight to it (its WAIT_SIGNAL, whose dispatch clears the residency before
+ * the bracket's drain runs). And a task taken up from the policy -- a resume
+ * at host depth > 0 (the longjmp) or at depth 0 (a save-state load's run that
+ * starts in the policy) -- drops the streamed overlay its ELF replaced.
+ *
+ * The "policy" is a co-resident code region at LS 0xA00 (image 77), as
+ * inFamous 2's pm_30023680 is; TaskInfo (LS 0x2794) names a registered task
+ * ELF whose policy is that region, so spu_taskset_resident_image resolves.
+ *
+ *   A  POLL shape: the task calls a wrapper that tail-branches to 0xA70; the
+ *      policy (0xA70 -> 0xB60, `bi $r0`, as pm_30023680) returns to the link:
+ *      in the policy the residency is 0, back in the task 9 (policy module) /
+ *      0 (SPU_TASKSET_LLE=0: the old path);
+ *   B  the same call with no task resident: 0 before and after;
+ *   C  WAIT_SIGNAL shape: a bisl straight to 0xA70: back in the task 9 / 0;
+ *   D  a task call to a lifted helper in the task region: 9 throughout;
+ *   E  C, then a computed call (bisl) into the task region: the helper runs
+ *      with the task resident and the caller's frame survives the call
+ *      (policy module only: the old path takes the false resume there);
+ *   F  a "kernel" calls the policy, which branches to the task's saved pc
+ *      (the resume longjmp): a job module left as resident_ovl that has a
+ *      lift at that pc must not run it -- the base image's lift runs
+ *      (policy module) / the job module's (=0: the old path);
+ *   G  the same branch at host depth 0 (a resumed run that starts in the
+ *      policy): the same.
+ *
+ * Run it twice: `test_spu_task_residency 1` (the policy module) and
+ * `test_spu_task_residency 0` (SPU_TASKSET_LLE=0). No game code: the "task",
+ * the "policy", the "kernel" and the "job module" are a few lines of C written
+ * as the lifter lowers them.
+ *
+ * Build (Windows, clang-cl; from the toolkit root, the runtime's own flags):
+ *   clang-cl /O2 /std:c17 -MD -msse4.1 -fno-strict-aliasing -ffp-contract=off \
+ *       -I include -I runtime/spu -I runtime/platform \
+ *       runtime/spu/tests/test_spu_task_residency.c \
+ *       runtime/spu/spu_channels.c runtime/spu/spu_drain.c runtime/spu/spu_interp.c \
+ *       runtime/spu/spu_coherency.c runtime/spu/spu_lockstep.c \
+ *       runtime/spu/spu_workload.c runtime/spu/spurs_policy.c runtime/spu/spurs_job.c \
+ *       runtime/spu/spu_tsp_weak.c runtime/spu/spu_vm_pagemap.c \
+ *       runtime/spu/spurs_policy_blob_weak.c runtime/platform/win32_compat.c \
+ *       /Fe:test_spu_task_residency.exe
+ *
+ * Exit code: 0 if all passed, 1 if any failed. Final line prints a summary.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "spu_context.h"
+#include "spu_helpers.h"
+
+typedef void (*test_spu_fn)(spu_context*);
+void spu_begin_image(int image_id);
+void spu_register_function(uint32_t addr, test_spu_fn fn);
+int  spu_run_with_halt(void (*entry)(spu_context*), spu_context* ctx);
+void spu_stop(spu_context* ctx);
+void spu_halt(spu_context* ctx);
+void spu_taskset_lle_configure(int on);
+int  spu_taskset_lle_on(void);
+void spu_taskset_register_task_elf(uint32_t elf_ea, int image_id, int policy_image_id);
+
+/* Guest memory: nothing here issues a DMA. */
+uint8_t* vm_base = NULL;
+uint32_t ppu_vm_size = 0;
+
+#define TEST_IMG 62           /* the task's (and the kernel's) lifted functions */
+#define TASK_IMG 9            /* the resident task the runs start with */
+#define PM_IMG   77           /* the policy: a co-resident code region at 0xA00 */
+#define JOB_IMG  88           /* a job module left as the streamed overlay */
+#define TASK_ELF 0x0080A100u  /* TaskInfo's ELF, registered with the policy */
+
+static int g_pass, g_fail;
+static void check(int ok, const char* what)
+{
+    if (ok) { g_pass++; return; }
+    g_fail++;
+    printf("  FAIL: %s\n", what);
+}
+
+/* brsl rt, f -- a direct call into a lifted function (spu_lifter.py's bracket) */
+#define L_BRSL(c, link_rt, f, link) do {                                        \
+        (c)->gpr[link_rt] = spu_link(link);                                     \
+        { int32_t _si = (int32_t)(c)->image_id; (c)->host_depth++;              \
+          f(c); spu_drain_call((c), (link));                                    \
+          (c)->host_depth--; spu_img_restore((c), _si); }                       \
+    } while (0)
+
+/* bisl $r0, rt -- a computed call (spu_lifter.py's bisl bracket) */
+#define L_BISL(c, target, link) do {                                            \
+        (c)->gpr[0] = spu_link(link);                                           \
+        { int32_t _si = (int32_t)(c)->image_id; (c)->pc = (target);             \
+          (c)->host_depth++; (c)->drain_ret_pc = (link);                        \
+          spu_indirect_branch(c); spu_drain_call((c), (link));                  \
+          (c)->host_depth--; spu_img_restore((c), _si); }                       \
+    } while (0)
+
+#define L_STOP(c, code) do {                                                    \
+        (c)->stop_code = (code); (c)->status = SPU_STATUS_STOPPED_BY_STOP;      \
+        spu_stop(c); return;                                                    \
+    } while (0)
+
+static spu_context* new_ctx(int resident_task)
+{
+    spu_context* c = (spu_context*)calloc(1, sizeof *c);
+    if (!c) { printf("out of memory\n"); exit(2); }
+    spu_context_init(c, 0);
+    c->image_id = TEST_IMG;
+    c->status = SPU_STATUS_RUNNING;
+    c->resident_task = resident_task;
+    c->resident_code[0].image_id = PM_IMG;     /* the taskset policy, a co-resident region */
+    c->resident_code[0].lsa = 0xA00;
+    c->resident_code[0].size = 0x1E40;
+    c->ls[0x2794] = (uint8_t)(TASK_ELF >> 24); c->ls[0x2795] = (uint8_t)(TASK_ELF >> 16);
+    c->ls[0x2796] = (uint8_t)(TASK_ELF >> 8);  c->ls[0x2797] = (uint8_t)TASK_ELF;
+    spu_res_changed(c);
+    return c;
+}
+
+/* What the runs saw: the residency inside the "policy", back in the caller,
+ * in a task helper, and whether the caller's frame survived a later call. */
+static int g_in_pm, g_after, g_helper, g_line;
+
+/* The syscall entry (0xA70, below the task region), shaped like inFamous 2's
+ * pm_30023680: it saves the link, answers at once, then a direct trampoline
+ * to 0xB60, which restores the link and returns through it (`bi $r0`). */
+static uint32_t s_saved_r0;
+static void pm_B60(spu_context* c)
+{
+    c->gpr[0]._u32[0] = s_saved_r0;
+    c->pc = c->gpr[0]._u32[0];
+    g_spu_trampoline_fn = spu_indirect_branch;
+}
+static void pm_A70(spu_context* c)
+{
+    g_in_pm = c->resident_task;
+    s_saved_r0 = c->gpr[0]._u32[0];
+    c->gpr[3] = spu_splat_u32(0);
+    c->pc = 0xB60;
+    g_spu_trampoline_fn = pm_B60;
+}
+
+/* A task's syscall wrapper (in the task region): r3 = the syscall, then a
+ * tail branch through the syscall address -- `bi $r4`, as inFamous 2's
+ * psarc task's POLL wrapper does. */
+static void t_wrap(spu_context* c)
+{
+    c->gpr[3] = spu_splat_u32(3);
+    c->pc = 0xA70;
+    g_spu_trampoline_fn = spu_indirect_branch;
+}
+
+/* A, B: the task calls the wrapper (link 0x3108). */
+static void t_main_a(spu_context* c)
+{
+    L_BRSL(c, 0, t_wrap, 0x3108);
+    g_after = c->resident_task;
+    L_STOP(c, 0x201);
+}
+
+/* C: the WAIT_SIGNAL shape -- r3 = 2, a bisl straight to 0xA70 (0x9C7C). */
+static void t_main_c(spu_context* c)
+{
+    c->gpr[3] = spu_splat_u32(2);
+    L_BISL(c, 0xA70, 0x3508);
+    g_after = c->resident_task;
+    L_STOP(c, 0x202);
+}
+
+/* D: a task helper that stays in the task region. */
+static void t_helper(spu_context* c)
+{
+    g_helper = c->resident_task;
+    SPU_RET(c);
+}
+static void t_main_d(spu_context* c)
+{
+    L_BRSL(c, 0, t_helper, 0x3408);
+    g_after = c->resident_task;
+    L_STOP(c, 0x203);
+}
+
+/* E: C, then a computed call into the task region (the LFQueue pop's
+ * `bisl $r6` at 0xA28C). */
+static void t_main_e(spu_context* c)
+{
+    c->gpr[3] = spu_splat_u32(2);
+    L_BISL(c, 0xA70, 0x3608);
+    g_after = c->resident_task;
+    L_BISL(c, 0x3300, 0x3610);
+    g_line = 1;                       /* the caller's frame survived the call */
+    L_STOP(c, 0x204);
+}
+
+/* F, G: a policy resume. 0x3800 has a lift in the base image (the task's
+ * code: the task's own image has none there -- a computed branch into the
+ * middle of a function) and one in the job module (its code at the same LS). */
+static const char* g_ran;
+static int g_ovl_at_run;
+static void at3800(spu_context* c, const char* who)
+{
+    g_ran = who;
+    g_ovl_at_run = c->resident_ovl;
+    c->stop_code = 0x300; c->status = SPU_STATUS_STOPPED_BY_STOP;
+    spu_halt(c);
+}
+static void base_3800(spu_context* c) { at3800(c, "the base image"); }
+static void job_3800(spu_context* c)  { at3800(c, "the job module"); }
+/* the policy restored the task and branches to its saved pc */
+static void pm_A00(spu_context* c)
+{
+    c->pc = 0x3800;
+    g_spu_trampoline_fn = spu_indirect_branch;
+}
+/* the kernel calls the policy (bisl $r0, $r11 at 0x800) */
+static void k_main(spu_context* c)
+{
+    L_BISL(c, 0xA00, 0x804);
+    L_STOP(c, 0x2FF);
+}
+
+static void run(void (*entry)(spu_context*), int rt, uint32_t want_stop, const char* name)
+{
+    spu_context* c = new_ctx(rt);
+    g_in_pm = g_after = g_helper = -1;
+    g_line = 0;
+    spu_run_with_halt(entry, c);
+    if (!(c->status == SPU_STATUS_STOPPED_BY_STOP && c->stop_code == want_stop))
+        printf("  (%s: run ended with status 0x%X stop 0x%X, wanted stop 0x%X)\n",
+               name, c->status, c->stop_code, want_stop);
+    check(c->status == SPU_STATUS_STOPPED_BY_STOP && c->stop_code == want_stop, "the run reaches its stop");
+    free(c);
+}
+
+static void run_resume(void (*entry)(spu_context*), const char* name, int lle)
+{
+    spu_context* c = new_ctx(0);
+    c->image_id = TEST_IMG;
+    c->resident_ovl = JOB_IMG;                 /* the job module that ran last */
+    spu_res_changed(c);
+    g_ran = "nothing";
+    g_ovl_at_run = -1;
+    spu_run_with_halt(entry, c);
+    printf("  %s: 0x3800 ran %s (resident_ovl %d)\n", name, g_ran, g_ovl_at_run);
+    if (lle)
+        check(!strcmp(g_ran, "the base image") && g_ovl_at_run == 0,
+              "a task taken up from the policy drops the streamed overlay");
+    else
+        check(!strcmp(g_ran, "the job module"), "SPU_TASKSET_LLE=0 keeps the old path (the overlay stays named)");
+    free(c);
+}
+
+int main(int argc, char** argv)
+{
+    const int lle = argc > 1 && argv[1][0] == '1';
+    printf("SPU task residency across a policy-answered syscall (%s)\n",
+           lle ? "SPU_TASKSET_LLE: the policy module" : "SPU_TASKSET_LLE=0: the old path");
+#ifdef _WIN32
+    _putenv("SPU_TASKSET_LLE=");
+#else
+    unsetenv("SPU_TASKSET_LLE");
+#endif
+    spu_taskset_lle_configure(lle);
+    check(spu_taskset_lle_on() == lle, "the title's choice is the decision");
+    spu_taskset_register_task_elf(TASK_ELF, TASK_IMG, PM_IMG);
+    spu_begin_image(TEST_IMG);
+    spu_register_function(0x800, k_main);
+    spu_register_function(0x3100, t_main_a);
+    spu_register_function(0x3200, t_wrap);
+    spu_register_function(0x3300, t_helper);
+    spu_register_function(0x3400, t_main_d);
+    spu_register_function(0x3500, t_main_c);
+    spu_register_function(0x3600, t_main_e);
+    spu_register_function(0x3800, base_3800);
+    spu_begin_image(PM_IMG);
+    spu_register_function(0xA00, pm_A00);
+    spu_register_function(0xA70, pm_A70);
+    spu_register_function(0xB60, pm_B60);
+    spu_begin_image(JOB_IMG);
+    spu_register_function(0x3800, job_3800);
+    spu_begin_image(0);
+
+    run(t_main_a, TASK_IMG, 0x201, "A");
+    printf("  A (POLL shape): in the policy %d, back in the task %d\n", g_in_pm, g_after);
+    check(g_in_pm == 0, "A: the policy runs with no task resident");
+    check(g_after == (lle ? TASK_IMG : 0),
+          lle ? "A: back in the task its residency is given back" : "A: the old path gives nothing back");
+
+    run(t_main_a, 0, 0x201, "B");
+    check(g_in_pm == 0 && g_after == 0, "B: no task resident: 0 before and after");
+
+    run(t_main_c, TASK_IMG, 0x202, "C");
+    printf("  C (WAIT_SIGNAL shape): in the policy %d, back in the task %d\n", g_in_pm, g_after);
+    check(g_in_pm == 0, "C: the policy runs with no task resident");
+    check(g_after == (lle ? TASK_IMG : 0),
+          lle ? "C: back in the task its residency is given back" : "C: the old path gives nothing back");
+
+    run(t_main_d, TASK_IMG, 0x203, "D");
+    check(g_helper == TASK_IMG && g_after == TASK_IMG, "D: a call that stays in the task region keeps the residency");
+
+    if (lle) {
+        run(t_main_e, TASK_IMG, 0x204, "E");
+        printf("  E (WAIT_SIGNAL, then a computed call): helper %d, caller's frame %s\n",
+               g_helper, g_line ? "survived" : "LOST");
+        check(g_helper == TASK_IMG && g_line == 1,
+              "E: after the syscall a computed call is a call, not a resume");
+    }
+
+    run_resume(k_main, "F (resume at depth > 0)", lle);
+    run_resume(pm_A00, "G (resume at depth 0)", lle);
+
+    printf("%d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * The rest of the program the runtime files reach for. None is reached here.
+ * -----------------------------------------------------------------------*/
+static void unexpected(const char* f) { fprintf(stderr, "unexpected call: %s\n", f); exit(3); }
+uint32_t g_barrier_sync_watch = 0;
+uint32_t g_spu_image_ls_start = 0, g_spu_image_span = 0, g_spu_image_src_ea = 0;
+uint32_t g_ydkj_real_spurs_ea = 0, g_ydkj_real_taskid = 0, g_ydkj_real_taskset_ea = 0;
+uint32_t lv2_spu_bound_queue(const void* s, uint32_t n) { (void)s; (void)n; unexpected("lv2_spu_bound_queue"); return 0; }
+int sys_event_queue_receive_for_spu(uint32_t q, int b, void* o) { (void)q; (void)b; (void)o; unexpected("sys_event_queue_receive_for_spu"); return 0; }
+uint64_t ps3_guest_dilate_ns(uint64_t a, uint64_t b) { return b - a; }
