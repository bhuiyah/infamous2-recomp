@@ -9,6 +9,7 @@
 #include "cellResc.h"
 #include "../../runtime/ppu/ppu_memory.h"   /* GUEST_PTR, vm_write*: translate + byte-swap */
 #include "ps3emu/guest_call.h"   /* ps3_invoke_guest: handlers are guest OPDs */
+#include "../../runtime/savestate/ss_state.h"   /* field lists: this file's part of MISC */
 #include <stdio.h>
 #include <string.h>
 
@@ -302,3 +303,40 @@ s32 cellRescAdjustAspectRatio(float horizontal, float vertical)
     s_aspect_v = vertical;
     return CELL_OK;
 }
+
+/* ---------------------------------------------------------------------------
+ * Save states: cellResc's part of the MISC section (runtime/savestate/
+ * ss_state.h), written by cellSysmodule.c, which registers the section.
+ * Every static here is guest-visible and plain: the init config (the guest's
+ * struct as it was copied), display mode, sources and destinations, the
+ * handlers' OPDs, the display buffer the next convert-and-flip presents, the
+ * flip status and its counter (not a clock), the aspect and PAL ratios.
+ * -----------------------------------------------------------------------*/
+static const ss_field k_resc_ss_fields[] = {
+    SS_FIELD(s_initialized), SS_FIELD(s_config), SS_FIELD(s_display_mode),
+    SS_FIELD(s_src), SS_FIELD(s_dsts), SS_FIELD(s_flip_handler_opd),
+    SS_FIELD(s_vblank_handler_opd), SS_FIELD(s_flip_target), SS_FIELD(s_flip_status),
+    SS_FIELD(s_last_flip_time), SS_FIELD(s_aspect_h), SS_FIELD(s_aspect_v),
+    SS_FIELD(s_pal_ratio),
+};
+const ss_list cellResc_ss_list = SS_LIST("resc", k_resc_ss_fields);
+
+/* A load (M4c; cellSysmodule.c reads the image, ss_read_fields writes the
+ * list -- all of this library's state -- back by value). Teardown: the boot
+ * values. */
+void cellResc_ss_teardown(void)
+{
+    s_initialized = 0;
+    memset(&s_config, 0, sizeof(s_config));
+    s_display_mode = CELL_RESC_1280x720;
+    memset(s_src, 0, sizeof(s_src));
+    memset(s_dsts, 0, sizeof(s_dsts));
+    s_flip_handler_opd = 0;
+    s_vblank_handler_opd = 0;
+    s_flip_target = 0;
+    s_flip_status = 0;
+    s_last_flip_time = 0;
+    s_aspect_h = 1.0f;
+    s_aspect_v = 1.0f;
+    s_pal_ratio = 0.5f;
+}
diff --git a/libs/video/cellVideoOut.c b/libs/video/cellVideoOut.c
