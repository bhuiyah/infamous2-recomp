+extern "C" int ppu_cont_register(const ppu_cont_entry* t, uint32_t n, uint32_t entry_size,
+                                 uint32_t abi, const char* image)
+{
+    if (abi != PPU_CONT_ABI || entry_size != (uint32_t)sizeof(ppu_cont_entry)) {
+        fprintf(stderr, "[resume] %s: continuation table ABI %u / %u-byte entries, runtime "
+                        "wants %u / %u -- ignored (relift with this toolkit's ppu_lifter.py)\n",
+                image ? image : "?", abi, entry_size, (unsigned)PPU_CONT_ABI,
+                (unsigned)sizeof(ppu_cont_entry));
+        return 0;
+    }
+    if (!t || !n) return 0;
+    for (uint32_t i = 1; i < n; i++)
+        if (t[i - 1].ra >= t[i].ra) {
+            fprintf(stderr, "[resume] %s: continuation table not sorted at 0x%08X -- ignored\n",
+                    image ? image : "?", t[i].ra);
+            return 0;
+        }
+    if (s_nimg >= MAX_IMAGES) return 0;
+    s_img[s_nimg].t = t;
+    s_img[s_nimg].n = n;
+    s_img[s_nimg].name = image ? image : "?";
+    s_nimg++;
+    const char* lg = getenv("PPU_RESUME_LOG");
+    if (lg && *lg && *lg != '0')
+        fprintf(stderr, "[resume] %s: %u continuations, 0x%08X..0x%08X\n",
+                image ? image : "?", n, t[0].ra, t[n - 1].ra);
+    return 1;
+}
