+def _is_uncond_exit(line: str) -> bool:
+    """A lifted line after which the C function cannot fall through: return,
+    an unconditional goto, a trampoline / indirect tail jump, a switch."""
+    s = line.strip()
+    if not s or s.startswith("if (") or s.endswith(":"):
+        return False
+    return (s.startswith("return;") or s.startswith("goto ")
+            or s.endswith("return;") or s.endswith("return; }"))
+
+
+def _is_call_line(mnemonic: str, c_line: str) -> bool:
+    """True for a lifted instruction that CALLS and then continues here:
+    bl, bctrl, blrl, b<cond>ctrl / bcctrl, b<cond>lrl, and sc. A `bl` into
+    non-code lifts to a comment and is not a call."""
+    if mnemonic == "sc":
+        return "lv2_syscall(ctx);" in c_line
+    if not mnemonic.startswith("b") or "DRAIN_TRAMPOLINE(ctx);" not in c_line:
+        return False
+    if mnemonic == "bl":
+        return True
+    return mnemonic.endswith("ctrl") or mnemonic.endswith("lrl")
