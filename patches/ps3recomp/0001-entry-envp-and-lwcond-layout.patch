+"""Independent reference vectors for pad_hid_sony.c's unit tests.
+
+Builds the expected Sony output reports and the synthesized Bluetooth input /
+feature reports straight from the documented layouts (Linux hid-playstation /
+hid-sony, RPCS3), with Python's zlib.crc32 as the reference CRC-32. Nothing
+here is derived from the C code. Writes sony_vectors.h (next to the tests).
+
+    py -I libs/input/tests/sony_vectors.py libs/input/tests/sony_vectors.h
+"""
+import struct
+import sys
+import zlib
+
+assert zlib.crc32(b"123456789") == 0xCBF43926   # the CRC-32 check value
+
+# Must match the mock core in tests/test_pad_hid_sony.c.
+PORT_RGB = [(0x00, 0x00, 0x40), (0x40, 0x00, 0x00), (0x00, 0x40, 0x00), (0x20, 0x00, 0x20),
+            (0x40, 0x10, 0x00), (0x00, 0x20, 0x20), (0x20, 0x20, 0x20)]
+PORT_LED = [0x1, 0x2, 0x4, 0x8, 0x9, 0xA, 0xC]          # PS3 numbering, bit 0 = LED 1
+DS5_PLAYER = [0x04, 0x0A, 0x15, 0x1B, 0x1F, 0x17, 0x1D]
+
+
+def bt_crc(seed, data):
+    """CRC-32 over the BT transaction header byte + report (zlib polynomial)."""
+    return zlib.crc32(data, zlib.crc32(bytes([seed]))) & 0xFFFFFFFF
+
+
+def seal(seed, rep):
+    """Store the CRC of rep[:-4] little-endian in the last 4 bytes."""
+    rep[-4:] = struct.pack("<I", bt_crc(seed, bytes(rep[:-4])))
+    return rep
+
+
+# --- DS4 output -------------------------------------------------------------
+def ds4_usb_out(small, large, port):
+    r = bytearray(32)
+    r[0] = 0x05
+    r[1] = 0x07                      # valid_flag0: motor | led | blink
+    r[4] = 255 if small else 0      # motor_right (weak)
+    r[5] = large                    # motor_left (strong)
+    r[6:9] = bytes(PORT_RGB[port])
+    return r
+
+
+def ds4_bt_out(small, large, port):
+    r = bytearray(78)
+    r[0] = 0x11
+    r[1] = 0xC0 | 0x04              # HID | CRC32 | 4 ms poll interval
+    r[3] = 0x07
+    r[6] = 255 if small else 0
+    r[7] = large
+    r[8:11] = bytes(PORT_RGB[port])
+    return seal(0xA2, r)
+
+
+# --- DualSense output -------------------------------------------------------
+def ds5_common(small, large, port, v2):
+    c = bytearray(47)
+    c[0] = 0x02 | (0 if v2 else 0x01)     # HAPTICS_SELECT | COMPATIBLE_VIBRATION (v1)
+    c[1] = 0x04 | 0x10                    # LIGHTBAR_CONTROL_ENABLE | PLAYER_INDICATOR_CONTROL_ENABLE
+    c[2] = 255 if small else 0            # motor_right
+    c[3] = large                          # motor_left
+    c[38] = 0x04 if v2 else 0             # COMPATIBLE_VIBRATION2
+    c[43] = DS5_PLAYER[port]
+    c[44:47] = bytes(PORT_RGB[port])
+    return c
+
+
+def ds5_reset_common():
+    c = bytearray(47)
+    c[38] = 0x02                          # LIGHTBAR_SETUP_CONTROL_ENABLE
+    c[41] = 0x02                          # LIGHT_OUT
+    return c
+
+
+def ds5_usb_out(common):
+    return bytearray([0x02]) + common     # 48 bytes on Windows
+
+
+def ds5_bt_out(common, seq):
+    r = bytearray(78)
+    r[0] = 0x31
+    r[1] = (seq & 15) << 4
+    r[2] = 0x10
+    r[3:50] = common
+    return seal(0xA2, r)
+
+
+# --- DS3 output -------------------------------------------------------------
+def ds3_native_out(small, large, port):
+    r = bytearray(36)
+    r[0] = 0x01
+    r[2] = 0xFF
+    r[3] = 1 if small else 0
+    r[4] = 0xFF
+    r[5] = large
+    r[10] = PORT_LED[port] << 1
+    for i in range(4):
+        r[11 + 5 * i:16 + 5 * i] = bytes([0xFF, 0x27, 0x10, 0x00, 0x32])
+    return r
+
+
+def ds3_sxs_out(small, large, port):
+    n = ds3_native_out(small, large, port)
+    n[0] = 0x00                                 # RPCS3 _WIN32: id 0, then 02 00 00, then raw bytes 1..
+    return bytearray([0x00, 0x02, 0x00]) + n
+
+
+# --- synthesized device-side reports ----------------------------------------
+def ds4_bt_input():
+    r = bytearray(78)
+    r[0] = 0x11
+    r[1] = 0xC0
+    c = 3
+    r[c + 0:c + 4] = bytes([0x10, 0xF0, 0x80, 0x7F])
+    r[c + 4] = 0x20 | 0x02                 # cross, hat = right
+    r[c + 5] = 0x01 | 0x08 | 0x20 | 0x80   # L1, R2, Options, R3
+    r[c + 6] = 0x01 | 0x02                 # PS, touchpad click
+    r[c + 7] = 0x00
+    r[c + 8] = 0xC8
+    r[c + 12:c + 18] = struct.pack("<hhh", 0, -1600, 0)
+    r[c + 18:c + 24] = struct.pack("<hhh", 0, 8192, 0)
+    r[c + 29] = 0x08                       # level 8, no cable -> 85 %
+    return seal(0xA1, r)
+
+
+def ds4_bt_calibration():
+    r = bytearray(41)
+    r[0] = 0x05
+    # bias, then BT order: pitch+, yaw+, roll+, pitch-, yaw-, roll-
+    r[1:7] = struct.pack("<hhh", 0, 0, 0)
+    r[7:19] = struct.pack("<hhhhhh", 8000, 8000, 8000, -8000, -8000, -8000)
+    r[19:23] = struct.pack("<hh", 500, 500)
+    r[23:35] = struct.pack("<hhhhhh", 8192, -8192, 8192, -8192, 8192, -8192)
+    return seal(0xA3, r)
+
+
+def ds5_bt_input():
+    r = bytearray(78)
+    r[0] = 0x31
+    r[1] = 0x50                            # sequence / tag byte
+    b = 2
+    r[b + 0:b + 4] = bytes([0x00, 0xFF, 0x40, 0xC0])
+    r[b + 4] = 0x33                        # L2 analog
+    r[b + 5] = 0x00
+    r[b + 7] = 0x80 | 0x05                 # triangle, hat = down-left
+    r[b + 8] = 0x10 | 0x40                 # Create, L3
+    r[b + 9] = 0x04                        # mute
+    r[b + 15:b + 21] = struct.pack("<hhh", 0, 2000, 0)
+    r[b + 21:b + 27] = struct.pack("<hhh", -8192, 0, 0)
+    r[b + 52] = 0x13                       # charging, level 3 -> 35 %
+    return seal(0xA1, r)
+
+
+def ds5_bt_calibration():
+    r = bytearray(41)
+    r[0] = 0x05
+    r[1:7] = struct.pack("<hhh", -2, 0, 0)
+    r[7:19] = struct.pack("<hhhhhh", 8880, -8876, 8831, -8822, 8833, -8835)   # the real pad's values
+    r[19:23] = struct.pack("<hh", 540, 540)
+    r[23:35] = struct.pack("<hhhhhh", 8202, -8194, 8036, -8350, 8193, -8217)
+    return seal(0xA3, r)
+
+
+def ds5_bt_firmware(update_version):
+    r = bytearray(64)
+    r[0] = 0x20
+    r[1:21] = b"Jan  1 2021 00:00:00"
+    r[24:28] = struct.pack("<I", 0x00000414)
+    r[28:32] = struct.pack("<I", 0x0110002A)
+    r[44:46] = struct.pack("<H", update_version)
+    return seal(0xA3, r)
+
+
+def ds5_bt_pairing():
+    r = bytearray(20)
+    r[0] = 0x09
+    r[1:7] = bytes([0xBD, 0xED, 0x38, 0xEF, 0x66, 0x7C])   # LSB first
+    return r
+
+
+def emit(f, name, data):
+    f.write("static const unsigned char %s[%d] = {" % (name, len(data)))
+    for i, b in enumerate(data):
+        if i % 16 == 0:
+            f.write("\n   ")
+        f.write(" 0x%02X," % b)
+    f.write("\n};\n")
+
+
+def main():
+    out = sys.argv[1] if len(sys.argv) > 1 else "sony_vectors.h"
+    with open(out, "w", newline="\n") as f:
+        f.write("/* Generated by tools/sony_vectors.py -- reference vectors, zlib CRC-32. */\n")
+        f.write("#define VEC_CRC_CHECK 0x%08Xu /* crc32(\"123456789\") */\n" % zlib.crc32(b"123456789"))
+        emit(f, "vec_ds4_usb_out_p0", ds4_usb_out(1, 0x80, 0))
+        emit(f, "vec_ds4_bt_out_p1", ds4_bt_out(0, 0xFF, 1))
+        emit(f, "vec_ds5_usb_out_p2_v2", ds5_usb_out(ds5_common(1, 0x20, 2, True)))
+        emit(f, "vec_ds5_usb_reset", ds5_usb_out(ds5_reset_common()))
+        emit(f, "vec_ds5_bt_reset_seq0", ds5_bt_out(ds5_reset_common(), 0))
+        emit(f, "vec_ds5_bt_out_p3_v1_seq1", ds5_bt_out(ds5_common(0, 0x99, 3, False), 1))
+        emit(f, "vec_ds3_out_p4", ds3_native_out(1, 0x40, 4))
+        emit(f, "vec_ds3_sxs_out_p6", ds3_sxs_out(0, 0xFF, 6))
+        emit(f, "vec_ds4_bt_in", ds4_bt_input())
+        emit(f, "vec_ds4_bt_cal", ds4_bt_calibration())
+        emit(f, "vec_ds5_bt_in", ds5_bt_input())
+        emit(f, "vec_ds5_bt_cal", ds5_bt_calibration())
+        emit(f, "vec_ds5_bt_fw_0200", ds5_bt_firmware(0x0200))
+        emit(f, "vec_ds5_bt_pair", ds5_bt_pairing())
+        # The CRCs on their own, for the log / a reader checking by hand.
+        f.write("/* ds4_bt_out_p1 crc %08X, ds5_bt_reset_seq0 crc %08X, ds5_bt_out_p3_v1_seq1 crc %08X */\n" % (
+            bt_crc(0xA2, bytes(ds4_bt_out(0, 0xFF, 1)[:74])),
+            bt_crc(0xA2, bytes(ds5_bt_out(ds5_reset_common(), 0)[:74])),
+            bt_crc(0xA2, bytes(ds5_bt_out(ds5_common(0, 0x99, 3, False), 1)[:74]))))
+
+
+if __name__ == "__main__":
+    main()
