+     * yet" (restore is M4c) ---------------------------------------------------- */
+    InterlockedExchange(&g_walk_all_ok, 0);
+    run_request(SS_P_SAVE, 0.2, 3000, &res);
+    printf("phase 12a: save -> reason=%s (%s): %s\n", ss_reason_name(res.reason), res.detail, res.why);
+    CHECK(!res.ok && res.reason == SS_REASON_NOT_RESUMABLE && !strcmp(res.detail, "main") &&
