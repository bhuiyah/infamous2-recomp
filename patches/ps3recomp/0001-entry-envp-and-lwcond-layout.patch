+/* ATTRn inputs a compiled vertex shader actually reads. The DXBC input
+ * signature (ISGN) lists every declared input -- the decompiled VS declares
+ * all 16 -- with a "used" component mask (byte 21 of each 24-byte element):
+ * zero for an input no instruction reads, set for conditional reads, and set
+ * for all inputs when the program indexes them dynamically (checked against
+ * d3dcompiler_47, perf/vertex/test/isgn.c). Unknown -> 0xFFFF. */
+static u32 dxbc_attr_mask(ID3DBlob* blob)
+{
+    if (!blob) return 0xFFFFu;
+    const u8* p = (const u8*)blob->lpVtbl->GetBufferPointer(blob);
+    const size_t size = blob->lpVtbl->GetBufferSize(blob);
+    #define DXRD32(q) ((u32)(q)[0] | ((u32)(q)[1] << 8) | ((u32)(q)[2] << 16) | ((u32)(q)[3] << 24))
+    if (!p || size < 32 || memcmp(p, "DXBC", 4)) return 0xFFFFu;
+    const u32 nch = DXRD32(p + 28);
+    if (32u + 4u * (size_t)nch > size) return 0xFFFFu;
+    for (u32 c = 0; c < nch; c++) {
+        const u32 off = DXRD32(p + 32 + 4 * c);
+        if ((size_t)off + 8 > size) return 0xFFFFu;
+        if (memcmp(p + off, "ISGN", 4)) continue;
+        const u32 csz = DXRD32(p + off + 4);
+        const u8* d = p + off + 8;
+        if (csz < 8 || (size_t)off + 8 + csz > size) return 0xFFFFu;
+        const u32 n = DXRD32(d), eo = DXRD32(d + 4);
+        if ((size_t)eo + 24u * n > csz) return 0xFFFFu;
+        u32 mask = 0;
+        for (u32 i = 0; i < n; i++) {
+            const u8* e = d + eo + 24u * i;
+            const u32 no = DXRD32(e), si = DXRD32(e + 4);
+            if (no >= csz || !memchr(d + no, 0, csz - no)) return 0xFFFFu;
+            if (_stricmp((const char*)d + no, "ATTR") == 0 && si < 16 && e[21])
+                mask |= 1u << si;
+        }
+        return mask;
+    }
+    #undef DXRD32
+    return 0xFFFFu;
