+static guest_fn lookup_fn(uint32_t a)
+{
+    for (uint64_t i = 0; i < function_table_count; i++)
+        if ((uint32_t)function_table[i].addr == a) return function_table[i].func;
+    return nullptr;
+}
+static void load_image(void)
+{
+    for (size_t i = 0; i < sizeof g_image / sizeof g_image[0]; i++)
+        wbe(g_image_base + 4 * i, g_image[i], 4);
+}
+static const bool HAVE_CODE = true;
+#endif
+
+extern "C" void ps3_indirect_call(ppu_context* ctx)
+{
+    guest_fn f = lookup_fn((uint32_t)ctx->ctr);
+    if (!f) { fprintf(stderr, "unresolved icall 0x%llX\n", (unsigned long long)ctx->ctr); abort(); }
+    f(ctx);
+    drain(ctx);
+}
+
+/* ---------------- threads, the frame barrier, safepoints ---------------- */
+enum { NT = 2 };
+struct ParkRec { ppu_context ctx; int kind; uint32_t nid; int valid; };
+static ppu_context g_ctx[NT];
+static std::mutex g_mx;
+static std::condition_variable g_cv;
+static int g_arrived = 0;
+static uint32_t g_frame = 0;               /* the "kernel object" state */
+static std::atomic<int> g_snap_req{0};
+static int g_parked = 0;
+static ParkRec g_park[NT];
+static const char* g_snap_path = nullptr;
+static bool g_capture = false;             /* neg tests: keep the parks in memory */
+static std::condition_variable g_captured_cv;
+static bool g_captured = false;
+static PPU_THREAD_LOCAL int t_idx;
+
+static ppu_resume_park park_of(int idx)
+{
+    ppu_resume_park p;
+    memset(&p, 0, sizeof p);
+    p.kind = g_park[idx].kind;
+    p.nid = g_park[idx].nid;
+    p.root_lr = 0;                          /* threads are entered with LR 0 */
+    p.stack_lo = idx == 0 ? MAIN_STACK_LO : WORKER_STACK_LO;
+    p.stack_hi = idx == 0 ? MAIN_SP + 48 : WORKER_SP + 48;
+    return p;
+}
+
+static int validate(int idx, const char* when)
+{
+    static ppu_resume_chain ch;
+    ppu_resume_park p = park_of(idx);
+    int err = ppu_resume_walk(&g_park[idx].ctx, &p, &ch);
+    char buf[1024];
+    ppu_resume_format_chain(&ch, buf, sizeof buf);
+    printf("[%s] thread %d %s chain (%d frames):%s\n", when, idx,
+           g_park[idx].kind == PPU_PARK_SC ? "sc" : "hle", ch.n, buf);
+    fflush(stdout);
+    return err;
+}
+
+static void write_snapshot()
+{
+    for (int i = 0; i < NT; i++)
+        if (validate(i, "save")) { printf("[save] REFUSED\n"); fflush(stdout); _exit(3); }
+    FILE* f = fopen(g_snap_path, "wb");
+    if (!f) _exit(5);
+    fwrite("CONTSNP1", 1, 8, f);
+    fwrite(&g_arrived, sizeof g_arrived, 1, f);
+    fwrite(&g_frame, sizeof g_frame, 1, f);
+    fwrite(g_park, sizeof g_park, 1, f);
+    fwrite(vm_base, 1, VM_SIZE, f);
+    fclose(f);
+    printf("[save] wrote %s at frame %u\n", g_snap_path, g_frame);
+    fflush(stdout);
+    _exit(0);
+}
+
+/* Park this thread at an HLE/syscall ENTRY: record the entry ctx and the call. */
+static void park_locked(const ppu_context* entry, int kind, uint32_t nid, std::unique_lock<std::mutex>& lk)
+{
+    g_park[t_idx].ctx = *entry; g_park[t_idx].kind = kind; g_park[t_idx].nid = nid; g_park[t_idx].valid = 1;
+    if (++g_parked == NT) {
+        if (!g_capture) write_snapshot();
+        g_captured = true;
+        g_captured_cv.notify_all();
+    }
+    for (;;) g_cv.wait(lk);                 /* never released: the process exits */
+}
+static void safepoint(const ppu_context* ctx, int kind, uint32_t nid)
+{
+    if (!g_snap_req.load()) return;
+    std::unique_lock<std::mutex> lk(g_mx);
+    park_locked(ctx, kind, nid, lk);
+}
+static uint32_t barrier_arrive(const ppu_context* entry, int kind, uint32_t nid)
+{
+    std::unique_lock<std::mutex> lk(g_mx);
+    uint32_t my = g_frame;
+    if (++g_arrived == NT) { g_arrived = 0; g_frame++; g_cv.notify_all(); return g_frame; }
+    while (g_frame == my) {
+        if (g_snap_req.load()) { g_arrived--; park_locked(entry, kind, nid, lk); }  /* cancel -> entry */
+        g_cv.wait(lk);
+    }
+    return g_frame;
+}
+extern "C" void ps3_hle_call(uint32_t nid, ppu_context* ctx)
+{
+    if (g_test_entry_hook) g_test_entry_hook(ctx, PPU_PARK_HLE, nid);
+    if (g_ppu_resume_probe) g_ppu_resume_probe(ctx, PPU_PARK_HLE, nid);   /* as the scaffold does */
+    safepoint(ctx, PPU_PARK_HLE, nid);
+    if (nid == NID_BARRIER) {
+        ppu_context e = *ctx;
+        ctx->gpr[3] = (uint64_t)barrier_arrive(&e, PPU_PARK_HLE, nid) * 1000 + e.gpr[3];
+        return;
+    }
+    abort();
+}
+extern "C" void lv2_syscall(ppu_context* ctx)
+{
+    if (g_test_entry_hook) g_test_entry_hook(ctx, PPU_PARK_SC, (uint32_t)ctx->gpr[11]);
+    if (g_ppu_resume_probe) g_ppu_resume_probe(ctx, PPU_PARK_SC, (uint32_t)ctx->gpr[11]);
+    safepoint(ctx, PPU_PARK_SC, (uint32_t)ctx->gpr[11]);
+    if (ctx->gpr[11] == SC_BARRIER) {
+        ppu_context e = *ctx;
+        ctx->gpr[3] = (uint64_t)barrier_arrive(&e, PPU_PARK_SC, SC_BARRIER) * 1000 + e.gpr[3];
+        return;
+    }
+    abort();
+}
+
+/* ---------------- running, resuming ---------------- */
+static void fresh_thread(int idx, uint32_t entry, uint32_t sp, uint64_t r3)
+{
+    t_idx = idx;
+    ppu_context* ctx = &g_ctx[idx];
+    memset(ctx, 0, sizeof *ctx);
+    ctx->gpr[1] = sp; ctx->gpr[3] = r3; ctx->thread_id = (uint64_t)idx + 1; ctx->lr = 0;
+    guest_fn f = lookup_fn(entry);
+    if (!f) { fprintf(stderr, "entry 0x%08X not lifted\n", entry); abort(); }
+    f(ctx);
+    drain(ctx);
+}
+static void resume_thread(int idx)
+{
+    t_idx = idx;
+    ParkRec p = g_park[idx];
+    ppu_resume_park pk = park_of(idx);
+    ppu_context* ctx = &g_ctx[idx];
+    *ctx = p.ctx;
+    uint32_t steps = ppu_resume_run(ctx, &pk);
+    printf("[resume] thread %d reached its root after %u continuation(s)\n", idx, steps);
+    fflush(stdout);
+}
+static void init_world(void)
+{
+    memset(vm_base, 0, VM_SIZE);
+    load_image();
+    vm_write32(ITER_ADDR, ITER);
+    vm_write32(OBJ, 0x00100100);           /* obj->vtbl */
+    vm_write32(0x00100100, 0x00100200);    /* vtbl[0] -> OPD */
+    vm_write32(0x00100200, VTBL_TARGET); vm_write32(0x00100204, 0x00700000);
+}
+static void start_fresh(std::thread th[NT])
+{
+    th[0] = std::thread(fresh_thread, 0, MAIN_ENTRY, (uint32_t)MAIN_SP, (uint64_t)OBJ);
+    th[1] = std::thread(fresh_thread, 1, WORKER_ENTRY, (uint32_t)WORKER_SP, (uint64_t)0);
+}
+static void request_snapshot(void)
+{
+    { std::lock_guard<std::mutex> lk(g_mx); g_parked = 0; memset(g_park, 0, sizeof g_park); g_snap_req = 1; }
+    g_cv.notify_all();
+}
+static int finish(const char* result_path)
+{
+    char line[200];
+    snprintf(line, sizeof line, "frame=%u main=%016llX worker=%016llX counter=%u", g_frame,
+             (unsigned long long)vm_read64(MAIN_HASH), (unsigned long long)vm_read64(WORKER_HASH),
+             vm_read32(OBJ_COUNTER));
+    printf("[done] %s\n", line);
+    fflush(stdout);
+    if (result_path) { FILE* f = fopen(result_path, "w"); if (f) { fprintf(f, "%s\n", line); fclose(f); } }
+    return 0;
+}
+
+/* ---------------- negative tests (in process, threads parked) ---------------- */
+static int g_fail;
+#define CHECK(c) do { if (!(c)) { printf("FAIL line %d: %s\n", __LINE__, #c); g_fail++; } } while (0)
+
+static int walk_ctx(const ppu_context* c, int kind, int idx, ppu_resume_chain* ch)
+{
+    ppu_resume_park p = park_of(idx);
+    p.kind = kind;
+    return ppu_resume_walk(c, &p, ch);
+}
+
+static void neg_dummy(ppu_context*) { abort(); }
+
+static void neg_tests(void)
+{
+    static ppu_resume_chain ch;
+    ParkRec m = g_park[0], w = g_park[1];
+    CHECK(m.valid && w.valid && m.kind == PPU_PARK_HLE && w.kind == PPU_PARK_SC);
+    /* Both live chains validate, end at the thread root, main's runs through the
+     * bctrl made from the tail fragment, in its owner's frame. */
+    CHECK(walk_ctx(&m.ctx, m.kind, 0, &ch) == PPU_RESUME_OK && ch.root == PPU_RESUME_ROOT_LR && ch.n == 3);
+    if (ch.n == 3) {
+        CHECK(ch.f[1].e->call_kind == PPU_CONT_CALL_INDIRECT && ch.f[1].e->owner == 0x00010180u);
+        CHECK(ch.f[1].sp == ch.f[0].sp + 0x90 && ch.f[2].sp == ch.f[1].sp + 0x80);
+        if (HAVE_CODE) CHECK(ch.f[1].link == 1);   /* main's bl into 0x10100 made the 0x80 frame */
+    }
+    CHECK(walk_ctx(&w.ctx, w.kind, 1, &ch) == PPU_RESUME_OK && ch.root == PPU_RESUME_ROOT_LR && ch.n == 2);
+    /* No continuation for the return address. */
+    ppu_context c = m.ctx; c.lr = 0x00010004;
+    CHECK(walk_ctx(&c, PPU_PARK_HLE, 0, &ch) == PPU_RESUME_ERR_NO_CONT && ch.err_ra == 0x00010004u);
+    /* ...while the probe's census walk steps over that frame with the ABI back
+     * chain and still checks the two above it. */
+    { ppu_resume_park p = park_of(0);
+      CHECK(walk_impl(&c, &p, &ch, 1) == PPU_RESUME_OK && ch.missing == 1 && ch.n == 3 &&
+            !ch.f[0].e && ch.f[1].e && ch.f[2].e && ch.root == PPU_RESUME_ROOT_LR); }
+    /* A syscall that recorded no return address (code lifted without sc_ra). */
+    c = w.ctx; c.sc_ra = 0;
+    CHECK(walk_ctx(&c, PPU_PARK_SC, 1, &ch) == PPU_RESUME_ERR_NO_RA);
+    /* r1 misaligned / outside the stack. */
+    c = m.ctx; c.gpr[1] += 4;
+    CHECK(walk_ctx(&c, PPU_PARK_HLE, 0, &ch) == PPU_RESUME_ERR_SP);
+    /* A corrupted back chain: the frame is not the shape the continuation pops. */
+    const uint32_t sp0 = (uint32_t)m.ctx.gpr[1];
+    const uint64_t bc0 = vm_read64(sp0);
+    vm_write64(sp0, bc0 + 0x10);
+    CHECK(walk_ctx(&m.ctx, PPU_PARK_HLE, 0, &ch) == PPU_RESUME_ERR_FRAME_SHAPE && ch.err_sp == sp0);
+    vm_write64(sp0, bc0);
+    /* An exit the lifter could not model is refused. */
+    static const ppu_cont_entry unk[] = {
+        { 0x00FFFF00u, 0x00FFFE00u, neg_dummy, 0, 0, 0, PPU_CONT_CALL_INDIRECT, PPU_CONT_EXIT_UNKNOWN, 0, 0 } };
+    CHECK(ppu_cont_register(unk, 1, (uint32_t)sizeof(ppu_cont_entry), PPU_CONT_ABI, "neg") == 1);
+    c = m.ctx; c.lr = 0x00FFFF00;
+    CHECK(walk_ctx(&c, PPU_PARK_HLE, 0, &ch) == PPU_RESUME_ERR_EXIT_UNKNOWN);
+    /* A table of another ABI is not taken. */
+    CHECK(ppu_cont_register(unk, 1, (uint32_t)sizeof(ppu_cont_entry) + 8, PPU_CONT_ABI, "bad") == 0);
+    CHECK(ppu_cont_register(unk, 1, (uint32_t)sizeof(ppu_cont_entry), PPU_CONT_ABI + 1, "bad") == 0);
+    if (HAVE_CODE) {
+        /* The image in memory is not the one lifted: the call at ra-4 differs. */
+        const uint32_t ra0 = (uint32_t)m.ctx.lr, ins = vm_read32(ra0 - 4);
+        vm_write32(ra0 - 4, 0x60000000u);  /* nop */
+        CHECK(walk_ctx(&m.ctx, PPU_PARK_HLE, 0, &ch) == PPU_RESUME_ERR_CALL_MISMATCH);
+        vm_write32(ra0 - 4, ins);
+        /* A STALE saved LR (what a lift without the bctrl LR store leaves): the
+         * slot names the return site of the last `bl` (into the leaf 0x10200),
+         * whose frame is the right size -- only the link check catches it. */
+        const ppu_cont_entry* stale = nullptr;
+        for (int k = 0; k < s_nimg && !stale; k++)
+            for (uint32_t i = 0; i < s_img[k].n; i++)
+                if (s_img[k].t[i].call_kind == PPU_CONT_CALL_BL && s_img[k].t[i].callee == 0x00010200u &&
+                    s_img[k].t[i].owner == 0x00010100u)
+                    stale = &s_img[k].t[i];
+        CHECK(stale != nullptr);
+        if (stale) {
+            const uint32_t slot = sp0 + 0x90 + 0x10;      /* func_00010300's LR save slot */
+            const uint64_t saved = vm_read64(slot);
+            vm_write64(slot, stale->ra);
+            CHECK(walk_ctx(&m.ctx, PPU_PARK_HLE, 0, &ch) == PPU_RESUME_ERR_LINK);
+            vm_write64(slot, saved);
+        }
+    }
+    CHECK(walk_ctx(&m.ctx, PPU_PARK_HLE, 0, &ch) == PPU_RESUME_OK);   /* all restored */
+}
+
+/* ---------------- the orchestrator ---------------- */
+static std::string g_self;
+
+static int spawn(const std::vector<std::string>& args)
+{
+#ifdef _WIN32
+    std::vector<std::string> q;
+    for (const auto& a : args) q.push_back(a.find(' ') == std::string::npos ? a : "\"" + a + "\"");
+    std::vector<const char*> av;
+    std::string exe = "\"" + g_self + "\"";
+    av.push_back(exe.c_str());
+    for (const auto& a : q) av.push_back(a.c_str());
+    av.push_back(nullptr);
+    fflush(stdout);
+    return (int)_spawnv(_P_WAIT, g_self.c_str(), av.data());
+#else
+    fflush(stdout);
+    pid_t pid = fork();
+    if (pid == 0) {
+        std::vector<char*> av;
+        av.push_back((char*)g_self.c_str());
+        for (const auto& a : args) av.push_back((char*)a.c_str());
+        av.push_back(nullptr);
+        execv(g_self.c_str(), av.data());
+        _exit(127);
+    }
+    int st = 0;
+    waitpid(pid, &st, 0);
+    return WIFEXITED(st) ? WEXITSTATUS(st) : 128;
+#endif
+}
+static std::string slurp(const std::string& p)
+{
+    FILE* f = fopen(p.c_str(), "rb");
+    if (!f) return "";
+    char b[256] = {0};
+    size_t n = fread(b, 1, sizeof b - 1, f);
+    fclose(f);
+    std::string s(b, n);
+    while (!s.empty() && (s.back() == '\n' || s.back() == '\r')) s.pop_back();
+    return s;
+}
+static void set_env(const char* k, const char* v)
+{
+#ifdef _WIN32
+    _putenv_s(k, v ? v : "");
+#else
+    if (v) setenv(k, v, 1); else unsetenv(k);
+#endif
+}
+
+#ifndef CONT_TEST_NO_MAIN    /* test_ss_selfresume.cpp brings its own */
+static int orchestrate(const std::string& dir)
+{
+    auto P = [&](const char* n) { return dir + "/" + n; };
+    auto t0 = std::chrono::steady_clock::now();
+    CHECK(spawn({"run", P("ref.txt")}) == 0);
+    const double ms = (double)std::chrono::duration_cast<std::chrono::milliseconds>(
+                          std::chrono::steady_clock::now() - t0).count();
+    const std::string ref = slurp(P("ref.txt"));
+    char want[200];
+    snprintf(want, sizeof want, "frame=%u main=%016llX worker=%016llX counter=%u", (unsigned)ITER,
+             (unsigned long long)REF_MAIN, (unsigned long long)REF_WORKER, (unsigned)ITER);
+    printf("[test] reference run %.0f ms: %s\n", ms, ref.c_str());
+    CHECK(ref == want);                                  /* the study's numbers */
+    /* Five snapshot times across the run, each loaded in a fresh process. */
+    int saved = 0;
+    const double frac[] = { 0.03, 0.1, 0.2, 0.35, 0.5 };
+    for (double fr : frac) {
+        char t[32], s[64], r[64];
+        snprintf(t, sizeof t, "%d", (int)(ms * fr) > 0 ? (int)(ms * fr) : 1);
+        snprintf(s, sizeof s, "s%d.bin", (int)(fr * 100));
+        snprintf(r, sizeof r, "s%d.txt", (int)(fr * 100));
+        remove(P(s).c_str());
+        int rc = spawn({"save", t, P(s)});
+        if (rc == 4) { printf("[test] save at %s ms: run finished first (skipped)\n", t); continue; }
+        CHECK(rc == 0);
+        if (rc) continue;
+        saved++;
+        CHECK(spawn({"load", P(s), P(r)}) == 0);
+        const std::string got = slurp(P(r));
+        printf("[test] snapshot at %s ms -> %s\n", t, got.c_str());
+        CHECK(got == ref);
+    }
+    CHECK(saved >= 3);
+    /* Three generations: save, load + save, load + save, load. */
+    char t1[32], t2[32];
+    snprintf(t1, sizeof t1, "%d", (int)(ms * 0.2) > 0 ? (int)(ms * 0.2) : 1);
+    snprintf(t2, sizeof t2, "%d", (int)(ms * 0.05) > 0 ? (int)(ms * 0.05) : 1);
+    int rc = spawn({"save", t1, P("c0.bin")});
+    CHECK(rc == 0);
+    if (!rc) {
+        CHECK(spawn({"load", P("c0.bin"), P("c0.txt"), t2, P("c1.bin")}) == 0);
+        CHECK(spawn({"load", P("c1.bin"), P("c1.txt"), t2, P("c2.bin")}) == 0);
+        CHECK(spawn({"load", P("c2.bin"), P("c2.txt")}) == 0);
+        const std::string got = slurp(P("c2.txt"));
+        printf("[test] three generations -> %s\n", got.c_str());
+        CHECK(got == ref);
+    }
+    /* Negative tests, in a child (its parked threads never come back). */
+    CHECK(spawn({"neg"}) == 0);
+    /* The PPU_RESUME_CHECK_EVERY probe: every chain of a full run validates. */
+    set_env("PPU_RESUME_CHECK_EVERY", "1");
+    CHECK(spawn({"probe", P("probe.txt")}) == 0);
+    set_env("PPU_RESUME_CHECK_EVERY", nullptr);
+    CHECK(slurp(P("probe.txt")) == ref);
+    printf("%s: continuation resume (%d failure%s)\n", g_fail ? "FAIL" : "PASS", g_fail,
+           g_fail == 1 ? "" : "s");
+    return g_fail ? 1 : 0;
+}
+
+int main(int argc, char** argv)
+{
+    g_self = argv[0];
+    vm_base = (uint8_t*)calloc(1, VM_SIZE);
+    const std::string mode = argc > 1 ? argv[1] : "all";
+    std::thread th[NT];
+    if (mode == "all" || (mode != "run" && mode != "save" && mode != "load" && mode != "neg" &&
+                          mode != "probe")) {
+        const std::string dir = argc > 2 ? argv[2] : (mode == "all" ? "." : mode);
+        return orchestrate(dir);
+    }
+    if (mode == "neg") {
+        init_world();
+        g_capture = true;
+        start_fresh(th);
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        request_snapshot();
+        { std::unique_lock<std::mutex> lk(g_mx); g_captured_cv.wait(lk, [] { return g_captured; }); }
+        neg_tests();
+        printf("[neg] %s (%d failure%s)\n", g_fail ? "FAIL" : "pass", g_fail, g_fail == 1 ? "" : "s");
+        fflush(stdout);
+        _exit(g_fail ? 1 : 0);
+    }
+    if (mode == "run" || mode == "probe") {
+        init_world();
+        start_fresh(th);
+        for (auto& t : th) t.join();
+        if (mode == "probe") {
+            const uint64_t bad = s_n_samples.load() - s_n_ok.load();
+            printf("[probe] samples=%llu ok=%llu refused=%llu\n", (unsigned long long)s_n_samples.load(),
+                   (unsigned long long)s_n_ok.load(), (unsigned long long)bad);
+            if (!s_n_samples.load() || bad) { finish(nullptr); return 1; }
+        }
+        return finish(argc > 2 ? argv[2] : nullptr);
+    }
+    if (mode == "save") {
+        if (argc < 4) return 2;
+        g_snap_path = argv[3];
+        init_world();
+        start_fresh(th);
+        std::this_thread::sleep_for(std::chrono::milliseconds(atoi(argv[2])));
+        request_snapshot();
+        for (auto& t : th) t.join();      /* only if the run finished before every thread parked */
+        return 4;
+    }
+    /* load <snap> <result> [<ms> <snap2>] */
+    if (argc < 4) return 2;
+    FILE* f = fopen(argv[2], "rb");
+    char mg[8];
+    if (!f || fread(mg, 1, 8, f) != 8 || memcmp(mg, "CONTSNP1", 8)) { printf("bad snapshot\n"); return 1; }
+    if (fread(&g_arrived, sizeof g_arrived, 1, f) != 1 || fread(&g_frame, sizeof g_frame, 1, f) != 1 ||
+        fread(g_park, sizeof g_park, 1, f) != 1 || fread(vm_base, 1, VM_SIZE, f) != VM_SIZE) {
+        printf("short snapshot\n"); return 1; }
+    fclose(f);
+    printf("[load] frame=%u arrived=%d\n", g_frame, g_arrived);
+    for (int i = 0; i < NT; i++)
+        if (validate(i, "load")) { printf("[load] REFUSED\n"); return 3; }
+    if (argc >= 6) g_snap_path = argv[5];
+    for (int i = 0; i < NT; i++) th[i] = std::thread(resume_thread, i);
+    if (argc >= 6) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(atoi(argv[4])));
+        request_snapshot();
+    }
+    for (auto& t : th) t.join();
+    if (argc >= 6) return 4;              /* finished before the second snapshot */
+    return finish(argv[3]);
+}
+#endif /* CONT_TEST_NO_MAIN */
diff --git a/runtime/ppu/tests/test_hle_abi.cpp b/runtime/ppu/tests/test_hle_abi.cpp
new file mode 100644
index 0000000..a6693eb
--- /dev/null
+++ b/runtime/ppu/tests/test_hle_abi.cpp
@@ -0,0 +1,298 @@
+/*
+ * ps3recomp - PPC64 ELFv1 float/double HLE marshalling test.
+ *
+ * Encodes the rule (64-bit PowerPC ELF ABI Supplement 1.9, 3.2.3 and 3.2.4,
+ * T2) and checks both halves of the implementation:
+ *   A. the argument cursor in include/ps3emu/hle_abi.h, directly;
+ *   B. the thunks gen_hle_nids.py emits, end to end: the generator scans
+ *      hle_abi_mock.c, its output is compiled in, and each mock handler is
+ *      called through its thunk with a caller's register file and stack.
+ * The dispatcher wiring (ps3_hle_call -> thunk, PS3_HLE_ABI=0) is
+ * test_hle_abi_dispatch.cpp.
+ *
+ * run_test_hle_abi.py does all of it (and checks that the generator refuses
+ * hle_abi_mock_bad.c):
+ *   py runtime/ppu/tests/run_test_hle_abi.py [--lift <dir with ppu_recomp.h>]
+ * By hand, from external/ps3recomp:
+ *   py tools/gen_hle_nids.py --src runtime/ppu/tests/hle_abi_mock.c --out T/hle_abi_mock_gen.cpp
+ *   clang-cl /nologo /EHsc -std:c++17 -I include runtime/ppu/tests/test_hle_abi.cpp
+ *            runtime/ppu/tests/hle_abi_mock.c T/hle_abi_mock_gen.cpp /Fe:T/test_hle_abi.exe
+ */
+#include "ps3emu/hle_abi.h"
+#include "ps3emu/nid.h"
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+extern "C" {
+extern uint64_t g_mock_i[12];
+extern double   g_mock_f[16];
+extern int      g_mock_calls;
+extern char     g_mock_last[48];
+void ppu_hle_register_all(void);
+}
+
+static int s_fail = 0, s_pass = 0;
+#define CHECK(c, ...) do { if (c) s_pass++; else { s_fail++; printf("[FAIL] %s:%d: ", __FILE__, __LINE__); \
+                           printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+/* ---- a caller: register file + a sparse big-endian stack ------------------ */
+struct Caller {
+    uint64_t gpr[32];
+    double   fpr[32];
+    uint64_t sp;
+};
+static struct { uint64_t ea, val; } s_mem[32];
+static int s_nmem = 0;
+static uint64_t s_last_ea = 0;
+
+static void mem_clear(void) { s_nmem = 0; }
+static void mem_put(uint64_t ea, uint64_t v) { s_mem[s_nmem].ea = ea; s_mem[s_nmem].val = v; s_nmem++; }
+static uint64_t mem_load64(uint64_t ea)
+{
+    s_last_ea = ea;
+    for (int i = 0; i < s_nmem; i++) if (s_mem[i].ea == ea) return s_mem[i].val;
+    return 0xBADBADBADBADBAD0ull;   /* a read of a doubleword nobody stored */
+}
+static uint64_t dbits(double d) { uint64_t b; memcpy(&b, &d, 8); return b; }
+static uint32_t fbits(float f) { uint32_t b; memcpy(&b, &f, 4); return b; }
+
+static void caller_init(Caller* c)
+{
+    /* Poison everything: a value read from the wrong place shows up. */
+    for (int i = 0; i < 32; i++) {
+        c->gpr[i] = 0xDEAD000000000000ull | (uint64_t)i;
+        c->fpr[i] = -1000.0 - i;
+    }
+    c->sp = 0x0D000F00ull;
+    c->gpr[1] = c->sp;
+    mem_clear();
+}
+static void begin(ps3_abi_args* a, Caller* c) { ps3_abi_begin(a, c->gpr, c->fpr, c->sp, mem_load64); }
+
+/* ---- the generated registration table, captured ---------------------------- */
+struct Reg { uint32_t nid; const char* name; ps3_abi_thunk thunk; void* raw; };
+static Reg s_regs[64];
+static int s_nregs = 0;
+extern "C" void ps3_hle_register(unsigned int nid, const char* name, void* handler)
+{
+    s_regs[s_nregs].nid = nid; s_regs[s_nregs].name = name;
+    s_regs[s_nregs].thunk = nullptr; s_regs[s_nregs].raw = handler; s_nregs++;
+}
+extern "C" void ps3_hle_register_abi(unsigned int nid, const char* name, ps3_abi_thunk thunk,
+                                     void* handler)
+{
+    s_regs[s_nregs].nid = nid; s_regs[s_nregs].name = name;
+    s_regs[s_nregs].thunk = thunk; s_regs[s_nregs].raw = handler; s_nregs++;
+}
+static const Reg* reg(const char* name)
+{
+    for (int i = 0; i < s_nregs; i++) if (!strcmp(s_regs[i].name, name)) return &s_regs[i];
+    return nullptr;
+}
+/* Call a mock through its generated thunk. Returns the save-area reads. */
+static unsigned call(const char* name, Caller* c, ps3_abi_ret* r)
+{
+    const Reg* g = reg(name);
+    r->kind = -1; r->gpr = 0x5555; r->fpr = -5555.0;
+    if (!g || !g->thunk) { CHECK(0, "%s has no ABI thunk", name); return 0; }
+    g_mock_calls = 0; memset(g_mock_i, 0, sizeof(uint64_t) * 12);
+    for (int i = 0; i < 16; i++) g_mock_f[i] = -7777.0;
+    ps3_abi_args a; begin(&a, c);
+    g->thunk(&a, r);
+    CHECK(g_mock_calls == 1 && !strcmp(g_mock_last, name), "%s: handler not called once (%d, %s)",
+          name, g_mock_calls, g_mock_last);
+    return a.mem_reads;
+}
+
+/* ---- A. the cursor ---------------------------------------------------------- */
+static void test_cursor(void)
+{
+    Caller c; ps3_abi_args a;
+
+    /* Figure 3-18: func(c, ff, d, ...) puts c in r3, ff in f1, d in r5. The
+     * slot counter advances for every parameter, the FPR counter for floats. */
+    caller_init(&c);
+    c.gpr[3] = 11; c.fpr[1] = 2.5; c.gpr[5] = 33; c.fpr[2] = (double)0.75f; c.gpr[7] = 55;
+    begin(&a, &c);
+    CHECK(ps3_abi_int(&a) == 11, "c in r3");
+    CHECK(ps3_abi_f64(&a) == 2.5, "ff in f1 (r4 skipped)");
+    CHECK(ps3_abi_int(&a) == 33, "d in r5");
+    CHECK(ps3_abi_f32(&a) == 0.75f, "gg in f2 (r6 skipped)");
+    CHECK(ps3_abi_int(&a) == 55, "e in r7");
+    CHECK(a.slot == 5 && a.nfpr == 2 && a.mem_reads == 0, "slot=%u nfpr=%u mem=%u", a.slot, a.nfpr, a.mem_reads);
+
+    /* Ten integers: the 9th and 10th from the parameter save area at r1+48,
+     * doublewords 8 and 9 = r1+0x70 and r1+0x78. */
+    caller_init(&c);
+    for (int i = 0; i < 8; i++) c.gpr[3 + i] = 100 + i;
+    mem_put(c.sp + 0x70, 108); mem_put(c.sp + 0x78, 109);
+    begin(&a, &c);
+    for (int i = 0; i < 8; i++) CHECK(ps3_abi_int(&a) == (uint64_t)(100 + i), "int %d in r%d", i, 3 + i);
+    CHECK(ps3_abi_int(&a) == 108 && s_last_ea == c.sp + 0x70, "9th int at r1+0x70 (read 0x%llX)",
+          (unsigned long long)s_last_ea);
+    CHECK(ps3_abi_int(&a) == 109 && s_last_ea == c.sp + 0x78, "10th int at r1+0x78");
+    CHECK(a.mem_reads == 2, "two save-area reads, got %u", a.mem_reads);
+
+    /* A float past slot 8 is still in its FPR (Figure 3-18's hh in f5). */
+    caller_init(&c);
+    for (int i = 0; i < 8; i++) c.gpr[3 + i] = i;
+    mem_put(c.sp + 0x70, 8);
+    c.fpr[1] = (double)1.25f;
+    begin(&a, &c);
+    for (int i = 0; i < 9; i++) (void)ps3_abi_int(&a);
+    s_last_ea = 0;
+    CHECK(ps3_abi_f32(&a) == 1.25f && s_last_ea == 0, "float in slot 9 comes from f1, not memory");
+
+    /* Fourteen floats: f1..f13, then the 14th from doubleword 13 = r1+0x98;
+     * a single is the second (low-order) word of its doubleword. */
+    caller_init(&c);
+    for (int i = 1; i <= 13; i++) c.fpr[i] = (double)(float)(i * 0.5);
+    mem_put(c.sp + 0x98, 0xCAFEF00D00000000ull | fbits(-6.5f));
+    begin(&a, &c);
+    for (int i = 1; i <= 13; i++) CHECK(ps3_abi_f32(&a) == (float)(i * 0.5), "float %d in f%d", i, i);
+    CHECK(ps3_abi_f32(&a) == -6.5f && s_last_ea == c.sp + 0x98, "14th float: low word at r1+0x98");
+    caller_init(&c);
+    mem_put(c.sp + 0x98, dbits(1e300));
+    begin(&a, &c);
+    for (int i = 1; i <= 13; i++) (void)ps3_abi_f64(&a);
+    CHECK(ps3_abi_f64(&a) == 1e300, "14th double: whole doubleword at r1+0x98");
+
+    /* Results: r3 widened by the declared signedness; f1 for floats. */
+    ps3_abi_ret r;
+    ps3_abi_ret_s64(&r, (int64_t)(int32_t)-5);
+    CHECK(r.kind == PS3_ABI_RET_GPR && r.gpr == 0xFFFFFFFFFFFFFFFBull, "s32 -5 sign-extended");
+    ps3_abi_ret_u64(&r, (uint64_t)(uint32_t)0xFFFFFFFFu);
+    CHECK(r.kind == PS3_ABI_RET_GPR && r.gpr == 0x00000000FFFFFFFFull, "u32 zero-extended");
+    ps3_abi_ret_f32(&r, 0.1f);
+    CHECK(r.kind == PS3_ABI_RET_FPR && r.fpr == (double)0.1f, "float result in f1, single precision");
+    ps3_abi_ret_none(&r);
+    CHECK(r.kind == PS3_ABI_RET_NONE, "void result");
+}
+
+/* ---- B. the generated thunks ------------------------------------------------- */
+static void test_generated(void)
+{
+    s_nregs = 0;
+    ppu_hle_register_all();
+
+    /* Which prototypes got thunks. */
+    static const char* abi[] = { "cellMockSetGamma", "cellMockGlyph", "cellMockMixed",
+        "cellMockTwoFloats", "cellMockTypedef", "cellMockEnumCb", "cellMockRetFloat",
+        "cellMockRetDouble", "cellMockVoidFloat", "cellMockFourteen",
+        "cellMockNinePlusFloat", "cellMockTwelve", "cellMockFnPtrFloat" };
+    static const char* plain[] = { "cellMockIntOnly", "cellMockFloatPtr" };
+    for (const char* n : abi) {
+        const Reg* g = reg(n);
+        CHECK(g && g->thunk && g->raw, "%s registered with an ABI thunk", n);
+        if (g) CHECK(g->nid == ps3_compute_nid(n), "%s NID", n);
+    }
+    for (const char* n : plain) {
+        const Reg* g = reg(n);
+        CHECK(g && !g->thunk && g->raw, "%s registered on the integer adapter", n);
+    }
+    CHECK(s_nregs == 15, "15 registrations, got %d", s_nregs);
+
+    Caller c; ps3_abi_ret r;
+
+    /* A raw function-pointer parameter is one slot, whatever commas sit in
+     * its own parameter list: cb r3, f f1 (r4 skipped), n r5. */
+    caller_init(&c);
+    c.gpr[3] = 0x00ABC0; c.fpr[1] = (double)0.5f; c.gpr[5] = 9;
+    call("cellMockFnPtrFloat", &c, &r);
+    CHECK(g_mock_i[0] == 0x00ABC0 && g_mock_f[0] == 0.5 && g_mock_i[1] == 9,
+          "fn-ptr param: cb r3, f f1, n r5 (got 0x%llX %g %llu)", (unsigned long long)g_mock_i[0],
+          g_mock_f[0], (unsigned long long)g_mock_i[1]);
+
+    /* cellVideoOutSetGamma's shape, as inFamous 2's func_0013287C calls it:
+     * r3 = 0, the brightness in f1, r4 never written. */
+    caller_init(&c);
+    c.gpr[3] = 0; c.fpr[1] = (double)1.15f;
+    call("cellMockSetGamma", &c, &r);
+    CHECK(g_mock_i[0] == 0 && g_mock_f[0] == (double)1.15f, "gamma: videoOut=%llu gamma=%.9g",
+          (unsigned long long)g_mock_i[0], g_mock_f[0]);
+    CHECK(r.kind == PS3_ABI_RET_GPR && r.gpr == 0xFFFFFFFFFFFFFFFBull, "gamma: s32 -5 -> r3 sign-extended");
+
+    /* cellFontRenderCharGlyphImage: r3 r4 r5 f1 f2 r8 r9. */
+    caller_init(&c);
+    c.gpr[3] = 0x10000; c.gpr[4] = 0x41; c.gpr[5] = 0x20000; c.gpr[8] = 0x30000; c.gpr[9] = 0x40000;
+    c.fpr[1] = 12.5; c.fpr[2] = -3.25;
+    call("cellMockGlyph", &c, &r);
+    CHECK(g_mock_i[0] == 0x10000 && g_mock_i[1] == 0x41 && g_mock_i[2] == 0x20000 &&
+          g_mock_i[3] == 0x30000 && g_mock_i[4] == 0x40000, "glyph: integer args from r3 r4 r5 r8 r9");
+    CHECK(g_mock_f[0] == 12.5 && g_mock_f[1] == -3.25, "glyph: x,y from f1,f2 (got %g,%g)",
+          g_mock_f[0], g_mock_f[1]);
+
+    /* Figure 3-18 order with mixed signed ints. */
+    caller_init(&c);
+    c.gpr[3] = (uint64_t)(int64_t)-7; c.fpr[1] = 2.5e10; c.gpr[5] = 42; c.fpr[2] = (double)0.75f;
+    c.gpr[7] = (uint64_t)(int64_t)-1;
+    call("cellMockMixed", &c, &r);
+    CHECK((int64_t)g_mock_i[0] == -7 && g_mock_f[0] == 2.5e10 && g_mock_i[1] == 42 &&
+          g_mock_f[1] == 0.75 && (int64_t)g_mock_i[2] == -1, "mixed: c,ff,d,gg,e = r3,f1,r5,f2,r7");
+
+    caller_init(&c);
+    c.fpr[1] = 0.5; c.fpr[2] = 2.0;
+    call("cellMockTwoFloats", &c, &r);
+    CHECK(g_mock_f[0] == 0.5 && g_mock_f[1] == 2.0, "two floats: f1, f2");
+
+    caller_init(&c);
+    c.gpr[3] = 3; c.fpr[1] = 0.25;
+    call("cellMockTypedef", &c, &r);
+    CHECK(g_mock_i[0] == 3 && g_mock_f[0] == 0.25, "typedef'd scalar in r3, float in f1");
+
+    caller_init(&c);
+    c.gpr[3] = 7; c.gpr[4] = 0x1234; c.fpr[1] = 9.0;
+    call("cellMockEnumCb", &c, &r);
+    CHECK(g_mock_i[0] == 7 && g_mock_i[1] == 0x1234 && g_mock_f[0] == 9.0, "enum r3, callback r4, float f1");
+
+    caller_init(&c);
+    c.fpr[1] = 1.5; c.fpr[2] = 4.0;
+    call("cellMockRetFloat", &c, &r);
+    CHECK(r.kind == PS3_ABI_RET_FPR && r.fpr == 6.0, "float result -> f1 (kind %d, %g)", r.kind, r.fpr);
+
+    caller_init(&c);
+    c.gpr[3] = 3; c.fpr[1] = 0.1;
+    call("cellMockRetDouble", &c, &r);
+    CHECK(r.kind == PS3_ABI_RET_FPR && r.fpr == 0.1 * 2.0 + 3, "double result -> f1");
+
+    caller_init(&c);
+    c.fpr[1] = -0.5;
+    call("cellMockVoidFloat", &c, &r);
+    CHECK(r.kind == PS3_ABI_RET_NONE && g_mock_f[0] == -0.5, "void result leaves r3 alone");
+
+    caller_init(&c);
+    for (int i = 1; i <= 13; i++) c.fpr[i] = (double)(float)(i + 0.25);
+    mem_put(c.sp + 0x98, dbits(14.5));
+    unsigned mr = call("cellMockFourteen", &c, &r);
+    { int ok = 1; for (int i = 0; i < 13; i++) ok &= g_mock_f[i] == (double)(float)(i + 1 + 0.25);
+      CHECK(ok, "fourteen: f1..f13"); }
+    CHECK(g_mock_f[13] == 14.5 && mr == 1, "fourteen: 14th (double) from r1+0x98, %u memory read(s)", mr);
+
+    caller_init(&c);
+    for (int i = 0; i < 8; i++) c.gpr[3 + i] = 100 + i;
+    mem_put(c.sp + 0x70, 0xAAAAAAAA000000FFull);   /* u32 = the low word */
+    c.fpr[1] = 7.5;
+    mr = call("cellMockNinePlusFloat", &c, &r);
+    { int ok = 1; for (int i = 0; i < 8; i++) ok &= g_mock_i[i] == (uint64_t)(100 + i);
+      CHECK(ok, "nine+float: r3..r10"); }
+    CHECK(g_mock_i[8] == 0xFF && g_mock_f[0] == 7.5 && mr == 1,
+          "nine+float: 9th from r1+0x70 (0x%llX), float from f1 (%g)", (unsigned long long)g_mock_i[8], g_mock_f[0]);
+
+    caller_init(&c);
+    c.gpr[3] = 0x1FF;   /* u8 index: 0xFF */
+    for (int i = 1; i < 8; i++) c.gpr[3 + i] = (uint64_t)i;
+    for (int i = 8; i < 12; i++) mem_put(c.sp + 48 + 8u * (unsigned)i, (uint64_t)i);
+    mr = call("cellMockTwelve", &c, &r);
+    { int ok = g_mock_i[0] == 0xFF; for (int i = 1; i < 12; i++) ok &= g_mock_i[i] == (uint64_t)i;
+      CHECK(ok && mr == 4, "twelve ints: r3..r10 then r1+0x70..0x88 (%u memory reads)", mr); }
+}
+
+int main(void)
+{
+    test_cursor();
+    test_generated();
+    printf("test_hle_abi: %d passed, %d failed\n", s_pass, s_fail);
+    return s_fail ? 1 : 0;
+}
diff --git a/runtime/ppu/tests/test_hle_abi_dispatch.cpp b/runtime/ppu/tests/test_hle_abi_dispatch.cpp
new file mode 100644
index 0000000..8c077a7
--- /dev/null
+++ b/runtime/ppu/tests/test_hle_abi_dispatch.cpp
@@ -0,0 +1,202 @@
+/*
+ * ps3recomp - ps3_hle_call with ELFv1 thunk handlers (the dispatcher wiring
+ * of include/ps3emu/hle_abi.h; the rule itself is test_hle_abi.cpp).
+ *
+ * Links the real runtime/ppu/ppu_hle.cpp against stubs for everything else it
+ * reaches, so it needs a lift's ppu_recomp.h (the ppu_context layout):
+ *   clang-cl /nologo /EHsc -std:c++17 -I <lift> -I include -I runtime/ppu
+ *            runtime/ppu/tests/test_hle_abi_dispatch.cpp runtime/ppu/ppu_hle.cpp /Fe:T/d.exe
+ *   T/d.exe                          (thunk path)
+ *   set PS3_HLE_ABI=0 && T/d.exe legacy   (A/B switch: integer adapter)
+ * run_test_hle_abi.py --lift <dir> runs both.
+ */
+#include "ppu_recomp.h"
+#include "ps3emu/hle_abi.h"
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+extern "C" {
+void ps3_hle_register(uint32_t nid, const char* name, void* handler);
+void ps3_hle_register_abi(uint32_t nid, const char* name, ps3_abi_thunk thunk, void* handler);
+void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*));
+void ps3_hle_call(uint32_t nid, ppu_context* ctx);
+
+/* ---- what ppu_hle.cpp reaches, stubbed ---------------------------------- */
+static uint8_t s_ram[0x10000];   /* guest 0x0000..0xFFFF: the test's stack */
+uint8_t* vm_base = s_ram;
+uint64_t vm_read64(uint64_t a)
+{
+    uint64_t v = 0;
+    for (int i = 0; i < 8; i++) v = (v << 8) | s_ram[(a + (uint64_t)i) & 0xFFFF];
+    return v;
+}
+uint32_t vm_read32(uint64_t a) { return (uint32_t)(vm_read64(a) >> 32); }
+void vm_write64(uint64_t a, uint64_t v)
+{
+    for (int i = 7; i >= 0; i--) { s_ram[(a + (uint64_t)i) & 0xFFFF] = (uint8_t)v; v >>= 8; }
+}
+void vm_write32(uint64_t a, uint32_t v)
+{
+    for (int i = 3; i >= 0; i--) { s_ram[(a + (uint64_t)i) & 0xFFFF] = (uint8_t)v; v >>= 8; }
+}
+uint32_t prx_resolve_export(uint32_t nid) { (void)nid; return 0; }
+void ps3_indirect_call(ppu_context* ctx) { (void)ctx; }
+uint64_t ppu_guest_call(uint32_t opd, uint64_t, uint64_t, uint64_t, uint64_t,
+                        uint64_t, uint64_t, uint64_t, uint64_t) { (void)opd; return 0; }
+void ps3_msf(const char* fmt, ...) { (void)fmt; }
+void ppu_prof_stamp(void* ctx, unsigned lr) { (void)ctx; (void)lr; }
+uint32_t ppu_prof_resolve_host(void* ra) { (void)ra; return 0; }
+PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*) = nullptr;
+void (*g_ppu_resume_probe)(ppu_context* ctx, int kind, uint32_t nid) = nullptr;
+volatile long g_ss_req = 0;
+volatile long long g_ss_sr_mask = 0;
+void ss_ppu_safepoint(struct ppu_context* ctx, int at, uint32_t num, int tramp)
+{ (void)ctx; (void)at; (void)num; (void)tramp; }
+void ss_bridge_enter(uint32_t nid, uint32_t a, uint32_t b, uint32_t c) { (void)nid; (void)a; (void)b; (void)c; }
+void ss_bridge_leave(void) {}
+uint32_t g_ydkj_real_spurs_ea = 0, g_ydkj_real_taskset_ea = 0;
+void ppu_dump_guest_stack(ppu_context* ctx, const char* tag) { (void)ctx; (void)tag; }
+void ppu_dump_bctrl_ring(uint32_t tid, const char* tag) { (void)tid; (void)tag; }
+void ppu_guest_callstack(const char* tag) { (void)tag; }
+}
+
+static int s_fail = 0, s_pass = 0;
+#define CHECK(c, ...) do { if (c) s_pass++; else { s_fail++; printf("[FAIL] %s:%d: ", __FILE__, __LINE__); \
+                           printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+/* ---- handlers, and thunks written the way gen_hle_nids.py emits them ------ */
+static int      s_thunk_calls, s_raw_calls;
+static uint32_t s_got_out;
+static float    s_got_gamma;
+static uint32_t s_got10[10];
+
+extern "C" int32_t mock_set_gamma(uint32_t videoOut, float gamma)
+{
+    s_raw_calls++; s_got_out = videoOut; s_got_gamma = gamma;
+    return -2;
+}
+static void hle_abi_mock_set_gamma(ps3_abi_args* a, ps3_abi_ret* r)
+{
+    s_thunk_calls++;
+    uint32_t a0 = (uint32_t)ps3_abi_int(a);
+    float a1 = ps3_abi_f32(a);
+    ps3_abi_ret_s64(r, (int64_t)mock_set_gamma(a0, a1));
+}
+
+extern "C" float mock_scale(float x, uint32_t n)
+{
+    s_raw_calls++;
+    return x * (float)n;
+}
+static void hle_abi_mock_scale(ps3_abi_args* a, ps3_abi_ret* r)
+{
+    s_thunk_calls++;
+    float a0 = ps3_abi_f32(a);
+    uint32_t a1 = (uint32_t)ps3_abi_int(a);
+    ps3_abi_ret_f32(r, mock_scale(a0, a1));
+}
+
+extern "C" int32_t mock_ten(uint32_t a0, uint32_t a1, uint32_t a2, uint32_t a3, uint32_t a4,
+                            uint32_t a5, uint32_t a6, uint32_t a7, uint32_t a8, uint32_t a9)
+{
+    s_raw_calls++;
+    uint32_t v[10] = { a0, a1, a2, a3, a4, a5, a6, a7, a8, a9 };
+    memcpy(s_got10, v, sizeof v);
+    return 0;
+}
+static void hle_abi_mock_ten(ps3_abi_args* a, ps3_abi_ret* r)
+{
+    s_thunk_calls++;
+    uint32_t v[10];
+    for (int i = 0; i < 10; i++) v[i] = (uint32_t)ps3_abi_int(a);
+    ps3_abi_ret_s64(r, (int64_t)mock_ten(v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], v[9]));
+}
+
+extern "C" uint64_t mock_int(uint64_t a, uint64_t b) { s_raw_calls++; return a + b; }
+
+static int s_ctx_calls;
+static void mock_ctx_handler(ppu_context* ctx) { s_ctx_calls++; ctx->gpr[3] = 0x77; }
+
+static void ctx_init(ppu_context* c)
+{
+    memset(c, 0, sizeof *c);
+    for (int i = 0; i < 32; i++) { c->gpr[i] = 0xDEAD0000u + (unsigned)i; c->fpr[i] = -100.0 - i; }
+    c->gpr[1] = 0x8000;   /* stack in s_ram */
+    c->gpr[2] = 0x1234;   /* TOC */
+    c->thread_id = 1;
+}
+
+int main(int argc, char** argv)
+{
+    const int legacy = argc > 1 && !strcmp(argv[1], "legacy");   /* run with PS3_HLE_ABI=0 */
+    ps3_hle_register_abi(0x11110001u, "mock_set_gamma", hle_abi_mock_set_gamma, (void*)mock_set_gamma);
+    ps3_hle_register_abi(0x11110002u, "mock_scale", hle_abi_mock_scale, (void*)mock_scale);
+    ps3_hle_register_abi(0x11110003u, "mock_ten", hle_abi_mock_ten, (void*)mock_ten);
+    ps3_hle_register(0x11110004u, "mock_int", (void*)mock_int);
+    ps3_hle_register_abi(0x11110005u, "mock_ctx_wins", hle_abi_mock_set_gamma, (void*)mock_set_gamma);
+    ps3_hle_register_ctx(0x11110005u, "mock_ctx_wins", mock_ctx_handler);
+
+    ppu_context c;
+
+    /* inFamous 2's call: r3 = 0, gamma in f1, r4 never written. */
+    ctx_init(&c);
+    c.gpr[3] = 0; c.fpr[1] = (double)1.1f;
+    s_thunk_calls = s_raw_calls = 0;
+    ps3_hle_call(0x11110001u, &c);
+    if (!legacy) {
+        CHECK(s_thunk_calls == 1 && s_raw_calls == 1, "gamma: through the thunk");
+        CHECK(s_got_out == 0 && s_got_gamma == 1.1f, "gamma: videoOut=%u gamma=%.9g", s_got_out, (double)s_got_gamma);
+        CHECK(c.gpr[3] == 0xFFFFFFFFFFFFFFFEull, "gamma: r3 = -2 sign-extended (0x%llX)", (unsigned long long)c.gpr[3]);
+    } else {
+        CHECK(s_thunk_calls == 0 && s_raw_calls == 1, "legacy: integer adapter, thunk bypassed");
+    }
+    CHECK(c.gpr[2] == 0x1234, "TOC restored");
+
+    /* A float result goes to f1 and leaves r3 alone. */
+    ctx_init(&c);
+    c.fpr[1] = (double)2.5f; c.gpr[3] = 0xAAAA; c.gpr[4] = 4;
+    s_thunk_calls = s_raw_calls = 0;
+    ps3_hle_call(0x11110002u, &c);
+    if (!legacy) {
+        CHECK(s_thunk_calls == 1, "scale: through the thunk");
+        CHECK(c.fpr[1] == 10.0 && c.gpr[3] == 0xAAAA, "scale: f1=%g r3=0x%llX", c.fpr[1],
+              (unsigned long long)c.gpr[3]);
+    }
+
+    /* Ten integers: the 9th and 10th from the caller's save area at r1+0x70. */
+    ctx_init(&c);
+    for (int i = 0; i < 8; i++) c.gpr[3 + i] = 50 + (uint64_t)i;
+    vm_write64(c.gpr[1] + 0x70, 58);
+    vm_write64(c.gpr[1] + 0x78, 0xFFFFFFFF00000000ull | 59u);
+    s_thunk_calls = s_raw_calls = 0;
+    ps3_hle_call(0x11110003u, &c);
+    if (!legacy) {
+        int ok = 1;
+        for (int i = 0; i < 10; i++) ok &= s_got10[i] == (uint32_t)(50 + i);
+        CHECK(ok, "ten: r3..r10 then r1+0x70, r1+0x78 (got %u %u)", s_got10[8], s_got10[9]);
+    }
+
+    /* A ctx override for a NID that also has an ABI thunk still wins (what
+     * cellSaveDataListAutoLoad relies on): the ctx handler runs, the thunk and
+     * the raw handler do not. */
+    ctx_init(&c);
+    c.gpr[3] = 0; c.fpr[1] = (double)1.1f;
+    s_thunk_calls = s_raw_calls = s_ctx_calls = 0;
+    ps3_hle_call(0x11110005u, &c);
+    CHECK(s_ctx_calls == 1 && s_thunk_calls == 0 && s_raw_calls == 0 && c.gpr[3] == 0x77,
+          "ctx override wins over the thunk (ctx %d thunk %d raw %d)", s_ctx_calls, s_thunk_calls,
+          s_raw_calls);
+
+    /* An integer-only handler is untouched by any of this. */
+    ctx_init(&c);
+    c.gpr[3] = 40; c.gpr[4] = 2;
+    s_raw_calls = 0;
+    ps3_hle_call(0x11110004u, &c);
+    CHECK(s_raw_calls == 1 && c.gpr[3] == 42, "integer adapter: r3 = %llu", (unsigned long long)c.gpr[3]);
+
+    printf("test_hle_abi_dispatch%s: %d passed, %d failed\n", legacy ? " (PS3_HLE_ABI=0)" : "",
+           s_pass, s_fail);
+    return s_fail ? 1 : 0;
+}
diff --git a/runtime/ppu/tests/test_slotcheck.cpp b/runtime/ppu/tests/test_slotcheck.cpp
new file mode 100644
index 0000000..06eeb28
--- /dev/null
+++ b/runtime/ppu/tests/test_slotcheck.cpp
@@ -0,0 +1,251 @@
+/*
+ * Unit test for the --slotcheck reporter (runtime/ppu/ppu_slotcheck.h).
+ *
+ * The reporter is what turns ~80k instrumented call sites into one verdict
+ * ("mismatches=N") plus the first few details, so it is tested on its own
+ * here against a fake guest memory, with descriptors shaped the way
+ * tools/ppu_lifter.py --slotcheck emits them: clean slots stay silent, each
+ * slot kind is caught, details are rate-limited per function+slot and in
+ * total, fragments snapshot their owner's slots at entry, unreadable slots are
+ * reported (or skipped for an unreadable fragment snapshot), SLOTCHECK=0
+ * disarms, and the summary / SLOTCHECK_FUNCS outputs carry the counts.
+ * tools/test_ppu_slotcheck.py covers the lifter half end to end.
+ *
+ * Build and run from external/ps3recomp:
+ *   Windows: clang-cl /nologo /std:c++20 /EHsc /O1 runtime\ppu\tests\test_slotcheck.cpp
+ *                     /Fe:test_slotcheck.exe && test_slotcheck.exe [scratch-dir]
+ *   POSIX:   c++ -std=c++20 -O1 runtime/ppu/tests/test_slotcheck.cpp -lpthread
+ *                     -o test_slotcheck && ./test_slotcheck [scratch-dir]
+ * Exit status 0 = pass.
+ */
+#define PPU_SC_TESTING 1
+#ifdef _WIN32
+#  include <windows.h>
+#else
+#  include "../../platform/win32_compat.h"   /* SRWLOCK, GetTickCount64 */
+#endif
+#include "../ppu_context.h"
+#include <string>
+
+/* Fake guest memory: 128 KB at 0xD0000000 (a guest stack region). */
+static uint8_t g_mem[0x20000];
+static const uint32_t MEM = 0xD0000000u;
+
+static int ppu_sc_guest_read(uint32_t ea, unsigned width, uint64_t* out)
+{
+    if (ea < MEM || (uint64_t)ea + width > (uint64_t)MEM + sizeof g_mem) return 0;
+    uint64_t v = 0;
+    for (unsigned i = 0; i < width; i++) v = (v << 8) | g_mem[ea - MEM + i];
+    *out = v;
+    return 1;
+}
+#include "../ppu_slotcheck.h"
+
+static void put(uint32_t ea, uint64_t v, unsigned w = 8)
+{
+    for (unsigned i = 0; i < w; i++) g_mem[ea - MEM + i] = (uint8_t)(v >> (8 * (w - 1 - i)));
+}
+
+static int g_fail;
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); g_fail++; } } while (0)
+
+static void set_env(const char* k, const char* v)
+{
+#ifdef _WIN32
+    _putenv_s(k, v ? v : "");
+#else
+    if (v) setenv(k, v, 1); else unsetenv(k);
+#endif
+}
+
+static std::string slurp(const std::string& p)
+{
+    std::string s;
+    FILE* f = fopen(p.c_str(), "rb");
+    if (!f) return s;
+    char buf[4096]; size_t n;
+    while ((n = fread(buf, 1, sizeof buf, f)) > 0) s.append(buf, n);
+    fclose(f);
+    return s;
+}
+
+static int count(const std::string& hay, const char* needle)
+{
+    int n = 0;
+    for (size_t p = hay.find(needle); p != std::string::npos; p = hay.find(needle, p + 1)) n++;
+    return n;
+}
+
+static std::string g_dir = ".";
+static std::string arm(const char* name, const char* details = "64", const char* on = "1")
+{
+    ppu_sc_test_reset();
+    std::string log = g_dir + "/" + name + ".log";
+    set_env("SLOTCHECK", on);
+    set_env("SLOTCHECK_LOG", log.c_str());
+    set_env("SLOTCHECK_DETAILS", details);
+    set_env("SLOTCHECK_PER_KEY", "1");
+    set_env("SLOTCHECK_EVERY", "0");
+    set_env("SLOTCHECK_FUNCS", (g_dir + "/" + name + ".funcs").c_str());
+    return log;
+}
+
+/* A framed function as the lifter describes it: stdu r1,-0x90; LR saved at
+ * entry_sp+0x10; r30/r31 saved at entry_sp-0x10/-0x8; back chain at -0x90. */
+static const uint32_t SP0 = 0xD0010000u, FUNC = 0x00012340u, RA = 0x00012388u;
+static const uint32_t D_FRAMED[] = { FUNC, 4u,
+    (PPU_SC_LR << 8) | 0, 0x10u,
+    (PPU_SC_CS << 8) | 30, (uint32_t)-0x10,
+    (PPU_SC_CS << 8) | 31, (uint32_t)-0x8,
+    (PPU_SC_BC << 8) | 0, (uint32_t)-0x90 };
+
+static void framed_memory(ppu_context* ctx, uint64_t* v)
+{
+    memset(g_mem, 0, sizeof g_mem);
+    v[0] = SP0; v[1] = 0x00055554; v[2] = 0x2222222222222222ull; v[3] = 0x1111111111111111ull; v[4] = SP0;
+    put(SP0 + 0x10, v[1]); put(SP0 - 0x10, v[2]); put(SP0 - 0x8, v[3]); put(SP0 - 0x90, SP0);
+    ppu_context_init(ctx);
+    ctx->gpr[1] = SP0 - 0x90;
+    ctx->thread_id = 7;
+}
+
+int main(int argc, char** argv)
+{
+    if (argc > 1) g_dir = argv[1];
+    ppu_context ctx;
+    uint64_t v[5];
+
+    /* 1. Clean frame: thousands of checks, no mismatch, coverage = 1. */
+    std::string log = arm("clean");
+    framed_memory(&ctx, v);
+    for (int i = 0; i < 5000; i++) ppu_slotcheck(&ctx, D_FRAMED, v, RA, -0x90);
+    CHECK(s_sc_mismatches.load() == 0);
+    CHECK(s_sc_nfuncs.load() == 1);
+    ppu_slotcheck_summary("test");
+    std::string out = slurp(log);
+    CHECK(count(out, "[slotcheck] armed") == 1);
+    CHECK(count(out, "summary (test)") == 1);
+    CHECK(count(out, "mismatches=0 ") == 1);
+    CHECK(count(out, "checks~5000 ") == 1);
+    CHECK(count(out, "MISMATCH") == 0);
+    CHECK(count(slurp(g_dir + "/clean.funcs"), "func_00012340 5000") == 1);
+
+    /* 2. Each kind is caught, keyed by function+slot, one detail per key. */
+    log = arm("kinds");
+    framed_memory(&ctx, v);
+    put(SP0 - 0x8, 0xDEAD);                       /* r31's slot clobbered */
+    for (int i = 0; i < 5; i++) ppu_slotcheck(&ctx, D_FRAMED, v, RA, -0x90);
+    CHECK(s_sc_mismatches.load() == 5);
+    CHECK(s_sc_nkeys == 1 && s_sc_details == 1);
+    put(SP0 - 0x8, v[3]);
+    put(SP0 + 0x10, 0x00099990);                  /* saved LR clobbered */
+    ppu_slotcheck(&ctx, D_FRAMED, v, RA + 8, -0x90);
+    put(SP0 + 0x10, v[1]);
+    put(SP0 - 0x90, 0xD000FFF0);                  /* back chain clobbered */
+    ppu_slotcheck(&ctx, D_FRAMED, v, RA + 16, -0x90);
+    put(SP0 - 0x90, SP0);
+    ctx.gpr[1] = SP0 - 0x80;                      /* the callee returned with r1 drifted */
+    ppu_slotcheck(&ctx, D_FRAMED, v, RA + 24, -0x90);
+    ppu_slotcheck(&ctx, D_FRAMED, v, RA + 24, PPU_SC_NOSP);   /* no r1 assertion here */
+    ctx.gpr[1] = SP0 - 0x90;
+    CHECK(s_sc_mismatches.load() == 8);
+    CHECK(s_sc_nkeys == 4 && s_sc_details == 4);
+    ppu_slotcheck_summary("test");
+    out = slurp(log);
+    CHECK(count(out, "MISMATCH #1 func_00012340 CS r31 slot=entry_sp-8 (0xD000FFF8) "
+                     "want=0x1111111111111111 got=0x000000000000DEAD after call ra=0x00012388 tid=7") == 1);
+    CHECK(count(out, "MISMATCH #2 func_00012340 LR slot=entry_sp+16") == 1);
+    CHECK(count(out, "MISMATCH #3 func_00012340 BC slot=entry_sp-144") == 1);
+    CHECK(count(out, "MISMATCH #4 func_00012340 SP after call ra=0x000123A0") == 1);
+    CHECK(count(out, "guest stack:") == 4);
+    CHECK(count(out, "mismatches=8 keys=4") == 1);
+    /* rows sorted by count: the r31 key (5 hits) first */
+    {
+        size_t s = out.find("summary (test)");
+        size_t r = out.find("[slotcheck]  ", s);
+        const char* row = "[slotcheck]            5  func_00012340 CS   r31";
+        CHECK(r != std::string::npos && out.compare(r, strlen(row), row) == 0);
+    }
+
+    /* 3. A 32-bit stwu frame compares only the low word. */
+    arm("bc32");
+    {
+        const uint32_t d32[] = { 0x00020000u, 1u, (PPU_SC_BC32 << 8) | 0, (uint32_t)-0x40 };
+        memset(g_mem, 0, sizeof g_mem);
+        uint64_t v32[2] = { SP0, SP0 };
+        put(SP0 - 0x40, SP0, 4);
+        ppu_slotcheck(&ctx, d32, v32, RA, PPU_SC_NOSP);
+        CHECK(s_sc_mismatches.load() == 0);
+        put(SP0 - 0x40, 0x1234, 4);
+        ppu_slotcheck(&ctx, d32, v32, RA, PPU_SC_NOSP);
+        CHECK(s_sc_mismatches.load() == 1);
+    }
+
+    /* 4. A tail fragment: back chain and owner LR snapshotted at entry. */
+    log = arm("fragment");
+    {
+        const uint32_t OWNER = SP0 + 0x100;
+        const uint32_t df[] = { 0x00030000u, 3u,
+            (PPU_SC_CS << 8) | 29, 0x78u,
+            (PPU_SC_FBC << 8) | 0, 0u,
+            (PPU_SC_FLR << 8) | 0, 0x10u };
+        memset(g_mem, 0, sizeof g_mem);
+        put(SP0, OWNER); put(OWNER + 0x10, 0x00077770); put(SP0 + 0x78, 0x2929);
+        uint64_t vf[4] = { SP0, 0x2929, 0, 0 };
+        ctx.gpr[1] = SP0;
+        ppu_slotcheck_enter(df, vf);
+        CHECK(vf[2] == OWNER && vf[3] == 0x00077770);
+        ppu_slotcheck(&ctx, df, vf, RA, 0);
+        CHECK(s_sc_mismatches.load() == 0);
+        put(OWNER + 0x10, 0x00012345);             /* owner's saved LR clobbered */
+        ppu_slotcheck(&ctx, df, vf, RA, 0);
+        CHECK(s_sc_mismatches.load() == 1);
+        out = slurp(log);
+        CHECK(count(out, "FLR slot=owner_sp+16") == 1);
+        /* unreadable snapshot (fragment entered on a stack we cannot read): skipped */
+        uint64_t vs[4] = { 0x00001000, 0x2929, 0, 0 };
+        ppu_slotcheck_enter(df, vs);
+        CHECK(vs[2] == PPU_SC_SKIP && vs[3] == PPU_SC_SKIP);
+        const uint32_t dfo[] = { 0x00030000u, 2u, (PPU_SC_FBC << 8) | 0, 0u, (PPU_SC_FLR << 8) | 0, 0x10u };
+        uint64_t vo[3] = { 0x00001000, 0, 0 };
+        ppu_slotcheck_enter(dfo, vo);
+        ppu_slotcheck(&ctx, dfo, vo, RA, PPU_SC_NOSP);
+        CHECK(s_sc_mismatches.load() == 1);
+        /* an unreadable ordinary slot IS reported */
+        const uint32_t du[] = { 0x00040000u, 1u, (PPU_SC_CS << 8) | 28, 0x10u };
+        uint64_t vu[2] = { 0x00001000, 5 };
+        ppu_slotcheck(&ctx, du, vu, RA, PPU_SC_NOSP);
+        CHECK(s_sc_mismatches.load() == 2);
+        out = slurp(log);
+        CHECK(count(out, "got=UNREADABLE ") == 1);
+        ctx.gpr[1] = SP0 - 0x90;
+    }
+
+    /* 5. The total detail budget holds across keys; counting goes on. */
+    log = arm("budget", "3");
+    framed_memory(&ctx, v);
+    for (uint32_t f = 0; f < 10; f++) {
+        uint32_t d[] = { 0x00050000u + 0x10 * f, 1u, (PPU_SC_CS << 8) | 31, (uint32_t)-0x8 };
+        uint64_t vb[2] = { SP0, 0xBAD };
+        ppu_slotcheck(&ctx, d, vb, RA, PPU_SC_NOSP);
+    }
+    CHECK(s_sc_mismatches.load() == 10 && s_sc_nkeys == 10 && s_sc_details == 3);
+    ppu_slotcheck_summary("test");
+    out = slurp(log);
+    CHECK(count(out, "MISMATCH #") == 3);
+    CHECK(count(out, "keys=10 details=3/3") == 1);
+
+    /* 6. SLOTCHECK=0 disarms: no checks, no reports, even on bad slots. */
+    log = arm("off", "64", "0");
+    framed_memory(&ctx, v);
+    put(SP0 - 0x8, 0xDEAD);
+    ppu_slotcheck(&ctx, D_FRAMED, v, RA, -0x90);
+    CHECK(s_sc_mismatches.load() == 0 && s_sc_nfuncs.load() == 0);
+    out = slurp(log);
+    CHECK(count(out, "disarmed (SLOTCHECK=0)") == 1);
+    CHECK(count(out, "MISMATCH") == 0);
+
+    ppu_sc_test_reset();
+    printf("%s: test_slotcheck (%d failure%s)\n", g_fail ? "FAIL" : "PASS", g_fail, g_fail == 1 ? "" : "s");
+    return g_fail ? 1 : 0;
+}
diff --git a/runtime/savestate/ss_core.c b/runtime/savestate/ss_core.c
new file mode 100644
index 0000000..dfdb229
--- /dev/null
+++ b/runtime/savestate/ss_core.c
@@ -0,0 +1,3681 @@
+/*
+ * ps3recomp - save-state core (see ss_core.h for the model and the switches).
+ *
+ * Threads involved and what each does here:
+ *   guest PPU threads   park at S1/S2/S3 (ss_ppu_safepoint / ss_ppu_wait_point)
+ *   lv2 SPU threads     park at drain hops and in host waits (ss_spu_park_point)
+ *   cellAudio mixer     parks between blocks (ss_mixer_park_point)
+ *   frame clock         coordinates (ss_frame_tick); it is also the RSX walker,
+ *                       so the walker is "parked" whenever the coordinator is
+ *                       busy in a synchronous step
+ * One lock + one condition variable carry every park; each class has its own
+ * generation counter, bumped on release, so a parked thread waits exactly
+ * until the stop it parked in is over -- or, for a LOAD (M4c), until the
+ * coordinator gives that stop's generation a DISCARD verdict: the thread
+ * drops the lock and longjmps to its root, and a recreated one (or main)
+ * waits at the load gate until the release.
+ */
+#include "ss_core.h"
+#include "ss_state.h"
+#include "ss_ui.h"
+#include "../ppu/ppu_context.h"
+#include "../syscalls/sys_ppu_thread.h"
+#include "../platform/win32_compat.h"
+#include "../platform/guest_clock.h"
+
+#include <setjmp.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#  include <windows.h>
+#  pragma comment(lib, "user32.lib")      /* MessageBoxA: a load that fails past its point of no return */
+#else
+#  include <pthread.h>
+#endif
+
+extern uint8_t* vm_base;
+
+volatile int  g_ss_armed   = 0;
+volatile long g_ss_req     = 0;
+volatile long g_ss_spu_req = 0;
+volatile long g_ss_mix_req = 0;
+void (*g_ss_on_capture)(void* user) = 0;
+void*  g_ss_on_capture_user = 0;
+
