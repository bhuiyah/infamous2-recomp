+static void pfx_watch_update(void)
+{
+    int n = 0;
+    const unsigned* ids = pfx_scene_ids(&n);
+    u64 bits = 0;
+    for (int i = 0; i < n; i++) bits |= 1ull << (ids[i] & 63u);
+    for (int i = 0; i < s_pfx_ids.nmovie; i++) bits |= 1ull << (s_pfx_ids.movie[i] & 63u);
+    s_pfx.idbits = bits;
+    s_pfx.watch = s_pfx.on && bits != 0 && !s_pfx.dead;
