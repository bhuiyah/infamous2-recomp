+static void test_xbox_dinput_layout(void)
+{
+    PadHostDevice d;
+    PadHostPortState st;
+    desc_reset();
+    add_value(GEN_PAGE_GD, 0x30, 0, 16, 0, 65535, 0, 0);
+    add_value(GEN_PAGE_GD, 0x31, 0, 16, 0, 65535, 0, 0);
+    add_value(GEN_PAGE_GD, 0x33, 0, 16, 0, 65535, 0, 0);
+    add_value(GEN_PAGE_GD, 0x34, 0, 16, 0, 65535, 0, 0);
+    add_value(GEN_PAGE_GD, 0x32, 0, 16, 0, 65535, 0, 0);
+    add_value(GEN_PAGE_GD, 0x39, 0, 4, 1, 8, 1, 0);    /* 1..8, 0 = centred */
