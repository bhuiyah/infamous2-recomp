+/* ---------------- the frame clock (the coordinator's thread) ---------------- */
+static HANDLE g_wake, g_done_ev;
+static volatile LONG g_quit_clock;
+static unsigned g_flip;
+static int  fake_walker_pass(void) { return 0; }
+static void fake_walker_info(ss_walker_info* w)
+{
+    memset(w, 0, sizeof *w);
+    w->get = w->put = 0x1000; w->park_off = 0xFFFFFFFFu; w->acq_pos = 0xFFFFFFFFu;
+}
+static void fake_rebase(unsigned long long) {}
+static void fake_wake(void) { SetEvent(g_wake); }
+static unsigned __stdcall clock_proc(void*)
+{
+    while (!g_quit_clock) {
+        WaitForSingleObject(g_wake, 2);
+        ss_frame_tick(++g_flip);
+    }
+    return 0;
+}
+static volatile LONG g_done_ok, g_done_reason;
+static void on_done(int ok, int reason, void*) { g_done_ok = ok; g_done_reason = reason; SetEvent(g_done_ev); }
+/* One request, waited for: 0 if it was done ok, else its reason (negative:
+ * not taken / no answer). out: ss_last_request's result. */
+static int request(int purpose, unsigned flags, const ss_image* img, double give_up_s, ss_request_result* out)
+{
+    ss_request r;
+    memset(&r, 0, sizeof r);
+    r.purpose = purpose; r.slot = -1; r.flags = flags; r.image = img; r.done = on_done; r.give_up_s = give_up_s;
+    ResetEvent(g_done_ev);
+    const int q = ss_request_submit(&r);
+    if (q != SS_R_QUEUED) return -100 + q;
+    if (WaitForSingleObject(g_done_ev, 30000) != WAIT_OBJECT_0) return -200;
+    if (out) ss_last_request(out);
+    return g_done_ok ? 0 : (int)g_done_reason;
+}
