+/* One walk for per-draw use (see the header): size, structural hash, the
+ * inline constants and the texture units the program samples. */
+int rsx_fp_scan_program(const u8* ucode, u32 max_bytes, u64 seed,
+                        u32 (*consts)[4], u32 max_consts,
+                        u32* out_size, u64* out_hash, u32* out_tex_mask)
+{
+    return rsx_fp_scan_program_slots(ucode, max_bytes, seed, consts, max_consts,
+                                     out_size, out_hash, out_tex_mask, NULL);
+}
+
+int rsx_fp_scan_program_slots(const u8* ucode, u32 max_bytes, u64 seed,
+                              u32 (*consts)[4], u32 max_consts,
+                              u32* out_size, u64* out_hash, u32* out_tex_mask,
+                              u32* slot_offs)
+{
+    if (!ucode)
+        return -1;
+    if (max_consts > RSX_FP_MAX_INLINE_CONSTANTS)
+        max_consts = RSX_FP_MAX_INLINE_CONSTANTS;
+    static const u32 structural_tag = 0x31535046u; /* "FPS1", as rsx_fp_structural_hash */
+    u64 hash = fp_hash_bytes(&structural_tag, sizeof(structural_tag), seed);
+    u32 off = 0, instruction_count = 0, constant_count = 0, tex_mask = 0;
+    while (off + 16 <= max_bytes) {
+        const u32 w0 = rsx_fp_read_word(ucode + off + 0);
