+/* sdata 2: the container must decrypt again to the plaintext the guest was
+ * reading -- sdata_decrypt's own conditions, read off its header (the last
+ * block inside the file), and the same size. */
+static int ppu_fs_ss_check_sdata(const char* host, uint64_t size, char* why, size_t n)
+{
+    FILE* f = fopen(host, "rb");
+    if (!f) { snprintf(why, n, "its NPD container is gone"); return -1; }
+    uint8_t h[0x100];
+    const size_t got = fread(h, 1, sizeof h, f);
+    fseek(f, 0, SEEK_END);
+    const long len = ftell(f);                      /* (sdata_to_tmpfile's measure) */
+    fclose(f);
+    if (got != sizeof h || h[0] != 'N' || h[1] != 'P' || h[2] != 'D') {
+        snprintf(why, n, "no longer an NPD container");
+        return -1;
+    }
+    const uint32_t flags = sd_be32(h + 0x80), bs = sd_be32(h + 0x84);
+    const uint64_t fsz = sd_be64(h + 0x88);
+    if (!(flags & 0x01000000u) || (flags & 0x01u) || !bs || !fsz || len <= 0 || fsz > (uint64_t)len) {
+        snprintf(why, n, "its NPD container no longer decrypts (flags 0x%X)", flags);
+        return -1;
+    }
+    const uint64_t nb = (fsz + bs - 1) / bs, last_len = (fsz % bs) ? fsz % bs : bs;
+    const uint64_t last = (flags & 0x20u) ? 0x100 + (nb - 1) * (0x20 + (uint64_t)bs) + 0x20
+                                          : 0x100 + nb * 0x10 + (nb - 1) * bs;
+    if (last + ((last_len + 15) & ~15ull) > (uint64_t)len) {
+        snprintf(why, n, "its NPD container is cut short");
+        return -1;
+    }
+    if (fsz != size) {
+        snprintf(why, n, "decrypts to %llu bytes now, %llu when it was saved", (unsigned long long)fsz,
+                 (unsigned long long)size);
+        return -1;
+    }
+    return 0;
