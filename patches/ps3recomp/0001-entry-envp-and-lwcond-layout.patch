diff --git a/libs/video/rsx_upscale.h b/libs/video/rsx_upscale.h
new file mode 100644
index 0000000..114f6db
--- /dev/null
+++ b/libs/video/rsx_upscale.h
@@ -0,0 +1,347 @@
+/*
+ * ps3recomp - the window-sized present: the upscale / downscale kernels, the
+ * swap-chain decision, the variable-refresh plan and the composition modes.
+ * The pure part (no D3D), header-only like rsx_res_scale.h: the D3D12 backend
+ * (rsx_d3d12_backend.c), the window pass's shader (rsx_res_pass.c, the same
+ * formulas in HLSL) and libs/video/tests/test_upscale.c run the same rules.
+ *
+ * Two settings-store rows (libs/system/options.c):
+ *   upscale  off | bilinear | bicubic | lanczos  (Graphics, restart; env GFX_UPSCALE)
+ *            off = today: a 1280x720 swap chain that Windows (the desktop
+ *            compositor) stretches to the window. The others give the swap
+ *            chain the view's own size and the window pass (rsx_rs_blit,
+ *            the RES_SCALE pass) resamples the frame into it with the kernel
+ *            below. At RES_SCALE >= 2 (always window-sized) the same row picks
+ *            the downsample kernel; off keeps that pass's box / area average.
+ *   vrr      0 | 1  (Frame, restart; env PRESENT_VRR) "Variable refresh
+ *            (G-Sync / FreeSync)": the swap chain window-sized (bilinear when
+ *            upscale is off) and tearing-capable; switching it in a menu also
+ *            sets vsync off and the frame-rate limit just under the refresh
+ *            (rsx_vrr_plan), so every row shows what runs.
+ *
+ * Kernels (radius r, x in source pixels / scale):
+ *   bilinear  tent         max(0, 1 - |x|)                                  r 1
+ *   bicubic   Catmull-Rom  (B 0, C 1/2): 1.5|x|^3 - 2.5|x|^2 + 1     |x|<1
+ *                          -0.5|x|^3 + 2.5|x|^2 - 4|x| + 2         1<=|x|<2  r 2
+ *   lanczos   Lanczos-2    sinc(x) sinc(x / 2)                              r 2
+ * Per axis, source length S onto destination length D: ratio = S / D; the
+ * kernel is stretched by scale = max(1, ratio) (a downsample also filters
+ * away what the smaller picture cannot hold); destination pixel i's centre is
+ * source position c = (i + 0.5) * ratio (texel j's centre is j + 0.5); every
+ * texel whose centre lies within radius * scale of c is a tap, its weight
+ * K((j + 0.5 - c) / scale) per axis, the 2-D weight their product, divided by
+ * the sum of the weights (edges: the texel index is clamped). At most
+ * RSX_UP_MAX_TAPS taps per axis (the scale is capped: a shrink beyond 4x for
+ * the radius-2 kernels filters a little less). At 1:1 every kernel returns the
+ * texel itself.
+ * Anti-ringing (bicubic and lanczos): the result is clamped to the min / max of
+ * the taps inside the kernel's main lobe on both axes (|x| < 1): the 2x2
+ * texels around c when upscaling, the source pixels under the destination
+ * pixel when downscaling. Both kernels' negative lobes (about -6% each) would
+ * otherwise draw light / dark halos beside hard edges such as HUD text.
+ * Linear light: when either axis shrinks the taps are averaged in linear light
+ * (2.2) like the RES_SCALE box (RSX_RES_DOWNSAMPLE); upscaling interpolates the
+ * encoded values, as the compositor's stretch does.
+ */
+#ifndef RSX_UPSCALE_H
+#define RSX_UPSCALE_H
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum { RSX_UP_OFF = 0, RSX_UP_BILINEAR = 1, RSX_UP_BICUBIC = 2, RSX_UP_LANCZOS = 3 };
+#define RSX_UP_MAX_TAPS 16
+
+/* The upscale row's values (the store's spelling), RSX_UP_* index order. */
+static inline const char* rsx_up_name(int f)
+{
+    return f == RSX_UP_BILINEAR ? "bilinear" : f == RSX_UP_BICUBIC ? "bicubic (Catmull-Rom)" :
+           f == RSX_UP_LANCZOS ? "lanczos-2" : "off";
+}
+
+static inline double rsx_up_radius(int f)
+{
+    return f == RSX_UP_BILINEAR ? 1.0 : (f == RSX_UP_BICUBIC || f == RSX_UP_LANCZOS) ? 2.0 : 0.0;
+}
+
+/* K(x) of a filter (x in kernel units). */
+static inline double rsx_up_kernel(int f, double x)
+{
+    x = fabs(x);
+    if (f == RSX_UP_BILINEAR) return x < 1.0 ? 1.0 - x : 0.0;
+    if (f == RSX_UP_BICUBIC) {
+        if (x < 1.0) return (1.5 * x - 2.5) * x * x + 1.0;
+        if (x < 2.0) return ((-0.5 * x + 2.5) * x - 4.0) * x + 2.0;
+        return 0.0;
+    }
+    if (f == RSX_UP_LANCZOS) {
+        if (x < 1e-4) return 1.0;
+        if (x >= 2.0) return 0.0;
+        const double a = 3.14159265358979323846 * x;
+        return 2.0 * sin(a) * sin(0.5 * a) / (a * a);
+    }
+    return 0.0;
+}
+
+/* One axis of a resample: what the shader's constants hold. */
+typedef struct {
+    double ratio;    /* S / D: source pixels per destination pixel */
+    double scale;    /* kernel stretch: max(1, ratio), capped so taps <= RSX_UP_MAX_TAPS */
+    double support;  /* radius * scale, source pixels */
+    int    taps;     /* taps per destination pixel on this axis: ceil(2 * support) */
+} rsx_up_axis;
+
+static inline rsx_up_axis rsx_up_axis_of(int f, unsigned S, unsigned D)
+{
+    rsx_up_axis a;
+    const double r = rsx_up_radius(f);
+    a.ratio = (S && D) ? (double)S / (double)D : 1.0;
+    a.scale = a.ratio > 1.0 ? a.ratio : 1.0;
+    if (r > 0.0 && 2.0 * r * a.scale > (double)RSX_UP_MAX_TAPS) a.scale = (double)RSX_UP_MAX_TAPS / (2.0 * r);
+    a.support = r * a.scale;
+    a.taps = r > 0.0 ? (int)ceil(2.0 * a.support - 1e-9) : 1;
+    if (a.taps > RSX_UP_MAX_TAPS) a.taps = RSX_UP_MAX_TAPS;
+    if (a.taps < 1) a.taps = 1;
+    return a;
+}
+
+/* Destination pixel i's centre in source pixels, and its first tap: the
+ * smallest j with |j + 0.5 - c| < support. */
+static inline double rsx_up_centre(const rsx_up_axis* a, unsigned i) { return ((double)i + 0.5) * a->ratio; }
+static inline int rsx_up_first(const rsx_up_axis* a, double c) { return (int)floor(c - 0.5 - a->support) + 1; }
+
+/* The 1-D weights of destination pixel i (w[0..taps), unnormalised, and the
+ * main-lobe flags); returns the first texel index (before clamping). */
+static inline int rsx_up_weights(int f, const rsx_up_axis* a, unsigned i, double* w, int* lobe)
+{
+    const double c = rsx_up_centre(a, i);
+    const int j0 = rsx_up_first(a, c);
+    for (int k = 0; k < a->taps; k++) {
+        const double d = ((double)(j0 + k) + 0.5 - c) / a->scale;
+        w[k] = rsx_up_kernel(f, d);
+        if (lobe) lobe[k] = fabs(d) < 1.0;
+    }
+    return j0;
+}
+
+/* Whether a resample of S x ... onto D x ... averages in linear light: when
+ * either axis shrinks (and RSX_RES_DOWNSAMPLE is linear). */
+static inline int rsx_up_linear(int linear_cfg, unsigned sw, unsigned sh, unsigned dw, unsigned dh)
+{
+    return linear_cfg && (sw > dw || sh > dh);
+}
+
+/* The CPU twin of the window pass's kernel path for one destination pixel
+ * (x, y) of src (sw x sh, RGBA floats in [0, 1], row-major): out[4]. */
+static inline void rsx_up_sample(const float* src, unsigned sw, unsigned sh, int f, unsigned dw, unsigned dh,
+                                 unsigned x, unsigned y, int lin, int antiring, double e, float out[4])
+{
+    const rsx_up_axis ax = rsx_up_axis_of(f, sw, dw), ay = rsx_up_axis_of(f, sh, dh);
+    double wx[RSX_UP_MAX_TAPS], wy[RSX_UP_MAX_TAPS];
+    int lx[RSX_UP_MAX_TAPS], ly[RSX_UP_MAX_TAPS];
+    const int jx = rsx_up_weights(f, &ax, x, wx, lx), jy = rsx_up_weights(f, &ay, y, wy, ly);
+    double acc[4] = { 0, 0, 0, 0 }, ws = 0.0, mn[4] = { 1e9, 1e9, 1e9, 1e9 }, mx[4] = { -1e9, -1e9, -1e9, -1e9 };
+    for (int ky = 0; ky < ay.taps; ky++) {
+        int sy = jy + ky;
+        sy = sy < 0 ? 0 : sy >= (int)sh ? (int)sh - 1 : sy;
+        for (int kx = 0; kx < ax.taps; kx++) {
+            int sx = jx + kx;
+            sx = sx < 0 ? 0 : sx >= (int)sw ? (int)sw - 1 : sx;
+            const float* p = src + ((size_t)sy * sw + (size_t)sx) * 4;
+            const double w = wy[ky] * wx[kx];
+            for (int c = 0; c < 4; c++) {
+                double v = p[c];
+                if (lin && c < 3) v = pow(v < 0 ? 0 : v > 1 ? 1 : v, 2.2);
+                acc[c] += w * v;
+                if (lx[kx] && ly[ky]) { if (v < mn[c]) mn[c] = v; if (v > mx[c]) mx[c] = v; }
+            }
+            ws += w;
+        }
+    }
+    for (int c = 0; c < 4; c++) {
+        double v = ws != 0.0 ? acc[c] / ws : 0.0;
+        if (antiring) v = v < mn[c] ? mn[c] : v > mx[c] ? mx[c] : v;
+        if (c < 3) {
+            if (lin) v = pow(v < 0 ? 0 : v > 1 ? 1 : v, 1.0 / 2.2);
+            if (e != 1.0) v = pow(v < 0 ? 0 : v > 1 ? 1 : v, e);
+        }
+        out[c] = (float)(v < 0 ? 0 : v > 1 ? 1 : v);
+    }
+}
+
+/* ---- the swap chain at start (init_d3d12) --------------------------------- */
+typedef struct {
+    int res_scale;       /* the RES_SCALE request: 0 off, 1 plumbing at x1, 2..4 */
+    int present_window;  /* RSX_RES_PRESENT=window (1, default) | guest (0) */
+    int upscale;         /* the upscale row, RSX_UP_* */
+    int vrr;             /* the vrr row */
+    int tearing;         /* the tearing row / PRESENT_TEARING */
+} rsx_pm_in;
+typedef struct {
+    int window_sized;    /* the swap chain takes the view's size; the window pass resamples into it */
+    int filter;          /* that pass's kernel; RSX_UP_OFF at RES_SCALE >= 2 = its box / area average */
+    int want_tearing;    /* create it tearing-capable (when DXGI supports it) */
+    int vrr_bilinear;    /* vrr asked for a window-sized chain while upscale is off: bilinear */
+} rsx_pm_out;
+
+/* Defaults (RES_SCALE unset, upscale off, vrr 0, tearing 0): not window-sized,
+ * no tearing flag -- today's swap chain exactly. */
+static inline void rsx_pm_decide(const rsx_pm_in* in, rsx_pm_out* o)
+{
+    int up = in->upscale >= RSX_UP_OFF && in->upscale <= RSX_UP_LANCZOS ? in->upscale : RSX_UP_OFF;
+    o->want_tearing = in->tearing || in->vrr;
+    o->vrr_bilinear = 0;
+    if (in->res_scale >= 2) {               /* the RES_SCALE window pass: window-sized already */
+        o->window_sized = in->present_window ? 1 : 0;
+        o->filter = up;
+        return;
+    }
+    if (up == RSX_UP_OFF && in->vrr) { up = RSX_UP_BILINEAR; o->vrr_bilinear = 1; }
+    o->window_sized = up != RSX_UP_OFF && in->present_window;
+    o->filter = o->window_sized ? up : RSX_UP_OFF;
+    if (!o->window_sized) o->vrr_bilinear = 0;
+}
+
+/* ---- variable refresh ------------------------------------------------------
+ * The frame-rate limit under a VRR display: a little under its highest refresh,
+ * so a frame never waits for (or tears at) the top of the range: the smaller of
+ * refresh - 3 and refresh - refresh^2 / 3600, whole fps. 75 -> 72, 60 -> 57,
+ * 120 -> 116, 144 -> 138, 240 -> 224. 0 when the refresh is unknown. */
+static inline int rsx_vrr_cap_hz(double refresh)
+{
+    if (!(refresh >= 30.0) || refresh > 1000.0) return 0;
+    const double a = refresh - 3.0, b = refresh - refresh * refresh / 3600.0;
+    return (int)floor((a < b ? a : b) + 1e-9);
+}
+
+/* What switching the vrr row on asks of the other rows. The current values
+ * are the store's canonical texts; out: up to 5 (key, value to set, value it
+ * had) triples; the caller sets each one the environment does not lock and
+ * records those (rsx_vrr_record). vsync 0, tearing 1, the limit to the cap
+ * when it is off or above it (a lower limit stays), even frame pacing off (it
+ * presents every k-th fixed refresh: the opposite of a display that follows
+ * the frames), and upscale bilinear when it is off at the PS3 resolution
+ * (scaled = 0; at Internal resolution 2x-4x the swap chain is window-sized
+ * anyway and the row picks the downscale filter, which VRR does not need). */
+typedef struct { const char* key; char val[16]; char old[24]; } rsx_vrr_set;
+static inline void rsx_vrr_put(rsx_vrr_set* s, const char* key, const char* val, const char* old)
+{
+    s->key = key;
+    snprintf(s->val, sizeof s->val, "%s", val);
+    snprintf(s->old, sizeof s->old, "%s", old ? old : "");
+}
+static inline int rsx_vrr_plan(double refresh, int scaled, const char* vsync, const char* fps_cap,
+                               const char* tearing, const char* upscale, const char* pacing, rsx_vrr_set out[5])
+{
+    int n = 0;
+    const int cap = rsx_vrr_cap_hz(refresh);
+    const double fc = fps_cap ? atof(fps_cap) : 0.0;
+    const int vs = vsync ? atoi(vsync) : 1, te = tearing ? atoi(tearing) : 0;
+    if (vs != 0) rsx_vrr_put(&out[n++], "vsync", "0", vsync ? vsync : "1");
+    if (te != 1) rsx_vrr_put(&out[n++], "tearing", "1", tearing ? tearing : "0");
+    if (cap > 0 && (!(fc > 0.0) || fc > (double)cap)) {
+        char c[16];
+        snprintf(c, sizeof c, "%d", cap);
+        rsx_vrr_put(&out[n++], "fps_cap", c, fps_cap ? fps_cap : "0");
+    }
+    if (!scaled && upscale && !strcmp(upscale, "off")) rsx_vrr_put(&out[n++], "upscale", "bilinear", "off");
+    if (pacing && *pacing && strcmp(pacing, "off")) rsx_vrr_put(&out[n++], "frame_pacing", "off", pacing);
+    return n;
+}
+/* The record of what switching vrr on changed, kept in a hidden row so it
+ * outlives the session (the row is often switched off in a later one):
+ * "key=old>new" entries joined by ','. rsx_vrr_record writes it ("" for
+ * none); rsx_vrr_unrecord reads it back into (key, val = what VRR set, old =
+ * what to restore), skipping unknown keys and malformed entries. Switching
+ * off restores each row that still holds VRR's value (rsx_vrr_same): a row
+ * the user changed since keeps the user's value, one VRR never touched is
+ * left alone. */
+static inline void rsx_vrr_record(const rsx_vrr_set* s, int n, char* buf, size_t cap)
+{
+    size_t u = 0;
+    if (cap) buf[0] = 0;
+    for (int i = 0; i < n && u < cap; i++)
+        u += (size_t)snprintf(buf + u, cap - u, "%s%s=%s>%s", i ? "," : "", s[i].key, s[i].old, s[i].val);
+}
+static inline int rsx_vrr_unrecord(const char* rec, rsx_vrr_set out[5])
+{
+    static const char* const keys[] = { "vsync", "tearing", "fps_cap", "upscale", "frame_pacing" };
+    int n = 0;
+    const char* p = rec;
+    while (p && *p && n < 5) {
+        const char* e = strchr(p, ',');
+        const size_t len = e ? (size_t)(e - p) : strlen(p);
+        const char* eq = (const char*)memchr(p, '=', len);
+        const char* gt = eq ? (const char*)memchr(eq, '>', len - (size_t)(eq - p)) : NULL;
+        if (eq && gt)
+            for (int k = 0; k < 5; k++)
+                if (strlen(keys[k]) == (size_t)(eq - p) && !strncmp(p, keys[k], (size_t)(eq - p))) {
+                    rsx_vrr_set* s = &out[n++];
+                    s->key = keys[k];
+                    snprintf(s->old, sizeof s->old, "%.*s", (int)(gt - eq - 1), eq + 1);
+                    snprintf(s->val, sizeof s->val, "%.*s", (int)(p + len - gt - 1), gt + 1);
+                    break;
+                }
+        p = e ? e + 1 : NULL;
+    }
+    return n;
+}
+/* The same setting value: numbers by value ("72" == "72.0"), else the text. */
+static inline int rsx_vrr_same(const char* a, const char* b)
+{
+    if (!a || !b) return 0;
+    char* ea;
+    char* eb;
+    const double x = strtod(a, &ea), y = strtod(b, &eb);
+    if (ea != a && !*ea && eb != b && !*eb) return fabs(x - y) < 1e-6;
+    return !strcmp(a, b);
+}
+
+/* How Windows shows the swap chain, from one second of counts ([present]):
+ * pps our presents per second, own the frames the kernel counted as put on
+ * the display by our process itself (D3DKMT process VidPN-source statistics).
+ * Independent flip: about one per present -- our buffers are flipped to the
+ * screen; composed: (almost) none -- the desktop compositor flips its own
+ * frame. Too few presents (a loading pause, minimised) or a count in between
+ * (a switch inside the second): unclear. */
+enum { RSX_PM_COMPOSED = 0, RSX_PM_INDEPENDENT = 1, RSX_PM_UNCLEAR = 2 };
+static inline int rsx_pm_classify(double pps, double own)
+{
+    if (!(pps >= 10.0)) return RSX_PM_UNCLEAR;
+    if (own >= 0.6 * pps) return RSX_PM_INDEPENDENT;
+    if (own <= 0.1 * pps) return RSX_PM_COMPOSED;
+    return RSX_PM_UNCLEAR;
+}
+/* Does a variable-refresh display follow the frames? One sample a second while
+ * the swap chain flips independently: pps our presents per second, rpf the
+ * display refreshes per shown frame (DXGI SyncRefreshCount / PresentCount over
+ * the second), hz its nominal refresh. Only seconds that can decide count:
+ * 80% of the refresh <= pps <= refresh - 2.5 (inside any VRR range's top
+ * part, the vrr row's own cap included: 72 at 75 Hz), where the display
+ * refreshes hz times a second at a fixed refresh and pps times when it
+ * follows the frames: a second whose refreshes (rpf * pps) are nearer pps is
+ * "follows", nearer hz "fixed" (at 72 fps on 75 Hz: 72 against 75, apart by
+ * more than a second's counting error); 6 of the last 8 deciding samples give
+ * the verdict. */
+enum { RSX_VRR_UNKNOWN = 0, RSX_VRR_ACTIVE = 1, RSX_VRR_FIXED = 2 };
+typedef struct { unsigned char last[8]; int n; } rsx_vrr_tally;
+static inline int rsx_vrr_verdict(rsx_vrr_tally* t, double pps, double rpf, double hz)
+{
+    if (!(hz >= 30.0) || pps < 0.8 * hz || pps > hz - 2.5 || !(rpf > 0.0)) return RSX_VRR_UNKNOWN;
+    const double rps = rpf * pps;   /* display refreshes a second */
+    t->last[t->n++ % 8] = rps < 0.5 * (pps + hz) ? RSX_VRR_ACTIVE : RSX_VRR_FIXED;
+    if (t->n < 8) return RSX_VRR_UNKNOWN;
+    int a = 0, f = 0;
+    for (int i = 0; i < 8; i++) { a += t->last[i] == RSX_VRR_ACTIVE; f += t->last[i] == RSX_VRR_FIXED; }
+    return a >= 6 ? RSX_VRR_ACTIVE : f >= 6 ? RSX_VRR_FIXED : RSX_VRR_UNKNOWN;
+}
+static inline const char* rsx_pm_mode_name(int m)
+{
+    return m == RSX_PM_COMPOSED ? "COMPOSED (the desktop compositor copies each frame into its own)" :
+           m == RSX_PM_INDEPENDENT ? "INDEPENDENT FLIP (frames go to the screen without the compositor)" :
+           "unclear";
+}
+
+#endif /* RSX_UPSCALE_H */
