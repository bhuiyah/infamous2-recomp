+         * exclusive-fullscreen switch (MakeWindowAssociation below). */
+        if (wp == VK_RETURN && (lp & 0x20000000)) {
+            if (!(lp & 0x40000000)) disp_set_fullscreen(hwnd, !s_fullscreen);
+            return 0;
+        }
+        break;
+    case WM_SYSCHAR:
+        if (wp == '\r' && (lp & 0x20000000)) return 0;   /* no beep for Alt+Enter */
+        break;
+    case WM_SIZE:
+        disp_layout(hwnd);
+        return 0;
+    case WM_APP_DISP_LAYOUT:
+        disp_layout(hwnd);
+        return 0;
+    case WM_DPICHANGED:
