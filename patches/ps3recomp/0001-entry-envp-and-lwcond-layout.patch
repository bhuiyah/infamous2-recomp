+#!/usr/bin/env python3
+"""--slotcheck: the lifter's guest stack-slot checks, emission and end to end.
+
+A save-state resume reloads the saved LR, the callee-saved registers and the
+back chain from guest stack slots the lifter itself stopped trusting (the _cs_
+copies). `ppu_lifter.py --slotcheck` instruments every call site of the
+functions that keep _cs_ copies so a play session can measure whether those
+slots hold; runtime/ppu/ppu_slotcheck.h counts and reports. This test pins:
+
+  * the emission: which slots a framed function and a frameless tail fragment
+    describe (offsets from the entry r1), the r1 expectation per call site,
+    the entry snapshot for fragments, no checks in unreachable code, no
+    r1/back-chain assertion past an alloca, "cs" vs "all", and that a lift
+    without the flag is untouched;
+  * end to end: the lifted C is compiled with a small driver and the REAL
+    reporter against a fake guest memory, and a callee that clobbers each slot
+    kind in turn must be caught (and a well-behaved one must not) -- which also
+    proves at run time that bctrl now passes the return address in ctx->lr and
+    sc in ctx->sc_ra.
+
+The compile step needs clang-cl (Windows; LLVM's default install path is
+tried) or a C++ compiler ($CXX, clang++, g++); without one it is skipped.
+Run: py -3 tools/test_ppu_slotcheck.py
+"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+sys.path.insert(0, TOOLS)
+
+import ppu_disasm                       # noqa: E402
+from ppu_lifter import PPULifter        # noqa: E402
+
+FAILS = []
+
+
+def check(cond, msg):
+    if not cond:
+        FAILS.append(msg)
+        print("FAIL:", msg)
+
+
+def w_std(rs, ra, d, u=0): return (62 << 26) | (rs << 21) | (ra << 16) | (d & 0xFFFC) | u
+def w_ld(rt, ra, d):       return (58 << 26) | (rt << 21) | (ra << 16) | (d & 0xFFFC)
+def w_addi(rt, ra, s):     return (14 << 26) | (rt << 21) | (ra << 16) | (s & 0xFFFF)
+def w_mr(ra, rs):          return (31 << 26) | (rs << 21) | (ra << 16) | (rs << 11) | (444 << 1)
+def w_mtctr(rs):           return 0x7C0903A6 | (rs << 21)
+def w_bl(frm, to):         return (18 << 26) | ((to - frm) & 0x3FFFFFC) | 1
+def w_b(frm, to):          return (18 << 26) | ((to - frm) & 0x3FFFFFC)
+
+
+MFLR_R0, MTLR_R0, BCTRL, SC, BLR = 0x7C0802A6, 0x7C0803A6, 0x4E800421, 0x44000002, 0x4E800020
+G = 0x10100            # callee, supplied by the driver (external to the lift)
+
+# F: a framed function, gcc style: stdu first, saves above the new sp.
+F = 0x10000
+F_WORDS = [MFLR_R0, w_std(1, 1, -0x90, 1), w_std(30, 1, 0x80), w_std(31, 1, 0x88),
+           w_std(0, 1, 0xA0), w_mr(31, 3), w_mr(30, 4),
+           None,                          # 0x1001C bl G          -> RA 0x10020
+           w_mtctr(31), BCTRL,            # 0x10024 bctrl         -> RA 0x10028
+           SC,                            # 0x10028 sc            -> RA 0x1002C
+           w_ld(0, 1, 0xA0), w_ld(30, 1, 0x80), w_ld(31, 1, 0x88), MTLR_R0,
+           w_addi(1, 1, 0x90), BLR]
+F_WORDS[7] = w_bl(F + 0x1C, G)
+
+# T: a frameless tail fragment of an F-like owner (restores from the owner's
+# frame), plus an unreachable call after its return.
+T = 0x10200
+T_WORDS = [w_mr(3, 31), w_bl(T + 4, G),   # 0x10204 bl G -> RA 0x10208
+           w_ld(30, 1, 0x80), w_ld(31, 1, 0x88), w_ld(0, 1, 0xA0), MTLR_R0,
+           w_addi(1, 1, 0x90), BLR,
+           w_bl(T + 0x20, G), BLR]        # dead in this C function
+
+# P: LR saved, no callee-saves (checked in "all" mode only).
+P = 0x10300
+P_WORDS = [MFLR_R0, w_std(1, 1, -0x70, 1), w_std(0, 1, 0x80), w_bl(P + 0xC, G),
+           w_ld(0, 1, 0x80), MTLR_R0, w_addi(1, 1, 0x70), BLR]
+
+# A: an alloca after the prologue (`ld r0,0(r1); stdu r0,-0x40(r1)`).
+A = 0x10400
+A_WORDS = [MFLR_R0, w_std(31, 1, -8), w_std(0, 1, 16), w_std(1, 1, -0x80, 1),
+           w_bl(A + 0x10, G),             # RA 0x10414: before the alloca
+           w_ld(0, 1, 0), w_std(0, 1, -0x40, 1),
+           w_bl(A + 0x1C, G),             # RA 0x10420: after it
+           w_ld(1, 1, 0), w_ld(0, 1, 16), MTLR_R0, w_ld(31, 1, -8), BLR]
+
+
+def decode(words, base):
+    return [ppu_disasm.decode(w, base + 4 * i) for i, w in enumerate(words)]
+
+
+def lift(mode, header_name="lifted.h"):
+    lifter = PPULifter()
+    lifter.slotcheck = mode
+    lifter.header_name = header_name
+    funcs = {}
+    for base, words in ((F, F_WORDS), (T, T_WORDS), (P, P_WORDS), (A, A_WORDS)):
+        funcs[base] = lifter.lift_function(decode(words, base), base, base + 4 * len(words))
+    return lifter, funcs
+
+
+def body(fn):
+    return "\n".join(fn.body_lines)
+
+
+def test_emission():
+    _, plain = lift("")
+    _, cs = lift("cs")
+    _, al = lift("all")
+
+    f = body(cs[F])
+    check("static const uint32_t _scd[] = { 0x00010000u, 4u, 0x100u, 0x10u, 0x21Eu, 0xFFFFFFF0u, "
+          "0x21Fu, 0xFFFFFFF8u, 0x300u, 0xFFFFFF70u };" in f, "F descriptor:\n" + f)
+    check("uint64_t _sc_v[] = { ctx->gpr[1], ctx->lr, _cs_30, _cs_31, ctx->gpr[1] };" in f, "F values")
+    for ra in (0x10020, 0x10028, 0x1002C):
+        check(f"ppu_slotcheck(ctx, _scd, _sc_v, 0x{ra:08X}u, -0x90);" in f, f"F check at {ra:#x}")
+    check("ctx->lr = 0x00010028; ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx); ppu_slotcheck(" in f,
+          "F bctrl: LR store, call, then the check")
+    check("ctx->sc_ra = 0x0001002C; lv2_syscall(ctx); ppu_slotcheck(" in f, "F sc check")
+    check("ppu_slotcheck_enter" not in f, "F needs no entry snapshot")
+
+    t = body(cs[T])
+    check("static const uint32_t _scd[] = { 0x00010200u, 4u, 0x21Eu, 0x80u, 0x21Fu, 0x88u, "
+          "0x500u, 0x0u, 0x600u, 0x10u };" in t, "T descriptor:\n" + t)
+    check("ppu_slotcheck_enter(_scd, _sc_v);" in t, "T snapshots FBC/FLR at entry")
+    check(t.count("ppu_slotcheck(ctx") == 1 and "0x00010208u, 0x0);" in t,
+          "T: one reachable call site, r1 == entry r1; the dead one is left alone")
+
+    check("ppu_slotcheck" not in body(cs[P]), "cs mode: P has no _cs_ copies, no checks")
+    p = body(al[P])
+    check("{ 0x00010300u, 2u, 0x100u, 0x10u, 0x300u, 0xFFFFFF90u }" in p, "all mode: P LR+BC:\n" + p)
+
+    a = body(cs[A])
+    check("0x00010414u, -0x80);" in a, "A: r1 asserted before the alloca:\n" + a)
+    check("0x00010420u, PPU_SC_NOSP);" in a, "A: no r1 assertion after the alloca")
+    check("0x300u" not in a, "A: no back-chain slot in an alloca frame")
+    check("0x21Fu, 0xFFFFFFF8u" in a and "0x100u, 0x10u" in a, "A: LR and r31 (saved before stdu)")
+
+    for base in plain:
+        check("_sc" not in body(plain[base]), f"no slotcheck without the flag ({base:#x})")
+        stripped = [l.split(" ppu_slotcheck(ctx")[0] for l in al[base].body_lines
+                    if "_scd" not in l.split(" ppu_slotcheck(ctx")[0] and "_sc_v[]" not in l]
+        check(stripped == plain[base].body_lines,
+              f"slotcheck only adds decls and checks ({base:#x})")
+    lifter, _ = lift("cs")
+    check("void ppu_slotcheck(ppu_context* ctx" in "\n".join(lifter._preamble_lines()),
+          "preamble declares the reporter")
+    check("ppu_slotcheck" not in "\n".join(lift("")[0]._preamble_lines()),
+          "preamble untouched without the flag")
+
+
+DRIVER = r"""
+#define _CRT_SECURE_NO_WARNINGS 1
+#define PPU_SC_TESTING 1
+#ifdef _WIN32
+#  include <windows.h>
+#else
+#  include "win32_compat.h"
+#endif
+#include "lifted.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern "C" uint8_t* vm_base = nullptr;
+extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*) = nullptr;
+static const uint32_t VM_SIZE = 0x01000000u;
+
+static uint64_t be(uint64_t a, unsigned w) { uint64_t v = 0; for (unsigned i = 0; i < w; i++) v = (v << 8) | vm_base[(uint32_t)a + i]; return v; }
+static void wbe(uint64_t a, uint64_t v, unsigned w) { for (unsigned i = 0; i < w; i++) vm_base[(uint32_t)a + i] = (uint8_t)(v >> (8 * (w - 1 - i))); }
+extern "C" uint8_t  vm_read8 (uint64_t a) { return (uint8_t)be(a, 1); }
+extern "C" uint16_t vm_read16(uint64_t a) { return (uint16_t)be(a, 2); }
+extern "C" uint32_t vm_read32(uint64_t a) { return (uint32_t)be(a, 4); }
+extern "C" uint64_t vm_read64(uint64_t a) { return be(a, 8); }
+extern "C" void vm_write8 (uint64_t a, uint8_t  v) { wbe(a, v, 1); }
+extern "C" void vm_write16(uint64_t a, uint16_t v) { wbe(a, v, 2); }
+extern "C" void vm_write32(uint64_t a, uint32_t v) { wbe(a, v, 4); }
+extern "C" void vm_write64(uint64_t a, uint64_t v) { wbe(a, v, 8); }
+
+static int ppu_sc_guest_read(uint32_t ea, unsigned w, uint64_t* out)
+{
+    if (ea < 0x10000u || (uint64_t)ea + w > VM_SIZE) return 0;
+    *out = be(ea, w);
+    return 1;
+}
+#include "ppu_slotcheck.h"
+
+static int g_mode, g_fail;
+static uint64_t g_seen_lr[8], g_seen_sc_ra; static int g_nseen;
+#define CHECK(c) do { if (!(c)) { printf("FAIL line %d: %s\n", __LINE__, #c); g_fail++; } } while (0)
+
+/* The callee G (0x10100), "lifted" by hand: what a deeper frame might do. */
+void func_00010100(ppu_context* ctx)
+{
+    const uint64_t sp = ctx->gpr[1];
+    if (g_nseen < 8) g_seen_lr[g_nseen++] = ctx->lr;
+    switch (g_mode) {
+    case 0: for (uint64_t a = sp - 0x100; a < sp; a += 8) wbe(a, 0x5A5A5A5A5A5A5A5Aull, 8); break; /* its own frame */
+    case 1: wbe(sp + 0x88, 0xBAD, 8); break;          /* the caller's r31 slot */
+    case 2: wbe(sp + 0xA0, 0xBAD, 8); break;          /* the caller's saved-LR slot */
+    case 3: wbe(sp, 0xBAD, 8); break;                 /* the caller's back chain */
+    case 4: ctx->gpr[1] += 0x10; break;               /* returns with r1 drifted */
+    }
+}
+extern "C" void ps3_indirect_call(ppu_context* ctx)
+{
+    if ((uint32_t)ctx->ctr == 0x10100u) func_00010100(ctx);
+}
+extern "C" void lv2_syscall(ppu_context* ctx) { g_seen_sc_ra = ctx->sc_ra; }
+
+static uint64_t key_count(uint32_t func, unsigned kind, unsigned reg)
+{
+    uint64_t n = 0;
+    for (uint32_t h = 0; h < PPU_SC_KEYS; h++)
+        if (s_sc_keys[h].count && s_sc_keys[h].func == func && s_sc_keys[h].kind == kind
+            && (kind != PPU_SC_CS || s_sc_keys[h].reg == reg)) n += s_sc_keys[h].count;
+    return n;
+}
+
+static void arm(const char* log)
+{
+    ppu_sc_test_reset();
+#ifdef _WIN32
+    _putenv_s("SLOTCHECK", "1"); _putenv_s("SLOTCHECK_LOG", log); _putenv_s("SLOTCHECK_EVERY", "0");
+#else
+    setenv("SLOTCHECK", "1", 1); setenv("SLOTCHECK_LOG", log, 1); setenv("SLOTCHECK_EVERY", "0", 1);
+#endif
+}
+
+static ppu_context run_F(int mode, const char* log)
+{
+    arm(log);
+    memset(vm_base, 0, VM_SIZE);
+    g_mode = mode; g_nseen = 0; g_seen_sc_ra = 0;
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx);
+    ctx.gpr[1] = 0x00F08000; ctx.lr = 0x00055554; ctx.thread_id = 3;
+    ctx.gpr[3] = 0x10100; ctx.gpr[4] = 4;
+    ctx.gpr[30] = 0x3030303030303030ull; ctx.gpr[31] = 0x3131313131313131ull;
+    func_00010000(&ctx);
+    return ctx;
+}
+
+static void run_T(int mode, const char* log)
+{
+    arm(log);
+    memset(vm_base, 0, VM_SIZE);
+    g_mode = mode; g_nseen = 0;
+    const uint64_t owner = 0x00F08000, sp = owner - 0x90;
+    wbe(sp, owner, 8); wbe(owner + 0x10, 0x00066660, 8);       /* the owner's frame */
+    wbe(sp + 0x80, 0x3030, 8); wbe(sp + 0x88, 0x3131, 8);
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx);
+    ctx.gpr[1] = sp; ctx.lr = 0x00012345; ctx.thread_id = 4;
+    func_00010200(&ctx);
+    CHECK(ctx.gpr[1] == owner);
+}
+
+int main(int argc, char** argv)
+{
+    const char* log = argc > 1 ? argv[1] : "slotcheck_e2e.log";
+    vm_base = (uint8_t*)calloc(1, VM_SIZE);
+
+    /* F, well-behaved callee: no mismatch; ABI and link registers right. */
+    ppu_context c = run_F(0, log);
+    CHECK(s_sc_mismatches.load() == 0);
+    CHECK(c.gpr[1] == 0x00F08000 && c.gpr[30] == 0x3030303030303030ull && c.gpr[31] == 0x3131313131313131ull);
+    CHECK(g_nseen == 2 && g_seen_lr[0] == 0x10020 && g_seen_lr[1] == 0x10028);  /* bl, then bctrl */
+    CHECK(g_seen_sc_ra == 0x1002C);
+    CHECK(be(0x00F08000 + 0x10, 8) == 0x00055554);                  /* the entry LR, saved by F */
+    /* F, each slot clobbered by its callee: caught at all three call sites. */
+    run_F(1, log); CHECK(s_sc_mismatches.load() == 3 && key_count(0x10000, PPU_SC_CS, 31) == 3);
+    run_F(2, log); CHECK(s_sc_mismatches.load() == 3 && key_count(0x10000, PPU_SC_LR, 0) == 3);
+    run_F(3, log); CHECK(s_sc_mismatches.load() == 3 && key_count(0x10000, PPU_SC_BC, 0) == 3);
+    run_F(4, log); CHECK(s_sc_mismatches.load() == 3 && key_count(0x10000, PPU_SC_SP, 0) == 3);
+    /* T, the tail fragment, against its owner's frame. */
+    run_T(0, log); CHECK(s_sc_mismatches.load() == 0);
+    run_T(1, log); CHECK(s_sc_mismatches.load() == 1 && key_count(0x10200, PPU_SC_CS, 31) == 1);
+    run_T(2, log); CHECK(s_sc_mismatches.load() == 1 && key_count(0x10200, PPU_SC_FLR, 0) == 1);
+    run_T(3, log); CHECK(s_sc_mismatches.load() == 1 && key_count(0x10200, PPU_SC_FBC, 0) == 1);
+    ppu_sc_test_reset();
+    printf("%s: slotcheck end to end (%d failure%s)\n", g_fail ? "FAIL" : "PASS", g_fail, g_fail == 1 ? "" : "s");
+    return g_fail ? 1 : 0;
+}
+"""
+
+
+def find_cxx():
+    cands = [os.environ.get("CXX")] if os.environ.get("CXX") else []
+    if os.name == "nt":
+        cands += [shutil.which("clang-cl"), r"C:\Program Files\LLVM\bin\clang-cl.exe"]
