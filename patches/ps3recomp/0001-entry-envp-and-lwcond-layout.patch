+#ifdef _WIN32
+/* HOST_PLACEMENT (NOTES 2026-10-27, PF1; hybrid / affinity 2026-11-12): the threads on the heavy views'
+ * critical path on physical cores of their own, so no other thread of the game shares their core through
+ * SMT. In the New Marais pier view a frame is the walker's work plus the SPU lighting chain behind its
+ * G-buffer readback, and the SPU workers run ~80% busy: with the scheduler's placement a busy thread often
+ * had another for an SMT sibling.
+ *   1 = the frame clock (the FIFO walker and the renderer) on a core of its own;
+ *   2 = that, and the first four of the SPURS kernel's five SPU workers (spu tid 0x2000-0x2003; 0x2004 is
+ *       ~0.5% busy) each on a core of its own;
+ *   3 = that, and the PPU main thread (the host main thread) on a core of its own.
+ * The cores: the process's allowed logical processors in group 0 (its affinity mask: a tool such as Process
+ * Lasso, or `start /affinity`, narrows them), grouped by physical core. The "fast" cores are those of the
+ * highest efficiency class (a hybrid CPU's P-cores; every core of a uniform CPU), and of those, the ones
+ * sharing the last-level cache that holds the most of them (one CCD of a two-CCD part). Placed threads take
+ * fast cores from the highest CoreIndex down. Every other thread of the process gets every allowed core
+ * that is not reserved (the process's default CPU sets) -- on a hybrid CPU that includes the E-cores --,
+ * except: the save-state codec pools and a few others (ps3_host_unplace_thread: every core), and on a
+ * hybrid CPU in mode 1-2 the PPU main thread, which is kept to the P-cores left over (never an E-core;
+ * shared, not reserved). Placement only: nothing the game computes depends on it.
+ * A title opts in (ps3_host_placement_configure, before its frame clock starts; inFamous 2: src/main.cpp
+ * from the cpu_placement row): the toolkit's default is off, so a title that does not opt in is never
+ * placed. Auto picks by the fast cores F (measured on the 9800X3D narrowed with an affinity mask, gate
+ * fight, 3 interleaved rounds, NOTES 2026-11-12: 6 cores off 35.2 fps / 1 38.0 / 2 39.1; 4 cores off 31.3 /
+ * 1 30.9):
+ *   - F >= 6 with SMT, one class, one cache (6-8-core Ryzen, i5-12400, the 9800X3D here): 2;
+ *   - a hybrid CPU with F >= 6 P-cores (12600K, 13400, 12700K, 14700(F)...): 2 on the P-cores, the rest of
+ *     the game on the P-cores left and the E-cores;
+ *   - otherwise off (4 cores: nothing to gain; no SMT: too little left for the other threads).
+ * HOST_PLACEMENT=auto | off | 0-3 overrides the title's choice (a debug knob; a forced mode needs 7 fast
+ * cores for 3, 5 for 2, 2 for 1, else the next mode down). HOST_PLACEMENT_SIM=<cores>:<class>[x<smt>],...
+ * (e.g. "8:1x2,4:0x1" = a 12700K) prints the plan auto would make for that topology and leaves placement
+ * off: a check of the decision on a CPU this PC is not. Any CPU set call that fails turns placement off. */
+#define HP_MAXC 64
+typedef struct { BYTE cidx, eff, llc, nid; ULONG ids[4]; } hp_core;
+static struct {
+    int mode, ncores;                   /* -1 undecided */
+    hp_core c[HP_MAXC];                 /* allowed cores, ascending CoreIndex */
+    int fast[HP_MAXC], nfast;           /* indexes into c: the fast cores, descending CoreIndex (the order they are taken) */
+    int hybrid;
+    int defaults_set;
+    SRWLOCK lk;
+    int cfg;                            /* the title's choice: 0 off (the default), -1 auto, 1-3 a mode */
+} s_hp = { -1, 0, {{0}}, {0}, 0, 0, 0, SRWLOCK_INIT, 0 };
+/* The title's choice, before any thread is placed: -1 auto, 0 off, 1-3 a mode. */
+void ps3_host_placement_configure(int mode)
+{
+    AcquireSRWLockExclusive(&s_hp.lk);
+    if (s_hp.mode >= 0) fprintf(stderr, "[placement] configured after placement was decided: ignored\n");
+    else s_hp.cfg = mode < -1 ? -1 : mode > 3 ? 3 : mode;
+    ReleaseSRWLockExclusive(&s_hp.lk);
+}
+static int hp_core_of(BYTE cidx, int* nc)       /* the slot of CoreIndex cidx, kept ascending; -1 when full */
+{
+    int k = 0;
+    while (k < *nc && s_hp.c[k].cidx != cidx) k++;
+    if (k < *nc) return k;
+    if (*nc >= HP_MAXC) return -1;
+    int at = *nc;
+    while (at > 0 && s_hp.c[at - 1].cidx > cidx) { s_hp.c[at] = s_hp.c[at - 1]; at--; }
+    memset(&s_hp.c[at], 0, sizeof s_hp.c[at]);
+    s_hp.c[at].cidx = cidx;
+    (*nc)++;
+    return at;
+}
+/* The fast cores (see above) into s_hp.fast, descending CoreIndex. Returns their count. */
+static int hp_pick_fast(int nc)
+{
+    BYTE maxe = 0;
+    for (int k = 0; k < nc; k++) if (s_hp.c[k].eff > maxe) maxe = s_hp.c[k].eff;
+    s_hp.hybrid = 0;
+    for (int k = 0; k < nc; k++) if (s_hp.c[k].eff != maxe) s_hp.hybrid = 1;
+    int best_llc = -1, best_n = 0;
+    for (int k = 0; k < nc; k++) {
+        if (s_hp.c[k].eff != maxe) continue;
+        int n = 0;
+        for (int j = 0; j < nc; j++) if (s_hp.c[j].eff == maxe && s_hp.c[j].llc == s_hp.c[k].llc) n++;
+        if (n > best_n) { best_n = n; best_llc = s_hp.c[k].llc; }
+    }
+    s_hp.nfast = 0;
+    for (int k = nc - 1; k >= 0; k--)
+        if (s_hp.c[k].eff == maxe && s_hp.c[k].llc == best_llc) s_hp.fast[s_hp.nfast++] = k;
+    return s_hp.nfast;
+}
+/* The mode auto picks, and why (for the log). */
+static int hp_auto(int nc, const char** why)
+{
+    const int F = s_hp.nfast;
+    int smt = F > 0, onellc = 1;
+    for (int i = 0; i < F; i++) if (s_hp.c[s_hp.fast[i]].nid < 2) smt = 0;
+    for (int k = 0; k < nc; k++) if (s_hp.c[k].llc != s_hp.c[0].llc) onellc = 0;
+    if (s_hp.hybrid) {
+        if (F >= 6) { *why = "a hybrid CPU with 6+ P-cores: the busy threads on P-cores of their own, the rest of the game on the E-cores and the P-cores left"; return 2; }
+        *why = "a hybrid CPU with under 6 P-cores: off"; return 0;
+    }
+    if (F >= 6 && smt && onellc) { *why = "6+ cores of one kind sharing one cache, with SMT"; return 2; }
+    *why = F < 6 ? "under 6 cores: off (measured: no gain on 4)" : !smt ? "no SMT: off (too little left for the rest)" : "two caches: off";
+    return 0;
+}
+/* HOST_PLACEMENT_SIM: fill s_hp.c from "<n>:<class>[x<smt>],..." (fake ids; never applied). */
+static int hp_sim(const char* spec)
+{
+    int nc = 0; BYTE cidx = 0;
+    for (const char* p = spec; *p; ) {
+        int n = 0, cls = 0, t = 2;
+        if (sscanf(p, "%d:%dx%d", &n, &cls, &t) < 2) return 0;
+        for (int i = 0; i < n && nc < HP_MAXC; i++) {
+            hp_core* c = &s_hp.c[nc++];
+            memset(c, 0, sizeof *c);
+            c->cidx = cidx++; c->eff = (BYTE)cls; c->llc = 0; c->nid = (BYTE)(t < 1 ? 1 : t > 4 ? 4 : t);
+            for (int j = 0; j < c->nid; j++) c->ids[j] = 256u + nc * 4u + (ULONG)j;
+        }
+        p = strchr(p, ',');
+        if (!p) break;
+        p++;
+    }
+    return nc;
+}
+static void hp_init(void)               /* under s_hp.lk */
+{
+    const char* e = getenv("HOST_PLACEMENT");   /* a debug override of the title's choice */
+    const char* sim = getenv("HOST_PLACEMENT_SIM");
+    int req = s_hp.cfg;
+    if (e && *e) {
+        if (!strcmp(e, "auto") || !strcmp(e, "on")) req = -1;
+        else if (!strcmp(e, "off")) req = 0;
+        else if (e[0] >= '0' && e[0] <= '3' && !e[1]) req = e[0] - '0';
+        else fprintf(stderr, "[placement] HOST_PLACEMENT=%s not understood (auto | off | 0-3): the setting's choice\n", e);
+    }
+    if (sim && *sim) req = -1;
+    const int autom = req < 0;
+    s_hp.mode = 0;
+    if (req == 0) {
+        fprintf(stderr, "[placement] off%s: the scheduler places every thread\n",
+                e && *e ? " (HOST_PLACEMENT)" : " (the cpu_placement setting is Off, or the title did not opt in)");
+        return;
+    }
+    int nc = 0;
+    if (sim && *sim) nc = hp_sim(sim);
+    else {
+        DWORD_PTR pmask = 0, smask = 0;
+        if (!GetProcessAffinityMask(GetCurrentProcess(), &pmask, &smask) || !pmask) pmask = ~(DWORD_PTR)0;
+        ULONG len = 0;
+        GetSystemCpuSetInformation(NULL, 0, &len, GetCurrentProcess(), 0);
+        unsigned char* buf = len ? (unsigned char*)malloc(len) : NULL;
+        if (!buf || !GetSystemCpuSetInformation((PSYSTEM_CPU_SET_INFORMATION)buf, len, &len, GetCurrentProcess(), 0)) {
+            fprintf(stderr, "[placement] off: the CPU sets cannot be read (GetSystemCpuSetInformation, error %lu)\n",
+                    (unsigned long)GetLastError());
+            free(buf); return;
+        }
+        for (ULONG o = 0; o < len; ) {
+            const SYSTEM_CPU_SET_INFORMATION* si = (const SYSTEM_CPU_SET_INFORMATION*)(buf + o);
+            if (!si->Size) break;
+            if (si->Type == CpuSetInformation && si->CpuSet.Group == 0 &&
+                si->CpuSet.LogicalProcessorIndex < 8 * sizeof(DWORD_PTR) &&
+                (pmask >> si->CpuSet.LogicalProcessorIndex) & 1) {
+                const int k = hp_core_of(si->CpuSet.CoreIndex, &nc);
+                if (k >= 0) {
+                    hp_core* c = &s_hp.c[k];
+                    c->eff = si->CpuSet.EfficiencyClass; c->llc = si->CpuSet.LastLevelCacheIndex;
+                    if (c->nid < 4) c->ids[c->nid++] = si->CpuSet.Id;
+                }
+            }
+            o += si->Size;
+        }
+        free(buf);
+    }
+    const int F = hp_pick_fast(nc);
+    const char* why = "";
+    int mode = autom ? hp_auto(nc, &why) : req;
+    if (mode >= 3 && F < 7) mode = 2;          /* 6 reserved: at least one fast core left for the rest */
+    if (mode >= 2 && F < 5) mode = 1;
+    if (F < 2) mode = 0;
+    fprintf(stderr, "[placement] %smode %d%s: %d allowed core(s) in group 0, %d fast%s\n",
+            sim && *sim ? "SIM " : "", mode, autom ? " (auto)" : "", nc, F,
+            s_hp.hybrid ? " (P-cores; the rest are E-cores)" : "");
+    if (autom) fprintf(stderr, "[placement]   auto: %s\n", why);
+    if (mode >= 1) {
+        fprintf(stderr, "[placement]   frame clock -> core %u", s_hp.c[s_hp.fast[0]].cidx);
+        if (mode >= 2) for (int i = 0; i < 4; i++) fprintf(stderr, ", SPU worker %d -> core %u", i, s_hp.c[s_hp.fast[1 + i]].cidx);
+        if (mode >= 3) fprintf(stderr, ", PPU main -> core %u", s_hp.c[s_hp.fast[5]].cidx);
+        else if (s_hp.hybrid) fprintf(stderr, ", PPU main -> the %d P-cores left (shared)", F - (mode >= 2 ? 5 : 1));
