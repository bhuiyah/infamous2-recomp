+/* ---------------------------------------------------------------------------
+ * Render-target readback (GPU -> guest memory)
+ *
+ * A surface this backend draws exists only as a D3D12 resource; the guest
+ * local memory under it keeps whatever was there before. A guest-side read of
+ * it then sees stale memory -- inFamous 2's menu copies every rendered frame
+ * to main memory with NV3089 blits for its SPU MLAA, and got the stale local
+ * memory instead (an olive frame). Before such a read cellGcmSys calls
+ * rsx_d3d12_readback_surface(): records still pending against the surface are
+ * executed first (render_frame in flush mode: no present, and the backbuffer
+ * is kept for the rest of the guest frame), then the resource is copied back
+ * into guest memory in RSX byte order. Only surfaces drawn since their last
+ * readback are copied.
+ * RT_READBACK=0 disables; RT_READBACK_DBG=<n> logs the first n readbacks.
+ * -----------------------------------------------------------------------*/
+static ID3D12CommandAllocator*    s_rb_alloc;
+static ID3D12GraphicsCommandList* s_rb_list;
+static ID3D12Resource*            s_rb_buf;
+static u64                        s_rb_size;
+
+static u32 dxgi_bpp(u32 dxgi)
+{
+    return dxgi == DXGI_FORMAT_R16G16B16A16_FLOAT ? 8u :
+           dxgi == DXGI_FORMAT_R32G32B32A32_FLOAT ? 16u : 4u;
+}
+
+/* The readback list, its allocator and a staging buffer of at least `need`
+ * bytes. 0 when they cannot be made. */
+static int rb_prepare(u64 need)
+{
+    ID3D12Device* dev = s_d3d.device;
+    if (!s_rb_alloc &&
+        FAILED(dev->lpVtbl->CreateCommandAllocator(dev, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                   &IID_ID3D12CommandAllocator, (void**)&s_rb_alloc))) return 0;
+    if (!s_rb_list) {
+        if (FAILED(dev->lpVtbl->CreateCommandList(dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                       s_rb_alloc, NULL, &IID_ID3D12GraphicsCommandList, (void**)&s_rb_list)))
+            return 0;
+        s_rb_list->lpVtbl->Close(s_rb_list);
+        s_rb_list->lpVtbl->SetName(s_rb_list, L"rt-readback");
+    }
+    if (need > s_rb_size) {
+        if (s_rb_buf) { s_rb_buf->lpVtbl->Release(s_rb_buf); s_rb_buf = NULL; s_rb_size = 0; }
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        bd.Width = need; bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+        bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if (FAILED(dev->lpVtbl->CreateCommittedResource(dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                       D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+                       &IID_ID3D12Resource, (void**)&s_rb_buf))) return 0;
+        s_rb_size = need;
+    }
+    return 1;
+}
