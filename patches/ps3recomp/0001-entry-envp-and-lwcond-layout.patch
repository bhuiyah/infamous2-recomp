+            (!dr->fp_shash || (dr->fp_texmask & (1u << u)))) rd_rt |= 1u << u;
+    fprintf(stderr, "[IMMDIAG] id=%08X frame %llu rec %u prim=%u(%s) first=%u count=%u indexed=%d %s"
+                    " vs=%d hash=%08X vs_in=0x%04X layout vmask=0x%04X vstride=%u -> %u indices"
+                    " (D3D triangle list) rt=0x%X units-sampling-rt=0x%X\n",
+            dr->fp_id, (unsigned long long)s_d3d.frame_count, (u32)(dr - s_d3d.draws), prim,
+            pn[prim <= 10 ? prim : 0], first, count, indexed, tr ? "IMMEDIATE" : "array",
+            dr->vs_idx, dr->vs_hash_rec, vs_in, dr->vmask, dr->vstride, emitted, dr->rt_off, rd_rt);
+    u32 pushed = 0;
+    if (tr) {
+        pushed = tr->pushed_mask;
+        fprintf(stderr, "[IMMDIAG]  imm verts=%u pushed=0x%04X stale=0x%04X reg=0x%04X late=0x%04X IMM_FIX=%u"
