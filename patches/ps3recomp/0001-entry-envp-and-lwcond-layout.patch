+static int s_ftr_on = -1;            /* -1 unknown, 0 off, 1 on */
+static FILE* s_ftr_f;
+static LARGE_INTEGER s_ftr_freq;
+extern int g_ftr_on;                 /* cellGcmSys.c: flip requests, walker idle */
+static int ftr_on(void)
+{
+    if (s_ftr_on >= 0) return s_ftr_on;
+    s_ftr_on = 0;
+    const char* e = getenv("FRAME_TRACE");
+    if (!e || !*e || (e[0] == '0' && !e[1])) {
+        if (!pi_active()) return 0;
+        QueryPerformanceFrequency(&s_ftr_freq);      /* light: the issues log's frames */
+        s_ftr_on = 2;
+        g_ftr_on = 1;
+        return 2;
+    }
+    s_ftr_f = fopen(e, "w");
+    if (!s_ftr_f) { fprintf(stderr, "[frametrace] cannot write %s -- off%c", e, 10); return 0; }
+    QueryPerformanceFrequency(&s_ftr_freq);
+    fprintf(s_ftr_f, "frame,t_s,interval_ms,flip_dt_ms,flip_to_present_ms,present_ms,pace_ms,rf_ms,gpuwait_ms,"
+                     "idle_ms,batches,fl_readback,fl_report,fl_capacity,draws,pso_miss,pso_ms,compiles,"
+                     "compile_ms,sc_hits,sc_read_ms,vs_new,vs_ms,pso_creates,pso_create_ms,tex_uploads,tex_new,"
+                     "tex_recreated,tex_mb,tex_ms,texval_ms,rt_new,zeta_new,readbacks,readback_ms,vtx_ms,"
+                     "present_count,present_refresh,sync_refresh,sync_qpc_ms,lat_frames,t_ready_s,pad_rx,"
+                     "sc_waits,sc_wait_ms,kicks,prewarm_left,flips,fifo_catchup,backlog_kb,"
+                     "vc_hits,vc_admits,vc_nofit,vc_bypassed,vc_recycled,vc_held,vc_moved,fl_texfence,texfences,"
+                     "tex_create_n,tex_create_ms,upbuf_n,upbuf_ms,rt_create_ms,pagefaults,pso_prewarmed,sc_mem,vram_hw_mb\n");
+    fprintf(stderr, "[frametrace] per-frame trace -> %s%c", e, 10);
+    s_ftr_on = 1;
+    g_ftr_on = 1;
+    return 1;
+}
+static inline double ftr_now(void)
+{
+    LARGE_INTEGER c; QueryPerformanceCounter(&c);
+    return (double)c.QuadPart / (double)s_ftr_freq.QuadPart;
+}
+/* R1: the render thread (RENDER_THREAD) replays batches beside the walker; FRAME_TRACE's counters are the
+ * walker's (its row is written on the walker), so the render thread adds nothing to them. */
+static __declspec(thread) int t_rt_render;   /* 1 on the render thread */
+#define FTR_T0()  (s_ftr_on > 0 ? ftr_now() : 0.0)
+#define FTR_ADD(field, t0) do { if (s_ftr_on > 0 && !t_rt_render) s_ftr.field += ftr_now() - (t0); } while (0)
+#define FTR_INC(field) do { if (s_ftr_on > 0 && !t_rt_render) s_ftr.field++; } while (0)
+/* per-draw timers: the full trace only */
+#define FTR_T0_FULL()  (s_ftr_on == 1 ? ftr_now() : 0.0)
+#define FTR_ADD_FULL(field, t0) do { if (s_ftr_on == 1 && !t_rt_render) s_ftr.field += ftr_now() - (t0); } while (0)
