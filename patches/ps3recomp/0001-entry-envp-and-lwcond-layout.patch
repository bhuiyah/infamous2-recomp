+    uint64_t stopped_us;              /* ... minus every stop */
+    uint64_t t_selftest;              /* M4c: the next selftest is due (SS_SELFTEST_EVERY / _AB) */
+    int      ab_phase;                /* SS_SELFTEST_AB: 0 capture A next, 1 load A next */
