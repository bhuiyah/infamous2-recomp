+    CHECK(g_notices == 1, "no sink, no call");
+}
+
+/* --- the hand-over under real concurrency -------------------------------------
+ * ss_ui.h allows requests from any thread. Here they come from another thread
+ * than the coordinator, and the engine finishes each one later on a worker
+ * thread: the engine must never be handed a request while one is in flight
+ * (a request can land in the mailbox while the last one is being handed
+ * over), and every request it started must complete. */
+static volatile LONG g_r_active, g_r_overlap, g_r_started, g_r_done, g_r_todo, g_r_stop, g_r_queued;
+static int race_engine(const ss_ui_request* r, char* why, unsigned n, void* user)
+{
+    (void)why; (void)n; (void)user;
+    if (InterlockedIncrement(&g_r_active) > 1) InterlockedIncrement(&g_r_overlap);
+    InterlockedIncrement(&g_r_started);
+    while (InterlockedCompareExchange(&g_r_todo, (LONG)r->seq, 0) != 0) YieldProcessor();
+    return SS_UI_ENGINE_STARTED;
+}
+static DWORD WINAPI race_worker(LPVOID p)
+{
+    (void)p;
+    for (;;) {
+        const LONG s = InterlockedExchange(&g_r_todo, 0);
+        if (!s) { if (g_r_stop == 2) return 0; YieldProcessor(); continue; }
+        for (volatile int i = 0; i < 500; i++) {}
+        InterlockedDecrement(&g_r_active);
+        InterlockedIncrement(&g_r_done);
+        ss_ui_complete((unsigned)s, 1, NULL);
+    }
+}
+static DWORD WINAPI race_requester(LPVOID p)
+{
+    (void)p;
+    while (!g_r_stop) if (ss_ui_request_save(1 + (int)(g_r_queued % SS_UI_SLOTS)) == SS_UI_QUEUED)
+        InterlockedIncrement(&g_r_queued);
+    return 0;
+}
+
+static void test_handover_race(void)
+{
+    ss_ui_set_notice_sink(NULL, NULL);
+    ss_ui_set_engine(race_engine, NULL);
+    /* every request and notice is a log line: send them to NUL meanwhile */
+    fflush(stdout);
+    const int keep = _dup(1), nul = _open("NUL", _O_WRONLY);
+    _dup2(nul, 1);
+    _close(nul);
+    HANDLE w = CreateThread(NULL, 0, race_worker, NULL, 0, NULL);
+    HANDLE q = CreateThread(NULL, 0, race_requester, NULL, 0, NULL);
+    const ULONGLONG end = GetTickCount64() + 600;
+    while (GetTickCount64() < end) ss_ui_service(1);
+    InterlockedExchange(&g_r_stop, 1);
+    WaitForSingleObject(q, 5000);
+    for (int i = 0; i < 100000 && ss_ui_busy(); i++) { ss_ui_service(1); YieldProcessor(); }   /* the last one */
+    InterlockedExchange(&g_r_stop, 2);
+    WaitForSingleObject(w, 5000);
+    CloseHandle(q);
+    CloseHandle(w);
+    fflush(stdout);
+    _dup2(keep, 1);
+    _close(keep);
+    printf("hand-over race: %ld queued, %ld started, %ld completed, %ld overlaps\n",
+           (long)g_r_queued, (long)g_r_started, (long)g_r_done, (long)g_r_overlap);
+    CHECK(g_r_overlap == 0, "the engine got a request while another was in flight (%ld times)", (long)g_r_overlap);
+    CHECK(g_r_started == g_r_queued && g_r_done == g_r_started, "every queued request started and completed");
+    CHECK(g_r_started > 100, "requests went through (%ld)", (long)g_r_started);
+    CHECK(!ss_ui_busy(), "nothing left in flight");
+    ss_ui_set_engine(NULL, NULL);
+}
+
+static void test_set_dir(void)
+{
+    char other[320], p[320];
+    snprintf(other, sizeof other, "%s\\other", g_dir);
+    ss_ui_set_dir(other);
+    CHECK(!_stricmp(ss_ui_dir(), other), "dir %s", ss_ui_dir());
+    CHECK(ss_ui_ensure_dir() == 1, "created %s", other);
+    CHECK(ss_ui_slot_path(1, ".meta", p, sizeof p) && strstr(p, "\\other\\slot1.meta"), "%s", p);
+    ss_slot_info in;
+    CHECK(ss_ui_slot_info(3, &in) == 0, "slot 3 is not in the other folder");
+    RemoveDirectoryA(other);
+}
+
+/* M5: savestates.ini, the engine's availability rule, a success notice of its own */
+static int g_av_ok;
+static int avail_fn(int op, char* why, unsigned n, void* user)
+{
+    (void)user;
+    if (g_av_ok) return 1;
+    snprintf(why, n, op == SS_UI_OP_SAVE ? "available once the game is running" : "a load is still in progress");
+    return 0;
+}
+
+static void test_m5(void)
+{
+    /* the settings: comments, a comment after a value, case, blanks, the '|' override string */
+    ss_ui_cfg_parse("# savestates.ini\r\n  Enabled = 1\r\ndir = my states   # where\r\nslots=4\r\n"
+                    "compression = xpress\r\n#thumbnail = 0\r\nbroken line\r\ngive_up_s = 2.5\r\n", 0);
+    ss_ui_cfg_parse("slots=6|thumbnail=off", 1);
+    CHECK(ss_ui_cfg_int("enabled", 0) == 1 && !strcmp(ss_ui_cfg("dir"), "my states") &&
+          !strcmp(ss_ui_cfg("compression"), "xpress"), "cfg: enabled %d dir '%s'", ss_ui_cfg_int("enabled", 0),
+          ss_ui_cfg("dir") ? ss_ui_cfg("dir") : "(null)");
+    CHECK(ss_ui_cfg_int("thumbnail", 1) == 0 && ss_ui_cfg_num("give_up_s", 3) == 2.5 && !ss_ui_cfg("missing") &&
+          ss_ui_cfg_int("missing", 7) == 7, "cfg: thumbnail / give_up_s / missing");
+    CHECK(ss_ui_slot_count() == 6, "slots %d (the override wins)", ss_ui_slot_count());
+    ss_ui_cfg_parse("slots = 99", 0);
+    CHECK(ss_ui_slot_count() == SS_UI_SLOTS, "slots clamped: %d", ss_ui_slot_count());
+    ss_ui_cfg_parse("slots = 10", 0);
+
+    /* availability: without a hook always; with one, requests are refused with its reason */
+    char why[160];
+    CHECK(ss_ui_available(SS_UI_OP_SAVE, why, sizeof why) == 1, "no hook: available");
+    ss_ui_set_notice_sink(sink, NULL);
+    ss_ui_set_engine(engine, NULL);
+    ss_ui_set_availability(avail_fn, NULL);
+    g_av_ok = 0;
+    notice_reset();
+    CHECK(!ss_ui_available(SS_UI_OP_SAVE, why, sizeof why) && !strcmp(why, "available once the game is running"),
+          "why '%s'", why);
+    CHECK(ss_ui_request_save(2) == SS_UI_UNAVAILABLE &&
+          !strcmp(g_notice, "Cannot save now: available once the game is running") && !ss_ui_busy(),
+          "refused save: '%s'", g_notice);
+    CHECK(ss_ui_request_load(SS_UI_QUICK) == SS_UI_UNAVAILABLE &&
+          !strcmp(g_notice, "Cannot load now: a load is still in progress"), "refused load: '%s'", g_notice);
+    g_av_ok = 1;
+    g_eng_answer = SS_UI_ENGINE_STARTED;
+    CHECK(ss_ui_request_save(2) == SS_UI_QUEUED, "available: queued");
+    ss_ui_service(900);
+    ss_ui_complete(g_req.seq, 1, "Saved slot 2 (14:32)");
+    CHECK(!strcmp(g_notice, "Saved slot 2 (14:32)") && !ss_ui_busy(), "the engine's own notice: '%s'", g_notice);
+    ss_ui_set_availability(NULL, NULL);
+    ss_ui_set_engine(NULL, NULL);
+}
+
+int main(int argc, char** argv)
+{
+    if (argc < 2) { printf("usage: test_ss_ui <scratch dir>\n"); return 2; }
+    if (!GetFullPathNameA(argv[1], (DWORD)sizeof g_dir, g_dir, NULL)) return 2;
+    size_t n = strlen(g_dir);
+    while (n > 3 && (g_dir[n - 1] == '\\' || g_dir[n - 1] == '/')) g_dir[--n] = 0;
+    char env[400];
+    snprintf(env, sizeof env, "SS_DIR=%s\\", g_dir);          /* a trailing separator is dropped */
+    _putenv(env);
+
+    test_when();
+    test_meta_parse();
+    test_labels();
+    test_slots();
+    test_requests();
+    test_handover_race();
+    test_set_dir();
+    test_m5();
+    printf("%d checks, %d failed\n", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
