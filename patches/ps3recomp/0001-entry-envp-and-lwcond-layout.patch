+/* IMM_DIAG=<hex fp id>[,<hex fp id>...] (the manifests' fphash; '*' = every
+ * immediate-mode primitive, counted per fragment program), IMM_DIAG_N=<n>
+ * reports per id (default 2): once
+ * rsx_capfile_armed() (RSX_CAP_FILE's trigger; armed from the start without
+ * it), each matching VP draw (VCOMPACT, or the old path with VCOMPACT=0 or a
+ * diagnostic that turns it off, e.g. VB_CLIP_ID) prints on stderr
+ *   [IMMDIAG] id ...      guest primitive, first/count, VS (slot, hash, the
+ *                         attributes it reads), the record's vertex layout and
+ *                         the texture units that sample the target being drawn;
+ *   [IMMDIAG]  imm ...    immediate mode (rsx_imm_trace_current): attributes
+ *                         pushed, left on a guest array (stale), fed the
+ *                         register, written after the last attribute-0 write
+ *                         (late: pushed after the provoking write), IMM_FIX;
+ *   [IMMDIAG]  words ...  the primitive's vertex-data words as received ('!' =
+ *                         no handler decoded it -- the word was dropped);
+ *   [IMMDIAG]  array aN   the guest array state of each VS input not pushed;
+ *   [IMMDIAG]  vK ...     each emitted vertex's register snapshot (VS inputs);
+ *   [IMMDIAG]  tri ...    the uploaded triangle list: indices into the arena and
+ *                         each vertex's VS inputs as the GPU reads them;
+ *   [IMMDIAG]  verdict .. what is wrong with the inputs, if anything. */
+#define IMMD_APPEND(...) do { if (lp < (int)sizeof line - 1) {                       \
+        const int _r = snprintf(line + lp, sizeof line - (size_t)lp, __VA_ARGS__);   \
+        if (_r > 0) lp += _r;                                                         \
+        if (lp > (int)sizeof line - 1) lp = (int)sizeof line - 1; } } while (0)
+static void imm_diag(const D3D12DrawRecord* dr, const rsx_state* st, u32 prim, u32 first,
+                     u32 count, int indexed, u32 emitted)
+{
