+    s_userdata = (void*)(uintptr_t)s_ss_userdata;
+    s_nobutton_deadline = s_ss_nobutton_left_ms ? dialog_now_ms() + (ULONGLONG)s_ss_nobutton_left_ms : 0;
+    for (int i = 0; i < MAX_PROGRESS_BARS; i++)
