+static void test_ds4_bt(void)
+{
+    printf("DS4 Bluetooth: open (0x05 + CRC, 0x02 switch), simple 0x01, full 0x11 (+bad CRC), output 0x11\n");
+    mock_reset();
+    mock_feature(vec_ds4_bt_cal, 41, 0);
+    u8 f02[37] = { 0x02 };
+    mock_feature(f02, 37, 0);
+    PadHostDevice* d = new_dev(0x05C4, PADHOST_BUS_BT, 547, 547, 547);
+    strcpy(d->serial, "A4:AE:12:34:56:78");
+    CHECK_EQ(padhost_drv_ds4.open(d), 0);
+    CHECK_EQ(g_get_calls[0x05], 1);
+    CHECK_EQ(g_get_calls[0x02], 1);                   /* the switch to 0x11 */
+    CHECK(!strcmp(d->serial, "a4ae12345678"));
+
+    /* Simple report, padded to 547 like Windows does. */
+    u8 rep[547]; memset(rep, 0, sizeof rep);
+    rep[0] = 0x01; rep[1] = 0x80; rep[2] = 0x00; rep[3] = 0xFF; rep[4] = 0x80;
+    rep[5] = 0x40 | 0x04;                              /* circle, hat down */
+    rep[6] = 0x20;                                     /* Options */
+    rep[7] = 0x01;                                     /* PS */
+    rep[8] = 0x10; rep[9] = 0x20;
+    PadHostPortState st; fresh(&st);
+    st.sensor_x = 600;                                 /* previous motion survives */
+    CHECK_EQ(padhost_drv_ds4.parse(d, rep, 547, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CIRCLE | CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_START);
+    CHECK_EQ(st.ps, 1);
+    CHECK_EQ(st.ly, 0x00); CHECK_EQ(st.rx, 0xFF);
+    CHECK_EQ(st.press[PADHOST_PRESS_L2], 0x10); CHECK_EQ(st.press[PADHOST_PRESS_R2], 0x20);
+    CHECK_EQ(st.sensor_x, 600); CHECK_EQ(st.battery, 255);
+
+    /* Simple reports keep coming: the switch request is repeated. */
+    for (int i = 0; i < 250; i++) padhost_drv_ds4.parse(d, rep, 547, &st);
+    CHECK_EQ(g_get_calls[0x02], 2);
+
+    /* Full report with the reference CRC. */
+    memset(rep, 0, sizeof rep);
+    memcpy(rep, vec_ds4_bt_in, 78);
+    fresh(&st);
+    CHECK_EQ(padhost_drv_ds4.parse(d, rep, 547, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_RIGHT | CELL_PAD_CTRL_L1 | CELL_PAD_CTRL_R2 |
+                         CELL_PAD_CTRL_START | CELL_PAD_CTRL_R3 | CELL_PAD_CTRL_SELECT);
+    CHECK_EQ(st.ps, 1);
+    CHECK_EQ(st.lx, 0x10); CHECK_EQ(st.ly, 0xF0); CHECK_EQ(st.rx, 0x80); CHECK_EQ(st.ry, 0x7F);
+    CHECK_EQ(st.press[PADHOST_PRESS_R2], 0xC8);
+    CHECK_EQ(st.sensor_x, 512); CHECK_EQ(st.sensor_y, 399); CHECK_EQ(st.sensor_z, 512);
+    CHECK_EQ(st.sensor_g, 648);                        /* -1600 / 16 = -100 deg/s -> 512 + 136.67 */
+    CHECK_EQ(st.battery, 85);
+    for (int i = 0; i < 300; i++) padhost_drv_ds4.parse(d, rep, 547, &st);
+    CHECK_EQ(g_get_calls[0x02], 2);                    /* no more switch requests once full */
+
+    /* One flipped bit: dropped, state untouched. */
+    rep[10] ^= 0x01;
+    PadHostPortState st2 = st;
+    CHECK_EQ(padhost_drv_ds4.parse(d, rep, 547, &st2), 0);
+    CHECK(!memcmp(&st, &st2, sizeof st));
+
+    /* Output 0x11: 78-byte report padded to the declared 547. */
+    u8 out[600]; memset(out, 0xEE, sizeof out);
+    int n = padhost_drv_ds4.build_output(d, 0, 0xFF, 1, out, (int)sizeof out);
+    CHECK_EQ(n, 547);
+    CHECK(same_bytes(out, vec_ds4_bt_out_p1, 78, "DS4 BT output"));
+    CHECK(zero_from(out, 78, 547));
+    /* A buffer too small for the padding still gets the report itself. */
+    n = padhost_drv_ds4.build_output(d, 0, 0xFF, 1, out, 100);
+    CHECK_EQ(n, 78);
+    CHECK(same_bytes(out, vec_ds4_bt_out_p1, 78, "DS4 BT output (short buffer)"));
+}
