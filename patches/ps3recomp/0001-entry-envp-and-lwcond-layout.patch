+/* Set by the present entry point: 1 = this batch ends with a swapchain
+ * Present, 0 = execute the recorded draws only. An OFFSCREEN-only batch (a
+ * render-to-texture pass) must still run -- it is what fills the texture a
+ * later batch samples -- but presenting it would show a half-built frame. */
+static int s_present_this_frame = 1;
+
+/* RT readback flush (rsx_d3d12_readback_surface): render_frame runs the
+ * records accumulated so far without presenting, so a guest read of a
+ * rendered surface sees its pixels. The rest of the guest frame lands in a
+ * later render_frame, which must not clear the backbuffer the flush already
+ * drew into (s_bb_keep). The present gates count what flushes executed. */
+static int s_rf_flush = 0;
+static u32 s_cap_batch_draws = 0;   /* records in the batch render_frame just ran */
+static int s_rf_prev_flush = 0;    /* the last render_frame was a readback flush:
+                                    * this one continues the same guest frame */
+static int s_bb_keep = 0;
+
+/* Surfaces drawn or cleared so far in this guest frame, in record order (the
+ * texture prepass walks the records in submission order). A display buffer
+ * is the swap-chain backbuffer here, so its guest memory never holds what
+ * was shown: sampling one before this frame drew to it means "last frame's
+ * image" -- inFamous 2's eye adaptation measures display buffer 1 at the
+ * start of each frame, then reuses that memory as a G-buffer target. */
+extern int cellGcmOffsetIsDisplay(u32 offset);
+static u32 s_fw_off[64];
+static int s_fw_n;
+static int fw_has(u32 off)
+{
+    for (int i = 0; i < s_fw_n; i++) if (s_fw_off[i] == off) return 1;
+    return 0;
+}
+static void fw_add(u32 off)
+{
+    if (off && !fw_has(off) && s_fw_n < 64) s_fw_off[s_fw_n++] = off;
+}
+/* Which copy of each display buffer holds its latest contents this guest
+ * frame, in record order. A display buffer is two resources here: the swap
+ * chain backbuffer (draws with rt_off 0) and an offscreen RT aliasing its
+ * offset (MRT targets, render-to-texture). inFamous 2 uses the back buffer's
+ * memory as its G-buffer's third plane, then draws the lit scene into it
+ * (op "#192", a full-screen copy to the backbuffer here) and immediately
+ * downsamples it for its glow (op "#193") -- which read the alias, i.e. the
+ * G-buffer plane (green = depth), and the composite added it to every frame.
+ * DB_BB: last written through the backbuffer -> a sampler needs a snapshot of
+ * the backbuffer copied into the alias first; DB_ALIAS: the alias is current;
+ * 0: not written this frame (the previous frame's copy, SCREEN_AS_TEX). */
+enum { DB_NONE = 0, DB_BB = 1, DB_ALIAS = 2 };
+static u32 s_db_off[4]; static int s_db_kind[4], s_db_snapped[4], s_db_n;
+static int db_idx(u32 off, int add)
+{
+    for (int i = 0; i < s_db_n; i++) if (s_db_off[i] == off) return i;
+    if (!add || s_db_n >= 4) return -1;
+    s_db_off[s_db_n] = off; s_db_kind[s_db_n] = DB_NONE; s_db_snapped[s_db_n] = 0;
+    return s_db_n++;
+}
+static int db_kind(u32 off) { int i = db_idx(off, 0); return i < 0 ? DB_NONE : s_db_kind[i]; }
+static void db_wrote(u32 off, int kind)
+{
+    extern int cellGcmOffsetIsDisplay(u32 offset);
+    if (!off || !cellGcmOffsetIsDisplay(off)) return;
+    int i = db_idx(off, 1);
+    if (i >= 0) { s_db_kind[i] = kind; if (kind == DB_BB) s_db_snapped[i] = 0; }
+}
+static int s_flush_display = 0;    /* a flush executed display-target records */
+static u32 s_flush_records = 0;    /* records executed by flushes this frame */
+
+/* Resolve a DRAW_*_TEX value: a hex raw offset, or the literal "duck" for the
+ * content-identified duck texture. */
+static u32 draw_filter_tex(const char* e)
+{
+    if (!e) return 0;
+    if (e[0] == 'd' && e[1] == 'u') return s_duck_raw;
+    return (u32)strtoul(e, NULL, 16);
+}
