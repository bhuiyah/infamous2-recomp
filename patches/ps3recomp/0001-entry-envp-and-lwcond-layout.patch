+    SPU__VX_OPAQUE(a); SPU__VX_OPAQUE(b);
+    const __m256d u = spu__fx2d_v(a), v = spu__fx2d_v(b);
+    SPU__FX_VXSUM(_mm_add_ps(spu__f(a), spu__f(b)), spu__fxden2(a, b), u, v);
