+ * The thread resumes as this call would have gone on from its park -- the
+ * EXACT rule (critique B2): a LWCOND park waits for a token again WITHOUT
+ * registering (its registration is in the lwcond's waiter count, which
+ * KOBJ's restore brings back with the pending tokens), then re-takes the
+ * mutex; a LWCOND_REACQ park re-takes the mutex. Either way owner = this
+ * thread, recursion = the payload's, r3 = the result (ETIMEDOUT after a
+ * timed-out wait), as the call returns. */
+static void ss_resume_lwcond_common(ppu_context* ctx, uint32_t lwcond, const ss_wait_rec* rec, int signal_half)
+{
+    const uint32_t lwmutex = rec->a, rc = rec->b;
+    HANDLE s = lwm_sem(lwmutex);
+    struct LwcSlot* c = signal_half ? lwc_slot(lwcond) : nullptr;
+    int32_t rc_out = signal_half ? 0 : (int32_t)rec->c;
+    if (!s || (signal_half && !c)) { ctx->gpr[3] = 0; return; }   /* (as the call does without them) */
+    lwc_wait_rec* wr = lwc_wait_rec_of(ctx);
+    if (wr) { wr->lwcond = lwcond; wr->lwmutex = lwmutex; wr->own = LWM_SELF(ctx); wr->rc = rc;
