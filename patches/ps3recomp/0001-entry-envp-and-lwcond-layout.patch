+/* A LINEAR texture steps every level's rows by the one pitch register. */
+static void test_mip_chain_linear_pitch(void)
+{
+    rsx_tex_level lv[RSX_MAX_TEXTURE_LEVELS];
+    CHECK_EQ(rsx_texture_uniform_pitch(FMT_A8R8G8B8 | FMT_LN, 16, 4, 128), 128);
+    CHECK_EQ(rsx_texture_uniform_pitch(FMT_A8R8G8B8 | FMT_LN, 16, 4, 64), 64);   /* = packed: still every level */
+    CHECK_EQ(rsx_texture_uniform_pitch(FMT_A8R8G8B8 | FMT_LN, 16, 4, 32), 0);    /* too narrow */
+    CHECK_EQ(rsx_texture_uniform_pitch(FMT_A8R8G8B8 | FMT_LN, 16, 4, 0), 0);
+    CHECK_EQ(rsx_texture_uniform_pitch(FMT_A8R8G8B8, 16, 4, 128), 0);            /* swizzled */
+    CHECK_EQ(rsx_texture_uniform_pitch(FMT_DXT1, 16, 16, 64), 0);                /* LN clear */
+
+    rsx_texture_mip_chain(FMT_A8R8G8B8 | FMT_LN, 16, 4, 3, 128, lv);
+    CHECK_EQ(lv[0].offset, 0);   CHECK_EQ(lv[0].tl.row_bytes, 128); CHECK_EQ(lv[0].tl.dst_row_bytes, 64);
+    CHECK_EQ(lv[1].offset, 512); CHECK_EQ(lv[1].tl.row_bytes, 128); CHECK_EQ(lv[1].tl.dst_row_bytes, 32);
+    CHECK_EQ(lv[2].offset, 768); CHECK_EQ(lv[2].tl.row_bytes, 128); CHECK_EQ(lv[2].tl.face_bytes, 128);
+
+    /* pitch unset: packed at each level's own width, as before */
+    rsx_texture_mip_chain(FMT_A8R8G8B8 | FMT_LN, 16, 4, 3, 0, lv);
+    CHECK_EQ(lv[1].offset, 256); CHECK_EQ(lv[2].offset, 320); CHECK_EQ(lv[1].tl.row_bytes, 32);
+
+    /* LN DXT1: block rows at the pitch, each copying only its own blocks */
+    rsx_texture_mip_chain(FMT_DXT1 | FMT_LN, 16, 16, 3, 64, lv);
+    CHECK_EQ(lv[0].tl.row_bytes, 64); CHECK_EQ(lv[0].tl.dst_row_bytes, 32); CHECK_EQ(lv[0].tl.face_bytes, 256);
+    CHECK_EQ(lv[1].offset, 256); CHECK_EQ(lv[1].tl.face_bytes, 128); CHECK_EQ(lv[1].tl.dst_row_bytes, 16);
+    CHECK_EQ(lv[2].offset, 384); CHECK_EQ(lv[2].tl.face_bytes, 64);
+    u8 src[128], dst[2 * 20];
+    for (u32 i = 0; i < sizeof src; i++) src[i] = (u8)(i + 1);
+    memset(dst, 0xEE, sizeof dst);
+    rsx_texture_decode(dst, 20, src, 8, 8, &lv[1].tl, 0);   /* level 1: 2 block rows, 16 bytes each */
+    for (u32 b = 0; b < 16; b++) { CHECK_EQ(dst[b], src[b]); CHECK_EQ(dst[20 + b], src[64 + b]); }
+    CHECK_EQ(dst[16], 0xEE);                                  /* no spill past the blocks */
+}
