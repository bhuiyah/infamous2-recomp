+        if (s_tc.st_fz || s_tc.st_fz_split || s_tc.st_fz_unused || s_tc.st_fz_budget)   /* TX1, cumulative */
+            fprintf(stderr, "[TEXFENCE] fences %u (reference %u, back-end label %u, texture-read label %u), batches"
+                            " judged by one %u, splits %u, unused %u, budget %u | slots copied at the fence %u (%.1f MB;"
+                            " hot ones over the cap %u),"
+                            " textures with no slot copied %u (read %u, not copied %u), watched %u (hot %u), hashed %u"
+                            " (unchanged at the fence %u, unchecked %u, RSX copies after the fence %u), rewritten after"
+                            " the fence %u, evicted %u,"
+                            " copies refused"
+                            " %u | per fence: harvest %.1f us, walk + copies %.1f us%c",
+                    s_tc.st_fz, s_tc.st_fzk[0], s_tc.st_fzk[1], s_tc.st_fz_texread,
+                    s_tc.st_fz_used, s_tc.st_fz_split, s_tc.st_fz_unused, s_tc.st_fz_budget, s_tc.st_fz_cap,
+                    (double)s_tc.st_fz_capbytes / 1048576.0, s_tc.st_fz_hotcap, s_tc.st_fz_new, s_tc.st_fz_newuse,
+                    s_tc.st_fz_newskip,
+                    s_tc.st_fz_watch, s_tc.st_fz_hot, s_tc.st_fz_rsx, s_tc.st_fz_rsxsame, s_tc.st_fz_rsxoff,
+                    s_tc.st_fz_rsxw, s_tc.st_fz_lost, s_tc.st_fz_evict, s_tc.st_fz_capfail,
