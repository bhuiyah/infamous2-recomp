+/* The header CRC recomputed (header with hdr_crc 0, then both tables), as a
+ * hand-edited file would carry it. The tables must be inside the file. */
+static void reseal_file(uint8_t* fb)
+{
+    ss_img_hdr h;
+    memcpy(&h, fb, sizeof h);
+    h.hdr_crc = 0;
+    uint32_t crc = ss_crc32c(0, &h, sizeof h);
+    crc = ss_crc32c(crc, fb + h.sec_off, (size_t)h.nsections * sizeof(ss_sec_ent));
+    crc = ss_crc32c(crc, fb + h.chunk_off, (size_t)h.nchunks * sizeof(ss_chunk_ent));
+    memcpy(fb + offsetof(ss_img_hdr, hdr_crc), &crc, 4);
+}
+
+/* Crafted files whose offsets wrap a u64 sum: each passed the old bound
+ * checks and then read outside the file. Refused, nothing read out of it. */
+static void check_crafted(uint8_t* fb, uint64_t fn)
+{
+    char why[256];
+    ss_image fi;
+    ss_img_hdr h0;
+    memcpy(&h0, fb, sizeof h0);
+    uint8_t* save = (uint8_t*)malloc((size_t)h0.data_off);   /* header and both tables */
+    if (!save) return;
+    memcpy(save, fb, (size_t)h0.data_off);
+    ss_img_hdr h;
+    /* the section table "before" the file: sec_off + nsections * 64 wraps to 0 */
+    h = h0;
+    h.sec_off = 0 - (uint64_t)h.nsections * sizeof(ss_sec_ent);
+    memcpy(fb, &h, sizeof h);
+    CHECK(ss_image_parse(&fi, fb, fn, why, sizeof why) == SS_E_CORRUPT && strstr(why, "table bounds"),
+          "a wrapping section table: %s", why);
+    /* the data region: data_off + data_size wraps to 0 (CRC fixed) */
+    h = h0;
+    h.data_off = 0x100000000000ull;
+    h.data_size = 0 - h.data_off;
+    memcpy(fb, &h, sizeof h);
+    reseal_file(fb);
+    CHECK(ss_image_parse(&fi, fb, fn, why, sizeof why) == SS_E_CORRUPT && strstr(why, "table bounds"),
+          "a wrapping data region: %s", why);
+    /* a chunk size the format does not have */
+    h = h0;
+    h.chunk_bytes = 0xFFFFFFFFu;
+    memcpy(fb, &h, sizeof h);
+    reseal_file(fb);
+    CHECK(ss_image_parse(&fi, fb, fn, why, sizeof why) == SS_E_CORRUPT && strstr(why, "table bounds"),
+          "chunk_bytes 0xFFFFFFFF: %s", why);
+    /* a section (and its chunks, so the coverage agrees) near 2^64: offset +
+     * size wraps to size - 64, below data_size (CRC fixed) */
+    memcpy(fb, save, (size_t)h0.data_off);
+    ss_sec_ent* se = (ss_sec_ent*)(fb + h0.sec_off);
+    ss_chunk_ent* ce = (ss_chunk_ent*)(fb + h0.chunk_off);
+    const uint64_t hi_off = 0 - (uint64_t)64;       /* (TIME is far larger than 64 bytes) */
+    for (uint32_t c = se[0].chunk0; c < se[0].chunk0 + se[0].nchunks; c++) ce[c].offset += hi_off - se[0].offset;
+    se[0].offset = hi_off;
+    reseal_file(fb);
+    CHECK(ss_image_parse(&fi, fb, fn, why, sizeof why) == SS_E_CORRUPT && strstr(why, "out of bounds"),
+          "a section whose offset + size wraps: %s", why);
+    /* a chunk running past its section (the next chunk starting inside it) */
+    memcpy(fb, save, (size_t)h0.data_off);
+    for (uint32_t i = 0; i < h0.nsections; i++) {
+        if (se[i].nchunks < 1 || se[i].size < 2) continue;
+        ce[se[i].chunk0 + se[i].nchunks - 1].size += 1;
+        break;
+    }
+    reseal_file(fb);
+    CHECK(ss_image_parse(&fi, fb, fn, why, sizeof why) == SS_E_CORRUPT && strstr(why, "misplaced"),
+          "a chunk past its section: %s", why);
+    memcpy(fb, save, (size_t)h0.data_off);
+    CHECK(ss_image_parse(&fi, fb, fn, why, sizeof why) == SS_OK, "parse once restored: %s", why);
+    free(save);
+}
