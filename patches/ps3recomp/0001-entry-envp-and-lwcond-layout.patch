+    "float4 rsx_texproc_bx2(float4 c, uint u) {\n"
+    "    const uint m = u < 8u ? (asuint(fp_alpha.w) >> (u * 4u)) & 0xFu : 0u;\n"
+    "    if (m == 0u) return rsx_texproc(c, u);\n"
+    "    const bool4 bx = bool4((m & 1u) != 0u, (m & 2u) != 0u, (m & 4u) != 0u, (m & 8u) != 0u);\n"
+    "    return bx ? c * 2.0 - 1.0 : c;\n"
+    "}\n";
