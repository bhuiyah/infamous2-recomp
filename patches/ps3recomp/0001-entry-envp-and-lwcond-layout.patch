+        ss_slots_undo_settle(1);
+        CHECK(!strcmp(mission_of(up), "C") && !exists(ub), "loaded: undo = C (%s)", mission_of(up));
+        /* 4. Undo last load: undo.p3ss (C) is read into memory, then its own undo point D is written over it;
+         * the load done, undo = D -- a second undo goes back to D (the two moments swap) */
+        {
+            ss_file_image fi;
+            ss_file_identity me;
+            ss_slots_identity(&me);
+            CHECK(ss_file_load(up, &me, 2, &fi, NULL, why, sizeof why, NULL) == SS_OK &&
+                  !strcmp(fi.hdr.mission, "C") && fi.compat_warn == 0, "the undo point read: %s", why);
+            UNDO_KEEP("D");
+            CHECK(!strcmp(mission_of(ub), "C"), "C waits as .bak while the load runs");
+            ss_slots_undo_settle(1);
+            CHECK(!strcmp(mission_of(up), "D") && !exists(ub), "undo of an undo: undo = D (%s)", mission_of(up));
+            if (fi.buf) check_same(img, &fi.img, "the undo point read back");
+            ss_file_image_free(&fi);
+        }
+        /* 5. the very first load refused: no undo point is left behind */
+        DeleteFileA(up);
+        UNDO_KEEP("E");
+        ss_slots_undo_settle(0);
+        CHECK(!exists(up) && !exists(ub), "a refused first load leaves nothing to undo");
+        CHECK(ss_ui_slot_info(SS_UI_UNDO, &u) == 0 && strstr(u.label, "(nothing to undo)"), "%s", u.label);
+#undef UNDO_KEEP
+    }
+
+    /* ---- a section this build needs is not in the file (build_check = 0) -- */
+    {
+        static const ss_section_ops k_c_ops = {
+            SS_FOURCC('F', 'K', 'C', '1'), 1, 0, SS_ORDER_GCM + 1, NULL, a_capture, NULL, NULL, NULL, "fake late", NULL, NULL,
+        };
+        CHECK(ss_section_register(&k_c_ops), "register a section after the capture");
+        ss_file_identity loose = id;
+        loose.check_build = 0;
+        expect_refused(path, &loose, SS_E_LAYOUT, "another build: data missing", "no section FKC1 (fake late)", "missing");
+        snprintf(loose.build_id, sizeof loose.build_id, "test build 2 | 00000002-00000000");
+        expect_refused(path, &loose, SS_E_LAYOUT, "another build: data missing", "no section FKC1 (fake late)",
+                       "policy: a missing section");
+        CHECK(ss_image_validate(img, why, sizeof why) == SS_E_LAYOUT && strstr(why, "FKC1 (fake late) is missing"),
+              "the image is refused too: %s", why);
+    }
+
+    printf("%s: %d checks, %d failed\n", g_fail ? "FAIL" : "PASS", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
