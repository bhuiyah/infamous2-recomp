+    { FP_PK_UPG, "float4 rsx_upg(float v) { return rsx_s2l(rsx_upb(v)); }\n" },
+    { FP_PK_PK4,
+      "float rsx_pk4(float4 v) { const uint4 b = asuint((int4)round(clamp(v, -1.0, 1.0) * 127.0)) & 0xFFu;"
+      " return asfloat(b.x | (b.y << 8) | (b.z << 16) | (b.w << 24)); }\n" },
+    { FP_PK_UP4,
+      "float4 rsx_up4(float v) { const uint u = asuint(v);"
+      " return max((float4)(asint(uint4(u << 24, u << 16, u << 8, u)) >> 24) / 127.0, -1.0); }\n" },
+    { FP_PK_PK2, "float rsx_pk2(float4 v) { return asfloat(f32tof16(v.x) | (f32tof16(v.y) << 16)); }\n" },
+    { FP_PK_UP2,
+      "float4 rsx_up2(float v) { const uint u = asuint(v);"
+      " return float4(f16tof32(u), f16tof32(u >> 16), f16tof32(u), f16tof32(u >> 16)); }\n" },
+    { FP_PK_PK16,
+      "float rsx_pk16(float4 v) { const uint2 s = (uint2)round(saturate(v.xy) * 65535.0);"
+      " return asfloat(s.x | (s.y << 16)); }\n" },
+    { FP_PK_UP16,
+      "float4 rsx_up16(float v) { const uint u = asuint(v);"
+      " return float4(u & 0xFFFFu, u >> 16, u & 0xFFFFu, u >> 16) / 65535.0; }\n" },
+};
