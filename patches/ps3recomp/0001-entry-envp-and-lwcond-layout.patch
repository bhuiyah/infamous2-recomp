+/* Save states (M4c, KOBJ's teardown): a load leaves no sys_rwlock live (an
+ * image never holds one). Every guest thread is gone, so nobody waits on
+ * one; a lock a discarded thread held is simply forgotten (an SRW lock needs
+ * no destroy, and a zeroed one is SRWLOCK_INIT). */
+void sys_rwlock_ss_teardown(void)
+{
+#ifndef _WIN32
+    for (int i = 0; i < SYS_RWLOCK_MAX; i++)
+        if (g_sys_rwlocks[i].active) pthread_rwlock_destroy(&g_sys_rwlocks[i].rwl);
+#endif
+    memset(g_sys_rwlocks, 0, sizeof(g_sys_rwlocks));
+}
