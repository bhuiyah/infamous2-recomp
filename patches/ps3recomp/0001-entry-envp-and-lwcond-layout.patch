+#if defined(SPU_HELPERS_FP_RZDAZ)
+/* The result test when MXCSR is round-toward-zero + DAZ + FTZ (the runtime
+ * guarantees it for every SPU host thread of a build with this define):
+ *  - a denormal operand already reads as zero, which is what the SPU (and
+ *    the reference's slow path) does: x*0, x+0 and a*b+0 are exact. With a
+ *    denormal c the reference truncates a*b exactly, and so does the host
+ *    under round-toward-zero.
+ *  - the host rounding is the SPU's truncation, so a result of exactly
+ *    2^-126 is the truncated one; below it, FTZ has made it a signed zero,
+ *    and adding +0 turns -0 into +0 (exact for every other value).
+ *  - an exponent-255 operand is an infinity or NaN on the host, and any op
+ *    on one gives an infinity or NaN; an overflow gives +-FLT_MAX: all of
+ *    them are |r| > 0x7F7FFFFE and go to the reference, as before.
+ * fxtest.c / test_spu_helpers_simd.c check it against the reference in that
+ * mode.
+ * The compiler does not know about DAZ/FTZ: it assumes IEEE denormals (clang's
+ * default denormal mode) and folds `x + 0.0f` away whenever it can "prove" x
+ * is never -0 -- e.g. `fadd y, C` for a nonzero constant C that lifted code
+ * built with ilhu/iohl. Under FTZ a tiny negative sum is -0, so the result
+ * must be opaque before the +0, and so must the operand of any conversion
+ * whose denormal flush is left to DAZ (spu__cflt_x): no constant folding with
+ * IEEE denormals. SPU__RZ_OPAQUE costs no instruction. */
+#  if defined(__clang__) || defined(__GNUC__)
+#    define SPU__RZ_OPAQUE(v) __asm__("" : "+x"(v))
+#  else
+#    define SPU__RZ_OPAQUE(v) ((void)0)
+#  endif
+SPU_FORCEINLINE __m128i spu__fxres_rzdaz(__m128 f, __m128i* bad) {
+    *bad = _mm_or_si128(*bad, _mm_cmpgt_epi32(_mm_and_si128(spu__i(f), spu__k(0x7FFFFFFFu)), spu__k(0x7F7FFFFEu)));
+    SPU__RZ_OPAQUE(f);
+    return spu__i(_mm_add_ps(f, _mm_setzero_ps()));
