+
+static uint64_t tp_auto_budget(void)
+{
+    uint64_t b = 0;
+    IDXGIFactory4* f = NULL;
+    if (SUCCEEDED(CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&f)) && f) {
+        LUID luid; s_tp.dev->lpVtbl->GetAdapterLuid(s_tp.dev, &luid);
+        IDXGIAdapter3* a = NULL;
+        if (SUCCEEDED(f->lpVtbl->EnumAdapterByLuid(f, luid, &IID_IDXGIAdapter3, (void**)&a)) && a) {
+            DXGI_QUERY_VIDEO_MEMORY_INFO mi;
+            if (SUCCEEDED(a->lpVtbl->QueryVideoMemoryInfo(a, 0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &mi)))
+                b = mi.Budget / 100u * 35u;
+            a->lpVtbl->Release(a);
+        }
+        f->lpVtbl->Release(f);
+    }
+    return b < (512ull << 20) ? (512ull << 20) : b;
+}
