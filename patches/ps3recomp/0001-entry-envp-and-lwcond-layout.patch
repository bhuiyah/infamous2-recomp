+static void backend_opt_install(void)
+{
+    static const char* const keys[] = { "vsync", "anisotropy", "brightness", "fullscreen", "window", "monitor",
+                                        "texture_packs", "texture_dump", "aa", "sharpen" };
+    psync_latch();
+    aniso_latch();
+    brightness_latch();
+    pfx_latch();
+    for (unsigned i = 0; i < sizeof keys / sizeof keys[0]; i++) {
+        const opt_id id = opt_find(keys[i]);
+        if (id >= 0) opt_watch(id, backend_opt_changed, NULL, OPT_ON_RENDER);
+    }
+    { const opt_id id = opt_find("vrr"); if (id >= 0) opt_watch(id, vrr_changed, NULL, OPT_ON_SETTER); }
+}
