+static void report(void)
+{
+    char b[96];
+    const ss_cap_thr* last = 0;
+    for (int i = 0; i < s_cap.nthr; i++) if ((int)s_cap.thr[i].tid == s_cap.last_tid) last = &s_cap.thr[i];
+    if (last) fmt_at(b, sizeof b, last->at, last->num, last->obj); else strcpy(b, "-");
+    const ss_walker_info* w = &s_cap.w1;
+    char wk[96];
+    if (!s_host.walker_info) strcpy(wk, "n/a");
+    else snprintf(wk, sizeof wk, "%s get=0x%X put=0x%X%s%s refq=%u pend=%u",
+                  w->get == w->put ? "idle" : (w->park_off != 0xFFFFFFFFu ? "park" :
+                                               (w->acq_pos != 0xFFFFFFFFu ? "acquire" : "busy")),
+                  w->get, w->put, w->park_off != 0xFFFFFFFFu ? " parked-at-selfjump" : "",
+                  w->acq_pos != 0xFFFFFFFFu ? " at-acquire" : "", w->ref_q, w->pending);
+    char sb[40] = "";
+    if (s_cap.strict_n) snprintf(sb, sizeof sb, " strict=%d/%d", s_cap.strict_ok, s_cap.strict_n);
+    fprintf(stderr, "[ss] census #%u t=%.1fs %s%s%s ppu=%.1fms %d/%d parked (tier1 %d, tier2 %d; last tid=%d '%s' at %s)"
+                    " walker=%s %.1fms/%d pass(es) spu=%s%d/%d %.2fms foreign=%ld stop=%.1fms mixer=%s audioq=%d/%d%s\n",
+            s_cap.attempt, s_cap.t_s, s_cap.ok ? "OK" : "FAIL", s_cap.ok ? "" : " ",
+            s_cap.ok ? "" : s_cap.why, s_cap.ppu_ms, s_cap.parked, s_cap.total, s_cap.tier1, s_cap.tier2,
+            s_cap.last_tid, last ? last->name : "-", b, wk, s_cap.walker_ms, s_cap.walker_passes,
+            s_cap.spu_on ? "" : "off ", s_cap.spu_parked, s_cap.nspu, s_cap.spu_ms, s_cap.spu_foreign, s_cap.stop_ms,
+            !s_cap.mix_live ? "none" : (s_cap.mix_parked ? "parked" : "LATE"),
+            s_cap.mix_fill, s_cap.mix_cap, sb);
+    /* stragglers (PPU) */
+    for (int i = 0; i < s_cap.nthr; i++) {
+        const ss_cap_thr* c = &s_cap.thr[i];
+        if (c->parked) {
+            if (s_cfg.verbose) {
+                fmt_at(b, sizeof b, c->at, c->num, c->obj);
+                fprintf(stderr, "[ss]   tid=%u '%s' tier%d %s %.1fms cb=%d br=%d frames=%d\n",
+                        c->tid, c->name, c->tier, b, c->ms, c->cb, c->br, c->nf);
+            }
+            continue;
+        }
+        char v[96] = "never reached a safepoint during the stop";
+        if (c->visits) {
+            fmt_at(b, sizeof b, c->visit_at, c->visit_num, 0);
+            snprintf(v, sizeof v, "%u safepoint visit(s), last %s %.1fms ago lr=0x%08X refused=%s",
+                     c->visits, b, c->visit_ago_ms, c->visit_lr, k_refuse[c->visit_refuse]);
+        }
+        char hb[160] = "";
+        int p = 0;
+        for (int k = 0; k < c->nhost && p < 140; k++)
+            p += snprintf(hb + p, sizeof hb - p, " func_%08X", c->hostbt[k]);
+        fprintf(stderr, "[ss]   STRAGGLER tid=%u '%s' in sc=%u hle=%s prof_pc=0x%08X cia=0x%08X lr=0x%08X;"
+                        " %s; host:%s%s\n",
+                c->tid, c->name, c->sc_inflight, c->hle_inflight ? c->hle_inflight : "-",
+                c->prof_pc, c->tcia, c->tlr, v, c->host_rip_lifted ? " (in lifted code)" : "",
+                c->nhost ? hb : " (no lifted frame)");
+    }
+    /* SPU */
+    for (int k = 0; k < s_cap.nspu; k++) {
+        if (s_cap.spu[k].parked && !s_cfg.verbose) continue;
+        const ss_spu_desc* d = &s_cap.spu[k].d;
+        fprintf(stderr, "[ss]   spu tid=0x%X group=0x%X %s %s%s %.2fms pc=0x%05X img=%u depth=%u irq=%d resv=%d irq-skips=%u\n",
+                s_cap.spu[k].tid, s_cap.spu[k].group, s_cap.spu[k].parked ? "parked" : "NOT PARKED",
+                s_cap.spu[k].parked ? spu_where_name(s_cap.spu[k].where) : "-",
+                s_cap.spu[k].foreign ? " (foreign ctx)" : "", s_cap.spu[k].ms,
+                d->pc, d->image_id, d->host_depth, d->irq_saved, d->resv_valid, s_cap.spu[k].irq_skips);
+    }
+    if (s_cap.spu_on && s_cfg.spu_expect && s_cap.nspu != s_cfg.spu_expect) {
+        static int last_n = -1;
+        if (last_n != s_cap.nspu) {
+            last_n = s_cap.nspu;
+            fprintf(stderr, "[ss] M0 CHECK: %d SPU host thread(s) registered, expected %d (SS_SPU_EXPECT)\n",
+                    s_cap.nspu, s_cfg.spu_expect);
+        }
+    }
+    if (s_cap.spu_foreign && s_cap.spu_foreign_ctx) {
+        /* once per distinct context */
+        static const void* seen[16];
+        static int nseen;
+        int known = 0;
+        for (int i = 0; i < nseen; i++) if (seen[i] == s_cap.spu_foreign_ctx) known = 1;
+        if (!known) {
+            if (nseen < 16) seen[nseen++] = s_cap.spu_foreign_ctx;
+            fprintf(stderr, "[ss] M0 CHECK: SPU code ran on a context that is not a registered SPU"
+                            " thread's while SPUs were parking (ctx=%p pc=0x%05X img=%u; %ld park"
+                            " point(s) this stop) -- an extra SPU context is live (policy module,"
+                            " async job, raw SPU?)\n",
+                    s_cap.spu_foreign_ctx, s_cap.spu_foreign_pc, s_cap.spu_foreign_img, s_cap.spu_foreign);
+        }
+    }
+    if (s_cap.unreg_visits) {
+        static long last_u = 0;
+        if (s_cap.unreg_visits != last_u) {
+            last_u = s_cap.unreg_visits;
+            fprintf(stderr, "[ss] note: %ld safepoint visit(s) from contexts with no guest thread id"
+                            " (host-thread callbacks) -- never parked\n", s_cap.unreg_visits);
+        }
+    }
+    ss_stats st;
+    ss_get_stats(&st);
+    char ss[48] = "";
+    if (s_sr_ops.walk) snprintf(ss, sizeof ss, "; strict-pass stops=%u", st.strict_stops);
+    fprintf(stderr, "[ss] summary: attempts=%u ok=%u (%.1f%%) within500=%u (%.1f%%) fail: ppu=%u spu=%u;"
+                    " mixer-late=%u; ppu ms p50=%.1f p95=%.1f max=%.1f; stop ms p50=%.1f p95=%.1f max=%.1f%s\n",
+            st.attempts, st.ok, st.attempts ? 100.0 * st.ok / st.attempts : 0.0,
+            st.within_500, st.attempts ? 100.0 * st.within_500 / st.attempts : 0.0,
+            st.fail_ppu, st.fail_spu, st.mixer_late, st.ppu_p50, st.ppu_p95, st.ppu_max,
+            st.stop_p50, st.stop_p95, st.stop_max, ss);
+    fflush(stderr);
+}
+
+/* Where the chains text of a stop goes: the SS_CHAINS file (a census), or a
+ * save's CHNS section (the same text, written into the image). */
+typedef struct chains_out { FILE* f; ss_writer* w; } chains_out;
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((format(printf, 2, 3)))
+#endif
+static void ch_printf(chains_out* o, const char* fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    if (o->f) vfprintf(o->f, fmt, ap);
+    else ss_text_vprintf(o->w, fmt, ap);
+    va_end(ap);
+}
+
+/* One stop's block: its census line, every thread (parked: its chain and
+ * strict walk; not parked: a straggler line), every SPU, "end census". */
+static void chains_emit(chains_out* o)
+{
+    char b[96], fn[48];
+    ch_printf(o, "census %u t=%.3f status=%s%s%s ppu_ms=%.2f spu_ms=%.3f walker_ms=%.2f stop_ms=%.2f"
+                 " threads=%d parked=%d tier1=%d tier2=%d spu=%d/%d audioq=%d/%d",
+              s_cap.attempt, s_cap.t_s, s_cap.ok ? "ok" : "fail", s_cap.ok ? "" : ":", s_cap.ok ? "" : s_cap.why,
+              s_cap.ppu_ms, s_cap.spu_ms, s_cap.walker_ms, s_cap.stop_ms, s_cap.total, s_cap.parked,
+              s_cap.tier1, s_cap.tier2, s_cap.spu_parked, s_cap.nspu, s_cap.mix_fill, s_cap.mix_cap);
+    if (s_cap.strict_n) ch_printf(o, " strict=%d/%d", s_cap.strict_ok, s_cap.strict_n);
+    ch_printf(o, "\n");
+    for (int i = 0; i < s_cap.nthr; i++) {
+        const ss_cap_thr* c = &s_cap.thr[i];
+        if (!c->parked) {
+            ch_printf(o, "straggler tid=%u name=\"%s\" sc=%u hle=%s prof_pc=0x%08X visits=%u refused=%s host=",
+                      c->tid, c->name, c->sc_inflight, c->hle_inflight ? c->hle_inflight : "-", c->prof_pc,
+                      c->visits, k_refuse[c->visit_refuse]);
+            for (int k = 0; k < c->nhost; k++) ch_printf(o, "%sfunc_%08X", k ? "," : "", c->hostbt[k]);
+            ch_printf(o, "\n");
+            continue;
+        }
+        fmt_at(b, sizeof b, c->at, c->num, c->obj);
+        ch_printf(o, "thread tid=%u name=\"%s\" tier=%d at=%s ms=%.2f cb=%d br=%d icall=%d vcall=%d"
+                     " r1=0x%08X r2=0x%08X lr=0x%08X sc_ra=0x%08X\n",
+                  c->tid, c->name, c->tier, b, c->ms, c->cb, c->br, c->icall, c->vcall,
+                  c->r1, c->r2, c->lr, c->sc_ra);
+        for (int k = 0; k < c->br && k < SS_BRIDGE_MAX; k++)
+            ch_printf(o, "  bridge %d nid=0x%08X caller_r1=0x%08X slice_r1=0x%08X caller_r2=0x%08X\n",
+                      k, c->brr[k].nid, c->brr[k].caller_r1, c->brr[k].slice_r1, c->brr[k].caller_r2);
+        fmt_fn(fn, sizeof fn, c->ra0);
+        ch_printf(o, "  ra0 ra=0x%08X %s link=%s\n", c->ra0, fn, link_kind(c->ra0_word));
+        for (int k = 0; k < c->nf; k++) {
+            const ss_frame* fr = &c->f[k];
+            fmt_fn(fn, sizeof fn, fr->ra);
+            const uint32_t tgt = call_target(fr->ra, fr->word);
+            if (tgt)
+                ch_printf(o, "  frame %d sp=0x%08X ra=0x%08X %s link=%s calls=0x%08X\n",
+                          k, fr->sp, fr->ra, fn, link_kind(fr->word), tgt);
+            else
+                ch_printf(o, "  frame %d sp=0x%08X ra=0x%08X %s link=%s\n",
+                          k, fr->sp, fr->ra, fn, link_kind(fr->word));
+        }
+        ch_printf(o, "  end %s depth=%d\n", c->end, c->nf);
+        if (c->strict_on) {
+            /* "  strict <verdict>": the walk a save would run (ss_sr_ops.walk).
+             * ok | no-ra | not-covered (missing / unmodelled / partial) |
+             * refused:<ppu_resume error>; missing= lists every return address
+             * of the chain with no continuation (ready for the --cont-list). */
+            const ss_sr_walk_out* w = &c->strict;
+            static const char* const k_end[] = { "none", "lr", "zero-bc", "noreturn" };
+            static const char* const k_nc[] = { "?", "missing", "unmodelled", "partial" };
+            char v[64];
+            if (w->verdict == SS_SR_OK) strcpy(v, "ok");
+            else if (w->verdict == SS_SR_NO_RA) strcpy(v, "no-ra");
+            else if (w->verdict == SS_SR_NOT_COVERED)
+                snprintf(v, sizeof v, "not-covered:%s", k_nc[(unsigned)w->why < 4 ? w->why : 0]);
+            else if (w->verdict >= SS_SR_REFUSED_BASE)
+                snprintf(v, sizeof v, "refused:%s", s_sr_ops.strerror ? s_sr_ops.strerror(w->verdict - SS_SR_REFUSED_BASE) : "?");
+            else snprintf(v, sizeof v, "?%d", w->verdict);
+            ch_printf(o, "  strict %s frames=%d end=%s rec=%d", v, w->frames,
+                      k_end[(unsigned)w->root < 4 ? w->root : 0], c->strict_rec);
+            if (w->verdict != SS_SR_OK && w->err_ra) ch_printf(o, " at=0x%08X", w->err_ra);
+            for (int k = 0; k < w->nmiss && k < SS_SRW_MAXMISS; k++)
+                ch_printf(o, "%s0x%08X", k ? "," : " missing=", w->miss[k]);
+            ch_printf(o, "\n");
+        }
+    }
+    for (int k = 0; k < s_cap.nspu; k++) {
+        const ss_spu_desc* d = &s_cap.spu[k].d;
+        ch_printf(o, "spu tid=0x%X group=0x%X kind=%s %s where=%s ms=%.3f pc=0x%05X img=%u depth=%u status=0x%X"
+                     " irq=%d resv=%d foreign=%d\n",
+                  s_cap.spu[k].tid, s_cap.spu[k].group, s_cap.spu[k].kind == SS_SPU_FALLBACK ? "fallback" : "lifted",
+                  s_cap.spu[k].parked ? "parked" : "not-parked",
+                  s_cap.spu[k].parked ? spu_where_name(s_cap.spu[k].where) : "-", s_cap.spu[k].ms,
+                  d->pc, d->image_id, d->host_depth, d->status, d->irq_saved, d->resv_valid,
+                  s_cap.spu[k].foreign);
+    }
+    ch_printf(o, "end census %u\n", s_cap.attempt);
+}
+
+static void write_chains(void)
+{
+    if (!s_cfg.chains_path[0]) return;
+    /* One file per run: the first census of this process truncates it. */
+    static int s_opened = 0;
+    FILE* f = fopen(s_cfg.chains_path, s_opened ? "a" : "w");
+    if (!f) {
+        static int warned = 0;
+        if (!warned++) fprintf(stderr, "[ss] cannot open %s for writing\n", s_cfg.chains_path);
+        return;
+    }
+    if (!s_opened) {
+        s_opened = 1;
+        fprintf(f, "# ss_chains: save-state census (runtime/savestate/ss_core.c), period %.1f s,"
+                   " tier 1 %u ms, timeout %u ms; summarise with tools/ss_census.py\n",
+                s_cfg.period_s, s_cfg.tier1_ms, s_cfg.timeout_ms);
+    }
+    chains_out o = { f, NULL };
+    chains_emit(&o);
+    fclose(f);
+}
+
+/* ---------------------------------------------------------------------------
+ * Requests, eligibility and reasons (M4a; see ss_core.h)
+ *
+ * One request at a time in s_rq: a submitter (any thread) takes it from FREE
+ * to FILLING with a compare-exchange, copies the request and publishes it
+ * QUEUED; the coordinator takes it ACTIVE, runs its stops and, when done,
+ * sets it FREE before calling done() (so done may submit the next one).
+ * Everything else in s_rq is the coordinator's.
+ * -----------------------------------------------------------------------*/
+static const char* const k_purpose[SS_P__N] = { "?", "census", "save", "load", "hold", "selftest" };
+static const char* purpose_name(int p) { return (p > 0 && p < SS_P__N) ? k_purpose[p] : "?"; }
+
+static const struct { const char* name; const char* text; } k_reason[SS_REASON__N] = {
+    { "ok",            "done" },
+    { "not-yet",       "this part of save states is not built yet" },
+    { "off",           "save states are turned off (SAVESTATES=0)" },
+    { "booting",       "available once the game is running" },
+    { "debug-switch",  "not available with this debug switch set" },
+    { "thread-busy",   "the game is busy" },
+    { "callback",      "the game is busy" },
+    { "game-saving",   "the game is saving its progress, try again in a moment" },
+    { "file-write",    "the game is installing or writing data" },
+    { "transition",    "the game is busy" },
+    { "bridge",        "the game is busy" },
+    { "trampoline",    "the game is busy" },
+    { "not-resumable", "the game is busy" },
+    { "no-root",       "the game is busy" },
+    { "spu-busy",      "the game is busy" },
+    { "spu-extra",     "the game is busy" },
+    { "audio",         "the game is busy" },
+    { "gpu",           "the game is busy" },
+    { "host-guest",    "the game is busy" },
+    { "section",       "the game is busy" },
+    { "capture",       "the state could not be captured" },
+    { "image",         "this save state cannot be loaded (damaged, or made by another build)" },
+    { "writing",       "a save state is still being written, try again in a moment" },
+};
+const char* ss_reason_name(int r) { return (r >= 0 && r < SS_REASON__N) ? k_reason[r].name : "?"; }
+const char* ss_reason_text(int r) { return (r >= 0 && r < SS_REASON__N) ? k_reason[r].text : "the game is busy"; }
+
+/* ---- transitions (the table-busy counters) ------------------------------- */
+static volatile long s_tr[SS_TR__N];
+void ss_transition_begin(int w) { if (w >= 0 && w < SS_TR__N) InterlockedIncrement(&s_tr[w]); }
+void ss_transition_end(int w)
+{
+    if (w < 0 || w >= SS_TR__N) return;
+    for (;;) {                                        /* never below zero: an unpaired end is ignored */
+        const long v = s_tr[w];
+        if (v <= 0 || InterlockedCompareExchange(&s_tr[w], v - 1, v) == v) return;
+    }
+}
+
+/* ---- checks the rest of the runtime adds ---------------------------------- */
+#define SS_CHECK_MAX 8
+static struct { volatile long ready; int reason; ss_check_fn fn; } s_chk[SS_CHECK_MAX];
+static volatile long s_nchk;
+void ss_add_check(int reason, ss_check_fn fn)
+{
+    if (!fn) return;
+    const long i = InterlockedIncrement(&s_nchk) - 1;
+    if (i >= SS_CHECK_MAX) {
+        fprintf(stderr, "[ss] WARNING: more than %d eligibility checks -- one for '%s' is not kept\n",
+                SS_CHECK_MAX, ss_reason_name(reason));
+        return;
+    }
+    s_chk[i].reason = reason;
+    s_chk[i].fn = fn;
+    InterlockedExchange(&s_chk[i].ready, 1);
+}
+
+/* ---- the SPU host waits a strict save accepts ----------------------------- */
+/* Besides a drain hop (an exact pc), an SPU may be parked only in a host wait
+ * the title's SPU study audited as exact or restartable (ss_set_spu_audited;
+ * see ss_core.h). Image ids are per title, so the toolkit's own table is
+ * empty: with no title table only drain hops pass. SS_SPU_AUDITED=img:where:
+ * pc,... (or "none") replaces the table for an experiment. */
+#define SS_AUDIT_MAX 32
+static ss_spu_audit s_audit[SS_AUDIT_MAX];         /* in force */
+static int s_naudit;
+static ss_spu_audit s_audit_title[SS_AUDIT_MAX];   /* the title's (ss_set_spu_audited) */
+static int s_naudit_title;
+
+static int where_from_name(const char* s, size_t n)
+{
+    static const int k[] = { SS_SPU_AT_HOP, SS_SPU_W_CHANNEL, SS_SPU_W_SIGNAL, SS_SPU_W_EQUEUE };
+    for (size_t i = 0; i < sizeof k / sizeof k[0]; i++) {
+        const char* nm = spu_where_name(k[i]);
+        if (strlen(nm) == n && !strncmp(nm, s, n)) return k[i];
+    }
+    return 0;
+}
+
+static void audit_configure(const char* spec)
+{
+    s_naudit = 0;
+    if (!spec || !*spec) {
+        memcpy(s_audit, s_audit_title, sizeof s_audit);
+        s_naudit = s_naudit_title;
+        return;
+    }
+    for (const char* p = spec; *p && s_naudit < SS_AUDIT_MAX;) {   /* "41:ch-wait:0x1178,..." */
+        const size_t n = strcspn(p, ",");
+        char tok[64];
+        if (n && n < sizeof tok) {
+            memcpy(tok, p, n);
+            tok[n] = 0;
+            char* c1 = strchr(tok, ':');
+            char* c2 = c1 ? strchr(c1 + 1, ':') : 0;
+            if (c1 && c2) {
+                const int w = where_from_name(c1 + 1, (size_t)(c2 - c1 - 1));
+                if (w) {
+                    s_audit[s_naudit].image_id = (uint32_t)strtoul(tok, 0, 10);
+                    s_audit[s_naudit].where = w;
+                    s_audit[s_naudit].pc = (uint32_t)strtoul(c2 + 1, 0, 16);
+                    s_naudit++;
+                }
+            }
+        }
+        p += n;
+        if (*p == ',') p++;
+    }
+}
+
+void ss_set_spu_audited(const ss_spu_audit* rows, int n)
+{
+    if (n < 0 || !rows) n = 0;
+    if (n > SS_AUDIT_MAX) n = SS_AUDIT_MAX;
+    memcpy(s_audit_title, rows, (size_t)n * sizeof *rows);
+    s_naudit_title = n;
+    audit_configure(s_cfg.spu_audited);               /* (an SS_SPU_AUDITED override stays) */
+    if (g_ss_armed) {
+        fprintf(stderr, "[ss] strict saves accept %d audited SPU host wait(s) besides drain hops%s\n",
+                s_naudit, s_cfg.spu_audited[0] ? " (SS_SPU_AUDITED)" : " (the title's table)");
+        fflush(stderr);
+    }
+}
+
+static int spu_audited(const ss_spu_desc* d, int where)
+{
+    for (int i = 0; i < s_naudit; i++)
+        if (s_audit[i].image_id == d->image_id && s_audit[i].where == where && s_audit[i].pc == d->pc)
+            return 1;
+    return 0;
+}
+
+/* ---- the request slot ----------------------------------------------------- */
+enum { RQ_FREE = 0, RQ_FILLING, RQ_QUEUED, RQ_ACTIVE };
+static struct {
+    volatile long state;
+    ss_request    r;
+    unsigned      seq, attempts;
+    double        stopped_ms;                /* the stops' total length */
+    uint64_t      t_submit, t_take;
+    int           reason;                    /* the last stop's (or pre-check's) first blocker */
+    int           pre_reason;                /* the pre-check's last blocker (logged when it changes) */
+    char          detail[96], why[192];
+    int           s3[SS_W__COUNT], s1, s2;   /* the eligible stop's parks by kind */
+    int           validated;                 /* a LOAD's image passed its checks (once per request) */
+} s_rq;
+
+/* The fidelity check after this request's restore: SS_VERIFY=1 always, =0
+ * never; by default a selftest's, or a request that asks (SS_RQ_VERIFY). */
+static int rq_verify(void)
+{
+    if (s_cfg.verify == 0) return 0;
+    if (s_cfg.verify == 1) return 1;
+    return (s_rq.r.flags & SS_RQ_VERIFY) || s_rq.r.purpose == SS_P_SELFTEST;
+}
+static volatile long     s_rq_seq;
+static ss_request_result s_last;
+static struct { ss_request_stats p[SS_P__N]; } s_rqs;   /* [0]: unused (ss_get_request_stats sums) */
+/* The pause of every captured SAVE's eligible stop (its percentiles). */
+#define SS_PAUSE_HIST 256
+static float    s_pause[SS_PAUSE_HIST];
+static unsigned s_npause;
+
+int ss_request_submit(const ss_request* r)
+{
+    if (!r || r->purpose < SS_P_CENSUS || r->purpose >= SS_P__N) return SS_R_INVALID;
+    if (!g_ss_armed) return SS_R_OFF;
+    if (InterlockedCompareExchange(&s_rq.state, RQ_FILLING, RQ_FREE) != RQ_FREE) return SS_R_BUSY;
+    s_rq.r = *r;
+    if (!(s_rq.r.give_up_s > 0)) s_rq.r.give_up_s = 3.0;
+    s_rq.attempts = 0;                                /* (the slot is the submitter's until QUEUED) */
+    s_rq.stopped_ms = 0;
+    s_rq.validated = 0;
+    s_rq.reason = s_rq.pre_reason = SS_REASON_OK;
+    s_rq.detail[0] = 0;
+    s_rq.why[0] = 0;
+    s_rq.seq = (unsigned)InterlockedIncrement(&s_rq_seq);
+    s_rq.t_submit = ss_now_us();
+    InterlockedExchange(&s_rq.state, RQ_QUEUED);
+    wake_coordinator();
+    return SS_R_QUEUED;
+}
+
+int ss_busy(void) { return s_rq.state != RQ_FREE; }
+
+void ss_last_request(ss_request_result* out) { if (out) *out = s_last; }
+
+void ss_get_request_stats(int purpose, ss_request_stats* o)
+{
+    memset(o, 0, sizeof *o);
+    for (int p = 1; p < SS_P__N; p++) {
+        if (purpose && p != purpose) continue;
+        const ss_request_stats* s = &s_rqs.p[p];
+        o->done += s->done; o->ok += s->ok; o->not_yet += s->not_yet; o->refused += s->refused;
+        o->attempts += s->attempts;
+        for (int k = 0; k < SS_REASON__N; k++) o->by_reason[k] += s->by_reason[k];
+        if (s->eligible_ms_max > o->eligible_ms_max) o->eligible_ms_max = s->eligible_ms_max;
+        o->captured += s->captured;
+    }
+    if (purpose == 0 || purpose == SS_P_SAVE) {
+        const unsigned n = s_npause < SS_PAUSE_HIST ? s_npause : SS_PAUSE_HIST;
+        o->pause_p50 = pct(s_pause, n, 0.5);
+        o->pause_p95 = pct(s_pause, n, 0.95);
+        o->pause_max = pct(s_pause, n, 1.0);
+    }
+}
+
+void ss_request_summary(const char* when)
+{
+    char b[900];
+    int p = 0;
+    b[0] = 0;
+    for (int k = 1; k < SS_P__N && p < (int)sizeof b - 120; k++) {
+        const ss_request_stats* s = &s_rqs.p[k];
+        if (!s->done) continue;
+        p += snprintf(b + p, sizeof b - p, "%s%s %u (ok %u", p ? "; " : "", purpose_name(k), s->done, s->ok);
+        if (s->not_yet) p += snprintf(b + p, sizeof b - p, ", not-yet %u", s->not_yet);
+        if (s->refused) {
+            p += snprintf(b + p, sizeof b - p, ", refused %u:", s->refused);
+            for (int r = 0; r < SS_REASON__N && p < (int)sizeof b - 60; r++)
+                if (s->by_reason[r]) p += snprintf(b + p, sizeof b - p, " %s x%u", ss_reason_name(r), s->by_reason[r]);
+        }
+        p += snprintf(b + p, sizeof b - p, ", %u stop(s)", s->attempts);
+        if (s->eligible_ms_max > 0 && k != SS_P_CENSUS)
+            p += snprintf(b + p, sizeof b - p, ", eligible within %.0f ms", s->eligible_ms_max);
+        if (k == SS_P_SAVE && s->captured) {
+            ss_request_stats t;
+            ss_get_request_stats(SS_P_SAVE, &t);
+            p += snprintf(b + p, sizeof b - p, ", %u captured, pause ms p50=%.1f p95=%.1f max=%.1f",
+                          s->captured, t.pause_p50, t.pause_p95, t.pause_max);
+        }
+        p += snprintf(b + p, sizeof b - p, ")");
+    }
+    if (!p) return;
+    fprintf(stderr, "[ss] requests %s: %s\n", when ? when : "", b);
+    fflush(stderr);
+}
+
+static void rq_atexit(void) { ss_request_summary("exit"); }
+
+static int blocked(int reason, const char* detail, const char* fmt, ...)
+{
+    s_rq.reason = reason;
+    snprintf(s_rq.detail, sizeof s_rq.detail, "%s", detail ? detail : "");
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(s_rq.why, sizeof s_rq.why, fmt, ap);
+    va_end(ap);
+    return reason;
+}
+
+static void strict_verdict(const ss_sr_walk_out* w, char* v, size_t n)
+{
+    static const char* const k_nc[] = { "?", "missing", "unmodelled", "partial" };
+    if (w->verdict == SS_SR_OK) snprintf(v, n, "ok");
+    else if (w->verdict == SS_SR_NO_RA) snprintf(v, n, "no-ra");
+    else if (w->verdict == SS_SR_NOT_COVERED)
+        snprintf(v, n, "not-covered:%s", k_nc[(unsigned)w->why < 4 ? w->why : 0]);
+    else if (w->verdict >= SS_SR_REFUSED_BASE)
+        snprintf(v, n, "refused:%s", s_sr_ops.strerror ? s_sr_ops.strerror(w->verdict - SS_SR_REFUSED_BASE) : "?");
+    else snprintf(v, n, "?%d", w->verdict);
+}
+
+/* What every stop waits for, converged or not: the game's state rather than
+ * one thread's park -- and the better reason when a stop times out (a thread
+ * stuck in the game's own save is "saving", not "busy"). */
+static int world_check(void)
+{
+    if (s_debug_switch) return blocked(SS_REASON_DEBUG_SWITCH, s_debug_switch, "%s is set", s_debug_switch);
+    if (co.last_flip == 0) return blocked(SS_REASON_BOOTING, "", "no flip yet");
+    const long n = s_nchk < SS_CHECK_MAX ? s_nchk : SS_CHECK_MAX;
+    for (long i = 0; i < n; i++) {
+        if (!s_chk[i].ready) continue;
+        char w[96];
+        w[0] = 0;
+        if (s_chk[i].fn(w, sizeof w)) return blocked(s_chk[i].reason, w, "%s", w);
+    }
+    if (s_tr[SS_TR_PPU_THREAD] > 0)
+        return blocked(SS_REASON_TRANSITION, "a thread starting or exiting",
+                       "%ld PPU thread(s) being created or exiting", s_tr[SS_TR_PPU_THREAD]);
+    if (s_tr[SS_TR_SPU_THREAD] > 0)
+        return blocked(SS_REASON_TRANSITION, "an SPU thread starting or ending",
+                       "%ld SPU host thread(s) starting or ending", s_tr[SS_TR_SPU_THREAD]);
+    return SS_REASON_OK;
+}
+
+/* A converged stop, everything still parked: may it be saved (strict) or
+ * discarded by a load (lenient)? Returns the first blocking reason. */
+static int eligibility(int strict, int spu_ok)
+{
+    const int w = world_check();
+    if (w) return w;
+    memset(s_rq.s3, 0, sizeof s_rq.s3);
+    s_rq.s1 = s_rq.s2 = 0;
+    for (int i = 0; i < s_cap.nthr; i++) {
+        const ss_cap_thr* c = &s_cap.thr[i];
+        char at[64];
+        if (!c->parked) return blocked(SS_REASON_THREAD_BUSY, c->name, "tid=%u '%s' did not park", c->tid, c->name);
+        fmt_at(at, sizeof at, c->at, c->num, c->obj);
+        if (c->cb > 0)
+            return blocked(SS_REASON_CALLBACK, c->name, "tid=%u '%s' %s inside a guest callback", c->tid, c->name, at);
+        if (c->at == SS_IN_WAIT && c->num < SS_W__COUNT) s_rq.s3[c->num]++;   /* recorded: the M4c resumers */
+        else if (c->at == SS_AT_SC) s_rq.s1++;
+        else s_rq.s2++;
+        if (!strict) continue;                        /* a load discards a park wherever it is */
+        if (c->br > 0)
+            return blocked(SS_REASON_BRIDGE, c->name, "tid=%u '%s' %s inside a libsre bridge (nid 0x%08X)",
+                           c->tid, c->name, at, c->brr[0].nid);
+        if (c->tramp)
+            return blocked(SS_REASON_TRAMPOLINE, c->name, "tid=%u '%s' %s with a trampoline pending", c->tid, c->name, at);
+        if (!c->strict_on)
+            return blocked(SS_REASON_NOT_RESUMABLE, c->name, "tid=%u '%s': this build has no strict walk"
+                           " (runtime/ppu/ppu_selfresume.cpp)", c->tid, c->name);
+        if (!c->strict_rec)
+            return blocked(SS_REASON_NO_ROOT, c->name, "tid=%u '%s' %s has no root record", c->tid, c->name, at);
+        if (c->strict.verdict != SS_SR_OK) {
+            char v[64];
+            strict_verdict(&c->strict, v, sizeof v);
+            return blocked(SS_REASON_NOT_RESUMABLE, c->name, "tid=%u '%s' %s: strict %s at=0x%08X",
+                           c->tid, c->name, at, v, c->strict.err_ra);
+        }
+    }
+    int nreg = 0;
+    for (int i = 0; i < SS_SPU_MAX; i++) if (s_spu[i].used == 1) nreg++;
+    if (!s_cfg.spu && nreg)
+        return blocked(SS_REASON_SPU_BUSY, "SPU", "%d SPU host thread(s) left running (SS_SPU=0)", nreg);
+    if (s_cap.spu_foreign)
+        return blocked(SS_REASON_SPU_EXTRA, "SPU", "%ld park point(s) on an SPU context no registered thread"
+                       " owns (ctx=%p pc=0x%05X img=%u)", s_cap.spu_foreign, s_cap.spu_foreign_ctx,
+                       s_cap.spu_foreign_pc, s_cap.spu_foreign_img);
+    for (int k = 0; k < s_cap.nspu; k++) {
+        const ss_spu_desc* d = &s_cap.spu[k].d;
+        char who[24];
+        snprintf(who, sizeof who, "SPU 0x%X", s_cap.spu[k].tid);
+        if (!s_cap.spu[k].parked)
+            return blocked(SS_REASON_SPU_BUSY, who, "spu tid=0x%X did not park in %u ms (pc=0x%05X img=%u)",
+                           s_cap.spu[k].tid, s_cfg.spu_timeout_ms, d->pc, d->image_id);
+        if (s_cap.spu[k].foreign)
+            return blocked(SS_REASON_SPU_EXTRA, who, "spu tid=0x%X parked running a context not its own",
+                           s_cap.spu[k].tid);
+        if (!strict) continue;
+        if (s_cap.spu[k].kind == SS_SPU_FALLBACK)
+            return blocked(SS_REASON_SPU_EXTRA, who, "spu tid=0x%X is a PPU-fallback SPU thread (its state"
+                           " lives in a host function)", s_cap.spu[k].tid);
+        if (d->irq_saved)
+            return blocked(SS_REASON_SPU_BUSY, who, "spu tid=0x%X: an interrupt handler in flight", s_cap.spu[k].tid);
+        if (s_cap.spu[k].where != SS_SPU_AT_HOP && !spu_audited(d, s_cap.spu[k].where))
+            return blocked(SS_REASON_SPU_BUSY, who, "spu tid=0x%X parked at an unaudited host wait %s"
+                           " pc=0x%05X img=%u", s_cap.spu[k].tid, spu_where_name(s_cap.spu[k].where),
+                           d->pc, d->image_id);
+    }
+    if (!spu_ok)
+        return blocked(SS_REASON_SPU_BUSY, "SPU", "the SPUs did not all park in %u ms", s_cfg.spu_timeout_ms);
+    if (s_cap.mix_live && !s_cap.mix_parked)
+        return blocked(SS_REASON_AUDIO, "audio", "the cellAudio mixer did not park in %u ms", s_cfg.mixer_timeout_ms);
+    if (strict && s_host.walker_info) {
+        const ss_walker_info* wk = &s_cap.w1;
+        const int at_rest = wk->get == wk->put || wk->park_off != 0xFFFFFFFFu || wk->acq_pos != 0xFFFFFFFFu;
+        if (!at_rest || wk->pumping)
+            return blocked(SS_REASON_GPU, "graphics", "the RSX walker is %s (get=0x%X put=0x%X)",
+                           wk->pumping ? "being pumped" : "busy", wk->get, wk->put);
+    }
+    if (s_cap.unreg_visits)
+        return blocked(SS_REASON_HOST_GUEST, "a host callback", "%ld safepoint visit(s) from contexts with no"
+                       " guest thread id", s_cap.unreg_visits);
+    s_rq.reason = SS_REASON_OK;
+    s_rq.detail[0] = 0;
+    s_rq.why[0] = 0;
+    return SS_REASON_OK;
+}
+
+/* A stop that timed out: the game's state first, then the first straggler. */
+static int abort_reason(void)
+{
+    const int w = world_check();
+    if (w) return w;
+    for (int i = 0; i < s_cap.nthr; i++) {
+        const ss_cap_thr* c = &s_cap.thr[i];
+        if (c->parked) continue;
+        const int ref = c->visits ? c->visit_refuse : REFUSE_NONE;
+        const int r = ref == REFUSE_CB ? SS_REASON_CALLBACK : ref == REFUSE_BRIDGE ? SS_REASON_BRIDGE :
+                      ref == REFUSE_TRAMP ? SS_REASON_TRAMPOLINE : SS_REASON_THREAD_BUSY;
+        return blocked(r, c->name, "tid=%u '%s' did not park in %u ms (sc=%u hle=%s, %u safepoint visit(s),"
+                       " refused=%s)", c->tid, c->name, s_cfg.timeout_ms, c->sc_inflight,
+                       c->hle_inflight ? c->hle_inflight : "-", c->visits, k_refuse[c->visit_refuse]);
+    }
+    return blocked(SS_REASON_THREAD_BUSY, "", "the stop timed out");
+}
+
+static void parks_text(char* b, size_t n)
+{
+    size_t p = 0;
+    b[0] = 0;
+    for (int k = 1; k < SS_W__COUNT && p + 24 < n; k++)
+        if (s_rq.s3[k]) p += (size_t)snprintf(b + p, n - p, "%s%s %d", p ? ", " : "", ss_wait_name(k), s_rq.s3[k]);
+    if (s_rq.s1 && p + 24 < n) p += (size_t)snprintf(b + p, n - p, "%ssc %d", p ? ", " : "", s_rq.s1);
+    if (s_rq.s2 && p + 24 < n) p += (size_t)snprintf(b + p, n - p, "%shle %d", p ? ", " : "", s_rq.s2);
+}
+
+/* One line per stop of a request that is not a census (the first three, every
+ * tenth and the eligible one): no "census" tag, so tools/ss_census.py does
+ * not count it, and no STRAGGLER lines for the same reason. */
+static void attempt_line(int reason)
+{
+    const unsigned n = s_rq.attempts;
+    if (!(n <= 3 || n % 10 == 0 || reason == SS_REASON_OK || s_cfg.verbose)) return;
+    const int strict = s_cap.purpose != SS_P_LOAD;
+    char v[400];
+    if (reason == SS_REASON_OK) {
+        char pk[200];
+        parks_text(pk, sizeof pk);
+        snprintf(v, sizeof v, "eligible (%s); parks: %s", strict ? "strict" : "lenient", pk);
+    } else {
+        snprintf(v, sizeof v, "refused: %s (%s)%s%s", ss_reason_name(reason), s_rq.detail,
+                 strcmp(s_rq.why, s_rq.detail) ? " " : "", strcmp(s_rq.why, s_rq.detail) ? s_rq.why : "");
+    }
+    fprintf(stderr, "[ss] %s #%u t=%.1fs attempt %u: %s%s ppu=%.1fms %d/%d parked spu=%d/%d stop=%.1fms -> %s\n",
+            purpose_name(s_cap.purpose), s_cap.attempt, s_cap.t_s, n, s_cap.ok ? "converged" : "FAIL ",
+            s_cap.ok ? "" : s_cap.why, s_cap.ppu_ms, s_cap.parked, s_cap.total, s_cap.spu_parked, s_cap.nspu,
+            s_cap.stop_ms, v);
+    for (int i = 0; i < s_cap.nthr && !s_cap.ok; i++) {
+        const ss_cap_thr* c = &s_cap.thr[i];
+        if (c->parked) continue;
+        char hb[160] = "";
+        int p = 0;
+        for (int k = 0; k < c->nhost && p < 140; k++) p += snprintf(hb + p, sizeof hb - p, " func_%08X", c->hostbt[k]);
+        fprintf(stderr, "[ss]   %s straggler tid=%u '%s' sc=%u hle=%s prof_pc=0x%08X visits=%u refused=%s host:%s\n",
+                purpose_name(s_cap.purpose), c->tid, c->name, c->sc_inflight,
+                c->hle_inflight ? c->hle_inflight : "-", c->prof_pc, c->visits, k_refuse[c->visit_refuse],
+                c->nhost ? hb : " (no lifted frame)");
+    }
+    fflush(stderr);
+}
+
+/* ---- the capture (M4b; ss_state.h) ----------------------------------------- */
+#define SS_MB 1048576.0
+
+/* Play time: wall time since the first flip, every stop taken out (the one
+ * in progress too). */
+static uint64_t play_ms(uint64_t now)
+{
+    if (!co.t_first_flip || now <= co.t_first_flip) return 0;
+    const uint64_t run = now - co.t_first_flip;
+    const uint64_t stopped = co.stopped_us + (co.st != CO_IDLE && now > co.t_attempt ? now - co.t_attempt : 0);
+    return run > stopped ? (run - stopped) / 1000ull : 0;
+}
+
+/* CHNS: the stop's chains text, as the census writes it -- in the image for
+ * tools/ss_inspect.py, and for the refusal messages of a load (M4c). */
+static int chns_capture(ss_writer* w)
+{
+    ss_text_begin(w, "chains");
+    chains_out o = { NULL, w };
+    chains_emit(&o);
+    ss_text_end(w);
+    return ss_writer_error(w);
+}
+static const ss_section_ops k_chns_ops = {
+    SS_FOURCC('C', 'H', 'N', 'S'), 1, SS_SEC_OPTIONAL | SS_SEC_INFO | SS_SEC_NO_VERIFY, SS_ORDER_INFO + 10,
+    NULL, chns_capture, NULL, NULL, NULL,
+    "census chains", NULL, NULL, NULL,
+};
+SS_SECTION_REGISTER(k_chns_ops)
+
+/* KNDS: the numbering of the values other sections save raw -- a park's `at`
+ * and wait kind (PPUT), an SPU's park point (SPUC). Field lists hash names and
+ * sizes only, so a renumbered enum passes them and is read as another kind,
+ * after the point of no return. This section saves nothing of note; its
+ * layout hash is these names at their numbers, so a state of a build that
+ * numbers them otherwise is refused before anything stops (M7b: states of
+ * other builds load). OPTIONAL: a state from before it loads unchecked. A new
+ * kind: add it here at its number (the assert below). */
+#define SS_KND(name, v) { name, NULL, (uint32_t)(v), 0u }
+static const ss_field k_knd_at[] = {
+    SS_KND("none", SS_AT_NONE), SS_KND("sc", SS_AT_SC), SS_KND("hle", SS_AT_HLE), SS_KND("wait", SS_IN_WAIT),
+};
+static const ss_field k_knd_wait[] = {
+    SS_KND("none", SS_W_NONE), SS_KND("sem", SS_W_SEM), SS_KND("equeue", SS_W_EQUEUE), SS_KND("eflag", SS_W_EFLAG),
+    SS_KND("join", SS_W_JOIN), SS_KND("usleep", SS_W_USLEEP), SS_KND("sleep", SS_W_SLEEP),
+    SS_KND("spu_join", SS_W_SPU_JOIN), SS_KND("mutex", SS_W_MUTEX), SS_KND("cond", SS_W_COND),
+    SS_KND("lwmutex", SS_W_LWMUTEX), SS_KND("lwcond", SS_W_LWCOND), SS_KND("lwcond_reacq", SS_W_LWCOND_REACQ),
+    SS_KND("spinlock", SS_W_SPINLOCK), SS_KND("net", SS_W_NET), SS_KND("count", SS_W__COUNT),
+};
+_Static_assert(SS_W__COUNT == 15, "a new wait kind: add it to k_knd_wait (KNDS) at its number");
+static const ss_field k_knd_spu[] = {
+    SS_KND("hop", SS_SPU_AT_HOP), SS_KND("ch-wait", SS_SPU_W_CHANNEL), SS_KND("wait-signal", SS_SPU_W_SIGNAL),
+    SS_KND("stop-receive", SS_SPU_W_EQUEUE),
+};
+#undef SS_KND
+static const ss_list k_knd_list_at = SS_LIST("park at", k_knd_at);
+static const ss_list k_knd_list_wait = SS_LIST("wait kinds", k_knd_wait);
+static const ss_list k_knd_list_spu = SS_LIST("spu park points", k_knd_spu);
+static const ss_list* const k_knd_lists[] = { &k_knd_list_at, &k_knd_list_wait, &k_knd_list_spu, NULL };
+static int knd_capture(ss_writer* w)
+{
+    ss_write_u64(w, "wait_kinds", SS_W__COUNT);
+    return ss_writer_error(w);
+}
+static int knd_restore(ss_reader* r) { (void)r; return SS_OK; }   /* (its layout hash is the point) */
+static const ss_section_ops k_knd_ops = {
+    SS_FOURCC('K', 'N', 'D', 'S'), 1, SS_SEC_OPTIONAL | SS_SEC_NO_VERIFY, SS_ORDER_TITLE + 60,
+    NULL, knd_capture, NULL, knd_restore, NULL,
+    "value numbering", k_knd_lists, NULL, NULL, NULL,
+};
+SS_SECTION_REGISTER(k_knd_ops)
+
+/* The stop as eligibility() judged it, still in force: nothing released it
+ * since -- the watchdog, which a parked thread fires, releases everything
+ * (g_ss_req 0, every generation bumped). Read under s_lk, where it does. */
+typedef struct stop_gens { long gen, spu_gen, mix_gen; } stop_gens;
+static int stop_intact(const stop_gens* g)
+{
+    AcquireSRWLockShared(&s_lk);
+    const int ok = g_ss_req != 0 && s_gen == g->gen && s_spu_gen == g->spu_gen && s_mix_gen == g->mix_gen;
+    ReleaseSRWLockShared(&s_lk);
+    return ok;
+}
+
+/* An eligible SAVE, everything still parked: the GPU made idle (so the
+ * sections' checks see every GPU result delivered -- a pending report is
+ * not a reason to refuse), the sections' own checks, every section captured
+ * into the staging buffer. Returns the first blocking reason (the stop is
+ * then refused, and retried). The watchdog allows capture_grace_ms more
+ * meanwhile; if it fired anyway, nothing runs against the released world
+ * (KOBJ's check probes live semaphores) and no image is kept. */
+static int save_capture(void)
+{
+    stop_gens g;
+    g.gen = s_gen; g.spu_gen = s_spu_gen; g.mix_gen = s_mix_gen;
+    InterlockedExchange(&s_co_capturing, 1);          /* until the release (release_ppu_and_mixer) */
+    char why[192], f4[5];
+    uint32_t fc = 0;
+    why[0] = 0;
+    const uint64_t t0 = ss_now_us();
+    const int idle = s_host.gpu_idle ? s_host.gpu_idle() : 0;
+    s_cap.gpu_ms = (double)(ss_now_us() - t0) / 1000.0;
+    if (!stop_intact(&g))
+        return blocked(SS_REASON_CAPTURE, "watchdog", "the stop's watchdog released every thread during the"
+                       " GPU flush (%.0f ms): nothing checked or captured", s_cap.gpu_ms);
+    if (idle < 0)
+        return blocked(SS_REASON_GPU, "GPU", "the GPU did not go idle (its fence wait gave up after %.0f ms)",
+                       s_cap.gpu_ms);
+    /* Guest time stands still from here to the release (the one guest
+     * clock, design 6.4): the capture's instant is the snapshot's, and the
+     * game sees no jump when it goes on. */
+    ss_time_freeze();
+    int r = ss_state_check(why, sizeof why, &fc);
+    if (r) {
+        const ss_section_ops* o = ss_section_find(fc);
+        return blocked(r > 0 && r < SS_REASON__N ? r : SS_REASON_SECTION,
+                       o && o->name ? o->name : ss_fourcc_str(fc, f4), "section %s: %s",
+                       ss_fourcc_str(fc, f4), why[0] ? why : "not now");
+    }
+    const uint64_t t1 = ss_now_us();
+    /* the chains' census line: a converged stop, its length so far */
+    s_cap.ok = 1;
+    s_cap.why = "";
+    s_cap.stop_ms = (double)(t1 - co.t_attempt) / 1000.0;
+    ss_capture_info ci;
+    memset(&ci, 0, sizeof ci);
+    ci.seq = s_rq.seq;
+    ci.purpose = s_cap.purpose;
+    ci.flip_count = co.last_flip;
+    ci.play_ms = play_ms(t1);
+    ci.t_s = (double)(t1 - co.t_init) / 1e6;
+    r = ss_state_capture(&ci, why, sizeof why, &fc);
+    s_cap.capture_ms = (double)(ss_now_us() - t1) / 1000.0;
+    if (r) return blocked(SS_REASON_CAPTURE, fc ? ss_fourcc_str(fc, f4) : "capture", "%s", why);
+    if (!stop_intact(&g))                             /* (the image stays unsealed: ss_image_last() NULL) */
+        return blocked(SS_REASON_CAPTURE, "watchdog", "the stop's watchdog released every thread during the"
+                       " capture (%.0f ms): the image is discarded", s_cap.capture_ms);
+    s_cap.captured = 1;
+    return SS_REASON_OK;
+}
