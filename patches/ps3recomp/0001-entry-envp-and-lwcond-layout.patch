 #include <string.h>
 #include <stdlib.h>
@@ -51,6 +65,116 @@
  * -----------------------------------------------------------------------*/
 
 static char s_save_root[1024] = "./gamedata/dev_hdd0/home/00000001/savedata";
+static int  s_save_root_checked;
+
+/* Save states: an operation in progress (cellSaveData.h, ps3_savedata_busy).
+ * A count, as the list / fixed entries nest the execute they end in. */
+static volatile long s_savedata_busy;
+int ps3_savedata_busy(void) { return __atomic_load_n(&s_savedata_busy, __ATOMIC_ACQUIRE) != 0; }
+static void savedata_busy(int d) { __atomic_add_fetch(&s_savedata_busy, (long)d, __ATOMIC_SEQ_CST); }
+
+/* The savedata directory. PS3_SAVEDATA_DIR replaces it, so a run can be
+ * pointed at a folder of saved checkpoints without touching the player's own
+ * saves. The resolved path is logged once because the default is relative to
+ * the working directory: started from build\, the exe saves into
+ * build\gamedata, not the project's gamedata. */
+static const char* save_root(void)
+{
+    if (!s_save_root_checked) {
+        s_save_root_checked = 1;
+        const char* env = getenv("PS3_SAVEDATA_DIR");
+        if (env && *env) snprintf(s_save_root, sizeof s_save_root, "%s", env);
+        char full[1024];
+#ifdef _WIN32
+        if (!_fullpath(full, s_save_root, sizeof full))
+#else
+        if (!realpath(s_save_root, full))
+#endif
+            snprintf(full, sizeof full, "%s", s_save_root);
+        printf("[cellSaveData] savedata directory: %s%s\n", full,
+               env && *env ? " (PS3_SAVEDATA_DIR)" : "");
+    }
+    return s_save_root;
+}
+
+const char* ps3_savedata_root(void) { return save_root(); }
+
+/* The last operation that completed, for ps3_savedata_last_op. */
+static struct {
+    u32  count;
+    char dir[CELL_SAVEDATA_DIRNAME_SIZE];
+    int  wrote;
+} s_last_op;
+
+static void savedata_note_op(const char* dirName, int wrote)
+{
+    snprintf(s_last_op.dir, sizeof s_last_op.dir, "%s", dirName);
+    s_last_op.wrote = wrote;
+    s_last_op.count++;
+}
+
+u32 ps3_savedata_last_op(char* dirName, int* wrote)
+{
+    if (dirName) memcpy(dirName, s_last_op.dir, sizeof s_last_op.dir);
+    if (wrote) *wrote = s_last_op.wrote;
+    return s_last_op.count;
+}
+
+/* The PARAM.SFO text of the save the title last wrote or loaded -- title,
+ * subtitle, detail -- for ps3_savedata_last_text: what a save-state slot is
+ * described by (engine design 5.5; inFamous 2's subtitle names the mission,
+ * "3. Forward Momentum"). A save state carries it (the MISC section), so a
+ * loaded state keeps its own text until the title saves again. Written by
+ * the one guest thread inside an operation, read by any thread: seq is odd
+ * while it is being written. */
+static struct {
+    volatile long seq;
+    u32  count;
+    int  wrote;
+    char dir[CELL_SAVEDATA_DIRNAME_SIZE];
+    char title[CELL_SAVEDATA_SYSP_TITLE_SIZE];
+    char subTitle[CELL_SAVEDATA_SYSP_SUBTITLE_SIZE];
+    char detail[CELL_SAVEDATA_SYSP_DETAIL_SIZE];
+} s_last_text;
+
+static void savedata_note_text(const char* dirName, const CellSaveDataSystemFileParam* p, int wrote)
+{
+    __atomic_add_fetch(&s_last_text.seq, 1, __ATOMIC_SEQ_CST);
+    snprintf(s_last_text.dir, sizeof s_last_text.dir, "%s", dirName);
+    snprintf(s_last_text.title, sizeof s_last_text.title, "%.*s", (int)sizeof p->title, p->title);
+    snprintf(s_last_text.subTitle, sizeof s_last_text.subTitle, "%.*s", (int)sizeof p->subTitle, p->subTitle);
+    snprintf(s_last_text.detail, sizeof s_last_text.detail, "%.*s", (int)sizeof p->detail, p->detail);
+    s_last_text.wrote = wrote;
+    s_last_text.count++;
+    __atomic_add_fetch(&s_last_text.seq, 1, __ATOMIC_SEQ_CST);
+}
+
+/* Copies of that text (any of the buffers may be NULL); returns how many
+ * operations noted one (0: none yet, and the copies are empty). */
+u32 ps3_savedata_last_text(char* title, size_t title_n, char* subTitle, size_t subTitle_n,
+                           char* detail, size_t detail_n)
+{
+    for (int tries = 0; tries < 1000; tries++) {
+        const long s0 = __atomic_load_n(&s_last_text.seq, __ATOMIC_ACQUIRE);
+        if (s0 & 1) continue;
+        /* bounded reads: a copy torn by a writer is thrown away below */
+        if (title && title_n)
+            snprintf(title, title_n, "%.*s", (int)sizeof s_last_text.title - 1, s_last_text.title);
+        if (subTitle && subTitle_n)
+            snprintf(subTitle, subTitle_n, "%.*s", (int)sizeof s_last_text.subTitle - 1, s_last_text.subTitle);
+        if (detail && detail_n)
+            snprintf(detail, detail_n, "%.*s", (int)sizeof s_last_text.detail - 1, s_last_text.detail);
+        const u32 n = s_last_text.count;
+        if (__atomic_load_n(&s_last_text.seq, __ATOMIC_ACQUIRE) == s0) return n;
+    }
+    return 0;
+}
