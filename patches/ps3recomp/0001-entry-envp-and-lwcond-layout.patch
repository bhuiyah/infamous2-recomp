+/* Save states (M4c): a thread a load resumes from sys_cond_wait. Its waiter
+ * record lived on the host stack the load discarded (a load refuses a stop
+ * with one parked here, and KOBJ's teardown clears the waiter lists), so it
+ * comes back as a spurious wakeup: the guest mutex taken back `depth` times
+ * as this thread, as the wait's own exit does, and CELL_OK. */
+static void ss_resume_cond(ppu_context* ctx, uint32_t obj, const ss_wait_rec* rec)
+{
+    (void)obj;
+    const uint32_t mid = rec->a;
+    if (!mid || mid > SYS_MUTEX_MAX || !g_sys_mutexes[mid - 1].active) {
+        ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)CELL_ESRCH;
+        return;
+    }
+    sys_mutex_info* m = &g_sys_mutexes[mid - 1];
+    const int depth = (int)rec->b;
+    for (int i = 0; i < depth; ++i) guest_lock(m);
+    m->owner_tid = ctx->thread_id;
+    m->lock_count = depth;
+    ctx->gpr[3] = CELL_OK;
+}
