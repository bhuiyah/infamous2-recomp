+    CHECK_EQ(sw_cfg_labels(), 0);
+}
+
+static void test_imu_absent_and_battery(void)
+{
+    PadHostDevice d;
+    fake_reset();
+    fake_flash_default();
+    F.no_imu = 1;
+    dev_init(&d, PADHOST_BUS_USB, 0);
+    F.usb_answers = 1;
+    padhost_drv_switchpro.open(&d);
+    CHECK_EQ(sw_priv(&d)->imu_on, 0);
+    PadHostPortState st;
+    memset(&st, 0, sizeof st);
+    u8 r[64];
+    int sticks[4] = { 2048, 2048, 2000, 2100 }, acc[3] = { 0, 0, 4096 }, gyr[3] = { 0, 0, 0 };
+    mk_full(r, 0, 0, 0, sticks, acc, gyr);
+    padhost_drv_switchpro.parse(&d, r, 64, &st);
+    CHECK_EQ(st.has_motion, 0);
+    CHECK_EQ(st.sensor_x, 512); CHECK_EQ(st.sensor_y, 399);
+
+    CHECK_EQ(sw_battery_pct(0x90), 100);        /* full, charging */
+    CHECK_EQ(sw_battery_pct(0x80), 100);
+    CHECK_EQ(sw_battery_pct(0x60), 75);
+    CHECK_EQ(sw_battery_pct(0x41), 50);
+    CHECK_EQ(sw_battery_pct(0x20), 25);
+    CHECK_EQ(sw_battery_pct(0x0E), 0);
+    CHECK_EQ(sw_battery_pct(0x00), 255);
+
+    /* match */
+    dev_init(&d, PADHOST_BUS_USB, 0);
+    d.pid = 0x2006;
+    CHECK_EQ(padhost_drv_switchpro.match(&d), 0);
+    dev_init(&d, PADHOST_BUS_USB, 0);
+    d.usage_page = 0x0C; d.usage = 0x01;
+    CHECK_EQ(padhost_drv_switchpro.match(&d), 0);
+    dev_init(&d, PADHOST_BUS_BT, 0);
+    d.usage = 4;
+    CHECK_EQ(padhost_drv_switchpro.match(&d), 100);
+}
