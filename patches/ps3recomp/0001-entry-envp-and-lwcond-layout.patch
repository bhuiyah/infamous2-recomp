+    /* deadzone: auto = by kind, XInput 24 %, the rest 8 % */
+    CHECK(padhost_config_set("deadzone", "auto") == 1 && s_cfg.dz_left == PH_DZ_KIND && s_cfg.dz_right == PH_DZ_KIND,
