+/* Units (bit u) whose texture is UN -- SET_TEXTURE_FORMAT bit 0x40, libgcm
+ * CELL_GCM_TEXTURE_UN / PSL1GHT GCM_TEXTURE_FORMAT_UNRM: addressed in texels,
+ * not [0,1] -- for the next BUFFERED decompile: a 2D sample of such a unit
+ * divides the coordinate's xy by the bound texture's size (rsx_unn, from
+ * GetDimensions) before sampling. 0 (the default) emits what it always did.
+ * Cube units are never UN. Set and cleared around the decompile like
+ * rsx_fp_set_tex_modes, and part of the variant key. */
+void rsx_fp_set_tex_unnorm(u32 mask);
+
+/* f[WPOS] (input 0) as NV_fragment_program 3.11.1.1 and SET_SHADER_WINDOW
+ * (0x1D88) define it, for BUFFERED decompiles: a program that reads WPOS gets
+ *     (pos.x + k.x, pos.y * k.y + k.z, pos.z, 1 / pos.w)
+ * from D3D's SV_Position, with k = float4 fp_window, declared in b1 right after
+ * fp_texctl (the caller fills it with rsx_raster_wpos_consts: origin and pixel
+ * centre). An unbuffered decompile gets (pos.xyz, 1 / pos.w). 0 (the default)
+ * = SV_Position as it is, the old HLSL. A setting the caller makes, like
+ * rsx_fp_set_tex_modes: the D3D12 backend sets it from FP_WPOS (default 0 --
+ * no inFamous 2 program reads WPOS, so the rule has no title instruction
+ * behind it, docs/GROUND_TRUTH.md 1.2 rule 2) and fills fp_window; a backend
+ * that does not lay out fp_window never sets it. A program that never reads
+ * WPOS is byte-identical either way. */
+void rsx_fp_set_wpos_window(int on);
+
+/* Shadow filtering for BUFFERED decompiles: how a depth-compare unit that the
+ * program samples ONCE filters its comparisons (rsx_ztexs). A process-wide
+ * setting made once before the first decompile (the D3D12 backend: the
+ * "Shadow filtering" settings row, a restart row), like
+ * rsx_fp_set_wpos_window: it is not part of a shader key. Kernel, bits 0-1:
+ *   RSX_FP_SHADOW_PS3     0  (the default) one 2x2 bilinear PCF per tap, the
+ *                            RSX's -- the HLSL is exactly what it was
+ *   RSX_FP_SHADOW_SOFT    1  a tent of 1-texel radius over the texel squares
+ *                            (the quadratic B-spline): 3x3 texels per tap
+ *   RSX_FP_SHADOW_SOFTER  2  a tent of 2-texel radius over the texel squares:
+ *                            5x5 texels per tap
+ * Radii are in texels of the bound map (GetDimensions), so they hold at any
+ * shadow-map size. Flags (diagnostics / A/B; the defaults are 0):
+ *   RSX_FP_SHADOW_POISSON  with SOFTER: 12 bilinear PCF taps of a Poisson disc
+ *                          of 2-texel radius, rotated per pixel, instead
+ *   RSX_FP_SHADOW_PLANE    a receiver-plane depth bias (below)
+ *   RSX_FP_SHADOW_PLANE_LOWER  the same, but the plane only ever LOWERS a
+ *                          texel's reference (toward lit), never raises it
+ * Receiver-plane depth bias (A/B only): every texel of the wider kernel is
+ * compared with the receiver's depth at that texel -- the plane through the
+ * pixel from the screen-space derivatives of (u, v, r) (Isidoro, GDC 2006) --
+ * instead of the pixel's r; where the plane is degenerate or steeper than
+ * rsx_fp_set_shadow_plane_max allows (a 2x2 pixel quad across two surfaces)
+ * the pixel keeps the PS3 kernel. Off by default: in inFamous 2 the resolves
+ * rebuild the receiver from the depth buffer, and the plane solved from those
+ * derivatives is noisy (speckles on posts, crates and Cole), while the wider
+ * kernels without it shadow no surface the PS3 kernel leaves lit (2026-10-27,
+ * docs/NOTES.md); on a clean analytic slope (tests/test_ztex_pcf.c) it removes
+ * the acne a wider reach brings.
+ * Units the program samples more than once (the title's own multi-tap
+ * resolves: a centre TXP plus four taps at +-0.7 texel), units sampled inside
+ * a flow-control block (derivatives), cube units, ZFUNC 0 (a depth read, no
+ * comparison), NEAREST units and ZTEX_PCF's diagnostic footprints (fp_texctl
+ * bits 5-6 != 0) keep the PS3 kernel; a program with no such unit sampled
+ * once is byte-identical to the PS3 HLSL. */
+#define RSX_FP_SHADOW_PS3      0u
+#define RSX_FP_SHADOW_SOFT     1u
+#define RSX_FP_SHADOW_SOFTER   2u
+#define RSX_FP_SHADOW_KERNEL   3u          /* mask */
+#define RSX_FP_SHADOW_POISSON  4u
+#define RSX_FP_SHADOW_PLANE    8u
+#define RSX_FP_SHADOW_PLANE_LOWER 16u
+void rsx_fp_set_shadow_filter(u32 filter);
+u32  rsx_fp_shadow_filter(void);
+/* The steepest receiver plane trusted, in depth units (0..1) per texel; a
