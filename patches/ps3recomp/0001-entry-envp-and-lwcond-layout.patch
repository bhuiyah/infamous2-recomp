+/* ---------------- the guest arena ---------------- */
+enum : uint32_t {
+    MAIN_MEM = 0x00010000u, MAIN_MEM_SIZE = 0x01000000u,     /* 16 MB at vm_init's main-memory base */
+    STACKS_SIZE = 0x01000000u,                               /* 16 MB of VM_STACK_BASE's region */
+    G_SC = 0x00100000u, G_SC_RA = 0x00100010u,               /* the generic `sc` stub, its sc's return */
+    G_HLE = 0x00100100u,                                     /* import stubs, 0x10 apart */
+    G_BODY = 0x00110000u,                                    /* bodies, 0x1000 apart */
+    DATA = 0x00800000u,                                      /* results, objects, parameters */
+    MAIN_STACK_LO = 0x00E00000u, MAIN_SP = 0x00F00000u - 48, /* main's guest stack (no table range) */
+};
+static void arena_init(void)
+{
+    vm_base = (uint8_t*)VirtualAlloc(NULL, (SIZE_T)VM_TOTAL_SIZE, MEM_RESERVE, PAGE_NOACCESS);
+    if (!vm_base || !VirtualAlloc(vm_base + MAIN_MEM, MAIN_MEM_SIZE, MEM_COMMIT, PAGE_READWRITE) ||
+        !VirtualAlloc(vm_base + VM_STACK_BASE, STACKS_SIZE, MEM_COMMIT, PAGE_READWRITE)) {
+        printf("no guest arena\n");
+        exit(2);
+    }
+    vm_stack_alloc_init(&g_vm_stack_alloc);
+    g_vm_stack_alloc.region_end = VM_STACK_BASE + STACKS_SIZE;
+    ss_state_set_arena(vm_base, VM_TOTAL_SIZE);
+}
