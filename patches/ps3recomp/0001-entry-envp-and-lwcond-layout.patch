+/*
+ * ps3recomp - the settings store. API, layers and threading rules:
+ * include/ps3emu/options.h. The ini editor is libs/system/opt_ini.h.
+ *
+ * Every built-in default below is today's behaviour, so a run with no
+ * options.ini and no new environment variable takes exactly the old code
+ * paths; each consumer keeps its old environment parse first (FPS_CAP,
+ * PRESENT_SYNC, PRESENT_TEARING) and reads the store only when that variable
+ * is not set.
+ *
+ * Test scaffolding (off unless set): OPTIONS_TEST_FILE=<path>. At each render
+ * point (at most every 100 ms) the file, when it exists, is read and deleted;
+ * each line "key = value" is an opt_set, "reset = key" an opt_reset and
+ * "intercept = 1|0" options_set_intercepted -- a closed loop for scripted runs
+ * (write the file after READY), the way PAD_FILE drives the pad.
+ */
+#include "ps3emu/options.h"
+#include "opt_ini.h"
+#include "../video/display_cfg.h"      /* window / monitor validators (header-only) */
+
+#ifdef _WIN32
+#  ifndef WIN32_LEAN_AND_MEAN
+#    define WIN32_LEAN_AND_MEAN
+#  endif
+#  include <windows.h>
+#else
+#  include "../../runtime/platform/win32_compat.h"
+#  include <sys/stat.h>
+#  include <unistd.h>
+#endif
+#include <math.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#  define OPT_SEP "\\"
+#else
+#  define OPT_SEP "/"
+#endif
+
+#define OPT_MAX      256
+#define OPT_VALLEN   96
+#define OPT_MAXWATCH 128
+
+typedef struct {
+    const opt_def*  d;
+    char            val[OPT_VALLEN];       /* current, canonical */
+    char            start[OPT_VALLEN];     /* at registration: restart-pending check */
+    char            home_val[OPT_VALLEN];  /* from display.ini / input.ini ("" = none) */
+    int             home_line;
+    char            file_val[OPT_VALLEN];  /* from options.ini ("" = none) */
+    int             file_line;
+    opt_source_kind src;
+    const char*     lock;                  /* env variable that set it */
+    volatile LONG64 bits;                  /* the number, as double bits */
+    volatile LONG   gen;
+    int             dirty;                 /* changed at run time: options.ini needs it */
+    int             rpend;                 /* OPT_ON_RENDER callbacks pending */
+    char            rold[OPT_VALLEN];      /* value at the last render point */
+} opt_slot;
+
+typedef struct { opt_id id; opt_fn fn; void* user; int where; } opt_watcher;
+
+static opt_slot      s_slot[OPT_MAX];
+static volatile LONG s_n;
+static volatile LONG s_generation;
+static volatile LONG s_state;              /* 0 not loaded, 1 loading, 2 ready */
+static SRWLOCK       s_lock = SRWLOCK_INIT;
+static opt_watcher   s_watch[OPT_MAXWATCH];
+static volatile LONG s_nwatch;
+static volatile LONG s_rpend_any;
+static int           s_batch, s_batch_dirty;
+
+static ini_buf s_txt_display, s_txt_input, s_txt_opts;   /* decoded (UTF-8) file texts */
+static ini_buf s_layer_display, s_layer_input;
+static int     s_opts_enc = INI_ENC_UTF8;
+static int     s_opts_exists;
+static char    s_opts_path[1024];          /* "" = OPTIONS_CONFIG=none: nothing saved */
+static char    s_display_path[1024], s_input_path[1024];
+
+static void opt_logf(const char* fmt, ...);
+
+/* ---------------------------------------------------------------- platform */
+
+static double d_from_bits(LONG64 b) { double d; memcpy(&d, &b, sizeof d); return d; }
+static LONG64 bits_from_d(double d) { LONG64 b; memcpy(&b, &d, sizeof b); return b; }
+
+static int file_read_all(const char* path, ini_buf* raw)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    ini_buf_clear(raw);
+    char tmp[8192];
+    size_t n;
+    while ((n = fread(tmp, 1, sizeof tmp, f)) > 0) ini_buf_put(raw, tmp, n);
+    fclose(f);
+    return 1;
+}
+
+static int path_is_dir(const char* p)
+{
+#ifdef _WIN32
+    DWORD a = GetFileAttributesA(p);
+    return a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY);
+#else
+    struct stat st;
+    return stat(p, &st) == 0 && S_ISDIR(st.st_mode);
+#endif
+}
+
+static void full_path(const char* p, char* out, size_t n)
+{
+#ifdef _WIN32
+    if (!GetFullPathNameA(p, (DWORD)n, out, NULL)) snprintf(out, n, "%s", p);
+#else
+    snprintf(out, n, "%s", p);
+#endif
+}
+
+/* name next to the exe, or "" */
+static void exe_dir_file(const char* name, char* out, size_t n)
+{
+    out[0] = 0;
+#ifdef _WIN32
+    char exe[MAX_PATH];
+    DWORD k = GetModuleFileNameA(NULL, exe, MAX_PATH);
+    char* slash = (k && k < MAX_PATH) ? strrchr(exe, '\\') : NULL;
+    if (slash) { slash[1] = 0; snprintf(out, n, "%s%s", exe, name); }
+#else
+    (void)name; (void)n;
+#endif
+}
+
+/* The discovery every config file of this project uses: <env> (none/0: no
+ * file), else .\<name>, .\config\<name>, <name> next to the exe. Returns 1
+ * and the path when a file was read into raw; 0 otherwise (*off = 1 when the
+ * variable said none). */
+static int find_and_read(const char* env, const char* name, char* path, size_t pn, ini_buf* raw, int* off)
+{
+    *off = 0;
+    path[0] = 0;
+    const char* e = getenv(env);
+    if (e && *e) {
+        if (!strcmp(e, "none") || !strcmp(e, "0")) { *off = 1; return 0; }
+        full_path(e, path, pn);
+        return file_read_all(e, raw);
+    }
+    char cfg[512], ex[1024];
+    snprintf(cfg, sizeof cfg, "config" OPT_SEP "%s", name);
+    exe_dir_file(name, ex, sizeof ex);
+    const char* cand[3] = { name, cfg, ex };
+    for (int i = 0; i < 3; i++) {
+        if (!cand[i][0] || !file_read_all(cand[i], raw)) continue;
+        full_path(cand[i], path, pn);
+        return 1;
+    }
+    return 0;
+}
