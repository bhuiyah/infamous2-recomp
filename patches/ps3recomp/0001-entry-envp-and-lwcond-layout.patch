+    ss_configure(&on);
+    run_clock(200);
+    {
+        ss_host_ops h = { fake_walker_pass, fake_walker_info, fake_rebase, fake_wake, fake_gpu_idle };
+        ss_set_host_ops(&h);
+        ss_request_stats s0, s1;
+        /* 14a: refused at one stop, captured at the next */
+        ss_get_request_stats(SS_P_SAVE, &s0);
+        InterlockedExchange(&g_tsec_refuse, 1);
+        run_request(SS_P_SAVE, 3.0, 5000, &res);
+        ss_get_request_stats(SS_P_SAVE, &s1);
+        printf("phase 14a: a section refuses once -> ok=%d attempts=%u captured +%u\n", res.ok, res.attempts,
