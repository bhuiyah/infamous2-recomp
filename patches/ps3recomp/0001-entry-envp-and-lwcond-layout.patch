+#define RSX_VH_SCRAMBLE_KEY (rsx_vh_key + 192 - 64)
+#define RSX_VH_LAST_KEY     (rsx_vh_key + 192 - 64 - 7)
+#define RSX_VH_MERGE_KEY    (rsx_vh_key + 11)
+
+static inline u64 rsx_vh_rd64(const u8* p) { u64 v; memcpy(&v, p, 8); return v; }
+
+static u64 rsx_vh_fold128(u64 a, u64 b)   /* low ^ high half of the 128-bit product */
+{
+#if defined(__SIZEOF_INT128__)
+    const unsigned __int128 m = (unsigned __int128)a * b;
+    return (u64)m ^ (u64)(m >> 64);
+#else
+    const u64 al = (u32)a, ah = a >> 32, bl = (u32)b, bh = b >> 32;
+    const u64 ll = al * bl, lh = al * bh, hl = ah * bl, hh = ah * bh;
+    const u64 mid = (ll >> 32) + (u32)lh + (u32)hl;
+    return (((mid << 32) | (u32)ll)) ^ (hh + (lh >> 32) + (hl >> 32) + (mid >> 32));
+#endif
+}
+
+/* The accumulators merged with the length, then combined with the seed
+ * through a bijection in either argument. */
+static u64 rsx_vh_finish(const u64* acc, size_t len, u64 seed)
+{
+    u64 r = (u64)len * RSX_P1;
+    for (int i = 0; i < 4; i++)
+        r += rsx_vh_fold128(acc[2 * i] ^ rsx_vh_rd64(RSX_VH_MERGE_KEY + 16 * i),
+                            acc[2 * i + 1] ^ rsx_vh_rd64(RSX_VH_MERGE_KEY + 16 * i + 8));
+    r ^= r >> 37; r *= 0x165667919E3779F9ull; r ^= r >> 32;
+    u64 h = r ^ (seed * RSX_P2);
+    h = rsx_rotl64(h, 31) * RSX_P1;
+    h ^= h >> 29; h *= RSX_P3; h ^= h >> 32;
+    return h;
+}
+#endif
+
+#if defined(RSX_VH_SCALAR_REF)
+/* acc[8] for p[0, len), len >= 64: blocks of 16 stripes (64 bytes, key
+ * advancing 8 bytes per stripe) each followed by a scramble, then the
+ * remaining whole stripes but the last, then the last 64 bytes. What the
+ * vector loops compute, in plain C (tests only). */
+static inline void rsx_vh_stripe_scalar(u64* acc, const u8* in, const u8* key)
+{
+    for (int i = 0; i < 8; i++) {
+        const u64 dv = rsx_vh_rd64(in + 8 * i), dk = dv ^ rsx_vh_rd64(key + 8 * i);
+        acc[i ^ 1] += dv;
+        acc[i] += (u64)(u32)dk * (dk >> 32);
+    }
+}
+static void rsx_vh_long_scalar(const u8* p, size_t len, u64* acc)
+{
+    memcpy(acc, rsx_vh_init, sizeof rsx_vh_init);
+    const size_t nb = (len - 1u) / 1024u;
+    for (size_t b = 0; b < nb; b++) {
+        for (u32 s = 0; s < 16u; s++) rsx_vh_stripe_scalar(acc, p + 1024u * b + 64u * s, rsx_vh_key + 8u * s);
+        for (int i = 0; i < 8; i++) {
+            u64 a = acc[i];
+            a ^= a >> 47; a ^= rsx_vh_rd64(RSX_VH_SCRAMBLE_KEY + 8 * i); a *= RSX_P32_1;
+            acc[i] = a;
+        }
+    }
+    const size_t ns = ((len - 1u) - 1024u * nb) / 64u;
+    for (size_t s = 0; s < ns; s++) rsx_vh_stripe_scalar(acc, p + 1024u * nb + 64u * s, rsx_vh_key + 8u * s);
+    rsx_vh_stripe_scalar(acc, p + len - 64u, RSX_VH_LAST_KEY);
+}
+#endif
+
+#if RSX_VF_SSE41
+static inline void rsx_vh_stripe_sse(__m128i* a, const u8* in, const u8* key)
+{
+    for (int i = 0; i < 4; i++) {
+        const __m128i d  = _mm_loadu_si128((const __m128i*)(in + 16 * i));
+        const __m128i dk = _mm_xor_si128(d, _mm_loadu_si128((const __m128i*)(key + 16 * i)));
+        const __m128i pr = _mm_mul_epu32(dk, _mm_shuffle_epi32(dk, _MM_SHUFFLE(0, 3, 0, 1)));
+        a[i] = _mm_add_epi64(a[i], _mm_add_epi64(pr, _mm_shuffle_epi32(d, _MM_SHUFFLE(1, 0, 3, 2))));
+    }
+}
+static inline void rsx_vh_scramble_sse(__m128i* a)
+{
+    const __m128i k32 = _mm_set1_epi32((int)RSX_P32_1);
+    for (int i = 0; i < 4; i++) {
+        __m128i x = _mm_xor_si128(a[i], _mm_srli_epi64(a[i], 47));
+        x = _mm_xor_si128(x, _mm_loadu_si128((const __m128i*)(RSX_VH_SCRAMBLE_KEY + 16 * i)));
+        const __m128i lo = _mm_mul_epu32(x, k32);
+        const __m128i hi = _mm_mul_epu32(_mm_shuffle_epi32(x, _MM_SHUFFLE(0, 3, 0, 1)), k32);
+        a[i] = _mm_add_epi64(lo, _mm_slli_epi64(hi, 32));
+    }
+}
+static void rsx_vh_long_sse(const u8* p, size_t len, u64* acc)
+{
+    __m128i a[4];
+    for (int i = 0; i < 4; i++) a[i] = _mm_loadu_si128((const __m128i*)(rsx_vh_init + 2 * i));
+    const size_t nb = (len - 1u) / 1024u;
+    for (size_t b = 0; b < nb; b++) {
+        const u8* blk = p + 1024u * b;
+        for (u32 s = 0; s < 16u; s++) rsx_vh_stripe_sse(a, blk + 64u * s, rsx_vh_key + 8u * s);
+        rsx_vh_scramble_sse(a);
+    }
+    const size_t ns = ((len - 1u) - 1024u * nb) / 64u;
+    for (size_t s = 0; s < ns; s++) rsx_vh_stripe_sse(a, p + 1024u * nb + 64u * s, rsx_vh_key + 8u * s);
+    rsx_vh_stripe_sse(a, p + len - 64u, RSX_VH_LAST_KEY);
+    for (int i = 0; i < 4; i++) _mm_storeu_si128((__m128i*)(acc + 2 * i), a[i]);
+}
+#endif
+
+#if RSX_VH_AVX2
+#if defined(_MSC_VER)
+static void rsx_vh_cpuid(int leaf, int r[4]) { __cpuidex(r, leaf, 0); }
+#else
+static void rsx_vh_cpuid(int leaf, int r[4])
+{
+    unsigned a, b, c, d; __cpuid_count((unsigned)leaf, 0u, a, b, c, d);
+    r[0] = (int)a; r[1] = (int)b; r[2] = (int)c; r[3] = (int)d;
+}
+#endif
+/* AVX2 in the CPU and YMM state saved by the OS (the test spu_drain.c makes). */
+static int rsx_vh_avx2_ok(void)
+{
+    int r0[4], r1[4], r7[4] = {0, 0, 0, 0};
+    rsx_vh_cpuid(0, r0);
+    rsx_vh_cpuid(1, r1);
+    if (r0[0] >= 7) rsx_vh_cpuid(7, r7);
+    if (!((unsigned)r1[2] >> 27 & 1) || !((unsigned)r1[2] >> 28 & 1) || !((unsigned)r7[1] >> 5 & 1)) return 0;
+    unsigned lo, hi;
+    __asm__ volatile("xgetbv" : "=a"(lo), "=d"(hi) : "c"(0));   /* _xgetbv needs -mxsave */
+    (void)hi;
+    return (lo & 6u) == 6u;
+}
+__attribute__((target("avx2")))
+static inline void rsx_vh_stripe_avx2(__m256i* a, const u8* in, const u8* key)
+{
+    for (int i = 0; i < 2; i++) {
+        const __m256i d  = _mm256_loadu_si256((const __m256i*)(in + 32 * i));
+        const __m256i dk = _mm256_xor_si256(d, _mm256_loadu_si256((const __m256i*)(key + 32 * i)));
+        const __m256i pr = _mm256_mul_epu32(dk, _mm256_shuffle_epi32(dk, _MM_SHUFFLE(0, 3, 0, 1)));
+        a[i] = _mm256_add_epi64(a[i], _mm256_add_epi64(pr, _mm256_shuffle_epi32(d, _MM_SHUFFLE(1, 0, 3, 2))));
+    }
+}
+__attribute__((target("avx2")))
+static inline void rsx_vh_scramble_avx2(__m256i* a)
+{
+    const __m256i k32 = _mm256_set1_epi32((int)RSX_P32_1);
+    for (int i = 0; i < 2; i++) {
+        __m256i x = _mm256_xor_si256(a[i], _mm256_srli_epi64(a[i], 47));
+        x = _mm256_xor_si256(x, _mm256_loadu_si256((const __m256i*)(RSX_VH_SCRAMBLE_KEY + 32 * i)));
+        const __m256i lo = _mm256_mul_epu32(x, k32);
+        const __m256i hi = _mm256_mul_epu32(_mm256_shuffle_epi32(x, _MM_SHUFFLE(0, 3, 0, 1)), k32);
+        a[i] = _mm256_add_epi64(lo, _mm256_slli_epi64(hi, 32));
+    }
+}
+__attribute__((target("avx2")))
+static void rsx_vh_long_avx2(const u8* p, size_t len, u64* acc)
+{
+    __m256i a[2];
+    for (int i = 0; i < 2; i++) a[i] = _mm256_loadu_si256((const __m256i*)(rsx_vh_init + 4 * i));
+    const size_t nb = (len - 1u) / 1024u;
+    for (size_t b = 0; b < nb; b++) {
+        const u8* blk = p + 1024u * b;
+        for (u32 s = 0; s < 16u; s++) rsx_vh_stripe_avx2(a, blk + 64u * s, rsx_vh_key + 8u * s);
+        rsx_vh_scramble_avx2(a);
+    }
+    const size_t ns = ((len - 1u) - 1024u * nb) / 64u;
+    for (size_t s = 0; s < ns; s++) rsx_vh_stripe_avx2(a, p + 1024u * nb + 64u * s, rsx_vh_key + 8u * s);
+    rsx_vh_stripe_avx2(a, p + len - 64u, RSX_VH_LAST_KEY);
+    for (int i = 0; i < 2; i++) _mm256_storeu_si256((__m256i*)(acc + 4 * i), a[i]);
+    _mm256_zeroupper();
+}
+#endif
+
+/* rsx_vhash64 below RSX_VH_LONG bytes, and everywhere without SSE4.1 (the
+ * plain C long loop is slower than XXH64); else the vector loop. */
+u64 rsx_vhash64x(const u8* p, size_t len, u64 seed)
+{
+#if RSX_VF_SSE41
+    if (len >= RSX_VH_LONG) {
+        typedef void (*long_fn)(const u8*, size_t, u64*);
+        static long_fn fn;
+        if (!fn) {
+            long_fn f = rsx_vh_long_sse;
+#if RSX_VH_AVX2
+            const char* e = getenv("VHASH_AVX2");
+            if (!(e && *e == '0') && rsx_vh_avx2_ok()) f = rsx_vh_long_avx2;
+#endif
+            fn = f;
+        }
+        u64 acc[8];
+        fn(p, len, acc);
+        return rsx_vh_finish(acc, len, seed);
+    }
+#endif
+    return rsx_vhash64(p, len, seed);
+}
+
+static inline u64 rsx_mix64(u64 h, u64 v) { return (h ^ (v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2))) * RSX_P1; }
+
+u64 rsx_vfetch_plan_sig(const rsx_vfetch_plan* p, int with_mapping)
+{
+    u64 h = rsx_mix64(0x5EEDull, p->mask | ((u64)p->nslots << 16) | ((u64)rsx_vf_nofreq() << 24));
+    for (u32 si = 0; si < p->nslots; si++) {
+        const rsx_vf_slot* s = &p->s[si];
+        u64 k0, k1; memcpy(&k0, s->k, 8); memcpy(&k1, s->k + 2, 8);
+        h = rsx_mix64(h, (u64)s->mode | ((u64)s->type << 8) | ((u64)s->n << 16) | ((u64)s->fmode << 24) |
+                         ((u64)s->idx << 32) | ((u64)s->loc << 40));
+        h = rsx_mix64(h, k0); h = rsx_mix64(h, k1);
+        if (s->mode == RSX_VF_CONST) continue;
+        h = rsx_mix64(h, (u64)s->stride | ((u64)s->freq << 32));
+        h = rsx_mix64(h, (u64)s->off);
+        if (with_mapping && s->mode == RSX_VF_FAST)
+            h = rsx_mix64(h, (u64)s->ea0 | ((u64)s->elo << 32));
+    }
+    return h;
+}
+
+/* rsx_vfetch_hash with the plan's rsx_vfetch_plan_sig(p, 1) already in hand
+ * (rsx_vcache_get computes it for its key anyway). */
+static int rsx_vf_hash_sig(const rsx_vfetch_plan* p, u64 sig, u64* out)
+{
+    if (!p->hashable || !vm_base) return 0;
+    /* Spans [ea, ea + len) of every FAST slot; interleaved attributes of one
+     * array overlap, so merge them and hash each byte once. */
+    u64 lo[16], hi[16]; u32 n = 0;
+    for (u32 si = 0; si < p->nslots; si++) {
+        const rsx_vf_slot* s = &p->s[si];
+        if (s->mode != RSX_VF_FAST) continue;
+        const u64 a = s->ea0;
+        const u64 b = a + (u64)(s->ehi - s->elo) * s->stride + s->bytes;
+        if (b > 0x100000000ull) return 0;   /* would wrap the 32-bit EA */
+        u32 k = n++;
+        while (k > 0 && lo[k - 1] > a) { lo[k] = lo[k - 1]; hi[k] = hi[k - 1]; k--; }
+        lo[k] = a; hi[k] = b;
+    }
+    u64 h = sig;
+    u64 cur_lo = 0, cur_hi = 0; int have = 0;
+    for (u32 i = 0; i < n; i++) {
+        if (have && lo[i] <= cur_hi) { if (hi[i] > cur_hi) cur_hi = hi[i]; continue; }
+        if (have) h = rsx_vhash64x(vm_base + cur_lo, (size_t)(cur_hi - cur_lo), h);
+        cur_lo = lo[i]; cur_hi = hi[i]; have = 1;
+    }
+    if (have) h = rsx_vhash64x(vm_base + cur_lo, (size_t)(cur_hi - cur_lo), h);
+    *out = h;
+    return 1;
+}
+
+int rsx_vfetch_hash(const rsx_vfetch_plan* p, u64* out)
+{
+    if (!p->hashable || !vm_base) return 0;
+    return rsx_vf_hash_sig(p, rsx_vfetch_plan_sig(p, 1), out);
+}
+
+/* ---- primitive expansion ------------------------------------------------ */
+
+u32 rsx_vexpand_count(u32 prim, u32 count)
+{
+    switch (prim) {
+    case RSX_PRIMITIVE_TRIANGLES:      return count;
+    case RSX_PRIMITIVE_QUADS:          return (count / 4u) * 6u;
+    case RSX_PRIMITIVE_TRIANGLE_STRIP:
+    case RSX_PRIMITIVE_TRIANGLE_FAN:   return count >= 3 ? (count - 2u) * 3u : 0;
+    default:                           return 0;
+    }
+}
+
+u32 rsx_vexpand_used(u32 prim, u32 count)
+{
+    switch (prim) {
+    case RSX_PRIMITIVE_TRIANGLES:      return count;
+    case RSX_PRIMITIVE_QUADS:          return (count / 4u) * 4u;
+    case RSX_PRIMITIVE_TRIANGLE_STRIP:
+    case RSX_PRIMITIVE_TRIANGLE_FAN:   return count >= 3 ? count : 0;
+    default:                           return 0;
+    }
+}
+
+u32 rsx_vexpand(u32 prim, u32 count, u32* order)
+{
+    u32 o = 0;
+    switch (prim) {
+    case RSX_PRIMITIVE_TRIANGLES:
+        for (u32 i = 0; i < count; i++) order[o++] = i;
+        break;
+    case RSX_PRIMITIVE_QUADS:
+        for (u32 q = 0; q < count / 4u; q++) {
+            const u32 b = q * 4u;   /* quad -> (v0,v1,v2) (v0,v2,v3) */
+            order[o++] = b; order[o++] = b + 1; order[o++] = b + 2;
+            order[o++] = b; order[o++] = b + 2; order[o++] = b + 3;
+        }
+        break;
+    case RSX_PRIMITIVE_TRIANGLE_STRIP:
+    case RSX_PRIMITIVE_TRIANGLE_FAN: {
+        const int fan = prim == RSX_PRIMITIVE_TRIANGLE_FAN;
+        if (count < 3) break;
+        for (u32 t = 0; t < count - 2u; t++) {
+            u32 i1 = t + 1, i2 = t + 2;
+            if (!fan && (t & 1)) { u32 x = i1; i1 = i2; i2 = x; }   /* strip winding */
+            order[o++] = fan ? 0 : t; order[o++] = i1; order[o++] = i2;
+        }
+        break; }
+    default:
+        break;
+    }
+    return o;
+}
+
+/* ---- unique-vertex assignment ------------------------------------------- */
+
+void rsx_vdedupe_reset(rsx_vdedupe* d)
+{
+    if (++d->gen == 0) {          /* wrapped: no stale entry may look current */
+        for (u32 i = 0; i < (1u << RSX_VDEDUPE_BITS); i++) d->t[i].g = 0;
+        d->gen = 1;
+    }
+}
+
+u32 rsx_vdedupe_run(rsx_vdedupe* d, const u32* vis, u32 n, u32* next_elem,
+                    u32* ib, u32* newv)
+{
+    if (d->gen == 0) rsx_vdedupe_reset(d);
+    const u32 gen = d->gen;
+    u32 e = *next_elem, nn = 0;
+    /* Branch-free: whether an index was seen is data, not control flow (a
+     * record's first touch of each vertex is a miss, interleaved with the
+     * hits of its neighbours, so a branch on it mispredicts constantly). A
+     * hit stores back the values its entry already holds; newv[nn] is scratch
+     * until a miss keeps it (nn <= j < n). */
+    for (u32 j = 0; j < n; j++) {
+        const u32 vi = vis[j];
+        rsx_vdedupe_ent* t = &d->t[(vi * 2654435761u) >> (32 - RSX_VDEDUPE_BITS)];
+        const u32 te = t->e, tg = t->g, tv = t->vi;
+        const u32 miss = (u32)((tg ^ gen) | (tv ^ vi)) != 0u;   /* 1: not in the table */
+        const u32 el = RSX_VF_UNPREDICTABLE(miss) ? e : te;
+        t->g = gen; t->vi = vi; t->e = el;
+        ib[j] = el;
+        newv[nn] = vi;
+        nn += miss;
+        e += miss;
+    }
+    *next_elem = e;
+    return nn;
+}
+
+/* ---- cross-batch converted-vertex cache ---------------------------------- */
+
+/* rsx_vfetch_convert, or its specialised twin when VEMIT_FAST is on (same
+ * bytes either way; defined with the fast path below). */
+static void rsx_ve_convert(const rsx_vfetch_plan* p, const u32* vis, u32 first, u32 n, void* out, u32 out_stride);
+
+int rsx_vcache_init(rsx_vcache* c, u64 base, u64 bytes, u32 nent)
+{
+    memset(c, 0, sizeof *c);
+    const u64 ns = bytes / RSX_VCACHE_SLAB;
+    if (ns < 2 || ns > 0xFFFFu || !nent || (nent & (nent - 1))) return 0;
+    c->slab_gen  = (u32*)calloc((size_t)ns, sizeof(u32));
+    c->slab_last = (u32*)calloc((size_t)ns, sizeof(u32));
+    c->slab_used = (u32*)calloc((size_t)ns, sizeof(u32));
+    c->ent = (rsx_vcache_ent*)calloc(nent, sizeof(rsx_vcache_ent));
+    c->seen = (u64*)calloc(RSX_VCACHE_SEEN, sizeof(u64));
+    c->slab_live = (u32*)calloc((size_t)ns, sizeof(u32));
+    if (!c->slab_gen || !c->slab_last || !c->slab_used || !c->ent || !c->seen || !c->slab_live) {
+        free(c->slab_gen); free(c->slab_last); free(c->slab_used); free(c->ent); free(c->seen);
+        free(c->slab_live);
+        memset(c, 0, sizeof *c);
+        return 0;
+    }
+    c->base = base;
+    c->nslab = (u32)ns;
+    c->nent = nent;
+    c->min_age = RSX_VCACHE_MIN_AGE;
+    c->admit2 = 1;
+    c->evac_on = 1;
+    c->evac = ~0u;
+    c->nofree_batch = ~0u;
+    for (u32 i = 0; i < c->nslab; i++) c->slab_gen[i] = 1;   /* gen 0 = never live */
+    return 1;
+}
+
+static int rsx_vc_live(const rsx_vcache* c, const rsx_vcache_ent* e)
+{
+    return e->slab_gen && e->slab < c->nslab && c->slab_gen[e->slab] == e->slab_gen;
+}
+
+/* ---- VCACHE_STATS (diagnostic) ------------------------------------------- */
+
+int rsx_vcache_diag_on(rsx_vcache* c)
+{
+    if (c->dg || !c->nent) return c->dg != NULL;
+    rsx_vcache_diag* d = (rsx_vcache_diag*)calloc(1, sizeof *d);
+    if (!d) return 0;
+    d->ent = (rsx_vcache_dg*)calloc(c->nent, sizeof *d->ent);
+    d->key = (rsx_vcache_key*)calloc(RSX_VCD_KEYS, sizeof *d->key);
+    if (!d->ent || !d->key) { free(d->ent); free(d->key); free(d); return 0; }
+    c->dg = d;
+    return 1;
+}
+
+void rsx_vcache_diag_clear(rsx_vcache* c)
+{
+    if (c->dg) memset(c->dg->ent, 0, (size_t)c->nent * sizeof *c->dg->ent);
+}
+
+/* A sighting of range key k (its bytes): the key's sightings so far (1: the
+ * set had never seen it; 0: no room in the set). */
+static u32 rsx_vcd_seen(rsx_vcache_diag* d, u64 k, u32 batch, u32 bytes)
+{
+    if (!k) k = 1;
+    u32 i = (u32)(k ^ (k >> 32)) & (RSX_VCD_KEYS - 1u);
+    for (u32 n = 0; n < 64u; n++, i = (i + 1u) & (RSX_VCD_KEYS - 1u)) {
+        rsx_vcache_key* q = &d->key[i];
+        if (q->k == k) return ++q->n;
+        if (!q->k) { q->k = k; q->first = batch; q->n = 1; q->bytes = bytes; d->nkey++; return 1; }
+    }
+    d->key_full++;
+    return 0;
+}
+
+/* An admission into table entry v (e: the entry that had the key, live: its
+ * copy was live, nseen: the key's sightings), before v is overwritten. */
+static void rsx_vcd_admit(rsx_vcache* c, const rsx_vcache_ent* v, const rsx_vcache_ent* e,
+                          int live, u32 nseen, u32 batch)
+{
+    rsx_vcache_diag* d = c->dg;
+    if (!e) { if (nseen == 1) d->adm_first++; else if (c->admit2 && nseen == 2) d->adm_second++; else d->adm_forgot++; }
+    else if (live) d->adm_changed++;
+    else d->adm_dead++;
+    if (v != e && rsx_vc_live(c, v)) d->forget++;
+    rsx_vcache_dg* s = &d->ent[v - c->ent];
+    if (s->adm) { if (s->hits) d->die1++; else d->die0++; }
+    s->born = batch; s->last = batch; s->hits = 0; s->adm = 1;
+}
+
+
+static int rsx_vcd_cmp_u32(const void* a, const void* b)
+{
+    const u32 x = *(const u32*)a, y = *(const u32*)b;
+    return x < y ? -1 : x > y;
+}
+
+void rsx_vcache_census_run(const rsx_vcache* c, u32 batch, u32 since, rsx_vcache_census* o)
+{
+    memset(o, 0, sizeof *o);
+    const rsx_vcache_diag* d = c->dg;
+    if (!d || !c->nslab) return;
+    const u32 age = c->min_age < 2u ? 2u : c->min_age;
+    u64* live_b = (u64*)calloc(c->nslab, sizeof(u64));
+    u64* hot_b = (u64*)calloc(c->nslab, sizeof(u64));
+    u32* hot_n = (u32*)calloc(c->nslab, sizeof(u32));
+    u32* pkb = (u32*)calloc(c->nslab, sizeof(u32));
+    if (!live_b || !hot_b || !hot_n || !pkb) { free(live_b); free(hot_b); free(hot_n); free(pkb); return; }
+    for (u32 i = 0; i < c->nent; i++) {
+        const rsx_vcache_ent* q = &c->ent[i];
+        if (!rsx_vc_live(c, q)) continue;
+        const u64 b = (u64)(q->hi - q->lo + 1u) * q->stride;
+        o->live++;
+        live_b[q->slab] += b;
+        if (d->ent[i].last + age > batch) { o->hot++; o->hot_b += b; hot_b[q->slab] += b; hot_n[q->slab]++; }
+        else { o->cold_b += b; if (!d->ent[i].hits) o->cold0_b += b; }
+    }
+    for (u32 i = 0; c->seen && i < RSX_VCACHE_SEEN; i++) o->seen += c->seen[i] != 0;
+    u32 np = 0;
+    for (u32 s = 0; s < c->nslab; s++) {
+        if (!c->slab_used[s]) continue;
+        o->used++;
+        o->used_b += c->slab_used[s];
+        if (c->slab_used[s] > live_b[s]) o->orphan_b += c->slab_used[s] - live_b[s];
+        if (c->slab_last[s] + age <= batch) { o->recyclable++; continue; }
+        o->pinned++;
+        const u32 k = hot_n[s];
+        o->pin_by[k == 0 ? 0 : k == 1 ? 1 : k <= 4 ? 2 : 3]++;
+        pkb[np++] = (u32)(hot_b[s] >> 10);
+    }
+    if (c->evac != ~0u && c->evac < c->nslab) o->evac_kb = c->slab_live[c->evac] >> 10;
+    if (np) {
+        qsort(pkb, np, sizeof(u32), rsx_vcd_cmp_u32);
+        o->hot_kb_p50 = pkb[np / 2];
+        o->hot_kb_p90 = pkb[(np * 9u) / 10u];
+    }
+    for (u32 i = 0; i < RSX_VCD_KEYS; i++) {
+        const rsx_vcache_key* q = &d->key[i];
+        if (!q->k) continue;
+        o->keys++;
+        if (q->first >= since) continue;
+        if (q->n == 1) { o->once++; o->once_b += q->bytes; } else o->multi_b += q->bytes;
+    }
+    free(live_b); free(hot_b); free(hot_n); free(pkb);
+}
+
+/* Arena offset where `bytes` (stride-aligned) fit after slab s's used part
+ * (used = 0: an empty slab), ~0 when they do not. */
+static u64 rsx_vc_fit(const rsx_vcache* c, u32 s, u32 used, u64 bytes, u32 stride)
+{
+    const u64 sb = c->base + (u64)s * RSX_VCACHE_SLAB;
+    const u64 g = ((sb + used + stride - 1u) / stride) * stride;
+    return g + bytes <= sb + RSX_VCACHE_SLAB ? g : ~0ull;
+}
+
+/* evac: as the allocator opens a slab, or finds none to open. A slab being
+ * emptied whose stamp has aged (no draw read it for min_age batches) is done;
+ * with none being emptied and fewer than nslab / 8 (at least 2) slabs free or
+ * recyclable, the one whose live copies hold the fewest bytes among those a
+ * draw used within min_age batches (not the current slab) is chosen. */
+static void rsx_vc_evac_pick(rsx_vcache* c, u32 batch)
+{
+    if (!c->evac_on) return;
+    const u32 age = c->min_age < 2u ? 2u : c->min_age;
+    if (c->evac != ~0u) {
+        if (c->slab_last[c->evac] + age > batch) return;   /* still read within min_age */
+        c->evac = ~0u;
+    }
+    u32 nfree = 0, best = ~0u, best_live = ~0u;
+    for (u32 s = 0; s < c->nslab; s++) {
+        if (!c->slab_used[s] || c->slab_last[s] + age <= batch) { nfree++; continue; }
+        if (s != c->cur && c->slab_live[s] < best_live) { best = s; best_live = c->slab_live[s]; }
+    }
+    const u32 low = c->nslab / 8u > 2u ? c->nslab / 8u : 2u;
+    if (nfree < low && best != ~0u) { c->evac = best; c->evacs++; }
+}
+
+/* evac: a live copy named by table entry q leaves its slab's live bytes. */
+static void rsx_vc_live_sub(rsx_vcache* c, const rsx_vcache_ent* q)
+{
+    if (!c->evac_on || !rsx_vc_live(c, q)) return;
+    const u32 b = (q->hi - q->lo + 1u) * q->stride;
+    c->slab_live[q->slab] = c->slab_live[q->slab] > b ? c->slab_live[q->slab] - b : 0u;
+}
+
+/* The next slab after cur that may be recycled: never used, or unreferenced
+ * for min_age batches (>= 2: render_frame has waited for everything older
+ * than the previous batch). ~0u when there is none. Stamps only move forward
+ * within a batch, so a scan that finds none holds for the rest of it. The
+ * slab evac is emptying comes first once it has aged: opened later, a draw
+ * of a copy it still holds would stamp it again. */
+static u32 rsx_vc_next_free(rsx_vcache* c, u32 batch)
+{
+    if (c->nofree_batch == batch) return ~0u;
+    const u32 age = c->min_age < 2u ? 2u : c->min_age;
+    if (c->evac != ~0u && c->evac != c->cur && c->slab_last[c->evac] + age <= batch) return c->evac;
+    for (u32 k = 1; k < c->nslab; k++) {
+        const u32 s = (c->cur + k) % c->nslab;
+        if (!c->slab_used[s] || c->slab_last[s] + age <= batch) return s;
+    }
+    c->nofree_batch = batch;
+    rsx_vc_evac_pick(c, batch);   /* none left: empty one */
+    return ~0u;
+}
+
+/* Would rsx_vc_alloc succeed? (No side effects except the no-free memo and
+ * evac's choice of a slab to empty.) */
+static int rsx_vc_can_alloc(rsx_vcache* c, u64 bytes, u32 stride, u32 batch)
+{
+    if (bytes > RSX_VCACHE_SLAB) return 0;
+    if (rsx_vc_fit(c, c->cur, c->slab_used[c->cur], bytes, stride) != ~0ull) return 1;
+    const u32 nx = rsx_vc_next_free(c, batch);
+    return nx != ~0u && rsx_vc_fit(c, nx, 0, bytes, stride) != ~0ull;
+}
+
+/* Arena offset of `bytes` (stride-aligned) in the current slab, else in the
+ * next recyclable slab; ~0 when there is none. */
+static u64 rsx_vc_alloc(rsx_vcache* c, u64 bytes, u32 stride, u32 batch, u32* slab)
+{
+    if (bytes > RSX_VCACHE_SLAB) return ~0ull;
+    u64 g = rsx_vc_fit(c, c->cur, c->slab_used[c->cur], bytes, stride);
+    if (g == ~0ull) {
+        const u32 nx = rsx_vc_next_free(c, batch);
+        if (nx == ~0u || rsx_vc_fit(c, nx, 0, bytes, stride) == ~0ull) return ~0ull;
+        if (c->slab_used[nx]) c->recycled++;
+        if (++c->slab_gen[nx] == 0) c->slab_gen[nx] = 1;   /* its entries die */
+        c->slab_used[nx] = 0;
+        c->slab_live[nx] = 0;
+        if (nx == c->evac) c->evac = ~0u;                  /* emptied */
+        c->cur = nx;
+        g = rsx_vc_fit(c, nx, 0, bytes, stride);
+        rsx_vc_evac_pick(c, batch);
+    }
+    c->slab_used[c->cur] = (u32)(g + bytes - (c->base + (u64)c->cur * RSX_VCACHE_SLAB));
+    c->slab_last[c->cur] = batch;
+    *slab = c->cur;
+    return g;
+}
+
+/* ---- VCACHE_VERIFY (diagnostic) ----------------------------------------- */
+
+int rsx_vcache_verify_on(rsx_vcache* c)
+{
+    if (c->ver || !c->nslab) return c->ver != NULL;
+    rsx_vcache_ver* v = (rsx_vcache_ver*)calloc(1, sizeof *v);
+    if (!v) return 0;
+    v->ref = (u32*)calloc((size_t)c->nslab * (RSX_VCACHE_SLAB / 16u), sizeof(u32));
+    if (!v->ref) { free(v); return 0; }
+    c->ver = v;
+    return 1;
+}
+
+void rsx_vcache_verify_clear(rsx_vcache* c)
+{
+    if (c->ver) memset(c->ver->ref, 0, (size_t)c->nslab * (RSX_VCACHE_SLAB / 16u) * sizeof(u32));
+}
+
+/* A conversion into [go, go + bytes) of the region in batch `batch`: none of
+ * its bytes may be one a draw of this batch or of the previous one read
+ * (stamp 1 + B with B >= batch - 1). */
+static void rsx_vcv_write(rsx_vcache* c, u64 go, u64 bytes, u32 batch)
+{
+    rsx_vcache_ver* v = c->ver;
+    const u64 a = (go - c->base) / 16u, b = (go - c->base + bytes + 15u) / 16u;
+    u64 bad = 0;
+    u32 worst = 0;
+    for (u64 i = a; i < b; i++) {
+        const u32 r = v->ref[i];
+        if (r && r >= batch) { bad++; if (r > worst) worst = r; }
+    }
+    v->writes++;
+    if (!bad) return;
+    v->unsafe_writes++;
+    v->unsafe_gran += bad;
+    if (v->nlog < 8u) {
+        v->nlog++;
+        fprintf(stderr, "[VCVERIFY] UNSAFE write batch %u: arena 0x%llx +%llu over %llu granules a draw of batch %u"
+                        " read%c", batch, (unsigned long long)go, (unsigned long long)bytes,
+                (unsigned long long)bad, worst - 1u, 10);
+    }
+}
+
+/* A draw the cache serves from the copy at arena offset g: the copy's bytes
+ * are stamped with the batch (first, so a comparison skipped for want of
+ * memory still guards them), then the reference conversion of the plan's
+ * range is compared against the copy. */
+static void rsx_vcv_serve(rsx_vcache* c, const rsx_vfetch_plan* p, const u8* arena, u64 g,
+                          u32 n, u32 stride, u32 batch)
+{
+    rsx_vcache_ver* v = c->ver;
+    const u64 bytes = (u64)n * stride;
+    const u64 r0 = (g - c->base) / 16u, r1 = (g - c->base + bytes + 15u) / 16u;
+    for (u64 i = r0; i < r1; i++) v->ref[i] = batch + 1u;
+    if (bytes > v->tmp_cap) {
+        u8* t = (u8*)realloc(v->tmp, (size_t)bytes);
+        if (!t) return;
+        v->tmp = t; v->tmp_cap = bytes;
+    }
+    rsx_ve_convert(p, NULL, p->vlo, n, v->tmp, stride);   /* as the stream path would */
+    const u32 vb = p->nslots * 16u <= stride ? p->nslots * 16u : stride;   /* bytes the layout reads */
+    if (vb != stride) v->odd_stride++;
+    u64 diff = 0;
+    for (u32 j = 0; j < n; j++) {
+        const u8* x = arena + g + (u64)j * stride;
+        const u8* y = v->tmp + (u64)j * stride;
+        for (u32 k = 0; k < vb; k += 16u) {
+#if RSX_VF_SSE41
+            const __m128i a = _mm_stream_load_si128((__m128i*)(void*)(x + k));   /* write-combined */
+            const __m128i b = _mm_loadu_si128((const __m128i*)(const void*)(y + k));
+            u32 eq = (u32)_mm_movemask_epi8(_mm_cmpeq_epi8(a, b));
+            for (; eq != 0xFFFFu; eq |= eq + 1u) diff++;   /* one per differing byte */
+#else
+            for (u32 q = 0; q < 16u; q++) diff += x[k + q] != y[k + q];
+#endif
+        }
+    }
+    v->draws++;
+    v->bytes += (u64)n * vb;
+    if (diff) {
+        v->diff_draws++;
+        v->diff_bytes += diff;
+        if (v->nlog < 8u) {
+            v->nlog++;
+            fprintf(stderr, "[VCVERIFY] DIFF batch %u: range %u..%u stride %u at arena 0x%llx, %llu bytes differ%c",
+                    batch, p->vlo, p->vhi, stride, (unsigned long long)g, (unsigned long long)diff, 10);
+        }
+    }
+}
+
+/* First probe slot of range [vlo, vhi] at `stride` under plan signature sig
+ * (rsx_vfetch_plan_sig(p, 1)). */
+static u32 rsx_vc_slot(const rsx_vcache* c, u64 sig, u32 vlo, u32 vhi, u32 stride)
+{
+    const u64 kh = rsx_mix64(rsx_mix64(sig, vlo | ((u64)vhi << 32)), stride);
+    return (u32)(kh ^ (kh >> 29)) & (c->nent - 1u);
+}
+
+/* admit2: of the 8 probe entries from `slot` (all live), the least recently
+ * used one that no draw used for min_age batches; NULL when every one was used
+ * since. Replacing an entry never writes the arena (its copy is left to its
+ * slab's recycling). */
+static rsx_vcache_ent* rsx_vc_lru(rsx_vcache* c, u32 slot, u32 batch)
+{
+    const u32 age = c->min_age < 2u ? 2u : c->min_age;
+    rsx_vcache_ent* best = NULL;
+    for (u32 i = 0; i < 8; i++) {
+        rsx_vcache_ent* q = &c->ent[(slot + i) & (c->nent - 1u)];
+        if (q->last + age <= batch && (!best || q->last < best->last)) best = q;
+    }
+    return best;
+}
+
+/* rsx_vcache_get; sigp: rsx_vfetch_plan_sig(p, 1) when the caller already has
+ * it (VEMIT_FAST), else NULL. */
+static int rsx_vc_get(rsx_vcache* c, const rsx_vfetch_plan* p, u32 stride,
+                      u8* arena, u32 batch, u64* g, int* hit, const u64* sigp)
+{
+    *hit = 0;
+    if (!c->nent || !p->hashable || stride < 16u || (stride & 15u) || p->vhi < p->vlo) return 0;
+    const u32 n = p->vhi - p->vlo + 1u;
+    const u64 bytes = (u64)n * stride;
+    if (bytes > RSX_VCACHE_SLAB) return 0;
+    const u64 sig = sigp ? *sigp : rsx_vfetch_plan_sig(p, 1);
+    const u32 m = c->nent - 1u, slot = rsx_vc_slot(c, sig, p->vlo, p->vhi, stride);
+    rsx_vcache_ent* e = NULL;
+    rsx_vcache_ent* victim = NULL;
+    for (u32 i = 0; i < 8; i++) {
+        rsx_vcache_ent* q = &c->ent[(slot + i) & m];
+        if (q->slab_gen && q->sig == sig && q->lo == p->vlo && q->hi == p->vhi && q->stride == stride) { e = q; break; }
+        if (!victim && !rsx_vc_live(c, q)) victim = q;
+    }
+    rsx_vcache_diag* const dg = c->dg;   /* VCACHE_STATS */
+    const u32 nseen = dg ? rsx_vcd_seen(dg, rsx_mix64(rsx_mix64(sig, p->vlo | ((u64)p->vhi << 32)), stride),
+                                        batch, (u32)bytes) : 0;
+    const int first = nseen == 1;
+    if (e && e->bypass) { e->bypass--; e->last = batch; c->bypassed++; return 0; }
+    /* admit2: a key the table does not hold and the filter has not seen is
+     * held back -- its key goes into the filter and the draw to the stream
+     * path; nothing is hashed, allocated or converted. Seen (a second
+     * sighting), it goes on to be admitted. */
+    if (!e && c->admit2) {
+        const u64 k = rsx_mix64(rsx_mix64(sig, p->vlo | ((u64)p->vhi << 32)), stride) | 1u;
+        u64* f = &c->seen[(u32)(k >> 32) & (RSX_VCACHE_SEEN - 1u)];
+        if (*f != k) { *f = k; c->held++; return 0; }
+    }
+    const int live = e && rsx_vc_live(c, e);
+    /* admit2: a new key whose probe window holds only ranges the frames still
+     * use is refused before anything is hashed or allocated (nothing below
+     * changes the table before the victim is taken) */
+    rsx_vcache_ent* lru = NULL;
+    if (!e && !victim && c->admit2) {
+        lru = rsx_vc_lru(c, slot, batch);
+        if (!lru) { c->refused++; return 0; }
+    }
+    /* Anything but a hit needs room; when there is none, give up before
+     * paying for the content hash (the overflow of a working set larger
+     * than the region lands here every draw). */
+    if (!live && !rsx_vc_can_alloc(c, bytes, stride, batch)) {
+        c->nofit++;
+        if (dg) { if (first) dg->nofit_first++; else dg->nofit_seen++; }
+        return 0;
+    }
+    u64 h;
+    if (!rsx_vf_hash_sig(p, sig, &h)) return 0;
+    if (live && e->h == h && e->slab == c->evac) {
+        /* evac: the copy is in the slab being emptied -- convert the range
+         * again into the current slab (as a miss would) and serve that, or
+         * take the stream path; the old copy is not read, the slab not
+         * stamped. */
+        u32 slab;
+        const u64 go = rsx_vc_alloc(c, bytes, stride, batch, &slab);
+        if (go == ~0ull) {
+            c->nofit++;
+            if (dg) dg->nofit_seen++;
+            return 0;
+        }
+        if (c->ver) rsx_vcv_write(c, go, bytes, batch);   /* VCACHE_VERIFY */
+        rsx_ve_convert(p, NULL, p->vlo, n, arena + go, stride);
+        rsx_vc_live_sub(c, e);
+        e->g = go; e->slab = (u16)slab; e->slab_gen = c->slab_gen[slab]; e->dyn = 0; e->last = batch;
+        c->slab_live[slab] += (u32)bytes;
+        *g = go; c->moved++;
+        if (dg) { rsx_vcache_dg* s = &dg->ent[e - c->ent]; s->last = batch; s->hits++; }
+        if (c->ver) rsx_vcv_serve(c, p, arena, go, n, stride, batch);   /* VCACHE_VERIFY */
+        return 1;
+    }
+    if (live && e->h == h) {
+        c->slab_last[e->slab] = batch;
+        e->dyn = 0; e->last = batch;
+        *g = e->g; *hit = 1; c->hits++;
+        if (dg) { rsx_vcache_dg* s = &dg->ent[e - c->ent]; s->last = batch; s->hits++; }
+        if (c->ver) rsx_vcv_serve(c, p, arena, e->g, n, stride, batch);   /* VCACHE_VERIFY */
+        return 1;
+    }
+    u8 dyn = 0;
+    if (e) {
+        if (live) {                       /* same range, new content */
+            dyn = (u8)(e->dyn + 1u);
+            if (dyn >= 2u) { e->dyn = 0; e->bypass = 64; c->bypassed++; return 0; }
+        } else dyn = e->dyn;              /* its slab was recycled */
+        victim = e;
+    }
+    if (!victim) victim = lru;            /* admit2: never a range the frames still use */
+    if (!victim) victim = &c->ent[slot];  /* forgetting a live entry is harmless */
+    u32 slab;
+    const u64 go = rsx_vc_alloc(c, bytes, stride, batch, &slab);
+    if (go == ~0ull) {
+        c->nofit++;
+        if (dg) { if (first) dg->nofit_first++; else dg->nofit_seen++; }
+        return 0;
+    }
+    if (c->ver) rsx_vcv_write(c, go, bytes, batch);   /* VCACHE_VERIFY */
+    rsx_ve_convert(p, NULL, p->vlo, n, arena + go, stride);
+    if (dg) rsx_vcd_admit(c, victim, e, live, nseen, batch);
+    rsx_vc_live_sub(c, victim);                        /* evac: its old copy */
+    if (c->evac_on) c->slab_live[slab] += (u32)bytes;
+    victim->sig = sig; victim->h = h; victim->g = go;
+    victim->lo = p->vlo; victim->hi = p->vhi; victim->stride = stride;
+    victim->slab = (u16)slab; victim->slab_gen = c->slab_gen[slab];
+    victim->dyn = dyn; victim->bypass = 0; victim->last = batch;
+    *g = go; c->misses++;
+    if (c->ver) rsx_vcv_serve(c, p, arena, go, n, stride, batch);   /* VCACHE_VERIFY */
+    return 1;
+}
+
+int rsx_vcache_get(rsx_vcache* c, const rsx_vfetch_plan* p, u32 stride,
+                   u8* arena, u32 batch, u64* g, int* hit)
+{
+    return rsx_vc_get(c, p, stride, arena, batch, g, hit, NULL);
+}
+
+/* ---- one draw entry ------------------------------------------------------ */
+
+static u32* rsx_vemit_scratch(size_t n)
+{
+    static u32* b; static size_t cap;
+    if (n > cap) {
+        u32* nb = (u32*)realloc(b, n * sizeof(u32));
+        if (!nb) return NULL;
+        b = nb; cap = n;
+    }
+    return b;
+}
+
+/* ---- rsx_vemit_run's per-index loops --------------------------------------
+ * Every DRAW_INDEX_ARRAY entry (up to 256 indices) runs these, so they are
+ * written for throughput; each produces exactly what the plain loop in its
+ * comment does. */
+
+/* gvi[k] = big-endian u16 q[k], k < n; returns min/max of gvi. */
+static void rsx_ve_idx16(const u8* q, u32 n, u32* gvi, u32* lo_out, u32* hi_out)
+{
+    u32 k = 0, lo = 0xFFFFFFFFu, hi = 0;
+#if RSX_VF_SSE41
+    if (n >= 8) {
+        const __m128i sl = _mm_setr_epi8(1, 0, -1, -1, 3, 2, -1, -1, 5, 4, -1, -1, 7, 6, -1, -1);
+        const __m128i sh = _mm_setr_epi8(9, 8, -1, -1, 11, 10, -1, -1, 13, 12, -1, -1, 15, 14, -1, -1);
+        __m128i vlo = _mm_set1_epi32(-1), vhi = _mm_setzero_si128();
+        for (; k + 8 <= n; k += 8) {
+            const __m128i x = _mm_loadu_si128((const __m128i*)(q + 2u * k));
+            const __m128i a = _mm_shuffle_epi8(x, sl), b = _mm_shuffle_epi8(x, sh);
+            _mm_storeu_si128((__m128i*)(gvi + k), a);
+            _mm_storeu_si128((__m128i*)(gvi + k + 4), b);
+            vlo = _mm_min_epu32(vlo, _mm_min_epu32(a, b));
+            vhi = _mm_max_epu32(vhi, _mm_max_epu32(a, b));
+        }
+        vlo = _mm_min_epu32(vlo, _mm_shuffle_epi32(vlo, _MM_SHUFFLE(1, 0, 3, 2)));
+        vlo = _mm_min_epu32(vlo, _mm_shuffle_epi32(vlo, _MM_SHUFFLE(2, 3, 0, 1)));
+        vhi = _mm_max_epu32(vhi, _mm_shuffle_epi32(vhi, _MM_SHUFFLE(1, 0, 3, 2)));
+        vhi = _mm_max_epu32(vhi, _mm_shuffle_epi32(vhi, _MM_SHUFFLE(2, 3, 0, 1)));
+        lo = (u32)_mm_cvtsi128_si32(vlo); hi = (u32)_mm_cvtsi128_si32(vhi);
+    }
+#endif
+    for (; k < n; k++) {
+        const u32 v = ((u32)q[2u * k] << 8) | q[2u * k + 1u];
+        gvi[k] = v;
+        if (v < lo) lo = v;
+        if (v > hi) hi = v;
+    }
+    *lo_out = lo; *hi_out = hi;
+}
+
+/* gvi[k] = big-endian u32 q[k], k < n; returns min/max of gvi. */
+static void rsx_ve_idx32(const u8* q, u32 n, u32* gvi, u32* lo_out, u32* hi_out)
+{
+    u32 k = 0, lo = 0xFFFFFFFFu, hi = 0;
+#if RSX_VF_SSE41
+    if (n >= 4) {
+        const __m128i sw = _mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12);
+        __m128i vlo = _mm_set1_epi32(-1), vhi = _mm_setzero_si128();
+        for (; k + 4 <= n; k += 4) {
+            const __m128i a = _mm_shuffle_epi8(_mm_loadu_si128((const __m128i*)(q + 4u * k)), sw);
+            _mm_storeu_si128((__m128i*)(gvi + k), a);
+            vlo = _mm_min_epu32(vlo, a);
+            vhi = _mm_max_epu32(vhi, a);
+        }
+        vlo = _mm_min_epu32(vlo, _mm_shuffle_epi32(vlo, _MM_SHUFFLE(1, 0, 3, 2)));
+        vlo = _mm_min_epu32(vlo, _mm_shuffle_epi32(vlo, _MM_SHUFFLE(2, 3, 0, 1)));
+        vhi = _mm_max_epu32(vhi, _mm_shuffle_epi32(vhi, _MM_SHUFFLE(1, 0, 3, 2)));
+        vhi = _mm_max_epu32(vhi, _mm_shuffle_epi32(vhi, _MM_SHUFFLE(2, 3, 0, 1)));
+        lo = (u32)_mm_cvtsi128_si32(vlo); hi = (u32)_mm_cvtsi128_si32(vhi);
+    }
+#endif
+    for (; k < n; k++) {
+        const u32 v = ((u32)q[4u * k] << 24) | ((u32)q[4u * k + 1u] << 16) |
+                      ((u32)q[4u * k + 2u] << 8) | q[4u * k + 3u];
+        gvi[k] = v;
+        if (v < lo) lo = v;
+        if (v > hi) hi = v;
+    }
+    *lo_out = lo; *hi_out = hi;
+}
+
+/* ib[j] = vis[j] + add (mod 2^32), j < n. ib may be write-combined memory:
+ * only written, in order. */
+static void rsx_ve_emit_ib(u32* ib, const u32* vis, u32 n, u32 add)
+{
+    u32 j = 0;
+#if RSX_VF_SSE41
+    const __m128i va = _mm_set1_epi32((int)add);
+    for (; j + 4 <= n; j += 4)
+        _mm_storeu_si128((__m128i*)(ib + j),
+                         _mm_add_epi32(_mm_loadu_si128((const __m128i*)(vis + j)), va));
+#endif
+    for (; j < n; j++) ib[j] = vis[j] + add;
+}
+
+/* Distinct values among gvi[0..n), all in [lo, lo + span), span <= 4096 --
+ * the popcount of the old 4096-bit set. A stamp per value instead of a bit:
+ * the old bitmap's read-modify-write of one word chained every index that
+ * fell into the same 64-vertex block through the store buffer. */
+static u32 rsx_ve_distinct(const u32* gvi, u32 n, u32 lo)
+{
+    static u32 stamp[4096];
+    static u32 gen;
+    if (++gen == 0) { memset(stamp, 0, sizeof stamp); gen = 1; }
+    const u32 g = gen;
+    u32 uniq = 0;
+    for (u32 k = 0; k < n; k++) {
+        u32* s = &stamp[(gvi[k] - lo) & 4095u];
+        uniq += *s != g;
+        *s = g;
+    }
+    return uniq;
+}
+
+/* The reference rsx_vemit_run (VEMIT_FAST=0); rsx_vemit_run_fast below
+ * produces exactly what this does. */
+static u32 rsx_vemit_run_ref(rsx_vemit* e)
+{
+    const rsx_state* st = e->st;
+    const u32 used = rsx_vexpand_used(e->prim, e->count), nout = rsx_vexpand_count(e->prim, e->count);
+    const u32 stride = e->stride;
+    e->converted = 0; e->cached = 0;
+    if (!used || !nout || !vm_base || stride < 16u) return 0;
+    u32* buf = rsx_vemit_scratch((size_t)used + 3u * (size_t)nout);
+    if (!buf) return 0;
+    u32* gvi = buf; u32* vis = gvi + used + nout; u32* newv = vis + nout;
+    u32 lo, hi;
+    if (e->indexed) {
+        /* the old read_guest_index: SET_INDEX_ARRAY_DMA [3:0] location
+         * (0 local, 1 main), [7:4] type (1 = u16, else u32), big-endian;
+         * the base resolved once, entries at base + k * size */
+        const int local = ((st->index_array_dma & 0xF) == 0);
+        const u8* ip = vm_base + cellGcmResolveLocated(local, st->index_array_offset);
+        if (((st->index_array_dma >> 4) & 0xF) == 1)
+            rsx_ve_idx16(ip + (u64)e->first * 2u, used, gvi, &lo, &hi);
+        else
+            rsx_ve_idx32(ip + (u64)e->first * 4u, used, gvi, &lo, &hi);
+    } else {
+        lo = 0xFFFFFFFFu; hi = 0;
+        for (u32 k = 0; k < used; k++) {
+            const u32 v = e->first + k;
+            gvi[k] = v;
+            if (v < lo) lo = v;
+            if (v > hi) hi = v;
+        }
+    }
+    /* vis[j] = gvi[order[j]] for rsx_vexpand's order, built directly: the
+     * triangle list itself is gvi. */
+    switch (e->prim) {
+    case RSX_PRIMITIVE_TRIANGLES:
+        vis = gvi;                                   /* order[j] = j, nout == used */
+        break;
+    case RSX_PRIMITIVE_QUADS:
+        for (u32 q = 0, o = 0; q < e->count / 4u; q++, o += 6u) {
+            const u32* v = gvi + q * 4u;             /* (v0,v1,v2) (v0,v2,v3) */
+            vis[o] = v[0]; vis[o + 1] = v[1]; vis[o + 2] = v[2];
+            vis[o + 3] = v[0]; vis[o + 4] = v[2]; vis[o + 5] = v[3];
+        }
+        break;
+    default: {                                       /* STRIP / FAN (count >= 3) */
+        const int fan = e->prim == RSX_PRIMITIVE_TRIANGLE_FAN;
+        for (u32 t = 0, o = 0; t < e->count - 2u; t++, o += 3u) {
+            u32 i1 = t + 1, i2 = t + 2;
+            if (!fan && (t & 1)) { u32 x = i1; i1 = i2; i2 = x; }   /* strip winding */
+            vis[o] = gvi[fan ? 0 : t]; vis[o + 1] = gvi[i1]; vis[o + 2] = gvi[i2];
+        }
+        break; }
+    }
+
+    rsx_vfetch_plan plan;
+    rsx_vfetch_plan_init(&plan, st, e->mask, lo, hi);
+
+    /* The cache converts, stores and hashes the whole planned range, so it
+     * only pays when the range is mostly vertices this entry reads: span <=
+     * 1.25 x distinct + 16. Sparse ranges -- and index orders whose
+     * consecutive entries keep reaching far back, which would cache the same
+     * vertices in many overlapping ranges -- take the per-record dedupe.
+     * distinct <= used, so a span past used + used/4 + 16 cannot pass, and
+     * one of at most 16 always does: neither needs the count. */
+    int dense = 0;
+    if (e->vc && e->vc->nent && (u64)(hi - lo) < 4096u) {
+        const u32 span = hi - lo + 1u;
+        if (span <= 16u) dense = 1;
+        else if ((u64)span <= (u64)used + used / 4u + 16u) {
+            const u32 uniq = rsx_ve_distinct(gvi, used, lo);
+            dense = span <= uniq + uniq / 4u + 16u;
+        }
+    }
+    if (dense) {
+        u64 g; int hit;
+        if (rsx_vcache_get(e->vc, &plan, stride, e->arena, e->batch, &g, &hit)) {
+            const u32 e0 = (u32)(g / stride);
+            rsx_ve_emit_ib(e->ib, vis, nout, e0 - lo);   /* e0 + (vis[j] - lo) */
+            if (!hit) e->converted = hi - lo + 1u;
+            e->cached = 1;
+            return nout;
+        }
+    }
+
+    /* Stream half: each distinct vertex converted once per record (dd). The
+     * table must not outlive the attribute setup it was filled under. */
+    const u64 sig = rsx_vfetch_plan_sig(&plan, 0) ^ ((u64)stride << 48);
+    if (sig != *e->dd_sig) { rsx_vdedupe_reset(e->dd); *e->dd_sig = sig; }
+    const u64 g0 = ((e->half0 + e->vb_used + stride - 1u) / stride) * stride;
+    if (g0 + (u64)used * stride > e->half0 + e->half_bytes) return 0;
+    u32 next = (u32)(g0 / stride);
+    const u32 nn = rsx_vdedupe_run(e->dd, vis, nout, &next, e->ib, newv);
+    /* The check above counts distinct indices, but the table is direct-mapped:
+     * an index evicted by a colliding one is converted again when it recurs
+     * (QUADS reuse v0/v2, strips and fans every vertex), so nn can reach nout.
+     * Re-check the real count; the table entries just made point at elements
+     * that will not be written, so drop them. ib entries already written are
+     * harmless: the caller does not advance vp_ib_used on 0. */
+    if (g0 + (u64)nn * stride > e->half0 + e->half_bytes) { rsx_vdedupe_reset(e->dd); return 0; }
+    if (nn) {
+        rsx_vfetch_convert(&plan, newv, 0, nn, e->arena + g0, stride);
+        e->vb_used = (u32)(g0 + (u64)nn * stride - e->half0);
+    }
+    e->converted = nn;
+    return nout;
+}
+
+/* ======================================================================
+ * rsx_vemit_run, fast path (VEMIT_FAST; VEMIT_FAST=0 runs rsx_vemit_run_ref)
+ *
+ * The same control flow and the same results as the reference -- every ib
+ * entry, arena byte, vb_used, dedupe-table byte and vertex-cache field --
+ * with cheaper pieces. In the game the RSX thread reaches each entry with the
+ * guest index / vertex lines and the path's own tables (dedupe table, cache
+ * entries) out of L1/L2 (the FIFO walk, the record capture and the texture
+ * hashing in between evict them), so most of the per-entry time was waiting:
+ *   - prefetch, all of it hints (no value depends on one; a prefetch never
+ *     faults, so a span may run past committed guest memory):
+ *       rsx_vemit_prefetch  the backend announces the entry before it builds
+ *                           the record: the index span (non-indexed: the
+ *                           head of each array) is in flight meanwhile;
+ *       next chunk          a full 256-index entry is usually followed by the
+ *                           next 256 of the same stream: requested as soon as
+ *                           this entry's indices are read;
+ *       plan                the head of each vertex span, as it is resolved;
+ *       cache probe         the first probe lines, before the distinct count;
+ *       dedupe              each index's table entry, 16 indices ahead;
+ *       conversion          each gathered vertex, 8 vertices ahead.
+ *     VPREFETCH=0 turns all of them off.
+ *   - rsx_ve_plan_init: rsx_vfetch_plan_init over the mask's set bits, the
+ *     element size from a table instead of a switch.
+ *   - rsx_ve_plan_sigs: both plan signatures as two interleaved chains, and
+ *     only when the entry can use them (the cache key when it is a cache
+ *     candidate, the dedupe key otherwise / afterwards).
+ *   - rsx_ve_distinct_fast: a byte mark per value and a SAD sum.
+ *   - rsx_ve_dedupe_fast: the (vi, g) pair probed and stored as one 8-byte
+ *     word -- the same table bytes.
+ *   - rsx_vk_convert: rsx_vfetch_convert with each slot's type and size fixed
+ *     per call (one dispatch per slot instead of a nested switch), the element
+ *     address folded to base + ei * stride (the same u32 arithmetic) and the
+ *     same instructions per element (bswap/shuffle, the half-float integer
+ *     path, the same divps by the same constants) -- bit-identical under any
+ *     MXCSR mode.
+ * ==================================================================== */
+
+static int rsx_ve_fast_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("VEMIT_FAST"); v = !(e && *e == '0'); }
+    return v;
+}
+static int rsx_ve_pf_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("VPREFETCH"); v = !(e && *e == '0'); }
+    return v;
+}
+#if RSX_VF_SSE41
+static int rsx_ve_check_on(void)   /* VFETCH_CHECK, read as rsx_vfetch_convert does */
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("VFETCH_CHECK"); v = (e && *e && *e != '0') ? 1 : 0; }
+    return v;
+}
+#endif
+
+#if defined(__clang__) || defined(__GNUC__)
+#define RSX_VE_INLINE static inline __attribute__((always_inline))
+#define RSX_VE_PREFETCH(a) __builtin_prefetch((const void*)(a), 0, 3)
+static inline u32 rsx_ve_ctz(u32 m) { return (u32)__builtin_ctz(m); }
+#else
+#define RSX_VE_INLINE static __forceinline
+#define RSX_VE_PREFETCH(a) ((void)(a))
+static inline u32 rsx_ve_ctz(u32 m) { u32 i = 0; while (!(m & 1u)) { m >>= 1; i++; } return i; }
+#endif
+
+#define RSX_VE_PF_LINES 16u   /* lines of an index span / a hinted array head (1 KB)   */
+#define RSX_VE_PF_HEAD  8u    /* lines at the head of each vertex span, at plan time:
+                               * the loops below prefetch ahead on their own, and a
+                               * long burst only queues behind the miss buffers      */
+#define RSX_VE_PFD_IDX  16u   /* dedupe: table entry requested this many indices ahead */
+#define RSX_VE_PFD_VTX  8u    /* conversion: vertex requested this many vertices ahead */
+
+/* Prefetch the cache lines of host [p, p + len), at most maxl of them. */
+static inline void rsx_ve_pf(const u8* p, u64 len, u32 maxl)
+{
+    uintptr_t a = (uintptr_t)p & ~(uintptr_t)63u;
+    const uintptr_t end = (uintptr_t)p + (uintptr_t)len;
+    for (u32 k = 0; a < end && k < maxl; a += 64u, k++) RSX_VE_PREFETCH(a);
+}
+
+void rsx_vemit_prefetch(const rsx_state* st, u32 prim, u32 first, u32 count, int indexed)
+{
+    if (!st || !vm_base || !rsx_ve_fast_on() || !rsx_ve_pf_on()) return;
+    const u32 used = rsx_vexpand_used(prim, count);
+    if (!used) return;
+    if (indexed) {
+        /* the span rsx_vemit_run reads: the base resolved once, entries at
+         * base + k * size */
+        const int local = ((st->index_array_dma & 0xF) == 0);
+        const u64 sz = (((st->index_array_dma >> 4) & 0xF) == 1) ? 2u : 4u;
+        const u8* ip = vm_base + cellGcmResolveLocated(local, st->index_array_offset);
+        rsx_ve_pf(ip + (u64)first * sz, (u64)used * sz, RSX_VE_PF_LINES);
+        return;
+    }
+    /* the head of vertices first .. first + used - 1 of every enabled
+     * per-vertex array; an interleaved array starting inside the span just
+     * requested is skipped */
+    uintptr_t lo = 0, hi = 0;
+    for (u32 i = 0; i < 16; i++) {
+        const rsx_vertex_attrib* a = &st->vertex_attribs[i];
+        if (!a->enabled || !a->stride || a->frequency > 1) continue;
+        const u32 off = (a->offset & 0x7FFFFFFFu) + first * a->stride;
+        const u8* h = vm_base + cellGcmResolveLocated((a->offset & 0x80000000u) ? 0 : 1, off);
+        if ((uintptr_t)h >= lo && (uintptr_t)h < hi) continue;
+        const u64 len = (u64)(used - 1u) * a->stride + 16u;
+        rsx_ve_pf(h, len, RSX_VE_PF_LINES);
+        lo = (uintptr_t)h; hi = (uintptr_t)h + (uintptr_t)len;
+    }
+}
+
+/* rsx_vfetch_plan_init, slot for slot (the same fields, the same zeroes),
+ * iterating the mask's set bits; with pf, the head of each FAST slot's
+ * element span is requested as soon as it is resolved (once per interleaved
+ * buffer). */
+static void rsx_ve_plan_init(rsx_vfetch_plan* p, const rsx_state* st, u32 mask, u32 vlo, u32 vhi, int pf)
+{
+    /* bytes per component of types 1..7 (6, CMP, is one 4-byte word); types
+     * 0 and > 7 are SLOW with bytes 0, as in the reference's switch */
+    static const u8 cb[8] = { 0, 2, 4, 2, 1, 2, 0, 1 };
+    p->st = st;
+    p->mask = mask & 0xFFFFu;
+    p->nslots = 0;
+    p->vlo = vlo; p->vhi = vhi;
+    p->hashable = 1;
+    if (vhi < vlo) vhi = vlo;
+    const int nofreq = rsx_vf_nofreq();
+    uintptr_t pf_lo = 0, pf_hi = 0;
+    for (u32 m = p->mask; m; m &= m - 1u) {
+        const u32 i = rsx_ve_ctz(m);
+        rsx_vf_slot* s = &p->s[p->nslots++];
+        memset(s, 0, sizeof *s);
+        s->idx = (u8)i;
+        memcpy(s->k, st->vertex_data4f[i], sizeof s->k);
+        const rsx_vertex_attrib* a = &st->vertex_attribs[i];
+        if (!a->enabled || a->stride == 0 || !vm_base) { s->mode = RSX_VF_CONST; continue; }
+        s->stride = a->stride;
+        s->freq = a->frequency;
+        s->off = a->offset & 0x7FFFFFFFu;
+        s->loc = (a->offset & 0x80000000u) ? 0 : 1;
+        if (a->frequency > 1 && !nofreq)
+            s->fmode = (st->frequency_divider_op & (1u << i)) ? 2 : 1;
+        u32 n = a->size ? a->size : 4; if (n > 4) n = 4;
+        s->n = (u8)n;
+        s->type = (u8)a->type;
+        if (a->type == 0 || a->type > 7) { s->mode = RSX_VF_SLOW; p->hashable = 0; continue; }
+        s->bytes = (u8)(a->type == 6 ? 4u : cb[a->type] * n);
+        u32 elo, ehi;
+        if (s->fmode == 0)      { elo = vlo; ehi = vhi; }
+        else if (s->fmode == 1) { elo = vlo / s->freq; ehi = vhi / s->freq; }
+        else {
+            const u32 f = s->freq;
+            if (vhi - vlo >= f - 1u) { elo = 0; ehi = f - 1u; }
+            else {
+                const u32 r0 = vlo % f, r1 = vhi % f;
+                if (r0 <= r1) { elo = r0; ehi = r1; } else { elo = 0; ehi = f - 1u; }
+            }
+        }
+        u32 ea0;
+        if (!rsx_vf_linear(s, elo, ehi, &ea0)) { s->mode = RSX_VF_SLOW; p->hashable = 0; continue; }
+        s->mode = RSX_VF_FAST;
+        s->elo = elo; s->ehi = ehi; s->ea0 = ea0;
+        if (pf) {
+            const u8* h = vm_base + ea0;
+            if ((uintptr_t)h < pf_lo || (uintptr_t)h >= pf_hi) {
+                const u64 len = (u64)(ehi - elo) * s->stride + s->bytes;
+                rsx_ve_pf(h, len, RSX_VE_PF_HEAD);
+                pf_lo = (uintptr_t)h; pf_hi = (uintptr_t)h + (uintptr_t)len;
+            }
+        }
+    }
+}
+
+/* rsx_vfetch_plan_sig(p, 0) and rsx_vfetch_plan_sig(p, 1), mix for mix, as two
+ * interleaved chains (the multiplies of one hide the other's latency). */
+static void rsx_ve_plan_sigs(const rsx_vfetch_plan* p, u64* sig0, u64* sig1)
+{
+    u64 h0 = rsx_mix64(0x5EEDull, p->mask | ((u64)p->nslots << 16) | ((u64)rsx_vf_nofreq() << 24));
+    u64 h1 = h0;
+    for (u32 si = 0; si < p->nslots; si++) {
+        const rsx_vf_slot* s = &p->s[si];
+        u64 k0, k1; memcpy(&k0, s->k, 8); memcpy(&k1, s->k + 2, 8);
+        const u64 w = (u64)s->mode | ((u64)s->type << 8) | ((u64)s->n << 16) | ((u64)s->fmode << 24) |
+                      ((u64)s->idx << 32) | ((u64)s->loc << 40);
+        h0 = rsx_mix64(h0, w);  h1 = rsx_mix64(h1, w);
+        h0 = rsx_mix64(h0, k0); h1 = rsx_mix64(h1, k0);
+        h0 = rsx_mix64(h0, k1); h1 = rsx_mix64(h1, k1);
+        if (s->mode == RSX_VF_CONST) continue;
+        const u64 sf = (u64)s->stride | ((u64)s->freq << 32);
+        h0 = rsx_mix64(h0, sf); h1 = rsx_mix64(h1, sf);
+        h0 = rsx_mix64(h0, (u64)s->off); h1 = rsx_mix64(h1, (u64)s->off);
+        if (s->mode == RSX_VF_FAST)
+            h1 = rsx_mix64(h1, (u64)s->ea0 | ((u64)s->elo << 32));
+    }
+    *sig0 = h0; *sig1 = h1;
+}
+
+/* rsx_ve_distinct for span = hi - lo + 1 <= 4096 (every gvi in [lo, hi]):
+ * mark each value's byte, sum the marks 16 at a time, clear them again (the
+ * array is all zero between calls). */
+static u32 rsx_ve_distinct_fast(const u32* gvi, u32 n, u32 lo, u32 span)
+{
+    static u64 markw[(4096u + 16u) / 8u];      /* 8-byte aligned; SSE below loads unaligned */
+    u8* const mark = (u8*)markw;
+    for (u32 k = 0; k < n; k++) mark[gvi[k] - lo] = 1;
+    const u32 nb = (span + 15u) & ~15u;
+    u32 uniq = 0;
+#if RSX_VF_SSE41
+    __m128i acc = _mm_setzero_si128();
+    for (u32 o = 0; o < nb; o += 16u) {
+        const __m128i v = _mm_loadu_si128((const __m128i*)(mark + o));
+        acc = _mm_add_epi64(acc, _mm_sad_epu8(v, _mm_setzero_si128()));
+        _mm_storeu_si128((__m128i*)(mark + o), _mm_setzero_si128());
+    }
+    uniq = (u32)_mm_cvtsi128_si32(acc) + (u32)_mm_extract_epi32(acc, 2);
+#else
+    for (u32 o = 0; o < nb; o++) { uniq += mark[o]; mark[o] = 0; }
+#endif
+    return uniq;
+}
+
+/* rsx_vdedupe_run with the entry's (vi, g) pair compared and stored as one
+ * little-endian 8-byte word (vi at +0, g at +4): the same table bytes, the
+ * same ib / newv / counts. The table (64 KB) is mostly out of L1/L2 when an
+ * entry starts, so each index's entry is requested RSX_VE_PFD_IDX ahead. */
+#define RSX_VE_DD_SLOT(vi) (((u32)(vi) * 2654435761u) >> (32 - RSX_VDEDUPE_BITS))
+static u32 rsx_ve_dedupe_fast(rsx_vdedupe* d, const u32* vis, u32 n, u32* next_elem, u32* ib, u32* newv, int pf)
+{
+    if (d->gen == 0) rsx_vdedupe_reset(d);
+    const u64 g64 = (u64)d->gen << 32;
+    u32 e = *next_elem, nn = 0;
+#define RSX_VE_DD_STEP(j)                                               \
+    do {                                                                \
+        const u32 vi = vis[j];                                          \
+        rsx_vdedupe_ent* t = &d->t[RSX_VE_DD_SLOT(vi)];                 \
+        const u64 key = (u64)vi | g64;                                  \
+        u64 cur; memcpy(&cur, t, 8);                                    \
+        const u32 te = t->e;                                            \
+        const u32 miss = cur != key;                                    \
+        const u32 el = RSX_VF_UNPREDICTABLE(miss) ? e : te;             \
+        memcpy(t, &key, 8);                                             \
+        t->e = el;                                                      \
+        ib[j] = el;                                                     \
+        newv[nn] = vi;                                                  \
+        nn += miss;                                                     \
+        e += miss;                                                      \
+    } while (0)
+    u32 j = 0;
+    if (pf && n > RSX_VE_PFD_IDX) {
+        for (u32 k = 0; k < RSX_VE_PFD_IDX; k++) RSX_VE_PREFETCH(&d->t[RSX_VE_DD_SLOT(vis[k])]);
+        for (; j < n - RSX_VE_PFD_IDX; j++) {
+            RSX_VE_PREFETCH(&d->t[RSX_VE_DD_SLOT(vis[j + RSX_VE_PFD_IDX])]);
+            RSX_VE_DD_STEP(j);
+        }
+    }
+    for (; j < n; j++) RSX_VE_DD_STEP(j);
+#undef RSX_VE_DD_STEP
+    *next_elem = e;
+    return nn;
+}
+
+/* ---- specialised conversion ----------------------------------------------- */
+#if RSX_VF_SSE41
+enum {
+    RSX_VK_CONST = 0, RSX_VK_GEN,
+    RSX_VK_F32 = 2,                 /* + n - 1 */
+    RSX_VK_F16 = 6, RSX_VK_UBN = 10, RSX_VK_UB = 14, RSX_VK_S1 = 18, RSX_VK_S32K = 22,
+    RSX_VK_CMP = 26
+};
+typedef struct rsx_vk {
+    u32 kind;
+    u32 base;        /* ea0 - elo * stride: element ei at vm_base + (u32)(base + ei * stride) */
+    u32 stride, elo, span;
+    const rsx_vf_slot* s;
+} rsx_vk;
+
+/* rsx_vf_conv with type / n / bytes constant at each call site: the same
+ * operations on the same values. */
+RSX_VE_INLINE void rsx_vk_conv(const u32 type, const u32 n, const u32 bytes, const float* k, const u8* p, float* d)
+{
+    const __m128i bswap32 = _mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12);
+    const __m128i bswap16 = _mm_setr_epi8(1, 0, 3, 2, 5, 4, 7, 6, 9, 8, 11, 10, 13, 12, 15, 14);
+    __m128 v;
+    switch (type) {
+    case 2: {
+        __m128i x; u32 w;
+        switch (n) {
+        case 4:  x = _mm_loadu_si128((const __m128i*)p); break;
+        case 3:  memcpy(&w, p + 8, 4);
+                 x = _mm_insert_epi32(_mm_loadl_epi64((const __m128i*)p), (int)w, 2); break;
+        case 2:  x = _mm_loadl_epi64((const __m128i*)p); break;
+        default: memcpy(&w, p, 4); x = _mm_cvtsi32_si128((int)w); break;
+        }
+        v = rsx_vf_keep(_mm_castsi128_ps(_mm_shuffle_epi8(x, bswap32)), k, n);
+        break; }
+    case 3: {
+        const __m128i h = _mm_cvtepu16_epi32(_mm_shuffle_epi8(
+            _mm_cvtsi64_si128((long long)rsx_vf_ld_upto8(p, bytes)), bswap16));
+        const __m128i sgn = _mm_slli_epi32(_mm_and_si128(h, _mm_set1_epi32(0x8000)), 16);
+        const __m128i em  = _mm_and_si128(h, _mm_set1_epi32(0x7FFF));
+        const __m128i ex  = _mm_srli_epi32(em, 10);
+        const __m128i nrm = _mm_or_si128(sgn, _mm_add_epi32(_mm_slli_epi32(em, 13), _mm_set1_epi32(112 << 23)));
+        const __m128i inf = _mm_or_si128(sgn, _mm_or_si128(_mm_set1_epi32(0x7F800000),
+                                _mm_slli_epi32(_mm_and_si128(h, _mm_set1_epi32(0x3FF)), 13)));
+        __m128i r = _mm_blendv_epi8(nrm, inf, _mm_cmpeq_epi32(ex, _mm_set1_epi32(31)));
+        r = _mm_blendv_epi8(r, sgn, _mm_cmpeq_epi32(ex, _mm_setzero_si128()));
+        v = rsx_vf_keep(_mm_castsi128_ps(r), k, n);
+        break; }
+    case 4:
+    case 7: {
+        const __m128i x = _mm_cvtepu8_epi32(_mm_cvtsi32_si128((int)(u32)rsx_vf_ld_upto8(p, bytes)));
+        v = _mm_cvtepi32_ps(x);
+        if (type == 4) v = _mm_div_ps(v, _mm_set1_ps(255.0f));
+        v = rsx_vf_keep(v, k, n);
+        break; }
+    case 1:
+    case 5: {
+        const __m128i x = _mm_cvtepi16_epi32(_mm_shuffle_epi8(
+            _mm_cvtsi64_si128((long long)rsx_vf_ld_upto8(p, bytes)), bswap16));
+        v = _mm_cvtepi32_ps(x);
+        if (type == 1) v = _mm_div_ps(v, _mm_set1_ps(32767.0f));
+        v = rsx_vf_keep(v, k, n);
+        break; }
+    default: {   /* 6: CMP 11:11:10, w = 1 regardless of size */
+        u32 raw; memcpy(&raw, p, 4);
+        raw = (raw >> 24) | ((raw >> 8) & 0xFF00u) | ((raw << 8) & 0xFF0000u) | (raw << 24);
+        const s32 x = ((s32)(raw << 21)) >> 21;
+        const s32 y = ((s32)(raw << 10)) >> 21;
+        const s32 z = ((s32)raw) >> 22;
+        v = _mm_div_ps(_mm_cvtepi32_ps(_mm_setr_epi32(x, y, z, 1)),
+                       _mm_setr_ps(1023.0f, 1023.0f, 511.0f, 1.0f));
+        break; }
+    }
+    _mm_storeu_ps(d, v);
+}
+
+/* The reference's per-slot code, for the slots and elements the specialised
+ * cases do not take (frequency divisor, SLOW, outside the planned range). */
+static void rsx_vk_gen(const rsx_vfetch_plan* p, const rsx_vf_slot* s, u32 vi, float* d)
+{
+    if (s->mode == RSX_VF_FAST) {
+        u32 ei = vi;
+        if (s->fmode == 1) ei = vi / s->freq;
+        else if (s->fmode == 2) ei = vi % s->freq;
+        if (ei - s->elo <= s->ehi - s->elo) {
+            rsx_vf_conv(s, vm_base + (u32)(s->ea0 + (ei - s->elo) * s->stride), d);
+            return;
+        }
+    } else if (s->mode == RSX_VF_CONST) {
+        memcpy(d, s->k, 16);
+        return;
+    }
+    float t[4];
+    rsx_fetch_attrib(p->st, s->idx, vi, t);
+    memcpy(d, t, 16);
+}
+
+static void rsx_vk_convert(const rsx_vfetch_plan* p, const u32* vis, u32 first, u32 n, void* out, u32 out_stride)
+{
+    rsx_vk vk[16];
+    const u32 ns = p->nslots;
+    for (u32 si = 0; si < ns; si++) {
+        const rsx_vf_slot* s = &p->s[si];
+        rsx_vk* q = &vk[si];
+        q->s = s;
+        q->base = s->ea0 - s->elo * s->stride;
+        q->stride = s->stride; q->elo = s->elo; q->span = s->ehi - s->elo;
+        if (s->mode == RSX_VF_CONST)                     q->kind = RSX_VK_CONST;
+        else if (s->mode != RSX_VF_FAST || s->fmode)     q->kind = RSX_VK_GEN;
+        else switch (s->type) {
+            case 2:  q->kind = RSX_VK_F32  + s->n - 1u; break;
+            case 3:  q->kind = RSX_VK_F16  + s->n - 1u; break;
+            case 4:  q->kind = RSX_VK_UBN  + s->n - 1u; break;
+            case 7:  q->kind = RSX_VK_UB   + s->n - 1u; break;
+            case 1:  q->kind = RSX_VK_S1   + s->n - 1u; break;
+            case 5:  q->kind = RSX_VK_S32K + s->n - 1u; break;
+            case 6:  q->kind = RSX_VK_CMP;              break;
+            default: q->kind = RSX_VK_GEN;              break;
+        }
+    }
+    /* Gathered vertices (vis: the record's new vertices in first-use order)
+     * are requested RSX_VE_PFD_VTX vertices ahead: per guest buffer
+     * (interleaved attributes share one) the lines of [base + vi * stride,
+     * + ext) -- its first and last byte. A sequential range (vis NULL) is
+     * left to the hardware prefetcher. */
+    u32 hb[4], hs[4], he[4], nh = 0;
+    if (vis && rsx_ve_pf_on()) {
+        for (u32 si = 0; si < ns; si++) {
+            const rsx_vk* q = &vk[si];
+            if (q->kind == RSX_VK_CONST || q->kind == RSX_VK_GEN) continue;
+            const u32 b = q->base, st = q->stride, nb = q->s->bytes;
+            u32 h = 0;
+            for (; h < nh; h++) {
+                if (hs[h] != st) continue;
+                if ((u32)(b - hb[h]) < st) { const u32 x = (b - hb[h]) + nb; if (x > he[h]) he[h] = x; break; }
+                if ((u32)(hb[h] - b) < st) { const u32 x = (hb[h] - b) + he[h]; he[h] = x > nb ? x : nb; hb[h] = b; break; }
+            }
+            if (h == nh && nh < 4) { hb[nh] = b; hs[nh] = st; he[nh] = nb; nh++; }
+        }
+        for (u32 h = 0; h < nh; h++) he[h] = he[h] ? he[h] - 1u : 0u;   /* offset of the last byte */
+        for (u32 j = 0; j < n && j < RSX_VE_PFD_VTX; j++)
+            for (u32 h = 0; h < nh; h++) {
+                const u8* a = vm_base + (u32)(hb[h] + vis[j] * hs[h]);
+                RSX_VE_PREFETCH(a); RSX_VE_PREFETCH(a + he[h]);
+            }
+    }
+    u8* o = (u8*)out;
+    for (u32 j = 0; j < n; j++, o += out_stride) {
+        const u32 vi = vis ? vis[j] : first + j;
+        if (nh && j + RSX_VE_PFD_VTX < n) {
+            const u32 vn = vis[j + RSX_VE_PFD_VTX];
+            for (u32 h = 0; h < nh; h++) {
+                const u8* a = vm_base + (u32)(hb[h] + vn * hs[h]);
+                RSX_VE_PREFETCH(a); RSX_VE_PREFETCH(a + he[h]);
+            }
+        }
+        float* d = (float*)o;
+        for (u32 si = 0; si < ns; si++, d += 4) {
+            const rsx_vk* q = &vk[si];
+#define RSX_VK_CASE(K, T, N, B)                                                         \
+            case K:                                                                     \
+                if (vi - q->elo <= q->span)                                             \
+                    rsx_vk_conv(T, N, B, q->s->k, vm_base + (u32)(q->base + vi * q->stride), d); \
+                else rsx_vk_gen(p, q->s, vi, d);                                        \
+                break;
+            switch (q->kind) {
+            case RSX_VK_CONST: _mm_storeu_ps(d, _mm_loadu_ps(q->s->k)); break;
+            RSX_VK_CASE(RSX_VK_F32 + 0, 2, 1, 4)  RSX_VK_CASE(RSX_VK_F32 + 1, 2, 2, 8)
+            RSX_VK_CASE(RSX_VK_F32 + 2, 2, 3, 12) RSX_VK_CASE(RSX_VK_F32 + 3, 2, 4, 16)
+            RSX_VK_CASE(RSX_VK_F16 + 0, 3, 1, 2)  RSX_VK_CASE(RSX_VK_F16 + 1, 3, 2, 4)
+            RSX_VK_CASE(RSX_VK_F16 + 2, 3, 3, 6)  RSX_VK_CASE(RSX_VK_F16 + 3, 3, 4, 8)
+            RSX_VK_CASE(RSX_VK_UBN + 0, 4, 1, 1)  RSX_VK_CASE(RSX_VK_UBN + 1, 4, 2, 2)
+            RSX_VK_CASE(RSX_VK_UBN + 2, 4, 3, 3)  RSX_VK_CASE(RSX_VK_UBN + 3, 4, 4, 4)
+            RSX_VK_CASE(RSX_VK_UB + 0, 7, 1, 1)   RSX_VK_CASE(RSX_VK_UB + 1, 7, 2, 2)
+            RSX_VK_CASE(RSX_VK_UB + 2, 7, 3, 3)   RSX_VK_CASE(RSX_VK_UB + 3, 7, 4, 4)
+            RSX_VK_CASE(RSX_VK_S1 + 0, 1, 1, 2)   RSX_VK_CASE(RSX_VK_S1 + 1, 1, 2, 4)
+            RSX_VK_CASE(RSX_VK_S1 + 2, 1, 3, 6)   RSX_VK_CASE(RSX_VK_S1 + 3, 1, 4, 8)
+            RSX_VK_CASE(RSX_VK_S32K + 0, 5, 1, 2) RSX_VK_CASE(RSX_VK_S32K + 1, 5, 2, 4)
+            RSX_VK_CASE(RSX_VK_S32K + 2, 5, 3, 6) RSX_VK_CASE(RSX_VK_S32K + 3, 5, 4, 8)
+            RSX_VK_CASE(RSX_VK_CMP, 6, 4, 4)
+            default: rsx_vk_gen(p, q->s, vi, d); break;
+            }
+#undef RSX_VK_CASE
+        }
+    }
+}
+#endif /* RSX_VF_SSE41 */
+
+/* rsx_vfetch_convert, or (VEMIT_FAST) rsx_vk_convert: the same bytes.
+ * VFETCH_CHECK keeps the reference and its read-back check. */
+static void rsx_ve_convert(const rsx_vfetch_plan* p, const u32* vis, u32 first, u32 n, void* out, u32 out_stride)
+{
+#if RSX_VF_SSE41
+    if (rsx_ve_fast_on() && !rsx_ve_check_on()) {
+        rsx_vk_convert(p, vis, first, n, out, out_stride);
+        return;
+    }
+#endif
+    rsx_vfetch_convert(p, vis, first, n, out, out_stride);
+}
+
+static u32 rsx_vemit_run_fast(rsx_vemit* e)
+{
+    const rsx_state* st = e->st;
+    const u32 used = rsx_vexpand_used(e->prim, e->count), nout = rsx_vexpand_count(e->prim, e->count);
+    const u32 stride = e->stride;
+    e->converted = 0; e->cached = 0;
+    if (!used || !nout || !vm_base || stride < 16u) return 0;
+    u32* buf = rsx_vemit_scratch((size_t)used + 3u * (size_t)nout);
+    if (!buf) return 0;
+    u32* gvi = buf; u32* vis = gvi + used + nout; u32* newv = vis + nout;
+    const int pf = rsx_ve_pf_on();
+    u32 lo, hi;
+    if (e->indexed) {
+        const int local = ((st->index_array_dma & 0xF) == 0);
+        const u8* ip = vm_base + cellGcmResolveLocated(local, st->index_array_offset);
+        const u32 isz = (((st->index_array_dma >> 4) & 0xF) == 1) ? 2u : 4u;
+        if (isz == 2u)
+            rsx_ve_idx16(ip + (u64)e->first * 2u, used, gvi, &lo, &hi);
+        else
+            rsx_ve_idx32(ip + (u64)e->first * 4u, used, gvi, &lo, &hi);
+        /* a full entry (256 indices, the most one DRAW_INDEX_ARRAY word
+         * carries) is usually followed by the next 256 of the same stream */
+        if (pf && e->count == 256u)
+            rsx_ve_pf(ip + ((u64)e->first + 256u) * isz, 256u * isz, RSX_VE_PF_LINES);
+    } else {
+        lo = 0xFFFFFFFFu; hi = 0;
+        for (u32 k = 0; k < used; k++) {
+            const u32 v = e->first + k;
+            gvi[k] = v;
+            if (v < lo) lo = v;
+            if (v > hi) hi = v;
+        }
+    }
+    switch (e->prim) {
+    case RSX_PRIMITIVE_TRIANGLES:
+        vis = gvi;
+        break;
+    case RSX_PRIMITIVE_QUADS:
+        for (u32 q = 0, o = 0; q < e->count / 4u; q++, o += 6u) {
+            const u32* v = gvi + q * 4u;
+            vis[o] = v[0]; vis[o + 1] = v[1]; vis[o + 2] = v[2];
+            vis[o + 3] = v[0]; vis[o + 4] = v[2]; vis[o + 5] = v[3];
+        }
+        break;
+    default: {
+        const int fan = e->prim == RSX_PRIMITIVE_TRIANGLE_FAN;
+        for (u32 t = 0, o = 0; t < e->count - 2u; t++, o += 3u) {
+            u32 i1 = t + 1, i2 = t + 2;
+            if (!fan && (t & 1)) { u32 x = i1; i1 = i2; i2 = x; }
+            vis[o] = gvi[fan ? 0 : t]; vis[o + 1] = gvi[i1]; vis[o + 2] = gvi[i2];
+        }
+        break; }
+    }
+
+    rsx_vfetch_plan plan;
+    rsx_ve_plan_init(&plan, st, e->mask, lo, hi, pf);
+
+    /* The reference's density test, with the cache key (and the dedupe key,
+     * in the same pass) computed first for an entry that can reach the cache
+     * -- the conditions rsx_vcache_get checks before it hashes the plan -- so
+     * that its first probe lines are on their way during the distinct count.
+     * The signatures are pure functions of the plan: computing them earlier
+     * changes nothing. */
+    u64 sig0 = 0, sig1 = 0;
+    int have0 = 0, have1 = 0;
+    int dense = 0;
+    if (e->vc && e->vc->nent && (u64)(hi - lo) < 4096u) {
+        const u32 span = hi - lo + 1u;
+        const int cand = span <= 16u || (u64)span <= (u64)used + used / 4u + 16u;
+        if (cand && plan.hashable && !(stride & 15u)) {
+            rsx_ve_plan_sigs(&plan, &sig0, &sig1); have0 = have1 = 1;
+            if (pf) {
+                const rsx_vcache_ent* q = &e->vc->ent[rsx_vc_slot(e->vc, sig1, lo, hi, stride)];
+                RSX_VE_PREFETCH(q); RSX_VE_PREFETCH((const u8*)q + 64);
+            }
+        }
+        if (span <= 16u) dense = 1;
+        else if (cand) {
+            const u32 uniq = rsx_ve_distinct_fast(gvi, used, lo, span);
+            dense = span <= uniq + uniq / 4u + 16u;
+        }
+    }
+    if (dense) {
+        u64 g; int hit;
+        if (rsx_vc_get(e->vc, &plan, stride, e->arena, e->batch, &g, &hit, have1 ? &sig1 : NULL)) {
+            const u32 e0 = (u32)(g / stride);
+            rsx_ve_emit_ib(e->ib, vis, nout, e0 - lo);
+            if (!hit) e->converted = hi - lo + 1u;
+            e->cached = 1;
+            return nout;
+        }
+    }
+
+    if (!have0) sig0 = rsx_vfetch_plan_sig(&plan, 0);
+    const u64 sig = sig0 ^ ((u64)stride << 48);
+    if (sig != *e->dd_sig) { rsx_vdedupe_reset(e->dd); *e->dd_sig = sig; }
+    const u64 g0 = ((e->half0 + e->vb_used + stride - 1u) / stride) * stride;
+    if (g0 + (u64)used * stride > e->half0 + e->half_bytes) return 0;
+    u32 next = (u32)(g0 / stride);
+    const u32 nn = rsx_ve_dedupe_fast(e->dd, vis, nout, &next, e->ib, newv, pf);
+    if (g0 + (u64)nn * stride > e->half0 + e->half_bytes) { rsx_vdedupe_reset(e->dd); return 0; }
+    if (nn) {
+        rsx_ve_convert(&plan, newv, 0, nn, e->arena + g0, stride);
+        e->vb_used = (u32)(g0 + (u64)nn * stride - e->half0);
+    }
+    e->converted = nn;
+    return nout;
+}
+
+u32 rsx_vemit_run(rsx_vemit* e)
+{
+    return rsx_ve_fast_on() ? rsx_vemit_run_fast(e) : rsx_vemit_run_ref(e);
+}
diff --git a/libs/video/rsx_vertex_fetch.h b/libs/video/rsx_vertex_fetch.h
index a52a2e1..280aedd 100644
--- a/libs/video/rsx_vertex_fetch.h
+++ b/libs/video/rsx_vertex_fetch.h
@@ -32,6 +32,7 @@
 #define PS3RECOMP_RSX_VERTEX_FETCH_H
 
 #include "rsx_commands.h"
+#include <stddef.h>
 
 #ifdef __cplusplus
 extern "C" {
@@ -68,6 +69,356 @@ float rsx_rd_half_be(const u8* p);  /* 2-byte IEEE half -> float  */
  */
 void rsx_fetch_attrib(const rsx_state* st, int idx, u32 vi, float out[4]);
 
+/* ---- Per-draw fetch plan ------------------------------------------------
+ *
+ * rsx_fetch_attrib decodes the attribute descriptor, copies the constant
+ * register and resolves the array offset again for every attribute of every
+ * vertex. A plan does that once per draw, for just the attributes the vertex
+ * shader reads (`mask`), and resolves each array to ONE linear host range when
+ * the RSX offset -> EA mapping is linear over the elements the draw can touch
+ * (vertices vlo..vhi). The conversion is then a load, a byte swap and a store.
+ *
+ * rsx_vfetch_convert is bit-exact with rsx_fetch_attrib for every attribute in
+ * the mask: anything the fast path does not cover -- a mapping that is not
+ * linear over the range, an unknown type, an element outside the planned
+ * range -- is handed to rsx_fetch_attrib itself (RSX_VF_SLOW).
+ *
+ * Linearity: cellGcmResolveLocated(LOCAL, o) is localAddress + o, and
+ * cellGcmResolveOffset maps 1 MB pages (offset >> 20), each page either to
+ * VRAM or through the IO table; within a page both are o + constant. So a
+ * range is linear exactly when every 1 MB page boundary inside it continues
+ * the line from its first element, which is what the plan checks.
+ * VFETCH_CHECK=1 re-fetches every converted vertex through rsx_fetch_attrib
+ * and reports the first mismatches (diagnostic). */
+#define RSX_VF_CONST 0   /* disabled / zero stride: the constant register   */
+#define RSX_VF_FAST  1   /* linear host range, known type                   */
+#define RSX_VF_SLOW  2   /* per vertex through rsx_fetch_attrib             */
+
+typedef struct rsx_vf_slot {
+    u8  mode;       /* RSX_VF_*                                             */
+    u8  type;       /* NV4097 vertex type (FAST)                            */
+    u8  n;          /* components read from memory, 1..4                    */
+    u8  fmode;      /* 0 per vertex, 1 divide (instance), 2 modulo (repeat) */
+    u8  idx;        /* attribute index 0..15                                */
+    u8  bytes;      /* bytes of one element in memory (FAST)                */
+    u8  loc;        /* 1 = LOCAL (offset bit 31 clear), 0 = MAIN            */
+    u8  pad;
+    u32 freq;       /* frequency divisor (fmode 1/2)                        */
+    u32 stride;     /* guest array stride                                   */
+    u32 off;        /* offset & 0x7FFFFFFF                                  */
+    u32 elo, ehi;   /* element range ea0 covers (FAST)                      */
+    u32 ea0;        /* resolved EA of element elo (FAST)                    */
+    float k[4];     /* constant register vertex_data4f[idx]                 */
+} rsx_vf_slot;
+
+typedef struct rsx_vfetch_plan {
+    const rsx_state* st;
+    u32 mask;       /* planned attributes; output slot order is ascending   */
+    u32 nslots;     /* popcount(mask): output vertex = nslots float4        */
+    u32 vlo, vhi;   /* vertex range the plan covers                         */
+    int hashable;   /* every slot CONST or FAST (rsx_vfetch_hash works)     */
+    rsx_vf_slot s[16];
+} rsx_vfetch_plan;
+
+/* Build a plan for attributes `mask` of vertices vlo..vhi (inclusive). */
+void rsx_vfetch_plan_init(rsx_vfetch_plan* p, const rsx_state* st, u32 mask,
+                          u32 vlo, u32 vhi);
+/* Convert n vertices -- vis[0..n-1], or first..first+n-1 when vis is NULL --
+ * to nslots float4 each, out_stride bytes apart. `out` may be write-combined
+ * memory: it is only ever written, 16 bytes at a time, in order. */
+void rsx_vfetch_convert(const rsx_vfetch_plan* p, const u32* vis, u32 first,
+                        u32 n, void* out, u32 out_stride);
+/* Everything a converted vertex depends on except guest memory contents:
+ * mask, per-slot mode/type/size/stride/frequency/offset/context and constant
+ * registers; with_mapping adds each FAST slot's resolved EA (the offset ->
+ * EA mapping can change over time, e.g. cellGcmMapMainMemory). */
+u64  rsx_vfetch_plan_sig(const rsx_vfetch_plan* p, int with_mapping);
+/* 64-bit content hash of the guest bytes every FAST slot reads for the
+ * planned range (overlapping interleaved spans are hashed once). Returns 0
+ * and leaves *h alone when the plan is not hashable. */
+int  rsx_vfetch_hash(const rsx_vfetch_plan* p, u64* h);
+/* Raw 64-bit hash of a byte span (exposed for tests). */
+u64  rsx_vhash64(const u8* p, size_t n, u64 seed);
+/* The content hash rsx_vfetch_hash uses: rsx_vhash64 for spans under 256
+ * bytes (and in builds without SSE4.1), a vector XXH3-style loop above; the
+ * SSE and AVX2 loops give the same value. */
+u64  rsx_vhash64x(const u8* p, size_t n, u64 seed);
+
+/* ---- Primitive expansion ------------------------------------------------
+ * The VP path draws triangle lists. rsx_vexpand writes, in triangle-list
+ * order, the position (0..count-1) of each stream entry: TRIANGLES as is,
+ * QUADS (v0,v1,v2)(v0,v2,v3), TRIANGLE_STRIP with alternating winding,
+ * TRIANGLE_FAN around entry 0 -- the expansion the per-primitive upload paths
+ * have always done. Returns the number written (rsx_vexpand_count), 0 for a
+ * primitive the VP path does not draw. */
+u32 rsx_vexpand_count(u32 prim, u32 count);
+u32 rsx_vexpand(u32 prim, u32 count, u32* order);
+/* Highest stream entry the expansion reads + 1 (QUADS ignore a partial quad). */
+u32 rsx_vexpand_used(u32 prim, u32 count);
+
+/* ---- Unique-vertex assignment --------------------------------------------
+ * Direct-mapped table: guest vertex index -> output element, valid for one
+ * generation (one draw record, one buffer half, one fetch plan). A collision
+ * only costs a duplicate conversion, never a wrong vertex. */
+#define RSX_VDEDUPE_BITS 12
+typedef struct rsx_vdedupe_ent {
+    u32 vi, g, e, pad;      /* one 16-byte entry: a probe touches one line */
+} rsx_vdedupe_ent;
+typedef struct rsx_vdedupe {
+    u32 gen;
+    rsx_vdedupe_ent t[1u << RSX_VDEDUPE_BITS];
+} rsx_vdedupe;
+void rsx_vdedupe_reset(rsx_vdedupe* d);   /* new generation */
+/* For guest indices vis[0..n-1]: ib[j] = element of vis[j]. Unseen indices get
+ * *next_elem, *next_elem + 1, ... and are appended to newv (capacity n).
+ * Returns how many were new. */
+u32 rsx_vdedupe_run(rsx_vdedupe* d, const u32* vis, u32 n, u32* next_elem,
+                    u32* ib, u32* newv);
+
+/* ---- Cross-batch converted-vertex cache ---------------------------------
+ *
+ * A draw's planned vertex range [vlo, vhi] converted once into a persistent
+ * region of the vertex arena and reused by later draws -- this frame or the
+ * next -- that plan the same range with the same signature (attributes,
+ * constants, resolved addresses, output stride) AND whose guest bytes hash the
+ * same (rsx_vfetch_hash: every byte the conversion reads). No write tracking
+ * is needed for correctness; with it, the hash could be skipped.
+ *
+ * The region is 1 MB slabs filled in turn. Every use stamps its slab with the
+ * batch number; a slab is recycled only when its stamp is at least min_age
+ * batches old. GPU safety needs 2 (render_frame waits for the GPU before it
+ * records the next batch, so batch B-2 has finished when batch B is being
+ * built, while B-1 may still be executing); the default is larger
+ * (RSX_VCACHE_MIN_AGE) so that slabs the current frames keep hitting are not
+ * recycled: a frame's draws reach the cache in the same cyclic order every
+ * frame, and with a 2-batch age a working set even slightly larger than the
+ * region evicted every range just before its next use -- 0 hits, every draw
+ * paying hash + conversion (verifier's vbench: 4688 static 32 KB ranges in a
+ * 64 MB region, 0 hits in 4 frames). With the longer age the region keeps the
+ * ranges it holds and the overflow takes the per-record path (nofit), which
+ * is detected before the content hash is computed. Entries in a recycled slab
+ * die with it (slab generation). Ranges whose content keeps changing (dynamic
+ * buffers) are bypassed for a while so they do not churn slabs.
+ *
+ * Why the region filled up (PF5, NOTES 2026-10-27; the [VCSTAT] census):
+ * inFamous 2 draws ~1000 ranges a frame at the prologue's gate fight (~90 on
+ * the busy street) that it never draws again -- geometry written to new
+ * addresses every frame. Admitted on sight, their dead copies filled every
+ * slab around the few ranges the frames still hit (each hit re-stamps its
+ * slab), and their live entries filled the table, which then forgot hot
+ * ranges (slot 0 of a full probe window) and admitted them again in other
+ * slabs. Within 4-9 s of a load all 256 slabs were pinned, holding 4-22 MB of
+ * ranges any frame still hit and 153-206 MB of orphaned copies; nothing was
+ * admitted after that and 130-4500 draws a frame converted every frame.
+ *
+ * admit2 (VCACHE_ADMIT2, default on; PF5): a range is admitted on its second
+ * sighting. A key the table does not hold is looked up in a direct-mapped
+ * filter of first sightings beside the table (seen[], RSX_VCACHE_SEEN slots);
+ * not there, it is written there and the draw converts into the stream half,
+ * as a range that does not fit does -- no hash, no slab, no table entry;
+ * there, the range is admitted. The filter only says "seen": a key another
+ * overwrote costs one more stream conversion, a 64-bit key matched by chance
+ * an admission one sighting early (the old path's every admission). And an
+ * admission whose probe window holds only live entries takes the least
+ * recently used one that no draw used for min_age batches (each entry's
+ * `last`: its admission, hits, moves and bypassed sightings); with none it is
+ * refused -- the stream path; the key stays in the filter -- rather than
+ * forgetting slot 0, which may be a range the frames still hit (on the busy
+ * street that took the region from 115 recyclable slabs to none in 25 s even
+ * with the filter: ~130 forgets a frame). admit2 = 0: a range is admitted on
+ * its first sighting and a full window forgets slot 0 (the old path).
+ *
+ * evac (VCACHE_EVAC, default on; PF5): a slab a few ranges the frames still
+ * hit keep from recycling -- one admitted late (its content changed, new
+ * geometry came into view) among copies long dead -- is emptied. As the
+ * allocator opens a slab, or finds none to open, and fewer than nslab / 8 (at
+ * least 2) slabs are free or recyclable, the slab whose live copies hold the
+ * fewest bytes is chosen (slab_live, kept per admission, move and recycling;
+ * never the current slab); a hit on a copy in it converts the range again
+ * into the current slab, as a miss would, or takes the stream path when there
+ * is no room -- either way no draw reads the slab any more, so its stamp ages
+ * and the allocator recycles it by the usual rule (min_age: no new GPU-safety
+ * assumption). One slab at a time: at most 1 MB of conversions per min_age
+ * batches. Without it, admit2's pinned slabs still grew ~18 a minute on a
+ * street walk in one place, and a region with late hot ranges in every slab
+ * freezes again (tests/test_vcache_admit2.c). evac = 0: no slab is emptied
+ * (the old path).
+ *
+ * Neither part changes what a draw reads: a copy is still served only for the
+ * same key and the same content hash, every write into the region is an
+ * admission (or a move) into a slab the allocator opened under min_age, and
+ * the filter, the table's victim and the slab chosen are bookkeeping that
+ * never writes the arena. VCACHE_VERIFY checks both claims draw by draw. */
+typedef struct rsx_vcache_ent {
+    u64 sig, h, g;          /* plan signature, content hash, arena offset   */
+    u32 lo, hi, stride;
+    u32 slab_gen;
+    u16 slab;
+    u8  dyn, bypass;
+    u32 last;               /* batch of its last use (admit2's victim; in
+                             * what was padding: 48 bytes either way)      */
+} rsx_vcache_ent;
+_Static_assert(sizeof(rsx_vcache_ent) == 48, "rsx_vcache_ent: last sits in the old padding");
+
+/* VCACHE_STATS (diagnostic; the backend's [VCSTAT] census): beside the
+ * table, each entry's admission batch, last use and hits, and a set of every
+ * range key ever looked up (how often, how big), so that a census can say
+ * what keeps the slabs from being recycled -- the ranges the frames still hit
+ * in each, and how much of each is dead. NULL (the default): nothing is kept;
+ * nothing the cache decides reads it either way. */
+typedef struct rsx_vcache_dg { u32 born, last, hits, adm; } rsx_vcache_dg;
+typedef struct rsx_vcache_key { u64 k; u32 first, n, bytes, pad; } rsx_vcache_key;
+#define RSX_VCD_KEYS (1u << 22)
+typedef struct rsx_vcache_diag {
+    rsx_vcache_dg*  ent;    /* nent, parallel to the table                  */
+    rsx_vcache_key* key;    /* RSX_VCD_KEYS slots, open addressing          */
+    u32 nkey, key_full;     /* keys held; sightings the set had no room for */
+    /* since the last census: admissions by why the range had no live copy --
+     * a key never seen before, its content changed, its copy's slab was
+     * recycled, the table had forgotten it (seen before, no entry; with admit2
+     * a third or later sighting), its second sighting (admit2); nofit on a
+     * key's first sighting / a later one; live entries overwritten (all probe
+     * slots live); copies replaced unhit / after hits */
+    u64 adm_first, adm_changed, adm_dead, adm_forgot, adm_second;
+    u64 nofit_first, nofit_seen;
+    u64 forget, die0, die1;
+} rsx_vcache_diag;
+
+typedef struct rsx_vcache {
+    u64 base;               /* arena byte offset of the region             */
+    u32 nslab, cur;
+    u32* slab_gen;
+    u32* slab_last;         /* batch that last referenced the slab         */
+    u32* slab_used;         /* bytes allocated (0 = never used)            */
+    rsx_vcache_ent* ent;
+    u32 nent;               /* power of two                                */
+    u32 min_age;            /* batches a slab must go unreferenced before
+                             * it is recycled; >= 2 (GPU safety)           */
+    u32 nofree_batch;       /* batch in which no slab was recyclable       */
+    u64 hits, misses, bypassed, nofit;   /* statistics                     */
+    u64 recycled;           /* statistic: used slabs taken again           */
+    u64 held;               /* statistic: first sightings left to the stream (admit2) */
+    u64 refused;            /* statistic: admissions with no entry to take (admit2) */
+    u32 admit2;             /* admit on the second sighting (init: 1)      */
+    u64* seen;              /* admit2: RSX_VCACHE_SEEN keys of first sightings (0 = empty) */
+    u32 evac_on;            /* empty slabs kept by a few hot ranges (init: 1) */
+    u32 evac;               /* the slab being emptied (~0u: none)          */
+    u32* slab_live;         /* evac: bytes of the table's live copies in each slab */
+    u64 moved, evacs;       /* statistics: copies moved out; slabs chosen  */
+    rsx_vcache_diag* dg;    /* VCACHE_STATS; NULL = off                    */
+    struct rsx_vcache_ver* ver;   /* VCACHE_VERIFY; NULL = off             */
+} rsx_vcache;
+
+#define RSX_VCACHE_SLAB (1u << 20)
+#define RSX_VCACHE_MIN_AGE 16u   /* default min_age: a few frames of batches */
+#define RSX_VCACHE_SEEN (1u << 17)   /* admit2's filter: 1 MB; ~1000 new keys a frame
+                                      * overwrite a given slot with p ~0.8% a frame */
+/* Region [base, base + bytes) of the arena; nent: entry table size (pow2).
+ * Sets min_age to RSX_VCACHE_MIN_AGE; a caller may raise it (never below 2).
+ * Sets admit2 and evac_on (a caller may clear them: the old path). */
+int  rsx_vcache_init(rsx_vcache* c, u64 base, u64 bytes, u32 nent);
+/* Converted copy of plan p's range at `stride` bytes per vertex: on success
+ * returns 1 and *g = arena offset of vertex p->vlo (vertex v at
+ * *g + (v - p->vlo) * stride), *hit says whether it was reused. Returns 0
+ * when the caller should convert into its per-batch stream instead (plan not
+ * hashable, range too large for a slab, bypassed as dynamic, or no slab old
+ * enough to recycle). arena: host pointer of arena offset 0 (write-only). */
+int  rsx_vcache_get(rsx_vcache* c, const rsx_vfetch_plan* p, u32 stride,
+                    u8* arena, u32 batch, u64* g, int* hit);
+
+/* VCACHE_STATS: attach the diagnostic tables (0: out of memory); clear the
+ * entries' stamps after the table was cleared (the key set stays). */
+int  rsx_vcache_diag_on(rsx_vcache* c);
+void rsx_vcache_diag_clear(rsx_vcache* c);
+/* The census as of `batch` (a slab is "pinned" while its stamp is younger
+ * than min_age; an entry is "hot" while its last use is): slabs used /
+ * recyclable / pinned, pinned slabs by the hot ranges in them (0, 1, 2-4, 5+)
+ * and the hot KB they hold (p50 / p90); bytes used, in hot copies, in cold
+ * live copies (and of those never hit), orphaned (no entry: a superseded or
+ * forgotten copy); keys in admit2's filter; keys first seen before `since`
+ * seen once / more often and the bytes of their ranges. Needs c->dg. */
+typedef struct rsx_vcache_census {
+    u32 used, recyclable, pinned, pin_by[4], hot_kb_p50, hot_kb_p90;
+    u64 used_b, hot_b, cold_b, cold0_b, orphan_b;
+    u32 live, hot, seen, keys, once, evac_kb;
+    u64 once_b, multi_b;
+} rsx_vcache_census;
+void rsx_vcache_census_run(const rsx_vcache* c, u32 batch, u32 since, rsx_vcache_census* o);
+
+/* VCACHE_VERIFY (diagnostic; the backend's [VCVERIFY]; PF5): every draw the
+ * cache serves -- a hit, an admission or a move -- also runs the conversion it
+ * replaces: the plan's whole range converted afresh from the guest bytes
+ * (the converter the stream path runs for a draw the cache does not serve)
+ * into cached memory and compared with
+ * the copy the draw's indices name in the arena, i.e. the bytes the GPU reads
+ * (per vertex the 16 bytes of each attribute the layout holds; the arena is
+ * write-combined: read with streaming loads). And every conversion into the
+ * region is checked against the draws that read the bytes it overwrites,
+ * from stamps per 16 bytes kept beside the cache's own (slab) bookkeeping:
+ * no byte a draw of this batch, or of the previous one, read may be
+ * rewritten -- render_frame waits for the GPU before it submits a batch, not
+ * before the walker records the next one, so the previous batch may still be
+ * running. Counts only: nothing the cache decides reads it. */
+typedef struct rsx_vcache_ver {
+    u32* ref;               /* per 16 bytes of the region: 1 + the last batch a served draw read them in */
+    u8*  tmp;               /* the fresh conversion                        */
+    u64  tmp_cap;
+    u64  draws, bytes, diff_draws, diff_bytes;   /* served draws compared, bytes, differing */
+    u64  writes, unsafe_writes, unsafe_gran;     /* conversions into the region checked; unsafe ones */
+    u64  odd_stride;        /* draws whose stride is not 16 x the attributes (compared per attribute) */
+    u32  nlog;              /* detail lines printed (at most 8)            */
+} rsx_vcache_ver;
+int  rsx_vcache_verify_on(rsx_vcache* c);      /* allocates c->ver; 0 on failure */
+/* The table was cleared with the GPU idle: no draw reads the region. */
+void rsx_vcache_verify_clear(rsx_vcache* c);
+
+/* ---- One draw entry: vertices + triangle-list indices --------------------
+ *
+ * For one DRAW_ARRAYS / DRAW_INDEX_ARRAY entry (`count` stream entries from
+ * `first`; indexed reads the index array exactly as the old read_guest_index
+ * did): expands the primitive to a triangle list of u32 indices into ib, each
+ * naming a converted vertex by its arena element number (arena offset /
+ * stride). Vertices come from the cache (whole planned range, when dense
+ * enough and hashable) or are converted into the stream half once per
+ * distinct guest vertex (dd: the caller resets it for each new record; it is
+ * also reset here when the attribute setup changes). Not reentrant (one
+ * static scratch buffer): the RSX thread's. */
+typedef struct rsx_vemit {
+    const rsx_state* st;
+    u32 prim, first, count;
+    int indexed;
+    u32 mask, stride;           /* layout: attributes, 16 * popcount(mask)  */
+    u8* arena;                  /* host pointer of arena offset 0           */
+    u64 half0, half_bytes;      /* this batch's stream half in the arena    */
+    u32 vb_used;                /* in/out: bytes used in the stream half    */
+    u32* ib;                    /* out: the entry's indices                 */
+    rsx_vdedupe* dd;
+    u64* dd_sig;                /* plan signature dd belongs to (0 = none)  */
+    rsx_vcache* vc;             /* NULL: no cache                           */
+    u32 batch;
+    u32 converted;              /* out: vertices converted                  */
+    int cached;                 /* out: indices name cached vertices        */
+} rsx_vemit;
+/* Returns the number of indices written to ib (rsx_vexpand_count), 0 when
+ * the primitive draws nothing or the stream half has no room.
+ *
+ * VEMIT_FAST (default on; VEMIT_FAST=0 runs the reference code): the same
+ * function with cheaper internals -- prefetches of the guest index / vertex
+ * lines and of the path's own tables ahead of their use, a one-pass fetch
+ * plan, both plan signatures in one pass, a byte-mark distinct count, a fused
+ * dedupe probe, a per-slot specialised conversion doing the same operations.
+ * Every output (ib, arena bytes, vb_used, dedupe table, cache state) is
+ * bit-identical to the reference; the test vb4.c checks that differentially. */
+u32 rsx_vemit_run(rsx_vemit* e);
+
+/* Prefetch hint for an entry about to be emitted: the index span (indexed) or
+ * the head of each enabled attribute array from `first` (non-indexed). Call
+ * it as early as the entry is known -- the backend does, before it builds the
+ * record (constant bank, program lookup), so the guest lines are on their way
+ * while that runs. Reads nothing, writes nothing, never faults; VPREFETCH=0
+ * (or VEMIT_FAST=0) turns it -- and rsx_vemit_run's own prefetches -- off. */
+void rsx_vemit_prefetch(const rsx_state* st, u32 prim, u32 first, u32 count, int indexed);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/libs/video/rsx_videoout_gamma.c b/libs/video/rsx_videoout_gamma.c
new file mode 100644
index 0000000..19d6afe
--- /dev/null
+++ b/libs/video/rsx_videoout_gamma.c
@@ -0,0 +1,348 @@
+/*
+ * ps3recomp - video-out gamma: state and the D3D12 present pass.
+ * See rsx_videoout_gamma.h for the semantics, the evidence and the switches.
+ */
+#include "rsx_videoout_gamma.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+/* The accepted value, as float bits: written by the title's thread
+ * (cellVideoOutSetGamma), read by the render thread. An aligned 32-bit
+ * store/load is atomic on every host this builds for. */
+static volatile uint32_t s_gamma_bits = 0x3F800000u;   /* 1.0f */
+
+void rsx_videoout_gamma_set(float gamma)
+{
+    uint32_t b;
+    memcpy(&b, &gamma, sizeof b);
+    s_gamma_bits = b;
+}
+
+float rsx_videoout_gamma_get(void)
+{
+    uint32_t b = s_gamma_bits;
+    float g;
+    memcpy(&g, &b, sizeof g);
+    return g;
+}
+
+int rsx_videoout_gamma_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0) {
+        const char* v = getenv("VIDEOOUT_GAMMA");
+        int ok = 1;
+        mode = rsx_vog_parse_mode(v, &ok);
+        if (!ok)
+            fprintf(stderr, "[videoout-gamma] VIDEOOUT_GAMMA=%s is not 0, 1 or inv: "
+                            "using 1 (out = in^(1/gamma))\n", v);
+    }
+    return mode;
+}
+
+const char* rsx_videoout_gamma_mode_name(int mode)
+{
+#if !defined(_WIN32) || defined(RSX_VOG_NO_D3D12)
+    /* Only the D3D12 backend has the present pass: say so, do not imply it. */
+    if (mode != RSX_VOG_OFF) return "NOT applied (this build has no D3D12 present pass)";
+#endif
+    switch (mode) {
+    case RSX_VOG_OFF: return "off (VIDEOOUT_GAMMA=0)";
+    case RSX_VOG_INV: return "out = in^gamma (VIDEOOUT_GAMMA=inv)";
+    default:          return "out = in^(1/gamma)";
+    }
+}
+
+/* The PC brightness (settings store row "brightness", latched by the backend
+ * at its render point): the exponent is divided by it. 1.0 = the PS3's
+ * transfer, bit for bit (the division is skipped). */
+static volatile uint32_t s_bright_bits = 0x3F800000u;   /* 1.0f */
+
+void rsx_videoout_gamma_set_brightness(float b)
+{
+    if (!(b >= 0.25f && b <= 4.0f)) b = 1.0f;
+    uint32_t u;
+    memcpy(&u, &b, sizeof u);
+    s_bright_bits = u;
+}
+
+float rsx_videoout_gamma_brightness(void)
+{
+    uint32_t u = s_bright_bits;
+    float b;
+    memcpy(&b, &u, sizeof b);
+    return b;
+}
+
+float rsx_videoout_gamma_exponent_now(float* gamma_used)
+{
+    static int forced = -1;
+    static float force = 1.0f;
+    if (forced < 0) {
+        const char* v = getenv("VIDEOOUT_GAMMA_FORCE");
+        forced = 0;
+        if (v && *v) {
+            char* end = NULL;
+            double d = strtod(v, &end);
+            if (end != v && d > 0.0 && d < 16.0) {
+                forced = 1; force = (float)d;
+                fprintf(stderr, "[videoout-gamma] VIDEOOUT_GAMMA_FORCE=%g overrides the "
+                                "title's gamma\n", d);
+            } else
+                fprintf(stderr, "[videoout-gamma] VIDEOOUT_GAMMA_FORCE=%s ignored: "
+                                "expected a number in (0, 16)\n", v);
+        }
+    }
+    float g = forced ? force : rsx_videoout_gamma_get();
+    if (gamma_used) *gamma_used = g;
+    const float e = rsx_vog_exponent(g, rsx_videoout_gamma_mode());
+    const float b = rsx_videoout_gamma_brightness();
+    return b == 1.0f ? e : e / b;
+}
+
+/* RSX_VOG_NO_D3D12: the state above only (the host unit test). */
+#if defined(_WIN32) && !defined(RSX_VOG_NO_D3D12)
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <limits.h>
+#include <d3d12.h>
+#include <d3dcompiler.h>
+/* This file calls D3DCompile, D3D12SerializeRootSignature and the IID_*
+ * GUIDs itself; say so here rather than relying on rsx_d3d12_backend.c's
+ * pragmas being linked in alongside it. */
+#pragma comment(lib, "d3d12.lib")
+#pragma comment(lib, "d3dcompiler.lib")
+#pragma comment(lib, "dxguid.lib")
+
+/* Full-screen triangle; the pixel shader reads the copy of the backbuffer at
+ * its own pixel (Load: no filtering, no sampler) and applies the transfer to
+ * RGB. saturate() keeps pow's domain [0,1]; pow(0, e) = 0 for e > 0. */
+static const char s_vog_vs[] =
+    "float4 main(uint id : SV_VertexID) : SV_Position {\n"
+    "    float2 uv = float2((id << 1) & 2, id & 2);\n"
+    "    return float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+    "}\n";
+static const char s_vog_ps[] =
+    "Texture2D<float4> src : register(t0);\n"
+    "cbuffer C : register(b0) { float e; };\n"
+    "float4 main(float4 p : SV_Position) : SV_Target {\n"
+    "    float4 c = src.Load(int3(p.xy, 0));\n"
+    "    return float4(pow(saturate(c.rgb), e), c.a);\n"
+    "}\n";
+
+static struct {
+    int                   failed;     /* set once, logged once: no silent skip */
+    ID3D12RootSignature*  rs;
+    ID3D12PipelineState*  pso;
+    ID3D12DescriptorHeap* heap;       /* 1 SRV, shader-visible */
+    ID3D12Resource*       tmp;        /* copy of the backbuffer */
+    UINT                  tw, th;
+    D3D12_RESOURCE_STATES tst;
+    ID3D12Resource*       retired[4]; /* old copies, possibly still in flight */
+    int                   nretired;
+    uint32_t              last_e_bits;
+    int                   logged;
+} s_vog = { 0 };
+
+static void vog_fail(const char* what, HRESULT hr)
+{
+    s_vog.failed = 1;
+    fprintf(stderr, "[videoout-gamma] ERROR: %s failed (0x%08lX): the video-out gamma "
+                    "is NOT applied from here on\n", what, (unsigned long)hr);
+}
+
+static int vog_init(ID3D12Device* dev)
+{
+    ID3DBlob *vs = NULL, *ps = NULL, *err = NULL, *sig = NULL;
+    HRESULT hr = D3DCompile(s_vog_vs, sizeof s_vog_vs - 1, "vog_vs", NULL, NULL,
+                            "main", "vs_5_0", 0, 0, &vs, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[videoout-gamma] VS: %s\n",
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+        if (err) err->lpVtbl->Release(err);
+        vog_fail("D3DCompile(vs)", hr); return 0;
+    }
+    hr = D3DCompile(s_vog_ps, sizeof s_vog_ps - 1, "vog_ps", NULL, NULL,
+                    "main", "ps_5_0", 0, 0, &ps, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[videoout-gamma] PS: %s\n",
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+        if (err) err->lpVtbl->Release(err);
+        vs->lpVtbl->Release(vs);
+        vog_fail("D3DCompile(ps)", hr); return 0;
+    }
+
+    D3D12_DESCRIPTOR_RANGE range = {0};
+    range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    range.NumDescriptors = 1;
+    range.BaseShaderRegister = 0;
+    range.OffsetInDescriptorsFromTableStart = 0;
+    D3D12_ROOT_PARAMETER rp[2];
+    memset(rp, 0, sizeof rp);
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    rp[0].DescriptorTable.NumDescriptorRanges = 1;
+    rp[0].DescriptorTable.pDescriptorRanges = &range;
+    rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[1].Constants.ShaderRegister = 0;
+    rp[1].Constants.Num32BitValues = 1;
+    rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC rd = {0};
+    rd.NumParameters = 2;
+    rd.pParameters = rp;
+    rd.Flags = D3D12_ROOT_SIGNATURE_FLAG_NONE;
+    hr = D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+    if (FAILED(hr)) {
+        if (err) err->lpVtbl->Release(err);
+        vs->lpVtbl->Release(vs); ps->lpVtbl->Release(ps);
+        vog_fail("D3D12SerializeRootSignature", hr); return 0;
+    }
+    hr = dev->lpVtbl->CreateRootSignature(dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                                          sig->lpVtbl->GetBufferSize(sig),
+                                          &IID_ID3D12RootSignature, (void**)&s_vog.rs);
+    sig->lpVtbl->Release(sig);
+    if (FAILED(hr)) {
+        vs->lpVtbl->Release(vs); ps->lpVtbl->Release(ps);
+        vog_fail("CreateRootSignature", hr); return 0;
+    }
+
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+    memset(&pd, 0, sizeof pd);
+    pd.pRootSignature = s_vog.rs;
+    pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs);
+    pd.VS.BytecodeLength  = vs->lpVtbl->GetBufferSize(vs);
+    pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps);
+    pd.PS.BytecodeLength  = ps->lpVtbl->GetBufferSize(ps);
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = UINT_MAX;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1;
+    pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;   /* the swap chain's format */
+    pd.DSVFormat = DXGI_FORMAT_UNKNOWN;
+    pd.SampleDesc.Count = 1;
+    hr = dev->lpVtbl->CreateGraphicsPipelineState(dev, &pd, &IID_ID3D12PipelineState,
+                                                  (void**)&s_vog.pso);
+    vs->lpVtbl->Release(vs); ps->lpVtbl->Release(ps);
+    if (FAILED(hr)) { vog_fail("CreateGraphicsPipelineState", hr); return 0; }
+
+    D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    hd.NumDescriptors = 1;
+    hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    hr = dev->lpVtbl->CreateDescriptorHeap(dev, &hd, &IID_ID3D12DescriptorHeap,
+                                           (void**)&s_vog.heap);
+    if (FAILED(hr)) { vog_fail("CreateDescriptorHeap", hr); return 0; }
+    return 1;
+}
+
+/* The backbuffer copy, w x h, with its SRV. A size change keeps the old copy
+ * alive (a frame in flight may still read it) and makes a new one. */
+static int vog_ensure_tmp(ID3D12Device* dev, UINT w, UINT h)
+{
+    if (s_vog.tmp && s_vog.tw == w && s_vog.th == h) return 1;
+    if (s_vog.tmp) {
+        if (s_vog.nretired >= (int)(sizeof s_vog.retired / sizeof s_vog.retired[0])) {
+            vog_fail("backbuffer size changed too often", E_FAIL); return 0;
+        }
+        s_vog.retired[s_vog.nretired++] = s_vog.tmp;
+        s_vog.tmp = NULL;
+    }
+    D3D12_HEAP_PROPERTIES hp = {0};
+    hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = w; td.Height = h;
+    td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    HRESULT hr = dev->lpVtbl->CreateCommittedResource(dev, &hp, D3D12_HEAP_FLAG_NONE, &td,
+                                                      D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+                                                      &IID_ID3D12Resource, (void**)&s_vog.tmp);
+    if (FAILED(hr)) { s_vog.tmp = NULL; vog_fail("CreateCommittedResource(copy)", hr); return 0; }
+    s_vog.tw = w; s_vog.th = h;
+    s_vog.tst = D3D12_RESOURCE_STATE_COPY_DEST;
+
+    D3D12_SHADER_RESOURCE_VIEW_DESC sd;
+    memset(&sd, 0, sizeof sd);
+    sd.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    sd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sd.Texture2D.MipLevels = 1;
+    D3D12_CPU_DESCRIPTOR_HANDLE ch;
+    s_vog.heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_vog.heap, &ch);
+    dev->lpVtbl->CreateShaderResourceView(dev, s_vog.tmp, &sd, ch);
+    return 1;
+}
+
+/* Called by the D3D12 backend once per PRESENTED frame, after every copy of
+ * the backbuffer the title can read (display write-through, screen copy) and
+ * before the dump readback and the Present. The backbuffer is in
+ * RENDER_TARGET on entry and is left there; the command list's root
+ * signature, PSO, descriptor heaps and render targets are changed. */
+void rsx_videoout_gamma_d3d12(ID3D12Device* dev, ID3D12GraphicsCommandList* cl,
+                              ID3D12Resource* bb, D3D12_CPU_DESCRIPTOR_HANDLE rtv,
+                              UINT w, UINT h)
+{
+    float g = 1.0f;
+    float e = rsx_videoout_gamma_exponent_now(&g);
+    uint32_t eb;
+    memcpy(&eb, &e, sizeof eb);
+    if (!s_vog.logged || eb != s_vog.last_e_bits) {   /* first frame, then each change */
+        const float pb = rsx_videoout_gamma_brightness();
+        char bs[48] = "";
+        if (pb != 1.0f) snprintf(bs, sizeof bs, ", PC brightness %.2f", (double)pb);
+        fprintf(stderr, "[videoout-gamma] gamma %.6g -> exponent %.6g, %s%s%s\n",
+                (double)g, (double)e, rsx_videoout_gamma_mode_name(rsx_videoout_gamma_mode()), bs,
+                e == 1.0f ? " (identity: no pass)" : "");
+        s_vog.last_e_bits = eb;
+        s_vog.logged = 1;
+    }
+    if (e == 1.0f || s_vog.failed || !dev || !cl || !bb || !w || !h) return;
+    if (!s_vog.pso && !vog_init(dev)) return;
+    if (!vog_ensure_tmp(dev, w, h)) return;
+
+    D3D12_RESOURCE_BARRIER b[2];
+    memset(b, 0, sizeof b);
+    b[0].Type = b[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b[0].Transition.pResource   = bb;
+    b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[0].Transition.StateAfter  = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b[1].Transition.pResource   = s_vog.tmp;
+    b[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[1].Transition.StateBefore = s_vog.tst;
+    b[1].Transition.StateAfter  = D3D12_RESOURCE_STATE_COPY_DEST;
+    cl->lpVtbl->ResourceBarrier(cl, s_vog.tst == D3D12_RESOURCE_STATE_COPY_DEST ? 1 : 2, b);
+    cl->lpVtbl->CopyResource(cl, s_vog.tmp, bb);
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b[0].Transition.StateAfter  = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b[1].Transition.StateAfter  = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    cl->lpVtbl->ResourceBarrier(cl, 2, b);
+    s_vog.tst = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+
+    D3D12_GPU_DESCRIPTOR_HANDLE gh;
+    s_vog.heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_vog.heap, &gh);
+    cl->lpVtbl->SetDescriptorHeaps(cl, 1, &s_vog.heap);
+    cl->lpVtbl->SetGraphicsRootSignature(cl, s_vog.rs);
+    cl->lpVtbl->SetPipelineState(cl, s_vog.pso);
+    cl->lpVtbl->SetGraphicsRootDescriptorTable(cl, 0, gh);
+    cl->lpVtbl->SetGraphicsRoot32BitConstants(cl, 1, 1, &e, 0);
+    D3D12_VIEWPORT vp = { 0.0f, 0.0f, (float)w, (float)h, 0.0f, 1.0f };
+    D3D12_RECT sc = { 0, 0, (LONG)w, (LONG)h };
+    cl->lpVtbl->RSSetViewports(cl, 1, &vp);
+    cl->lpVtbl->RSSetScissorRects(cl, 1, &sc);
+    cl->lpVtbl->OMSetRenderTargets(cl, 1, &rtv, FALSE, NULL);
+    cl->lpVtbl->IASetPrimitiveTopology(cl, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    cl->lpVtbl->DrawInstanced(cl, 3, 1, 0, 0);
+}
+
+#endif /* _WIN32 && !RSX_VOG_NO_D3D12 */
diff --git a/libs/video/rsx_videoout_gamma.h b/libs/video/rsx_videoout_gamma.h
new file mode 100644
index 0000000..1f00d51
--- /dev/null
+++ b/libs/video/rsx_videoout_gamma.h
@@ -0,0 +1,119 @@
+/*
+ * ps3recomp - video-out gamma (cellVideoOutSetGamma) as the display transfer.
+ *
+ * A PS3 title sets the gamma of the video output with
+ * cellVideoOutSetGamma(videoOut, gamma) (libsysutil avconf ext). It is part
+ * of the scanout, not of the frame buffer: the frame the title rendered, and
+ * every copy it reads back from guest memory, stay untouched; only what the
+ * display receives changes. So the transfer is applied to the backbuffer as
+ * the very last step before the Present (and before a CELLMARK dump, which
+ * stands in for a capture of the HDMI output), after every copy of the
+ * frame that the title can sample.
+ *
+ * Evidence (docs/GROUND_TRUTH.md tiers):
+ *  - Call shape, T3: inFamous 2's func_0013287C passes r3 = 0 (the primary
+ *    output) and, in f1, the saved option at settings +0x6A4 (written by the
+ *    options setter func_0004C12C; by its use here, the brightness option).
+ *    It calls only when the value differs from the one cached at this+8.
+ *  - Accepted range [0.8, 1.2] with CELL_VIDEO_OUT_ERROR_PARAMETER_OUT_OF_RANGE
+ *    outside it, then UNSUPPORTED_VIDEO_OUT for a non-primary output: T5 only
+ *    (RPCS3 cellAvconfExt.cpp, no hardware note). No public Sony document was
+ *    found (no PSL1GHT binding, no psdevwiki page). CryEngine 3's published
+ *    r_Gamma documentation (https://www.cryengine.com/docs/static/engines/
+ *    cryengine-3/categories/9895942/pages/9218939) calls it the "graphics card
+ *    gamma correction" that "affects also HUD and desktop" -- an output-stage
+ *    transfer, as placed here -- and gives the PS3 range as 0.8 to 1.25, so the
+ *    lower bound agrees and the upper bound is an OPEN QUESTION. A rejected
+ *    value is logged with its bits, so a title passing 1.2..1.25 shows up.
+ *  - The transfer itself: out = in ^ (1 / gamma) per 8-bit RGB channel, alpha
+ *    untouched, 1.0 = identity, gamma > 1 brightens. That is the usual
+ *    display-gamma convention (SDL 1.2's SDL_SetGamma builds its ramp as
+ *    pow(i/256, 1/gamma), src/video/SDL_gamma.c), not a Sony document: the
+ *    DIRECTION is an OPEN QUESTION, which is why VIDEOOUT_GAMMA=inv exists.
+ *    At 1.0 both readings are the identity.
+ *  - Default on, as the P0-3 task specified, although the direction has no
+ *    T4 note (GROUND_TRUTH rule 2 would default an unproven RSX-only rule
+ *    off): leaving the title's request unapplied is certainly wrong for any
+ *    gamma != 1.0, and 1.0 -- the boot value -- is a no-op. If the logged
+ *    gamma at default settings is not 1.0, the default is decided by the T1b
+ *    A/B (default / inv / 0) and recorded in GROUND_TRUTH open question 12.
+ *
+ * Switches:
+ *   VIDEOOUT_GAMMA=0        do not apply it (the value is still validated,
+ *                           stored and logged)
+ *   VIDEOOUT_GAMMA=1/unset  out = in ^ (1/gamma)
+ *   VIDEOOUT_GAMMA=inv      out = in ^ gamma (the other reading, for A/B)
+ *   VIDEOOUT_GAMMA_FORCE=g  use g instead of the title's value (picture A/B)
+ */
+#ifndef RSX_VIDEOOUT_GAMMA_H
+#define RSX_VIDEOOUT_GAMMA_H
+
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define RSX_VOG_MIN     0.8f
+#define RSX_VOG_MAX     1.2f
+#define RSX_VOG_DEFAULT 1.0f
+
+enum { RSX_VOG_OFF = 0, RSX_VOG_ON = 1, RSX_VOG_INV = 2 };
+
+/* The accepted range; NaN is out of range. */
+static inline int rsx_vog_in_range(float g)
+{
+    return g >= RSX_VOG_MIN && g <= RSX_VOG_MAX;
+}
+
+/* VIDEOOUT_GAMMA. *ok = 0 for a value it does not know (the caller logs it
+ * and keeps the default rather than guessing). */
+static inline int rsx_vog_parse_mode(const char* v, int* ok)
+{
+    *ok = 1;
+    if (!v || !*v || !strcmp(v, "1") || !strcmp(v, "on")) return RSX_VOG_ON;
+    if (!strcmp(v, "0") || !strcmp(v, "off")) return RSX_VOG_OFF;
+    if (!strcmp(v, "inv")) return RSX_VOG_INV;
+    *ok = 0;
+    return RSX_VOG_ON;
+}
+
+/* The exponent applied to the normalised channel value. */
+static inline float rsx_vog_exponent(float gamma, int mode)
+{
+    if (mode == RSX_VOG_OFF || !(gamma > 0.0f)) return 1.0f;
+    return mode == RSX_VOG_INV ? gamma : 1.0f / gamma;
+}
+
+/* The 8-bit transfer, the reference the present shader implements:
+ * round(255 * (v/255)^e). 0 and 255 are fixed points for every e. */
+static inline uint8_t rsx_vog_apply8(uint8_t v, float e)
+{
+    if (e == 1.0f || v == 0 || v == 255) return v;
+    double y = pow((double)v / 255.0, (double)e) * 255.0;
+    long o = (long)floor(y + 0.5);
+    return (uint8_t)(o < 0 ? 0 : o > 255 ? 255 : o);
+}
+
+/* State shared by cellVideoOutSetGamma (libs/misc/cellAvconfExt.c) and the
+ * present pass (rsx_videoout_gamma.c). */
+void        rsx_videoout_gamma_set(float gamma);   /* a value already validated */
+float       rsx_videoout_gamma_get(void);          /* last accepted, 1.0 at boot */
+int         rsx_videoout_gamma_mode(void);         /* VIDEOOUT_GAMMA */
+const char* rsx_videoout_gamma_mode_name(int mode);
+/* The exponent the present pass applies this frame (mode, force, value),
+ * divided by the PC brightness when that is not 1. */
+float       rsx_videoout_gamma_exponent_now(float* gamma_used);
+/* PC brightness (settings store "brightness", default 1.0 = the PS3's
+ * transfer exactly; outside [0.25, 4] means 1.0). Not a PS3 behaviour: the
+ * game's own brightness option is the gamma above. */
+void        rsx_videoout_gamma_set_brightness(float b);
+float       rsx_videoout_gamma_brightness(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* RSX_VIDEOOUT_GAMMA_H */
diff --git a/libs/video/rsx_vp_decompiler.c b/libs/video/rsx_vp_decompiler.c
index edd01d6..e55fc26 100644
