+++ b/libs/input/pad_hid_generic.c
@@ -0,0 +1,1088 @@
+/*
+ * ps3recomp - generic HID gamepads / joysticks for the pad host (pad_host.h)
+ *
+ * Everything with a Generic Desktop Joystick / Gamepad top-level collection
+ * that no specific driver (DS3, DS4, DualSense, Switch Pro) claims and that
+ * XInput does not serve: the DirectInput-class pads -- cheap USB pads, arcade
+ * sticks, flight sticks, retro adapters. A Multi-axis collection (3D mice and
+ * the like) only with a map.VID:PID line. Read entirely through
+ * the HID report descriptor (HidP_GetValueCaps / HidP_GetButtonCaps, then
+ * HidP_GetUsageValue / HidP_GetUsages per report), so it needs nothing
+ * device-specific. No rumble: HID force feedback (PID) is not supported.
+ *
+ * Axes are named by usage, the way DirectInput numbers them:
+ *   a0 X   a1 Y   a2 Z   a3 Rx   a4 Ry   a5 Rz   a6 Slider   a7 Dial   a8 Wheel
+ *   a9+    anything further in descriptor order: a second X/Y/..., and the
+ *          Simulation page's Rudder, Throttle, Accelerator, Brake, Steering.
+ * Buttons are bN with N the HID button usage, 1-based: the number Windows'
+ * "Game Controllers" panel shows. Hats are h0, h1, ... in descriptor order.
+ *
+ * Default layout (the common DirectInput convention; a DS4 or DualSense in
+ * plain HID mode comes out exactly right with it):
+ *   left stick X/Y; right stick Z/Rz with Rx/Ry as analog L2/R2, or Rx/Ry
+ *   when Z/Rz are absent (then a lone Z is a shared trigger axis: above the
+ *   middle L2, below it R2, as Xbox pads report under DirectInput); a second
+ *   X/Y pair as the right stick when nothing else is; Brake/Accelerator as
+ *   L2/R2 if no axis feeds them yet; hat 0 = d-pad; a Slider or Dial (a
+ *   throttle wheel: it stays where it is left) never feeds a stick;
+ *   b1 Square b2 Cross b3 Circle b4 Triangle (left/bottom/right/top),
+ *   b5 L1 b6 R1 b7 L2 b8 R2, b9 Select b10 Start, b11 L3 b12 R3, b13 PS.
+ *
+ * Every axis is normalised from its own logical range: raw bits are sign-
+ * extended when the logical minimum is negative, a Logical Maximum that came
+ * out below the minimum (0xFFFF written without a sign byte reads as -1, a
+ * common descriptor bug) is taken as the unsigned range of the field, and a
+ * value outside the range (the null state) is "at rest". Sticks are reported
+ * raw (the pad host applies the deadzone), except that a stick within one
+ * 8-bit step of the middle of its range reads exactly 128, so a pad resting
+ * at 127 or 128 of 0..255 is centred.
+ *
+ * On a Joystick / Multi-axis device (not a Gamepad collection) an axis only
+ * counts once it has been seen where its use rests: a stick or a half-axis
+ * near the middle, a trigger near its released end. Until then it reads at
+ * rest. A wheel's pedals resting at one end of Y / Rz, or a flight stick's
+ * throttle, would otherwise hold a stick or trigger down for good -- on port
+ * 0, merged with the keyboard, a player walking backwards with nothing
+ * touched.
+ *
+ * Per-device mapping: one line per device in input.ini's [gamepad] section
+ * (the pad host's controller settings; PAD_HOST="map.VID:PID=..." works too):
+ *
+ *   [gamepad]
+ *   map.0079:0006 = Triangle=b1 Circle=b2 Cross=b3 Square=b4 RX=a3 RY=a2
+ *   map.0810:0001 = ignore
+ *
+ * VID:PID in hex. The value is Target=Source items separated by spaces or
+ * commas; targets not named keep the default layout, Target=none unbinds
+ * one, and "ignore" leaves the device to other programs.
+ *   Targets  Cross Circle Square Triangle L1 R1 L2 R2 L3 R3 Start Select PS
+ *            Up Down Left Right, Dpad (all four from one hat), LX LY RX RY
+ *   Sources  bN       button N
+ *            aN       axis N: a stick target uses its whole range, a button
+ *                     or trigger reads min = released .. max = fully pressed
+ *            aN~      the same axis reversed
+ *            aN+ aN-  the half above / below the middle (buttons and
+ *                     triggers: a stick or a shared trigger axis as buttons)
+ *            hN.up hN.down hN.left hN.right   hat N's directions; Dpad=hN
+ *            home, dpad.up/.down/.left/.right  HID System Menu / AC Home
+ *                     and Generic Desktop d-pad buttons
+ *   Several sources for one target: L2=b7/a3 (the strongest wins).
+ * When a pad is opened its active line is logged in this syntax, ready to be
+ * copied into input.ini and edited.
+ */
+#if defined(_WIN32)
+
+#include "pad_host.h"
+#include "cellPad.h"
+
+#include <ctype.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef WIN32_LEAN_AND_MEAN
+  #define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <hidsdi.h>
+#pragma comment(lib, "hid.lib")
+
+/* ---------------------------------------------------------------------------
+ * Targets and sources
+ * -----------------------------------------------------------------------*/
+
+/* 0..15 are the CELL_PAD_CTRL_* bit numbers (SELECT = bit 0 .. SQUARE = 15),
+ * the same numbering pad_kbm.h uses for its targets. */
+enum {
+    GT_SELECT = 0, GT_L3, GT_R3, GT_START, GT_UP, GT_RIGHT, GT_DOWN, GT_LEFT,
+    GT_L2, GT_R2, GT_L1, GT_R1, GT_TRIANGLE, GT_CIRCLE, GT_CROSS, GT_SQUARE,
+    GT_PS, GT_LX, GT_LY, GT_RX, GT_RY,
+    GT_COUNT,
+    GT_DPAD = 100               /* parser only: Up/Right/Down/Left of one hat */
+};
+
+enum { GS_NONE = 0, GS_BUTTON, GS_AXIS, GS_HAT, GS_DPADBTN, GS_HOME };
+enum { GA_FULL = 0, GA_INV, GA_POS, GA_NEG };          /* axis use */
+enum { GH_UP = 1, GH_RIGHT = 2, GH_DOWN = 4, GH_LEFT = 8 };
+
+typedef struct { u8 kind, index, mode; } GenSrc;      /* index: button 1..128 / axis slot / hat */
+#define GEN_MAX_SRC 4
+typedef struct { u8 n; GenSrc s[GEN_MAX_SRC]; } GenBind;
+typedef struct { GenBind t[GT_COUNT]; } GenMap;
+
+/* An axis or button feeding a digital target counts as pressed from here
+ * (0..255): 16 %, between XInput's trigger threshold and a stick's drift. */
+#define GEN_DIGITAL_THRESHOLD 40
+
+static const struct { const char* name; int t; } gen_target_names[] = {
+    /* first entry per target is the printed name */
+    {"Cross", GT_CROSS}, {"Circle", GT_CIRCLE}, {"Square", GT_SQUARE},
+    {"Triangle", GT_TRIANGLE}, {"L1", GT_L1}, {"R1", GT_R1}, {"L2", GT_L2},
+    {"R2", GT_R2}, {"L3", GT_L3}, {"R3", GT_R3}, {"Start", GT_START},
+    {"Select", GT_SELECT}, {"PS", GT_PS}, {"Up", GT_UP}, {"Down", GT_DOWN},
+    {"Left", GT_LEFT}, {"Right", GT_RIGHT}, {"LX", GT_LX}, {"LY", GT_LY},
+    {"RX", GT_RX}, {"RY", GT_RY}, {"Dpad", GT_DPAD},
+    /* aliases */
+    {"Home", GT_PS}, {"Guide", GT_PS}, {"Share", GT_SELECT}, {"Back", GT_SELECT},
+    {"Options", GT_START}, {"DpadUp", GT_UP}, {"DpadDown", GT_DOWN},
+    {"DpadLeft", GT_LEFT}, {"DpadRight", GT_RIGHT}, {"LeftX", GT_LX},
+    {"LeftY", GT_LY}, {"RightX", GT_RX}, {"RightY", GT_RY}, {"LStickX", GT_LX},
+    {"LStickY", GT_LY}, {"RStickX", GT_RX}, {"RStickY", GT_RY},
+};
+
+/* ---------------------------------------------------------------------------
+ * Mapping lines (map.VID:PID)
+ * -----------------------------------------------------------------------*/
+
+typedef struct {
+    u8 ignore;
+    u8 set[GT_COUNT];           /* 1 = this target replaced by bind[] */
+    GenBind bind[GT_COUNT];
+} GenOverride;
+
+/* Compare ignoring case, spaces, '_' and '-' (as pad_kbm.h does). */
+static void gcfg_norm(const char* s, char* out, size_t n)
+{
+    size_t k = 0;
+    for (; *s && k + 1 < n; s++) {
+        if (*s == ' ' || *s == '\t' || *s == '_' || *s == '-') continue;
+        out[k++] = (char)tolower((unsigned char)*s);
+    }
+    out[k] = 0;
+}
+
+static int gen_target_from_name(const char* name)
+{
+    char a[32], b[32];
+    gcfg_norm(name, a, sizeof a);
+    for (size_t i = 0; i < sizeof gen_target_names / sizeof gen_target_names[0]; i++) {
+        gcfg_norm(gen_target_names[i].name, b, sizeof b);
+        if (!strcmp(a, b)) return gen_target_names[i].t;
+    }
+    return -1;
+}
+
+static const char* gen_target_name(int t)
+{
+    for (size_t i = 0; i < sizeof gen_target_names / sizeof gen_target_names[0]; i++)
+        if (gen_target_names[i].t == t) return gen_target_names[i].name;
+    return "?";
+}
+
+static int gen_is_stick(int t) { return t >= GT_LX && t <= GT_RY; }
+
+static int gcfg_hat_dir(const char* s)
+{
+    char n[16];
+    gcfg_norm(s, n, sizeof n);
+    if (!strcmp(n, "up") || !strcmp(n, "u") || !strcmp(n, "n") || !strcmp(n, "1")) return GH_UP;
+    if (!strcmp(n, "right") || !strcmp(n, "r") || !strcmp(n, "e") || !strcmp(n, "2")) return GH_RIGHT;
+    if (!strcmp(n, "down") || !strcmp(n, "d") || !strcmp(n, "s") || !strcmp(n, "4")) return GH_DOWN;
+    if (!strcmp(n, "left") || !strcmp(n, "l") || !strcmp(n, "w") || !strcmp(n, "8")) return GH_LEFT;
+    return 0;
+}
+
+/* One source for target t. Returns 1 ok (*out filled; kind GS_NONE = "none"),
+ * 0 = syntax error, -1 = not allowed for this target. For the Dpad target the
+ * only source is a bare hat (hN), returned with mode 0. */
+static int gcfg_parse_src(const char* s, int t, GenSrc* out)
+{
+    char n[32];
+    gcfg_norm(s, n, sizeof n);
+    memset(out, 0, sizeof *out);
+    if (!strcmp(n, "none")) return 1;
+    if (!strcmp(n, "home")) {
+        out->kind = GS_HOME;
+        return (t == GT_DPAD || gen_is_stick(t)) ? -1 : 1;
+    }
+    if (!strncmp(n, "dpad.", 5)) {
+        int dir = gcfg_hat_dir(n + 5);
+        if (!dir) return 0;
+        out->kind = GS_DPADBTN; out->mode = (u8)dir;
+        return (t == GT_DPAD || gen_is_stick(t)) ? -1 : 1;
+    }
+    if (n[0] != 'a' && n[0] != 'b' && n[0] != 'h') return 0;
+    if (!isdigit((unsigned char)n[1])) return 0;
+    char* end;
+    long idx = strtol(n + 1, &end, 10);
+    if (n[0] == 'b') {
+        if (*end || idx < 1 || idx > 128) return 0;
+        out->kind = GS_BUTTON; out->index = (u8)idx;
+        return (t == GT_DPAD || gen_is_stick(t)) ? -1 : 1;
+    }
+    if (n[0] == 'a') {
+        if (idx < 0 || idx > 15) return 0;
+        out->kind = GS_AXIS; out->index = (u8)idx; out->mode = GA_FULL;
+        if (*end == '~')      { out->mode = GA_INV; end++; }
+        else if (*end == '+') { out->mode = GA_POS; end++; }
+        /* '-' is dropped by gcfg_norm, so read the suffix from the original */
+        else if (!*end) {
+            const char* o = s + strlen(s);
+            while (o > s && (o[-1] == ' ' || o[-1] == '\t')) o--;
+            if (o > s && o[-1] == '-') out->mode = GA_NEG;
+        }
+        if (*end) return 0;
+        if (t == GT_DPAD) return -1;
+        if (gen_is_stick(t) && out->mode != GA_FULL && out->mode != GA_INV) return -1;
+        return 1;
+    }
+    /* hat */
+    if (idx < 0 || idx > 3) return 0;
+    out->kind = GS_HAT; out->index = (u8)idx;
+    if (!*end) return t == GT_DPAD ? 1 : -1;
+    if (*end != '.') return 0;
+    int dir = gcfg_hat_dir(end + 1);
+    if (!dir) return 0;
+    out->mode = (u8)dir;
+    return (t == GT_DPAD || gen_is_stick(t)) ? -1 : 1;
+}
+
+/* A mapping line's value: "Target=Source[/Source...]" items separated by
+ * spaces or commas, or "ignore". Applies the good items to *o; returns the
+ * number of bad ones, the first described in err. */
+static int gcfg_parse_device(GenOverride* o, const char* value, char* err, size_t errn)
+{
+    char buf[512];
+    snprintf(buf, sizeof buf, "%s", value);
+    int bad = 0;
+    char* p = buf;
+    while (*p) {
+        while (*p == ' ' || *p == '\t' || *p == ',') p++;
+        if (!*p) break;
+        char* tok = p;
+        while (*p && *p != ' ' && *p != '\t' && *p != ',') p++;
+        if (*p) *p++ = 0;
+
+        char* eq = strchr(tok, '=');
+        if (!eq) {
+            char n[16];
+            gcfg_norm(tok, n, sizeof n);
+            if (!strcmp(n, "ignore")) { o->ignore = 1; continue; }
+            if (!bad++) snprintf(err, errn, "expected Target=Source, got \"%s\"", tok);
+            continue;
+        }
+        *eq = 0;
+        int t = gen_target_from_name(tok);
+        if (t < 0) {
+            if (!bad++) snprintf(err, errn, "unknown target \"%s\"", tok);
+            continue;
+        }
+        GenBind b;
+        memset(&b, 0, sizeof b);
+        int ok = 1, dpad_hat = -1;
+        char* sp = eq + 1;
+        for (;;) {
+            char* slash = strchr(sp, '/');
+            if (slash) *slash = 0;
+            GenSrc s;
+            int r = gcfg_parse_src(sp, t, &s);
+            if (r <= 0) {
+                if (!bad++) snprintf(err, errn, r ? "%s: source \"%s\" does not fit this target"
+                                                  : "%s: bad source \"%s\"", tok, sp);
+                ok = 0;
+                break;
+            }
+            if (t == GT_DPAD) {
+                if (s.kind == GS_HAT) dpad_hat = s.index;
+            } else if (s.kind != GS_NONE && b.n < GEN_MAX_SRC) {
+                b.s[b.n++] = s;
+            }
+            if (!slash) break;
+            sp = slash + 1;
+        }
+        if (!ok) continue;
+        if (t == GT_DPAD) {
+            static const struct { int t; u8 dir; } dp[4] = {
+                {GT_UP, GH_UP}, {GT_RIGHT, GH_RIGHT}, {GT_DOWN, GH_DOWN}, {GT_LEFT, GH_LEFT} };
+            for (int k = 0; k < 4; k++) {
+                GenBind* d = &o->bind[dp[k].t];
+                memset(d, 0, sizeof *d);
+                if (dpad_hat >= 0) {
+                    d->n = 1;
+                    d->s[0].kind = GS_HAT; d->s[0].index = (u8)dpad_hat; d->s[0].mode = dp[k].dir;
+                }
+                o->set[dp[k].t] = 1;
+            }
+        } else {
+            o->bind[t] = b;
+            o->set[t] = 1;
+        }
+    }
+    return bad;
+}
+
+/* The device's mapping line, or NULL. The pad host stores [gamepad] keys
+ * that start with "map" (or "generic") for the drivers; its key compare
+ * ignores case, spaces, '_', '-' and '.'. */
+static const char* gen_cfg_line(u16 vid, u16 pid)
+{
+    char k[32];
+    snprintf(k, sizeof k, "map.%04X:%04X", vid, pid);
+    const char* v = padhost_config_get(k);
+    if (!v) {
+        snprintf(k, sizeof k, "generic.%04X:%04X", vid, pid);
+        v = padhost_config_get(k);
+    }
+    return v;
+}
+
+/* ---------------------------------------------------------------------------
+ * Device description (from the report descriptor) and the HidP layer
+ * -----------------------------------------------------------------------*/
+
+#define GEN_MAX_VALUES   20     /* axes + hats */
+#define GEN_MAX_AXES     16     /* axis slots a0..a15 */
+#define GEN_MAX_HATS     4
+#define GEN_MAX_BRANGES  16
+#define GEN_MAX_BUTTONS  128
+#define GEN_NAMED_AXES   9      /* a0..a8 have fixed usages */
+
+#define GEN_PAGE_GD      0x01
+#define GEN_PAGE_SIM     0x02
+#define GEN_PAGE_BUTTON  0x09
+#define GEN_PAGE_CONSUMER 0x0C
+#define GEN_GD_HAT       0x39
+#define GEN_GD_MENU      0x85   /* System Main Menu */
+#define GEN_GD_DPAD_UP   0x90   /* .. 0x93: D-pad Up, Down, Right, Left */
+#define GEN_CONS_AC_HOME 0x223
+
+typedef struct {
+    u16 page, usage, link;
+    u8  report_id, bits, has_null;
+    s32 lmin, lmax;
+    u8  count;                  /* > 1: a value array (Report Count above the usages
+                                 * listed, the last usage repeated); its first field is read */
+} GenValue;                     /* one axis or hat */
+
+typedef struct { u16 page, umin, umax, link; u8 report_id; } GenBtnRange;
+
+typedef struct {
+    int nvalues;
+    GenValue values[GEN_MAX_VALUES];
+    int nbr;
+    GenBtnRange br[GEN_MAX_BRANGES];
+} GenDesc;
+
+/* The HidP calls, behind a table so the tests can run the driver on a fake
+ * descriptor. */
+typedef struct {
+    /* fill *g (and a product name if the device has none yet); 0 = ok */
+    int (*describe)(PadHostDevice* d, GenDesc* g, char* name, int name_cap);
+    /* 0 = *raw read, 1 = not in this report, -1 = error */
+    int (*get_value)(PadHostDevice* d, const GenValue* v, const unsigned char* rep, int len, u32* raw);
+    /* usages of this page that are down (count >= 0), or -1 = none in this report */
+    int (*get_usages)(PadHostDevice* d, u16 page, const unsigned char* rep, int len, u16* usages, int cap);
+} GenHidOps;
+
+static int gen_value_wanted(u16 page, u16 usage)
+{
+    if (page == GEN_PAGE_GD) return usage >= 0x30 && usage <= GEN_GD_HAT;
+    if (page == GEN_PAGE_SIM)
+        return usage == 0xBA || usage == 0xBB || usage == 0xC4 || usage == 0xC5 || usage == 0xC8;
+    return 0;
+}
+
+static int gen_button_wanted(u16 page, u16 umin, u16 umax)
+{
+    if (page == GEN_PAGE_BUTTON) return 1;
+    if (page == GEN_PAGE_GD)
+        return (umin <= GEN_GD_MENU && umax >= GEN_GD_MENU) ||
+               (umin <= GEN_GD_DPAD_UP + 3 && umax >= GEN_GD_DPAD_UP);
+    if (page == GEN_PAGE_CONSUMER) return umin <= GEN_CONS_AC_HOME && umax >= GEN_CONS_AC_HOME;
+    return 0;
+}
+
+static int gen_win_describe(PadHostDevice* d, GenDesc* g, char* name, int name_cap)
+{
+    PHIDP_PREPARSED_DATA pp = (PHIDP_PREPARSED_DATA)d->preparsed;
+    HIDP_CAPS caps;
+    memset(g, 0, sizeof *g);
+    if (!pp || HidP_GetCaps(pp, &caps) != HIDP_STATUS_SUCCESS) return -1;
+
+    HIDP_VALUE_CAPS vc[64];
+    USHORT nv = caps.NumberInputValueCaps > 64 ? 64 : caps.NumberInputValueCaps;
+    if (nv && HidP_GetValueCaps(HidP_Input, vc, &nv, pp) != HIDP_STATUS_SUCCESS) nv = 0;
+    for (USHORT i = 0; i < nv; i++) {
+        const HIDP_VALUE_CAPS* c = &vc[i];
+        if (!c->IsAbsolute) continue;                          /* a trackball / mouse-like axis */
+        unsigned lo = c->IsRange ? c->Range.UsageMin : c->NotRange.Usage;
+        unsigned hi = c->IsRange ? c->Range.UsageMax : c->NotRange.Usage;
+        for (unsigned u = lo; u <= hi && g->nvalues < GEN_MAX_VALUES; u++) {
+            if (!gen_value_wanted(c->UsagePage, (u16)u)) continue;
+            GenValue* v = &g->values[g->nvalues++];
+            v->page = c->UsagePage; v->usage = (u16)u; v->link = c->LinkCollection;
+            v->report_id = c->ReportID; v->bits = (u8)c->BitSize; v->has_null = c->HasNull ? 1 : 0;
+            v->count = (u8)(!c->IsRange && c->ReportCount > 1 ? (c->ReportCount > 255 ? 255 : c->ReportCount) : 1);
+            v->lmin = c->LogicalMin; v->lmax = c->LogicalMax;
+        }
+    }
+
+    HIDP_BUTTON_CAPS bc[64];
+    USHORT nb = caps.NumberInputButtonCaps > 64 ? 64 : caps.NumberInputButtonCaps;
+    if (nb && HidP_GetButtonCaps(HidP_Input, bc, &nb, pp) != HIDP_STATUS_SUCCESS) nb = 0;
+    for (USHORT i = 0; i < nb && g->nbr < GEN_MAX_BRANGES; i++) {
+        const HIDP_BUTTON_CAPS* c = &bc[i];
+        u16 lo = c->IsRange ? c->Range.UsageMin : c->NotRange.Usage;
+        u16 hi = c->IsRange ? c->Range.UsageMax : c->NotRange.Usage;
+        if (!gen_button_wanted(c->UsagePage, lo, hi)) continue;
+        GenBtnRange* r = &g->br[g->nbr++];
+        r->page = c->UsagePage; r->umin = lo; r->umax = hi;
+        r->link = c->LinkCollection; r->report_id = c->ReportID;
+    }
+
+    name[0] = 0;
+    WCHAR w[128];
+    if (!d->name[0] && d->handle && d->handle != INVALID_HANDLE_VALUE &&
+        HidD_GetProductString((HANDLE)d->handle, w, sizeof w)) {
+        w[127] = 0;
+        if (!WideCharToMultiByte(CP_UTF8, 0, w, -1, name, name_cap, NULL, NULL)) name[0] = 0;
+    }
+    return 0;
+}
+
+static int gen_win_get_value(PadHostDevice* d, const GenValue* v, const unsigned char* rep, int len, u32* raw)
+{
+    ULONG x = 0;
+    NTSTATUS s;
+    if (v->count > 1) {
+        /* A value array comes back packed, field after field, LSB first;
+         * the first field is the axis. */
+        unsigned char buf[256];
+        USHORT n = (USHORT)(((unsigned)v->bits * v->count + 7) / 8);
+        if (!v->bits || v->bits > 32 || n > sizeof buf) return -1;
+        memset(buf, 0, sizeof buf);
+        s = HidP_GetUsageValueArray(HidP_Input, v->page, v->link, v->usage, (PCHAR)buf, n,
+                                    (PHIDP_PREPARSED_DATA)d->preparsed, (PCHAR)(uintptr_t)rep, (ULONG)len);
+        if (s == HIDP_STATUS_SUCCESS)
+            for (unsigned b = 0; b < v->bits; b++)
+                if (buf[b >> 3] & (1u << (b & 7))) x |= 1ul << b;
+    } else {
+        s = HidP_GetUsageValue(HidP_Input, v->page, v->link, v->usage, &x,
+                               (PHIDP_PREPARSED_DATA)d->preparsed, (PCHAR)(uintptr_t)rep, (ULONG)len);
+    }
+    if (s == HIDP_STATUS_SUCCESS) { *raw = (u32)x; return 0; }
+    if (s == HIDP_STATUS_INCOMPATIBLE_REPORT_ID) return 1;
+    return -1;
+}
+
+static int gen_win_get_usages(PadHostDevice* d, u16 page, const unsigned char* rep, int len, u16* usages, int cap)
+{
+    USAGE list[256];
+    ULONG n = 256;
+    NTSTATUS s = HidP_GetUsages(HidP_Input, page, 0, list, &n,
+                                (PHIDP_PREPARSED_DATA)d->preparsed, (PCHAR)(uintptr_t)rep, (ULONG)len);
+    if (s != HIDP_STATUS_SUCCESS) return -1;
+    int k = 0;
+    for (ULONG i = 0; i < n && k < cap; i++) usages[k++] = list[i];
+    return k;
+}
+
+static const GenHidOps gen_win_ops = { gen_win_describe, gen_win_get_value, gen_win_get_usages };
+static const GenHidOps* s_gen_ops = &gen_win_ops;
+
+/* ---------------------------------------------------------------------------
+ * Per-device state
+ * -----------------------------------------------------------------------*/
+
+#define GEN_SP_UP    GH_UP      /* Generic Desktop d-pad buttons, same bits as a hat */
+#define GEN_SP_RIGHT GH_RIGHT
+#define GEN_SP_DOWN  GH_DOWN
+#define GEN_SP_LEFT  GH_LEFT
+#define GEN_SP_HOME  0x10
+
+typedef struct {
+    GenDesc desc;
+    s8   slot_val[GEN_MAX_AXES];        /* axis slot -> desc.values index, -1 = none */
+    s8   hat_val[GEN_MAX_HATS];         /* hat n -> desc.values index */
+    s8   dup_x, dup_y;                  /* slots of a second X / Y */
+    s8   brake, accel;                  /* slots of Simulation Brake / Accelerator */
+    u8   nslots, nhats;
+    u8   nbuttons;                      /* highest Button-page usage */
+    u8   has_ids;                       /* reports carry a report ID byte */
+    u8   overridden;
+    u8   rest_guard;                    /* a Joystick / Multi-axis device: see the header */
+    u8   rest[GEN_MAX_VALUES];          /* GEN_REST_*: where each value has been seen */
+    GenMap map;
+    /* latest raw state */
+    s32  val[GEN_MAX_VALUES];
+    u8   val_ok[GEN_MAX_VALUES];
+    u32  btn[GEN_MAX_BUTTONS / 32];     /* bit n-1 = button n */
+    u8   special;                       /* GEN_SP_* */
+    char name[64];
+} GenPriv;
+
+#ifdef __cplusplus
+static_assert(sizeof(GenPriv) <= sizeof(((PadHostDevice*)0)->priv), "GenPriv too big");
+#else
+_Static_assert(sizeof(GenPriv) <= sizeof(((PadHostDevice*)0)->priv), "GenPriv too big");
+#endif
+
+static GenPriv* gen_priv(PadHostDevice* d) { return (GenPriv*)(void*)d->priv; }
+
+#define GEN_REST_MID 1                  /* within a quarter of the middle */
+#define GEN_REST_MIN 2                  /* in the lowest quarter */
+#define GEN_REST_MAX 4                  /* in the highest quarter */
+
+static const char* gen_axis_usage_name(const GenValue* v)
+{
+    static const char* gd[] = { "X", "Y", "Z", "Rx", "Ry", "Rz", "Slider", "Dial", "Wheel" };
+    if (v->page == GEN_PAGE_GD && v->usage >= 0x30 && v->usage <= 0x38) return gd[v->usage - 0x30];
+    if (v->page == GEN_PAGE_SIM) {
+        if (v->usage == 0xBA) return "Rudder";
+        if (v->usage == 0xBB) return "Throttle";
+        if (v->usage == 0xC4) return "Accelerator";
+        if (v->usage == 0xC5) return "Brake";
+        if (v->usage == 0xC8) return "Steering";
+    }
+    return "?";
+}
+
+/* Axis slots (a0..a8 by usage, the rest in order), hats, button count. */
+static void gen_classify(GenPriv* p)
+{
+    memset(p->slot_val, -1, sizeof p->slot_val);
+    memset(p->hat_val, -1, sizeof p->hat_val);
+    p->dup_x = p->dup_y = p->brake = p->accel = -1;
+    p->nhats = 0;
+    int next_extra = GEN_NAMED_AXES;
+    for (int i = 0; i < p->desc.nvalues; i++) {
+        const GenValue* v = &p->desc.values[i];
+        if (v->report_id) p->has_ids = 1;
+        if (v->page == GEN_PAGE_GD && v->usage == GEN_GD_HAT) {
+            if (p->nhats < GEN_MAX_HATS) p->hat_val[p->nhats++] = (s8)i;
+            continue;
+        }
+        int slot = -1;
+        if (v->page == GEN_PAGE_GD && v->usage <= 0x38 && p->slot_val[v->usage - 0x30] < 0)
+            slot = v->usage - 0x30;
+        else if (next_extra < GEN_MAX_AXES)
+            slot = next_extra++;
+        if (slot < 0) continue;
+        p->slot_val[slot] = (s8)i;
+        if (slot >= GEN_NAMED_AXES) {
+            if (v->page == GEN_PAGE_GD && v->usage == 0x30 && p->dup_x < 0) p->dup_x = (s8)slot;
+            if (v->page == GEN_PAGE_GD && v->usage == 0x31 && p->dup_y < 0) p->dup_y = (s8)slot;
+            if (v->page == GEN_PAGE_SIM && v->usage == 0xC5 && p->brake < 0) p->brake = (s8)slot;
+            if (v->page == GEN_PAGE_SIM && v->usage == 0xC4 && p->accel < 0) p->accel = (s8)slot;
+        }
+    }
+    p->nslots = 0;
+    for (int s = 0; s < GEN_MAX_AXES; s++) if (p->slot_val[s] >= 0) p->nslots++;
+    p->nbuttons = 0;
+    for (int i = 0; i < p->desc.nbr; i++) {
+        const GenBtnRange* r = &p->desc.br[i];
+        if (r->report_id) p->has_ids = 1;
+        if (r->page == GEN_PAGE_BUTTON) {
+            unsigned hi = r->umax > GEN_MAX_BUTTONS ? GEN_MAX_BUTTONS : r->umax;
+            if (hi > p->nbuttons) p->nbuttons = (u8)hi;
+        }
+    }
+}
+
+static void gen_bind_add(GenMap* m, int t, u8 kind, u8 index, u8 mode)
+{
+    GenBind* b = &m->t[t];
+    if (b->n >= GEN_MAX_SRC) return;
+    b->s[b->n].kind = kind; b->s[b->n].index = index; b->s[b->n].mode = mode;
+    b->n++;
+}
+
+static int gen_bind_has_axis(const GenMap* m, int t)
+{
+    for (int i = 0; i < m->t[t].n; i++) if (m->t[t].s[i].kind == GS_AXIS) return 1;
+    return 0;
+}
+
+static int gen_has_button_usage(const GenPriv* p, u16 page, u16 usage)
+{
+    for (int i = 0; i < p->desc.nbr; i++) {
+        const GenBtnRange* r = &p->desc.br[i];
+        if (r->page == page && usage >= r->umin && usage <= r->umax) return 1;
+    }
+    return 0;
+}
+
+static void gen_default_map(const GenPriv* p, GenMap* m)
+{
+    memset(m, 0, sizeof *m);
+#define HAS(s) (p->slot_val[s] >= 0)
+    if (HAS(0)) gen_bind_add(m, GT_LX, GS_AXIS, 0, GA_FULL);
+    if (HAS(1)) gen_bind_add(m, GT_LY, GS_AXIS, 1, GA_FULL);
+    if (HAS(2) && HAS(5)) {
+        gen_bind_add(m, GT_RX, GS_AXIS, 2, GA_FULL);
+        gen_bind_add(m, GT_RY, GS_AXIS, 5, GA_FULL);
+        if (HAS(3)) gen_bind_add(m, GT_L2, GS_AXIS, 3, GA_FULL);
+        if (HAS(4)) gen_bind_add(m, GT_R2, GS_AXIS, 4, GA_FULL);
+    } else if (HAS(3) && HAS(4)) {
+        gen_bind_add(m, GT_RX, GS_AXIS, 3, GA_FULL);
+        gen_bind_add(m, GT_RY, GS_AXIS, 4, GA_FULL);
+        if (HAS(2)) {
+            gen_bind_add(m, GT_L2, GS_AXIS, 2, GA_POS);
+            gen_bind_add(m, GT_R2, GS_AXIS, 2, GA_NEG);
+        }
+    } else if (HAS(2) || HAS(5)) {
+        /* one of Z / Rz, maybe with one of Rx / Ry (never a Slider: a throttle
+         * stays where it is left, and the camera would spin) */
+        static const int rx_pref[] = { 2, 3 }, ry_pref[] = { 5, 4 };
+        int rx = -1, ry = -1;
+        for (int i = 0; i < 2 && rx < 0; i++) if (HAS(rx_pref[i])) rx = rx_pref[i];
+        for (int i = 0; i < 2 && ry < 0; i++) if (HAS(ry_pref[i]) && ry_pref[i] != rx) ry = ry_pref[i];
+        if (rx >= 0) gen_bind_add(m, GT_RX, GS_AXIS, (u8)rx, GA_FULL);
+        if (ry >= 0) gen_bind_add(m, GT_RY, GS_AXIS, (u8)ry, GA_FULL);
+    } else if (p->dup_x >= 0 && p->dup_y >= 0) {
+        gen_bind_add(m, GT_RX, GS_AXIS, (u8)p->dup_x, GA_FULL);
+        gen_bind_add(m, GT_RY, GS_AXIS, (u8)p->dup_y, GA_FULL);
+    }
+#undef HAS
+    if (!gen_bind_has_axis(m, GT_L2) && p->brake >= 0) gen_bind_add(m, GT_L2, GS_AXIS, (u8)p->brake, GA_FULL);
+    if (!gen_bind_has_axis(m, GT_R2) && p->accel >= 0) gen_bind_add(m, GT_R2, GS_AXIS, (u8)p->accel, GA_FULL);
+
+    static const struct { int t; u8 dir; u16 gd_usage; } dp[4] = {
+        {GT_UP, GH_UP, GEN_GD_DPAD_UP}, {GT_RIGHT, GH_RIGHT, GEN_GD_DPAD_UP + 2},
+        {GT_DOWN, GH_DOWN, GEN_GD_DPAD_UP + 1}, {GT_LEFT, GH_LEFT, GEN_GD_DPAD_UP + 3} };
+    for (int k = 0; k < 4; k++) {
+        if (p->nhats > 0) gen_bind_add(m, dp[k].t, GS_HAT, 0, dp[k].dir);
+        if (gen_has_button_usage(p, GEN_PAGE_GD, dp[k].gd_usage)) gen_bind_add(m, dp[k].t, GS_DPADBTN, 0, dp[k].dir);
+    }
+
+    static const u8 order[13] = { GT_SQUARE, GT_CROSS, GT_CIRCLE, GT_TRIANGLE, GT_L1, GT_R1,
+                                  GT_L2, GT_R2, GT_SELECT, GT_START, GT_L3, GT_R3, GT_PS };
+    for (int i = 0; i < 13 && i < p->nbuttons; i++) gen_bind_add(m, order[i], GS_BUTTON, (u8)(i + 1), 0);
+    if (gen_has_button_usage(p, GEN_PAGE_GD, GEN_GD_MENU) || gen_has_button_usage(p, GEN_PAGE_CONSUMER, GEN_CONS_AC_HOME))
+        gen_bind_add(m, GT_PS, GS_HOME, 0, 0);
+}
+
+/* ---------------------------------------------------------------------------
+ * Normalisation and evaluation
+ * -----------------------------------------------------------------------*/
+
+static s32 gen_value_from_raw(const GenValue* v, u32 raw)
+{
+    if (v->lmin < 0 && v->bits > 0 && v->bits < 32 && (raw & (1u << (v->bits - 1))))
+        raw |= ~((1u << v->bits) - 1u);
+    return (s32)raw;
+}
+
+static void gen_range(const GenValue* v, s32* lo, s32* hi)
+{
+    *lo = v->lmin;
+    *hi = v->lmax;
+    if (*hi <= *lo) {           /* see the header comment: take the field's unsigned range */
+        *lo = 0;
+        *hi = (v->bits >= 1 && v->bits <= 30) ? (s32)((1u << v->bits) - 1u) : 0x3FFFFFFF;
+    }
+}
+
+/* The value of desc.values[vi], -1..+1 about the middle of its range (0 when
+ * no report has carried it yet or it is in its null state). */
+static float gen_centered(const GenPriv* p, int vi)
+{
+    if (vi < 0 || !p->val_ok[vi]) return 0.0f;
+    s32 lo, hi;
+    gen_range(&p->desc.values[vi], &lo, &hi);
+    s32 x = p->val[vi];
+    if (x < lo || x > hi) return 0.0f;
+    double half = ((double)hi - (double)lo) / 2.0;
+    double dv = (double)x - ((double)lo + half);
+    if (fabs(dv) <= half / 128.0) return 0.0f;      /* centre snap */
+    double n = dv / half;
+    return (float)(n < -1.0 ? -1.0 : n > 1.0 ? 1.0 : n);
+}
+
+/* 0..1 from the minimum to the maximum (0 when unknown / null). */
+static float gen_full(const GenPriv* p, int vi, int inverted)
+{
+    if (vi < 0 || !p->val_ok[vi]) return 0.0f;
+    s32 lo, hi;
+    gen_range(&p->desc.values[vi], &lo, &hi);
+    s32 x = p->val[vi];
+    if (x < lo || x > hi) return 0.0f;
+    double f = ((double)x - (double)lo) / ((double)hi - (double)lo);
+    return (float)(inverted ? 1.0 - f : f);
+}
+
+/* -1..1 -> 0..255, centre 128 (-1 -> 0, +1 -> 255) */
+static u8 gen_n_to_u8(float n)
+{
+    float f = n >= 0.0f ? 128.0f + floorf(n * 127.0f + 0.5f)
+                        : 128.0f - floorf(-n * 128.0f + 0.5f);
+    int v = (int)f;
+    return (u8)(v < 0 ? 0 : v > 255 ? 255 : v);
+}
+
+/* 0..1 -> 0..255 */
+static int gen_u8_level(float f)
+{
+    float r = floorf(f * 255.0f + 0.5f);
+    int v = (int)r;
+    return v < 0 ? 0 : v > 255 ? 255 : v;
+}
+
+/* Hat n as GH_* bits. Eight positions clockwise from north; a four-position
+ * hat counts in 90-degree steps; a nine-value hat (0..8) whose last value is
+ * "centred" is accepted as well. */
+static int gen_hat_bits(const GenPriv* p, int n)
+{
+    static const u8 dir8[8] = { GH_UP, GH_UP | GH_RIGHT, GH_RIGHT, GH_DOWN | GH_RIGHT,
+                                GH_DOWN, GH_DOWN | GH_LEFT, GH_LEFT, GH_UP | GH_LEFT };
+    if (n < 0 || n >= p->nhats) return 0;
+    int vi = p->hat_val[n];
+    if (vi < 0 || !p->val_ok[vi]) return 0;
+    const GenValue* v = &p->desc.values[vi];
+    s32 lo = v->lmin, hi = v->lmax, x = p->val[vi];
+    if (hi < lo) { lo = 0; hi = v->bits >= 1 && v->bits <= 8 ? (1 << v->bits) - 1 : 7; }
+    if (x < lo || x > hi) return 0;
+    int count = hi - lo + 1, idx = x - lo;
+    if (count == 4) return dir8[idx * 2];
+    if (count == 8 || count == 9) return idx < 8 ? dir8[idx] : 0;
+    return 0;
+}
+
+static int gen_button(const GenPriv* p, int n)
+{
+    if (n < 1 || n > GEN_MAX_BUTTONS) return 0;
+    return (p->btn[(n - 1) >> 5] >> ((n - 1) & 31)) & 1;
+}
+
+static int gen_src_level(const GenPriv* p, const GenSrc* s)
+{
+    switch (s->kind) {
+    case GS_BUTTON:  return gen_button(p, s->index) ? 255 : 0;
+    case GS_HAT:     return (gen_hat_bits(p, s->index) & s->mode) ? 255 : 0;
+    case GS_DPADBTN: return (p->special & s->mode) ? 255 : 0;
+    case GS_HOME:    return (p->special & GEN_SP_HOME) ? 255 : 0;
+    case GS_AXIS: {
+        int vi = s->index < GEN_MAX_AXES ? p->slot_val[s->index] : -1;
+        if (vi < 0 || !p->val_ok[vi]) return 0;
+        if (p->rest_guard) {
+            u8 need = s->mode == GA_FULL ? GEN_REST_MIN : s->mode == GA_INV ? GEN_REST_MAX : GEN_REST_MID;
+            if (!(p->rest[vi] & need)) return 0;
+        }
+        if (s->mode == GA_FULL) return gen_u8_level(gen_full(p, vi, 0));
+        if (s->mode == GA_INV)  return gen_u8_level(gen_full(p, vi, 1));
+        float n = gen_centered(p, vi);
+        if (s->mode == GA_POS) return n > 0.0f ? gen_u8_level(n) : 0;
+        return n < 0.0f ? gen_u8_level(-n) : 0;                 /* GA_NEG */
+    }
+    default:
+        return 0;
+    }
+}
+
+static float gen_src_stick(const GenPriv* p, const GenSrc* s)
+{
+    if (s->kind != GS_AXIS || s->index >= GEN_MAX_AXES) return 0.0f;
+    int vi = p->slot_val[s->index];
+    if (p->rest_guard && vi >= 0 && !(p->rest[vi] & GEN_REST_MID)) return 0.0f;
+    float n = gen_centered(p, vi);
+    return s->mode == GA_INV ? -n : n;
+}
+
+static void gen_eval(const GenPriv* p, PadHostPortState* st)
+{
+    int lvl[GT_PS + 1];
+    u16 buttons = 0;
+    for (int t = 0; t <= GT_PS; t++) {
+        int best = 0;
+        for (int k = 0; k < p->map.t[t].n; k++) {
+            int v = gen_src_level(p, &p->map.t[t].s[k]);
+            if (v > best) best = v;
+        }
+        lvl[t] = best;
+        if (t < 16 && best >= GEN_DIGITAL_THRESHOLD) buttons |= (u16)(1u << t);
+    }
+    u8 stick[4];
+    for (int t = GT_LX; t <= GT_RY; t++) {
+        float best = 0.0f;
+        for (int k = 0; k < p->map.t[t].n; k++) {
+            float n = gen_src_stick(p, &p->map.t[t].s[k]);
+            if (fabsf(n) > fabsf(best)) best = n;
+        }
+        stick[t - GT_LX] = gen_n_to_u8(best);
+    }
+    st->buttons = buttons;
+    st->ps = lvl[GT_PS] >= GEN_DIGITAL_THRESHOLD ? 1 : 0;
+    st->lx = stick[0]; st->ly = stick[1]; st->rx = stick[2]; st->ry = stick[3];
+    static const u8 press_target[PADHOST_PRESS_COUNT] = {
+        GT_RIGHT, GT_LEFT, GT_UP, GT_DOWN, GT_TRIANGLE, GT_CIRCLE,
+        GT_CROSS, GT_SQUARE, GT_L1, GT_R1, GT_L2, GT_R2 };
+    for (int i = 0; i < PADHOST_PRESS_COUNT; i++) st->press[i] = (u8)lvl[press_target[i]];
+}
+
+/* ---------------------------------------------------------------------------
+ * The log: the device, and its active mapping written as an input.ini line.
+ * -----------------------------------------------------------------------*/
+
+static void gen_src_str(const GenSrc* s, char* out, size_t n)
+{
+    static const char* dirs[9] = { "", "up", "right", "", "down", "", "", "", "left" };
+    static const char* amode[4] = { "", "~", "+", "-" };
+    switch (s->kind) {
+    case GS_BUTTON:  snprintf(out, n, "b%u", s->index); break;
+    case GS_AXIS:    snprintf(out, n, "a%u%s", s->index, amode[s->mode & 3]); break;
+    case GS_HAT:     snprintf(out, n, "h%u.%s", s->index, s->mode <= 8 ? dirs[s->mode] : "?"); break;
+    case GS_DPADBTN: snprintf(out, n, "dpad.%s", s->mode <= 8 ? dirs[s->mode] : "?"); break;
+    case GS_HOME:    snprintf(out, n, "home"); break;
+    default:         snprintf(out, n, "none"); break;
+    }
+}
+
+static void gen_map_str(const GenMap* m, char* out, size_t n)
+{
+    static const int order[] = { GT_CROSS, GT_CIRCLE, GT_SQUARE, GT_TRIANGLE, GT_L1, GT_R1, GT_L2, GT_R2,
+                                 GT_L3, GT_R3, GT_START, GT_SELECT, GT_PS, GT_UP, GT_DOWN, GT_LEFT, GT_RIGHT,
+                                 GT_LX, GT_LY, GT_RX, GT_RY };
+    out[0] = 0;
+    /* a plain hat d-pad prints as Dpad=hN */
+    int dpad_hat = -1;
+    {
+        const GenBind *u = &m->t[GT_UP], *r = &m->t[GT_RIGHT], *d = &m->t[GT_DOWN], *l = &m->t[GT_LEFT];
+        if (u->n == 1 && r->n == 1 && d->n == 1 && l->n == 1 && u->s[0].kind == GS_HAT &&
+            r->s[0].kind == GS_HAT && d->s[0].kind == GS_HAT && l->s[0].kind == GS_HAT &&
+            u->s[0].index == r->s[0].index && u->s[0].index == d->s[0].index && u->s[0].index == l->s[0].index &&
+            u->s[0].mode == GH_UP && r->s[0].mode == GH_RIGHT && d->s[0].mode == GH_DOWN && l->s[0].mode == GH_LEFT)
+            dpad_hat = u->s[0].index;
+    }
+    for (size_t i = 0; i < sizeof order / sizeof order[0]; i++) {
+        int t = order[i];
+        if (dpad_hat >= 0 && (t == GT_UP || t == GT_DOWN || t == GT_LEFT || t == GT_RIGHT)) {
+            if (t == GT_UP) {
+                size_t used = strlen(out);
+                snprintf(out + used, n - used, "%sDpad=h%d", used ? " " : "", dpad_hat);
+            }
+            continue;
+        }
+        const GenBind* b = &m->t[t];
+        if (!b->n) continue;
+        size_t used = strlen(out);
+        snprintf(out + used, n - used, "%s%s=", used ? " " : "", gen_target_name(t));
+        for (int k = 0; k < b->n; k++) {
+            char s[24];
+            gen_src_str(&b->s[k], s, sizeof s);
+            used = strlen(out);
+            snprintf(out + used, n - used, "%s%s", k ? "/" : "", s);
+        }
+    }
+}
+
+static void gen_log(const PadHostDevice* d, const GenPriv* p, const char* note)
+{
+    char axes[256];
+    axes[0] = 0;
+    for (int s = 0; s < GEN_MAX_AXES; s++) {
+        int vi = p->slot_val[s];
+        if (vi < 0) continue;
+        const GenValue* v = &p->desc.values[vi];
+        s32 lo, hi;
+        gen_range(v, &lo, &hi);
+        size_t used = strlen(axes);
+        snprintf(axes + used, sizeof axes - used, "%sa%d=%s(%ld..%ld)", used ? " " : "", s,
+                 gen_axis_usage_name(v), (long)lo, (long)hi);
+    }
+    int hid_extra = gen_has_button_usage(p, GEN_PAGE_GD, GEN_GD_DPAD_UP) ||
+                    gen_has_button_usage(p, GEN_PAGE_GD, GEN_GD_MENU) ||
+                    gen_has_button_usage(p, GEN_PAGE_CONSUMER, GEN_CONS_AC_HOME);
+    const char* nm = d->name[0] ? d->name : p->name[0] ? p->name : "HID gamepad";
+    padhost_logf("generic %04X:%04X \"%s\": %s%s%d hat(s), %d button(s)%s", d->vid, d->pid, nm,
+                 axes, axes[0] ? ", " : "", p->nhats, p->nbuttons, hid_extra ? " + HID d-pad/home usages" : "");
+    char map[640];
+    gen_map_str(&p->map, map, sizeof map);
+    padhost_logf("  map.%04X:%04X = %s%s", d->vid, d->pid, map, note);
+}
+
+/* ---------------------------------------------------------------------------
+ * Driver
+ * -----------------------------------------------------------------------*/
+
+/* XInput devices carry "IG_" in their HID path (wired, wireless receiver and
+ * Bluetooth via xinputhid alike); the pad host reads those through XInput. */
+static int gen_path_is_xinput(const char* path)
+{
+    if (!path) return 0;
+    for (const char* s = path; s[0] && s[1] && s[2]; s++)
+        if ((s[0] == 'I' || s[0] == 'i') && (s[1] == 'G' || s[1] == 'g') && s[2] == '_') return 1;
+    return 0;
+}
+
+static int gen_match(const PadHostDevice* d)
+{
+    if (d->usage_page != GEN_PAGE_GD) return 0;
+    if (d->usage != 0x04 && d->usage != 0x05 && d->usage != 0x08) return 0;
+    if (gen_path_is_xinput(d->path)) return 0;
+    if (d->vid == 0x045E && d->usage == 0x05) return 0;     /* Xbox pads: XInput's */
+    const char* line = gen_cfg_line(d->vid, d->pid);
+    if (line) {
+        GenOverride o;
+        char err[8];
+        memset(&o, 0, sizeof o);
+        gcfg_parse_device(&o, line, err, sizeof err);
+        if (o.ignore) return 0;
+    }
+    /* Multi-axis: 3D mice, motion platforms, button boxes -- not a pad
+     * unless the user maps it. */
+    if (d->usage == 0x08 && !line) return 0;
+    return 1;           /* lowest claim: any specific driver wins */
+}
+
+static int gen_open(PadHostDevice* d)
+{
+    GenPriv* p = gen_priv(d);
+    memset(p, 0, sizeof *p);
+    if (s_gen_ops->describe(d, &p->desc, p->name, (int)sizeof p->name) != 0) {
+        padhost_logf("generic %04X:%04X: cannot read its report descriptor", d->vid, d->pid);
+        return -1;
+    }
+    if (!d->name[0] && p->name[0]) snprintf(d->name, sizeof d->name, "%s", p->name);
+    gen_classify(p);
+    if (p->nbuttons < 2 || (p->nslots < 2 && p->nhats == 0)) {
+        padhost_logf("generic %04X:%04X \"%s\": %d axes, %d hat(s), %d button(s): not a usable gamepad",
+                     d->vid, d->pid, d->name, p->nslots, p->nhats, p->nbuttons);
+        return PADHOST_OPEN_DECLINED;
+    }
+    p->rest_guard = d->usage != 0x05;
+    gen_default_map(p, &p->map);
+
+    const char* note = "";
+    const char* line = gen_cfg_line(d->vid, d->pid);
+    if (line) {
+        GenOverride o;
+        char err[160];
+        memset(&o, 0, sizeof o);
+        err[0] = 0;
+        int bad = gcfg_parse_device(&o, line, err, sizeof err);
+        if (bad)
+            padhost_logf("map.%04X:%04X: %s%s", d->vid, d->pid, err,
+                         bad > 1 ? " (and more; those items skipped)" : " (item skipped)");
+        for (int t = 0; t < GT_COUNT; t++)
+            if (o.set[t]) p->map.t[t] = o.bind[t];
+        p->overridden = 1;
+        note = "  (from the config)";
+        for (int t = 0; t < GT_COUNT; t++)
+            for (int k = 0; k < p->map.t[t].n; k++) {
+                const GenSrc* s = &p->map.t[t].s[k];
+                int missing = (s->kind == GS_AXIS && p->slot_val[s->index] < 0) ||
+                              (s->kind == GS_HAT && s->index >= p->nhats) ||
+                              (s->kind == GS_BUTTON && s->index > p->nbuttons);
+                if (missing) {
+                    char ss[24];
+                    gen_src_str(s, ss, sizeof ss);
+                    padhost_logf("map.%04X:%04X: %s=%s, which this device does not have",
+                                 d->vid, d->pid, gen_target_name(t), ss);
+                }
+            }
+    }
+    gen_log(d, p, note);
+    return 0;
+}
+
+static int gen_parse(PadHostDevice* d, const unsigned char* rep, int len, PadHostPortState* st)
+{
+    GenPriv* p = gen_priv(d);
+    unsigned char tmp[1024];
+    if (len <= 0) return 0;
+    /* HidP wants the whole report as the descriptor sizes it */
+    if (d->in_len > len && d->in_len <= (int)sizeof tmp) {
+        memcpy(tmp, rep, (size_t)len);
+        memset(tmp + len, 0, (size_t)(d->in_len - len));
+        rep = tmp;
+        len = d->in_len;
+    }
+    u8 rid = p->has_ids ? rep[0] : 0;
+    int touched = 0;
+
+    for (int i = 0; i < p->desc.nvalues; i++) {
+        const GenValue* v = &p->desc.values[i];
+        if (v->report_id != rid) continue;
+        u32 raw;
+        if (s_gen_ops->get_value(d, v, rep, len, &raw) != 0) continue;
+        p->val[i] = gen_value_from_raw(v, raw);
+        p->val_ok[i] = 1;
+        touched = 1;
+        if (p->rest_guard && p->rest[i] != (GEN_REST_MID | GEN_REST_MIN | GEN_REST_MAX)) {
+            s32 lo, hi, x = p->val[i];
+            gen_range(v, &lo, &hi);
+            if (x < lo || x > hi) {
+                p->rest[i] = GEN_REST_MID | GEN_REST_MIN | GEN_REST_MAX;     /* null state: at rest */
+            } else {
+                double f = ((double)x - (double)lo) / ((double)hi - (double)lo);
+                if (f >= 0.375 && f <= 0.625) p->rest[i] |= GEN_REST_MID;
+                if (f <= 0.25) p->rest[i] |= GEN_REST_MIN;
+                if (f >= 0.75) p->rest[i] |= GEN_REST_MAX;
+            }
+        }
+    }
+
+    /* Buttons of a page are cleared and re-set from each report that carries
+     * that page, so buttons in another report keep their state. */
+    static const u16 pages[3] = { GEN_PAGE_BUTTON, GEN_PAGE_GD, GEN_PAGE_CONSUMER };
+    for (int pi = 0; pi < 3; pi++) {
+        int in_report = 0;
+        for (int i = 0; i < p->desc.nbr; i++) {
+            const GenBtnRange* r = &p->desc.br[i];
+            if (r->page != pages[pi] || r->report_id != rid) continue;
+            in_report = 1;
+            if (pages[pi] == GEN_PAGE_BUTTON) {
+                for (unsigned u = r->umin ? r->umin : 1; u <= r->umax && u <= GEN_MAX_BUTTONS; u++)
+                    p->btn[(u - 1) >> 5] &= ~(1u << ((u - 1) & 31));
+            } else if (pages[pi] == GEN_PAGE_GD) {
+                if (r->umin <= GEN_GD_DPAD_UP + 3 && r->umax >= GEN_GD_DPAD_UP)
+                    p->special &= (u8)~(GEN_SP_UP | GEN_SP_RIGHT | GEN_SP_DOWN | GEN_SP_LEFT);
+                if (r->umin <= GEN_GD_MENU && r->umax >= GEN_GD_MENU) p->special &= (u8)~GEN_SP_HOME;
+            } else {
+                p->special &= (u8)~GEN_SP_HOME;
+            }
+        }
+        if (!in_report) continue;
+        u16 us[GEN_MAX_BUTTONS + 16];
+        int n = s_gen_ops->get_usages(d, pages[pi], rep, len, us, (int)(sizeof us / sizeof us[0]));
+        touched = 1;
+        for (int i = 0; i < n; i++) {
+            u16 u = us[i];
+            if (pages[pi] == GEN_PAGE_BUTTON) {
+                if (u >= 1 && u <= GEN_MAX_BUTTONS) p->btn[(u - 1) >> 5] |= 1u << ((u - 1) & 31);
+            } else if (pages[pi] == GEN_PAGE_GD) {
+                if (u == GEN_GD_DPAD_UP)          p->special |= GEN_SP_UP;
+                else if (u == GEN_GD_DPAD_UP + 1) p->special |= GEN_SP_DOWN;
+                else if (u == GEN_GD_DPAD_UP + 2) p->special |= GEN_SP_RIGHT;
+                else if (u == GEN_GD_DPAD_UP + 3) p->special |= GEN_SP_LEFT;
+                else if (u == GEN_GD_MENU)        p->special |= GEN_SP_HOME;
+            } else if (u == GEN_CONS_AC_HOME) {
+                p->special |= GEN_SP_HOME;
+            }
+        }
+    }
+    if (!touched) return 0;
+
+    gen_eval(p, st);
+    st->connected = 1;
+    st->kind = PADHOST_KIND_GENERIC;
+    st->bus = d->bus;
+    st->vid = d->vid;
+    st->pid = d->pid;
+    st->has_pressure = 0;
+    st->has_motion = 0;
+    st->sensor_x = PADHOST_SENSOR_NEUTRAL_X; st->sensor_y = PADHOST_SENSOR_NEUTRAL_Y;
+    st->sensor_z = PADHOST_SENSOR_NEUTRAL_Z; st->sensor_g = PADHOST_SENSOR_NEUTRAL_G;
+    st->battery = 255;
+    return 1;
+}
+
+/* No rumble or LEDs over plain HID: nothing to send, nothing to release. */
+static int gen_build_output(PadHostDevice* d, u8 small_motor, u8 large_motor, int port,
+                            unsigned char* out, int cap)
+{
+    (void)d; (void)small_motor; (void)large_motor; (void)port; (void)out; (void)cap;
+    return 0;
+}
+
+static void gen_close(PadHostDevice* d) { (void)d; }
+
+const PadHostDriver padhost_drv_generic = {
+    "generic HID", PADHOST_KIND_GENERIC,
+    gen_match, gen_open, gen_parse, gen_build_output, gen_close,
+};
+
+#else  /* HID access is Windows-only here (the SDL2 backend serves other hosts) */
+typedef int pad_hid_generic_windows_only;   /* ISO C: a translation unit declares something */
+#endif /* _WIN32 */
diff --git a/libs/input/pad_hid_sony.c b/libs/input/pad_hid_sony.c
new file mode 100644
index 0000000..2c94237
--- /dev/null
+++ b/libs/input/pad_hid_sony.c
@@ -0,0 +1,1263 @@
+/*
+ * ps3recomp - Sony controllers on the host: DualShock 3, DualShock 4, DualSense
+ *
+ * Three pad_host.h drivers (padhost_drv_ds3, padhost_drv_ds4,
+ * padhost_drv_dualsense). Each turns its family's HID input reports into a
+ * PadHostPortState in PS3 conventions and builds the family's output report
+ * (rumble, lightbar colour, player LEDs). There is no Win32 in this file: all
+ * device I/O goes through the padhost_dev_* helpers, so it compiles on every
+ * platform (pad_host.h stubs them out where there is no HID manager).
+ *
+ * Where the protocol facts come from (each cross-checked against a second
+ * source where one exists):
+ *   Linux drivers/hid/hid-playstation.c  DS4 / DualSense report layouts, IMU
+ *       calibration, output report flags, Bluetooth CRC seeds, battery, the
+ *       DS4 wireless adapter's connection bit, DualSense player LED patterns.
+ *   Linux drivers/hid/hid-sony.c  DS3 report 0x01 layout, battery, the
+ *       GET_REPORT 0xF2 "operational" trick, output report 0x01, LED table.
+ *   SDL src/joystick/hidapi/SDL_hidapi_ps4.c / _ps5.c  the simple Bluetooth
+ *       report (10 bytes) and switching to the full one.
+ *   RPCS3 rpcs3/Input/{ds3,ds4,dualsense}_pad_handler.cpp, Emu/Io/pad_types.h
+ *       the conversion to SIXAXIS units (MOTION_ONE_G = 113, gyro 123/90),
+ *       its sign conventions, and the DS3 layout under Sony's Windows driver.
+ *   DsHidMini driver/DsHid.c, HID.FeatureReport.c, HID.Reports.c, driver/HID/,
+ *       docs/MOTION.md  how the DS3 is exposed on Windows (see the DS3 part).
+ *
+ * Configuration (padhost_config_get: PAD_HOST="k=v|..." or input.ini's
+ * [controller] section; case does not matter). A button list is names joined
+ * by '+' (select l3 r3 start up right down left l2 r2 l1 r1 triangle circle
+ * cross square ps none) or a CELL_PAD_CTRL mask like PAD_SCRIPT's ("0x4000").
+ *   ds4_touchpad / dualsense_touchpad   touchpad click presses (default select)
+ *   dualsense_mute                      mic-mute button presses (default none)
+ *   dualsense_edge_left_paddle / _right_paddle / _left_fn / _right_fn
+ *                                       DualSense Edge back buttons (default none)
+ *   ds4_lightbar / dualsense_lightbar   port (default: the port's colour), off, RRGGBB
+ *   dualsense_player_leds               port (default) or off
+ *   dualsense_vibration                 auto (default: v2 on Edge / update >= 0x0224, both
+ *                                       from 0x0215, else v1), v1, v2 or both
+ * Deadzones, rumble strength and read-only mode belong to the manager.
+ */
+
+#include "pad_host.h"
+#include "cellPad.h"     /* CELL_PAD_CTRL_* */
+
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define SONY_VID 0x054C
+
+/* ---------------------------------------------------------------------------
+ * Shared helpers
+ * -----------------------------------------------------------------------*/
+
+static int sony_s16le(const u8* p) { return (int)(int16_t)(u16)(p[0] | (p[1] << 8)); }
+static unsigned sony_u16le(const u8* p) { return (unsigned)(p[0] | (p[1] << 8)); }
+static unsigned sony_u32le(const u8* p)
+{
+    return (unsigned)p[0] | ((unsigned)p[1] << 8) | ((unsigned)p[2] << 16) | ((unsigned)p[3] << 24);
+}
+static void sony_put_u32le(u8* p, unsigned v)
+{
+    p[0] = (u8)v; p[1] = (u8)(v >> 8); p[2] = (u8)(v >> 16); p[3] = (u8)(v >> 24);
+}
+
+/* RPCS3 Clamp0To1023: clamp, then truncate. */
+static u16 sony_clamp1023(float v)
+{
+    if (!(v > 0.0f)) return 0;
+    if (v > 1023.0f) return 1023;
+    return (u16)v;
+}
+
+/* Bluetooth reports of the DS4 and the DualSense end in a CRC-32 (zlib
+ * polynomial) taken over one "seed" byte -- the BT HID transaction header the
+ * pad saw: 0xA1 input, 0xA2 output, 0xA3 feature -- followed by the report
+ * from its id up to the CRC field. */
+static unsigned sony_bt_crc(u8 seed, const u8* p, int n)
+{
+    return padhost_crc32(padhost_crc32(0, &seed, 1), p, n);
+}
+
+/* n = whole report length, CRC included (stored little-endian at the end). */
+static int sony_bt_crc_ok(u8 seed, const u8* rep, int n)
+{
+    return n >= 5 && sony_bt_crc(seed, rep, n - 4) == sony_u32le(rep + n - 4);
+}
+
+/* Buffer size for a GET_FEATURE: Windows wants at least the collection's
+ * longest feature report. */
+static int sony_feat_len(const PadHostDevice* d, int want, int cap)
+{
+    int n = d->feat_len > want ? d->feat_len : want;
+    return n > cap ? cap : n;
+}
+
+/* Output report size: the report's own size, raised to the collection's
+ * declared output length (Windows writes exactly that many bytes) when the
+ * caller's buffer allows. */
+static int sony_out_len(const PadHostDevice* d, int natural, int cap)
+{
+    int n = d->out_len > natural ? d->out_len : natural;
+    return n <= cap ? n : (natural <= cap ? natural : 0);
+}
+
+/* Bluetooth framing, decided from the collection's longest input report: a
+ * USB DS4/DualSense declares 64 bytes, Bluetooth declares more (DS4 547,
+ * DualSense 78). The bus the manager detected only breaks a tie. */
+static int sony_detect_bt(const PadHostDevice* d, int usb_in_len)
+{
+    if (d->in_len > usb_in_len) return 1;
+    if (d->in_len == usb_in_len) return 0;
+    return d->bus == PADHOST_BUS_BT;
+}
+
+/* Hat switch (0 = up, clockwise, >= 8 released) -> PS3 d-pad bits. */
+static u16 sony_hat_to_dpad(unsigned hat)
+{
+    static const u16 m[8] = {
+        CELL_PAD_CTRL_UP, CELL_PAD_CTRL_UP | CELL_PAD_CTRL_RIGHT, CELL_PAD_CTRL_RIGHT,
+        CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_RIGHT, CELL_PAD_CTRL_DOWN,
+        CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_LEFT, CELL_PAD_CTRL_LEFT,
+        CELL_PAD_CTRL_UP | CELL_PAD_CTRL_LEFT };
+    return hat < 8 ? m[hat] : 0;
+}
+
+/* Config values are compared without regard to case. */
+static int sony_is(const char* v, const char* word)
+{
+    if (!v) return 0;
+    for (; *v && *word; v++, word++) {
+        char c = *v;
+        if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
+        if (c != *word) return 0;
+    }
+    return !*v && !*word;
+}
+
+/* A button mapping target: CELL_PAD_CTRL_* bits, plus this bit for PS. */
+#define SONY_MAP_PS 0x10000u
+
+/* "select", "start+cross", "ps", "none", or a number ("0x4000", CELL_PAD_CTRL
+ * mask, (DIGITAL2 << 8) | DIGITAL1 like PAD_SCRIPT). Unknown words -> dflt. */
+static unsigned sony_parse_buttons(const char* s, unsigned dflt)
+{
+    static const struct { const char* name; unsigned bit; } names[] = {
+        { "select", CELL_PAD_CTRL_SELECT }, { "l3", CELL_PAD_CTRL_L3 }, { "r3", CELL_PAD_CTRL_R3 },
+        { "start", CELL_PAD_CTRL_START }, { "up", CELL_PAD_CTRL_UP }, { "right", CELL_PAD_CTRL_RIGHT },
+        { "down", CELL_PAD_CTRL_DOWN }, { "left", CELL_PAD_CTRL_LEFT }, { "l2", CELL_PAD_CTRL_L2 },
+        { "r2", CELL_PAD_CTRL_R2 }, { "l1", CELL_PAD_CTRL_L1 }, { "r1", CELL_PAD_CTRL_R1 },
+        { "triangle", CELL_PAD_CTRL_TRIANGLE }, { "circle", CELL_PAD_CTRL_CIRCLE },
+        { "cross", CELL_PAD_CTRL_CROSS }, { "square", CELL_PAD_CTRL_SQUARE },
+        { "ps", SONY_MAP_PS }, { "none", 0 }, { "off", 0 },
+    };
+    if (!s) return dflt;
+    unsigned mask = 0;
+    while (*s) {
+        while (*s == ' ' || *s == '+' || *s == ',' || *s == '|') s++;
+        if (!*s) break;
+        char w[16]; int n = 0;
+        while (*s && *s != ' ' && *s != '+' && *s != ',' && *s != '|') {
+            char c = *s++;
+            if (n < (int)sizeof w - 1) w[n++] = (char)((c >= 'A' && c <= 'Z') ? c - 'A' + 'a' : c);
+        }
+        w[n] = 0;
+        if (w[0] >= '0' && w[0] <= '9') {
+            char* end; unsigned long v = strtoul(w, &end, 0);
+            if (*end) return dflt;
+            mask |= (unsigned)v & (0xFFFFu | SONY_MAP_PS);
+            continue;
+        }
+        unsigned k = 0;
+        while (k < sizeof names / sizeof names[0] && strcmp(names[k].name, w)) k++;
+        if (k == sizeof names / sizeof names[0]) return dflt;
+        mask |= names[k].bit;
+    }
+    return mask;
+}
+
+static unsigned sony_cfg_buttons(const char* key, unsigned dflt)
+{
+    const char* v = padhost_config_get(key);
+    unsigned m = sony_parse_buttons(v, dflt);
+    if (v && m == dflt && sony_parse_buttons(v, dflt ^ 1u) != m)
+        padhost_logf("%s=\"%s\": not a button list, using the default\n", key, v);
+    return m;
+}
+
+/* Lightbar setting: "port" (default: the port's colour), "off", or "RRGGBB". */
+enum { SONY_LIGHT_PORT, SONY_LIGHT_OFF, SONY_LIGHT_FIXED };
+static int sony_cfg_light(const char* key, u8 rgb[3])
+{
+    const char* v = padhost_config_get(key);
+    if (!v || !*v || sony_is(v, "port") || sony_is(v, "on") || sony_is(v, "1")) return SONY_LIGHT_PORT;
+    if (sony_is(v, "off") || sony_is(v, "0") || sony_is(v, "none")) return SONY_LIGHT_OFF;
+    const char* h = v[0] == '#' ? v + 1 : v;
+    char* end; unsigned long c = strtoul(h, &end, 16);
+    if (strlen(h) == 6 && !*end) {
+        rgb[0] = (u8)(c >> 16); rgb[1] = (u8)(c >> 8); rgb[2] = (u8)c;
+        return SONY_LIGHT_FIXED;
+    }
+    padhost_logf("%s=\"%s\": expected port, off or RRGGBB\n", key, v);
+    return SONY_LIGHT_PORT;
+}
+
+static void sony_light_rgb(int mode, const u8 fixed[3], int port, u8* r, u8* g, u8* b)
+{
+    if (mode == SONY_LIGHT_FIXED) { *r = fixed[0]; *g = fixed[1]; *b = fixed[2]; return; }
+    *r = *g = *b = 0;
+    if (mode == SONY_LIGHT_PORT && port >= 0) padhost_port_color(port, r, g, b);
+}
+
+/* Pressure words for a pad without pressure-sensitive buttons: full pressure
+ * while the digital bit is down, the analog triggers carry their value. */
+static void sony_digital_press(PadHostPortState* st, u8 l2, u8 r2)
+{
+    static const struct { u16 bit; u8 idx; } m[] = {
+        { CELL_PAD_CTRL_RIGHT, PADHOST_PRESS_RIGHT }, { CELL_PAD_CTRL_LEFT, PADHOST_PRESS_LEFT },
+        { CELL_PAD_CTRL_UP, PADHOST_PRESS_UP }, { CELL_PAD_CTRL_DOWN, PADHOST_PRESS_DOWN },
+        { CELL_PAD_CTRL_TRIANGLE, PADHOST_PRESS_TRIANGLE }, { CELL_PAD_CTRL_CIRCLE, PADHOST_PRESS_CIRCLE },
+        { CELL_PAD_CTRL_CROSS, PADHOST_PRESS_CROSS }, { CELL_PAD_CTRL_SQUARE, PADHOST_PRESS_SQUARE },
+        { CELL_PAD_CTRL_L1, PADHOST_PRESS_L1 }, { CELL_PAD_CTRL_R1, PADHOST_PRESS_R1 },
+    };
+    for (unsigned i = 0; i < sizeof m / sizeof m[0]; i++)
+        st->press[m[i].idx] = (st->buttons & m[i].bit) ? 255 : 0;
+    st->press[PADHOST_PRESS_L2] = l2;
+    st->press[PADHOST_PRESS_R2] = r2;
+    st->has_pressure = 0;
+}
+
+/* OR an extra mapped button (touchpad click, mute, Edge paddles) in. */
+static void sony_apply_map(PadHostPortState* st, unsigned map)
+{
+    st->buttons |= (u16)(map & 0xFFFFu);
+    if (map & SONY_MAP_PS) st->ps = 1;
+}
+
+/* The DS4 / DualSense button bytes: [0] hat + face, [1] shoulders, sticks,
+ * Share/Create (SELECT), Options (START), [2] PS, touchpad click (+ DualSense
+ * mute and Edge buttons, handled by the caller). */
+static void sony_ds45_buttons(const u8* b, unsigned touch_map, PadHostPortState* st)
+{
+    u16 v = sony_hat_to_dpad(b[0] & 0x0F);
+    if (b[0] & 0x10) v |= CELL_PAD_CTRL_SQUARE;
+    if (b[0] & 0x20) v |= CELL_PAD_CTRL_CROSS;
+    if (b[0] & 0x40) v |= CELL_PAD_CTRL_CIRCLE;
+    if (b[0] & 0x80) v |= CELL_PAD_CTRL_TRIANGLE;
+    if (b[1] & 0x01) v |= CELL_PAD_CTRL_L1;
+    if (b[1] & 0x02) v |= CELL_PAD_CTRL_R1;
+    if (b[1] & 0x04) v |= CELL_PAD_CTRL_L2;
+    if (b[1] & 0x08) v |= CELL_PAD_CTRL_R2;
+    if (b[1] & 0x10) v |= CELL_PAD_CTRL_SELECT;     /* Share / Create */
+    if (b[1] & 0x20) v |= CELL_PAD_CTRL_START;      /* Options */
+    if (b[1] & 0x40) v |= CELL_PAD_CTRL_L3;
+    if (b[1] & 0x80) v |= CELL_PAD_CTRL_R3;
+    st->buttons = v;
+    st->ps = (u8)(b[2] & 0x01);
+    if (b[2] & 0x02) sony_apply_map(st, touch_map);
+}
+
+/* "aa:bb:..": the pad's Bluetooth address, most significant byte first, as 12
+ * lowercase hex digits -- the same text for a USB connection (read from a
+ * feature report) and a Bluetooth one (the serial string Windows reports), so
+ * the manager gives a pad its port back when it switches bus. */
+static void sony_mac_serial(PadHostDevice* d, const u8* lsb_first)
+{
+    static const char hx[] = "0123456789abcdef";
+    int nz = 0;
+    for (int i = 0; i < 6; i++) nz |= lsb_first[i];
+    if (!nz) return;
+    for (int i = 0; i < 6; i++) {
+        d->serial[i * 2]     = hx[lsb_first[5 - i] >> 4];
+        d->serial[i * 2 + 1] = hx[lsb_first[5 - i] & 15];
+    }
+    d->serial[12] = 0;
+}
+
+static void sony_normalize_serial(PadHostDevice* d)
+{
+    char t[13]; int n = 0;
+    for (const char* s = d->serial; *s && n <= 12; s++) {
+        char c = *s;
+        if (c == ':' || c == '-' || c == ' ') continue;
+        if (c >= 'A' && c <= 'F') c = (char)(c - 'A' + 'a');
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return;
+        t[n++] = c;
+    }
+    if (n != 12) return;
+    t[12] = 0;
+    memcpy(d->serial, t, 13);
+}
+
+/* ---------------------------------------------------------------------------
+ * IMU calibration (DS4 and DualSense) and the conversion to SIXAXIS units
+ *
+ * Both pads report gyro (pitch, yaw, roll) and accelerometer (x, y, z) as
+ * signed 16-bit counts and keep per-unit calibration in a feature report
+ * (DS4: 0x02 over USB, 0x05 over Bluetooth; DualSense: 0x05). Layout, after
+ * the report id, little-endian s16:
+ *   1 pitch bias, 3 yaw bias, 5 roll bias,
+ *   7..17 the six gyro plus/minus readings (order below), 19/21 gyro speed
+ *   plus/minus (deg/s the plus/minus readings stand for), 23..33 accel
+ *   x+/x-/y+/y-/z+/z- (counts at +1 g / -1 g).
+ * The six gyro readings are pitch+, pitch-, yaw+, yaw-, roll+, roll- on a
+ * DualSense and a DS4 over USB, but pitch+, yaw+, roll+, pitch-, yaw-, roll- on
+ * a DS4 over Bluetooth or behind the wireless adapter (and on some licensed
+ * wired pads). Like RPCS3 the order is told apart by sign: in the first, the
+ * second reading is a minus one (< 0).
+ *
+ * Applied as Linux hid-playstation does: deg/s = raw * speed_2x / (|plus -
+ * bias| + |minus - bias|) -- the gyro bias is NOT subtracted (the pad already
+ * removes it; on the DualSense here the gyro reads 0..2 counts at rest, not the
+ * stored bias) -- and g = (raw - (plus - range/2)) * 2 / range with range =
+ * plus - minus. A zero/insane denominator falls back to Linux's uncalibrated
+ * scale (raw / 16 deg/s, raw / 8192 g), per axis.
+ *
+ * SIXAXIS units (RPCS3 ds4/dualsense_pad_handler.cpp get_extended_info and
+ * pad_types.h): accel word = -a[g] * MOTION_ONE_G(113) + 512 for x, y, z (so a
+ * pad lying flat reads y = 399, pad_types.h's DEFAULT_MOTION_Y), gyro word =
+ * -yaw[deg/s] * 123 / 90 + 512 (the DS3 gyro's 123 counts per 90 deg/s); the
+ * PS3 has only the yaw gyro. Clamped to 0..1023 and truncated, as RPCS3's
+ * Clamp0To1023. RPCS3 gets there through its own fixed-point calibration
+ * (DS4/DUALSENSE_ACC_RES_PER_G 8192, GYRO_RES_PER_DEG_S 86); the physical
+ * units in between make the constants unnecessary here.
+ * -----------------------------------------------------------------------*/
+
+typedef struct { float bias, scale; } SonyAxis;   /* physical = (raw - bias) * scale */
+typedef struct {
+    SonyAxis gyro[3];   /* deg/s: pitch, yaw, roll */
+    SonyAxis acc[3];    /* g: x, y, z */
+    int      ok;        /* 1 = from the pad's calibration report */
+} SonyImuCal;
+
+#define SONY_MOTION_ONE_G   113.0f          /* RPCS3 pad_types.h MOTION_ONE_G */
+#define SONY_GYRO_PER_DEG_S (123.0f / 90.0f) /* RPCS3: "The ds3 resolution is 123/90 deg/sec" */
+
+static void sony_cal_default(SonyImuCal* c)
+{
+    for (int i = 0; i < 3; i++) {
+        c->gyro[i].bias = 0.0f; c->gyro[i].scale = 2048.0f / 32767.0f;
+        c->acc[i].bias  = 0.0f; c->acc[i].scale  = 4.0f / 32767.0f;
+    }
+    c->ok = 0;
+}
+
+static int sony_iabs(int v) { return v < 0 ? -v : v; }
+
+/* buf = the calibration feature report, report id in buf[0], >= 35 bytes.
+ * Returns the number of axes that had to fall back (0 = all good). */
+static int sony_cal_parse(const u8* buf, SonyImuCal* c)
+{
+    int bias[3] = { sony_s16le(buf + 1), sony_s16le(buf + 3), sony_s16le(buf + 5) };
+    int plus[3], minus[3];
+    if (sony_s16le(buf + 9) < 0) {             /* pitch+, pitch-, yaw+, yaw-, roll+, roll- */
+        for (int i = 0; i < 3; i++) { plus[i] = sony_s16le(buf + 7 + 4 * i); minus[i] = sony_s16le(buf + 9 + 4 * i); }
+    } else {                                   /* pitch+, yaw+, roll+, pitch-, yaw-, roll- */
+        for (int i = 0; i < 3; i++) { plus[i] = sony_s16le(buf + 7 + 2 * i); minus[i] = sony_s16le(buf + 13 + 2 * i); }
+    }
+    int speed_2x = sony_s16le(buf + 19) + sony_s16le(buf + 21);
+    int bad = 0;
+    sony_cal_default(c);
+    for (int i = 0; i < 3; i++) {
+        int den = sony_iabs(plus[i] - bias[i]) + sony_iabs(minus[i] - bias[i]);
+        float s = den ? (float)speed_2x / (float)den : 0.0f;
+        /* Real pads: ~0.06 deg/s per count (DS4 and DualSense, +-2000 deg/s). */
+        if (s > 0.005f && s < 1.0f) c->gyro[i].scale = s;
+        else bad++;
+    }
+    for (int i = 0; i < 3; i++) {
+        int p = sony_s16le(buf + 23 + 4 * i), m = sony_s16le(buf + 25 + 4 * i);
+        int range = p - m;
+        /* Real pads: ~8192 counts per g, so range ~16384. */
+        if (range > 2000 && range < 65536) {
+            c->acc[i].bias  = (float)(p - range / 2);
+            c->acc[i].scale = 2.0f / (float)range;
+        } else bad++;
+    }
+    c->ok = bad < 6;
+    return bad;
+}
+
+/* g[3] gyro pitch/yaw/roll, a[3] accel x/y/z, raw counts. */
+static void sony_motion_to_ps3(const SonyImuCal* c, const int g[3], const int a[3], PadHostPortState* st)
+{
+    float ax = ((float)a[0] - c->acc[0].bias) * c->acc[0].scale;
+    float ay = ((float)a[1] - c->acc[1].bias) * c->acc[1].scale;
+    float az = ((float)a[2] - c->acc[2].bias) * c->acc[2].scale;
+    float yaw = ((float)g[1] - c->gyro[1].bias) * c->gyro[1].scale;
+    st->sensor_x = sony_clamp1023(-ax * SONY_MOTION_ONE_G + 512.0f);
+    st->sensor_y = sony_clamp1023(-ay * SONY_MOTION_ONE_G + 512.0f);
+    st->sensor_z = sony_clamp1023(-az * SONY_MOTION_ONE_G + 512.0f);
+    st->sensor_g = sony_clamp1023(-yaw * SONY_GYRO_PER_DEG_S + 512.0f);
+    st->has_motion = 1;
+}
+
+static void sony_log_cal(const char* who, const SonyImuCal* c, int bad)
+{
+    if (!c->ok) { padhost_logf("%s: no IMU calibration, motion uses nominal scales\n", who); return; }
+    if (bad) padhost_logf("%s: IMU calibration had %d bad axis value(s), nominal scale used for those\n", who, bad);
+    if (padhost_log_enabled())
+        padhost_logf("%s: gyro %.4f/%.4f/%.4f deg/s per count, accel 1g = %.0f/%.0f/%.0f counts (bias %.0f/%.0f/%.0f)\n",
+                     who, (double)c->gyro[0].scale, (double)c->gyro[1].scale, (double)c->gyro[2].scale,
+                     (double)(1.0f / c->acc[0].scale), (double)(1.0f / c->acc[1].scale), (double)(1.0f / c->acc[2].scale),
+                     (double)c->acc[0].bias, (double)c->acc[1].bias, (double)c->acc[2].bias);
+}
+
+/* Shared state layout checks: priv[] is a byte array in the manager's struct. */
+#define SONY_PRIV(T, d) ((T*)(void*)(d)->priv)
+#define SONY_PRIV_FITS(T) \
+    _Static_assert(sizeof(T) <= sizeof(((PadHostDevice*)0)->priv), #T " does not fit priv[]"); \
+    _Static_assert(offsetof(PadHostDevice, priv) % _Alignof(T) == 0, #T " misaligned in priv[]")
+
+/* ===========================================================================
+ * DualShock 4  (054C:05C4 v1, 054C:09CC v2, 054C:0BA0 USB wireless adapter)
+ *
+ * Input: USB report 0x01 (64 bytes) = id + common block. Bluetooth starts in
+ * a simple 0x01 report (10 bytes: sticks, buttons, triggers -- no motion, no
+ * battery) and sends the full 0x11 report (78 bytes = id, 2 bytes, common
+ * block, touch, CRC-32 seed 0xA1) once the host has read feature report 0x02
+ * ("in Bluetooth mode feature report 0x02 also changes the state of the
+ * controller, so that it sends input reports of type 0x11" -- hid-sony; RPCS3
+ * does the same) or written an output report (SDL). On Windows a Bluetooth DS4
+ * declares 547-byte input reports (its longest, 0x19), so every report reads
+ * as 547 bytes, zero padded.
+ * Common block: 0 lx, 1 ly, 2 rx, 3 ry, 4..6 buttons, 7 l2, 8 r2, 9 timestamp,
+ * 11 temperature, 12 gyro[3], 18 accel[3], 29 status0 (battery level low
+ * nibble, cable bit 4), 30 status1 (adapter: bit 2 = no controller).
+ * Output: USB 0x05 (32 bytes), Bluetooth 0x11 (78 bytes, CRC seed 0xA2):
+ * flags 0x07 (motors, lightbar, blink), right/weak motor, left/strong motor,
+ * R, G, B, blink on, blink off.
+ * =========================================================================*/
+
+typedef struct {
+    int bt;              /* Bluetooth framing */
+    int dongle;          /* 054C:0BA0 */
+    int dongle_pad;      /* adapter: -1 unknown, 0 no controller, 1 controller */
+    int full_seen;       /* a full report arrived (0x11 / USB 0x01) */
+    int simple_n;        /* simple BT reports since the last switch attempt */
+    int switch_tries;
+    int crc_bad;
+    unsigned touch_map;
+    int light; u8 light_rgb[3];
+    SonyImuCal cal;
+} Ds4Priv;
+SONY_PRIV_FITS(Ds4Priv);
+
+static int ds4_match(const PadHostDevice* d)
+{
+    if (d->vid != SONY_VID) return 0;
+    if (d->pid != 0x05C4 && d->pid != 0x09CC && d->pid != 0x0BA0) return 0;
+    if (d->usage_page && d->usage_page != 0x01) return 0;
+    if (d->usage && d->usage != 0x04 && d->usage != 0x05) return 0;
+    return 100;
+}
+
+static int ds4_read_calibration(PadHostDevice* d, Ds4Priv* p)
+{
+    u8 buf[1024];
+    const u8 id = p->bt ? 0x05 : 0x02;
+    const int len = p->bt ? 41 : 37;
+    for (int tries = 0; tries < 3; tries++) {
+        memset(buf, 0, sizeof buf);
+        buf[0] = id;
+        int n = padhost_dev_get_feature(d, buf, sony_feat_len(d, len, (int)sizeof buf));
+        if (n < len || buf[0] != id) continue;
+        if (p->bt && !sony_bt_crc_ok(0xA3, buf, len)) continue;
+        int bad = sony_cal_parse(buf, &p->cal);
+        sony_log_cal("DS4", &p->cal, bad);
+        return p->cal.ok;
+    }
+    sony_cal_default(&p->cal);
+    sony_log_cal("DS4", &p->cal, 6);
+    return 0;
+}
+
+/* Bluetooth: GET_REPORT 0x02 turns on the full 0x11 report. */
+static void ds4_request_full_reports(PadHostDevice* d)
+{
+    u8 buf[1024];
+    memset(buf, 0, sizeof buf);
+    buf[0] = 0x02;
+    padhost_dev_get_feature(d, buf, sony_feat_len(d, 37, (int)sizeof buf));
+}
+
+static int ds4_open(PadHostDevice* d)
+{
+    Ds4Priv* p = SONY_PRIV(Ds4Priv, d);
+    memset(p, 0, sizeof *p);
+    p->dongle = d->pid == 0x0BA0;
+    p->bt = p->dongle ? 0 : sony_detect_bt(d, 64);
+    p->dongle_pad = -1;
+    sony_cal_default(&p->cal);
+    p->touch_map = sony_cfg_buttons("ds4_touchpad", CELL_PAD_CTRL_SELECT);
+    p->light = sony_cfg_light("ds4_lightbar", p->light_rgb);
+
+    if (!p->dongle) ds4_read_calibration(d, p);   /* the adapter: once a pad shows up */
+    if (p->bt) {
+        ds4_request_full_reports(d);
+        sony_normalize_serial(d);
+    } else if (!p->dongle) {
+        u8 buf[1024];                              /* 0x12: pairing info, MAC at 1..6 */
+        memset(buf, 0, sizeof buf);
+        buf[0] = 0x12;
+        if (padhost_dev_get_feature(d, buf, sony_feat_len(d, 16, (int)sizeof buf)) >= 16 && buf[0] == 0x12)
+            sony_mac_serial(d, buf + 1);
+    }
+    snprintf(d->name, sizeof d->name, "%s", p->dongle ? "DUALSHOCK 4 USB Wireless Adaptor"
+             : d->pid == 0x09CC ? "DUALSHOCK 4 (v2)" : "DUALSHOCK 4");
+    padhost_logf("DS4 %04X %s: %s\n", d->pid, p->dongle ? "USB adapter" : p->bt ? "Bluetooth" : "USB",
+                 p->cal.ok ? "IMU calibration read" : p->dongle ? "calibration when a pad connects" : "uncalibrated");
+    return 0;
+}
+
+static void ds4_battery(u8 status0, PadHostPortState* st)
+{
+    unsigned lvl = status0 & 0x0F;
+    if (status0 & 0x10) {             /* cable: charging */
+        if (lvl < 10) st->battery = (u8)(lvl * 10 + 5);
+        else if (lvl == 10 || lvl == 11) st->battery = 100;    /* 11 = full */
+        else st->battery = 255;                                 /* 14/15: error */
+    } else {
+        st->battery = (u8)(lvl < 10 ? lvl * 10 + 5 : 100);
+    }
+}
+
+/* Simple report: id, lx, ly, rx, ry, buttons[3], l2, r2. Motion and battery
+ * are not in it and keep their last values. */
+static void ds45_parse_simple(const u8* r, unsigned touch_map, PadHostPortState* st)
+{
+    st->lx = r[1]; st->ly = r[2]; st->rx = r[3]; st->ry = r[4];
+    sony_ds45_buttons(r + 5, touch_map, st);
+    sony_digital_press(st, r[8], r[9]);
+}
+
+static int ds4_parse(PadHostDevice* d, const unsigned char* rep, int len, PadHostPortState* st)
+{
+    Ds4Priv* p = SONY_PRIV(Ds4Priv, d);
+    const u8* c;
+    if (!rep || len < 10) return 0;
+    if (rep[0] == 0x11 && len >= 78) {
+        if (!sony_bt_crc_ok(0xA1, rep, 78)) {
+            if (p->crc_bad++ % 1000 == 0) padhost_logf("DS4: dropped Bluetooth report with bad CRC (%d)\n", p->crc_bad);
+            return 0;
+        }
+        if (!p->bt) p->bt = 1;
+        c = rep + 3;
+    } else if (rep[0] == 0x01 && !p->bt && len >= 64) {
+        c = rep + 1;
+    } else if (rep[0] == 0x01) {
+        /* Bluetooth simple report. Keep asking for the full one now and then
+         * (a pad that was already connected may have ignored the request in
+         * open()); 250 reports is about 1-2 s. */
+        ds45_parse_simple(rep, p->touch_map, st);
+        d->streams = 0;
+        if (!p->full_seen && ++p->simple_n >= 250 && p->switch_tries < 5) {
+            p->simple_n = 0; p->switch_tries++;
+            ds4_request_full_reports(d);
+        }
+        return 1;
+    } else {
+        return 0;
+    }
+
+    if (p->dongle) {
+        int pad = !(c[30] & 0x04);
+        if (pad != p->dongle_pad) {
+            p->dongle_pad = pad;
+            if (pad) ds4_read_calibration(d, p);   /* a different pad may have been paired */
+        }
+        if (!pad) return -1;          /* receiver idle: the manager releases the port */
+    }
+
+    if (!p->full_seen) {
+        p->full_seen = 1;
+        if (p->bt && padhost_log_enabled()) padhost_logf("DS4: full Bluetooth reports (0x11) active\n");
+    }
+    d->streams = 1;                   /* full reports come every few ms, idle or not */
+    st->lx = c[0]; st->ly = c[1]; st->rx = c[2]; st->ry = c[3];
+    sony_ds45_buttons(c + 4, p->touch_map, st);
+    sony_digital_press(st, c[7], c[8]);
+    {
+        int g[3], a[3];
+        for (int i = 0; i < 3; i++) { g[i] = sony_s16le(c + 12 + 2 * i); a[i] = sony_s16le(c + 18 + 2 * i); }
+        sony_motion_to_ps3(&p->cal, g, a, st);
+    }
+    ds4_battery(c[29], st);
+    return 1;
+}
+
+static int ds4_build(PadHostDevice* d, u8 small_motor, u8 large_motor, int port, unsigned char* out,
+                     int cap, int closing)
+{
+    Ds4Priv* p = SONY_PRIV(Ds4Priv, d);
+    const int natural = p->bt ? 78 : 32;
+    int n = sony_out_len(d, natural, cap);
+    if (!n) return 0;
+    memset(out, 0, (size_t)n);
+    u8* e;                                     /* the common block */
+    if (p->bt) {
+        out[0] = 0x11;
+        out[1] = 0xC4;     /* HID 0x80 | CRC 0x40 | report every 4 ms (hid-playstation, RPCS3, SDL) */
+        e = out + 3;
+    } else {
+        out[0] = 0x05;
+        e = out + 1;
+    }
+    e[0] = 0x07;           /* valid: motors 0x01, lightbar 0x02, blink 0x04 (0/0 = steady) */
+    e[3] = small_motor ? 255 : 0;                /* right, weak motor (the DS3's on/off one) */
+    e[4] = large_motor;                          /* left, strong motor */
+    if (closing) { e[5] = 0x00; e[6] = 0x00; e[7] = 0x40; }   /* back to the PS4's player-1 blue */
+    else sony_light_rgb(p->light, p->light_rgb, port, &e[5], &e[6], &e[7]);
+    if (p->bt) sony_put_u32le(out + 74, sony_bt_crc(0xA2, out, 74));
+    return n;
+}
+
+static int ds4_build_output(PadHostDevice* d, u8 small_motor, u8 large_motor, int port, unsigned char* out, int cap)
+{
+    return ds4_build(d, small_motor, large_motor, port, out, cap, 0);
+}
+
+static void ds4_close(PadHostDevice* d)
+{
+    u8 out[1024];
+    int n = ds4_build(d, 0, 0, d->port, out, (int)sizeof out, 1);
+    if (n > 0) padhost_dev_write(d, out, n);
+}
+
+const PadHostDriver padhost_drv_ds4 = {
+    "ds4", PADHOST_KIND_DS4, ds4_match, ds4_open, ds4_parse, ds4_build_output, ds4_close
+};
+
+/* ===========================================================================
+ * DualSense (054C:0CE6) and DualSense Edge (054C:0DF2)
+ *
+ * Input: USB report 0x01 (64 bytes) = id + body; Bluetooth 0x31 (78 bytes) =
+ * id, a sequence/tag byte, body, CRC-32 seed 0xA1. Over Bluetooth the pad
+ * starts with the same 10-byte simple 0x01 report as a DS4 and switches to
+ * 0x31 once the host reads a feature report (RPCS3 reads 0x09, Linux reads
+ * 0x09/0x05/0x20 at probe) or sends an output report (SDL); open() does both.
+ * Body: 0 lx, 1 ly, 2 rx, 3 ry, 4 l2, 5 r2, 6 seq, 7..10 buttons, 15 gyro[3],
+ * 21 accel[3], 27 sensor timestamp, 32 touch points, 52 status (battery level
+ * low nibble, charge state high nibble). buttons[2]: 0x01 PS, 0x02 touchpad,
+ * 0x04 mute; Edge: 0x10/0x20 Fn left/right, 0x40/0x80 left/right back paddle.
+ * Feature reports (all read-only here): 0x05 IMU calibration (41), 0x09
+ * pairing info (20, MAC at 1..6 LSB first), 0x20 firmware info (64:
+ * hw_version u32 @24, fw_version u32 @28, update_version u16 @44). Over
+ * Bluetooth each ends in a CRC-32 (seed 0xA3); over USB those bytes are 0.
+ *
+ * Output: USB 0x02 = id + 47-byte common block (Windows declares 48 bytes);
+ * Bluetooth 0x31 (78 bytes) = id, seq_tag (sequence << 4), tag 0x10, common
+ * block, CRC-32 seed 0xA2 at 74. Common block (hid-playstation):
+ *   0 valid_flag0: 0x01 COMPATIBLE_VIBRATION, 0x02 HAPTICS_SELECT
+ *   1 valid_flag1: 0x04 LIGHTBAR_CONTROL_ENABLE, 0x08 RELEASE_LEDS,
+ *                  0x10 PLAYER_INDICATOR_CONTROL_ENABLE
+ *   2 motor_right (weak), 3 motor_left (strong)
+ *   38 valid_flag2: 0x02 LIGHTBAR_SETUP_CONTROL_ENABLE, 0x04 COMPATIBLE_VIBRATION2
+ *   41 lightbar_setup (0x02 = LIGHT_OUT), 42 led_brightness, 43 player_leds,
+ *   44 red, 45 green, 46 blue
+ * "Compatible vibration" makes the haptic actuators behave like DS4 rumble
+ * motors. Newer firmware and every Edge need the v2 flag for it (the v1
+ * emulation is weak there); older firmware only knows v1. Where "newer"
+ * starts, the references disagree: Linux switches at update_version 0x0215
+ * (its DS_FEATURE_VERSION(2, 21)), SDL at 0x0224 ("2.24"). In between both
+ * flags are set, as RPCS3 always does, so either reading gets rumble.
+ * Over Bluetooth the pad runs a start-up lightbar animation and ignores
+ * lightbar colours until a LIGHTBAR_SETUP LIGHT_OUT report has been sent
+ * (dualsense_reset_leds in hid-playstation); open() sends it on both buses.
+ * =========================================================================*/
+
+enum { DS5_VIB_AUTO, DS5_VIB_V1, DS5_VIB_V2, DS5_VIB_BOTH };
+
+typedef struct {
+    int bt;
+    int edge;
+    int full_seen;
+    int simple_n, switch_tries;
+    int crc_bad;
+    int vib;              /* DS5_VIB_V1 / V2 / BOTH, resolved in open() */
+    int player_leds;      /* 1 = show the port, 0 = off */
+    int light; u8 light_rgb[3];
+    unsigned touch_map, mute_map, paddle_map[2], fn_map[2];
+    u8  out_seq;          /* Bluetooth output sequence, 0..15 */
+    unsigned fw_version, hw_version, update_version;
+    SonyImuCal cal;
+} Ds5Priv;
+SONY_PRIV_FITS(Ds5Priv);
+
+/* Player LEDs for ports 1..7: the PS5's own patterns for players 1-5 (as
+ * hid-playstation), then RPCS3's for 6 and 7. Bit 0 = leftmost LED. */
+static const u8 ds5_player_led[7] = { 0x04, 0x0A, 0x15, 0x1B, 0x1F, 0x17, 0x1D };
+
+static int ds5_match(const PadHostDevice* d)
+{
+    if (d->vid != SONY_VID || (d->pid != 0x0CE6 && d->pid != 0x0DF2)) return 0;
+    if (d->usage_page && d->usage_page != 0x01) return 0;
+    if (d->usage && d->usage != 0x04 && d->usage != 0x05) return 0;
+    return 100;
+}
+
+/* GET_FEATURE that checks the id and, over Bluetooth, the CRC (hid-playstation
+ * checks it for 0x05 and 0x20, not for the pairing info); 3 tries. */
+static int ds5_get_feature(PadHostDevice* d, const Ds5Priv* p, u8 id, int len, u8* buf, int cap, int crc)
+{
+    for (int tries = 0; tries < 3; tries++) {
+        memset(buf, 0, (size_t)cap);
+        buf[0] = id;
+        int n = padhost_dev_get_feature(d, buf, sony_feat_len(d, len, cap));
+        if (n < len || buf[0] != id) continue;
+        if (crc && p->bt && !sony_bt_crc_ok(0xA3, buf, len)) continue;
+        return 1;
+    }
+    return 0;
+}
+
+static int ds5_build(PadHostDevice* d, u8 small_motor, u8 large_motor, int port, unsigned char* out,
+                     int cap, int mode);
+enum { DS5_OUT_NORMAL, DS5_OUT_RESET_LEDS, DS5_OUT_CLOSE };
+
+static int ds5_open(PadHostDevice* d)
+{
+    Ds5Priv* p = SONY_PRIV(Ds5Priv, d);
+    u8 buf[1024];
+    memset(p, 0, sizeof *p);
+    p->bt = sony_detect_bt(d, 64);
+    p->edge = d->pid == 0x0DF2;
+    sony_cal_default(&p->cal);
+
+    p->touch_map = sony_cfg_buttons("dualsense_touchpad", CELL_PAD_CTRL_SELECT);
+    p->mute_map  = sony_cfg_buttons("dualsense_mute", 0);
+    p->paddle_map[0] = sony_cfg_buttons("dualsense_edge_left_paddle", 0);
+    p->paddle_map[1] = sony_cfg_buttons("dualsense_edge_right_paddle", 0);
+    p->fn_map[0] = sony_cfg_buttons("dualsense_edge_left_fn", 0);
+    p->fn_map[1] = sony_cfg_buttons("dualsense_edge_right_fn", 0);
+    p->light = sony_cfg_light("dualsense_lightbar", p->light_rgb);
+    {
+        const char* v = padhost_config_get("dualsense_player_leds");
+        p->player_leds = !(sony_is(v, "off") || sony_is(v, "0") || sony_is(v, "none"));
+    }
+
+    /* Pairing info first: it is also what switches a Bluetooth pad to 0x31. */
+    if (ds5_get_feature(d, p, 0x09, 20, buf, (int)sizeof buf, 0)) sony_mac_serial(d, buf + 1);
+    else if (p->bt) sony_normalize_serial(d);
+
+    int bad = 6;
+    if (ds5_get_feature(d, p, 0x05, 41, buf, (int)sizeof buf, 1)) bad = sony_cal_parse(buf, &p->cal);
+    else sony_cal_default(&p->cal);
+
+    int have_fw = ds5_get_feature(d, p, 0x20, 64, buf, (int)sizeof buf, 1);
+    if (have_fw) {
+        p->hw_version = sony_u32le(buf + 24);
+        p->fw_version = sony_u32le(buf + 28);
+        p->update_version = sony_u16le(buf + 44);
+    }
+    {
+        const char* v = padhost_config_get("dualsense_vibration");
+        p->vib = DS5_VIB_AUTO;
+        if (sony_is(v, "v1")) p->vib = DS5_VIB_V1;
+        else if (sony_is(v, "v2")) p->vib = DS5_VIB_V2;
+        else if (sony_is(v, "both")) p->vib = DS5_VIB_BOTH;
+        else if (v && !sony_is(v, "auto")) padhost_logf("dualsense_vibration=\"%s\": expected auto, v1, v2 or both\n", v);
+        if (p->vib == DS5_VIB_AUTO) {
+            if (p->edge) p->vib = DS5_VIB_V2;
+            else if (have_fw) p->vib = p->update_version >= 0x0224 ? DS5_VIB_V2 :
+                                       p->update_version >= 0x0215 ? DS5_VIB_BOTH : DS5_VIB_V1;
+            else p->vib = DS5_VIB_BOTH;          /* RPCS3 always sets both */
+        }
+    }
+
+    snprintf(d->name, sizeof d->name, "%s", p->edge ? "DualSense Edge" : "DualSense");
+    padhost_logf("%s %s: firmware %08X (update %X.%02X, hw %08X), vibration %s\n",
+                 d->name, p->bt ? "Bluetooth" : "USB", p->fw_version, p->update_version >> 8,
+                 p->update_version & 0xFF, p->hw_version,
+                 p->vib == DS5_VIB_V2 ? "v2" : p->vib == DS5_VIB_V1 ? "v1" : "v1+v2");
+    sony_log_cal(d->name, &p->cal, bad);
+
+    /* Release the start-up lightbar animation; on Bluetooth this also turns on
+     * the full report. A failed write (read-only mode) is not an error. */
+    {
+        int n = ds5_build(d, 0, 0, -1, buf, (int)sizeof buf, DS5_OUT_RESET_LEDS);
+        if (n > 0) padhost_dev_write(d, buf, n);
+    }
+    return 0;
+}
+
+static void ds5_battery(u8 status, PadHostPortState* st)
+{
+    unsigned lvl = status & 0x0F, chg = status >> 4;
+    unsigned pct = lvl * 10 + 5;
+    if (pct > 100) pct = 100;
+    switch (chg) {
+    case 0x0: case 0x1: st->battery = (u8)pct; break;   /* discharging / charging */
+    case 0x2: st->battery = 100; break;                 /* full */
+    default: st->battery = 255; break;                  /* 0xA/0xB not charging (temperature, voltage), 0xF error */
+    }
+}
+
+static int ds5_parse(PadHostDevice* d, const unsigned char* rep, int len, PadHostPortState* st)
+{
+    Ds5Priv* p = SONY_PRIV(Ds5Priv, d);
+    const u8* b;
+    if (!rep || len < 10) return 0;
+    if (rep[0] == 0x31 && len >= 78) {
+        if (!sony_bt_crc_ok(0xA1, rep, 78)) {
+            if (p->crc_bad++ % 1000 == 0) padhost_logf("DualSense: dropped Bluetooth report with bad CRC (%d)\n", p->crc_bad);
+            return 0;
+        }
+        p->bt = 1;
+        b = rep + 2;
+    } else if (rep[0] == 0x01 && !p->bt && len >= 64) {
+        b = rep + 1;
+    } else if (rep[0] == 0x01) {
+        ds45_parse_simple(rep, p->touch_map, st);
+        d->streams = 0;
+        if (!p->full_seen && ++p->simple_n >= 250 && p->switch_tries < 5) {
+            u8 buf[1024];
+            p->simple_n = 0; p->switch_tries++;
+            /* Reading the calibration report switches it (and refreshes it). */
+            if (ds5_get_feature(d, p, 0x05, 41, buf, (int)sizeof buf, 1) && !p->cal.ok) sony_cal_parse(buf, &p->cal);
+        }
+        return 1;
+    } else {
+        return 0;
+    }
+
+    if (!p->full_seen) {
+        p->full_seen = 1;
+        if (p->bt && padhost_log_enabled()) padhost_logf("DualSense: full Bluetooth reports (0x31) active\n");
+    }
+    d->streams = 1;
+    st->lx = b[0]; st->ly = b[1]; st->rx = b[2]; st->ry = b[3];
+    sony_ds45_buttons(b + 7, p->touch_map, st);
+    if (b[9] & 0x04) sony_apply_map(st, p->mute_map);
+    if (p->edge) {
+        if (b[9] & 0x10) sony_apply_map(st, p->fn_map[0]);
+        if (b[9] & 0x20) sony_apply_map(st, p->fn_map[1]);
+        if (b[9] & 0x40) sony_apply_map(st, p->paddle_map[0]);
+        if (b[9] & 0x80) sony_apply_map(st, p->paddle_map[1]);
+    }
+    sony_digital_press(st, b[4], b[5]);
+    {
+        int g[3], a[3];
+        for (int i = 0; i < 3; i++) { g[i] = sony_s16le(b + 15 + 2 * i); a[i] = sony_s16le(b + 21 + 2 * i); }
+        sony_motion_to_ps3(&p->cal, g, a, st);
+    }
+    ds5_battery(b[52], st);
+    return 1;
+}
+
+static int ds5_build(PadHostDevice* d, u8 small_motor, u8 large_motor, int port, unsigned char* out,
+                     int cap, int mode)
+{
+    Ds5Priv* p = SONY_PRIV(Ds5Priv, d);
+    const int natural = p->bt ? 78 : 48;
+    int n = sony_out_len(d, natural, cap);
+    if (!n) return 0;
+    memset(out, 0, (size_t)n);
+    u8* c;
+    if (p->bt) {
+        out[0] = 0x31;
+        out[1] = (u8)(p->out_seq << 4);          /* seq_tag: sequence number, tag 0 */
+        p->out_seq = (u8)((p->out_seq + 1) & 15);
+        out[2] = 0x10;                           /* DS_OUTPUT_TAG */
+        c = out + 3;
+    } else {
+        out[0] = 0x02;
+        c = out + 1;
+    }
+    if (mode == DS5_OUT_RESET_LEDS) {
+        c[38] = 0x02;                            /* LIGHTBAR_SETUP_CONTROL_ENABLE */
+        c[41] = 0x02;                            /* LIGHT_OUT: end the start-up animation */
+    } else {
+        c[0] = 0x02;                             /* HAPTICS_SELECT */
+        if (p->vib != DS5_VIB_V2) c[0] |= 0x01;  /* COMPATIBLE_VIBRATION */
+        if (p->vib != DS5_VIB_V1) c[38] |= 0x04; /* COMPATIBLE_VIBRATION2 */
+        c[2] = small_motor ? 255 : 0;            /* right, weak motor */
+        c[3] = large_motor;                      /* left, strong motor */
+        if (mode == DS5_OUT_CLOSE) {
+            c[1] = 0x08;                         /* RELEASE_LEDS: back to the pad's own */
+        } else {
+            c[1] = 0x04 | 0x10;                  /* lightbar + player indicator */
+            c[43] = (u8)(p->player_leds && port >= 0 && port < 7 ? ds5_player_led[port] : 0);
+            sony_light_rgb(p->light, p->light_rgb, port, &c[44], &c[45], &c[46]);
+        }
+    }
+    if (p->bt) sony_put_u32le(out + 74, sony_bt_crc(0xA2, out, 74));
+    return n;
+}
+
+static int ds5_build_output(PadHostDevice* d, u8 small_motor, u8 large_motor, int port, unsigned char* out, int cap)
+{
+    return ds5_build(d, small_motor, large_motor, port, out, cap, DS5_OUT_NORMAL);
+}
+
+static void ds5_close(PadHostDevice* d)
+{
+    u8 out[1024];
+    int n = ds5_build(d, 0, 0, d->port, out, (int)sizeof out, DS5_OUT_CLOSE);
+    if (n > 0) padhost_dev_write(d, out, n);
+}
+
+const PadHostDriver padhost_drv_dualsense = {
+    "dualsense", PADHOST_KIND_DUALSENSE, ds5_match, ds5_open, ds5_parse, ds5_build_output, ds5_close
+};
+
+/* ===========================================================================
+ * DualShock 3 / SIXAXIS (054C:0268)
+ *
+ * The DS3's own report 0x01 (49 bytes with the id; hid-sony, DsHidMini
+ * Ds3Types.h DS3_RAW_INPUT_REPORT, RPCS3 ds3_input_report agree):
+ *   2 SELECT L3 R3 START UP RIGHT DOWN LEFT (bits 0..7, the PS3's DIGITAL1)
+ *   3 L2 R2 L1 R1 TRIANGLE CIRCLE CROSS SQUARE (the PS3's DIGITAL2), 4 PS
+ *   6 lx, 7 ly, 8 rx, 9 ry (up = 0, as on the PS3)
+ *   14..25 pressure: up right down left l2 r2 l1 r1 triangle circle cross square
+ *   30 battery: 0..5 level, 0xEE charging, 0xEF full
+ *   41 accel x, 43 accel "z", 45 accel "y", 47 gyro: 10-bit, big-endian
+ * The PS3 is the DS3's host, so it is already in PS3 units. As RPCS3 does for
+ * a raw device, sensor_x = 1024 - x (the PS3 mirrors x), sensor_y = word 45,
+ * sensor_z = word 43, sensor_g = word 47 (a pad lying flat reads ~399 at 45).
+ * Output report 0x01: rumble (padding, right duration, right on/off, left
+ * duration, left force), 4 padding, LED bitmap (LED 1 = 0x02 .. LED 4 = 0x10),
+ * four 5-byte LED timing blocks, a fifth unused one (hid-sony).
+ *
+ * How the DS3 reaches a Windows program -- it is not usable with no driver:
+ *  - Stock Windows HID driver (no extra driver installed): the collection is
+ *    the raw one (input 0x01, 49 bytes). The pad stays silent until it is
+ *    switched to "operational": hid-sony does GET_REPORT 0xF2, the PS3 sends
+ *    SET_REPORT 0xF4 42 0C 00 00; open() tries both and ignores failures.
+ *    Output report 0x01 works only over the control endpoint ("the Sixaxis
+ *    does not handle HID Output Reports on the Interrupt EP" -- hid-sony), so
+ *    rumble/LEDs need padhost_dev_write's SET_OUTPUT_REPORT path.
+ *  - Sony's sixaxis.sys (installed with PlayStation Now) and DsHidMini in SXS
+ *    mode (which emulates it; RPCS3's recommended setup): a joystick
+ *    collection without report ids -- input 12 bytes (13 with the id byte),
+ *    output 48 (49), feature 49 (50). The full state is the feature report 0:
+ *    byte 0 id 0, 1 = 0x00, 2 = 0x3F, then the raw report's bytes 2..48 at
+ *    3..49 -- i.e. the raw layout one byte later (RPCS3 DS3_HID_OFFSET 1;
+ *    DsHidMini DSHM_GetFeature), with the sensor words little-endian and
+ *    already in PS3 form (RPCS3: "Official Sony Windows DS3 driver seems to do
+ *    the same modification of this value as the ps3"). It is polled on every
+ *    input report. Output: id 0, then 0x02 0x00 0x00, then raw output bytes
+ *    1.. (RPCS3 ds3_output_report on _WIN32; DsHidMini copies the write from
+ *    its 4th byte on). Rumble, LEDs, pressure and motion all work.
+ *  - DsHidMini SDF mode: one gamepad collection, report 0x01 of 37 bytes
+ *    (DsHid.c DS3_RAW_TO_SDF_HID_INPUT_REPORT): 1..4 sticks, 5 hat + face
+ *    buttons, 6 SELECT L3 R3 START L2 R2 L1 R1, 7 PS + d-pad buttons, 8 l2,
+ *    9 r2, 10..19 pressure up right down left l1 r1 triangle circle cross
+ *    square (in DsHidMini's "analogue" pressure mode; "digital" leaves them 0
+ *    and then only the bits count). Pressure works; no motion, and the LEDs
+ *    / rumble belong to DsHidMini (charging animation, force feedback), so no
+ *    output here.
+ *  - DsHidMini GPJ mode: two collections. 0x01 (12 bytes) = SDF's first 8
+ *    bytes + l2 r2 l1 r1 pressure; 0x02 (9 bytes, the "joystick") = d-pad and
+ *    face pressure. The first is driven as a pad (shoulder pressure only); the
+ *    second is claimed and refused in open() so it never becomes a port.
+ *  - DsHidMini CGP / XInput / DS4Windows modes: not claimed here (generic HID,
+ *    XInput, or an emulated DS4 with an artificial VID/PID).
+ * =========================================================================*/
+
+enum { DS3_NONE, DS3_NATIVE, DS3_SXS, DS3_SDF, DS3_GPJ1, DS3_GPJ2 };
+enum { DS3_SENS_UNKNOWN, DS3_SENS_RAW_BE, DS3_SENS_PS3_LE };
+
+typedef struct {
+    int layout;
+    int sens;            /* sensor word format, latched once unambiguous */
+    int bogus;           /* dropped reports */
+    int feat_fail;       /* SXS: consecutive failed feature polls */
+} Ds3Priv;
+SONY_PRIV_FITS(Ds3Priv);
+
+static int ds3_layout_of(const PadHostDevice* d)
+{
+    if (d->vid != SONY_VID || d->pid != 0x0268) return DS3_NONE;
+    switch (d->in_len) {
+    case 0:  return DS3_NATIVE;           /* lengths unknown: assume the raw device */
+    case 49: case 50: return DS3_NATIVE;
+    case 13: return DS3_SXS;
+    case 37: return DS3_SDF;
+    case 12: return DS3_GPJ1;
+    case 9:  return DS3_GPJ2;
+    default: return DS3_NONE;             /* something else: leave it to the generic driver */
+    }
+}
+
+static const char* ds3_layout_name(int l)
+{
+    switch (l) {
+    case DS3_NATIVE: return "raw HID";
+    case DS3_SXS:    return "SIXAXIS.SYS / DsHidMini SXS";
+    case DS3_SDF:    return "DsHidMini SDF";
+    case DS3_GPJ1:   return "DsHidMini GPJ";
+    case DS3_GPJ2:   return "DsHidMini GPJ pressure collection";
+    default:         return "?";
+    }
+}
+
+static int ds3_match(const PadHostDevice* d)
+{
+    return ds3_layout_of(d) != DS3_NONE ? 100 : 0;
+}
+
+static int ds3_open(PadHostDevice* d)
+{
+    Ds3Priv* p = SONY_PRIV(Ds3Priv, d);
+    memset(p, 0, sizeof *p);
+    p->layout = ds3_layout_of(d);
+    if (p->layout == DS3_GPJ2) {
+        padhost_logf("DS3 (DsHidMini GPJ): ignoring the pressure-only collection; SDF or SXS mode gives full pressure\n");
+        return PADHOST_OPEN_DECLINED;
+    }
+    if (p->layout == DS3_NATIVE) {
+        u8 buf[1024];
+        static const u8 enable[5] = { 0xF4, 0x42, 0x0C, 0x00, 0x00 };
+        d->out_set_report = 1;               /* report 0x01 only works as a SET_REPORT */
+        memset(buf, 0, sizeof buf);
+        buf[0] = 0xF2;                       /* GET_REPORT 0xF2: "operational" (hid-sony) */
+        int got = padhost_dev_get_feature(d, buf, sony_feat_len(d, 18, (int)sizeof buf));
+        if (got >= 10 && buf[0] == 0xF2) {
+            /* 0xF2 carries the pad's Bluetooth address at 4..9, MSB first. */
+            u8 mac[6];
+            for (int i = 0; i < 6; i++) mac[i] = buf[9 - i];
+            sony_mac_serial(d, mac);
+        }
+        int set = padhost_dev_set_feature(d, enable, 5);
+        if (set < 0 && d->feat_len > 5) {
+            memset(buf, 0, sizeof buf);
+            memcpy(buf, enable, 5);
+            set = padhost_dev_set_feature(d, buf, sony_feat_len(d, 5, (int)sizeof buf));
+        }
+        if (got < 0 && set < 0)
+            padhost_logf("DS3: could not switch the pad to operational mode; it may stay silent "
+                         "(install DsHidMini and pick SXS or SDF mode)\n");
+    } else if (d->bus == PADHOST_BUS_BT) {
+        sony_normalize_serial(d);
+    }
+    p->sens = p->layout == DS3_SXS ? DS3_SENS_UNKNOWN : DS3_SENS_RAW_BE;
+    snprintf(d->name, sizeof d->name, "DUALSHOCK 3 (%s)", ds3_layout_name(p->layout));
+    padhost_logf("DS3 via %s: pressure %s, motion %s, rumble/LEDs %s\n", ds3_layout_name(p->layout),
+                 p->layout == DS3_GPJ1 ? "L1/R1/L2/R2 only" : "yes",
+                 p->layout == DS3_NATIVE || p->layout == DS3_SXS ? "yes" : "no",
+                 p->layout == DS3_NATIVE || p->layout == DS3_SXS ? "yes" : "no (driver owns them)");
+    return 0;
+}
+
+static void ds3_battery(u8 v, PadHostPortState* st)
+{
+    static const u8 cap[6] = { 0, 1, 25, 50, 75, 100 };   /* hid-sony sixaxis_battery_capacity */
+    st->battery = v >= 0xEE ? 100 : cap[v <= 5 ? v : 5];
+}
+
+/* Sensor words at r[41..48]. BE (the pad's own) or LE (sixaxis.sys form): a
+ * 10-bit value read the wrong way round is > 1023 unless its low byte is < 4,
+ * so a report where exactly one reading fits all four words settles it. */
+static void ds3_sensors(Ds3Priv* p, const u8* r, PadHostPortState* st)
+{
+    unsigned be[4], le[4];
+    int be_ok = 1, le_ok = 1, zero = 1;
+    for (int i = 0; i < 4; i++) {
+        be[i] = ((unsigned)r[41 + 2 * i] << 8) | r[42 + 2 * i];
+        le[i] = r[41 + 2 * i] | ((unsigned)r[42 + 2 * i] << 8);
+        if (be[i] > 1023) be_ok = 0;
+        if (le[i] > 1023) le_ok = 0;
+        if (be[i]) zero = 0;
+    }
+    if (zero) return;                     /* sensors not running: keep neutral */
+    int fmt = p->sens;
+    if (be_ok != le_ok) {
+        fmt = be_ok ? DS3_SENS_RAW_BE : DS3_SENS_PS3_LE;
+        if (fmt != p->sens && p->sens != DS3_SENS_UNKNOWN)
+            padhost_logf("DS3: sensor words are %s\n", fmt == DS3_SENS_RAW_BE ? "big-endian (raw)" : "little-endian (driver-processed)");
+        p->sens = fmt;
+    }
+    if (fmt == DS3_SENS_UNKNOWN) fmt = DS3_SENS_PS3_LE;
+    if (fmt == DS3_SENS_RAW_BE) {
+        int x = 1024 - (int)be[0];
+        st->sensor_x = (u16)(x < 0 ? 0 : x > 1023 ? 1023 : x);
+        st->sensor_z = (u16)be[1];
+        st->sensor_y = (u16)be[2];
+        st->sensor_g = (u16)be[3];
+    } else {
+        st->sensor_x = (u16)(le[0] > 1023 ? 1023 : le[0]);
+        st->sensor_z = (u16)(le[1] > 1023 ? 1023 : le[1]);
+        st->sensor_y = (u16)(le[2] > 1023 ? 1023 : le[2]);
+        st->sensor_g = (u16)(le[3] > 1023 ? 1023 : le[3]);
+    }
+    st->has_motion = 1;
+}
+
+/* r = the raw layout (r[0] report id 0x01, or 0 in the SXS feature copy). */
+static void ds3_parse_raw(Ds3Priv* p, const u8* r, PadHostPortState* st)
+{
+    st->buttons = (u16)(r[2] | (r[3] << 8));
+    st->ps = (u8)(r[4] & 0x01);
+    st->lx = r[6]; st->ly = r[7]; st->rx = r[8]; st->ry = r[9];
+    st->press[PADHOST_PRESS_UP]       = r[14];
+    st->press[PADHOST_PRESS_RIGHT]    = r[15];
+    st->press[PADHOST_PRESS_DOWN]     = r[16];
+    st->press[PADHOST_PRESS_LEFT]     = r[17];
+    st->press[PADHOST_PRESS_L2]       = r[18];
+    st->press[PADHOST_PRESS_R2]       = r[19];
+    st->press[PADHOST_PRESS_L1]       = r[20];
+    st->press[PADHOST_PRESS_R1]       = r[21];
+    st->press[PADHOST_PRESS_TRIANGLE] = r[22];
+    st->press[PADHOST_PRESS_CIRCLE]   = r[23];
+    st->press[PADHOST_PRESS_CROSS]    = r[24];
+    st->press[PADHOST_PRESS_SQUARE]   = r[25];
+    st->has_pressure = 1;
+    ds3_battery(r[30], st);
+    ds3_sensors(p, r, st);
+}
+
+/* SDF / GPJ report 0x01 bytes 1..7 (DsHid.c). */
+static void ds3_parse_dshm_buttons(const u8* r, PadHostPortState* st)
+{
+    u16 v = sony_hat_to_dpad(r[5] & 0x0F);
+    if (r[5] & 0x10) v |= CELL_PAD_CTRL_TRIANGLE;
+    if (r[5] & 0x20) v |= CELL_PAD_CTRL_CIRCLE;
+    if (r[5] & 0x40) v |= CELL_PAD_CTRL_CROSS;
+    if (r[5] & 0x80) v |= CELL_PAD_CTRL_SQUARE;
+    v |= (u16)(r[6] & 0x0F);                         /* SELECT L3 R3 START */
+    if (r[6] & 0x10) v |= CELL_PAD_CTRL_L2;
+    if (r[6] & 0x20) v |= CELL_PAD_CTRL_R2;
+    if (r[6] & 0x40) v |= CELL_PAD_CTRL_L1;
+    if (r[6] & 0x80) v |= CELL_PAD_CTRL_R1;
+    if (r[7] & 0x02) v |= CELL_PAD_CTRL_UP;          /* individual d-pad buttons, if enabled */
+    if (r[7] & 0x04) v |= CELL_PAD_CTRL_RIGHT;
+    if (r[7] & 0x08) v |= CELL_PAD_CTRL_DOWN;
+    if (r[7] & 0x10) v |= CELL_PAD_CTRL_LEFT;
+    st->buttons = v;
+    st->ps = (u8)(r[7] & 0x01);
+    st->lx = r[1]; st->ly = r[2]; st->rx = r[3]; st->ry = r[4];
+}
+
+/* DsHidMini's pressure exposure setting decides what SDF carries: digital
+ * bits only (pressure bytes stay 0), pressure only (face / d-pad bits stay
+ * 0), or both. So: the pressure byte if there is one, else full pressure from
+ * the bit; and a firm press seen only as pressure sets the bit. */
+static void ds3_press(PadHostPortState* st, int idx, u16 bit, u8 v)
+{
+    if (v >= 0x30) st->buttons |= bit;
+    st->press[idx] = v ? v : (st->buttons & bit) ? 255 : 0;
+}
+
+/* The 12-byte SXS joystick report, used only when the feature report 0 poll
+ * fails (DsHid.c DS3_RAW_TO_SIXAXIS_HID_INPUT_REPORT; rep[0] = id 0). */
+static void ds3_parse_sxs_input(const u8* rep, PadHostPortState* st)
+{
+    const u8* r = rep + 1;
+    u16 v = sony_hat_to_dpad(r[3] & 0x0F);
+    if (r[0] & 0x01) v |= CELL_PAD_CTRL_TRIANGLE;
+    if (r[0] & 0x02) v |= CELL_PAD_CTRL_CIRCLE;
+    if (r[0] & 0x04) v |= CELL_PAD_CTRL_CROSS;
+    if (r[0] & 0x08) v |= CELL_PAD_CTRL_SQUARE;
+    if (r[0] & 0x10) v |= CELL_PAD_CTRL_L2;
+    if (r[0] & 0x20) v |= CELL_PAD_CTRL_R2;
+    if (r[0] & 0x40) v |= CELL_PAD_CTRL_L1;
+    if (r[0] & 0x80) v |= CELL_PAD_CTRL_R1;
+    if (r[1] & 0x01) v |= CELL_PAD_CTRL_START;
+    if (r[1] & 0x02) v |= CELL_PAD_CTRL_SELECT;
+    if (r[1] & 0x04) v |= CELL_PAD_CTRL_L3;
+    if (r[1] & 0x08) v |= CELL_PAD_CTRL_R3;
+    st->buttons = v;
+    st->ps = (u8)((r[1] >> 4) & 1);
+    st->lx = r[4]; st->ly = r[5]; st->rx = r[6]; st->ry = r[7];
+    sony_digital_press(st, (u8)(0xFF - r[10]), (u8)(0xFF - r[11]));
+    st->press[PADHOST_PRESS_CIRCLE] = (u8)(0xFF - r[8]);
+    st->press[PADHOST_PRESS_CROSS]  = (u8)(0xFF - r[9]);
+}
+
+static int ds3_parse(PadHostDevice* d, const unsigned char* rep, int len, PadHostPortState* st)
+{
+    Ds3Priv* p = SONY_PRIV(Ds3Priv, d);
+    switch (p->layout) {
+    case DS3_NATIVE:
+        if (!rep || len < 49 || rep[0] != 0x01) return 0;
+        /* "the Sixaxis occasionally sends a report with the second byte 0xff
+         * and the rest zeroed" -- hid-sony; not the pad's state. */
+        if (rep[1] == 0xFF) { p->bogus++; return 0; }
+        ds3_parse_raw(p, rep, st);
+        return 1;
+    case DS3_SXS: {
+        /* rep == NULL: a poll with no input report (read timeout). */
+        u8 buf[1024];
+        memset(buf, 0, sizeof buf);
+        buf[0] = 0x00;
+        int n = padhost_dev_get_feature(d, buf, sony_feat_len(d, 50, (int)sizeof buf));
+        if (n >= 50 && buf[0] == 0x00) {
+            p->feat_fail = 0;
+            ds3_parse_raw(p, buf + 1, st);
+            return 1;
+        }
+        if (p->feat_fail++ == 0) padhost_logf("DS3 (SXS): feature report 0 failed, buttons/sticks only\n");
+        if (!rep || len < 13 || rep[0] != 0x00) return 0;
+        ds3_parse_sxs_input(rep, st);
+        return 1;
+    }
+    case DS3_SDF:
+    case DS3_GPJ1: {
+        if (!rep || rep[0] != 0x01 || len < (p->layout == DS3_SDF ? 20 : 12)) return 0;
+        ds3_parse_dshm_buttons(rep, st);
+        if (p->layout == DS3_SDF) {
+            ds3_press(st, PADHOST_PRESS_UP,       CELL_PAD_CTRL_UP,       rep[10]);
+            ds3_press(st, PADHOST_PRESS_RIGHT,    CELL_PAD_CTRL_RIGHT,    rep[11]);
+            ds3_press(st, PADHOST_PRESS_DOWN,     CELL_PAD_CTRL_DOWN,     rep[12]);
+            ds3_press(st, PADHOST_PRESS_LEFT,     CELL_PAD_CTRL_LEFT,     rep[13]);
+            ds3_press(st, PADHOST_PRESS_L1,       CELL_PAD_CTRL_L1,       rep[14]);
+            ds3_press(st, PADHOST_PRESS_R1,       CELL_PAD_CTRL_R1,       rep[15]);
+            ds3_press(st, PADHOST_PRESS_TRIANGLE, CELL_PAD_CTRL_TRIANGLE, rep[16]);
+            ds3_press(st, PADHOST_PRESS_CIRCLE,   CELL_PAD_CTRL_CIRCLE,   rep[17]);
+            ds3_press(st, PADHOST_PRESS_CROSS,    CELL_PAD_CTRL_CROSS,    rep[18]);
+            ds3_press(st, PADHOST_PRESS_SQUARE,   CELL_PAD_CTRL_SQUARE,   rep[19]);
+            ds3_press(st, PADHOST_PRESS_L2,       CELL_PAD_CTRL_L2,       rep[8]);
+            ds3_press(st, PADHOST_PRESS_R2,       CELL_PAD_CTRL_R2,       rep[9]);
+        } else {
+            sony_digital_press(st, rep[8], rep[9]);
+            st->press[PADHOST_PRESS_L1] = rep[10];
+            st->press[PADHOST_PRESS_R1] = rep[11];
+        }
+        st->has_pressure = 1;
+        return 1;
+    }
+    default:
+        return 0;
+    }
+}
+
+static int ds3_build(PadHostDevice* d, u8 small_motor, u8 large_motor, int port, unsigned char* out, int cap)
+{
+    Ds3Priv* p = SONY_PRIV(Ds3Priv, d);
+    if (p->layout != DS3_NATIVE && p->layout != DS3_SXS) return 0;
+    const int lead = p->layout == DS3_SXS ? 3 : 0;   /* SXS: id 0, then 02 00 00 */
+    int n = sony_out_len(d, 36 + lead, cap);
+    if (!n) return 0;
+    memset(out, 0, (size_t)n);
+    if (p->layout == DS3_SXS) { out[0] = 0x00; out[1] = 0x02; }
+    else out[0] = 0x01;
+    u8* r = out + lead;               /* r[k] = byte k of the raw output report 0x01 */
+    r[2] = 0xFF;                      /* right (weak) motor: duration forever, */
+    r[3] = small_motor ? 1 : 0;       /*   on/off only */
+    r[4] = 0xFF;                      /* left (strong) motor: duration forever, */
+    r[5] = large_motor;               /*   force 0..255 */
+    r[10] = (u8)(port >= 0 ? (padhost_port_led_mask(port) & 0x0F) << 1 : 0);
+    for (int i = 0; i < 4; i++) {     /* LED timing: always on (hid-sony default_report) */
+        u8* l = r + 11 + 5 * i;
+        l[0] = 0xFF; l[1] = 0x27; l[2] = 0x10; l[3] = 0x00; l[4] = 0x32;
+    }
+    return n;
+}
+
+static int ds3_build_output(PadHostDevice* d, u8 small_motor, u8 large_motor, int port, unsigned char* out, int cap)
+{
+    return ds3_build(d, small_motor, large_motor, port, out, cap);
+}
+
+static void ds3_close(PadHostDevice* d)
+{
+    u8 out[1024];
+    int n = ds3_build(d, 0, 0, d->port, out, (int)sizeof out);   /* motors off, port LED kept */
+    if (n > 0) padhost_dev_write(d, out, n);
+}
+
+const PadHostDriver padhost_drv_ds3 = {
+    "ds3", PADHOST_KIND_DS3, ds3_match, ds3_open, ds3_parse, ds3_build_output, ds3_close
+};
diff --git a/libs/input/pad_hid_switch.c b/libs/input/pad_hid_switch.c
new file mode 100644
index 0000000..9b344ad
--- /dev/null
+++ b/libs/input/pad_hid_switch.c
@@ -0,0 +1,786 @@
+/*
+ * ps3recomp - Nintendo Switch Pro Controller for the pad host (pad_host.h)
+ *
+ * 057E:2009 over USB and Bluetooth, and the third-party pads that present
+ * themselves as one ("Switch mode" on 8BitDo, PowerA, Hori, ...). Protocol
+ * per dekuNukem's Nintendo_Switch_Reverse_Engineering notes, SDL's
+ * SDL_hidapi_switch.c and Linux's hid-nintendo.c:
+ *
+ *   USB only, first: output 0x80 <cmd> -- 0x01 status, 0x02 handshake,
+ *   0x03 3 Mbit link, 0x02 again, then 0x04 "no timeout" (stay a plain USB
+ *   HID device instead of falling back to waiting for a console). Each is
+ *   answered by input 0x81 <cmd>, except 0x04.
+ *
+ *   Both buses: output 0x01 = [0x01, packet counter (low 4 bits, one counter
+ *   per controller for every 0x01/0x10 packet), 8 bytes rumble, subcommand,
+ *   arguments], answered by input 0x21 = [0x21, timer, battery, 9 bytes of
+ *   input state, vibrator byte, ACK (0x80 | data type), subcommand, data].
+ *   Output 0x10 = [0x10, counter, 8 bytes rumble]: rumble only.
+ *
+ * Bring-up: device info (0x02), SPI flash reads (0x10) of the factory and
+ * user stick calibration (0x603D, 0x8010) and IMU calibration (0x6020,
+ * 0x8026), vibration on (0x48), IMU on (0x40), full report mode 0x30 (0x03),
+ * player lights = port (0x30), HOME ring on (0x38). Every step is best
+ * effort: clones often ignore some of them, and a pad that answers nothing at
+ * all is still read through its plain 0x3F report.
+ *
+ * Input 0x30 (USB and Bluetooth alike, ~8 ms / 15 ms): bytes 3-5 buttons,
+ * 6-11 the two sticks as 12-bit pairs, 13-48 three IMU samples (accel XYZ,
+ * gyro XYZ, int16 LE). Input 0x3F (the pad's power-on mode, sent on change):
+ * 2 button bytes, a hat, 4 x u16 sticks centred on 0x8000 (HID orientation,
+ * down = larger). 0x21 replies carry the 0x30 input bytes too.
+ *
+ * Face buttons go by POSITION by default -- B (bottom) = Cross, A (right) =
+ * Circle, Y (left) = Square, X (top) = Triangle -- so the game's "press X to
+ * jump" is the same thumb movement as on a DUALSHOCK. switch_layout = label
+ * (input.ini [gamepad], or PAD_HOST="switch_layout=label") maps by printed
+ * letter instead, as an Xbox pad's letters sit: A = Cross, B = Circle,
+ * X = Square, Y = Triangle. ZL/ZR = L2/R2 (digital, full pressure), L/R =
+ * L1/R1, Minus = SELECT, Plus = START, Capture = SELECT too, HOME = PS.
+ * switch_home_led = 0..100 sets the HOME ring (default 40, 0 = off).
+ */
+#if defined(_WIN32)
+
+#include "pad_host.h"
+#include "cellPad.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef WIN32_LEAN_AND_MEAN
+  #define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+/* ---------------------------------------------------------------------------
+ * Protocol constants
+ * -----------------------------------------------------------------------*/
+
+#define SW_VID_NINTENDO   0x057E
+#define SW_PID_PRO        0x2009
+
+#define SW_OUT_SUBCMD     0x01
+#define SW_OUT_RUMBLE     0x10
+#define SW_OUT_USB        0x80
+#define SW_IN_REPLY       0x21
+#define SW_IN_FULL        0x30
+#define SW_IN_SIMPLE      0x3F
+#define SW_IN_USB_REPLY   0x81
+
+#define SW_USB_STATUS     0x01
+#define SW_USB_HANDSHAKE  0x02
+#define SW_USB_HIGHSPEED  0x03
+#define SW_USB_NO_TIMEOUT 0x04
+
+#define SW_SUB_DEVICE_INFO   0x02
+#define SW_SUB_INPUT_MODE    0x03
+#define SW_SUB_SPI_READ      0x10
+#define SW_SUB_PLAYER_LIGHTS 0x30
+#define SW_SUB_HOME_LIGHT    0x38
+#define SW_SUB_IMU           0x40
+#define SW_SUB_VIBRATION     0x48
+
+#define SW_SPI_FACTORY_STICKS 0x603D    /* 2 x 9 bytes: left, right */
+#define SW_SPI_USER_STICKS    0x8010    /* B2 A1 + 9 bytes left @+2, B2 A1 + 9 bytes right @+0x0B */
+#define SW_SPI_FACTORY_IMU    0x6020    /* 24 bytes */
+#define SW_SPI_USER_IMU       0x8026    /* B2 A1 + 24 bytes */
+
+#define SW_OUT_MAX        128
+#define SW_IN_MAX         512
+
+/* Write pacing, from SDL: written to faster than every 30 ms a Bluetooth pad
+ * can drop the link (and over USB the motors miss commands), and a running
+ * rumble dies out unless re-sent about every 50 ms. The refresh asked of the
+ * pad host is 40 ms because its timer runs on the 15.6 ms system tick. */
+#define SW_MIN_GAP_MS         30
+#define SW_RUMBLE_REFRESH_MS  40
+
+/* Defaults for a stick whose calibration is missing or implausible. */
+#define SW_STICK_CENTER   2048
+#define SW_STICK_EXTENT   1400
+
+static const u8 sw_neutral_rumble[8] = { 0x00, 0x01, 0x40, 0x40, 0x00, 0x01, 0x40, 0x40 };
+
+/* ---------------------------------------------------------------------------
+ * State
+ * -----------------------------------------------------------------------*/
+
+typedef struct { s16 center, below, above; } SwAxisCal;     /* 12-bit raw; extents from centre */
+
+typedef struct {
+    SwAxisCal stick[2][2];          /* [left, right][x, y] */
+    float acc_off[3], acc_k[3];     /* G = (raw - off) * k */
+    float gyro_off[3], gyro_k[3];   /* deg/s = (raw - off) * k */
+    u8    usb, labels;
+    u8    imu_on, mode_set, vib_on;
+    u8    unresponsive, fails;
+    u8    counter;                  /* packet counter, 0..15 */
+    int   sent_port;                /* port shown on the player lights; SW_PORT_UNSENT before any */
+    unsigned long long last_write;  /* ms of the last output packet */
+    s32   simple_min[4], simple_max[4];     /* 0x3F stick extents seen, about 0x8000 */
+    u16   sensor[4];
+    u8    has_motion;
+    u8    battery;
+    u8    fw_major, fw_minor, dev_type;
+    char  cal_src[48];
+} SwPriv;
+
+#define SW_PORT_UNSENT (-100)
+
+#ifdef __cplusplus
+static_assert(sizeof(SwPriv) <= sizeof(((PadHostDevice*)0)->priv), "SwPriv too big");
+#else
+_Static_assert(sizeof(SwPriv) <= sizeof(((PadHostDevice*)0)->priv), "SwPriv too big");
+#endif
+
+static SwPriv* sw_priv(PadHostDevice* d) { return (SwPriv*)(void*)d->priv; }
+
+static unsigned long long sw_clock_default(void) { return (unsigned long long)GetTickCount64(); }
+static void sw_sleep_default(unsigned ms) { Sleep(ms); }
+static unsigned long long (*s_sw_clock)(void) = sw_clock_default;  /* tests substitute these */
+static void (*s_sw_sleep)(unsigned ms) = sw_sleep_default;
+
+/* ---------------------------------------------------------------------------
+ * Output packets
+ * -----------------------------------------------------------------------*/
+
+/* Amplitude 0..1 -> the 7-bit HD rumble amplitude code (0..100): the
+ * piecewise-logarithmic scale of the HD rumble amplitude table, as CTCaer's
+ * jc_toolkit encodes it (code 100 = amplitude 1.0, the safe maximum). */
+static int sw_amp_code(float a)
+{
+    if (!(a > 0.0f)) return 0;
+    if (a > 1.0f) a = 1.0f;
+    float e;
+    if (a > 0.23f)       e = log2f(a * 8.7f) * 32.0f;
+    else if (a > 0.12f)  e = log2f(a * 17.0f) * 16.0f;
+    else                 e = 16.0f + 4.0f * log2f(a / 0.112f);
+    float r = floorf(e + 0.5f);
+    int c = (int)r;
+    return c < 1 ? 1 : c > 100 ? 100 : c;
+}
+
+/* One actuator's 4 bytes at the neutral frequencies (high band 320 Hz,
+ * low band 160 Hz) with the given band amplitudes. Both codes 0 gives the
+ * neutral pattern 00 01 40 40. */
+static void sw_encode_rumble(u8 out[4], float hi_amp, float lo_amp)
+{
+    const int hf = 0x0100;          /* 320 Hz: (code 0xA0 - 0x60) * 4 */
+    const int lf = 0x40;            /* 160 Hz: code 0x80 - 0x40 */
+    int eh = sw_amp_code(hi_amp), el = sw_amp_code(lo_amp);
+    out[0] = (u8)(hf & 0xFF);
+    out[1] = (u8)((eh * 2) | ((hf >> 8) & 0x01));
+    out[2] = (u8)(lf | ((el & 1) << 7));
+    out[3] = (u8)(0x40 + el / 2);
+}
+
+/* PS3 motors -> both actuators: the large (0..255) drives the low band, the
+ * small one (on/off) the high band, the way SDL feeds low/high frequency
+ * rumble to this pad. */
+static void sw_rumble_bytes(u8 out[8], u8 small_motor, u8 large_motor)
+{
+    float lo = (float)large_motor / 255.0f;
+    float hi = small_motor ? 0.6f : 0.0f;
+    sw_encode_rumble(out, hi, lo);
+    memcpy(out + 4, out, 4);
+}
+
+static void sw_pkt_subcmd(u8* out, int n, u8 counter, const u8 rumble[8], u8 sub, const u8* args, int nargs)
+{
+    memset(out, 0, (size_t)n);
+    out[0] = SW_OUT_SUBCMD;
+    out[1] = (u8)(counter & 0x0F);
+    memcpy(out + 2, rumble, 8);
+    out[10] = sub;
+    if (nargs > 0 && 11 + nargs <= n) memcpy(out + 11, args, (size_t)nargs);
+}
+
+static void sw_pkt_rumble(u8* out, int n, u8 counter, const u8 rumble[8])
+{
+    memset(out, 0, (size_t)n);
+    out[0] = SW_OUT_RUMBLE;
+    out[1] = (u8)(counter & 0x0F);
+    memcpy(out + 2, rumble, 8);
+}
+
+/* Player lights for a PS3 port, numbered as a DUALSHOCK 3 shows it (the pad
+ * host's mask: ports 1-4 one light each, 5-7 the fourth light plus light
+ * 1-3). Subcommand 0x30's low nibble = lights on, high nibble = flashing. */
+static u8 sw_port_lights(int port)
+{
+    return (u8)(padhost_port_led_mask(port) & 0x0F);
+}
+
+/* HOME ring at a steady intensity (0..15); 0 = off. */
+static void sw_home_light_args(u8 args[4], int intensity)
+{
+    if (intensity < 0) intensity = 0;
+    if (intensity > 15) intensity = 15;
+    args[0] = 0x01;                         /* no mini cycles, 8 ms base */
+    args[1] = (u8)(intensity << 4);         /* start intensity, repeat forever */
+    args[2] = (u8)(intensity << 4);         /* first cycle intensity */
+    args[3] = 0x00;
+}
+
+static int sw_out_len(const PadHostDevice* d, const SwPriv* p)
+{
+    int n = d->out_len > 0 ? d->out_len : (p->usb ? 64 : 49);
+    return n > SW_OUT_MAX ? SW_OUT_MAX : n;
+}
+
+static int sw_in_cap(const PadHostDevice* d)
+{
+    return (d->in_len > 0 && d->in_len <= SW_IN_MAX) ? d->in_len : SW_IN_MAX;
+}
+
+/* ---------------------------------------------------------------------------
+ * Commands with replies (open() only: the reader thread is not running yet)
+ * -----------------------------------------------------------------------*/
+
+static int sw_write(PadHostDevice* d, SwPriv* p, const u8* out, int n)
+{
+    p->last_write = s_sw_clock();
+    return padhost_dev_write(d, out, n);
+}
+
+/* Read until a report satisfying want() arrives or timeout_ms passes. */
+static int sw_wait(PadHostDevice* d, u8* in, int cap, int timeout_ms,
+                   int (*want)(const u8* in, int len, int arg), int arg)
+{
+    unsigned long long deadline = s_sw_clock() + (unsigned long long)timeout_ms;
+    for (;;) {
+        unsigned long long now = s_sw_clock();
+        if (now >= deadline) return -1;
+        int got = padhost_dev_read(d, in, cap, (int)(deadline - now));
+        if (got <= 0) return -1;
+        if (want(in, got, arg)) return got;
+    }
+}
+
+static int sw_want_usb_reply(const u8* in, int len, int cmd)
+{
+    return len >= 2 && in[0] == SW_IN_USB_REPLY && in[1] == (u8)cmd;
+}
+
+static int sw_want_subcmd_reply(const u8* in, int len, int sub)
+{
+    return len >= 15 && in[0] == SW_IN_REPLY && in[14] == (u8)sub;
+}
+
+static int sw_usb_cmd(PadHostDevice* d, SwPriv* p, u8 cmd, int wait_reply)
+{
+    u8 out[SW_OUT_MAX], in[SW_IN_MAX];
+    int n = sw_out_len(d, p);
+    memset(out, 0, sizeof out);
+    out[0] = SW_OUT_USB;
+    out[1] = cmd;
+    if (sw_write(d, p, out, n) < 0) return -1;
+    if (!wait_reply) return 0;
+    return sw_wait(d, in, sw_in_cap(d), 100, sw_want_usb_reply, cmd) > 0 ? 0 : -1;
+}
+
+/* Send a subcommand and wait for its acknowledged 0x21 reply (copied to
+ * reply, which must hold the input report length). The reply paces the next
+ * write, as in SDL. Three tries, one once the pad has ignored two
+ * subcommands in a row (a clone that does not speak this part of the
+ * protocol should not stall bring-up for seconds). */
+static int sw_subcmd(PadHostDevice* d, SwPriv* p, u8 sub, const u8* args, int nargs, u8* reply)
+{
+    u8 out[SW_OUT_MAX];
+    u8 in[SW_IN_MAX];
+    int n = sw_out_len(d, p), cap = sw_in_cap(d);
+    int tries = p->unresponsive ? 1 : 3;
+    for (int t = 0; t < tries; t++) {
+        sw_pkt_subcmd(out, n, p->counter, sw_neutral_rumble, sub, args, nargs);
+        p->counter = (u8)((p->counter + 1) & 0x0F);
+        if (sw_write(d, p, out, n) < 0) return -1;
+        int got = sw_wait(d, in, cap, p->usb ? 100 : 150, sw_want_subcmd_reply, sub);
+        if (got > 0 && (in[13] & 0x80)) {
+            if (reply) { memset(reply, 0, (size_t)cap); memcpy(reply, in, (size_t)got); }
+            p->fails = 0;
+            return 0;
+        }
+    }
+    if (++p->fails >= 2) p->unresponsive = 1;
+    return -1;
+}
+
+static int sw_spi_read(PadHostDevice* d, SwPriv* p, u32 addr, int len, u8* out)
+{
+    u8 args[5] = { (u8)addr, (u8)(addr >> 8), (u8)(addr >> 16), (u8)(addr >> 24), (u8)len };
+    u8 r[SW_IN_MAX];
+    if (len < 1 || len > 0x1D) return -1;
+    if (sw_subcmd(d, p, SW_SUB_SPI_READ, args, 5, r) != 0) return -1;
+    u32 got = (u32)r[15] | ((u32)r[16] << 8) | ((u32)r[17] << 16) | ((u32)r[18] << 24);
+    if (got != addr || r[19] != (u8)len) return -1;
+    memcpy(out, r + 20, (size_t)len);
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Calibration
+ * -----------------------------------------------------------------------*/
+
+/* Nine bytes = six 12-bit values, packed little-endian in pairs. */
+static void sw_unpack12(const u8* c, u16 v[6])
+{
+    for (int i = 0; i < 3; i++) {
+        const u8* q = c + i * 3;
+        v[i * 2]     = (u16)(q[0] | ((q[1] & 0x0F) << 8));
+        v[i * 2 + 1] = (u16)((q[1] >> 4) | (q[2] << 4));
+    }
+}
+
+static int sw_axis_cal_ok(const SwAxisCal* a)
+{
+    return a->center >= 1024 && a->center <= 3072 &&
+           a->below >= 512 && a->below <= 2047 && a->above >= 512 && a->above <= 2047;
+}
+
+/* The two sticks store their values in different orders:
+ *   left:  X above, Y above, X centre, Y centre, X below, Y below
+ *   right: X centre, Y centre, X below, Y below, X above, Y above
+ * Returns 1 when the stick's values are plausible (and stores them). */
+static int sw_decode_stick(SwPriv* p, int stick, const u8* c9)
+{
+    u16 v[6];
+    SwAxisCal a[2];
+    sw_unpack12(c9, v);
+    for (int ax = 0; ax < 2; ax++) {
+        if (stick == 0) { a[ax].above = (s16)v[ax]; a[ax].center = (s16)v[2 + ax]; a[ax].below = (s16)v[4 + ax]; }
+        else            { a[ax].center = (s16)v[ax]; a[ax].below = (s16)v[2 + ax]; a[ax].above = (s16)v[4 + ax]; }
+        if (!sw_axis_cal_ok(&a[ax])) return 0;
+    }
+    p->stick[stick][0] = a[0];
+    p->stick[stick][1] = a[1];
+    return 1;
+}
+
+static void sw_default_cal(SwPriv* p)
+{
+    for (int s = 0; s < 2; s++)
+        for (int ax = 0; ax < 2; ax++) {
+            p->stick[s][ax].center = SW_STICK_CENTER;
+            p->stick[s][ax].below = p->stick[s][ax].above = SW_STICK_EXTENT;
+        }
+    for (int i = 0; i < 3; i++) {
+        p->acc_off[i] = 0.0f;  p->acc_k[i] = 4.0f / 16384.0f;     /* +-8 G: 4096 per G */
+        p->gyro_off[i] = 0.0f; p->gyro_k[i] = 936.0f / 13371.0f;  /* +-2000 deg/s */
+    }
+}
+
+static s16 sw_le16(const u8* b) { return (s16)(u16)(b[0] | (b[1] << 8)); }
+
+/* 24 bytes: accel origin XYZ, accel sensitivity XYZ, gyro origin XYZ, gyro
+ * sensitivity XYZ (int16 LE; nominal sensitivities 16384 and 13371). Applied
+ * as Linux hid-nintendo does: divide by (sensitivity - origin). */
+static int sw_decode_imu(SwPriv* p, const u8* c)
+{
+    float ao[3], as[3], go[3], gs[3];
+    for (int i = 0; i < 3; i++) {
+        ao[i] = sw_le16(c + i * 2);      as[i] = sw_le16(c + 6 + i * 2);
+        go[i] = sw_le16(c + 12 + i * 2); gs[i] = sw_le16(c + 18 + i * 2);
+        if (fabsf(ao[i]) > 2000.0f || as[i] < 12000.0f || as[i] > 20000.0f) return 0;
+        if (fabsf(go[i]) > 2000.0f || gs[i] < 10000.0f || gs[i] > 17000.0f) return 0;
+    }
+    for (int i = 0; i < 3; i++) {
+        p->acc_off[i] = ao[i];  p->acc_k[i] = 4.0f / (as[i] - ao[i]);
+        p->gyro_off[i] = go[i]; p->gyro_k[i] = 936.0f / (gs[i] - go[i]);
+    }
+    return 1;
+}
+
+static void sw_load_calibration(PadHostDevice* d, SwPriv* p)
+{
+    u8 f[0x12], u[0x16], imu[0x1A];
+    const char* src[2] = { "default", "default" };
+    if (sw_spi_read(d, p, SW_SPI_FACTORY_STICKS, 0x12, f) == 0) {
+        if (sw_decode_stick(p, 0, f))     src[0] = "factory";
+        if (sw_decode_stick(p, 1, f + 9)) src[1] = "factory";
+    }
+    if (sw_spi_read(d, p, SW_SPI_USER_STICKS, 0x16, u) == 0) {
+        if (u[0] == 0xB2 && u[1] == 0xA1 && sw_decode_stick(p, 0, u + 2))       src[0] = "user";
+        if (u[0x0B] == 0xB2 && u[0x0C] == 0xA1 && sw_decode_stick(p, 1, u + 0x0D)) src[1] = "user";
+    }
+    const char* isrc = "default";
+    if (sw_spi_read(d, p, SW_SPI_FACTORY_IMU, 0x18, imu) == 0 && sw_decode_imu(p, imu)) isrc = "factory";
+    if (sw_spi_read(d, p, SW_SPI_USER_IMU, 0x1A, imu) == 0 && imu[0] == 0xB2 && imu[1] == 0xA1 &&
+        sw_decode_imu(p, imu + 2)) isrc = "user";
+    snprintf(p->cal_src, sizeof p->cal_src, "sticks %s/%s, IMU %s", src[0], src[1], isrc);
+}
+
+/* ---------------------------------------------------------------------------
+ * Input
+ * -----------------------------------------------------------------------*/
+
+enum {
+    SWB_A = 1 << 0, SWB_B = 1 << 1, SWB_X = 1 << 2, SWB_Y = 1 << 3,
+    SWB_L = 1 << 4, SWB_R = 1 << 5, SWB_ZL = 1 << 6, SWB_ZR = 1 << 7,
+    SWB_MINUS = 1 << 8, SWB_PLUS = 1 << 9, SWB_LS = 1 << 10, SWB_RS = 1 << 11,
+    SWB_HOME = 1 << 12, SWB_CAPTURE = 1 << 13,
+    SWB_UP = 1 << 14, SWB_DOWN = 1 << 15, SWB_LEFT = 1 << 16, SWB_RIGHT = 1 << 17,
+};
+
+/* -1..1 -> 0..255, centre 128 */
+static u8 sw_n_to_u8(float n)
+{
+    if (n > 1.0f) n = 1.0f;
+    if (n < -1.0f) n = -1.0f;
+    float f = n >= 0.0f ? 128.0f + floorf(n * 127.0f + 0.5f)
+                        : 128.0f - floorf(-n * 128.0f + 0.5f);
+    int v = (int)f;
+    return (u8)(v < 0 ? 0 : v > 255 ? 255 : v);
+}
+
+/* 12-bit raw -> PS3 0..255 through the calibration. invert: the Switch's Y
+ * grows upward, the PS3's downward. */
+static u8 sw_stick_u8(const SwAxisCal* c, int raw, int invert)
+{
+    int dv = raw - c->center;
+    float n = dv >= 0 ? (float)dv / (float)c->above : (float)dv / (float)c->below;
+    return sw_n_to_u8(invert ? -n : n);
+}
+
+static u16 sw_clamp10(float v)
+{
+    float f = floorf(v + 0.5f);
+    int i = (int)f;
+    return (u16)(i < 0 ? 0 : i > 1023 ? 1023 : i);
+}
+
+/* Three IMU samples (36 bytes at report offset 13), averaged, to SIXAXIS
+ * units. The Switch IMU axes are X forward, Y left, Z up; turned into the
+ * PlayStation convention (X right, Y up, Z toward the player) the way SDL
+ * does, then to DUALSHOCK 3 counts the way RPCS3 converts a DS4: accel
+ * 512 - 113 per G, gyro (yaw) 512 - 123 per 90 deg/s. A pad lying flat reads
+ * x 512, y 399, z 512, g 512. */
+static int sw_parse_imu(SwPriv* p, const u8* imu)
+{
+    float acc[3] = { 0, 0, 0 }, gyr[3] = { 0, 0, 0 };
+    int nonzero = 0;
+    for (int s = 0; s < 3; s++)
+        for (int i = 0; i < 3; i++) {
+            s16 a = sw_le16(imu + s * 12 + i * 2), g = sw_le16(imu + s * 12 + 6 + i * 2);
+            nonzero |= a | g;
+            acc[i] += ((float)a - p->acc_off[i]) * p->acc_k[i];
+            gyr[i] += ((float)g - p->gyro_off[i]) * p->gyro_k[i];
+        }
+    if (!nonzero) return 0;         /* a clone without an IMU */
+    for (int i = 0; i < 3; i++) { acc[i] /= 3.0f; gyr[i] /= 3.0f; }
+    p->sensor[0] = sw_clamp10(512.0f + 113.0f * acc[1]);
+    p->sensor[1] = sw_clamp10(512.0f - 113.0f * acc[2]);
+    p->sensor[2] = sw_clamp10(512.0f + 113.0f * acc[0]);
+    p->sensor[3] = sw_clamp10(512.0f - gyr[2] * (123.0f / 90.0f));
+    return 1;
+}
+
+/* Battery nibble: level 0/2/4/6/8 in bits 7-5, bit 4 charging. */
+static u8 sw_battery_pct(u8 b)
+{
+    if (b == 0) return 255;         /* clones that leave it zero */
+    int level = (b >> 5) & 7;
+    return (u8)(level >= 4 ? 100 : level * 25);
+}
+
+static void sw_fill_state(PadHostDevice* d, SwPriv* p, u32 sb, const u8 sticks[4], PadHostPortState* st)
+{
+    u16 b = 0;
+    if (p->labels) {
+        if (sb & SWB_A) b |= CELL_PAD_CTRL_CROSS;
+        if (sb & SWB_B) b |= CELL_PAD_CTRL_CIRCLE;
+        if (sb & SWB_X) b |= CELL_PAD_CTRL_SQUARE;
+        if (sb & SWB_Y) b |= CELL_PAD_CTRL_TRIANGLE;
+    } else {
+        if (sb & SWB_B) b |= CELL_PAD_CTRL_CROSS;
+        if (sb & SWB_A) b |= CELL_PAD_CTRL_CIRCLE;
+        if (sb & SWB_Y) b |= CELL_PAD_CTRL_SQUARE;
+        if (sb & SWB_X) b |= CELL_PAD_CTRL_TRIANGLE;
+    }
+    if (sb & SWB_L)  b |= CELL_PAD_CTRL_L1;
+    if (sb & SWB_R)  b |= CELL_PAD_CTRL_R1;
+    if (sb & SWB_ZL) b |= CELL_PAD_CTRL_L2;
+    if (sb & SWB_ZR) b |= CELL_PAD_CTRL_R2;
+    if (sb & (SWB_MINUS | SWB_CAPTURE)) b |= CELL_PAD_CTRL_SELECT;
+    if (sb & SWB_PLUS) b |= CELL_PAD_CTRL_START;
+    if (sb & SWB_LS) b |= CELL_PAD_CTRL_L3;
+    if (sb & SWB_RS) b |= CELL_PAD_CTRL_R3;
+    if (sb & SWB_UP)    b |= CELL_PAD_CTRL_UP;
+    if (sb & SWB_DOWN)  b |= CELL_PAD_CTRL_DOWN;
+    if (sb & SWB_LEFT)  b |= CELL_PAD_CTRL_LEFT;
+    if (sb & SWB_RIGHT) b |= CELL_PAD_CTRL_RIGHT;
+
+    st->connected = 1;
+    st->kind = PADHOST_KIND_SWITCH_PRO;
+    st->bus = d->bus;
+    st->vid = d->vid;
+    st->pid = d->pid;
+    st->buttons = b;
+    st->ps = (sb & SWB_HOME) ? 1 : 0;
+    st->lx = sticks[0]; st->ly = sticks[1]; st->rx = sticks[2]; st->ry = sticks[3];
+    static const u16 press_bit[12] = {
+        CELL_PAD_CTRL_RIGHT, CELL_PAD_CTRL_LEFT, CELL_PAD_CTRL_UP, CELL_PAD_CTRL_DOWN,
+        CELL_PAD_CTRL_TRIANGLE, CELL_PAD_CTRL_CIRCLE, CELL_PAD_CTRL_CROSS, CELL_PAD_CTRL_SQUARE,
+        CELL_PAD_CTRL_L1, CELL_PAD_CTRL_R1, CELL_PAD_CTRL_L2, CELL_PAD_CTRL_R2 };
+    for (int i = 0; i < 12; i++) st->press[i] = (b & press_bit[i]) ? 255 : 0;
+    st->has_pressure = 0;
+    st->has_motion = p->has_motion;
+    if (p->has_motion) {
+        st->sensor_x = p->sensor[0]; st->sensor_y = p->sensor[1];
+        st->sensor_z = p->sensor[2]; st->sensor_g = p->sensor[3];
+    } else {
+        st->sensor_x = PADHOST_SENSOR_NEUTRAL_X; st->sensor_y = PADHOST_SENSOR_NEUTRAL_Y;
+        st->sensor_z = PADHOST_SENSOR_NEUTRAL_Z; st->sensor_g = PADHOST_SENSOR_NEUTRAL_G;
+    }
+    st->battery = p->battery;
+}
+
+/* Bytes 2..11 of 0x30 / 0x21: battery, buttons, sticks. */
+static void sw_parse_standard(PadHostDevice* d, SwPriv* p, const u8* rep, PadHostPortState* st)
+{
+    u8 r = rep[3], s = rep[4], l = rep[5];
+    u32 sb = 0;
+    if (r & 0x01) sb |= SWB_Y;      if (r & 0x02) sb |= SWB_X;
+    if (r & 0x04) sb |= SWB_B;      if (r & 0x08) sb |= SWB_A;
+    if (r & 0x40) sb |= SWB_R;      if (r & 0x80) sb |= SWB_ZR;
+    if (s & 0x01) sb |= SWB_MINUS;  if (s & 0x02) sb |= SWB_PLUS;
+    if (s & 0x04) sb |= SWB_RS;     if (s & 0x08) sb |= SWB_LS;
+    if (s & 0x10) sb |= SWB_HOME;   if (s & 0x20) sb |= SWB_CAPTURE;
+    if (l & 0x01) sb |= SWB_DOWN;   if (l & 0x02) sb |= SWB_UP;
+    if (l & 0x04) sb |= SWB_RIGHT;  if (l & 0x08) sb |= SWB_LEFT;
+    if (l & 0x40) sb |= SWB_L;      if (l & 0x80) sb |= SWB_ZL;
+
+    int lx = rep[6] | ((rep[7] & 0x0F) << 8), ly = (rep[7] >> 4) | (rep[8] << 4);
+    int rx = rep[9] | ((rep[10] & 0x0F) << 8), ry = (rep[10] >> 4) | (rep[11] << 4);
+    u8 sticks[4] = {
+        sw_stick_u8(&p->stick[0][0], lx, 0), sw_stick_u8(&p->stick[0][1], ly, 1),
+        sw_stick_u8(&p->stick[1][0], rx, 0), sw_stick_u8(&p->stick[1][1], ry, 1) };
+    p->battery = sw_battery_pct(rep[2]);
+    sw_fill_state(d, p, sb, sticks, st);
+}
+
+/* The 0x3F sticks have no calibration: their range is learned. Start at
+ * half the u16 span about 0x8000 (so a stick reaches full deflection
+ * straight away) and widen to whatever the stick is seen to reach, as SDL
+ * does for this report. */
+static u8 sw_simple_axis(SwPriv* p, int i, u16 raw, int invert)
+{
+    s32 dv = (s32)raw - 0x8000;
+    if (dv > p->simple_max[i]) p->simple_max[i] = dv;
+    if (dv < p->simple_min[i]) p->simple_min[i] = dv;
+    float n = dv >= 0 ? (float)dv / (float)p->simple_max[i] : (float)dv / (float)-p->simple_min[i];
+    if (dv == 0) n = 0.0f;
+    return sw_n_to_u8(invert ? -n : n);
+}
+
+static void sw_parse_simple(PadHostDevice* d, SwPriv* p, const u8* rep, PadHostPortState* st)
+{
+    static const u32 hat[8] = { SWB_UP, SWB_UP | SWB_RIGHT, SWB_RIGHT, SWB_DOWN | SWB_RIGHT,
+                                SWB_DOWN, SWB_DOWN | SWB_LEFT, SWB_LEFT, SWB_UP | SWB_LEFT };
+    u8 b0 = rep[1], b1 = rep[2];
+    u32 sb = 0;
+    if (b0 & 0x01) sb |= SWB_B;     if (b0 & 0x02) sb |= SWB_A;
+    if (b0 & 0x04) sb |= SWB_Y;     if (b0 & 0x08) sb |= SWB_X;
+    if (b0 & 0x10) sb |= SWB_L;     if (b0 & 0x20) sb |= SWB_R;
+    if (b0 & 0x40) sb |= SWB_ZL;    if (b0 & 0x80) sb |= SWB_ZR;
+    if (b1 & 0x01) sb |= SWB_MINUS; if (b1 & 0x02) sb |= SWB_PLUS;
+    if (b1 & 0x04) sb |= SWB_LS;    if (b1 & 0x08) sb |= SWB_RS;
+    if (b1 & 0x10) sb |= SWB_HOME;  if (b1 & 0x20) sb |= SWB_CAPTURE;
+    if (rep[3] < 8) sb |= hat[rep[3]];
+    u8 sticks[4];
+    for (int i = 0; i < 4; i++)
+        sticks[i] = sw_simple_axis(p, i, (u16)(rep[4 + i * 2] | (rep[5 + i * 2] << 8)), 0);
+    sw_fill_state(d, p, sb, sticks, st);
+}
+
+/* ---------------------------------------------------------------------------
+ * Driver
+ * -----------------------------------------------------------------------*/
+
+static int sw_match(const PadHostDevice* d)
+{
+    if (d->vid != SW_VID_NINTENDO || d->pid != SW_PID_PRO) return 0;
+    if (d->usage_page && !(d->usage_page == 0x01 && (d->usage == 0x04 || d->usage == 0x05))) return 0;
+    return 100;
+}
+
+static int sw_cfg_labels(void)
+{
+    const char* v = padhost_config_get("switch_layout");
+    if (!v) return 0;
+    while (*v == ' ' || *v == '\t') v++;
+    char c = (char)(v[0] | 0x20);
+    return c == 'l' || c == 'x';    /* "label(s)", "letter(s)", "xbox" */
+}
+
+static int sw_cfg_home_light(void)
+{
+    const char* v = padhost_config_get("switch_home_led");
+    int pct = v ? atoi(v) : 40;
+    if (pct <= 0) return 0;
+    if (pct > 100) pct = 100;
+    return (pct * 15 + 99) / 100;
+}
+
+static int sw_open(PadHostDevice* d)
+{
+    SwPriv* p = sw_priv(d);
+    memset(p, 0, sizeof *p);
+    p->sent_port = SW_PORT_UNSENT;
+    p->battery = 255;
+    for (int i = 0; i < 4; i++) { p->simple_max[i] = 0x4000; p->simple_min[i] = -0x4000; }
+    p->labels = (u8)sw_cfg_labels();
+    sw_default_cal(p);
+
+    /* The USB handshake doubles as the bus test when the host could not tell:
+     * a Bluetooth pad never answers 0x80 commands. */
+    if (d->bus == PADHOST_BUS_USB) p->usb = 1;
+    else if (d->bus == PADHOST_BUS_OTHER) p->usb = sw_usb_cmd(d, p, SW_USB_STATUS, 1) == 0;
+    if (p->usb) {
+        if (d->bus == PADHOST_BUS_USB) sw_usb_cmd(d, p, SW_USB_STATUS, 1);
+        /* Clones (8BitDo M30/SF30 Pro) ignore some of these and work anyway. */
+        sw_usb_cmd(d, p, SW_USB_HANDSHAKE, 1);
+        sw_usb_cmd(d, p, SW_USB_HIGHSPEED, 1);
+        sw_usb_cmd(d, p, SW_USB_HANDSHAKE, 1);
+        sw_usb_cmd(d, p, SW_USB_NO_TIMEOUT, 0);
+    }
+
+    u8 r[SW_IN_MAX];
+    if (sw_subcmd(d, p, SW_SUB_DEVICE_INFO, NULL, 0, r) == 0) {
+        p->fw_major = r[15]; p->fw_minor = r[16]; p->dev_type = r[17];
+        /* The Bluetooth address (big-endian at 19..24) is the pad's identity
+         * on both buses -- over USB every Pro Controller has the same serial
+         * string -- so it keeps its port across a USB <-> Bluetooth switch. */
+        const u8* m = r + 19;
+        if (m[0] | m[1] | m[2] | m[3] | m[4] | m[5])
+            snprintf(d->serial, sizeof d->serial, "%02x%02x%02x%02x%02x%02x", m[0], m[1], m[2], m[3], m[4], m[5]);
+    }
+    sw_load_calibration(d, p);
+
+    u8 on = 1, mode = SW_IN_FULL;
+    p->vib_on = sw_subcmd(d, p, SW_SUB_VIBRATION, &on, 1, NULL) == 0;
+    p->imu_on = sw_subcmd(d, p, SW_SUB_IMU, &on, 1, NULL) == 0;
+    p->mode_set = sw_subcmd(d, p, SW_SUB_INPUT_MODE, &mode, 1, NULL) == 0;
+
+    /* The port comes after open(); until then the lights are off rather than
+     * the pad's "searching" sweep, and the first build_output() sets them. */
+    u8 lights = sw_port_lights(d->port);
+    if (sw_subcmd(d, p, SW_SUB_PLAYER_LIGHTS, &lights, 1, NULL) == 0) p->sent_port = d->port;
+    u8 home[4];
+    sw_home_light_args(home, sw_cfg_home_light());
+    sw_subcmd(d, p, SW_SUB_HOME_LIGHT, home, 4, NULL);
+    d->out_refresh_ms = SW_RUMBLE_REFRESH_MS;
+
+    char fw[32];
+    if (p->fw_major || p->fw_minor) snprintf(fw, sizeof fw, "firmware %X.%02X", p->fw_major, p->fw_minor);
+    else snprintf(fw, sizeof fw, "no device info");
+    padhost_logf("switch pro %04X:%04X %s: %s, %s, %s, rumble %s, face buttons by %s",
+                 d->vid, d->pid, p->usb ? "USB" : "Bluetooth", fw, p->cal_src,
+                 p->mode_set ? "full reports (0x30)" : "simple reports (0x3F) only",
+                 p->vib_on ? "on" : "unconfirmed", p->labels ? "label" : "position");
+    return 0;
+}
+
+static int sw_parse(PadHostDevice* d, const unsigned char* rep, int len, PadHostPortState* st)
+{
+    SwPriv* p = sw_priv(d);
+    if (len < 1) return 0;
+    switch (rep[0]) {
+    case SW_IN_FULL:
+        if (len < 13) return 0;
+        if (len >= 49) p->has_motion = (u8)(p->imu_on && sw_parse_imu(p, rep + 13));
+        sw_parse_standard(d, p, rep, st);
+        d->streams = 1;             /* 0x30 comes every 8 / 15 ms */
+        return 1;
+    case SW_IN_REPLY:
+        if (len < 13) return 0;
+        sw_parse_standard(d, p, rep, st);
+        return 1;
+    case SW_IN_SIMPLE:
+        if (len < 12) return 0;
+        sw_parse_simple(d, p, rep, st);
+        d->streams = 0;             /* 0x3F is sent on change only */
+        return 1;
+    default:
+        return 0;   /* 0x81 handshake replies, NFC/IR modes */
+    }
+}
+
+/* The pad host calls this when the port or the motors changed, and every
+ * out_refresh_ms while a motor runs; each call that returns a packet gets it
+ * written. The player lights go out (in an 0x01 packet that carries the
+ * rumble too) when the port changed, else an 0x10 rumble packet. A motor
+ * change that comes within SW_MIN_GAP_MS of the previous packet is skipped:
+ * the motors are running, so the next refresh, at most out_refresh_ms away,
+ * sends the values current then. A stop is never skipped. */
+static int sw_build_output(PadHostDevice* d, u8 small_motor, u8 large_motor, int port,
+                           unsigned char* out, int cap)
+{
+    SwPriv* p = sw_priv(d);
+    int n = sw_out_len(d, p);
+    if (n > cap) n = cap;
+    if (n < 12) return 0;
+    unsigned long long now = s_sw_clock();
+    int lights_due = port != p->sent_port;
+    int stop = !small_motor && !large_motor;
+    if (!lights_due && !stop && p->last_write && now - p->last_write < SW_MIN_GAP_MS) return 0;
+
+    u8 rum[8];
+    sw_rumble_bytes(rum, small_motor, large_motor);
+    if (lights_due) {
+        u8 lights = sw_port_lights(port);
+        sw_pkt_subcmd(out, n, p->counter, rum, SW_SUB_PLAYER_LIGHTS, &lights, 1);
+        p->sent_port = port;
+    } else {
+        sw_pkt_rumble(out, n, p->counter, rum);
+    }
+    p->counter = (u8)((p->counter + 1) & 0x0F);
+    p->last_write = now;
+    return n;
+}
+
+/* Motors off, HOME ring and player lights off, and back to the simple 0x3F
+ * report other programs expect. Writes only (the pad host may be on its
+ * ExitProcess path), paced so a Bluetooth pad takes all four. */
+static void sw_close(PadHostDevice* d)
+{
+    SwPriv* p = sw_priv(d);
+    u8 out[SW_OUT_MAX];
+    int n = sw_out_len(d, p);
+    unsigned gap = p->usb ? 8 : SW_MIN_GAP_MS;
+
+    sw_pkt_rumble(out, n, p->counter, sw_neutral_rumble);
+    p->counter = (u8)((p->counter + 1) & 0x0F);
+    sw_write(d, p, out, n);
+
+    u8 home[4];
+    sw_home_light_args(home, 0);
+    s_sw_sleep(gap);
+    sw_pkt_subcmd(out, n, p->counter, sw_neutral_rumble, SW_SUB_HOME_LIGHT, home, 4);
+    p->counter = (u8)((p->counter + 1) & 0x0F);
+    sw_write(d, p, out, n);
+
+    u8 lights = 0;
+    s_sw_sleep(gap);
+    sw_pkt_subcmd(out, n, p->counter, sw_neutral_rumble, SW_SUB_PLAYER_LIGHTS, &lights, 1);
+    p->counter = (u8)((p->counter + 1) & 0x0F);
+    sw_write(d, p, out, n);
+
+    if (p->mode_set) {
+        u8 mode = SW_IN_SIMPLE;
+        s_sw_sleep(gap);
+        sw_pkt_subcmd(out, n, p->counter, sw_neutral_rumble, SW_SUB_INPUT_MODE, &mode, 1);
+        p->counter = (u8)((p->counter + 1) & 0x0F);
+        sw_write(d, p, out, n);
+    }
+}
+
+const PadHostDriver padhost_drv_switchpro = {
+    "Switch Pro", PADHOST_KIND_SWITCH_PRO,
+    sw_match, sw_open, sw_parse, sw_build_output, sw_close,
+};
+
+#else  /* HID access is Windows-only here (the SDL2 backend serves other hosts) */
+typedef int pad_hid_switch_windows_only;   /* ISO C: a translation unit declares something */
+#endif /* _WIN32 */
diff --git a/libs/input/pad_host.h b/libs/input/pad_host.h
new file mode 100644
index 0000000..efda69c
--- /dev/null
+++ b/libs/input/pad_host.h
@@ -0,0 +1,302 @@
+/*
+ * ps3recomp - host game controllers -> PS3 pad ports
+ *
+ * The device manager behind cellPad on Windows: finds the physical controllers
+ * (XInput slots and HID game controllers), gives each a PS3 pad port, runs one
+ * reader thread per HID device and keeps the latest state of every port in a
+ * snapshot that cellPadGetData can copy without ever touching a driver.
+ *
+ *   cellPad.c                    pad_host_win.c                 drivers
+ *   ---------                    --------------                 -------
+ *   padhost_get(port)  <-------  per-port snapshot  <--------   parse()      (reader thread)
+ *   padhost_set_actuator ------> wanted motors ---- wake ---->  build_output (reader thread)
+ *   padhost_generation <-------  port assignment changes
+ *
+ * Drivers (libs/input/pad_hid_*.c) translate one controller
+ * family's reports into PadHostPortState, in PS3 conventions, and build its
+ * output reports (rumble, lightbar, player LEDs). They never see threads,
+ * handles or ports beyond what is passed in: every call into a driver for a
+ * given device comes from that device's own thread, so priv[] needs no lock.
+ *
+ * Driver rules:
+ *   - parse() gets the device's previous RAW state (neutral before the first
+ *     report: sticks 128, sensors neutral, battery 255), so a report that
+ *     carries only part of the state may update only that part. Report raw
+ *     stick values: the manager applies the user's radial deadzone itself.
+ *     It also fills connected/kind/bus/vid/pid/seq; the driver need not.
+ *     Returns 1 = state updated, 0 = nothing (other report id, ...), -1 = a
+ *     receiver with no controller behind it right now (the DS4 USB wireless
+ *     adapter): its port is released until parse() returns 1 again.
+ *   - padhost_dev_read() is for open() and close(); while the read loop runs
+ *     it owns the input stream.
+ *   - On Windows a HID read always returns in_len bytes: shorter reports are
+ *     zero-padded to the longest input report, report id in rep[0].
+ *   - build_output() returns one output report (rep[0] = report id) that the
+ *     manager writes with padhost_dev_write(), or 0. port is 0..6, always a
+ *     real port (a device without a port gets no output at all).
+ *   - close() turns motors off and releases LEDs. It can run on the
+ *     ExitProcess path with every other thread already gone: it must not wait
+ *     for other threads, create threads or print.
+ *
+ * The non-Windows build gets stubs (nothing connected), so drivers that call
+ * the helpers still link; cellPad keeps its SDL2 backend there.
+ */
+
+#ifndef PS3RECOMP_PAD_HOST_H
+#define PS3RECOMP_PAD_HOST_H
+
+#include "ps3emu/ps3types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PADHOST_MAX_PORTS 7
+
+enum {
+    PADHOST_KIND_NONE,
+    PADHOST_KIND_XINPUT,
+    PADHOST_KIND_DS3,
+    PADHOST_KIND_DS4,
+    PADHOST_KIND_DUALSENSE,
+    PADHOST_KIND_SWITCH_PRO,
+    PADHOST_KIND_GENERIC,
+    PADHOST_KIND_COUNT
+};
+
+enum { PADHOST_BUS_USB, PADHOST_BUS_BT, PADHOST_BUS_OTHER };
+
+/* press[] indices -- the order of the PS3 pressure words (button[8..19]). */
+enum {
+    PADHOST_PRESS_RIGHT, PADHOST_PRESS_LEFT, PADHOST_PRESS_UP, PADHOST_PRESS_DOWN,
+    PADHOST_PRESS_TRIANGLE, PADHOST_PRESS_CIRCLE, PADHOST_PRESS_CROSS, PADHOST_PRESS_SQUARE,
+    PADHOST_PRESS_L1, PADHOST_PRESS_R1, PADHOST_PRESS_L2, PADHOST_PRESS_R2,
+    PADHOST_PRESS_COUNT
+};
+
+/* Sixaxis words of a pad lying still and flat -- the values cellPad has
+ * always reported, and what a port without motion sensors reads. */
+#define PADHOST_SENSOR_NEUTRAL_X 512
+#define PADHOST_SENSOR_NEUTRAL_Y 399
+#define PADHOST_SENSOR_NEUTRAL_Z 512
+#define PADHOST_SENSOR_NEUTRAL_G 512
+
+typedef struct {            /* one port's latest state, PS3 conventions */
+    int connected, kind, bus; u16 vid, pid;
+    u16 buttons;            /* CELL_PAD_CTRL_* packed (DIGITAL2<<8)|DIGITAL1, as cellPad.c's PadHostState */
+    u8  ps;                 /* PS / Guide / Home pressed */
+    u8  lx, ly, rx, ry;     /* 0..255, 128 centre, up = 0 */
+    u8  press[12];          /* right,left,up,down,triangle,circle,cross,square,l1,r1,l2,r2: 0..255; analog triggers carry their value; buttons without pressure read 255 when down */
+    u8  has_pressure, has_motion;
+    u16 sensor_x, sensor_y, sensor_z, sensor_g;  /* PS3 SIXAXIS units, 10-bit, 512 = zero; neutral defaults when !has_motion */
+    u8  battery;            /* 0..100, 255 = unknown */
+    u32 seq;                /* bumps on every input report */
+    u32 assign_seq;         /* manager-owned: bumps whenever the port is given to a device or
+                             * released, so an unplug + replug between two reads still shows */
+} PadHostPortState;
+
+typedef struct PadHostDevice {   /* manager-owned; drivers keep private state in priv[] */
+    void* handle; int bus; u16 vid, pid, version; u16 usage_page, usage;
+    int in_len, out_len, feat_len;   /* HIDP_CAPS byte lengths incl. report id */
+    void* preparsed;                 /* PHIDP_PREPARSED_DATA (NULL for a virtual device) */
+    const char* path; int port;      /* assigned PS3 port, -1 none */
+    unsigned char priv[2048];
+    /* --- additions to the shared contract --- */
+    char serial[64];      /* identity for getting the same port back on reconnect. The
+                           * manager fills it from HidD_GetSerialNumberString (over
+                           * Bluetooth that is the MAC); a driver may overwrite it in
+                           * open(), e.g. with the MAC read from a feature report, so
+                           * USB and Bluetooth connections of one pad count as one. */
+    char name[64];        /* product string, for the log; a driver may overwrite it */
+    int  out_refresh_ms;  /* set in open() if the device stops rumbling unless the
+                           * output is repeated: build_output is re-sent this often
+                           * while a motor runs. 0 = only on change. */
+    int  out_set_report;  /* set in open() if the device ignores output reports on its
+                           * interrupt pipe (a DUALSHOCK 3 under the stock HID driver):
+                           * padhost_dev_write then sends them as SET_REPORT on the
+                           * control pipe (IOCTL_HID_SET_OUTPUT_REPORT) only. */
+    int  streams;         /* set by the driver (any time) while the device sends input
+                           * reports continuously (DS4 / DualSense full reports, Switch
+                           * 0x30), 0 when it reports only on change. Over Bluetooth the
+                           * manager then takes a second without a report as a lost link:
+                           * the port's input is released and the output re-sent. */
+} PadHostDevice;
+
+/* open() result for a device the driver matched but will not drive (a
+ * DsHidMini pressure-only side collection, a HID "joystick" with too few
+ * inputs): listed as not used and never re-opened while it stays plugged in.
+ * Any other non-zero result is a failure, retried with a backoff. */
+#define PADHOST_OPEN_DECLINED 2
+
+typedef struct {
+    const char* name; int kind;
+    int  (*match)(const PadHostDevice* d);                         /* >0 = claim (highest wins), 0 = no */
+    int  (*open)(PadHostDevice* d);                                /* handshake / mode switch / calibration; 0 ok,
+                                                                    * PADHOST_OPEN_DECLINED, else failed */
+    int  (*parse)(PadHostDevice* d, const unsigned char* rep, int len, PadHostPortState* st); /* 1 = st updated, 0 = no, -1 = receiver idle */
+    int  (*build_output)(PadHostDevice* d, u8 small_motor, u8 large_motor, int port, unsigned char* out, int cap); /* bytes to write, 0 = none */
+    void (*close)(PadHostDevice* d);                               /* motors off, LEDs released */
+} PadHostDriver;
+
+/* ---------------------------------------------------------------------------
+ * Helpers for drivers. All usable inside open() (it runs on the device's own
+ * thread before the read loop starts), parse(), build_output() and close().
+ * -----------------------------------------------------------------------*/
+int padhost_dev_read(PadHostDevice* d, unsigned char* buf, int cap, int timeout_ms);   /* bytes or -1 (error / timeout) */
+int padhost_dev_write(PadHostDevice* d, const unsigned char* buf, int len);           /* output report, WriteFile then IOCTL_HID_SET_OUTPUT_REPORT fallback
+                                                                                         * (only the latter with out_set_report); len or -1 */
+int padhost_dev_get_feature(PadHostDevice* d, unsigned char* buf, int len);           /* buf[0] = report id; bytes or -1 */
+int padhost_dev_set_feature(PadHostDevice* d, const unsigned char* buf, int len);     /* len or -1 */
+unsigned padhost_crc32(unsigned seed, const unsigned char* p, int n);                 /* zlib crc32(): seed 0 to start, chainable */
+
+/* Port identity for LEDs, so every family shows the same thing for a port:
+ * PS4/PS5 lightbar colours (blue, red, green, pink, then orange, cyan, white),
+ * and the PS3's own player-LED numbering on four LEDs (ports 4..6 light LED 4
+ * plus LED 1/2/3). Mask bit 0 = LED 1. */
+void     padhost_port_color(int port, u8* r, u8* g, u8* b);
+unsigned padhost_port_led_mask(int port);
+
+/* Neutral state: sticks 128, nothing pressed, neutral sensors, battery unknown. */
+void padhost_state_neutral(PadHostPortState* st);
+
+/* Verbose per-device logging (PAD_LOG=1). padhost_logf prints "[padhost] ..."
+ * and is silent on the ExitProcess path. */
+#if defined(__GNUC__) || defined(__clang__)
+#define PADHOST_PRINTF(a, b) __attribute__((format(printf, a, b)))
+#else
+#define PADHOST_PRINTF(a, b)
+#endif
+int  padhost_log_enabled(void);
+void padhost_logf(const char* fmt, ...) PADHOST_PRINTF(1, 2);
+
+/* ---------------------------------------------------------------------------
+ * Public API for cellPad.c
+ * -----------------------------------------------------------------------*/
+void padhost_init(void);        /* enumerate, start threads; returns once the controllers present now are open
+                                 * and on their ports (at most ~2 s; a slower one arrives as a hotplug). Those
+                                 * get ports by class, whichever opened first: XInput pads, then the
+                                 * PlayStation / Nintendo drivers' pads, then other HID gamepads, then HID
+                                 * joysticks / multi-axis devices -- so port 0 is a gamepad if there is one.
+                                 * Virtual pads (a remapper's copy: ViGEm / SCP bus, Steam Input) come after
+                                 * all of those, and with prefer_physical (default) one that duplicates a
+                                 * physical pad gets no port at all while that pad is connected */
+void padhost_shutdown(void);    /* motors off, LEDs released, threads joined, handles closed; idempotent,
+                                 * safe from atexit and from the ExitProcess path. Registered with atexit by
+                                 * padhost_init; a bare ExitProcess still gets HID motors off / LEDs released
+                                 * from a TLS callback, but XInput is already shut down by then, so call this
+                                 * before a direct ExitProcess to stop an Xbox pad's rumble too. */
+int  padhost_get(int port, PadHostPortState* out);              /* lock-cheap snapshot, never blocks on I/O; returns connected */
+void padhost_set_actuator(int port, u8 small_motor, u8 large_motor); /* non-blocking; small = on/off (0/1 from the guest), large = 0..255 */
+unsigned padhost_generation(void);                              /* bumps on any port assignment change */
+/* Who is on a port, for logs and notices: "DualSense (USB)", "Xbox controller (XInput)",
+ * "virtual Xbox controller (ViGEm bus)". 1 = a controller is there, 0 = none,
+ * -1 = the manager is busy right now (never waits: ask again on the next poll). */
+int  padhost_port_describe(int port, char* buf, int n);
+
+extern const PadHostDriver padhost_drv_ds3, padhost_drv_ds4, padhost_drv_dualsense,
+                           padhost_drv_switchpro, padhost_drv_generic;
+
+/* Extra drivers (tests, padprobe's raw dump). Before or after padhost_init;
+ * at most 8. Built-in drivers are always registered. */
+int padhost_register_driver(const PadHostDriver* drv);
+
+/* The HID drivers linked in and registered (XInput is built in, not listed). */
+int padhost_drivers(const PadHostDriver** out, int max);
+
+/* ---------------------------------------------------------------------------
+ * Configuration
+ *
+ * Environment (read by padhost_init, and they win over everything else):
+ *   PAD_NO_HOST=1        no physical controllers at all (benchmark determinism)
+ *   PAD_BACKENDS=list    xinput,ds3,ds4,dualsense,switchpro,generic | all | none;
+ *                        "-name" removes one ("all,-generic")
+ *   PAD_DEADZONE=pct     radial stick deadzone in percent, 0 = raw (default: 24 for
+ *                        XInput pads, as XInput recommends; 8 for the others)
+ *   PAD_FOCUS_ONLY=1     neutral input while no window of this process is foreground
+ *   PAD_PREFER_PHYSICAL=0  keep virtual duplicates on ports (see prefer_physical)
+ *   PAD_LOG=1            verbose per-device logging
+ *   PAD_HOST="k=v|k=v"   any key below
+ *
+ * Keys (case, spaces, '_', '-' and '.' ignored; an optional "controller" /
+ * "gamepad" / "pad" prefix is accepted, so "controller_deadzone" == "deadzone"):
+ *   controllers=1/0  backends=list  deadzone=pct  deadzone_left=pct
+ *   deadzone_right=pct  focus_only=0/1  rumble=pct (0 off, 100 default, max 200;
+ *   a number is always a percentage, on/off/yes/no mean 100/0)
+ *   trigger_threshold=pct (XInput L2/R2 digital bit, default ~12)
+ *   log=0/1  readonly=0/1 (never write to a controller: no output or feature writes)
+ *   motion=1/0 (0: motion sensors ignored, every port reads a pad lying still)
+ *   prefer_physical=1/0 (1: a virtual pad -- DS4Windows / DualSenseX / BetterJoy /
+ *   x360ce on the ViGEm bus, SCP, Steam Input -- that duplicates a physical
+ *   PlayStation / Nintendo / HID pad gets no port while that pad is connected, and
+ *   takes over if it goes; 0: virtual pads are ordinary pads, the old behaviour)
+ * Keys beginning with ds3/ds4/dualsense/switchpro/switch/generic/xinput/map
+ * are stored for the drivers: padhost_config_get() returns them.
+ * ---------------------------------------------------------------------------*/
+
+/* 1 = applied (or stored for a driver), 0 = not a controller key, -1 = bad value.
+ * Callable before or after padhost_init; an environment variable for the same
+ * setting keeps precedence. Backends/controllers changes after init take effect
+ * immediately (devices of a disabled backend are closed, others re-probed). */
+int padhost_config_set(const char* key, const char* value);
+
+/* Stored value of a key (any key padhost_config_set accepted), or NULL. The
+ * pointer stays valid until that key is set again. */
+const char* padhost_config_get(const char* key);
+
+/* "name = value" lines ('#'/';' comments). In a section whose name starts with
+ * "controller" or "gamepad" ([controller], [gamepads], [Controller settings]
+ * -- the sections pad_kbm.h leaves alone) every line is a controller key; elsewhere only
+ * names starting with "controller" are taken and the rest is left to whoever
+ * owns them (the keyboard/mouse table). env_style: '|' and ';' also end a line.
+ * warn gets one message per bad line. Returns the number of bad lines. */
+int padhost_config_parse_text(const char* text, int env_style, void (*warn)(const char* msg));
+
+int padhost_backend_enabled(int kind);
+
+/* ---------------------------------------------------------------------------
+ * Introspection (padprobe, logs)
+ * -----------------------------------------------------------------------*/
+typedef struct {
+    int  claimed;         /* 1 = driven by a driver / XInput, 0 = seen but not used */
+    int  idle;            /* claimed receiver with no controller behind it */
+    int  kind, bus, port; /* port -1 = none (unclaimed, or waiting for a free port) */
+    u16  vid, pid, usage_page, usage;
+    u8   battery;
+    char driver[40];      /* driver name, or why it is not used */
+    char name[64];
+    char path[200];
+    int  hidden;          /* claimed virtual duplicate kept off the ports (prefer_physical) */
+    char virt[32];        /* a virtual pad: what made it ("ViGEm bus", "Steam Input", ...), else "" */
+} PadHostDeviceInfo;
+
+int  padhost_enum_devices(PadHostDeviceInfo* out, int max);   /* returns the count (may exceed max) */
+void padhost_log_devices(const char* why);                     /* the device list, as printed at startup / hotplug */
+const char* padhost_kind_name(int kind);
+const char* padhost_bus_name(int bus);
+
+/* ---------------------------------------------------------------------------
+ * Virtual devices: a driver run end to end (open -> port -> parse -> output ->
+ * close) on its own device thread, with reports and feature replies supplied
+ * by the caller and output reports captured. For tests and for validating a
+ * driver's Bluetooth path with synthesized reports. Need padhost_init first;
+ * not affected by PAD_NO_HOST / PAD_BACKENDS. Not safe against a concurrent
+ * detach of the same id.
+ * -----------------------------------------------------------------------*/
+int  padhost_virtual_attach(const PadHostDriver* drv, int bus, u16 vid, u16 pid,
+                            const char* serial, int in_len, int out_len);   /* id > 0, or -1 (open failed) */
+/* Queue features first, then attach, if the driver's open() reads them: */
+int  padhost_virtual_prepare(const PadHostDriver* drv, int bus, u16 vid, u16 pid,
+                             const char* serial, int in_len, int out_len);  /* id, device not started */
+int  padhost_virtual_start(int id);                                         /* 0 ok, -1 open failed */
+void padhost_virtual_set_feature(int id, const unsigned char* rep, int len);  /* reply for get_feature(rep[0]) */
+int  padhost_virtual_feed(int id, const unsigned char* rep, int len);        /* returns once parsed; 0 ok */
+int  padhost_virtual_last_output(int id, unsigned char* buf, int cap, int* count); /* last write's bytes; count = writes so far */
+int  padhost_virtual_last_feature_set(int id, unsigned char* buf, int cap, int* count);
+int  padhost_virtual_port(int id);
+void padhost_virtual_detach(int id);   /* unplug: returns once the port is released */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_PAD_HOST_H */
diff --git a/libs/input/pad_host_win.c b/libs/input/pad_host_win.c
new file mode 100644
index 0000000..0e233de
--- /dev/null
+++ b/libs/input/pad_host_win.c
@@ -0,0 +1,3506 @@
+/*
+ * ps3recomp - host game controllers: the Windows device manager
+ *
+ * See pad_host.h for the picture. What lives here:
+ *
+ *   - HID enumeration (SetupDi on the HID interface class), filtered to game
+ *     controller collections (usage page 1, usage 4/5/8) and matched against
+ *     the drivers, highest match score wins. HID collections that XInput
+ *     already serves are skipped so no pad shows up twice: every
+ *     XInput-compatible pad exposes a HID collection with "IG_" in its path,
+ *     and Xbox pads on Bluetooth (VID 045E gamepads) are served by XInput
+ *     through xinputhid.
+ *   - XInput as a built-in backend, polled on its own thread at 250 Hz while a
+ *     slot is connected. An empty slot is only re-probed every 2 s (or on a
+ *     hotplug notification): XInputGetState on an empty slot costs ~14 us.
+ *   - Hotplug: CM_Register_Notification on the HID and XUSB interface classes
+ *     (no window needed) wakes the manager thread, which rescans. A device
+ *     that disappears is also caught by its reader: ReadFile fails.
+ *   - One thread per HID device: driver open() (handshake), then an
+ *     overlapped ReadFile loop calling driver parse() and publishing into the
+ *     port snapshot; output reports (rumble, LEDs) are built and written by
+ *     the same thread, woken by padhost_set_actuator, so a driver is only
+ *     ever entered from one thread and the guest thread never does I/O.
+ *   - Ports: up to 7 in connection order (lowest free port), stable while
+ *     connected; a device that comes back (same serial, else same path) gets
+ *     its old port if it is free. An 8th device waits for a free port. The
+ *     devices present at startup are ranked instead (ph_dev_rank), so a
+ *     wheel or flight stick does not beat the gamepad to port 0.
+ *   - Virtual duplicates: a remapper's emulated pad (ViGEm / SCP bus, Steam
+ *     Input) next to the physical pad it reads is recognised from its device
+ *     tree and, by default, kept off the ports while that pad is connected
+ *     (ph_dup_reeval).
+ *   - A device Windows wants to remove or restart (disable, driver update)
+ *     is let go of on its query-remove notification instead of vetoing it.
+ *   - Shutdown: device threads turn motors off / release LEDs (driver
+ *     close()), threads are joined with bounded waits, handles closed. If the
+ *     process leaves through ExitProcess with no shutdown call (the window's
+ *     close button does exactly that), a TLS callback does the motors-off part
+ *     from the loader's process-detach notification, lock-free, since every
+ *     other thread is already gone by then.
+ */
+
+#include "pad_host.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+/* ---------------------------------------------------------------------------
+ * Portable helpers
+ * -----------------------------------------------------------------------*/
+
+/* zlib crc32(): reflected polynomial 0xEDB88320, pre/post inverted, so it
+ * chains: crc32(crc32(0, a), b) == crc32(0, a||b). Bitwise rather than a
+ * table: the longest report it ever covers is ~80 bytes, and there is no
+ * table to initialise race-free. */
+unsigned padhost_crc32(unsigned seed, const unsigned char* p, int n)
+{
+    unsigned c = ~seed;
+    for (int i = 0; i < n; i++) {
+        c ^= p[i];
+        for (int k = 0; k < 8; k++)
+            c = (c >> 1) ^ (0xEDB88320u & (0u - (c & 1u)));
+    }
+    return ~c;
+}
+
+void padhost_port_color(int port, u8* r, u8* g, u8* b)
+{
+    static const u8 col[PADHOST_MAX_PORTS][3] = {
+        { 0x00, 0x00, 0x40 },   /* blue   */
+        { 0x40, 0x00, 0x00 },   /* red    */
+        { 0x00, 0x40, 0x00 },   /* green  */
+        { 0x20, 0x00, 0x20 },   /* pink   */
+        { 0x40, 0x18, 0x00 },   /* orange */
+        { 0x00, 0x28, 0x28 },   /* cyan   */
+        { 0x28, 0x28, 0x28 },   /* white  */
+    };
+    if (port < 0 || port >= PADHOST_MAX_PORTS) port = 0;
+    if (r) *r = col[port][0];
+    if (g) *g = col[port][1];
+    if (b) *b = col[port][2];
+}
+
+unsigned padhost_port_led_mask(int port)
+{
+    static const unsigned m[PADHOST_MAX_PORTS] = { 0x1, 0x2, 0x4, 0x8, 0x9, 0xA, 0xC };
+    return (port >= 0 && port < PADHOST_MAX_PORTS) ? m[port] : 0;
+}
+
+void padhost_state_neutral(PadHostPortState* st)
+{
+    memset(st, 0, sizeof *st);
+    st->lx = st->ly = st->rx = st->ry = 128;
+    st->sensor_x = PADHOST_SENSOR_NEUTRAL_X;
+    st->sensor_y = PADHOST_SENSOR_NEUTRAL_Y;
+    st->sensor_z = PADHOST_SENSOR_NEUTRAL_Z;
+    st->sensor_g = PADHOST_SENSOR_NEUTRAL_G;
+    st->battery  = 255;
+}
+
+const char* padhost_kind_name(int kind)
+{
+    switch (kind) {
+    case PADHOST_KIND_XINPUT:     return "XInput";
+    case PADHOST_KIND_DS3:        return "DualShock 3";
+    case PADHOST_KIND_DS4:        return "DualShock 4";
+    case PADHOST_KIND_DUALSENSE:  return "DualSense";
+    case PADHOST_KIND_SWITCH_PRO: return "Switch Pro";
+    case PADHOST_KIND_GENERIC:    return "HID gamepad";
+    default:                      return "unknown";
+    }
