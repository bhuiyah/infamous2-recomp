+    uint32_t send = spu_interp_run_until(sh, pc, ret);
+    /* the real (lifted) call, run to its return here */
+    void (*saved_tr)(spu_context*) = g_spu_trampoline_fn;
+    g_spu_trampoline_fn = 0;
+    ctx->host_depth++;
+    spu_indirect_branch(ctx);
+    spu_drain_call(ctx, ret);
+    ctx->host_depth--;
+    (void)saved_tr;
+    int ngd = 0, nld = 0; char gl[600]; int gp = 0; gl[0] = 0;
+    for (int r = 0; r < 128; r++)
+        if (memcmp(&sh->gpr[r], &ctx->gpr[r], 16)) {
+            if (ngd < 6) gp += snprintf(gl + gp, sizeof gl - gp, " r%d lift=%08X%08X%08X%08X interp=%08X%08X%08X%08X",
+                r, ctx->gpr[r]._u32[3], ctx->gpr[r]._u32[2], ctx->gpr[r]._u32[1], ctx->gpr[r]._u32[0],
+                sh->gpr[r]._u32[3], sh->gpr[r]._u32[2], sh->gpr[r]._u32[1], sh->gpr[r]._u32[0]);
+            ngd++; }
+    uint32_t first_ld = 0, last_ld = 0;
+    for (uint32_t a = 0; a < SPU_LS_SIZE; a += 16)
+        if (memcmp(sh->ls + a, ctx->ls + a, 16)) { if (!nld) first_ld = a; last_ld = a; nld++; }
+    fprintf(stderr, "[pic-verify] img=%d entry=0x%05X(+0x%X) ret=0x%05X interp-end=0x%05X: %s gpr-diffs=%d ls-diff-lines=%d",
+            img, pc, pc - lsa, ret, send, (ngd || nld || send != ret) ? "MISMATCH" : "ok", ngd, nld);
+    if (nld) fprintf(stderr, " ls[0x%05X..0x%05X]", first_ld, last_ld + 15);
+    fprintf(stderr, "%s\n", gl);
+    if (nld) {   /* the first differing line, both ways */
+        const uint8_t* a = ctx->ls + first_ld; const uint8_t* b = sh->ls + first_ld;
+        fprintf(stderr, "[pic-verify]   0x%05X lift  :", first_ld);
+        for (int i = 0; i < 16; i++) fprintf(stderr, " %02X", a[i]);
+        fprintf(stderr, "\n[pic-verify]   0x%05X interp:", first_ld);
+        for (int i = 0; i < 16; i++) fprintf(stderr, " %02X", b[i]);
+        fprintf(stderr, "\n");
+    }
+    _aligned_free(sh);
+    busy = 0;
+    ctx->pc = ret;
+    g_spu_trampoline_fn = spu_indirect_branch;   /* the caller's drain sees pc == its return pc */
+    return 1;
+}
+
+#include "spu_jobverify.inc"   /* SPU_JOB_VERIFY: uses the statics above */
+
+/* SPU_INTERP_IMG: interpret code of a listed image from ctx->pc until it
+ * returns to the drain's return pc (or rejoins lifted code of another image,
+ * which then trampolines on), as the lifted function would have. */
+static void spu_interp_listed(spu_context* ctx)
+{
+    g_spu_lookup_gated = 0;
+    const uint32_t pc = ctx->pc & SPU_LS_MASK;
+    const uint32_t stop = ctx->drain_ret_pc & SPU_LS_MASK;   /* captured: nested drains rewrite it */
+    { static int n = 0; if (n++ < 8)
+        fprintf(stderr, "[spu-interp-img] interpreting from pc=0x%05X (ovl %d, stop 0x%05X)\n",
+                pc, (int)ctx->resident_ovl, stop); }
+    const int prev_irqb = g_spu_interp_irq_break;   /* nests; a longjmp out is reset in spu_run_with_halt */
+    g_spu_interp_irq_break = 1;
+    spu_interp_run_until(ctx, pc, stop);
+    g_spu_interp_irq_break = prev_irqb;
+    if (ctx->status == SPU_STATUS_STOPPED_BY_HALT) { spu_halt(ctx); return; }   /* lifted HALT parity */
+    if (ctx->status == SPU_STATUS_RUNNING && (!stop || (ctx->pc & SPU_LS_MASK) != stop))
+        g_spu_trampoline_fn = spu_indirect_branch;   /* rejoined lifted code / interrupt pending */
+}
+
+/* Is any of spu_indirect_branch's per-dispatch probes switched on (-1 = not
+ * read yet)? Each probe still reads and honours its own variable; this only
+ * skips the lot when none is set. */
+static int s_ib_diag = -1;
+static int spu_ib_diag_on(void)
+{
+    if (s_ib_diag < 0)
+        s_ib_diag = (getenv("SPU_IBCOV") || getenv("SPU_POLLTRACE") || getenv("YDKJ_POLTRACE") ||
+                     getenv("SPU_JOBTRACE") || getenv("LBP_HLE_JOBDONE") || getenv("SPU_JOBEXEC")) ? 1 : 0;
+    return s_ib_diag;
+}
+
+/* Is the cached dispatch allowed for this run? Off when any diagnostic that
+ * the full resolver or a drain hop would run per transfer is armed (each is
+ * keyed on its variable being present at all), with SPU_NO_GOTO (whose point
+ * is the legacy transfer sequence) and with SPU_IBFAST=0. SPU_IBFAST=check
+ * fills the caches but answers nothing from them: every computed branch they
+ * could have answered is resolved in full and compared ([spu-ibc] lines). */
+static void spu_ibfast_init(void)
+{
+    static const char* const k_off[] = {
+        "SPU_PIC_VERIFY", "SPU_JOB_VERIFY", "SPU_FLOWRING", "SPU_LOCKSTEP",
+        "SPU_TAILRET", "SPU_PCHIST", "SPURS_PM_FLOW", "SPU_INTERP_IMG", "SPU_IBCOV",
+        "SPU_POLLTRACE", "YDKJ_POLTRACE", "SPU_JOBTRACE", "LBP_HLE_JOBDONE", "SPU_JOBEXEC",
+        "SPU_NO_LS0_END", "SPU_EXITTRACE", "SPU_STEPTRACE", "SPU_JOBDRAIN", "SPU_NO_GOTO",
+    };
+    extern int spu_tlc_mode(void);
+    extern int g_spu_no_goto;
+    const char* e = getenv("SPU_IBFAST");
+    int on = !(e && *e == '0');
+    const int check = e && (!strcmp(e, "check") || !strcmp(e, "2"));
+    for (unsigned i = 0; on && i < sizeof k_off / sizeof k_off[0]; i++)
+        if (getenv(k_off[i])) on = 0;
+    if (on && (spu_tlc_mode() != 0 || g_spu_no_goto)) on = 0;
+    if (s_interp_img_on < 0) spu_interp_img_init();
+    if (on && (spu_ib_diag_on() || s_interp_img_on)) on = 0;
+    s_ibfast_on = on && check ? 2 : on;
+    if (s_ibfast_on == 1 && !s_ibfast_held) g_spu_ibfast = s_ibfast_gen;
+    if (e && *e) fprintf(stderr, "[spu] cached computed-branch dispatch %s (SPU_IBFAST=%s)\n",
+                         s_ibfast_on == 2 ? "in check mode" : on ? "on" : "off", e);
+}
+
+/* SPU_IBFAST=check: the answer the cache holds for ctx->pc (what the fast
+ * paths would have done), NULL if none; spu_ibc_check_end compares it with
+ * what the full resolver then did. */
+typedef struct { void (*fn)(spu_context*); uint32_t gen, bias; int pic; } spu_ibc_pred;
+static spu_ibc_pred spu_ibc_check_begin(const spu_context* ctx)
+{
+    spu_ibc_pred r = { NULL, 0, 0, 0 };
+    const uint32_t pc = ctx->pc;
+    const spu_ibc_ent* e = &ctx->ibc[SPU_IBC_IDX(pc)];
+    if (ctx->ibc_ggen != s_ibfast_gen || e->pc != pc || e->gen != ctx->res_gen ||
+        e->img != ctx->image_id || ctx->irq_saved)
+        return r;
+    if (e->pic) {
+        const unsigned slot = e->pic - 1u;
+        if (!spu_pic_slot_intact(ctx, slot, pc)) return r;   /* the fast path would not take it either */
+        r.pic = 1;
+        r.bias = ctx->resident_code[slot].lsa - ctx->resident_code[slot].pic_base;
+    }
+    r.fn = e->fn;
+    r.gen = ctx->res_gen;
+    return r;
+}
+static void spu_ibc_check_end(const spu_context* ctx, const spu_ibc_pred* pr, void (*fn)(spu_context*),
+                              const char* how)
+{
+    static volatile long s_checked, s_bad;
+    if (!pr->fn) return;
+    const long k = _InterlockedIncrement(&s_checked);
+    SPU_IBC_STAT(4);
+    const int bad = fn != pr->fn || ctx->res_gen != pr->gen || (pr->pic && ctx->pic_bias != pr->bias);
+    if (bad) {
+        const long b = _InterlockedIncrement(&s_bad);
+        if (b <= 32)
+            fprintf(stderr, "[spu-ibc] CHECK MISMATCH (%s) pc=0x%05X img=%d ovl=%d task=%d depth=%u: cached %p, "
+                    "resolved %p, residency gen %u -> %u%s\n", how, ctx->pc & SPU_LS_MASK, ctx->image_id,
+                    ctx->resident_ovl, ctx->resident_task, ctx->host_depth, (void*)pr->fn, (void*)fn,
+                    pr->gen, ctx->res_gen, pr->pic && ctx->pic_bias != pr->bias ? " (pic bias differs)" : "");
+    }
+    if ((k & 0xFFFFFF) == 0 || (bad && s_bad <= 32))
+        fprintf(stderr, "[spu-ibc] check: %ld cached answers verified, %ld mismatches\n", k, (long)s_bad);
+}
+
+/* Record what the full resolver just did for ctx->pc -- fn, resolved through
+ * the resident code slots / task / overlay / image (resident code slot `slot`,
+ * or -1), with no other effect -- so the next computed branch to pc under the
+ * same residency (res_gen), image and registry (g_spu_ibfast) takes it
+ * straight (spu_indirect_branch's first lines, spu_ib_inline). Refused for the
+ * addresses whose dispatch does more than that: the policy-module kernel
+ * services, the taskset syscall, the job-return and LS-0 job-end addresses, a
+ * registered stack reset, and a taskset task address whose resident task the
+ * resolver would (re)decide from local store or adopt now. */
+static void spu_ibc_fill(spu_context* ctx, void (*fn)(spu_context*), int slot)
+{
+    const uint32_t pc = ctx->pc;
+    if (pc == 0 || pc == SPU_JOB_RETURN_LS || pc == SPURS_PM_EXIT_TO_KERNEL_LS ||
+        pc == SPURS_PM_SELECT_WORKLOAD_LS || pc == SPURS_TASKSET_PM_SYSCALL_LS)
+        return;
+    for (unsigned i = 0; i < s_stack_reset_count; ++i)
+        if (s_stack_reset[i].entry == pc) return;
+    if (pc >= SPU_TASKSET_TASK_LO) {
+        if (!ctx->resident_task && spu_taskset_task_image(pc)) return;
+        for (int i = 0; i < s_task_elf_count; ++i)
+            if (s_task_elf[i].policy_image_id == ctx->resident_ovl ||
+                spu_code_slot_holds(ctx, s_task_elf[i].policy_image_id))
+                return;
+    }
+    if (ctx->ibc_ggen != s_ibfast_gen) {
+        for (unsigned i = 0; i < SPU_IBC_N; ++i) ctx->ibc[i].pc = SPU_IBC_NOPC;
+        ctx->ibc_ggen = s_ibfast_gen;
+    }
+    spu_ibc_ent* e = &ctx->ibc[SPU_IBC_IDX(pc)];
+    SPU_IBC_STAT(2);
+    e->pc = pc;
+    e->gen = ctx->res_gen;
+    e->img = ctx->image_id;
+    e->pic = (slot >= 0 && ctx->resident_code[slot].pic_base) ? (uint32_t)slot + 1u : 0u;
+    e->fn = fn;
+}
+
+#if defined(__clang__)
+#  define SPU_IB_TAIL(f) do { __attribute__((musttail)) return (f)(ctx); } while (0)
+#else
+#  define SPU_IB_TAIL(f) do { (f)(ctx); return; } while (0)
+#endif
+
+/* SPU_TASKSET_LLE (NOTES 2026-10-27, PF4): who runs a SPURS taskset task's
+ * syscalls when the taskset's policy module is lifted code at LS 0xA70 (the
+ * real libsre kernel holds it as a co-resident region; the lookups in
+ * spu_indirect_branch miss it). Off, the HLE (spu_spurs_taskset_syscall) runs
+ * them, and its WAIT_SIGNAL parks the SPU's host thread until a signal: the
+ * SPU is held for the whole wait. On, Sony's policy module runs them: a waiting
+ * task is saved to its context save area and the SPU goes back to the SPURS
+ * kernel, which runs other workloads on it and brings the task back, on
+ * whichever SPU it picks, once it is signalled -- what a PS3 does. inFamous 2's
+ * psarc decompressor task waits for requests all game long, so with the HLE
+ * one of its five CellSpursKernelGroup SPUs never ran a WWS job (max
+ * contention 5): the gate fight ran its jobs on four. A title opts in
+ * (spu_taskset_lle_configure, before its first SPU thread starts); the
+ * toolkit's default stays the HLE. SPU_TASKSET_LLE=1 | 0 overrides the title's
+ * choice (0 = the HLE, the kill switch). Decided once, at the first query (a
+ * task's first syscall or resume). The policy path needs two residency rules
+ * the HLE never exercised: a task's syscall runs the policy as a nested call
+ * that gives the task its residency back when the policy returns
+ * (spu_taskset_pm_call), and a task taken up from the policy drops the
+ * streamed overlay its ELF replaced (both below). */
+static int s_taskset_lle_cfg;               /* the title's choice: 0 the HLE (the toolkit default), 1 the policy */
+static volatile int s_taskset_lle = -1;     /* -1 undecided */
+void spu_taskset_lle_configure(int on) { s_taskset_lle_cfg = on ? 1 : 0; }
+int spu_taskset_lle_on(void)
+{
+    const int d = s_taskset_lle;
+    if (__builtin_expect(d >= 0, 1)) return d;
+    int v = s_taskset_lle_cfg;
+    const char* e = getenv("SPU_TASKSET_LLE");
+    int bad = 0;
+    if (e && *e) {
+        if (e[0] == '0' && !e[1]) v = 0;
+        else if (e[0] == '1' && !e[1]) v = 1;
+        else bad = 1;
+    }
+    if (__sync_val_compare_and_swap(&s_taskset_lle, -1, v) == -1) {
+        if (bad) fprintf(stderr, "[spu] SPU_TASKSET_LLE=%s not understood (0 | 1): the title's choice\n", e);
+        fprintf(stderr, "[spu] taskset tasks: %s (%s)\n",
+                v ? "Sony's policy module -- a waiting task gives its SPU back to the SPURS kernel"
+                  : "the HLE syscall -- a waiting task parks its SPU's host thread",
+                e && *e && !bad ? (v ? "SPU_TASKSET_LLE=1" : "SPU_TASKSET_LLE=0")
+                                : "the title's choice; SPU_TASKSET_LLE=0 | 1 overrides");
+    }
+    return s_taskset_lle;
+}
+
+/* TASK_PUTLOG=<file> (diagnostic, PF4's oracle): one line per MFC PUT that a
+ * SPURS taskset task's own code issues (resident_task set: its pc is in the
+ * task region) -- "<task image> <ea> <size> <FNV-1a 64 of the bytes>" -- the
+ * task's output, to compare between the HLE and the policy module
+ * (SPU_TASKSET_LLE) over the same boot. The policy module's own context-save
+ * DMA runs outside the task region and is not logged. Routes every DMA to the
+ * diagnostic path (spu_dma.h's gate). */
+static FILE* s_task_putlog;
+static int s_task_putlog_state = -1;        /* -1 unread, 0 off, 1 on */
+static SRWLOCK s_task_putlog_lock = SRWLOCK_INIT;
+void spu_task_put_note(const spu_context* ctx, uint32_t ea, const uint8_t* src, uint32_t size)
+{
+    if (s_task_putlog_state == 0 || !ctx->resident_task) return;
+    AcquireSRWLockExclusive(&s_task_putlog_lock);
+    if (s_task_putlog_state < 0) {
+        const char* f = getenv("TASK_PUTLOG");
+        s_task_putlog = f && *f ? fopen(f, "w") : NULL;
+        s_task_putlog_state = s_task_putlog ? 1 : 0;
+        fprintf(stderr, "[spu] TASK_PUTLOG -> %s: %s\n", f ? f : "(unset)", s_task_putlog ? "on" : "OFF");
+    }
+    if (s_task_putlog) {
+        uint64_t h = 1469598103934665603ull;
+        for (uint32_t i = 0; i < size; i++) { h ^= src[i]; h *= 1099511628211ull; }
+        fprintf(s_task_putlog, "%d %08X %u %016llX\n", ctx->resident_task, ea, size, (unsigned long long)h);
+        fflush(s_task_putlog);
+    }
+    ReleaseSRWLockExclusive(&s_task_putlog_lock);
+}
+
+/* SPU_TASKSET_LLE: a task's syscall -- a bisl straight to the policy's entry
+ * at 0xA70 (inFamous 2's psarc task's WAIT_SIGNAL) or a call to a wrapper that
+ * tail-branches there (its POLL, YIELD) -- run as the call it is. The policy
+ * either returns to the task's link -- POLL, YIELD with nothing else ready, a
+ * WAIT_SIGNAL whose signal is already latched -- or never comes back here: it
+ * saves the task and gives the SPU back (0x808, the stack reset: a longjmp to
+ * depth 0) or resumes a saved task (the TaskInfo resume in
+ * spu_indirect_branch: a longjmp). Policy code runs with no task resident, as
+ * any dispatch below the task region; a return gives the task its residency
+ * back. Left cleared, the task's next computed branch took the "the policy
+ * resumed a saved task" path -- a longjmp to depth 0 over its own live
+ * frames -- and a few returns later it branched to LS 0 (NOTES 2026-10-27,
+ * PF4: every policy-module cold boot, at the end of the world load). Here and
+ * not in the caller's drain: a bisl's dispatch clears the residency before
+ * its bracket's drain runs. */
+static __attribute__((noinline)) void spu_taskset_pm_call(spu_context* ctx, spu_lifted_fn pm)
+{
+    const int rt = ctx->resident_task;
+    const uint32_t lr = ctx->gpr[0]._u32[0] & SPU_LS_MASK;
+    const int32_t si = (int32_t)ctx->image_id;
+    ctx->resident_task = 0;
+    spu_res_changed(ctx);
+    ctx->host_depth++;
+    ctx->drain_ret_pc = lr;
+    pm(ctx);
+    spu_drain_call(ctx, lr);
+    ctx->host_depth--;
+    spu_img_restore(ctx, si);
+    if (!ctx->resident_task) { ctx->resident_task = rt; spu_res_changed(ctx); }
+    /* back at the link, as the HLE's return: dispatched when no host frame is live */
+    if (ctx->host_depth == 0) g_spu_trampoline_fn = spu_indirect_branch;
+}
+
+void spu_indirect_branch(spu_context* ctx)
+{
+    /* Real SPU bi/bisl mask the target to the 256 KB local store; the high bits
+     * of a computed pointer (e.g. a packed handle like 0x7a028803) are ignored.
+     * Without this, any indirect branch through such a value fails the lookup
+     * and falls into branch-to-0. All lifted funcs live below SPU_LS_SIZE, so
+     * masking is a no-op for already-valid targets. */
+    ctx->pc &= SPU_LS_MASK;
+    /* Cached: the answer the code below gave for this pc under the same
+     * residency, image and registry, when it did nothing else (spu_ibc_fill).
+     * Pending interrupt-register restores and --pic slots whose bytes may have
+     * been overwritten since still go the full way. */
+    {
+        const uint32_t pc = ctx->pc, gg = g_spu_ibfast;
+        const spu_ibc_ent* e = &ctx->ibc[SPU_IBC_IDX(pc)];
+        if (__builtin_expect(gg != 0 && ctx->ibc_ggen == gg && e->pc == pc && e->gen == ctx->res_gen &&
+                             e->img == ctx->image_id && ctx->irq_saved == 0, 1)) {
+            void (*const hit)(spu_context*) = e->fn;
+            SPU_IBC_STAT(1);
+            if (e->pic == 0) SPU_IB_TAIL(hit);
+            const unsigned slot = e->pic - 1u;
+            if (spu_pic_slot_intact(ctx, slot, pc)) {
+                ctx->pic_bias = ctx->resident_code[slot].lsa - ctx->resident_code[slot].pic_base;
+                SPU_IB_TAIL(hit);
+            }
+        }
+    }
+    if (__builtin_expect(s_ibfast_on < 0, 0)) spu_ibfast_init();
+    t_lk_wild = 0;
+    spu_ibc_pred ib_pred = { NULL, 0, 0, 0 };
+    if (__builtin_expect(s_ibfast_on == 2, 0)) ib_pred = spu_ibc_check_begin(ctx);
+    SPU_IBC_STAT(3);
+#ifdef SPU_IBC_STATS
+    if ((g_spu_ibc_stat[3] & 0x3FFFFFu) == 0) spu_ibc_stat_report();
+#endif
+    /* Every guest indirect branch comes through here, so each disabled
+     * diagnostic below is a load and a branch, not a call (the gates are -1
+     * until the function behind them has read its env). */
+    if (__builtin_expect(s_pv_lo != -1, 0) && spu_pic_verify(ctx)) return;
+    if (__builtin_expect(s_jv_on != 0, 0) && spu_job_verify(ctx)) return;    /* SPU_JOB_VERIFY (spu_jobverify.inc) */
+    SPU_FLOW_NOTE(ctx, 'I');
+    /* Interrupt-return register restore (see spu_drain.c spu_irq_regs_save):
+     * the WWS handler's save/restore shim lives at unlifted top-of-LS, so we
+     * enforce the preserve-all-registers hardware contract here -- the first
+     * interrupts-enabled dispatch at the saved srr0 is the irete.
+     * (spu_irq_regs_maybe_restore does nothing unless irq_saved.) */
+    { extern int spu_irq_regs_maybe_restore(spu_context*);
+      if (ctx->irq_saved && spu_irq_regs_maybe_restore(ctx)) {
+          static int s_it = -1; if (s_it < 0) s_it = getenv("SPU_IRQTRACE") ? 1 : 0;
+          static int _r = 0;
+          if (s_it && _r++ < 200)
+              fprintf(stderr, "[irq] IRET restore at srr0=0x%05X\n", ctx->pc & SPU_LS_MASK);
+      } }
+    /* SPURS kernel services (policy-module runs only): the HLE kernel plants
+     * these two reserved addresses as exitToKernelAddr / selectWorkloadAddr in
+     * the SpursKernelContext (spurs_policy.c). */
+    if (ctx->policy_mode) {
+        extern volatile unsigned g_spurs_pm_polls, g_spurs_pm_exited;
+        if (ctx->pc == SPURS_PM_EXIT_TO_KERNEL_LS) {
+            /* Module exit: the workload returned to the kernel (drained/yield).
+             * Print gated: fires once per policy run = thousands/sec. */
+            g_spurs_pm_exited = 1;
+            { static int s_t = -1; if (s_t < 0) s_t = getenv("SPURS_PM_TRACE") ? 1 : 0;
+              if (s_t) { static unsigned long _n = 0; unsigned long n = ++_n;
+                if (n <= 64 || (n & 0xFFF) == 0)
+                    fprintf(stderr, "[spurs-pm] exit-to-kernel#%lu (r3=0x%08X polls=%u)\n",
+                            n, ctx->gpr[3]._u32[0], g_spurs_pm_polls); } }
+            ctx->status = SPU_STATUS_STOPPED_BY_STOP;
+            spu_halt(ctx);
+            return;
+        }
+        if (ctx->pc == SPURS_PM_SELECT_WORKLOAD_LS) {
+            /* cellSpursModulePoll: report "no contention — keep running".
+             * (One virtual SPU per workload here, so nothing ever preempts.) */
+            unsigned n = ++g_spurs_pm_polls;
+            if (n <= 4 || (n % 4096) == 0)
+                fprintf(stderr, "[spurs-pm] poll #%u (r3=0x%08X) -> continue\n",
+                        n, ctx->gpr[3]._u32[0]);
+            ctx->gpr[3] = spu_make_preferred_u32(0);
+            ctx->pc = ctx->gpr[0]._u32[0] & SPU_LS_MASK;
+            return;
+        }
+    }
+    /* Synthetic HLE tasks have no resident taskset policy at 0xA70. Real
+     * tasksets use the SAME syscall address, so the API table alone is not
+     * evidence that this is an HLE context. LLE tasks must enter Sony's policy
+     * to yield/select workloads instead of parking an entire SPU host thread.
+     * Image 22 is the legacy standalone HLE CRI task runner. */
+    if (ctx->pc == SPURS_TASKSET_PM_SYSCALL_LS) {
