+static const ss_section_ops k_fsfd_ops = {
+    SS_FOURCC('F', 'S', 'F', 'D'), 1, 0, SS_ORDER_FS,
+    fsfd_check, fsfd_capture, fsfd_teardown, fsfd_restore, NULL,
+    "open files", s_fsfd_lists, fsfd_size_hint,
+    NULL, fsfd_check_image,                         /* verify: the generic compare (host_path skipped) */
+};
