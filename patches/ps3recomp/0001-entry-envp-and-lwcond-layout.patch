+/* Root records for the census's strict walk: written by ss_root_enter on the
+ * thread itself (P0 keeps its own copy in t_root), read by the coordinator
+ * with that thread parked. `valid` is the writer's token (0 = none), so an
+ * old host thread on its way out never clears the record of the new thread
+ * that took its tid. */
+typedef struct ss_root_tab { volatile long valid; ss_sr_root r; } ss_root_tab;
+static ss_root_tab s_roots[SS_MAX_TID + 1];
+static ss_sr_ops s_sr_ops;
+
+/* A LOAD's park records (M4c): what each RUNNING / DETACHED thread of the
+ * image resumes from, handed over by PPUT's restore (ss_load_set_park) and
+ * consumed by that thread at the release (ss_root_load_run). During the load
+ * they stand in for the parks of a stop, so the fidelity check's capture of
+ * PPUT writes them back as they were captured. */
+typedef struct ss_lpark {
+    volatile long valid;
+    int      at, tier;
+    uint32_t num, obj;
+    ss_wait_rec rec;
+    ss_sr_root  root;
+    int      root_valid;
+    ppu_context ctx;
+} ss_lpark;
+static ss_lpark s_lpark[SS_MAX_TID + 1];
+
+/* g_ppu_ss_park_of (the PPUT section's capture, sys_ppu_thread.c): thread
+ * `tid`'s park record in the stop in progress -- read on the coordinator
+ * with that thread parked, so the record and its root hold still. During a
+ * load: its restored park record. */
+static int ppu_park_of(unsigned tid, int* at, int* tier, uint32_t* num, uint32_t* obj,
+                       const ppu_context** ctx, struct ss_sr_root* root, int* rv)
+{
+    if (!tid || tid > SS_MAX_TID) return 0;
+    if (s_loading) {
+        const ss_lpark* p = &s_lpark[tid];
+        if (!p->valid) return 0;
+        *at = p->at; *tier = p->tier; *num = p->num; *obj = p->obj; *ctx = &p->ctx;
+        *rv = p->root_valid;
+        if (*rv) *root = p->root;
+        return 1;
+    }
+    const ss_thr* r = &s_thr[tid];
+    if (r->state != 1 || r->gen != s_gen) return 0;
+    *at = r->at; *tier = r->tier; *num = r->num; *obj = r->obj; *ctx = &r->ctx;
+    *rv = s_roots[tid].valid != 0;
+    if (*rv) *root = s_roots[tid].r;
+    return 1;
+}
+
+int ss_ppu_wait_rec(unsigned tid, ss_wait_rec* out)
+{
+    if (!tid || tid > SS_MAX_TID || !out) return 0;
+    if (s_loading) {
+        if (!s_lpark[tid].valid) return 0;
+        *out = s_lpark[tid].rec;
+        return 1;
+    }
+    const ss_thr* r = &s_thr[tid];
+    if (r->state != 1 || r->gen != s_gen) return 0;
+    *out = r->rec;
+    return 1;
+}
+
+int ss_load_set_park(unsigned tid, int at, int tier, uint32_t num, uint32_t obj, const ss_wait_rec* rec,
+                     const ss_sr_root* root, int root_valid, const struct ppu_context* ctx)
+{
+    if (!tid || tid > SS_MAX_TID || !ctx) return -1;
+    ss_lpark* p = &s_lpark[tid];
+    p->at = at; p->tier = tier; p->num = num; p->obj = obj;
+    if (rec) p->rec = *rec; else memset(&p->rec, 0, sizeof p->rec);
+    p->root_valid = root_valid && root;
+    if (p->root_valid) p->root = *root; else memset(&p->root, 0, sizeof p->root);
+    memcpy(&p->ctx, ctx, sizeof p->ctx);
+    p->ctx.reserve_addr = 0;              /* a reservation never survives a load */
+    p->ctx.reserve_valid = 0;
+    InterlockedExchange(&p->valid, 1);
+    return 0;
+}
+
+int ss_loading(void) { return s_loading != 0; }
+
+static uint32_t rd32(uint32_t a)
+{
+    const uint8_t* p = vm_base + a;
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+
+static int is_code(uint32_t a)
+{
+    if (a < 0x10000u || (a & 3u)) return 0;
+    if (s_ppu.is_code) return s_ppu.is_code(a);
+    return a < 0x40000000u;
+}
+
+static const char* link_kind(uint32_t w)
+{
+    const uint32_t op = w >> 26;
+    if (op == 18 && (w & 1u)) return "bl";
+    if (op == 16 && (w & 1u)) return "bcl";
+    if (op == 19 && (w & 0x7FFu) == 0x421u) return "bcctrl";
+    if (op == 19 && (w & 0x7FFu) == 0x021u) return "bclrl";
+    if (w == 0x44000002u) return "sc";
+    return "?";
+}
+
+/* `bl`/`bcl` target of the call word at ra-4 (0 for an indirect call). */
+static uint32_t call_target(uint32_t ra, uint32_t w)
+{
+    const uint32_t op = w >> 26;
+    if (op == 18) {
+        int32_t li = (int32_t)(w & 0x03FFFFFCu);
+        if (li & 0x02000000) li -= 0x04000000;
+        return (w & 2u) ? (uint32_t)li : (ra - 4u) + (uint32_t)li;
+    }
+    if (op == 16) {
+        int32_t bd = (int32_t)(w & 0xFFFCu);
+        if (bd & 0x8000) bd -= 0x10000;
+        return (w & 2u) ? (uint32_t)bd : (ra - 4u) + (uint32_t)bd;
+    }
+    return 0;
+}
+
+/* The ELFv1 back chain: a frame's word 0 is its caller's sp, and a callee
+ * saves its return address at caller_sp + 0x10 -- so the return address of
+ * the function owning frame N is at [[sp_N] + 0x10]. M1 made those slots
+ * exact (the lifter now stores lr before every indirect call, and a 7-minute
+ * slotcheck run measured zero mismatches). Low words: all of it is 32-bit. */
+static void walk_chain(ss_cap_thr* c, const ppu_context* ctx, unsigned tid)
+{
+    const uint32_t lo = (uint32_t)ctx->gpr[1];
+    uint32_t hi = 0;
+    const ppu_thread_info* ti = &g_ppu_threads[tid - 1];
+    if (ti->stack_size && lo >= ti->stack_addr && lo < ti->stack_addr + ti->stack_size)
+        hi = ti->stack_addr + ti->stack_size;
+    else {                                        /* main thread: no recorded range */
+        hi = lo + 0x100000u;
+        if (lo < 0x10000000u && hi > 0x10000000u) hi = 0x10000000u;
+    }
+    c->nf = 0;
+    c->end = "depth";
+    if (!vm_base) { c->end = "no-vm"; return; }
+    uint32_t sp = lo;
+    for (int d = 0; d < SS_CHAIN_MAX; d++) {
+        if (!sp || (sp & 7u) || sp + 8u > hi) { c->end = "range"; return; }
+        const uint32_t bhi = rd32(sp), back = rd32(sp + 4);
+        if (!back && !bhi) { c->end = "root"; return; }
+        if (bhi || back <= sp || back + 0x18u > hi || back - sp > 0x100000u) { c->end = "bad-back"; return; }
+        const uint32_t ra = rd32(back + 0x14);
+        ss_frame* f = &c->f[c->nf++];
+        f->sp = sp; f->ra = ra;
+        f->word = is_code(ra) ? rd32(ra - 4) : 0;
+        sp = back;
+    }
+}
+
+#ifdef _WIN32
+static uintptr_t s_img_lo, s_img_hi;
+static void image_range(void)
+{
+    if (s_img_lo) return;
+    const uint8_t* b = (const uint8_t*)GetModuleHandleA(NULL);
+    const IMAGE_DOS_HEADER* dh = (const IMAGE_DOS_HEADER*)b;
+    const IMAGE_NT_HEADERS* nh = (const IMAGE_NT_HEADERS*)(b + dh->e_lfanew);
+    s_img_lo = (uintptr_t)b;
+    s_img_hi = (uintptr_t)b + nh->OptionalHeader.SizeOfImage;
+}
+
+static uint32_t host_to_guest(uint64_t pc)
+{
+    if (!s_ppu.host_fn_guest || pc < s_img_lo || pc >= s_img_hi) return 0;
+    ULONG64 ib = 0;
+    PRUNTIME_FUNCTION f = RtlLookupFunctionEntry((DWORD64)pc, &ib, NULL);
+    if (!f) return 0;
+    return s_ppu.host_fn_guest((void*)(uintptr_t)(ib + f->BeginAddress));
+}
+
+/* Where is a thread that did not park? Suspend it just long enough to copy its
+ * rip and the top of its host stack (nothing that could take a lock while it
+ * is stopped), then resolve what was copied: the rip, and every stack word
+ * that falls inside a lifted function -- return addresses into the guest
+ * frames it is running, most recent first. */
+static void sample_host(unsigned long host_tid, ss_cap_thr* c)
+{
+    c->nhost = 0; c->host_rip_lifted = 0;
+    if (!host_tid || host_tid == GetCurrentThreadId()) return;
+    image_range();
+    HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION,
+                          FALSE, (DWORD)host_tid);
+    if (!h) return;
+    enum { NW = 2048 };
+    static uint64_t words[NW];
+    uint64_t rip = 0;
+    int nw = 0;
+    if (SuspendThread(h) != (DWORD)-1) {
+        CONTEXT k;
+        memset(&k, 0, sizeof k);
+        k.ContextFlags = CONTEXT_CONTROL;
+        if (GetThreadContext(h, &k)) {
+            rip = k.Rip;
+            MEMORY_BASIC_INFORMATION mi;
+            if (VirtualQuery((void*)(uintptr_t)k.Rsp, &mi, sizeof mi) && mi.State == MEM_COMMIT) {
+                const uintptr_t end = (uintptr_t)mi.BaseAddress + mi.RegionSize;
+                const uintptr_t sp = (uintptr_t)k.Rsp & ~(uintptr_t)7;
+                nw = (int)((end - sp) / 8);
+                if (nw > NW) nw = NW;
+                memcpy(words, (const void*)sp, (size_t)nw * 8);
+            }
+        }
+        ResumeThread(h);
+    }
+    CloseHandle(h);
+    uint32_t g = host_to_guest(rip);
+    if (g) { c->hostbt[c->nhost++] = g; c->host_rip_lifted = 1; }
+    for (int i = 0; i < nw && c->nhost < SS_HOSTBT; i++) {
+        g = host_to_guest(words[i]);
+        if (g && (c->nhost == 0 || c->hostbt[c->nhost - 1] != g)) c->hostbt[c->nhost++] = g;
+    }
+}
+#endif
+
+static void capture_threads(uint64_t t_ppu)
+{
+    s_cap.nthr = 0; s_cap.total = 0; s_cap.parked = 0; s_cap.tier1 = 0; s_cap.tier2 = 0;
+    s_cap.last_tid = 0; s_cap.strict_n = 0; s_cap.strict_ok = 0;
+    uint64_t t_last = 0;
+    const uint64_t now = ss_now_us();
+    for (int i = 0; i < PPU_THREAD_MAX; i++) {
+        const ppu_thread_info* ti = &g_ppu_threads[i];
+        if (ti->state != PPU_THREAD_STATE_RUNNING && ti->state != PPU_THREAD_STATE_DETACHED) continue;
+        const unsigned tid = (unsigned)i + 1;
+        ss_thr* r = &s_thr[tid];
+        ss_cap_thr* c = &s_cap.thr[s_cap.nthr++];
+        memset(c, 0, sizeof *c);
+        c->tid = tid;
+        strncpy(c->name, ti->name[0] ? ti->name : (tid == 1 ? "main" : "?"), sizeof c->name - 1);
+        s_cap.total++;
+        if (r->state == 1 && r->gen == s_gen) {
+            c->parked = 1;
+            s_cap.parked++;
+            c->at = r->at; c->tier = r->tier; c->num = r->num; c->obj = r->obj;
+            c->ms = r->t_park_us > t_ppu ? (double)(r->t_park_us - t_ppu) / 1000.0 : 0.0;
+            if (r->t_park_us > t_last) { t_last = r->t_park_us; s_cap.last_tid = (int)tid; }
+            if (r->tier >= 2) s_cap.tier2++; else s_cap.tier1++;
+            c->cb = r->cb_depth; c->br = r->br_depth; c->icall = r->icall_depth; c->vcall = r->vcall_sp;
+            c->tramp = r->tramp;
+            memcpy(c->brr, r->br, sizeof c->brr);
+            c->r1 = (uint32_t)r->ctx.gpr[1]; c->lr = (uint32_t)r->ctx.lr;
+            c->sc_ra = r->ctx.sc_ra; c->r2 = (uint32_t)r->ctx.gpr[2];
+            const int sc = r->at == SS_AT_SC || (r->at == SS_IN_WAIT && ss_wait_is_syscall((int)r->num));
+            c->ra0 = sc ? c->sc_ra : c->lr;
+            c->ra0_word = (vm_base && is_code(c->ra0)) ? rd32(c->ra0 - 4) : 0;
+            walk_chain(c, &r->ctx, tid);
+            if (s_sr_ops.walk && vm_base) {
+                /* The walk a save would run: continuations + the stack, up to
+                 * the root (its record, if this thread entered one). */
+                c->strict_rec = s_roots[tid].valid != 0;
+                s_sr_ops.walk(&r->ctx, sc ? SS_AT_SC : SS_AT_HLE,
+                              c->strict_rec ? &s_roots[tid].r : 0, &c->strict);
+                c->strict_on = 1;
+                s_cap.strict_n++;
+                s_cap.strict_ok += c->strict.verdict == SS_SR_OK;
+            }
+        } else {
+            c->sc_inflight  = s_ppu.sc_inflight && tid < (unsigned)s_ppu.inflight_n ? s_ppu.sc_inflight[tid] : 0;
+            c->hle_inflight = s_ppu.hle_inflight && tid < (unsigned)s_ppu.inflight_n ? s_ppu.hle_inflight[tid] : 0;
+            c->prof_pc = ti->prof_pc;
+            c->tcia = (uint32_t)ti->ctx.cia; c->tlr = (uint32_t)ti->ctx.lr;   /* racy; main's is not live */
+            if (r->visit_gen == s_gen && r->visits) {
+                c->visits = r->visits; c->visit_at = r->visit_at; c->visit_num = r->visit_num;
+                c->visit_refuse = r->visit_refuse; c->visit_lr = r->visit_lr;
+                c->visit_ago_ms = (double)(now - r->visit_us) / 1000.0;
+            }
+#ifdef _WIN32
+            sample_host(tid == 1 && s_ppu.main_host_tid ? s_ppu.main_host_tid : (unsigned long)ti->host_tid, c);
+#endif
+        }
+    }
+    s_cap.ppu_ms = t_last > t_ppu ? (double)(t_last - t_ppu) / 1000.0 : 0.0;
+}
+
+static void capture_spu(uint64_t t0)
+{
+    s_cap.nspu = 0; s_cap.spu_parked = 0;
+    for (int i = 0; i < SS_SPU_MAX; i++) {
+        ss_spu_slot* s = &s_spu[i];
+        if (s->used != 1) continue;
+        int k = s_cap.nspu++;
+        s_cap.spu[k].tid = s->tid; s_cap.spu[k].group = s->group; s_cap.spu[k].kind = s->kind;
+        s_cap.spu[k].irq_skips = s->irq_skips;
+        if (s->state == 1 && s->gen == s_spu_gen) {
+            s_cap.spu[k].parked = 1; s_cap.spu_parked++;
+            s_cap.spu[k].where = s->where; s_cap.spu[k].d = s->d; s_cap.spu[k].foreign = s->foreign;
+            s_cap.spu[k].ms = s->t_park_us > t0 ? (double)(s->t_park_us - t0) / 1000.0 : 0.0;
+        } else {
+            s_cap.spu[k].parked = 0; s_cap.spu[k].where = 0; s_cap.spu[k].foreign = 0;
+            memset(&s_cap.spu[k].d, 0, sizeof s_cap.spu[k].d);
+            if (s->ctx && s_spu_ops && s_spu_ops->describe) s_spu_ops->describe(s->ctx, &s_cap.spu[k].d);
+        }
+    }
+    s_cap.spu_foreign = s_spu_foreign;
+    s_cap.spu_foreign_ctx = s_spu_foreign_ctx;
+    s_cap.spu_foreign_pc = s_spu_foreign_pc;
+    s_cap.spu_foreign_img = s_spu_foreign_img;
+}
