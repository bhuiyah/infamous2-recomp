+/* A fake XInput (slot 0 only), for the backend-off path. */
+static XINPUT_VIBRATION s_fx_vib;
+static int s_fx_sets, s_fx_present = 1;
+static DWORD WINAPI fx_get(DWORD i, XINPUT_STATE* st)
+{
+    if (i != 0 || !s_fx_present) return ERROR_DEVICE_NOT_CONNECTED;
+    memset(st, 0, sizeof *st);
+    st->dwPacketNumber = 1;
+    return ERROR_SUCCESS;
+}
+static DWORD WINAPI fx_set(DWORD i, XINPUT_VIBRATION* v)
+{
+    if (i == 0) { s_fx_vib = *v; s_fx_sets++; }
+    return ERROR_SUCCESS;
+}
