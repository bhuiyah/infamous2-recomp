+/* ---- the fallback of the fa/fs/fm/fma/fms/fnms fast paths (AVX2 + FMA3) ----
+ * spu_<op>_vx(a, b[, c]) returns exactly what spu_<op>_ref returns, lane for
+ * lane, in every MXCSR mode (round-to-nearest / toward zero, with or without
+ * FTZ/DAZ). It runs whenever a lane of the fast path touches exponent 255 or
+ * overflows: every lane of a reciprocal or rsqrt Newton step on a zero
+ * (frest(0) = 0x7FFFFFFF, fi of it an exponent-255 number), and whatever is
+ * computed from the saturated result. The reference's lane loop (which clang
+ * vectorizes, to ~200 instructions and ten callee-saved xmm spills) took
+ * 39-57 TSC ticks per call (Zen 5, back to back); this takes 13-17 under
+ * round-toward-zero.
+ * Per lane the reference keeps the host result f (the same IEEE op, so the
+ * same bits in the same mode) when no operand is a denormal and f is not
+ * inf/NaN, a denormal, +-FLT_MAX or +-2^-126; otherwise it computes in double
+ * from the exact SPU values: d2fx(da*db), or d2fx2(u, v) = the truncation of
+ * s = u + v, less 1 ulp when the two-sum error of s has the sign opposite to
+ * s and s is an SPU single (s rounded up in magnitude).
+ * - Rounding toward zero (MXCSR RC = 11: every SPU host thread of an
+ *   SPU_HELPERS_FP_RZDAZ build, SPU_FPMODE=rz otherwise) makes all of that
+ *   the double path without the correction, in every lane:
+ *   . RZ(u + v) truncated to 24 bits is the truncation of the exact u + v
+ *     (two truncations compose; flush/saturation agree since 2^-126 and
+ *     2^129 are doubles), and the correction never fires: with x = u + v > 0
+ *     (x < 0 is symmetric) the two-sum err is >= 0 under RZ. Proof: if s ==
+ *     x, err = 0. Else if |u| >= |v|, s - u is exact (Sterbenz), so err =
+ *     RZ(x - s) >= 0. Else v > |u|; let d >= 0 be the rounding error of
+ *     bb = RZ(s - u): v - bb = (x - s) + d and s - bb = u + d, so t1 =
+ *     RZ(s - bb) is in [u, u + d] (u >= 0) or exactly u + d (u < 0:
+ *     Sterbenz, s and bb are in [v/2, v]); either way t2 = RZ(u - t1) is a
+ *     float with |t2| <= d, so t3 = RZ(v - bb) >= |t2| and err = RZ(t2 + t3)
+ *     >= 0. Every value is a multiple of 2^-298: no double denormal arises
+ *     and DAZ/FTZ change nothing. (Also checked exhaustively in p-bit
+ *     formats, p = 3..11, and on 10^8 SPU-shaped sums at p = 53.)
+ *   . a lane where the reference keeps f has no denormal operand and a
+ *     normal f, which under RZ is that same truncation.
+ * - Rounding to nearest: f, the operand test and the double path op for op
+ *   (two-sum and correction included), in four double lanes, with two
+ *   shortcuts, both exact: an exponent-255 operand needs no test (the host
+ *   reads it as inf/NaN, any op on one gives inf/NaN, which the f test
+ *   rejects); a zero f, kept by the reference as +0, is taken from the
+ *   double path, which gives +0 there too (f == +-0 means |exact| < 2^-126,
+ *   which d2fx flushes, and d2fx2's s reaches 2^-126 only by rounding up,
+ *   which its correction undoes: r - 1 has exponent 0, giving +0).
+ * fx2d decodes exponent 255 as 254 and doubles the result (exact), and
+ * e == 0 as +0: the sign of a zero operand cannot reach a result (a zero
+ * product or addend leaves the sum exact and the two-sum error 0). The
+ * operands are opaque so that no float op here is folded with constants
+ * (see SPU__OPAQUE). */
+#    if defined(__clang__) || defined(__GNUC__)
+#      define SPU__VX_OPAQUE(v) __asm__("" : "+x"(v))
+#    else
+#      define SPU__VX_OPAQUE(v) ((void)0)
+#    endif
+/* Is the rounding toward zero? A probe, not stmxcsr (reading MXCSR waits for
+ * the FP pipeline: +12 ticks a call): +-(1 + 0.75 ulp) stays +-1 only under
+ * RZ (RN rounds both away from 1, RD the negative one, RU the positive one). */
+SPU_FORCEINLINE int spu__fx_rz(void) {
+    __m128 x = _mm_setr_ps(1.0f, -1.0f, 1.0f, -1.0f);
+    SPU__VX_OPAQUE(x);
+    return _mm_movemask_ps(_mm_cmpeq_ps(_mm_add_ps(x, _mm_setr_ps(0x1.8p-24f, -0x1.8p-24f, 0x1.8p-24f, -0x1.8p-24f)), x)) == 0xF;
+}
+SPU_FORCEINLINE __m256d spu__fx2d_v(__m128i x) {                   /* spu__fx2d, 4 lanes */
+    const __m128i e8 = _mm_and_si128(x, spu__k(0x7F800000u));
+    const __m128i big = _mm_cmpeq_epi32(e8, spu__k(0x7F800000u));
+    x = _mm_andnot_si128(_mm_cmpeq_epi32(e8, _mm_setzero_si128()), _mm_sub_epi32(x, _mm_and_si128(big, spu__k(0x00800000u))));
