+/* Per-monitor DPI awareness (v2), before the process's first window: client
+ * sizes, the monitor rectangle and the cursor clip are then real pixels, a
+ * 2560x1080 fullscreen window is 2560x1080, and Windows does not bitmap-scale
+ * the window on a scaled monitor. dpi_aware = 0 in display.ini turns it off. */
+static void disp_dpi_aware(void)
+{
+    if (dcfg_parse_bool(dcfg_get(&s_dcfg, "dpi_aware")) == 0) {
+        printf("[display] DPI awareness off (dpi_aware = 0)\n");
+        return;
+    }
+    typedef BOOL (WINAPI *ctx_fn)(HANDLE);
+    HMODULE u = GetModuleHandleA("user32.dll");
+    ctx_fn f = u ? (ctx_fn)(void*)GetProcAddress(u, "SetProcessDpiAwarenessContext") : NULL;
+    if (f) {
+        if (f((HANDLE)(intptr_t)-4)) return;           /* DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2 */
+        if (GetLastError() == ERROR_ACCESS_DENIED) return;   /* already set (manifest) */
+    }
+    SetProcessDPIAware();                               /* pre-1703 Windows: system-aware */
+}
+
+static BOOL CALLBACK disp_list_mon(HMONITOR m, HDC dc, LPRECT r, LPARAM lp)
+{
+    (void)dc; (void)r;
+    int* idx = (int*)lp;
+    MONITORINFO mi;
+    mi.cbSize = sizeof mi;
+    if (GetMonitorInfoA(m, &mi))
+        printf("[display] monitor %d: %ldx%ld at (%ld,%ld)%s\n", ++*idx,
+               mi.rcMonitor.right - mi.rcMonitor.left, mi.rcMonitor.bottom - mi.rcMonitor.top,
+               mi.rcMonitor.left, mi.rcMonitor.top, (mi.dwFlags & MONITORINFOF_PRIMARY) ? " primary" : "");
+    return TRUE;
+}
