+static void test_mips_bc(void)
+{
+    const uint8_t src[2 * 2 * 4] = { 0, 10, 255, 0,   255, 20, 255, 255,   0, 30, 0, 255,   255, 40, 0, 255 };
+    uint8_t d[4];
+    tp_mip_down8(src, 2, 2, 4, d, 0);
+    CHECK(d[0] == 128 && d[1] == 25 && d[2] == 128 && d[3] == 191);                          /* gamma-space box, rounded */
+    tp_mip_down8(src, 2, 2, 4, d, 1);
+    CHECK(d[0] == 188 && d[1] == 27 && d[2] == 188 && d[3] == 191);                          /* linear light (sRGB 0/255 -> 188), alpha plain */
+    uint8_t row[3 * 1 * 1] = { 9, 0, 0 }; uint8_t o1[1];
+    tp_mip_down8(row, 3, 1, 1, o1, 0); CHECK(o1[0] == 5);                                     /* 3x1 -> 1x1: first pair (odd column dropped) */
+    const uint16_t s16[4] = { 0, 65535, 65535, 65535 }; uint16_t o16[1];
+    tp_mip_down16(s16, 2, 2, 1, o16); CHECK(o16[0] == 49151);
+    /* BC1: c0 = pure red (0xF800), c1 = pure blue (0x001F), indices 0,1,2,3 in row 0 */
+    const uint8_t blk[8] = { 0x00, 0xF8, 0x1F, 0x00, 0xE4, 0x00, 0x00, 0x00 };
+    uint8_t px[4 * 4 * 4];
+    tp_bc_decode(px, 16, blk, 4, 4, 1);
+    CHECK(px[0] == 255 && px[2] == 0 && px[3] == 255);                 /* index 0: red */
+    CHECK(px[4] == 0 && px[6] == 255);                                 /* index 1: blue */
+    CHECK(px[8] == 170 && px[10] == 85);                               /* index 2: 2/3 red + 1/3 blue */
+    CHECK(px[12] == 85 && px[14] == 170);                              /* index 3 */
+    CHECK(px[16] == 255 && px[18] == 0);                               /* row 1: index 0 */
+    /* BC3 alpha: a0 = 255, a1 = 0, index 1 everywhere -> 0 */
+    uint8_t b3[16] = { 255, 0, 0x49, 0x92, 0x24, 0x49, 0x92, 0x24, 0x00, 0xF8, 0x1F, 0x00, 0, 0, 0, 0 };
+    tp_bc_decode(px, 16, b3, 4, 4, 3);
+    CHECK(px[3] == 0 && px[63] == 0 && px[0] == 255);
+}
