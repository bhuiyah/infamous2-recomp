+/* Strict eligibility (engine design 4.2), the part this table can judge:
+ * every RUNNING / DETACHED thread has a park record in this stop (when the
+ * coordinator provides them) and a context to save. */
+static int pput_check(char* why, size_t n)
+{
+    for (int i = 0; i < PPU_THREAD_MAX; i++) {
+        const ppu_thread_info* t = &g_ppu_threads[i];
+        if (!pput_live(t)) continue;
+        const unsigned tid = (unsigned)i + 1;
+        if (g_ppu_ss_park_of) {
+            int at = 0, tier = 0, rv = 0;
+            uint32_t num = 0, obj = 0;
+            const ppu_context* c = NULL;
+            ss_sr_root root;
+            if (!g_ppu_ss_park_of(tid, &at, &tier, &num, &obj, &c, &root, &rv) || !c) {
+                snprintf(why, n, "tid %u '%s' has no park record", tid, t->name);
+                return SS_REASON_THREAD_BUSY;
