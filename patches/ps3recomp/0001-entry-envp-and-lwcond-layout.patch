+        rsx_texture_decode(_map0 + _lp->Offset, _lp->Footprint.RowPitch,
+                           tc_fz_src(&fzs, off + lv[_m].offset, lv[_m].tl.face_bytes),
+                           lv[_m].w, lv[_m].h, &lv[_m].tl, rsx_texture_argb_is_rgba());
+        if (mc->tint) tc_tint_level(_map0 + _lp->Offset, _lp->Footprint.RowPitch, &lv[_m].tl, lv[_m].w, _m);
+    }
+    if (_f == 0 && mc->dump && (mc->dump == key_off || (mc->dump & 0x3FFFFFFFu) == (key_off & 0x3FFFFFFFu)) &&
+        (!mc->dump_w || (mc->dump_w == w && mc->dump_h == h))) {
+        static int nd = 0;
+        if (nd < 16) { tc_mipdump(key_off, off, fmt, lv, nlv, _map0, _fp, vm_base + off, nd); nd++; }
+    }
+    }   /* end per-face conversion */
+    /* TX1 TEX_FENCE: a watched slot, asked again after the conversion read it */
+    if (!fzl && fzw == TC_FZ_WATCH && t->trk_len && tc_wt_written_now(t->trk_off, t->trk_len)) {
+        fzl = 1; tc_fz_lost(key_off, src_span);
+    }
+    off = _off0; mapped = _map0;
+    /* (upload memory stays mapped: the ring is persistent, and an overflow
+     * buffer is released whole at the next batch) */
+
+    if (!fresh) {   /* reused resource: PSR -> COPY_DEST first */
+        D3D12_RESOURCE_BARRIER b = {0};
+        b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b.Transition.pResource = t->res;
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        b.Transition.StateAfter  = D3D12_RESOURCE_STATE_COPY_DEST;
+        b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    } else if (t->ph) tph_activate(t->res);   /* ST1 TEX_PLACED: its upload memory found, its first copy next */
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = t->res; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = _upres; src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    for (u32 _s = 0; _s < _nfaces * nlv; _s++) {
+        dst.SubresourceIndex        = _s;      /* face f (array slice), level m: f * nlv + m */
+        src.PlacedFootprint         = _fp[_s];
+        src.PlacedFootprint.Offset += _upoff;
+        copy_note(__LINE__, &dst, &src); s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &dst, 0, 0, 0, &src, NULL);
+    }
+    if (s_tph.verify && t->ph) {   /* ST1 TEX_PLACED_VERIFY: read the placed texture back (compared next batch) */
+        D3D12_PLACED_SUBRESOURCE_FOOTPRINT _vfp[6u * RSX_MAX_TEXTURE_LEVELS];
+        for (u32 _s = 0; _s < _nfaces * nlv; _s++) { _vfp[_s] = _fp[_s]; }
+        tph_verify_add(t->res, _upres, _upoff, up_total, _nfaces * nlv, _vfp, lv, nlv);
+    }
+    {
+        D3D12_RESOURCE_BARRIER b = {0};
+        b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b.Transition.pResource = t->res;
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+        b.Transition.StateAfter  = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    }
+    /* SRV at heap slot TEX_SRV_BASE+slot (not 1+slot: see DRAW_SRV_BASE) */
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = dxfmt;
+    sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    /* RSX B8 replicates the byte into all four channels (dbgfont's FP reads
+     * coverage from .w); DXGI R8 defaults to (r,0,0,1), so swizzle (R,R,R,R)
+     * = encoded 0x1000 (component 0 in all lanes + always-set bit). ARGB8
+     * keeps the identity mapping. */
+    sv.Shader4ComponentMapping = (basef == 0x81) ? 0x1000 : D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sv.Texture2D.MipLevels = nlv;
+    D3D12_CPU_DESCRIPTOR_HANDLE sh;
+    s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &sh);
+    sh.ptr += (u64)(TEX_SRV_BASE + slot) * s_d3d.srv_inc;
+    if (cube) {
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURECUBE;
+        sv.TextureCube.MipLevels = nlv;
+        sv.TextureCube.MostDetailedMip = 0;
+        sv.TextureCube.ResourceMinLODClamp = 0.0f;
+    }
+    s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, t->res, &sv, sh);
+
+    t->off = off; t->span = src_span; t->vol = vol;
+    t->hash = pre_hash; t->csum = pre_csum;   /* both taken before the conversion read */
+    t->use_batch = s_tc.batch; t->vround = s_tcw.round;
+    if (g_tp_on) tp_note_upload(t, !t->mapped, w, h, fmt, cube, kmips, kpitch, nlv, src_span,
+                                tc_fz_src(&fzs, off, src_span));
+    if (!t->mapped) {                         /* a new key (a stale one keeps its own) */
+        t->key = key_off; t->w = w; t->h = h; t->fmt = fmt; t->cube = cube; t->kmips = kmips;
+        t->kpitch = kpitch;
+        tc_map_insert(slot);
+    }
+    s_tc.st_upload++;
+    s_tc.st_upbytes += up_total;
+    /* [TEXMIP] LN pitch: the CONTROL3 pitch laid out this LINEAR texture's
+     * rows differently from packed -- level 0's when it is wider than the
+     * packed row (every earlier build read level 0 packed), and the levels
+     * below it whenever there are any. The one new layout rule, so it is said
+     * (8 textures at most) whatever the other switches. kpitch is non-zero
+     * only for LN with TEX_MIPS and TEX_PITCH on. */
+    if (kpitch) {
+        const u32 upitch = rsx_texture_uniform_pitch(fmt, w, h, kpitch);
+        const u32 up = (upitch && (upitch != tl.row_bytes || nlv > 1u)) ? upitch : 0u;
+        if (up) {
+            static u32 seen[8]; static int ns = 0; int known = 0;
+            s_tc.st_lnpitch++;
+            for (int i = 0; i < ns; i++) known |= seen[i] == key_off;
+            if (!known && ns < 8) {
+                seen[ns++] = key_off;
+                fprintf(stderr, "[TEXMIP] LN pitch: key 0x%08X src 0x%08X %ux%u fmt 0x%02X, %u level(s): CONTROL3"
+                                " pitch %u, packed row %u -- %s read %u bytes apart (TEX_PITCH=0: packed, as"
+                                " before)%c", key_off, off, w, h, fmt, nlv, kpitch, tl.row_bytes,
+                        up != tl.row_bytes ? "every level's rows" : "levels 1.. rows", up, 10);
+            }
+        }
+    }
+    if (nlv > 1u) {
+        s_tc.st_mipup++;
+        s_tc.st_mipbytes += (u64)_nfaces * (lv[nlv - 1u].offset + lv[nlv - 1u].tl.face_bytes - lv[1].offset);
+    }
+    /* TEX_MIPDBG=<n>: the first n uploads with more than one level (or whose
+     * level count was cut by the dimensions): what was read from where. */
+    if (mc->dbg > 0 && (nlv > 1u || (mc->on && mips > glv))) {
+        static int nl = 0;
+        if (nl++ < mc->dbg) {
+            char lvs[400]; int at = 0;
+            for (u32 m = 1; m < nlv && at < (int)sizeof lvs - 40; m++)
+                at += snprintf(lvs + at, sizeof lvs - (size_t)at, " L%u +0x%X %ux%u", m, lv[m].offset, lv[m].w, lv[m].h);
+            lvs[at] = 0;
+            fprintf(stderr, "[TEXMIP] key 0x%08X src 0x%08X %ux%u fmt 0x%02X%s: format levels %u -> %u in the"
+                            " chain, %u uploaded | %s rows %u B%s | span %u (level 0 %u) |%s%c",
+                    key_off, off, w, h, fmt, cube ? " cube" : "", mips, glv, nlv,
+                    lv[0].tl.swizzled ? "swizzled" : lv[0].tl.compressed ? "blocks" : "linear",
+                    lv[0].tl.row_bytes,
+                    !kpitch ? "" : rsx_texture_uniform_pitch(fmt, w, h, kpitch)
+                        ? " (CONTROL3 pitch, every level)" : " (CONTROL3 pitch narrower than the row: packed)",
+                    src_span,
+                    lv[0].tl.face_bytes, nlv > 1u ? lvs : " level 0 only", 10);
+        }
+    }
+    if (perf_on()) s_tc.st_up_s += perf_now() - _ut0;
+    return slot;
+}
+
+/* ---------------------------------------------------------------------------
+ * Render-to-texture: offscreen RT pool.
+ *
+ * Draws/clears targeting a non-display surface (SET_SURFACE_COLOR_xOFFSET
+ * not registered via cellGcmSetDisplayBuffer) render into a pooled RGBA8
+ * texture keyed by the surface's resolved vm offset; a later draw binding a
+ * texture at that offset samples the RT directly instead of guest memory.
+ * RGBA8 for every RT (even half-float guest surfaces) keeps the existing
+ * PSO/RTV formats -- values clamp to [0,1], which demosaic's RGB data fits.
+ * -----------------------------------------------------------------------*/
+
+/* Constant-slot reuse (vp_record_cb): the slot it last wrote and what that
+ * slot was written from. A record whose constant bank is unchanged since then
+ * (same rsx_state, same vertex_constants_gen), with the same viewport epilogue
+ * and the same projection fallback, points its cb_slot at that slot instead
+ * of storing another 8.4 KB into the write-combined upload heap -- the GPU
+ * reads the same bytes either way. An entry is good only in the parity half
+ * and batch it was written in, and only for a HIGHER record index: slot s is
+ * rewritten only by vp_record_cb(s), which needs draw_count back at s (a batch
+ * end, a record dropped after capture, a clear-path reset), and any index
+ * that does not increase drops the entry first. CB_REUSE=0 turns reuse off;
+ * CB_REUSE_VERIFY=1 also compares the bank itself before reusing. */
+#define VP_CB_EPI_FLOATS 24   /* vp_posscale, vp_posoffset, vp_uc[4] */
+static struct {
+    const rsx_state* st;
+    int   valid;
+    u32   slot, parity, vbatch, gen;
+    int   fix;                          /* garbage-projection fallback applied */
+    float epi[VP_CB_EPI_FLOATS];        /* the epilogue as written */
+    u32   records, reused;              /* PERF=1: [CBREUSE] line */
+    u64   mask[8];                      /* CB_COMPACT: the registers the slot holds */
+    int   full;                         /*   ... all of them */
+    u32   compact;                      /* PERF=1: records written compact */
+    u64   bytes;                        /*   ... and bytes stored, either way */
+    float bank[RSX_MAX_VERTEX_CONSTANTS][4];   /* CB_REUSE_VERIFY=1 only */
+} s_cbr;
+
+/* VPC_NORM=<hex fp id>[:<lo>-<hi>[.<x|y|z|w>]][@<sum>] -- an EXPERIMENT, off
+ * by default: for that fragment program's draws whose vertex-program
+ * constants c[lo..hi] (default 462-466, z) sum to within 3% of <sum>
+ * (default 2.0; @0 = any sum), rescale that lane in the draw's own constant
+ * slot so it sums to 1. inFamous 2's glow pyramid (fp 62949BCC) takes each
+ * blur tap's weight from tcN.z = c[466-N].z; in every capture since
+ * 2026-10-05 the horizontal pass of a level has a gain of 1.0 and the
+ * vertical pass exactly 2.0 (fitted from the render targets), so the levels
+ * compound x2 each (x32 at 20x11) and the glow outshines the scene. Whether
+ * the title itself uploads the 2.0 is not settled (tools/rpcs3_probe/
+ * tconst_scan.py reads it from RPCS3); VPC_NORM=62949BCC shows the frame with
+ * those vertical passes at 1.0. The default @2 matters: the same program
+ * blurs the 256x256 water reflection (different VP, vertical gain 0.90), and
+ * normalizing that too would change the water the experiment is judged on.
+ * The draws left alone are logged as well. A rescaled slot is never shared
+ * through CB_REUSE; a draw that is not rescaled records exactly as before. */
+static const rsx_vpc_norm_cfg* vpc_norm_cfg(void)
+{
+    static int init = 0;
+    static rsx_vpc_norm_cfg cfg;
+    if (!init) {
+        init = 1;
+        const char* e = getenv("VPC_NORM");
+        if (e && *e) {
+            if (rsx_vpc_norm_parse(e, &cfg))
+                fprintf(stderr, "[VPCNORM] fp %08X: c[%u..%u].%c rescaled to sum 1 when it sums to %s%.3f "
+                                "(experiment)\n", cfg.fp_id, cfg.lo, cfg.hi, "xyzw"[cfg.lane & 3u],
+                        cfg.from > 0.0f ? "" : "anything but ", (double)(cfg.from > 0.0f ? cfg.from : 1.0f));
+            else
+                fprintf(stderr, "[VPCNORM] cannot parse VPC_NORM=%s (<hex fp id>[:<lo>-<hi>[.lane]][@sum]) "
+                                "-- off\n", e);
+        }
+    }
+    return cfg.fp_id ? &cfg : NULL;
+}
+/* VPC_NORM log: each distinct (target size, VP, sum to 1e-3, rescaled or not)
+ * once -- so a run lists every pass of the program and what was done to it,
+ * whenever it first appears (the menu's passes do not use up the lines). */
+static void vpc_norm_log(const D3D12DrawRecord* dr, float before, float after, int done)
+{
+    static u32 seen[64][3];
+    static int ns = 0;
+    const u32 k0 = (dr->rt_w << 16) ^ dr->rt_h ^ ((u32)done << 31), k1 = dr->vs_hash_rec;
+    const u32 k2 = (before > -1.0e6f && before < 1.0e6f)          /* NaN / huge: one bucket */
+                 ? (u32)(int)(before * 1000.0f + (before < 0 ? -0.5f : 0.5f)) : 0xFFFFFFFFu;
+    for (int i = 0; i < ns; i++)
+        if (seen[i][0] == k0 && seen[i][1] == k1 && seen[i][2] == k2) return;
+    if (ns >= 64) return;
+    seen[ns][0] = k0; seen[ns][1] = k1; seen[ns][2] = k2; ns++;
+    if (done)
+        fprintf(stderr, "[VPCNORM] frame %llu fp %08X vs %08X rt 0x%X %ux%u: lane sum %.4f -> %.4f\n",
+                (unsigned long long)s_d3d.frame_count, dr->fp_id, dr->vs_hash_rec, dr->rt_off,
+                dr->rt_w, dr->rt_h, (double)before, (double)after);
+    else
+        fprintf(stderr, "[VPCNORM] frame %llu fp %08X vs %08X rt 0x%X %ux%u: lane sum %.4f left alone\n",
+                (unsigned long long)s_d3d.frame_count, dr->fp_id, dr->vs_hash_rec, dr->rt_off,
+                dr->rt_w, dr->rt_h, (double)before);
+}
+/* Is this record's bank (the guest's, before it is copied) one VPC_NORM
+ * rescales? */
+static int vpc_norm_hit(const D3D12DrawRecord* dr, const rsx_state* st)
+{
+    const rsx_vpc_norm_cfg* c = vpc_norm_cfg();
+    if (!c || !dr || !st || dr->fp_id != c->fp_id) return 0;
+    const float s = rsx_vpc_lane_sum(&st->vertex_constants[0][0], c->lo, c->hi, c->lane);
+    if (rsx_vpc_norm_wants(c, s)) return 1;
+    vpc_norm_log(dr, s, s, 0);
+    return 0;
+}
+static void vpc_norm_apply(float* bank, const D3D12DrawRecord* dr)
+{
+    const rsx_vpc_norm_cfg* c = vpc_norm_cfg();
+    if (!c || !dr) return;
+    const float s = rsx_vpc_normalize(bank, c->lo, c->hi, c->lane);
+    vpc_norm_log(dr, s, rsx_vpc_lane_sum(bank, c->lo, c->hi, c->lane), 1);
+}
+
+/* ---- Raster geometry (rsx_raster.h; docs/GROUND_TRUTH.md 5.2) ------------
+ * Switches, read once (raster_cfg):
+ *   RASTER_XFORM   1 (default): a draw's x/y transform is the guest's
+ *                  VIEWPORT_SCALE/OFFSET exactly -- fractions, either y
+ *                  direction, a transform reaching past the surface. The D3D
+ *                  viewport carries it (rsx_raster_host_map route 1: o - |s|,
+ *                  2 |s|; the epilogue only mirrors an axis), so libgcm's
+ *                  integer rect inside the target is the old D3D state bit
+ *                  for bit; for a fractional edge, past D3D's viewport range,
+ *                  or under RASTER_VPCLIP 0/2 the viewport is the frame and
+ *                  the VS epilogue carries the map (route 2). The scissor is
+ *                  the pixel-ownership rect.
+ *                  0: the old transform and clip -- the integer
+ *                  VIEWPORT_HORIZONTAL/VERTICAL rect, or the full target when
+ *                  the rect leaves it.
+ *   RASTER_VPCLIP  the viewport's own pixel clip: 1 (default) the image of the
+ *                  NDC square, 2 the integer rect, 0 none (guard band only).
+ *   RASTER_SCISSOR 1 (default): SET_SCISSOR clips draws. 0: ignored (old).
+ *                  RASTER_XFORM=0 with RASTER_SCISSOR=0 is the old path itself
+ *                  (render_frame's integer-rect D3D viewport and scissor).
+ *   RASTER_CLEAR   1 (default): CLEAR_SURFACE writes only scissor & surface
+ *                  clip. 0: the whole surface (old).
+ *   RASTER_LOG     1 (default): each distinct draw state whose transform or
+ *                  pixel ownership differs from the old path (24 lines) and
+ *                  each clipped clear (16); 2: also a count every 20000 draws;
+ *                  0: silent.
+ *   FP_WPOS        1: f[WPOS] in SHADER_WINDOW's convention (fp_window in b1).
+ *                  0 (default): SV_Position as before -- no title program
+ *                  reads WPOS (GROUND_TRUTH 3.2), so rule 2 keeps it off. */
+typedef struct { int xform, vpclip, scissor, clear, log, wpos; } RasterCfg;
+static int raster_env(const char* name, int def)
+{
+    const char* e = getenv(name);
+    return (e && *e) ? atoi(e) : def;
+}
+static const RasterCfg* raster_cfg(void)
+{
+    static RasterCfg c;
+    static int init = 0;
+    if (!init) {
+        c.xform   = raster_env("RASTER_XFORM", 1) != 0;
+        c.vpclip  = raster_env("RASTER_VPCLIP", RSX_VPCLIP_FOOTPRINT);
+        if (c.vpclip < RSX_VPCLIP_NONE || c.vpclip > RSX_VPCLIP_RECT) c.vpclip = RSX_VPCLIP_FOOTPRINT;
+        c.scissor = raster_env("RASTER_SCISSOR", 1) != 0;
+        c.clear   = raster_env("RASTER_CLEAR", 1) != 0;
+        c.log     = raster_env("RASTER_LOG", 1);
+        c.wpos    = raster_env("FP_WPOS", 0) == 1;
+        rsx_fp_set_wpos_window(c.wpos);   /* before any decompile: draws record first */
+        shadow_filter_cfg();              /* the same: the shadow_filter row, once */
+        init = 1;
+        fprintf(stderr, "[RASTER] RASTER_XFORM=%d RASTER_VPCLIP=%d RASTER_SCISSOR=%d RASTER_CLEAR=%d "
+                        "FP_WPOS=%d (docs/GROUND_TRUTH.md 5.2)\n",
+                c.xform, c.vpclip, c.scissor, c.clear, c.wpos);
+    }
+    return &c;
+}
+/* The shader list's / kicks' decompiles see the same f[WPOS] mode. */
+static void sl_raster_init(void) { (void)raster_cfg(); }
+static void raster_regs(const rsx_state* st, rsx_raster_regs* g)
+{
+    g->sx = st->viewport_scale[0];  g->sy = st->viewport_scale[1];
+    g->ox = st->viewport_offset[0]; g->oy = st->viewport_offset[1];
+    g->vx = st->viewport_x; g->vy = st->viewport_y; g->vw = st->viewport_w; g->vh = st->viewport_h;
+    g->scx = st->scissor_x; g->scy = st->scissor_y; g->scw = st->scissor_w; g->sch = st->scissor_h;
+    g->cx = st->surface_clip_x; g->cy = st->surface_clip_y;
+    g->cw = st->surface_clip_w; g->ch = st->surface_clip_h;
+}
+static u32 raster_hash(const void* p, size_t n, u32 h)
+{
+    const unsigned char* b = (const unsigned char*)p;
+    for (size_t i = 0; i < n; i++) h = (h ^ b[i]) * 16777619u;
+    return h;
+}
+/* The old path's D3D viewport (= its scissor) for a draw on a fw x fh frame:
+ * the integer rect when it fits, else the whole frame (render_frame). */
+static rsx_rect raster_old_rect(const D3D12DrawRecord* dr, u32 fw, u32 fh)
+{
+    if (dr->vp_w >= 2 && dr->vp_h >= 2 &&
+        (float)(dr->vp_x + dr->vp_w) <= (float)fw + 0.5f &&
+        (float)(dr->vp_y + dr->vp_h) <= (float)fh + 0.5f)
+        return rsx_rect_xywh(dr->vp_x, dr->vp_y, dr->vp_w, dr->vp_h);
+    return rsx_rect_xywh(0, 0, fw, fh);
+}
+static struct { u32 draws, xform, own, empty, epi; } s_rs_stat;
+/* A draw's raster state at record time (vp_record_cb, after dr->rt_w/rt_h and
+ * vp_* are set). The frame (route 2's viewport) is the surface clip (the
+ * offscreen slot's size) or, for a display target, the backbuffer -- any
+ * frame works as long as the replay's D3D viewport is the same one, so the
+ * viewport is stored (rs_vp). */
+/* PF3 RASTER_MEMO (default 1; 0 = every draw computes it, as before): the
+ * previous record's raster state, kept with every input it was computed from --
+ * the guest registers (raster_regs), the frame and the record's viewport rect
+ * (raster_old_rect) -- byte for byte. A record with the same inputs gets the
+ * same outputs (rs_vp, rs_k, rs_own, the route; the RASTER_LOG comparison's
+ * xd / od / em), copied: consecutive draws of a pass rarely change any of
+ * them, and the per-draw work (the RASTER_LOG comparison and its FNV hash of
+ * the registers) was ~0.4 ms of the heavy pier view's walker frame. Logging is
+ * unchanged: the previous identical record already found or added its hash
+ * (or the 24-entry list was full), so a repeat never prints; the statistics
+ * count every record as before. Not kept when the "unusable" warning ran (its
+ * counter decides per call). PF3_VERIFY=1 recomputes every reused one. */
+static int raster_memo_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RASTER_MEMO"); on = (e && *e == '0') ? 0 : 1; }
+    return on;
+}
+static struct {
+    int valid;
+    rsx_raster_regs g; u32 fw, fh, vx, vy, vw, vh;        /* the inputs */
+    float rs_vp[4], rs_k[4]; rsx_rect rs_own;             /* the record's outputs */
+    int route, xd, od, em;                                /* RASTER_LOG's comparison */
+} s_rsm;
+static void raster_record_draw_full(D3D12DrawRecord* dr, const rsx_state* st, int memo);
+static void raster_record_draw(D3D12DrawRecord* dr, const rsx_state* st)
+{
+    if (!raster_memo_on()) { raster_record_draw_full(dr, st, 0); return; }
+    const RasterCfg* c = raster_cfg();
+    dr->rs_on = 0;
+    if (!st || (!c->xform && !c->scissor)) return;      /* the old path, as it was */
+    rsx_raster_regs g;
+    raster_regs(st, &g);
+    const u32 fw = dr->rt_w ? dr->rt_w : s_d3d.width, fh = dr->rt_h ? dr->rt_h : s_d3d.height;
+    if (!(s_rsm.valid && s_rsm.fw == fw && s_rsm.fh == fh && s_rsm.vx == dr->vp_x && s_rsm.vy == dr->vp_y &&
+          s_rsm.vw == dr->vp_w && s_rsm.vh == dr->vp_h && !memcmp(&s_rsm.g, &g, sizeof g))) {
+        raster_record_draw_full(dr, st, 1);
+        return;
+    }
+    memcpy(dr->rs_vp, s_rsm.rs_vp, sizeof dr->rs_vp);
+    memcpy(dr->rs_k, s_rsm.rs_k, sizeof dr->rs_k);
+    dr->rs_own = s_rsm.rs_own;
+    dr->rs_on = 1;
+    if (pf3_verify_on()) {                 /* the old computation, compared byte for byte */
+        float vp[4], k[4];
+        const int xf = c->xform;
+        rsx_raster_regs g2 = g; int vpclip = c->vpclip;
+        const rsx_rect old = raster_old_rect(dr, fw, fh);
+        if (!xf) {
+            float s[2], o[2];
+            rsx_raster_rect_xform((unsigned)old.x0, (unsigned)old.y0, (unsigned)(old.x1 - old.x0),
+                                  (unsigned)(old.y1 - old.y0), s, o);
+            g2.sx = s[0]; g2.sy = s[1]; g2.ox = o[0]; g2.oy = o[1];
+            vpclip = RSX_VPCLIP_FOOTPRINT;
+        }
+        const int route = rsx_raster_host_map(g2.sx, g2.sy, g2.ox, g2.oy, fw, fh, vpclip != RSX_VPCLIP_FOOTPRINT,
+                                              vp, k);
+        const rsx_rect own = rsx_raster_draw_own(&g2, vpclip, c->scissor);
+        const u8* a[3] = { (const u8*)vp, (const u8*)k, (const u8*)&own };
+        const u8* b[3] = { (const u8*)dr->rs_vp, (const u8*)dr->rs_k, (const u8*)&dr->rs_own };
+        const size_t n[3] = { sizeof vp, sizeof k, sizeof own };
+        for (int j = 0; j < 3; j++)
+            for (size_t i = 0; i < n[j]; i++) s_pf3v.rs_diff += a[j][i] != b[j][i];
+        s_pf3v.rs_diff += route != s_rsm.route;
+        s_pf3v.rs_cmp++;
+    }
+    if (!c->log) return;
+    s_rs_stat.epi += (u32)(s_rsm.route == RSX_RASTER_ROUTE_EPILOGUE);
+    s_rs_stat.draws++; s_rs_stat.xform += (u32)s_rsm.xd; s_rs_stat.own += (u32)s_rsm.od;
+    s_rs_stat.empty += (u32)s_rsm.em;
+    if (c->log >= 2 && s_rs_stat.draws >= 20000u) {
+        fprintf(stderr, "[RASTER] %u draws: %u with a transform the old viewport did not give, %u with other "
+                        "pixels, %u empty, %u through the VS epilogue map\n", s_rs_stat.draws, s_rs_stat.xform,
+                s_rs_stat.own, s_rs_stat.empty, s_rs_stat.epi);
+        memset(&s_rs_stat, 0, sizeof s_rs_stat);
+    }
+}
+/* RASTER_MEMO: a record's raster inputs and outputs, for the next record. */
+static void rsm_keep(const D3D12DrawRecord* dr, const rsx_raster_regs* g_in, u32 fw, u32 fh, int route,
+                     int xd, int od, int em)
+{
+    s_rsm.g = *g_in; s_rsm.fw = fw; s_rsm.fh = fh;
+    s_rsm.vx = dr->vp_x; s_rsm.vy = dr->vp_y; s_rsm.vw = dr->vp_w; s_rsm.vh = dr->vp_h;
+    memcpy(s_rsm.rs_vp, dr->rs_vp, sizeof s_rsm.rs_vp);
+    memcpy(s_rsm.rs_k, dr->rs_k, sizeof s_rsm.rs_k);
+    s_rsm.rs_own = dr->rs_own; s_rsm.route = route;
+    s_rsm.xd = xd; s_rsm.od = od; s_rsm.em = em;
+    s_rsm.valid = 1;
+}
+static void raster_record_draw_full(D3D12DrawRecord* dr, const rsx_state* st, int memo)
+{
+    const RasterCfg* c = raster_cfg();
+    dr->rs_on = 0;
+    if (memo) s_rsm.valid = 0;
+    if (!st || (!c->xform && !c->scissor)) return;      /* the old path, as it was */
+    rsx_raster_regs g;
+    raster_regs(st, &g);
+    const rsx_raster_regs g_in = g;                     /* RASTER_MEMO's key (g changes below) */
+    const u32 fw = dr->rt_w ? dr->rt_w : s_d3d.width, fh = dr->rt_h ? dr->rt_h : s_d3d.height;
+    /* The old path's D3D viewport: the integer rect, or the frame when the
+     * rect leaves it. Its pixels are that rect; as a transform it is route 1
+     * of that rect, i.e. the same D3D viewport (test_raster_warp
+     * "libgcm_equals_old_path"). */
+    const rsx_rect old = raster_old_rect(dr, fw, fh);
+    int xf = c->xform, vpclip = c->vpclip, warned = 0;
+    if (xf && !rsx_raster_xform_valid(g.sx, g.sy, g.ox, g.oy)) {
+        static int n = 0;
+        warned = 1;
+        if (n++ < 4)
+            fprintf(stderr, "[RASTER] VIEWPORT_SCALE (%g, %g) / OFFSET (%g, %g) unusable (never programmed, "
+                            "zero or not finite): fp=0x%X keeps the integer viewport rect %u,%u %ux%u\n",
+                    (double)g.sx, (double)g.sy, (double)g.ox, (double)g.oy, dr->fp_addr,
+                    g.vx, g.vy, g.vw, g.vh);
+        xf = 0;
+    }
+    if (!xf) {                      /* RASTER_XFORM=0: the old transform and its clip */
+        float s[2], o[2];
+        rsx_raster_rect_xform((unsigned)old.x0, (unsigned)old.y0, (unsigned)(old.x1 - old.x0),
+                              (unsigned)(old.y1 - old.y0), s, o);
+        g.sx = s[0]; g.sy = s[1]; g.ox = o[0]; g.oy = o[1];
+        vpclip = RSX_VPCLIP_FOOTPRINT;
+    }
+    /* Route 1 (the D3D viewport) clips x/y to the NDC square's image, which is
+     * RASTER_VPCLIP=1's ownership; 0 and 2 need the frame-sized route 2. */
+    const int route = rsx_raster_host_map(g.sx, g.sy, g.ox, g.oy, fw, fh, vpclip != RSX_VPCLIP_FOOTPRINT,
+                                          dr->rs_vp, dr->rs_k);
+    dr->rs_own = rsx_raster_draw_own(&g, vpclip, c->scissor);
+    dr->rs_on = 1;
+    if (!c->log) { if (memo && !warned) rsm_keep(dr, &g_in, fw, fh, route, 0, 0, 0); return; }
+    s_rs_stat.epi += (u32)(route == RSX_RASTER_ROUTE_EPILOGUE);
+    /* Against the old path: its transform is the one its D3D viewport rect
+     * stands for, its pixels that rect. */
+    float os[2], oo[2];
+    rsx_raster_rect_xform((unsigned)old.x0, (unsigned)old.y0, (unsigned)(old.x1 - old.x0),
+                          (unsigned)(old.y1 - old.y0), os, oo);
+    const int xd = os[0] != g.sx || os[1] != g.sy || oo[0] != g.ox || oo[1] != g.oy;
+    const rsx_rect own = rsx_rect_and(dr->rs_own, rsx_rect_xywh(0, 0, fw, fh));
+    const int od = !rsx_rect_eq(own, old), em = rsx_rect_empty(own);
+    if (memo && !warned) rsm_keep(dr, &g_in, fw, fh, route, xd, od, em);
+    s_rs_stat.draws++; s_rs_stat.xform += (u32)xd; s_rs_stat.own += (u32)od; s_rs_stat.empty += (u32)em;
+    if (xd || od) {
+        static u32 seen[24];
+        static int ns = 0;
+        u32 h = raster_hash(&g, sizeof g, 2166136261u);
+        h = raster_hash(&fw, sizeof fw, h); h = raster_hash(&fh, sizeof fh, h);
+        int f = 0;
+        for (int i = 0; i < ns; i++) if (seen[i] == h) f = 1;
+        if (!f && ns < 24) {
+            seen[ns++] = h;
+            fprintf(stderr, "[RASTER] draw fp=0x%X rt=0x%X %ux%u: s=(%g, %g) o=(%g, %g) rect %u,%u %ux%u "
+                            "scissor %u,%u %ux%u clip %u,%u %ux%u -> owns [%d,%d)x[%d,%d)%s%s, D3D viewport "
+                            "(%g, %g) %gx%g%s; old: viewport [%d,%d)x[%d,%d)\n",
+                    dr->fp_addr, dr->rt_off, fw, fh, (double)g.sx, (double)g.sy, (double)g.ox, (double)g.oy,
+                    g.vx, g.vy, g.vw, g.vh, g.scx, g.scy, g.scw, g.sch, g.cx, g.cy, g.cw, g.ch,
+                    own.x0, own.x1, own.y0, own.y1, xd ? " TRANSFORM DIFFERS" : "", em ? " EMPTY" : "",
+                    (double)dr->rs_vp[0], (double)dr->rs_vp[1], (double)dr->rs_vp[2], (double)dr->rs_vp[3],
+                    route == RSX_RASTER_ROUTE_EPILOGUE ? " + VS epilogue map" : "",
+                    old.x0, old.x1, old.y0, old.y1);
+        }
+    }
+    if (c->log >= 2 && s_rs_stat.draws >= 20000u) {
+        fprintf(stderr, "[RASTER] %u draws: %u with a transform the old viewport did not give, %u with other "
+                        "pixels, %u empty, %u through the VS epilogue map\n", s_rs_stat.draws, s_rs_stat.xform,
+                s_rs_stat.own, s_rs_stat.empty, s_rs_stat.epi);
+        memset(&s_rs_stat, 0, sizeof s_rs_stat);
+    }
+}
+/* A clear's rect at record time (the three CLEAR_SURFACE record sites, after
+ * the record's rt_w/rt_h are set). */
+static void raster_record_clear(D3D12DrawRecord* dr)
+{
+    const RasterCfg* c = raster_cfg();
+    const rsx_state* st = s_d3d.current_rsx_state;
+    dr->rs_on = 0;
+    if (!c->clear || !st) return;
+    rsx_raster_regs g;
+    raster_regs(st, &g);
+    dr->rs_own = rsx_raster_clear_own(&g);
+    dr->rs_on = 1;
+    const u32 fw = dr->rt_w ? dr->rt_w : s_d3d.width, fh = dr->rt_h ? dr->rt_h : s_d3d.height;
+    if (c->log && !rsx_rect_covers(dr->rs_own, fw, fh)) {
+        static int n = 0;
+        if (n++ < 16)
+            fprintf(stderr, "[RASTER] clear mask 0x%X of 0x%X (%ux%u, display 0x%X): scissor %u,%u %ux%u "
+                            "& clip %u,%u %ux%u -> [%d,%d)x[%d,%d)%s\n",
+                    dr->clr_mask, dr->rt_off, fw, fh, dr->disp_raw, g.scx, g.scy, g.scw, g.sch,
+                    g.cx, g.cy, g.cw, g.ch, dr->rs_own.x0, dr->rs_own.x1, dr->rs_own.y0, dr->rs_own.y1,
+                    rsx_rect_empty(dr->rs_own) ? " EMPTY: nothing cleared" : "");
+    }
+}
+/* May the next display depth/stencil clear fold into lr (d3d12_clear)? Only
+ * with the same rect. */
+static int raster_clear_same(const D3D12DrawRecord* lr)
+{
+    const RasterCfg* c = raster_cfg();
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!c->clear || !st) return !lr->rs_on;
+    rsx_raster_regs g;
+    raster_regs(st, &g);
+    return lr->rs_on && rsx_rect_eq(lr->rs_own, rsx_raster_clear_own(&g));
+}
+
+/* Snapshot the VP constant bank + viewport epilogue for one draw into its
+ * vp_cb slot, or point the record at the previous record's slot when that
+ * holds exactly the same bytes (s_cbr); dr->cb_slot names the slot used.
+ * Runs at record time so every draw keeps the constants that
+ * were live when the guest issued it. */
+static void vp_record_cb(u32 slot, int vs_idx, D3D12DrawRecord* dr)
+{
+    const rsx_state* st = s_d3d.current_rsx_state;
+    /* ZPASS counter segment and texture-cache epoch (rsx_report.c). */
+    if (dr) { extern u32 rsx_report_draw_tag(void); extern u32 rsx_report_tex_epoch(void);
+              dr->zp_seg = rsx_report_draw_tag(); dr->tinv_epoch = rsx_report_tex_epoch(); }
+    /* Depth/stencil state and zeta surface (depth model). */
+    if (dr) ds_record(dr, st);
+    /* x/y transform + pixel ownership (RASTER_*; the epilogue below). */
+    if (dr) raster_record_draw(dr, st);
+    /* b1: the fragment program's constants + alpha state (vp_record_fp). */
+    if (dr) vp_record_fp(dr);
+    if (!s_d3d.vp_cb_mapped || !st || slot >= MAX_DRAWS) return;
+    /* CONSTDBG_ID=<hex fp id>: c[456..467] for that program's first 6 draws,
+     * plus where the last SET_TRANSFORM_CONSTANT_LOAD pointed. */
+    { static u32 cid = 0xFFFFFFFFu; static int cn = 0;
+      if (cid == 0xFFFFFFFFu) { const char* e = getenv("CONSTDBG_ID"); cid = e ? (u32)strtoul(e, NULL, 16) : 0; }
+      /* VTX_CLIP_ID=<hex id>[,<hex id>]: for the first 3 draws of each program
+       * (from CONSTDBG_FRAME on), push attribute 0 of its first 4 vertices
+       * through c[259..262] as matrix columns (the layout inFamous 2's world
+       * VPs use) and print clip coordinates and window depth. */
+      { static u32 vids[4], vbase[4]; static int nv = -1, vcnt[4];
+        if (nv < 0) { nv = 0; const char* e = getenv("VTX_CLIP_ID");
+            while (e && *e && nv < 4) { char* end; vids[nv] = (u32)strtoul(e, &end, 16); vbase[nv] = 259;
+                                        if (end == e) break;
+                                        if (*end == ':') { vbase[nv] = (u32)strtoul(end + 1, &end, 10);
+                                                           if (vbase[nv] > RSX_MAX_VERTEX_CONSTANTS - 4u)
+                                                               vbase[nv] = RSX_MAX_VERTEX_CONSTANTS - 4u; }
+                                        nv++; e = (*end == ',') ? end + 1 : end; } }
+        static long vf = -1;
+        if (vf < 0) { const char* e = getenv("CONSTDBG_FRAME"); vf = e ? atol(e) : 0; }
+        for (int vi = 0; vi < nv && dr && dr->fp_shash; vi++)
+            if (dr->fp_id == vids[vi] && vcnt[vi] < 3 && (long)s_d3d.frame_count >= vf) {
+                vcnt[vi]++;
+                const float (*c)[4] = st->vertex_constants + vbase[vi];   /* c[0..3]: the matrix columns */
+                for (u32 k = 0; k < 4; k++) {
+                    float a[4]; extern void rsx_fetch_attrib(const rsx_state*, int, u32, float*);
+                    rsx_fetch_attrib(st, 0, k, a);
+                    float cl[4];
+                    for (int j = 0; j < 4; j++)
+                        cl[j] = a[0] * c[0][j] + a[1] * c[1][j] + a[2] * c[2][j] + c[3][j];
+                    const float wz = cl[3] != 0.0f ? (cl[2] / cl[3]) * st->viewport_scale[2] + st->viewport_offset[2] : -1.0f;
+                    fprintf(stderr, "[VTXCLIP] id=%08X frame %llu v%u a0=(%g %g %g) clip=(%g %g %g %g) winz=%.7f%c",
+                            vids[vi], (unsigned long long)s_d3d.frame_count, k, (double)a[0], (double)a[1],
+                            (double)a[2], (double)cl[0], (double)cl[1], (double)cl[2], (double)cl[3], (double)wz, 10);
+                    /* every enabled attribute of this vertex, with its array format */
+                    for (int ai = 1; ai < 16; ai++) {
+                        const rsx_vertex_attrib* va = &st->vertex_attribs[ai];
+                        if (!va->enabled) continue;
+                        float b[4]; rsx_fetch_attrib(st, ai, k, b);
+                        fprintf(stderr, "[VTXCLIP]    a%d type=%u size=%u stride=%u off=0x%08X freq=%u = (%g %g %g %g)%c",
+                                ai, (unsigned)va->type, (unsigned)va->size, (unsigned)va->stride, va->offset,
+                                (unsigned)va->frequency, (double)b[0], (double)b[1], (double)b[2], (double)b[3], 10);
+                    }
+                }
+            }
+        /* CAM_TRACE=<frames>: every <frames> frames, the first draw's c[460] when
+         * it reads as inFamous 2's negated eye position (w == -1): where the
+         * camera is, in world units, over time. */
+        { static int ce = -1; static unsigned long long clast = ~0ull; static unsigned long long ct0;
+          if (ce < 0) { const char* e = getenv("CAM_TRACE"); ce = e ? atoi(e) : 0; ct0 = GetTickCount64(); }
+          if (ce > 0 && (s_d3d.frame_count % (unsigned)ce) == 0 && clast != s_d3d.frame_count &&
+              st->vertex_constants[460][3] == -1.0f) {
+              clast = s_d3d.frame_count;
+              fprintf(stderr, "[CAM] t=%llums frame %llu eye=(%.2f %.2f %.2f)%c",
+                      (unsigned long long)(GetTickCount64() - ct0), (unsigned long long)s_d3d.frame_count,
+                      -(double)st->vertex_constants[460][0], -(double)st->vertex_constants[460][1],
+                      -(double)st->vertex_constants[460][2], 10); } }
+        /* With RSX_CAP_FILE set, the trace also waits for that trigger file. */
+        /* VS_TRACE_ID=<hex fp id>[,...] (+ VS_TRACE_AFTER_MS): once per program,
+         * that draw's whole constant bank and its first 8 vertices' fetched
+         * attributes, in tools/vp_eval.py's trace format ([pso-const] /
+         * [pso-trace] attrN ... big-endian float hex; attribute lines first, since
+         * vp_eval starts a draw at its attr0 line). With VS_DUMP_ALL's
+         * vs_<slot>_*.hlsl, vp_eval computes the draw's clip positions offline. */
+        { static int tn = -1, tdone[8]; static u32 tids[8]; static long long tafter; static unsigned long long tt0;
+          if (tn < 0) { tn = 0; const char* e = getenv("VS_TRACE_ID");
+              while (e && *e && tn < 8) { char* end; tids[tn] = (u32)strtoul(e, &end, 16); if (end == e) break;
+                                          tn++; e = (*end == ',') ? end + 1 : end; }
+              e = getenv("VS_TRACE_AFTER_MS"); tafter = e ? atoll(e) : 0; tt0 = GetTickCount64(); }
+          for (int ti = 0; ti < tn && dr && dr->fp_shash; ti++)
+              if (dr->fp_id == tids[ti] && !tdone[ti] && (long long)(GetTickCount64() - tt0) >= tafter &&
+                  rsx_capfile_armed()) {
+                  tdone[ti] = 1;
+                  fprintf(stderr, "[pso-begin] id=%08X frame %llu vs=%d n=%u%c", tids[ti],
+                          (unsigned long long)s_d3d.frame_count, dr->vs_idx, dr->vertex_count, 10);
+                  for (int ai = 0; ai < 16; ai++) {
+                      const rsx_vertex_attrib* va = &st->vertex_attribs[ai];
+                      if (!va->enabled) continue;
+                      char line[1024]; int lp = snprintf(line, sizeof line,
+                          "[pso-trace] attr%d type=2 size=4 stride=16 loc=0 off=0x%08X: ", ai, va->offset);
+                      for (u32 k = 0; k < 8 && lp < (int)sizeof line - 48; k++) {
+                          float b[4]; extern void rsx_fetch_attrib(const rsx_state*, int, u32, float*);
+                          rsx_fetch_attrib(st, ai, k, b);
+                          u32 bw[4]; memcpy(bw, b, 16);
+                          lp += snprintf(line + lp, sizeof line - (size_t)lp, "%08X%08X%08X%08X | ",
+                                         bw[0], bw[1], bw[2], bw[3]); }
+                      fprintf(stderr, "%s%c[pso-fmt] attr%d rsx type=%u size=%u stride=%u%c", line, 10, ai,
+                              (unsigned)va->type, (unsigned)va->size, (unsigned)va->stride, 10); }
+                  for (int ci = 0; ci < RSX_MAX_VERTEX_CONSTANTS; ci++) {
+                      u32 w[4]; memcpy(w, st->vertex_constants[ci], 16);
+                      if (!(w[0] | w[1] | w[2] | w[3])) continue;
+                      fprintf(stderr, "[pso-const] %d %08X %08X %08X %08X%c", ci, w[0], w[1], w[2], w[3], 10); }
+              } }
+        /* VB_CLIP_ID=<hex id>[:<base>]: for that program's first 4 draws (from
+         * CONSTDBG_FRAME on), every vertex AS UPLOADED (after index fetch and
+         * primitive assembly), attribute 0 through c[base..base+3] (default
+         * 259): the NDC extent, and the first few vertices at w <= 0 or far
+         * off screen -- one wild vertex stretches a triangle over the frame. */
+        { static u32 bid = 0xFFFFFFFFu, bbase = 259; static int bn = 0;
+          if (bid == 0xFFFFFFFFu) { const char* e = getenv("VB_CLIP_ID"); bid = 0;
+              if (e) { char* end; bid = (u32)strtoul(e, &end, 16);
+                       if (*end == ':') bbase = (u32)strtoul(end + 1, NULL, 10);
+                       if (bbase > RSX_MAX_VERTEX_CONSTANTS - 4u) bbase = RSX_MAX_VERTEX_CONSTANTS - 4u; } }
+          if (bid && dr && dr->fp_shash && dr->fp_id == bid && bn < 4 && s_d3d.vp_vb_mapped && rsx_capfile_armed() &&
+              (long)s_d3d.frame_count >= vf) {
+              bn++;
+              const u8* vb = (const u8*)s_d3d.vp_vb_mapped
+                  + (u64)s_d3d.vp_parity * MAX_VERTICES * 256u + dr->vb_byte_offset;
+              const float (*c)[4] = st->vertex_constants + bbase;
+              float mn[3] = {1e30f, 1e30f, 1e30f}, mx[3] = {-1e30f, -1e30f, -1e30f};
+              u32 nodd = 0;
+              for (u32 i = 0; i < dr->vertex_count && i < 4096u; i++) {
+                  const float* a = (const float*)(vb + (u64)i * 256u);
+                  float cl[4];
+                  for (int j = 0; j < 4; j++) cl[j] = a[0] * c[0][j] + a[1] * c[1][j] + a[2] * c[2][j] + c[3][j];
+                  const int bad_w = !(cl[3] > 0.0f);
+                  float q[3] = {0, 0, 0};
+                  if (!bad_w) for (int j = 0; j < 3; j++) {
+                      q[j] = cl[j] / cl[3];
+                      if (q[j] < mn[j]) mn[j] = q[j];
+                      if (q[j] > mx[j]) mx[j] = q[j];
+                  }
+                  if (bad_w || q[0] < -4.0f || q[0] > 4.0f || q[1] < -4.0f || q[1] > 4.0f) {
+                      if (nodd++ < 6)
+                          fprintf(stderr, "[VBCLIP]    v%u a0=(%g %g %g %g) clip=(%g %g %g %g)%c", i,
+                                  (double)a[0], (double)a[1], (double)a[2], (double)a[3],
+                                  (double)cl[0], (double)cl[1], (double)cl[2], (double)cl[3], 10);
+                  }
+              }
+              fprintf(stderr, "[VBCLIP] id=%08X frame %llu n=%u ndc x[%g, %g] y[%g, %g] z[%g, %g] odd=%u%c",
+                      bid, (unsigned long long)s_d3d.frame_count, dr->vertex_count,
+                      (double)mn[0], (double)mx[0], (double)mn[1], (double)mx[1], (double)mn[2], (double)mx[2],
+                      nodd, 10);
+          } }
+        }
+      static long cf = -1;
+      if (cf < 0) { const char* e = getenv("CONSTDBG_FRAME"); cf = e ? atol(e) : 0; }
+      if (cid && dr && dr->fp_shash && dr->fp_id == cid && (long)s_d3d.frame_count >= cf && cn < 40) { cn++;
+          fprintf(stderr, "[CONSTDBG1] frame %llu c466=(%g %g %g %g) c467=(%g %g %g %g) c262=(%g %g %g %g)%c",
+                  (unsigned long long)s_d3d.frame_count,
+                  (double)st->vertex_constants[466][0], (double)st->vertex_constants[466][1],
+                  (double)st->vertex_constants[466][2], (double)st->vertex_constants[466][3],
+                  (double)st->vertex_constants[467][0], (double)st->vertex_constants[467][1],
+                  (double)st->vertex_constants[467][2], (double)st->vertex_constants[467][3],
+                  (double)st->vertex_constants[262][0], (double)st->vertex_constants[262][1],
+                  (double)st->vertex_constants[262][2], (double)st->vertex_constants[262][3], 10);
+      }
+      /* CONSTDBG_FULL=1: also c[456..467] for that program's first 6 draws. */
+      { static int full = -1; if (full < 0) full = getenv("CONSTDBG_FULL") ? 1 : 0;
+      if (full && cid && dr && dr->fp_shash && dr->fp_id == cid && (long)s_d3d.frame_count >= cf && cn <= 6) {
+          fprintf(stderr, "[CONSTDBG] id=%08X load=%u lo=%u hi=%u%c", cid, st->transform_constant_load,
+                  st->vertex_constants_lo, st->vertex_constants_hi, 10);
+          for (int i = 456; i < 468 && i < RSX_MAX_VERTEX_CONSTANTS; i++)
+              fprintf(stderr, "[CONSTDBG]   c[%d] = %g %g %g %g%c", i,
+                      (double)st->vertex_constants[i][0], (double)st->vertex_constants[i][1],
+                      (double)st->vertex_constants[i][2], (double)st->vertex_constants[i][3], 10); } } }
+    /* VP_MVP=<N>: the constant bank as the shader will see it, for the first N
+     * draws. A snapshot taken from a stale rsx_state looks exactly like a broken
+     * vertex program from the outside -- both give zero fragments. */
+    { static int cap = -1, seen = 0;
+      if (cap < 0) { const char* e = getenv("VP_MVP"); cap = e ? atoi(e) : 0; }
+      if (cap && seen < cap) { seen++;
+        const float* c = &st->vertex_constants[0][0];   /* what the slot gets */
+        int last_nz = -1;
+        for (int i = 0; i < RSX_MAX_VERTEX_CONSTANTS * 4; i++)
+            if (c[i] > 1e-9f || c[i] < -1e-9f) last_nz = i / 4;
+        fprintf(stderr, "[VPMVP] slot=%u lastNZ=c%d  c260=(%g %g %g %g) c467=(%g %g %g %g)\n",
+                slot, last_nz,
+                c[260*4+0], c[260*4+1], c[260*4+2], c[260*4+3],
+                c[467*4+0], c[467*4+1], c[467*4+2], c[467*4+3]); } }
+    /* Viewport epilogue (see the render_frame notes this logic came from):
+     * x/y identity -- or, with raster_record_draw's rs_k, an axis mirror
+     * (route 1) or the whole guest map on a frame-sized viewport (route 2) --
+     * z lane remaps GL clip z when the guest programs one.
+     * Built here, stored after the bank below (it is part of the reuse key). */
+    float vpx[VP_CB_EPI_FLOATS];
+    /* vp_uc[4] after vp_posoffset (vec4 514..517): per plane a factor and a
+     * bias, D3D keeping d * f + b >= 0 -- GE keeps d >= 0 (f 1), LT keeps
+     * d < 0 (f -1), disabled always keeps (f 0, b 0.5), as RPCS3. */
+    { float* uc = vpx + 8;
+      const u32 ctl = user_clip_on() ? st->user_clip_control : 0u;
+      if (dr) dr->uclip = ctl;
+      for (int i = 0; i < 6; i++) {
+          const u32 op = (ctl >> (4 * i)) & 0xFu;
+          const float f = op == 2u ? 1.0f : (op == 1u ? -1.0f : 0.0f);
+          uc[(i / 3) * 4 + (i % 3)] = f;
+          uc[8 + (i / 3) * 4 + (i % 3)] = f != 0.0f ? 0.0f : 0.5f;
+          if (op > 2u) { static int n = 0; if (n++ < 4)
+              fprintf(stderr, "[UCLIP] plane %d op %u unknown: treated as disabled%c", i, op, 10); }
+      }
+      uc[3] = uc[7] = uc[11] = uc[15] = 0.0f; }
+    const float* vs_ = st->viewport_scale;
+    const float* vo_ = st->viewport_offset;
+    vpx[0] = vpx[1] = vpx[3] = 1.0f;
+    vpx[4] = vpx[5] = vpx[7] = 0.0f;
+    if (dr && dr->rs_on) { vpx[0] = dr->rs_k[0]; vpx[1] = dr->rs_k[1];
+                           vpx[4] = dr->rs_k[2]; vpx[5] = dr->rs_k[3]; }
+    /* vp_posoffset.w: SET_VERTEX_ATTRIB_OUTPUT_MASK's TEX8 (bit 12) / TEX9 (bit 13)
+     * as 0..3 -- the VS forwards o15 / o6 to the fragment program only when the
+     * guest enabled them (PSL1GHT GCM_ATTRIB_OUTPUT_MASK_TEX8/9; o6 is otherwise
+     * point size + user clip distances). VP_OUTMASK=0: always forward. */
+    { static int om = -1;
+      if (om < 0) { const char* e = getenv("VP_OUTMASK"); om = (e && *e == '0') ? 0 : 1; }
+      vpx[7] = om ? (float)((st->vertex_attrib_output_mask >> 12) & 3u) : 3.0f; }
+    if (vs_[2] != 0.0f) { vpx[2] = vs_[2]; vpx[6] = vo_[2]; }
+    else                { vpx[2] = 1.0f;   vpx[6] = 0.0f;   }
+    /* ZSCALE_DBG=1: each distinct viewport transform (all lanes) at record time. */
+    { static int zd = -1; static float seen[32][6]; static int ns = 0;
+      if (zd < 0) zd = getenv("ZSCALE_DBG") ? 1 : 0;
+      if (zd && ns < 32) {
+          float k[6] = { vs_[0], vs_[1], vs_[2], vo_[0], vo_[1], vo_[2] };
+          int f = 0;
+          for (int i = 0; i < ns && !f; i++) if (!memcmp(seen[i], k, sizeof k)) f = 1;
+          if (!f) { memcpy(seen[ns++], k, sizeof k);
+              fprintf(stderr, "[ZSCALE] scale=(%g %g %g) offset=(%g %g %g) rt=0x%X fp=0x%X vp=%ux%u frame=%llu%c",
+                      (double)k[0], (double)k[1], (double)k[2], (double)k[3], (double)k[4], (double)k[5],
+                      dr ? dr->rt_off : 0, dr ? dr->fp_addr : 0, st->viewport_w, st->viewport_h,
+                      (unsigned long long)s_d3d.frame_count, 10); } } }
+    /* DBG_ZOOM=<k> with DBG_CENTER="cx,cy": a debug camera applied in CLIP space,
+     * not a framebuffer crop -- the geometry is re-rasterized at full resolution.
+     * The shader epilogue already computes
+     *     pos.xyz = _p.xyz * vp_posscale + _p.w * vp_posoffset
+     * so recentring NDC point c and magnifying by k is exactly
+     *     pos.xy = _p.xy * k + _p.w * (-c * k).
+     * Rubber Ducky frames its ducks near the bottom edge of the viewport and its
+     * camera only moves from the analog sticks, so without this there is no way
+     * to look at the subject of the demo. It changes the view, nothing else:
+     * same draws, same transform, same textures. */
+    { static int z = -1; static float k = 1.0f, cx = 0.0f, cy = 0.0f;
+      if (z < 0) { const char* e = getenv("DBG_ZOOM");
+                   k = e ? (float)atof(e) : 1.0f;
+                   z = (e && k > 0.0f) ? 1 : 0;
+                   const char* ce = getenv("DBG_CENTER");
+                   if (ce) { double a = 0, b = 0; sscanf(ce, "%lf,%lf", &a, &b);
+                             cx = (float)a; cy = (float)b; } }
+      if (z) { float ux = cx, uy = cy;
+               static int lock = -1;
+               if (lock < 0) { const char* le = getenv("DBG_LOCK"); lock = le ? atoi(le) : 0; }
+               if (lock && s_lock_valid) { ux = s_lock_x; uy = s_lock_y; }
+               /* zoom about c in the guest's NDC, then the guest map */
+               vpx[4] -= ux * k * vpx[0]; vpx[5] -= uy * k * vpx[1];
+               vpx[0] *= k; vpx[1] *= k; } }
+
+    /* Garbage-projection fallback (vkcube; see the original comment). c[0] is
+     * taken from the bank being snapshotted instead of being read back from
+     * the slot -- a load from the write-combined upload heap waits for the
+     * 8 KB just stored to drain (~0.6 us a record) -- and the two switches are
+     * read once: getenv() walks the whole environment (~1 us a call), and both
+     * calls ran for every record (~23% of the render thread in the pier view). */
+    static int s_nofix = -1, s_forcefix = 0;
+    if (s_nofix < 0) { s_nofix = getenv("VP_NOFIXPROJ") ? 1 : 0;
+                       s_forcefix = getenv("VP_FIXPROJ") ? 1 : 0; }
+    int uses_c03 = (vs_idx >= 0 && vs_idx < s_d3d.vp_vs_n)
+                       ? s_d3d.vp_vs[vs_idx].uses_c03 : s_d3d.vp_uses_c03;
+    const float c00 = st->vertex_constants[0][0];
+    int garbage = !(c00 > 0.0f && c00 < 8.0f);
+    if (s_nofix) garbage = 0;
+    const int fix = (garbage && uses_c03) || s_forcefix;
+    if (fix) {
+        { static int _fb = 0; if (_fb++ < 6)
+            printf("[VPFB] fallback proj on draw slot %u (c00=%g vs_idx=%d)\n",
+                   slot, c00, vs_idx); }
+        vpx[2] = 1.0f; vpx[6] = 0.0f;
+    }
+    /* RSX_DBG_CB=<hex tex0 offset>: the constants as they land in the per-draw
+     * constant buffer for that texture's draws -- i.e. exactly what the shader
+     * samples, not what the CPU-side rsx_state holds. Those two agreeing is an
+     * assumption worth checking directly when a draw transforms to nothing.
+     * (c256..259 are the bank's; the fallback only replaces c0..15.) */
+    { static const char* dc = (const char*)1; static u32 wantc = 0; static int n = 0;
+      if (dc == (const char*)1) { dc = getenv("RSX_DBG_CB");
+                                  wantc = dc ? (u32)strtoul(dc, NULL, 16) : 0; }
+      if (wantc && dr && dr->tex[0].raw == wantc && n < 4) { n++;
+          const float* c = &st->vertex_constants[0][0];
+          fprintf(stderr, "[DUCKCB] slot=%u vs_idx=%d posscale=(%g %g %g) posoffset=(%g %g %g)%c",
+                  slot, vs_idx, vpx[0], vpx[1], vpx[2],
+                  vpx[4], vpx[5], vpx[6], 10);
+          for (int r = 256; r <= 259; r++)
+              fprintf(stderr, "[DUCKCB]   c%d=(%g %g %g %g)%c", r,
+                      c[r*4+0], c[r*4+1], c[r*4+2], c[r*4+3], 10);
+      } }
+
+    const int vnorm = vpc_norm_hit(dr, st);   /* VPC_NORM: this record gets its own slot */
+    /* Reuse the previous record's slot when it holds these exact bytes. */
+    static int s_reuse = -1, s_verify = 0;
+    if (s_reuse < 0) { const char* e = getenv("CB_REUSE"); s_reuse = (e && *e == '0') ? 0 : 1;
+                       s_verify = getenv("CB_REUSE_VERIFY") ? 1 : 0; }
+    if (perf_on() && ++s_cbr.records >= 20000u) {
+        fprintf(stderr, "[CBREUSE] %u records: %u reused the previous record's constant slot (%.1f%%); "
+                        "%u written compact, %llu KB stored%c",
+                s_cbr.records, s_cbr.reused, 100.0 * s_cbr.reused / s_cbr.records, s_cbr.compact,
+                (unsigned long long)(s_cbr.bytes >> 10), 10);
+        s_cbr.records = s_cbr.reused = s_cbr.compact = 0; s_cbr.bytes = 0;
+    }
+    /* CB_COMPACT (default 1): store only the registers the record's VS reads (VPCRead,
+     * scanned from its HLSL) instead of all 512 -- a record whose bank changed wrote
+     * 8 KB to the write-combined upload heap, ~6k records a frame at the prologue gate.
+     * The mask is the record's VS OR the primary VS (the replay falls back to the
+     * primary pipeline when the record's VS was evicted). Registers outside it are
+     * never read by the shader, so the GPU sees the same values. Full copies when a
+     * VS uses relative addressing, for VPC_NORM, and while a CPU-side reader of the
+     * slots is armed. CB_COMPACT=0 stores everything; CB_COMPACT_POISON=1 fills the
+     * rest with NaN, so a read the scan missed shows as broken geometry. */
+    static int s_compact = -1, s_poison = 0;
+    if (s_compact < 0) {
+        const char* e = getenv("CB_COMPACT");
+        s_compact = !(e && *e == '0');
+        s_poison = getenv("CB_COMPACT_POISON") ? 1 : 0;
+        static const char* const rd[] = { "RSX_CAP", "RSX_CAP_VPC", "VB_CLIP_ID", "VS_TRACE_ID",
+                                          "VB_SKIP_WNEG", "CONSTDBG_FRAME" };
+        for (unsigned i = 0; s_compact && i < sizeof rd / sizeof rd[0]; i++)
+            if (getenv(rd[i])) {
+                s_compact = 0;
+                fprintf(stderr, "[CBCOMPACT] off: %s reads the constant slots on the CPU%c", rd[i], 10);
+            }
+    }
+    u64 need[8];
+    int cfull = 1;
+    if (s_compact && dr && !vnorm && vs_idx >= 0 && vs_idx < s_d3d.vp_vs_n &&
+        !s_d3d.vp_vs[vs_idx].cread.full && !s_d3d.vp_cread.full) {
+        for (int w = 0; w < 8; w++) need[w] = s_d3d.vp_vs[vs_idx].cread.m[w] | s_d3d.vp_cread.m[w];
+        cfull = 0;
+    }
+    int covers = s_cbr.full;                       /* the previous slot holds what this record reads */
+    if (!covers && !cfull) {
+        covers = 1;
+        for (int w = 0; w < 8; w++) if (need[w] & ~s_cbr.mask[w]) { covers = 0; break; }
+    }
+    if (s_reuse && dr && !vnorm && s_cbr.valid && s_cbr.st == st && s_cbr.gen == st->vertex_constants_gen &&
+        s_cbr.parity == (u32)s_d3d.vp_parity && s_cbr.vbatch == s_d3d.vbatch && s_cbr.slot < slot &&
+        s_cbr.fix == fix && covers && !memcmp(s_cbr.epi, vpx, sizeof vpx)) {
+        if (!s_verify || !memcmp(s_cbr.bank, st->vertex_constants, sizeof s_cbr.bank)) {
+            dr->cb_slot = s_cbr.slot;
+            s_cbr.reused++;
+            return;
+        }
+        { static int n = 0; if (n++ < 8)
+            fprintf(stderr, "[CBREUSE] slot %u: the bank changed but vertex_constants_gen did not "
+                            "(a writer that does not bump it) -- written afresh%c", s_cbr.slot, 10); }
+    }
+    s_cbr.valid = 0;
+    char* dst = (char*)s_d3d.vp_cb_mapped
+        + ((u64)s_d3d.vp_parity * MAX_DRAWS + slot) * VP_CB_STRIDE;
+    if (cfull) {
+        memcpy(dst, st->vertex_constants, RSX_MAX_VERTEX_CONSTANTS * 16);
+        if (perf_on()) s_cbr.bytes += RSX_MAX_VERTEX_CONSTANTS * 16;
+    } else {
+        if (s_poison) {
+            static float pz[RSX_MAX_VERTEX_CONSTANTS][4];
+            static int pinit = 0;
+            if (!pinit) { const u32 nan = 0x7FC00000u;
+                          for (int i = 0; i < RSX_MAX_VERTEX_CONSTANTS * 4; i++) memcpy(&pz[0][0] + i, &nan, 4);
+                          pinit = 1; }
+            memcpy(dst, pz, sizeof pz);
+        }
+        vp_copy_cruns(dst, (const float (*)[4])st->vertex_constants, need);
+        if (perf_on()) {
+            u32 n = 0;
+            for (int w = 0; w < 8; w++) n += (u32)__builtin_popcountll(need[w]);
+            s_cbr.compact++; s_cbr.bytes += (u64)n * 16;
+        }
+    }
+    if (fix) {
+        float* c = (float*)dst;
+        for (int _i = 0; _i < 16; _i++) c[_i] = 0.0f;
+        c[0]=1.358f; c[5]=2.414f; c[11]=1.0f;
+        c[10]=1.0f/99.0f; c[14]=-1.0f/99.0f;
+    }
+    memcpy(dst + RSX_MAX_VERTEX_CONSTANTS * 16, vpx, sizeof vpx);
+    if (vnorm) vpc_norm_apply((float*)dst, dr);
+    if (dr) dr->cb_slot = slot;
+    s_cbr.slot = slot; s_cbr.parity = (u32)s_d3d.vp_parity; s_cbr.vbatch = s_d3d.vbatch;
+    s_cbr.st = st; s_cbr.gen = st->vertex_constants_gen; s_cbr.fix = fix;
+    s_cbr.full = cfull;
+    if (!cfull) memcpy(s_cbr.mask, need, sizeof need);
+    memcpy(s_cbr.epi, vpx, sizeof vpx);
+    if (s_verify) memcpy(s_cbr.bank, st->vertex_constants, sizeof s_cbr.bank);
+    s_cbr.valid = !vnorm;   /* a VPC_NORM-rescaled slot is no other record's */
+}
+
+/* Which offscreen surface (if any) does the current RSX state render to?
+ * Returns 0 for a display buffer (backbuffer), else the surface's RAW RSX
+ * offset. RTs are keyed by raw offset -- a texture bound at the same raw
+ * offset is the same buffer (surface and texture registers share the offset
+ * space; location bits differ but one title doesn't alias local vs main at
+ * one offset), which sidesteps guessing the surface's context DMA location. */
+static u32 current_rt_off(u32* out_w, u32* out_h, u32 out_mrt[3])
+{
+    extern int cellGcmOffsetIsDisplay(u32 offset);
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (out_w) *out_w = 0;
+    if (out_h) *out_h = 0;
+    if (out_mrt) out_mrt[0] = out_mrt[1] = out_mrt[2] = 0;
+    if (!st) return 0;
+    /* SET_SURFACE_COLOR_TARGET: 1 = A, 2 = B, 0x13 = MRT1 (A+B),
+     * 0x17 = MRT2 (A+B+C), 0x1F = MRT3 (A+B+C+D). */
+    int sel = (st->color_target == 2) ? 1 : 0;
+    u32 raw = st->surface_color_offset[sel];
+    if (out_mrt) {
+        if (st->color_target >= 0x13) out_mrt[0] = st->surface_color_offset[1];
+        if (st->color_target >= 0x17) out_mrt[1] = st->surface_color_offset[2];
+        if (st->color_target >= 0x1F) out_mrt[2] = st->surface_color_offset[3];
+    }
+    { static int _rs = -1; if (_rs < 0) _rs = getenv("RT_SEQDBG") ? 1 : 0;
+      static u32 _last = 0; static int _n2 = 0;
+      if (_rs && st->surface_color_offset[0] != _last && _n2 < 400000) {
+          _last = st->surface_color_offset[0]; _n2++;
+          fprintf(stderr, "[RTSEQ] #%d -> 0x%X%c", _n2, _last, 10); } }
+    { static int _ro = -1; if (_ro < 0) _ro = getenv("RT_OFFDBG") ? 1 : 0;
+      static u32 _seen[32]; static int _ns = 0;
+      if (_ro) { u32 _k = st->surface_color_offset[0] ^ (st->color_target << 24)
+                        ^ (st->surface_clip_w << 8) ^ st->surface_format;
+        int _f = 0; for (int _i = 0; _i < _ns; _i++) if (_seen[_i] == _k) _f = 1;
+        if (!_f && _ns < 32) { _seen[_ns++] = _k;
+        fprintf(stderr, "[RTOFF] fmt=0x%X tgt=0x%X off[0]=0x%X off[1]=0x%X zeta=0x%X clip=%ux%u disp=%d -> 0x%X\n",
+                st->surface_format, st->color_target, st->surface_color_offset[0], st->surface_color_offset[1],
+                st->surface_zeta_offset, st->surface_clip_w, st->surface_clip_h,
+                cellGcmOffsetIsDisplay(raw), cellGcmOffsetIsDisplay(raw) ? 0 : raw); } } }
+    if (cellGcmOffsetIsDisplay(raw)) { s_cur_disp_raw = raw; return 0; }
+    /* RT_DISPLAY_BY_SIZE=1: also treat a single-target surface whose clip
+     * exactly matches the display resolution as the backbuffer.
+     *
+     * cellGcmSetDisplayBuffer only registers the buffers the FLIP may point at;
+     * a guest is free to render into a different surface of the same size and
+     * flip to it later (PSGL does). Matching offsets alone then classifies every
+     * draw as offscreen, has_display stays 0, and render_frame() -- which is
+     * what draws ALL recorded geometry -- is never called. The backbuffer shows
+     * only the clear, which looks exactly like "nothing rasterizes". */
+    { static int _bs = -1; if (_bs < 0) _bs = getenv("RT_DISPLAY_BY_SIZE") ? 1 : 0;
+      if (_bs && st->color_target < 0x13 &&
+          st->surface_clip_w == s_d3d.width && st->surface_clip_h == s_d3d.height)
+          return 0; }
+    /* Surface clip dims when sane; else the window size. Any size works --
+     * passes draw normalized full-surface quads -- this only picks resolution. */
+    u32 w = st->surface_clip_w, h = st->surface_clip_h;
+    /* Any size from 1: inFamous 2's exposure chain ends in a 20x11 target, and
+     * the old 16-pixel floor turned it into a window-sized surface drawn only in
+     * its corner -- sampled whole, the scene's average luminance read ~0 and the
+     * exposure blew every frame out to white. */
+    if (w < 1 || w > 4096 || h < 1 || h > 4096) { w = 0; h = 0; }
+    if (out_w) *out_w = w;
+    if (out_h) *out_h = h;
+    return raw;
+}
+
+/* RSX surface colour format (SET_SURFACE_FORMAT bits [4:0]) -> DXGI. Float
+ * targets matter: wave's water height maps store SIGNED values (F_W16..),
+ * demosaic's differential planes likewise -- RGBA8 clamps them to zero. */
+static DXGI_FORMAT rsx_surface_dxgi(u32 fmt)
+{
+    switch (fmt & 0x1F) {
+    case 0x0B: return DXGI_FORMAT_R16G16B16A16_FLOAT; /* F_W16Z16Y16X16 */
+    case 0x0C: return DXGI_FORMAT_R32G32B32A32_FLOAT; /* F_W32Z32Y32X32 */
+    case 0x0D: return DXGI_FORMAT_R32_FLOAT;          /* F_X32          */
+    default:   return DXGI_FORMAT_R8G8B8A8_UNORM;
+    }
+}
+
+/* The pool holds one resource per (offset, size, format): a title may use
+ * one address as differently sized surfaces within a frame. Recreating the
+ * one slot instead released a resource the open command list still used
+ * (its seed copy) -- a GPU hang (DRED: DEVICE_HUNG on the frame's first
+ * CopyTextureRegion, the 0xAB8000 1280x180 seed). */
+static u32 s_off_rt_clock;
+
+/* Offset only: the newest surface at this offset. */
+/* Write masks of colour targets B..D as D3D nibbles (R=1 G=2 B=4 A=8) at
+ * bits 4/8/12 of a draw's cmask; target A keeps bits 0..3. All on until the
+ * title sets SET_COLOR_MASK_MRT: inFamous 2 masks its G-buffer's third target
+ * in passes that bind it, and writing the shader's leftover h6 there anyway is
+ * a candidate for the flat green its glow pass then adds to every frame. */
+static u32 rsx_mrt_cmask(const rsx_state* st)
+{
+    if (!st || !st->color_mask_mrt_set) return 0xFFF0u;
+    u32 out = 0;
+    for (int t = 1; t <= 3; t++) {
+        u32 nib = (st->color_mask_mrt >> (4 * t)) & 0xFu;
+        u32 dm = ((nib & 2u) ? 1u : 0u) | ((nib & 4u) ? 2u : 0u) |
+                 ((nib & 8u) ? 4u : 0u) | ((nib & 1u) ? 8u : 0u);
+        out |= dm << (4 * t);
+    }
+    return out;
+}
+
+static int off_rt_find(u32 off)
+{
+    if (!off) return -1;
+    int best = -1;
+    for (int i = 0; i < MAX_OFF_RTS; i++)
+        if (s_d3d.off_rt[i].res && s_d3d.off_rt[i].off == off &&
+            (best < 0 || s_d3d.off_rt[i].stamp > s_d3d.off_rt[best].stamp)) best = i;
+    return best;
+}
+
+static DXGI_FORMAT off_rt_want_fmt(u32 rsx_fmt)
+{
+    DXGI_FORMAT want_fmt = rsx_surface_dxgi(rsx_fmt);
+    /* RT_FORCE_RGBA8=1: allocate every offscreen target as R8G8B8A8 rather than
+     * its native format. A title whose final composite reads a half-float
+     * surface cannot be shown with a plain CopyTextureRegion, and giving it an
+     * 8-bit target costs HDR precision but makes the composite a same-format
+     * copy. A stopgap for looking at the frame, not a rendering fix. */
+    static int f8 = -1;
+    if (f8 < 0) { const char* e = getenv("RT_FORCE_RGBA8"); f8 = e ? atoi(e) : 0; }
+    return f8 ? DXGI_FORMAT_R8G8B8A8_UNORM : want_fmt;
+}
+
+/* The surface a record targets: offset, clip dims (0 = window) and format,
+ * exactly as the prepass's off_rt_get created it. */
+static int off_rt_find_dims(u32 off, u32 w, u32 h, u32 rsx_fmt)
+{
+    if (!off) return -1;
+    if (!w) w = s_d3d.width;
+    if (!h) h = s_d3d.height;
+    u32 f = (u32)off_rt_want_fmt(rsx_fmt);
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (r->res && r->off == off && r->w == w && r->h == h && r->dxgi == f) return i;
+    }
+    return off_rt_find(off);
+}
+
+/* A texture's source surface: same offset and the texture's dims, else the
+ * newest surface there. */
+static int off_rt_find_tex(u32 off, u32 w, u32 h)
+{
+    if (!off) return -1;
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (r->res && r->off == off && r->w == w && r->h == h) return i;
+    }
+    return off_rt_find(off);
+}
+
+/* An offscreen RT at this raw offset with exactly these dims. */
+static int off_rt_same(u32 off, u32 w, u32 h)
+{
+    int s = off_rt_find_tex(off, w, h);
+    return s >= 0 && s_d3d.off_rt[s].w == w && s_d3d.off_rt[s].h == h;
+}
+
+/* Ensure an RT resource exists for this surface; (re)creates the RTV at
+ * rt_rtv_heap[i] and the SRV at srv_heap[RT_SRV_BASE+i]. */
+static int off_rt_get(u32 off, u32 w, u32 h, u32 rsx_fmt)
+{
+    if (!off || !s_d3d.rt_rtv_heap || !s_d3d.srv_heap) return -1;
+    int guessed = !w || !h;
+    if (!w) w = s_d3d.width;
+    if (!h) h = s_d3d.height;
+    DXGI_FORMAT want_fmt = off_rt_want_fmt(rsx_fmt);
+    u32 hw, hh;                     /* RES_SCALE: the host size (== w x h unscaled) */
+    rs_host_dims(w, h, &hw, &hh);
+    int slot = -1;
+    for (int i = 0; i < MAX_OFF_RTS && slot < 0; i++) {
+        OffRT* r = &s_d3d.off_rt[i];
+        if (r->res && r->off == off && r->w == w && r->h == h && r->dxgi == (u32)want_fmt)
+            slot = i;
+    }
+    if (slot >= 0 && (s_d3d.off_rt[slot].hw != hw || s_d3d.off_rt[slot].hh != hh)) {
+        /* RES_SCALE: the latched factor changed: a new resource at the new host
+         * size in the same slot (content from guest memory, as a new surface;
+         * the old resource may still be referenced by the list in flight). */
+        OffRT* r = &s_d3d.off_rt[slot];
+        { static int n = 0; if (n++ < 16)
+            fprintf(stderr, "[RSCALE] surface 0x%X %ux%u: host %ux%u -> %ux%u (made anew)%c",
+                    off, w, h, r->hw, r->hh, hw, hh, 10); }
+        res_grave_put(r->res); r->res = NULL;
+        res_grave_put(r->up);  r->up = NULL;
+    } else if (slot >= 0) {
+        OffRT* r = &s_d3d.off_rt[slot];
+        r->used = 1; r->rsx_fmt = rsx_fmt & 0x1F; r->guessed = guessed;
+        r->stamp = ++s_off_rt_clock;
+        return slot;
+    }
+    if (slot < 0) {
+        /* Another size or format at this offset keeps its own slot: it was
+         * targeted earlier in this batch (or in an earlier frame) and the
+         * command list being recorded may reference it. */
+        for (int i = 0; i < MAX_OFF_RTS; i++)
+            if (!s_d3d.off_rt[i].res) { slot = i; break; }
+        if (slot < 0) {   /* evict the oldest entry not used this frame: nothing
+                           * recorded since its frame began references it */
+            for (int i = 0; i < MAX_OFF_RTS; i++)
+                if (!s_d3d.off_rt[i].used &&
+                    (slot < 0 || s_d3d.off_rt[i].stamp < s_d3d.off_rt[slot].stamp)) slot = i;
+            if (slot < 0) {
+                static unsigned long n = 0;
+                if (++n <= 8 || (n & 1023) == 0)
+                    fprintf(stderr, "[D3D12] offscreen RT pool full (%d slots in use this frame): "
+                            "no surface for 0x%X %ux%u (#%lu)%c", MAX_OFF_RTS, off, w, h, n, 10);
+                return -1;
+            }
+            wait_for_gpu();   /* earlier submissions may still use it */
+            s_d3d.off_rt[slot].res->lpVtbl->Release(s_d3d.off_rt[slot].res);
+            s_d3d.off_rt[slot].res = NULL;
+            if (s_d3d.off_rt[slot].up) {
+                s_d3d.off_rt[slot].up->lpVtbl->Release(s_d3d.off_rt[slot].up);
+                s_d3d.off_rt[slot].up = NULL;
+            }
+        }
+    }
+    OffRT* r = &s_d3d.off_rt[slot];
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = hw; td.Height = hh; td.DepthOrArraySize = 1; td.MipLevels = 1;   /* == w x h unscaled */
+    td.Format = want_fmt; td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    if (hw != w || hh != h)   /* RES_SCALE: the scaled-copy compute passes write it */
+        td.Flags |= D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    D3D12_CLEAR_VALUE cv = {0};
+    cv.Format = td.Format;
+    const double _frc0 = FTR_T0();
+    const HRESULT _rchr = s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, &cv,
+            &IID_ID3D12Resource, (void**)&r->res);
+    FTR_ADD(rt_cr, _frc0);
+    if (FAILED(_rchr))
+        return -1;
+    r->off = off; r->w = w; r->h = h; r->dxgi = (u32)want_fmt;
+    r->hw = hw; r->hh = hh;
+    if (s_rs.artlog) { const u64 k_[2] = { ((u64)off << 32) | (u32)want_fmt, ((u64)w << 32) | h };
+                       const u64 v_[2] = { ((u64)hw << 32) | hh, td.Flags };
+                       rs_art_line("surface", rs_fnv(k_, sizeof k_, 1469598103934665603ull),
+                                   rs_fnv(v_, sizeof v_, 1469598103934665603ull)); }
+    r->stamp = ++s_off_rt_clock;
+    FTR_INC(rt_new_n);
+    { wchar_t nm[48]; swprintf(nm, 48, L"offrt_%X_%ux%u", off, w, h);
+      r->res->lpVtbl->SetName(r->res, nm); }
+    r->st = D3D12_RESOURCE_STATE_COPY_DEST;
+    r->used = 1;
+    r->gpu_dirty = 0;   /* seeded from guest memory below */
+    r->rsx_fmt = rsx_fmt & 0x1F;
+    r->guessed = guessed;
+
+    /* Populate the new RT from guest memory: titles CPU-initialise their
+     * render-target buffers (wave fills the height fields with texels of
+     * (0,0,0, 1.0f) -- the .w is 'inverse of mass'; from an all-zero GPU
+     * resource the water simulation can never boot). Guest data is
+     * big-endian and tightly packed. */
+    {
+        extern uint8_t* vm_base;
+        extern u32 cellGcmResolveOffset(u32);
+        u32 bpp = (want_fmt == DXGI_FORMAT_R16G16B16A16_FLOAT) ? 8u :
+                  (want_fmt == DXGI_FORMAT_R32G32B32A32_FLOAT) ? 16u :
+                  (want_fmt == DXGI_FORMAT_R32_FLOAT) ? 4u : 4u;
+        u32 pitch = (hw * bpp + 255) & ~255u;   /* hw == w unscaled */
+        u32 src = cellGcmResolveOffset(off);
+        if (vm_base && src != 0xFFFFFFFFu) {
+            D3D12_HEAP_PROPERTIES hu = {0}; hu.Type = D3D12_HEAP_TYPE_UPLOAD;
+            D3D12_RESOURCE_DESC bd = {0};
+            bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+            bd.Width = (u64)pitch * hh; bd.Height = 1; bd.DepthOrArraySize = 1;
+            bd.MipLevels = 1; bd.SampleDesc.Count = 1;
+            bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+            if (SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(
+                    s_d3d.device, &hu, D3D12_HEAP_FLAG_NONE, &bd,
+                    D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                    &IID_ID3D12Resource, (void**)&r->up))) {
+                void* mp = NULL; D3D12_RANGE nr = {0,0};
+                if (SUCCEEDED(r->up->lpVtbl->Map(r->up, 0, &nr, &mp)) && mp) {
+                    const u8* sp = vm_base + src;
+                    /* A display buffer's guest memory never holds what was
+                     * shown (the swap chain does), so it is stale: start the
+                     * aliasing surface black, as the cleared buffer would be
+                     * (display_write_through keeps it current afterwards).
+                     * Seeded from guest bytes, inFamous 2's glow pass fed a
+                     * flat green surface back into every frame. */
+                    int zero_seed = 0;
+                    { extern int cellGcmOffsetIsDisplay(u32 offset);
+                      if (cellGcmOffsetIsDisplay(off)) {
+                          memset(mp, 0, (size_t)pitch * hh);
+                          zero_seed = 1;   /* skip the guest-byte rows below */
+                      } }
+                    /* RES_SCALE: a scaled surface's guest rows go to system memory
+                     * first, then spread to the host size (below). */
+                    u8* gdst = (u8*)mp; u64 gpitch = pitch;
+                    if (!zero_seed && (hw != w || hh != h)) {
+                        gpitch = (u64)w * bpp;
+                        gdst = (u8*)malloc((size_t)(gpitch * h));
+                        if (!gdst) { memset(mp, 0, (size_t)pitch * hh); zero_seed = 1;
+                                     fprintf(stderr, "[RSCALE] seed of 0x%X: out of memory, black%c", off, 10); }
+                    }
+                    for (u32 y = 0; y < h && !zero_seed; y++) {
+                        const u8* srow = sp + (u64)y * w * bpp;
+                        u8* drow = gdst + (u64)y * gpitch;
+                        if (want_fmt == DXGI_FORMAT_R8G8B8A8_UNORM) {
+                            /* guest A8R8G8B8 (bytes A,R,G,B) -> R,G,B,A */
+                            for (u32 x = 0; x < w; x++) {
+                                drow[x*4+0] = srow[x*4+1];
+                                drow[x*4+1] = srow[x*4+2];
+                                drow[x*4+2] = srow[x*4+3];
+                                drow[x*4+3] = srow[x*4+0];
+                            }
+                        } else if (want_fmt == DXGI_FORMAT_R16G16B16A16_FLOAT) {
+                            for (u32 x = 0; x < w * 4; x++) {   /* u16 halves, BE */
+                                drow[x*2+0] = srow[x*2+1];
+                                drow[x*2+1] = srow[x*2+0];
+                            }
+                        } else {                                 /* u32 floats, BE */
+                            u32 nw = (w * bpp) / 4;
+                            for (u32 x = 0; x < nw; x++) {
+                                drow[x*4+0] = srow[x*4+3];
+                                drow[x*4+1] = srow[x*4+2];
+                                drow[x*4+2] = srow[x*4+1];
+                                drow[x*4+3] = srow[x*4+0];
+                            }
+                        }
+                    }
+                    /* RES_SCALE: the guest rows spread to the host size, nearest
+                     * (rsx_rs_guest_of; the seed upscale of design 3.6). */
+                    if (gdst != (u8*)mp) {
+                        if (!zero_seed)
+                            for (u32 Y = 0; Y < hh; Y++) {
+                                const u8* srow = gdst + (u64)rsx_rs_guest_of(Y, h, hh) * gpitch;
+                                u8* drow = (u8*)mp + (u64)Y * pitch;
+                                for (u32 X = 0; X < hw; X++)
+                                    memcpy(drow + (u64)X * bpp, srow + (u64)rsx_rs_guest_of(X, w, hw) * bpp, bpp);
+                            }
+                        free(gdst);
+                    }
+                    r->up->lpVtbl->Unmap(r->up, 0, NULL);
+                    D3D12_TEXTURE_COPY_LOCATION cdst = {0}, csrc = {0};
+                    cdst.pResource = r->res;
+                    cdst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+                    csrc.pResource = r->up;
+                    csrc.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+                    csrc.PlacedFootprint.Footprint.Format   = want_fmt;
+                    csrc.PlacedFootprint.Footprint.Width    = hw;   /* == w unscaled */
+                    csrc.PlacedFootprint.Footprint.Height   = hh;
+                    csrc.PlacedFootprint.Footprint.Depth    = 1;
+                    csrc.PlacedFootprint.Footprint.RowPitch = pitch;
+                    copy_note(__LINE__, &cdst, &csrc); s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &cdst, 0, 0, 0, &csrc, NULL);
+                }
+            }
+        }
+        {
+            D3D12_RESOURCE_BARRIER b = {0};
+            b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+            b.Transition.pResource   = r->res;
+            b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+            b.Transition.StateAfter  = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+            b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+            s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+            r->st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        }
+    }
+
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_d3d.rt_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.rt_rtv_heap, &rh);
+    rh.ptr += (u64)slot * s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    s_d3d.device->lpVtbl->CreateRenderTargetView(s_d3d.device, r->res, NULL, rh);
+
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = td.Format;
+    sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sv.Texture2D.MipLevels = 1;
+    D3D12_CPU_DESCRIPTOR_HANDLE sh;
+    s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &sh);
+    sh.ptr += (u64)(RT_SRV_BASE + slot) * s_d3d.srv_inc;
+    s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, r->res, &sv, sh);
+
+    static int _log = 0;
+    if (_log++ < 8)
+        printf("[D3D12] offscreen RT %d: off=0x%X %ux%u (render-to-texture)\n",
+               slot, off, w, h);
+    return slot;
+}
+
+static D3D12_CPU_DESCRIPTOR_HANDLE off_rt_rtv(int slot)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_d3d.rt_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.rt_rtv_heap, &rh);
+    rh.ptr += (u64)slot * s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+        s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    return rh;
+}
+
+/* Write a texture SRV (or a null SRV when res == NULL) at an absolute SRV
+ * heap slot. Used to fill per-draw t0-t3 descriptor windows. */
+static void srv_write_ex(u32 heap_slot, ID3D12Resource* res, DXGI_FORMAT fmt,
+                         UINT mapping, int cube)
+{
+    /* The null view most units of most draws get: copied from a prebuilt one
+     * (a descriptor copy is a few ns, a CreateShaderResourceView ~25-100). */
+    if (!res && !cube && fmt == DXGI_FORMAT_R8G8B8A8_UNORM &&
+        mapping == D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING && tc_cpu_heap()) {
+        tc_copy_desc(heap_slot, s_tc.cpu_base);
+        return;
+    }
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = fmt;
+    sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sv.Shader4ComponentMapping = mapping;
+    /* every level res has (guest textures: their mips); a null view, one */
+    sv.Texture2D.MipLevels = res ? (UINT)-1 : 1u;
+    if (cube) {   /* must match the TextureCube declaration in the HLSL */
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURECUBE;
+        sv.TextureCube.MipLevels = res ? (UINT)-1 : 1u;
+        sv.TextureCube.MostDetailedMip = 0;
+        sv.TextureCube.ResourceMinLODClamp = 0.0f;
+    }
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &h);
+    h.ptr += (u64)heap_slot * s_d3d.srv_inc;
+    { const u32 w = heap_slot - (u32)DRAW_SRV_BASE;   /* no longer the copied null view */
+      if (w < (u32)(MAX_DRAWS * RSX_DRAW_TEX_UNITS)) s_win_null[w] = 0; }
+    rth_desc(2, h.ptr, res, &sv, sizeof sv);   /* RT_STREAM_LOG */
+    s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, res, &sv, h);
+}
+
+static void srv_write(u32 heap_slot, ID3D12Resource* res, DXGI_FORMAT fmt, UINT mapping)
+{
+    srv_write_ex(heap_slot, res, fmt, mapping, 0);
+}
+
+static void off_rt_transition(int slot, D3D12_RESOURCE_STATES to)
+{
+    OffRT* r = &s_d3d.off_rt[slot];
+    if (r->st == to) return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource   = r->res;
+    b.Transition.StateBefore = r->st;
+    b.Transition.StateAfter  = to;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    r->st = to;
+}
+
+/* DISPLAY_REDIRECT (render_frame): display buffers the title has written as
+ * offscreen surfaces. From then on such a buffer IS that surface: draws and
+ * colour clears aimed at it go there, samplers read it, and a present of it
+ * copies it to the backbuffer. */
+static u32 s_rd_off[4], s_rd_w[4], s_rd_h[4], s_rd_fmt[4]; static int s_rd_n;
+static int rd_has(u32 off)
+{
+    for (int i = 0; i < s_rd_n; i++) if (off && s_rd_off[i] == off) return 1;
+    return 0;
+}
+
+/* RSX_CAP_OPSNAP=<hex surface offset>: while a capture is pending, copy that
+ * offscreen target after every draw into it; a captured batch writes them as
+ * snap_opNNN_<fp id>.bmp (op numbers as in its manifest), so a pass that
+ * spoils a target is visible directly instead of bisected over runs. Batches
+ * that are not captured drop theirs. */
+#define OPSNAP_MAX 256   /* 1280x720 RGBA8 each: ~0.9 GB at the cap, capture only */
+static ID3D12Resource* s_snap[OPSNAP_MAX];
+static u32 s_snap_op[OPSNAP_MAX], s_snap_fp[OPSNAP_MAX];
+static u32 s_snap_w[OPSNAP_MAX], s_snap_h[OPSNAP_MAX], s_snap_dxgi[OPSNAP_MAX];   /* one offset, several sizes */
+static int s_snap_n, s_cap_live;
+static u32 opsnap_target(void)
+{
+    static u32 t = 1;
+    if (t == 1) { const char* e = getenv("RSX_CAP_OPSNAP"); t = e ? (u32)strtoul(e, NULL, 16) : 0; }
+    return t;
+}
+static void opsnap_reset(void)
+{
+    for (int i = 0; i < s_snap_n; i++) { res_grave_put(s_snap[i]); s_snap[i] = NULL; }
+    s_snap_n = 0;
+}
+static void opsnap_after(u32 d, const D3D12DrawRecord* dr, int cur_rt, const int* cur_m)
+{
+    const u32 t = opsnap_target();
+    if (!t || !s_cap_live || s_snap_n >= OPSNAP_MAX) return;
+    /* RSX_CAP_OPSNAP_OPS=<a>-<b>: only ops a..b of a batch (a long G-buffer
+     * pass would fill the OPSNAP_MAX snapshots before the op of interest). */
+    { static u32 lo = 1, hi = 0; static int init = 0;
+      if (!init) { init = 1; const char* e = getenv("RSX_CAP_OPSNAP_OPS");
+                   if (e && sscanf(e, "%u-%u", &lo, &hi) != 2) { lo = 1; hi = 0; } }
+      if (lo <= hi && (d < lo || d > hi)) return; }
+    /* the watched surface as target A or as an MRT plane B..D */
+    if (cur_rt < 0 || s_d3d.off_rt[cur_rt].off != t)
+        for (int _m = 0; _m < 3; _m++)
+            if (cur_m[_m] >= 0 && s_d3d.off_rt[cur_m[_m]].off == t) { cur_rt = cur_m[_m]; break; }
+    if (cur_rt < 0) return;
+    OffRT* r = &s_d3d.off_rt[cur_rt];
+    if (r->off != t || !r->res) return;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = r->hw; td.Height = r->hh; td.DepthOrArraySize = 1; td.MipLevels = 1;   /* host == guest unscaled */
+    td.Format = (DXGI_FORMAT)r->dxgi; td.SampleDesc.Count = 1;
+    ID3D12Resource* s = NULL;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s)) || !s) return;
+    const D3D12_RESOURCE_STATES was = r->st;
+    off_rt_transition(cur_rt, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    s_d3d.cmd_list->lpVtbl->CopyResource(s_d3d.cmd_list, s, r->res);
+    off_rt_transition(cur_rt, was);
+    s_snap[s_snap_n] = s; s_snap_op[s_snap_n] = d; s_snap_fp[s_snap_n] = dr->fp_id;
+    s_snap_w[s_snap_n] = r->hw; s_snap_h[s_snap_n] = r->hh; s_snap_dxgi[s_snap_n] = r->dxgi; s_snap_n++;
+}
+static void opsnap_dump(const char* dir, u32 fi)
+{
+    char path[512];
+    for (int i = 0; i < s_snap_n; i++) {
+        snprintf(path, sizeof path, "%s/snap_op%03u_%08X.bmp", dir, s_snap_op[i], s_snap_fp[i]);
+        cap_readback_write(s_snap[i], s_snap_w[i], s_snap_h[i], s_snap_dxgi[i], D3D12_RESOURCE_STATE_COPY_DEST, fi, path);
+    }
+    opsnap_reset();
+}
