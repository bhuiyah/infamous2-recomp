 }
+
+/* ---------------------------------------------------------------------------
+ * Save states: cellNetCtl's part of the MISC section (runtime/savestate/
+ * ss_state.h), written by cellSysmodule.c, which registers the section:
+ * initialised, and each registered handler's OPD and argument, keyed by its
+ * id. The connection state is not state: it is PS3_NET_ONLINE's, fixed at
+ * startup (offline unless set), and the net-start dialog's events are
+ * already in the sysutil ring (SUTL) when its call returns.
+ * -----------------------------------------------------------------------*/
+typedef struct { uint32_t handler, arg; } NetCtlHandlerRec;   /* the guest values */
+static NetCtlHandlerRec s_ss_handler;                          /* capture scratch */
+static const ss_field k_netctl_ss_fields[] = { SS_FIELD(s_netctl_initialized) };
+const ss_list cellNetCtl_ss_list = SS_LIST("netctl", k_netctl_ss_fields);
+static const ss_field k_netctl_ss_handler_fields[] = {
+    SS_MEMBER(NetCtlHandlerRec, handler), SS_MEMBER(NetCtlHandlerRec, arg),
+};
+const ss_list cellNetCtl_ss_handlers_list = SS_LIST("netctl_handlers", k_netctl_ss_handler_fields);
+
+/* Handler i for the records: -1 past the end, 0 a free slot, 1 = *rec holds
+ * its guest values (until the next call), keyed by its id. */
+int cellNetCtl_ss_handler(uint32_t i, uint32_t* key, const void** rec)
+{
+    if (i >= CELL_NET_CTL_HANDLER_MAX) return -1;
+    if (!s_handlers[i].in_use) return 0;
+    s_ss_handler.handler = (uint32_t)(uintptr_t)s_handlers[i].handler;
+    s_ss_handler.arg     = (uint32_t)(uintptr_t)s_handlers[i].arg;
+    *key = i;
+    *rec = &s_ss_handler;
+    return 1;
+}
+
+/* A load (M4c; cellSysmodule.c reads the image, ss_read_fields writes the
+ * "netctl" list back). Teardown: not initialised, no handler. */
+void cellNetCtl_ss_teardown(void)
+{
+    s_netctl_initialized = 0;
+    memset(s_handlers, 0, sizeof(s_handlers));
+}
+
+/* A "netctl_handlers" record (a NetCtlHandlerRec: the guest values) for
+ * handler id `key`; with apply, registered again. i: the record's place
+ * (unused). 0, or -1 with why. */
+const uint32_t cellNetCtl_ss_handler_size = (uint32_t)sizeof(NetCtlHandlerRec);
+int cellNetCtl_ss_handler_put(uint32_t i, uint32_t key, const void* rec, int apply, char* why, size_t n)
+{
+    const NetCtlHandlerRec* h = (const NetCtlHandlerRec*)rec;
+    (void)i;
+    if (key >= CELL_NET_CTL_HANDLER_MAX) {
+        snprintf(why, n, "no handler %u (%d handlers)", key, CELL_NET_CTL_HANDLER_MAX);
+        return -1;
+    }
+    if (!apply) return 0;
+    s_handlers[key].in_use  = 1;
+    s_handlers[key].handler = (cellNetCtlHandler)(uintptr_t)h->handler;
+    s_handlers[key].arg     = (void*)(uintptr_t)h->arg;
+    return 0;
+}
