+        open(os.path.join(tmp, "driver.cpp"), "w").write(DRIVER)
+        exe = os.path.join(tmp, "e2e.exe" if os.name == "nt" else "e2e")
+        inc = [os.path.join(ROOT, "runtime", "ppu"), os.path.join(ROOT, "runtime", "platform"), tmp]
