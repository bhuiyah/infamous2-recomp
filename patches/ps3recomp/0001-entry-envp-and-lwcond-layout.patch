+/* ---- controller navigation (overlay thread, while open) */
+
+typedef struct {
+    u16  prev;
+    int  dir_prev;          /* -1 none, else the held direction nav */
+    double dir_next;        /* next repeat */
+    int  big_prev;
+    double big_next;
+    int  kind;
+    int  ps_prev;
+    int  armed;             /* prev state taken at open */
+} pad_nav_t;
+static pad_nav_t s_pn;
+
+static int pad_poll_nav(double t, ovl_nav* out, int max)
+{
+    PadHostPortState st;
+    u16 btn = 0;
+    int ps = 0, dir = -1, any = 0;
+    int best = 0;
+    for (int i = 0; i < PADHOST_MAX_PORTS; i++) {
+        if (!padhost_get(i, &st) || !st.connected) continue;
+        any = 1;
+        btn |= st.buttons;
+        ps |= st.ps;
+        const int dx = (int)st.lx - 128, dy = (int)st.ly - 128;
+        const int mag = dx * dx + dy * dy;
+        if (mag > best) {
+            best = mag;
+            if (mag > 64 * 64) dir = abs(dx) > abs(dy) ? (dx < 0 ? OVL_NAV_LEFT : OVL_NAV_RIGHT) : (dy < 0 ? OVL_NAV_UP : OVL_NAV_DOWN);
+        }
+        if (st.buttons) s_pn.kind = st.kind;
+        else if (!s_pn.kind) s_pn.kind = st.kind;
+    }
+    if (!any) { s_pn.prev = 0; s_pn.dir_prev = -1; s_pn.ps_prev = 0; return 0; }
+    if (btn & CELL_PAD_CTRL_UP) dir = OVL_NAV_UP;
+    else if (btn & CELL_PAD_CTRL_DOWN) dir = OVL_NAV_DOWN;
+    else if (btn & CELL_PAD_CTRL_LEFT) dir = OVL_NAV_LEFT;
+    else if (btn & CELL_PAD_CTRL_RIGHT) dir = OVL_NAV_RIGHT;
+    if (!s_pn.armed) {                         /* what is held at open does not count */
+        s_pn.armed = 1; s_pn.prev = btn; s_pn.ps_prev = ps; s_pn.dir_prev = dir; s_pn.dir_next = t + 1e9;
+        s_pn.big_prev = (btn & (CELL_PAD_CTRL_L2 | CELL_PAD_CTRL_R2)) != 0; s_pn.big_next = t + 1e9;
+        return 0;
+    }
+    int n = 0;
+    const u16 down = (u16)(btn & ~s_pn.prev);
+    s_pn.prev = btn;
+    if (ps && !s_pn.ps_prev && n < max) out[n++] = OVL_NAV_CLOSE;
+    s_pn.ps_prev = ps;
+    if ((down & CELL_PAD_CTRL_CROSS) && n < max)    out[n++] = OVL_NAV_ACCEPT;
+    if ((down & CELL_PAD_CTRL_CIRCLE) && n < max)   out[n++] = OVL_NAV_BACK;
+    if ((down & CELL_PAD_CTRL_SQUARE) && n < max)   out[n++] = OVL_NAV_RESET;
+    if ((down & CELL_PAD_CTRL_TRIANGLE) && n < max) out[n++] = OVL_NAV_QUIT;
+    if ((down & CELL_PAD_CTRL_L1) && n < max)       out[n++] = OVL_NAV_TAB_PREV;
+    if ((down & CELL_PAD_CTRL_R1) && n < max)       out[n++] = OVL_NAV_TAB_NEXT;
+    if ((down & CELL_PAD_CTRL_START) && n < max)    out[n++] = OVL_NAV_CLOSE;
+    /* directions and L2 / R2 (coarse), with repeat after 350 ms, then every 80 ms */
+    if (dir != s_pn.dir_prev) {
+        s_pn.dir_prev = dir;
+        if (dir >= 0 && n < max) { out[n++] = (ovl_nav)dir; s_pn.dir_next = t + 0.35; }
+    } else if (dir >= 0 && t >= s_pn.dir_next && n < max) {
+        out[n++] = (ovl_nav)dir;
+        s_pn.dir_next = t + 0.08;
+    }
+    const int big = (btn & CELL_PAD_CTRL_L2) ? OVL_NAV_LEFT_BIG : (btn & CELL_PAD_CTRL_R2) ? OVL_NAV_RIGHT_BIG : -1;
+    if (big != s_pn.big_prev) {
+        s_pn.big_prev = big;
+        if (big >= 0 && n < max) { out[n++] = (ovl_nav)big; s_pn.big_next = t + 0.35; }
+    } else if (big >= 0 && t >= s_pn.big_next && n < max) {
+        out[n++] = (ovl_nav)big;
+        s_pn.big_next = t + 0.08;
+    }
+    return n;
+}
