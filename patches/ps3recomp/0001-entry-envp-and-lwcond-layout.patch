+/* Every port while intercepted: what a pad lying still with nothing pressed
+ * reports for the port's settings (the words the port's len covers). */
+static void pad_neutral_data(CellPadData* d, u32 setting)
+{
+    d->button[CELL_PAD_BTN_OFFSET_DIGITAL1] = 0;
+    d->button[CELL_PAD_BTN_OFFSET_DIGITAL2] = 0;
+    d->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_X] = 0x80;
+    d->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_Y] = 0x80;
+    d->button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X]  = 0x80;
+    d->button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y]  = 0x80;
+    if (setting & CELL_PAD_SETTING_PRESS_ON)
+        for (int k = CELL_PAD_BTN_OFFSET_PRESS_RIGHT; k <= CELL_PAD_BTN_OFFSET_PRESS_R2; k++) d->button[k] = 0;
+    if (setting & CELL_PAD_SETTING_SENSOR_ON) {
+        d->button[CELL_PAD_BTN_OFFSET_SENSOR_X] = 512;
+        d->button[CELL_PAD_BTN_OFFSET_SENSOR_Y] = 399;   /* gravity, as a pad without sensors */
+        d->button[CELL_PAD_BTN_OFFSET_SENSOR_Z] = 512;
+        d->button[CELL_PAD_BTN_OFFSET_SENSOR_G] = 512;
+    }
+}
