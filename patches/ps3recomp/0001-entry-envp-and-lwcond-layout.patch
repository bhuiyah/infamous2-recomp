+    /* Test 19: every pack/unpack opcode, names and the HLSL each becomes. */
+    {
+        static const struct { u32 op; const char* name; const char* call; const char* decl; int unpack; } t[] = {
+            { 0x27, "PKB",  "rsx_pkb((h[1]).xyzw)",          "float rsx_pkb(float4 v)",   0 },
+            { 0x2C, "PKG",  "rsx_pkg((h[1]).xyzw)",          "float rsx_pkg(float4 v)",   0 },
+            { 0x13, "PK4",  "rsx_pk4((h[1]).xyzw)",          "float rsx_pk4(float4 v)",   0 },
+            { 0x24, "PK2",  "rsx_pk2((h[1]).xyzw)",          "float rsx_pk2(float4 v)",   0 },
+            { 0x29, "PK16", "rsx_pk16((h[1]).xyzw)",         "float rsx_pk16(float4 v)",  0 },
+            { 0x28, "UPB",  "rsx_upb(((r[1]).xyzw).x)",      "float4 rsx_upb(float v)",   1 },
+            { 0x2D, "UPG",  "rsx_upg(((r[1]).xyzw).x)",      "float4 rsx_upg(float v)",   1 },
+            { 0x14, "UP4",  "rsx_up4(((r[1]).xyzw).x)",      "float4 rsx_up4(float v)",   1 },
+            { 0x25, "UP2",  "rsx_up2(((r[1]).xyzw).x)",      "float4 rsx_up2(float v)",   1 },
+            { 0x2A, "UP16", "rsx_up16(((r[1]).xyzw).x)",     "float4 rsx_up16(float v)",  1 },
+        };
+        for (u32 i = 0; i < sizeof t / sizeof t[0]; i++) {
+            u8 prog[16];
+            const u32 xmask = 1u << 9;
+            /* pack: R0.x <- pack(H1) ; unpack: H0.xyzw <- unpack(R1.x) */
+            put_word(prog + 0, OPC(t[i].op) | (t[i].unpack ? (OUTMASK_ALL | OUTHALF) : xmask) | END);
+            put_word(prog + 4, T_TEMP | REG(1) | (t[i].unpack ? 0u : (1u << 8)) | SWZ_IDENT | EXEC_ALWAYS);
+            put_word(prog + 8, 0); put_word(prog + 12, 0);
+            char tn[64];
+            snprintf(tn, sizeof tn, "pack_name_%s", t[i].name);
+            check_true(tn, strcmp(rsx_fp_opcode_name(t[i].op), t[i].name) == 0);
+            u32 nk = 0;
+            rsx_fp_decompile_buffered_ex(prog, sizeof(prog), CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+            snprintf(tn, sizeof tn, "pack_call_%s", t[i].name);
+            check(tn, hlsl, t[i].call);
+            snprintf(tn, sizeof tn, "pack_decl_%s", t[i].name);
+            check(tn, hlsl, t[i].decl);
+            snprintf(tn, sizeof tn, "pack_write_%s", t[i].name);
+            check(tn, hlsl, t[i].unpack ? "h[0].xyzw = rsx_h16(_v).xyzw;" : "r[0].x = _v.x;");
+            /* the same in an unbuffered program (pure ALU) */
+            rsx_fp_decompile(prog, sizeof(prog), CTRL_16BIT, hlsl, sizeof(hlsl));
+            snprintf(tn, sizeof tn, "pack_unbuffered_%s", t[i].name);
+            check(tn, hlsl, t[i].decl);
+        }
+        /* A program with no pack op declares none of the helpers. */
+        u8 mov[16];
+        put_word(mov + 0, OPC(0x01) | OUTMASK_ALL | INSRC(1) | END);
+        put_word(mov + 4, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(mov + 8, 0); put_word(mov + 12, 0);
+        u32 nk = 0;
+        rsx_fp_decompile_buffered_ex(mov, sizeof(mov), CTRL_32BIT, 0, hlsl, sizeof(hlsl), &nk);
