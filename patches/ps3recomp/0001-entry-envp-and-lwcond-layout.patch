+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <stdio.h>
+#include <string.h>
+#include <wchar.h>
+
+#include "cellPad.h"                         /* cellPad_host_hotkey*, cellPad_host_input_hold */
+#include "pad_hotkeys.h"                     /* HK_* action ids */
+#include "../../runtime/savestate/ss_ui.h"   /* requests, slot labels, notices */
+#include "ps3emu/play_issues.h"            /* F8: mark a problem moment */
+
+#define WM_APP_WINMENU   (WM_APP + 0x2D16)   /* a notice is waiting (posted from any thread) */
+#ifndef WM_DPICHANGED
+#define WM_DPICHANGED    0x02E0
+#endif
+#define OSD_TIMER_ID     1
+
+enum { MK_NONE = 0, MK_FILE, MK_SAVE, MK_LOAD, MK_VIEW };
+
+static HMENU             s_bar;              /* the menu bar (attached or not) */
+static HWND              s_hwnd;             /* the game window */
+static rsx_winmenu_host  s_host;
+static rsx_winmenu_hooks s_hooks;
+static int               s_in_menu;          /* WM_ENTERMENULOOP depth */
+static int               s_show_fps;         /* own FPS box on */
+static double            s_fps = -1.0;
+
+/* notice handed over from any thread */
+static SRWLOCK           s_nlock = SRWLOCK_INIT;
+static char              s_ntext[200];
+static unsigned          s_nms;
+
+/* the notice / FPS box */
+static HWND              s_osd;
+static HFONT             s_osd_font;
+static UINT              s_osd_font_dpi;
+static wchar_t           s_osd_text[260];
+static char              s_osd_notice[200];
+static ULONGLONG         s_osd_notice_until;
+
+static UINT win_dpi(HWND h)
+{
+    typedef UINT (WINAPI *fn_t)(HWND);
+    static fn_t f = (fn_t)(intptr_t)-1;
+    if (f == (fn_t)(intptr_t)-1) {
+        HMODULE u = GetModuleHandleA("user32.dll");
+        f = u ? (fn_t)(void*)GetProcAddress(u, "GetDpiForWindow") : NULL;
+    }
+    UINT d = (f && h) ? f(h) : 0;
+    return d >= 48 && d <= 960 ? d : 96;
+}
+
+static void to_wide(const char* s, wchar_t* w, int n)
+{
+    if (!MultiByteToWideChar(CP_UTF8, 0, s, -1, w, n) && n > 0) {
+        int k = 0;                                    /* not UTF-8: bytes as Latin-1 */
+        for (; s[k] && k + 1 < n; k++) w[k] = (unsigned char)s[k];
+        w[k] = 0;
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * Menus
+ * -----------------------------------------------------------------------*/
+static void menu_kind_set(HMENU m, int kind)
+{
+    MENUINFO mi;
+    memset(&mi, 0, sizeof mi);
+    mi.cbSize = sizeof mi;
+    mi.fMask = MIM_MENUDATA;
+    mi.dwMenuData = (ULONG_PTR)kind;
+    SetMenuInfo(m, &mi);
+}
+
+static int menu_kind(HMENU m)
+{
+    MENUINFO mi;
+    memset(&mi, 0, sizeof mi);
+    mi.cbSize = sizeof mi;
+    mi.fMask = MIM_MENUDATA;
+    return (m && GetMenuInfo(m, &mi)) ? (int)mi.dwMenuData : MK_NONE;
+}
+
+static void menu_clear(HMENU m)
+{
+    while (GetMenuItemCount(m) > 0) DeleteMenu(m, 0, MF_BYPOSITION);
+}
+
+/* "text" or "text<TAB>keys"; flags: MF_GRAYED, MF_CHECKED. */
+static void menu_add(HMENU m, UINT flags, int id, const char* text, const char* keys)
+{
+    char t[256];
+    if (keys && *keys) snprintf(t, sizeof t, "%s\t%s", text, keys);
+    else snprintf(t, sizeof t, "%s", text);
+    wchar_t w[256];
+    to_wide(t, w, 256);
+    AppendMenuW(m, MF_STRING | flags, (UINT_PTR)(RSX_WINMENU_ID_BASE + id), w);
+}
+
+static const char* hk_keys(int action, char* buf, int n)
+{
+    if (!cellPad_host_hotkey_text(action, buf, n)) buf[0] = 0;
+    return buf;
+}
+
+static void fill_file(HMENU m)
+{
+    menu_clear(m);
+    menu_add(m, 0, RSX_WINMENU_ID_OPEN_FOLDER - RSX_WINMENU_ID_BASE, "&Open Save State Folder", NULL);
+    AppendMenuW(m, MF_SEPARATOR, 0, NULL);
+    menu_add(m, 0, RSX_WINMENU_ID_EXIT - RSX_WINMENU_ID_BASE, "E&xit", "Alt+F4");
+}
+
+/* The menu text of a numbered slot: "Slot &3  -  today 14:03" (the label
+ * from ss_ui, with the slot's digit as the mnemonic: 1..9, then 1&0). */
+static void slot_text(const ss_slot_info* in, char* t, size_t n)
+{
+    char head[16];
+    if (in->slot == 10) snprintf(head, sizeof head, "Slot 1&0");
+    else snprintf(head, sizeof head, "Slot &%d", in->slot);
+    const char* rest = in->label;
+    while (*rest && *rest != ' ') rest++;           /* past "Slot" */
+    if (*rest) rest++;
+    while (*rest >= '0' && *rest <= '9') rest++;    /* past the number */
+    snprintf(t, n, "%s%s", head, rest);
+}
+
+static void fill_slots(HMENU m, int save)
+{
+    char keys[40], t[200], why[160];
+    /* the engine's rule (not before the game's first frame, not while a save
+     * or load runs, save states off): everything greyed, the reason on top */
+    const int avail = ss_ui_available(save ? SS_UI_OP_SAVE : SS_UI_OP_LOAD, why, sizeof why);
+    const int busy = ss_ui_busy() || !avail;
+    ss_slot_info in;
+    menu_clear(m);
+    if (!avail) {
+        snprintf(t, sizeof t, "(%s)", why);
+        menu_add(m, MF_GRAYED, 0, t, NULL);
+        AppendMenuW(m, MF_SEPARATOR, 0, NULL);
+    }
+    ss_ui_slot_info(SS_UI_QUICK, &in);
+    if (save) {
+        menu_add(m, busy ? MF_GRAYED : 0, HK_QUICK_SAVE, "&Quick Save", hk_keys(HK_QUICK_SAVE, keys, sizeof keys));
+    } else {
+        const char* rest = in.label + strlen("Quick slot");
+        snprintf(t, sizeof t, "Quick &Load%s", strncmp(in.label, "Quick slot", 10) ? "" : rest);
+        menu_add(m, (busy || !in.used) ? MF_GRAYED : 0, HK_QUICK_LOAD, t, hk_keys(HK_QUICK_LOAD, keys, sizeof keys));
+    }
+    AppendMenuW(m, MF_SEPARATOR, 0, NULL);
+    const int nslots = ss_ui_slot_count();
+    for (int s = 1; s <= nslots; s++) {
+        ss_ui_slot_info(s, &in);
+        slot_text(&in, t, sizeof t);
+        const int a = (save ? HK_SAVE_SLOT1 : HK_LOAD_SLOT1) + s - 1;
+        menu_add(m, (busy || (!save && !in.used)) ? MF_GRAYED : 0, a, t, hk_keys(a, keys, sizeof keys));
+    }
+    if (!save) {   /* the undo point: the moment before the last load */
+        AppendMenuW(m, MF_SEPARATOR, 0, NULL);
+        ss_ui_slot_info(SS_UI_UNDO, &in);
+        const size_t nl = strlen("Undo last load");
+        snprintf(t, sizeof t, "&Undo Last Load%s", strncmp(in.label, "Undo last load", nl) ? "" : in.label + nl);
+        menu_add(m, (busy || !in.used) ? MF_GRAYED : 0, HK_UNDO_LOAD, t, hk_keys(HK_UNDO_LOAD, keys, sizeof keys));
+    }
+}
+
+static int fps_shown(void)
+{
+    if (s_hooks.get_show_fps && s_hooks.set_show_fps) return s_hooks.get_show_fps();
+    return s_show_fps;
+}
+
+static void fill_view(HMENU m)
+{
+    char keys[40];
+    menu_clear(m);
+    const int fs = s_host.is_fullscreen ? s_host.is_fullscreen() : 0;
+    menu_add(m, fs ? MF_CHECKED : 0, HK_FULLSCREEN, "&Fullscreen", hk_keys(HK_FULLSCREEN, keys, sizeof keys));
+    menu_add(m, fps_shown() ? MF_CHECKED : 0, HK_SHOW_FPS, "Show F&PS", hk_keys(HK_SHOW_FPS, keys, sizeof keys));
+    AppendMenuW(m, MF_SEPARATOR, 0, NULL);
+    const char* ok = s_hooks.options_keys && *s_hooks.options_keys ? s_hooks.options_keys
+                                                                    : hk_keys(HK_OPTIONS, keys, sizeof keys);
+    menu_add(m, s_hooks.open_options ? 0 : MF_GRAYED, HK_OPTIONS, "&Options...", ok);
+    menu_add(m, pi_active() ? 0 : MF_GRAYED, HK_MARK, "&Mark a Problem Here", hk_keys(HK_MARK, keys, sizeof keys));
+}
+
+static void fill(HMENU m)
+{
+    switch (menu_kind(m)) {
+    case MK_FILE: fill_file(m); break;
+    case MK_SAVE: fill_slots(m, 1); break;
+    case MK_LOAD: fill_slots(m, 0); break;
+    case MK_VIEW: fill_view(m); break;
+    default: break;
+    }
+}
+
+/* File / Save / Load / View popups appended to `bar` (a menu bar or a popup).
+ * No '&' in these four names: Alt+letter never opens the bar (cellPad.c
+ * swallows SC_KEYMENU), so an underlined letter would promise a key that does
+ * nothing. Inside an open menu the items' letters do work. */
+static int add_popups(HMENU bar)
+{
+    static const struct { int kind; const wchar_t* name; } p[] = {
+        { MK_FILE, L"File" }, { MK_SAVE, L"Save" }, { MK_LOAD, L"Load" }, { MK_VIEW, L"View" } };
+    for (int i = 0; i < 4; i++) {
+        HMENU m = CreatePopupMenu();
+        if (!m) return 0;
+        menu_kind_set(m, p[i].kind);
+        fill(m);
+        if (!AppendMenuW(bar, MF_POPUP | MF_STRING, (UINT_PTR)m, p[i].name)) { DestroyMenu(m); return 0; }
+    }
+    return 1;
+}
+
+void* rsx_winmenu_create(void)
+{
+    if (s_bar) return s_bar;
+    HMENU bar = CreateMenu();
+    if (!bar) return NULL;
+    if (!add_popups(bar)) { DestroyMenu(bar); return NULL; }
+    s_bar = bar;
+    return bar;
+}
+
+/* ---------------------------------------------------------------------------
+ * The notice / FPS box
+ * -----------------------------------------------------------------------*/
+static LRESULT CALLBACK osd_proc(HWND h, UINT msg, WPARAM wp, LPARAM lp);
+static void osd_update(void);
+
+static int osd_make(void)
+{
+    if (s_osd) return 1;
+    if (!s_hwnd) return 0;
+    static int failed = 0;
+    if (failed) return 0;
+    WNDCLASSEXW wc;
+    memset(&wc, 0, sizeof wc);
+    wc.cbSize = sizeof wc;
+    wc.lpfnWndProc = osd_proc;
+    wc.hInstance = GetModuleHandleW(NULL);
+    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
+    wc.lpszClassName = L"ps3recomp_osd";
+    RegisterClassExW(&wc);
+    s_osd = CreateWindowExW(WS_EX_LAYERED | WS_EX_TRANSPARENT | WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW,
+                            wc.lpszClassName, L"", WS_POPUP, 0, 0, 1, 1, s_hwnd, NULL, wc.hInstance, NULL);
+    if (!s_osd) {
+        failed = 1;
+        printf("[winmenu] notice box unavailable (error %lu): notices go to the log only\n",
+               (unsigned long)GetLastError());
+        fflush(stdout);
+        return 0;
+    }
+    SetLayeredWindowAttributes(s_osd, 0, 224, LWA_ALPHA);
+    return 1;
+}
+
+static void osd_font(void)
+{
+    const UINT dpi = win_dpi(s_hwnd);
+    if (s_osd_font && s_osd_font_dpi == dpi) return;
+    if (s_osd_font) DeleteObject(s_osd_font);
+    s_osd_font = CreateFontW(-MulDiv(15, (int)dpi, 96), 0, 0, 0, FW_SEMIBOLD, FALSE, FALSE, FALSE,
+                             DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY,
+                             DEFAULT_PITCH | FF_SWISS, L"Segoe UI");
+    s_osd_font_dpi = dpi;
+}
+
+static void osd_update(void)
+{
+    char t[260];
+    t[0] = 0;
+    const ULONGLONG now = GetTickCount64();
+    const int fps_own = s_show_fps && !(s_hooks.get_show_fps && s_hooks.set_show_fps);
+    if (fps_own) {
+        if (s_fps >= 0.0) snprintf(t, sizeof t, "%.0f FPS", s_fps);
+        else snprintf(t, sizeof t, "-- FPS");
+    }
+    if (s_osd_notice[0] && now < s_osd_notice_until) {
+        size_t u = strlen(t);
+        snprintf(t + u, sizeof t - u, "%s%s", u ? "\n" : "", s_osd_notice);
+    } else {
+        s_osd_notice[0] = 0;
+    }
+    if (!t[0] || !s_hwnd || IsIconic(s_hwnd)) {
+        if (s_osd) { ShowWindow(s_osd, SW_HIDE); KillTimer(s_osd, OSD_TIMER_ID); }
+        return;
+    }
+    if (!osd_make()) return;
+    osd_font();
+    to_wide(t, s_osd_text, 260);
+    const UINT dpi = win_dpi(s_hwnd);
+    const int pad = MulDiv(8, (int)dpi, 96), margin = MulDiv(12, (int)dpi, 96);
+    HDC dc = GetDC(s_osd);
+    HGDIOBJ old = SelectObject(dc, s_osd_font);
+    RECT r = { 0, 0, 0, 0 };
+    DrawTextW(dc, s_osd_text, -1, &r, DT_CALCRECT | DT_NOPREFIX | DT_LEFT);
+    SelectObject(dc, old);
+    ReleaseDC(s_osd, dc);
+    const int w = r.right + 2 * pad, h = r.bottom + 2 * pad;
+    int px = 0, py = 0, pw = 0, ph = 0;
+    if (s_host.picture_rect) s_host.picture_rect(s_hwnd, &px, &py, &pw, &ph);
+    POINT o = { px + margin, py + margin };
+    ClientToScreen(s_hwnd, &o);
+    SetWindowRgn(s_osd, CreateRoundRectRgn(0, 0, w + 1, h + 1, 2 * pad, 2 * pad), FALSE);
+    SetWindowPos(s_osd, NULL, o.x, o.y, w, h, SWP_NOZORDER | SWP_NOACTIVATE | SWP_SHOWWINDOW);
+    InvalidateRect(s_osd, NULL, TRUE);
+    if (s_osd_notice[0]) {
+        const ULONGLONG left = s_osd_notice_until - now;
+        SetTimer(s_osd, OSD_TIMER_ID, (UINT)(left < 50 ? 50 : left + 20), NULL);
+    } else {
+        KillTimer(s_osd, OSD_TIMER_ID);
+    }
+}
+
+static LRESULT CALLBACK osd_proc(HWND h, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg) {
+    case WM_NCHITTEST:    return HTTRANSPARENT;
+    case WM_MOUSEACTIVATE: return MA_NOACTIVATE;
+    case WM_ERASEBKGND:   return 1;
+    case WM_TIMER:
+        if (wp == OSD_TIMER_ID) { osd_update(); return 0; }
+        break;
+    case WM_PAINT: {
+        PAINTSTRUCT ps;
+        HDC dc = BeginPaint(h, &ps);
+        RECT rc;
+        GetClientRect(h, &rc);
+        HBRUSH bg = CreateSolidBrush(RGB(16, 18, 24));
+        FillRect(dc, &rc, bg);
+        DeleteObject(bg);
+        const int pad = MulDiv(8, (int)win_dpi(s_hwnd), 96);
+        InflateRect(&rc, -pad, -pad);
+        HGDIOBJ old = SelectObject(dc, s_osd_font);
+        SetBkMode(dc, TRANSPARENT);
+        SetTextColor(dc, RGB(240, 242, 246));
+        DrawTextW(dc, s_osd_text, -1, &rc, DT_NOPREFIX | DT_LEFT);
+        SelectObject(dc, old);
+        EndPaint(h, &ps);
+        return 0;
+    }
+    }
+    return DefWindowProcW(h, msg, wp, lp);
+}
+
+static void osd_notice(const char* text, unsigned ms)
+{
+    snprintf(s_osd_notice, sizeof s_osd_notice, "%s", text);
+    s_osd_notice_until = GetTickCount64() + (ms ? ms : 2500);
+    osd_update();
+}
+
+/* ss_ui's notice sink: any thread. The latest notice wins. */
+static void notice_sink(const char* text, unsigned ms, void* user)
+{
+    (void)user;
+    AcquireSRWLockExclusive(&s_nlock);
+    snprintf(s_ntext, sizeof s_ntext, "%s", text);
+    s_nms = ms;
+    ReleaseSRWLockExclusive(&s_nlock);
+    HWND h = s_hwnd;
+    if (h) PostMessageW(h, WM_APP_WINMENU, 0, 0);
+}
+
+static void notice_deliver(void)
+{
+    char t[200];
+    unsigned ms;
+    AcquireSRWLockShared(&s_nlock);
+    snprintf(t, sizeof t, "%s", s_ntext);
+    ms = s_nms;
+    ReleaseSRWLockShared(&s_nlock);
+    if (!t[0]) return;
+    if (s_hooks.notice) s_hooks.notice(t, ms);
+    else osd_notice(t, ms);
+}
+
+/* ---------------------------------------------------------------------------
+ * Actions
+ * -----------------------------------------------------------------------*/
+static void open_folder(void)
+{
+    /* ss_ui_dir() comes from the ANSI file APIs (GetFullPathNameA): it is in
+     * the ANSI code page, not UTF-8: a folder with an accented letter (byte
+     * 0xE9 in cp1252) through to_wide would reach Explorer as U+FFFD and
+     * open the wrong folder. */
+    wchar_t dir[320], win[MAX_PATH], exe[MAX_PATH + 16], cmd[720];
+    if (!MultiByteToWideChar(CP_ACP, 0, ss_ui_dir(), -1, dir, 320)) dir[0] = 0;
+    if (!ss_ui_ensure_dir()) {
+        char u8[640];
+        if (!WideCharToMultiByte(CP_UTF8, 0, dir, -1, u8, (int)sizeof u8, NULL, NULL)) u8[0] = 0;
+        ss_ui_notify(3000, "Cannot create the save-state folder %s", u8);
+        return;
+    }
+    if (!dir[0]) return;
+    UINT n = GetWindowsDirectoryW(win, MAX_PATH);
+    if (!n || n >= MAX_PATH) return;
+    swprintf(exe, MAX_PATH + 16, L"%ls\\explorer.exe", win);      /* not found via PATH */
+    swprintf(cmd, 720, L"\"%ls\" \"%ls\"", exe, dir);
+    STARTUPINFOW si;
+    PROCESS_INFORMATION pi;
+    memset(&si, 0, sizeof si);
+    si.cb = sizeof si;
+    if (CreateProcessW(exe, cmd, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi)) {
+        CloseHandle(pi.hThread);
+        CloseHandle(pi.hProcess);
+    }
+}
+
+static void popup_menu(HWND h);
+
+static void run_action(HWND h, int a)
+{
+    if (a >= HK_SAVE_SLOT1 && a < HK_SAVE_SLOT1 + HK_SLOTS) { ss_ui_request_save(a - HK_SAVE_SLOT1 + 1); return; }
+    if (a >= HK_LOAD_SLOT1 && a < HK_LOAD_SLOT1 + HK_SLOTS) { ss_ui_request_load(a - HK_LOAD_SLOT1 + 1); return; }
+    switch (a) {
+    case HK_QUICK_SAVE: ss_ui_request_save(SS_UI_QUICK); break;
+    case HK_QUICK_LOAD: ss_ui_request_load(SS_UI_QUICK); break;
+    case HK_UNDO_LOAD:  ss_ui_request_undo(); break;
+    case HK_FULLSCREEN: if (s_host.toggle_fullscreen) s_host.toggle_fullscreen(h); break;
+    case HK_SHOW_FPS:
+        if (s_hooks.get_show_fps && s_hooks.set_show_fps) s_hooks.set_show_fps(!s_hooks.get_show_fps());
+        else { s_show_fps = !s_show_fps; osd_update(); }
+        break;
+    case HK_OPTIONS:
+        if (s_hooks.open_options) s_hooks.open_options();
+        else ss_ui_notify(2500, "Options are not available yet");
+        break;
+    case HK_MARK: {
+        const int n = pi_mark();
+        if (n) ss_ui_notify(2500, "Marked #%d in the issues log", n);
+        else ss_ui_notify(3500, "The issues log is off (it runs when the game is started without arguments)");
+        break;
+    }
+    case HK_MENU:
+        if (GetMenu(h)) DefWindowProcA(h, WM_SYSCOMMAND, SC_KEYMENU, 0);   /* past cellPad's SC_KEYMENU filter */
+        else popup_menu(h);
+        break;
+    default: break;
+    }
+}
+
+static void run_command(HWND h, int id)
+{
+    if (id == RSX_WINMENU_ID_OPEN_FOLDER) open_folder();
+    else if (id == RSX_WINMENU_ID_EXIT) PostMessageW(h, WM_CLOSE, 0, 0);
+    else if (id > RSX_WINMENU_ID_BASE && id < RSX_WINMENU_ID_BASE + HK_COUNT) run_action(h, id - RSX_WINMENU_ID_BASE);
+}
+
+/* No menu bar (fullscreen, or menu_bar = 0): the same menus as a popup in
+ * the picture's top-left corner. */
+static void popup_menu(HWND h)
+{
+    HMENU pm = CreatePopupMenu();
+    if (!pm) return;
+    if (add_popups(pm)) {
+        int px = 0, py = 0, pw = 0, ph = 0;
+        if (s_host.picture_rect) s_host.picture_rect(h, &px, &py, &pw, &ph);
+        POINT o = { px + 8, py + 8 };
+        ClientToScreen(h, &o);
+        SetForegroundWindow(h);
+        int id = (int)TrackPopupMenuEx(pm, TPM_RETURNCMD | TPM_LEFTALIGN | TPM_TOPALIGN | TPM_RIGHTBUTTON,
+                                       o.x, o.y, h, NULL);
+        PostMessageW(h, WM_NULL, 0, 0);
+        if (id) run_command(h, id);
+    }
+    DestroyMenu(pm);                                /* and its four popups */
+}
+
+/* ---------------------------------------------------------------------------
+ * Window side
+ * -----------------------------------------------------------------------*/
+void rsx_winmenu_attach(void* hwnd, const rsx_winmenu_host* host, int show_fps)
+{
+    s_hwnd = (HWND)hwnd;
+    if (host) s_host = *host;
+    s_show_fps = show_fps ? 1 : 0;
+    ss_ui_set_notice_sink(notice_sink, NULL);
+    printf("[winmenu] %s; save states in %s (Save / Load menus; keys in input.ini [hotkeys])\n",
+           GetMenu(s_hwnd) ? "menu bar on (display.ini menu_bar = 0 hides it)" : "no menu bar",
+           ss_ui_dir());
+    fflush(stdout);
+    if (s_show_fps) osd_update();
+}
+
+void rsx_winmenu_set_hooks(const rsx_winmenu_hooks* h)
+{
+    if (h) s_hooks = *h;
+    else memset(&s_hooks, 0, sizeof s_hooks);
+    osd_update();
+}
+
+int rsx_winmenu_in_menu(void) { return s_in_menu > 0; }
+
+int rsx_winmenu_osd_text(char* buf, int n)
+{
+    if (buf && n > 0) {
+        buf[0] = 0;
+        if (s_osd && IsWindowVisible(s_osd) &&
+            !WideCharToMultiByte(CP_UTF8, 0, s_osd_text, -1, buf, n, NULL, NULL))
+            buf[0] = 0;
+    }
+    return s_osd && IsWindowVisible(s_osd) ? 1 : 0;
+}
+
+void rsx_winmenu_set_fullscreen(void* hwnd, int on)
+{
+    HWND h = (HWND)hwnd;
+    if (!h) return;
+    if (on) {
+        HMENU m = GetMenu(h);
+        if (m) { s_bar = m; SetMenu(h, NULL); }
+    } else if (s_bar && !GetMenu(h)) {
+        SetMenu(h, s_bar);
+    }
+}
+
+void rsx_winmenu_fps(double fps)
+{
+    s_fps = fps;
+    if (s_show_fps && !(s_hooks.get_show_fps && s_hooks.set_show_fps)) osd_update();
+}
+
+int rsx_winmenu_message(void* hwnd, unsigned int msg, uintptr_t wp, intptr_t lp, intptr_t* result)
+{
+    HWND h = (HWND)hwnd;
+    switch (msg) {
+    case WM_KEYDOWN: case WM_SYSKEYDOWN: {
+        const int a = cellPad_host_hotkey(msg, wp, lp);
+        if (!a) return 0;
+        if (!(a & HK_REPEAT)) run_action(h, a);
+        *result = 0;
+        return 1;
+    }
+    case WM_COMMAND:
+        if (HIWORD(wp) == 0 && lp == 0 && LOWORD(wp) > RSX_WINMENU_ID_BASE &&
+            LOWORD(wp) <= RSX_WINMENU_ID_EXIT) {
+            run_command(h, (int)LOWORD(wp));
+            *result = 0;
+            return 1;
+        }
+        return 0;
+    case WM_INITMENUPOPUP:
+        if (menu_kind((HMENU)wp) == MK_NONE) return 0;   /* the system menu */
+        fill((HMENU)wp);
+        *result = 0;
+        return 1;
+    case WM_ENTERMENULOOP:
+        /* The menu loop takes the keyboard, but the pad reads held keys
+         * directly: hold game input. Not consumed -- the backend starts its
+         * modal timer here, which keeps the frame clock (and the game) going
+         * inside the loop. */
+        if (s_in_menu++ == 0) cellPad_host_input_hold(1);
+        return 0;
+    case WM_EXITMENULOOP:
+        if (s_in_menu > 0 && --s_in_menu == 0) cellPad_host_input_hold(0);
+        return 0;
+    case WM_APP_WINMENU:
+        if (wp == 1) osd_update();                  /* re-place the box after a size / move */
+        else notice_deliver();
+        *result = 0;
+        return 1;
+    case WM_SIZE: case WM_MOVE: case WM_DPICHANGED:
+        /* Not consumed: the backend lays the picture out on these. The box
+         * follows the new picture rectangle afterwards (posted). */
+        if ((s_osd && IsWindowVisible(s_osd)) ||
+            (msg == WM_SIZE && wp != SIZE_MINIMIZED && (s_show_fps || s_osd_notice[0])))
+            PostMessageW(h, WM_APP_WINMENU, 1, 0);
+        return 0;
+    case WM_DESTROY:
+        ss_ui_set_notice_sink(NULL, NULL);
+        if (s_in_menu) { s_in_menu = 0; cellPad_host_input_hold(0); }
+        if (s_osd) { DestroyWindow(s_osd); s_osd = NULL; }
+        if (s_osd_font) { DeleteObject(s_osd_font); s_osd_font = NULL; }
+        s_osd_notice[0] = 0;                        /* nothing carries over to another window */
+        s_fps = -1.0;
+        if (s_bar && GetMenu(h) != s_bar) DestroyMenu(s_bar);   /* detached (fullscreen): ours to free */
+        s_bar = NULL;
+        s_hwnd = NULL;
+        return 0;
+    }
+    return 0;
+}
+
+#else /* !_WIN32: no window menu */
+
+void* rsx_winmenu_create(void) { return 0; }
+void  rsx_winmenu_attach(void* hwnd, const rsx_winmenu_host* host, int show_fps)
+{ (void)hwnd; (void)host; (void)show_fps; }
+int   rsx_winmenu_message(void* hwnd, unsigned int msg, uintptr_t wp, intptr_t lp, intptr_t* result)
+{ (void)hwnd; (void)msg; (void)wp; (void)lp; (void)result; return 0; }
+void  rsx_winmenu_set_fullscreen(void* hwnd, int on) { (void)hwnd; (void)on; }
+void  rsx_winmenu_fps(double fps) { (void)fps; }
+void  rsx_winmenu_set_hooks(const rsx_winmenu_hooks* hooks) { (void)hooks; }
+int   rsx_winmenu_in_menu(void) { return 0; }
+int   rsx_winmenu_osd_text(char* buf, int n) { if (buf && n > 0) buf[0] = 0; return 0; }
+
+#endif /* _WIN32 */
diff --git a/libs/video/rsx_winmenu.h b/libs/video/rsx_winmenu.h
new file mode 100644
index 0000000..910c4ca
--- /dev/null
+++ b/libs/video/rsx_winmenu.h
@@ -0,0 +1,111 @@
+/*
+ * ps3recomp - the game window's menu bar and window hotkeys (Windows)
+ *
+ *   File   Open Save State Folder | Exit (Alt+F4)
+ *   Save   Quick Save (F5) | Slot 1 .. Slot 10, each with its time (Ctrl+F1..F10)
+ *   Load   Quick Load (F9) | Slot 1 .. Slot 10, empty slots greyed
+ *          (Ctrl+Shift+F1..F10) | Undo Last Load: the moment before the last
+ *          load, greyed with nothing to undo (Ctrl+Z)
+ *   View   Fullscreen (F11) | Show FPS | Options... (greyed until an overlay
+ *          plugs in, rsx_winmenu_set_hooks)
+ * The keys are the defaults; input.ini [hotkeys] changes them and the menu
+ * shows whatever is bound.
+ *
+ * A native Win32 menu on the backend's top-level window. Save / load go to
+ * runtime/savestate/ss_ui.h, which only QUEUES them for the save-state
+ * coordinator (the frame clock's ss_frame_tick): nothing runs in the window
+ * procedure. The keys are the input.ini [hotkeys] table (pad_hotkeys.h,
+ * owned by cellPad.c); they work without the menu bar too.
+ *
+ * Window. The window is created with the menu (the client area -- and so
+ * the picture -- keeps the size it had without one: the backend adds the
+ * menu's height to the frame), the bar is taken off in borderless fullscreen
+ * and put back when it ends. display.ini menu_bar = 0 (env RSX_MENU=0): no
+ * bar; the hotkeys stay.
+ * Keyboard. Alt alone, Alt+letter and F10 do not open the menu (cellPad.c
+ * swallows SC_KEYMENU: they are play keys / release the mouse); a click on
+ * the bar does, and so does the `menu` hotkey if one is bound (in fullscreen
+ * it opens the same menus as a popup in the picture's corner).
+ * Game input while a menu is open: none from the keyboard and mouse
+ * (cellPad_host_input_hold); the game keeps running (the backend's modal
+ * timer drives the frame clock inside the menu loop).
+ * Notices ("Saved to slot 3", "Save states are not available yet") and the
+ * FPS counter: a small click-through box in the picture's top-left corner --
+ * an owned, layered, never-activated popup window drawn with GDI. Chosen over
+ * the window title (hidden in borderless fullscreen, rewritten every second
+ * with the FPS) and over text drawn by the renderer (no font pipeline yet; it
+ * would also land in the frame). It is not part of the game's frame
+ * (CELLMARK_DUMP, RSX_CAP and a PrintWindow of the game window never contain
+ * it), but a grab of the screen (kbm_inject / checkpoint "shot") does while it
+ * shows: only after a save / load request, or with Show FPS on. It shows in
+ * borderless fullscreen too. An overlay can take both over
+ * (rsx_winmenu_hooks).
+ *
+ * In the window procedure, call rsx_winmenu_message before
+ * cellPad_host_window_message (a hotkey must not be latched as game input);
+ * an overlay that owns the keyboard while it is open goes before both.
+ * Everything here runs on the window's thread, which is the frame clock / RSX
+ * walker thread (rsx_winmenu_fps is called from the present, on it too).
+ * Notices may come from any thread: ss_ui_notify posts them to the window.
+ */
+#ifndef PS3RECOMP_RSX_WINMENU_H
+#define PS3RECOMP_RSX_WINMENU_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* What the presenting backend provides. HWNDs travel as void*. */
+typedef struct rsx_winmenu_host {
+    void (*toggle_fullscreen)(void* hwnd);
+    int  (*is_fullscreen)(void);
+    /* The picture's rectangle in the window's client coordinates. */
+    void (*picture_rect)(void* hwnd, int* x, int* y, int* w, int* h);
+} rsx_winmenu_host;
+
+/* What an overlay (the options menu) plugs in later; NULL members keep the
+ * menu's own behaviour. Called on the window thread.
+ * The overlay's own window-procedure hook runs before rsx_winmenu_message,
+ * so a key it takes there must match its modifiers exactly: an "F1 with any
+ * modifiers" test would eat Ctrl+F1 (save to slot 1) and Ctrl+Shift+F1
+ * (load slot 1). Simplest: bind it as the `options` hotkey (input.ini
+ * [hotkeys] options = F1) and let open_options be called from here. */
+typedef struct rsx_winmenu_hooks {
+    void        (*open_options)(void);             /* View > Options...; NULL: greyed */
+    const char*   options_keys;                    /* its key for the menu text ("F1"), or NULL */
+    int         (*get_show_fps)(void);             /* both set: the overlay draws the FPS */
+    void        (*set_show_fps)(int on);
+    void        (*notice)(const char* text, unsigned ms);   /* set: the overlay shows notices */
+} rsx_winmenu_hooks;
+
+/* The menu bar for CreateWindowEx (an HMENU), or NULL if it cannot be made. */
+void* rsx_winmenu_create(void);
+/* After the window exists (the menu passed to it or not): hotkey actions,
+ * notices, the FPS box. show_fps: display.ini show_fps. */
+void  rsx_winmenu_attach(void* hwnd, const rsx_winmenu_host* host, int show_fps);
+/* Window procedure hook: non-zero = consumed, *result is the return value. */
+int   rsx_winmenu_message(void* hwnd, unsigned int msg, uintptr_t wp, intptr_t lp, intptr_t* result);
+/* Borderless fullscreen on (bar off) / off (bar back): the backend calls it
+ * after changing the style and before restoring the window placement. */
+void  rsx_winmenu_set_fullscreen(void* hwnd, int on);
+/* Presented frames per second, about once a second. */
+void  rsx_winmenu_fps(double fps);
+void  rsx_winmenu_set_hooks(const rsx_winmenu_hooks* hooks);
+int   rsx_winmenu_in_menu(void);                   /* a menu loop is running */
+/* The notice / FPS box: 1 while it shows, its text (UTF-8) in buf. For tests
+ * and diagnostics. */
+int   rsx_winmenu_osd_text(char* buf, int n);
+
+/* Command ids: RSX_WINMENU_ID_BASE + HK_* (pad_hotkeys.h) for the actions,
+ * and these two. */
+#define RSX_WINMENU_ID_BASE        0x5300
+#define RSX_WINMENU_ID_OPEN_FOLDER (RSX_WINMENU_ID_BASE + 0x40)
+#define RSX_WINMENU_ID_EXIT        (RSX_WINMENU_ID_BASE + 0x41)
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_RSX_WINMENU_H */
diff --git a/libs/video/tests/fp_pack_programs.h b/libs/video/tests/fp_pack_programs.h
new file mode 100644
index 0000000..13cb84e
--- /dev/null
+++ b/libs/video/tests/fp_pack_programs.h
@@ -0,0 +1,138 @@
+/*
+ * Hand-assembled RSX fragment programs for the pack/unpack and TEX_bx2 tests
+ * (test_fp_decompiler.c, test_fp_warp.c), in guest byte order as the RSX
+ * reads them. Field layout as rsx_fp_decompiler.c (RPCS3 RSXFragmentProgram.h).
+ * No title's microcode is embedded here.
+ *
+ * fpt_gbuffer is the shape of inFamous 2's G-buffer character materials
+ * (Cole's head is fphash 6004A381), reduced to what decides the albedo export:
+ *
+ *   0 TEX     H2.xyz, TC0, TEX0      albedo texel (sRGB-encoded bytes)
+ *   1 PKB     R0.x, H2.xyzx          \ sRGB -> linear through a packed word
+ *   2 UPG     R3.xyz, R0             /
+ *   3 MUL     H4.xyz, R3, c[0]       the "lit" albedo (c[0] = 1)
+ *   4 TEX_bx2 H6.yw, TC0, TEX1       DXT5-style normal x/y, expanded to 2c - 1
+ *   5 TEX     H0.y, TC0, TEX7        a mask texel lands in H0 ...
+ *   6 PKG     R0.x, H4.xyzx          \ ... and is overwritten by the albedo,
+ *   7 UPB     H0.xyz, R0     END     / linear -> sRGB -> 4 x unorm8 -> H0
+ *
+ * 16-bit exports: t0 = H0, t1 = H4, t2 = H6, t3 = H8. With 1/2/6/7 dropped
+ * (the decompiler before pack/unpack support) t0 is (0, mask.y, 0, 0): the
+ * solid green heads.
+ */
+#ifndef FP_PACK_PROGRAMS_H
+#define FP_PACK_PROGRAMS_H
+
+#include "../rsx_fp_decompiler.h"
+#include <string.h>
+
+#define FPT_OPC(x)              ((u32)(x) << 24)
+#define FPT_END                 1u
+#define FPT_MX 1u
+#define FPT_MY 2u
+#define FPT_MZ 4u
+#define FPT_MW 8u
+#define FPT_DST(reg, half, m)   (((u32)(reg) << 1) | ((half) ? 0x80u : 0u) | ((u32)(m) << 9))
+#define FPT_INSRC(x)            ((u32)(x) << 13)
+#define FPT_TEXU(x)             ((u32)(x) << 17)
+#define FPT_BX2                 (1u << 21)
+#define FPT_SWZ(x, y, z, w)     (((u32)(x) << 9) | ((u32)(y) << 11) | ((u32)(z) << 13) | ((u32)(w) << 15))
+#define FPT_XYZW                FPT_SWZ(0, 1, 2, 3)
+#define FPT_XYZX                FPT_SWZ(0, 1, 2, 0)
+#define FPT_TEMP(reg, half)     (((u32)(reg) << 2) | ((half) ? 0x100u : 0u))
+#define FPT_INPUT               1u
+#define FPT_CONST               2u
+#define FPT_SRC2_ABS            (1u << 18)
+/* exec_if lt|eq|gt, identity condition swizzle: unconditional. */
+#define FPT_ALWAYS              ((7u << 18) | (0u << 21) | (1u << 23) | (2u << 25) | (3u << 27))
+
+#define FPT_OP_MUL  0x02u
+#define FPT_OP_MAD  0x04u
+#define FPT_OP_TEX  0x17u
+#define FPT_OP_PK4  0x13u
+#define FPT_OP_UP4  0x14u
+#define FPT_OP_PK2  0x24u
+#define FPT_OP_UP2  0x25u
+#define FPT_OP_PKB  0x27u
+#define FPT_OP_UPB  0x28u
+#define FPT_OP_PK16 0x29u
+#define FPT_OP_UP16 0x2Au
+#define FPT_OP_PKG  0x2Cu
+#define FPT_OP_UPG  0x2Du
+
+/* Guest bytes such that rsx_fp_read_word(p) == w (big-endian, halves swapped). */
+static inline void fpt_put(u8* p, u32 w)
+{
+    const u32 be = (w << 16) | (w >> 16);
+    p[0] = (u8)(be >> 24); p[1] = (u8)(be >> 16); p[2] = (u8)(be >> 8); p[3] = (u8)be;
+}
+
+static inline void fpt_putf(u8* p, float f)
+{
+    u32 w;
+    memcpy(&w, &f, 4);
+    fpt_put(p, w);
+}
+
+/* One instruction at p; `k` (when not NULL) is its inline constant slot.
+ * Returns the bytes written (16 or 32). */
+static inline u32 fpt_ins(u8* p, u32 w0, u32 w1, u32 w2, u32 w3, const float* k)
+{
+    fpt_put(p + 0, w0); fpt_put(p + 4, w1); fpt_put(p + 8, w2); fpt_put(p + 12, w3);
+    if (!k)
+        return 16u;
+    for (int i = 0; i < 4; i++)
+        fpt_putf(p + 16 + 4 * i, k[i]);
+    return 32u;
+}
+
+#define FPT_GBUFFER_BYTES 144u   /* 8 instructions + 1 constant slot */
+
+static inline u32 fpt_gbuffer(u8* p)
+{
+    static const float one[4] = { 1.0f, 1.0f, 1.0f, 1.0f };
+    u32 o = 0;
+    o += fpt_ins(p + o, FPT_OPC(FPT_OP_TEX) | FPT_DST(2, 1, FPT_MX | FPT_MY | FPT_MZ) | FPT_INSRC(4) | FPT_TEXU(0),
+                 FPT_INPUT | FPT_XYZW | FPT_ALWAYS, 0, 0, NULL);
+    o += fpt_ins(p + o, FPT_OPC(FPT_OP_PKB) | FPT_DST(0, 0, FPT_MX),
+                 FPT_TEMP(2, 1) | FPT_XYZX | FPT_ALWAYS, 0, 0, NULL);
+    o += fpt_ins(p + o, FPT_OPC(FPT_OP_UPG) | FPT_DST(3, 0, FPT_MX | FPT_MY | FPT_MZ),
+                 FPT_TEMP(0, 0) | FPT_XYZW | FPT_ALWAYS, 0, 0, NULL);
+    o += fpt_ins(p + o, FPT_OPC(FPT_OP_MUL) | FPT_DST(4, 1, FPT_MX | FPT_MY | FPT_MZ),
+                 FPT_TEMP(3, 0) | FPT_XYZW | FPT_ALWAYS, FPT_CONST | FPT_XYZW, 0, one);
+    o += fpt_ins(p + o, FPT_OPC(FPT_OP_TEX) | FPT_DST(6, 1, FPT_MY | FPT_MW) | FPT_INSRC(4) | FPT_TEXU(1) | FPT_BX2,
+                 FPT_INPUT | FPT_XYZW | FPT_ALWAYS, 0, 0, NULL);
+    o += fpt_ins(p + o, FPT_OPC(FPT_OP_TEX) | FPT_DST(0, 1, FPT_MY) | FPT_INSRC(4) | FPT_TEXU(7),
+                 FPT_INPUT | FPT_XYZW | FPT_ALWAYS, 0, 0, NULL);
+    o += fpt_ins(p + o, FPT_OPC(FPT_OP_PKG) | FPT_DST(0, 0, FPT_MX),
+                 FPT_TEMP(4, 1) | FPT_XYZX | FPT_ALWAYS, 0, 0, NULL);
+    o += fpt_ins(p + o, FPT_OPC(FPT_OP_UPB) | FPT_DST(0, 1, FPT_MX | FPT_MY | FPT_MZ) | FPT_END,
+                 FPT_TEMP(0, 0) | FPT_XYZW | FPT_ALWAYS, 0, 0, NULL);
+    return o;
+}
+
+/* `OP dst, c[0]` (END): a pack writes R0.x, an unpack H0.xyzw. 32 bytes. */
+static inline u32 fpt_pack_op(u8* p, u32 op, int unpack, const float k[4])
+{
+    const u32 dst = unpack ? FPT_DST(0, 1, FPT_MX | FPT_MY | FPT_MZ | FPT_MW) : FPT_DST(0, 0, FPT_MX);
+    return fpt_ins(p, FPT_OPC(op) | dst | FPT_END, FPT_CONST | FPT_XYZW | FPT_ALWAYS, 0, 0, k);
+}
+
+/* PKB R1.x, c[0] ; UPB H0.xyzw, R1 (END): a packed word carried through a
+ * register between two instructions. 48 bytes. */
+static inline u32 fpt_pkb_upb(u8* p, const float k[4])
+{
+    u32 o = fpt_ins(p, FPT_OPC(FPT_OP_PKB) | FPT_DST(1, 0, FPT_MX), FPT_CONST | FPT_XYZW | FPT_ALWAYS, 0, 0, k);
+    o += fpt_ins(p + o, FPT_OPC(FPT_OP_UPB) | FPT_DST(0, 1, FPT_MX | FPT_MY | FPT_MZ | FPT_MW) | FPT_END,
+                 FPT_TEMP(1, 0) | FPT_XYZW | FPT_ALWAYS, 0, 0, NULL);
+    return o;
+}
+
+/* MAD R0, c[0], c[0], |c[0]| (END): SRC2's abs bit. 32 bytes. */
+static inline u32 fpt_mad_src2_abs(u8* p, const float k[4])
+{
+    return fpt_ins(p, FPT_OPC(FPT_OP_MAD) | FPT_DST(0, 0, FPT_MX | FPT_MY | FPT_MZ | FPT_MW) | FPT_END,
+                   FPT_CONST | FPT_XYZW | FPT_ALWAYS, FPT_CONST | FPT_XYZW, FPT_CONST | FPT_XYZW | FPT_SRC2_ABS, k);
+}
+
+#endif /* FP_PACK_PROGRAMS_H */
diff --git a/libs/video/tests/spec_audit_test.c b/libs/video/tests/spec_audit_test.c
new file mode 100644
index 0000000..263acc7
--- /dev/null
+++ b/libs/video/tests/spec_audit_test.c
@@ -0,0 +1,420 @@
+/*
+ * spec_audit_test.c -- hardware-spec expectations for the RSX shader decompilers
+ * and the texture layout/remap helpers. Every check states the HARDWARE/SPEC
+ * behaviour; a FAIL is a discrepancy in our implementation (not a test bug).
+ *
+ * Sources per check (docs/GROUND_TRUTH.md sections 2, 3, 6): NV_fragment_program
+ * (3.11.1.1 f[WPOS].w = 1/w, 3.11.4.1 storage precision, 3.11.4.2 fx12
+ * conversion, 3.11.4.4 destination and CC update, 3.11.5.x PK and UP ops),
+ * NV_fragment_program_option (X precision overflow), NV_vertex_program
+ * 2.14.1.5 (colour clamp), 2.14.1.9 (relative reads out of range),
+ * 2.14.1.10.x, NV_vertex_program1_1 / NV_vertex_program2 (RCC, RSQ, LG2,
+ * EXP, LOG), NV_fragment_program2 3.11.5.51 (NRM), RPCS3 hw-test notes for the
+ * encoding-only fields (source precision modifiers, SRC2.perspective_corr,
+ * per-format texture presentation / remap rules). Checks of RSX-only fields
+ * that the title does not need (GROUND_TRUTH 1.2 rule 2) test the mechanism
+ * with its env switch on and say that the default is off.
+ *
+ * Build, from this directory (no D3D dependency):
+ *   cc -std=c11 -I../../../include -I.. spec_audit_test.c ../rsx_fp_decompiler.c \
+ *      ../rsx_vp_decompiler.c ../rsx_texture_layout.c -lm -o spec_audit_test
+ *   (Windows: clang-cl -std:c17 -I../../../include -I.. spec_audit_test.c
+ *    ../rsx_fp_decompiler.c ../rsx_vp_decompiler.c ../rsx_texture_layout.c)
+ */
+#ifndef _WIN32
+#define _POSIX_C_SOURCE 200809L   /* setenv / unsetenv under -std=c11 */
+#endif
+#include "rsx_fp_decompiler.h"
+#include "rsx_vp_decompiler.h"
+#include "rsx_texture_layout.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <stdint.h>
+
+static void set_env(const char* k, const char* v)   /* v NULL: unset */
+{
+#ifdef _WIN32
+    _putenv_s(k, v ? v : "");
+#else
+    if (v) setenv(k, v, 1); else unsetenv(k);
+#endif
+}
+
+static int g_pass = 0, g_fail = 0;
+static void res(const char* id, int ok, const char* what)
+{
+    printf("[%s] %-34s %s\n", ok ? "PASS" : "FAIL", id, what);
+    if (ok) g_pass++; else g_fail++;
+}
+
+/* ---- FP encoding helpers (same convention as tests/test_fp_decompiler.c) */
+static void put_word(u8* p, u32 h)
+{
+    u32 be = (h << 16) | (h >> 16);
+    p[0] = (u8)(be >> 24); p[1] = (u8)(be >> 16); p[2] = (u8)(be >> 8); p[3] = (u8)be;
+}
+static void put_float(u8* p, float f) { u32 h; memcpy(&h, &f, 4); put_word(p, h); }
+#define OPC(x)      ((u32)(x) << 24)
+#define END         1u
+#define OUTREG(i)   ((u32)(i) << 1)
+#define OUTHALF     (1u << 7)
+#define SETCC       (1u << 8)
+#define MASK(x,y,z,w) (((x)<<9)|((y)<<10)|((z)<<11)|((w)<<12))
+#define INSRC(x)    ((u32)(x) << 13)
+#define TEXU(x)     ((u32)(x) << 17)
+#define PREC(p)     ((u32)(p) << 22)
+#define SAT         (1u << 31)
+#define T_TEMP 0u
+#define T_INPUT 1u
+#define T_CONST 2u
+#define REG(i)      ((u32)(i) << 2)
+#define SHALF       (1u << 8)
+#define SWZ(a,b,c,d) (((u32)(a)<<9)|((u32)(b)<<11)|((u32)(c)<<13)|((u32)(d)<<15))
+#define SWZ_IDENT   SWZ(0,1,2,3)
+#define NEG         (1u << 17)
+#define ABS0        (1u << 29)        /* SRC0 abs, in w1 */
+#define EXEC_ALWAYS ((7u << 18) | (0u << 21) | (1u << 23) | (2u << 25) | (3u << 27))
+#define EXEC_EQ_X   ((2u << 18))      /* exec_if_eq only, cond swizzle xxxx */
+#define SRCMOD0(m)  ((u32)(m) << 19)  /* in w2 (SRC1 word) */
+#define SRCMOD1(m)  ((u32)(m) << 22)
+#define PERSP       (1u << 31)        /* in w3 (SRC2 word) */
+
+static char hlsl[65536];
+
+static int fp1(u32 w0, u32 w1, u32 w2, u32 w3, const float* k, u32 ctrl)
+{
+    u8 prog[32]; memset(prog, 0, sizeof prog);
+    put_word(prog, w0); put_word(prog + 4, w1); put_word(prog + 8, w2); put_word(prog + 12, w3);
+    u32 n = 16;
+    if (k) { for (int i = 0; i < 4; i++) put_float(prog + 16 + 4 * i, k[i]); n = 32; }
+    return rsx_fp_decompile(prog, n, ctrl, hlsl, sizeof hlsl);
+}
+
+/* ---- VP encoding (rsx_vp_decompiler.c header): one instruction, LE words */
+static char vh[300000];
+#define VSRC_IDENT ((3u << 8) | (2u << 10) | (1u << 12) | (0u << 14))
+static int vp1(u32 d0, u32 d1, u32 d2, u32 d3)
+{
+    u8 vp[16]; u32 w[4] = { d0, d1, d2, d3 };
+    for (int i = 0; i < 4; i++) { vp[4*i] = (u8)w[i]; vp[4*i+1] = (u8)(w[i] >> 8); vp[4*i+2] = (u8)(w[i] >> 16); vp[4*i+3] = (u8)(w[i] >> 24); }
+    return rsx_vp_decompile(vp, 16, vh, sizeof vh);
+}
+/* scalar op `sca` on c[cidx].x into o[dst].x (the scalar unit reads SRC2) */
+static int vp_sca(u32 sca, u32 cidx, u32 dst)
+{
+    const u32 src2 = 3u;                                     /* constant, .xxxx */
+    return vp1(0x3Fu << 15, (sca << 27) | (cidx << 12), (src2 >> 11) & 0x3Fu,
+               1u | (dst << 2) | (0x3Fu << 7) | (1u << 20) | ((src2 & 0x7FFu) << 21));
+}
+/* MOV o[dst], <src0> with the vector unit */
+static int vp_mov(u32 src0, u32 cidx, int index_const, u32 dst)
+{
+    return vp1((1u << 30) | (0x3Fu << 15), (1u << 22) | (cidx << 12) | ((src0 >> 9) & 0xFFu),
+               (src0 & 0x1FFu) << 23,
+               1u | ((u32)index_const << 1) | (dst << 2) | (0x3Fu << 7) | (0xFu << 13));
+}
+
+/* the body line of the single instruction (first line with "_v =") */
+static const char* body_line(void)
+{
+    static char line[2048];
+    const char* p = strstr(hlsl, "float4 _v =");
+    if (!p) return "";
+    const char* e = strchr(p, '\n'); size_t n = e ? (size_t)(e - p) : strlen(p);
+    if (n >= sizeof line) n = sizeof line - 1;
+    memcpy(line, p, n); line[n] = 0; return line;
+}
+
+/* ---- C mirrors of the HLSL pack helpers (text in rsx_fp_decompiler.c) ---- */
+static float clampf(float v, float lo, float hi) { return v < lo ? lo : v > hi ? hi : v; }
+static u32 ours_pk4(const float v[4])
+{
+    u32 r = 0;
+    for (int i = 0; i < 4; i++) r |= ((u32)(int)nearbyintf(clampf(v[i], -1.f, 1.f) * 127.f) & 0xFFu) << (8 * i);
+    return r;
+}
+static void ours_up4(u32 u, float o[4])
+{
+    for (int i = 0; i < 4; i++) { int b = (int)(int8_t)(u >> (8 * i)); o[i] = fmaxf((float)b / 127.f, -1.f); }
+}
+/* NV_fragment_program 3.11.5.21 PK4B / 3.11.5.42 UP4B */
+static u32 spec_pk4(const float v[4])
+{
+    u32 r = 0;
+    for (int i = 0; i < 4; i++) {
+        float t = clampf(v[i], -128.f / 127.f, 127.f / 127.f);
+        r |= ((u32)nearbyintf(127.f * t + 128.f) & 0xFFu) << (8 * i);
+    }
+    return r;
+}
+static void spec_up4(u32 u, float o[4])
+{
+    for (int i = 0; i < 4; i++) o[i] = ((float)((u >> (8 * i)) & 0xFFu) - 128.f) / 127.f;
+}
+static u32 pkb(const float v[4])   /* ours == spec 3.11.5.22 */
+{
+    u32 r = 0;
+    for (int i = 0; i < 4; i++) r |= ((u32)nearbyintf(clampf(v[i], 0.f, 1.f) * 255.f)) << (8 * i);
+    return r;
+}
+static float h2f(u32 h)
+{
+    u32 s = (h >> 15) & 1, e = (h >> 10) & 31, m = h & 1023;
+    float f;
+    if (e == 0) f = ldexpf((float)m, -24);
+    else if (e == 31) f = m ? NAN : INFINITY;
+    else f = ldexpf((float)(m | 1024), (int)e - 25);
+    return s ? -f : f;
+}
+
+int main(void)
+{
+    /* ================= FRAGMENT PROGRAM ================= */
+    float k5[4] = { 5.f, 5.f, 5.f, 5.f };
+    float k1[4] = { 1.f, 0.f, 0.f, 0.f };
+
+    /* FP-1: source precision modifier SATURATE (SRC1 bits 22-24 = 4) on src1:
+     * ADD R2.zw, R1, -sat(R1)  (inFamous 2 god-ray loop, fp ADD0CB4D..., op 8) */
+    fp1(OPC(0x03) | MASK(0,0,1,1) | OUTREG(2) | END,
+        T_TEMP | REG(1) | SWZ_IDENT | EXEC_ALWAYS,
+        T_TEMP | REG(1) | SWZ_IDENT | NEG | SRCMOD1(4), 0, NULL, 0x40);
+    res("FP-1 srcmod sat (src1)", strstr(body_line(), "saturate") != NULL,
+        "ADD R2.zw,R1,-R1[sat] must read -saturate(R1)");
+    printf("        ours: %s\n", body_line());
+
+    /* FP-2: source modifier FX9 (3) on src0 -- clamp to [-1,1] after abs, before
+     * neg (RPCS3 GetSRC order, hw-tested). RSX-only, no title instruction needs
+     * it (3200686E's three uses clamp |cos| <= 1): off by default, so the
+     * mechanism is checked with FP_SRCPREC=0x18. */
+    set_env("FP_SRCPREC", "0x18");
+    fp1(OPC(0x03) | MASK(0,1,0,0) | OUTREG(2) | OUTHALF | PREC(1) | END,
+        T_TEMP | REG(2) | SHALF | SWZ(2,2,2,2) | NEG | ABS0 | EXEC_ALWAYS,
+        T_CONST | SWZ(0,0,0,0) | SRCMOD0(3), 0, k1, 0x00);
+    set_env("FP_SRCPREC", NULL);
+    res("FP-2 srcmod fx9 (src0)", strstr(body_line(), "-(rsx_fx9(abs((h[2]).zzzz)))") != NULL &&
+                                  strstr(hlsl, "clamp(x, -1.0, 1.0)") != NULL,
+        "ADD H2.y,-|H2.z|[fx9],c must read -clamp(|H2.z|,-1,1) [default off: FP_SRCPREC=0x18]");
+
+    /* FP-3: destination precision FX12 (OPDEST 22-23 = 2): MOV_X H0.w, 5.0 ->
+     * [-2048/1024, 2047/1024], NaN 0 (NV_fp 3.11.4.2, NV_fp_option) */
+    fp1(OPC(0x01) | MASK(0,0,0,1) | OUTHALF | PREC(2) | END,
+        T_CONST | SWZ_IDENT | EXEC_ALWAYS, 0, 0, k5, 0x00);
+    res("FP-3 dst prec fx12", strstr(body_line(), "_v = rsx_fx12(_v);") != NULL &&
+                              strstr(hlsl, "isnan(x) ? (float4)0 : clamp(x, -2.0, 1.9990234375)") != NULL,
+        "MOV_X result must clamp to [-2, 2047/1024] (NV_fp fx12 conversion)");
+
+    /* FP-4: COL0/COL1 reach the program in [0,1]: clamped per vertex, then
+     * interpolated (NV_vertex_program 2.14.1.5) -- the VS epilogue (VP-1), so
+     * the read is raw; VP_COLSAT=2 clamps at the read instead (RPCS3's
+     * placement of its hw-test finding). */
+    fp1(OPC(0x01) | MASK(1,1,1,1) | INSRC(1) | END, T_INPUT | SWZ_IDENT | EXEC_ALWAYS, 0, 0, NULL, 0x40);
+    {
+        const int raw = strstr(body_line(), "((input.col0).xyzw)") != NULL;
+        set_env("VP_COLSAT", "2");
+        fp1(OPC(0x01) | MASK(1,1,1,1) | INSRC(1) | END, T_INPUT | SWZ_IDENT | EXEC_ALWAYS, 0, 0, NULL, 0x40);
+        set_env("VP_COLSAT", NULL);
+        res("FP-4 COL0 in [0,1]", raw && strstr(body_line(), "saturate(input.col0)") != NULL,
+            "clamped once: at the VS output (default) or at the read (VP_COLSAT=2)");
+    }
+
+    /* FP-5: SRC2.perspective_corr (w3 bit 31): TEX R0, TEX2 with the flag =
+     * sample at tc2 * (1/w); D3D's SV_Position.w is clip w (NV f[WPOS].w is 1/w) */
+    fp1(OPC(0x17) | MASK(1,1,1,1) | INSRC(6) | TEXU(0) | END,
+        T_INPUT | SWZ_IDENT | EXEC_ALWAYS, 0, PERSP, NULL, 0x40);
+    res("FP-5 persp flag on TEXn", strstr(hlsl, "(input.tc2 * rsx_iw)") != NULL &&
+                                   strstr(hlsl, "const float rsx_iw = 1.0 / input.position.w;") != NULL,
+        "TEX with SRC2.perspective_corr must scale TEX2 by 1/w");
+    printf("        ours: %s\n", body_line());
+
+    /* FP-6: CC update under a conditional write (NV_fp 3.11.4.4: CC changes only
+     * where write mask AND condition test pass). MOV_C0 R0.x, k (EQ cc0.x) */
+    fp1(OPC(0x01) | MASK(1,0,0,0) | SETCC | END, T_CONST | SWZ_IDENT | EXEC_EQ_X, 0, 0, k1, 0x40);
+    {
+        const char* c = strstr(hlsl, "cc0.x =");
+        int ok = c && strncmp(c, "cc0.x = _p.x ? _v.x : cc0.x;", 28) == 0;
+        res("FP-6 CC update predicated", ok, "failing components must keep their OLD CC, not the old dest value");
+        if (c) { char l[96]; snprintf(l, sizeof l, "%.60s", c); char* e = strchr(l, '\n'); if (e) *e = 0;
+                 printf("        ours: %s\n", l); }
+        /* FP-11: the destination half of the same rule -- a select, since
+         * lerp(dst, v, p) is NaN when either side is INF/NaN */
+        res("FP-11 dst update predicated", strstr(hlsl, "r[0].x = _p.x ? _v.x : r[0].x;") != NULL &&
+                                           strstr(hlsl, "lerp(") == NULL,
+            "a failing component keeps its old value exactly (INF/NaN included)");
+        /* FP-12: "FL" (no exec bit) writes neither the register nor the CC */
+        fp1(OPC(0x01) | MASK(1,0,0,0) | SETCC | END, T_CONST | SWZ_IDENT, 0, 0, k1, 0x40);
+        res("FP-12 FL writes nothing", strstr(hlsl, "cc0.x =") == NULL && strstr(hlsl, "r[0].x =") == NULL,
+            "exec_if none: destination and CC unchanged");
+    }
+
+    /* FP-13: H registers are fp16 storage (NV_fp 3.11.4.1): MOV H0, R1 */
+    fp1(OPC(0x01) | MASK(1,1,1,1) | OUTHALF | END, T_TEMP | REG(1) | SWZ_IDENT | EXEC_ALWAYS, 0, 0, NULL, 0x00);
+    res("FP-13 H write is fp16", strstr(body_line(), "h[0].xyzw = rsx_h16(_v).xyzw;") != NULL &&
+                                 strstr(hlsl, "f16tof32(f32tof16(x))") != NULL,
+        "an H register holds an fp16 value");
+
+    /* FP-15: the CC is generated from the value the destination holds (NV_fp
+     * 3.11.4.4: "each component of the destination register enabled for
+     * writes is compared to zero"; GenerateCC(DstT)): MOVC H0.x, k */
+    fp1(OPC(0x01) | MASK(1,0,0,0) | OUTHALF | SETCC | END, T_CONST | SWZ_IDENT | EXEC_ALWAYS, 0, 0, k1, 0x00);
+    res("FP-15 CC from the stored value", strstr(hlsl, "cc0.x = rsx_h16(_v).x;") != NULL,
+        "an H destination's CC is the fp16 value it now holds");
+
+    /* FP-14: source saturate before abs (RPCS3 GetSRC, hw-tested order):
+     * -|sat(R1)| */
+    fp1(OPC(0x03) | MASK(1,1,1,1) | OUTREG(2) | END, T_TEMP | REG(1) | SWZ_IDENT | NEG | ABS0 | EXEC_ALWAYS,
+        T_TEMP | REG(1) | SWZ_IDENT | SRCMOD0(4), 0, NULL, 0x40);
+    res("FP-14 srcmod sat before abs", strstr(body_line(), "-(abs(saturate((r[1]).xyzw)))") != NULL,
+        "saturate, then abs, then negate");
+
+    /* FP-7: opcodes the specs define that the decompiler leaves unhandled */
+    {
+        static const struct { u32 op; const char* name; int nsrc; } u[] = {
+            { 0x07, "DST", 2 }, { 0x1E, "LIT", 1 }, { 0x36, "RFL", 2 }, { 0x20, "STR", 0 },
+            { 0x21, "SFL", 0 }, { 0x2E, "DP2A", 3 }, { 0x19, "TXD", 3 }, { 0x2B, "BEM", 3 },
+            { 0x33, "TEXBEM", 3 }, { 0x34, "TXPBEM", 3 } };
+        for (unsigned i = 0; i < sizeof u / sizeof u[0]; i++) {
+            fp1(OPC(u[i].op) | MASK(1,1,1,1) | END, T_TEMP | REG(1) | SWZ_IDENT | EXEC_ALWAYS,
+                T_TEMP | REG(2) | SWZ_IDENT, T_TEMP | REG(3) | SWZ_IDENT, NULL, 0x40);
+            char id[48]; snprintf(id, sizeof id, "FP-7 opcode %s", u[i].name);
+            res(id, strstr(hlsl, "TODO: unhandled") == NULL, "defined by NV_fp/NV_fp2 (unused by inFamous 2)");
+        }
+    }
+
+    /* FP-8: KIL with a condition kills if ANY tested component passes (3.11.5.11) */
+    fp1(OPC(0x12) | END, (5u << 18) /* GT|LT = NE */ | EXEC_ALWAYS * 0 | ((u32)0 << 21), 0, 0, NULL, 0x40);
+    res("FP-8 KIL any()", strstr(hlsl, "if (any(cc0") != NULL, "KIL NE cc0.xxxx -> any()");
+
+    /* FP-9: scale is applied before saturate (RPCS3 SetDst, no public spec) */
+    fp1(OPC(0x01) | MASK(1,1,1,1) | SAT | END, T_CONST | SWZ_IDENT | EXEC_ALWAYS, (1u << 28), 0, k1, 0x40);
+    res("FP-9 scale then saturate", strstr(body_line(), "* 2.0; _v = saturate(_v)") != NULL ||
+                                   strstr(body_line(), "* 2.0; _v = saturate") != NULL, "x2 then _SAT");
+
+    /* FP-10: an export gathered from the other register file carries RAW BITS
+     * (e.g. PKB/PKG packed words into h4 under 16-bit exports). Hardware stores
+     * the bits; our NaN guard zeroes that channel (the guard is per component,
+     * GROUND_TRUTH 3.5) when a half is a NaN pattern. PKB(1,1,0,0) =
+     * 0x0000FFFF -> h4.x = fp16 0xFFFF = NaN. */
+    {
+        u8 prog[64]; memset(prog, 0, sizeof prog);
+        /* PKB R2.x, R1 ; MOV H0, R1 (END) -- 16-bit exports, target 1 = h4 = r2.x/y */
+        put_word(prog + 0, OPC(0x27) | MASK(1,0,0,0) | OUTREG(2));
+        put_word(prog + 4, T_TEMP | REG(1) | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 16, OPC(0x01) | MASK(1,1,1,1) | OUTHALF | END);
+        put_word(prog + 20, T_TEMP | REG(1) | SWZ_IDENT | EXEC_ALWAYS);
+        rsx_fp_set_min_targets(2);
+        rsx_fp_decompile(prog, 32, 0x00, hlsl, sizeof hlsl);
+        rsx_fp_set_min_targets(1);
+        const float v[4] = { 1.f, 1.f, 0.f, 0.f };
+        u32 word = pkb(v);
+        float hx = h2f(word & 0xFFFF);
+        int gathered = strstr(hlsl, "f16tof32(asuint(r[2].x))") != NULL;
+        int guard = strstr(hlsl, "_out.t1 = (_o1 == _o1) ? _o1 : (float4)0;") != NULL;
+        printf("        PKB(1,1,0,0)=0x%08X h4.x=fp16(0x%04X)=%f  gathered=%d nan-guard=%d\n",
+               word, word & 0xFFFF, hx, gathered, guard);
+        res("FP-10 raw-bit export survives", !(gathered && guard && isnan(hx)),
+            "bit-packed export must reach the target bit-exactly (no NaN guard / float round-trip)");
+    }
+
+    /* ================= PACK / UNPACK numerics (NV_fragment_program 3.11.5) ===== */
+    {
+        const float z[4] = { 0.f, 0.5f, -0.5f, 1.f };
+        u32 a = ours_pk4(z), b = spec_pk4(z);
+        printf("        PK4B(0,.5,-.5,1): ours 0x%08X spec 0x%08X\n", a, b);
+        res("PK-1 PK4B encoding", a == b, "spec: byte = round(127*clamp(v,-128/127,1) + 128) (excess-128)");
+        float o1[4], o2[4]; ours_up4(0x00000080u, o1); spec_up4(0x00000080u, o2);
+        printf("        UP4B(0x80): ours x=%f spec x=%f\n", o1[0], o2[0]);
+        res("PK-2 UP4B decoding", fabsf(o1[0] - o2[0]) < 1e-6f, "spec: (byte - 128)/127");
+        const float c[4] = { 0.1f, 0.2f, 0.3f, 0.4f };
+        u32 w = pkb(c);
+        res("PK-3 PK4UB byte order", (w & 0xFF) == 26 && ((w >> 24) & 0xFF) == 102, "x -> bits 0-7 ... w -> 24-31 (matches)");
+    }
+
+    /* ================= TEXTURES ================= */
+    {
+        static const struct { u32 fmt; u32 bpp; const char* name; } t[] = {
+            { 0x8F, 2, "R6G5B5" }, { 0x91, 4, "DEPTH24_D8_FLOAT" }, { 0x93, 2, "DEPTH16_FLOAT" },
+            { 0x98, 2, "COMPRESSED_HILO8" }, { 0x99, 2, "COMPRESSED_HILO_S8" },
+            { 0x8D, 2, "COMPRESSED_B8R8_G8R8 (2 texels/32b)" }, { 0x8E, 2, "COMPRESSED_R8B8_R8G8" },
+            { 0x94, 2, "X16" }, { 0x95, 4, "Y16_X16" }, { 0x9F, 4, "Y16_X16_FLOAT" } };
+        for (unsigned i = 0; i < sizeof t / sizeof t[0]; i++) {
+            rsx_tex_layout tl; rsx_texture_layout(t[i].fmt | 0x20u, 64, 64, &tl);
+            char id[48], what[128];
+            snprintf(id, sizeof id, "TX-1 layout 0x%02X", t[i].fmt);
+            snprintf(what, sizeof what, "%s: source bytes/texel %u (ours %u, row %u)", t[i].name, t[i].bpp,
+                     tl.bytes_per_texel, tl.row_bytes);
+            res(id, tl.bytes_per_texel == t[i].bpp && (t[i].fmt != 0x8D && t[i].fmt != 0x8E), what);
+        }
+    }
+    {
+        /* Presented vector per format (RPCS3 GLTexture get_swizzle_remap, ARGB):
+         * X16 = (X, 1, X, 1); B8 = (1, B, B, B); Y16_X16 = (X, Y, X, Y). Our
+         * resource for X16 is R16 (R = X, G = B = 0, A = 1). With the title's
+         * X16 remap 0xAAEE (A<-G R<-B G<-G B<-B; RPCS3 rewrites 0xEE->0xAA for
+         * 16-bit-channel formats, i.e. all from G) hardware returns X in every
+         * channel; ours selects resource components 1/2 = 0. */
+        u8 out[4]; rsx_texture_component_remap(0xAAEEu, 0x94u, out);
+        /* out[] = A,R,G,B selectors into an R16 resource: 0 = X, 1/2 = 0.0, 3 = 1.0 */
+        int any_x = 0; for (int i = 0; i < 4; i++) if (out[i] == 0) any_x = 1;
+        printf("        X16 remap 0xAAEE -> selectors A=%u R=%u G=%u B=%u (0 = the X16 value)\n",
+               out[0], out[1], out[2], out[3]);
+        res("TX-2 X16 remap 0xAAEE", any_x, "hardware returns the X16 value; ours reads only constant-0 lanes");
+        rsx_texture_component_remap(0xAAE4u, 0x81u, out);
+        printf("        B8 identity -> A=%u R=%u G=%u B=%u (resource R8: 0 = value)\n", out[0], out[1], out[2], out[3]);
+        res("TX-3 B8 identity presents B in RGB", out[1] == 0 && out[2] == 0 && out[3] == 0,
+            "B8 presents (A=1, R=G=B=value); ours: G,B from resource lanes 1,2 (=0) "
+            "[the prepass then forces mapping 0x1000 = value in all four, A wrong]");
+        rsx_texture_component_remap(0xAAE4u, 0x95u, out);
+        printf("        Y16_X16 identity -> A=%u R=%u G=%u B=%u\n", out[0], out[1], out[2], out[3]);
+        res("TX-4 Y16_X16 presents A,B", out[0] != 3 && out[3] != 2,
+            "Y16_X16 presents (A=X, R=Y, G=X, B=Y); ours A=1.0, B=0.0");
+        /* float formats cannot be remapped on hardware (RPCS3: low byte forced 0xE4) */
+        rsx_texture_component_remap(0xAA1Bu, 0x9Au, out);
+        res("TX-5 W16 float ignores crossbar", out[1] == 0 && out[2] == 1 && out[3] == 2 && out[0] == 3,
+            "float formats: crossbar low byte forced to identity");
+    }
+
+    /* ================= VERTEX PROGRAM ================= */
+    {
+        /* MOV o1, v0 (END): D1 vec_op=MOV, src0 = input v0 identity; D3 dst=1 */
+        int n = vp_mov(2u | VSRC_IDENT, 0, 0, 1);
+        int wrote = strstr(vh, "o[1].xyzw = _v.xyzw") != NULL;
+        int clamped = strstr(vh, "Out.col0 = saturate(Out.col0); Out.col1 = saturate(Out.col1);") != NULL;
+        printf("        vp n=%d wrote_o1=%d\n", n, wrote);
+        res("VP-1 COL0/COL1 output clamp", clamped, "NV_vertex_program 2.14.1.5: colours clamped to [0,1], then interpolated");
+    }
+    {
+        /* RCC (NV_vertex_program1_1 2.14.1.10.19, NV_vp2 2.14.3.25): the sign
+         * is kept and |1/x| clamped to [2^-64, 2^+64] (0x1F800000, 0x5F800000) */
+        vp_sca(3u, 5u, 7u);
+        res("VP-3 RCC sign", strstr(vh, "o[7].x = _v.x") != NULL && strstr(vh, "vp_rcc(((vp_c[5]).xxxx).x)") != NULL &&
+                             strstr(vh, "clamp(abs(r), asfloat(0x1F800000u), asfloat(0x5F800000u))") != NULL &&
+                             strstr(vh, "(asuint(r) >> 31) != 0u ? -m : m") != NULL,
+            "RCC(-2) must be -0.5; |RCC| in [2^-64, 2^64]");
+        /* RSQ(0) = +INF (NV_vp 2.14.1.10.7, NV_vp2 2.14.3.28) */
+        vp_sca(4u, 5u, 7u);
+        res("VP-4 RSQ(0) = +INF", strstr(vh, "rsqrt(abs(((vp_c[5]).xxxx).x))") != NULL && strstr(vh, "1e-10") == NULL,
+            "no epsilon guard: 1/sqrt(|+-0|) is +INF");
+        /* LG2(+-0) = -INF, LG2(x < 0) = NaN (NV_vp2 2.14.3.17) */
+        vp_sca(0x0Du, 5u, 7u);
+        res("VP-5 LG2 special cases", strstr(vh, "log2(((vp_c[5]).xxxx).x)") != NULL && strstr(vh, "1e-10") == NULL,
+            "log2(x): -INF at 0, NaN below");
+        /* EXP / LOG vector forms (NV_vp 2.14.1.10.15/16, NV_vp2 2.14.3.14/19) */
+        vp_sca(0x05u, 5u, 7u);
+        const int exp_ok = strstr(vh, "float4(exp2(f), isinf(x) ? 0.0 : x - f, exp2(x), 1.0)") != NULL;
+        vp_sca(0x06u, 5u, 7u);
+        const int log_ok = strstr(vh, "if (a == 0.0) return float4(-inf, 1.0, -inf, 1.0);") != NULL &&
+                           strstr(vh, "asfloat((u & 0x007FFFFFu) | 0x3F800000u), log2(a), 1.0)") != NULL;
+        res("VP-6 EXP/LOG vector forms", exp_ok && log_ok,
+            "EXP = (2^floor x, frac x, 2^x, 1); LOG = (exponent, mantissa, log2|x|, 1)");
+        /* relative constant reads outside the file read (0,0,0,0) (NV_vp 2.14.1.9) */
+        vp_mov(3u | VSRC_IDENT, 5u, 1, 7u);
+        res("VP-7 relative read out of range = 0", strstr(vh, "vp_cr(5 + a0.x)") != NULL &&
+                                                  strstr(vh, "(uint)i < 512u ? vp_c[min((uint)i, 511u)] : (float4)0") != NULL,
+            "c[A0.x + 5] beyond the constant file reads 0, not a wrapped entry");
+    }
+
+    printf("\n%d pass, %d fail (each FAIL = a spec discrepancy in our implementation)\n", g_pass, g_fail);
+    return 0;
+}
diff --git a/libs/video/tests/test_display_cfg.c b/libs/video/tests/test_display_cfg.c
new file mode 100644
index 0000000..157e3fc
--- /dev/null
+++ b/libs/video/tests/test_display_cfg.c
@@ -0,0 +1,186 @@
+/*
+ * ps3recomp - self-contained tests for the display.ini parser and the window
+ * geometry helpers (libs/video/display_cfg.h)
+ *
+ *   cc -I libs/video -o /tmp/t libs/video/tests/test_display_cfg.c && /tmp/t
+ *   clang-cl /nologo -I libs\video libs\video\tests\test_display_cfg.c /Fe:t.exe && t.exe
+ *
+ * display_cfg.h is header-only and OS-free. Covers the file / override
+ * parser (comments, sections, name normalisation, a UTF-8 BOM, UTF-16 as
+ * PowerShell 5 writes it, bad lines), the aspect, size and switch parsers,
+ * the letter/pillarbox rectangle (including W' = round(720 * 64/27) shown on
+ * a 2560x1080 monitor without a 1-pixel bar) and the default window size.
+ */
+#include "display_cfg.h"
+
+#include <math.h>
+#include <stdio.h>
+
+static int g_fail = 0, g_checks = 0;
+
+#define CHECK(cond)                                                            \
+    do { g_checks++;                                                           \
+         if (!(cond)) { printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #cond); \
+                        g_fail++; } } while (0)
+
+#define CHECK_EQ(got, want)                                                    \
+    do { long _g = (long)(got), _w = (long)(want); g_checks++;                 \
+         if (_g != _w) { printf("FAIL %s:%d  %s = %ld, want %ld\n",            \
+                                __FILE__, __LINE__, #got, _g, _w);             \
+                         g_fail++; } } while (0)
+
+#define CHECK_NEAR(got, want, eps)                                             \
+    do { double _g = (got), _w = (want); g_checks++;                           \
+         if (fabs(_g - _w) > (eps)) { printf("FAIL %s:%d  %s = %.6f, want %.6f\n", \
+                                __FILE__, __LINE__, #got, _g, _w);             \
+                         g_fail++; } } while (0)
+
+#define CHECK_STR(got, want)                                                   \
+    do { const char* _g = (got); g_checks++;                                   \
+         if (!_g || strcmp(_g, (want))) { printf("FAIL %s:%d  %s = \"%s\", want \"%s\"\n", \
+                                __FILE__, __LINE__, #got, _g ? _g : "(null)", (want)); \
+                         g_fail++; } } while (0)
+
+static int g_warns = 0;
+static void count_warn(const void* ctx, const char* msg) { (void)ctx; (void)msg; g_warns++; }
+
+static void test_parse_file(void)
+{
+    DisplayCfg c;
+    memset(&c, 0, sizeof c);
+    const char* text =
+        "# display.ini\n"
+        "[display]\n"
+        "Aspect     = 64:27      # the monitor\n"
+        "full_screen = 1 ; comment\r\n"
+        "  window = 1707x720\n"
+        "\n"
+        "this line is bad\n"
+        "hud=16:9\n";
+    g_warns = 0;
+    CHECK_EQ(dcfg_parse_text(&c, text, 0, count_warn, NULL), 1);
+    CHECK_EQ(g_warns, 1);
+    CHECK_STR(dcfg_get(&c, "aspect"), "64:27");
+    CHECK_STR(dcfg_get(&c, "FullScreen"), "1");
+    CHECK_STR(dcfg_get(&c, "window"), "1707x720");
+    CHECK_STR(dcfg_get(&c, "hud"), "16:9");
+    CHECK(dcfg_get(&c, "lod") == NULL);
+
+    /* override string: '|' and ';' separate items, later wins */
+    CHECK_EQ(dcfg_parse_text(&c, "aspect=21:9|lod=0;fullscreen = 0", 1, count_warn, NULL), 0);
+    CHECK_STR(dcfg_get(&c, "aspect"), "21:9");
+    CHECK_STR(dcfg_get(&c, "lod"), "0");
+    CHECK_STR(dcfg_get(&c, "fullscreen"), "0");
+    CHECK_EQ(c.n, 5);
+
+    /* set/replace */
+    CHECK(dcfg_set(&c, "Window", "max"));
+    CHECK_STR(dcfg_get(&c, "window"), "max");
+    CHECK_EQ(c.n, 5);
+}
+
+static void test_encodings(void)
+{
+    /* UTF-8 BOM */
+    {
+        char buf[64] = "\xEF\xBB\xBF" "aspect = 32:9\n";
+        DisplayCfg c;
+        memset(&c, 0, sizeof c);
+        dcfg_parse_text(&c, dcfg_text_prepare(buf, strlen(buf)), 0, NULL, NULL);
+        CHECK_STR(dcfg_get(&c, "aspect"), "32:9");
+    }
+    /* UTF-16 LE with BOM (PowerShell 5 '>') */
+    {
+        const char* s = "fullscreen=1\r\nwindow=max\r\n";
+        char buf[128];
+        size_t n = 0;
+        buf[n++] = (char)0xFF; buf[n++] = (char)0xFE;
+        for (const char* p = s; *p; p++) { buf[n++] = *p; buf[n++] = 0; }
+        DisplayCfg c;
+        memset(&c, 0, sizeof c);
+        dcfg_parse_text(&c, dcfg_text_prepare(buf, n), 0, NULL, NULL);
+        CHECK_STR(dcfg_get(&c, "fullscreen"), "1");
+        CHECK_STR(dcfg_get(&c, "window"), "max");
+    }
+}
+
+static void test_values(void)
+{
+    CHECK_NEAR(dcfg_parse_aspect("64:27"), 64.0 / 27.0, 1e-9);
+    CHECK_NEAR(dcfg_parse_aspect("21:9"), 21.0 / 9.0, 1e-9);
+    CHECK_NEAR(dcfg_parse_aspect("43:18"), 43.0 / 18.0, 1e-9);
+    CHECK_NEAR(dcfg_parse_aspect("32 : 9"), 32.0 / 9.0, 1e-9);
+    CHECK_NEAR(dcfg_parse_aspect("16/10"), 1.6, 1e-9);
+    CHECK_NEAR(dcfg_parse_aspect("2560x1080"), 2560.0 / 1080.0, 1e-9);
+    CHECK_NEAR(dcfg_parse_aspect("2.37"), 2.37, 1e-9);
+    CHECK_NEAR(dcfg_parse_aspect("AUTO"), DCFG_ASPECT_AUTO, 0);
+    CHECK_NEAR(dcfg_parse_aspect(""), DCFG_ASPECT_AUTO, 0);
+    CHECK_NEAR(dcfg_parse_aspect("off"), DCFG_ASPECT_OFF, 0);
+    CHECK_NEAR(dcfg_parse_aspect("native"), DCFG_ASPECT_OFF, 0);
+    CHECK_NEAR(dcfg_parse_aspect("wide"), DCFG_ASPECT_BAD, 0);
+    CHECK_NEAR(dcfg_parse_aspect("16:0"), DCFG_ASPECT_BAD, 0);
+    CHECK_NEAR(dcfg_parse_aspect("16:9x"), DCFG_ASPECT_BAD, 0);
+    CHECK_NEAR(dcfg_parse_aspect("12"), DCFG_ASPECT_BAD, 0);
+    CHECK_NEAR(dcfg_parse_aspect(NULL), DCFG_ASPECT_BAD, 0);
+
+    int w = 0, h = 0;
+    CHECK_EQ(dcfg_parse_size("auto", &w, &h), DCFG_SIZE_AUTO);
+    CHECK_EQ(dcfg_parse_size("Max", &w, &h), DCFG_SIZE_MAX);
+    CHECK_EQ(dcfg_parse_size("2560x1080", &w, &h), DCFG_SIZE_EXACT);
+    CHECK_EQ(w, 2560); CHECK_EQ(h, 1080);
+    CHECK_EQ(dcfg_parse_size("2560 x 1080", &w, &h), DCFG_SIZE_EXACT);
+    CHECK_EQ(dcfg_parse_size("10x10", &w, &h), DCFG_SIZE_BAD);
+    CHECK_EQ(dcfg_parse_size("1707", &w, &h), DCFG_SIZE_BAD);
+    CHECK_EQ(dcfg_parse_size("big", &w, &h), DCFG_SIZE_BAD);
+
+    CHECK_EQ(dcfg_parse_bool("1"), 1);
+    CHECK_EQ(dcfg_parse_bool("On"), 1);
+    CHECK_EQ(dcfg_parse_bool("false"), 0);
+    CHECK_EQ(dcfg_parse_bool("2"), -1);
+    CHECK_EQ(dcfg_parse_bool(NULL), -1);
+}
+
+static void test_fit(void)
+{
+    int x, y, w, h;
+    /* 16:9 image in a 16:9 client: the whole client (the stock path) */
+    dcfg_fit_rect(1280, 720, 1280.0 / 720.0, &x, &y, &w, &h);
+    CHECK_EQ(x, 0); CHECK_EQ(y, 0); CHECK_EQ(w, 1280); CHECK_EQ(h, 720);
+    /* W' = 1707 (64:27 rounded) fullscreen on 2560x1080: no 1-pixel bar */
+    dcfg_fit_rect(2560, 1080, 1707.0 / 720.0, &x, &y, &w, &h);
+    CHECK_EQ(x, 0); CHECK_EQ(y, 0); CHECK_EQ(w, 2560); CHECK_EQ(h, 1080);
+    /* 16:9 image on 2560x1080: pillarbox 1920 wide */
+    dcfg_fit_rect(2560, 1080, 16.0 / 9.0, &x, &y, &w, &h);
+    CHECK_EQ(w, 1920); CHECK_EQ(h, 1080); CHECK_EQ(x, 320); CHECK_EQ(y, 0);
+    /* 64:27 image in a 1920x1080 (16:9) window: letterbox */
+    dcfg_fit_rect(1920, 1080, 64.0 / 27.0, &x, &y, &w, &h);
+    CHECK_EQ(w, 1920); CHECK_EQ(h, 810); CHECK_EQ(x, 0); CHECK_EQ(y, 135);
+    /* degenerate input keeps the client */
+    dcfg_fit_rect(800, 600, 0.0, &x, &y, &w, &h);
+    CHECK_EQ(w, 800); CHECK_EQ(h, 600);
+}
+
+static void test_default_client(void)
+{
+    int w, h;
+    /* 64:27 at 100%: guest height, 1707 wide */
+    dcfg_default_client(1707.0 / 720.0, 720, 1.0, 2544, 993, &w, &h);
+    CHECK_EQ(w, 1707); CHECK_EQ(h, 720);
+    /* 150% scale on a 1920x1080 laptop panel: shrunk to the work area */
+    dcfg_default_client(16.0 / 9.0, 720, 1.5, 1904, 1001, &w, &h);
+    CHECK_EQ(h, 1001); CHECK_EQ(w, 1780);
+    /* 32:9 on a 2560-wide work area: width-limited */
+    dcfg_default_client(32.0 / 9.0, 720, 1.0, 2544, 1385, &w, &h);
+    CHECK_EQ(w, 2544); CHECK_EQ(h, 716);
+}
+
+int main(void)
+{
+    test_parse_file();
+    test_encodings();
+    test_values();
+    test_fit();
+    test_default_client();
+    printf("%s: %d checks, %d failed\n", g_fail ? "FAIL" : "OK", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_fp_decompiler.c b/libs/video/tests/test_fp_decompiler.c
index b75424f..bd0d867 100644
--- a/libs/video/tests/test_fp_decompiler.c
+++ b/libs/video/tests/test_fp_decompiler.c
@@ -12,9 +12,15 @@
  * how many SV_TARGETs a program that writes more than one export gets.
  */
 
+#ifndef _WIN32
+#define _POSIX_C_SOURCE 200809L   /* setenv / unsetenv under -std=c11 */
+#endif
 #include "../rsx_fp_decompiler.h"
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
+#include <math.h>
+#include "fp_pack_programs.h"   /* fpt_gbuffer: hand-assembled (tests 18+) */
 
 static int g_pass = 0, g_fail = 0;
 
@@ -86,9 +92,280 @@ static void check_true(const char* test, int cond)
 #define CTRL_32BIT  0x40u
 #define CTRL_16BIT  0x00u
 
+/* ---- Hardware semantics (P0-4, docs/GROUND_TRUTH.md section 3): the rule
+ * each env switch encodes, and that the switch restores the old text. ---- */
+static void set_env(const char* k, const char* v)   /* v NULL: unset */
+{
+#ifdef _WIN32
+    _putenv_s(k, v ? v : "");
+#else
+    if (v) setenv(k, v, 1); else unsetenv(k);
+#endif
+}
+
+static int fp_one(u32 w0, u32 w1, u32 w2, u32 w3, const float* k, u32 ctrl, char* out, u32 n)
+{
+    u8 prog[32];
+    memset(prog, 0, sizeof prog);
+    put_word(prog, w0); put_word(prog + 4, w1); put_word(prog + 8, w2); put_word(prog + 12, w3);
+    if (k) for (int i = 0; i < 4; i++) put_float(prog + 16 + 4 * i, k[i]);
+    return rsx_fp_decompile(prog, k ? 32u : 16u, ctrl, out, n);
+}
+
+#define PREC(p)      ((u32)(p) << 22)        /* OPDEST destination precision */
+#define SRCMOD(i, m) ((u32)(m) << (19 + 3 * (i)))  /* DWORD2 source i precision */
+#define SRC_NEG      (1u << 17)
+#define SRC0_ABS     (1u << 29)
+#define SRC_HALF     (1u << 8)
+#define PERSP        (1u << 31)              /* DWORD3 perspective_corr */
+#define SETCC        (1u << 8)
+
+static void test_hw_semantics(void)
+{
+    static char h[16384];
+    static const float k1[4] = { 1.0f, 0.0f, 0.0f, 0.0f };
+    static const float k5[4] = { 5.0f, 5.0f, 5.0f, 5.0f };
+    static const char* sw[] = { "FP_SRCPREC", "FP_PERSP", "FP_DSTPREC", "FP_HROUND", "FP_CCRULE", "VP_COLSAT" };
+    for (u32 i = 0; i < sizeof sw / sizeof sw[0]; i++) set_env(sw[i], NULL);
+
+    /* HW1: source precision modifiers. God rays ADD0CB4D op 8, ADD R2.zw,
+     * R1, -R1[sat]: saturate, then negate. Without it the ADD is 0. */
+    {
+        const u32 w0 = OPC(0x03) | (3u << 11) | OUTREG(2) | END;
+        const u32 w1 = T_TEMP | REG(1) | SWZ_IDENT | EXEC_ALWAYS;
+        const u32 w2 = T_TEMP | REG(1) | SWZ_IDENT | SRC_NEG | SRCMOD(1, 4);
+        fp_one(w0, w1, w2, 0, NULL, CTRL_32BIT, h, sizeof h);
+        check("hw1_sat_then_neg", h, "((r[1]).xyzw) + (-(saturate((r[1]).xyzw)))");
+        set_env("FP_SRCPREC", "0");
+        fp_one(w0, w1, w2, 0, NULL, CTRL_32BIT, h, sizeof h);
+        check("hw1_off_old_text", h, "((r[1]).xyzw) + (-((r[1]).xyzw))");
+        set_env("FP_SRCPREC", NULL);
+        /* saturate BEFORE abs: -|sat(R1)| */
+        fp_one(w0, w1 | SRC0_ABS | SRC_NEG, T_TEMP | REG(2) | SWZ_IDENT | SRCMOD(0, 4), 0, NULL,
+               CTRL_32BIT, h, sizeof h);
+        check("hw1_sat_before_abs", h, "-(abs(saturate((r[1]).xyzw)))");
+        /* fx9, as 3200686E op 27 ADD H2.y, -|H2.z|[fx9], c: clamp AFTER abs,
+         * negate last -- honoured only with FP_SRCPREC bit 3 (no title
+         * instruction needs it: default off) */
+        const u32 x0 = OPC(0x03) | (1u << 10) | OUTREG(2) | OUTHALF | END;
+        const u32 x1 = T_TEMP | REG(2) | SRC_HALF | (2u << 9) | (2u << 11) | (2u << 13) | (2u << 15) |
+                       SRC_NEG | SRC0_ABS | EXEC_ALWAYS;
+        const u32 x2 = T_CONST | SWZ_IDENT | SRCMOD(0, 3);
+        fp_one(x0, x1, x2, 0, k1, CTRL_16BIT, h, sizeof h);
+        check("hw1_fx9_default_off", h, "-(abs((h[2]).zzzz))");
+        check_absent("hw1_fx9_default_no_helper", h, "rsx_fx9");
+        set_env("FP_SRCPREC", "0x18");
+        fp_one(x0, x1, x2, 0, k1, CTRL_16BIT, h, sizeof h);
+        check("hw1_fx9_after_abs", h, "-(rsx_fx9(abs((h[2]).zzzz)))");
+        check("hw1_fx9_helper", h, "float4 rsx_fx9(float4 x) { return isnan(x) ? (float4)0 : clamp(x, -1.0, 1.0); }");
+        /* mode 5 is "does nothing" from hw tests, even when every bit is set */
+        set_env("FP_SRCPREC", "0xFF");
+        fp_one(x0, x1, (x2 & ~SRCMOD(0, 7)) | SRCMOD(0, 5), 0, k1, CTRL_16BIT, h, sizeof h);
+        check("hw1_mode5_noop", h, "-(abs((h[2]).zzzz))");
+        /* fx12: NV_fp's range and NaN 0 */
+        fp_one(x0, x1, (x2 & ~SRCMOD(0, 7)) | SRCMOD(0, 2), 0, k1, CTRL_16BIT, h, sizeof h);
+        check("hw1_fx12", h, "-(rsx_fx12(abs((h[2]).zzzz)))");
+        check("hw1_fx12_helper", h, "clamp(x, -2.0, 1.9990234375)");
+        /* COL0/COL1 and SSA take no modifier: -|SSA[sat]| stays -|SSA| */
+        fp_one(x0 | INSRC(0xE), (x1 & ~(0x3u | (0x3Fu << 2) | SRC_HALF)) | 0x1u,
+               SRCMOD(0, 4) | T_CONST | SWZ_IDENT, 0, k1, CTRL_16BIT, h, sizeof h);
+        check("hw1_ssa_read", h, "-(abs(((input.face ? (float4)1.0 : (float4)-1.0)).zzzz))");
+        check_absent("hw1_ssa_no_sat", h, "saturate(");
+        fp_one(x0 | INSRC(0x1), (x1 & ~(0x3u | (0x3Fu << 2) | SRC_HALF)) | 0x1u,
+               SRCMOD(0, 4) | T_CONST | SWZ_IDENT, 0, k1, CTRL_16BIT, h, sizeof h);
+        check_absent("hw1_col0_no_sat", h, "saturate(");
+        /* a branch's DWORD2 is not a modifier field: LOOP whose increment
+         * (DWORD2 [19:26]) = 1 reads as no fp16 modifier, no helper */
+        {
+            u8 lp[48];
+            memset(lp, 0, sizeof lp);
+            put_word(lp, OPC(0x03) | 0x0u);                                   /* LOOP */
+            put_word(lp + 4, 0x1C9DC800u);
+            put_word(lp + 8, 0x80080040u);                                    /* branch, end 16 init 0 inc 1 */
+            put_word(lp + 12, 0x8u);                                          /* end: word 8 = byte 32 */
+            put_word(lp + 16, OPC(0x01) | OUTMASK_ALL | END);
+            put_word(lp + 20, T_TEMP | REG(1) | SWZ_IDENT | EXEC_ALWAYS);
+            rsx_fp_decompile(lp, 32u, CTRL_32BIT, h, sizeof h);
+            check("hw1_loop_decoded", h, "[loop] for (int _l0 = 0; _l0 < 16; _l0 += 1)");
+            check_absent("hw1_loop_no_helper", h, "rsx_h16");
+        }
+        /* fp16 of an fp16 register is the register; of an fp32 one, a round */
+        fp_one(x0, x1, (x2 & ~SRCMOD(0, 7)) | SRCMOD(0, 1), 0, k1, CTRL_16BIT, h, sizeof h);
+        check("hw1_fp16_of_h_noop", h, "-(abs((h[2]).zzzz))");
+        fp_one(x0, x1 & ~SRC_HALF, (x2 & ~SRCMOD(0, 7)) | SRCMOD(0, 1), 0, k1, CTRL_16BIT, h, sizeof h);
+        check("hw1_fp16_of_r", h, "-(rsx_h16(abs((r[2]).zzzz)))");
+        set_env("FP_SRCPREC", NULL);
+    }
+
+    /* HW2: SRC2.perspective_corr -- TEXn * 1/w, 1/w from D3D's clip-w
+     * SV_Position.w. TEX R0, TEX2 (the title's screen-space lookups). */
+    {
+        const u32 w0 = OPC(0x17) | OUTMASK_ALL | INSRC(6) | TEXU(0) | END;
+        const u32 w1 = T_INPUT | SWZ_IDENT | EXEC_ALWAYS;
+        fp_one(w0, w1, 0, PERSP, NULL, CTRL_32BIT, h, sizeof h);
+        check("hw2_persp_read", h, "rsx_tex[0].Sample(rsx_samp[0], (((input.tc2 * rsx_iw)).xyzw).xy)");
+        check("hw2_persp_invw", h, "float4 main(PSInput input) : SV_TARGET {\n"
+                                   "    const float rsx_iw = 1.0 / input.position.w;\n");
+        fp_one(w0, w1, 0, 0, NULL, CTRL_32BIT, h, sizeof h);
+        check("hw2_no_flag", h, "rsx_tex[0].Sample(rsx_samp[0], ((input.tc2).xyzw).xy)");
+        check_absent("hw2_no_flag_no_invw", h, "rsx_iw");
+        /* only TEXn: COL0 with the bit is COL0 */
+        fp_one(OPC(0x01) | OUTMASK_ALL | INSRC(1) | END, w1, 0, PERSP, NULL, CTRL_32BIT, h, sizeof h);
+        check_absent("hw2_col_unaffected", h, "rsx_iw");
+        set_env("FP_PERSP", "0");
+        fp_one(w0, w1, 0, PERSP, NULL, CTRL_32BIT, h, sizeof h);
+        check("hw2_off_old_text", h, "rsx_tex[0].Sample(rsx_samp[0], ((input.tc2).xyzw).xy)");
+        check_absent("hw2_off_no_invw", h, "rsx_iw");
+        set_env("FP_PERSP", NULL);
+    }
+
+    /* HW3: COL0/COL1 are [0,1]. The clamp is the VS output's (VP_COLSAT=1,
+     * rsx_vp_decompiler.c); VP_COLSAT=2 moves it to the fragment read. */
+    {
+        const u32 w0 = OPC(0x01) | OUTMASK_ALL | INSRC(1) | END;
+        const u32 w1 = T_INPUT | SWZ_IDENT | EXEC_ALWAYS;
+        fp_one(w0, w1, 0, 0, NULL, CTRL_32BIT, h, sizeof h);
+        check("hw3_default_read_raw", h, "((input.col0).xyzw)");
+        set_env("VP_COLSAT", "2");
+        fp_one(w0, w1, 0, 0, NULL, CTRL_32BIT, h, sizeof h);
+        check("hw3_fs_clamp", h, "((saturate(input.col0)).xyzw)");
+        set_env("VP_COLSAT", NULL);
+    }
+
+    /* HW4: destination precision. MOV_X H0.w, 5 -> fx12 [-2, 2047/1024]. */
+    {
+        const u32 w0 = OPC(0x01) | (1u << 12) | OUTHALF | PREC(2) | END;
+        const u32 w1 = T_CONST | SWZ_IDENT | EXEC_ALWAYS;
+        fp_one(w0, w1, 0, 0, k5, CTRL_16BIT, h, sizeof h);
+        check("hw4_fx12", h, "{ float4 _v = (float4)((float4(5,5,5,5)).xyzw); _v = rsx_fx12(_v); h[0].w = rsx_h16(_v).w; }");
+        check("hw4_fx12_helper", h, "float4 rsx_fx12(float4 x) { return isnan(x) ? (float4)0 : clamp(x, -2.0, 1.9990234375); }");
+        /* after the scale, before/with _SAT */
+        fp_one(w0 | (1u << 31), w1, 1u << 28, 0, k5, CTRL_16BIT, h, sizeof h);
+        check("hw4_scale_prec_sat", h, " * 2.0; _v = rsx_fx12(_v); _v = saturate(_v);");
+        /* fx9 dest: T4 only, unused by the title -- FP_DSTPREC bit 3 */
+        fp_one((w0 & ~PREC(3)) | PREC(3), w1, 0, 0, k5, CTRL_16BIT, h, sizeof h);
+        check_absent("hw4_fx9_default_off", h, "rsx_fx9");
+        set_env("FP_DSTPREC", "0x0C");
+        fp_one((w0 & ~PREC(3)) | PREC(3), w1, 0, 0, k5, CTRL_16BIT, h, sizeof h);
+        check("hw4_fx9_on", h, "_v = rsx_fx9(_v);");
+        set_env("FP_DSTPREC", "0");
+        fp_one(w0, w1, 0, 0, k5, CTRL_16BIT, h, sizeof h);
+        check_absent("hw4_off", h, "rsx_fx12");
+        set_env("FP_DSTPREC", NULL);
+        /* a pack's result is bits: no conversion */
+        fp_one(OPC(0x27) | (1u << 9) | PREC(2) | END, T_TEMP | REG(1) | SRC_HALF | SWZ_IDENT | EXEC_ALWAYS,
+               0, 0, NULL, CTRL_32BIT, h, sizeof h);
+        check_absent("hw4_not_on_pack", h, "rsx_fx12");
+    }
+
+    /* HW5: H registers store fp16 (rsx_h16 on every H write). */
+    {
+        const u32 w0 = OPC(0x01) | OUTMASK_ALL | OUTHALF | END;
+        const u32 w1 = T_TEMP | REG(1) | SWZ_IDENT | EXEC_ALWAYS;
+        fp_one(w0, w1, 0, 0, NULL, CTRL_16BIT, h, sizeof h);
+        check("hw5_h_store", h, "h[0].xyzw = rsx_h16(_v).xyzw;");
+        check("hw5_helper", h, "float4 rsx_h16(float4 x) { return f16tof32(f32tof16(x)); }");
+        fp_one(w0 & ~OUTHALF, w1, 0, 0, NULL, CTRL_32BIT, h, sizeof h);
+        check_absent("hw5_r_store_exact", h, "rsx_h16");
+        set_env("FP_HROUND", "2");
+        fp_one(w0, w1, 0, 0, NULL, CTRL_16BIT, h, sizeof h);
+        check("hw5_inf_overflow", h, "abs(x) >= 65536.0 ? x * asfloat(0x7F800000u) : f16tof32(f32tof16(x));");
+        set_env("FP_HROUND", "0");
+        fp_one(w0, w1, 0, 0, NULL, CTRL_16BIT, h, sizeof h);
+        check("hw5_off_old_text", h, "h[0].xyzw = _v.xyzw;");
+        set_env("FP_HROUND", NULL);
+        /* a packed word into an H register keeps its bits */
+        fp_one(OPC(0x27) | (1u << 9) | OUTHALF | END, w1, 0, 0, NULL, CTRL_16BIT, h, sizeof h);
+        check("hw5_pack_raw", h, "h[0].x = _v.x;");
+    }
+
+    /* HW6: NV_fp 3.11.4.4 -- a destination and a CC component change only
+     * where the write mask and the condition test pass. MOV_C0 R0.x, k (EQ
+     * cc0.x). */
+    {
+        const u32 w0 = OPC(0x01) | (1u << 9) | SETCC | END;
+        const u32 w1 = T_CONST | SWZ_IDENT | (2u << 18);     /* exec_if EQ, cc0.xxxx */
+        fp_one(w0, w1, 0, 0, k1, CTRL_32BIT, h, sizeof h);
+        check("hw6_pred", h, "bool4 _p = (cc0).xxxx == (float4)0.0;");
+        check("hw6_dst_select", h, "r[0].x = _p.x ? _v.x : r[0].x;");
+        check("hw6_cc_keeps_old", h, "cc0.x = _p.x ? _v.x : cc0.x;");
+        check_absent("hw6_no_lerp", h, "lerp(");
+        /* H destination: the register stores fp16, and the CC is generated
+         * from that stored value (GenerateCC(DstT)) */
+        fp_one(w0 | OUTHALF, w1, 0, 0, k1, CTRL_16BIT, h, sizeof h);
+        check("hw6_h_select", h, "h[0].x = _p.x ? rsx_h16(_v).x : h[0].x;");
+        check("hw6_h_cc_stored", h, "cc0.x = _p.x ? rsx_h16(_v).x : cc0.x;");
+        fp_one(w0 | OUTHALF, w1 | (7u << 18), 0, 0, k1, CTRL_16BIT, h, sizeof h);
+        check("hw6_h_uncond_cc_stored", h, "cc0.x = rsx_h16(_v).x;");
+        /* "FL": neither the destination nor the CC */
+        fp_one(w0, w1 & ~(7u << 18), 0, 0, k1, CTRL_32BIT, h, sizeof h);
+        check_absent("hw6_never_no_cc", h, "cc0.x =");
+        check_absent("hw6_never_no_dst", h, "r[0].x =");
+        /* unconditional: the CC is the written value */
+        fp_one(w0, w1 | (7u << 18), 0, 0, k1, CTRL_32BIT, h, sizeof h);
+        check("hw6_uncond_cc", h, "cc0.x = _v.x;");
+        /* RC (no destination) under a condition */
+        fp_one(w0 | (1u << 30), w1, 0, 0, k1, CTRL_32BIT, h, sizeof h);
+        check("hw6_rc_cc_keeps_old", h, "cc0.x = _p.x ? _v.x : cc0.x;");
+        set_env("FP_CCRULE", "0");
+        fp_one(w0, w1, 0, 0, k1, CTRL_32BIT, h, sizeof h);
+        check("hw6_off_old_lerp", h, "r[0].x = lerp(r[0].x, _v.x, _p.x);");
+        check("hw6_off_old_cc", h, "cc0.x = r[0].x;");
+        set_env("FP_CCRULE", NULL);
+    }
+}
