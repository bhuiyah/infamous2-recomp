+    if (FAILED(hr = CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&fac))) return die("CreateDXGIFactory1", hr);
+    if (FAILED(hr = fac->lpVtbl->EnumWarpAdapter(fac, &IID_IDXGIAdapter, (void**)&warp))) return die("EnumWarpAdapter", hr);
+    if (FAILED(hr = D3D12CreateDevice((IUnknown*)warp, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&dev)))
+        return die("D3D12CreateDevice(WARP)", hr);
+    ID3D12InfoQueue* iq = NULL;
+    if (debug_layer) dev->lpVtbl->QueryInterface(dev, &IID_ID3D12InfoQueue, (void**)&iq);
+    printf("WARP device, debug layer %s\n", iq ? "on" : "not installed");
+
+    D3D12_COMMAND_QUEUE_DESC qd = {0}; qd.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    if (FAILED(hr = dev->lpVtbl->CreateCommandQueue(dev, &qd, &IID_ID3D12CommandQueue, (void**)&q))) return die("queue", hr);
+    if (FAILED(hr = dev->lpVtbl->CreateCommandAllocator(dev, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                                        &IID_ID3D12CommandAllocator, (void**)&al))) return die("allocator", hr);
+    if (FAILED(hr = dev->lpVtbl->CreateCommandList(dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, al, NULL,
+                                                   &IID_ID3D12GraphicsCommandList, (void**)&cl))) return die("list", hr);
+    if (FAILED(hr = dev->lpVtbl->CreateFence(dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&fence)))
+        return die("fence", hr);
+
+    /* Resources: target, copy, depth, vertex buffer, readback. */
+    D3D12_HEAP_PROPERTIES hdef = {0}, hup = {0}, hrb = {0};
+    hdef.Type = D3D12_HEAP_TYPE_DEFAULT; hup.Type = D3D12_HEAP_TYPE_UPLOAD; hrb.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; td.Width = W; td.Height = H; td.DepthOrArraySize = 1;
+    td.MipLevels = 1; td.Format = DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count = 1;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    ID3D12Resource *rt = NULL, *snap = NULL, *ds = NULL, *vb = NULL, *rb = NULL;
+    if (FAILED(hr = dev->lpVtbl->CreateCommittedResource(dev, &hdef, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_RENDER_TARGET, NULL, &IID_ID3D12Resource, (void**)&rt))) return die("target", hr);
+    td.Flags = D3D12_RESOURCE_FLAG_NONE;      /* the copy: as rt_selfsample makes it */
+    if (FAILED(hr = dev->lpVtbl->CreateCommittedResource(dev, &hdef, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&snap))) return die("copy", hr);
+    D3D12_RESOURCE_STATES snap_st = D3D12_RESOURCE_STATE_COPY_DEST;
+    td.Format = DXGI_FORMAT_D32_FLOAT; td.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+    D3D12_CLEAR_VALUE cv = {0}; cv.Format = DXGI_FORMAT_D32_FLOAT; cv.DepthStencil.Depth = 1.0f;
+    if (FAILED(hr = dev->lpVtbl->CreateCommittedResource(dev, &hdef, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_DEPTH_WRITE, &cv, &IID_ID3D12Resource, (void**)&ds))) return die("depth", hr);
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = 4096; bd.Height = 1; bd.DepthOrArraySize = 1;
+    bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(hr = dev->lpVtbl->CreateCommittedResource(dev, &hup, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&vb))) return die("vb", hr);
+    bd.Width = (UINT64)PITCH * H;
+    if (FAILED(hr = dev->lpVtbl->CreateCommittedResource(dev, &hrb, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rb))) return die("readback", hr);
+    float* v = NULL; { D3D12_RANGE nr = {0, 0}; vb->lpVtbl->Map(vb, 0, &nr, (void**)&v); }
+    quad(v + 0,  0.0f,  0.0f, 32.0f, 64.0f, 0.3f);   /* occluder: left half */
+    quad(v + 18, 16.0f,  8.0f, 48.0f, 24.0f, 0.5f);  /* the box: 32x16, half behind it */
+    quad(v + 36, 0.0f,  0.0f, 64.0f, 64.0f, 0.5f);   /* full screen */
+    D3D12_VERTEX_BUFFER_VIEW vbv;
+    vbv.BufferLocation = vb->lpVtbl->GetGPUVirtualAddress(vb); vbv.SizeInBytes = 4096; vbv.StrideInBytes = 12;
+
