diff --git a/libs/video/rsx_tex_cache.h b/libs/video/rsx_tex_cache.h
new file mode 100644
index 0000000..dc97f36
--- /dev/null
+++ b/libs/video/rsx_tex_cache.h
@@ -0,0 +1,760 @@
+/*
+ * ps3recomp - guest texture residency for the D3D12 backend: guest-write
+ * tracking, the content hash, and the key -> slot map.
+ *
+ * The backend keeps every guest texture it has uploaded resident in a slot and
+ * has one question to answer each time a draw binds one: have the guest bytes
+ * under it changed since the slot read them? It used to answer by re-reading
+ * them -- a 1024-sample sparse checksum per distinct texture per batch, after
+ * a linear scan of all 1024 slots per binding -- which costs more than the
+ * uploads it saves once a scene binds several hundred distinct textures a
+ * batch, and still misses an update that touches none of the sampled words
+ * (a glyph rasterised into a font atlas, a decal stamped into a tile).
+ *
+ * This header holds the parts that do not depend on D3D12, so a test can drive
+ * them without a device -- with real writer threads on a write-watched arena,
+ * checking after every quiescent round that no resident texture is stale.
+ *
+ * ---------------------------------------------------------------------------
+ * Who writes guest memory under a texture (and therefore what must be seen)
+ * ---------------------------------------------------------------------------
+ *   - Lifted PPU scalar stores: vm_write8/16/32/64 (ppu_loader.cpp).
+ *   - Lifted PPU VECTOR stores (stvx & co.) and dcbz: inline memcpy/memset into
+ *     vm_base in the generated code. No hook can see them short of re-lifting.
+ *   - HLE code: vm_write* / vm_memcpy_to / vm_memset (ppu_memory.h) and raw
+ *     GUEST_PTR memcpy in libs/.
+ *   - cellFsRead / cellFsReadWithOffset: fread straight into vm_base
+ *     (ppu_fs.cpp) -- a KERNEL write.
+ *   - SPU DMA PUT / PUTL lists / PUTLLC / PUTLLUC: memcpy in
+ *     mfc_do_transfer_impl (spu_dma.h) and the lock-line commits
+ *     (spu_coherency.c). Bink's decoded planes and anything SPU-decompressed
+ *     (psarc/zlib streaming) arrive this way.
+ *   - RSX-side copies run by the runtime: NV3089 scaled image (vm_write32 per
+ *     texel, linear destination) and its NV309E swizzled-destination path (raw
+ *     memcpy), NV308A inline image (vm_write32), all in cellGcmSys.c. NV0039
+ *     (m2mf) is not implemented, so it writes nothing today.
+ *   - The backend's own render-target / zeta readbacks into guest memory
+ *     (rsx_d3d12_readback_surface, zeta readback): raw stores.
+ *   - Render-target aliases are NOT guest writes: a surface the backend draws
+ *     exists only on the GPU, and a texture bound at its offset samples the
+ *     off_rt resource directly (off_rt_find_tex runs before the uploader). The
+ *     guest bytes at that offset change only through a readback, above.
+ *
+ * Every one of those is a CPU store (or a kernel copy) into the one guest
+ * arena, which is why the primary mechanism is the OS's own page tracking:
+ *
+ * 1. Write watch (when the host reserved the arena with MEM_WRITE_WATCH).
+ *    GetWriteWatch reports every 4 KB page written since its last reset, by
+ *    any thread, including fread/ReadFile -- buffered and unbuffered -- and
+ *    SSE/non-temporal stores (each verified on a guest-shaped arena: 4 GB
+ *    reserve, 64 KB VEH demand commit). A page costs nothing until it is
+ *    reset; the first write after a reset takes one soft fault (~0.45 us
+ *    measured) on the WRITING thread -- the PPU or an SPU -- so resets are
+ *    rationed:
+ *      - a page under a resident texture is reset when it is tracked and each
+ *        time a harvest reports it, unless it was dirty TC_HOT_STREAK harvests
+ *        running (a hot neighbour, a vertex ring sharing the page): then it
+ *        is left dirty, re-armed every 64 rounds;
+ *      - PF3 (TEX_WW_RSX, default 1; 0 = off): a page the RSX's own copies
+ *        (NV3089 / NV309E / NV308A in cellGcmSys.c, on the walker thread)
+ *        wrote within the last TC_RSX_ROUNDS rounds is left dirty too. inFamous
+ *        2 NV3089-copies two 3.5 MB surfaces to main memory every frame for its
+ *        SPU jobs (the RSX samples them as well: tracked); reset after every
+ *        frame's report, each of their ~1800 pages took a soft fault on the
+ *        walker's next copy -- ~0.75 ms of a 17 ms frame, before the label the
+ *        SPU lighting waits for. Left dirty, the pages are reported by every
+ *        harvest, so a write by any other thread is still seen; their slots
+ *        are re-hashed at each bind (they are re-uploaded every frame anyway).
+ *        (A general rule -- any page dirty 3 times within 16 harvests is hot
+ *        -- was measured too: 0.6 ms better than none, 0.4 ms worse than this
+ *        one, as more textures bound in every batch are then re-hashed);
+ *      - any other dirty page inside the harvested span is reset the first
+ *        time it is seen, so data written once (everything loaded at level
+ *        start) stops being reported; seen dirty again, it is written
+ *        repeatedly and is left dirty, re-armed every 256 rounds. A write-
+ *        heavy page nobody samples thus costs its writer at most a couple of
+ *        faults per ~256 batches, and the render thread ~17 ns per harvest.
+ *
+ * 2. No write watch (another host, or TEX_WW=0): the backend falls back to the
+ *    sparse checksum per bound texture per batch, exactly the old behaviour
+ *    (a software-only scheme cannot be made complete: see vector stores).
+ *
+ * Generation rule (round = one texture prepass that binds anything):
+ *   - tc_wt_round_begin raises the round to r and harvests: every dirty page
+ *     some slot reads gets gen = r. Bytes read during round r are read after
+ *     that harvest's resets, so they include every write the harvest saw.
+ *   - A write that lands after a page's reset is reported by the next harvest
+ *     (gen = r+1 or later).
+ *   - A slot whose bytes were read (or verified) in round v is stale iff one of
+ *     its pages has gen > v. last_dirty (the newest gen handed out) makes the
+ *     common no-writes case O(1).
+ *   - A page left dirty on purpose (hot) is reported by every harvest, so its
+ *     slots are re-verified every round -- by content hash, so a write that
+ *     did not change the texture's bytes costs a hash, not an upload.
+ *   - GetWriteWatch (no reset) then ResetWriteWatch on the reported runs: a
+ *     write landing between the two is not reported again, which is safe
+ *     because every read of that page happens after the reset (the slot is
+ *     either already stale with gen = r, or reads after the harvest).
+ *
+ * Which round a batch is judged by (TX1, TEX_FENCE; the backend's
+ * tex_fence_hook and tc_round_ensure). The backend records the FIFO's draws
+ * and validates and reads their textures when it replays them (render_frame).
+ * On a PS3 the RSX reads a texture when it draws, and a completion point after
+ * the draw -- NV406E SET_REFERENCE (cellGcmFinish's fence), a back-end label
+ * (0x1D70) -- reaches the PPU and the SPUs only after those reads: a writer the
+ * game releases with it cannot change what the draws before it read. The
+ * walker passes such a point long before the replay, so without a rule a write
+ * it released could land before the batch's harvest and be uploaded for the
+ * draws before it, a copy NEWER than the memory at their fence (inFamous 2's
+ * water job, NOTES TX1). The rule: at a fence with records pending the backend
+ * harvests (tc_wt_fence_harvest) and keeps the round; the next record starts a
+ * new batch, so every record of a batch with a fence precedes it; at that
+ * batch's first validation, while the fence's harvest is still the latest
+ * (tc_wt_fence_current), no round begins: each slot is judged by the writes
+ * harvested up to the fence, and a write after it is reported by the next
+ * batch's harvest -- where the draws after the fence are. A slot that is
+ * judged written (a write since it was last read: the replay reads it again)
+ * could also be rewritten after the fence, before the replay (the same texture
+ * written on both sides of it). One up to TEX_FENCE_COPY_MAX (256 KB) has its
+ * bytes copied at the fence and the replay reads the copy; so has a larger one
+ * over a page the hot rule leaves dirty (every harvest reports it: a movie's
+ * planes) while the fence's such copies stay within TEX_FENCE_HOT_MAX (4 MB).
+ * Any other larger one is watched instead: the fence's harvest reset its pages
+ * (a hot one over the budget is reset then), so at the replay the write watch itself says
+ * whether anything wrote it since (tc_wt_written_now, asked before and after
+ * the read): nothing -- the guest memory is the bytes at the fence; something
+ * -- counted ([TEXFENCE] "rewritten after the fence"). A larger one over pages
+ * TEX_WW_RSX keeps dirty (tc_wt_span_rsx: every harvest reports them;
+ * inFamous 2's two 3.5 MB copy targets) is hashed at the fence and compared
+ * at the replay, counted the same way. A slot the fence marked is not evicted
+ * in its batch's prepass (unless nothing else is free: counted); a fence that
+ * lapses (a record after it, a harvest since) takes its marks with it; at
+ * most TEX_FENCE_MAX fences open per guest frame (the state: tc_fence below).
+ * A texture with no slot at the fence (first bound in the fenced batch) is
+ * copied by key, up to the cap and 1 MB a fence (tc_fznew). PF3_VERIFY
+ * compares every bind of a fenced batch with the bytes at its fence.
+ */
+#ifndef PS3RECOMP_RSX_TEX_CACHE_H
+#define PS3RECOMP_RSX_TEX_CACHE_H
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define TC_PAGE_SHIFT  12u
+#define TC_NPAGES      (1u << 20)                 /* 4 GB guest space / 4 KB    */
+#define TC_REG_SHIFT   14u                        /* harvest regions: 64 MB     */
+#define TC_NREG        (TC_NPAGES >> TC_REG_SHIFT)
+#define TC_HOT_STREAK  3u                         /* dirty this many harvests in a row: leave it dirty */
+#define TC_RSX_ROUNDS  16u                        /* TEX_WW_RSX: an RSX write keeps its pages dirty this long */
+
+/* ---------------------------------------------------------------------------
+ * Write tracking
+ * -----------------------------------------------------------------------*/
+typedef struct {
+    uint32_t* gen;       /* [TC_NPAGES] last round a write to a TRACKED page was seen */
+    uint16_t* ref;       /* [TC_NPAGES] resident slots reading the page               */
+    uint8_t*  streak;    /* [TC_NPAGES] consecutive harvests the page was dirty (bits
+                          * 0-6); bit 7: reset once already while nobody tracked it */
+    uint8_t*  seen;      /* [TC_NPAGES] low byte of the last round it was dirty       */
+    uint8_t*  base;      /* vm_base                                                   */
+    uint32_t  round;     /* current round (render thread)                             */
+    uint32_t  last_dirty;/* newest gen handed out                                     */
+    int       os_ww;     /* GetWriteWatch works on the guest arena                    */
+    uint32_t  lo[TC_NREG], hi[TC_NREG];   /* tracked page bounds per region, [lo,hi)  */
+    int       bounds_stale;               /* a page dropped to ref 0: recompute       */
+    uint32_t* rsx_round; /* [TC_NPAGES] TEX_WW_RSX: the first round whose harvest sees the
+                          * page's last write by the RSX's own copies (0 = none);
+                          * NULL = the rule is off                                       */
+    uint32_t  rsx_kept;  /* stats: tracked dirty pages left dirty by that rule            */
+    PVOID*    hits;
+    ULONG_PTR cap;
+    /* stats since the last tc_wt_stats_clear */
+    double    harvest_s;
+    uint32_t  harvests, dirty_tracked, dirty_other, resets, hot_kept;
+} tc_wtrack;
+
+static tc_wtrack s_tcw;
+
+static double tc_now(void)
+{
+    static LARGE_INTEGER f; LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart / (double)f.QuadPart;
+}
+
+/* Probe: does GetWriteWatch accept the arena? It succeeds only inside a region
+ * reserved with MEM_WRITE_WATCH; the probed page need not be committed. */
+static int tc_wt_probe(uint8_t* arena)
+{
+    PVOID one[1]; ULONG_PTR n = 1; DWORD gran = 0;
+    return arena && GetWriteWatch(0, arena, 0x1000, one, &n, &gran) == 0;
+}
+
+/* Render thread, once. allow_ww = 0 forces checksum validation. Returns
+ * whether write watch is in use (0 also when the arrays cannot be had). */
+static int tc_wt_init(uint8_t* arena, int allow_ww)
+{
+    if (s_tcw.gen) return s_tcw.os_ww;
+    memset(&s_tcw, 0, sizeof s_tcw);
+    for (uint32_t k = 0; k < TC_NREG; k++) { s_tcw.lo[k] = 0xFFFFFFFFu; s_tcw.hi[k] = 0; }
+    s_tcw.base  = arena;
+    s_tcw.round = 1;
+    if (!allow_ww || !tc_wt_probe(arena)) return 0;
+    /* Demand-zero: only the pages under tracked textures are ever touched. */
+    uint8_t* mem = (uint8_t*)VirtualAlloc(NULL, (SIZE_T)TC_NPAGES * (4 + 2 + 1 + 1 + 4),
+                                          MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    PVOID* hits = (PVOID*)malloc((size_t)(1u << 15) * sizeof(PVOID));
+    if (!mem || !hits) {
+        if (mem) VirtualFree(mem, 0, MEM_RELEASE);
+        free(hits);
+        return 0;
+    }
+    s_tcw.gen    = (uint32_t*)(void*)mem;
+    s_tcw.ref    = (uint16_t*)(void*)(mem + (size_t)TC_NPAGES * 4);
+    s_tcw.streak = mem + (size_t)TC_NPAGES * 6;
+    s_tcw.seen   = mem + (size_t)TC_NPAGES * 7;
+    s_tcw.hits   = hits;
+    s_tcw.cap    = 1u << 15;
+    s_tcw.os_ww  = 1;
+    /* TEX_WW_RSX (PF3; see tc_wt_harvest_span): default 1, 0 = off. */
+    { const char* e = getenv("TEX_WW_RSX");
+      if (!(e && *e == '0')) s_tcw.rsx_round = (uint32_t*)(void*)(mem + (size_t)TC_NPAGES * 8);
+      fprintf(stderr, "[TEXCACHE] pages the RSX's own copies write stay dirty for %u rounds after each write%s%c",
+              TC_RSX_ROUNDS, s_tcw.rsx_round ? " (TEX_WW_RSX=1)" : ": off (TEX_WW_RSX=0)", 10); }
+    return 1;
+}
+
+static inline void tc_wt_pages(uint32_t ea, uint32_t len, uint32_t* p0, uint32_t* p1)
+{
+    uint64_t end = (uint64_t)ea + (len ? len : 1u) - 1u;
+    if (end > 0xFFFFFFFFull) end = 0xFFFFFFFFull;
+    *p0 = ea >> TC_PAGE_SHIFT;
+    *p1 = (uint32_t)(end >> TC_PAGE_SHIFT);
+}
+
+static void tc_wt_reset_run(uint32_t p0, uint32_t p1x)    /* pages [p0, p1x) */
+{
+    if (p1x <= p0) return;
+    ResetWriteWatch(s_tcw.base + ((uint64_t)p0 << TC_PAGE_SHIFT),
+                    (SIZE_T)(p1x - p0) << TC_PAGE_SHIFT);
+    s_tcw.resets++;
+}
+
+static void tc_wt_bounds_add(uint32_t p0, uint32_t p1)    /* pages [p0, p1] */
+{
+    for (uint32_t k = p0 >> TC_REG_SHIFT; k <= (p1 >> TC_REG_SHIFT) && k < TC_NREG; k++) {
+        const uint32_t rlo = k << TC_REG_SHIFT, rhi = (k + 1u) << TC_REG_SHIFT;
+        const uint32_t a = p0 > rlo ? p0 : rlo;
+        const uint32_t b = (p1 + 1u) < rhi ? (p1 + 1u) : rhi;
+        if (a < s_tcw.lo[k]) s_tcw.lo[k] = a;
+        if (b > s_tcw.hi[k]) s_tcw.hi[k] = b;
+    }
+}
+
+/* Bounds only grow as spans are tracked; the caller rebuilds them from its
+ * live spans (tc_wt_bounds_clear + tc_wt_bounds_span per slot) when
+ * bounds_stale says something was untracked, so the harvest stops scanning
+ * memory nothing reads any more. */
+static void tc_wt_bounds_clear(void)
+{
+    for (uint32_t k = 0; k < TC_NREG; k++) { s_tcw.lo[k] = 0xFFFFFFFFu; s_tcw.hi[k] = 0; }
+    s_tcw.bounds_stale = 0;
+}
+static void tc_wt_bounds_span(uint32_t ea, uint32_t len)
+{
+    if (!len) return;
+    uint32_t p0, p1;
+    tc_wt_pages(ea, len, &p0, &p1);
+    tc_wt_bounds_add(p0, p1);
+}
+
+/* Render thread: a slot is about to read [ea, ea+len). MUST run before the
+ * bytes are read: a page nobody tracked yet is reset here, so a write that
+ * lands after this point is reported. A page already tracked was reset by the
+ * last harvest (or is hot and permanently reported), so a write since then
+ * shows up in the next harvest either way. */
+static void tc_wt_track(uint32_t ea, uint32_t len)
+{
+    if (!len || !s_tcw.os_ww) return;
+    uint32_t p0, p1;
+    tc_wt_pages(ea, len, &p0, &p1);
+    uint32_t run0 = 0, runx = 0;
+    for (uint32_t p = p0; ; p++) {
+        if (s_tcw.ref[p]++ == 0) {
+            if (runx == p && runx) runx = p + 1;
+            else { tc_wt_reset_run(run0, runx); run0 = p; runx = p + 1; }
+        }
+        if (p == p1) break;
+    }
+    tc_wt_reset_run(run0, runx);
+    tc_wt_bounds_add(p0, p1);
+}
+
+/* Render thread: the slot that read [ea, ea+len) no longer holds it. */
+static void tc_wt_untrack(uint32_t ea, uint32_t len)
+{
+    if (!len || !s_tcw.os_ww) return;
+    uint32_t p0, p1;
+    tc_wt_pages(ea, len, &p0, &p1);
+    for (uint32_t p = p0; ; p++) {
+        if (s_tcw.ref[p] && --s_tcw.ref[p] == 0) s_tcw.bounds_stale = 1;
+        if (p == p1) break;
+    }
+}
+
+/* TEX_WW_RSX: [ea, ea+len) was just written by the RSX's own copies (NV3089 /
+ * NV309E / NV308A, cellGcmSys.c, through g_gcm_rsx_write_note) on the walker
+ * thread, between two harvests: the next harvest (round + 1) is the first to
+ * see it. The walker only (gcm_2d_method under the FIFO lock, the thread the
+ * harvests run on): the round is read unlocked; nothing but the stamp is
+ * touched. */
+static void tc_wt_rsx_write(uint32_t ea, uint32_t len)
+{
+    if (!s_tcw.rsx_round || !len) return;
+    uint32_t p0, p1;
+    tc_wt_pages(ea, len, &p0, &p1);
+    const uint32_t r = s_tcw.round + 1u;
+    for (uint32_t p = p0; ; p++) {
+        s_tcw.rsx_round[p] = r;
+        if (p == p1) break;
+    }
+}
+
+/* One harvest over [p0, p1x). */
+static void tc_wt_harvest_span(uint32_t p0, uint32_t p1x, uint32_t r)
+{
+    uint8_t* a   = s_tcw.base + ((uint64_t)p0  << TC_PAGE_SHIFT);
+    uint8_t* end = s_tcw.base + ((uint64_t)p1x << TC_PAGE_SHIFT);
+    const uint8_t rb = (uint8_t)r, rprev = (uint8_t)(r - 1u);
+    const int rearm_tracked = (r & 63u) == 0;    /* left-dirty pages are reset once in a while */
+    const int rearm_other   = (r & 255u) == 0;
+    while (a < end) {
+        ULONG_PTR n = s_tcw.cap; DWORD gran = 0;
+        if (GetWriteWatch(0, a, (SIZE_T)(end - a), s_tcw.hits, &n, &gran) != 0) {
+            fprintf(stderr, "[TEXCACHE] GetWriteWatch failed (%lu): every texture is stale "
+                            "this round%c", GetLastError(), 10);
+            /* Fail safe: treat every tracked page as written. */
+            s_tcw.last_dirty = r;
+            for (uint32_t p = p0; p < p1x; p++) if (s_tcw.ref[p]) s_tcw.gen[p] = r;
+            return;
+        }
+        uint32_t run0 = 0, runx = 0;
+        for (ULONG_PTR i = 0; i < n; i++) {
+            const uint32_t p = (uint32_t)(((uint8_t*)s_tcw.hits[i] - s_tcw.base) >> TC_PAGE_SHIFT);
+            const uint32_t st   = s_tcw.streak[p] & 0x7Fu;
+            const uint32_t once = s_tcw.streak[p] & 0x80u;
+            const uint32_t nst  = (st && s_tcw.seen[p] == rprev) ? (st < 127u ? st + 1u : 127u) : 1u;
+            s_tcw.seen[p] = rb;
+            int reset, rsxk = 0;
+            if (s_tcw.ref[p]) {
+                s_tcw.gen[p] = r; s_tcw.last_dirty = r; s_tcw.dirty_tracked++;
+                s_tcw.streak[p] = (uint8_t)(nst | once);
+                reset = nst < TC_HOT_STREAK || rearm_tracked;
+                /* TEX_WW_RSX: written by the RSX's own copies within the last
+                 * TC_RSX_ROUNDS rounds: left dirty, so the next copy does not
+                 * fault on it. Being dirty it is reported by every harvest, so a
+                 * write by anyone else is seen as surely as after a reset; once
+                 * the copies stop, the rules above apply again. */
+                if (s_tcw.rsx_round && s_tcw.rsx_round[p] && r - s_tcw.rsx_round[p] < TC_RSX_ROUNDS) {
+                    if (reset) { s_tcw.rsx_kept++; rsxk = 1; }
+                    reset = 0;
+                }
+            } else {
+                s_tcw.dirty_other++;
+                s_tcw.streak[p] = (uint8_t)(nst | 0x80u);
+                reset = !once || rearm_other;
+            }
+            if (!reset) { if (!rsxk) s_tcw.hot_kept++; continue; }   /* the two counts apart */
+            if (runx == p && runx) runx = p + 1;
+            else { tc_wt_reset_run(run0, runx); run0 = p; runx = p + 1; }
+        }
+        tc_wt_reset_run(run0, runx);
+        if (n < s_tcw.cap) break;
+        a = (uint8_t*)s_tcw.hits[n - 1] + ((size_t)1 << TC_PAGE_SHIFT);
+    }
+}
+
+/* Render thread, once per round, before any slot of that round is validated
+ * or read. Returns the new round. */
+static uint32_t tc_wt_round_begin(void)
+{
+    const uint32_t r = ++s_tcw.round;
+    if (!s_tcw.os_ww) return r;
+    const double t0 = tc_now();
+    for (uint32_t k = 0; k < TC_NREG; k++)
+        if (s_tcw.lo[k] < s_tcw.hi[k]) tc_wt_harvest_span(s_tcw.lo[k], s_tcw.hi[k], r);
+    s_tcw.harvest_s += tc_now() - t0;
+    s_tcw.harvests++;
+    /* TC_HARVEST_LOG=1 (diagnostic): every 256 rounds, what the harvest scans
+     * (regions, MB) against the tracked pages themselves (runs merged over
+     * gaps up to 256 KB / 1 MB / 4 MB: calls and MB). */
+    { static int lg = -1;
+      if (lg < 0) { const char* e = getenv("TC_HARVEST_LOG"); lg = (e && *e == '1') ? 1 : 0; }
+      if (lg && (r & 255u) == 0) {
+          uint32_t nreg = 0; uint64_t span = 0, trk = 0;
+          static const uint32_t gaps[3] = { 64u, 256u, 1024u };     /* pages */
+          uint32_t runs[3] = {0, 0, 0}; uint64_t cov[3] = {0, 0, 0};
+          for (uint32_t k = 0; k < TC_NREG; k++) {
+              if (s_tcw.lo[k] >= s_tcw.hi[k]) continue;
+              nreg++; span += s_tcw.hi[k] - s_tcw.lo[k];
+              for (int gi = 0; gi < 3; gi++) {
+                  uint32_t run0 = 0, last = 0; int open = 0;
+                  for (uint32_t p = s_tcw.lo[k]; p < s_tcw.hi[k]; p++) {
+                      if (!s_tcw.ref[p]) continue;
+                      if (gi == 0) trk++;
+                      if (open && p - last <= gaps[gi]) { last = p; continue; }
+                      if (open) { runs[gi]++; cov[gi] += last + 1u - run0; }
+                      run0 = last = p; open = 1;
+                  }
+                  if (open) { runs[gi]++; cov[gi] += last + 1u - run0; }
+              }
+          }
+          fprintf(stderr, "[TCHARVEST] round %u: %u regions, %.1f MB scanned per harvest (%.3f ms avg) | tracked"
+                          " %.1f MB | runs over gaps <=256K %u (%.1f MB), <=1M %u (%.1f MB), <=4M %u (%.1f MB)%c",
+                  r, nreg, (double)span / 256.0, s_tcw.harvests ? s_tcw.harvest_s * 1e3 / s_tcw.harvests : 0.0,
+                  (double)trk / 256.0, runs[0], (double)cov[0] / 256.0, runs[1], (double)cov[1] / 256.0,
+                  runs[2], (double)cov[2] / 256.0, 10);
+      } }
+    return r;
+}
+
+/* Has any page of [ea, ea+len) been written after round `since` began? */
+static inline int tc_wt_dirty_since(uint32_t ea, uint32_t len, uint32_t since)
+{
+    if (s_tcw.last_dirty <= since) return 0;     /* nothing written since: O(1) */
+    uint32_t p0, p1;
+    tc_wt_pages(ea, len, &p0, &p1);
+    for (uint32_t p = p0; ; p++) {
+        if (s_tcw.gen[p] > since) return 1;
+        if (p == p1) break;
+    }
+    return 0;
+}
+
+/* TX1 TEX_FENCE (see "Which round a batch is judged by" above). The fence's
+ * harvest is an ordinary round; the batch that holds only records before the
+ * fence is judged by it while no other harvest has run since. */
+static inline uint32_t tc_wt_fence_harvest(void) { return tc_wt_round_begin(); }
+static inline int tc_wt_fence_current(uint32_t fz_round)
+{
+    return fz_round != 0 && fz_round == s_tcw.round;
+}
+/* Does [ea, ea+len) cover a page the hot rule leaves dirty (dirty
+ * TC_HOT_STREAK harvests running; one re-armed this round counts too)? */
+static inline int tc_wt_span_hot(uint32_t ea, uint32_t len)
+{
+    uint32_t p0, p1;
+    if (!s_tcw.os_ww || !len) return 0;
+    tc_wt_pages(ea, len, &p0, &p1);
+    for (uint32_t p = p0; ; p++) {
+        if ((s_tcw.streak[p] & 0x7Fu) >= TC_HOT_STREAK) return 1;
+        if (p == p1) break;
+    }
+    return 0;
+}
+/* Has anything written a page of [ea, ea+len) since the last reset of its
+ * write watch (no reset here)? Failure counts as written. */
+static int tc_wt_written_now(uint32_t ea, uint32_t len)
+{
+    uint32_t p0, p1;
+    if (!s_tcw.os_ww || !len) return 1;
+    tc_wt_pages(ea, len, &p0, &p1);
+    ULONG_PTR n = 1; DWORD gran = 0; PVOID one[1];
+    if (GetWriteWatch(0, s_tcw.base + ((uint64_t)p0 << TC_PAGE_SHIFT),
+                      (SIZE_T)(p1 - p0 + 1u) << TC_PAGE_SHIFT, one, &n, &gran) != 0) return 1;
+    return n != 0;
+}
+/* Reset the write watch of [ea, ea+len): a write from now on is reported (by
+ * tc_wt_written_now, the next harvest). A page the hot rule left dirty then
+ * costs its writer one soft fault. */
+static void tc_wt_reset_span(uint32_t ea, uint32_t len)
+{
+    uint32_t p0, p1;
+    if (!s_tcw.os_ww || !len) return;
+    tc_wt_pages(ea, len, &p0, &p1);
+    tc_wt_reset_run(p0, p1 + 1u);
+}
+/* Does [ea, ea+len) cover a page the TEX_WW_RSX rule keeps dirty (an RSX copy
+ * wrote it within the last TC_RSX_ROUNDS rounds)? */
+static inline int tc_wt_span_rsx(uint32_t ea, uint32_t len)
+{
+    uint32_t p0, p1;
+    if (!s_tcw.rsx_round || !len) return 0;
+    tc_wt_pages(ea, len, &p0, &p1);
+    for (uint32_t p = p0; ; p++) {
+        if (s_tcw.rsx_round[p] && s_tcw.round - s_tcw.rsx_round[p] < TC_RSX_ROUNDS) return 1;
+        if (p == p1) break;
+    }
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * TX1 TEX_FENCE: a fence's state (the backend: tex_fence_hook opens it,
+ * tc_round_ensure judges the fenced batch, tex_fence_capture marks the slots
+ * its records sample, tc_alloc_slot keeps them, vp_upload_tex_slot reads them).
+ * A fence holds its batch only if every record of the batch precedes it and no
+ * harvest ran since (tc_fz_judge); otherwise it lapses -- its serial moves on,
+ * so its marks (copies, watches, hashes) count no more -- and the batch begins
+ * a round as before. A marked slot that carries a copy, a watch or a hash is
+ * not given to another texture during its batch's prepass (tc_fz_protected),
+ * and the replay uses them only for the batch the fence judged
+ * (tc_fz_active). Kept here so tests/test_tex_cache_rsx.c drives the same code.
+ * -----------------------------------------------------------------------*/
+#define TC_FZ_SLOTS 4096u
+enum { TC_FZ_NONE = 0, TC_FZ_WATCH = 1, TC_FZ_HASH = 2 };
+typedef struct {
+    uint32_t batch;               /* the batch the fenced records replay as (0 = none) */
+    uint32_t round;               /* its harvest's round */
+    uint32_t draws;               /* the records before it */
+    uint32_t used;                /* the batch tc_fz_judge said the fence holds */
+    uint32_t id;                  /* the fence's serial, which marks carry */
+    uint32_t chk[TC_FZ_SLOTS];    /* per slot: the serial of the fence that marked it */
+    uint32_t capo[TC_FZ_SLOTS];   /* its copy at the fence: offset + 1 in the copy buffer (0 = none) */
+    uint8_t  watch[TC_FZ_SLOTS];  /* TC_FZ_WATCH: ask the write watch; TC_FZ_HASH: compare hash[] */
+    uint64_t hash[TC_FZ_SLOTS];   /* TC_FZ_HASH: the hash of its bytes at the fence */
+} tc_fence;
+
+/* At a fence with n records pending for batch b: the harvest; a new serial. */
+static inline uint32_t tc_fz_open(tc_fence* f, uint32_t b, uint32_t n)
+{
+    f->round = tc_wt_fence_harvest();
+    f->batch = b; f->draws = n; f->used = 0;
+    if (!++f->id) ++f->id;
+    return f->round;
+}
+/* Batch b's first validation (draw_count records): 1 = the fence holds it (no
+ * round of its own), 0 = no fence, -1 = the fence lapsed (a record after it,
+ * or a harvest since): its marks stop counting, harvest as before. */
+static inline int tc_fz_judge(tc_fence* f, uint32_t b, uint32_t draw_count)
+{
+    if (f->batch != b) return 0;
+    if (tc_wt_fence_current(f->round) && f->draws == draw_count) { f->used = b; return 1; }
+    if (!++f->id) ++f->id;
+    return -1;
+}
+/* Mark slot s for the current fence (copy / watch cleared); 0 if marked already. */
+static inline int tc_fz_mark(tc_fence* f, uint32_t s)
+{
+    if (f->chk[s] == f->id) return 0;
+    f->chk[s] = f->id; f->capo[s] = 0; f->watch[s] = TC_FZ_NONE;
+    return 1;
+}
+/* The replay of batch b: does slot s carry the fence's copy / watch / hash? */
+static inline int tc_fz_active(const tc_fence* f, uint32_t s, uint32_t b)
+{
+    return f->used == b && f->chk[s] == f->id;
+}
+/* Batch b's prepass: is slot s kept for the record that samples it? */
+static inline int tc_fz_protected(const tc_fence* f, uint32_t s, uint32_t b)
+{
+    return f->batch == b && f->chk[s] == f->id && (f->capo[s] || f->watch[s]);
+}
+/* Slot s now holds another texture: what the fence kept for the old one goes. */
+static inline void tc_fz_forget(tc_fence* f, uint32_t s) { f->capo[s] = 0; f->watch[s] = TC_FZ_NONE; }
+/* A texture with no slot at the fence (its first bind is in the fenced batch):
+ * its key, the serial of the fence that looked at it, its copy (offset + 1; 0
+ * = not copied: a render target's, too large, unreadable, over the budget). */
+#define TC_FZ_NEW 64u
+typedef struct { uint32_t id, off, w, h, fmt, cube, kmips, kpitch, span, capo; } tc_fznew;
+
+/* ---------------------------------------------------------------------------
+ * Content hash: every byte, independent multiply-xorshift lanes. Each lane's
+ * step is a bijection of its state for a given word, and the lanes (and a
+ * partial last word) are folded together with the same step, so two inputs
+ * of the same length that differ in exactly one 8-byte word always hash
+ * differently; anything else collides with probability ~2^-64.
+ *
+ * What it is spent on. A page under a texture that is written every frame is
+ * reported by every harvest, and the texture is then hashed in full at its
+ * next bind (and a new texture once, at its upload). In inFamous 2 those are
+ * full-screen 32-bit images the title rewrites in main memory every frame
+ * (it NV3089-copies a 1280x720 colour target and its depth buffer to
+ * 0x473F3B80 / 0x47777B80 for its SPU jobs, 3.5 MB each). In gameplay their
+ * bytes change from frame to frame (PERF: "0 re-hashed same"), so the hash
+ * only confirms the upload that follows (linear A8R8G8B8: see the pshufb path
+ * in rsx_texture_decode); in the menu an image rewritten with the same bytes
+ * is re-hashed and its upload saved. TEX_HASHLOG=<n> (backend) names each
+ * re-hashed texture.
+ *
+ * The original 4-lane form (tc_hash64_v1) is bound by its multiply chains at
+ * ~9.8 GB/s whatever cache level the bytes are in -- tc_hash64 was 4.7% of
+ * the render thread in gameplay. tc_hash64_v2 runs 32 lanes, lane k taking
+ * word k of each 256-byte block: with AVX-512 that is 4 vectors of 8 lanes,
+ * ~140 GB/s on bytes another core or this one just wrote (L3) and ~59 GB/s
+ * from DRAM on a 9800X3D; the portable form of the SAME function ~28 GB/s.
+ * Both forms return the same value for every input, so which one runs is a
+ * speed choice only.
+ *
+ * TEX_FASTHASH=0 brings back the original 4-lane hash, =1 forces the portable
+ * 32-lane form; default: AVX-512 when the CPU and the OS support it. The
+ * choice is made once, before the first hash: a stored hash is only ever
+ * compared with one computed by the same function.
+ * -----------------------------------------------------------------------*/
+static inline uint64_t tc_mix(uint64_t h, uint64_t w)
+{
+    h ^= w;
+    h *= 0x9FB21C651E98DF25ull;
+    return h ^ (h >> 29);
+}
+
+/* The original hash: four lanes (TEX_FASTHASH=0). */
+static uint64_t tc_hash64_v1(const uint8_t* p, size_t n)
+{
+    uint64_t a = 0x9E3779B97F4A7C15ull ^ (uint64_t)n, b = 0xC2B2AE3D27D4EB4Full;
+    uint64_t c = 0x165667B19E3779F9ull, d = 0x27D4EB2F165667C5ull;
+    size_t i = 0;
+    for (; i + 32 <= n; i += 32) {
+        uint64_t w0, w1, w2, w3;
+        memcpy(&w0, p + i, 8);      memcpy(&w1, p + i + 8, 8);
+        memcpy(&w2, p + i + 16, 8); memcpy(&w3, p + i + 24, 8);
+        a = tc_mix(a, w0); b = tc_mix(b, w1); c = tc_mix(c, w2); d = tc_mix(d, w3);
+    }
+    for (; i + 8 <= n; i += 8) { uint64_t w; memcpy(&w, p + i, 8); a = tc_mix(a, w); }
+    if (i < n) { uint64_t w = 0; memcpy(&w, p + i, n - i); b = tc_mix(b, w ^ 0x80u); }
+    uint64_t h = tc_mix(a, b + 0x632BE59BD9B4E019ull);
+    h = tc_mix(h, c + 0x85EBCA77C2B2AE63ull);
+    h = tc_mix(h, d + 0x27D4EB2F165667C5ull);
+    return tc_mix(h, (uint64_t)n);
+}
+
+/* tc_hash64_v2: 32 lanes. The block loop is the only part with a vector
+ * form; the lane seeds, the words after the last whole block, the fold and
+ * the length are shared code, so both forms agree by construction. */
+#define TC_HLANES 32u
+static inline void tc_h2_seed(uint64_t* s, size_t n)
+{
+    for (uint32_t k = 0; k < TC_HLANES; k++)
+        s[k] = (0x9E3779B97F4A7C15ull * (uint64_t)(k + 1u)) ^ (uint64_t)n;
+}
+static inline uint64_t tc_h2_finish(uint64_t* s, const uint8_t* p, size_t i, size_t n)
+{
+    for (uint32_t k = 0; i + 8 <= n; i += 8, k++) {      /* < 32 words remain */
+        uint64_t w; memcpy(&w, p + i, 8); s[k] = tc_mix(s[k], w);
+    }
+    uint64_t h = 0x27D4EB2F165667C5ull;
+    for (uint32_t k = 0; k < TC_HLANES; k++)
+        h = tc_mix(h, s[k] + 0x632BE59BD9B4E019ull * (uint64_t)(k + 1u));
+    if (i < n) { uint64_t w = 0; memcpy(&w, p + i, n - i); h = tc_mix(h, w ^ 0x80u); }
+    return tc_mix(h, (uint64_t)n);
+}
+static uint64_t tc_hash64_v2(const uint8_t* p, size_t n)
+{
+    uint64_t s[TC_HLANES];
+    tc_h2_seed(s, n);
+    size_t i = 0;
+    for (; i + 8u * TC_HLANES <= n; i += 8u * TC_HLANES)
+        for (uint32_t k = 0; k < TC_HLANES; k++) {
+            uint64_t w; memcpy(&w, p + i + 8u * k, 8); s[k] = tc_mix(s[k], w);
+        }
+    return tc_h2_finish(s, p, i, n);
+}
+
+/* x64 with MSVC-style intrinsics (cl, clang-cl): __cpuid/__cpuidex/_xgetbv. */
+#if (defined(_M_X64) || defined(__x86_64__)) && defined(_MSC_VER)
+#include <immintrin.h>
+#include <intrin.h>
+#if defined(__clang__) || defined(__GNUC__)
+#define TC_TARGET_AVX512 __attribute__((target("avx512f,avx512dq")))
+#define TC_TARGET_XSAVE  __attribute__((target("xsave")))
+#else
+#define TC_TARGET_AVX512
+#define TC_TARGET_XSAVE
+#endif
+TC_TARGET_AVX512 static inline __m512i tc_mix8(__m512i h, __m512i w, __m512i k)
+{
+    h = _mm512_xor_si512(h, w);
+    h = _mm512_mullo_epi64(h, k);
+    return _mm512_xor_si512(h, _mm512_srli_epi64(h, 29));
+}
+/* tc_hash64_v2 with the block loop 8 lanes per instruction. */
+TC_TARGET_AVX512 static uint64_t tc_hash64_v2_avx512(const uint8_t* p, size_t n)
+{
+    uint64_t s[TC_HLANES];
+    tc_h2_seed(s, n);
+    size_t i = 0;
+    if (n >= 8u * TC_HLANES) {
+        const __m512i k = _mm512_set1_epi64((long long)0x9FB21C651E98DF25ull);
+        __m512i a = _mm512_loadu_si512(s),      b = _mm512_loadu_si512(s + 8);
+        __m512i c = _mm512_loadu_si512(s + 16), d = _mm512_loadu_si512(s + 24);
+        for (; i + 8u * TC_HLANES <= n; i += 8u * TC_HLANES) {
+            a = tc_mix8(a, _mm512_loadu_si512(p + i),       k);
+            b = tc_mix8(b, _mm512_loadu_si512(p + i + 64),  k);
+            c = tc_mix8(c, _mm512_loadu_si512(p + i + 128), k);
+            d = tc_mix8(d, _mm512_loadu_si512(p + i + 192), k);
+        }
+        _mm512_storeu_si512(s, a);      _mm512_storeu_si512(s + 8, b);
+        _mm512_storeu_si512(s + 16, c); _mm512_storeu_si512(s + 24, d);
+    }
+    return tc_h2_finish(s, p, i, n);
+}
+TC_TARGET_XSAVE static int tc_os_avx512(void)
+{
+    /* XCR0: SSE, AVX, opmask, ZMM0-15 upper halves, ZMM16-31 all saved */
+    return (_xgetbv(0) & 0xE6u) == 0xE6u;
+}
+static int tc_cpu_avx512(void)
+{
+    int r[4];
+    __cpuid(r, 0);
+    if (r[0] < 7) return 0;
+    __cpuid(r, 1);
+    if (!(r[2] & (1 << 27))) return 0;                  /* OSXSAVE */
+    __cpuidex(r, 7, 0);
+    if (!(r[1] & (1 << 16)) || !(r[1] & (1 << 17))) return 0;   /* AVX512F, AVX512DQ */
+    return tc_os_avx512();
+}
+#define TC_HAVE_AVX512_PATH 1
+#endif
+
+typedef uint64_t (*tc_hash_fn)(const uint8_t*, size_t);
+static tc_hash_fn s_tc_hashfn;
+
+/* Pick the hash once (render thread, before the first hash). */
+static tc_hash_fn tc_hash_select(void)
+{
+    if (s_tc_hashfn) return s_tc_hashfn;
+    const char* e = getenv("TEX_FASTHASH");
+    tc_hash_fn f = tc_hash64_v2;
+    const char* what = "32-lane, portable";
+    if (e && *e == '0') { f = tc_hash64_v1; what = "original 4-lane (TEX_FASTHASH=0)"; }
+#ifdef TC_HAVE_AVX512_PATH
+    else if (!(e && *e == '1') && tc_cpu_avx512()) { f = tc_hash64_v2_avx512; what = "32-lane, AVX-512"; }
+#endif
+    else if (e && *e == '1') what = "32-lane, portable (TEX_FASTHASH=1)";
+    fprintf(stderr, "[TEXCACHE] content hash: %s%c", what, 10);
+    s_tc_hashfn = f;
+    return f;
+}
+
+static inline uint64_t tc_hash64(const uint8_t* p, size_t n)
+{
+    const tc_hash_fn f = s_tc_hashfn ? s_tc_hashfn : tc_hash_select();
+    return f(p, n);
+}
+
+/* ---------------------------------------------------------------------------
+ * Key -> slot: chained hash over the slot array. The slot type embeds the key
+ * fields and a `hnext` link (slot index + 1, 0 = end of chain).
+ * -----------------------------------------------------------------------*/
+#define TC_MAP_BUCKETS 4096u          /* power of two, 4x the slot count */
+
+static inline uint32_t tc_key_hash(uint32_t off, uint32_t w, uint32_t h, uint32_t fmt,
+                                   int cube, uint32_t mips)
+{
+    uint64_t k = 0x9E3779B97F4A7C15ull;
+    k ^= off;                                          k *= 0xBF58476D1CE4E5B9ull;
+    k ^= ((uint64_t)w << 32) | h;                      k *= 0x94D049BB133111EBull;
+    k ^= ((uint64_t)fmt << 32) | ((uint64_t)mips << 1) | (uint64_t)(cube & 1);
+    k *= 0xBF58476D1CE4E5B9ull;
+    k ^= k >> 31;
+    return (uint32_t)k & (TC_MAP_BUCKETS - 1u);
+}
+
+#endif /* PS3RECOMP_RSX_TEX_CACHE_H */
diff --git a/libs/video/rsx_tex_heap.h b/libs/video/rsx_tex_heap.h
new file mode 100644
index 0000000..ac66f5a
--- /dev/null
+++ b/libs/video/rsx_tex_heap.h
@@ -0,0 +1,124 @@
+/*
+ * rsx_tex_heap.h -- ST1 TEX_PLACED's range allocator (rsx_d3d12_backend.c tph_*): placement of textures in a
+ * fixed-size heap. A heap keeps its free ranges sorted by offset; a block is taken first fit at the resource's
+ * alignment (the space before an aligned start stays a free range), and a block given back merges with the free
+ * ranges it touches, so a fully freed heap is one range again. Pure C, no D3D: the backend keeps one per 32 MB
+ * D3D12 heap (heap is its ID3D12Heap*); a released heap's slot is cleared (tph_heap_clear) and takes nothing.
+ * TphDefer: blocks given back only later (the backend's failure path: the resource made on them waits in its
+ * graveyard for the next GPU wait) -- a listed block still counts as taken until tph_defer_drain.
+ * Test: libs/video/tests/test_tex_heap.c.
+ */
+#ifndef RSX_TEX_HEAP_H
+#define RSX_TEX_HEAP_H
+
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct { unsigned long long off, len; } TphRange;
+typedef struct {
+    void* heap;                          /* the backend's heap object */
+    TphRange* fr; int nfr, cap;          /* free ranges, sorted by offset, none adjacent */
+    unsigned long long used, size;       /* bytes taken; the heap's size */
+} TphHeap;
+
+/* An empty heap of `size` bytes: one free range. 1 = ok. */
+static int tph_heap_init(TphHeap* H, void* heap, unsigned long long size)
+{
+    memset(H, 0, sizeof *H);
+    H->fr = (TphRange*)malloc(16 * sizeof *H->fr);
+    if (!H->fr) return 0;
+    H->heap = heap; H->cap = 16; H->nfr = 1; H->size = size;
+    H->fr[0].off = 0; H->fr[0].len = size;
+    return 1;
+}
+static int tph_grow(TphHeap* H)
+{
+    if (H->nfr < H->cap) return 1;
+    TphRange* n = (TphRange*)realloc(H->fr, (size_t)H->cap * 2 * sizeof *n);
+    if (!n) return 0;
+    H->fr = n; H->cap *= 2;
+    return 1;
+}
+/* First fit of `size` bytes at an `align`-aligned offset (align a power of two). 1 and *off when it fits. */
+static int tph_take(TphHeap* H, unsigned long long size, unsigned long long align, unsigned long long* off)
+{
+    for (int i = 0; i < H->nfr; i++) {
+        const unsigned long long ro = H->fr[i].off, re = ro + H->fr[i].len;
+        const unsigned long long a = (ro + align - 1u) & ~(align - 1u);
+        if (a + size > re || a + size < a) continue;
+        const unsigned long long head = a - ro, tail = re - (a + size);
+        if (head && tail) {                                /* split: the tail becomes range i + 1 */
+            if (!tph_grow(H)) return 0;
+            memmove(&H->fr[i + 2], &H->fr[i + 1], (size_t)(H->nfr - i - 1) * sizeof *H->fr);
+            H->nfr++;
+            H->fr[i].len = head;
+            H->fr[i + 1].off = a + size; H->fr[i + 1].len = tail;
+        } else if (head) H->fr[i].len = head;
+        else if (tail) { H->fr[i].off = a + size; H->fr[i].len = tail; }
+        else { memmove(&H->fr[i], &H->fr[i + 1], (size_t)(H->nfr - i - 1) * sizeof *H->fr); H->nfr--; }
+        H->used += size;
+        *off = a;
+        return 1;
+    }
+    return 0;
+}
+/* Give [off, off + len) back, merged with its neighbours. 1 = ok; 0 = no memory for a new range (the block
+ * is lost to the heap, nothing else). */
+static int tph_give(TphHeap* H, unsigned long long off, unsigned long long len)
+{
+    int i = 0;
+    while (i < H->nfr && H->fr[i].off < off) i++;
+    const int prev = i > 0 && H->fr[i - 1].off + H->fr[i - 1].len == off;
+    const int next = i < H->nfr && off + len == H->fr[i].off;
+    if (prev && next) {
+        H->fr[i - 1].len += len + H->fr[i].len;
+        memmove(&H->fr[i], &H->fr[i + 1], (size_t)(H->nfr - i - 1) * sizeof *H->fr);
+        H->nfr--;
+    } else if (prev) H->fr[i - 1].len += len;
+    else if (next) { H->fr[i].off = off; H->fr[i].len += len; }
+    else {
+        if (!tph_grow(H)) return 0;
+        memmove(&H->fr[i + 1], &H->fr[i], (size_t)(H->nfr - i) * sizeof *H->fr);
+        H->fr[i].off = off; H->fr[i].len = len;
+        H->nfr++;
+    }
+    H->used -= len;
+    return 1;
+}
+
+/* A released heap's slot (its D3D12 heap gone): takes nothing until tph_heap_init again. */
+static void tph_heap_clear(TphHeap* H)
+{
+    free(H->fr);
+    memset(H, 0, sizeof *H);
+}
+
+typedef struct { int hi; unsigned long long off, len; } TphPend;   /* a block of heap hi to give back later */
+typedef struct { TphPend* p; int n, cap; } TphDefer;
+/* 1 = listed; 0 = no memory for the list (the block stays taken: lost to its heap, nothing else). */
+static int tph_defer_put(TphDefer* D, int hi, unsigned long long off, unsigned long long len)
+{
+    if (D->n == D->cap) {
+        const int nc = D->cap ? D->cap * 2 : 32;
+        TphPend* q = (TphPend*)realloc(D->p, (size_t)nc * sizeof *q);
+        if (!q) return 0;
+        D->p = q; D->cap = nc;
+    }
+    D->p[D->n].hi = hi; D->p[D->n].off = off; D->p[D->n].len = len;
+    D->n++;
+    return 1;
+}
+/* Every listed block back to its heap (H: the heaps by index); the list empties. Returns the blocks given back;
+ * *lost counts those that found no memory for a free range. */
+static int tph_defer_drain(TphDefer* D, TphHeap* H, int* lost)
+{
+    int n = 0;
+    for (int i = 0; i < D->n; i++) {
+        if (tph_give(&H[D->p[i].hi], D->p[i].off, D->p[i].len)) n++;
+        else if (lost) (*lost)++;
+    }
+    D->n = 0;
+    return n;
+}
+
+#endif /* RSX_TEX_HEAP_H */
diff --git a/libs/video/rsx_texpack.h b/libs/video/rsx_texpack.h
new file mode 100644
index 0000000..00f8dd9
--- /dev/null
+++ b/libs/video/rsx_texpack.h
@@ -0,0 +1,952 @@
+/*
+ * ps3recomp - texture dump / replacement packs: the pure parts.
+ *
+ * What a guest texture IS, independent of the host API: its identity (the pack
+ * hash and the level-0 hash), its file name, whether it may be dumped or
+ * replaced at all, the DDS container (parsed as untrusted input), the PNG
+ * header, mip generation, block decoding for dumps, and how a larger
+ * replacement shifts a sampler's LOD clamps. No D3D12, no threads, no file
+ * I/O: rsx_texpack_rt.h (the Windows runtime) and tools/texpack build on this,
+ * and libs/video/tests/test_texpack.c drives it with synthetic data.
+ *
+ * ---------------------------------------------------------------------------
+ * Identity (design.md section 3, critique M1/M2)
+ * ---------------------------------------------------------------------------
+ *   pack hash  = tc_hash64_v2(canonical texel stream)      -- pinned to v2
+ *   level-0 hash = tc_hash64_v2(the stream's level-0 rows of every face)
+ *   canonical texel stream = for each face (1, or 6 for a cube), for each
+ *     GUEST level (rsx_texture_level_count of the format word, whatever
+ *     TEX_MIPS_MAX uploads), for each texel / 4x4-block row: that row's
+ *     texel bytes as stored in guest memory (swizzled stays swizzled, DXT
+ *     blocks stay blocks), with
+ *       - a LINEAR texture's CONTROL3 pitch padding left out,
+ *       - the 128-byte alignment gap between cube faces left out,
+ *       - the don't-care X bits of D8R8G8B8 (0x9E) / D1R5G5B5 (0x9D) forced 0.
+ *   When none of those apply the stream IS the contiguous guest span the
+ *   texture cache already hashed (rsx_tex_cache.h, default v2): no extra pass.
+ *   The level-0 hash is the fallback key when a pack file's full hash does not
+ *   match: a mip tail the title never fills (or fills differently from run to
+ *   run) changes the full hash but not level 0.
+ *
+ * File name: <hash16>_<W>x<H>_<FMT>[_ln][_m<levels>][_cube].png|.dds
+ *   e.g. c095f01e9261e877_512x512_DXT45_m10.png. Only the hash is the key; W,
+ *   H, FMT, ln and cube are checked against the texture (levels are not: they
+ *   are implied by the full hash and may differ for a level-0 match).
+ */
+#ifndef PS3RECOMP_RSX_TEXPACK_H
+#define PS3RECOMP_RSX_TEXPACK_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <math.h>
+#include "rsx_texture_layout.h"
+#include "rsx_tex_cache.h"      /* tc_hash64_v2 (+ the AVX-512 form) */
+
+/* Header-only: every function is static inline, so a translation unit that
+ * uses a few of them carries no unused-function noise for the rest. */
+#define TP_FN static inline
+
+/* Bumped when rsx_texture_decode's output changes for some format, so a
+ * texture dumped through an older decode is written again (critique M14). */
+#define TP_DECODER_VERSION 1
+#define TP_HASHV "tc64v2"
+
+/* ---------------------------------------------------------------------------
+ * Per-slot state (embedded in the backend's VPTexSlot; all zero = nothing)
+ * -----------------------------------------------------------------------*/
+#define TP_F_HASHED     0x0001u  /* hash / hash0 valid for the slot's current bytes   */
+#define TP_F_NOREPLACE  0x0002u  /* not eligible for replacement (see tp_flags_of)  */
+#define TP_F_NODUMP     0x0004u  /* not eligible for dumping                         */
+#define TP_F_DYNAMIC    0x0008u  /* content changed >= 2 times at this key: no dump   */
+#define TP_F_RSXMADE    0x0010u  /* bytes written by an RSX copy / readback           */
+#define TP_F_UNIFORM    0x0020u  /* level 0 is one colour: never dumped or replaced   */
+#define TP_F_DPENDING   0x0040u  /* new hash: dump once it has settled                 */
+#define TP_F_DQUEUED    0x0080u  /* copied for the dump thread                         */
+#define TP_F_USENOTED   0x0100u  /* a usage record was sent for the last tuple        */
+
+struct tp_rep;
+typedef struct tp_slot {
+    uint64_t hash, hash0;      /* canonical pack hash, level-0 hash              */
+    uint64_t use_key;          /* last usage tuple noted (dump mode)             */
+    uint32_t flags;            /* TP_F_*                                          */
+    uint32_t changes;          /* canonical content changes at this key          */
+    uint32_t up_batch;         /* batch of the last upload                       */
+    uint64_t up_frame;         /* backend frame of the last upload               */
+    uint32_t gen;              /* pack generation the lookup was made against    */
+    struct tp_rep* rep;        /* replacement (render thread object), or NULL     */
+} tp_slot;
+
+/* ---------------------------------------------------------------------------
+ * Canonical layout and hashes
+ * -----------------------------------------------------------------------*/
+typedef struct {
+    uint32_t fmt;      /* SET_TEXTURE_FORMAT byte as bound (LN 0x20 / UN 0x40 kept) */
+    uint32_t w, h;
+    uint32_t levels;   /* the format word's level count (or the guest level count) */
+    int      cube;
+    uint32_t pitch;    /* CONTROL3 pitch (0 = packed)                               */
+} tp_desc;
+
+typedef struct {
+    rsx_tex_level lv[RSX_MAX_TEXTURE_LEVELS];
+    uint32_t glv;              /* guest levels                                   */
+    uint32_t nfaces;
+    uint32_t pyramid;          /* guest bytes of one face's pyramid (with pitch)  */
+    uint32_t face_stride;      /* guest bytes from one face to the next           */
+    uint32_t packed_row[RSX_MAX_TEXTURE_LEVELS];   /* texel bytes per row, no pitch */
+    uint64_t stream_bytes;     /* canonical stream length                         */
+    uint64_t stream0_bytes;    /* its level-0 part (all faces)                    */
+    uint64_t guest_span;       /* guest bytes from the base the stream draws from */
+    int      contiguous;       /* stream == guest bytes [0, guest_span)           */
+    int      contiguous0;      /* level-0 stream == guest bytes [0, stream0_bytes) */
+    int      xmask;            /* 0, 4 (0x9E: byte 0 of each 4), 2 (0x9D: bit 7 of byte 0 of each 2) */
+} tp_layout;
+
+/* 0 when the texture has a shape (non-zero dimensions, at most 4096 a side,
+ * the hardware's limit), -1 otherwise. */
+TP_FN int tp_layout_of(const tp_desc* d, tp_layout* L)
+{
+    memset(L, 0, sizeof *L);
+    if (!d->w || !d->h || d->w > 4096u || d->h > 4096u) return -1;
+    L->glv = rsx_texture_mip_chain(d->fmt, d->w, d->h, d->levels, d->pitch, L->lv);
+    if (!L->glv) return -1;
+    L->pyramid = L->lv[L->glv - 1].offset + L->lv[L->glv - 1].tl.face_bytes;
+    L->nfaces = d->cube ? 6u : 1u;
+    L->face_stride = d->cube ? rsx_texture_cube_face_stride(d->fmt, d->w, d->h, d->levels, d->pitch) : L->pyramid;
+    const uint32_t basef = d->fmt & 0x9Fu;
+    L->xmask = basef == 0x9Eu ? 4 : basef == 0x9Du ? 2 : 0;
+    int gaps = 0;
+    for (uint32_t m = 0; m < L->glv; m++) {
+        rsx_tex_layout packed;
+        rsx_texture_layout(d->fmt, L->lv[m].w, L->lv[m].h, &packed);   /* no pitch: the texel bytes */
+        L->packed_row[m] = packed.row_bytes;
+        if (packed.row_bytes != L->lv[m].tl.row_bytes) gaps = 1;
+        L->stream_bytes += (uint64_t)packed.row_bytes * L->lv[m].tl.rows * L->nfaces;
+        if (m == 0) L->stream0_bytes = (uint64_t)packed.row_bytes * L->lv[0].tl.rows * L->nfaces;
+    }
+    if (d->cube && L->face_stride != L->pyramid) gaps = 1;
+    L->guest_span = (uint64_t)(L->nfaces - 1u) * L->face_stride + L->pyramid;
+    L->contiguous  = !gaps && !L->xmask;
+    L->contiguous0 = L->nfaces == 1u && !L->xmask && L->packed_row[0] == L->lv[0].tl.row_bytes;
+    return 0;
+}
+
+/* Write the canonical stream (level0_only: only level 0 of every face) of the
+ * texture at `base` to `out` (stream_bytes / stream0_bytes long). */
+TP_FN void tp_gather(const tp_layout* L, const uint8_t* base, uint8_t* out, int level0_only)
+{
+    uint8_t* o = out;
+    const uint32_t nlv = level0_only ? 1u : L->glv;
+    for (uint32_t f = 0; f < L->nfaces; f++)
+        for (uint32_t m = 0; m < nlv; m++) {
+            const uint8_t* lvl = base + (size_t)f * L->face_stride + L->lv[m].offset;
+            if (L->packed_row[m] == L->lv[m].tl.row_bytes) {
+                memcpy(o, lvl, (size_t)L->packed_row[m] * L->lv[m].tl.rows);
+                o += (size_t)L->packed_row[m] * L->lv[m].tl.rows;
+            } else
+                for (uint32_t r = 0; r < L->lv[m].tl.rows; r++) {
+                    memcpy(o, lvl + (size_t)r * L->lv[m].tl.row_bytes, L->packed_row[m]);
+                    o += L->packed_row[m];
+                }
+        }
+    const size_t n = (size_t)(o - out);
+    if (L->xmask == 4) for (size_t i = 0; i < n; i += 4) out[i] = 0;          /* X of X8R8G8B8 */
+    if (L->xmask == 2) for (size_t i = 0; i < n; i += 2) out[i] &= 0x7Fu;     /* X bit of D1R5G5B5 */
+}
+
+/* The pinned hash: tc_hash64_v2, in its fastest form on this CPU (both forms
+ * return the same value for every input, rsx_tex_cache.h). */
+typedef uint64_t (*tp_hash_fn_t)(const uint8_t*, size_t);
+TP_FN tp_hash_fn_t tp_hash_fn(void)
+{
+    static tp_hash_fn_t f;
+    if (!f) {
+        tp_hash_fn_t g = tc_hash64_v2;
+#ifdef TC_HAVE_AVX512_PATH
+        if (tc_cpu_avx512()) g = tc_hash64_v2_avx512;
+#endif
+        f = g;
+    }
+    return f;
+}
+
+/* Both hashes of the texture at `base`. `scratch` (stream_bytes long, may be
+ * NULL: then it is allocated) holds the gathered stream when the layout is
+ * not contiguous. Returns 0, or -1 when no memory could be had. */
+TP_FN int tp_hashes(const tp_layout* L, const uint8_t* base, uint64_t* full, uint64_t* h0)
+{
+    const tp_hash_fn_t hf = tp_hash_fn();
+    uint8_t* tmp = NULL;
+    if (full) {
+        if (L->contiguous) *full = hf(base, (size_t)L->stream_bytes);
+        else {
+            tmp = (uint8_t*)malloc((size_t)L->stream_bytes ? (size_t)L->stream_bytes : 1u);
+            if (!tmp) return -1;
+            tp_gather(L, base, tmp, 0);
+            *full = hf(tmp, (size_t)L->stream_bytes);
+        }
+    }
+    if (h0) {
+        if (L->contiguous0) *h0 = hf(base, (size_t)L->stream0_bytes);
+        else {
+            /* level 0 of face f starts every face; the full stream (gathered
+             * above) holds face f's level 0 at f * (stream_bytes / nfaces) */
+            if (tmp && L->nfaces == 1u) *h0 = hf(tmp, (size_t)L->stream0_bytes);
+            else {
+                uint8_t* t0 = (uint8_t*)malloc((size_t)L->stream0_bytes ? (size_t)L->stream0_bytes : 1u);
+                if (!t0) { free(tmp); return -1; }
+                tp_gather(L, base, t0, 1);
+                *h0 = hf(t0, (size_t)L->stream0_bytes);
+                free(t0);
+            }
+        }
+    }
+    free(tmp);
+    return 0;
+}
+
+/* 1 when level 0 of face 0 is one value repeated: every texel (or 4x4 block,
+ * or 4:2:2 pair) the same bytes, X bits ignored. Such a texture (a cleared
+ * buffer, an evicted render target's zeros, a placeholder) shares its name
+ * with every other one of its size and format, so replacing it would replace
+ * all of them (critique M5). */
+TP_FN int tp_is_uniform(const tp_layout* L, const tp_desc* d, const uint8_t* base)
+{
+    const rsx_tex_layout* tl = &L->lv[0].tl;
+    uint32_t unit = tl->compressed ? tl->block_bytes : tl->bytes_per_texel;
+    const uint32_t basef = d->fmt & 0x9Fu;
+    if (basef == 0x8Du || basef == 0x8Eu) unit = 4u;
+    if (!unit || unit > 16u || L->packed_row[0] < unit) return 0;
+    uint8_t ref[16], mask[16];
+    memcpy(ref, base, unit);
+    memset(mask, 0xFF, sizeof mask);
+    if (L->xmask == 4) mask[0] = 0;
+    if (L->xmask == 2) mask[0] = 0x7F;
+    for (uint32_t i = 0; i < unit; i++) ref[i] &= mask[i];
+    for (uint32_t r = 0; r < tl->rows; r++) {
+        const uint8_t* row = base + (size_t)r * tl->row_bytes;
+        for (uint32_t x = 0; x + unit <= L->packed_row[0]; x += unit)
+            for (uint32_t i = 0; i < unit; i++)
+                if ((row[x + i] & mask[i]) != ref[i]) return 0;
+    }
+    return 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Format names and classes
+ * -----------------------------------------------------------------------*/
+TP_FN const char* tp_fmt_name(uint32_t fmt)
+{
+    switch (fmt & 0x9Fu) {
+    case 0x81: return "B8";        case 0x82: return "A1R5G5B5";  case 0x83: return "A4R4G4B4";
+    case 0x84: return "R5G6B5";    case 0x85: return "A8R8G8B8";  case 0x86: return "DXT1";
+    case 0x87: return "DXT23";     case 0x88: return "DXT45";     case 0x8B: return "G8B8";
+    case 0x8D: return "B8R8_G8R8"; case 0x8E: return "R8B8_R8G8"; case 0x8F: return "R6G5B5";
+    case 0x90: return "DEPTH24_D8"; case 0x91: return "DEPTH24_D8F"; case 0x92: return "DEPTH16";
+    case 0x93: return "DEPTH16F";
+    case 0x94: return "X16";       case 0x95: return "Y16_X16";   case 0x97: return "R5G5B5A1";
+    case 0x98: return "HILO8";     case 0x99: return "HILO_S8";   case 0x9A: return "W16Z16Y16X16F";
+    case 0x9B: return "W32Z32Y32X32F"; case 0x9C: return "X32F";  case 0x9D: return "D1R5G5B5";
+    case 0x9E: return "D8R8G8B8";  case 0x9F: return "Y16_X16F";  default: return NULL;
+    }
+}
+
+/* Format byte (0x80-0x9F, no LN/UN) from a name at `s`; *len gets the name's
+ * length. The longest matching name wins (Y16_X16 vs Y16_X16F). 0 = none. */
+TP_FN uint32_t tp_fmt_from_name(const char* s, size_t* len)
+{
+    uint32_t best = 0; size_t bl = 0;
+    for (uint32_t f = 0x80; f <= 0x9F; f++) {
+        const char* n = tp_fmt_name(f);
+        if (!n) continue;
+        const size_t l = strlen(n);
+        if (l > bl && !strncmp(s, n, l)) { best = f; bl = l; }
+    }
+    if (len) *len = bl;
+    return best;
+}
+
+/* What the uploader decodes a format to (rsx_texture_layout's class), and so
+ * what a replacement must provide. */
+enum {
+    TP_CLS_NONE = 0, TP_CLS_RGBA8, TP_CLS_BC1, TP_CLS_BC2, TP_CLS_BC3, TP_CLS_R8, TP_CLS_R8G8,
+    TP_CLS_R8G8S, TP_CLS_R16, TP_CLS_R16G16, TP_CLS_F16X2, TP_CLS_F16X4, TP_CLS_F32, TP_CLS_F32X4,
+    TP_CLS_DEPTH
+};
+TP_FN int tp_class_of(uint32_t fmt)
+{
+    const uint32_t b = fmt & 0x9Fu;
+    if (rsx_texture_format_is_depth(b)) return TP_CLS_DEPTH;
+    if (!rsx_texture_format_known(b)) return TP_CLS_NONE;
+    if (b == 0x99u) return TP_CLS_R8G8S;
+    rsx_tex_layout tl; rsx_texture_layout(b, 4, 4, &tl);
+    switch (tl.fmt) {
+    case RSX_TEXFMT_R8:       return TP_CLS_R8;
+    case RSX_TEXFMT_R8G8:     return TP_CLS_R8G8;
+    case RSX_TEXFMT_R8G8B8A8: return TP_CLS_RGBA8;
+    case RSX_TEXFMT_BC1:      return TP_CLS_BC1;
+    case RSX_TEXFMT_BC2:      return TP_CLS_BC2;
+    case RSX_TEXFMT_BC3:      return TP_CLS_BC3;
+    case RSX_TEXFMT_R16:      return TP_CLS_R16;
+    case RSX_TEXFMT_R16G16:   return TP_CLS_R16G16;
+    case RSX_TEXFMT_R16G16F:  return TP_CLS_F16X2;
+    case RSX_TEXFMT_R16G16B16A16F: return TP_CLS_F16X4;
+    case RSX_TEXFMT_R32F:     return TP_CLS_F32;
+    case RSX_TEXFMT_R32G32B32A32F: return TP_CLS_F32X4;
+    default: return TP_CLS_NONE;
+    }
+}
+/* Colour classes: dumped by default ("color"); the others (16-bit data,
+ * signed, float) only with TEXDUMP_WHAT=all. */
+TP_FN int tp_class_is_color(int cls)
+{
+    return cls == TP_CLS_RGBA8 || cls == TP_CLS_BC1 || cls == TP_CLS_BC2 || cls == TP_CLS_BC3 ||
+           cls == TP_CLS_R8 || cls == TP_CLS_R8G8;
+}
+
+/* Why a texture may never be dumped or replaced, from its registers alone:
+ * a depth format (depth semantics, rsx_ztex reads GetDimensions), UN
+ * (texel-addressed: rsx_unn divides by the resource's size), a 3D texture
+ * (format word dimension 3: not implemented by the backend), a border texture
+ * (format word bit 3 clear: not modelled), an unknown format. `fword` is the
+ * whole SET_TEXTURE_FORMAT word (0 when unknown: dimension / border not
+ * checked). Returns 0 when allowed, else a short reason. */
+TP_FN const char* tp_reg_veto(uint32_t fmt, uint32_t fword)
+{
+    const int cls = tp_class_of(fmt);
+    if (cls == TP_CLS_NONE) return "unknown format";
+    if (cls == TP_CLS_DEPTH) return "depth format";
+    if (fmt & 0x40u) return "UN (texel coordinates)";
+    if (fword) {
+        if (((fword >> 4) & 0xFu) == 3u) return "3D texture";
+        if (!(fword & 8u)) return "border texture";
+    }
+    return NULL;
+}
+
+/* ---------------------------------------------------------------------------
+ * File names
+ * -----------------------------------------------------------------------*/
+TP_FN int tp_make_name(char* out, size_t n, const tp_desc* d, uint64_t hash, const char* ext)
+{
+    const char* fn = tp_fmt_name(d->fmt);
+    const uint32_t glv = rsx_texture_level_count(d->w, d->h, d->levels);
+    char lvs[16] = "";
+    if (glv > 1) snprintf(lvs, sizeof lvs, "_m%u", glv);
+    return snprintf(out, n, "%016llx_%ux%u_%s%s%s%s%s", (unsigned long long)hash, d->w, d->h,
+                    fn ? fn : "UNK", (d->fmt & 0x20u) ? "_ln" : "", lvs, d->cube ? "_cube" : "",
+                    ext ? ext : "");
+}
+
+enum { TP_KIND_NONE = 0, TP_KIND_PNG = 1, TP_KIND_DDS = 2 };
+typedef struct {
+    uint64_t hash;
+    uint32_t w, h, fmt;   /* fmt: base format byte 0x80-0x9F */
+    int ln, cube;
+    uint32_t levels;      /* 0 when the name has no _m */
+    int kind;             /* TP_KIND_PNG / DDS */
+} tp_name_info;
+
+static int tp_hexval(int c)
+{
+    return (c >= '0' && c <= '9') ? c - '0' : (c >= 'a' && c <= 'f') ? c - 'a' + 10
+         : (c >= 'A' && c <= 'F') ? c - 'A' + 10 : -1;
+}
+static int tp_parse_u32(const char** p, uint32_t* v, uint32_t maxv)
+{
+    const char* s = *p; uint64_t x = 0; int n = 0;
+    while (*s >= '0' && *s <= '9' && n < 7) { x = x * 10u + (uint64_t)(*s - '0'); s++; n++; }
+    if (!n || x > maxv || (*s >= '0' && *s <= '9')) return -1;
+    *v = (uint32_t)x; *p = s;
+    return 0;
+}
+/* Parse a pack/dump file name (no directory). 0 = ok. Anything after the
+ * recognised suffixes and before the extension is ignored, so an author may
+ * keep a note in the name ("..._DXT45_m10_hd.png"). */
+TP_FN int tp_parse_name(const char* name, tp_name_info* o)
+{
+    memset(o, 0, sizeof *o);
+    const char* s = name;
+    uint64_t h = 0;
+    for (int i = 0; i < 16; i++) {
+        const int v = tp_hexval((unsigned char)s[i]);
+        if (v < 0) return -1;
+        h = (h << 4) | (uint64_t)v;
+    }
+    s += 16;
+    if (*s++ != '_') return -1;
+    if (tp_parse_u32(&s, &o->w, 16384) || *s++ != 'x' || tp_parse_u32(&s, &o->h, 16384) || *s++ != '_') return -1;
+    if (!o->w || !o->h) return -1;
+    size_t fl = 0;
+    o->fmt = tp_fmt_from_name(s, &fl);
+    if (!o->fmt) return -1;
+    s += fl;
+    if (!strncmp(s, "_ln", 3) && (s[3] == '_' || s[3] == '.')) { o->ln = 1; s += 3; }
+    if (s[0] == '_' && s[1] == 'm' && s[2] >= '0' && s[2] <= '9') {
+        s += 2;
+        if (tp_parse_u32(&s, &o->levels, 64)) return -1;
+    }
+    if (!strncmp(s, "_cube", 5) && (s[5] == '_' || s[5] == '.')) { o->cube = 1; s += 5; }
+    const char* dot = strrchr(s, '.');
+    if (!dot) return -1;
+    if (!strcmp(dot, ".png") || !strcmp(dot, ".PNG")) o->kind = TP_KIND_PNG;
+    else if (!strcmp(dot, ".dds") || !strcmp(dot, ".DDS")) o->kind = TP_KIND_DDS;
+    else return -1;
+    if (*s != '.' && *s != '_' && *s != '-' && *s != ' ') return -1;   /* "…_DXT45x.png" is not a name */
+    o->hash = h;
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * DXGI formats used by packs (values from dxgiformat.h, so this header needs
+ * no Windows headers)
+ * -----------------------------------------------------------------------*/
+enum {
+    TP_DXGI_UNKNOWN = 0, TP_DXGI_R32G32B32A32_FLOAT = 2, TP_DXGI_R16G16B16A16_FLOAT = 10,
+    TP_DXGI_R16G16_FLOAT = 34, TP_DXGI_R16G16_UNORM = 35, TP_DXGI_R8G8B8A8_UNORM = 28,
+    TP_DXGI_R8G8B8A8_UNORM_SRGB = 29, TP_DXGI_R32_FLOAT = 41, TP_DXGI_R8G8_UNORM = 49,
+    TP_DXGI_R8G8_SNORM = 51, TP_DXGI_R16_UNORM = 56, TP_DXGI_R8_UNORM = 61,
+    TP_DXGI_BC1_UNORM = 71, TP_DXGI_BC1_UNORM_SRGB = 72, TP_DXGI_BC2_UNORM = 74,
+    TP_DXGI_BC2_UNORM_SRGB = 75, TP_DXGI_BC3_UNORM = 77, TP_DXGI_BC3_UNORM_SRGB = 78,
+    TP_DXGI_BC4_UNORM = 80, TP_DXGI_BC4_SNORM = 81, TP_DXGI_BC5_UNORM = 83, TP_DXGI_BC5_SNORM = 84,
+    TP_DXGI_B8G8R8A8_UNORM = 87, TP_DXGI_B8G8R8X8_UNORM = 88, TP_DXGI_B8G8R8A8_UNORM_SRGB = 91,
+    TP_DXGI_B8G8R8X8_UNORM_SRGB = 93, TP_DXGI_BC7_UNORM = 98, TP_DXGI_BC7_UNORM_SRGB = 99
+};
+
+/* The UNORM form of an sRGB format (critique M6: an _SRGB view would make the
+ * hardware linearise and then rsx_texproc linearise again). */
+TP_FN uint32_t tp_dxgi_unorm(uint32_t f)
+{
+    switch (f) {
+    case TP_DXGI_R8G8B8A8_UNORM_SRGB: return TP_DXGI_R8G8B8A8_UNORM;
+    case TP_DXGI_BC1_UNORM_SRGB: return TP_DXGI_BC1_UNORM;
+    case TP_DXGI_BC2_UNORM_SRGB: return TP_DXGI_BC2_UNORM;
+    case TP_DXGI_BC3_UNORM_SRGB: return TP_DXGI_BC3_UNORM;
+    case TP_DXGI_BC7_UNORM_SRGB: return TP_DXGI_BC7_UNORM;
+    case TP_DXGI_B8G8R8A8_UNORM_SRGB: return TP_DXGI_B8G8R8A8_UNORM;
+    case TP_DXGI_B8G8R8X8_UNORM_SRGB: return TP_DXGI_B8G8R8X8_UNORM;
+    default: return f;
+    }
+}
+/* Bytes per texel (uncompressed) or per 4x4 block (*block = 1). 0 = not a
+ * format packs use. */
+TP_FN uint32_t tp_dxgi_size(uint32_t f, int* block)
+{
+    *block = 0;
+    switch (tp_dxgi_unorm(f)) {
+    case TP_DXGI_R32G32B32A32_FLOAT: return 16;
+    case TP_DXGI_R16G16B16A16_FLOAT: return 8;
+    case TP_DXGI_R16G16_FLOAT: case TP_DXGI_R16G16_UNORM: case TP_DXGI_R8G8B8A8_UNORM:
+    case TP_DXGI_R32_FLOAT: case TP_DXGI_B8G8R8A8_UNORM: case TP_DXGI_B8G8R8X8_UNORM: return 4;
+    case TP_DXGI_R8G8_UNORM: case TP_DXGI_R8G8_SNORM: case TP_DXGI_R16_UNORM: return 2;
+    case TP_DXGI_R8_UNORM: return 1;
+    case TP_DXGI_BC1_UNORM: case TP_DXGI_BC4_UNORM: case TP_DXGI_BC4_SNORM: *block = 1; return 8;
+    case TP_DXGI_BC2_UNORM: case TP_DXGI_BC3_UNORM: case TP_DXGI_BC5_UNORM: case TP_DXGI_BC5_SNORM:
+    case TP_DXGI_BC7_UNORM: *block = 1; return 16;
+    default: return 0;
+    }
+}
+/* Tight row bytes and rows of one w x h level. 0 on an unknown format. */
+TP_FN uint64_t tp_dxgi_level_bytes(uint32_t f, uint32_t w, uint32_t h, uint32_t* row_bytes, uint32_t* rows)
+{
+    int blk; const uint32_t sz = tp_dxgi_size(f, &blk);
+    if (!sz || !w || !h) return 0;
+    const uint64_t rb = blk ? (uint64_t)((w + 3u) / 4u) * sz : (uint64_t)w * sz;
+    const uint32_t nr = blk ? (h + 3u) / 4u : h;
+    if (rb > 0xFFFFFFFFull) return 0;
+    if (row_bytes) *row_bytes = (uint32_t)rb;
+    if (rows) *rows = nr;
+    return rb * nr;
+}
+TP_FN uint32_t tp_full_levels(uint32_t w, uint32_t h)
+{
+    uint32_t m = w > h ? w : h, n = 1;
+    while (m > 1u) { m >>= 1; n++; }
+    return n;
+}
+
+/* Which file formats can stand in for a guest class (design 6.2). The
+ * replacement's view format is always UNORM (or SNORM where the original is),
+ * never _SRGB. */
+TP_FN int tp_class_accepts_dxgi(int cls, uint32_t f)
+{
+    f = tp_dxgi_unorm(f);
+    switch (cls) {
+    case TP_CLS_RGBA8: case TP_CLS_BC1: case TP_CLS_BC2: case TP_CLS_BC3:
+        return f == TP_DXGI_R8G8B8A8_UNORM || f == TP_DXGI_B8G8R8A8_UNORM || f == TP_DXGI_B8G8R8X8_UNORM ||
+               f == TP_DXGI_BC1_UNORM || f == TP_DXGI_BC2_UNORM || f == TP_DXGI_BC3_UNORM || f == TP_DXGI_BC7_UNORM;
+    case TP_CLS_R8:     return f == TP_DXGI_R8_UNORM || f == TP_DXGI_BC4_UNORM;
+    case TP_CLS_R8G8:   return f == TP_DXGI_R8G8_UNORM || f == TP_DXGI_BC5_UNORM;
+    case TP_CLS_R8G8S:  return f == TP_DXGI_R8G8_SNORM || f == TP_DXGI_BC5_SNORM;
+    case TP_CLS_R16:    return f == TP_DXGI_R16_UNORM;
+    case TP_CLS_R16G16: return f == TP_DXGI_R16G16_UNORM;
+    case TP_CLS_F16X2:  return f == TP_DXGI_R16G16_FLOAT;
+    case TP_CLS_F16X4:  return f == TP_DXGI_R16G16B16A16_FLOAT;
+    case TP_CLS_F32:    return f == TP_DXGI_R32_FLOAT;
+    case TP_CLS_F32X4:  return f == TP_DXGI_R32G32B32A32_FLOAT;
+    default: return 0;
+    }
+}
+/* The DXGI format the uploader gives the original (rsx_d3d12_backend.c). */
+TP_FN uint32_t tp_class_dxgi(int cls)
+{
+    switch (cls) {
+    case TP_CLS_RGBA8: return TP_DXGI_R8G8B8A8_UNORM;
+    case TP_CLS_BC1: return TP_DXGI_BC1_UNORM;  case TP_CLS_BC2: return TP_DXGI_BC2_UNORM;
+    case TP_CLS_BC3: return TP_DXGI_BC3_UNORM;  case TP_CLS_R8: return TP_DXGI_R8_UNORM;
+    case TP_CLS_R8G8: return TP_DXGI_R8G8_UNORM; case TP_CLS_R8G8S: return TP_DXGI_R8G8_SNORM;
+    case TP_CLS_R16: return TP_DXGI_R16_UNORM;  case TP_CLS_R16G16: return TP_DXGI_R16G16_UNORM;
+    case TP_CLS_F16X2: return TP_DXGI_R16G16_FLOAT; case TP_CLS_F16X4: return TP_DXGI_R16G16B16A16_FLOAT;
+    case TP_CLS_F32: case TP_CLS_DEPTH: return TP_DXGI_R32_FLOAT;
+    case TP_CLS_F32X4: return TP_DXGI_R32G32B32A32_FLOAT;
+    default: return TP_DXGI_UNKNOWN;
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * DDS container. Pack files are untrusted input (critique M7): every size is
+ * computed in 64 bits and checked against the file before anything is read.
+ * -----------------------------------------------------------------------*/
+#define TP_DDS_MAX_DIM 16384u
+#define TP_MAX_SUB (6u * 16u)
+typedef struct {
+    uint32_t dxgi;             /* as stored (may be _SRGB; tp_dxgi_unorm for the view) */
+    uint32_t w, h, levels, faces;   /* faces: 1, or 6 for a cube */
+    uint64_t off[TP_MAX_SUB];  /* byte offset of subresource face * levels + level */
+    uint32_t row_bytes[16], rows[16];
+    uint64_t data_bytes;       /* bytes of every subresource together */
+    const char* err;
+} tp_dds_info;
+
+static uint32_t tp_rd32le(const uint8_t* p) { return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24); }
+static void tp_wr32le(uint8_t* p, uint32_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24); }
+#define TP_FOURCC(a, b, c, d) ((uint32_t)(uint8_t)(a) | ((uint32_t)(uint8_t)(b) << 8) | ((uint32_t)(uint8_t)(c) << 16) | ((uint32_t)(uint8_t)(d) << 24))
+
+/* 0 = ok (o filled), -1 = rejected (o->err says why). */
+TP_FN int tp_dds_parse(const uint8_t* d, size_t n, tp_dds_info* o)
+{
+    memset(o, 0, sizeof *o);
+    if (n < 128 || tp_rd32le(d) != TP_FOURCC('D', 'D', 'S', ' ')) { o->err = "not a DDS file"; return -1; }
+    const uint8_t* hd = d + 4;
+    if (tp_rd32le(hd) != 124u) { o->err = "bad header size"; return -1; }
+    const uint32_t flags = tp_rd32le(hd + 4);
+    uint32_t h = tp_rd32le(hd + 8), w = tp_rd32le(hd + 12);
+    const uint32_t depth = tp_rd32le(hd + 20);
+    uint32_t mips = tp_rd32le(hd + 24);
+    const uint8_t* pf = hd + 72;          /* DDS_PIXELFORMAT */
+    const uint32_t pfflags = tp_rd32le(pf + 4), fourcc = tp_rd32le(pf + 8), bits = tp_rd32le(pf + 12);
+    const uint32_t rm = tp_rd32le(pf + 16), gm = tp_rd32le(pf + 20), bm = tp_rd32le(pf + 24), am = tp_rd32le(pf + 28);
+    const uint32_t caps2 = tp_rd32le(hd + 108);
+    size_t data_at = 128;
+    uint32_t dxgi = 0, faces = 1;
+    (void)flags;
+    if ((pfflags & 4u) && fourcc == TP_FOURCC('D', 'X', '1', '0')) {
+        if (n < 148) { o->err = "truncated DX10 header"; return -1; }
+        const uint8_t* x = d + 128;
+        dxgi = tp_rd32le(x);
+        const uint32_t dim = tp_rd32le(x + 4), misc = tp_rd32le(x + 8), arr = tp_rd32le(x + 12);
+        if (dim != 3u) { o->err = "not a 2D texture"; return -1; }
+        if (misc & 4u) { if (arr != 1u) { o->err = "cube arrays not supported"; return -1; } faces = 6; }
+        else if (arr != 1u) { o->err = "texture arrays not supported"; return -1; }
+        data_at = 148;
+    } else if (pfflags & 4u) {
+        switch (fourcc) {
+        case TP_FOURCC('D', 'X', 'T', '1'): dxgi = TP_DXGI_BC1_UNORM; break;
+        case TP_FOURCC('D', 'X', 'T', '2'): case TP_FOURCC('D', 'X', 'T', '3'): dxgi = TP_DXGI_BC2_UNORM; break;
+        case TP_FOURCC('D', 'X', 'T', '4'): case TP_FOURCC('D', 'X', 'T', '5'): dxgi = TP_DXGI_BC3_UNORM; break;
+        case TP_FOURCC('A', 'T', 'I', '1'): case TP_FOURCC('B', 'C', '4', 'U'): dxgi = TP_DXGI_BC4_UNORM; break;
+        case TP_FOURCC('A', 'T', 'I', '2'): case TP_FOURCC('B', 'C', '5', 'U'): dxgi = TP_DXGI_BC5_UNORM; break;
+        case TP_FOURCC('B', 'C', '5', 'S'): dxgi = TP_DXGI_BC5_SNORM; break;
+        case 113u: dxgi = TP_DXGI_R16G16B16A16_FLOAT; break;   /* D3DFMT_A16B16G16R16F */
+        case 116u: dxgi = TP_DXGI_R32G32B32A32_FLOAT; break;   /* D3DFMT_A32B32G32R32F */
+        case 114u: dxgi = TP_DXGI_R32_FLOAT; break;            /* D3DFMT_R32F */
+        case 112u: dxgi = TP_DXGI_R16G16_FLOAT; break;         /* D3DFMT_G16R16F */
+        default: o->err = "unsupported FourCC"; return -1;
+        }
+    } else if (pfflags & 0x40u) {         /* DDPF_RGB */
+        if (bits == 32 && rm == 0xFFu && gm == 0xFF00u && bm == 0xFF0000u) dxgi = TP_DXGI_R8G8B8A8_UNORM;
+        else if (bits == 32 && rm == 0xFF0000u && gm == 0xFF00u && bm == 0xFFu) dxgi = am ? TP_DXGI_B8G8R8A8_UNORM : TP_DXGI_B8G8R8X8_UNORM;
+        else if (bits == 32 && rm == 0xFFFFu && gm == 0xFFFF0000u) dxgi = TP_DXGI_R16G16_UNORM;
+        else { o->err = "unsupported RGB layout"; return -1; }
+    } else if (pfflags & 0x20000u) {      /* DDPF_LUMINANCE */
+        if (bits == 8 && rm == 0xFFu) dxgi = TP_DXGI_R8_UNORM;
+        else if (bits == 16 && rm == 0xFFFFu) dxgi = TP_DXGI_R16_UNORM;
+        else if (bits == 16 && rm == 0xFFu && (pfflags & 1u) && am == 0xFF00u) dxgi = TP_DXGI_R8G8_UNORM;
+        else { o->err = "unsupported luminance layout"; return -1; }
+    } else { o->err = "unsupported pixel format"; return -1; }
+    if (!(pfflags & 4u) || fourcc != TP_FOURCC('D', 'X', '1', '0')) {
+        if ((caps2 & 0x200u)) {
+            if ((caps2 & 0xFC00u) != 0xFC00u) { o->err = "partial cube map"; return -1; }
+            faces = 6;
+        }
+        if (caps2 & 0x200000u) { o->err = "volume textures not supported"; return -1; }
+    }
+    if (depth > 1u) { o->err = "volume textures not supported"; return -1; }
+    if (!w || !h || w > TP_DDS_MAX_DIM || h > TP_DDS_MAX_DIM) { o->err = "bad dimensions"; return -1; }
+    if (faces == 6 && w != h) { o->err = "cube faces not square"; return -1; }
+    int blk; if (!tp_dxgi_size(dxgi, &blk)) { o->err = "unsupported DXGI format"; return -1; }
+    if (!mips) mips = 1;
+    const uint32_t full = tp_full_levels(w, h);
+    if (mips > full || mips > 16u) { o->err = "more mip levels than the size has"; return -1; }
+    uint64_t at = data_at;
+    for (uint32_t f = 0; f < faces; f++)
+        for (uint32_t m = 0; m < mips; m++) {
+            const uint32_t lw = (w >> m) ? (w >> m) : 1u, lh = (h >> m) ? (h >> m) : 1u;
+            uint32_t rb = 0, nr = 0;
+            const uint64_t lb = tp_dxgi_level_bytes(dxgi, lw, lh, &rb, &nr);
+            if (!lb) { o->err = "bad level size"; return -1; }
+            o->off[f * mips + m] = at;
+            if (f == 0) { o->row_bytes[m] = rb; o->rows[m] = nr; }
+            at += lb;
+            if (at > (uint64_t)n) { o->err = "file shorter than its levels"; return -1; }
+        }
+    o->dxgi = dxgi; o->w = w; o->h = h; o->levels = mips; o->faces = faces;
+    o->data_bytes = at - data_at;
+    return 0;
+}
+
+/* A DDS header for (dxgi, w, h, levels, cube): the legacy form for BC1/2/3 and
+ * R8G8B8A8 (readable by every tool), the DX10 form otherwise. Returns its
+ * size (128 or 148); `out` holds 148 bytes. */
+TP_FN size_t tp_dds_header(uint8_t* out, uint32_t dxgi, uint32_t w, uint32_t h, uint32_t levels, int cube)
+{
+    memset(out, 0, 148);
+    tp_wr32le(out, TP_FOURCC('D', 'D', 'S', ' '));
+    uint8_t* hd = out + 4;
+    int blk; const uint32_t sz = tp_dxgi_size(dxgi, &blk);
+    uint32_t rb = 0, nr = 0; tp_dxgi_level_bytes(dxgi, w, h, &rb, &nr);
+    tp_wr32le(hd, 124);
+    tp_wr32le(hd + 4, 0x1u | 0x2u | 0x4u | 0x1000u | (levels > 1 ? 0x20000u : 0u) | (blk ? 0x80000u : 0x8u));
+    tp_wr32le(hd + 8, h); tp_wr32le(hd + 12, w);
+    tp_wr32le(hd + 16, blk ? rb * nr : rb);
+    tp_wr32le(hd + 24, levels);
+    uint8_t* pf = hd + 72;
+    tp_wr32le(pf, 32);
+    tp_wr32le(hd + 104, 0x1000u | (levels > 1 ? 0x400008u : 0u) | (cube ? 0x8u : 0u));
+    tp_wr32le(hd + 108, cube ? 0xFE00u : 0u);
+    const uint32_t u = tp_dxgi_unorm(dxgi);
+    if (u == TP_DXGI_BC1_UNORM || u == TP_DXGI_BC2_UNORM || u == TP_DXGI_BC3_UNORM) {
+        tp_wr32le(pf + 4, 4u);
+        tp_wr32le(pf + 8, u == TP_DXGI_BC1_UNORM ? TP_FOURCC('D', 'X', 'T', '1')
+                        : u == TP_DXGI_BC2_UNORM ? TP_FOURCC('D', 'X', 'T', '3') : TP_FOURCC('D', 'X', 'T', '5'));
+        return 128;
+    }
+    if (dxgi == TP_DXGI_R8G8B8A8_UNORM) {
+        tp_wr32le(pf + 4, 0x40u | 0x1u); tp_wr32le(pf + 12, 32);
+        tp_wr32le(pf + 16, 0xFFu); tp_wr32le(pf + 20, 0xFF00u); tp_wr32le(pf + 24, 0xFF0000u); tp_wr32le(pf + 28, 0xFF000000u);
+        return 128;
+    }
+    (void)sz;
+    tp_wr32le(pf + 4, 4u); tp_wr32le(pf + 8, TP_FOURCC('D', 'X', '1', '0'));
+    uint8_t* x = out + 128;
+    tp_wr32le(x, dxgi); tp_wr32le(x + 4, 3u); tp_wr32le(x + 8, cube ? 4u : 0u); tp_wr32le(x + 12, 1u);
+    return 148;
+}
+
+/* ---------------------------------------------------------------------------
+ * PNG header (dimensions without decoding). 0 = ok.
+ * -----------------------------------------------------------------------*/
+TP_FN int tp_png_ihdr(const uint8_t* d, size_t n, uint32_t* w, uint32_t* h, int* depth, int* ctype)
+{
+    static const uint8_t sig[8] = {0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A};
+    if (n < 33 || memcmp(d, sig, 8) || memcmp(d + 12, "IHDR", 4)) return -1;
+    const uint32_t W = ((uint32_t)d[16] << 24) | ((uint32_t)d[17] << 16) | ((uint32_t)d[18] << 8) | d[19];
+    const uint32_t H = ((uint32_t)d[20] << 24) | ((uint32_t)d[21] << 16) | ((uint32_t)d[22] << 8) | d[23];
+    if (!W || !H || W > TP_DDS_MAX_DIM || H > TP_DDS_MAX_DIM) return -1;
+    *w = W; *h = H; *depth = d[24]; *ctype = d[25];
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Replacement shape rules
+ * -----------------------------------------------------------------------*/
+/* log2 of a replacement's scale against the original: rw = ow * 2^s and
+ * rh = oh * 2^s exactly, s in [-2, 4] (a quarter to 16 times). The aspect
+ * must match. Returns 1 with *s set, 0 when the shape cannot replace it.
+ * Non-power-of-two originals take any exact power-of-two multiple. */
+TP_FN int tp_scale_log2(uint32_t ow, uint32_t oh, uint32_t rw, uint32_t rh, int* s)
+{
+    for (int k = -2; k <= 4; k++) {
+        const uint64_t ew = k >= 0 ? (uint64_t)ow << k : (uint64_t)(ow >> -k);
+        const uint64_t eh = k >= 0 ? (uint64_t)oh << k : (uint64_t)(oh >> -k);
+        if (k < 0 && ((ow & ((1u << -k) - 1u)) || (oh & ((1u << -k) - 1u)))) continue;
+        if (ew == rw && eh == rh) { *s = k; return 1; }
+    }
+    return 0;
+}
+/* Levels a replacement view shows for a slot whose original has `glv` levels
+ * uploaded: never past the guest's coarsest level (critique C3: the guest's
+ * chain end is an implicit clamp), so at most glv + s; at least 1. */
+TP_FN uint32_t tp_view_levels(uint32_t rep_levels, uint32_t glv, int s)
+{
+    int64_t cap = (int64_t)glv + s;
+    if (cap < 1) cap = 1;
+    uint32_t v = rep_levels < (uint64_t)cap ? rep_levels : (uint32_t)cap;
+    return v ? v : 1u;
+}
+
+/* ---------------------------------------------------------------------------
+ * Sampler LOD with a larger (or smaller) replacement (design 6.5 + critique
+ * C3/B9). The backend's sampler code (rsx_d3d12_backend.c samp_code /
+ * samp_lod_bits): bit 3 mips on, bit 2 mip linear, bit 53 guest LOD state
+ * present with min LOD bits 26-37 and max LOD bits 38-49 (unsigned 4.8, 0xFFF =
+ * none). Hardware LOD from derivatives scales with the resource, so a 2^s
+ * replacement picks level k + s where the original picked k; only the absolute
+ * clamps move. This adds, only when it changes the sampler (so every other
+ * code -- and every code with packs off -- stays exactly today's):
+ *   bit 63: shifted, bits 59-62: s + 8.
+ * (Bits 54-58 are TEX_BORDER's border-colour index in the shadow work's
+ * samp_border_bits: the two must never share a bit, or a border index >= 16
+ * would read as a shift with packs off.)
+ * A mip filter whose LOD state clamps nothing needs no shift (the view's level
+ * count, tp_view_levels, already ends the chain where the guest's ends). A
+ * non-mip guest filter (level 0 only) with s > 0 and minify = mip becomes a
+ * linear-mip filter limited to levels [0, s]: never coarser than the PS3's
+ * level 0, never more aliased.
+ * -----------------------------------------------------------------------*/
+#define TP_SAMP_SHIFTED (1ull << 63)
+#define TP_SAMP_S_SHIFT 59
+TP_FN uint64_t tp_samp_shift(uint64_t code, int s, int minify_mip)
+{
+    if (s == 0 || s < -7 || s > 7) return code;
+    if (code & 8u) {
+        if (!((code >> 53) & 1u)) return code;
+        const uint32_t mn = (uint32_t)(code >> 26) & 0xFFFu, mx = (uint32_t)(code >> 38) & 0xFFFu;
+        if (mn == 0u && mx == 0xFFFu) return code;
+    } else if (!(s > 0 && minify_mip)) return code;
+    return code | TP_SAMP_SHIFTED | ((uint64_t)((uint32_t)(s + 8) & 0xFu) << TP_SAMP_S_SHIFT);
+}
+/* What a shifted code means (samp_write): the absolute min/max LOD and
+ * whether a non-mip filter was promoted. Returns 0 for an unshifted code. */
+TP_FN int tp_samp_lod(uint64_t code, float* min_lod, float* max_lod, int* promote_mip)
+{
+    if (!(code & TP_SAMP_SHIFTED)) return 0;
+    const int s = (int)((code >> TP_SAMP_S_SHIFT) & 0xFu) - 8;
+    *promote_mip = 0;
+    if (!(code & 8u)) {                       /* non-mip guest filter, s > 0 */
+        *promote_mip = 1; *min_lod = 0.0f; *max_lod = (float)s;
+        return 1;
+    }
+    const uint32_t mn = (uint32_t)(code >> 26) & 0xFFFu, mx = (uint32_t)(code >> 38) & 0xFFFu;
+    float a = mn ? (float)mn / 256.0f + (float)s : 0.0f;   /* 0 stays 0: the extra detail is sampled */
+    if (a < 0.0f) a = 0.0f;
+    float b = mx == 0xFFFu ? 3.402823466e+38f : (float)mx / 256.0f + (float)s;
+    if (b < a) b = a;
+    *min_lod = a; *max_lod = b;
+    return 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Mip generation (critique M13: in gamma space by default -- 2011-era chains
+ * were box-filtered on the stored values, so this keeps the PS3's distance
+ * look; "linear" averages in linear light, an enhancement).
+ * -----------------------------------------------------------------------*/
+static float tp_srgb_to_lin(float c) { return c <= 0.04045f ? c / 12.92f : powf((c + 0.055f) / 1.055f, 2.4f); }
+static float tp_lin_to_srgb(float c) { return c <= 0.0031308f ? c * 12.92f : 1.055f * powf(c, 1.0f / 2.4f) - 0.055f; }
+/* One 2x2 box step of an 8-bit image with `ch` channels (1, 2 or 4); in
+ * linear mode the first min(ch, 3) channels are averaged in linear light
+ * (alpha never). dst is (max(1,w/2)) x (max(1,h/2)), tightly packed. */
+TP_FN void tp_mip_down8(const uint8_t* src, uint32_t w, uint32_t h, uint32_t ch, uint8_t* dst, int linear)
+{
+    static float lut[256]; static int lut_ok;
+    if (linear && !lut_ok) { for (int i = 0; i < 256; i++) lut[i] = tp_srgb_to_lin((float)i / 255.0f); lut_ok = 1; }
+    const uint32_t dw = w > 1 ? w / 2 : 1, dh = h > 1 ? h / 2 : 1;
+    for (uint32_t y = 0; y < dh; y++)
+        for (uint32_t x = 0; x < dw; x++) {
+            const uint32_t x0 = w > 1 ? 2 * x : 0, x1 = w > 1 ? 2 * x + 1 : 0;
+            const uint32_t y0 = h > 1 ? 2 * y : 0, y1 = h > 1 ? 2 * y + 1 : 0;
+            const uint8_t* p[4] = { src + ((size_t)y0 * w + x0) * ch, src + ((size_t)y0 * w + x1) * ch,
+                                    src + ((size_t)y1 * w + x0) * ch, src + ((size_t)y1 * w + x1) * ch };
+            uint8_t* o = dst + ((size_t)y * dw + x) * ch;
+            for (uint32_t c = 0; c < ch; c++) {
+                if (linear && c < 3 && ch != 2) {
+                    const float v = (lut[p[0][c]] + lut[p[1][c]] + lut[p[2][c]] + lut[p[3][c]]) * 0.25f;
+                    int q = (int)(tp_lin_to_srgb(v) * 255.0f + 0.5f);
+                    o[c] = (uint8_t)(q < 0 ? 0 : q > 255 ? 255 : q);
+                } else
+                    o[c] = (uint8_t)(((uint32_t)p[0][c] + p[1][c] + p[2][c] + p[3][c] + 2u) / 4u);
+            }
+        }
+}
+/* The same for 16-bit channels (R16, R16G16: data, never gamma). */
+TP_FN void tp_mip_down16(const uint16_t* src, uint32_t w, uint32_t h, uint32_t ch, uint16_t* dst)
+{
+    const uint32_t dw = w > 1 ? w / 2 : 1, dh = h > 1 ? h / 2 : 1;
+    for (uint32_t y = 0; y < dh; y++)
+        for (uint32_t x = 0; x < dw; x++) {
+            const uint32_t x0 = w > 1 ? 2 * x : 0, x1 = w > 1 ? 2 * x + 1 : 0;
+            const uint32_t y0 = h > 1 ? 2 * y : 0, y1 = h > 1 ? 2 * y + 1 : 0;
+            for (uint32_t c = 0; c < ch; c++)
+                dst[((size_t)y * dw + x) * ch + c] = (uint16_t)(((uint32_t)src[((size_t)y0 * w + x0) * ch + c] +
+                    src[((size_t)y0 * w + x1) * ch + c] + src[((size_t)y1 * w + x0) * ch + c] +
+                    src[((size_t)y1 * w + x1) * ch + c] + 2u) / 4u);
+        }
+}
+
+/* ---------------------------------------------------------------------------
+ * BC1/2/3 (DXT1/23/45) decode to RGBA8 -- for dumping a DXT texture as PNG
+ * and for the tool. Integer palette, as the backend's TEX_MIPDUMP decoder.
+ * -----------------------------------------------------------------------*/
+TP_FN void tp_bc_decode(uint8_t* out, uint32_t opitch, const uint8_t* src, uint32_t w, uint32_t h, int bcn)
+{
+    const uint32_t bb = bcn == 1 ? 8u : 16u, bw = (w + 3u) / 4u;
+    for (uint32_t by = 0; by < (h + 3u) / 4u; by++)
+        for (uint32_t bx = 0; bx < bw; bx++) {
+            const uint8_t* blk = src + ((size_t)by * bw + bx) * bb;
+            const uint8_t* cb = bb == 16u ? blk + 8 : blk;
+            const uint32_t c0 = (uint32_t)cb[0] | ((uint32_t)cb[1] << 8), c1 = (uint32_t)cb[2] | ((uint32_t)cb[3] << 8);
+            uint8_t pal[4][4];
+            for (int i = 0; i < 2; i++) {
+                const uint32_t c = i ? c1 : c0;
+                pal[i][0] = (uint8_t)(((c >> 11) & 31u) * 255u / 31u);
+                pal[i][1] = (uint8_t)(((c >> 5) & 63u) * 255u / 63u);
+                pal[i][2] = (uint8_t)((c & 31u) * 255u / 31u);
+                pal[i][3] = 255;
+            }
+            const int four = bcn != 1 || c0 > c1;
+            for (int c = 0; c < 3; c++) {
+                pal[2][c] = (uint8_t)(four ? (2u * pal[0][c] + pal[1][c]) / 3u : (pal[0][c] + pal[1][c]) / 2u);
+                pal[3][c] = (uint8_t)(four ? (pal[0][c] + 2u * pal[1][c]) / 3u : 0u);
+            }
+            pal[2][3] = 255; pal[3][3] = four ? 255 : 0;
+            const uint32_t idx = (uint32_t)cb[4] | ((uint32_t)cb[5] << 8) | ((uint32_t)cb[6] << 16) | ((uint32_t)cb[7] << 24);
+            uint8_t a8[8] = {0};
+            if (bcn == 3) {
+                a8[0] = blk[0]; a8[1] = blk[1];
+                for (int i = 2; i < 8; i++)
+                    a8[i] = (uint8_t)(blk[0] > blk[1] ? ((8 - i) * blk[0] + (i - 1) * blk[1]) / 7
+                                                      : (i < 6 ? ((6 - i) * blk[0] + (i - 1) * blk[1]) / 5 : (i == 6 ? 0 : 255)));
+            }
+            const uint64_t abits = bcn == 3 ? ((uint64_t)blk[2] | ((uint64_t)blk[3] << 8) | ((uint64_t)blk[4] << 16) |
+                                               ((uint64_t)blk[5] << 24) | ((uint64_t)blk[6] << 32) | ((uint64_t)blk[7] << 40)) : 0;
+            for (uint32_t i = 0; i < 16u; i++) {
+                const uint32_t x = bx * 4u + (i & 3u), y = by * 4u + (i >> 2);
+                if (x >= w || y >= h) continue;
+                uint8_t* p = out + (size_t)y * opitch + (size_t)x * 4u;
+                memcpy(p, pal[(idx >> (2u * i)) & 3u], 4);
+                if (bcn == 2) p[3] = (uint8_t)(((blk[i >> 1] >> (4u * (i & 1u))) & 15u) * 17u);
+                else if (bcn == 3) p[3] = a8[(abits >> (3u * i)) & 7u];
+            }
+        }
+}
+
+/* ---------------------------------------------------------------------------
+ * index.jsonl: one JSON object per line, written by the dump; read back by
+ * the dump (what was dumped before) and by the pack loader (level-0 hashes).
+ * Only flat "key":"string" / "key":number fields are read; a line that does
+ * not parse (a torn last line after a crash, critique M9) is skipped.
+ * -----------------------------------------------------------------------*/
+TP_FN const char* tp_json_find(const char* line, const char* key)
+{
+    char pat[48];
+    const int n = snprintf(pat, sizeof pat, "\"%s\":", key);
+    if (n <= 0 || n >= (int)sizeof pat) return NULL;
+    const char* p = strstr(line, pat);
+    return p ? p + n : NULL;
+}
+TP_FN int tp_json_str(const char* line, const char* key, char* out, size_t n)
+{
+    const char* p = tp_json_find(line, key);
+    if (!p || *p != '"' || !n) return -1;
+    p++;
+    size_t i = 0;
+    while (*p && *p != '"') {
+        if (*p == '\\') { p++; if (!*p) return -1; }
+        if (i + 1 >= n) return -1;
+        out[i++] = *p++;
+    }
+    if (*p != '"') return -1;
+    out[i] = 0;
+    return 0;
+}
+TP_FN int tp_json_hex64(const char* line, const char* key, uint64_t* v)
+{
+    char b[24];
+    if (tp_json_str(line, key, b, sizeof b) || strlen(b) != 16) return -1;
+    uint64_t x = 0;
+    for (int i = 0; i < 16; i++) { const int d = tp_hexval((unsigned char)b[i]); if (d < 0) return -1; x = (x << 4) | (uint64_t)d; }
+    *v = x;
+    return 0;
+}
+TP_FN int tp_json_int(const char* line, const char* key, long long* v)
+{
+    const char* p = tp_json_find(line, key);
+    if (!p) return -1;
+    char* e = NULL;
+    const long long x = strtoll(p, &e, 10);
+    if (e == p) return -1;
+    *v = x;
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * A set of 64-bit keys (open addressing; key 0 is stored as 1).
+ * -----------------------------------------------------------------------*/
+typedef struct { uint64_t* k; uint32_t cap, n; } tp_hset;
+static uint64_t tp_hset_mix(uint64_t k) { k ^= k >> 33; k *= 0xFF51AFD7ED558CCDull; k ^= k >> 33; return k; }
+TP_FN int tp_hset_has(const tp_hset* s, uint64_t k)
+{
+    if (!s->cap) return 0;
+    if (!k) k = 1;
+    for (uint32_t i = (uint32_t)tp_hset_mix(k) & (s->cap - 1u); ; i = (i + 1u) & (s->cap - 1u)) {
+        if (s->k[i] == k) return 1;
+        if (!s->k[i]) return 0;
+    }
+}
+TP_FN int tp_hset_add(tp_hset* s, uint64_t k)   /* 1 = added, 0 = present, -1 = no memory */
+{
+    if (!k) k = 1;
+    if ((s->n + 1u) * 4u >= s->cap * 3u) {
+        const uint32_t nc = s->cap ? s->cap * 2u : 1024u;
+        uint64_t* nk = (uint64_t*)calloc(nc, sizeof *nk);
+        if (!nk) return -1;
+        for (uint32_t j = 0; j < s->cap; j++)
+            if (s->k[j])
+                for (uint32_t i = (uint32_t)tp_hset_mix(s->k[j]) & (nc - 1u); ; i = (i + 1u) & (nc - 1u))
+                    if (!nk[i]) { nk[i] = s->k[j]; break; }
+        free(s->k); s->k = nk; s->cap = nc;
+    }
+    for (uint32_t i = (uint32_t)tp_hset_mix(k) & (s->cap - 1u); ; i = (i + 1u) & (s->cap - 1u)) {
+        if (s->k[i] == k) return 0;
+        if (!s->k[i]) { s->k[i] = k; s->n++; return 1; }
+    }
+}
+TP_FN void tp_hset_free(tp_hset* s) { free(s->k); memset(s, 0, sizeof *s); }
+
+/* ---------------------------------------------------------------------------
+ * PARAM.SFO: one string value (the folders are named after TITLE_ID). The
+ * format is little-endian: magic "\0PSF", key table @0x08, data table @0x0C,
+ * entry count @0x10, 16-byte entries from 0x14 (key offset u16, format u16,
+ * length u32, max u32, data offset u32). 0 = found.
+ * -----------------------------------------------------------------------*/
+TP_FN int tp_sfo_string(const uint8_t* d, size_t n, const char* key, char* out, size_t on)
+{
+    if (n < 0x14 || n > (1u << 20) || !on || d[0] != 0 || d[1] != 'P' || d[2] != 'S' || d[3] != 'F') return -1;
+    const uint32_t kt = tp_rd32le(d + 8), dt = tp_rd32le(d + 12), cnt = tp_rd32le(d + 16);
+    for (uint32_t i = 0; i < cnt && i < 4096u; i++) {
+        const uint64_t e = 0x14u + (uint64_t)i * 0x10u;
+        if (e + 0x10u > n) break;
+        const uint32_t ko = (uint32_t)d[e] | ((uint32_t)d[e + 1] << 8);
+        const uint32_t len = tp_rd32le(d + e + 4), dof = tp_rd32le(d + e + 12);
+        const uint64_t ka = (uint64_t)kt + ko;
+        if (ka >= n) continue;
+        const size_t kmax = n - (size_t)ka;
+        if (strnlen((const char*)d + ka, kmax) == kmax || strcmp((const char*)d + ka, key)) continue;
+        const uint64_t da = (uint64_t)dt + dof;
+        if (da >= n) return -1;
+        size_t c = len; if (c > n - (size_t)da) c = n - (size_t)da;
+        if (c >= on) c = on - 1;
+        memcpy(out, d + da, c); out[c] = 0;
+        out[strnlen(out, c)] = 0;
+        return out[0] ? 0 : -1;
+    }
+    return -1;
+}
+
+/* The dump's "already written" key: the hash and the decoder version. */
+static uint64_t tp_dump_key(uint64_t hash) { return hash ^ ((uint64_t)TP_DECODER_VERSION * 0x9E3779B97F4A7C15ull); }
+
