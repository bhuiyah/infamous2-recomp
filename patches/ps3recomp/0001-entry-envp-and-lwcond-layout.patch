diff --git a/runtime/syscalls/fsfd_ss.inc b/runtime/syscalls/fsfd_ss.inc
new file mode 100644
index 0000000..a660fcd
--- /dev/null
+++ b/runtime/syscalls/fsfd_ss.inc
@@ -0,0 +1,128 @@
+/*
+ * ps3recomp - FSFD: the open files and directories of the three fd tables, one
+ * save-state section (runtime/savestate/ss_state.h; engine design 6.2)
+ *
+ * A guest file can be open in any of three tables, each with its own fd
+ * numbers -- they overlap (every table hands out 3 first), so an fd is only
+ * meaningful with its table:
+ *   FSFD_T_SYS_FS  the lv2 syscalls          runtime/syscalls/sys_fs.c (registers FSFD)
+ *   FSFD_T_PPU_FS  the cellFs HLE the title uses   runtime/ppu/ppu_fs.cpp
+ *   FSFD_T_CELLFS  the libs cellFs functions        libs/filesystem/cellFs.c
+ * sys_fs.c owns the section: the record layout, the strict check and the
+ * capture. Each table is a PART that only answers "what is in slot i" with
+ * plain values (fsfd_ent); sys_fs.c turns that into the FSFD records. Per
+ * file: table, fd, guest path, host path, open flags, position, sdata /
+ * EDAT origin, and the size and last write of what is open (so a load can
+ * tell a changed file). Per directory: table, fd, guest path, host path and
+ * the entries the guest was given. M4c reopens each at the same fd of the
+ * same table (critique C7).
+ *
+ * A LOAD (M4c; the contract is runtime/savestate/ss_state.h "THE LOAD"):
+ *   check_image  before the stop, the world running: every record's guest
+ *                path resolved again through its table's translator (and
+ *                the EDAT step), and the file found unchanged (size, last
+ *                write), the directory still as long; a write-open record,
+ *                a table or fd this build does not have, refused by name
+ *   teardown     every table closes all it holds and is empty (boot state)
+ *   restore      every record put back at its fd: a file reopened
+ *                read-only and sought to its position (an sdata tmpfile
+ *                decrypted again), a directory reopened with its consumed
+ *                entries skipped; each part's own FIELDS read back
+ * sys_fs.c does the generic half (validation, the path, open and seek); a
+ * part's put() installs what it is handed in its own slot.
+ *
+ * Included by those three files (C and C++); a part registers once, before
+ * the first save (static init, or the table's own init at boot).
+ */
+#ifndef PS3RECOMP_FSFD_SS_INC
+#define PS3RECOMP_FSFD_SS_INC
+
+#include <stdint.h>
+#include <stdio.h>
+#include "../savestate/ss_state.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { FSFD_T_SYS_FS = 1, FSFD_T_PPU_FS = 2, FSFD_T_CELLFS = 3 };
+#define FSFD_PATH_MAX 1024          /* CELL_FS_MAX_FS_PATH_LENGTH: every guest path the PS3 accepts */
+
+/* sdata: how the bytes of an open file reach the guest */
+enum { FSFD_SD_NONE = 0,            /* cellFsOpen / sys_fs_open of the file */
+       FSFD_SD_PLAIN = 1,           /* cellFsSdataOpen of a file already plaintext */
+       FSFD_SD_TMPFILE = 2 };       /* cellFsSdataOpen: NPD decrypted into an anonymous tmpfile */
+
+/* One slot of a table as the table holds it. Strings point into the table. */
+typedef struct fsfd_ent {
+    int         fd;                 /* the number the guest holds */
+    int         dir;                /* 1: an open directory */
+    int         wr;                 /* files: opened for writing (the strict check refuses it) */
+    uint32_t    flags;              /* files: the guest's open flags, as passed */
+    int         sdata;              /* files: FSFD_SD_* */
+    int         edat;               /* files: 1 = host_path is the EDAT decryption cache (edat_resolve) */
+    FILE*       fp;                 /* files: the stream (position, size: read, never kept) */
+    uint32_t    consumed;           /* directories: entries the guest has been given */
+    const char* path;               /* the guest path it was opened with */
+    const char* host_path;          /* what was opened on the host */
+} fsfd_ent;
+
+/* One record of an image, as a LOAD hands it to a part's put(): plain values,
+ * checked against this build already (table, fd, flags, strings). */
+typedef struct fsfd_put {
+    int         fd;                 /* the number the guest holds */
+    int         dir;                /* 1: a directory */
+    uint32_t    flags;              /* files: the guest's open flags (read-only: a save refuses any other) */
+    int         sdata;              /* files: FSFD_SD_* */
+    int         edat;               /* files: 1 = host is the EDAT cache */
+    uint64_t    pos;                /* files: the next read's offset */
+    uint64_t    size;               /* files: the size the guest saw (an sdata tmpfile's: the plaintext's) */
+    uint32_t    consumed;           /* directories: entries the guest was given */
+    const char* path;               /* the guest path */
+    const char* host;               /* what to open: the path resolved again now (translate, the EDAT step) */
+} fsfd_put;
+
+typedef struct fsfd_part {
+    uint32_t       table;           /* FSFD_T_* */
+    int            nslots;          /* slot() answers for [0, nslots) */
+    /* 1: slot i holds an open file or directory (in *e, zeroed by the caller);
+     * 0: a free slot. Called with every guest thread parked (check, capture)
+     * or with the world running (size_hint): plain reads, no lock. */
+    int          (*slot)(int i, fsfd_ent* e);
+    /* The table's own statics to save (written as a FIELDS record), or NULL. */
+    const ss_list* fields;
+    /* -- M4c, a LOAD (sys_fs.c's FSFD check_image / teardown / restore) -- */
+    /* The host path this table's open would use for guest path `path` now:
+     * its own translator, nothing else (the EDAT step is sys_fs.c's, for the
+     * tables whose file opens take it: edat_opens). 0, or -1: no mapping. */
+    int          (*translate)(const char* path, char* host, size_t cap);
+    int            edat_opens;      /* 1: this table's file opens go through edat_resolve */
+    /* 1 if this table hands out fd for a file (dir 0) or a directory (dir 1). */
+    int          (*fd_ok)(int fd, int dir);
+    int            shared_fds;      /* 1: its files and directories share the numbers */
+    /* sdata 2 (an NPD container served decrypted from a tmpfile): can the
+     * container at host be decrypted again to `size` bytes? 0, or -1 with
+     * why. NULL: this table opens none (such a record is refused). */
+    int          (*check_sdata)(const char* host, uint64_t size, char* why, size_t n);
+    /* Close every handle the table holds and zero its slots and per-fd
+     * arrays: empty, as at boot (a LOAD, after the discard). */
+    void         (*teardown)(void);
+    /* Put one record back at its fd; the slot is free (teardown ran). A file:
+     * fp is open read-only on p->host, at p->pos -- or, sdata 2, at 0 on the
+     * NPD container, for the table to decrypt again and seek --, and the
+     * part owns it from here (closes it on a failure). A directory: fp is
+     * NULL; the part opens p->host and skips p->consumed entries. 0, or -1
+     * with why (the load then ends the process: it is past its point of no
+     * return). */
+    int          (*put)(const fsfd_put* p, FILE* fp, char* why, size_t n);
+} fsfd_part;
+
+/* Add a table (sys_fs.c's own is built in). Returns 1; 0 for NULL or a full
+ * registry. A second part with the same table replaces the first. */
+int fsfd_ss_add_part(const fsfd_part* p);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_FSFD_SS_INC */
