new file mode 100644
index 0000000..b78d3f3
--- /dev/null
+++ b/libs/input/tests/test_pad_hid_sony.c
@@ -0,0 +1,742 @@
+/*
+ * Unit tests for libs/input/pad_hid_sony.c with synthesized reports.
+ *
+ * The pad_host.h helpers are mocked here: feature reports come from a
+ * per-test table, writes and SET_FEATUREs are captured, the CRC is a plain
+ * table zlib CRC-32. Expected output reports and the Bluetooth input /
+ * feature reports with CRCs come from sony_vectors.py (Python zlib, an
+ * independent implementation), in sony_vectors.h.
+ *
+ * Every (pad, bus, report type): DS4 USB full, BT simple, BT full (+bad CRC),
+ * USB adapter; DualSense USB full, BT simple, BT full (+bad CRC), Edge; DS3
+ * raw, SXS (feature poll + fallback), SDF, GPJ; every output report.
+ *
+ * Build and run (Windows, from external/ps3recomp):
+ *   py -I libs/input/tests/sony_vectors.py libs/input/tests/sony_vectors.h   (only if the vectors change)
+ *   clang-cl /std:c17 /O2 /MD -I include -I libs/input -I libs/system
+ *            libs/input/tests/test_pad_hid_sony.c libs/input/pad_hid_sony.c /Fe:test_pad_hid_sony.exe
+ */
+#define _CRT_SECURE_NO_WARNINGS
+#include "pad_host.h"
+#include "cellPad.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sony_vectors.h"
+
+/* ---------------------------------------------------------------- mock core */
+
+typedef struct { u8 id; int len; u8 data[600]; int fail; } MockFeature;
+static MockFeature g_feat[16];
+static int g_nfeat;
+static int g_get_calls[256];
+static u8  g_last_write[2048]; static int g_last_write_len, g_writes;
+static u8  g_last_setf[2048];  static int g_last_setf_len, g_setfs;
+static int g_set_feature_fails;
+static const char* g_cfg_keys[16]; static const char* g_cfg_vals[16]; static int g_ncfg;
+static int g_log_lines;
+
+static void mock_reset(void)
+{
+    memset(g_feat, 0, sizeof g_feat); g_nfeat = 0;
+    memset(g_get_calls, 0, sizeof g_get_calls);
+    g_last_write_len = g_writes = 0; g_last_setf_len = g_setfs = 0;
+    g_set_feature_fails = 0; g_ncfg = 0;
+}
+static void mock_feature(const u8* data, int len, int fail_first)
+{
+    MockFeature* f = &g_feat[g_nfeat++];
+    f->id = data[0]; f->len = len; memcpy(f->data, data, (size_t)len); f->fail = fail_first;
+}
+static void mock_cfg(const char* k, const char* v) { g_cfg_keys[g_ncfg] = k; g_cfg_vals[g_ncfg] = v; g_ncfg++; }
+
+int padhost_dev_read(PadHostDevice* d, unsigned char* buf, int cap, int timeout_ms) { return -1; }
+int padhost_dev_write(PadHostDevice* d, const unsigned char* buf, int len)
+{
+    memcpy(g_last_write, buf, (size_t)len); g_last_write_len = len; g_writes++;
+    return len;
+}
+int padhost_dev_get_feature(PadHostDevice* d, unsigned char* buf, int len)
+{
+    g_get_calls[buf[0]]++;
+    for (int i = 0; i < g_nfeat; i++) {
+        MockFeature* f = &g_feat[i];
+        if (f->id != buf[0]) continue;
+        if (f->fail > 0) { f->fail--; return -1; }
+        if (len < f->len) return -1;
+        memset(buf, 0, (size_t)len);
+        memcpy(buf, f->data, (size_t)f->len);
+        return len;
+    }
+    return -1;
+}
+int padhost_dev_set_feature(PadHostDevice* d, const unsigned char* buf, int len)
+{
+    if (g_set_feature_fails) return -1;
+    memcpy(g_last_setf, buf, (size_t)len); g_last_setf_len = len; g_setfs++;
+    return len;
+}
+unsigned padhost_crc32(unsigned seed, const unsigned char* p, int n)
+{
+    static unsigned t[256]; static int init;
+    if (!init) {
+        for (unsigned i = 0; i < 256; i++) { unsigned c = i;
+            for (int k = 0; k < 8; k++) c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+            t[i] = c; }
+        init = 1;
+    }
+    unsigned c = ~seed;
+    while (n-- > 0) c = t[(c ^ *p++) & 0xFF] ^ (c >> 8);
+    return ~c;
+}
+void padhost_port_color(int port, u8* r, u8* g, u8* b)
+{
+    static const u8 rgb[7][3] = { {0x00,0x00,0x40}, {0x40,0x00,0x00}, {0x00,0x40,0x00}, {0x20,0x00,0x20},
+                                  {0x40,0x10,0x00}, {0x00,0x20,0x20}, {0x20,0x20,0x20} };
+    *r = rgb[port][0]; *g = rgb[port][1]; *b = rgb[port][2];
+}
+unsigned padhost_port_led_mask(int port)
+{
+    static const unsigned m[7] = { 0x1, 0x2, 0x4, 0x8, 0x9, 0xA, 0xC };
+    return m[port];
+}
+void padhost_state_neutral(PadHostPortState* st)
+{
+    memset(st, 0, sizeof *st);
+    st->lx = st->ly = st->rx = st->ry = 128;
+    st->sensor_x = PADHOST_SENSOR_NEUTRAL_X; st->sensor_y = PADHOST_SENSOR_NEUTRAL_Y;
+    st->sensor_z = PADHOST_SENSOR_NEUTRAL_Z; st->sensor_g = PADHOST_SENSOR_NEUTRAL_G;
