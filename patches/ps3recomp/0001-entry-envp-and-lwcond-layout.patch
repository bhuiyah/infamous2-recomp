+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    size_t n = fread(text, 1, sizeof text - 1, f);
+    fclose(f);
+    *errs += dcfg_parse_text(&s_dcfg, dcfg_text_prepare(text, n), 0, dcfg_warn, path);
+    return 1;
+}
