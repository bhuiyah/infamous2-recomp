+/* Windows LANGID: low 10 bits the primary language, the rest the region. */
+s32 cellSysutil_lang_from_windows(unsigned langid)
+{
+    const unsigned pri = langid & 0x3FF, sub = (langid >> 10) & 0x3F;
+    switch (pri) {
+    case 0x11: return CELL_SYSUTIL_LANG_JAPANESE;
+    case 0x09:  /* English: the UK and the Commonwealth regions a PS3 sold as PAL */
+        switch (langid) {
+        case 0x0809: case 0x0C09: case 0x1409: case 0x1809: case 0x1C09: case 0x4009:
+            return CELL_SYSUTIL_LANG_ENGLISH_GB;   /* GB, AU, NZ, IE, ZA, IN */
+        default: return CELL_SYSUTIL_LANG_ENGLISH_US;
+        }
+    case 0x0C: return CELL_SYSUTIL_LANG_FRENCH;
+    case 0x0A: return CELL_SYSUTIL_LANG_SPANISH;
+    case 0x07: return CELL_SYSUTIL_LANG_GERMAN;
+    case 0x10: return CELL_SYSUTIL_LANG_ITALIAN;
+    case 0x13: return CELL_SYSUTIL_LANG_DUTCH;
+    case 0x16: return sub == 1 ? CELL_SYSUTIL_LANG_PORTUGUESE_BR : CELL_SYSUTIL_LANG_PORTUGUESE_PT;
+    case 0x19: return CELL_SYSUTIL_LANG_RUSSIAN;
+    case 0x12: return CELL_SYSUTIL_LANG_KOREAN;
+    case 0x04:  /* Chinese: Taiwan, Hong Kong, Macao and zh-Hant are Traditional */
+        return (langid == 0x0404 || langid == 0x0C04 || langid == 0x1404 || langid == 0x7C04)
+            ? CELL_SYSUTIL_LANG_CHINESE_T : CELL_SYSUTIL_LANG_CHINESE_S;
+    case 0x0B: return CELL_SYSUTIL_LANG_FINNISH;
+    case 0x1D: return CELL_SYSUTIL_LANG_SWEDISH;
+    case 0x06: return CELL_SYSUTIL_LANG_DANISH;
+    case 0x14: return CELL_SYSUTIL_LANG_NORWEGIAN;
+    case 0x15: return CELL_SYSUTIL_LANG_POLISH;
+    case 0x1F: return CELL_SYSUTIL_LANG_TURKISH;
+    default:   return -1;
+    }
+}
+
+/* key is one of the '|'-separated words of list */
+static int lang_listed(const char* list, const char* key)
+{
+    const size_t n = strlen(key);
+    for (const char* p = list; p && *p; ) {
+        const char* e = strchr(p, '|');
+        const size_t len = e ? (size_t)(e - p) : strlen(p);
+        if (len == n && !strncmp(p, key, n)) return 1;
+        p = e ? e + 1 : NULL;
+    }
+    return 0;
+}
+
+s32 cellSysutil_lang_auto(unsigned langid, const char* offered)
+{
+    const s32 w = cellSysutil_lang_from_windows(langid);
+    if (w < 0 || !offered) return CELL_SYSUTIL_LANG_ENGLISH_US;
+    if (lang_listed(offered, cellSysutil_lang_key(w))) return w;
+    /* a title may offer only one of the two Portugueses, Englishes or Chineses */
+    const s32 sib = w == CELL_SYSUTIL_LANG_PORTUGUESE_BR ? CELL_SYSUTIL_LANG_PORTUGUESE_PT
+                  : w == CELL_SYSUTIL_LANG_PORTUGUESE_PT ? CELL_SYSUTIL_LANG_PORTUGUESE_BR
+                  : w == CELL_SYSUTIL_LANG_ENGLISH_GB    ? CELL_SYSUTIL_LANG_ENGLISH_US
+                  : w == CELL_SYSUTIL_LANG_ENGLISH_US    ? CELL_SYSUTIL_LANG_ENGLISH_GB
+                  : w == CELL_SYSUTIL_LANG_CHINESE_T     ? CELL_SYSUTIL_LANG_CHINESE_S
+                  : w == CELL_SYSUTIL_LANG_CHINESE_S     ? CELL_SYSUTIL_LANG_CHINESE_T : -1;
+    if (sib >= 0 && lang_listed(offered, cellSysutil_lang_key(sib))) return sib;
+    return CELL_SYSUTIL_LANG_ENGLISH_US;
+}
+
+static s32 s_sys_lang = -1;
+
+s32 cellSysutil_system_language(void)
+{
+    if (s_sys_lang >= 0) return s_sys_lang;
+    s32 lang = CELL_SYSUTIL_LANG_ENGLISH_US;
+    const opt_id id = opt_find("language");
+    const opt_def* d = id >= 0 ? opt_def_of(id) : NULL;
+    if (!d) {
+        printf("[cellSysutil] system language: english_us (the title has no language setting)\n");
+    } else {
+        char v[32] = "";
+        opt_text(id, v, sizeof v);
+        const char* where = NULL;
+        int line = 0;
+        const opt_source_kind src = opt_source(id, &where, &line);
+        char from[160];
+        if (src == OPT_SRC_ENV)       snprintf(from, sizeof from, "env %s", where ? where : "?");
+        else if (src == OPT_SRC_FILE) snprintf(from, sizeof from, "%s:%d", where ? where : "options.ini", line);
+        else                          snprintf(from, sizeof from, "default");
+        if (!strcmp(v, "auto")) {
+            unsigned wl = 0;
+#ifdef _WIN32
+            wl = GetUserDefaultUILanguage();
+#endif
+            const s32 w = cellSysutil_lang_from_windows(wl);
+            lang = cellSysutil_lang_auto(wl, d->values);
+            printf("[cellSysutil] system language: %s (language = auto (%s): Windows UI language 0x%04X = %s%s)\n",
+                   cellSysutil_lang_key(lang), from, wl, w >= 0 ? cellSysutil_lang_key(w) : "no PS3 language",
+                   w < 0 || lang == w ? "" : ", not offered by this title: the nearest it offers");
+        } else {
+            const s32 k = cellSysutil_lang_from_key(v);
+            lang = k >= 0 ? k : CELL_SYSUTIL_LANG_ENGLISH_US;
+            printf("[cellSysutil] system language: %s (language = %s, %s)\n", cellSysutil_lang_key(lang), v, from);
+        }
+    }
+    fflush(stdout);
+    s_sys_lang = lang;
+    return lang;
+}
