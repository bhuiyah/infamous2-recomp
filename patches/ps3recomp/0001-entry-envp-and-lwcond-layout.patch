+/* render_frame's side of the raster geometry (raster_record_draw). A draw's
+ * D3D viewport is the one recorded with its epilogue (rs_vp), its scissor the
+ * pixel ownership rect inside the bound target (tw x th). An empty rect is the
+ * empty scissor, which D3D12 rasterises nothing for (test_raster_warp
+ * "empty"). The depth range stays the caller's. */
+static void raster_replay_draw(const D3D12DrawRecord* dr, float tw, float th,
+                               D3D12_VIEWPORT* vp, D3D12_RECT* sc)
+{
+    vp->TopLeftX = dr->rs_vp[0]; vp->TopLeftY = dr->rs_vp[1];
+    vp->Width = dr->rs_vp[2];    vp->Height = dr->rs_vp[3];
+    const rsx_rect r = rsx_rect_and(dr->rs_own, rsx_rect_xywh(0, 0, (unsigned)tw, (unsigned)th));
+    if (rsx_rect_empty(r)) { sc->left = sc->top = sc->right = sc->bottom = 0; return; }
+    sc->left = r.x0; sc->top = r.y0; sc->right = r.x1; sc->bottom = r.y1;
+}
+/* r inside a w x h view as a D3D12 clear rect; 0 = nothing left of it. */
+static int raster_d3d_rect(rsx_rect r, u32 w, u32 h, D3D12_RECT* out)
+{
+    r = rsx_rect_and(r, rsx_rect_xywh(0, 0, w, h));
+    if (rsx_rect_empty(r)) return 0;
+    out->left = r.x0; out->top = r.y0; out->right = r.x1; out->bottom = r.y1;
+    return 1;
+}
+/* RES_SCALE: a guest rect (scissor, clear rect) on a view whose resource is
+ * hw x hh for a guest w x h -- times its integer factors (rsx_rs_scale_rect). */
+static void rs_scale_rc(D3D12_RECT* rc, u32 w, u32 hw, u32 h, u32 hh)
+{
+    const u32 kx = rs_kx_of(w, hw), ky = rs_kx_of(h, hh);
+    if (!rs_new(kx, ky)) return;
+    rsx_rect g; g.x0 = rc->left; g.y0 = rc->top; g.x1 = rc->right; g.y1 = rc->bottom;
+    const rsx_rect o = rsx_rs_scale_rect(g, kx, ky);
+    rs_verify(rsx_rect_eq(o, g), "rect");
+    rc->left = o.x0; rc->top = o.y0; rc->right = o.x1; rc->bottom = o.y1;
+}
+/* RES_SCALE: a draw's D3D viewport and scissor (computed against the guest
+ * frame, as recorded) on its bound target r: times r's integer factors. The
+ * baked VS epilogue stays valid (rsx_rs_scale_vp). */
+static void rs_scale_draw_vp(const OffRT* r, D3D12_VIEWPORT* vp, D3D12_RECT* sc)
+{
+    const u32 kx = rs_kx_of(r->w, r->hw), ky = rs_kx_of(r->h, r->hh);
+    if (!rs_new(kx, ky)) return;
+    const float in[4] = { vp->TopLeftX, vp->TopLeftY, vp->Width, vp->Height };
+    float out[4];
+    if (!rsx_rs_scale_vp(in, kx, ky, out)) { static int n = 0; if (n++ < 4)
+        fprintf(stderr, "[RSCALE] viewport (%g, %g) %gx%g x%u/%u leaves D3D12's viewport range%c",
+                (double)in[0], (double)in[1], (double)in[2], (double)in[3], kx, ky, 10); }
+    rs_verify(!memcmp(in, out, sizeof in), "draw viewport");
+    vp->TopLeftX = out[0]; vp->TopLeftY = out[1]; vp->Width = out[2]; vp->Height = out[3];
+    rs_scale_rc(sc, r->w, r->hw, r->h, r->hh);
+}
+/* A clear whose rect (raster_record_clear) leaves part of a view it writes:
+ * cleared here, with that rect, and 1 is returned. 0: the rect covers every
+ * view it writes, and render_frame's whole-view clear runs (the old path,
+ * unchanged). An empty rect clears nothing. A partial colour mask is skipped
+ * and reported, as on the whole-view path. */
+static int raster_replay_clear(u32 d, const D3D12DrawRecord* dr, int cur_rt, const int cur_m[3],
+                               int cur_z, int dmodel, D3D12_CPU_DESCRIPTOR_HANDLE bb_rtv)
+{
+    const int zs  = dmodel && (dr->clr_mask & 3u) && cur_z >= 0;
+    const int col = (dr->clr_mask & 0xF0u) != 0;
+    const u32 tw = cur_rt >= 0 ? s_d3d.off_rt[cur_rt].w : s_d3d.width;
+    const u32 th = cur_rt >= 0 ? s_d3d.off_rt[cur_rt].h : s_d3d.height;
+    int partial = zs && !rsx_rect_covers(dr->rs_own, s_zeta[cur_z].w, s_zeta[cur_z].h);
+    if (col && !rsx_rect_covers(dr->rs_own, tw, th)) partial = 1;
+    for (int m = 0; m < 3 && col; m++)
+        if (cur_m[m] >= 0 && !rsx_rect_covers(dr->rs_own, s_d3d.off_rt[cur_m[m]].w, s_d3d.off_rt[cur_m[m]].h))
+            partial = 1;
+    if (!partial) return 0;
+    D3D12_RECT rc;
+    if (zs && raster_d3d_rect(dr->rs_own, s_zeta[cur_z].w, s_zeta[cur_z].h, &rc)) {
+        /* RES_SCALE: the op's factor -- its colour target's (a 1x op may bind a
+         * scaled zeta: New Marais draws a 256x256 view into 0x11C0000 against
+         * zeta 0x10000, cleared first); 1 for a backbuffer op (cur_rt < 0, also
+         * a display alias without a surface): its draws run a 1x viewport on
+         * the zeta's top-left region (rs_scale_draw_vp needs cur_rt >= 0). */
+        if (cur_rt >= 0)
+            rs_scale_rc(&rc, s_d3d.off_rt[cur_rt].w, s_d3d.off_rt[cur_rt].hw, s_d3d.off_rt[cur_rt].h,
+                        s_d3d.off_rt[cur_rt].hh);
+        s_d3d.cmd_list->lpVtbl->ClearDepthStencilView(s_d3d.cmd_list, zeta_dsv(cur_z),
+            (D3D12_CLEAR_FLAGS)(((dr->clr_mask & 1u) ? D3D12_CLEAR_FLAG_DEPTH : 0) |
+                                ((dr->clr_mask & 2u) ? D3D12_CLEAR_FLAG_STENCIL : 0)),
+            dr->clr_depth, (UINT8)dr->clr_stencil, 1, &rc);
+        zeta_mark_dirty(&s_zeta[cur_z]);
+    }
+    if (!col) return 1;
+    if ((dr->clr_mask & 0xF0u) != 0xF0u) {
+        static int pn = 0;
+        if (pn++ < 8)
+            fprintf(stderr, "[CLEAR] partial colour mask 0x%X on 0x%X (op %u, rect [%d,%d)x[%d,%d)): skipped\n",
+                    dr->clr_mask, dr->rt_off, d, dr->rs_own.x0, dr->rs_own.x1, dr->rs_own.y0, dr->rs_own.y1);
+        return 1;
+    }
+    if (raster_d3d_rect(dr->rs_own, tw, th, &rc)) {
+        if (cur_rt >= 0) rs_scale_rc(&rc, tw, s_d3d.off_rt[cur_rt].hw, th, s_d3d.off_rt[cur_rt].hh);   /* RES_SCALE */
+        s_d3d.cmd_list->lpVtbl->ClearRenderTargetView(s_d3d.cmd_list,
+            cur_rt >= 0 ? off_rt_rtv(cur_rt) : bb_rtv, dr->cc, 1, &rc);
+    }
+    for (int m = 0; m < 3; m++)
+        if (cur_m[m] >= 0 &&
+            raster_d3d_rect(dr->rs_own, s_d3d.off_rt[cur_m[m]].w, s_d3d.off_rt[cur_m[m]].h, &rc)) {
+            const OffRT* q = &s_d3d.off_rt[cur_m[m]];
+            rs_scale_rc(&rc, q->w, q->hw, q->h, q->hh);   /* RES_SCALE */
+            s_d3d.cmd_list->lpVtbl->ClearRenderTargetView(s_d3d.cmd_list, off_rt_rtv(cur_m[m]), dr->cc, 1, &rc);
+        }
+    return 1;
+}
+/* A display colour clear that is not an op (it seeds the next frame-start
+ * clear of the whole backbuffer): its rect is not applied -- said once per
+ * distinct rect (d3d12_clear). */
+static void raster_note_display_clear(u32 flags)
+{
+    const RasterCfg* c = raster_cfg();
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!c->clear || !c->log || !st || !(flags & 0xF0u)) return;
+    if (current_rt_off(NULL, NULL, NULL) != 0 || rd_has(s_cur_disp_raw)) return;
+    rsx_raster_regs g;
+    raster_regs(st, &g);
+    const rsx_rect r = rsx_raster_clear_own(&g);
+    if (rsx_rect_covers(r, s_d3d.width, s_d3d.height)) return;
+    static u32 seen[8];
+    static int ns = 0;
+    const u32 h = raster_hash(&r, sizeof r, 2166136261u);
+    for (int i = 0; i < ns; i++) if (seen[i] == h) return;
+    if (ns >= 8) return;
+    seen[ns++] = h;
+    fprintf(stderr, "[RASTER] display colour clear 0x%X with rect [%d,%d)x[%d,%d): the frame-start clear covers "
+                    "the whole backbuffer (rect NOT applied)\n", flags, r.x0, r.x1, r.y0, r.y1);
+}
+
+/* ---- RES_SCALE / RSX_RES_DRYRUN: render_frame's side --------------------------
+ * The census (logging only) is fed after the texture prepass, when every READ
+ * unit's source is known (RS_UK marks where the prepass bound it). */
+static u8  s_rs_uk[MAX_DRAWS][RSX_DRAW_TEX_UNITS];
+static int s_rs_census = -1;      /* rsx_rcz_on(), cached at init */
+#define RS_UK(d, u, k) do { if (s_rs_census > 0) s_rs_uk[(d)][(u)] = (u8)(k); } while (0)
+static void rs_census_batch(void)
