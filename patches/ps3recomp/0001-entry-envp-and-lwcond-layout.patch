new file mode 100644
index 0000000..eb502f8
--- /dev/null
+++ b/libs/input/pad_kbm.h
@@ -0,0 +1,921 @@
+/*
+ * ps3recomp - keyboard + mouse -> DUALSHOCK 3 mapping (header-only)
+ *
+ * The OS-free half of cellPad.c's keyboard/mouse input: the key-name table,
+ * the input.ini / PAD_KBM parser, the mouse-motion -> right-stick filter and
+ * the per-report evaluation that turns held keys and mouse motion into one pad
+ * report (16 digital buttons + two sticks). cellPad.c supplies the host side
+ * (GetAsyncKeyState, raw mouse deltas from WM_INPUT, mouse capture), so all of
+ * this is testable anywhere:
+ *
+ *   cc -I libs/input -o /tmp/t libs/input/tests/test_pad_kbm.c -lm && /tmp/t
+ *
+ * Key codes are Windows virtual-key codes (0x01..0xFE; the mouse buttons are
+ * VK 0x01/0x02/0x04/0x05/0x06) plus two pseudo keys for the mouse wheel, whose
+ * notches become timed presses (see KbmPulse).
+ *
+ * Mouse camera model. The game turns its camera at a rate proportional to the
+ * right stick's deflection, so mouse SPEED maps to deflection:
+ *
+ *   deflection = sensitivity * (counts per second) / KBM_FULL_SPEED
+ *
+ * The speed is measured over a sliding window (mouse_smoothing_ms) of the
+ * pad's own reports: mouse reports arrive in bursts (the window thread pumps
+ * WM_INPUT between frames) and the game samples the stick once per frame, so
+ * an unfiltered per-report speed would flicker between zero and a spike. A box
+ * window rather than an exponential one is deliberate: the stick returns to
+ * centre exactly one window after the mouse stops instead of coasting on a
+ * tail. Every count contributes for one window, so the camera turns by an
+ * amount proportional to the distance the mouse moved (until the stick
+ * saturates).
+ *
+ * The game has its own stick deadzone, inside which a slow mouse would do
+ * nothing; mouse_anti_deadzone lifts any non-zero deflection to at least that
+ * value (magnitude, direction kept), so small motions still register. The
+ * vector is clamped to the unit circle (a real stick's gate).
+ *
+ * With a controller on port 0 too, kbm_arbitrate decides per stick which of
+ * the two drives it: the device used last, with a margin for the mouse (see
+ * there), so a mouse resting or jittering next to a controller player never
+ * nudges the camera.
+ */
+#ifndef PS3RECOMP_PAD_KBM_H
+#define PS3RECOMP_PAD_KBM_H
+
+#include <ctype.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ---------------------------------------------------------------------------
+ * Targets: what a key can drive. 0..15 are the CELL_PAD_CTRL_* bit numbers
+ * (SELECT = bit 0 ... SQUARE = bit 15), so the button mask is 1u << target.
+ * -----------------------------------------------------------------------*/
+enum {
+    KBM_SELECT = 0, KBM_L3, KBM_R3, KBM_START,
+    KBM_UP, KBM_RIGHT, KBM_DOWN, KBM_LEFT,
+    KBM_L2, KBM_R2, KBM_L1, KBM_R1,
+    KBM_TRIANGLE, KBM_CIRCLE, KBM_CROSS, KBM_SQUARE,
+    KBM_LS_UP, KBM_LS_DOWN, KBM_LS_LEFT, KBM_LS_RIGHT,
+    KBM_RS_UP, KBM_RS_DOWN, KBM_RS_LEFT, KBM_RS_RIGHT,
+    KBM_WALK,                       /* modifier: scales the keyboard left stick */
+    KBM_NUM_TARGETS
+};
+
+#define KBM_MAX_BIND        4       /* keys per target */
+#define KBM_KEY_WHEEL_UP    0x101   /* pseudo keys: one timed press per notch */
+#define KBM_KEY_WHEEL_DOWN  0x102
+#define KBM_WHEEL_DELTA     120     /* WHEEL_DELTA: one notch */
+#define KBM_FULL_SPEED      1500.0  /* counts/s for full deflection at sensitivity 1 */
+#define KBM_HIST            128     /* mouse filter history (pad reports; >= 512 ms at the 4 ms poll) */
+
+enum { KBM_CAPTURE_OFF = 0, KBM_CAPTURE_CLICK = 1, KBM_CAPTURE_FOCUS = 2 };
+
+typedef struct {
+    uint16_t keys[KBM_NUM_TARGETS][KBM_MAX_BIND];
+    uint8_t  nkeys[KBM_NUM_TARGETS];
+    float    mouse_sens;       /* 1.0 = full deflection at KBM_FULL_SPEED counts/s */
+    float    mouse_sens_y;     /* multiplier on the vertical axis */
+    int      invert_y;
+    float    smoothing_ms;     /* speed-measuring window */
+    float    anti_deadzone;    /* least deflection a moving mouse produces */
+    float    curve;            /* exponent on the deflection; 1 = linear */
+    int      capture;          /* KBM_CAPTURE_* */
+    float    walk_scale;       /* left-stick deflection while Walk is held */
+    float    wheel_pulse_ms;   /* press length per wheel notch */
+    int      merge;            /* also drive port 0 while a controller is on it */
+    int      last_device_wins; /* merged: each stick follows the device used last (kbm_arbitrate) */
+    float    mouse_takeover;   /* mouse travel (counts at sensitivity 1) that takes the camera from a controller */
+    int      keyboard, mouse;  /* master switches */
+} KbmConfig;
+
+/* ---------------------------------------------------------------------------
+ * Name tables
+ * -----------------------------------------------------------------------*/
+
+typedef struct { const char* name; int id; } KbmName;
+
+/* First entry per target is the canonical (printed) name. */
+static const KbmName kbm_target_names[] = {
+    {"Cross", KBM_CROSS}, {"Circle", KBM_CIRCLE}, {"Square", KBM_SQUARE},
+    {"Triangle", KBM_TRIANGLE}, {"L1", KBM_L1}, {"R1", KBM_R1}, {"L2", KBM_L2},
+    {"R2", KBM_R2}, {"L3", KBM_L3}, {"R3", KBM_R3}, {"Start", KBM_START},
+    {"Select", KBM_SELECT}, {"DpadUp", KBM_UP}, {"DpadDown", KBM_DOWN},
+    {"DpadLeft", KBM_LEFT}, {"DpadRight", KBM_RIGHT},
+    {"LStickUp", KBM_LS_UP}, {"LStickDown", KBM_LS_DOWN},
+    {"LStickLeft", KBM_LS_LEFT}, {"LStickRight", KBM_LS_RIGHT},
+    {"RStickUp", KBM_RS_UP}, {"RStickDown", KBM_RS_DOWN},
+    {"RStickLeft", KBM_RS_LEFT}, {"RStickRight", KBM_RS_RIGHT},
+    {"Walk", KBM_WALK},
+    /* aliases */
+    {"Up", KBM_UP}, {"Down", KBM_DOWN}, {"Left", KBM_LEFT}, {"Right", KBM_RIGHT},
+    {"LeftStickUp", KBM_LS_UP}, {"LeftStickDown", KBM_LS_DOWN},
+    {"LeftStickLeft", KBM_LS_LEFT}, {"LeftStickRight", KBM_LS_RIGHT},
+    {"RightStickUp", KBM_RS_UP}, {"RightStickDown", KBM_RS_DOWN},
+    {"RightStickLeft", KBM_RS_LEFT}, {"RightStickRight", KBM_RS_RIGHT},
+    {"MoveForward", KBM_LS_UP}, {"MoveBack", KBM_LS_DOWN},
+    {"MoveLeft", KBM_LS_LEFT}, {"MoveRight", KBM_LS_RIGHT},
+    {"LookUp", KBM_RS_UP}, {"LookDown", KBM_RS_DOWN},
+    {"LookLeft", KBM_RS_LEFT}, {"LookRight", KBM_RS_RIGHT},
+};
+
+/* Keys whose names are not a single letter/digit, F1..F24 or Num0..Num9.
+ * First entry per code is the canonical (printed) name. */
+static const KbmName kbm_key_names[] = {
+    {"Space", 0x20}, {"Enter", 0x0D}, {"Esc", 0x1B}, {"Tab", 0x09},
+    {"Backspace", 0x08}, {"CapsLock", 0x14},
+    {"Shift", 0x10}, {"LShift", 0xA0}, {"RShift", 0xA1},
+    {"Ctrl", 0x11}, {"LCtrl", 0xA2}, {"RCtrl", 0xA3},
+    {"Alt", 0x12}, {"LAlt", 0xA4}, {"RAlt", 0xA5},
+    {"Up", 0x26}, {"Down", 0x28}, {"Left", 0x25}, {"Right", 0x27},
+    {"Insert", 0x2D}, {"Delete", 0x2E}, {"Home", 0x24}, {"End", 0x23},
+    {"PageUp", 0x21}, {"PageDown", 0x22}, {"Pause", 0x13},
+    {"ScrollLock", 0x91}, {"NumLock", 0x90}, {"Apps", 0x5D},
+    {"NumMul", 0x6A}, {"NumAdd", 0x6B}, {"NumSub", 0x6D},
+    {"NumDecimal", 0x6E}, {"NumDiv", 0x6F},
+    {"Semicolon", 0xBA}, {"Equals", 0xBB}, {"Comma", 0xBC}, {"Minus", 0xBD},
+    {"Period", 0xBE}, {"Slash", 0xBF}, {"Grave", 0xC0}, {"LBracket", 0xDB},
+    {"Backslash", 0xDC}, {"RBracket", 0xDD}, {"Apostrophe", 0xDE},
+    {"LMB", 0x01}, {"RMB", 0x02}, {"MMB", 0x04}, {"Mouse4", 0x05},
+    {"Mouse5", 0x06},
+    {"WheelUp", KBM_KEY_WHEEL_UP}, {"WheelDown", KBM_KEY_WHEEL_DOWN},
+    /* aliases */
+    {"Return", 0x0D}, {"Escape", 0x1B}, {"Back", 0x08}, {"Caps", 0x14},
+    {"Control", 0x11}, {"LControl", 0xA2}, {"RControl", 0xA3},
+    {"LeftShift", 0xA0}, {"RightShift", 0xA1}, {"LeftCtrl", 0xA2},
+    {"RightCtrl", 0xA3}, {"LeftControl", 0xA2}, {"RightControl", 0xA3},
+    {"LeftAlt", 0xA4}, {"RightAlt", 0xA5},
+    {"ArrowUp", 0x26}, {"ArrowDown", 0x28}, {"ArrowLeft", 0x25},
+    {"ArrowRight", 0x27}, {"UpArrow", 0x26}, {"DownArrow", 0x28},
+    {"LeftArrow", 0x25}, {"RightArrow", 0x27},
+    {"Ins", 0x2D}, {"Del", 0x2E}, {"PgUp", 0x21}, {"PgDn", 0x22},
+    {"NumMultiply", 0x6A}, {"NumStar", 0x6A}, {"NumPlus", 0x6B},
+    {"NumMinus", 0x6D}, {"NumDot", 0x6E}, {"NumPeriod", 0x6E},
+    {"NumDivide", 0x6F}, {"NumSlash", 0x6F},
+    {"Equal", 0xBB}, {"Plus", 0xBB}, {"Dot", 0xBE}, {"Tilde", 0xC0},
+    {"Backquote", 0xC0}, {"Backtick", 0xC0}, {"Quote", 0xDE},
+    {"OpenBracket", 0xDB}, {"CloseBracket", 0xDD},
+    {"Mouse1", 0x01}, {"MouseLeft", 0x01}, {"LeftMouse", 0x01},
+    {"Mouse2", 0x02}, {"MouseRight", 0x02}, {"RightMouse", 0x02},
+    {"Mouse3", 0x04}, {"MouseMiddle", 0x04}, {"MiddleMouse", 0x04},
+    {"XButton1", 0x05}, {"MouseBack", 0x05},
+    {"XButton2", 0x06}, {"MouseForward", 0x06},
+    {"MouseWheelUp", KBM_KEY_WHEEL_UP}, {"MouseWheelDown", KBM_KEY_WHEEL_DOWN},
+};
+
+#define KBM_COUNT(a) ((int)(sizeof(a) / sizeof((a)[0])))
+
+/* Compare ignoring case, spaces, '_' and '-' ("mouse_sensitivity" ==
+ * "MouseSensitivity", "Page Up" == "PageUp"). */
+static inline void kbm_norm(const char* s, char* out, size_t n)
+{
+    size_t k = 0;
+    for (; *s && k + 1 < n; s++) {
+        if (*s == ' ' || *s == '\t' || *s == '_' || *s == '-') continue;
+        out[k++] = (char)tolower((unsigned char)*s);
+    }
+    out[k] = 0;
+}
+
+static inline int kbm_lookup(const KbmName* t, int n, const char* name)
+{
+    char a[64], b[64];
+    kbm_norm(name, a, sizeof a);
+    if (!a[0]) return -1;
+    for (int i = 0; i < n; i++) {
+        kbm_norm(t[i].name, b, sizeof b);
+        if (!strcmp(a, b)) return t[i].id;
+    }
+    return -1;
+}
+
+static inline int kbm_target_from_name(const char* name)
+{
+    return kbm_lookup(kbm_target_names, KBM_COUNT(kbm_target_names), name);
+}
+
+static inline const char* kbm_target_name(int t)
+{
+    for (int i = 0; i < KBM_COUNT(kbm_target_names); i++)
+        if (kbm_target_names[i].id == t) return kbm_target_names[i].name;
+    return "?";
+}
+
+/* Key code for a name, or -1. Accepts the table names, single letters and
+ * digits, F1..F24, Num0..Num9 / Numpad0..Numpad9, the punctuation characters
+ * other than the list/comment separators ',', ';' and '#' (spell those
+ * "Comma"/"Semicolon"), and a raw virtual-key code as 0xNN. */
+static inline int kbm_key_from_name(const char* name)
+{
+    if (!name || !*name) return -1;
+    if (name[1] == 0) {
+        unsigned char c = (unsigned char)name[0];
+        if (isalpha(c)) return toupper(c);
+        if (isdigit(c)) return c;
+        switch (c) {
+        case '=': return 0xBB;  case '-': return 0xBD;  case '.': return 0xBE;
+        case '/': return 0xBF;  case '`': return 0xC0;  case '[': return 0xDB;
+        case '\\': return 0xDC; case ']': return 0xDD;  case '\'': return 0xDE;
+        default: return -1;
+        }
+    }
+    if (name[0] == '0' && (name[1] == 'x' || name[1] == 'X')) {
+        char* end;
+        unsigned long v = strtoul(name, &end, 16);
+        if (*end || v < 1 || v > 0xFE) return -1;
+        return (int)v;
+    }
+    char n[64];
+    kbm_norm(name, n, sizeof n);
+    if (n[0] == 'f' && isdigit((unsigned char)n[1])) {
+        char* end;
+        long v = strtol(n + 1, &end, 10);
+        if (!*end && v >= 1 && v <= 24) return 0x6F + (int)v;      /* VK_F1 = 0x70 */
+    }
+    {
+        const char* d = NULL;
+        if (!strncmp(n, "numpad", 6)) d = n + 6;
+        else if (!strncmp(n, "num", 3)) d = n + 3;
+        if (d && isdigit((unsigned char)d[0]) && d[1] == 0) return 0x60 + (d[0] - '0');
+    }
+    return kbm_lookup(kbm_key_names, KBM_COUNT(kbm_key_names), name);
+}
+
+/* Printable name of a key code into buf. */
+static inline const char* kbm_key_name(int code, char* buf, size_t n)
+{
+    if ((code >= 'A' && code <= 'Z') || (code >= '0' && code <= '9')) {
+        snprintf(buf, n, "%c", code);
+        return buf;
+    }
+    if (code >= 0x70 && code <= 0x87) { snprintf(buf, n, "F%d", code - 0x6F); return buf; }
+    if (code >= 0x60 && code <= 0x69) { snprintf(buf, n, "Num%d", code - 0x60); return buf; }
+    for (int i = 0; i < KBM_COUNT(kbm_key_names); i++)
+        if (kbm_key_names[i].id == code) { snprintf(buf, n, "%s", kbm_key_names[i].name); return buf; }
+    snprintf(buf, n, "0x%02X", (unsigned)code);
+    return buf;
+}
+
+static inline int kbm_is_mouse_key(int code)
+{
+    return code == 0x01 || code == 0x02 || code == 0x04 || code == 0x05 || code == 0x06 ||
+           code == KBM_KEY_WHEEL_UP || code == KBM_KEY_WHEEL_DOWN;
+}
+
+/* ---------------------------------------------------------------------------
+ * Defaults (inFamous 2's DUALSHOCK 3 layout, laid onto a PC keyboard + mouse)
+ * -----------------------------------------------------------------------*/
+
+static inline char* kbm_trim(char* s)
+{
+    while (*s == ' ' || *s == '\t' || *s == '\r' || *s == '\n') s++;
+    char* e = s + strlen(s);
+    while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n')) e--;
+    *e = 0;
+    return s;
+}
+
+/* Next comma-separated token of *p (modified in place), trimmed; NULL at end. */
+static inline char* kbm_next_token(char** p)
+{
+    if (!*p) return NULL;
+    char* s = *p;
+    char* comma = strchr(s, ',');
+    if (comma) { *comma = 0; *p = comma + 1; }
+    else       *p = NULL;
+    return kbm_trim(s);
+}
+
+static inline void kbm_bind(KbmConfig* c, int t, const char* keys)
+{
+    /* keys: comma-separated names, all known (defaults only) */
+    char buf[128];
+    char* p = buf;
+    c->nkeys[t] = 0;
+    snprintf(buf, sizeof buf, "%s", keys);
+    for (char* tok; (tok = kbm_next_token(&p)) != NULL && c->nkeys[t] < KBM_MAX_BIND; ) {
+        int k = kbm_key_from_name(tok);
+        if (k > 0) c->keys[t][c->nkeys[t]++] = (uint16_t)k;
+    }
+}
+
+static inline void kbm_config_defaults(KbmConfig* c)
+{
+    memset(c, 0, sizeof *c);
+    kbm_bind(c, KBM_CROSS,    "Space, Enter");      /* jump / climb; menu confirm */
+    kbm_bind(c, KBM_SQUARE,   "F");                 /* melee */
+    kbm_bind(c, KBM_TRIANGLE, "E");                 /* interact / finisher / look */
+    kbm_bind(c, KBM_CIRCLE,   "C, Backspace");      /* drop / cover / dive roll; menu back */
+    kbm_bind(c, KBM_L1,       "RMB");               /* aim mode (hold) */
+    kbm_bind(c, KBM_R1,       "LMB");               /* lock-on; bolt while aiming */
+    kbm_bind(c, KBM_L2,       "Q, Mouse4");         /* electric drain */
+    kbm_bind(c, KBM_R2,       "R, Mouse5");         /* kinetic pulse */
+    kbm_bind(c, KBM_L3,       "LShift");
+    kbm_bind(c, KBM_R3,       "MMB, G");
+    kbm_bind(c, KBM_START,    "Esc, P");            /* pause menu */
+    kbm_bind(c, KBM_SELECT,   "Tab, M");            /* map */
+    kbm_bind(c, KBM_UP,       "Up, 1, WheelUp");
+    kbm_bind(c, KBM_RIGHT,    "Right, 2");
+    kbm_bind(c, KBM_DOWN,     "Down, 3, WheelDown");
+    kbm_bind(c, KBM_LEFT,     "Left, 4");
+    kbm_bind(c, KBM_LS_UP,    "W");
+    kbm_bind(c, KBM_LS_DOWN,  "S");
+    kbm_bind(c, KBM_LS_LEFT,  "A");
+    kbm_bind(c, KBM_LS_RIGHT, "D");
+    kbm_bind(c, KBM_RS_UP,    "I, Num8");
+    kbm_bind(c, KBM_RS_DOWN,  "K, Num2");
+    kbm_bind(c, KBM_RS_LEFT,  "J, Num4");
+    kbm_bind(c, KBM_RS_RIGHT, "L, Num6");
+    kbm_bind(c, KBM_WALK,     "LCtrl");
+    c->mouse_sens     = 1.0f;
+    c->mouse_sens_y   = 1.0f;
+    c->invert_y       = 0;
+    c->smoothing_ms   = 50.0f;
+    c->anti_deadzone  = 0.20f;
+    c->curve          = 1.0f;
+    c->capture        = KBM_CAPTURE_CLICK;
+    c->walk_scale     = 0.5f;
+    c->wheel_pulse_ms = 100.0f;
+    c->merge          = 1;
+    c->last_device_wins = 1;
+    c->mouse_takeover = 40.0f;
+    c->keyboard       = 1;
+    c->mouse          = 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Parser
+ *
+ *   # comment            ; comment            [section]   (sections ignored)
+ *   Cross    = Space, Enter        a target: replaces its keys (max 4)
+ *   Square   = none                unbinds
+ *   mouse_sensitivity = 1.5        a setting
+ *
+ * Text after '#' or ';' is a comment. Names ignore case, spaces, '_' and '-'.
+ * -----------------------------------------------------------------------*/
+
+static inline int kbm_parse_bool(const char* v, int* out)
+{
+    char n[16];
+    kbm_norm(v, n, sizeof n);
+    if (!strcmp(n, "1") || !strcmp(n, "true") || !strcmp(n, "yes") || !strcmp(n, "on"))   { *out = 1; return 1; }
+    if (!strcmp(n, "0") || !strcmp(n, "false") || !strcmp(n, "no") || !strcmp(n, "off")) { *out = 0; return 1; }
+    return 0;
+}
+
+static inline int kbm_parse_float(const char* v, float lo, float hi, float* out)
+{
+    char* end;
+    double d = strtod(v, &end);
+    if (end == v) return 0;
+    while (*end == ' ' || *end == '\t') end++;
+    if (*end || d != d || d < lo || d > hi) return 0;
+    *out = (float)d;
+    return 1;
+}
+
+/* Returns 1 = applied, 0 = blank/comment/section, -1 = error (message in err). */
+static inline int kbm_parse_line(KbmConfig* c, const char* line, char* err, size_t errn)
+{
+    char buf[512];
+    snprintf(buf, sizeof buf, "%s", line);
+    for (char* p = buf; *p; p++)
+        if (*p == '#' || *p == ';') { *p = 0; break; }
+    char* s = kbm_trim(buf);
+    if (!*s || *s == '[') return 0;
+    char* eq = strchr(s, '=');
+    if (!eq) { snprintf(err, errn, "expected 'name = value': \"%s\"", s); return -1; }
+    *eq = 0;
+    char* name = kbm_trim(s);
+    char* val  = kbm_trim(eq + 1);
+
+    int t = kbm_target_from_name(name);
+    if (t >= 0) {
+        uint16_t keys[KBM_MAX_BIND];
+        int n = 0;
+        char low[16];
+        kbm_norm(val, low, sizeof low);
+        if (*val && strcmp(low, "none")) {
+            char* p = val;
+            for (char* tok; (tok = kbm_next_token(&p)) != NULL; ) {
+                if (!*tok) continue;
+                int k = kbm_key_from_name(tok);
+                if (k < 0) { snprintf(err, errn, "%s: unknown key \"%s\"", name, tok); return -1; }
+                int dup = 0;
+                for (int i = 0; i < n; i++) dup |= (keys[i] == k);
+                if (dup) continue;
+                if (n == KBM_MAX_BIND) { snprintf(err, errn, "%s: more than %d keys", name, KBM_MAX_BIND); return -1; }
+                keys[n++] = (uint16_t)k;
+            }
+        }
+        memcpy(c->keys[t], keys, sizeof(uint16_t) * (size_t)n);
+        c->nkeys[t] = (uint8_t)n;
+        return 1;
+    }
+
+    char k[64];
+    kbm_norm(name, k, sizeof k);
+#define KBM_IS(a) (!strcmp(k, a))
+    int ok = 0;
+    if (KBM_IS("mousesensitivity") || KBM_IS("sensitivity"))
+        ok = kbm_parse_float(val, 0.001f, 100.0f, &c->mouse_sens);
+    else if (KBM_IS("mousesensitivityy") || KBM_IS("sensitivityy"))
+        ok = kbm_parse_float(val, 0.001f, 100.0f, &c->mouse_sens_y);
+    else if (KBM_IS("mouseinverty") || KBM_IS("inverty"))
+        ok = kbm_parse_bool(val, &c->invert_y);
+    else if (KBM_IS("mousesmoothingms") || KBM_IS("mousesmoothing") || KBM_IS("smoothingms") || KBM_IS("smoothing"))
+        ok = kbm_parse_float(val, 0.0f, 500.0f, &c->smoothing_ms);
+    else if (KBM_IS("mouseantideadzone") || KBM_IS("antideadzone"))
+        ok = kbm_parse_float(val, 0.0f, 0.95f, &c->anti_deadzone);
+    else if (KBM_IS("mousecurve") || KBM_IS("curve"))
+        ok = kbm_parse_float(val, 0.1f, 10.0f, &c->curve);
+    else if (KBM_IS("mousecapture") || KBM_IS("capture")) {
+        char v[16];
+        kbm_norm(val, v, sizeof v);
+        if (!strcmp(v, "click"))      { c->capture = KBM_CAPTURE_CLICK; ok = 1; }
+        else if (!strcmp(v, "focus")) { c->capture = KBM_CAPTURE_FOCUS; ok = 1; }
+        else if (!strcmp(v, "off") || !strcmp(v, "0") || !strcmp(v, "none")) { c->capture = KBM_CAPTURE_OFF; ok = 1; }
+    }
+    else if (KBM_IS("walkscale"))
+        ok = kbm_parse_float(val, 0.05f, 1.0f, &c->walk_scale);
+    else if (KBM_IS("wheelpulsems") || KBM_IS("wheelpulse"))
+        ok = kbm_parse_float(val, 10.0f, 2000.0f, &c->wheel_pulse_ms);
+    else if (KBM_IS("mergewithcontroller") || KBM_IS("merge"))
+        ok = kbm_parse_bool(val, &c->merge);
+    else if (KBM_IS("lastdevicewins") || KBM_IS("lastactivedevicewins"))
+        ok = kbm_parse_bool(val, &c->last_device_wins);
+    else if (KBM_IS("mousetakeover") || KBM_IS("mousetakeovercounts"))
+        ok = kbm_parse_float(val, 0.0f, 100000.0f, &c->mouse_takeover);
+    else if (KBM_IS("keyboard"))
+        ok = kbm_parse_bool(val, &c->keyboard);
+    else if (KBM_IS("mouse"))
+        ok = kbm_parse_bool(val, &c->mouse);
+    else {
+        snprintf(err, errn, "unknown name \"%s\"", name);
+        return -1;
+    }
+#undef KBM_IS
+    if (!ok) { snprintf(err, errn, "%s: bad value \"%s\"", name, val); return -1; }
+    return 1;
+}
+
+/* Turn a config file's raw bytes (buf[0..n), with buf[n] writable) into text
+ * kbm_parse_text can read, in place; returns its start. A UTF-8 byte order
+ * mark is skipped (Notepad and VS Code can write one, and it would glue onto
+ * the first line's name), and UTF-16 with a BOM -- what Windows PowerShell 5's
+ * '>' and Out-File write -- is folded to 8-bit text (non-ASCII becomes '?'),
+ * where it would otherwise end at its first zero byte. */
+static inline char* kbm_text_prepare(char* buf, size_t n)
+{
+    const unsigned char* u = (const unsigned char*)buf;
+    buf[n] = 0;
+    if (n >= 3 && u[0] == 0xEF && u[1] == 0xBB && u[2] == 0xBF) return buf + 3;
+    if (n >= 2 && ((u[0] == 0xFF && u[1] == 0xFE) || (u[0] == 0xFE && u[1] == 0xFF))) {
+        int le = u[0] == 0xFF;
+        size_t o = 0;
+        for (size_t i = 2; i + 1 < n; i += 2) {
+            unsigned ch = le ? (unsigned)(u[i] | (u[i + 1] << 8)) : (unsigned)((u[i] << 8) | u[i + 1]);
+            if (!ch) break;
+            buf[o++] = (char)(ch < 0x80 ? ch : '?');   /* o < i: never overtakes the read */
+        }
+        buf[o] = 0;
+    }
+    return buf;
+}
+
+typedef void (*kbm_warn_fn)(const void* ctx, const char* msg);
+
+/* Parse a whole file (lines) or an override string (env_style: lines may
+ * also be separated by ';' or '|', e.g. PAD_KBM="mouse_sensitivity=2|Cross=J").
+ * A bad line is reported and skipped; returns the number of bad lines.
+ * [controller(s)] / [gamepad(s)] sections, and names starting with
+ * "controller" or "gamepad" anywhere, belong to the physical controllers
+ * (pad_host.h's padhost_config_parse_text reads the same file): skipped.
+ * So do a [hotkeys] section and names starting with "hotkey" anywhere: the
+ * window hotkeys (pad_hotkeys.h's hk_parse_text reads them). */
+static inline int kbm_parse_text(KbmConfig* c, const char* text, int env_style,
+                                 kbm_warn_fn warn, const void* ctx)
+{
+    int errors = 0, lineno = 0, host_section = 0;
+    const char* p = text;
+    while (p && *p) {
+        const char* e = p;
+        while (*e && *e != '\n' && !(env_style && (*e == ';' || *e == '|'))) e++;
+        char line[512];
+        size_t n = (size_t)(e - p);
+        if (n >= sizeof line) n = sizeof line - 1;
+        memcpy(line, p, n);
+        line[n] = 0;
+        lineno++;
+        {
+            char nm[16];
+            const char* s = line;
+            while (*s == ' ' || *s == '\t') s++;
+            kbm_norm(*s == '[' ? s + 1 : s, nm, sizeof nm);
+            int host = !strncmp(nm, "controller", 10) || !strncmp(nm, "gamepad", 7) ||
+                       !strncmp(nm, "hotkey", 6);     /* not ours: controllers, window hotkeys */
+            if (*s == '[') host_section = host;
+            if (*s == '[' || host || host_section) { p = *e ? e + 1 : e; continue; }
+        }
+        char err[200];
+        if (kbm_parse_line(c, line, err, sizeof err) < 0) {
+            errors++;
+            if (warn) {
+                char msg[260];
+                if (env_style) snprintf(msg, sizeof msg, "item %d: %s", lineno, err);
+                else           snprintf(msg, sizeof msg, "line %d: %s", lineno, err);
+                warn(ctx, msg);
+            }
+        }
+        p = *e ? e + 1 : e;
+    }
+    return errors;
+}
+
+/* ---------------------------------------------------------------------------
+ * Runtime: mouse filter, wheel pulses, evaluation
+ * -----------------------------------------------------------------------*/
+
+typedef struct { double t0, t1; float dx, dy; } KbmMouseSample;
+
+typedef struct {
+    KbmMouseSample s[KBM_HIST];
+    int    head, count;
+    double t_last;              /* time of the previous step */
+    int    primed;              /* t_last is valid */
+} KbmMouseFilter;
+
+/* A wheel notch is a press of wheel_pulse_ms followed by a release gap, so a
+ * game that samples once per frame sees each one as a distinct press. */
+typedef struct { int pending; int phase; double until; } KbmPulse;   /* phase 0 idle, 1 down, 2 gap */
+
+typedef struct {
+    KbmMouseFilter mouse;
+    KbmPulse       wheel_up, wheel_down;
+    int            wheel_acc;
+} KbmRuntime;
+
+typedef int (*kbm_key_fn)(void* ctx, int code);   /* 1 = key is held */
+
+typedef struct {
+    uint16_t buttons;           /* CELL_PAD_CTRL_* layout */
+    float    lx, ly, rx, ry;    /* -1..1, +x = right, +y = DOWN (PS3 stick convention) */
+    int      l_active, r_active;
+    uint16_t mbuttons;          /* the part of buttons held by mouse buttons */
+    int      r_keys;            /* right-stick keys held */
+    float    krx, kry;          /* the right stick from those keys alone */
+} KbmOut;
+
+static inline void kbm_runtime_reset(KbmRuntime* rt) { memset(rt, 0, sizeof *rt); }
+
+/* Push this report's motion (counts since the previous step) and return the
+ * mouse speed in counts/s over exactly the last window_ms: the counts of each
+ * report are taken as spread evenly over the interval since the report
+ * before it, and the part of that interval inside the window is counted.
+ * So each count is counted for exactly one window, however the reports and
+ * the WM_INPUT bursts happen to fall: the camera turns by an amount that
+ * depends only on how far the mouse moved. With a window shorter than the
+ * report interval this is just the speed over that interval. */
+static inline void kbm_mouse_filter_step(KbmMouseFilter* f, double now_ms, double dx, double dy,
+                                         double window_ms, double* vx, double* vy)
+{
+    /* The counts span the whole time since the previous report -- after a
+     * stall in the game's pad polling (a loading screen) that is long, so
+     * motion made during the stall comes out thin and brief, not as a spin. */
+    double t0 = (f->primed && now_ms > f->t_last) ? f->t_last : now_ms - 8.0;
+    KbmMouseSample* s = &f->s[f->head];
+    s->t0 = t0; s->t1 = now_ms; s->dx = (float)dx; s->dy = (float)dy;
+    f->head = (f->head + 1) % KBM_HIST;
+    if (f->count < KBM_HIST) f->count++;
+    f->t_last = now_ms;
+    f->primed = 1;
+
+    double w  = window_ms < 1.0 ? 1.0 : window_ms;
+    double lo = now_ms - w;
+    double sx = 0.0, sy = 0.0;
+    for (int k = 0; k < f->count; k++) {
+        const KbmMouseSample* q = &f->s[(f->head - 1 - k + 2 * KBM_HIST) % KBM_HIST];
+        if (q->t1 <= lo) break;
+        double len  = q->t1 - q->t0;
+        double from = q->t0 > lo ? q->t0 : lo;
+        double frac = len > 0.0 ? (q->t1 - from) / len : 1.0;
+        sx += q->dx * frac;
+        sy += q->dy * frac;
+    }
+    *vx = sx * 1000.0 / w;
+    *vy = sy * 1000.0 / w;
+}
+
+/* Mouse speed (counts/s, +y = mouse moved toward the user) -> stick vector. */
+static inline void kbm_mouse_to_stick(const KbmConfig* c, double vx, double vy, float* ox, float* oy)
+{
+    double x = vx * c->mouse_sens / KBM_FULL_SPEED;
+    double y = vy * c->mouse_sens * c->mouse_sens_y / KBM_FULL_SPEED;
+    if (c->invert_y) y = -y;
+    double m = sqrt(x * x + y * y);
+    if (m < 1e-6) { *ox = *oy = 0.0f; return; }
+    double mc = m > 1.0 ? 1.0 : m;
+    if (c->curve != 1.0f) mc = pow(mc, (double)c->curve);
+    double adz = c->anti_deadzone;
+    double mo = adz + (1.0 - adz) * mc;
+    if (mo > 1.0) mo = 1.0;
+    *ox = (float)(x / m * mo);
+    *oy = (float)(y / m * mo);
+}
+
+static inline void kbm_pulse_step(KbmPulse* p, double now, double press_ms)
+{
+    double gap = press_ms * 0.6 < 40.0 ? 40.0 : press_ms * 0.6;
+    if (p->phase == 1 && now >= p->until) { p->phase = 2; p->until = now + gap; }
+    if (p->phase == 2 && now >= p->until) p->phase = 0;
+    if (p->phase == 0 && p->pending > 0) { p->pending--; p->phase = 1; p->until = now + press_ms; }
+}
+
+static inline int kbm_target_held(const KbmConfig* c, const KbmRuntime* rt, int t,
+                                  kbm_key_fn down, void* ctx)
+{
+    for (int i = 0; i < c->nkeys[t]; i++) {
+        int k = c->keys[t][i];
+        if (k == KBM_KEY_WHEEL_UP)   { if (rt->wheel_up.phase == 1)   return 1; continue; }
+        if (k == KBM_KEY_WHEEL_DOWN) { if (rt->wheel_down.phase == 1) return 1; continue; }
+        if (down(ctx, k)) return 1;
+    }
+    return 0;
+}
+
+/* Held through one of the mouse buttons (VK 1, 2, 4, 5, 6). */
+static inline int kbm_target_held_mouse(const KbmConfig* c, int t, kbm_key_fn down, void* ctx)
+{
+    for (int i = 0; i < c->nkeys[t]; i++) {
+        int k = c->keys[t][i];
+        if ((k == 0x01 || k == 0x02 || k == 0x04 || k == 0x05 || k == 0x06) && down(ctx, k)) return 1;
+    }
+    return 0;
+}
+
+static inline float kbm_clamp1(float v) { return v < -1.0f ? -1.0f : v > 1.0f ? 1.0f : v; }
+
+/* One pad report. mdx/mdy: mouse counts since the previous call (+y = toward
+ * the user); wheel: raw wheel delta since the previous call (+ = away). */
+static inline void kbm_eval(const KbmConfig* c, KbmRuntime* rt, kbm_key_fn down, void* ctx,
+                            double now_ms, long mdx, long mdy, long wheel, KbmOut* o)
+{
+    memset(o, 0, sizeof *o);
+
+    rt->wheel_acc += (int)wheel;
+    while (rt->wheel_acc >= KBM_WHEEL_DELTA) {
+        rt->wheel_acc -= KBM_WHEEL_DELTA;
+        if (rt->wheel_up.pending < 8) rt->wheel_up.pending++;
+    }
+    while (rt->wheel_acc <= -KBM_WHEEL_DELTA) {
+        rt->wheel_acc += KBM_WHEEL_DELTA;
+        if (rt->wheel_down.pending < 8) rt->wheel_down.pending++;
+    }
+    kbm_pulse_step(&rt->wheel_up, now_ms, c->wheel_pulse_ms);
+    kbm_pulse_step(&rt->wheel_down, now_ms, c->wheel_pulse_ms);
+
+    for (int t = 0; t < 16; t++)
+        if (kbm_target_held(c, rt, t, down, ctx)) {
+            o->buttons |= (uint16_t)(1u << t);
+            if (kbm_target_held_mouse(c, t, down, ctx)) o->mbuttons |= (uint16_t)(1u << t);
+        }
+
+#define KBM_H(t) (kbm_target_held(c, rt, (t), down, ctx) ? 1.0f : 0.0f)
+    float lx = KBM_H(KBM_LS_RIGHT) - KBM_H(KBM_LS_LEFT);
+    float ly = KBM_H(KBM_LS_DOWN)  - KBM_H(KBM_LS_UP);
+    if (lx != 0.0f || ly != 0.0f) {
+        if (kbm_target_held(c, rt, KBM_WALK, down, ctx)) { lx *= c->walk_scale; ly *= c->walk_scale; }
+        o->l_active = 1;
+    }
+    float kx = KBM_H(KBM_RS_RIGHT) - KBM_H(KBM_RS_LEFT);
+    float ky = KBM_H(KBM_RS_DOWN)  - KBM_H(KBM_RS_UP);
+#undef KBM_H
+
+    double vx, vy;
+    float mx, my;
+    kbm_mouse_filter_step(&rt->mouse, now_ms, (double)mdx, (double)mdy, c->smoothing_ms, &vx, &vy);
+    kbm_mouse_to_stick(c, vx, vy, &mx, &my);
+
+    o->lx = lx; o->ly = ly;
+    o->rx = kbm_clamp1(kx + mx);
+    o->ry = kbm_clamp1(ky + my);
+    o->r_active = (kx != 0.0f || ky != 0.0f || mx != 0.0f || my != 0.0f);
+    o->r_keys = (kx != 0.0f || ky != 0.0f);
+    o->krx = kx; o->kry = ky;
+}
+
+/* ---------------------------------------------------------------------------
+ * Controller vs keyboard/mouse on port 0 (merge_with_controller = 1)
+ *
+ * Buttons always combine. Each stick follows the device used last:
+ *   - right stick (camera): a controller button press, the controller's right
+ *     stick leaving its rest position, or that stick held out while the mouse
+ *     is still, gives the camera to the controller. The mouse takes it back
+ *     once it has really moved: its displacement, summed with a 0.5 s leak,
+ *     reaches mouse_takeover counts (at mouse_sensitivity 1; divided by the
+ *     sensitivity, so a high-DPI mouse turned down needs the same hand
+ *     motion). Sensor noise and a mouse jittering in place go back and forth
+ *     and never get there; a camera key press or a mouse button press takes
+ *     the camera at once. While the controller has it, camera keys held still
+ *     turn the camera when its stick is at rest.
+ *   - left stick: a move key press takes it, the controller's left stick
+ *     leaving rest takes it back; held move keys still move while the
+ *     controller's stick is at rest.
+ * A controller that appears starts with both sticks, so a mouse lying next to
+ * it does nothing until it is really moved. last_device_wins = 0 is the old
+ * merge: whatever the keyboard/mouse deflects overrides the controller's stick
+ * for that report (mouse_takeover = 0 does that for the camera alone).
+ * The controller's sticks come in after its deadzone (pad_host.h), so its rest
+ * position is exactly the centre; KBM_ARB_STICK only absorbs a raw deadzone 0.
+ * -----------------------------------------------------------------------*/
+
+#define KBM_ARB_STICK    0.15     /* controller stick "out of rest": radius, 0..1 */
+#define KBM_ARB_DECAY_MS 500.0    /* the mouse displacement sum's time constant */
+
+typedef struct {
+    int      started;               /* a controller was there at the previous report */
+    int      r_pad, l_pad;          /* 1: the controller has that stick */
+    double   sx, sy, t_travel;      /* mouse displacement since the controller took the camera (leaky) */
+    uint16_t pad_buttons, mbuttons; /* previous report's controller buttons / mouse-button targets */
+    int      pad_r_out, pad_l_out;  /* the controller's sticks were out of rest */
+    int      keys_r, keys_l;        /* stick keys were held */
+} KbmArb;
+
+static inline void kbm_arb_reset(KbmArb* a) { memset(a, 0, sizeof *a); }
+
+static inline double kbm_arb_radius(uint8_t x, uint8_t y)
+{
+    double fx = ((double)x - 128.0) / 127.5, fy = ((double)y - 128.0) / 127.5;
+    return sqrt(fx * fx + fy * fy);
+}
+
+/* One report. have_pad: a controller is on port 0, with these buttons and
+ * sticks (0..255, before the keyboard/mouse were merged in); o: this report's
+ * keyboard/mouse; mdx/mdy: the mouse counts that went into it. Out:
+ *   *use_l  1 = the keyboard's left stick (o->lx/ly), 0 = the controller's
+ *   *use_r  0 = the controller's right stick, 1 = the keyboard/mouse one
+ *           (o->rx/ry), 2 = the camera keys' alone (o->krx/kry) */
+static inline void kbm_arbitrate(const KbmConfig* c, KbmArb* a, int have_pad, uint16_t pad_buttons,
+                                 uint8_t plx, uint8_t ply, uint8_t prx, uint8_t pry,
+                                 const KbmOut* o, long mdx, long mdy, double now_ms,
+                                 int* use_l, int* use_r)
+{
+    if (!have_pad || !c->last_device_wins) {
+        kbm_arb_reset(a);
+        *use_l = o->l_active;
+        *use_r = o->r_active ? 1 : 0;
+        return;
+    }
+    int pad_r_out = kbm_arb_radius(prx, pry) > KBM_ARB_STICK;
+    int pad_l_out = kbm_arb_radius(plx, ply) > KBM_ARB_STICK;
+    if (!a->started) {
+        /* buttons and sticks already held are not a "press" */
+        a->started = 1;
+        a->r_pad = a->l_pad = 1;
+        a->sx = a->sy = 0.0; a->t_travel = now_ms;
+        a->pad_buttons = pad_buttons; a->mbuttons = o->mbuttons;
+        a->pad_r_out = pad_r_out; a->pad_l_out = pad_l_out;
+        a->keys_r = o->r_keys; a->keys_l = o->l_active;
+    }
+    int pad_press   = (pad_buttons & (uint16_t)~a->pad_buttons) != 0;
+    int mouse_press = (o->mbuttons & (uint16_t)~a->mbuttons) != 0;
+    int key_r_press = o->r_keys && !a->keys_r;
+    int key_l_press = o->l_active && !a->keys_l;
+    int moved = mdx != 0 || mdy != 0;
+
+    /* right stick */
+    if (key_r_press || mouse_press) {
+        a->r_pad = 0;
+    } else if (pad_press || (pad_r_out && !a->pad_r_out) || (pad_r_out && !moved && !o->r_keys)) {
+        if (!a->r_pad) { a->r_pad = 1; a->sx = a->sy = 0.0; a->t_travel = now_ms; }
+    }
+    if (a->r_pad && moved) {
+        double dt = now_ms - a->t_travel, sens = c->mouse_sens > 0.05f ? c->mouse_sens : 0.05;
+        if (dt > 0.0) { double k = exp(-dt / KBM_ARB_DECAY_MS); a->sx *= k; a->sy *= k; }
+        a->t_travel = now_ms;
+        a->sx += (double)mdx; a->sy += (double)mdy;
+        if (sqrt(a->sx * a->sx + a->sy * a->sy) * sens >= (double)c->mouse_takeover) a->r_pad = 0;
+    }
+    if (!a->r_pad)                    *use_r = o->r_active ? 1 : 0;
+    else if (o->r_keys && !pad_r_out) *use_r = 2;
+    else                              *use_r = 0;
+
+    /* left stick */
+    if (key_l_press)                         a->l_pad = 0;
+    else if (pad_l_out && !a->pad_l_out)     a->l_pad = 1;
+    *use_l = o->l_active && (!a->l_pad || !pad_l_out);
+
+    a->pad_buttons = pad_buttons; a->mbuttons = o->mbuttons;
+    a->pad_r_out = pad_r_out; a->pad_l_out = pad_l_out;
+    a->keys_r = o->r_keys; a->keys_l = o->l_active;
+}
+
+/* -1..1 -> 0..255 with 128 = centre (-1 -> 0, +1 -> 255). */
+static inline uint8_t kbm_axis_u8(float v)
+{
+    float f = floorf(128.0f + v * 128.0f + 0.5f);
+    int i = (int)f;
+    return (uint8_t)(i < 0 ? 0 : i > 255 ? 255 : i);
+}
+
+/* ---------------------------------------------------------------------------
+ * Startup print of the active table
+ * -----------------------------------------------------------------------*/
+
+static inline void kbm_keys_str(const KbmConfig* c, int t, char* out, size_t n)
+{
+    out[0] = 0;
+    if (!c->nkeys[t]) { snprintf(out, n, "-"); return; }
+    for (int i = 0; i < c->nkeys[t]; i++) {
+        char kn[24];
+        size_t len = strlen(out);
+        snprintf(out + len, n - len, "%s%s", i ? ", " : "", kbm_key_name(c->keys[t][i], kn, sizeof kn));
+    }
+}
+
+/* Append printf-style text to a NUL-terminated buffer, truncating at n. */
+static inline void kbm_appendf(char* out, size_t n, const char* fmt, ...)
+{
+    size_t len = strlen(out);
+    if (len + 1 >= n) return;
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(out + len, n - len, fmt, ap);
+    va_end(ap);
+}
+
+/* The table is formatted into one buffer and written with a single fputs:
+ * it prints while the guest's threads are starting, and line-by-line writes
+ * came out interleaved mid-line with their log output. */
+static inline void kbm_print_bindings(const KbmConfig* c, FILE* f, const char* pfx)
+{
+    char out[4096];
+    out[0] = 0;
+    static const int order[] = {
+        KBM_CROSS, KBM_SQUARE, KBM_TRIANGLE, KBM_CIRCLE, KBM_L1, KBM_R1, KBM_L2, KBM_R2,
+        KBM_L3, KBM_R3, KBM_START, KBM_SELECT, KBM_UP, KBM_RIGHT, KBM_DOWN, KBM_LEFT,
+        KBM_LS_UP, KBM_LS_DOWN, KBM_LS_LEFT, KBM_LS_RIGHT,
+        KBM_RS_UP, KBM_RS_DOWN, KBM_RS_LEFT, KBM_RS_RIGHT, KBM_WALK,
+    };
+    char line[256];
+    line[0] = 0;
+    for (int i = 0; i < KBM_COUNT(order); i++) {
+        char keys[96], cell[128];
+        kbm_keys_str(c, order[i], keys, sizeof keys);
+        snprintf(cell, sizeof cell, "%-12s %-20s", kbm_target_name(order[i]), keys);
+        size_t used = strlen(line);
+        snprintf(line + used, sizeof line - used, "%s", cell);
+        if (i % 3 == 2 || i == KBM_COUNT(order) - 1) {
+            char* e = line + strlen(line);
+            while (e > line && e[-1] == ' ') *--e = 0;
+            kbm_appendf(out, sizeof out, "%s  %s\n", pfx, line);
+            line[0] = 0;
+        }
+    }
+    static const char* cap[] = { "off", "on click (Alt/F10/focus loss releases)", "on focus (Alt/F10 releases)" };
+    kbm_appendf(out, sizeof out, "%s  mouse -> right stick: %s; sensitivity %.2f (y x%.2f), smoothing %.0f ms, "
+               "anti-deadzone %.2f, curve %.2f, invert-y %s; capture %s\n",
+            pfx, c->mouse ? "on" : "off", c->mouse_sens, c->mouse_sens_y, c->smoothing_ms,
+            c->anti_deadzone, c->curve, c->invert_y ? "on" : "off",
+            cap[c->capture < 0 || c->capture > 2 ? 0 : c->capture]);
+    kbm_appendf(out, sizeof out, "%s  keyboard %s, walk scale %.2f, wheel pulse %.0f ms, merge with a controller %s\n",
+            pfx, c->keyboard ? "on" : "off", c->walk_scale, c->wheel_pulse_ms, c->merge ? "on" : "off");
+    if (c->merge) {
+        if (c->last_device_wins)
+            kbm_appendf(out, sizeof out, "%s  with a controller: each stick follows the device used last; the mouse "
+                        "takes the camera back after %.0f counts\n", pfx, c->mouse_takeover);
+        else
+            kbm_appendf(out, sizeof out, "%s  with a controller: keyboard/mouse sticks override the controller's "
+                        "(last_device_wins = 0)\n", pfx);
+    }
+    /* A key driving two targets is allowed (e.g. a key for both a d-pad
+     * direction and the stick), but usually a leftover default: say so. */
+    for (int t = 0; t < KBM_NUM_TARGETS; t++)
+        for (int i = 0; i < c->nkeys[t]; i++) {
+            int k = c->keys[t][i], first = 1;
+            for (int u = 0; u < t && first; u++)
+                for (int j = 0; j < c->nkeys[u]; j++) if (c->keys[u][j] == k) first = 0;
+            if (!first) continue;
+            char also[160];
+            also[0] = 0;
+            int n = 0;
+            for (int u = t + 1; u < KBM_NUM_TARGETS; u++)
+                for (int j = 0; j < c->nkeys[u]; j++)
+                    if (c->keys[u][j] == k) {
+                        size_t len = strlen(also);
+                        snprintf(also + len, sizeof also - len, ", %s", kbm_target_name(u));
+                        n++;
+                    }
+            if (n) {
+                char kn[24];
+                kbm_appendf(out, sizeof out, "%s  note: key %s drives %s%s\n", pfx, kbm_key_name(k, kn, sizeof kn),
+                        kbm_target_name(t), also);
+            }
+        }
+    fputs(out, f);
+}
+
+#endif /* PS3RECOMP_PAD_KBM_H */
diff --git a/libs/input/tests/padprobe.c b/libs/input/tests/padprobe.c
new file mode 100644
index 0000000..2009df3
--- /dev/null
+++ b/libs/input/tests/padprobe.c
@@ -0,0 +1,254 @@
+/*
+ * padprobe - the host controllers as cellPad will see them
+ *
+ * Links pad_host_win.c plus whichever driver files exist (a missing driver
+ * resolves to an empty one), runs the real device manager and prints the
+ * device list and every port's state as the game would read it.
+ *
+ *   padprobe [seconds]            stream port state (default 10 s, 0 = until Ctrl+C)
+ *   padprobe --list               device list only
+ *   padprobe --readonly           never write to a controller (no LEDs, no rumble)
+ *   padprobe --raw[=VID:PID]      claim game controllers with a dump driver instead of
+ *                                 the real ones: prints caps, feature reports and the
+ *                                 first input reports, sends nothing
+ *   padprobe --feature=ID[:LEN],..  feature reports read by --raw (e.g. 0x05:41,0x20:64)
+ *   padprobe --rumble=PORT[:MS[:STRENGTH[:SMALL]]]
+ *                                 one rumble after 1 s (default 250 ms, large motor 80)
+ *   padprobe --log                PAD_LOG=1 (per-device detail, first reports in hex)
+ *   padprobe --quiet              print a port line only when its buttons/sticks change
+ *
+ * Build (Windows, from external/ps3recomp; the drivers are optional):
+ *   clang-cl /std:c17 /O2 /MD -D_CRT_SECURE_NO_WARNINGS -I include -I libs/input -I libs/system
+ *            libs/input/tests/padprobe.c libs/input/pad_host_win.c libs/input/pad_hid_*.c /Fe:padprobe.exe
+ */
+
+#include "../pad_host.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+static volatile LONG s_quit;
+
+static BOOL WINAPI on_ctrl(DWORD type)
+{
+    (void)type;
+    InterlockedExchange(&s_quit, 1);
+    return TRUE;
+}
+
+/* ---- the --raw dump driver ----------------------------------------------*/
+
+static int s_raw_on;
+static unsigned s_raw_vid, s_raw_pid;
+static struct { int id, len; } s_feat[16];
+static int s_nfeat;
+
+static void hexdump(const char* what, const unsigned char* p, int n)
+{
+    printf("    %s (%d bytes):", what, n);
+    for (int i = 0; i < n; i++) {
+        if (i % 32 == 0) printf("\n     ");
+        printf(" %02X", p[i]);
+    }
+    printf("\n");
+}
+
+static int raw_match(const PadHostDevice* d)
+{
+    if (!s_raw_on) return 0;
+    if (s_raw_vid && d->vid != s_raw_vid) return 0;
+    if (s_raw_pid && d->pid != s_raw_pid) return 0;
+    return 1000;
+}
+
+static int raw_open(PadHostDevice* d)
+{
+    printf("[raw] %s  %s %04X:%04X ver %04X  usage %02X:%02X  in/out/feature %d/%d/%d  serial \"%s\"\n"
+           "      %s\n", d->name, padhost_bus_name(d->bus), d->vid, d->pid, d->version,
+           d->usage_page, d->usage, d->in_len, d->out_len, d->feat_len, d->serial, d->path);
+    unsigned char buf[1024];
+    for (int i = 0; i < s_nfeat; i++) {
+        int len = s_feat[i].len > 0 ? s_feat[i].len : d->feat_len;
+        if (len <= 0 || len > (int)sizeof buf) len = 64;
+        memset(buf, 0, sizeof buf);
+        buf[0] = (unsigned char)s_feat[i].id;
+        int n = padhost_dev_get_feature(d, buf, len);
+        char what[64];
+        snprintf(what, sizeof what, "feature 0x%02X, asked %d", s_feat[i].id, len);
+        if (n < 0) printf("    %s: failed\n", what);
+        else       hexdump(what, buf, n);
+    }
+    memset(buf, 0, sizeof buf);
+    int n = padhost_dev_read(d, buf, (int)sizeof buf, 500);
+    if (n < 0) printf("    padhost_dev_read: nothing within 500 ms\n");
+    else       hexdump("padhost_dev_read (open-time sync read)", buf, n);
+    fflush(stdout);
+    return 0;
+}
+
+static int raw_parse(PadHostDevice* d, const unsigned char* rep, int len, PadHostPortState* st)
+{
+    (void)st;
+    unsigned* count = (unsigned*)(void*)d->priv;
+    if (*count < 3) {
+        char what[48];
+        snprintf(what, sizeof what, "input report #%u", *count);
+        hexdump(what, rep, len);
+        fflush(stdout);
+    }
+    (*count)++;
+    return 1;          /* publish (neutral) so the stream shows the report rate */
+}
+
+static const PadHostDriver raw_drv = { "raw-dump", PADHOST_KIND_GENERIC, raw_match, raw_open, raw_parse, NULL, NULL };
+
+/* ---- main ----------------------------------------------------------------*/
+
+static void print_port(int p, const PadHostPortState* st, double rate)
+{
+    char batt[8];
+    if (st->battery == 255) snprintf(batt, sizeof batt, "-");
+    else                    snprintf(batt, sizeof batt, "%u%%", st->battery);
+    printf("p%d %-11s %-3s %04X:%04X btn=%04X ps=%u L(%3u,%3u) R(%3u,%3u) L2=%3u R2=%3u "
+           "pr[%3u %3u %3u %3u|%3u %3u %3u %3u|%3u %3u] %s acc(%4u,%4u,%4u) g=%4u bat=%-4s %6.1f/s seq=%u\n",
+           p, padhost_kind_name(st->kind), padhost_bus_name(st->bus), st->vid, st->pid,
+           st->buttons, st->ps, st->lx, st->ly, st->rx, st->ry,
+           st->press[PADHOST_PRESS_L2], st->press[PADHOST_PRESS_R2],
+           st->press[0], st->press[1], st->press[2], st->press[3],
+           st->press[4], st->press[5], st->press[6], st->press[7], st->press[8], st->press[9],
+           st->has_pressure ? "P" : "-", st->sensor_x, st->sensor_y, st->sensor_z, st->sensor_g,
+           batt, rate, st->seq);
+}
+
+int main(int argc, char** argv)
+{
+    double seconds = 10;
+    int list = 0, quiet = 0;
+    int rumble_port = -1, rumble_ms = 250, rumble_large = 80, rumble_small = 0;
+
+    for (int i = 1; i < argc; i++) {
+        const char* a = argv[i];
+        if (!strcmp(a, "--list")) list = 1;
+        else if (!strcmp(a, "--readonly")) padhost_config_set("readonly", "1");
+        else if (!strcmp(a, "--log")) padhost_config_set("log", "1");
+        else if (!strcmp(a, "--quiet")) quiet = 1;
+        else if (!strncmp(a, "--raw", 5)) {
+            s_raw_on = 1;
+            if (a[5] == '=') sscanf(a + 6, "%x:%x", &s_raw_vid, &s_raw_pid);
+        } else if (!strncmp(a, "--feature=", 10)) {
+            const char* p = a + 10;
+            while (*p && s_nfeat < 16) {
+                char* e;
+                s_feat[s_nfeat].id = (int)strtol(p, &e, 0);
+                s_feat[s_nfeat].len = 0;
+                if (*e == ':') s_feat[s_nfeat].len = (int)strtol(e + 1, &e, 0);
+                s_nfeat++;
+                p = *e == ',' ? e + 1 : e;
+                if (e == p && *p != ',') break;
+            }
+        } else if (!strncmp(a, "--rumble=", 9)) {
+            sscanf(a + 9, "%d:%d:%d:%d", &rumble_port, &rumble_ms, &rumble_large, &rumble_small);
+        } else if (a[0] >= '0' && a[0] <= '9') {
+            seconds = atof(a);
+        } else {
+            fprintf(stderr, "unknown argument %s (see the comment at the top of padprobe.c)\n", a);
+            return 2;
+        }
+    }
+    if (s_raw_on && !s_nfeat) printf("[raw] no --feature list: only caps and input reports\n");
+    if (s_raw_on) padhost_register_driver(&raw_drv);
+    SetConsoleCtrlHandler(on_ctrl, TRUE);
+
+    {
+        const PadHostDriver* dl[16];
+        int nd = padhost_drivers(dl, 16);
+        printf("HID drivers linked:");
+        for (int i = 0; i < nd; i++) printf(" %s", dl[i]->name);
+        printf("%s\n", nd ? "" : " none (game controllers show as unclaimed)");
+    }
+    ULONGLONG t0 = GetTickCount64();
+    padhost_init();
+    printf("padhost_init: %llu ms, generation %u\n", (unsigned long long)(GetTickCount64() - t0), padhost_generation());
+
+    {
+        PadHostDeviceInfo info[64];
+        int n = padhost_enum_devices(info, 64);
+        printf("padhost_enum_devices: %d\n", n);
+        for (int i = 0; i < n && i < 64; i++)
+            printf("  [%s] port %d %-12s %-3s %04X:%04X usage %02X:%02X driver/why \"%s\" name \"%s\"%s%s%s\n    %s\n",
+                   info[i].claimed ? (info[i].hidden ? "hidden" : "claimed") : "seen", info[i].port,
+                   padhost_kind_name(info[i].kind), padhost_bus_name(info[i].bus), info[i].vid, info[i].pid,
+                   info[i].usage_page, info[i].usage, info[i].driver, info[i].name,
+                   info[i].virt[0] ? " virtual \"" : "", info[i].virt, info[i].virt[0] ? "\"" : "", info[i].path);
+        char p1[96];
+        int r = padhost_port_describe(0, p1, (int)sizeof p1);
+        printf("player 1 (port 0): %s\n", r > 0 ? p1 : r < 0 ? "(busy)" : "no controller");
+    }
+    fflush(stdout);
+
+    if (!list) {
+        u32 last_seq[PADHOST_MAX_PORTS] = { 0 }, rate_seq[PADHOST_MAX_PORTS] = { 0 };
+        ULONGLONG last_print[PADHOST_MAX_PORTS] = { 0 }, rate_t[PADHOST_MAX_PORTS] = { 0 };
+        double rate[PADHOST_MAX_PORTS] = { 0 };
+        PadHostPortState prev[PADHOST_MAX_PORTS];
+        memset(prev, 0, sizeof prev);
+        unsigned gen = padhost_generation();
+        int rumble_state = rumble_port >= 0 ? 1 : 0;
+        ULONGLONG start = GetTickCount64();
+        while (!s_quit) {
+            ULONGLONG now = GetTickCount64();
+            double el = (double)(now - start) / 1000.0;
+            if (seconds > 0 && el >= seconds) break;
+            if (rumble_state == 1 && el >= 1.0) {
+                printf("rumble port %d: large %d small %d for %d ms\n", rumble_port, rumble_large, rumble_small, rumble_ms);
+                padhost_set_actuator(rumble_port, (u8)rumble_small, (u8)rumble_large);
+                rumble_state = 2;
+            } else if (rumble_state == 2 && el >= 1.0 + rumble_ms / 1000.0) {
+                padhost_set_actuator(rumble_port, 0, 0);
+                printf("rumble port %d: off\n", rumble_port);
+                rumble_state = 3;
+            }
+            if (padhost_generation() != gen) {
+                gen = padhost_generation();
+                printf("generation %u (port assignment changed)\n", gen);
+            }
+            for (int p = 0; p < PADHOST_MAX_PORTS; p++) {
+                PadHostPortState st;
+                if (!padhost_get(p, &st)) continue;
+                if (now - rate_t[p] >= 1000) {
+                    if (rate_t[p]) rate[p] = (double)(st.seq - rate_seq[p]) * 1000.0 / (double)(now - rate_t[p]);
+                    rate_t[p] = now;
+                    rate_seq[p] = st.seq;
+                }
+                PadHostPortState a = st, b = prev[p];
+                a.seq = b.seq = 0;
+                int changed = memcmp(&a, &b, sizeof a) != 0;
+                if ((!quiet && (st.seq != last_seq[p] && now - last_print[p] >= 250)) ||
+                    (changed && now - last_print[p] >= 50)) {
+                    print_port(p, &st, rate[p]);
+                    last_print[p] = now;
+                }
+                last_seq[p] = st.seq;
+                prev[p] = st;
+            }
+            fflush(stdout);
+            Sleep(10);
+        }
+        if (rumble_state == 2) padhost_set_actuator(rumble_port, 0, 0);
+    }
+    t0 = GetTickCount64();
+    padhost_shutdown();
+    printf("padhost_shutdown: %llu ms\n", (unsigned long long)(GetTickCount64() - t0));
+    return 0;
+}
+
+#else
+int main(void) { printf("padprobe: Windows only\n"); return 0; }
+#endif
diff --git a/libs/input/tests/sony_vectors.h b/libs/input/tests/sony_vectors.h
