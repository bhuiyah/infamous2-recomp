+/* ===========================================================================
+ * The load (M4c; ss_core.h "the load", engine design 4.3)
+ * =========================================================================*/
+static ss_ppu_recreate_fn s_ppu_recreate;
+static ss_spu_recreate_fn s_spu_recreate;
+void ss_set_ppu_recreate(ss_ppu_recreate_fn fn) { s_ppu_recreate = fn; }
+void ss_set_spu_recreate(ss_spu_recreate_fn fn) { s_spu_recreate = fn; }
+static ss_load_session_fn s_load_session;
+void ss_set_load_session_check(ss_load_session_fn fn) { s_load_session = fn; }
+
+/* The load gate: recreated threads and main wait here from their recreation
+ * (main: its discard) to the release. Opened (0) outside a load. */
+static volatile long s_gate_closed;
+static volatile long s_main_at_gate;      /* main reached the gate after its discard */
+void ss_load_gate_wait(void)
+{
+    if (!s_gate_closed) return;
+    AcquireSRWLockExclusive(&s_lk);
+    while (s_gate_closed) SleepConditionVariableSRW(&s_cv, &s_lk, 50, 0);
+    ReleaseSRWLockExclusive(&s_lk);
+}
+
+/* The last load's figures (ss_request_result's load part). */
+static struct {
+    double discard_ms, teardown_ms, restore_ms, verify_ms, recreate_ms, release_ms;
+    int verified;
+    unsigned ppu, spu, norestore;
+    int main;                                 /* main resumed at the gate */
+    ss_verify_result v;
+} s_lres;
+
+/* A failure past the point of no return: the old state is gone, the new one
+ * incomplete -- never run on that. One FATAL line, the request summary, a
+ * message box unless SS_FATAL_BOX=0, exit code 3. */
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((format(printf, 1, 2), noreturn))
+#endif
+static void load_fatal(const char* fmt, ...)
+{
+    char b[400];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(b, sizeof b, fmt, ap);
+    va_end(ap);
+    fprintf(stderr, "[ss] FATAL: %s request #%u failed past its point of no return: %s -- the old state is"
+                    " gone and the new one is incomplete; exiting (code 3)\n",
+            s_rq.r.purpose == SS_P_SELFTEST ? "selftest" : "load", s_rq.seq, b);
+    ss_request_summary("fatal");
+    fflush(stderr);
+    fflush(stdout);
+#ifdef _WIN32
+    if (s_cfg.fatal_box) {
+        char m[600];
+        snprintf(m, sizeof m, "Loading the save state failed, and the game cannot go on:\n\n%s\n\n"
+                              "The game will close. Your own game saves are not affected.", b);
+        MessageBoxA(NULL, m, "Save state", MB_OK | MB_ICONERROR | MB_TOPMOST | MB_SETFOREGROUND);
+    }
+    ExitProcess(3);
+#else
+    _exit(3);
+#endif
+}
+
+/* A parked PPU thread's discard: to its root, which tells a discard apart
+ * from an exit (SS_ROOT_DISCARD). Called with no lock held. */
+static void discard_self(void);
+
+/* What a load needs of its stop beyond the eligibility of its purpose:
+ * every parked PPU thread has a root to be discarded to and no sys_cond
+ * waiter on its host stack; every SPU host thread a discard root; the build
+ * can recreate threads; no modal loop; the sections it will tear down and
+ * restore are every registered one, once (ss_state_order_check: without PPUT
+ * or SPUC the threads cannot be resumed, which is found only past the point
+ * of no return). Returns the first blocking reason. */
+static int load_checks(void)
+{
+    if (!s_ppu_recreate || !s_sr_ops.run)
+        return blocked(SS_REASON_NOT_YET, "", "this build cannot recreate threads (no PPU recreate / resume ops)");
+    {
+        char w[160];
+        w[0] = 0;
+        if (ss_state_order_check(w, sizeof w))
+            return blocked(SS_REASON_NOT_RESUMABLE, "the save-state engine", "%s", w);
+    }
+    if (s_host.in_modal && s_host.in_modal())
+        return blocked(SS_REASON_THREAD_BUSY, "the window", "the window is in a modal loop (a drag or a menu)");
+    for (int i = 0; i < s_cap.nthr; i++) {
+        const ss_cap_thr* c = &s_cap.thr[i];
+        if (!s_roots[c->tid].valid)
+            return blocked(SS_REASON_NO_ROOT, c->name, "tid=%u '%s' has no thread root to be discarded to",
+                           c->tid, c->name);
+        if (c->at == SS_IN_WAIT && c->num == SS_W_COND)
+            return blocked(SS_REASON_NOT_RESUMABLE, c->name, "tid=%u '%s' waits in sys_cond_wait (its waiter"
+                           " record is on the host stack a discard throws away)", c->tid, c->name);
+    }
+    for (int i = 0; i < SS_SPU_MAX; i++)
+        if (s_spu[i].used == 1 && !s_spu[i].root)
+            return blocked(SS_REASON_SPU_EXTRA, "SPU", "SPU 0x%X has no discard root (a PPU-fallback thread?)",
+                           s_spu[i].tid);
+    /* The session's own SPU work a load would not replace (the async runner,
+     * a raw SPU, a debug switch): the sections' check_image read it once for
+     * the request, and it may have changed since -- read again, parked. */
+    if (s_load_session) {
+        char w[160];
+        w[0] = 0;
+        const int rc = s_load_session(w, sizeof w);
+        if (rc) return blocked(rc, "SPU", "this session: %s, which a load does not replace", w);
+    }
+    return SS_REASON_OK;
+}
+
+/* The image's own check (PPUT, sys_ppu_thread.c): every thread it resumes
+ * has a park record of a resumable kind. 0, or non-zero with why. */
+static int (*s_ppu_image_check)(const ss_image* img, char* why, size_t why_n);
+void ss_set_ppu_image_check(int (*fn)(const ss_image* img, char* why, size_t why_n)) { s_ppu_image_check = fn; }
+
+static void sr_reset_all(void);
+
+/* The load proper, on the coordinator, every guest thread parked and the
+ * GPU idle: DISCARD .. RELEASE. Returns only if it succeeded; a failure past
+ * the discard ends the process (load_fatal). */
+static void load_run(const ss_image* img, int verify)
+{
+    memset(&s_lres, 0, sizeof s_lres);
+    char why[256];
+    uint64_t t = ss_now_us();
+    /* ---- DISCARD ----------------------------------------------------------- */
+    InterlockedExchange(&s_loading, 1);               /* watchdog off, parks read as the load's */
+    InterlockedExchange(&s_gate_closed, 1);
+    InterlockedExchange(&s_main_at_gate, 0);
+    ss_time_freeze();                                 /* (a selftest's capture already froze it) */
+    HANDLE hw[SS_MAX_TID + SS_SPU_MAX];
+    char   hn[SS_MAX_TID + SS_SPU_MAX][40];
+    int nh = 0, main_parked = 0;
+    for (unsigned tid = 1; tid <= SS_MAX_TID; tid++) {
+        const ss_thr* r = &s_thr[tid];
+        if (r->state != 1 || r->gen != s_gen) continue;
+        if (s_ppu.main_host_tid && r->host_tid == s_ppu.main_host_tid) { main_parked = 1; continue; }
+        HANDLE h = OpenThread(SYNCHRONIZE, FALSE, r->host_tid);
+        if (!h) continue;                             /* (gone already) */
+        snprintf(hn[nh], sizeof hn[nh], "PPU tid %u '%s'", tid, g_ppu_threads[tid - 1].name);
+        hw[nh++] = h;
+    }
+    for (int i = 0; i < SS_SPU_MAX; i++) {
+        const ss_spu_slot* s = &s_spu[i];
+        if (s->used != 1 || s->state != 1 || s->gen != s_spu_gen) continue;
+        HANDLE h = OpenThread(SYNCHRONIZE, FALSE, s->host_tid);
+        if (!h) continue;
+        snprintf(hn[nh], sizeof hn[nh], "SPU 0x%X", s->tid);
+        hw[nh++] = h;
+    }
+    AcquireSRWLockExclusive(&s_lk);
+    s_discard_gen = s_gen;
+    s_spu_discard_gen = s_spu_gen;
+    InterlockedExchange(&g_ss_req, 0);
+    InterlockedIncrement(&s_gen);
+    InterlockedExchange(&g_ss_spu_req, 0);
+    InterlockedIncrement(&s_spu_gen);
+    ReleaseSRWLockExclusive(&s_lk);
+    WakeAllConditionVariable(&s_cv);
+    if (s_spu_ops && s_spu_ops->force_hops) s_spu_ops->force_hops(0);
+    co.spu_req = 0;
+    const uint64_t dl = ss_now_us() + (uint64_t)s_cfg.discard_ms * 1000ull;
+    for (int i = 0; i < nh; i++) {
+        const uint64_t now = ss_now_us();
+        const DWORD ms = now < dl ? (DWORD)((dl - now + 999) / 1000) : 0;
+        if (WaitForSingleObject(hw[i], ms) != WAIT_OBJECT_0)
+            load_fatal("%s did not unwind within %u ms of its discard", hn[i], s_cfg.discard_ms);
+        CloseHandle(hw[i]);
+    }
+    while (main_parked && !s_main_at_gate) {
+        if (ss_now_us() >= dl) load_fatal("the main thread did not reach the load gate within %u ms", s_cfg.discard_ms);
+        Sleep(1);
+    }
+    s_discard_gen = -1;
+    s_spu_discard_gen = -1;
+    /* ss_core's own tables: nothing of the old world's threads stays (H2/H3) */
+    for (unsigned tid = 0; tid <= SS_MAX_TID; tid++) {
+        s_thr[tid].state = 0;
+        s_thr[tid].gen = -1;
+        InterlockedExchange(&s_roots[tid].valid, 0);
+        InterlockedExchange(&s_lpark[tid].valid, 0);
+    }
+    for (int i = 0; i < SS_SPU_MAX; i++) {
+        if (s_spu[i].used) { s_spu[i].ctx = 0; s_spu[i].root = NULL; InterlockedExchange(&s_spu[i].used, 0); }
+    }
+    s_unreg_visits = 0;
+    sr_reset_all();
+    const uint64_t t1 = ss_now_us();
+    s_lres.discard_ms = (double)(t1 - t) / 1000.0;
+    /* ---- TEARDOWN / RESTORE ------------------------------------------------- */
+    ss_state_teardown();
+    if (s_host.gpu_reset) s_host.gpu_reset();         /* the renderer's derived caches (design 6.2) */
+    const uint64_t t2 = ss_now_us();
+    s_lres.teardown_ms = (double)(t2 - t1) / 1000.0;
+    uint32_t fc = 0;
+    why[0] = 0;
+    if (ss_state_restore(img, why, sizeof why, &fc, &s_lres.norestore) != SS_OK) load_fatal("restore: %s", why);
+    const uint64_t t3 = ss_now_us();
+    s_lres.restore_ms = (double)(t3 - t2) / 1000.0;
+    /* ---- VERIFY ------------------------------------------------------------- */
+    if (verify) {
+        ss_capture_info ci;
+        memset(&ci, 0, sizeof ci);
+        ci.seq = s_rq.seq;
+        ci.purpose = s_rq.r.purpose;
+        ci.flip_count = s_host.flip_count ? s_host.flip_count() : co.last_flip;
+        ci.play_ms = play_ms(t3);
+        ci.t_s = (double)(t3 - co.t_init) / 1e6;
+        why[0] = 0;
+        if (ss_state_capture(&ci, why, sizeof why, &fc) == SS_OK) {
+            ss_state_verify(img, ss_image_captured(), &s_lres.v);
+            s_lres.verified = 1;
+        } else {
+            char f4[5];
+            fprintf(stderr, "[ss] load #%u: the fidelity check could not capture (section %s: %s)\n", s_rq.seq,
+                    ss_fourcc_str(fc, f4), why);
+        }
+    }
+    const uint64_t t4 = ss_now_us();
+    s_lres.verify_ms = (double)(t4 - t3) / 1000.0;
+    /* ---- RECREATE ------------------------------------------------------------ */
+    if (s_spu_recreate) {
+        why[0] = 0;
+        const int n = s_spu_recreate(why, sizeof why);
+        if (n < 0) load_fatal("SPU threads: %s", why);
+        s_lres.spu = (unsigned)n;
+    }
+    /* main (guest tid 1, ppu_thread_register_main) is the process's main
+     * thread inside ppu_run: never recreated, it resumes at the gate */
+    const int have_main = s_ppu.main_host_tid != 0;
+    for (unsigned tid = 1; tid <= SS_MAX_TID; tid++) {
+        if (!s_lpark[tid].valid || (tid == 1 && have_main)) continue;
+        why[0] = 0;
+        if (s_ppu_recreate(tid, why, sizeof why) != 0) load_fatal("PPU tid %u: %s", tid, why);
+        s_lres.ppu++;
+    }
+    if (main_parked && !s_lpark[1].valid)
+        load_fatal("the image has no park record for the main thread");
+    if (have_main && !main_parked && s_lpark[1].valid)
+        load_fatal("the main thread was not parked, its park record has nobody to resume it");
+    s_lres.main = main_parked;
+    const uint64_t t5 = ss_now_us();
+    s_lres.recreate_ms = (double)(t5 - t4) / 1000.0;
+    /* ---- RELEASE -------------------------------------------------------------- */
+    ss_time_thaw();                                   /* guest time goes on from the snapshot's */
+    AcquireSRWLockExclusive(&s_lk);
+    InterlockedExchange(&s_gate_closed, 0);
+    ReleaseSRWLockExclusive(&s_lk);
+    WakeAllConditionVariable(&s_cv);
+    release_ppu_and_mixer();                          /* the mixer (no PPU thread is parked) */
+    if (s_host.walker_rebase) s_host.walker_rebase((ss_now_us() - t3 + 999) / 1000);   /* (from the restore) */
+    const unsigned flips = s_host.flip_count ? s_host.flip_count() : co.last_flip;
+    if (s_host.resync_clock) s_host.resync_clock(flips);
+    co.last_flip = flips;
+    InterlockedExchange(&s_loading, 0);
+    ss_state_after_release();
+    s_lres.release_ms = (double)(ss_now_us() - t5) / 1000.0;
+}
+
+/* SS_DUMP: the raw image to <SS_DIR or .\savestates>\dump-<n>.p3ssraw, and
+ * what a slot file of it would weigh: XPRESS_HUFF on 32 of GMEM's chunks
+ * spread over it, on every chunk of the other sections. */
+static void dump_image(const ss_image* img, const ss_mem_stats* m)
+{
+    static unsigned s_dump_n;
+    char path[600], why[256];
+    if (!ss_ui_ensure_dir()) {
+        fprintf(stderr, "[ss] SS_DUMP: cannot create the folder %s\n", ss_ui_dir());
+        return;
+    }
+#ifdef _WIN32
+    snprintf(path, sizeof path, "%s\\dump-%u.p3ssraw", ss_ui_dir(), ++s_dump_n);
+#else
+    snprintf(path, sizeof path, "%s/dump-%u.p3ssraw", ss_ui_dir(), ++s_dump_n);
+#endif
+    double wms = 0;
+    why[0] = 0;
+    if (ss_image_write_file(img, path, &wms, why, sizeof why) != SS_OK) {
+        fprintf(stderr, "[ss] SS_DUMP #%u: %s\n", s_dump_n, why);
+        return;
+    }
+    const uint32_t k_gmem = SS_FOURCC('G', 'M', 'E', 'M');
+    ss_compress_est g;
+    memset(&g, 0, sizeof g);
+    double est = 0, est_ms = 0;
+    int measured = 0;
+    for (uint32_t i = 0; i < img->hdr.nsections; i++) {
+        const ss_sec_ent* e = &img->sec[i];
+        ss_compress_est t;
+        const int rc = ss_image_estimate_compressed(img, e->fourcc, e->fourcc == k_gmem ? 32u : 0xFFFFFFFFu, &t);
+        if (e->fourcc == k_gmem) g = t;
+        est += (rc == SS_OK ? t.ratio : 1.0) * (double)e->size;
+        est_ms += t.ms;
+        measured |= rc == SS_OK && t.chunks > 0;
+    }
+    const double image_mb = (double)img->hdr.file_size / SS_MB;
+    char ratio[160] = "no estimate (the Compression API is Windows only)";
+    if (measured)
+        snprintf(ratio, sizeof ratio, "XPRESS_HUFF on %u of %u GMEM chunks: %.1f%% at %.0f MB/s -> a slot file of"
+                 " about %.0f MB (%.1f%% of the image; %.0f ms)", g.chunks, g.of, 100.0 * g.ratio, g.mb_s,
+                 est / SS_MB, image_mb > 0 ? 100.0 * (est / SS_MB) / image_mb : 0.0, est_ms);
+    fprintf(stderr, "[ss] SS_DUMP #%u -> %s: %.1f MB written in %.0f ms; guest memory %.1f MB committed, %.1f MB"
+                    " non-zero (%u pages; %.1f MB unreadable, %u regions); %s\n", s_dump_n, path, image_mb, wms,
+            (double)m->committed / SS_MB, (double)m->nonzero / SS_MB, m->pages, (double)m->unreadable / SS_MB,
+            m->regions, ratio);
+}
+
+/* A captured SAVE, after the release: seal the image (CRC32C), report it,
+ * and for SS_RQ_DUMP write it out. The game runs again, but this is the
+ * frame-clock thread: time spent here is a frame hitch, not a pause. */
+static void save_done(uint64_t now)
+{
+    (void)now;
+    if (!s_cap.captured) return;
+    const double seal_ms = ss_state_seal();
+    const ss_image* img = ss_image_last();
+    if (!img) return;
+    ss_mem_stats m;
+    ss_state_mem_stats(&m);
+    char secs[480], f4[5];
+    int p = 0;
+    secs[0] = 0;
+    for (uint32_t i = 0; i < img->hdr.nsections && p < (int)sizeof secs - 48; i++) {
+        const ss_sec_ent* e = &img->sec[i];
+        const int big = e->size >= (1u << 20);
+        p += snprintf(secs + p, sizeof secs - p, "%s%s %.1f %s %.1f ms", i ? ", " : "", ss_fourcc_str(e->fourcc, f4),
+                      big ? (double)e->size / SS_MB : (double)e->size / 1024.0, big ? "MB" : "KB",
+                      (double)e->capture_us / 1000.0);
+    }
+    const double stop = s_cap.stop_ms - s_cap.gpu_ms - s_cap.capture_ms;
+    fprintf(stderr, "[ss] save request #%u: captured %.1f MB in %u sections -- pause %.1f ms = stop %.1f + gpu %.1f"
+                    " + capture %.1f (MAPS scan %.1f, GMEM copy %.1f); guest memory %.1f MB committed, %.1f MB"
+                    " non-zero; sealed in %.1f ms; staging %.0f MB; sections: %s\n",
+            s_rq.seq, (double)img->hdr.file_size / SS_MB, img->hdr.nsections, s_cap.stop_ms, stop > 0 ? stop : 0.0,
+            s_cap.gpu_ms, s_cap.capture_ms, m.scan_ms, m.copy_ms, (double)m.committed / SS_MB,
+            (double)m.nonzero / SS_MB, seal_ms, (double)ss_state_staging_bytes() / SS_MB, secs);
+    fflush(stderr);
+    if (s_rq.r.flags & SS_RQ_DUMP) dump_image(img, &m);
+    if (s_rq.r.flags & SS_RQ_HOLD) (void)ss_image_hold();   /* (a later LOAD's image: SS_SELFTEST_AB) */
+}
+
+/* A LOAD / SELFTEST that loaded: one line, the pause by phase and the
+ * fidelity check (each differing section with its first field). */
+static void load_done(void)
+{
+    const double stop = s_cap.stop_ms - s_lres.discard_ms - s_lres.teardown_ms - s_lres.restore_ms -
+                        s_lres.verify_ms - s_lres.recreate_ms - s_lres.release_ms -
+                        (s_cap.purpose == SS_P_SELFTEST ? s_cap.capture_ms + s_cap.gpu_ms : 0.0);
+    char vb[900];
+    int p = 0;
+    vb[0] = 0;
+    if (!s_lres.verified) snprintf(vb, sizeof vb, "fidelity check off");
+    else if (!s_lres.v.differ)
+        snprintf(vb, sizeof vb, "fidelity check: %u section(s) equal (%.1f ms)", s_lres.v.compared, s_lres.v.ms);
+    else {
+        char f4[5];
+        p = snprintf(vb, sizeof vb, "fidelity check: %u of %u section(s) DIFFER (%.1f ms):", s_lres.v.differ,
+                     s_lres.v.compared, s_lres.v.ms);
+        for (unsigned i = 0; i < s_lres.v.n && p > 0 && p < (int)sizeof vb - 80; i++) {
+            const ss_verify_sec* v = &s_lres.v.sec[i];
+            if (!v->diffs) continue;
+            p += snprintf(vb + p, sizeof vb - p, " %s x%u (%.*s);", ss_fourcc_str(v->fourcc, f4), v->diffs,
+                          120, v->first);
+        }
+    }
+    fprintf(stderr, "[ss] load request #%u (%s): loaded -- pause %.1f ms = stop %.1f%s + discard %.1f + teardown %.1f"
+                    " + restore %.1f + verify %.1f + recreate %.1f + release %.1f; %u PPU%s + %u SPU thread(s)"
+                    " resumed; %u section(s) without restore yet; %s\n",
+            s_rq.seq, s_cap.purpose == SS_P_SELFTEST ? "selftest round trip" : "load", s_cap.stop_ms,
+            stop > 0 ? stop : 0.0, "", s_lres.discard_ms, s_lres.teardown_ms, s_lres.restore_ms, s_lres.verify_ms,
+            s_lres.recreate_ms, s_lres.release_ms, s_lres.ppu, s_lres.main ? " + main" : "", s_lres.spu,
+            s_lres.norestore, vb);
+    if (s_cap.purpose == SS_P_SELFTEST)
+        fprintf(stderr, "[ss]   (selftest #%u: capture of state A %.1f ms, gpu %.1f ms, inside the stop)\n",
+                s_rq.seq, s_cap.capture_ms, s_cap.gpu_ms);
+    if (s_lres.verified)
+        for (unsigned i = 0; i < s_lres.v.n; i++) {
+            const ss_verify_sec* v = &s_lres.v.sec[i];
+            char f4[5];
+            if (v->diffs) fprintf(stderr, "[ss]   verify %s: %u difference(s), first: %s\n",
+                                  ss_fourcc_str(v->fourcc, f4), v->diffs, v->first);
+        }
+    fflush(stderr);
+}
+
+static void rq_complete(int ok, int reason, uint64_t now, uint64_t t_elig)
+{
+    const ss_request r = s_rq.r;
+    ss_request_result* o = &s_last;
+    memset(o, 0, sizeof *o);
+    o->purpose = r.purpose; o->ok = ok; o->reason = reason;
+    o->seq = s_rq.seq; o->attempts = s_rq.attempts; o->stopped_ms = s_rq.stopped_ms;
+    o->waited_ms = now > s_rq.t_submit ? (double)(now - s_rq.t_submit) / 1000.0 : 0.0;
+    o->eligible_ms = t_elig ? (double)(t_elig - s_rq.t_submit) / 1000.0 : -1.0;
+    if (reason != SS_REASON_OK && reason != SS_REASON_NOT_YET) {
+        snprintf(o->detail, sizeof o->detail, "%s", s_rq.detail);
+        snprintf(o->why, sizeof o->why, "%s", s_rq.why);
+    }
+    const int captured = ok && r.purpose == SS_P_SAVE && s_cap.captured;   /* (s_cap: its eligible stop) */
+    if (captured) {
+        const ss_image* img = ss_image_last() ? ss_image_last() : ss_image_held();
+        o->pause_ms = s_cap.stop_ms;
+        o->gpu_ms = s_cap.gpu_ms;
+        o->capture_ms = s_cap.capture_ms;
+        o->image_bytes = img ? img->hdr.file_size : 0;
+        s_pause[s_npause++ % SS_PAUSE_HIST] = (float)s_cap.stop_ms;
+    }
+    if (ok && s_cap.loaded && (r.purpose == SS_P_LOAD || r.purpose == SS_P_SELFTEST)) {
+        o->pause_ms = s_cap.stop_ms;
+        o->gpu_ms = s_cap.gpu_ms;
+        o->capture_ms = s_cap.capture_ms;
+        o->discard_ms = s_lres.discard_ms; o->teardown_ms = s_lres.teardown_ms;
+        o->restore_ms = s_lres.restore_ms; o->verify_ms = s_lres.verify_ms;
+        o->recreate_ms = s_lres.recreate_ms; o->release_ms = s_lres.release_ms;
+        o->verified = s_lres.verified;
+        o->verify_compared = s_lres.v.compared; o->verify_differ = s_lres.v.differ;
+        o->ppu_recreated = s_lres.ppu; o->spu_recreated = s_lres.spu; o->norestore = s_lres.norestore;
+    }
+    const int pi = (r.purpose > 0 && r.purpose < SS_P__N) ? r.purpose : 0;
+    if (pi) {
+        ss_request_stats* st = &s_rqs.p[pi];
+        st->done++;
+        st->attempts += s_rq.attempts;
+        if (ok) st->ok++;
+        else if (reason == SS_REASON_NOT_YET) st->not_yet++;
+        else { st->refused++; if (reason > 0 && reason < SS_REASON__N) st->by_reason[reason]++; }
+        if (o->eligible_ms > st->eligible_ms_max) st->eligible_ms_max = o->eligible_ms;
+        st->captured += (unsigned)captured;
+    }
+    if (r.purpose != SS_P_CENSUS) {
+        char el[48] = "never";
+        if (o->eligible_ms >= 0) snprintf(el, sizeof el, "%.1f ms", o->eligible_ms);
+        if (reason == SS_REASON_OK || reason == SS_REASON_NOT_YET)
+            fprintf(stderr, "[ss] request #%u %s: %s [%s], attempts %u (stopped %.1f ms), eligible after %s,"
+                            " waited %.1f ms\n", o->seq, purpose_name(r.purpose), ok ? "ok" : "not done",
+                    ss_reason_name(reason), o->attempts, o->stopped_ms, el, o->waited_ms);
+        else
+            fprintf(stderr, "[ss] request #%u %s: refused [%s] %s%s%s%s%s%s, attempts %u (stopped %.1f ms),"
+                            " eligible after %s, waited %.1f ms\n", o->seq, purpose_name(r.purpose),
+                    ss_reason_name(reason), ss_reason_text(reason), o->detail[0] ? " (" : "", o->detail,
+                    o->detail[0] ? ")" : "", o->why[0] && strcmp(o->why, o->detail) ? ": " : "",
+                    o->why[0] && strcmp(o->why, o->detail) ? o->why : "", o->attempts, o->stopped_ms,
+                    el, o->waited_ms);
+    }
+    if (r.purpose == SS_P_CENSUS) co.t_census = now + (uint64_t)(s_cfg.period_s * 1e6);
+    InterlockedExchange(&s_rq.state, RQ_FREE);
+    if (r.done) r.done(ok, reason, r.user);
+    if (r.purpose != SS_P_CENSUS) ss_request_summary("so far");   /* (ExitProcess skips the atexit one) */
+    fflush(stderr);
+}
+
+/* A request still waiting when the engine is disarmed. */
+static void rq_cancel(int reason)
+{
+    const long st = s_rq.state;
+    if (st == RQ_QUEUED || st == RQ_ACTIVE) rq_complete(0, reason, ss_now_us(), 0);
+}
+
+static void rq_take(uint64_t now)
+{
+    if (InterlockedCompareExchange(&s_rq.state, RQ_ACTIVE, RQ_QUEUED) != RQ_QUEUED) return;
+    s_rq.t_take = now;
+    s_rq.attempts = 0;
+    s_rq.stopped_ms = 0;
+    s_rq.reason = s_rq.pre_reason = SS_REASON_OK;
+    s_rq.detail[0] = 0;
+    s_rq.why[0] = 0;
+    co.retries = 0;
+    co.t_next = now;                                  /* its first stop at the next flip */
+}
+
+/* A stop of the active request is over (released). */
+static void rq_attempt_done(uint64_t now, int converged, int reason)
+{
+    if (s_rq.state != RQ_ACTIVE) return;              /* cancelled meanwhile */
+    const int p = s_rq.r.purpose;
+    if (p == SS_P_CENSUS) {
+        if (converged) { rq_complete(1, SS_REASON_OK, now, now); return; }
+        if (co.retries < s_cfg.retries) { co.retries++; co.t_next = now; return; }   /* again at the next flip */
+        rq_complete(0, reason ? reason : SS_REASON_THREAD_BUSY, now, 0);
+        return;
+    }
+    if (reason == SS_REASON_OK) {
+        /* The stop was eligible. A SAVE was captured in it (M4b): seal and
+         * report it, the game running again. Restore (M4c) takes over the
+         * rest from this point. */
+        if (p == SS_P_SAVE) {
+            save_done(now);
+            rq_complete(1, SS_REASON_OK, now, now);
+            return;
+        }
+        if ((p == SS_P_LOAD || p == SS_P_SELFTEST) && s_cap.loaded) {
+            load_done();
+            rq_complete(1, SS_REASON_OK, now, now);
+            return;
+        }
+        static const char* const k_next[SS_P__N] = { "", "", "", ("no image to load, or no thread recreation"
+                                                     " in this build"), "holding: not built yet",
+                                                     "no thread recreation in this build" };
+        fprintf(stderr, "[ss] %s request: %s OK (%s)\n", purpose_name(p), p == SS_P_LOAD ? "lenient" : "strict",
+                k_next[p]);
+        rq_complete(0, SS_REASON_NOT_YET, now, now);
+        return;
+    }
+    /* Not eligible, or not converged: the next stop no sooner than retry_gap
+     * times this one's length after it (the next flip at the earliest), so a
+     * refused request keeps the game stopped at most 1/(retry_gap+1) of its
+     * retry window -- 35-40 ms stops at every 17 ms flip would run the game
+     * at a third of its speed. Done once that next stop is past give_up_s. */
+    const uint64_t gap = (uint64_t)(s_cap.stop_ms * 1000.0 * (double)s_cfg.retry_gap);
+    if ((double)(now + gap - s_rq.t_submit) >= s_rq.r.give_up_s * 1e6) rq_complete(0, reason, now, 0);
+    else co.t_next = now + gap;
+}
+
+/* Before each stop of a request: the blockers that need no stop (world_check:
+ * the debug switch, booting, the added checks, the transitions), read with
+ * the world running. While one blocks there is no stop -- it would freeze
+ * the game only to learn what is already known -- and the pre-check runs
+ * again at the next flip until give_up_s; a debug switch (fixed at startup)
+ * refuses at once. Advisory: a stop that starts is judged again with
+ * everything parked. A census has none (it measures the stop itself).
+ * Returns 1: start the stop. */
+static int rq_precheck(uint64_t now)
+{
+    if (s_rq.r.purpose == SS_P_CENSUS) return 1;
+    int reason = world_check();
+    const int p = s_rq.r.purpose;
+    /* the capture order (SS1): every registered section, once. It does not get
+     * better, so a broken one ends the request here, with no stop -- a save
+     * would write an image without some sections, a load tear down and restore
+     * without them (load_checks checks again inside the stop) */
+    if (reason == SS_REASON_OK) {
+        char why[160];
+        why[0] = 0;
+        if (ss_state_order_check(why, sizeof why)) {
+            rq_complete(0, blocked(SS_REASON_NOT_RESUMABLE, "the save-state engine", "%s", why), now, 0);
+            return 0;
+        }
+    }
+    if (reason == SS_REASON_OK && (p == SS_P_SAVE || p == SS_P_SELFTEST)) {
+        /* the staging buffer grows here, never inside the stop (M4b) */
+        char why[160];
+        why[0] = 0;
+        if (ss_state_prepare(why, sizeof why) != SS_OK) reason = blocked(SS_REASON_CAPTURE, "memory", "%s", why);
+    }
+    if (reason == SS_REASON_OK && (p == SS_P_LOAD || p == SS_P_SELFTEST)) {
+        /* M4c: no load from inside the window's modal loop (critique #4) */
+        if (s_host.in_modal && s_host.in_modal())
+            reason = blocked(SS_REASON_THREAD_BUSY, "the window", "the window is in a modal loop (a drag or a menu)");
+        /* the image a LOAD carries, once per request: CRCs, every record,
+         * every layout this build has (ss_image_validate), then PPUT's own
+         * check (every thread it resumes parked in a resumable kind), then
+         * every section's check_image (a file changed on disk, ...) */
+        if (reason == SS_REASON_OK && p == SS_P_LOAD && s_rq.r.image && !s_rq.validated) {
+            char why[192];
+            why[0] = 0;
+            if (ss_image_validate_ex(s_rq.r.image, !(s_rq.r.flags & SS_RQ_CRC_CHECKED), why, sizeof why) != SS_OK)
+                reason = blocked(SS_REASON_IMAGE, "the image", "%s", why);
+            else if (s_ppu_image_check && s_ppu_image_check(s_rq.r.image, why, sizeof why))
+                reason = blocked(SS_REASON_NOT_RESUMABLE, "the image", "%s", why);
+            else if (ss_state_check_image(s_rq.r.image, why, sizeof why, NULL) != SS_OK)
+                reason = blocked(SS_REASON_IMAGE, "the image", "%s", why);   /* (a section's check_image) */
+            if (reason == SS_REASON_OK) s_rq.validated = 1;
+            else { rq_complete(0, reason, now, 0); return 0; }   /* (an image does not get better) */
+        }
+        /* the fidelity check captures into the bank the image does not use */
+        if (reason == SS_REASON_OK && rq_verify()) {
+            char why[160];
+            why[0] = 0;
+            if (ss_state_prepare_spare(why, sizeof why) != SS_OK)
+                reason = blocked(SS_REASON_CAPTURE, "memory", "%s", why);
+        }
+    }
+    if (reason == SS_REASON_OK) { s_rq.pre_reason = SS_REASON_OK; return 1; }
+    if (reason != s_rq.pre_reason) {                  /* once per blocker, not per flip */
+        s_rq.pre_reason = reason;
+        const int dw = strcmp(s_rq.why, s_rq.detail) != 0;
+        fprintf(stderr, "[ss] %s #%u t=%.1fs: no stop: %s%s%s%s%s%s\n", purpose_name(s_rq.r.purpose), s_rq.seq,
+                (double)(now - co.t_init) / 1e6, ss_reason_name(reason), s_rq.detail[0] ? " (" : "",
+                s_rq.detail, s_rq.detail[0] ? ")" : "", dw ? " " : "", dw ? s_rq.why : "");
+        fflush(stderr);
+    }
+    if (reason == SS_REASON_DEBUG_SWITCH || (double)(now - s_rq.t_submit) >= s_rq.r.give_up_s * 1e6)
+        rq_complete(0, reason, now, 0);
+    else co.t_next = now;                             /* again at the next flip */
+    return 0;
+}
+
+/* ---- request sources: SS_SAVE_AT, SS_DUMP and the census --------------------- */
+static void at_done(const char* src, double t, int ok, int reason)
+{
+    ss_request_result o;
+    ss_last_request(&o);
+    if (ok)
+        fprintf(stderr, "[ss] %s t=%.1f -> ok: captured %.1f MB, pause %.1f ms (gpu %.1f, capture %.1f),"
+                        " attempts %u, waited %.0f ms\n", src, t, (double)o.image_bytes / SS_MB, o.pause_ms,
+                o.gpu_ms, o.capture_ms, o.attempts, o.waited_ms);
+    else
+        fprintf(stderr, "[ss] %s t=%.1f -> refused: %s%s%s%s [%s], attempts %u, waited %.0f ms\n",
+                src, t, ss_reason_text(reason), o.detail[0] ? " (" : "", o.detail, o.detail[0] ? ")" : "",
+                ss_reason_name(reason), o.attempts, o.waited_ms);
+    fflush(stderr);
+}
+static ss_save_at_sink_fn s_save_at_sink;
+void ss_set_save_at_sink(ss_save_at_sink_fn fn) { s_save_at_sink = fn; }
+static void sat_done(int ok, int reason, void* user)
+{
+    const int i = (int)(intptr_t)user;
+    const double t = (i >= 0 && i < s_cfg.n_save_at) ? s_cfg.save_at[i] : -1.0;
+    at_done("SS_SAVE_AT", t, ok, reason);
+    if (s_save_at_sink) s_save_at_sink(ok, reason, t);   /* (M5: SS_SAVE_SLOT writes it to a slot) */
+}
+static void dump_done(int ok, int reason, void* user)
+{
+    const int i = (int)(intptr_t)user;
+    at_done("SS_DUMP", (i >= 0 && i < s_cfg.n_dump_at) ? s_cfg.dump_at[i] : -1.0, ok, reason);
+}
+
+/* SS_SELFTEST_EVERY / SS_SELFTEST_AB (M4c): what the selftest requests
+ * report, and when the next is due. A round trip (SELFTEST) or the LOAD of
+ * an A-B pair: its load line is load_done's; this adds the outcome. */
+static void selftest_done(int ok, int reason, void* user)
+{
+    const int kind = (int)(intptr_t)user;            /* 0 round trip, 1 AB capture, 2 AB load */
+    const uint64_t now = ss_now_us();
+    ss_request_result o;
+    ss_last_request(&o);
+    if (kind == 1) {                                  /* A captured and held: load it s seconds later */
+        if (ok && ss_image_held()) co.ab_phase = 1;
+        co.t_selftest = now + (uint64_t)(s_cfg.selftest_ab_s * 1e6);
+        fprintf(stderr, "[ss] selftest A-B #%u: state A %s%s%s; loading it in %.1f s\n", o.seq,
+                ok ? "captured and held" : "NOT captured: ", ok ? "" : ss_reason_name(reason),
+                ok ? "" : " (retry)", s_cfg.selftest_ab_s);
+    } else {
+        co.ab_phase = 0;
+        co.t_selftest = now + (uint64_t)((kind == 2 ? s_cfg.selftest_ab_s : s_cfg.selftest_every_s) * 1e6);
+        fprintf(stderr, "[ss] selftest %s #%u: %s%s%s%s pause %.1f ms (restore %.1f, verify %.1f)%s\n",
+                kind == 2 ? "A-B load" : "round trip", o.seq, ok ? "ok" : "refused: ",
+                ok ? "" : ss_reason_name(reason), ok ? "" : " ", ok ? "" : o.why, o.pause_ms, o.restore_ms,
+                o.verify_ms, !ok ? "" : !o.verified ? ", no fidelity check" :
+                o.verify_differ ? ", fidelity check: sections differ (see the load line)" : ", fidelity check: equal");
+    }
+    fflush(stderr);
+}
+
+static void sources_tick(uint64_t now)
+{
+    if ((s_cfg.selftest_every_s > 0 || s_cfg.selftest_ab_s > 0) && co.t_first_flip && now >= co.t_selftest) {
+        ss_request r;
+        memset(&r, 0, sizeof r);
+        r.slot = -1;
+        r.done = selftest_done;
+        r.give_up_s = 10.0;
+        if (s_cfg.selftest_every_s > 0) {
+            r.purpose = SS_P_SELFTEST;
+            r.flags = SS_RQ_VERIFY;
+            r.user = (void*)(intptr_t)0;
+        } else if (co.ab_phase == 0) {
+            r.purpose = SS_P_SAVE;
+            r.flags = SS_RQ_HOLD;
+            r.user = (void*)(intptr_t)1;
+        } else {
+            r.purpose = SS_P_LOAD;
+            r.flags = SS_RQ_VERIFY;
+            r.image = ss_image_held();
+            r.user = (void*)(intptr_t)2;
+        }
+        if (ss_request_submit(&r) == SS_R_QUEUED) {
+            co.selftests++;
+            co.t_selftest = ~0ull;                    /* (done sets the next one) */
+            return;
+        }
+    }
+    if (co.sat_next < s_cfg.n_save_at &&
+        now >= co.t_init + (uint64_t)(s_cfg.save_at[co.sat_next] * 1e6)) {
+        ss_request r;
+        memset(&r, 0, sizeof r);
+        r.purpose = SS_P_SAVE;
+        r.slot = -1;
+        r.done = sat_done;
+        r.user = (void*)(intptr_t)co.sat_next;
+        if (ss_request_submit(&r) == SS_R_QUEUED) co.sat_next++;
+        return;
+    }
+    if (co.dump_next < s_cfg.n_dump_at &&
+        now >= co.t_init + (uint64_t)(s_cfg.dump_at[co.dump_next] * 1e6)) {
+        ss_request r;
+        memset(&r, 0, sizeof r);
+        r.purpose = SS_P_SAVE;
+        r.slot = -1;
+        r.flags = SS_RQ_DUMP;
+        r.done = dump_done;
+        r.user = (void*)(intptr_t)co.dump_next;
+        if (ss_request_submit(&r) == SS_R_QUEUED) co.dump_next++;
+        return;
+    }
+    if (s_cfg.period_s > 0 && now >= co.t_census) {   /* (the next one is due period_s after this one is done) */
+        ss_request r;
+        memset(&r, 0, sizeof r);
+        r.purpose = SS_P_CENSUS;
+        r.slot = -1;
+        (void)ss_request_submit(&r);
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * Coordinator
+ * -----------------------------------------------------------------------*/
+static int roster_parked(int* total)
+{
+    int t = 0, p = 0;
+    for (int i = 0; i < PPU_THREAD_MAX; i++) {
+        const int st = g_ppu_threads[i].state;
+        if (st != PPU_THREAD_STATE_RUNNING && st != PPU_THREAD_STATE_DETACHED) continue;
+        t++;
+        const ss_thr* r = &s_thr[i + 1];
+        if (r->state == 1 && r->gen == s_gen) p++;
+    }
+    *total = t;
+    return p;
+}
+
+static void release_spu(void)
+{
+    if (!co.spu_req) return;
+    AcquireSRWLockExclusive(&s_lk);
+    InterlockedExchange(&g_ss_spu_req, 0);
+    InterlockedIncrement(&s_spu_gen);
+    ReleaseSRWLockExclusive(&s_lk);
+    WakeAllConditionVariable(&s_cv);
+    if (s_spu_ops && s_spu_ops->force_hops) s_spu_ops->force_hops(0);
+    co.spu_req = 0;
+}
+
+static void release_ppu_and_mixer(void)
+{
+    ss_time_thaw();                       /* guest time goes on (a save froze it; else nothing) */
+    AcquireSRWLockExclusive(&s_lk);
+    InterlockedExchange(&g_ss_req, 0);
+    InterlockedIncrement(&s_gen);
+    InterlockedExchange(&g_ss_mix_req, 0);
+    InterlockedIncrement(&s_mix_gen);
+    s_stop_t0 = 0;
+    InterlockedExchange(&s_co_capturing, 0);
+    ReleaseSRWLockExclusive(&s_lk);
+    WakeAllConditionVariable(&s_cv);
+}
+
+int ss_stop_in_progress(void) { return co.st != CO_IDLE; }
+
+static void release_all(void)
+{
+    release_spu();
+    release_ppu_and_mixer();
+    co.st = CO_IDLE;
+}
+
+static void begin_attempt(uint64_t now)
+{
+    memset(&s_cap, 0, offsetof(ss_capture, thr));
+    s_st.stops++;
+    s_cap.purpose = s_rq.r.purpose;
+    s_cap.attempt = s_cap.purpose == SS_P_CENSUS ? ++s_st.started : s_rq.seq;   /* census #N / request #N */
+    s_rq.attempts++;
+    s_stop_t0 = now;
+    s_cap.t_s = (double)(now - co.t_init) / 1e6;
+    s_spu_foreign = 0; s_spu_foreign_ctx = 0;
+    s_unreg_visits = 0;
+    co.t_attempt = now;
+    s_cap.mix_live = s_mix_live ? 1 : 0;
+    if (s_cap.mix_live) {
+        InterlockedExchange(&g_ss_mix_req, 1);
+        co.t_mix = now;
+        co.st = CO_MIXER;
+    } else {
+        co.t_ppu = now;
+        InterlockedExchange(&g_ss_req, 1);
+        co.st = CO_PPU;
+    }
+}
+
+static void begin_ppu(uint64_t now)
+{
+    s_cap.mix_parked = (s_mix.state == 1 && s_mix.gen == s_mix_gen) ? 1 : 0;
+    if (s_cap.mix_live) {
+        s_cap.mixer_ms = (double)(now - co.t_mix) / 1000.0;
+        if (s_cap.mix_parked) { s_cap.mix_fill = s_mix.fill; s_cap.mix_cap = s_mix.cap; }
+        else if (s_cap.purpose == SS_P_CENSUS) s_st.mixer_late++;
+    }
+    co.t_ppu = now;
+    co.t_tier2 = 0;
+    InterlockedExchange(&g_ss_req, 1);
+    co.st = CO_PPU;
+}
+
+static void walker_drain(void)
+{
+    const uint64_t t0 = ss_now_us();
+    s_cap.walker_passes = 0; s_cap.walker_idle = 0;
+    if (s_host.walker_info) s_host.walker_info(&s_cap.w0);
+    s_cap.w1 = s_cap.w0;
+    if (s_host.walker_pass && s_host.walker_info) {
+        for (;;) {
+            ss_walker_info a, z;
+            s_host.walker_info(&a);
+            if (a.get == a.put) { s_cap.walker_idle = 1; break; }
+            if (ss_now_us() - t0 > (uint64_t)s_cfg.walker_ms * 1000ull || s_cap.walker_passes >= 64) break;
+            s_host.walker_pass();
+            s_cap.walker_passes++;
+            s_host.walker_info(&z);
+            if (z.get == a.get && z.put == a.put && s_cap.walker_passes > 1) break;   /* parked / acquire */
+        }
+        s_host.walker_info(&s_cap.w1);
+    }
+    s_cap.walker_ms = (double)(ss_now_us() - t0) / 1000.0;
+}
+
+static int spu_park_all(void)
+{
+    s_cap.spu_on = s_cfg.spu;
+    if (!s_cfg.spu) return 1;
+    int reg = 0;
+    for (int i = 0; i < SS_SPU_MAX; i++) if (s_spu[i].used == 1) reg++;
+    if (!reg) return 1;
+    const uint64_t t0 = ss_now_us();
+    if (s_spu_ops && s_spu_ops->force_hops) s_spu_ops->force_hops(1);
+    InterlockedExchange(&g_ss_spu_req, 1);
+    co.spu_req = 1;
+    int ok = 0;
+    for (unsigned spins = 0;; spins++) {
+        int n = 0, p = 0;
+        for (int i = 0; i < SS_SPU_MAX; i++) {
+            const ss_spu_slot* s = &s_spu[i];
+            if (s->used != 1) continue;
+            n++;
+            if (s->state == 1 && s->gen == s_spu_gen) p++;
+        }
+        if (p == n) { ok = 1; break; }
+        if (ss_now_us() - t0 > (uint64_t)s_cfg.spu_timeout_ms * 1000ull) break;
+        if (spins < 200) SwitchToThread(); else Sleep(1);
+    }
+    capture_spu(t0);
+    double mx = 0;
+    for (int k = 0; k < s_cap.nspu; k++) if (s_cap.spu[k].parked && s_cap.spu[k].ms > mx) mx = s_cap.spu[k].ms;
+    s_cap.spu_ms = ok ? mx : (double)(ss_now_us() - t0) / 1000.0;
+    return ok;
+}
+
+/* A stop is over (everything released): the census's statistics and report,
+ * or the request's attempt line, then the request decides what is next. */
+static void finish(uint64_t now, int ok, const char* why, int reason)
+{
+    s_cap.ok = ok;
+    s_cap.why = why;
+    s_cap.stop_ms = (double)(now - co.t_attempt) / 1000.0;
+    if (s_rq.state == RQ_ACTIVE) s_rq.stopped_ms += s_cap.stop_ms;
+    if (now > co.t_attempt) co.stopped_us += now - co.t_attempt;   /* (not play time) */
+    if (s_cap.purpose == SS_P_CENSUS) {
+        s_st.attempts++;
+        const unsigned k = s_st.n % SS_HIST;
+        if (ok) {
+            s_st.ok++;
+            s_st.censuses++;
+            if (s_cap.ppu_ms <= 500.0) s_st.within_500++;
+            s_st.ppu[k] = (float)s_cap.ppu_ms;
+            s_st.stop[k] = (float)s_cap.stop_ms;
+            s_st.n++;
+            if (s_cap.strict_n && s_cap.strict_n == s_cap.parked && s_cap.strict_ok == s_cap.strict_n)
+                s_st.strict_stops++;
+        }
+        for (int i = 0; i < s_cap.nthr; i++) {
+            const ss_cap_thr* c = &s_cap.thr[i];
+            ss_thr* r = &s_thr[c->tid];
+            if (c->parked) {
+                r->n_parks++; if (c->tier < 2) r->n_tier1++;
+                r->sum_ms += c->ms; if (c->ms > r->max_ms) r->max_ms = c->ms;
+            } else r->n_straggler++;
+        }
+        report();
+        write_chains();
+    } else {
+        attempt_line(reason);
+    }
+    co.st = CO_IDLE;
+    rq_attempt_done(now, ok, reason);
+}
+
+static void stop_converged(void)
+{
+    /* everything below is synchronous on the frame-clock thread: the walker
+     * runs only here, so it is parked by construction until we return */
+    walker_drain();
+    const int spu_ok = spu_park_all();
+    capture_threads(co.t_ppu);                        /* chains read with everything stopped */
+    s_cap.unreg_visits = s_unreg_visits;
+    /* The other purposes: is this stop one a save (strict) or a load
+     * (lenient) can use? Judged now, with everything still parked. */
+    int reason = SS_REASON_OK;
+    const int p = s_cap.purpose;
+    if (p != SS_P_CENSUS) reason = eligibility(p != SS_P_LOAD, spu_ok);
+    /* An eligible SAVE is captured now, still stopped (M4b). */
+    if (reason == SS_REASON_OK && p == SS_P_SAVE) reason = save_capture();
+    /* An eligible LOAD / SELFTEST that this build can run (thread recreation
+     * registered; a LOAD with an image): the load's own checks; a SELFTEST
+     * then captures state A and holds it, a LOAD flushes the renderer and
+     * waits for the GPU -- then the load itself, from the discard (the point
+     * of no return) to the release (M4c). Otherwise "not yet" as before. */
+    const ss_image* img = NULL;
+    int do_load = 0;
+    stop_gens lg;                                     /* the stop a load runs in (the watchdog can end it) */
+    lg.gen = s_gen; lg.spu_gen = s_spu_gen; lg.mix_gen = s_mix_gen;
+    if (reason == SS_REASON_OK && (p == SS_P_LOAD || p == SS_P_SELFTEST) && s_ppu_recreate && s_sr_ops.run &&
+        (p == SS_P_SELFTEST || s_rq.r.image)) {
+        reason = load_checks();
+        if (reason == SS_REASON_OK && p == SS_P_SELFTEST) {
+            reason = save_capture();
+            if (reason == SS_REASON_OK && !(img = ss_image_hold()))
+                reason = blocked(SS_REASON_CAPTURE, "capture", "the captured state could not be held");
+            char why[192];
+            why[0] = 0;
+            if (reason == SS_REASON_OK && s_ppu_image_check && s_ppu_image_check(img, why, sizeof why))
+                reason = blocked(SS_REASON_NOT_RESUMABLE, "state A", "%s", why);
+        } else if (reason == SS_REASON_OK) {
+            img = s_rq.r.image;
+            InterlockedExchange(&s_co_capturing, 1);  /* the watchdog's grace for the GPU flush, as a save's */
+            const uint64_t t0 = ss_now_us();
+            const int idle = s_host.gpu_idle ? s_host.gpu_idle() : 0;
+            s_cap.gpu_ms = (double)(ss_now_us() - t0) / 1000.0;
+            if (idle < 0)
+                reason = blocked(SS_REASON_GPU, "GPU", "the GPU did not go idle (its fence wait gave up after %.0f ms)",
+                                 s_cap.gpu_ms);
+            else if (!stop_intact(&lg))
+                reason = blocked(SS_REASON_CAPTURE, "watchdog", "the stop's watchdog released every thread during the"
+                                 " load's GPU flush (%.0f ms): nothing discarded", s_cap.gpu_ms);
+        }
+        do_load = reason == SS_REASON_OK;
+        if (!do_load && p == SS_P_SELFTEST) ss_image_release();
+    }
+    if (g_ss_on_capture && g_ss_req) g_ss_on_capture(g_ss_on_capture_user);   /* (not after the watchdog) */
+    /* From here the watchdog stops counting: the stop found intact and
+     * s_loading set together, under the lock its park loops hold while they
+     * check -- a stop it released is never loaded into. (After the census
+     * hook: s_loading makes parks read as the load's.) */
+    if (do_load) {
+        AcquireSRWLockExclusive(&s_lk);
+        const int intact = g_ss_req != 0 && s_gen == lg.gen && s_spu_gen == lg.spu_gen && s_mix_gen == lg.mix_gen;
+        if (intact) InterlockedExchange(&s_loading, 1);
+        ReleaseSRWLockExclusive(&s_lk);
+        if (!intact) {
+            do_load = 0;
+            reason = blocked(SS_REASON_CAPTURE, "watchdog", "the stop's watchdog released every thread before the"
+                             " load began: nothing discarded");
+            if (p == SS_P_SELFTEST) ss_image_release();
+        }
+    }
+    if (do_load) {
+        load_run(img, rq_verify());                   /* returns released (a failure never returns) */
+        if (p == SS_P_SELFTEST) ss_image_release();
+        s_cap.loaded = 1;
+        finish(ss_now_us(), 1, "", SS_REASON_OK);
+        return;
+    }
+    ss_time_thaw();                                   /* (before any SPU reads the clock again) */
+    const uint64_t t_rel = ss_now_us();
+    release_spu();
+    if (s_host.walker_rebase) s_host.walker_rebase((t_rel - co.t_attempt + 999) / 1000);
+    release_ppu_and_mixer();
+    if (s_cap.purpose == SS_P_CENSUS && !spu_ok) {
+        s_st.fail_spu++;
+        reason = blocked(SS_REASON_SPU_BUSY, "SPU", "spu-timeout");
+    }
+    finish(t_rel, spu_ok, spu_ok ? "" : "spu-timeout", reason);
+}
+
+static void stop_abort(const char* why)
+{
+    if (s_host.walker_info) s_host.walker_info(&s_cap.w1);
+    capture_threads(co.t_ppu);                        /* parked chains + stragglers */
+    s_cap.unreg_visits = s_unreg_visits;
+    const int reason = abort_reason();
+    const uint64_t t_rel = ss_now_us();
+    release_ppu_and_mixer();
+    if (s_host.walker_rebase) s_host.walker_rebase((t_rel - co.t_attempt + 999) / 1000);
+    if (s_cap.purpose == SS_P_CENSUS) s_st.fail_ppu++;
+    finish(t_rel, 0, why, reason);
+}
+
+unsigned ss_flip_count(void) { return co.last_flip; }
+
+void ss_frame_tick(unsigned flip_count)
+{
+    /* Save / load requests from the window menu and hotkeys (ss_ui.h): taken
+     * here, at the frame clock's step, never in the window procedure. */
+    if (g_ss_ui_pending && !co.reentry) {
+        co.reentry = 1;
+        ss_ui_service(flip_count);
+        co.reentry = 0;
+    }
+    if (!g_ss_armed) {
+        /* disarmed with a request still queued (a submit that raced ss_configure) */
+        if (s_rq.state == RQ_QUEUED && !co.reentry) rq_complete(0, SS_REASON_OFF, ss_now_us(), 0);
+        return;
+    }
+    if (co.reentry) return;
+    const int flipped = flip_count != co.last_flip;
+    co.last_flip = flip_count;
+    if (SS_UNLIKELY(!co.t_first_flip) && flip_count) co.t_first_flip = ss_now_us();   /* play time */
+    /* Armed and idle -- the common case, every iteration: no request, no
+     * request source. (The flip count is kept, so a request still starts
+     * right after a flip.) */
+    if (co.st == CO_IDLE && s_rq.state == RQ_FREE && s_cfg.period_s <= 0 && co.sat_next >= s_cfg.n_save_at &&
+        co.dump_next >= s_cfg.n_dump_at && s_cfg.selftest_every_s <= 0 && s_cfg.selftest_ab_s <= 0)
+        return;
+    co.reentry = 1;
+    const uint64_t now = ss_now_us();
+    switch (co.st) {
+    case CO_IDLE:
+        if (s_rq.state == RQ_FREE) sources_tick(now);
+        if (s_rq.state == RQ_QUEUED) rq_take(now);
+        if (s_rq.state == RQ_ACTIVE && now >= co.t_next &&
+            (flipped || now - co.t_next >= (uint64_t)s_cfg.noflip_ms * 1000ull) && rq_precheck(now))
+            begin_attempt(now);
+        break;
+    case CO_MIXER:
+        if ((s_mix.state == 1 && s_mix.gen == s_mix_gen) || !s_mix_live ||
+            now - co.t_mix >= (uint64_t)s_cfg.mixer_timeout_ms * 1000ull)
+            begin_ppu(now);
+        break;
+    case CO_PPU: {
+        int total = 0;
+        const int parked = roster_parked(&total);
+        const uint64_t el = now - co.t_ppu;
+        if (parked == total) { stop_converged(); break; }
+        if (g_ss_req == 1 && el >= (uint64_t)s_cfg.tier1_ms * 1000ull) {
+            InterlockedExchange(&g_ss_req, 2);
+            co.t_tier2 = now;
+        }
+        if (el >= (uint64_t)s_cfg.timeout_ms * 1000ull) stop_abort("ppu-timeout");
+        break; }
+    }
+    co.reentry = 0;
+}
+
+/* ===========================================================================
+ * P0: per-thread self-resume (SS_SELFRESUME; see ss_core.h)
+ *
+ * A requested thread (its bit in g_ss_sr_mask) that reaches an S1/S2 entry
+ * with nothing nested above its own root -- no guest callback, no libsre
+ * bridge, no trampoline pending, on the root's own context -- asks the PPU
+ * half (ss_sr_ops.check: runtime/ppu/ppu_selfresume.cpp) whether its guest
+ * chain can be rebuilt from the continuation table. If it can, it copies its
+ * context (the call's ENTRY context) and longjmps to its root, which discards
+ * every host frame above the root. The root resets the host thread-local
+ * state those frames held and calls ss_root_resume: restore the copy,
+ * re-issue the call, run the continuations up to the root (ss_sr_ops.run).
+ * Not touched: guest memory, other threads, kernel objects.
+ *
+ * Threads: the timer thread raises requests; each guest thread consumes its
+ * own and is the only writer of its record's counters (the timer writes only
+ * requests / overdue / t_req, the summary reads everything unlocked).
+ * =========================================================================*/
+volatile int       g_ss_sr_on   = 0;
+volatile long long g_ss_sr_mask = 0;
+
+void ss_set_sr_ops(const ss_sr_ops* o) { if (o) s_sr_ops = *o; }   /* (s_sr_ops: above) */
+
+int ss_cont_covered(uint32_t ra, int* noreturn)
+{
+    if (noreturn) *noreturn = 0;
+    if (!s_sr_ops.cont_lookup) return -1;
+    if (s_sr_ops.cont_lookup(ra, noreturn)) return 1;
+    if (s_ppu.is_code && !s_ppu.is_code(ra)) return 2;   /* not lifted code: past the chain's root */
+    return 0;
+}
+
+static struct {
+    unsigned           period_ms;
+    unsigned long long sel;          /* selected tids, bit tid-1 */
+    double             start_s;
+    long               log_n;
+    uint64_t           t0;
+    int                at_root;      /* SS_SELFRESUME_ATROOT: request each selected thread at its root */
+} s_srcfg;
+static volatile long      s_sr_timer_started;
+static volatile long long s_sr_rooted;          /* tids that have a root (bit tid-1) */
+
+typedef struct ss_root_rec {
+    void*               jb;                     /* jmp_buf* of the root's setjmp */
+    struct ppu_context* ctx;                    /* the thread's own context */
+    ss_sr_root          r;
+} ss_root_rec;
+static PPU_THREAD_LOCAL ss_root_rec t_root;
+
+typedef struct ss_sr_thr {
+    ppu_context snap;                           /* entry context of the call it resumes with */
+    int      at, frames, icall, vcall;
+    uint32_t num, ra;
+    volatile uint64_t t_req;                    /* when the pending request was raised; 0 none */
+    uint64_t t_req_taken, t_park;
+    unsigned requests, resumes, overdue, roots, ctx_changed;
+    unsigned skip[SS_SR__N];
+    unsigned refused[16];
+    double   lat_sum_ms, lat_max_ms;
+    unsigned long long frames_sum;
+    int      frames_max, icall_max;
+    uintptr_t host_sp0;
+    unsigned long long host_sp_drift;
+} ss_sr_thr;
+static ss_sr_thr s_sr[SS_MAX_TID + 1];
+
+static void sr_or(volatile long long* p, unsigned long long b)
+{
+#ifdef _WIN32
+    InterlockedOr64((volatile LONG64*)p, (LONG64)b);
+#else
+    __atomic_fetch_or((long long*)p, (long long)b, __ATOMIC_SEQ_CST);
+#endif
+}
+static void sr_and(volatile long long* p, unsigned long long b)
+{
+#ifdef _WIN32
+    InterlockedAnd64((volatile LONG64*)p, (LONG64)b);
+#else
+    __atomic_fetch_and((long long*)p, (long long)b, __ATOMIC_SEQ_CST);
+#endif
+}
+
+/* ---- requests ------------------------------------------------------------ */
+void ss_sr_request(unsigned tid)
+{
+    if (!g_ss_sr_on || tid == 0 || tid > SS_MAX_TID) return;
+    const unsigned long long b = 1ull << (tid - 1);
+    if ((unsigned long long)g_ss_sr_mask & b) { s_sr[tid].overdue++; return; }
+    s_sr[tid].requests++;
+    s_sr[tid].t_req = ss_now_us();
+    sr_or(&g_ss_sr_mask, b);
+}
+
+static void sr_request_all(void)
+{
+    const unsigned long long want = (unsigned long long)s_sr_rooted & s_srcfg.sel;
+    if (!want) return;
+    for (unsigned t = 1; t <= SS_MAX_TID; t++)
+        if (want & (1ull << (t - 1))) ss_sr_request(t);
+}
+
+#ifdef _WIN32
+static DWORD WINAPI sr_timer_proc(LPVOID arg)
+#else
+static void* sr_timer_proc(void* arg)
+#endif
+{
+    (void)arg;
+    const uint32_t n = s_sr_ops.count ? s_sr_ops.count() : 0;
+    fprintf(stderr, "[ss] self-resume: %u continuation(s) registered%s\n", n,
+            !s_sr_ops.run ? " -- NO PPU HALF (runtime/ppu/ppu_selfresume.cpp is not in this build):"
+                            " nothing will resume"
+            : n ? "" : " -- NONE: relift with --cont-list config/ss_cont_list.txt; every thread"
+                       " will be skipped as not-covered");
+    fflush(stderr);
+    const uint64_t t_start = s_srcfg.t0 + (uint64_t)(s_srcfg.start_s * 1e6);
+    uint64_t next_sum = ss_now_us() + 10000000ull;
+    for (;;) {
+        Sleep(s_srcfg.period_ms ? s_srcfg.period_ms : 1000);
+        const uint64_t now = ss_now_us();
+        if (s_srcfg.period_ms && now >= t_start) sr_request_all();
+        if (now >= next_sum) {
+            next_sum = now + 10000000ull;
+            ss_sr_summary("periodic");
+        }
+    }
+}
+
+static void sr_atexit(void) { ss_sr_summary("exit"); }
+
+static void sr_timer_start(void)
+{
+    if (InterlockedCompareExchange(&s_sr_timer_started, 1, 0) != 0) return;
+    atexit(sr_atexit);
+#ifdef _WIN32
+    HANDLE h = CreateThread(NULL, 64 * 1024, sr_timer_proc, NULL, 0, NULL);
+    if (h) CloseHandle(h);
+#else
+    pthread_t th;
+    if (pthread_create(&th, NULL, sr_timer_proc, NULL) == 0) pthread_detach(th);
+#endif
+}
+
+void ss_sr_configure(unsigned period_ms, unsigned long long tid_mask, double start_s, long log_n)
+{
+    s_srcfg.period_ms = period_ms;
+    s_srcfg.sel = tid_mask;
+    s_srcfg.start_s = start_s;
+    s_srcfg.log_n = log_n;
+    s_srcfg.t0 = ss_now_us();
+    g_ss_sr_on = 1;
+}
+
+static void sr_init_env(void)
+{
+    const char* e = getenv("SS_SELFRESUME");
+    if (!e || !*e || atoi(e) <= 0) return;
+    unsigned long long sel = ~0ull;
+    const char* t = getenv("SS_SELFRESUME_TID");
+    if (t && *t) {
+        sel = 0;
+        for (const char* p = t; *p;) {
+            char* end;
+            const unsigned long v = strtoul(p, &end, 10);
+            if (end == p) { p++; continue; }
+            if (v >= 1 && v <= SS_MAX_TID) sel |= 1ull << (v - 1);
+            p = end;
+        }
+    }
+    const char* st = getenv("SS_SELFRESUME_START");
+    const char* lg = getenv("SS_SELFRESUME_LOG");
+    ss_sr_configure((unsigned)atoi(e), sel, (st && *st) ? atof(st) : 0.0,
+                    (lg && *lg) ? atol(lg) : 1000000L);
+    { const char* ar = getenv("SS_SELFRESUME_ATROOT"); s_srcfg.at_root = ar && *ar && *ar != '0'; }
+    char who[200];
+    if (sel == ~0ull) strcpy(who, "all");
+    else {
+        int p = 0;
+        who[0] = 0;
+        for (unsigned i = 1; i <= SS_MAX_TID && p < (int)sizeof who - 8; i++)
+            if (sel & (1ull << (i - 1))) p += snprintf(who + p, sizeof who - p, "%s%u", p ? "," : "", i);
+        if (!p) strcpy(who, "none (SS_SELFRESUME_TID names no thread 1..64)");
+    }
+    fprintf(stderr, "[ss] self-resume armed (SS_SELFRESUME): every %u ms, threads %s, from t=%.1f s,"
+                    " a line for each of a thread's first %ld resumes then every 100th%s\n",
+            s_srcfg.period_ms, who, s_srcfg.start_s, s_srcfg.log_n,
+            s_srcfg.at_root ? "; each also requested at its root (SS_SELFRESUME_ATROOT)" : "");
+    fflush(stderr);
+}
+
+/* ---- roots --------------------------------------------------------------- */
+static PPU_THREAD_LOCAL unsigned t_root_tid;   /* the s_roots[] record this thread wrote */
+static PPU_THREAD_LOCAL long     t_root_tok;   /* ... and its token there */
+static volatile long s_root_tok;
+
+/* The root record of thread `tid`: the census's / a save's copy (read by the
+ * coordinator while the thread is parked) and the thread's own (t_root:
+ * where a self-resume or a load's discard longjmps to). */
+static void root_record(void* jb, struct ppu_context* ctx, const ss_sr_root* rr)
+{
+    const uint64_t tid = ctx->thread_id;
+    if (tid >= 1 && tid <= SS_MAX_TID) {
+        long tok = InterlockedIncrement(&s_root_tok);
+        if (!tok) tok = InterlockedIncrement(&s_root_tok);   /* (0 means none) */
+        s_roots[tid].r = *rr;
+        InterlockedExchange(&s_roots[tid].valid, tok);
+        t_root_tid = (unsigned)tid;
+        t_root_tok = tok;
+    }
+    memset(&t_root, 0, sizeof t_root);
+    t_root.jb = jb;
+    t_root.ctx = ctx;
+    t_root.r = *rr;
+}
+
+static void sr_root_requests(uint64_t tid);
+
+void ss_root_enter(void* jb, struct ppu_context* ctx)
+{
+    if (!jb || !ctx || (!g_ss_sr_on && !g_ss_armed)) return;
+    const uint64_t tid = ctx->thread_id;
+    ss_sr_root rr;
+    rr.root_lr = (uint32_t)ctx->lr;
+    rr.root_sp = (uint32_t)ctx->gpr[1];
+    /* main has no recorded stack range: below its entry r1 */
+    rr.stack_lo = 0x10000u;
+    rr.stack_hi = rr.root_sp + 0x10u;
+    if (tid >= 1 && tid <= SS_MAX_TID) {
+        const ppu_thread_info* ti = &g_ppu_threads[tid - 1];
+        if (ti->stack_size && rr.root_sp >= ti->stack_addr && rr.root_sp < ti->stack_addr + ti->stack_size) {
+            rr.stack_lo = ti->stack_addr;
+            rr.stack_hi = ti->stack_addr + ti->stack_size;
+        }
+    }
+    /* Armed (always, M4a) the thread keeps its jump buffer too: a load's
+     * discard (M4c) longjmps there; P0 only adds its requests below. */
+    root_record(jb, ctx, &rr);
+    if (!g_ss_sr_on) return;
+    sr_root_requests(tid);
+}
+
+/* A recreated thread's root (M4c): the root record of its restored park --
+ * never one derived from its restored, deeply nested context (H3). */
+void ss_root_load_enter(void* jb, struct ppu_context* ctx)
+{
+    if (!jb || !ctx) return;
+    const uint64_t tid = ctx->thread_id;
+    ss_sr_root rr;
+    memset(&rr, 0, sizeof rr);
+    if (tid >= 1 && tid <= SS_MAX_TID && s_lpark[tid].valid && s_lpark[tid].root_valid) rr = s_lpark[tid].root;
+    root_record(jb, ctx, &rr);
+    if (g_ss_sr_on) sr_root_requests(tid);
+}
+
+/* A parked thread a load discards: to its root (ss_core.h "the load"). */
+static void discard_self(void)
+{
+    if (t_root.jb) longjmp(*(jmp_buf*)t_root.jb, SS_ROOT_DISCARD);
+    fprintf(stderr, "[ss] FATAL: a load discarded a thread with no root (host thread %lu)\n",
+            (unsigned long)GetCurrentThreadId());
+    fflush(stderr);
+    abort();
+}
+
+/* P0's state and every root record, after a load's discard: the threads they
+ * belonged to are gone (critique H2 / H3). */
+static void sr_reset_all(void)
+{
+    sr_and(&g_ss_sr_mask, 0);
+    sr_and(&s_sr_rooted, 0);
+    for (unsigned t = 0; t <= SS_MAX_TID; t++) { s_sr[t].t_req = 0; s_sr[t].host_sp0 = 0; }
+}
+
+void ss_root_load_run(int discarded)
+{
+    struct ppu_context* ctx = t_root.ctx;
+    const uint64_t tid = ctx ? ctx->thread_id : 0;
+    if (discarded) InterlockedExchange(&s_main_at_gate, 1);   /* (main, after its discard) */
+    ss_load_gate_wait();
+    if (!ctx || tid == 0 || tid > SS_MAX_TID || !s_lpark[tid].valid) {
+        fprintf(stderr, "[ss] FATAL: a thread reached its load gate with no park record to resume (tid=%llu)\n",
+                (unsigned long long)tid);
+        fflush(stderr);
+        abort();
+    }
+    ss_lpark* p = &s_lpark[tid];
+    const int at = p->at;
+    const uint32_t num = p->num, obj = p->obj;
+    const ss_wait_rec rec = p->rec;
+    ss_sr_root root = p->root;
+    if (!p->root_valid) memset(&root, 0, sizeof root);
+    memcpy(ctx, &p->ctx, sizeof *ctx);
+    InterlockedExchange(&p->valid, 0);                /* consumed */
+    if (discarded) root_record(t_root.jb, ctx, &root);   /* main: the image's root (the same entry) */
+    ss_thread_root_reset();
+    if (at == SS_IN_WAIT) {
+        if (!s_sr_ops.run_wait) {
+            fprintf(stderr, "[ss] FATAL: tid=%llu resumes from a %s wait, and this build has no S3 resume\n",
+                    (unsigned long long)tid, ss_wait_name((int)num));
+            fflush(stderr);
+            abort();
+        }
+        s_sr_ops.run_wait(ctx, (int)num, obj, &rec, &root);
+    } else {
+        s_sr_ops.run(ctx, at, num, &root);            /* S1 / S2: re-issue the call, then the continuations */
+    }
+}
+
+static void sr_root_requests(uint64_t tid)
+{
+    if (tid >= 1 && tid <= SS_MAX_TID) {
+        const unsigned long long b = 1ull << (tid - 1);
+        sr_and(&g_ss_sr_mask, ~b);
+        s_sr[tid].t_req = 0;
+        /* A new root is a new host thread (the kernel reuses a tid once its
+         * thread exited): the host-frame drift check compares resumes of
+         * this thread only, not its stack with the old thread's. */
+        s_sr[tid].host_sp0 = 0;
+        sr_or(&s_sr_rooted, b);
+        if (s_srcfg.at_root && (s_srcfg.sel & b)) ss_sr_request((unsigned)tid);
+    }
+    sr_timer_start();
+}
+
+void ss_root_leave(void)
+{
+    /* Only this thread's own record: by now a joiner (or a detached exit)
+     * may have freed the slot, and a new thread taken its tid and entered. */
+    int mine = 0;
+    if (t_root_tid) {
+        mine = InterlockedCompareExchange(&s_roots[t_root_tid].valid, 0, t_root_tok) == t_root_tok;
+        t_root_tid = 0;
+    }
+    if (!g_ss_sr_on) { memset(&t_root, 0, sizeof t_root); return; }   /* (no jump to a frame that is gone) */
+    const struct ppu_context* ctx = t_root.ctx;
+    if (ctx && mine && ctx->thread_id >= 1 && ctx->thread_id <= SS_MAX_TID) {
+        const unsigned long long b = 1ull << (ctx->thread_id - 1);
+        sr_and(&s_sr_rooted, ~b);
+        sr_and(&g_ss_sr_mask, ~b);
+    }
+    memset(&t_root, 0, sizeof t_root);
+}
+
+/* ---- the safepoint half --------------------------------------------------- */
+static void sr_safepoint(struct ppu_context* ctx, int at, uint32_t num, int tramp)
+{
+    const uint64_t tid = ctx->thread_id;
+    if (tid == 0 || tid > SS_MAX_TID) return;               /* host-thread callbacks */
+    const unsigned long long b = 1ull << (tid - 1);
+    if (!((unsigned long long)g_ss_sr_mask & b)) return;
+    ss_sr_thr* s = &s_sr[tid];
+    int why, frames = 0;
+    if (t_cb_depth > 0)                         why = SS_SR_CALLBACK;
+    else if (!t_root.jb || t_root.ctx != ctx)   why = SS_SR_NO_ROOT;   /* not the root's context */
+    else if (tramp)                             why = SS_SR_TRAMP;
+    else if (t_br_depth > 0)                    why = SS_SR_BRIDGE;
+    else if (!s_sr_ops.check || !s_sr_ops.run)  why = SS_SR_NO_OPS;
+    else why = s_sr_ops.check(ctx, at, num, &t_root.r, &frames);
+    if (why == SS_SR_OK) {
+        memcpy(&s->snap, ctx, sizeof s->snap);
+        s->at = at;
+        s->num = num;
+        s->frames = frames;
+        s->ra = at == SS_AT_SC ? (uint32_t)ctx->sc_ra : (uint32_t)ctx->lr;
+        s->t_park = ss_now_us();
+        s->t_req_taken = s->t_req;
+        s->t_req = 0;
+        int d = -1, v = -1;
+        if (s_ppu.icall_state) s_ppu.icall_state(&d, &v);   /* what the root reset will drop */
+        s->icall = d;
+        s->vcall = v;
+        sr_and(&g_ss_sr_mask, ~b);
+        longjmp(*(jmp_buf*)t_root.jb, SS_ROOT_RESUME);       /* -> the thread root */
+    }
+    if (why >= SS_SR_REFUSED_BASE) {
+        s->skip[SS_SR_REFUSED]++;
+        s->refused[(why - SS_SR_REFUSED_BASE) & 15]++;
+    } else if (why > 0 && why < SS_SR__N) {
+        s->skip[why]++;
+    }
+}
+
+/* ---- the root half -------------------------------------------------------- */
+static void sr_ctx_diff(unsigned tid, const ppu_context* a, const ppu_context* b)
+{
+    char d[400];
+    int p = 0;
+#define SR_CMP(f) if (memcmp(&a->f, &b->f, sizeof a->f) && p < (int)sizeof d - 24) \
+                      p += snprintf(d + p, sizeof d - p, " " #f)
+    SR_CMP(gpr); SR_CMP(fpr); SR_CMP(vr); SR_CMP(cr); SR_CMP(lr); SR_CMP(ctr); SR_CMP(xer);
+    SR_CMP(fpscr); SR_CMP(vscr); SR_CMP(cia); SR_CMP(thread_id); SR_CMP(reserve_addr);
+    SR_CMP(reserve_value); SR_CMP(reserve_valid); SR_CMP(sc_ra);
+#undef SR_CMP
+    fprintf(stderr, "[ss] tid=%u: the thread's context changed between its park and its root:%s"
+                    " (restored from the snapshot; logged once per thread)\n", tid, p ? d : " padding");
+}
+
+void ss_root_resume(void)
+{
+    struct ppu_context* ctx = t_root.ctx;
+    const uint64_t tid = ctx ? ctx->thread_id : 0;
+    if (!ctx || tid == 0 || tid > SS_MAX_TID || !s_sr_ops.run) {
+        fprintf(stderr, "[ss] FATAL: a self-resume reached a thread root with no root record"
+                        " (tid=%llu)\n", (unsigned long long)tid);
+        fflush(stderr);
+        abort();
+    }
+    ss_sr_thr* s = &s_sr[tid];
+    volatile int marker = 0;
+    const uintptr_t hsp = (uintptr_t)&marker;
+    ss_thread_root_reset();
+    /* The reservation fields are not the thread's alone: any other PPU
+     * store or SPU commit to the reserved line breaks it by writing this
+     * context's reserve_addr (ppu_resv_break_*). Not a change the discarded
+     * host frames made, so not compared. */
+    {
+        ppu_context a, b;
+        memcpy(&a, ctx, sizeof a);
+        memcpy(&b, &s->snap, sizeof b);
+        a.reserve_addr = b.reserve_addr = 0;
+        a.reserve_value = b.reserve_value = 0;
+        a.reserve_valid = b.reserve_valid = 0;
+        if (memcmp(&a, &b, sizeof a) != 0 && s->ctx_changed++ == 0)
+            sr_ctx_diff((unsigned)tid, &a, &b);
+    }
+    memcpy(ctx, &s->snap, sizeof *ctx);
+    /* A context switch drops the reservation. The lifted stwcx. tests
+     * reserve_addr == ea (0 = none), the older helpers reserve_valid. */
+    ctx->reserve_addr = 0;
+    ctx->reserve_valid = 0;
+    const uint64_t tr = s->t_req_taken;
+    const double lat = (tr && s->t_park > tr) ? (double)(s->t_park - tr) / 1000.0 : 0.0;
+    const unsigned n = ++s->resumes;
+    s->lat_sum_ms += lat;
+    if (lat > s->lat_max_ms) s->lat_max_ms = lat;
+    s->frames_sum += (unsigned long long)s->frames;
+    if (s->frames > s->frames_max) s->frames_max = s->frames;
+    if (s->icall > s->icall_max) s->icall_max = s->icall;
+    if (!s->host_sp0) s->host_sp0 = hsp;
+    else {
+        const unsigned long long dr = hsp > s->host_sp0 ? hsp - s->host_sp0 : s->host_sp0 - hsp;
+        if (dr > s->host_sp_drift) s->host_sp_drift = dr;
+    }
+    if (s_srcfg.log_n < 0 || (long)n <= s_srcfg.log_n || n % 100 == 0) {
+        char at[48], fn[48];
+        fmt_at(at, sizeof at, s->at, s->num, 0);
+        fmt_fn(fn, sizeof fn, s->ra);
+        fprintf(stderr, "[ss] tid=%u resumed frames=%d at %s ra=0x%08X %s icall=%d after %.1f ms (#%u)\n",
+                (unsigned)tid, s->frames, at, s->ra, fn, s->icall, lat, n);
+    }
+    s_sr_ops.run(ctx, s->at, s->num, &t_root.r);   /* re-issue, continuations to the root */
+    s->roots++;
+}
+
+/* ---- results -------------------------------------------------------------- */
+void ss_sr_get_stats(unsigned tid, ss_sr_stats* o)
+{
+    memset(o, 0, sizeof *o);
+    double lat = 0, lat_max = 0;
+    unsigned long long fr = 0;
+    for (unsigned t = tid ? tid : 1; t <= (tid ? tid : (unsigned)SS_MAX_TID); t++) {
+        if (t > SS_MAX_TID) break;
+        const ss_sr_thr* s = &s_sr[t];
+        o->requests += s->requests; o->resumes += s->resumes; o->roots += s->roots;
+        o->overdue += s->overdue; o->ctx_changed += s->ctx_changed;
+        for (int k = 0; k < SS_SR__N; k++) o->skip[k] += s->skip[k];
+        for (int k = 0; k < 16; k++) o->refused[k] += s->refused[k];
+        lat += s->lat_sum_ms;
+        if (s->lat_max_ms > lat_max) lat_max = s->lat_max_ms;
+        fr += s->frames_sum;
+        if (s->frames_max > o->frames_max) o->frames_max = s->frames_max;
+        if (s->icall_max > o->icall_max) o->icall_max = s->icall_max;
+        if (s->host_sp_drift > o->host_sp_drift) o->host_sp_drift = s->host_sp_drift;
+    }
+    o->lat_avg_ms = o->resumes ? lat / o->resumes : 0.0;
+    o->lat_max_ms = lat_max;
+    o->frames_avg = o->resumes ? (double)fr / o->resumes : 0.0;
+}
+
+static void sr_refused_text(const ss_sr_stats* st, char* b, size_t n)
+{
+    size_t p = 0;
+    b[0] = 0;
+    for (int k = 0; k < 16 && p + 1 < n; k++) {
+        if (!st->refused[k]) continue;
+        const char* nm = s_sr_ops.strerror ? s_sr_ops.strerror(k) : "?";
+        const int w = snprintf(b + p, n - p, "%s%s=%u", p ? " " : " (", nm, st->refused[k]);
+        if (w > 0) p += (size_t)w;
+    }
+    if (p && p + 1 < n) snprintf(b + p, n - p, ")");
+}
+
+void ss_sr_summary(const char* when)
+{
+    if (!g_ss_sr_on) return;
+    ss_sr_stats t;
+    ss_sr_get_stats(0, &t);
+    char rb[256];
+    sr_refused_text(&t, rb, sizeof rb);
+    fprintf(stderr, "[ss] selfresume %s: requests=%u resumed=%u roots=%u overdue=%u |"
+                    " not-covered=%u no-ra=%u callback=%u trampoline=%u bridge=%u no-root=%u no-ops=%u |"
+                    " REFUSED=%u%s | ctx-changed=%u host-sp-drift=%llu | latency ms avg=%.2f max=%.1f |"
+                    " frames avg=%.1f max=%d | icall-depth-at-park max=%d | %u continuations\n",
+            when, t.requests, t.resumes, t.roots, t.overdue, t.skip[SS_SR_NOT_COVERED],
+            t.skip[SS_SR_NO_RA], t.skip[SS_SR_CALLBACK], t.skip[SS_SR_TRAMP], t.skip[SS_SR_BRIDGE],
+            t.skip[SS_SR_NO_ROOT], t.skip[SS_SR_NO_OPS], t.skip[SS_SR_REFUSED], rb, t.ctx_changed,
+            t.host_sp_drift, t.lat_avg_ms, t.lat_max_ms, t.frames_avg, t.frames_max, t.icall_max,
+            s_sr_ops.count ? s_sr_ops.count() : 0u);
+    if (!strcmp(when, "exit")) {
+        for (unsigned tid = 1; tid <= SS_MAX_TID; tid++) {
+            ss_sr_stats s;
+            ss_sr_get_stats(tid, &s);
+            if (!s.requests && !s.resumes) continue;
+            sr_refused_text(&s, rb, sizeof rb);
+            fprintf(stderr, "[ss]   tid=%u '%s' requests=%u resumed=%u roots=%u overdue=%u not-covered=%u"
+                            " no-ra=%u callback=%u bridge=%u no-root=%u REFUSED=%u%s lat-max=%.1fms"
+                            " frames-max=%d\n",
+                    tid, g_ppu_threads[tid - 1].name[0] ? g_ppu_threads[tid - 1].name : "?",
+                    s.requests, s.resumes, s.roots, s.overdue, s.skip[SS_SR_NOT_COVERED],
+                    s.skip[SS_SR_NO_RA], s.skip[SS_SR_CALLBACK], s.skip[SS_SR_BRIDGE],
+                    s.skip[SS_SR_NO_ROOT], s.skip[SS_SR_REFUSED], rb, s.lat_max_ms, s.frames_max);
+        }
+    }
+    fflush(stderr);
+}
diff --git a/runtime/savestate/ss_core.h b/runtime/savestate/ss_core.h
new file mode 100644
index 0000000..fdcae82
--- /dev/null
+++ b/runtime/savestate/ss_core.h
@@ -0,0 +1,838 @@
+/*
+ * ps3recomp - save-state core: safepoints, stop-the-world, and the M2 census.
+ *
+ * True save states snapshot the guest in GUEST terms at a moment when every
+ * guest thread is parked at a call boundary (see the save-state plan, M0-M7).
+ * This is the part every later milestone stands on: where threads may park,
+ * the park/release protocol, and the coordinator that drives a stop from the
+ * frame clock. A stop runs on REQUEST (M4a): a CENSUS (milestone M2: stop the
+ * world, record where everything parked and how long it took, write every PPU
+ * thread's guest back chain, release), or a SAVE / LOAD / HOLD / SELFTEST,
+ * whose stop is then checked for ELIGIBILITY (see "requests" below). A SAVE
+ * that is eligible is CAPTURED into an image in RAM (M4b: ss_state.h, every
+ * section's capture() with the world still stopped); nothing is restored yet
+ * (M4c) and nothing reaches a slot file (M5).
+ *
+ * ALWAYS ON (M4a). Save states are armed at startup: every thread root keeps
+ * its record, the wrapped host waits run in SS_SLICE_MS slices so a blocked
+ * thread notices a stop, and there is no periodic stop -- the coordinator
+ * only serves requests. Armed and idle, every hook is still one load of a
+ * zero global; the slicing is the whole cost.
+ *
+ * SWITCHES
+ *   SAVESTATES=0           the kill switch: nothing armed, no slicing, no
+ *                          thread roots recorded, every request refused
+ *                          (SS_R_OFF) -- every hook is one load of a zero
+ *                          global and every wrapped wait the plain call it
+ *                          wraps, exactly the code before M4a
+ *   SS_CENSUS=<sec>        a census request every <sec> seconds (e.g. 5)
+ *   SS_CENSUS_START=<sec>  no census before this many seconds after start (0)
+ *   SS_SAVE_AT=<s>[,<s>..] a SAVE request at each of these process times
+ *                          (seconds after start; the scripted test of the
+ *                          strict check and the capture): one "[ss]
+ *                          SS_SAVE_AT" line each
+ *   SS_DUMP=<s>[,<s>..]    the same, and each captured image is also written
+ *                          raw to <SS_DIR or .\savestates>\dump-<n>.p3ssraw
+ *                          (after the release; tools/ss_inspect.py reads it)
+ *                          with its size, the committed and non-zero guest
+ *                          memory and an XPRESS_HUFF estimate of the slot file
+ *                          logged: one "[ss] SS_DUMP" line each
+ *   SS_SPU_AUDITED=<img>:<where>:<pc>[,...]  replaces the table of SPU host
+ *                          waits a strict save accepts (the title's, from
+ *                          ss_set_spu_audited; where = ch-wait|wait-signal|
+ *                          stop-receive; "none" = drain hops only)
+ *   SS_TIER1_MS=<ms>       phase 1 (blocking waits only) length (150)
+ *   SS_TIMEOUT_MS=<ms>     give up on a stop after this long (500), release,
+ *                          retry (a census at the next flip, SS_RETRIES
+ *                          times, 1; any other request after SS_RETRY_GAP)
+ *   SS_RETRY_GAP=<n>       a request that is not a census starts its next
+ *                          stop no sooner than <n> times the last stop's
+ *                          length after it (4): a refused request keeps the
+ *                          game stopped at most 1/(n+1) of its retry window
+ *   SS_SPU_TIMEOUT_MS=<ms> how long the SPUs get to park (200)
+ *   SS_CAPTURE_GRACE_MS=<ms>  how much longer the stop's watchdog waits while
+ *                          a SAVE's GPU flush and capture run (20000; a GPU
+ *                          fence wait alone may take 3 x 2 s before it
+ *                          gives up)
+ *   SS_SLICE_MS=<ms>       longest single host wait while armed (10), so a
+ *                          blocked thread notices a stop
+ *   SS_SPU=0               leave the SPUs running (PPU + walker census only)
+ *   SS_SPU_EXPECT=<n>      SPU host threads the title should have (7: M0 check)
+ *   SS_BRIDGE_PARK=0       refuse parks inside a libsre bridge call (default:
+ *                          allow, and record the bridge)
+ *   SS_CHAINS=<file>       chain output (ss_chains.txt; "-" = none)
+ *   SS_VERBOSE=1           one line per parked thread in the log too
+ *   SS_SELFTEST_EVERY=<s>  (M4c) a SELFTEST every <s> seconds: capture state
+ *                          A and load it again in the same stop (a round
+ *                          trip); one "[ss] load request #N" line each
+ *   SS_SELFTEST_AB=<s>     (M4c) capture A (a held SAVE), play <s> seconds,
+ *                          load A; then play <s> seconds and again
+ *   SS_SELFTEST_START=<s>  no selftest before this many seconds (30)
+ *   SS_VERIFY=0|1          the fidelity check after a load's restore
+ *                          (capture again, compare with the image section by
+ *                          section): default on for selftests, off for other
+ *                          loads; 1 = always, 0 = never
+ *   SS_DISCARD_MS=<ms>     how long a load waits for discarded threads (2000)
+ *   SS_FATAL_BOX=0         no message box when a load fails past its point
+ *                          of no return (scripted runs: the log and exit 3)
+ *
+ * P0 -- PER-THREAD SELF-RESUME (independent of the requests, off unless set;
+ * see the P0 section at the end of this header):
+ *   SS_SELFRESUME=<ms>         every <ms> ms ask each selected guest thread
+ *                              to resume itself at its next eligible S1/S2
+ *   SS_SELFRESUME_TID=<n>[,<m>...]  only these guest thread ids (default all)
+ *   SS_SELFRESUME_START=<s>    no request in the first <s> seconds (0)
+ *   SS_SELFRESUME_LOG=<n>      a "[ss] tid=N resumed ..." line for each of a
+ *                              thread's first <n> resumes, then every 100th
+ *                              (default 1000000; 0 = summaries only)
+ *
+ * SAFEPOINTS (PPU)
+ *   S1  lv2_syscall entry, before anything else in it      SS_AT_SC  (r11)
+ *   S2  ps3_hle_call entry, before anything else in it     SS_AT_HLE (nid)
+ *   S3  inside the blocking kernel waits (ss_wait_handle,
+ *       ss_sleep_cv_cs, ss_ppu_sleep_us, SS_WAIT_POINT)    SS_IN_WAIT (kind)
+ * Two tiers: g_ss_req == 1 parks only at S3 (where threads idle every frame);
+ * after SS_TIER1_MS it becomes 2 and any S1/S2 parks too. A park is refused
+ * inside a guest callback (ppu_guest_call), with a trampoline pending, and --
+ * with SS_BRIDGE_PARK=0 -- inside a libsre bridge. A park is non-destructive:
+ * releasing it just lets the call (or the wait) go on.
+ *
+ * SPU: a snap tick at every drain-loop hop (spu_drain.c), with the region
+ * back-edges forced through the drain loop (g_spu_no_goto) and the inline
+ * computed-branch hop off while a park is pending; hold points in the host
+ * waits an SPU blocks in (channel waits, taskset WAIT_SIGNAL, stop 0x110).
+ *
+ * ORDER OF A STOP (ss_frame_tick on the frame-clock thread, right after a flip)
+ *   1 the cellAudio mixer parks between blocks (its notify queue would fill)
+ *   2 PPU threads park, tier 1 then tier 2; SPUs, the RSX walker and vblank
+ *     keep running so a PPU spin that waits on them can finish
+ *   3 the walker drains to get == put (or to its park / acquire)
+ *   4 SPUs park
+ *   5 capture (the census) or the eligibility check (the other purposes);
+ *     an eligible SAVE then flushes the renderer and waits for the GPU
+ *     (ss_host_ops.gpu_idle), runs every section's check() and captures
+ *     every section into the staging buffer (ss_state_capture)
+ *   6 release SPU, walker timers, PPU, mixer; a SAVE's image is sealed (its
+ *     CRCs) and, for SS_DUMP, written out -- the game running again
+ */
+#ifndef PS3RECOMP_SS_CORE_H
+#define PS3RECOMP_SS_CORE_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ppu_context;
+
+/* ---- gates read inline at the hook sites ------------------------------- */
+extern volatile int  g_ss_armed;    /* armed: always, unless SAVESTATES=0 (fixed at startup) */
+extern volatile long g_ss_req;      /* PPU stop: 0 none, 1 tier 1 (S3), 2 tier 2 (any) */
+extern volatile long g_ss_spu_req;  /* SPU park pending */
+extern volatile long g_ss_mix_req;  /* audio mixer park pending */
+extern volatile int       g_ss_sr_on;    /* SS_SELFRESUME is set (fixed at startup) */
+extern volatile long long g_ss_sr_mask;  /* P0: bit tid-1 = that thread is asked to self-resume */
+
+#if defined(__GNUC__) || defined(__clang__)
+#  define SS_UNLIKELY(x) __builtin_expect(!!(x), 0)
+#else
+#  define SS_UNLIKELY(x) (x)
+#endif
+
+/* Where a PPU thread parked. */
+enum { SS_AT_NONE = 0, SS_AT_SC = 1, SS_AT_HLE = 2, SS_IN_WAIT = 3 };
+
+/* S3 wait kinds. "sc" = the wait is inside an lv2 syscall (its continuation is
+ * ctx->sc_ra), otherwise inside an HLE import (continuation ctx->lr). */
+enum ss_wait_kind {
+    SS_W_NONE = 0,
+    SS_W_SEM,          /* sc  sys_semaphore_wait                     */
+    SS_W_EQUEUE,       /* sc  sys_event_queue_receive                */
+    SS_W_EFLAG,        /* sc  sys_event_flag_wait                    */
+    SS_W_JOIN,         /* sc  sys_ppu_thread_join                    */
+    SS_W_USLEEP,       /* sc  sys_timer_usleep                       */
+    SS_W_SLEEP,        /* sc  sys_timer_sleep                        */
+    SS_W_SPU_JOIN,     /* sc  sys_spu_thread_group_join              */
+    SS_W_MUTEX,        /* sc  sys_mutex_lock                         */
+    SS_W_COND,         /* sc  sys_cond_wait                          */
+    SS_W_LWMUTEX,      /* hle sys_lwmutex_lock                       */
+    SS_W_LWCOND,       /* hle sys_lwcond_wait, waiting for a signal  */
+    SS_W_LWCOND_REACQ, /* hle sys_lwcond_wait, re-taking its mutex   */
+    SS_W_SPINLOCK,     /* hle sys_spinlock_lock                      */
+    SS_W_NET,          /* hle select / poll (offline sleeps)         */
+    SS_W__COUNT
+};
+const char* ss_wait_name(int kind);
+int         ss_wait_is_syscall(int kind);
+
+/* ---- setup -------------------------------------------------------------- */
+#define SS_SAVE_AT_MAX 64           /* SS_SAVE_AT / SS_DUMP times (a soak: one every 10 s for 10 min) */
+typedef struct ss_config {
+    int      on;                /* armed with no periodic stop (always-on mode); ss_init
+                                 * sets it unless SAVESTATES=0, ss_default_config does not */
+    double   period_s;          /* SS_CENSUS: a census request every period_s; 0 = none */
+    double   start_s;           /* SS_CENSUS_START */
+    double   save_at[SS_SAVE_AT_MAX];   /* SS_SAVE_AT: process times of the SAVE requests */
+    int      n_save_at;
+    char     spu_audited[256];  /* SS_SPU_AUDITED; "" = the title's table (ss_set_spu_audited) */
+    unsigned tier1_ms;          /* SS_TIER1_MS */
+    unsigned timeout_ms;        /* SS_TIMEOUT_MS */
+    unsigned spu_timeout_ms;    /* SS_SPU_TIMEOUT_MS */
+    unsigned mixer_timeout_ms;  /* how long the mixer gets (100) */
+    unsigned slice_ms;          /* SS_SLICE_MS */
+    unsigned walker_ms;         /* walker drain budget (50) */
+    unsigned noflip_ms;         /* start without a flip after this (250) */
+    int      retries;           /* SS_RETRIES */
+    unsigned retry_gap;         /* SS_RETRY_GAP */
+    int      bridge_park;       /* SS_BRIDGE_PARK */
+    int      spu;               /* SS_SPU */
+    int      spu_expect;        /* SS_SPU_EXPECT */
+    int      verbose;           /* SS_VERBOSE */
+    char     chains_path[260];  /* SS_CHAINS; "" = none */
+    double   dump_at[SS_SAVE_AT_MAX];   /* SS_DUMP: SAVE requests that also write the raw image */
+    int      n_dump_at;
+    unsigned capture_grace_ms;  /* SS_CAPTURE_GRACE_MS (appended) */
+    /* (appended, M4c) */
+    double   selftest_every_s;  /* SS_SELFTEST_EVERY: a round trip every this many seconds; 0 none */
+    double   selftest_ab_s;     /* SS_SELFTEST_AB: capture A, play this long, load A; 0 none */
+    double   selftest_start_s;  /* SS_SELFTEST_START */
+    int      verify;            /* SS_VERIFY: -1 default (selftests on), 0 never, 1 always */
+    unsigned discard_ms;        /* SS_DISCARD_MS */
+    int      fatal_box;         /* SS_FATAL_BOX */
+} ss_config;
+void ss_default_config(ss_config* c);
+/* The switches above into *c (ss_default_config first). Returns 0 when
+ * SAVESTATES=0 turns everything off (*c is then the unarmed default). */
+int  ss_config_from_env(ss_config* c);
+void ss_init(void);                      /* reads the environment, then ss_enable; idempotent */
+/* Arms when c->on, or when c->period_s > 0, c->n_save_at > 0 or
+ * c->n_dump_at > 0 (a request source implies arming); otherwise disarms,
+ * refusing (SS_REASON_OFF) a request still waiting. Tests and ss_init. */
+void ss_configure(const ss_config* c);
+/* Always-on arming without a census period: g_ss_armed = 1, roots record,
+ * host waits sliced, no periodic stop (the current configuration, or the
+ * default one if none was set); the capture's staging buffer is reserved
+ * (ss_state_enable). Returns 1. */
+int  ss_enable(void);
+
+/* What the frame clock provides (main.cpp). Any member may be NULL. */
+typedef struct ss_walker_info {
+    uint32_t get, put;          /* FIFO IO offsets */
+    uint32_t park_off;          /* self-jump the walker stands on (~0: none) */
+    uint32_t acq_pos;           /* SEMAPHORE_ACQUIRE it waits at (~0: none) */
+    uint32_t ref_q;             /* fences queued, not yet published */
+    uint32_t pending;           /* vblank/flip bits not yet delivered */
+    uint32_t flip_status, vblank, wake_kind, pumping;
+} ss_walker_info;
+typedef struct ss_host_ops {
+    int  (*walker_pass)(void);                     /* one FIFO pass (+ present a pending flip) */
+    void (*walker_info)(ss_walker_info* w);
+    void (*walker_rebase)(unsigned long long ms);  /* the walker was stopped this long */
+    void (*wake_coordinator)(void);                /* end the frame clock's idle wait */
+    /* A SAVE, everything parked and the walker drained, before its capture:
+     * execute what the renderer has recorded (no present), deliver the
+     * pending reports and wait for the GPU, so every result the guest can
+     * observe is in guest memory. Returns 1 if it did, 0 with nothing to
+     * do (no device), < 0 if the GPU did not go idle (its fence wait gave
+     * up): work could still land in guest memory, so that stop is refused
+     * (SS_REASON_GPU) and retried. (Appended.) */
+    int  (*gpu_idle)(void);
+    /* (appended, M4c) A LOAD's release: the frame clock goes on from the
+     * restored guest flip count (s_last_flip = flip_count, next tick now). */
+    void (*resync_clock)(unsigned flip_count);
+    /* (appended, M4c) 1 while the window runs a modal loop (a drag, a menu):
+     * a LOAD / SELFTEST waits until it is over (no D3D12 teardown inside
+     * DispatchMessage; critique #4). */
+    int  (*in_modal)(void);
+    /* (appended, M4c) The guest flip count now (after a restore: the
+     * snapshot's), for resync_clock. NULL: the count ss_frame_tick saw. */
+    unsigned (*flip_count)(void);
+    /* (appended, M4c) A LOAD's teardown, every guest thread gone and the GPU
+     * idle: drop the renderer's caches derived from guest memory
+     * (rsx_d3d12_backend_ss_reset). Run after every section's teardown. */
+    void (*gpu_reset)(void);
+} ss_host_ops;
+void ss_set_host_ops(const ss_host_ops* ops);
+
+/* What the PPU scaffold provides (ppu_loader.cpp). Any member may be NULL. */
+typedef struct ss_ppu_ops {
+    uint32_t (*func_start)(uint32_t guest_addr);   /* lifted function holding it, 0: none */
+    int      (*is_code)(uint32_t guest_addr);      /* inside a lifted function */
+    uint32_t (*host_fn_guest)(void* host_fn);      /* host function start -> guest fn, 0: not lifted */
+    void     (*icall_state)(int* depth, int* vcall_sp);   /* calling thread's indirect-call depth */
+    int      (*tramp_pending)(void);               /* calling thread has a trampoline pending */
+    const uint32_t*    sc_inflight;                /* g_sc_inflight[tid] */
+    const char* const* hle_inflight;               /* g_hle_inflight[tid] */
+    int      inflight_n;
+    unsigned long main_host_tid;                   /* host thread running guest tid 1 */
+    /* (appended, M4c) the NID the calling thread's innermost ps3_hle_call
+     * entered with (S2's thread-local): an HLE wait's default nid_or_sc */
+    uint32_t (*hle_nid)(void);
+} ss_ppu_ops;
+void ss_set_ppu_ops(const ss_ppu_ops* ops);
+
+/* ---- PPU safepoints ----------------------------------------------------- */
+/* S1/S2 slow path (call through SS_SAFEPOINT): a census park (g_ss_req), and
+ * then a P0 self-resume (g_ss_sr_mask) -- which does not return when it
+ * resumes: it longjmps to the thread's root. */
+void ss_ppu_safepoint(struct ppu_context* ctx, int at, uint32_t num, int tramp);
+#define SS_SAFEPOINT(ctx, at, num, tramp) do {                                   \
+        if (SS_UNLIKELY(g_ss_req != 0 || g_ss_sr_mask != 0))                     \
+            ss_ppu_safepoint((ctx), (at), (num), (tramp));                        \
+    } while (0)
+
+/* S3: park point inside a blocking wait. Call it with no host lock held and
+ * with the wait's own accounting undone; when it returns the caller simply
+ * carries on waiting (re-checking its predicate). Returns microseconds parked.
+ * A LOAD may DISCARD the parked thread instead: it never returns then (a
+ * longjmp to the thread's root; see "the load" below) -- so nothing the
+ * caller's frames hold may need undoing but what C++ destructors undo. */
+uint64_t ss_ppu_wait_point(struct ppu_context* ctx, int kind, uint32_t obj);
+#define SS_WAIT_POINT(ctx, kind, obj) \
+    (SS_UNLIKELY(g_ss_req != 0) ? ss_ppu_wait_point((ctx), (kind), (obj)) : (uint64_t)0)
+
+/* ---- S3 payloads and resumers (M4c; engine design 4.4) ------------------ */
+/* What a resumed wait needs beyond the parked context, passed by every S3
+ * site with its park point (the _ex variants; the plain ones pass none):
+ *   nid_or_sc     the call to re-issue: 0 = the default, filled in at the
+ *                 park -- r11 for a syscall wait, the NID ps3_hle_call
+ *                 entered with (S2's thread-local, ss_ppu_ops.hle_nid) for an
+ *                 HLE one
+ *   a, b, c       kind-specific, below
+ *   deadline_ns   a sleep's end on the guest clock (ss_guest_ns), 0 = none
+ * Kind           rule              payload
+ *   SEM EQUEUE EFLAG JOIN SPU_JOIN MUTEX
+ *                  re-issue          -- (sc)
+ *   LWMUTEX SPINLOCK NET
+ *                  re-issue          -- (nid)
+ *   USLEEP SLEEP   the rest          deadline_ns
+ *   LWCOND         the rest          a = lwmutex EA, b = recursion to put back,
+ *                                    c = the wait's timeout (ms, as passed)
+ *   LWCOND_REACQ   the rest          a = lwmutex EA, b = recursion, c = the
+ *                                    return code it writes (ETIMEDOUT after a
+ *                                    timed-out wait)
+ *   COND           the rest          a = sys_mutex id, b = lock depth
+ * RE-ISSUE: the call again from its entry -- lv2_syscall (r11 intact) or
+ * ps3_hle_call(nid) -- then the continuations from sc_ra / lr. Valid because
+ * every such site writes no argument register before its park point (each
+ * site carries an audit comment saying so). THE REST: a resumer the owner
+ * registers (ss_set_wait_resumer) does what the call had left to do from
+ * the park point -- it may block again, through the same parkable waits --
+ * and leaves r3 (and any other result register) as the call would; then
+ * the continuations run as for a re-issue. */
+typedef struct ss_wait_rec {
+    uint32_t nid_or_sc;
+    uint32_t a, b, c;
+    uint64_t deadline_ns;
+} ss_wait_rec;
+uint64_t ss_ppu_wait_point_ex(struct ppu_context* ctx, int kind, uint32_t obj, const ss_wait_rec* rec);
+#define SS_WAIT_POINT_EX(ctx, kind, obj, rec) \
+    (SS_UNLIKELY(g_ss_req != 0) ? ss_ppu_wait_point_ex((ctx), (kind), (obj), (rec)) : (uint64_t)0)
+typedef void (*ss_wait_resume_fn)(struct ppu_context* ctx, uint32_t obj, const ss_wait_rec* rec);
+void ss_set_wait_resumer(int kind, ss_wait_resume_fn fn);   /* static init / the owner's init */
+ss_wait_resume_fn ss_wait_resumer(int kind);                /* NULL: re-issue (or none: see below) */
+/* 1 if a thread parked in this kind can be resumed: a re-issue kind, or one
+ * whose owner registered its resumer. A strict save refuses a park in a kind
+ * that cannot (SS_REASON_NOT_RESUMABLE). */
+int  ss_wait_resumable(int kind);
+/* The guest clock in ns (guest_clock.h): sleeps' deadlines. */
+uint64_t ss_guest_ns(void);
+
+/* Host waits with park points. Unarmed, each is exactly the call it wraps.
+ * Armed, the wait runs in SS_SLICE_MS slices and parks between them when a
+ * stop is pending; time spent parked does not count against `ms`.
+ *   ss_wait_handle   -> WaitForSingleObject(h, ms)
+ *   ss_sleep_cv_cs   -> SleepConditionVariableCS(cv, cs, ms). Armed, it
+ *                       sleeps at most one slice and returns TRUE -- a
+ *                       spurious wakeup -- after a park (lock dropped and
+ *                       re-taken) and after a slice that timed out (a wake
+ *                       sent while the waiter re-took the lock is lost to
+ *                       the CV, not to the caller's predicate loop). So the
+ *                       caller loops on its predicate, and `ms` is INFINITE
+ *                       or the time it still has (sys_cond_wait)
+ *   ss_sleep_cv_cs_dl -> the same for a timed wait that passes the same `ms`
+ *                       on every call: *dl (0 before the first call) keeps
+ *                       its deadline across the slices; FALSE with
+ *                       ERROR_TIMEOUT once it passed */
+#ifdef _WIN32
+unsigned long ss_wait_handle(struct ppu_context* ctx, void* handle, unsigned long ms,
+                             int kind, uint32_t obj);
+int           ss_sleep_cv_cs(struct ppu_context* ctx, void* cv, void* cs, unsigned long ms,
+                             int kind, uint32_t obj);
+int           ss_sleep_cv_cs_dl(struct ppu_context* ctx, void* cv, void* cs, unsigned long ms,
+                                uint64_t* dl, int kind, uint32_t obj);
+/* The same with the site's S3 payload (rec may be NULL). */
+unsigned long ss_wait_handle_ex(struct ppu_context* ctx, void* handle, unsigned long ms,
+                                int kind, uint32_t obj, const ss_wait_rec* rec);
+int           ss_sleep_cv_cs_ex(struct ppu_context* ctx, void* cv, void* cs, unsigned long ms,
+                                int kind, uint32_t obj, const ss_wait_rec* rec);
+int           ss_sleep_cv_cs_dl_ex(struct ppu_context* ctx, void* cv, void* cs, unsigned long ms,
+                                   uint64_t* dl, int kind, uint32_t obj, const ss_wait_rec* rec);
+#endif
+/* Armed only: sleep `us` in slices with park points (callers keep their own
+ * sleep when !g_ss_armed). Each park records the sleep's deadline, so a
+ * resumed sleep sleeps what was left. */
+void          ss_ppu_sleep_us(struct ppu_context* ctx, uint64_t us, int kind);
+/* min(ms, SS_SLICE_MS) when armed, else ms (INFINITE included). */
+unsigned long ss_slice_ms(unsigned long ms);
+
+/* Guest callbacks (ppu_guest_call) and libsre bridge calls (ps3_hle_call)
+ * nest guest code inside a host call: no park inside a callback, a bridge is
+ * recorded. Thread-local depths; ss_thread_root_reset clears them after a
+ * longjmp to a thread root skipped the matching leave. */
+void ss_cb_enter(void);
+void ss_cb_leave(void);
+void ss_bridge_enter(uint32_t nid, uint32_t caller_r1, uint32_t slice_r1, uint32_t caller_r2);
+void ss_bridge_leave(void);
+void ss_thread_root_reset(void);
+
+/* ---- SPU ---------------------------------------------------------------- */
+enum { SS_SPU_LIFTED = 1, SS_SPU_FALLBACK = 2 };
+enum { SS_SPU_AT_HOP = 1, SS_SPU_W_CHANNEL, SS_SPU_W_SIGNAL, SS_SPU_W_EQUEUE };
+typedef struct ss_spu_desc {
+    uint32_t spu_id, pc, image_id, host_depth, status;
+    int      irq_saved, resv_valid;
+} ss_spu_desc;
+typedef struct ss_spu_ops {
+    void (*describe)(const void* spu_ctx, ss_spu_desc* d);
+    void (*force_hops)(int on);      /* every loop through the drain loop, inline hop off */
+} ss_spu_ops;
+/* An SPU host thread starts / ends (lv2 group_start's thread procs). ctx NULL
+ * = any context this thread runs (PPU-fallback threads). */
+void ss_spu_thread_begin(const void* ctx, uint32_t tid, uint32_t group, int kind,
+                         const ss_spu_ops* ops);
+void ss_spu_thread_end(void);
+/* Park point: a drain hop (SS_SPU_AT_HOP) or a host wait (SS_SPU_W_*), no
+ * host lock held. ctx NULL = this thread's registered context. A LOAD
+ * discards a parked SPU host thread from here: unregistered, then a longjmp
+ * to its discard root (never returns). */
+void ss_spu_park_point(const void* ctx, int where);
+/* The calling SPU host thread's DISCARD ROOT (M4c): a jmp_buf* its thread
+ * proc set up with setjmp after ss_spu_thread_begin; a discard longjmps
+ * there with SS_ROOT_DISCARD and the proc returns at once (no finish event,
+ * no exit status: the thread belongs to the state being thrown away). NULL
+ * clears it. A registered SPU thread without one cannot be discarded: a
+ * LOAD refuses it (SS_REASON_SPU_EXTRA). */
+void ss_spu_set_root(void* jmpbuf);
+#define SS_SPU_PENDING() SS_UNLIKELY(g_ss_spu_req != 0)
+
+/* ---- audio mixer -------------------------------------------------------- */
+void ss_mixer_present(int on);                      /* mixer thread started / stopping */
+void ss_mixer_park_point(int queue_fill, int queue_cap);   /* top of the mixer loop */
+
+/* ---- coordinator -------------------------------------------------------- */
+/* Call once per frame-clock iteration (and from the modal-loop tick) with the
+ * guest's flip count; does nothing unless armed or a save / load request from
+ * the window (ss_ui.h, g_ss_ui_pending) is waiting -- that is handed on first.
+ * Armed with no request and no request source (SS_CENSUS, SS_SAVE_AT) it
+ * notes the flip count and returns. */
+void ss_frame_tick(unsigned flip_count);
+int  ss_stop_in_progress(void);
+/* (M5) The guest flip count the coordinator last saw (0: the game has not
+ * presented a frame yet). Any thread; armed only (0 when unarmed). */
+unsigned ss_flip_count(void);
+/* (M5) Where an SS_SAVE_AT capture goes next: called on the frame-clock
+ * thread right after its "[ss] SS_SAVE_AT t=..." line, with the image
+ * sealed (ss_image_last) when ok -- the slot glue (ss_slots.c) writes it to
+ * the slot SS_SAVE_SLOT names. NULL: the capture stays in RAM. */
+typedef void (*ss_save_at_sink_fn)(int ok, int reason, double t);
+void ss_set_save_at_sink(ss_save_at_sink_fn fn);
+/* (M5) Whether this build has a continuation for return address ra: 1 yes
+ * (*noreturn: the continuation never returns, so nothing above it in the
+ * chain runs), 0 no, 2 ra is not in lifted code at all (a chain's walk has
+ * gone past its root), -1 unknown (no continuation table registered). For a
+ * load's check that every chain of the image can be resumed. */
+int  ss_cont_covered(uint32_t ra, int* noreturn);
+
+/* ---- requests (M4a; engine design 4.1) ----------------------------------- */
+/* Every stop is a request: the window menu and hotkeys (M5), SS_SAVE_AT, the
+ * census (SS_CENSUS), later SS_SELFTEST_EVERY and the overlay's freeze. One
+ * at a time: ss_request_submit copies the request (any thread); the
+ * coordinator starts its stop at the next flip and, once every thread is
+ * parked, checks ELIGIBILITY:
+ *   STRICT (SAVE, SELFTEST, HOLD -- a save may follow a hold): every
+ *     RUNNING/DETACHED PPU thread parked outside a guest callback, a libsre
+ *     bridge and a pending trampoline, with a root record and a strict walk
+ *     (ss_sr_ops.walk) that is ok; every registered SPU host thread parked at
+ *     a drain hop or at an audited restartable host wait (ss_set_spu_audited),
+ *     with no interrupt handler in flight, no foreign / extra SPU context and
+ *     no PPU-fallback SPU thread; the mixer parked; the walker idle, parked
+ *     or at an acquire and not being pumped; no guest code on host threads;
+ *     no thread or SPU thread in transition (ss_transition_*); every check
+ *     added with ss_add_check passing (the game's own save, a guest file
+ *     open for writing); not booting (no flip yet); no debug switch that
+ *     breaks parking (PPU_THREADGATE, RD_SPU_INTERP). Each parked thread's
+ *     S3 kind is recorded (the M4c resumers), not judged.
+ *   LENIENT (LOAD): the same, except WHERE a thread is parked: any S1/S2/S3
+ *     park can be discarded, bridges included (the strict walk, bridge,
+ *     trampoline, SPU pc / interrupt / fallback and walker checks do not
+ *     apply); a park inside a callback cannot happen, and is refused.
+ * The checks that need no stop -- the debug switch, booting, the added
+ * checks, the transitions -- are also read BEFORE each stop, with the world
+ * running: while one blocks there is no stop (a debug switch, fixed at
+ * startup, refuses the request at once), and they are judged again with
+ * everything parked.
+ * Not eligible (or not converged): release, and again after SS_RETRY_GAP
+ * times the stop's length (at the next flip at the earliest) until
+ * give_up_s -- or until the next stop could not start before it -- then
+ * done(0, the last FIRST blocking reason). A census has no eligibility and
+ * no pre-check: it is done when a stop converged, or after its SS_RETRIES
+ * retries (at the next flip).
+ * CAPTURE (M4b). Before each stop of a SAVE, with the world running, the
+ * staging buffer grows to what a capture can need (ss_state_prepare; a
+ * failure is a pre-check blocker, SS_REASON_CAPTURE). At an eligible stop,
+ * still stopped: the GPU made idle (ss_host_ops.gpu_idle), every section's
+ * check() (ss_state_check: a refusal is that section's reason, retried like
+ * any other), every section's capture() (ss_state_capture: an overflow is
+ * SS_REASON_CAPTURE, retried after the buffer grew). The stop's watchdog --
+ * a parked thread that has waited far longer than any stop takes releases
+ * everything, the coordinator being wedged -- allows SS_CAPTURE_GRACE_MS
+ * more from the GPU flush to the release, and the coordinator checks
+ * after the flush and after the capture that it did not fire: a stop it
+ * released is refused (SS_REASON_CAPTURE, "watchdog"), with no section's
+ * check() run against the running world and no image kept. Then the
+ * release, and with the game running: the image sealed (CRC32C), one
+ * "[ss] save request #N: captured ..." line with the pause (stop + gpu +
+ * capture), and for SS_RQ_DUMP the raw file; done(1, SS_REASON_OK), and
+ * ss_image_last() is the image until the next capture starts (with
+ * SS_RQ_HOLD: ss_image_held(), until released or replaced).
+ * LOAD and SELFTEST (M4c): see "the load" below. HOLD runs its stop and
+ * check, then is done(0, SS_REASON_NOT_YET). */
+enum ss_purpose { SS_P_CENSUS = 1, SS_P_SAVE, SS_P_LOAD, SS_P_HOLD, SS_P_SELFTEST, SS_P__N };
+enum {                                             /* ss_request.flags */
+    SS_RQ_DUMP   = 1u,                             /* SAVE: also write the raw image */
+    SS_RQ_HOLD   = 2u,                             /* SAVE: keep the image (ss_image_held) for a later LOAD */
+    SS_RQ_VERIFY = 4u,                             /* LOAD / SELFTEST: run the fidelity check */
+    /* LOAD (M5): the image's chunk CRCs were checked as it was read (a slot
+     * file, ss_file.h): its validation before the stop skips them (a second
+     * CRC32C pass over ~350 MB on the frame clock); everything else is checked */
+    SS_RQ_CRC_CHECKED = 8u
+};
+struct ss_image;
+typedef struct ss_request {
+    int      purpose;                              /* SS_P_* */
+    int      slot;                                 /* SAVE / LOAD: the slot (-1: none) */
+    double   give_up_s;                            /* retry window; 0 = 3 s */
+    void   (*done)(int ok, int reason, void* user);   /* on the frame-clock thread */
+    void*    user;
+    unsigned flags;                                /* SS_RQ_* (appended) */
+    /* LOAD (appended, M4c): the image to load -- validated before the stop
+     * (CRCs, layouts, park kinds); it must stay valid until done() (a held
+     * image: ss_image_held). NULL: done(0, SS_REASON_NOT_YET). */
+    const struct ss_image* image;
+} ss_request;
+enum { SS_R_QUEUED = 1, SS_R_BUSY = 0, SS_R_OFF = -1, SS_R_INVALID = -2 };
+int ss_request_submit(const ss_request* r);   /* any thread; one at a time */
+int ss_busy(void);                            /* a request is queued or running */
+
+/* Why a request was refused (design section 7). ss_reason_text is the
+ * user-facing text; the blocker (a thread's name, an SPU, a file) is
+ * ss_request_result.detail, to append in parentheses. */
+enum ss_reason {
+    SS_REASON_OK = 0,
+    SS_REASON_NOT_YET,         /* that part of the engine is not built yet (M4b / M4c) */
+    SS_REASON_OFF,             /* SAVESTATES=0, or disarmed while it waited */
+    SS_REASON_BOOTING,         /* no flip yet */
+    SS_REASON_DEBUG_SWITCH,    /* PPU_THREADGATE / RD_SPU_INTERP */
+    SS_REASON_THREAD_BUSY,     /* a PPU thread never reached a safepoint (a straggler) */
+    SS_REASON_CALLBACK,        /* ... it was inside a guest callback */
+    SS_REASON_GAME_SAVING,     /* cellSaveData is inside an operation */
+    SS_REASON_FILE_WRITE,      /* a guest file is open for writing */
+    SS_REASON_TRANSITION,      /* a PPU thread or an SPU thread starting or exiting */
+    SS_REASON_BRIDGE,          /* parked inside a libsre bridge call */
+    SS_REASON_TRAMPOLINE,      /* parked with a trampoline pending */
+    SS_REASON_NOT_RESUMABLE,   /* the strict walk failed (no continuation, ...) */
+    SS_REASON_NO_ROOT,         /* a thread without a root record */
+    SS_REASON_SPU_BUSY,        /* an SPU did not park, or not at a restartable pc */
+    SS_REASON_SPU_EXTRA,       /* an extra SPU context, or a PPU-fallback SPU thread */
+    SS_REASON_AUDIO,           /* the cellAudio mixer did not park */
+    SS_REASON_GPU,             /* the RSX walker is busy */
+    SS_REASON_HOST_GUEST,      /* guest code ran on a host thread during the stop */
+    SS_REASON_SECTION,         /* a save-state section's check() refused (no reason of its own) */
+    SS_REASON_CAPTURE,         /* the capture failed: staging buffer full / out of memory, a section's error */
+    SS_REASON_IMAGE,           /* (M4c) the image to load is damaged, or another build's (a layout) */
+    SS_REASON_WRITING,         /* (M5) a slot file is still being written from the last capture */
+    SS_REASON__N
+};
+const char* ss_reason_text(int reason);   /* "the game is saving its progress, ..." */
+const char* ss_reason_name(int reason);   /* "game-saving" (logs, statistics) */
+
+typedef struct ss_request_result {
+    int      purpose, ok, reason;
+    unsigned seq;              /* request number in the log */
+    unsigned attempts;         /* stops it ran */
+    double   stopped_ms;       /* ... their total length: the game stood still that long */
+    double   waited_ms;        /* submit -> done */
+    double   eligible_ms;      /* submit -> the eligible stop; < 0: none */
+    char     detail[96];       /* the first blocker: thread name, "SPU 0x2003", a file */
+    char     why[192];         /* the same for the log: kind, return address, pc */
+    /* a SAVE that was captured (appended) */
+    double   pause_ms;         /* its eligible stop: stop + gpu + capture */
+    double   gpu_ms, capture_ms;
+    unsigned long long image_bytes;
+    /* a LOAD / SELFTEST that loaded (appended, M4c): its phases (ms), the
+     * fidelity check, the threads it recreated */
+    double   discard_ms, teardown_ms, restore_ms, verify_ms, recreate_ms, release_ms;
+    int      verified;         /* the fidelity check ran */
+    unsigned verify_compared, verify_differ;   /* sections */
+    unsigned ppu_recreated, spu_recreated, norestore;
+} ss_request_result;
+void ss_last_request(ss_request_result* out);   /* the last finished one (also inside done) */
+
+typedef struct ss_request_stats {
+    unsigned done, ok, not_yet, refused, attempts;
+    unsigned by_reason[SS_REASON__N];
+    double   eligible_ms_max;
+    /* captured SAVEs (appended): the pause of each one's eligible stop */
+    unsigned captured;
+    double   pause_p50, pause_p95, pause_max;
+} ss_request_stats;
+void ss_get_request_stats(int purpose, ss_request_stats* out);   /* purpose 0: all */
+/* "[ss] requests <when>: save 4 (ok 3, refused 1: not-resumable x1, ...)".
+ * Logged after every request that is not a census, at exit() and wherever
+ * the title ends the process another way (ExitProcess skips atexit). */
+void ss_request_summary(const char* when);
+
+/* Transitions a snapshot cannot hold (the table-busy counters): a PPU thread
+ * being created or exiting, an SPU host thread starting or ending. Begin /
+ * end pairs from any thread; a strict or lenient stop waits until both are
+ * zero. Plain counters: they cost the same armed or not. */
+enum { SS_TR_PPU_THREAD = 0, SS_TR_SPU_THREAD, SS_TR__N };
+void ss_transition_begin(int what);
+void ss_transition_end(int what);
+
+/* Eligibility checks the rest of the runtime adds (up to 8, any time, any
+ * thread): fn fills `what` (a name for the log and the refusal, e.g. the
+ * file) and returns non-zero while a snapshot must wait -- reason is what
+ * the refusal says. Called on the coordinator: before a request's stop with
+ * the world running (advisory), with every guest thread parked, and after a
+ * stop that did not converge, to name the reason. So keep it a read of the
+ * subsystem's own state, no lock, safe while that state changes under it
+ * (fixed-size arrays, no pointer chased that a close may free). */
+typedef int (*ss_check_fn)(char* what, unsigned what_n);
+void ss_add_check(int reason, ss_check_fn fn);
+
+/* The SPU host waits a strict save accepts besides a drain hop (an exact
+ * pc): rows (lifted image id, where it parked, LS pc) the SPU study audited
+ * as exact or restartable -- run again from that pc after a load, the SPU
+ * does what continuing would have done. An image id means "this title's SPU
+ * images in registration order" (ss_spu_desc.image_id, the "img=" of a
+ * census "spu" line), so the toolkit has no rows: the project registers its
+ * table at startup, before the first request (rows are copied).
+ * SS_SPU_AUDITED / ss_config.spu_audited replace it for an experiment.
+ * To extend: find the park in a census (SS_CHAINS "spu ... where= pc= img="),
+ * audit what the SPU does from that pc again -- an idempotent prefix (channel
+ * reads re-issued, a reservation re-taken) or an exact resume -- then add a
+ * row to the project's table (and to tools/ss_census.py's SPU_AUDITED). */
+typedef struct ss_spu_audit {
+    uint32_t image_id;
+    int      where;             /* SS_SPU_W_CHANNEL / SS_SPU_W_SIGNAL / SS_SPU_W_EQUEUE */
+    uint32_t pc;
+} ss_spu_audit;
+void ss_set_spu_audited(const ss_spu_audit* rows, int n);
+
+/* Results, for tests and tools. Census stops only (the "[ss] census" lines
+ * and their summary), except `stops` and `watchdogs`: every stop of every
+ * purpose. */
+typedef struct ss_stats {
+    unsigned attempts, ok, fail_ppu, fail_spu, mixer_late, censuses;
+    double   ppu_p50, ppu_p95, ppu_max;     /* converged attempts, ms */
+    double   stop_p50, stop_p95, stop_max;  /* whole stop, ms */
+    unsigned within_500;                    /* converged within 500 ms */
+    unsigned strict_stops;                  /* ...every parked thread passed the strict walk */
+    unsigned stops;                         /* stops of any purpose (a census, a save, ...) */
+    unsigned watchdogs;                     /* stops the watchdog released (appended) */
+} ss_stats;
+void ss_get_stats(ss_stats* s);
+/* Called with everything parked at every converged stop whatever its purpose
+ * (tests), after an eligible SAVE's sections were captured. */
+extern void (*g_ss_on_capture)(void* user);
+extern void*  g_ss_on_capture_user;
+
+/* ---- P0: per-thread self-resume (SS_SELFRESUME) ------------------------- */
+/* The first in-game run of the machinery a fresh-process load will use. A
+ * requested thread at an S1/S2 entry -- the ENTRY context of an HLE call or
+ * syscall: nothing of the call done yet -- checks that its guest call chain
+ * can be rebuilt from the continuation table (runtime/ppu/ppu_resume.h),
+ * copies its context, and longjmps to its thread root, discarding every host
+ * frame between. The root resets the host thread-local state those frames
+ * held (the indirect-call depth and vcall stack, the callback / bridge
+ * depths, the trampoline), restores the copy, re-issues the call and runs the
+ * continuations to the root -- `blr`, in software. Guest memory, the other
+ * threads and every kernel object are left alone.
+ * Eligible: on the root's own context (not a callback's), no guest callback /
+ * libsre bridge nested, no trampoline pending, a return address recorded, and
+ * every frame of the chain has a continuation and checks out. A thread that
+ * is not eligible stays requested and tries again at its next S1/S2 entry;
+ * the reasons are counted, return addresses with no continuation are logged
+ * once each ("[ss-resume] missing 0x...", ready for config/ss_cont_list.txt),
+ * a chain that has continuations but fails a check is logged as REFUSED. */
+#define SS_ROOT_RESUME 0x5352     /* what a root's setjmp returns for a self-resume */
+
+/* Thread roots: the host function that calls a guest thread's entry, around
+ * `switch (setjmp(*jmpbuf))` (sys_ppu_thread.c's thread proc; ppu_run for the
+ * main thread). Enter before the setjmp, leave after the entry returned; at
+ * case SS_ROOT_RESUME run the scaffold's thread-root reset, then
+ * ss_root_resume. All three are inert unless SS_SELFRESUME is set -- except
+ * that armed (always, unless SAVESTATES=0) ss_root_enter / leave also keep
+ * each thread's root record (its entry LR, r1 and stack range), for the
+ * strict walk of a census or a save ("  strict" lines in SS_CHAINS).
+ * SS_SELFRESUME_ATROOT=1 also requests each selected thread as it enters its
+ * root, so it self-resumes at its first eligible S1/S2 entry: the way to run
+ * threads that park for good once started (the SPURS handlers) through P0. */
+void ss_root_enter(void* jmpbuf /* jmp_buf* */, struct ppu_context* ctx);
+void ss_root_leave(void);
+/* Restore the snapshot into the thread's context and run the thread from it.
+ * Returns when the guest entry function returns, like the first run did. */
+void ss_root_resume(void);
+
+/* Why a requested thread did not resume at an S1/S2 entry. check() returns
+ * SS_SR_OK, SS_SR_NO_RA, SS_SR_NOT_COVERED, or SS_SR_REFUSED_BASE + the
+ * ppu_resume error (a chain WITH continuations that failed a check). */
+enum { SS_SR_OK = 0, SS_SR_NO_RA, SS_SR_NOT_COVERED, SS_SR_REFUSED,
+       SS_SR_CALLBACK, SS_SR_NO_ROOT, SS_SR_TRAMP, SS_SR_BRIDGE, SS_SR_NO_OPS,
+       SS_SR__N };
+#define SS_SR_REFUSED_BASE 100
+typedef struct ss_sr_root {
+    uint32_t root_lr;             /* LR the guest entry was called with */
+    uint32_t root_sp;             /* r1 it was called with */
+    uint32_t stack_lo, stack_hi;  /* the thread's guest stack [lo, hi) */
+} ss_sr_root;
+/* The strict walk of a parked thread's chain (the census, M4a-0): what a save
+ * would check before it accepts the thread -- every frame has a continuation
+ * and agrees with the stack, up to the root. Nothing is logged or resumed. */
+enum { SS_SRW_MISSING = 1, SS_SRW_UNMODELLED, SS_SRW_PARTIAL };
+enum { SS_SRW_MAXMISS = 8 };
+typedef struct ss_sr_walk_out {
+    int      verdict;     /* SS_SR_OK, SS_SR_NO_RA, SS_SR_NOT_COVERED, SS_SR_REFUSED_BASE + error */
+    int      why;         /* NOT_COVERED: SS_SRW_MISSING / _UNMODELLED / _PARTIAL */
+    int      frames;      /* frames the walk went through */
+    int      root;        /* how it ended (ppu_resume.h PPU_RESUME_ROOT_*), 0 = it did not */
+    uint32_t err_ra;      /* the first return address that is not covered or failed */
+    int      nmiss;       /* return addresses with no continuation (all of the chain's) */
+    uint32_t miss[SS_SRW_MAXMISS];
+} ss_sr_walk_out;
+
+/* The PPU half (runtime/ppu/ppu_selfresume.cpp registers it at static init). */
+typedef struct ss_sr_ops {
+    int         (*check)(const struct ppu_context* ctx, int at, uint32_t num,
+                         const ss_sr_root* root, int* frames);
+    uint32_t    (*run)(struct ppu_context* ctx, int at, uint32_t num, const ss_sr_root* root);
+    uint32_t    (*count)(void);               /* continuations registered */
+    const char* (*strerror)(int err);         /* a ppu_resume error */
+    /* at: SS_AT_SC (first return address sc_ra) or SS_AT_HLE (lr); root NULL =
+     * not recorded (the chain then ends at return address 0, any r1). */
+    void        (*walk)(const struct ppu_context* ctx, int at, const ss_sr_root* root,
+                        ss_sr_walk_out* out);
+    /* (appended, M4c) a load's resume of a thread parked inside an S3 wait
+     * of `kind`: the kind's resumer (ss_wait_resumer) or a re-issue, then
+     * the continuations to the root. Returns the continuations run. */
+    uint32_t    (*run_wait)(struct ppu_context* ctx, int kind, uint32_t obj, const ss_wait_rec* rec,
+                            const ss_sr_root* root);
+    /* (appended, M5) the continuation table: 1 if ra has a continuation
+     * (*noreturn set when it never returns), 0 if not (ss_cont_covered) */
+    int         (*cont_lookup)(uint32_t ra, int* noreturn);
+} ss_sr_ops;
+void ss_set_sr_ops(const ss_sr_ops* ops);
+
+typedef struct ss_sr_stats {
+    unsigned requests, resumes, roots, overdue, ctx_changed;
+    unsigned skip[SS_SR__N];
+    unsigned refused[16];                     /* by ppu_resume error */
+    double   lat_avg_ms, lat_max_ms, frames_avg;
+    int      frames_max, icall_max;
+    unsigned long long host_sp_drift;         /* bytes the root's frame moved between resumes */
+} ss_sr_stats;
+void ss_sr_get_stats(unsigned tid, ss_sr_stats* out);   /* tid 0: all threads */
+void ss_sr_summary(const char* when);
+/* Tests: arm without the environment (period_ms 0 = no timer requests), and
+ * raise one thread's request by hand. */
+void ss_sr_configure(unsigned period_ms, unsigned long long tid_mask, double start_s, long log_n);
+void ss_sr_request(unsigned tid);
+
+/* ---- the load (M4c; engine design 4.3) ---------------------------------- */
+/* A LOAD request carries an image (ss_request.image, normally the held one);
+ * a SELFTEST captures state A at its eligible stop and loads A in the same
+ * stop -- a round trip. Before the stop, with the world running: the image
+ * validates (ss_image_validate), every PPU thread in it has a park record
+ * whose kind is resumable, every section's check_image accepts its part
+ * (ss_state_check_image), and this build can recreate threads (sys_ppu_
+ * thread.c registers ss_set_ppu_recreate) -- else done(0, ...) with no stop.
+ * At the stop (lenient for LOAD, strict for SELFTEST), also: every parked PPU
+ * thread has a root, every SPU host thread a discard root, none waits in
+ * sys_cond_wait (its waiter record lives on its host stack), no modal loop.
+ * Then, on the coordinator (ss_state.h "THE LOAD" is the sections' side):
+ *   DISCARD   every parked PPU thread but main wakes with a discard verdict,
+ *             drops the park lock and longjmps to its root with
+ *             SS_ROOT_DISCARD; the root returns from the host thread proc at
+ *             once -- no FINISHED, no finish event, no table write. Main
+ *             longjmps to its root too and waits at the load gate. SPU host
+ *             threads unregister and longjmp to their discard root. The
+ *             coordinator waits for every one of those host threads to exit
+ *             and for main at the gate (SS_DISCARD_MS, 2000). The POINT OF
+ *             NO RETURN: from here on a failure ends the process.
+ *   TEARDOWN / RESTORE / VERIFY   ss_state_teardown, ss_state_restore,
+ *             and (SS_VERIFY, SS_RQ_VERIFY) a capture into the spare bank
+ *             compared with the image (ss_state_verify)
+ *   RECREATE  ss_core's own tables reset (parks, roots, P0, SPU slots); the
+ *             SPU threads the image runs started in resume mode (lv2_
+ *             register.c, ss_set_spu_recreate), every RUNNING / DETACHED PPU
+ *             thread but main started in resume mode at its slot (ss_set_
+ *             ppu_recreate): all held at the gate
+ *   RELEASE   the guest clock thawed (time continues from the snapshot),
+ *             the gate opened (main and every recreated thread resume from
+ *             its park record), the mixer released, the walker rebased, the
+ *             frame clock resynced (ss_host_ops.resync_clock), every
+ *             section's after_release
+ * One "[ss] load request #N ..." line per load: the pause by phase and the
+ * fidelity check's result (each differing section's first field). After
+ * the point of no return a failure -- a thread that does not unwind in
+ * time, a restore error -- prints "[ss] FATAL ..." and ends the process
+ * with a message box (SS_FATAL_BOX=0: none) and exit code 3: never a game
+ * running on a half state. */
+#define SS_ROOT_DISCARD 0x5344      /* what a root's setjmp returns when a load discards the thread */
+/* PPUT's restore: the park record thread `tid` resumes from (every RUNNING /
+ * DETACHED slot; main's too). ctx is copied. 0, or -1 for a bad tid. */
+int  ss_load_set_park(unsigned tid, int at, int tier, uint32_t num, uint32_t obj, const ss_wait_rec* rec,
+                      const ss_sr_root* root, int root_valid, const struct ppu_context* ctx);
+int  ss_loading(void);              /* between a load's discard and its release */
+/* The S3 payload of thread `tid`'s park in the stop in progress -- during a
+ * load, of its restored park record. 1 = filled. (PPUT's capture.) */
+int  ss_ppu_wait_rec(unsigned tid, ss_wait_rec* out);
+/* Thread recreation, registered by the owners (sys_ppu_thread.c,
+ * lv2_register.c) at their init. ppu: start slot `tid`'s host thread in
+ * resume mode (its root takes ss_root_load_enter / ss_root_load_run);
+ * 0 or -1 with why. spu: start every lv2 SPU thread the restored tables
+ * say runs, in resume mode (held at ss_load_gate_wait); the number started,
+ * or -1 with why. */
+typedef int (*ss_ppu_recreate_fn)(unsigned tid, char* why, size_t why_n);
+typedef int (*ss_spu_recreate_fn)(char* why, size_t why_n);
+void ss_set_ppu_recreate(ss_ppu_recreate_fn fn);
+void ss_set_spu_recreate(ss_spu_recreate_fn fn);
+/* (appended) The session's own SPU work a load would not replace -- the async
+ * runner, a raw SPU, a debug switch -- read again in every stop a load runs
+ * in (lv2_register.c registers it): 0, or an ss_reason with why. */
+typedef int (*ss_load_session_fn)(char* why, size_t why_n);
+void ss_set_load_session_check(ss_load_session_fn fn);
+/* PPUT's check of an image before a load (sys_ppu_thread.c): every RUNNING /
+ * DETACHED thread has a park record, of a resumable kind. 0, or non-zero
+ * with why (the load is refused: SS_REASON_IMAGE / NOT_RESUMABLE). */
+void ss_set_ppu_image_check(int (*fn)(const struct ss_image* img, char* why, size_t why_n));
+/* A recreated PPU thread's root: in place of ss_root_enter, the root record
+ * of its restored park (critique H3: never its restored, nested context). */
+void ss_root_load_enter(void* jmpbuf, struct ppu_context* ctx);
+/* At the root -- case 0 of a recreated thread, or main's SS_ROOT_DISCARD
+ * case (discarded = 1: main tells the coordinator it is at the gate): wait
+ * at the load gate, put the restored park record into the thread's context,
+ * resume it (S1 / S2: re-issue; S3: re-issue or the kind's resumer; then the
+ * continuations to the root). Returns when the entry function returns. */
+void ss_root_load_run(int discarded);
+/* A recreated SPU host thread: wait until the load's release. */
+void ss_load_gate_wait(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_SS_CORE_H */
diff --git a/runtime/savestate/ss_file.c b/runtime/savestate/ss_file.c
new file mode 100644
index 0000000..a19a0bd
--- /dev/null
+++ b/runtime/savestate/ss_file.c
@@ -0,0 +1,1001 @@
+/*
+ * ps3recomp - save-state slot files: the P3SS v1 container (see ss_file.h)
+ *
+ * The codec is the Windows Compression API in raw mode (cabinet.dll, loaded on
+ * first use: an OS component, nothing linked, nothing shipped). One
+ * compressor / decompressor handle per worker thread (a handle is not
+ * thread-safe). Writing compresses ahead on workers into a ring of slots and
+ * the caller's thread writes them out in order; reading maps the file and
+ * decompresses every chunk on workers straight into the raw image.
+ */
+#include "ss_file.h"
+#include "../platform/win32_compat.h"
+#include "../platform/host_placement.h"   /* the codec pool runs on every core (HOST_PLACEMENT) */
+
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#ifdef _WIN32
+#  include <windows.h>
+#endif
+
+#if defined(__cplusplus) || (defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L)
+_Static_assert(sizeof(p3ss_sec) == 56, "p3ss_sec is 56 bytes");
+_Static_assert(sizeof(p3ss_chunk) == 24, "p3ss_chunk is 24 bytes");
+_Static_assert(offsetof(p3ss_hdr, sec) == 448, "p3ss_hdr.sec at 448");
+_Static_assert(sizeof(p3ss_hdr) == P3SS_HDR_SIZE, "p3ss_hdr is 4096 bytes");
+#endif
+
+#define FNV64_INIT 1469598103934665603ull
+static uint64_t fnv64(uint64_t h, const void* p, size_t n)
+{
+    const uint8_t* b = (const uint8_t*)p;
+    for (size_t i = 0; i < n; i++) { h ^= b[i]; h *= 1099511628211ull; }
+    return h;
+}
+
+static double now_ms(void)
+{
+#ifdef _WIN32
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart * 1000.0 / (double)f.QuadPart;
+#else
+    return (double)clock() * 1000.0 / CLOCKS_PER_SEC;
+#endif
+}
+
+#define FAIL(e, sw, ...) do { if (why && why_n) snprintf(why, why_n, __VA_ARGS__); \
+                              if (short_why) *short_why = (sw); return (e); } while (0)
+
+/* ---------------------------------------------------------------------------
+ * Names
+ * -----------------------------------------------------------------------*/
+static const char* const k_codec[P3SS_CODEC__N] = { "none", "xpress", "xpress_huff" };
+const char* ss_file_codec_name(int c) { return (c >= 0 && c < P3SS_CODEC__N) ? k_codec[c] : "?"; }
+int ss_file_codec_parse(const char* s)
+{
+    if (!s) return -1;
+    for (int i = 0; i < P3SS_CODEC__N; i++) if (!_stricmp(s, k_codec[i])) return i;
+    if (!_stricmp(s, "xpress-huff") || !_stricmp(s, "huff")) return P3SS_CODEC_XPRESS_HUFF;
+    if (!_stricmp(s, "0") || !_stricmp(s, "off")) return P3SS_CODEC_NONE;
+    return -1;
+}
+
+static const char* const k_mode[P3SS_MODE__N] = {
+    "", "gameplay", "pause menu", "title menu", "movie", "cutscene", "loading" };
+const char* ss_file_mode_name(uint32_t m) { return m < P3SS_MODE__N ? k_mode[m] : ""; }
+
+/* ---------------------------------------------------------------------------
+ * The Compression API (cabinet.dll)
+ * -----------------------------------------------------------------------*/
+#ifdef _WIN32
+typedef BOOL (WINAPI *cz_create_fn)(DWORD, void*, void**);
+typedef BOOL (WINAPI *cz_run_fn)(void*, LPCVOID, SIZE_T, PVOID, SIZE_T, SIZE_T*);
+typedef BOOL (WINAPI *cz_close_fn)(void*);
+static struct {
+    volatile LONG state;              /* 0 not loaded, 1 loading, 2 ok, 3 unavailable */
+    cz_create_fn  create_c, create_d;
+    cz_run_fn     compress, decompress;
+    cz_close_fn   close_c, close_d;
+} s_cz;
+
+static int cz_load(void)
+{
+    for (;;) {
+        const LONG st = s_cz.state;
+        if (st == 2) return 1;
+        if (st == 3) return 0;
+        if (st == 0 && InterlockedCompareExchange(&s_cz.state, 1, 0) == 0) break;
+        Sleep(0);
+    }
+    HMODULE m = LoadLibraryA("cabinet.dll");
+    if (m) {
+        s_cz.create_c = (cz_create_fn)(void*)GetProcAddress(m, "CreateCompressor");
+        s_cz.create_d = (cz_create_fn)(void*)GetProcAddress(m, "CreateDecompressor");
+        s_cz.compress = (cz_run_fn)(void*)GetProcAddress(m, "Compress");
+        s_cz.decompress = (cz_run_fn)(void*)GetProcAddress(m, "Decompress");
+        s_cz.close_c = (cz_close_fn)(void*)GetProcAddress(m, "CloseCompressor");
+        s_cz.close_d = (cz_close_fn)(void*)GetProcAddress(m, "CloseDecompressor");
+    }
+    const int ok = m && s_cz.create_c && s_cz.create_d && s_cz.compress && s_cz.decompress && s_cz.close_c &&
+                   s_cz.close_d;
+    InterlockedExchange(&s_cz.state, ok ? 2 : 3);
+    return ok;
+}
+
+enum { CZ_ALG_XPRESS = 3, CZ_ALG_XPRESS_HUFF = 4, CZ_RAW = 1 << 29 };   /* compressapi.h */
+static DWORD cz_alg(int codec) { return (codec == P3SS_CODEC_XPRESS ? CZ_ALG_XPRESS : CZ_ALG_XPRESS_HUFF) | CZ_RAW; }
+#endif
+
+/* ---------------------------------------------------------------------------
+ * Workers
+ * -----------------------------------------------------------------------*/
+static int cpu_count(void)
+{
+#ifdef _WIN32
+    DWORD n = GetActiveProcessorCount(ALL_PROCESSOR_GROUPS);
+    return n ? (int)n : 4;
+#else
+    return 4;
+#endif
+}
+
+static int env_threads(void)
+{
+    const char* e = getenv("SS_THREADS");
+    const int n = e && *e ? atoi(e) : 0;
+    return n > 0 && n <= 64 ? n : 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Writing
+ * -----------------------------------------------------------------------*/
+#ifdef _WIN32
+#define WSLOTS_PER_THREAD 3
+#define CZ_OUT_CAP (SS_CHUNK_BYTES + SS_CHUNK_BYTES / 8 + 4096)
+
+typedef struct wjob {
+    const ss_image* img;
+    int             codec;
+    uint32_t        n;                 /* chunks (the image's chunk table) */
+    int             nslots;
+    uint8_t**       sbuf;              /* per slot: the compressed bytes */
+    uint32_t*       sn;                /* per slot: stored size */
+    uint32_t*       scodec;            /* per slot: P3SS_CODEC_* */
+    volatile LONG*  schunk;            /* per slot: the chunk it holds, ready; -1 none */
+    LONG            next, written;     /* under lk */
+    int             stop;              /* under lk */
+    SRWLOCK         lk;
+    CONDITION_VARIABLE cv_ready, cv_free;
+    volatile LONG64 codec_us;          /* busy time, summed */
+    volatile LONG   none;              /* chunks stored as they are */
+    int             below_normal;
+} wjob;
+
+static DWORD WINAPI wjob_worker(LPVOID p)
+{
+    wjob* j = (wjob*)p;
+    if (!j->below_normal) ps3_host_unplace_thread();   /* a background F5 write stays on the shared cores */
+    if (j->below_normal) SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    void* cz = NULL;
+    if (j->codec != P3SS_CODEC_NONE && !s_cz.create_c(cz_alg(j->codec), NULL, &cz)) cz = NULL;
+    for (;;) {
+        AcquireSRWLockExclusive(&j->lk);
+        while (!j->stop && j->next < (LONG)j->n && j->next >= j->written + j->nslots)
+            SleepConditionVariableSRW(&j->cv_free, &j->lk, INFINITE, 0);
+        if (j->stop || j->next >= (LONG)j->n) { ReleaseSRWLockExclusive(&j->lk); break; }
+        const LONG i = j->next++;
+        ReleaseSRWLockExclusive(&j->lk);
+        const int s = (int)(i % j->nslots);
+        const ss_chunk_ent* c = &j->img->chunk[i];
+        const uint8_t* src = j->img->data + c->offset;
+        const double t0 = now_ms();
+        SIZE_T got = 0;
+        int ok = 0;
+        if (cz && c->size) {
+            ok = s_cz.compress(cz, src, c->size, j->sbuf[s], CZ_OUT_CAP, &got) && got > 0 &&
+                 (uint64_t)got * 100u < (uint64_t)c->size * 98u;            /* < 98%: else stored as is */
+        }
+        if (ok) { j->sn[s] = (uint32_t)got; j->scodec[s] = (uint32_t)j->codec; }
+        else { j->sn[s] = c->size; j->scodec[s] = P3SS_CODEC_NONE; InterlockedIncrement(&j->none); }
+        InterlockedAdd64(&j->codec_us, (LONG64)((now_ms() - t0) * 1000.0));
+        AcquireSRWLockExclusive(&j->lk);
+        j->schunk[s] = i;
+        WakeAllConditionVariable(&j->cv_ready);
+        ReleaseSRWLockExclusive(&j->lk);
+    }
+    if (cz) s_cz.close_c(cz);
+    return 0;
+}
+
+static int write_all(HANDLE f, const void* p, uint64_t n, double* io_ms)
+{
+    const double t0 = now_ms();
+    const uint8_t* b = (const uint8_t*)p;
+    while (n) {
+        const DWORD k = (DWORD)(n > (64u << 20) ? (64u << 20) : n);
+        DWORD wr = 0;
+        if (!WriteFile(f, b, k, &wr, NULL) || wr != k) return 0;
+        b += k;
+        n -= k;
+    }
+    if (io_ms) *io_ms += now_ms() - t0;
+    return 1;
+}
+
+static uint64_t file_pos(HANDLE f)
+{
+    LARGE_INTEGER z, p;
+    z.QuadPart = 0;
+    return SetFilePointerEx(f, z, &p, FILE_CURRENT) ? (uint64_t)p.QuadPart : 0;
+}
+
+/* MoveFileEx(REPLACE_EXISTING | WRITE_THROUGH), retried for ~2 s; GetLastError
+ * is the last attempt's. */
+static int move_retry(const char* from, const char* to)
+{
+    for (int k = 0;; k++) {
+        if (MoveFileExA(from, to, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) return 1;
+        const DWORD le = GetLastError();
+        if (k >= 20 || le == ERROR_FILE_NOT_FOUND || le == ERROR_PATH_NOT_FOUND) { SetLastError(le); return 0; }
+        Sleep(100);
+    }
+}
+
+static void copy_str(char* d, size_t cap, const char* s)
+{
+    size_t k = 0;
+    for (; s && s[k] && k + 1 < cap; k++) d[k] = s[k];
+    for (; k < cap; k++) d[k] = 0;
+}
+#endif
+
+uint64_t ss_file_image_spu_table(const ss_image* img)
+{
+    ss_reader r;
+    uint64_t v = 0;
+    if (!img || ss_reader_open(&r, img, SS_FOURCC('S', 'P', 'U', 'C')) != SS_OK) return 0;
+    return ss_read_u64(&r, "image_table", &v) == SS_OK ? v : 0;
+}
+
+int ss_file_write(const char* path, const ss_image* img, const ss_file_meta* meta, const ss_file_wopts* o,
+                  ss_file_stats* st, char* why, size_t why_n)
+{
+    const char** short_why = NULL;
+    ss_file_stats dummy;
+    if (!st) st = &dummy;
+    memset(st, 0, sizeof *st);
+    if (!path || !img || !img->sealed || !img->sec) FAIL(SS_E_STATE, "", "no sealed image to write");
+#ifndef _WIN32
+    (void)meta; (void)o;
+    FAIL(SS_E_STATE, "", "slot files are Windows only");
+#else
+    const double t_start = now_ms();
+    const ss_img_hdr* ih = &img->hdr;
+    if (ih->nsections >= P3SS_SEC_MAX) FAIL(SS_E_ARG, "", "%u sections: more than a slot file holds", ih->nsections);
+    int codec = o ? o->codec : P3SS_CODEC_XPRESS_HUFF;
+    if (codec < 0 || codec >= P3SS_CODEC__N) codec = P3SS_CODEC_XPRESS_HUFF;
+    if (codec != P3SS_CODEC_NONE && !cz_load()) codec = P3SS_CODEC_NONE;   /* (no cabinet.dll: stored) */
+    int threads = o && o->threads > 0 ? o->threads : env_threads();
+    if (threads <= 0) { threads = cpu_count() / 2; if (threads > 6) threads = 6; }
+    if (threads < 1) threads = 1;
+    if (codec == P3SS_CODEC_NONE) threads = 1;
+
+    /* the header, filled as the file is written */
+    p3ss_hdr* h = (p3ss_hdr*)calloc(1, sizeof *h);
+    if (!h) FAIL(SS_E_NOMEM, "", "out of memory");
+    memcpy(h->magic, P3SS_MAGIC, 8);
+    h->format_version = P3SS_VERSION;
+    h->header_size = P3SS_HDR_SIZE;
+    ss_time_info ti;
+    memset(&ti, 0, sizeof ti);
+    (void)ss_time_read(img, &ti);
+    if (meta) {
+        copy_str(h->title_id, sizeof h->title_id, meta->title_id);
+        copy_str(h->disc_ver, sizeof h->disc_ver, meta->disc_ver);
+        memcpy(h->eboot_sha1, meta->eboot_sha1, 20);
+        h->spu_table_hash = meta->spu_table_hash;
+        h->cont_hash = meta->cont_hash;
+        copy_str(h->build_id, sizeof h->build_id, meta->build_id);
+        h->aspect = meta->aspect;
+        h->hud = meta->hud; h->lod = meta->lod; h->fmv = meta->fmv;
+        h->guest_time_scale = meta->guest_time_scale;
+        h->created_unix_ms = meta->created_unix_ms;
+        h->tz_min = meta->tz_min;
+        h->play_time_ms = meta->play_time_ms;
+        h->guest_time_ns = meta->guest_time_ns;
+        h->flip_count = meta->flip_count;
+        h->game_mode = meta->game_mode;
+        copy_str(h->mission, sizeof h->mission, meta->mission);
+        copy_str(h->label, sizeof h->label, meta->label);
+        h->slot = meta->slot;
+        h->pause_us = meta->pause_us;
+    } else {
+        h->slot = ~0u;
+    }
+    if (!h->spu_table_hash) h->spu_table_hash = ss_file_image_spu_table(img);
+    if (!h->created_unix_ms) h->created_unix_ms = ti.unix_ms ? ti.unix_ms : ih->created_unix_ms;
+    if (!h->play_time_ms) h->play_time_ms = ti.play_ms;
+    if (!h->guest_time_ns) h->guest_time_ns = ti.guest_ns;
+    if (!h->flip_count) h->flip_count = ti.flip_count;
+    h->layout_hash = ih->layout_hash;
+    h->img_nsections = ih->nsections;
+    h->img_nchunks = ih->nchunks;
+    h->chunk_bytes = ih->chunk_bytes;
+    h->img_data_off = ih->data_off;
+    h->img_data_size = ih->data_size;
+    h->codec = (uint32_t)codec;
+
+    char tmp[MAX_PATH * 2], bak[MAX_PATH * 2];
+    snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    snprintf(bak, sizeof bak, "%s.bak", path);
+    HANDLE f = CreateFileA(tmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+                           FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+    if (f == INVALID_HANDLE_VALUE) {
+        const DWORD e = GetLastError();
+        free(h);
+        FAIL(SS_E_IO, "", "cannot create %s (error %lu)", tmp, (unsigned long)e);
+    }
+
+    /* the job: worker threads compress ahead into nslots buffers */
+    wjob j;
+    memset(&j, 0, sizeof j);
+    j.img = img;
+    j.codec = codec;
+    j.n = ih->nchunks;
+    j.nslots = threads * WSLOTS_PER_THREAD;
+    j.below_normal = o ? o->below_normal : 1;
+    InitializeSRWLock(&j.lk);
+    InitializeConditionVariable(&j.cv_ready);
+    InitializeConditionVariable(&j.cv_free);
+    j.sbuf = (uint8_t**)calloc((size_t)j.nslots, sizeof *j.sbuf);
+    j.sn = (uint32_t*)calloc((size_t)j.nslots, sizeof *j.sn);
+    j.scodec = (uint32_t*)calloc((size_t)j.nslots, sizeof *j.scodec);
+    j.schunk = (volatile LONG*)calloc((size_t)j.nslots, sizeof *j.schunk);
+    p3ss_chunk* tab = (p3ss_chunk*)calloc((size_t)(ih->nchunks ? ih->nchunks : 1), sizeof *tab);
+    int ok = j.sbuf && j.sn && j.scodec && j.schunk && tab;
+    for (int s = 0; ok && s < j.nslots; s++) {
+        j.schunk[s] = -1;
+        ok = (j.sbuf[s] = (uint8_t*)malloc(codec == P3SS_CODEC_NONE ? 16 : CZ_OUT_CAP)) != NULL;
+    }
+    HANDLE th[64];
+    int nth = 0;
+    double io_ms = 0, wait_thumb = 0;
+    int err = SS_OK;
+    char ebuf[200] = "";
+    static const uint8_t k_zero[P3SS_HDR_SIZE];
+    if (!ok) { err = SS_E_NOMEM; snprintf(ebuf, sizeof ebuf, "out of memory"); }
+
+    /* the header's place, then the image's own metadata (its header and tables) */
+    if (!err && !write_all(f, k_zero, P3SS_HDR_SIZE, &io_ms)) err = SS_E_IO;
+    if (!err) {
+        h->img_meta_off = P3SS_HDR_SIZE;
+        const uint64_t ns = (uint64_t)ih->nsections * sizeof(ss_sec_ent), nc = (uint64_t)ih->nchunks * sizeof(ss_chunk_ent);
+        h->img_meta_size = sizeof *ih + ns + nc;
+        if (!write_all(f, ih, sizeof *ih, &io_ms) || !write_all(f, img->sec, ns, &io_ms) ||
+            !write_all(f, img->chunk, nc, &io_ms) ||
+            !write_all(f, k_zero, (8 - (h->img_meta_size & 7)) & 7, &io_ms))   /* 8-aligned from here */
+            err = SS_E_IO;
+    }
+    for (int t = 0; !err && t < threads && t < 64; t++) {
+        th[nth] = CreateThread(NULL, 256 * 1024, wjob_worker, &j, 0, NULL);
+        if (th[nth]) nth++;
+    }
+    if (!err && !nth) { err = SS_E_NOMEM; snprintf(ebuf, sizeof ebuf, "no worker thread"); }
+
+    /* in order: each section's chunks, then its chunk table */
+    uint32_t nsec = 0;
+    for (uint32_t si = 0; !err && si < ih->nsections; si++) {
+        const ss_sec_ent* se = &img->sec[si];
+        p3ss_sec* ps = &h->sec[nsec++];
+        ps->fourcc = se->fourcc;
+        ps->version = se->version;
+        ps->layout_hash = se->layout_hash;
+        ps->raw = se->size;
+        ps->codec = (uint32_t)codec;
+        ps->flags = se->flags & 0xFFFFu;
+        ps->nchunks = se->nchunks;
+        const uint64_t start = file_pos(f);
+        for (uint32_t c = se->chunk0; !err && c < se->chunk0 + se->nchunks; c++) {
+            const int s = (int)(c % (uint32_t)j.nslots);
+            AcquireSRWLockExclusive(&j.lk);
+            while (j.schunk[s] != (LONG)c) SleepConditionVariableSRW(&j.cv_ready, &j.lk, INFINITE, 0);
+            ReleaseSRWLockExclusive(&j.lk);
+            const ss_chunk_ent* ce = &img->chunk[c];
+            p3ss_chunk* pc = &tab[c];
+            pc->off = file_pos(f);
+            pc->stored = j.sn[s];
+            pc->raw = ce->size;
+            pc->crc32c = ce->crc;
+            pc->codec = j.scodec[s];
+            const void* bytes = pc->codec == P3SS_CODEC_NONE ? (const void*)(img->data + ce->offset) : j.sbuf[s];
+            if (!write_all(f, bytes, pc->stored, &io_ms)) err = SS_E_IO;
+            st->raw_bytes += ce->size;
+            st->chunks++;
+            AcquireSRWLockExclusive(&j.lk);
+            j.schunk[s] = -1;
+            j.written++;
+            WakeAllConditionVariable(&j.cv_free);
+            ReleaseSRWLockExclusive(&j.lk);
+        }
+        if (err) break;
+        ps->offset = file_pos(f);
+        const uint64_t tn = (uint64_t)se->nchunks * sizeof(p3ss_chunk);
+        ps->crc32c = ss_crc32c(0, &tab[se->chunk0], (size_t)tn);
+        if (tn && !write_all(f, &tab[se->chunk0], tn, &io_ms)) err = SS_E_IO;
+        ps->stored = file_pos(f) - start;
+    }
+    AcquireSRWLockExclusive(&j.lk);
+    j.stop = 1;
+    WakeAllConditionVariable(&j.cv_free);
+    ReleaseSRWLockExclusive(&j.lk);
+    if (nth) WaitForMultipleObjects((DWORD)nth, th, TRUE, INFINITE);
+    for (int t = 0; t < nth; t++) CloseHandle(th[t]);
+    if (err == SS_E_IO && !ebuf[0]) snprintf(ebuf, sizeof ebuf, "cannot write %s (error %lu)", tmp, (unsigned long)GetLastError());
+
+    /* the thumbnail: a FILE section (one chunk, stored), if the caller has one */
+    if (!err && o && o->thumb && nsec < P3SS_SEC_MAX) {
+        const void* png = NULL;
+        size_t pn = 0;
+        const double t0 = now_ms();
+        const int have = o->thumb(o->thumb_user, &png, &pn);
+        wait_thumb = now_ms() - t0;
+        if (have && png && pn && pn < (64u << 20)) {
+            p3ss_sec* ps = &h->sec[nsec++];
+            memset(ps, 0, sizeof *ps);
+            ps->fourcc = P3SS_THMB;
+            ps->version = 1;
+            ps->raw = pn;
+            ps->codec = P3SS_CODEC_NONE;
+            ps->flags = P3SS_SF_FILE | SS_SEC_OPTIONAL | SS_SEC_INFO;
+            ps->nchunks = 1;
+            const uint64_t start = file_pos(f);
+            p3ss_chunk pc;
+            memset(&pc, 0, sizeof pc);
+            pc.off = start;
+            pc.stored = pc.raw = (uint32_t)pn;
+            pc.crc32c = ss_crc32c(0, png, pn);
+            pc.codec = P3SS_CODEC_NONE;
+            ps->offset = start + pn;
+            ps->crc32c = ss_crc32c(0, &pc, sizeof pc);
+            if (!write_all(f, png, pn, &io_ms) || !write_all(f, &pc, sizeof pc, &io_ms)) err = SS_E_IO;
+            ps->stored = file_pos(f) - start;
+        }
+    }
+    if (!err) {
+        h->nsections = nsec;
+        h->file_size = file_pos(f);
+        h->write_ms = (uint32_t)(now_ms() - t_start);
+        h->header_crc32c = 0;
+        h->header_crc32c = ss_crc32c(0, h, sizeof *h);
+        LARGE_INTEGER z;
+        z.QuadPart = 0;
+        if (!SetFilePointerEx(f, z, NULL, FILE_BEGIN) || !write_all(f, h, sizeof *h, &io_ms)) err = SS_E_IO;
+        const double t0 = now_ms();
+        if (!err && !FlushFileBuffers(f)) err = SS_E_IO;
+        io_ms += now_ms() - t0;
+        if (err && !ebuf[0]) snprintf(ebuf, sizeof ebuf, "cannot write %s (error %lu)", tmp, (unsigned long)GetLastError());
+    }
+    st->file_bytes = h->file_size;
+    CloseHandle(f);
+    int keep_tmp = 0;
+    if (!err) {
+        /* old -> .bak, then .tmp -> path; each rename retried for ~2 s (an
+         * antivirus scan, the indexer or a sync client can hold a just-closed
+         * file for a moment). If the second fails the old file goes back; only
+         * when that fails too is the new .tmp kept (ss_slots_init promotes a
+         * complete .tmp whose slot file is missing) -- a complete .tmp is never
+         * deleted once the old file has moved. */
+        const int keep_bak = o ? o->keep_bak : 1;
+        const int had_old = keep_bak && GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES;
+        /* (file names, not paths: the reason is the window's notice too, and the folder is in the log) */
+        const char* nm = strrchr(path, '\\') ? strrchr(path, '\\') + 1 : path;
+        if (had_old && !move_retry(path, bak)) {
+            err = SS_E_IO;
+            snprintf(ebuf, sizeof ebuf, "cannot keep the old %s as .bak (error %lu)", nm, (unsigned long)GetLastError());
+        }
+        if (!err && !move_retry(tmp, path)) {
+            const DWORD le = GetLastError();
+            err = SS_E_IO;
+            if (!had_old || move_retry(bak, path))
+                snprintf(ebuf, sizeof ebuf, "cannot replace %s (error %lu)%s", nm, (unsigned long)le,
+                         GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES ? "; the slot keeps its previous state"
+                                                                             : "");
+            else {
+                keep_tmp = 1;
+                snprintf(ebuf, sizeof ebuf, "cannot replace %s (error %lu); the new state stays in %s.tmp and the"
+                         " previous one in %s.bak", nm, (unsigned long)le, nm, nm);
+            }
+        }
+    }
+    if (err && !keep_tmp) DeleteFileA(tmp);
+    for (int s = 0; j.sbuf && s < j.nslots; s++) free(j.sbuf[s]);
+    free(j.sbuf); free(j.sn); free(j.scodec); free((void*)j.schunk); free(tab);
+    st->threads = nth;
+    st->stored_none = (uint32_t)j.none;
+    st->ms_codec = (double)j.codec_us / 1000.0;
+    st->ms_io = io_ms;
+    st->ms_wait_thumb = wait_thumb;
+    st->ms_total = now_ms() - t_start;
+    st->ratio = st->raw_bytes ? (double)st->file_bytes / (double)st->raw_bytes : 1.0;
+    free(h);
+    if (err) {
+        if (why && why_n) snprintf(why, why_n, "%s", ebuf[0] ? ebuf : ss_strerror(err));
+        return err;
+    }
+    return SS_OK;
+#endif
+}
+
+/* ---------------------------------------------------------------------------
+ * The header and the compatibility checks
+ * -----------------------------------------------------------------------*/
+static int is_zero(const void* p, size_t n)
+{
+    const uint8_t* b = (const uint8_t*)p;
+    for (size_t i = 0; i < n; i++) if (b[i]) return 0;
+    return 1;
+}
+
+int ss_file_parse_header(const void* buf, uint64_t file_size, p3ss_hdr* h, char* why, size_t why_n,
+                         const char** short_why)
+{
+    if (short_why) *short_why = "";
+    if (!buf || !h) FAIL(SS_E_ARG, "damaged", "no header");
+    memcpy(h, buf, sizeof *h);
+    if (memcmp(h->magic, P3SS_MAGIC, 8)) FAIL(SS_E_CORRUPT, "not a save state", "not a save-state file");
+    if (h->format_version != P3SS_VERSION || h->header_size != P3SS_HDR_SIZE)
+        FAIL(SS_E_LAYOUT, "made by another build", "a save-state file of format %u (this build reads %u)",
+             h->format_version, P3SS_VERSION);
+    p3ss_hdr c = *h;
+    c.header_crc32c = 0;
+    if (ss_crc32c(0, &c, sizeof c) != h->header_crc32c)
+        FAIL(SS_E_CORRUPT, "damaged", "the file is damaged (its header fails its CRC)");
+    if (file_size && h->file_size != file_size)
+        FAIL(SS_E_CORRUPT, "damaged", "the file is damaged (%llu bytes, its header says %llu: cut short?)",
+             (unsigned long long)file_size, (unsigned long long)h->file_size);
+    if (h->nsections > P3SS_SEC_MAX || h->img_nsections > h->nsections || h->img_nsections >= SS_SECTION_MAX ||
+        h->img_nchunks > SS_CHUNK_MAX || h->chunk_bytes == 0 || h->chunk_bytes > SS_CHUNK_BYTES)
+        FAIL(SS_E_CORRUPT, "damaged", "the file is damaged (its section table is out of bounds)");
+    /* the image's layout hash is the one its sections add up to */
+    uint64_t lh = FNV64_INIT;
+    for (uint32_t i = 0; i < h->img_nsections; i++) {
+        const p3ss_sec* s = &h->sec[i];
+        if (s->flags & P3SS_SF_FILE) FAIL(SS_E_CORRUPT, "damaged", "the file is damaged (section %u)", i);
+        if (s->flags & SS_SEC_INFO) continue;
+        lh = fnv64(lh, &s->fourcc, 4);
+        lh = fnv64(lh, &s->layout_hash, 8);
+    }
+    if (lh != h->layout_hash) FAIL(SS_E_CORRUPT, "damaged", "the file is damaged (its section layouts)");
+    h->title_id[sizeof h->title_id - 1] = 0;
+    h->disc_ver[sizeof h->disc_ver - 1] = 0;
+    h->build_id[sizeof h->build_id - 1] = 0;
+    h->mission[sizeof h->mission - 1] = 0;
+    h->label[sizeof h->label - 1] = 0;
+    return SS_OK;
+}
+
+int ss_file_read_header(const char* path, p3ss_hdr* h, char* why, size_t why_n, const char** short_why)
+{
+    if (short_why) *short_why = "";
+#ifndef _WIN32
+    (void)path; (void)h;
+    FAIL(SS_E_STATE, "unavailable", "slot files are Windows only");
+#else
+    HANDLE f = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,
+                           FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE) {
+        const DWORD e = GetLastError();
+        if (e == ERROR_FILE_NOT_FOUND || e == ERROR_PATH_NOT_FOUND) FAIL(SS_E_NOT_FOUND, "empty", "no such file");
+        FAIL(SS_E_IO, "unreadable", "cannot open %s (error %lu)", path, (unsigned long)e);
+    }
+    LARGE_INTEGER sz;
+    uint8_t buf[P3SS_HDR_SIZE];
+    DWORD rd = 0;
+    const int ok = GetFileSizeEx(f, &sz) && ReadFile(f, buf, sizeof buf, &rd, NULL);
+    CloseHandle(f);
+    if (!ok) FAIL(SS_E_IO, "unreadable", "cannot read %s", path);
+    if (rd < sizeof buf) {
+        if (rd >= 8 && !memcmp(buf, P3SS_MAGIC, 8)) FAIL(SS_E_CORRUPT, "damaged", "the file is damaged (cut short)");
+        FAIL(SS_E_CORRUPT, "not a save state", "not a save-state file");
+    }
+    return ss_file_parse_header(buf, (uint64_t)sz.QuadPart, h, why, why_n, short_why);
+#endif
+}
+
+uint64_t ss_file_build_layout_hash(const p3ss_hdr* h)
+{
+    uint64_t lh = FNV64_INIT;
+    for (uint32_t i = 0; h && i < h->img_nsections; i++) {
+        const p3ss_sec* s = &h->sec[i];
+        if (s->flags & SS_SEC_INFO) continue;
+        const ss_section_ops* o = ss_section_find(s->fourcc);
+        const uint64_t mine = o ? ss_section_layout_hash(o) : 0;
+        lh = fnv64(lh, &s->fourcc, 4);
+        lh = fnv64(lh, &mine, 8);
+    }
+    return lh;
+}
+
+/* "<text> | 6AE06214-0A5BC000": the link stamp (the first hex number after
+ * the last " | "); 0 = none. */
+static int build_stamp(const char* id, unsigned long* out)
+{
+    const char* bar = NULL;
+    for (const char* p = id; p && (p = strstr(p, " | ")) != NULL; p += 3) bar = p;
+    if (!bar) return 0;
+    char* end;
+    const unsigned long v = strtoul(bar + 3, &end, 16);
+    if (end == bar + 3 || (*end != '-' && *end != 0)) return 0;
+    *out = v;
+    return 1;
+}
+
+int ss_file_build_order(const char* a, const char* b)
+{
+    unsigned long x = 0, y = 0;
+    if (!build_stamp(a, &x) || !build_stamp(b, &y) || x == y) return 0;
+    return x < y ? -1 : 1;
+}
+
+int ss_file_check_compat(const p3ss_hdr* h, const ss_file_identity* id, char* why, size_t why_n,
+                         const char** short_why)
+{
+    return ss_file_check_compat_ex(h, id, why, why_n, short_why, NULL);
+}
+
+int ss_file_check_compat_ex(const p3ss_hdr* h, const ss_file_identity* id, char* why, size_t why_n,
+                            const char** short_why, uint32_t* warn)
+{
+    if (short_why) *short_why = "";
+    if (warn) *warn = 0;
+    if (!h) FAIL(SS_E_ARG, "damaged", "no header");
+    if (!id) return SS_OK;
+    if (id->title_id[0] && strncmp(h->title_id, id->title_id, sizeof h->title_id))
+        FAIL(SS_E_STATE, "another game", "this save state is of another game (%.11s; this is %.11s)",
+             h->title_id[0] ? h->title_id : "unknown", id->title_id);
+    if (id->disc_ver[0] && h->disc_ver[0] && strncmp(h->disc_ver, id->disc_ver, sizeof h->disc_ver))
+        FAIL(SS_E_STATE, "another game version", "this save state is of another version of the game (%.7s; this"
+             " build runs %.7s)", h->disc_ver, id->disc_ver);
+    if (id->have_sha1 && !is_zero(h->eboot_sha1, 20) && memcmp(h->eboot_sha1, id->eboot_sha1, 20)) {
+        char a[41], b[41];
+        ss_file_sha1_hex(h->eboot_sha1, a);
+        ss_file_sha1_hex(id->eboot_sha1, b);
+        FAIL(SS_E_STATE, "another game version", "this save state was made with another EBOOT (SHA-1 %.12s..., this"
+             " build runs %.12s...)", a, b);
+    }
+    /* another build of the port: refused only by the strict rule; else every
+     * check below decides, and a pass is a warning (the M7b policy) */
+    const int other_build = id->build_id[0] && strncmp(h->build_id, id->build_id, sizeof h->build_id) != 0;
+    if (other_build && id->check_build)
+        FAIL(SS_E_STATE, "made by another build", "this save state was made by another build of the game's port"
+             " (%.63s; this is %.63s), and build_check = 1 (savestates.ini) loads only this build's",
+             h->build_id[0] ? h->build_id : "unknown", id->build_id);
+    for (uint32_t i = 0; i < h->img_nsections; i++) {
+        const p3ss_sec* s = &h->sec[i];
+        char f4[5];
+        ss_fourcc_str(s->fourcc, f4);
+        const ss_section_ops* o = ss_section_find(s->fourcc);
+        if (!o) {
+            if (s->flags & (SS_SEC_OPTIONAL | SS_SEC_INFO)) continue;
+            FAIL(SS_E_LAYOUT, "another build: unknown data", "made by another build: it has a section %s this build"
+                 " does not know", f4);
+        }
+        if (s->flags & SS_SEC_INFO) continue;
+        if (o->version != s->version || ss_section_layout_hash(o) != s->layout_hash)
+            FAIL(SS_E_LAYOUT, "another build: layout changed", "made by another build: section %s (%s) is laid out"
+                 " differently (version %u, layout %016llX; this build: %u, %016llX)", f4, o->name ? o->name : f4,
+                 s->version, (unsigned long long)s->layout_hash, o->version,
+                 (unsigned long long)ss_section_layout_hash(o));
+    }
+    /* every section this build cannot do without is in the file (a capture
+     * writes every registered one; a missing one would keep this session's
+     * state past the point of no return) */
+    for (int k = 0; k < ss_section_count(); k++) {
+        const ss_section_ops* o = ss_section_at(k);
+        if (!o || (o->flags & (SS_SEC_OPTIONAL | SS_SEC_INFO))) continue;
+        uint32_t i = 0;
+        while (i < h->img_nsections && h->sec[i].fourcc != o->fourcc) i++;
+        if (i == h->img_nsections) {
+            char f4[5];
+            ss_fourcc_str(o->fourcc, f4);
+            FAIL(SS_E_LAYOUT, "another build: data missing", "made by another build: it has no section %s (%s),"
+                 " which this build needs", f4, o->name ? o->name : f4);
+        }
+    }
+    if (id->spu_table_hash && h->spu_table_hash && h->spu_table_hash != id->spu_table_hash)
+        FAIL(SS_E_LAYOUT, "another build: SPU code changed", "made by another build: its SPU program table differs"
+             " (%016llX; this build: %016llX)", (unsigned long long)h->spu_table_hash,
+             (unsigned long long)id->spu_table_hash);
+    if (other_build && warn) *warn |= SS_COMPAT_OTHER_BUILD;
+    return SS_OK;
+}
+
+/* ---------------------------------------------------------------------------
+ * Reading
+ * -----------------------------------------------------------------------*/
+#ifdef _WIN32
+typedef struct rjob {
+    const uint8_t*    map;             /* the file */
+    uint64_t          map_n;
+    uint8_t*          data;            /* the raw image's data region */
+    const p3ss_chunk* ch;              /* every image chunk, in the image's order */
+    const ss_chunk_ent* ich;           /* the image's own chunk table */
+    uint32_t          n;
+    volatile LONG     next;
+    volatile LONG     err;             /* the first bad chunk + 1 */
+    volatile LONG     kind;            /* 1 decompress, 2 CRC, 3 size */
+    volatile LONG64   codec_us;
+} rjob;
+
+static DWORD WINAPI rjob_worker(LPVOID p)
+{
+    rjob* j = (rjob*)p;
+    ps3_host_unplace_thread();
+    void* dz[P3SS_CODEC__N] = { NULL, NULL, NULL };
+    for (;;) {
+        const LONG i = InterlockedIncrement(&j->next) - 1;
+        if (i >= (LONG)j->n || j->err) break;
+        const p3ss_chunk* c = &j->ch[i];
+        uint8_t* dst = j->data + j->ich[i].offset;
+        const uint8_t* src = j->map + c->off;
+        const double t0 = now_ms();
+        int bad = 0;
+        if (c->codec == P3SS_CODEC_NONE) {
+            if (c->stored != c->raw) bad = 3;
+            else memcpy(dst, src, c->raw);
+        } else {
+            if (!dz[c->codec] && !s_cz.create_d(cz_alg((int)c->codec), NULL, &dz[c->codec])) dz[c->codec] = NULL;
+            SIZE_T got = 0;
+            if (!dz[c->codec] || !s_cz.decompress(dz[c->codec], src, c->stored, dst, c->raw, &got) || got != c->raw)
+                bad = 1;
+        }
+        if (!bad && ss_crc32c(0, dst, c->raw) != c->crc32c) bad = 2;
+        InterlockedAdd64(&j->codec_us, (LONG64)((now_ms() - t0) * 1000.0));
+        if (bad && InterlockedCompareExchange(&j->err, i + 1, 0) == 0) InterlockedExchange(&j->kind, bad);
+    }
+    for (int k = 0; k < P3SS_CODEC__N; k++) if (dz[k]) s_cz.close_d(dz[k]);
+    return 0;
+}
+#endif
+
+static int span_ok(uint64_t off, uint64_t len, uint64_t n) { return off <= n && len <= n - off; }
+
+void ss_file_image_free(ss_file_image* fi)
+{
+    if (!fi) return;
+#ifdef _WIN32
+    if (fi->buf) VirtualFree(fi->buf, 0, MEM_RELEASE);
+#else
+    free(fi->buf);
+#endif
+    free(fi->thumb);
+    memset(fi, 0, sizeof *fi);
+}
+
+int ss_file_load(const char* path, const ss_file_identity* id, int threads, ss_file_image* out,
+                 ss_file_stats* st, char* why, size_t why_n, const char** short_why)
+{
+    ss_file_stats dummy;
+    if (!st) st = &dummy;
+    memset(st, 0, sizeof *st);
+    if (short_why) *short_why = "";
+    if (!out) FAIL(SS_E_ARG, "damaged", "no output");
+    memset(out, 0, sizeof *out);
+#ifndef _WIN32
+    (void)path; (void)id; (void)threads;
+    FAIL(SS_E_STATE, "unavailable", "slot files are Windows only");
+#else
+    const double t_start = now_ms();
+    int e = ss_file_read_header(path, &out->hdr, why, why_n, short_why);
+    if (e) return e;
+    if ((e = ss_file_check_compat_ex(&out->hdr, id, why, why_n, short_why, &out->compat_warn)) != 0) return e;
+    const p3ss_hdr* h = &out->hdr;
+    if (!cz_load()) {
+        for (uint32_t i = 0; i < h->nsections; i++)
+            if (h->sec[i].codec != P3SS_CODEC_NONE) FAIL(SS_E_STATE, "unavailable", "the Windows Compression API"
+                                                          " (cabinet.dll) is not available");
+    }
+    HANDLE f = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,
+                           FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+    if (f == INVALID_HANDLE_VALUE) FAIL(SS_E_IO, "unreadable", "cannot open %s (error %lu)", path,
+                                        (unsigned long)GetLastError());
+    HANDLE m = CreateFileMappingA(f, NULL, PAGE_READONLY, 0, 0, NULL);
+    const uint8_t* map = m ? (const uint8_t*)MapViewOfFile(m, FILE_MAP_READ, 0, 0, 0) : NULL;
+    if (!map) {
+        const DWORD le = GetLastError();
+        if (m) CloseHandle(m);
+        CloseHandle(f);
+        FAIL(SS_E_IO, "unreadable", "cannot map %s (error %lu)", path, (unsigned long)le);
+    }
+    /* the file the header came from is replaced between the two opens (another
+     * instance saving to the slot, a sync client): every bound below is the
+     * header's size, so the mapping must be that size */
+    LARGE_INTEGER msz;
+    if (!GetFileSizeEx(f, &msz) || (uint64_t)msz.QuadPart != h->file_size) {
+        UnmapViewOfFile(map);
+        CloseHandle(m);
+        CloseHandle(f);
+        FAIL(SS_E_CORRUPT, "damaged", "%s changed while it was read (try again)", path);
+    }
+    const uint64_t fsz = h->file_size;
+    p3ss_chunk* ch = NULL;
+    uint8_t* raw = NULL;
+    uint64_t raw_n = 0;
+    e = SS_OK;
+    char ebuf[220] = "";
+    const char* sw = "damaged";
+    /* the image's metadata: its own header and tables (their CRC is checked by
+     * ss_image_parse at the end, over the copy) */
+    ss_img_hdr ih;
+    if (!span_ok(h->img_meta_off, h->img_meta_size, fsz) || h->img_meta_size < sizeof ih) {
+        e = SS_E_CORRUPT; snprintf(ebuf, sizeof ebuf, "the file is damaged (the image's tables are out of bounds)");
+    } else {
+        memcpy(&ih, map + h->img_meta_off, sizeof ih);
+        if (memcmp(ih.magic, SS_RAW_MAGIC, 8) || ih.version != SS_RAW_VERSION || ih.nsections != h->img_nsections ||
+            ih.nchunks != h->img_nchunks || ih.data_off != h->img_data_off || ih.data_size != h->img_data_size ||
+            ih.layout_hash != h->layout_hash || ih.sec_off != sizeof ih ||
+            ih.chunk_off != ih.sec_off + (uint64_t)ih.nsections * sizeof(ss_sec_ent) ||
+            ih.chunk_off + (uint64_t)ih.nchunks * sizeof(ss_chunk_ent) > ih.data_off ||
+            sizeof ih + (uint64_t)ih.nsections * sizeof(ss_sec_ent) + (uint64_t)ih.nchunks * sizeof(ss_chunk_ent) !=
+                h->img_meta_size || ih.data_off > (64ull << 20) || ih.data_size > (uint64_t)SS_CHUNK_MAX * SS_CHUNK_BYTES) {
+            e = SS_E_CORRUPT; snprintf(ebuf, sizeof ebuf, "the file is damaged (the image's header)");
+        }
+    }
+    /* the raw image: its metadata at the start, the data at data_off */
+    if (!e) {
+        raw_n = ih.data_off + ih.data_size;
+        raw = (uint8_t*)VirtualAlloc(NULL, (SIZE_T)(raw_n ? raw_n : 1), MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+        ch = (p3ss_chunk*)calloc((size_t)(ih.nchunks ? ih.nchunks : 1), sizeof *ch);
+        if (!raw || !ch) { e = SS_E_NOMEM; sw = "no memory"; snprintf(ebuf, sizeof ebuf, "out of memory (%.0f MB"
+                                                                      " for the image)", (double)raw_n / 1048576.0); }
+        else memcpy(raw, map + h->img_meta_off, (size_t)h->img_meta_size);
+    }
+    const ss_sec_ent* isec = raw ? (const ss_sec_ent*)(raw + ih.sec_off) : NULL;
+    const ss_chunk_ent* ichk = raw ? (const ss_chunk_ent*)(raw + ih.chunk_off) : NULL;
+    /* every image section: its chunk table (bounds, CRC, agreeing with the
+     * image's own table) */
+    for (uint32_t i = 0; !e && i < h->img_nsections; i++) {
+        const p3ss_sec* ps = &h->sec[i];
+        const ss_sec_ent* se = &isec[i];
+        char f4[5];
+        ss_fourcc_str(ps->fourcc, f4);
+        const uint64_t tn = (uint64_t)ps->nchunks * sizeof(p3ss_chunk);
+        if (se->fourcc != ps->fourcc || se->version != ps->version || se->nchunks != ps->nchunks ||
+            se->size != ps->raw || se->layout_hash != ps->layout_hash ||
+            se->chunk0 + (uint64_t)se->nchunks > ih.nchunks || !span_ok(ps->offset, tn, fsz)) {
+            e = SS_E_CORRUPT; snprintf(ebuf, sizeof ebuf, "the file is damaged (section %s's table)", f4);
+            break;
+        }
+        if (ss_crc32c(0, map + ps->offset, (size_t)tn) != ps->crc32c) {
+            e = SS_E_CORRUPT; snprintf(ebuf, sizeof ebuf, "the file is damaged (section %s's chunk table fails its"
+                                       " CRC)", f4);
+            break;
+        }
+        memcpy(&ch[se->chunk0], map + ps->offset, (size_t)tn);
+        for (uint32_t k = 0; k < se->nchunks; k++) {
+            const p3ss_chunk* c = &ch[se->chunk0 + k];
+            const ss_chunk_ent* ic = &ichk[se->chunk0 + k];
+            if (c->raw != ic->size || c->crc32c != ic->crc || c->codec >= P3SS_CODEC__N ||
+                !span_ok(c->off, c->stored, fsz) || c->off < h->img_meta_off + h->img_meta_size ||
+                !span_ok(ic->offset, ic->size, ih.data_size) || c->raw > ih.chunk_bytes) {
+                e = SS_E_CORRUPT;
+                snprintf(ebuf, sizeof ebuf, "the file is damaged (section %s, chunk %u)", f4, k);
+                break;
+            }
+        }
+    }
+    /* decompress, CRC every chunk */
+    if (!e) {
+        if (threads <= 0) threads = env_threads();
+        if (threads <= 0) { threads = cpu_count() - 2; if (threads > 8) threads = 8; }
+        if (threads < 1) threads = 1;
+        if ((uint32_t)threads > ih.nchunks) threads = ih.nchunks ? (int)ih.nchunks : 1;
+        rjob j;
+        memset(&j, 0, sizeof j);
+        j.map = map; j.map_n = fsz; j.data = raw + ih.data_off; j.ch = ch; j.ich = ichk; j.n = ih.nchunks;
+        HANDLE th[64];
+        int nth = 0;
+        for (int t = 0; t < threads && t < 64; t++) {
+            th[nth] = CreateThread(NULL, 256 * 1024, rjob_worker, &j, 0, NULL);
+            if (th[nth]) nth++;
+        }
+        if (!nth) rjob_worker(&j);
+        else WaitForMultipleObjects((DWORD)nth, th, TRUE, INFINITE);
+        for (int t = 0; t < nth; t++) CloseHandle(th[t]);
+        st->threads = nth ? nth : 1;
+        st->ms_codec = (double)j.codec_us / 1000.0;
+        if (j.err) {
+            const uint32_t bad = (uint32_t)j.err - 1;
+            uint32_t si = 0;
+            while (si + 1 < ih.nsections && bad >= isec[si].chunk0 + isec[si].nchunks) si++;
+            char f4[5];
+            e = SS_E_CORRUPT;
+            snprintf(ebuf, sizeof ebuf, "the file is damaged (section %s, chunk %u: %s)",
+                     ss_fourcc_str(isec[si].fourcc, f4), bad - isec[si].chunk0,
+                     j.kind == 2 ? "fails its CRC" : j.kind == 3 ? "bad size" : "does not decompress");
+        }
+        for (uint32_t i = 0; i < ih.nchunks; i++) {
+            st->raw_bytes += ch[i].raw;
+            st->chunks++;
+            st->stored_none += ch[i].codec == P3SS_CODEC_NONE;
+        }
+    }
+    /* the thumbnail, if the file has one */
+    for (uint32_t i = h->img_nsections; !e && i < h->nsections; i++) {
+        const p3ss_sec* ps = &h->sec[i];
+        if (ps->fourcc != P3SS_THMB || ps->nchunks != 1 || !span_ok(ps->offset, sizeof(p3ss_chunk), fsz)) continue;
+        p3ss_chunk c;
+        memcpy(&c, map + ps->offset, sizeof c);
+        if (ss_crc32c(0, &c, sizeof c) != ps->crc32c || c.codec != P3SS_CODEC_NONE || c.stored != c.raw ||
+            !span_ok(c.off, c.stored, fsz) || ss_crc32c(0, map + c.off, c.stored) != c.crc32c)
+            continue;                                   /* (a thumbnail is optional: a bad one is dropped) */
+        out->thumb = malloc(c.stored ? c.stored : 1);
+        if (out->thumb) { memcpy(out->thumb, map + c.off, c.stored); out->thumb_n = c.stored; }
+    }
+    UnmapViewOfFile(map);
+    CloseHandle(m);
+    CloseHandle(f);
+    free(ch);
+    if (!e) {
+        char pw[160] = "";
+        if (ss_image_parse(&out->img, raw, raw_n, pw, sizeof pw) != SS_OK) {
+            e = SS_E_CORRUPT;
+            snprintf(ebuf, sizeof ebuf, "the file is damaged (%s)", pw);
+        }
+    }
+    st->file_bytes = fsz;
+    st->ms_total = now_ms() - t_start;
+    st->ratio = st->raw_bytes ? (double)fsz / (double)st->raw_bytes : 1.0;
+    if (e) {
+        if (raw) VirtualFree(raw, 0, MEM_RELEASE);
+        free(out->thumb);
+        const p3ss_hdr keep = out->hdr;
+        memset(out, 0, sizeof *out);
+        out->hdr = keep;
+        if (short_why) *short_why = sw;
+        if (why && why_n) snprintf(why, why_n, "%s", ebuf);
+        return e;
+    }
+    out->buf = raw;
+    out->buf_size = raw_n;
+    return SS_OK;
+#endif
+}
+
+/* ---------------------------------------------------------------------------
+ * SHA-1 (BCrypt, an OS component; loaded on first use)
+ * -----------------------------------------------------------------------*/
+void ss_file_sha1_hex(const uint8_t s[20], char out[41])
+{
+    static const char hx[] = "0123456789abcdef";
+    for (int i = 0; i < 20; i++) { out[2 * i] = hx[s[i] >> 4]; out[2 * i + 1] = hx[s[i] & 15]; }
+    out[40] = 0;
+}
+
+int ss_file_sha1(const char* path, uint8_t out[20])
+{
+    memset(out, 0, 20);
+#ifdef _WIN32
+    typedef LONG (WINAPI *open_fn)(void**, LPCWSTR, LPCWSTR, ULONG);
+    typedef LONG (WINAPI *create_fn)(void*, void**, PUCHAR, ULONG, PUCHAR, ULONG, ULONG);
+    typedef LONG (WINAPI *hash_fn)(void*, PUCHAR, ULONG, ULONG);
+    typedef LONG (WINAPI *finish_fn)(void*, PUCHAR, ULONG, ULONG);
+    typedef LONG (WINAPI *destroy_fn)(void*);
+    typedef LONG (WINAPI *close_fn)(void*, ULONG);
+    HMODULE b = LoadLibraryA("bcrypt.dll");
+    if (!b) return 0;
+    open_fn op = (open_fn)(void*)GetProcAddress(b, "BCryptOpenAlgorithmProvider");
+    create_fn cr = (create_fn)(void*)GetProcAddress(b, "BCryptCreateHash");
+    hash_fn hs = (hash_fn)(void*)GetProcAddress(b, "BCryptHashData");
+    finish_fn fi = (finish_fn)(void*)GetProcAddress(b, "BCryptFinishHash");
+    destroy_fn de = (destroy_fn)(void*)GetProcAddress(b, "BCryptDestroyHash");
+    close_fn cl = (close_fn)(void*)GetProcAddress(b, "BCryptCloseAlgorithmProvider");
+    if (!op || !cr || !hs || !fi || !de || !cl) return 0;
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    void* alg = NULL;
+    void* hh = NULL;
+    int ok = op(&alg, L"SHA1", NULL, 0) == 0 && cr(alg, &hh, NULL, 0, NULL, 0, 0) == 0;
+    uint8_t* buf = ok ? (uint8_t*)malloc(1u << 20) : NULL;
+    ok = ok && buf;
+    size_t n;
+    while (ok && (n = fread(buf, 1, 1u << 20, f)) > 0) ok = hs(hh, buf, (ULONG)n, 0) == 0;
+    ok = ok && !ferror(f) && fi(hh, out, 20, 0) == 0;
+    if (hh) de(hh);
+    if (alg) cl(alg, 0);
+    free(buf);
+    fclose(f);
+    if (!ok) memset(out, 0, 20);
+    return ok;
+#else
+    (void)path;
+    return 0;
+#endif
+}
diff --git a/runtime/savestate/ss_file.h b/runtime/savestate/ss_file.h
new file mode 100644
index 0000000..ef44bac
--- /dev/null
+++ b/runtime/savestate/ss_file.h
@@ -0,0 +1,269 @@
+/*
+ * ps3recomp - save-state slot files: the P3SS v1 container (engine design 5.1,
+ * 5.4; milestone M5)
+ *
+ * A SAVE captures the game into an IMAGE in RAM (ss_state.h). This file puts
+ * an image on disk and reads it back: what a slot file is, nothing else --
+ * which slot, when and why is runtime/savestate/ss_slots.c.
+ *
+ * LAYOUT (little-endian, our own format):
+ *   [ header: 4096 bytes, never compressed -- the window menu reads only this ]
+ *     magic "P3SS\r\n\x1a\n", format version 1, header size, file size,
+ *     CRC32C of the header (with that field 0), the game (title id, disc
+ *     version, the EBOOT's SHA-1), the build (layout hash, SPU image table
+ *     hash, continuation hash, build id), the display configuration, the
+ *     metadata (created, play time, guest time, flips, game mode, mission
+ *     text, label, slot) and the SECTION TABLE (p3ss_sec, up to 64)
+ *   [ the image's metadata: its ss_img_hdr, section table and chunk table,
+ *     exactly as ss_state.c made them (they carry their own CRC32C) ]
+ *   [ per section: its chunks, then its CHUNK TABLE (p3ss_chunk per chunk) ]
+ * Image sections are the image's, one for one and in its order; FILE
+ * sections (P3SS_SF_FILE) exist only in the file -- THMB, the thumbnail PNG.
+ * A chunk is up to 1 MB of raw section bytes compressed on its own (XPRESS_
+ * HUFF or XPRESS through the Windows Compression API, raw mode, cabinet.dll:
+ * an OS component), or stored as is ('none') when that would not save 2%.
+ * Every chunk carries the CRC32C of its RAW bytes -- the same value as the
+ * image's own chunk table, so an image read back is byte for byte the one
+ * that was captured.
+ *
+ * WRITING (ss_file_write) runs outside any stop, on the caller's thread with
+ * worker threads compressing ahead of it: <path>.tmp, FlushFileBuffers, the
+ * old file renamed to <path>.bak, then <path>.tmp moved over <path>
+ * (MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH). A crash mid-save
+ * leaves the old slot (or its .bak) as it was.
+ *
+ * READING (ss_file_load): the header and its CRC; the compatibility checks
+ * (ss_file_check_compat, design 5.4) -- so a file the running build cannot
+ * load is refused before anything is decompressed, let alone stopped; then
+ * the file mapped, every chunk decompressed on worker threads straight into
+ * an in-RAM raw image (the layout ss_image_parse reads) with its CRC
+ * checked, and the image parsed: an ss_image the M4c LOAD takes
+ * (ss_request.image, flag SS_RQ_CRC_CHECKED).
+ *
+ * REFUSALS, each with a user-facing reason (and a short one for the menu):
+ * not a save state / damaged (magic, version, a CRC, a bound, a truncated
+ * file); another game (title id); another version of the game (the EBOOT's
+ * SHA-1); another build whose data this build reads differently (an unknown
+ * mandatory section, a section whose version or layout differs, a section
+ * this build needs and the file lacks, the SPU image table).
+ * THE BUILD POLICY (M7b, engine design 5.4): a state made by ANOTHER BUILD of
+ * the port (another build id) for the same EBOOT, which passes every check
+ * above, is accepted with a warning -- SS_COMPAT_OTHER_BUILD in *warn
+ * (ss_file_check_compat_ex, ss_file_image.compat_warn): the menu tags it
+ * "(older build)" and the load says so. ss_file_identity.check_build = 1
+ * (savestates.ini build_check = 1) refuses it instead, the first vertical
+ * slice's rule. A return address with no continuation in this build, or a
+ * wait kind it cannot resume, is the LOAD's own check (sys_ppu_thread.c,
+ * before its stop: the game is never lost to it). Windows only (the
+ * Compression API, file mapping); other hosts get SS_E_STATE.
+ */
+#ifndef PS3RECOMP_SS_FILE_H
+#define PS3RECOMP_SS_FILE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "ss_state.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define P3SS_MAGIC      "P3SS\r\n\x1a\n"
+#define P3SS_VERSION    1u
+#define P3SS_HDR_SIZE   4096u
+#define P3SS_SEC_MAX    64
+#define P3SS_THMB       SS_FOURCC('T', 'H', 'M', 'B')
+
+enum { P3SS_CODEC_NONE = 0, P3SS_CODEC_XPRESS = 1, P3SS_CODEC_XPRESS_HUFF = 2, P3SS_CODEC__N };
+const char* ss_file_codec_name(int codec);       /* "none", "xpress", "xpress_huff" */
+int         ss_file_codec_parse(const char* s);  /* the same names; -1 unknown */
+
+/* p3ss_sec.flags: the image's SS_SEC_* in the low bits, and */
+#define P3SS_SF_FILE 0x10000u   /* a section of the file only (THMB), not of the image */
+
+typedef struct p3ss_sec {                /* 56 bytes */
+    uint32_t fourcc, version;
+    uint64_t layout_hash;                /* the section's (ss_section_layout_hash), checked */
+    uint64_t offset;                     /* its chunk table in the file */
+    uint64_t stored;                     /* its bytes in the file: chunks + chunk table */
+    uint64_t raw;                        /* its raw size */
+    uint32_t codec;                      /* the codec its chunks were offered (a chunk may be 'none') */
+    uint32_t crc32c;                     /* CRC32C of its chunk table */
+    uint32_t flags;                      /* SS_SEC_* | P3SS_SF_* */
+    uint32_t nchunks;
+} p3ss_sec;
+typedef struct p3ss_chunk {              /* 24 bytes */
+    uint64_t off;                        /* its stored bytes in the file */
+    uint32_t stored, raw;                /* sizes */
+    uint32_t crc32c;                     /* CRC32C of the RAW bytes */
+    uint32_t codec;                      /* P3SS_CODEC_* */
+} p3ss_chunk;
+
+/* Game modes (p3ss_hdr.game_mode; the title's describe hook names them). */
+enum { P3SS_MODE_UNKNOWN = 0, P3SS_MODE_GAMEPLAY, P3SS_MODE_PAUSE_MENU, P3SS_MODE_TITLE_MENU,
+       P3SS_MODE_MOVIE, P3SS_MODE_POLYCUT, P3SS_MODE_LOADING, P3SS_MODE__N };
+const char* ss_file_mode_name(uint32_t mode);    /* "gameplay", "pause menu", ... */
+
+typedef struct p3ss_hdr {
+    char     magic[8];
+    uint32_t format_version, header_size;
+    uint64_t file_size;
+    uint32_t header_crc32c;              /* over the 4096 bytes with this field 0 */
+    uint32_t flags;
+    /* the game */
+    char     title_id[12];               /* "BCUS98125" */
+    char     disc_ver[8];                /* "02.00", or the update's "01.04" */
+    uint8_t  eboot_sha1[20];             /* of the EBOOT the build runs (all zero: unknown) */
+    /* the build */
+    uint64_t layout_hash;                /* the image's (every section's field lists) */
+    uint64_t spu_table_hash;             /* the SPU image table (SPUC's image_table) */
+    uint64_t cont_hash;                  /* the saving build's continuation set (informational) */
+    char     build_id[64];               /* checked: the first vertical slice loads its own build's states */
+    /* the display configuration the state was taken with (design 5.6; informational) */
+    double   aspect;                     /* the content aspect (0: stock 16:9) */
+    uint8_t  hud, lod, fmv, pad1[5];
+    double   guest_time_scale;
+    /* metadata (design 5.5) */
+    uint64_t created_unix_ms;
+    int32_t  tz_min;                     /* the saving PC's offset from UTC, minutes */
+    uint32_t pad2;
+    uint64_t play_time_ms;               /* wall time of play, stops excluded (TIME) */
+    uint64_t guest_time_ns;              /* the guest clock at the capture (TIME) */
+    uint32_t flip_count, game_mode;      /* P3SS_MODE_* */
+    char     mission[96];                /* UTF-8: "3. Forward Momentum", "Prologue - approach" */
+    char     label[64];                  /* a user's label (later: "Rename slot...") */
+    uint32_t slot;                       /* 0 quick, 1..10, 11 the undo point (SS_UI_UNDO); ~0 none */
+    /* the image */
+    uint32_t img_nsections, img_nchunks;
+    uint32_t chunk_bytes;                /* SS_CHUNK_BYTES */
+    uint64_t img_meta_off, img_meta_size;   /* its ss_img_hdr + tables, at this offset in the file */
+    uint64_t img_data_off, img_data_size;   /* the raw image's data region (ss_img_hdr) */
+    uint32_t codec;                      /* the codec asked for */
+    /* timings of the save (informational) */
+    uint32_t pause_us, write_ms;
+    uint32_t nsections;                  /* entries of sec[] */
+    p3ss_sec sec[P3SS_SEC_MAX];          /* at offset 448 */
+    uint8_t  reserved[P3SS_HDR_SIZE - 448 - P3SS_SEC_MAX * 56];
+} p3ss_hdr;
+
+/* What the header says besides the image (the slot glue fills it). */
+typedef struct ss_file_meta {
+    char     title_id[12], disc_ver[8];
+    uint8_t  eboot_sha1[20];
+    uint64_t spu_table_hash, cont_hash;  /* spu 0: read from the image's SPUC (image_table) */
+    char     build_id[64];
+    double   aspect, guest_time_scale;
+    uint8_t  hud, lod, fmv;
+    uint64_t created_unix_ms;            /* 0: the image's */
+    int32_t  tz_min;
+    uint64_t play_time_ms, guest_time_ns;   /* 0: TIME's */
+    uint32_t flip_count, game_mode;      /* flip 0: TIME's */
+    char     mission[96], label[64];
+    uint32_t slot;
+    uint32_t pause_us;
+} ss_file_meta;
+
+/* What this build is, for the compatibility checks. Empty / zero members
+ * are not checked (unknown here). */
+typedef struct ss_file_identity {
+    char     title_id[12], disc_ver[8];
+    uint8_t  eboot_sha1[20];
+    int      have_sha1;
+    char     build_id[64];
+    uint64_t spu_table_hash;             /* 0: unknown */
+    int      check_build;                /* 1: refuse another build id (savestates.ini build_check = 1);
+                                          * 0: accept it with SS_COMPAT_OTHER_BUILD (the M7b policy) */
+} ss_file_identity;
+
+/* Warnings of a header that passed the checks (ss_file_check_compat_ex). */
+#define SS_COMPAT_OTHER_BUILD 0x1u       /* made by another build of the port, for the same EBOOT */
+
+typedef struct ss_file_stats {
+    uint64_t raw_bytes, file_bytes;      /* image bytes in, file bytes out (or the reverse) */
+    uint32_t chunks, stored_none;        /* chunks; of them stored uncompressed */
+    int      threads;
+    double   ms_total, ms_codec, ms_io, ms_wait_thumb;   /* wall; codec busy (summed over threads); I/O */
+    double   ratio;                      /* file / raw */
+} ss_file_stats;
+
+/* The thumbnail (or any late file section) a write asks for after the
+ * image's sections are on disk: return 1 with *png / *n (kept until the
+ * write returns), or 0 for none. May wait. */
+typedef int (*ss_file_late_fn)(void* user, const void** png, size_t* n);
+
+typedef struct ss_file_wopts {
+    int             codec;               /* P3SS_CODEC_* */
+    int             threads;             /* compressing workers (0: half the CPUs, at most 6) */
+    int             below_normal;        /* workers at THREAD_PRIORITY_BELOW_NORMAL (the game runs on) */
+    ss_file_late_fn thumb;               /* NULL: no THMB */
+    void*           thumb_user;
+    int             keep_bak;            /* rename an existing file to <path>.bak first (1) */
+} ss_file_wopts;
+
+/* Write a sealed image to path (the .tmp / .bak / rename dance above).
+ * Returns 0, or an SS_E_* with why. Any thread; allocates. */
+int ss_file_write(const char* path, const ss_image* img, const ss_file_meta* meta, const ss_file_wopts* o,
+                  ss_file_stats* st, char* why, size_t why_n);
+
+/* The 4096-byte header: magic, version, size, CRC (0 / SS_E_CORRUPT /
+ * SS_E_IO with why; *short_why a few words for the menu: "damaged",
+ * "not a save state"). */
+int ss_file_read_header(const char* path, p3ss_hdr* h, char* why, size_t why_n, const char** short_why);
+/* Check a header that read fine (ss_file_parse_header) against this build:
+ * 0, or SS_E_LAYOUT / SS_E_STATE with a user-facing why ("made by another
+ * build: section XXXX (...) is laid out differently (...)"), and a short
+ * reason for the menu ("another build: layout changed"). Sections are
+ * checked against the ones this build registers (ss_state.h): an unknown
+ * mandatory one, a different version or layout hash refuses with its
+ * fourcc, a mandatory one the file lacks with its fourcc; then the SPU
+ * table. Another build id refuses ("made by another build") only with
+ * id->check_build; else it is the warning SS_COMPAT_OTHER_BUILD in *warn
+ * (may be NULL; 0 when there is none, or on a refusal). */
+int ss_file_check_compat_ex(const p3ss_hdr* h, const ss_file_identity* id, char* why, size_t why_n,
+                            const char** short_why, uint32_t* warn);
+int ss_file_check_compat(const p3ss_hdr* h, const ss_file_identity* id, char* why, size_t why_n,
+                         const char** short_why);
+/* Which of two build ids ("<text> | <PE link stamp>-<image size>") was
+ * linked first, by their link stamps: -1 a is older than b, 1 a is newer,
+ * 0 the same stamp or one that cannot be read. */
+int ss_file_build_order(const char* a, const char* b);
+/* The same header checks on 4096 bytes already in memory. */
+int ss_file_parse_header(const void* buf, uint64_t file_size, p3ss_hdr* h, char* why, size_t why_n,
+                         const char** short_why);
+
+/* A slot file read back: the raw image (ss_image_parse'd, every chunk's CRC
+ * checked) and the file's thumbnail (if any). Free with ss_file_image_free
+ * once the LOAD is done with it. */
+typedef struct ss_file_image {
+    ss_image  img;
+    p3ss_hdr  hdr;
+    void*     buf;                       /* the raw image (VirtualAlloc) */
+    uint64_t  buf_size;
+    void*     thumb;                     /* the THMB section's bytes (malloc), or NULL */
+    size_t    thumb_n;
+    uint32_t  compat_warn;               /* SS_COMPAT_* the compatibility checks warned of */
+} ss_file_image;
+/* Header, compatibility (id may be NULL: no checks), every chunk
+ * decompressed and CRC-checked into a fresh raw image, parsed. threads 0:
+ * the CPUs less two, at most 8. 0, or an SS_E_* with why (and short_why). */
+int  ss_file_load(const char* path, const ss_file_identity* id, int threads, ss_file_image* out,
+                  ss_file_stats* st, char* why, size_t why_n, const char** short_why);
+void ss_file_image_free(ss_file_image* fi);
+
+/* The image's SPU image table hash (its SPUC "image_table" u64), 0 if none. */
+uint64_t ss_file_image_spu_table(const ss_image* img);
+/* The layout hash of the sections this build registers that are in the
+ * table (h), as ss_state.c computes an image's: equal to h->layout_hash iff
+ * every one of them agrees. */
+uint64_t ss_file_build_layout_hash(const p3ss_hdr* h);
+
+/* SHA-1 of a file (BCrypt; Windows). 1 = done. */
+int ss_file_sha1(const char* path, uint8_t out[20]);
+void ss_file_sha1_hex(const uint8_t sha1[20], char out[41]);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_SS_FILE_H */
diff --git a/runtime/savestate/ss_slots.c b/runtime/savestate/ss_slots.c
new file mode 100644
index 0000000..c3716c1
--- /dev/null
+++ b/runtime/savestate/ss_slots.c
@@ -0,0 +1,1146 @@
+/*
+ * ps3recomp - save-state slots (see ss_slots.h)
+ *
+ * One job at a time (s_job, s_busy): a save from its request to its file, a
+ * load from its read to its release, or SS_LOAD's launch load. The window's
+ * own one-at-a-time rule (ss_ui) sits on top: a second request is refused
+ * as busy before it reaches here.
+ *
+ * Threads: the engine callback and every ss_core done() run on the frame-clock
+ * thread (which is also the window's); a save's file is written and a load's
+ * file read on a worker thread of their own, each with more workers for the
+ * codec (ss_file.c); the thumbnail grab arrives on the frame-clock thread.
+ */
+#include "ss_slots.h"
+#include "ss_core.h"
+#include "ss_state.h"
+#include "../platform/win32_compat.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#ifdef _WIN32
+#  include <windows.h>
+#endif
+
+#ifdef _WIN32
+
+/* ---------------------------------------------------------------------------
+ * State
+ * -----------------------------------------------------------------------*/
+static ss_slots_host     s_host;
+static volatile LONG     s_inited;
+static ss_file_identity  s_id;
+static HANDLE            s_id_ev;           /* set once s_id is complete (the SHA-1) */
+static int               s_codec = P3SS_CODEC_XPRESS_HUFF;
+static int               s_thumb_on = 1;
+static double            s_give_up_s = 3.0;
+static int               s_backup = 1;      /* savestates.ini backup_before_load: the undo point */
+static void            (*s_launch_hook)(int ok, const char* what);
+
+enum { ORIGIN_UI = 0, ORIGIN_SAVE_AT, ORIGIN_LAUNCH };
+enum { JOB_FREE = 0, JOB_SAVE, JOB_LOAD };
+static volatile LONG s_busy;                /* JOB_*: one job at a time */
+static volatile LONG s_writing;             /* a captured image is being written (other stops wait) */
+
+typedef struct slot_job {
+    int           op, slot, origin;
+    unsigned      seq;                      /* ss_ui's request (ORIGIN_UI) */
+    char          path[MAX_PATH * 2];
+    double        t_req;                    /* ms (now_ms) when asked */
+    const ss_image* img;                    /* SAVE: the capture */
+    ss_file_meta  meta;
+    double        pause_ms;
+    ss_file_image fi;                       /* LOAD: the image read */
+    ss_file_stats fst;
+    HANDLE        done_ev;                  /* LOAD: the request is done */
+    volatile LONG done_ok, done_reason;
+    ss_request_result res;
+    void*         png;                      /* the thumbnail, PNG */
+    size_t        png_n;
+    int           thumb_w, thumb_h;
+    /* LOAD: its undo point (img / meta / pause_ms hold the capture meanwhile) */
+    volatile LONG backing_up;               /* the undo point is being taken (the writer's check names it) */
+    double        undo_pause_ms, undo_write_ms, undo_ms;   /* its pause, write, request to written */
+} slot_job;
+static slot_job s_job;
+
+/* the thumbnail the backend hands over (frame-clock thread) */
+#define THUMB_W 320
+#define THUMB_HMAX 480
+static struct {
+    volatile LONG want, have;               /* the grab asked for / delivered (a sequence) */
+    int           w, h;
+    double        t_armed;
+    uint8_t       px[THUMB_W * THUMB_HMAX * 4];
+} s_thumb;
+static HANDLE s_thumb_ev;
+
+/* the menu's header cache */
+typedef struct hdr_cache {
+    int           valid;
+    uint64_t      size, mtime;
+    ss_slot_info  info;
+} hdr_cache;
+static hdr_cache s_cache[SS_UI_UNDO + 1];
+static SRWLOCK   s_cache_lk = SRWLOCK_INIT;
+
+static double now_ms(void)
+{
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart * 1000.0 / (double)f.QuadPart;
+}
+
+/* seconds since this process started */
+static double proc_s(void)
+{
+    FILETIME c, e, k, u, now;
+    if (!GetProcessTimes(GetCurrentProcess(), &c, &e, &k, &u)) return 0.0;
+    GetSystemTimePreciseAsFileTime(&now);
+    const uint64_t a = ((uint64_t)c.dwHighDateTime << 32) | c.dwLowDateTime;
+    const uint64_t b = ((uint64_t)now.dwHighDateTime << 32) | now.dwLowDateTime;
+    return b > a ? (double)(b - a) / 1e7 : 0.0;
+}
+
+static void logf_(const char* fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+    fflush(stderr);
+}
+
+static void slot_name(int slot, char* b, size_t n, int upper)
+{
+    if (slot == SS_UI_QUICK) snprintf(b, n, upper ? "The quick slot" : "the quick slot");
+    else if (slot == SS_UI_UNDO) snprintf(b, n, upper ? "The undo point" : "the undo point");
+    else snprintf(b, n, upper ? "Slot %d" : "slot %d", slot);
+}
+
+void ss_slots_fmt_play(uint64_t ms, char* b, size_t n)
+{
+    const uint64_t s = ms / 1000u;
+    if (s >= 3600u) snprintf(b, n, "%u:%02u:%02u", (unsigned)(s / 3600u), (unsigned)(s / 60u % 60u), (unsigned)(s % 60u));
+    else snprintf(b, n, "%u:%02u", (unsigned)(s / 60u), (unsigned)(s % 60u));
+}
+
+int ss_slots_path(int slot, const char* ext, char* buf, size_t n)
+{
+    if (slot < 0 || slot > SS_UI_UNDO || !buf || !n) return 0;
+    const char* e = ext ? ext : ".p3ss";
+    const int w = slot == SS_UI_QUICK ? snprintf(buf, n, "%s\\quick%s", ss_ui_dir(), e)
+                : slot == SS_UI_UNDO  ? snprintf(buf, n, "%s\\undo%s", ss_ui_dir(), e)
+                                      : snprintf(buf, n, "%s\\slot%02d%s", ss_ui_dir(), slot, e);
+    return w > 0 && (size_t)w < n;
+}
+
+int ss_slots_busy(void) { return s_busy != JOB_FREE; }
+
+int ss_slots_wait_written(unsigned max_ms)
+{
+    if (!s_writing) return 1;
+    /* the thumbnail would come from the frame clock -- the caller's thread,
+     * which is not presenting any more: the file goes without one */
+    InterlockedExchange(&s_thumb.want, 0);
+    if (s_thumb_ev) SetEvent(s_thumb_ev);
+    logf_("[ss] a save state is being written: waiting for it\n");
+    const double t0 = now_ms();
+    while (s_writing && now_ms() - t0 < (double)max_ms) Sleep(10);
+    if (s_writing) logf_("[ss] the save state was still being written after %u ms: not waiting longer\n", max_ms);
+    return !s_writing;
+}
+
+void ss_slots_set_launch_hook(void (*fn)(int ok, const char* what)) { s_launch_hook = fn; }
+
+/* ---------------------------------------------------------------------------
+ * Identity (what files are checked against)
+ * -----------------------------------------------------------------------*/
+static DWORD WINAPI id_thread(LPVOID p)
+{
+    (void)p;
+    const double t0 = now_ms();
+    uint8_t sha[20];
+    if (s_host.eboot_path && *s_host.eboot_path && ss_file_sha1(s_host.eboot_path, sha)) {
+        memcpy(s_id.eboot_sha1, sha, sizeof sha);      /* (whole, then have_sha1, then the event) */
+        s_id.have_sha1 = 1;
+        char hx[41];
+        ss_file_sha1_hex(sha, hx);
+        logf_("[ss-slots] EBOOT SHA-1 %s (%s, %.0f ms)\n", hx, s_host.eboot_path, now_ms() - t0);
+    } else if (s_host.eboot_path && *s_host.eboot_path) {
+        logf_("[ss-slots] WARNING: cannot hash the EBOOT %s: slot files are not checked against it\n",
+              s_host.eboot_path);
+    }
+    SetEvent(s_id_ev);
+    return 0;
+}
+
+/* The identity once the EBOOT's SHA-1 is in (or known missing): 1. 0 when it
+ * was not ready within wait_ms (a cold disk, a virus scan): `out` then has no
+ * SHA-1 -- have_sha1 0 and its bytes cleared, as id_thread may be writing
+ * them -- and a verdict made with it is not to be kept. */
+static int id_get(ss_file_identity* out, DWORD wait_ms)
+{
+    const int full = !s_id_ev || WaitForSingleObject(s_id_ev, wait_ms) == WAIT_OBJECT_0;
+    if (out) {
+        *out = s_id;
+        if (!full) { out->have_sha1 = 0; memset(out->eboot_sha1, 0, sizeof out->eboot_sha1); }
+    }
+    if (!full) {
+        static volatile LONG warned;
+        if (!InterlockedExchange(&warned, 1))
+            logf_("[ss-slots] WARNING: the EBOOT's SHA-1 was not ready after %lu ms: a check without it\n",
+                  (unsigned long)wait_ms);
+    }
+    return full;
+}
+
+int ss_slots_identity(ss_file_identity* out) { return id_get(out, 5000); }
+
+/* ---------------------------------------------------------------------------
+ * The menu's slot reader: the header (cached by size and time)
+ * -----------------------------------------------------------------------*/
+static int file_stat(const char* p, uint64_t* size, uint64_t* mtime)
+{
+    WIN32_FILE_ATTRIBUTE_DATA a;
+    if (!GetFileAttributesExA(p, GetFileExInfoStandard, &a) || (a.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+        return 0;
+    *size = ((uint64_t)a.nFileSizeHigh << 32) | a.nFileSizeLow;
+    *mtime = ((uint64_t)a.ftLastWriteTime.dwHighDateTime << 32) | a.ftLastWriteTime.dwLowDateTime;
+    return 1;
+}
+
+static void cache_drop(int slot)
+{
+    if (slot < 0 || slot > SS_UI_UNDO) return;
+    AcquireSRWLockExclusive(&s_cache_lk);
+    s_cache[slot].valid = 0;
+    ReleaseSRWLockExclusive(&s_cache_lk);
+}
+
+/* A state of another build that this build cannot resume (the LOAD's
+ * continuation / resumer check refused it): the menu greys it with that
+ * reason until the file changes. */
+static void cache_mark_unresumable(int slot)
+{
+    if (slot < 0 || slot > SS_UI_UNDO) return;
+    ss_slot_info in;
+    memset(&in, 0, sizeof in);
+    in.slot = slot;
+    if (!ss_slots_read_info(slot, &in, NULL)) return;     /* (fills the cache for the file as it is) */
+    AcquireSRWLockExclusive(&s_cache_lk);
+    if (s_cache[slot].valid && s_cache[slot].info.used) {
+        s_cache[slot].info.used = 0;
+        s_cache[slot].info.tag[0] = 0;
+        snprintf(s_cache[slot].info.reason, sizeof s_cache[slot].info.reason, "another build: cannot resume it");
+    }
+    ReleaseSRWLockExclusive(&s_cache_lk);
+}
+
+/* "3. Forward Momentum - 1:02:13" within the label's note */
+static void make_note(const p3ss_hdr* h, char* note, size_t n)
+{
+    char play[24] = "";
+    if (h->play_time_ms) ss_slots_fmt_play(h->play_time_ms, play, sizeof play);
+    const char* m = h->mission[0] ? h->mission : ss_file_mode_name(h->game_mode);
+    if (m[0] && play[0]) {
+        const size_t room = n > strlen(play) + 4 ? n - strlen(play) - 4 : 0;
+        snprintf(note, n, "%.*s - %s", (int)room, m, play);
+    } else if (m[0]) snprintf(note, n, "%s", m);
+    else if (play[0]) snprintf(note, n, "played %s", play);
+    else note[0] = 0;
+}
+
+int ss_slots_read_info(int slot, ss_slot_info* in, void* user)
+{
+    (void)user;
+    char path[MAX_PATH * 2];
+    uint64_t size = 0, mtime = 0;
+    if (!ss_slots_path(slot, NULL, path, sizeof path) || !file_stat(path, &size, &mtime)) {
+        in->used = 0;
+        return 0;
+    }
+    AcquireSRWLockShared(&s_cache_lk);
+    const int hit = s_cache[slot].valid && s_cache[slot].size == size && s_cache[slot].mtime == mtime;
+    if (hit) {
+        const int sl = in->slot;
+        *in = s_cache[slot].info;
+        in->slot = sl;
+    }
+    ReleaseSRWLockShared(&s_cache_lk);
+    if (hit) return in->used;
+    p3ss_hdr h;
+    char why[300];
+    const char* sw = "";
+    uint32_t warn = 0;
+    ss_file_identity id;
+    memset(&id, 0, sizeof id);
+    int idfull = 1;                                    /* (without the EBOOT's SHA-1: not kept) */
+    int e = ss_file_read_header(path, &h, why, sizeof why, &sw);
+    if (!e) {
+        idfull = ss_slots_identity(&id);
+        e = ss_file_check_compat_ex(&h, &id, why, sizeof why, &sw, &warn);
+        in->time = (long long)(h.created_unix_ms / 1000u);
+        make_note(&h, in->note, sizeof in->note);
+    }
+    in->used = e == SS_OK;
+    in->damaged = e == SS_E_CORRUPT;
+    in->tag[0] = 0;
+    if (!in->used) snprintf(in->reason, sizeof in->reason, "%s", sw && *sw ? sw : "cannot be loaded");
+    /* (once per file: the cache below keeps the answer until the file changes) */
+    if (!in->used) {
+        logf_("[ss-slots] %s cannot be loaded: %s\n", path, why);
+    } else if (warn & SS_COMPAT_OTHER_BUILD) {
+        const int age = ss_file_build_order(h.build_id, id.build_id);
+        snprintf(in->tag, sizeof in->tag, "%s", age < 0 ? "older build" : age > 0 ? "newer build" : "another build");
+        logf_("[ss-slots] %s: made by %s build of the port (%s; this is %s) -- it loads, with a warning\n", path,
+              age < 0 ? "an older" : age > 0 ? "a newer" : "another", h.build_id, id.build_id);
+    }
+    AcquireSRWLockExclusive(&s_cache_lk);
+    s_cache[slot].valid = idfull;
+    s_cache[slot].size = size;
+    s_cache[slot].mtime = mtime;
+    s_cache[slot].info = *in;
+    ReleaseSRWLockExclusive(&s_cache_lk);
+    return in->used;
+}
+
+/* ---------------------------------------------------------------------------
+ * Availability, and the writer's check on every other stop
+ * -----------------------------------------------------------------------*/
+static int avail(int op, char* why, unsigned n, void* user)
+{
+    (void)op; (void)user;
+    if (!g_ss_armed) {
+        snprintf(why, n, "save states are turned off (%s)", getenv("SAVESTATES") ? "SAVESTATES=0"
+                                                                                  : "savestates.ini: enabled = 0");
+        return 0;
+    }
+    if (ss_flip_count() == 0) { snprintf(why, n, "available once the game is running"); return 0; }
+    if (s_busy != JOB_FREE) {
+        snprintf(why, n, s_busy == JOB_SAVE ? "a save is still being written" : "a load is still in progress");
+        return 0;
+    }
+    return 1;
+}
+
+static int writing_check(char* what, unsigned n)
+{
+    if (!s_writing) return 0;
+    char b[24];
+    slot_name(s_job.backing_up ? SS_UI_UNDO : s_job.slot, b, sizeof b, 0);
+    snprintf(what, n, "%s", b);
+    return 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * The thumbnail
+ * -----------------------------------------------------------------------*/
+static void thumb_cb(const uint8_t* rgba, int w, int h, int stride, void* user)
+{
+    const LONG seq = (LONG)(intptr_t)user;
+    if (seq != s_thumb.want || !rgba || w <= 0 || h <= 0 || w > THUMB_W || h > THUMB_HMAX) return;
+    for (int y = 0; y < h; y++) memcpy(s_thumb.px + (size_t)y * THUMB_W * 4, rgba + (size_t)y * (size_t)stride, (size_t)w * 4);
+    s_thumb.w = w;
+    s_thumb.h = h;
+    InterlockedExchange(&s_thumb.have, seq);
+    SetEvent(s_thumb_ev);
+}
+
+static void thumb_arm(void)
+{
+    static volatile LONG s_seq;
+    if (!s_thumb_on || !s_host.thumb_grab || !s_host.png_encode) return;
+    const LONG seq = InterlockedIncrement(&s_seq);
+    ResetEvent(s_thumb_ev);
+    InterlockedExchange(&s_thumb.want, seq);
+    s_thumb.t_armed = now_ms();
+    if (!s_host.thumb_grab(THUMB_W, thumb_cb, (void*)(intptr_t)seq)) InterlockedExchange(&s_thumb.want, 0);
+}
+
+/* ss_file_write's late section: wait for the grab (at most 1.5 s after it was
+ * armed: a window that presents nothing gets no thumbnail), encode it. */
+static int thumb_late(void* user, const void** png, size_t* n)
+{
+    slot_job* j = (slot_job*)user;
+    const LONG want = s_thumb.want;
+    if (!want) return 0;
+    const double left = 1500.0 - (now_ms() - s_thumb.t_armed);
+    if (s_thumb.have != want) WaitForSingleObject(s_thumb_ev, left > 0 ? (DWORD)left : 0);
+    InterlockedExchange(&s_thumb.want, 0);                 /* a late grab is ignored from here */
+    if (s_thumb.have != want) return 0;
+    if (!s_host.png_encode(s_thumb.px, s_thumb.w, s_thumb.h, THUMB_W * 4, &j->png, &j->png_n) || !j->png) return 0;
+    j->thumb_w = s_thumb.w;
+    j->thumb_h = s_thumb.h;
+    *png = j->png;
+    *n = j->png_n;
+    return 1;
+}
+
+static void write_png_beside(const slot_job* j)
+{
+    char p[MAX_PATH * 2], tmp[MAX_PATH * 2 + 8];
+    if (!j->png || !ss_slots_path(j->slot, ".png", p, sizeof p)) return;
+    snprintf(tmp, sizeof tmp, "%s.tmp", p);
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return;
+    const int ok = fwrite(j->png, 1, j->png_n, f) == j->png_n;
+    if (fclose(f) == 0 && ok) MoveFileExA(tmp, p, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH);
+    else DeleteFileA(tmp);
+}
+
+/* ---------------------------------------------------------------------------
+ * SAVE
+ * -----------------------------------------------------------------------*/
+static void job_end(void)
+{
+    InterlockedExchange(&s_writing, 0);
+    InterlockedExchange(&s_busy, JOB_FREE);
+}
+
+static void hhmm(uint64_t unix_ms, char* b, size_t n)
+{
+    time_t t = (time_t)(unix_ms / 1000u);
+    struct tm lt;
+    if (localtime_s(&lt, &t) != 0) { snprintf(b, n, "?"); return; }
+    snprintf(b, n, "%02d:%02d", lt.tm_hour, lt.tm_min);
+}
+
+static DWORD WINAPI save_writer(LPVOID p)
+{
+    slot_job* j = (slot_job*)p;
+    char why[300] = "";
+    int e = ss_ui_ensure_dir() ? SS_OK : SS_E_IO;
+    if (e) snprintf(why, sizeof why, "cannot create the folder %s", ss_ui_dir());
+    ss_file_wopts o;
+    memset(&o, 0, sizeof o);
+    o.codec = s_codec;
+    o.below_normal = 1;
+    o.keep_bak = 1;
+    o.thumb = s_thumb.want ? thumb_late : NULL;
+    o.thumb_user = j;
+    if (!e) e = ss_file_write(j->path, j->img, &j->meta, &o, &j->fst, why, sizeof why);
+    if (!e) write_png_beside(j);
+    cache_drop(j->slot);
+    const double t_done = now_ms();
+    char nm[24], up[24], when[16];
+    slot_name(j->slot, nm, sizeof nm, 0);
+    slot_name(j->slot, up, sizeof up, 1);
+    hhmm(j->meta.created_unix_ms, when, sizeof when);
+    if (!e) {
+        logf_("[ss] %s saved: %s -- %.1f MB (image %.1f MB, %.1f%%; %u of %u chunks stored as is), pause %.1f ms,"
+              " request to saved %.2f s (write %.2f s: %s on %d thread(s) %.2f s busy, I/O %.2f s, thumbnail wait"
+              " %.2f s), thumbnail %s; mission '%s', mode %s, play %llu ms, flip %u\n",
+              nm, j->path, (double)j->fst.file_bytes / 1048576.0, (double)j->fst.raw_bytes / 1048576.0,
+              100.0 * j->fst.ratio, j->fst.stored_none, j->fst.chunks, j->pause_ms, (t_done - j->t_req) / 1000.0,
+              j->fst.ms_total / 1000.0, ss_file_codec_name(s_codec), j->fst.threads, j->fst.ms_codec / 1000.0,
+              j->fst.ms_io / 1000.0, j->fst.ms_wait_thumb / 1000.0,
+              j->png ? "yes" : "none", j->meta.mission, ss_file_mode_name(j->meta.game_mode),
+              (unsigned long long)j->meta.play_time_ms, j->meta.flip_count);
+        if (j->png) logf_("[ss]   thumbnail %dx%d, %.1f KB (also %s)\n", j->thumb_w, j->thumb_h,
+                          (double)j->png_n / 1024.0, "beside the slot as .png");
+    } else {
+        logf_("[ss] %s NOT saved: %s\n", nm, why);
+    }
+    free(j->png);
+    j->png = NULL;
+    const int origin = j->origin;
+    const unsigned seq = j->seq;
+    j->img = NULL;
+    job_end();                                         /* (before the completion: a new request may follow) */
+    if (origin == ORIGIN_UI) {
+        char msg[96];
+        if (!e) snprintf(msg, sizeof msg, "Saved %s (%s)", nm, when);
+        ss_ui_complete(seq, !e, !e ? msg : why);
+    } else if (!e) {
+        ss_ui_notify(2500, "Saved %s (%s)", nm, when);
+    } else {
+        ss_ui_notify(5000, "%s was not saved: %s", up, why);
+    }
+    return 0;
+}
+
+/* The capture's metadata, the game running again (frame-clock thread). */
+static void fill_meta(slot_job* j)
+{
+    ss_file_meta* m = &j->meta;
+    memset(m, 0, sizeof *m);
+    if (s_host.title_id) snprintf(m->title_id, sizeof m->title_id, "%s", s_host.title_id);
+    if (s_host.disc_ver) snprintf(m->disc_ver, sizeof m->disc_ver, "%s", s_host.disc_ver);
+    if (s_id_ev && WaitForSingleObject(s_id_ev, 0) == WAIT_OBJECT_0 && s_id.have_sha1)
+        memcpy(m->eboot_sha1, s_id.eboot_sha1, 20);
+    snprintf(m->build_id, sizeof m->build_id, "%s", s_id.build_id);
+    if (s_host.cont_hash) m->cont_hash = s_host.cont_hash();
+    m->spu_table_hash = 0;                            /* (the image's own: ss_file reads SPUC) */
+    m->guest_time_scale = s_host.guest_time_scale;
+    if (s_host.display) s_host.display(&m->aspect, &m->hud, &m->lod, &m->fmv);
+    if (s_host.describe) s_host.describe(m->mission, sizeof m->mission, &m->game_mode);
+    TIME_ZONE_INFORMATION tz;
+    const DWORD r = GetTimeZoneInformation(&tz);
+    m->tz_min = r == TIME_ZONE_ID_INVALID ? 0 : -(int32_t)(tz.Bias + (r == TIME_ZONE_ID_DAYLIGHT ? tz.DaylightBias : 0));
+    m->slot = (uint32_t)j->slot;
+    m->pause_us = (uint32_t)(j->pause_ms * 1000.0);
+    if (j->img) {
+        ss_time_info ti;
+        if (ss_time_read(j->img, &ti) == SS_OK) {
+            m->created_unix_ms = ti.unix_ms;
+            m->play_time_ms = ti.play_ms;
+            m->guest_time_ns = ti.guest_ns;
+            m->flip_count = ti.flip_count;
+        }
+    }
+}
+
+/* A capture is sealed in the staging buffer: write it out (frame-clock thread). */
+static int start_writer(slot_job* j)
+{
+    j->img = ss_image_last();
+    if (!j->img) return 0;
+    ss_request_result o;
+    ss_last_request(&o);
+    j->pause_ms = o.pause_ms;
+    fill_meta(j);
+    thumb_arm();
+    InterlockedExchange(&s_writing, 1);
+    HANDLE t = CreateThread(NULL, 256 * 1024, save_writer, j, 0, NULL);
+    if (!t) { InterlockedExchange(&s_writing, 0); return 0; }
+    CloseHandle(t);
+    return 1;
+}
+
+static void reason_msg(int reason, const ss_request_result* o, char* b, size_t n)
+{
+    const char* t = ss_reason_text(reason);
+    if ((reason == SS_REASON_IMAGE || reason == SS_REASON_NOT_RESUMABLE) && o->why[0]) snprintf(b, n, "%s", o->why);
+    else if (o->detail[0]) snprintf(b, n, "%s (%s)", t, o->detail);
+    else snprintf(b, n, "%s", t);
+}
+
+static void save_done(int ok, int reason, void* user)
+{
+    (void)user;
+    slot_job* j = &s_job;
+    ss_request_result o;
+    ss_last_request(&o);
+    if (ok && start_writer(j)) return;
+    char why[200];
+    if (ok) snprintf(why, sizeof why, "the capture could not be written");
+    else reason_msg(reason, &o, why, sizeof why);
+    char nm[24];
+    slot_name(j->slot, nm, sizeof nm, 0);
+    logf_("[ss] %s NOT saved: %s\n", nm, why);
+    const unsigned seq = j->seq;
+    job_end();
+    ss_ui_complete(seq, 0, why);
+}
+
+/* SS_SAVE_AT with SS_SAVE_SLOT=<n>[,<n>...]: the k-th capture (in time
+ * order) to the k-th slot listed, the last one for the rest. */
+static int s_save_at_slot[16];
+static int s_save_at_n;
+static volatile LONG s_save_at_calls;
+static void save_at_sink(int ok, int reason, double t)
+{
+    (void)reason;
+    const LONG k = InterlockedIncrement(&s_save_at_calls) - 1;
+    if (!ok || s_save_at_n <= 0) return;
+    const int slot = s_save_at_slot[k < s_save_at_n ? k : s_save_at_n - 1];
+    if (InterlockedCompareExchange(&s_busy, JOB_SAVE, JOB_FREE) != JOB_FREE) {
+        logf_("[ss] SS_SAVE_AT t=%.1f: not written to a slot -- another save or load is in progress\n", t);
+        return;
+    }
+    slot_job* j = &s_job;
+    HANDLE ev = j->done_ev;                            /* (kept: a later load's) */
+    memset(j, 0, sizeof *j);
+    j->done_ev = ev;
+    j->op = SS_UI_OP_SAVE;
+    j->slot = slot;
+    j->origin = ORIGIN_SAVE_AT;
+    j->t_req = now_ms();
+    ss_slots_path(j->slot, NULL, j->path, sizeof j->path);
+    if (!start_writer(j)) {
+        logf_("[ss] SS_SAVE_AT t=%.1f: the capture could not be written\n", t);
+        job_end();
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * LOAD
+ * -----------------------------------------------------------------------*/
+static void load_done(int ok, int reason, void* user)
+{
+    slot_job* j = (slot_job*)user;
+    ss_last_request(&j->res);
+    InterlockedExchange(&j->done_reason, reason);
+    InterlockedExchange(&j->done_ok, ok ? 1 : 0);
+    SetEvent(j->done_ev);
+}
+
+static int transient(int reason)
+{
+    return reason != SS_REASON_OFF && reason != SS_REASON_DEBUG_SWITCH && reason != SS_REASON_NOT_YET &&
+           reason != SS_REASON_IMAGE && reason != SS_REASON_NOT_RESUMABLE;
+}
+
+/* Submit the LOAD of j->fi and wait until it is done. 1 = loaded. */
+static int run_load(slot_job* j, double give_up_s, char* why, size_t why_n)
+{
+    const double t_end = now_ms() + give_up_s * 1000.0;
+    int image_tries = 0;
+    for (;;) {
+        ss_request r;
+        memset(&r, 0, sizeof r);
+        r.purpose = SS_P_LOAD;
+        r.slot = j->slot;
+        r.image = &j->fi.img;
+        r.flags = SS_RQ_CRC_CHECKED;
+        r.give_up_s = (t_end - now_ms()) / 1000.0;
+        if (r.give_up_s < 0.5) r.give_up_s = 0.5;
+        r.done = load_done;
+        r.user = j;
+        ResetEvent(j->done_ev);
+        const int q = ss_request_submit(&r);
+        if (q == SS_R_OFF) { snprintf(why, why_n, "%s", ss_reason_text(SS_REASON_OFF)); return 0; }
+        if (q != SS_R_QUEUED) {
+            if (now_ms() > t_end) { snprintf(why, why_n, "the save-state engine stayed busy"); return 0; }
+            Sleep(20);
+            continue;
+        }
+        WaitForSingleObject(j->done_ev, INFINITE);
+        if (j->done_ok) return 1;
+        reason_msg(j->done_reason, &j->res, why, why_n);
+        /* a launch load at boot: the session's own SPU work may still be on
+         * (a check_image refusal) -- try again while there is time */
+        const int again = j->origin == ORIGIN_LAUNCH &&
+                          (transient(j->done_reason) || (j->done_reason == SS_REASON_IMAGE && ++image_tries < 20));
+        if (!again || now_ms() + 500.0 > t_end) return 0;
+        logf_("[ss] SS_LOAD: refused (%s: %s) -- trying again\n", ss_reason_name(j->done_reason), why);
+        Sleep(j->done_reason == SS_REASON_IMAGE ? 1000 : 100);
+    }
+}
+
+static DWORD WINAPI free_thread(LPVOID p)
+{
+    ss_file_image* fi = (ss_file_image*)p;
+    ss_file_image_free(fi);
+    free(fi);
+    return 0;
+}
+
+/* Let the 350 MB go off the calling thread (VirtualFree of that much takes a
+ * few ms). */
+static void free_image_async(ss_file_image* fi)
+{
+    ss_file_image* c = (ss_file_image*)malloc(sizeof *c);
+    if (!c) { ss_file_image_free(fi); return; }
+    *c = *fi;
+    memset(fi, 0, sizeof *fi);
+    HANDLE t = CreateThread(NULL, 64 * 1024, free_thread, c, 0, NULL);
+    if (t) CloseHandle(t);
+    else free_thread(c);
+}
+
+/* ---------------------------------------------------------------------------
+ * The undo point (backup_before_load): the moment before a load
+ * -----------------------------------------------------------------------*/
+/* The load waits for the undo point's file: xpress, not the slots' xpress_huff -- measured (pier, 6 loads
+ * each): written in 0.18-0.20 s instead of 0.30-0.31 s, 237 MB instead of 204 MB. */
+static int undo_codec(void) { return s_codec == P3SS_CODEC_XPRESS_HUFF ? P3SS_CODEC_XPRESS : s_codec; }
+
+int ss_slots_undo_write(const ss_image* img, const ss_file_meta* meta, ss_file_stats* st, char* why, size_t why_n)
+{
+    char path[MAX_PATH * 2];
+    if (!ss_slots_path(SS_UI_UNDO, NULL, path, sizeof path)) {
+        snprintf(why, why_n, "the save-state folder's path is too long");
+        return SS_E_ARG;
+    }
+    if (!ss_ui_ensure_dir()) {
+        snprintf(why, why_n, "cannot create the folder %s", ss_ui_dir());
+        return SS_E_IO;
+    }
+    ss_file_wopts o;
+    memset(&o, 0, sizeof o);
+    o.codec = undo_codec();
+    o.below_normal = 0;                     /* (the load waits for it) */
+    o.keep_bak = 1;                         /* the previous undo point, until the load is done */
+    const int e = ss_file_write(path, img, meta, &o, st, why, why_n);
+    cache_drop(SS_UI_UNDO);
+    return e;
+}
+
+/* A rename / delete of a file just written or read: an indexer or an antivirus can hold it for a moment
+ * (ss_file.c retries the same way). 1 done. */
+static int undo_retry(const char* from, const char* to)
+{
+    for (int k = 0;; k++) {
+        if (to ? MoveFileExA(from, to, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) : DeleteFileA(from)) return 1;
+        const DWORD le = GetLastError();
+        if (k >= 20 || le == ERROR_FILE_NOT_FOUND || le == ERROR_PATH_NOT_FOUND) { SetLastError(le); return 0; }
+        Sleep(100);
+    }
+}
+
+void ss_slots_undo_settle(int loaded)
+{
+    char p[MAX_PATH * 2], bak[MAX_PATH * 2 + 8];
+    if (!ss_slots_path(SS_UI_UNDO, NULL, p, sizeof p)) return;
+    snprintf(bak, sizeof bak, "%s.bak", p);
+    const int had = GetFileAttributesA(bak) != INVALID_FILE_ATTRIBUTES;
+    if (loaded) {
+        if (had && !undo_retry(bak, NULL))
+            logf_("[ss] undo point: cannot remove the previous one, %s (error %lu)\n", bak, (unsigned long)GetLastError());
+    } else if (had) {
+        if (!undo_retry(bak, p))
+            logf_("[ss] undo point: cannot put the previous one back from %s (error %lu)\n", bak,
+                  (unsigned long)GetLastError());
+    } else {
+        DeleteFileA(p);                     /* (no load happened: there is nothing to undo) */
+    }
+    cache_drop(SS_UI_UNDO);
+}
+
+/* The undo point's SAVE is done (frame-clock thread): the moment's metadata
+ * now, as after a slot's capture, and every other stop held off until the
+ * file is written (the image stays in the staging buffer meanwhile). */
+static void undo_done(int ok, int reason, void* user)
+{
+    slot_job* j = (slot_job*)user;
+    ss_last_request(&j->res);
+    const ss_image* img = ok ? ss_image_last() : NULL;
+    if (img) {
+        j->img = img;
+        j->pause_ms = j->res.pause_ms;
+        fill_meta(j);
+        j->meta.slot = (uint32_t)SS_UI_UNDO;
+        InterlockedExchange(&s_writing, 1);
+    }
+    InterlockedExchange(&j->done_reason, ok && !img ? SS_REASON_CAPTURE : reason);
+    InterlockedExchange(&j->done_ok, img ? 1 : 0);
+    SetEvent(j->done_ev);
+}
+
+/* Before a load from the menu or a key (load_reader, the file read and
+ * accepted): save the game as it is now to the undo point. The SAVE gets at
+ * most a second to find a moment (a game that cannot stop now is loaded
+ * over without one). 1 = kept (ss_slots_undo_settle once the load is done),
+ * 0 with why. */
+static int undo_keep(slot_job* j, char* why, size_t why_n)
+{
+    const double t0 = now_ms();
+    ss_request r;
+    memset(&r, 0, sizeof r);
+    r.purpose = SS_P_SAVE;
+    r.slot = SS_UI_UNDO;
+    r.give_up_s = s_give_up_s < 1.0 ? s_give_up_s : 1.0;
+    r.done = undo_done;
+    r.user = j;
+    InterlockedExchange(&j->backing_up, 1);
+    ResetEvent(j->done_ev);
+    const int q = ss_request_submit(&r);
+    if (q != SS_R_QUEUED) {
+        InterlockedExchange(&j->backing_up, 0);
+        snprintf(why, why_n, "%s", q == SS_R_OFF ? ss_reason_text(SS_REASON_OFF) : "the save-state engine was busy");
+        return 0;
+    }
+    WaitForSingleObject(j->done_ev, INFINITE);
+    if (!j->done_ok) {
+        InterlockedExchange(&j->backing_up, 0);
+        reason_msg(j->done_reason, &j->res, why, why_n);
+        return 0;
+    }
+    const double t_cap = now_ms();
+    ss_file_stats st;
+    memset(&st, 0, sizeof st);
+    const int e = ss_slots_undo_write(j->img, &j->meta, &st, why, why_n);
+    j->img = NULL;
+    InterlockedExchange(&s_writing, 0);
+    InterlockedExchange(&j->backing_up, 0);
+    const double t_end = now_ms();
+    j->undo_pause_ms = j->pause_ms;
+    j->undo_write_ms = t_end - t_cap;
+    j->undo_ms = t_end - t0;
+    if (e) return 0;
+    char up[MAX_PATH * 2];
+    ss_slots_path(SS_UI_UNDO, NULL, up, sizeof up);
+    logf_("[ss] undo point: the moment before the load kept in %s -- pause %.1f ms, %.1f MB written in %.2f s"
+          " (%s on %d thread(s)); %.2f s from its request\n", up, j->undo_pause_ms, (double)st.file_bytes / 1048576.0,
+          j->undo_write_ms / 1000.0, ss_file_codec_name(undo_codec()), st.threads,
+          j->undo_ms / 1000.0);
+    return 1;
+}
+
+static DWORD WINAPI load_reader(LPVOID p)
+{
+    slot_job* j = (slot_job*)p;
+    char nm[24], why[300] = "";
+    slot_name(j->slot, nm, sizeof nm, 0);
+    const char* sw = "";
+    ss_file_identity id;
+    id_get(&id, 60000);                                /* (a state is checked against the EBOOT: wait longer) */
+    int ok = 0;
+    const double t0 = now_ms();
+    int e = ss_file_load(j->path, &id, 0, &j->fi, &j->fst, why, sizeof why, &sw);
+    const double t_read = now_ms() - t0;
+    double t_flip = 0;
+    const int other = !e && (j->fi.compat_warn & SS_COMPAT_OTHER_BUILD);
+    int undo_tried = 0, undo_kept = 0;
+    char uwhy[200] = "", when[16] = "";
+    if (!e) {
+        logf_("[ss] %s read: %s -- %.1f MB -> %.1f MB in %.0f ms (%d thread(s), codec %.0f ms busy); made %s,"
+              " mission '%s', play %llu ms\n", j->origin == ORIGIN_LAUNCH ? "SS_LOAD" : nm, j->path,
+              (double)j->fst.file_bytes / 1048576.0, (double)j->fst.raw_bytes / 1048576.0, t_read, j->fst.threads,
+              j->fst.ms_codec, j->fi.hdr.build_id, j->fi.hdr.mission, (unsigned long long)j->fi.hdr.play_time_ms);
+        hhmm(j->fi.hdr.created_unix_ms, when, sizeof when);
+        if (other) {
+            const int age = ss_file_build_order(j->fi.hdr.build_id, id.build_id);
+            logf_("[ss]   made by %s build of the port (this is %s): loaded with a warning -- its layouts and SPU"
+                  " table agree; savestates.ini build_check = 1 refuses it\n",
+                  age < 0 ? "an older" : age > 0 ? "a newer" : "another", id.build_id);
+        }
+        double aspect = 0;
+        uint8_t hud = 0, lod = 0, fmv = 0;
+        if (s_host.display) s_host.display(&aspect, &hud, &lod, &fmv);
+        if ((aspect > 0 || j->fi.hdr.aspect > 0) && (aspect - j->fi.hdr.aspect > 0.002 || j->fi.hdr.aspect - aspect > 0.002))
+            logf_("[ss]   saved at aspect %.4f, this session %.4f: the loaded state keeps its own (design 5.6)\n",
+                  j->fi.hdr.aspect, aspect);
+        if (j->origin == ORIGIN_LAUNCH) {
+            /* as soon as the game has presented its first frame */
+            while (ss_flip_count() == 0 && g_ss_armed) Sleep(5);
+            t_flip = proc_s();
+        }
+        /* the undo point: the game as it is now, before it is replaced */
+        if (j->origin == ORIGIN_UI && s_backup) {
+            undo_tried = 1;
+            undo_kept = undo_keep(j, uwhy, sizeof uwhy);
+            if (!undo_kept && j->slot != SS_UI_UNDO)
+                logf_("[ss] undo point: the moment before the load could not be kept (%s) -- the load goes ahead;"
+                      " Undo last load stays as it was\n", uwhy);
+        }
+        /* Undo itself keeps the way back (its moment becomes the next undo point): without it -- the game cannot
+         * be saved this second, or backup_before_load = 0 -- it would replace the game for good. Refused; the game
+         * goes on as it is. */
+        const int undo_refused = j->origin == ORIGIN_UI && j->slot == SS_UI_UNDO && !undo_kept;
+        if (undo_refused) {
+            if (s_backup)
+                snprintf(why, sizeof why, "the game could not be saved first, which Undo needs to keep the way back"
+                         " (%.140s) -- try again in a moment", uwhy);
+            else
+                snprintf(why, sizeof why, "Undo last load is off (savestates.ini backup_before_load = 0)");
+        }
+        InterlockedExchange(&j->done_reason, SS_REASON_OK);   /* (the LOAD's own reason from here) */
+        const double t_sub = now_ms();
+        const double give = j->origin == ORIGIN_LAUNCH
+                          ? ss_ui_cfg_num("launch_give_up_s", getenv("SS_LOAD_GIVE_UP_S") ? atof(getenv("SS_LOAD_GIVE_UP_S")) : 60.0)
+                          : s_give_up_s;
+        ok = undo_refused ? 0 : run_load(j, give, why, sizeof why);
+        const double t_done = now_ms();
+        if (undo_kept) ss_slots_undo_settle(ok);
+        if (ok) {
+            const ss_request_result* o = &j->res;
+            char ub[160] = "";
+            if (undo_kept)
+                snprintf(ub, sizeof ub, "; the undo point first: pause %.1f ms, written in %.2f s, %.2f s in all",
+                         j->undo_pause_ms, j->undo_write_ms / 1000.0, j->undo_ms / 1000.0);
+            else if (undo_tried)
+                snprintf(ub, sizeof ub, "; no undo point (%.100s)", uwhy);
+            if (j->origin == ORIGIN_LAUNCH)
+                logf_("[ss] loaded %s at t=%.1fs (boot to gameplay %.1f s; read + decompress %.0f ms while booting,"
+                      " first frame at t=%.1fs, load %.0f ms after it, pause %.1f ms)\n", j->path, proc_s(), proc_s(),
+                      t_read, t_flip, t_done - t_sub, o->pause_ms);
+            else
+                logf_("[ss] %s loaded: %s -- read + decompress %.0f ms, then the load: pause %.1f ms (stop %.1f,"
+                      " discard %.1f, teardown %.1f, restore %.1f, recreate %.1f, release %.1f); request to loaded"
+                      " %.2f s%s\n", nm, j->path, t_read, o->pause_ms,
+                      o->pause_ms - o->discard_ms - o->teardown_ms - o->restore_ms - o->verify_ms - o->recreate_ms -
+                      o->release_ms, o->discard_ms, o->teardown_ms, o->restore_ms, o->recreate_ms, o->release_ms,
+                      (t_done - j->t_req) / 1000.0, ub);
+        } else if (other && j->done_reason == SS_REASON_NOT_RESUMABLE && !strcmp(j->res.detail, "the image")) {
+            /* another build's state this one cannot resume: say so, here and in the menu */
+            char w2[300];
+            snprintf(w2, sizeof w2, "it was made by another build of the port, which this build cannot resume (%s)", why);
+            snprintf(why, sizeof why, "%s", w2);
+            if (j->origin == ORIGIN_UI) cache_mark_unresumable(j->slot);
+        }
+    }
+    if (!ok) logf_("[ss] %s NOT loaded (%s): %s\n", j->origin == ORIGIN_LAUNCH ? "SS_LOAD" : nm, j->path, why);
+    free_image_async(&j->fi);
+    const int origin = j->origin;
+    const unsigned seq = j->seq;
+    char path[sizeof j->path];                        /* (s_job is the next job's after job_end) */
+    snprintf(path, sizeof path, "%s", j->path);
+    const int slot = j->slot;
+    job_end();
+    /* the notice: what was loaded, a state of another build (longer), and an
+     * undo point that could not be kept */
+    static const char k_other[] = " -- a state made by another build of the port: something fixed since then may"
+                                  " behave differently";
+    if (origin == ORIGIN_UI) {
+        char msg[256];
+        if (slot == SS_UI_UNDO) snprintf(msg, sizeof msg, "Undid the last load (back to %s)", when);
+        else snprintf(msg, sizeof msg, "Loaded %s", nm);
+        if (ok && other) strncat(msg, k_other, sizeof msg - strlen(msg) - 1);
+        if (ok && undo_tried && !undo_kept) {
+            const size_t u = strlen(msg);
+            snprintf(msg + u, sizeof msg - u, " (no undo point: %.80s)", uwhy);
+        }
+        ss_ui_complete_ms(seq, ok, ok ? msg : why, ok && (other || (undo_tried && !undo_kept)) ? 8000 : 0);
+    } else if (origin == ORIGIN_LAUNCH) {
+        if (ok) ss_ui_notify(other ? 8000 : 2500, "Loaded %s%s", slot >= 0 ? nm : "the save state", other ? k_other : "");
+        else ss_ui_notify(6000, "The save state was not loaded: %s", why);
+        if (s_launch_hook) s_launch_hook(ok, ok ? path : why);
+    }
+    return 0;
+}
+
+static int start_reader(slot_job* j)
+{
+    if (!j->done_ev) j->done_ev = CreateEventA(NULL, TRUE, FALSE, NULL);
+    if (!j->done_ev) return 0;
+    HANDLE t = CreateThread(NULL, 256 * 1024, load_reader, j, 0, NULL);
+    if (!t) return 0;
+    CloseHandle(t);
+    return 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * The window menu's engine (frame-clock thread, ss_ui_service)
+ * -----------------------------------------------------------------------*/
+static int engine(const ss_ui_request* req, char* why, unsigned why_n, void* user)
+{
+    (void)user;
+    if (!avail(req->op, why, why_n, NULL)) return SS_UI_ENGINE_REFUSED;
+    const LONG kind = req->op == SS_UI_OP_SAVE ? JOB_SAVE : JOB_LOAD;
+    if (InterlockedCompareExchange(&s_busy, kind, JOB_FREE) != JOB_FREE) {
+        snprintf(why, why_n, "another save or load is in progress");
+        return SS_UI_ENGINE_REFUSED;
+    }
+    slot_job* j = &s_job;
+    HANDLE ev = j->done_ev;
+    memset(j, 0, sizeof *j);
+    j->done_ev = ev;
+    j->op = req->op;
+    j->slot = req->slot;
+    j->seq = req->seq;
+    j->origin = ORIGIN_UI;
+    j->t_req = now_ms();
+    if (!ss_slots_path(j->slot, NULL, j->path, sizeof j->path)) {
+        job_end();
+        snprintf(why, why_n, "the save-state folder's path is too long");
+        return SS_UI_ENGINE_REFUSED;
+    }
+    if (req->op == SS_UI_OP_SAVE) {
+        ss_request r;
+        memset(&r, 0, sizeof r);
+        r.purpose = SS_P_SAVE;
+        r.slot = j->slot;
+        r.give_up_s = s_give_up_s;
+        r.done = save_done;
+        r.user = j;
+        const int q = ss_request_submit(&r);
+        if (q != SS_R_QUEUED) {
+            job_end();
+            snprintf(why, why_n, "%s", q == SS_R_OFF ? ss_reason_text(SS_REASON_OFF) : "the game is busy");
+            return SS_UI_ENGINE_REFUSED;
+        }
+        return SS_UI_ENGINE_STARTED;
+    }
+    if (!start_reader(j)) {
+        job_end();
+        snprintf(why, why_n, "no thread to read the file");
+        return SS_UI_ENGINE_REFUSED;
+    }
+    return SS_UI_ENGINE_STARTED;
+}
+
+/* SAVESTATES=0: the menu still says why */
+static int engine_off(const ss_ui_request* req, char* why, unsigned why_n, void* user)
+{
+    (void)req;
+    avail(0, why, why_n, user);
+    return SS_UI_ENGINE_REFUSED;
+}
+
+/* ---------------------------------------------------------------------------
+ * Setup
+ * -----------------------------------------------------------------------*/
+static int parse_slot(const char* v)
+{
+    if (!v || !*v) return -1;
+    if (!_stricmp(v, "q") || !_stricmp(v, "quick")) return SS_UI_QUICK;
+    char* end;
+    const long n = strtol(v, &end, 10);
+    return (*end == 0 && n >= 0 && n <= SS_UI_SLOTS) ? (int)n : -2;   /* -2: not a slot number (a path) */
+}
+
+/* the exe's link stamp: the build id's last part */
+static void exe_stamp(char* b, size_t n)
+{
+    const uint8_t* base = (const uint8_t*)GetModuleHandleA(NULL);
+    const IMAGE_DOS_HEADER* d = (const IMAGE_DOS_HEADER*)base;
+    if (!base || d->e_magic != IMAGE_DOS_SIGNATURE) { snprintf(b, n, "?"); return; }
+    const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)(base + d->e_lfanew);
+    snprintf(b, n, "%08lX-%08lX", (unsigned long)nt->FileHeader.TimeDateStamp,
+             (unsigned long)nt->OptionalHeader.SizeOfImage);
+}
+
+/* What a write cut short left in the folder (the game was killed, or the
+ * final rename failed twice -- ss_file_write keeps the new .tmp then): a
+ * complete .tmp whose slot file is missing becomes the slot file; any other
+ * .tmp (and a thumbnail's) older than two minutes is removed -- a younger one
+ * may be another instance's write in progress. */
+int ss_slots_sweep(void)
+{
+    FILETIME now;
+    GetSystemTimeAsFileTime(&now);
+    const uint64_t t_now = ((uint64_t)now.dwHighDateTime << 32) | now.dwLowDateTime;
+    int done = 0;
+    for (int k = 0; k <= SS_UI_UNDO; k++) {
+        static const char* const k_ext[2] = { ".p3ss.tmp", ".png.tmp" };
+        for (int x = 0; x < 2; x++) {
+            char tmp[MAX_PATH * 2], path[MAX_PATH * 2];
+            WIN32_FILE_ATTRIBUTE_DATA a;
+            if (!ss_slots_path(k, k_ext[x], tmp, sizeof tmp) || !GetFileAttributesExA(tmp, GetFileExInfoStandard, &a))
+                continue;
+            if (x == 0 && ss_slots_path(k, NULL, path, sizeof path) &&
+                GetFileAttributesA(path) == INVALID_FILE_ATTRIBUTES) {
+                p3ss_hdr* h = (p3ss_hdr*)malloc(sizeof *h);
+                char why[200] = "";
+                const int whole = h && ss_file_read_header(tmp, h, why, sizeof why, NULL) == SS_OK;
+                free(h);
+                if (whole && MoveFileExA(tmp, path, MOVEFILE_WRITE_THROUGH)) {
+                    logf_("[ss-slots] %s: a complete save state left as %s -- it is the slot's file again\n", path, tmp);
+                    done++;
+                    continue;
+                }
+            }
+            const uint64_t t = ((uint64_t)a.ftLastWriteTime.dwHighDateTime << 32) | a.ftLastWriteTime.dwLowDateTime;
+            if (t_now > t && t_now - t > 120ull * 10000000ull && DeleteFileA(tmp)) {
+                logf_("[ss-slots] removed %s, left by a write that did not finish\n", tmp);
+                done++;
+            }
+        }
+    }
+    return done;
+}
+
+void ss_slots_init(const ss_slots_host* host)
+{
+    if (InterlockedCompareExchange(&s_inited, 1, 0) != 0) return;
+    if (host) s_host = *host;
+    /* the folder: SS_DIR, else savestates.ini dir (default savestates) + the title id */
+    if (!getenv("SS_DIR") || !*getenv("SS_DIR")) {
+        const char* d = ss_ui_cfg("dir");
+        char dir[MAX_PATH * 2];
+        snprintf(dir, sizeof dir, "%s%s%s", d && *d ? d : "savestates", s_host.title_id && *s_host.title_id ? "\\" : "",
+                 s_host.title_id ? s_host.title_id : "");
+        ss_ui_set_dir(dir);
+    }
+    /* settings */
+    const char* c = ss_ui_cfg("compression");
+    if (c && *c) {
+        const int k = ss_file_codec_parse(c);
+        if (k >= 0) s_codec = k;
+        else logf_("[ss-slots] savestates.ini compression = %s: expected xpress_huff, xpress or none\n", c);
+    }
+    s_thumb_on = ss_ui_cfg_int("thumbnail", 1) != 0;
+    s_give_up_s = ss_ui_cfg_num("give_up_s", 3.0);
+    if (!(s_give_up_s >= 0.2 && s_give_up_s <= 60.0)) s_give_up_s = 3.0;
+    s_backup = ss_ui_cfg_int("backup_before_load", 1) != 0;
+    /* what files are checked against */
+    if (s_host.title_id) snprintf(s_id.title_id, sizeof s_id.title_id, "%s", s_host.title_id);
+    if (s_host.disc_ver) snprintf(s_id.disc_ver, sizeof s_id.disc_ver, "%s", s_host.disc_ver);
+    char stamp[40];
+    exe_stamp(stamp, sizeof stamp);
+    snprintf(s_id.build_id, sizeof s_id.build_id, "%.44s | %s", s_host.build_text ? s_host.build_text : "?", stamp);
+    if (s_host.spu_table) s_id.spu_table_hash = s_host.spu_table();
+    /* the build policy (M7b, design 5.4): another build's state loads, with a warning, when the
+     * game, every section's layout, the SPU table and (the load's own check) every continuation
+     * agree; build_check = 1 (savestates.ini, SAVESTATES_CFG) keeps the first vertical slice's
+     * rule -- this build's states only */
+    s_id.check_build = ss_ui_cfg_int("build_check", 0) != 0;
+    logf_("[ss-slots] build policy: %s; undo point before each load %s\n",
+          s_id.check_build ? "this build's states only (build_check = 1)"
+                           : "other builds' states load with a warning when their layouts agree (build_check = 0)",
+          s_backup ? "on (backup_before_load = 1)" : "off (backup_before_load = 0)");
+    s_id_ev = CreateEventA(NULL, TRUE, FALSE, NULL);
+    s_thumb_ev = CreateEventA(NULL, TRUE, FALSE, NULL);
+    HANDLE t = s_id_ev ? CreateThread(NULL, 64 * 1024, id_thread, NULL, 0, NULL) : NULL;
+    if (t) CloseHandle(t);
+    else if (s_id_ev) SetEvent(s_id_ev);
+
+    ss_ui_set_slot_reader(ss_slots_read_info, NULL);
+    ss_ui_set_availability(avail, NULL);
+    ss_slots_sweep();
+    if (!g_ss_armed) {
+        ss_ui_set_engine(engine_off, NULL);
+        logf_("[ss-slots] save states are off: the Save / Load menus are greyed%s\n",
+              getenv("SS_LOAD") ? "; SS_LOAD ignored" : "");
+        return;
+    }
+    ss_ui_set_engine(engine, NULL);
+    ss_add_check(SS_REASON_WRITING, writing_check);
+    logf_("[ss-slots] slots in %s (%s, thumbnails %s, give up after %.1f s; settings: %s); build id '%s'\n",
+          ss_ui_dir(), ss_file_codec_name(s_codec), s_thumb_on ? "on" : "off", s_give_up_s,
+          ss_ui_cfg_file()[0] ? ss_ui_cfg_file() : "defaults (no savestates.ini)", s_id.build_id);
+
+    const char* sv = getenv("SS_SAVE_SLOT");
+    if (sv && *sv) {
+        char b[96];
+        snprintf(b, sizeof b, "%s", sv);
+        int bad = 0;
+        char* ctx = NULL;
+        for (char* tok = strtok_s(b, ", ", &ctx); tok && s_save_at_n < 16; tok = strtok_s(NULL, ", ", &ctx)) {
+            const int k = parse_slot(tok);
+            if (k >= 0) s_save_at_slot[s_save_at_n++] = k;
+            else bad = 1;
+        }
+        if (s_save_at_n > 0 && !bad) {
+            ss_set_save_at_sink(save_at_sink);
+            logf_("[ss-slots] SS_SAVE_SLOT=%s: SS_SAVE_AT captures are written to these slots, in time order\n", sv);
+        } else {
+            s_save_at_n = 0;
+            logf_("[ss-slots] SS_SAVE_SLOT=%s: expected slot numbers (0-%d) or q, comma-separated\n", sv, SS_UI_SLOTS);
+        }
+    }
+    const char* lv = getenv("SS_LOAD");
+    if (lv && *lv) {
+        slot_job* j = &s_job;
+        memset(j, 0, sizeof *j);
+        j->op = SS_UI_OP_LOAD;
+        j->origin = ORIGIN_LAUNCH;
+        j->t_req = now_ms();
+        const int k = parse_slot(lv);
+        j->slot = k >= 0 ? k : -1;
+        if (k >= 0) ss_slots_path(k, NULL, j->path, sizeof j->path);
+        else if (!GetFullPathNameA(lv, (DWORD)sizeof j->path, j->path, NULL)) snprintf(j->path, sizeof j->path, "%s", lv);
+        InterlockedExchange(&s_busy, JOB_LOAD);
+        logf_("[ss-slots] SS_LOAD=%s: %s is read now and loaded at the game's first frame\n", lv, j->path);
+        if (!start_reader(j)) {
+            job_end();
+            logf_("[ss] SS_LOAD: no thread to read %s\n", j->path);
+            if (s_launch_hook) s_launch_hook(0, "no thread to read the file");
+        }
+    }
+}
+
+#else /* !_WIN32 */
+
+void ss_slots_init(const ss_slots_host* host) { (void)host; }
+int  ss_slots_path(int slot, const char* ext, char* buf, size_t n) { (void)slot; (void)ext; (void)buf; (void)n; return 0; }
+int  ss_slots_busy(void) { return 0; }
+int  ss_slots_wait_written(unsigned max_ms) { (void)max_ms; return 1; }
+int  ss_slots_sweep(void) { return 0; }
+int  ss_slots_read_info(int slot, ss_slot_info* info, void* user) { (void)slot; (void)user; info->used = 0; return 0; }
+int  ss_slots_identity(ss_file_identity* out) { if (out) memset(out, 0, sizeof *out); return 1; }
+void ss_slots_set_launch_hook(void (*fn)(int ok, const char* what)) { (void)fn; }
+void ss_slots_fmt_play(uint64_t ms, char* b, size_t n) { snprintf(b, n, "%llu", (unsigned long long)(ms / 1000u)); }
+int  ss_slots_undo_write(const ss_image* img, const ss_file_meta* meta, ss_file_stats* st, char* why, size_t why_n)
+{ (void)img; (void)meta; (void)st; if (why && why_n) snprintf(why, why_n, "slot files are Windows only"); return SS_E_STATE; }
+void ss_slots_undo_settle(int loaded) { (void)loaded; }
+
+#endif
diff --git a/runtime/savestate/ss_slots.h b/runtime/savestate/ss_slots.h
new file mode 100644
index 0000000..f354f1a
--- /dev/null
+++ b/runtime/savestate/ss_slots.h
@@ -0,0 +1,147 @@
+/*
+ * ps3recomp - save-state slots: the engine behind the window menu's Save /
+ * Load, F5 / F9 and the slot hotkeys (engine design 3.2, 3.3; milestone M5)
+ *
+ * What a slot is: <dir>\slot03.p3ss (numbered slots 1..10) or <dir>\quick.p3ss
+ * (the quick slot, F5 / F9), a P3SS v1 file (ss_file.h), with slot03.png (the
+ * thumbnail, 320 wide) and slot03.p3ss.bak (the previous version) beside it.
+ * <dir> is SS_DIR, else savestates.ini `dir` (default "savestates", under the
+ * working directory) + "\<title id>": savestates\BCUS98125.
+ *
+ * SAVE (ss_ui's request, on the frame-clock thread): a SAVE request to the
+ * coordinator (ss_core.h); its capture is the pause. Then, the game running:
+ * a grab of the next presented frame for the thumbnail (the host's
+ * thumb_grab), and on a worker thread the file written -- compression on
+ * more workers, .tmp, flush, .bak, rename -- and the PNG beside it; then
+ * "Saved slot 3 (14:32)", or the reason it failed. While a file is being
+ * written every other stop waits (ss_add_check, SS_REASON_WRITING), so the
+ * image in the staging buffer stays as captured.
+ * LOAD: on a worker thread the file is read, checked against this build (ss_
+ * file_check_compat_ex: another game / EBOOT, a section's layout, a section
+ * missing, the SPU table; another build only with build_check = 1) and
+ * decompressed into RAM while the game plays on ("Loading slot 3..."); then,
+ * for a load from the menu or a key with backup_before_load = 1, THE UNDO
+ * POINT: the game as it is now saved (a SAVE request, a pause like F5's) and
+ * written to <dir>\undo.p3ss, the previous one kept as undo.p3ss.bak until the
+ * load is done (ss_slots_undo_settle: dropped after a load, put back after a
+ * refusal) -- a game that cannot be saved now is loaded over all the same,
+ * and the log says so; then a LOAD request with the image read (the M4c in-
+ * process load: everything else is checked before its stop too --
+ * continuations, resumable waits, files changed on disk; a refusal there
+ * leaves the game running), then "Loaded slot 3". "Undo last load" is a load
+ * of the undo point (SS_UI_UNDO), with its own undo point first: two undos
+ * swap the moments.
+ * THE BUILD POLICY (engine design 5.4, M7b): every place that checks a slot
+ * -- the menu's labels and greying, F9 and the slot keys (ss_ui's request
+ * reads the label), the load itself, SS_LOAD at launch -- uses this build's
+ * identity (ss_slots_identity) with ss_file_check_compat_ex: a state of
+ * another build of the same EBOOT loads when its data agrees, tagged "(older
+ * build)" (or newer) in the menu and with a longer notice after its load;
+ * savestates.ini build_check = 1 refuses it. A state another build made that
+ * this one cannot resume (the LOAD's continuation / resumer check) is marked
+ * so in the menu until the file changes ("another build: cannot resume it").
+ * AVAILABILITY (the menu greys, a hotkey says why): not before the game's
+ * first frame, not while another save or load is in progress, not with save
+ * states off (SAVESTATES=0, savestates.ini enabled = 0); an empty or
+ * incompatible slot cannot be loaded (its menu item says why).
+ * THE MENU'S LABELS come from each file's 4 KB header (ss_slots_read_info,
+ * ss_ui's slot reader), cached by the file's size and time.
+ *
+ * SWITCHES
+ *   SS_LOAD=<slot number | q | path>   load that state as soon as the game
+ *                         has presented its first frame (an in-process load at
+ *                         the title): "[ss] loaded <file> at t=... (boot to
+ *                         gameplay N s)". The file is read and checked while
+ *                         the game boots. Retried while the game cannot stop
+ *                         (SS_LOAD_GIVE_UP_S, default 60 s)
+ *   SS_SAVE_SLOT=<n | q>  every SS_SAVE_AT capture is written to this slot
+ *   SS_THREADS=<n>        compression / decompression workers
+ *   savestates.ini        enabled, dir, slots, compression, thumbnail,
+ *                         give_up_s, build_check, backup_before_load
+ *                         (config\savestates.ini documents them)
+ */
+#ifndef PS3RECOMP_SS_SLOTS_H
+#define PS3RECOMP_SS_SLOTS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "ss_ui.h"
+#include "ss_file.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The backend's grab of the next presented frame for a thumbnail: arm it and
+ * return 1; later (on the frame-clock thread) cb gets the frame box-
+ * downscaled to max_w wide at its aspect, RGBA rows. 0: no frame to grab. */
+typedef void (*ss_thumb_cb)(const uint8_t* rgba, int w, int h, int stride, void* user);
+typedef int  (*ss_thumb_grab_fn)(int max_w, ss_thumb_cb cb, void* user);
+/* PNG of RGBA pixels into malloc'd bytes (the host's WIC writer). 1 = ok. */
+typedef int  (*ss_png_fn)(const uint8_t* rgba, int w, int h, int stride, void** png, size_t* n);
+
+/* What the port provides (main.cpp). Any member may be NULL / empty. */
+typedef struct ss_slots_host {
+    const char*      title_id;           /* "BCUS98125" (the folder's name too) */
+    const char*      disc_ver;           /* "01.04" */
+    const char*      eboot_path;         /* the EBOOT this build runs: its SHA-1 is checked */
+    const char*      build_text;         /* with the exe's link stamp: the build id */
+    uint64_t       (*cont_hash)(void);   /* the continuation table's (informational) */
+    uint64_t       (*spu_table)(void);   /* the SPU image table's (checked) */
+    /* the moment's description for the menu: mission text and game mode
+     * (P3SS_MODE_*); called on the frame-clock thread right after a capture */
+    void           (*describe)(char* mission, size_t n, uint32_t* game_mode);
+    /* the display configuration in force (informational in the header) */
+    void           (*display)(double* aspect, uint8_t* hud, uint8_t* lod, uint8_t* fmv);
+    ss_thumb_grab_fn thumb_grab;
+    ss_png_fn        png_encode;
+    double           guest_time_scale;
+} ss_slots_host;
+
+/* Register the slots with the window menu (ss_ui_set_engine / _set_slot_
+ * reader / _set_availability / _set_dir), the SS_SAVE_AT sink, the writer's
+ * eligibility check, and start SS_LOAD's read. main.cpp, once the game's
+ * folder is the working directory, after ss_init. Idempotent. With save
+ * states off the menu greys Save and Load with that reason. */
+void ss_slots_init(const ss_slots_host* host);
+
+/* <dir>\slot03.p3ss ("quick.p3ss" for slot 0, "undo.p3ss" for SS_UI_UNDO);
+ * ext replaces ".p3ss" (".png"). 1 = it fits. */
+int  ss_slots_path(int slot, const char* ext, char* buf, size_t n);
+/* The undo point's two steps (the load job; also for tests). _write: a
+ * sealed image into <dir>\undo.p3ss, the one there kept as undo.p3ss.bak
+ * (0, or an SS_E_* with why). _settle, once the load it was taken for is
+ * done: loaded -- the .bak is dropped (undo.p3ss is the moment before that
+ * load); not loaded -- the .bak becomes undo.p3ss again (none: undo.p3ss is
+ * removed), so a refused load leaves "Undo last load" as it was. */
+int  ss_slots_undo_write(const ss_image* img, const ss_file_meta* meta, ss_file_stats* st, char* why, size_t why_n);
+void ss_slots_undo_settle(int loaded);
+/* A save being written or a load being read (or the launch load pending). */
+int  ss_slots_busy(void);
+/* Quitting: wait (up to max_ms) for a slot file being written to be on disk,
+ * without its thumbnail if that has not come yet. The frame-clock thread
+ * (main.cpp's exit path). 1 = nothing left being written. */
+int  ss_slots_wait_written(unsigned max_ms);
+/* What a write cut short left in the folder: a complete slot03.p3ss.tmp whose
+ * slot03.p3ss is missing becomes it; other .tmp files older than two minutes
+ * are removed. ss_slots_init runs it (also for tests). Returns how many. */
+int  ss_slots_sweep(void);
+/* ss_ui's slot reader (also for tests): the header, the compatibility
+ * checks, the label's note ("3. Forward Momentum - 1:02:13"). */
+int  ss_slots_read_info(int slot, ss_slot_info* info, void* user);
+/* What files are checked against (filled at init; the SHA-1 is computed once,
+ * on a thread). Returns 1, or 0 when the SHA-1 was not ready within 5 s: `out`
+ * then has none (have_sha1 0) and a verdict made with it is not to be kept. */
+int  ss_slots_identity(ss_file_identity* out);
+/* Called when SS_LOAD's launch load is done (ok) or given up (ok 0, why):
+ * the checkpoint harness's READY / fail. Any thread. */
+void ss_slots_set_launch_hook(void (*fn)(int ok, const char* what));
+/* "1:02:13" / "42:10" from milliseconds. */
+void ss_slots_fmt_play(uint64_t ms, char* buf, size_t n);
+
+#ifdef __cplusplus
+}
+#endif
