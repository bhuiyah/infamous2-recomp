+static void test_decoded_control1(void)
+{
+    CHECK_EQ(rsx_texture_decoded_control1(0u, FMT_A8R8G8B8), 0xAAE4u);
+    CHECK_EQ(rsx_texture_decoded_control1(0xAA1Bu, FMT_A8R8G8B8), 0xAA1Bu);
+    CHECK_EQ(rsx_texture_decoded_control1(0xAAE4u, FMT_X16), 0xAA66u);
+    CHECK_EQ(rsx_texture_decoded_control1(0x1AAE4u, FMT_X16 | FMT_LN), 0x1AA56u);   /* ORDER XXXY */
+    CHECK_EQ(rsx_texture_decoded_control1(0xAA4Eu, FMT_HILO8), 0xAA99u);
+    CHECK_EQ(rsx_texture_decoded_control1(0x1AA4Eu, FMT_HILO_S8), 0x1AAA9u);
+    CHECK_EQ(rsx_texture_decoded_control1(0xAAEEu, FMT_Y16X16), 0xAAAAu);
+    CHECK_EQ(rsx_texture_decoded_control1(0x1AAEEu, FMT_Y16X16), 0x1AAAAu);  /* no order variant */
+    CHECK_EQ(rsx_texture_decoded_control1(0xAA44u, FMT_X16), 0xAA55u);
+    CHECK_EQ(rsx_texture_decoded_control1(0xAA1Bu, FMT_X16), 0xAA1Bu);      /* not a valid one: as is */
+    CHECK_EQ(rsx_texture_decoded_control1(0xAA1Bu, FMT_W16F), 0xAAE4u);     /* float: no crossbar */
+    CHECK_EQ(rsx_texture_decoded_control1(0x55C6u, FMT_X32F), 0x55E4u);     /* ops still apply */
+    CHECK_EQ(rsx_texture_decoded_control1(0xAA1Bu, FMT_Y16X16F), 0xAA66u);
+    CHECK_EQ(rsx_texture_decoded_control1(0x1AA1Bu, FMT_Y16X16F), 0x1AA56u);
+    CHECK_EQ(rsx_texture_decoded_control1(0xAAEEu, FMT_G8B8), 0xAAEEu);     /* 8-bit: no rewrite */
+}
