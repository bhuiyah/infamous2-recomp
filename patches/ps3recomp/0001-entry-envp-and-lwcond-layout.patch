+# Declarations the continuation file needs on top of the normal chunk
+# preamble. ppu_cont_entry must stay layout-identical to the runtime's copy in
+# runtime/ppu/ppu_resume.h (the generated header defines its own ppu_context,
+# so the file cannot include the runtime one); ppu_cont_register refuses a
+# table whose ABI number or entry size differs.
+CONT_PREAMBLE = """\
+/* --cont-list: save-state continuations (runtime/ppu/ppu_resume.cpp).
+ * contf_<F>(ctx, ra) is lifted function F again, entered at the return
+ * address ra of one of its calls, its epilogue restoring r14-r31 and LR from
+ * the guest frame; cont_<RA>(ctx) enters it at one return address. The table
+ * at the end gives, per return address, the continuation, the call that
+ * precedes it, and how the continuation leaves its frame (the exit model the
+ * runtime validates a parked thread's guest stack against before resuming). */
+#define PPU_CONT_ABI 1
+typedef struct ppu_cont_entry {
+    uint32_t ra;          /* guest return address */
+    uint32_t owner;       /* guest start of the lifted function it is cloned from */
+    void   (*fn)(struct ppu_context* ctx);
+    uint32_t callee;      /* call_kind 1/4: the branch target at ra-4 */
+    int32_t  r1_off;      /* exit: r1 = (r1 at ra | back chain at r1) + r1_off */
+    int32_t  lr_off;      /* exit: LR = mem[(r1 at ra | back chain) + lr_off] */
+    uint8_t  call_kind;   /* 1 bl, 2 indirect, 3 sc, 4 bcl */
+    uint8_t  exit_kind;   /* 0 unknown, 1 returns (model valid), 2 never returns */
+    uint8_t  exit_flags;  /* 1 r1 from back chain, 2 LR slot off the back chain,
+                           * 4 32-bit LR slot, 8 partial (some paths unanalysed) */
+    uint8_t  reserved;
+} ppu_cont_entry;
+#ifdef __cplusplus
+extern "C" {
+#endif
+int  ppu_cont_register(const ppu_cont_entry* table, uint32_t count, uint32_t entry_size,
+                       uint32_t abi, const char* image);
+void ppu_cont_bad_entry(ppu_context* ctx, uint32_t owner, uint32_t ra);
+#ifdef __cplusplus
+}
+#endif
+"""
