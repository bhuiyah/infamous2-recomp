+/* Conversions. int -> float through exact doubles: the scaled value is
+ * truncated to 24 significant bits in the double (low 29 fraction bits
+ * cleared), so the conversion to float is exact in any rounding mode; below
+ * 2^-126 is +0. |x| >= 2^128 (only for i8 > 251) goes to the reference. */
+SPU_FORCEINLINE __m128i spu__d2fx_pd(__m128d lo, __m128d hi, __m128i* bad) {
+    const __m128d keep = _mm_castsi128_pd(_mm_set_epi32(-1, (int)0xE0000000u, -1, (int)0xE0000000u));
+    const __m128d absm = _mm_castsi128_pd(_mm_set_epi32(0x7FFFFFFF, -1, 0x7FFFFFFF, -1));
+    const __m128d tiny = _mm_set1_pd(0x1p-126), huge = _mm_set1_pd(0x1p128);
+    lo = _mm_and_pd(lo, keep); hi = _mm_and_pd(hi, keep);
+    const __m128d alo = _mm_and_pd(lo, absm), ahi = _mm_and_pd(hi, absm);
+    *bad = _mm_or_si128(*bad, _mm_castpd_si128(_mm_or_pd(_mm_cmpge_pd(alo, huge), _mm_cmpge_pd(ahi, huge))));
+    lo = _mm_andnot_pd(_mm_cmplt_pd(alo, tiny), lo);
+    hi = _mm_andnot_pd(_mm_cmplt_pd(ahi, tiny), hi);
+    return spu__i(_mm_movelh_ps(_mm_cvtpd_ps(lo), _mm_cvtpd_ps(hi)));
+}
+SPU__SLOWI(spu_csflt)
+SPU__SLOWI(spu_cuflt)
+SPU__SLOWI(spu_cflts)
+SPU__SLOWI(spu_cfltu)
+SPU_FORCEINLINE int spu__nonzero(__m128i m) {
+#  if defined(__SSE4_1__)
+    return !_mm_testz_si128(m, m);
+#  else
+    return _mm_movemask_epi8(_mm_cmpeq_epi32(m, _mm_setzero_si128())) != 0xFFFF;
+#  endif
+}
+SPU_FORCEINLINE __m128 spu__p2f(int k) { return spu__f(spu__k((uint32_t)(k + 127) << 23)); }  /* 2^k, k in [-126,127] */
+/* The scale is an immediate, so the i8 tests below fold away. With
+ * 2^(i8-155) >= 2^-126 no nonzero result can flush, and an integer below 2^24
+ * in magnitude converts exactly: one cvtdq2ps and one exact multiply. Other
+ * lanes take the double path. */
+#  if defined(__AVX2__)
+/* An unsigned 32-bit integer truncated to 24 significant bits, as float bits:
+ * v >> d, d = max(msb(v) - 23, 0), is below 2^24 and converts exactly; its
+ * exponent field then gets + d. msb(v) comes from the exact conversion of
+ * v >> 8 (exponent field 119 + msb, or 0 when v < 256), so d is that field
+ * minus 142, saturated at 0 (psubusw: the field sits in the low halfword).
+ * v == 0 gives +0. No rounding anywhere: the same bits in every MXCSR mode.
+ * With 29 <= i8 <= 250 every nonzero |v| * 2^(i8-155) is a normal float
+ * (1 <= |v| <= 2^32), so the scaling is exact too: the reference's result
+ * without its double-precision detour, for every input. */
+SPU_FORCEINLINE __m128i spu__u2f_trunc(__m128i V) {
+    const __m128i eh = _mm_srli_epi32(spu__i(_mm_cvtepi32_ps(_mm_srli_epi32(V, 8))), 23);
+    const __m128i d = _mm_subs_epu16(eh, spu__k(142u));
+    return _mm_add_epi32(spu__i(_mm_cvtepi32_ps(_mm_srlv_epi32(V, d))), _mm_slli_epi32(d, 23));
+}
+#  endif
+/* x86-64-v4 with SPU_HELPERS_FP_RZDAZ: MXCSR rounds toward zero, so
+ * cvtdq2ps / vcvtudq2ps (AVX-512) of v already IS v truncated to 24 significant
+ * bits, sign kept -- for 29 <= i8 <= 250 the reference's result (|v| *
+ * 2^(i8-155) is then exact and normal, and v == 0 gives +0) in one
+ * instruction. The operand is opaque: a compile-time conversion of a constant
+ * would round to nearest. */
+SPU_FORCEINLINE u128 spu_csflt(u128 a, int i8) {
+    const __m128i A = spu__v(a);
+    __m128i r;
+#  if SPU__AVX512 && defined(SPU_HELPERS_FP_RZDAZ)
+    if (i8 >= 29 && i8 <= 250) {
+        __m128i X = A; SPU__RZ_OPAQUE(X);
+        return spu__u(spu__i(_mm_mul_ps(_mm_cvtepi32_ps(X), spu__p2f(i8 - 155))));
+    }
+#  elif defined(__AVX2__)
+    if (i8 >= 29 && i8 <= 250)
+        return spu__u(spu__i(_mm_mul_ps(spu__f(_mm_or_si128(spu__u2f_trunc(_mm_abs_epi32(A)), _mm_and_si128(A, spu__k(0x80000000u)))),
+                                        spu__p2f(i8 - 155))));
+#  endif
+    if (i8 >= 29 && !spu__nonzero(_mm_srli_epi32(_mm_add_epi32(A, spu__k(0x01000000u)), 25)))   /* -2^24 <= v < 2^24 */
+        r = spu__i(_mm_mul_ps(_mm_cvtepi32_ps(A), spu__p2f(i8 - 155)));
+    else {
+        const __m128d f = _mm_set1_pd(spu__p2(i8 - 155));
+        __m128i bad = _mm_setzero_si128();
+        r = spu__d2fx_pd(_mm_mul_pd(_mm_cvtepi32_pd(A), f),
+                         _mm_mul_pd(_mm_cvtepi32_pd(_mm_unpackhi_epi64(A, A)), f), &bad);
+        if (SPU_HLP_UNLIKELY(spu__any(bad))) r = spu_csflt_slow(A, i8);
+    }
+    return spu__u(r);
+}
+SPU_FORCEINLINE u128 spu_cuflt(u128 a, int i8) {
+    const __m128i U = spu__v(a);
+    __m128i r;
+#  if SPU__AVX512 && defined(SPU_HELPERS_FP_RZDAZ)
+    if (i8 >= 29 && i8 <= 250) {
+        __m128i X = U; SPU__RZ_OPAQUE(X);
+        return spu__u(spu__i(_mm_mul_ps(_mm_cvtepu32_ps(X), spu__p2f(i8 - 155))));
+    }
+#  elif defined(__AVX2__)
+    if (i8 >= 29 && i8 <= 250)
+        return spu__u(spu__i(_mm_mul_ps(spu__f(spu__u2f_trunc(U)), spu__p2f(i8 - 155))));
+#  endif
+    if (i8 >= 29 && !spu__nonzero(_mm_srli_epi32(U, 24)))                                       /* v < 2^24 */
+        r = spu__i(_mm_mul_ps(_mm_cvtepi32_ps(U), spu__p2f(i8 - 155)));
+    else {
+        const __m128i A = _mm_xor_si128(U, spu__k(0x80000000u));   /* v - 2^31 as int32 */
+        const __m128d f = _mm_set1_pd(spu__p2(i8 - 155)), b31 = _mm_set1_pd(2147483648.0);
+        __m128i bad = _mm_setzero_si128();
+        r = spu__d2fx_pd(_mm_mul_pd(_mm_add_pd(_mm_cvtepi32_pd(A), b31), f),
+                         _mm_mul_pd(_mm_add_pd(_mm_cvtepi32_pd(_mm_unpackhi_epi64(A, A)), b31), f), &bad);
+        if (SPU_HLP_UNLIKELY(spu__any(bad))) r = spu_cuflt_slow(U, i8);
+    }
+    return spu__u(r);
+}
+/* float -> int: exponent-255 lanes go to the reference; denormals are +0.
+ * With the scale 2^(173-i8) a float, x*scale is exact wherever it matters:
+ * a normal product is exact, a product that flushes or goes denormal is below
+ * 1 (truncates to 0 either way), and one that overflows saturates either way.
+ * cvttps2dq truncates in any rounding mode. Scales outside float range use
+ * exact doubles. */
+SPU_FORCEINLINE __m128 spu__cflt_x(__m128i A, int* sp, int i8) {  /* operand with denormals -> +0 */
+    const __m128i m = _mm_and_si128(A, spu__k(0x7FFFFFFFu));
+    *sp = spu__any(_mm_cmpgt_epi32(m, spu__k(0x7F7FFFFFu)));
+#  if defined(SPU_HELPERS_FP_RZDAZ)
+    /* DAZ: the multiply below reads a denormal as zero -- at run time; a
+     * compile-time fold of a constant operand would not. That only matters
+     * with a scale of 2^127 or more (i8 <= 46: a denormal times anything
+     * smaller is below 1 and truncates to 0 either way), so the common
+     * scales (i8 = 173: 1.0) keep their folds. */
+    __m128 x = spu__f(A);
+    if (173 - i8 >= 127) SPU__RZ_OPAQUE(x);
+    return x;
+#  else
+    (void)i8;
+    return spu__f(_mm_andnot_si128(_mm_cmplt_epi32(m, spu__k(0x00800000u)), A));
+#  endif
+}
+/* the conversion of x = spu__cflt_x(a): exact unless a lane of a is exponent 255 */
+SPU_FORCEINLINE __m128i spu__cflts_x(__m128 x, int i8) {
+    __m128i r;
+    if (173 - i8 >= -126 && 173 - i8 <= 127) {
+        const __m128 y = _mm_mul_ps(x, spu__p2f(173 - i8));
+        /* cvtt gives 0x80000000 out of range: right below -2^31, flipped to 0x7FFFFFFF above */
+        r = _mm_xor_si128(_mm_cvttps_epi32(y), spu__i(_mm_cmpge_ps(y, _mm_set1_ps(2147483648.0f))));
+    } else {
+        const __m128d f = _mm_set1_pd(spu__p2(173 - i8));
+        const __m128d mx = _mm_set1_pd(2147483647.0), mn = _mm_set1_pd(-2147483648.0);
+        const __m128d lo = _mm_max_pd(_mm_min_pd(_mm_mul_pd(_mm_cvtps_pd(x), f), mx), mn);
+        const __m128d hi = _mm_max_pd(_mm_min_pd(_mm_mul_pd(_mm_cvtps_pd(_mm_movehl_ps(x, x)), f), mx), mn);
+        r = _mm_unpacklo_epi64(_mm_cvttpd_epi32(lo), _mm_cvttpd_epi32(hi));
+    }
+    return r;
+}
+SPU_FORCEINLINE u128 spu_cflts(u128 a, int i8) {
+    int sp;
+    const __m128 x = spu__cflt_x(spu__v(a), &sp, i8);
+    __m128i r = spu__cflts_x(x, i8);
+    if (SPU_HLP_UNLIKELY(sp)) r = spu_cflts_slow(spu__v(a), i8);
+    return spu__u(r);
+}
+SPU_FORCEINLINE __m128i spu__cfltu_x(__m128 x, int i8) {
+    __m128i r;
+    if (173 - i8 >= -126 && 173 - i8 <= 127) {
+        const __m128 y = _mm_max_ps(_mm_mul_ps(x, spu__p2f(173 - i8)), _mm_setzero_ps());   /* negative -> 0 */
+#  if SPU__AVX512
+        r = _mm_cvttps_epu32(y);   /* vcvttps2udq truncates; y >= 2^32 gives 0xFFFFFFFF: the saturation */
+#  else
+        const __m128 b31 = _mm_set1_ps(2147483648.0f);
+        const __m128i lo = _mm_cvttps_epi32(y);                                   /* y < 2^31 */
+        const __m128i hi = _mm_xor_si128(_mm_cvttps_epi32(_mm_sub_ps(y, b31)), spu__k(0x80000000u)); /* 2^31 <= y < 2^32: exact */
+        r = spu__blend(spu__i(_mm_cmpge_ps(y, b31)), hi, lo);
+        r = _mm_or_si128(r, spu__i(_mm_cmpge_ps(y, _mm_set1_ps(4294967296.0f))));   /* saturate */
+#  endif
+    } else {
+        const __m128d f = _mm_set1_pd(spu__p2(173 - i8));
+        const __m128d mx = _mm_set1_pd(4294967295.0), z = _mm_setzero_pd(), b31 = _mm_set1_pd(2147483648.0);
+        const __m128d lo = _mm_min_pd(_mm_max_pd(_mm_mul_pd(_mm_cvtps_pd(x), f), z), mx);
+        const __m128d hi = _mm_min_pd(_mm_max_pd(_mm_mul_pd(_mm_cvtps_pd(_mm_movehl_ps(x, x)), f), z), mx);
+        const __m128i small = _mm_unpacklo_epi64(_mm_cvttpd_epi32(lo), _mm_cvttpd_epi32(hi));
+        const __m128i big = _mm_xor_si128(_mm_unpacklo_epi64(_mm_cvttpd_epi32(_mm_sub_pd(lo, b31)),
+                                                             _mm_cvttpd_epi32(_mm_sub_pd(hi, b31))), spu__k(0x80000000u));
+        const __m128 ge = _mm_shuffle_ps(_mm_castpd_ps(_mm_cmpge_pd(lo, b31)), _mm_castpd_ps(_mm_cmpge_pd(hi, b31)), _MM_SHUFFLE(2, 0, 2, 0));
+        r = spu__blend(spu__i(ge), big, small);
+    }
