+    if (wr) wr->phase = LWC_WAIT_NONE;
+    ctx->gpr[3] = (uint64_t)(int64_t)rc_out;
+}
+static void ss_resume_lwcond(ppu_context* ctx, uint32_t obj, const ss_wait_rec* rec)
+{
+    ss_resume_lwcond_common(ctx, obj, rec, 1);
