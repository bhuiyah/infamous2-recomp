+static volatile long s_mix_live;
+static struct { volatile long state, gen; int fill, cap; uint64_t t_park_us; } s_mix;
+
+void ss_mixer_present(int on) { InterlockedExchange(&s_mix_live, on ? 1 : 0); }
+
+void ss_mixer_park_point(int fill, int cap)
+{
+    if (!g_ss_mix_req) return;
