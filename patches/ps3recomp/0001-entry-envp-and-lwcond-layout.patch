+u32 rsx_fp_bx2_channel_mask(u32 format, u32 remap, u32 filter)
+{
+    switch (format & ~0x60u) {   /* CELL_GCM_TEXTURE_LN / _UN */
+    case 0x81: case 0x82: case 0x83: case 0x84: case 0x85: case 0x86: case 0x87: case 0x88:
+    case 0x8B: case 0x8D: case 0x8E: case 0x8F:
+    case 0x90: case 0x91: case 0x92: case 0x93: case 0x94: case 0x95:
+    case 0x97: case 0x98: case 0x9D: case 0x9E:
+        break;                   /* RSX_FORMAT_FEATURE_BIASED_NORMALIZATION */
+    default:
+        return 0;                /* float formats, HILO_S8, unknown */
+    }
+    u32 c1 = remap & 0xFFFFu;
+    if (!c1) c1 = 0xAAE4u;
+    u32 live = 0;                /* R,G,B,A; remap ops are listed A,R,G,B */
+    for (u32 i = 0; i < 4u; i++)
+        if (((c1 >> (8u + i * 2u)) & 3u) >= 2u) live |= (i == 0u) ? 8u : (1u << (i - 1u));
+    const u32 sa = (filter >> 28) & 0xFu;                 /* A,R,G,B */
+    const u32 sg = ((sa >> 1) & 1u) | (((sa >> 2) & 1u) << 1) | (((sa >> 3) & 1u) << 2) |
+                   ((sa & 1u) << 3);
+    return live & ~sg & 0xFu;
+}
