+          tp_rep* rp = &gr[i]; tp_push((void**)&s_tp.live, &s_tp.nlive, &s_tp.caplive, &rp, sizeof rp);
+          s_tp.vram_used += gr[i].bytes; }
+      tp_evict(0); CHECK(gr[0].res && gr[1].res && gr[2].res && s_tp.nlive == 3);   /* views to spare: none go */
+      s_tp.ndesc_free = TP_DESC_LOW - 1;                        /* the rest taken by other replacements */
+      { tp_rep v; memset(&v, 0, sizeof v); v.e = &ge[0]; v.desc = -1; v.res = gr[2].res;
+        const int nf = s_tp.ndesc_free; s_tp.ndesc_free = 0;      /* none left: the original, said once */
+        CHECK(tp_rt_rep_view(&v, D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING, 0, 1) == 0 && v.desc == -1);
+        s_tp.ndesc_free = nf; }
+      tp_evict(0);
+      CHECK(gr[0].res == NULL && gr[1].res == NULL && gr[2].res && s_tp.nlive == 1 && s_tp.ndesc_free == TP_DESC_LOW + 1);
+      tp_rep_drop(&gr[2]);
+      for (int i = 0; i < s_tp.nrel; i++) s_tp.rel[i].dval = 0, s_tp.rel[i].cval = 0;
+      tp_release_drain(); CHECK(s_tp.nrel == 0 && s_tp.nlive == 0);
+      memcpy(s_tp.desc_free, keep_free, sizeof keep_free); s_tp.ndesc_free = keep_n; s_tp.vram_budget = b0; }
+
+    /* F. TEXPACK_VERIFY against a synthetic guest DXT1 64x64 with 7 levels */
+    { static uint8_t guest[0x10000]; vm_base = guest;
+      const uint32_t off = 0x100;
+      const tp_desc gd = { 0x86u /* DXT1, swizzle bit clear: packed */, 64, 64, 7, 0, 0 };
+      tp_layout GL; CHECK(tp_layout_of(&gd, &GL) == 0 && GL.contiguous);
+      fill(guest + off, (size_t)GL.guest_span);
+      /* identity DDS: header + the blocks of every level */
+      uint8_t* f = (uint8_t*)malloc(148 + (size_t)GL.guest_span); size_t at = tp_dds_header(f, TP_DXGI_BC1_UNORM, 64, 64, 7, 0);
+      memcpy(f + at, guest + off, (size_t)GL.guest_span); at += (size_t)GL.guest_span;
+      wchar_t pf[700]; swprintf(pf, 700, L"%ls\\f.dds", dir); CHECK(write_file(pf, f, at) == 0); free(f);
+      tp_req qf; memset(&qf, 0, sizeof qf); qf.path = pf; qf.kind = TP_KIND_DDS; qf.cls = TP_CLS_BC1; qf.ow = 64; qf.oh = 64;
+      qf.d = gd; qf.off = off;
+      const LONG s0 = s_tp_ver_same, d0 = s_tp_ver_diff;
+      tp_res rf; tp_load(&C, &qf, &rf);
+      CHECK(rf.ok && s_tp_ver_same == s0 + 1 && s_tp_ver_diff == d0);
+      if (rf.ok) { tp_wait_fence(s_tp.cfence, rf.cval, C.ev, "test"); rf.res->lpVtbl->Release(rf.res); }
+      guest[off + GL.lv[3].offset + 2] ^= 0x10u;               /* one byte of level 3 */
+      tp_load(&C, &qf, &rf);
+      CHECK(rf.ok && s_tp_ver_same == s0 + 1 && s_tp_ver_diff == d0 + 1);
+      if (rf.ok) { tp_wait_fence(s_tp.cfence, rf.cval, C.ev, "test"); rf.res->lpVtbl->Release(rf.res); }
+      /* PNG of level 0's CPU decode (as the dump writes it): identical at level 0 */
+      uint8_t* rgba = (uint8_t*)malloc(64 * 64 * 4); tp_bc_decode(rgba, 64 * 4, guest + off, 64, 64, 1);
+      for (int i = 0; i < 64 * 64; i++) { const uint8_t t = rgba[i * 4]; rgba[i * 4] = rgba[i * 4 + 2]; rgba[i * 4 + 2] = t; }
+      size_t pn = 0; uint8_t* png = tp_png_encode(&GUID_WICPixelFormat32bppBGRA, 64, 64, 64 * 4, rgba, &pn); free(rgba);
+      wchar_t pp[700]; swprintf(pp, 700, L"%ls\\f.png", dir); CHECK(png && write_file(pp, png, pn) == 0); free(png);
+      tp_req qp = qf; qp.path = pp; qp.kind = TP_KIND_PNG;
+      tp_load(&C, &qp, &rf);
+      CHECK(rf.ok && s_tp_ver_same == s0 + 2 && s_tp_ver_diff == d0 + 1);
+      if (rf.ok) { tp_wait_fence(s_tp.cfence, rf.cval, C.ev, "test"); rf.res->lpVtbl->Release(rf.res); }
+      vm_base = NULL; }
+
+    /* H. slot -> index -> loader -> bind */
+    { static uint8_t g2[0x40000]; vm_base = g2; g_tp_on = 1;
+      const uint32_t oA = 0x1000, oB = 0x9000, oU = 0x11000, oN = 0x19000, oR = 0x21000;
+      const tp_desc dA = { 0x86u, 64, 64, 7, 0, 0 };
+      tp_layout LA; tp_layout_of(&dA, &LA);
+      fill(g2 + oA, (size_t)LA.guest_span);
+      memcpy(g2 + oB, g2 + oA, (size_t)LA.guest_span); g2[oB + LA.lv[4].offset] ^= 0x5Au;   /* other mip tail */
+      memset(g2 + oU, 0, (size_t)LA.guest_span);                                          /* one colour */
+      memcpy(g2 + oN, g2 + oA, (size_t)LA.guest_span);                                    /* the UN binding */
+      memcpy(g2 + oR, g2 + oA, (size_t)LA.guest_span);                                    /* RSX-written */
+      uint64_t hA = 0, h0A = 0, hB = 0, h0B = 0;
+      tp_hashes(&LA, g2 + oA, &hA, &h0A); tp_hashes(&LA, g2 + oB, &hB, &h0B);
+      CHECK(hA != hB && h0A == h0B);
+      /* the pack: A's identity DDS under A's name (B is not in it: found by level 0), and a file
+       * with the uniform texture's hash but a bad size */
+      uint8_t* f = (uint8_t*)malloc(148 + (size_t)LA.guest_span); size_t at = tp_dds_header(f, TP_DXGI_BC1_UNORM, 64, 64, 7, 0);
+      memcpy(f + at, g2 + oA, (size_t)LA.guest_span); at += (size_t)LA.guest_span;
+      char nm[160]; tp_make_name(nm, sizeof nm, &dA, hA, ".dds");
+      wchar_t pa[700], wn[200]; tp_widen(nm, wn, 200); swprintf(pa, 700, L"%ls\\%ls", dir, wn);
+      CHECK(write_file(pa, f, at) == 0); free(f);
+      uint64_t hU = 0; { tp_layout LU; tp_layout_of(&dA, &LU); tp_hashes(&LU, g2 + oU, &hU, NULL); }
+      tp_srec* recs = (tp_srec*)calloc(2, sizeof *recs);
+      CHECK(tp_parse_name(nm, &recs[0].ni) == 0);
+      recs[0].path = _wcsdup(pa); recs[0].pkey = tp_path_key(pa); recs[0].h0 = h0A; recs[0].prio = 1; recs[0].mtime = 1;
+      recs[0].size = at;
+      { char bn[160]; const tp_desc dbad = { 0x86u, 32, 32, 6, 0, 0 }; tp_make_name(bn, sizeof bn, &dbad, hU, ".png");
+        CHECK(tp_parse_name(bn, &recs[1].ni) == 0); recs[1].path = _wcsdup(L"nowhere\\bad.png"); recs[1].pkey = 77; recs[1].prio = 1; }
+      s_tp.packs = 1; s_tp.dump = 0; s_tp.l0 = 1; s_tp.frame = 5000; s_tp.dead = 0;
+      tp_apply_snapshot(recs, 2);
+      CHECK(s_tp.npack_files == 2 && s_tp.has_h0);
+      /* A: hit, request, load, take, bind */
+      tp_slot sA; memset(&sA, 0, sizeof sA);
+      tp_rt_identify(&sA, 1, &dA, g2 + oA, oA, 0, 0, 100, s_tp.frame, 1);
+      CHECK((sA.flags & TP_F_HASHED) && sA.hash == hA && sA.rep != NULL);
+      const uint32_t fw2d = 0x00020028u | 0x86u;            /* dimension 2, border bit set */
+      tp_rep* rb = tp_rt_bind(&sA, &dA, g2 + oA, oA, fw2d, 100, s_tp.frame);
+      CHECK(rb == NULL && sA.rep && sA.rep->inflight && s_tp.nreq == 1);   /* the original until it is loaded */
+      if (s_tp.nreq == 1) {
+          tp_req q = s_tp.req[--s_tp.nreq]; tp_res rr; tp_load(&C, &q, &rr); free(q.path);
+          CHECK(rr.ok && rr.s == 0 && rr.levels == 7);
+          if (rr.ok) tp_wait_fence(s_tp.cfence, rr.cval, C.ev, "test");
