+static void test_axis_normalisation(void)
+{
+    PadHostDevice d;
+    PadHostPortState st;
+    desc_reset();
+    add_value(GEN_PAGE_GD, 0x30, 0, 16, -32768, 32767, 0, 0);   /* signed */
+    add_value(GEN_PAGE_GD, 0x31, 0, 16, 0, -1, 0, 0);           /* 0xFFFF written without its sign byte */
+    add_value(GEN_PAGE_GD, 0x32, 0, 8, 1, 255, 1, 0);           /* null state at 0 */
+    add_value(GEN_PAGE_GD, 0x35, 0, 12, 0, 4095, 0, 0);
+    add_value(GEN_PAGE_GD, 0x39, 0, 4, 0, 3, 1, 0);             /* 4-position hat */
+    add_buttons(GEN_PAGE_BUTTON, 1, 4, 0);
+    dev_init(&d, 1, 2);
+    CHECK_EQ(padhost_drv_generic.open(&d), 0);
+    memset(&st, 0, sizeof st);
+    set_raw(GEN_PAGE_GD, 0x30, 0x8000);         /* -32768 */
+    set_raw(GEN_PAGE_GD, 0x31, 0xFFFF);
+    set_raw(GEN_PAGE_GD, 0x32, 0);              /* null */
+    set_raw(GEN_PAGE_GD, 0x35, 2047);
+    set_raw(GEN_PAGE_GD, 0x39, 1);              /* east */
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 0); CHECK_EQ(st.ly, 255); CHECK_EQ(st.rx, 128); CHECK_EQ(st.ry, 128);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_RIGHT);
+    set_raw(GEN_PAGE_GD, 0x30, 0x7FFF);
+    set_raw(GEN_PAGE_GD, 0x31, 0x8000);
+    set_raw(GEN_PAGE_GD, 0x32, 255);
+    set_raw(GEN_PAGE_GD, 0x35, 0);
+    set_raw(GEN_PAGE_GD, 0x39, 2);              /* south */
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 255); CHECK_EQ(st.ly, 128); CHECK_EQ(st.rx, 255); CHECK_EQ(st.ry, 0);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_DOWN);
+    set_raw(GEN_PAGE_GD, 0x30, 0xFFFF);         /* -1: centred */
+    set_raw(GEN_PAGE_GD, 0x32, 1);
+    set_raw(GEN_PAGE_GD, 0x35, 2048);
+    set_raw(GEN_PAGE_GD, 0x39, 15);             /* null */
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 128); CHECK_EQ(st.rx, 0); CHECK_EQ(st.ry, 128);
+    CHECK_EQ(st.buttons, 0);
+
+    /* nine-value hat (0..8, 8 = centred, no null flag) */
+    desc_reset();
+    add_value(GEN_PAGE_GD, 0x30, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x31, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x39, 0, 4, 0, 8, 0, 0);
+    add_buttons(GEN_PAGE_BUTTON, 1, 12, 0);
+    dev_init(&d, 1, 3);
+    padhost_drv_generic.open(&d);
+    set_raw(GEN_PAGE_GD, 0x39, 8);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.buttons & 0xF0, 0);
+    set_raw(GEN_PAGE_GD, 0x39, 6);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.buttons & 0xF0, CELL_PAD_CTRL_LEFT);
+
+    /* helpers directly */
+    GenValue v = { GEN_PAGE_GD, 0x30, 0, 0, 8, 0, -128, 127 };
+    CHECK_EQ(gen_value_from_raw(&v, 0x80), -128);
+    CHECK_EQ(gen_value_from_raw(&v, 0x7F), 127);
+    CHECK_EQ(gen_value_from_raw(&v, 0xFF), -1);
+    CHECK_EQ(gen_n_to_u8(0.0f), 128);
+    CHECK_EQ(gen_n_to_u8(1.0f), 255);
+    CHECK_EQ(gen_n_to_u8(-1.0f), 0);
+    CHECK_EQ(gen_n_to_u8(0.5f), 192);
+    CHECK_EQ(gen_n_to_u8(-0.5f), 64);
+}
