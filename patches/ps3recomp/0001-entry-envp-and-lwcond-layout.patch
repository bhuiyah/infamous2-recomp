+ * what the hardware requires for swizzled textures. */
+
+/* Sparse FNV-1a over a texture's source bytes -- enough to notice an animated
+ * surface changing, cheap enough to run on every bind. Kept a function rather
+ * than a statement-expression macro so the file still compiles under MSVC;
+ * ps3recomp builds with clang-cl, but titles like Tokyo Jungle drive the build
+ * through the Visual Studio generator. */
+static u32 tex_csum(const u8* base, u32 nbytes)
+{
+    u32 h = 2166136261u;
+    u32 step = nbytes > 4096u ? nbytes / 1024u : 4u;
+    for (u32 i = 0; i + 3 < nbytes; i += step) {
+        u32 w32; memcpy(&w32, base + i, sizeof w32);
+        h ^= w32; h *= 16777619u;
+    }
+    return h;
+}
+
+/* ---------------------------------------------------------------------------
+ * Guest texture cache: the bookkeeping behind vp_upload_tex_slot.
+ *
+ *   - Lookup is a hash of (bound offset, w, h, format, cube, cube levels) --
+ *     the component remap is not part of it: that lives in the SRV, and the
+ *     same resource is viewed through whatever remap each draw asks for.
+ *   - A slot bound once in a batch is returned as-is for every later binding
+ *     in that batch (thousands of bindings collapse to the distinct textures).
+ *   - The first binding in a batch validates it: with write watch, "has a
+ *     page under it been written since it was read" (O(1) when nothing under
+ *     any resident texture was written); only then is the content re-hashed
+ *     and, if the bytes really changed, re-uploaded. Without write watch, the
+ *     old sparse checksum per batch.
+ *   - Eviction is least-recently-bound, never a slot this batch has bound
+ *     (its SRVs are already in the per-draw windows), preferring a victim of
+ *     the same shape so its resource is reused instead of re-created.
+ *   - Upload memory is one ring reset every batch (render_frame waits for the
+ *     GPU before the prepass), not a second committed buffer per slot.
+ *   - Per-draw SRVs are copied from views prebuilt in a CPU-only heap.
+ * TEX_WW=0 forces checksum validation; TEX_NOCACHE=1 still re-uploads every
+ * texture once per batch; TEX_FASTHASH=0 brings back the original content
+ * hash (rsx_tex_cache.h); TEX_HASHLOG=<n> names the first n re-hashed
+ * textures (tc_hashlog).
+ * -----------------------------------------------------------------------*/
+/* ---------------------------------------------------------------------------
+ * Guest mip levels. SET_TEXTURE_FORMAT bits 16-31 say how many levels follow
+ * level 0 in guest memory (rsx_texture_mip_chain has the layout); each slot's
+ * resource holds all of them (MipLevels = n), its SRVs view all of them, and
+ * the samplers apply TEXTURE_CONTROL0's min/max LOD and max anisotropy and
+ * TEXTURE_FILTER's LOD bias. Before this every texture was level 0 only, so a
+ * trilinear-filtered surface (most of inFamous 2: filter 0x02062000) was
+ * point-minified out of level 0 and shimmered/aliased into noise at a
+ * distance. Read once:
+ *   TEX_MIPS=0        level 0 only, pitch ignored, samplers as before: the old path
+ *   TEX_MIPS_MAX=<n>  upload at most n levels (1: level 0 only, with the pitch)
+ *   TEX_PITCH=0       ignore SET_TEXTURE_CONTROL3 (LINEAR rows packed at their width)
+ *   TEX_LOD=0         samplers ignore CONTROL0's min/max LOD and the FILTER bias
+ *   TEX_ANISO=0       samplers ignore CONTROL0's max anisotropy
+ *   TEX_MIPTINT=1     diagnostic: levels 1.. painted red, green, blue, yellow,
+ *                     magenta, cyan, white (level 0 untouched; alpha kept)
+ *   TEX_MIPDBG=<n>    a [TEXMIP] line for each of the first n multi-level uploads
+ *   TEX_MIPDUMP=<hex>[:<w>x<h>]
+ *                     every level of the texture bound at that offset (either
+ *                     form, 0x08151A00 or 0xC8151A00) -- only that size when
+ *                     one is given -- as BMPs named ..._u<k>.bmp, the first 16
+ *                     such uploads (an offset is reused by other textures over
+ *                     a session: the size filter keeps them out)
+ * Always on (8 lines at most): "[TEXMIP] LN pitch" names the LINEAR textures
+ * whose rows the CONTROL3 pitch lays out differently from packed -- level 0's
+ * when the pitch is wider than its packed row (the one change to a one-level
+ * texture here), the lower levels' whenever there are any. TEX_PITCH=0 reads
+ * them all packed, as before.
+ * -----------------------------------------------------------------------*/
+typedef struct { int init, on, maxlv, pitch, lod, aniso, tint, dbg; u32 dump, dump_w, dump_h; } tc_mipcfg_t;
+static tc_mipcfg_t s_tcm;
+static int tc_env_int(const char* name, int dflt)
+{
+    const char* e = getenv(name);
+    return (e && *e) ? atoi(e) : dflt;
+}
+static const tc_mipcfg_t* tc_mipcfg(void)
+{
+    if (s_tcm.init) return &s_tcm;
+    s_tcm.on    = tc_env_int("TEX_MIPS", 1) != 0;
+    s_tcm.maxlv = tc_env_int("TEX_MIPS_MAX", 0);
+    if (s_tcm.maxlv < 0) s_tcm.maxlv = 0;
+    s_tcm.pitch = tc_env_int("TEX_PITCH", 1) != 0;
+    s_tcm.lod   = tc_env_int("TEX_LOD", 1) != 0;
+    s_tcm.aniso = tc_env_int("TEX_ANISO", 1) != 0;
+    s_tcm.tint  = tc_env_int("TEX_MIPTINT", 0) != 0;
+    s_tcm.dbg   = tc_env_int("TEX_MIPDBG", 0);
+    { const char* e = getenv("TEX_MIPDUMP"); char* q = NULL;
+      s_tcm.dump = e ? (u32)strtoul(e, &q, 16) : 0u;
+      if (s_tcm.dump && q && *q == ':') {                /* :<w>x<h> */
+          s_tcm.dump_w = (u32)strtoul(q + 1, &q, 10);
+          if (q && (*q == 'x' || *q == 'X')) s_tcm.dump_h = (u32)strtoul(q + 1, NULL, 10);
+          if (!s_tcm.dump_w || !s_tcm.dump_h) s_tcm.dump_w = s_tcm.dump_h = 0;
+      } }
+    s_tcm.init = 1;
+    if (s_tcm.on)
+        fprintf(stderr, "[TEXMIP] guest mip levels on (TEX_MIPS=0: level 0 only) | levels %s%.0d | pitch %s |"
+                        " LOD clamp/bias %s | anisotropy %s%s%c",
+                s_tcm.maxlv ? "at most " : "all", s_tcm.maxlv, s_tcm.pitch ? "on" : "off (TEX_PITCH=0)",
+                s_tcm.lod ? "on" : "off (TEX_LOD=0)", s_tcm.aniso ? "on" : "off (TEX_ANISO=0)",
+                s_tcm.tint ? " | TEX_MIPTINT: levels 1.. painted" : "", 10);
+    else
+        fprintf(stderr, "[TEXMIP] guest mip levels OFF (TEX_MIPS=0): level 0 only, as before%c", 10);
+    if (s_tcm.dump)
+        fprintf(stderr, "[TEXMIP] TEX_MIPDUMP: offset 0x%08X, %s%.0u%s%.0u, first 16 uploads%c", s_tcm.dump,
+                s_tcm.dump_w ? "" : "any size", s_tcm.dump_w, s_tcm.dump_w ? "x" : "", s_tcm.dump_h, 10);
+    return &s_tcm;
+}
+/* The guest's level count: rsx_texture_level_count inline (it runs per
+ * binding and per sampler unit). 1 for a zero dimension. */
+static inline u32 tc_guest_levels(u32 w, u32 h, u32 mips)
+{
+    const u32 m = w > h ? w : h;
+    if (!w || !h) return 1u;
+    unsigned long hb; _BitScanReverse(&hb, m);           /* floor(log2(max)) */
+    u32 n = mips ? mips : 1u;
+    if (n > RSX_MAX_TEXTURE_LEVELS) n = RSX_MAX_TEXTURE_LEVELS;
+    return n < (u32)hb + 1u ? n : (u32)hb + 1u;
+}
+/* Levels uploaded for a texture of `glv` guest levels: all of them, at most
+ * TEX_MIPS_MAX; 1 with TEX_MIPS=0. */
+static inline u32 tc_up_levels(u32 glv)
+{
+    const tc_mipcfg_t* mc = tc_mipcfg();
+    if (!mc->on) return 1u;
+    return (mc->maxlv && glv > (u32)mc->maxlv) ? (u32)mc->maxlv : glv;
+}
+
+#define TC_RING_MIN   (16ull << 20)
+#define TC_RING_MAX   (128ull << 20)
+typedef struct {
+    int      inited;
+    int      ww;              /* validation by write watch; else checksum per batch */
+    u32      batch;           /* texture prepasses so far (tc_batch_begin)          */
+    u32      round_batch;     /* batch whose write-tracking round has begun          */
+    int      map[TC_MAP_BUCKETS];   /* slot index + 1, 0 = empty                      */
+    /* upload ring: persistently mapped, reset every batch */
+    ID3D12Resource* ring; u8* ring_map; u64 ring_size, ring_off, ring_want;
+    ID3D12Resource** tmp; int ntmp, captmp;   /* overflow buffers: released next batch */
+    ID3D12Resource* ck; u8* ck_map; u64 ck_size, ck_off;   /* ST1 TEX_UPCHUNK: the open overflow chunk (one of tmp) */
+    /* CPU-only SRV staging heap: [0] the null 2D view, then TC_DESC_VARIANTS per slot */
+    ID3D12DescriptorHeap* cpu_heap; SIZE_T cpu_base, vis_base; int cpu_failed;
+    /* stats, printed with PERF=1 every 20 batches */
+    u32 st_bind, st_dedup, st_clean, st_rehash_same, st_csum, st_upload, st_miss,
+        st_evict, st_recreate, st_overflow, st_fail, st_vol;
+    u64 st_upbytes, st_hashbytes;
+    double st_val_s, st_up_s;
+    /* guest mip levels: uploads with more than one level, the bytes those
+     * lower levels added to the upload, sampler sets built (and units in them
+     * whose CONTROL0 max LOD pins a mipmapped texture to level 0), the most
+     * sampler sets one render_frame used; LINEAR uploads whose rows the
+     * CONTROL3 pitch laid out differently from packed ([TEXMIP] LN pitch) */
+    u32 st_mipup, st_sampnew, st_clamp0, st_samp_peak, st_lnpitch;
+    u64 st_mipbytes;
+    /* TX1 TEX_FENCE (tex_fence_hook): the pending records' fence -- the batch
+     * number their prepass will run as (0 = none), its harvest's round, the
+     * records before it -- and cumulative counts: fences harvested (by kind:
+     * reference, back-end label), batches judged by one, splits (a record
+     * after a fence), fenced batches that began a round after all */
+    u32 st_fz, st_fzk[2], st_fz_used, st_fz_split, st_fz_unused;
+    u64 st_fault, st_ckfall;  /* ST1: TEX_FAULT_* failures injected; 32 MB chunks refused (the texture's own size taken) */
+    /* the fence's state (rsx_tex_cache.h: batch, round, records, serial, the
+     * marks: copy offsets, watches, hashes); the copy buffer (grown, kept);
+     * fences opened since the last present (the budget); counts: slots copied
+     * and their bytes, watched (hot ones after a reset), hashed (RSX-kept),
+     * rewritten after the fence (watched / hashed: counted), copies refused (no
+     * memory), marked slots evicted in their prepass (nothing else was free),
+     * fences over the budget (the old rule), texture-read labels taken */
+    tc_fence fz;
+    u8* fz_cap; size_t fz_cap_size, fz_cap_used;
+    u32 fz_frame;
+    u32 st_fz_cap, st_fz_rsx, st_fz_capfail, st_fz_watch, st_fz_lost;
+    u32 st_fz_hot, st_fz_evict, st_fz_budget, st_fz_texread;
+    u32 fz_hotbytes, st_fz_hotcap;   /* hot slots over the cap copied: bytes this fence; count */
+    u32 st_fz_rsxsame;               /* hashed slots unchanged at the fence: not read at the replay */
+    /* textures with no slot at the fence, copied by key (tex_fence_capture_new;
+     * their bytes this fence); the RSX-kept slots the fence marked (ea, len:
+     * an RSX copy into one before the replay is counted, tex_fence_rsx_note);
+     * counts: textures copied without a slot, read by their first replay, not
+     * copied (table full or over 1 MB a fence), RSX-kept slots not hashed
+     * (TEX_FENCE_RSX_HASH=0), RSX copies into one after its fence */
+    tc_fznew fzn[TC_FZ_NEW]; u32 fzn_n, fzn_bytes;
+    u32 fz_rsx[8][2], fz_rsxn;
+    u32 st_fz_new, st_fz_newuse, st_fz_newskip, st_fz_rsxoff, st_fz_rsxw;
+    u64 st_fz_capbytes;
+    double st_fz_harv_s, st_fz_cap_s;   /* time in the fences' harvests, in their walks + copies */
+} tc_state;
+static tc_state s_tc;
+typedef char tc_fz_slots_fit[(VP_TEX_SLOTS <= TC_FZ_SLOTS) ? 1 : -1];   /* the fence's per-slot marks */
+
+/* PF3_VERIFY=1: every PF3 shortcut also runs the computation it replaces, on
+ * the same draw, and compares what reaches the GPU -- RASTER_MEMO: the
+ * record's raster bytes (rs_vp, rs_k, rs_own: the D3D viewport, the epilogue
+ * lanes, the scissor) and the route; SAMP_KEEP: the 16 sampler codes of the
+ * set a draw binds (its descriptors are a pure function of them) against the
+ * set the per-batch heap would have bound; TEX_WW_RSX: every texture the
+ * write watch calls clean is hashed anyway against the hash of the bytes it
+ * holds (a stale one would differ; run with TEX_WW_RSX=0 for the old rule's
+ * count). Cumulative counts every 600 presents:
+ * [PF3VERIFY]. Diagnostic: it costs a hash per clean bind. */
+static int pf3_verify_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PF3_VERIFY"); on = (e && *e && *e != '0') ? 1 : 0; }
+    return on;
+}
+static struct {
+    u64 rs_cmp, rs_diff;              /* RASTER_MEMO: records compared, differing bytes */
+    u64 sp_cmp, sp_diff, sp_full;     /* SAMP_KEEP: draws compared, differing code bytes, old-heap "full" */
+    u64 tc_cmp, tc_stale, tc_bytes;   /* TEX_WW_RSX: clean binds hashed, stale, their bytes */
+    /* TX1: binds of records before their batch's fence compared with the bytes
+     * at the fence, differing (and their bytes), not in the fence's table,
+     * held over another span than the one hashed at the fence */
+    u64 fz_cmp, fz_diff, fz_bytes, fz_miss, fz_span;
+    u64 fz_later;   /* clean binds before their fence whose memory changed after it (the check above: "stale") */
+} s_pf3v;
+static int s_tfv_bind;   /* PF3_VERIFY: the bind in progress is a record's before its fence (tfv_check judges it) */
+static u32 s_tfv_batch, s_tfv_draws;   /* the fence oracle's batch (as tc_batch_begin will number it), its records before the fence */
+static void pf3_verify_report(void)
+{
+    static unsigned n = 0;
+    if (!pf3_verify_on() || (++n % 600u) != 0) return;
+    fprintf(stderr, "[PF3VERIFY] %u presents | raster memo: %llu records compared, %llu bytes differ | sampler"
+                    " sets: %llu draws compared, %llu code bytes differ (old heap full %llu) | write watch: %llu"
+                    " clean binds hashed, %llu stale (%llu bytes) | fence: %llu binds before their fence"
+                    " compared with its bytes, %llu differ (%llu bytes), %llu not in its table, %llu other"
+                    " span, %llu clean ones whose memory changed after the fence | fences %u (reference %u,"
+                    " back-end label %u, texture-read label %u), batches judged by one %u, splits %u, unused %u,"
+                    " over the budget %u; slots copied at the fence %u (%.1f MB; hot ones over the cap %u),"
+                    " textures with no slot copied %u"
+                    " (read %u, not copied %u), watched %u (hot %u), hashed %u (unchanged at the fence %u, unchecked"
+                    " %u, RSX copies after the fence %u), rewritten after the fence %u, evicted %u, copies refused %u;"
+                    " per fence: harvest %.1f us,"
+                    " walk + copies %.1f us%c", n,
+            (unsigned long long)s_pf3v.rs_cmp, (unsigned long long)s_pf3v.rs_diff,
+            (unsigned long long)s_pf3v.sp_cmp, (unsigned long long)s_pf3v.sp_diff,
+            (unsigned long long)s_pf3v.sp_full, (unsigned long long)s_pf3v.tc_cmp,
+            (unsigned long long)s_pf3v.tc_stale, (unsigned long long)s_pf3v.tc_bytes,
+            (unsigned long long)s_pf3v.fz_cmp, (unsigned long long)s_pf3v.fz_diff,
+            (unsigned long long)s_pf3v.fz_bytes, (unsigned long long)s_pf3v.fz_miss,
+            (unsigned long long)s_pf3v.fz_span, (unsigned long long)s_pf3v.fz_later,
+            s_tc.st_fz, s_tc.st_fzk[0], s_tc.st_fzk[1], s_tc.st_fz_texread,
+            s_tc.st_fz_used, s_tc.st_fz_split, s_tc.st_fz_unused, s_tc.st_fz_budget, s_tc.st_fz_cap,
+            (double)s_tc.st_fz_capbytes / 1048576.0, s_tc.st_fz_hotcap, s_tc.st_fz_new, s_tc.st_fz_newuse,
+            s_tc.st_fz_newskip,
+            s_tc.st_fz_watch, s_tc.st_fz_hot, s_tc.st_fz_rsx, s_tc.st_fz_rsxsame, s_tc.st_fz_rsxoff, s_tc.st_fz_rsxw,
+            s_tc.st_fz_lost, s_tc.st_fz_evict, s_tc.st_fz_capfail,
+            s_tc.st_fz ? s_tc.st_fz_harv_s * 1e6 / s_tc.st_fz : 0.0, s_tc.st_fz ? s_tc.st_fz_cap_s * 1e6 / s_tc.st_fz : 0.0,
+            10);
+}
+static int tex_fence_on(void);            /* TX1 TEX_FENCE (with render_frame) */
+static void tex_fence_hook(int kind);
+static void tc_init(void)
+{
+    extern uint8_t* vm_base;
+    if (s_tc.inited || !vm_base) return;
+    s_tc.inited = 1;
+    const char* e = getenv("TEX_WW");
+    const int allow = !(e && *e == '0');
+    s_tc.ww = tc_wt_init(vm_base, allow);
+    s_tc.ring_size = TC_RING_MIN;
+    fprintf(stderr, "[TEXCACHE] %s%c",
+            s_tc.ww ? "textures validated by write watch (guest arena reserved with MEM_WRITE_WATCH)"
+            : allow ? "textures validated by checksum every batch (guest arena has no MEM_WRITE_WATCH)"
+                    : "textures validated by checksum every batch (TEX_WW=0)", 10);
+    /* TX1 TEX_FENCE: the walker's fence points (rsx_commands.c) call
+     * tex_fence_hook; with TEX_FENCE=0 only PF3_VERIFY's oracle needs it. */
+    if (s_tc.ww && (tex_fence_on() || pf3_verify_on())) g_rsx_tex_fence_hook = tex_fence_hook;
+    fprintf(stderr, "[TEXCACHE] %s%c", !s_tc.ww ? "TEX_FENCE: off (no write watch)"
+            : tex_fence_on() ? "TEX_FENCE=1: a reference or a back-end label fixes what the draws before it read"
+                             : "TEX_FENCE=0: the draws read their textures at the replay (old rule)", 10);
+}
