+static void test_mouse_integral(void)
+{
+    /* With no anti-deadzone and below saturation, the stick deflection
+     * integrated over time is distance / KBM_FULL_SPEED * sensitivity,
+     * however the same 300 counts are chopped into reports. */
+    KbmConfig c;
+    kbm_config_defaults(&c);
+    c.anti_deadzone = 0.0f;
+    const double want = 300.0 / KBM_FULL_SPEED;       /* stick-seconds */
+    Run a = mouse_run(&c, 16.0, 30, 10, 0, 10);        /* 300 counts over 480 ms */
+    Run b = mouse_run(&c, 4.0, 100, 3, 0, 40);         /* 300 counts over 400 ms, 4 ms reports */
+    Run d = mouse_run(&c, 16.0, 1, 30, 0, 10);         /* 30 counts in one burst */
+    Run e = mouse_run(&c, 33.0, 10, 30, 0, 10);        /* 300 counts, 30 fps polling */
+    CHECK_NEAR(a.integral_x, want, want * 0.03);
+    CHECK_NEAR(b.integral_x, want, want * 0.03);
+    CHECK_NEAR(d.integral_x, 30.0 / KBM_FULL_SPEED, 30.0 / KBM_FULL_SPEED * 0.03);
+    CHECK_NEAR(e.integral_x, want, want * 0.03);
+    CHECK_EQ(a.last_rx, 128);
+    CHECK_EQ(b.last_rx, 128);
+    CHECK_EQ(d.last_rx, 128);
+    CHECK_EQ(e.last_rx, 128);
+    /* a different window gives the same total turn */
+    c.smoothing_ms = 120.0f;
+    Run f = mouse_run(&c, 16.0, 30, 10, 0, 20);
+    CHECK_NEAR(f.integral_x, want, want * 0.03);
+    c.smoothing_ms = 0.0f;                             /* per-report speed */
+    Run g = mouse_run(&c, 16.0, 30, 10, 0, 5);
+    CHECK_NEAR(g.integral_x, want, want * 0.03);
+    CHECK_EQ(g.last_rx, 128);
+}
+
+static void test_mouse_stale(void)
+{
+    /* motion accumulated across a long stall (the game stopped polling the
+     * pad, e.g. a loading screen) must not come out as a long camera spin */
+    KbmConfig c;
+    kbm_config_defaults(&c);
+    c.anti_deadzone = 0.0f;
+    KbmRuntime rt;
+    KbmOut o;
+    kbm_runtime_reset(&rt);
+    keys_clear();
+    kbm_eval(&c, &rt, fake_down, NULL, 0.0, 0, 0, 0, &o);
+    kbm_eval(&c, &rt, fake_down, NULL, 5000.0, 3000, 0, 0, &o);   /* 3000 counts over 5 s */
+    CHECK(o.rx < 0.5f);
+    double integral = o.rx * 16.0 / 1000.0;
+    for (int i = 1; i < 10; i++) {
+        kbm_eval(&c, &rt, fake_down, NULL, 5000.0 + i * 16.0, 0, 0, 0, &o);
+        integral += o.rx * 16.0 / 1000.0;
+    }
+    CHECK(integral < 3000.0 / KBM_FULL_SPEED * 0.05);
+    CHECK_EQ(kbm_axis_u8(o.rx), 128);
+}
