+    CHECK(rsx_selfsample_writes(0xFu, 0x0487u, 0) == 0x7u, "cmask 0x487 writes A, B and C, not D");
+    CHECK(rsx_selfsample_writes(0x7u, 0x0007u, 0) == 0x1u, "cmask 0x7 writes A only");
+    CHECK(rsx_selfsample_writes(0x7u, 0x0000u, 0) == 0x0u, "a fully masked draw writes no plane");
