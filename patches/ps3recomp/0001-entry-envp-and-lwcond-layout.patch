+/* ---------------------------------------------------------------------------
+ * Logging
+ * -----------------------------------------------------------------------*/
+
+int padhost_log_enabled(void) { return s_cfg.log != 0; }
+
+void padhost_logf(const char* fmt, ...)
+{
+    if (s_quiet) return;
+    char buf[1200];
+    int n = snprintf(buf, sizeof buf, "[padhost] ");
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf + n, sizeof buf - (size_t)n - 2, fmt, ap);
+    va_end(ap);
+    size_t l = strlen(buf);
+    if (!l || buf[l - 1] != '\n') { buf[l] = '\n'; buf[l + 1] = 0; }
+    fputs(buf, stdout);    /* one call per line: lines from several threads do not interleave */
+    fflush(stdout);
+}
+
+#define PH_VLOG(...) do { if (s_cfg.log) padhost_logf(__VA_ARGS__); } while (0)
+
+static void ph_name_thread(const WCHAR* name)
+{
+    static PFN_SetThreadDescription fn;
+    static int looked;
+    if (!looked) {
+        HMODULE k = GetModuleHandleW(L"kernel32.dll");
+        if (k) fn = (PFN_SetThreadDescription)(void*)GetProcAddress(k, "SetThreadDescription");
+        looked = 1;
+    }
+    if (fn) fn(GetCurrentThread(), name);
+}
+
+static int ph_drv_count(const PadHostDriver** out, int max);
+
+/* ---------------------------------------------------------------------------
+ * Snapshots and ports
+ * -----------------------------------------------------------------------*/
+
+static u8 ph_u8f(float v)
+{
+    v = floorf(v + 0.5f);
+    return (u8)(v < 0.f ? 0 : v > 255.f ? 255 : v);
+}
+
+/* Radial deadzone, rescaled: inside -> exactly centre, outside -> distance
+ * from the deadzone edge stretched back to the full range. The magnitude is
+ * not clamped to the unit circle, so a pad whose diagonals reach the corners
+ * (as a DS3's do) still reaches them. */
+static void ph_deadzone(u8* x, u8* y, LONG permille)
+{
+    if (permille <= 0) return;
+    float fx = ((float)*x - 127.5f) / 127.5f;
+    float fy = ((float)*y - 127.5f) / 127.5f;
+    float mag = sqrtf(fx * fx + fy * fy);
+    float dz = (float)permille / 1000.f;
+    if (mag <= dz) { *x = *y = 128; return; }
+    float s = (mag - dz) / (1.f - dz) / mag;
+    *x = ph_u8f(127.5f + fx * s * 127.5f);
+    *y = ph_u8f(127.5f + fy * s * 127.5f);
+}
+
+static void ph_publish(int port, int owner, const PadHostPortState* raw, int kind, int bus, u16 vid, u16 pid)
+{
+    if (port < 0 || port >= PADHOST_MAX_PORTS) return;
+    PadHostPortState st = *raw;
+    st.connected = 1;
+    st.kind = kind; st.bus = bus; st.vid = vid; st.pid = pid;
+    LONG dzl = s_cfg.dz_left, dzr = s_cfg.dz_right;
+    ph_deadzone(&st.lx, &st.ly, dzl == PH_DZ_KIND ? ph_dz_default(kind) : dzl);
+    ph_deadzone(&st.rx, &st.ry, dzr == PH_DZ_KIND ? ph_dz_default(kind) : dzr);
+    if (!st.has_motion || !s_cfg.motion) {
+        st.has_motion = 0;
+        st.sensor_x = PADHOST_SENSOR_NEUTRAL_X; st.sensor_y = PADHOST_SENSOR_NEUTRAL_Y;
+        st.sensor_z = PADHOST_SENSOR_NEUTRAL_Z; st.sensor_g = PADHOST_SENSOR_NEUTRAL_G;
+    }
+    AcquireSRWLockExclusive(&s_snap_lock);
+    if (s_snap_owner[port] == owner) {
+        st.seq = s_snap[port].seq + 1;
+        st.assign_seq = s_snap[port].assign_seq;
+        s_snap[port] = st;
+    }
+    ReleaseSRWLockExclusive(&s_snap_lock);
+}
+
+static int ph_port_free(int p) { return !s_port[p].dev && s_port[p].xslot < 0; }
+
+/* s_lock exclusive. Old port if free, else the lowest free one. */
+static int ph_pick_port(const char* ident)
+{
+    for (int p = 0; p < PADHOST_MAX_PORTS; p++)
+        if (ph_port_free(p) && ident[0] && !strcmp(s_port[p].last_ident, ident)) return p;
+    for (int p = 0; p < PADHOST_MAX_PORTS; p++)
+        if (ph_port_free(p)) return p;
+    return -1;
+}
+
+static void ph_snap_set(int p, int owner, int connected, int kind, int bus, u16 vid, u16 pid)
+{
+    AcquireSRWLockExclusive(&s_snap_lock);
+    u32 seq = s_snap[p].seq, aseq = s_snap[p].assign_seq;
+    padhost_state_neutral(&s_snap[p]);
+    s_snap[p].connected = connected;
+    s_snap[p].kind = kind; s_snap[p].bus = bus; s_snap[p].vid = vid; s_snap[p].pid = pid;
+    s_snap[p].seq = seq + 1;
+    s_snap[p].assign_seq = aseq + 1;
+    s_snap_owner[p] = owner;
+    ReleaseSRWLockExclusive(&s_snap_lock);
+}
+
+/* s_lock exclusive */
+static void ph_bind(int p, PhDev* d, int xslot, const char* ident)
+{
+    s_port[p].dev = d;
+    s_port[p].xslot = d ? -1 : xslot;
+    snprintf(s_port[p].last_ident, sizeof s_port[p].last_ident, "%s", ident);
+    InterlockedExchange(&s_act[p], 0);
+    if (d) {
+        d->pub.port = p;
+        InterlockedExchange(&d->port_v, p);
+        InterlockedExchange(&d->rebound, 1);
+        ph_snap_set(p, d->id, 1, d->kind, d->pub.bus, d->pub.vid, d->pub.pid);
+        if (d->wake_ev) SetEvent(d->wake_ev);    /* LEDs for the new port */
+    } else {
+        PhXSlot* x = &s_x.slot[xslot];
+        x->port = p;
+        ph_snap_set(p, -(xslot + 1), 1, PADHOST_KIND_XINPUT, PADHOST_BUS_OTHER, x->vid, x->pid);
+    }
+    InterlockedIncrement(&s_generation);
+    InterlockedExchange(&s_list_dirty, 1);
+}
+
+static void ph_assign_waiting(int p);
+static void ph_dup_reeval(void);
+
+/* A virtual pad whose port ph_dup_reeval decides (prefer_physical = 1); with
+ * prefer_physical = 0 it is an ordinary pad, ported where it connects. */
+static int ph_virt_deferred(int vsrc) { return vsrc && s_cfg.prefer_physical; }
+
+/* s_lock exclusive */
+static void ph_unbind(int p)
+{
+    if (s_port[p].dev) {
+        s_port[p].dev->pub.port = -1;
+        InterlockedExchange(&s_port[p].dev->port_v, -1);
+    } else if (s_port[p].xslot >= 0) {
+        s_x.slot[s_port[p].xslot].port = -1;
+    }
+    s_port[p].dev = NULL;
+    s_port[p].xslot = -1;
+    InterlockedExchange(&s_act[p], 0);
+    ph_snap_set(p, 0, 0, PADHOST_KIND_NONE, PADHOST_BUS_OTHER, 0, 0);
+    InterlockedIncrement(&s_generation);
+    InterlockedExchange(&s_list_dirty, 1);
+    if (s_state == 1) ph_assign_waiting(p);
+}
+
+/* s_lock exclusive. The same pad over its other link, already on a port: a
+ * DUALSHOCK 4 / DualSense / DS3 on Bluetooth whose USB cable is plugged in is
+ * two HID devices with one identity (the MAC) until one link goes (hid-sony and
+ * hid-playstation refuse the duplicate). The second link waits for the first
+ * one's port instead of taking another, or the pad ends up on port 1 once the
+ * first link drops and port 0 -- the only one a single-player title reads --
+ * stays empty. Two devices on the same bus are never one pad (clones that
+ * share a serial string). */
+static PhDev* ph_twin_on_port(const PhDev* d)
+{
+    if (!d->pub.serial[0] || !d->ident[0]) return NULL;
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* o = s_devs[i];
+        if (o && o != d && o->state == DEV_RUNNING && o->port_v >= 0 && o->pub.bus != d->pub.bus &&
+            !strcmp(o->ident, d->ident))
+            return o;
+    }
+    return NULL;
+}
+
+/* s_lock exclusive: a freed port goes to the pad's other link if it waits for
+ * it, else to whoever has waited longest. */
+static void ph_assign_waiting(int p)
+{
+    PhDev* best = NULL;
+    int bx = -1;
+    unsigned seq = 0xFFFFFFFFu;
+    if (s_hold_ports) return;                      /* ph_release_held_ports hands them out */
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* d = s_devs[i];
+        if (!d || d->state != DEV_RUNNING || d->port_v >= 0 || d->stop_req || d->idle) continue;
+        if (d->hidden || (d->vsrc && s_hold_virtual)) continue;   /* a virtual duplicate: ph_dup_reeval's */
+        if (s_port[p].last_ident[0] && !strcmp(d->ident, s_port[p].last_ident)) { best = d; seq = 0; break; }
+        if (ph_twin_on_port(d)) continue;          /* waits for its twin's port, not this one */
+        if (d->connect_seq < seq) { best = d; seq = d->connect_seq; }
+    }
+    for (int i = 0; i < PH_XSLOTS; i++) {
+        PhXSlot* x = &s_x.slot[i];
+        if (x->hidden || (x->vsrc && s_hold_virtual)) continue;
+        if (x->connected && x->port < 0 && x->connect_seq < seq) { best = NULL; bx = i; seq = x->connect_seq; }
+    }
+    if (best) {
+        ph_bind(p, best, -1, best->ident);
+        padhost_logf("port %d: %s (%s) took the free port", p, best->pub.name, best->drv->name);
+    } else if (bx >= 0) {
+        char id[16];
+        snprintf(id, sizeof id, "xinput#%d", bx);
+        ph_bind(p, NULL, bx, id);
+        padhost_logf("port %d: XInput pad %d took the free port", p, bx);
+    }
+}
+
+/* Class for handing out ports at startup, best first: pads of the specific
+ * drivers (XInput's are bound even before the HID scan starts), then other
+ * HID gamepads, then HID joysticks / multi-axis devices. Devices present at
+ * startup open in parallel and the order they finish in is arbitrary -- a
+ * generic device opens in microseconds, a DualSense reads three feature
+ * reports first -- and a wheel, flight stick or vJoy device must not take
+ * port 0, the one a single-player title reads, from the player's gamepad. */
+static int ph_dev_rank(const PhDev* d)
+{
+    if (d->kind != PADHOST_KIND_GENERIC) return 0;
+    return d->pub.usage == 0x05 ? 1 : 2;
+}
+
+/* s_lock held. A pad of rank < 2 just got port p > 0 while a joystick-class
+ * device holds port 0: say so (ports stay where they are once given). */
+static int ph_port0_note(int p, int rank, char* out, size_t n)
+{
+    const PhDev* z = s_port[0].dev;
+    if (p <= 0 || rank >= 2 || !z || ph_dev_rank(z) < 2) return 0;
+    snprintf(out, n, "note: port 0 -- the one a single-player game reads -- is \"%s\" (%04X:%04X), a joystick-class "
+             "device, not the controller on port %d. To keep it off the pad ports, add \"map.%04X:%04X = ignore\" "
+             "to config/input.ini [controller]; at startup gamepads get the first ports", z->pub.name,
+             z->pub.vid, z->pub.pid, p, z->pub.vid, z->pub.pid);
+    return 1;
+}
+
+/* End of padhost_init's first scan: the HID devices opened so far get their
+ * ports, by rank, then in the order they were found; then the virtual pads
+ * (XInput ones included), unless they duplicate a physical one. */
+static void ph_release_held_ports(void)
+{
+    PhDev* order[PH_MAX_DEVS];
+    static char lines[PH_MAX_DEVS + 1][400];    /* manager-init only */
+    int n = 0, nl = 0;
+    AcquireSRWLockExclusive(&s_lock);
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* d = s_devs[i];
+        if (d && d->state == DEV_RUNNING && d->port_v < 0 && !d->stop_req && !d->idle && !ph_virt_deferred(d->vsrc))
+            order[n++] = d;
+    }
+    for (int i = 1; i < n; i++) {
+        PhDev* x = order[i];
+        int j = i, rx = ph_dev_rank(x);
+        while (j > 0 && (ph_dev_rank(order[j - 1]) > rx || (ph_dev_rank(order[j - 1]) == rx && order[j - 1]->id > x->id))) {
+            order[j] = order[j - 1];
+            j--;
+        }
+        order[j] = x;
+    }
+    InterlockedExchange(&s_hold_ports, 0);
+    for (int i = 0; i < n; i++) {
+        PhDev* d = order[i];
+        PhDev* twin = ph_twin_on_port(d);
+        int p = twin ? -1 : ph_pick_port(d->ident);
+        if (p >= 0) ph_bind(p, d, -1, d->ident);
+        if (p >= 0)
+            snprintf(lines[nl++], sizeof lines[0], "port %d: %s connected (%s, %s %04X:%04X)", p, d->pub.name,
+                     d->drv->name, padhost_bus_name(d->pub.bus), d->pub.vid, d->pub.pid);
+        else if (twin)
+            snprintf(lines[nl++], sizeof lines[0], "%s connected over %s too: it stays on port %d over the other "
+                     "link, this one takes over when that goes", d->pub.name, padhost_bus_name(d->pub.bus),
+                     (int)twin->port_v);
+        else
+            snprintf(lines[nl++], sizeof lines[0], "%s connected, but all %d ports are taken: it waits for a "
+                     "free one", d->pub.name, PADHOST_MAX_PORTS);
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    for (int i = 0; i < nl; i++) padhost_logf("%s", lines[i]);
+    AcquireSRWLockExclusive(&s_lock);
+    InterlockedExchange(&s_hold_virtual, 0);
+    ph_dup_reeval();
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+/* ---------------------------------------------------------------------------
+ * Virtual duplicates
+ *
+ * DS4Windows, DualSenseX, BetterJoy and x360ce (on the ViGEm bus), SCP Toolkit
+ * (ScpVBus) and Steam Input put a virtual Xbox (or DUALSHOCK 4) pad next to
+ * the physical controller they read, so one controller shows up twice. XInput
+ * pads take the first ports, so the copy used to be player 1: no motion,
+ * lightbar or pressure, and dead the moment the remapper stops feeding it.
+ *
+ * A virtual pad is told by its device's ancestors: the ViGEm or SCP bus, or a
+ * root-enumerated software bus with no USB hub or Bluetooth radio in between
+ * (ph_vsrc_step), or by Steam's virtual-gamepad ids. An XInput slot is matched
+ * to its XUSB device through the LED state the driver keeps for it -- the
+ * player number xusb22 assigns, which is how XInput itself numbers its slots.
+ *
+ * With prefer_physical = 1 (the default) as many virtual pads as there are
+ * physical PlayStation / Nintendo / HID gamepads are hidden: no port, like the
+ * second link of a pad on Bluetooth and USB at once. Hidden rather than moved
+ * behind the physical pads: it is the same controller, and on a port of its
+ * own it would be a phantom second player mirroring the first in any title
+ * that reads more than port 0. A hidden one is a standby: if the physical pad
+ * goes away (unplugged, or hidden by HidHide) while the remapper still feeds
+ * the copy, the copy takes over. A physical pad that arrives while its copy
+ * holds a port (a replug: the remapper plugs its copy in before the pad's own
+ * open has finished) takes that port over. Virtual pads beyond that count (a
+ * copy of a controller hidden from us, e.g. by HidHide) are ordinary pads that
+ * get their ports after the physical ones at startup. Real Xbox pads are on
+ * none of these buses, so an Xbox pad and a DualSense both keep their ports.
+ * Steam's copies may mirror an Xbox pad too, so those count XInput pads as
+ * well. prefer_physical = 0: virtual pads are ordinary pads (the old order).
+ * -----------------------------------------------------------------------*/
+
+static const char* ph_vsrc_name(int s)
+{
+    switch (s) {
+    case PH_VSRC_VIGEM:   return "ViGEm bus";
+    case PH_VSRC_SCP:     return "SCP virtual bus";
+    case PH_VSRC_STEAM:   return "Steam Input";
+    case PH_VSRC_SOFTBUS: return "software bus";
+    default:              return "";
+    }
+}
+
+static const char* ph_vsrc_who(int s)
+{
+    switch (s) {
+    case PH_VSRC_VIGEM: return "DS4Windows, DualSenseX, BetterJoy, x360ce, ...";
+    case PH_VSRC_SCP:   return "SCP Toolkit, older DS4Windows";
+    case PH_VSRC_STEAM: return "Steam";
+    default:            return "a controller remapper";
+    }
+}
+
+/* One node of a device's ancestry, lower case: its instance id, hardware ids
+ * (joined by any separator) and service; depth 0 is the device itself.
+ * PH_VSRC_* once that settles it, -1 = look at the parent. */
+static int ph_vsrc_step(int depth, const char* id, const char* hw, const char* svc)
+{
+    if (strstr(hw, "vigembus") || !strcmp(svc, "vigembus")) return PH_VSRC_VIGEM;
+    if (strstr(hw, "scpvbus") || !strcmp(svc, "scpvbus")) return PH_VSRC_SCP;
+    if (strstr(id, "vid_28de&pid_11ff")) return PH_VSRC_STEAM;          /* Steam Virtual Gamepad */
+    /* a USB hub, a Bluetooth radio, the PCI / ACPI tree: real hardware */
+    if (ph_starts(id, "usb\\root_hub") || ph_starts(id, "pci\\") || ph_starts(id, "acpi\\") ||
+        ph_starts(id, "bth") || ph_starts(id, "htree\\"))
+        return PH_VSRC_NONE;
+    if (depth > 0 && ph_starts(id, "root\\")) return PH_VSRC_SOFTBUS;  /* a software-enumerated bus */
+    return -1;
+}
+
+/* XInput player number from the XUSB LED state (XINPUT_LED_*: 2..5 flash then
+ * stay on, 6..9 on, for players 1..4), -1 for none (off, blinking, ...). */
+static int ph_led_slot(unsigned led) { return led >= 2 && led <= 9 ? (int)((led - 2) & 3) : -1; }
+
+/* A physical pad a remapper may mirror: a PlayStation / Nintendo pad or a HID
+ * gamepad (not a joystick or wheel), counted once over two links. */
+static int ph_dup_source(const PhDev* d)
+{
+    if (!d || d->vsrc || d->state != DEV_RUNNING || d->idle || d->stop_req) return 0;
+    if (d->kind == PADHOST_KIND_GENERIC && d->pub.usage != 0x05) return 0;
+    if (d->port_v < 0 && ph_twin_on_port(d)) return 0;
+    return 1;
+}
+
+static void ph_dup_name(const PhDev* d, int xs, char* out, size_t n)
+{
+    if (d) snprintf(out, n, "%s (%04X:%04X)", d->pub.name, d->pub.vid, d->pub.pid);
+    else   snprintf(out, n, "XInput pad %d (%04X:%04X)", xs, s_x.slot[xs].vid, s_x.slot[xs].pid);
+}
+
+/* s_lock exclusive. Port p was a hidden duplicate's: the physical pad it
+ * copies takes it, i.e. the most recently connected physical pad on a later
+ * port (XInput ones too when allow_x: Steam's copies). Returns the port it
+ * left, or -1. */
+static int ph_dup_move_in(int p, int allow_x, char* who, size_t n)
+{
+    PhDev* best = NULL;
+    int bx = -1, found = 0;
+    unsigned seq = 0;
+    if (!ph_port_free(p)) return -1;               /* ph_unbind gave it to a waiting device */
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* d = s_devs[i];
+        if (ph_dup_source(d) && d->port_v > p && (!found || d->connect_seq > seq)) {
+            best = d; bx = -1; seq = d->connect_seq; found = 1;
+        }
+    }
+    for (int i = 0; allow_x && i < PH_XSLOTS; i++) {
+        PhXSlot* x = &s_x.slot[i];
+        if (x->connected && !x->vsrc && x->port > p && (!found || x->connect_seq > seq)) {
+            best = NULL; bx = i; seq = x->connect_seq; found = 1;
+        }
+    }
+    if (!found) return -1;
+    /* Port q is emptied only once the pad is on p: ph_unbind hands a freed
+     * port to whoever waits for one, and the pad itself, portless for that
+     * moment, looked like it (it then held both ports). */
+    int q;
+    if (best) {
+        q = (int)best->port_v;
+        s_port[q].dev = NULL;
+        ph_bind(p, best, -1, best->ident);
+        snprintf(who, n, "%s", best->pub.name);
+    } else {
+        char id[16];
+        q = s_x.slot[bx].port;
+        s_port[q].xslot = -1;
+        snprintf(id, sizeof id, "xinput#%d", bx);
+        ph_bind(p, NULL, bx, id);
+        snprintf(who, n, "XInput pad %d", bx);
+    }
+    ph_unbind(q);                                  /* now empty: neutral snapshot, a waiting pad gets it */
+    return q;
+}
+
+/* s_lock exclusive. Decide which virtual pads are hidden (see above), take
+ * the ports of the newly hidden ones, and give the others that have none a
+ * port (a virtual pad never gets one at connect: it is decided here). Called
+ * after every change of the pads present. */
+static void ph_dup_reeval(void)
+{
+    struct { PhDev* d; int xs, vs, was, want; unsigned seq; } c[PH_MAX_DEVS + PH_XSLOTS], t;
+    int nc = 0, hid_src = 0, x_src = 0;
+    if (s_state != 1) return;                      /* shutting down: nothing is handed on */
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* d = s_devs[i];
+        if (!d) continue;
+        if (ph_dup_source(d)) hid_src++;
+        else if (d->vsrc && d->state == DEV_RUNNING && !d->idle && !d->stop_req) {
+            c[nc].d = d; c[nc].xs = -1; c[nc].vs = d->vsrc; c[nc].was = (int)d->hidden;
+            c[nc].seq = d->connect_seq; nc++;
+        }
+    }
+    for (int i = 0; i < PH_XSLOTS; i++) {
+        PhXSlot* x = &s_x.slot[i];
+        if (!x->connected) continue;
+        if (!x->vsrc) { x_src++; continue; }
+        c[nc].d = NULL; c[nc].xs = i; c[nc].vs = x->vsrc; c[nc].was = x->hidden;
+        c[nc].seq = x->connect_seq; nc++;
+    }
+    if (!nc) return;
+    for (int i = 1; i < nc; i++) {                 /* the hidden ones stay hidden first, then by arrival */
+        int j = i;
+        t = c[i];
+        while (j > 0 && (c[j - 1].was < t.was || (c[j - 1].was == t.was && c[j - 1].seq > t.seq))) {
+            c[j] = c[j - 1];
+            j--;
+        }
+        c[j] = t;
+    }
+    int prefer = s_cfg.prefer_physical != 0;
+    int budget = prefer ? hid_src : 0;
+    for (int k = 0; k < nc; k++) {
+        c[k].want = 0;
+        if (c[k].vs != PH_VSRC_STEAM && budget > 0) { c[k].want = 1; budget--; }
+    }
+    budget += prefer ? x_src : 0;                  /* Steam may mirror an Xbox pad as well */
+    for (int k = 0; k < nc; k++)
+        if (c[k].vs == PH_VSRC_STEAM && budget > 0) { c[k].want = 1; budget--; }
+
+    /* All the flags first: a port freed below must not go to a pad that is
+     * about to be hidden (ph_assign_waiting skips hidden ones). */
+    for (int k = 0; k < nc; k++) {
+        if (c[k].want == c[k].was) continue;
+        if (c[k].d) InterlockedExchange(&c[k].d->hidden, c[k].want);
+        else        s_x.slot[c[k].xs].hidden = c[k].want;
+    }
+    int hold = s_hold_ports || s_hold_virtual;
+    for (int k = 0; k < nc; k++) {
+        PhDev* d = c[k].d;
+        int xs = c[k].xs, vs = c[k].vs;
+        char nm[96];
+        ph_dup_name(d, xs, nm, sizeof nm);
+        if (c[k].want && !c[k].was) {
+            int p = d ? (int)d->port_v : s_x.slot[xs].port;
+            char who[80] = "", tail[160] = "";
+            if (p >= 0) {
+                ph_unbind(p);
+                int q = ph_dup_move_in(p, vs == PH_VSRC_STEAM, who, sizeof who);
+                if (q >= 0)               snprintf(tail, sizeof tail, "; port %d goes to %s (from port %d)", p, who, q);
+                else if (ph_port_free(p)) snprintf(tail, sizeof tail, "; port %d is free", p);
+                else                      snprintf(tail, sizeof tail, "; port %d goes to a controller waiting for one", p);
+            }
+            padhost_logf("%s is a virtual pad (%s: %s), the same controller as a physical one here: hidden while "
+                         "that one is connected%s (prefer_physical = 0 in input.ini [controller] keeps it)",
+                         nm, ph_vsrc_name(vs), ph_vsrc_who(vs), tail);
+        } else if (!c[k].want && c[k].was) {
+            padhost_logf("%s (virtual pad, %s) back in use: no physical controller left for it to duplicate",
+                         nm, ph_vsrc_name(vs));
+        }
+        int hidden = d ? (int)d->hidden : s_x.slot[xs].hidden;
+        int port = d ? (int)d->port_v : s_x.slot[xs].port;
+        if (hidden || port >= 0 || hold) continue;
+        char id[PH_IDENT];
+        if (d) snprintf(id, sizeof id, "%s", d->ident);
+        else   snprintf(id, sizeof id, "xinput#%d", xs);
+        int p = ph_pick_port(id);
+        if (p < 0) continue;
+        ph_bind(p, d, xs, id);
+        padhost_logf("port %d: %s connected (virtual pad, %s)", p, nm, ph_vsrc_name(vs));
+    }
+}
+
+/* s_lock held (shared is enough). See padhost_port_describe. */
+static int ph_describe_locked(int port, char* buf, int n)
+{
+    const PhDev* d = s_port[port].dev;
+    int xs = s_port[port].xslot;
+    buf[0] = 0;
+    if (d) {
+        const char* nm = d->pub.name[0] ? d->pub.name : padhost_kind_name(d->kind);
+        const char* bus = d->pub.bus == PADHOST_BUS_USB ? "USB" : d->pub.bus == PADHOST_BUS_BT ? "Bluetooth" : "";
+        if (d->vsrc)     snprintf(buf, (size_t)n, "virtual %s (%s)", nm, ph_vsrc_name(d->vsrc));
+        else if (bus[0]) snprintf(buf, (size_t)n, "%s (%s)", nm, bus);
+        else             snprintf(buf, (size_t)n, "%s", nm);
+        return 1;
+    }
+    if (xs >= 0) {
+        const PhXSlot* x = &s_x.slot[xs];
+        if (x->vsrc) snprintf(buf, (size_t)n, "virtual Xbox controller (%s)", ph_vsrc_name(x->vsrc));
+        else         snprintf(buf, (size_t)n, "Xbox controller (XInput%s)", x->wired ? "" : ", wireless");
+        return 1;
+    }
+    return 0;
+}
+
+int padhost_port_describe(int port, char* buf, int n)
+{
+    if (!buf || n <= 0) return 0;
+    buf[0] = 0;
+    if (port < 0 || port >= PADHOST_MAX_PORTS) return 0;
+    ph_global_once();
+    if (!TryAcquireSRWLockShared(&s_lock)) return -1;   /* never waits: the caller is a guest thread */
+    int r = ph_describe_locked(port, buf, n);
+    ReleaseSRWLockShared(&s_lock);
+    return r;
+}
+
+int padhost_get(int port, PadHostPortState* out)
+{
+    if (!out) return 0;
+    if (port < 0 || port >= PADHOST_MAX_PORTS) { padhost_state_neutral(out); return 0; }
+    ph_global_once();
+    AcquireSRWLockShared(&s_snap_lock);
+    *out = s_snap[port];
+    ReleaseSRWLockShared(&s_snap_lock);
+    if (out->connected && s_cfg.focus_only) {
+        static volatile LONG64 checked;
+        static volatile LONG focused;
+        LONG64 now = (LONG64)GetTickCount64();
+        if (now - checked >= 50 || checked == 0) {
+            HWND fg = GetForegroundWindow();
+            DWORD pid = 0;
+            if (fg) GetWindowThreadProcessId(fg, &pid);
+            focused = pid == GetCurrentProcessId();
+            checked = now;
+        }
+        if (!focused) {
+            PadHostPortState n;
+            padhost_state_neutral(&n);
+            n.connected = 1; n.kind = out->kind; n.bus = out->bus;
+            n.vid = out->vid; n.pid = out->pid; n.battery = out->battery; n.seq = out->seq;
+            n.assign_seq = out->assign_seq;
+            *out = n;
+        }
+    }
+    return out->connected;
+}
+
+unsigned padhost_generation(void) { return (unsigned)s_generation; }
+
+void padhost_set_actuator(int port, u8 small_motor, u8 large_motor)
+{
+    if (port < 0 || port >= PADHOST_MAX_PORTS) return;
+    LONG v = (small_motor ? 1 : 0) | ((LONG)large_motor << 8);
+    if (InterlockedExchange(&s_act[port], v) == v) return;
+    /* Never wait here (guest thread). If the lock is busy, the device's own
+     * tick (every report, at least every PH_OUT_TICK_MS) picks the change up. */
+    if (!TryAcquireSRWLockShared(&s_lock)) return;
+    if (s_state == 1) {
+        if (s_port[port].dev && s_port[port].dev->wake_ev) SetEvent(s_port[port].dev->wake_ev);
+        else if (s_port[port].xslot >= 0 && s_ev_xwake) SetEvent(s_ev_xwake);
+    }
+    ReleaseSRWLockShared(&s_lock);
+}
+
+static void ph_act_scaled(int port, u8* small, u8* large)
+{
+    LONG a = port >= 0 && port < PADHOST_MAX_PORTS ? s_act[port] : 0;
+    LONG pct = s_cfg.rumble_pct;
+    if (pct <= 0) { *small = *large = 0; return; }
+    *small = (u8)(a & 1);
+    LONG l = ((a >> 8) & 0xFF) * pct / 100;
+    *large = (u8)(l > 255 ? 255 : l);
+}
+
+static void ph_battery_note(int port, const char* who, u8 batt, u8* logged)
+{
+    if (batt == 255 || batt == *logged) return;
+    if (*logged == 254) { *logged = batt; return; }          /* first reading: in the device list */
+    int low = batt <= 10 && (*logged == 255 || *logged > 10);
+    if (*logged != 255 && abs((int)batt - (int)*logged) < 10 && !low) return;
+    *logged = batt;
+    padhost_logf("port %d %s: battery %u%%%s", port, who, batt, batt <= 10 ? " -- low" : "");
+}
+
+/* ---------------------------------------------------------------------------
+ * Device I/O helpers
+ * -----------------------------------------------------------------------*/
+
+/* The ExitProcess path (one thread left, the loader lock held) does its I/O
+ * with this OVERLAPPED and buffer -- not the stack, and not the heap, whose
+ * lock a killed thread may hold -- so a write the stack does not cancel in
+ * time can be abandoned without the kernel later completing it into a frame
+ * the loader has reused. After one is abandoned no more I/O is tried. */
+static OVERLAPPED s_exit_ov;
+static unsigned char s_exit_buf[1024];
+static volatile LONG s_exit_io_stuck;
+
+static int ph_wait_ov(PhDev* d, OVERLAPPED* ov, HANDLE ev, DWORD timeout, DWORD* got)
+{
+    HANDLE h = d->pub.handle;
+    if (WaitForSingleObject(ev, timeout) != WAIT_OBJECT_0) {
+        CancelIoEx(h, ov);
+        if (!s_exiting)
+            GetOverlappedResult(h, ov, got, TRUE);
+        else if (WaitForSingleObject(ev, 100) == WAIT_OBJECT_0)
+            GetOverlappedResult(h, ov, got, FALSE);
+        else
+            InterlockedExchange(&s_exit_io_stuck, 1);
+        d->last_err = ERROR_TIMEOUT;
+        return -1;
+    }
+    if (!GetOverlappedResult(h, ov, got, FALSE)) { d->last_err = GetLastError(); return -1; }
+    return 0;
+}
+
+static int ph_ioctl(PhDev* d, DWORD code, void* in, DWORD inlen, void* out, DWORD outlen, DWORD* got,
+                    DWORD timeout)
+{
+    OVERLAPPED stack_ov;
+    OVERLAPPED* ov = &stack_ov;
+    void* user_out = out;
+    DWORD n = 0;
+    if (s_exiting) {
+        /* one buffer: a request either sends (in) or fetches (out) */
+        if (s_exit_io_stuck || (in && out) || inlen > sizeof s_exit_buf || outlen > sizeof s_exit_buf) return -1;
+        if (in) {
+            if (in != (void*)s_exit_buf) memcpy(s_exit_buf, in, inlen);
+            in = s_exit_buf;
+        }
+        if (out) {
+            memcpy(s_exit_buf, out, outlen);    /* the report id in out[0] */
+            out = s_exit_buf;
+        }
+        ov = &s_exit_ov;
+    }
+    memset(ov, 0, sizeof *ov);
+    ov->hEvent = d->io_ev;
+    ResetEvent(d->io_ev);
+    if (!DeviceIoControl(d->pub.handle, code, in, inlen, out, outlen, &n, ov)) {
+        DWORD e = GetLastError();
+        if (e != ERROR_IO_PENDING) { d->last_err = e; return -1; }
+    }
+    if (ph_wait_ov(d, ov, d->io_ev, s_exiting ? 100 : timeout, &n) < 0) return -1;
+    if (user_out && out != user_out) memcpy(user_out, out, n < outlen ? n : outlen);
+    if (got) *got = n;
+    return 0;
+}
+
+static PhDev* ph_dev(PadHostDevice* d) { return (PhDev*)(void*)d; }
+
+static int ph_virt_pop(PhVirt* v, unsigned char* buf, int cap)
+{
+    int n = -2;                     /* -2 nothing queued */
+    EnterCriticalSection(&v->cs);
+    if (v->count) {
+        int l = v->qlen[v->head];
+        n = l < cap ? l : cap;
+        memcpy(buf, v->q[v->head], (size_t)n);
+        v->head = (v->head + 1) % PH_VQ;
+        v->count--;
+    } else if (v->gone) {
+        n = -1;
+    }
+    if (!v->count && !v->gone) ResetEvent(v->ev);
+    LeaveCriticalSection(&v->cs);
+    return n;
+}
+
+int padhost_dev_read(PadHostDevice* pd, unsigned char* buf, int cap, int timeout_ms)
+{
+    PhDev* d = ph_dev(pd);
+    if (!d || !buf || cap <= 0) return -1;
+    if (d->virt) {
+        ULONGLONG end = GetTickCount64() + (ULONGLONG)(timeout_ms < 0 ? 0 : timeout_ms);
+        for (;;) {
+            int n = ph_virt_pop(d->virt, buf, cap);
+            if (n >= 0) {
+                InterlockedIncrement(&d->virt->consumed);
+                SetEvent(d->virt->done_ev);
+                return n;
+            }
+            if (n == -1) return -1;
+            ULONGLONG now = GetTickCount64();
+            if (now >= end) return -1;
+            WaitForSingleObject(d->virt->ev, (DWORD)(end - now));
+        }
+    }
+    if (s_exiting) return -1;         /* close() only writes; no stack I/O on that path */
+    /* Exactly one report: given a bigger buffer, a HID read returns as many
+     * queued reports as fit, back to back. */
+    int need = d->pub.in_len > 0 ? d->pub.in_len : cap;
+    unsigned char stackbuf[1024];
+    unsigned char* tmp = need <= (int)sizeof stackbuf ? stackbuf : (unsigned char*)malloc((size_t)need);
+    if (!tmp) return -1;
+    OVERLAPPED ov;
+    DWORD got = 0;
+    int r = -1;
+    memset(&ov, 0, sizeof ov);
+    ov.hEvent = d->io_ev;
+    ResetEvent(d->io_ev);
+    if (ReadFile(d->pub.handle, tmp, (DWORD)need, NULL, &ov) || GetLastError() == ERROR_IO_PENDING) {
+        if (ph_wait_ov(d, &ov, d->io_ev, (DWORD)(timeout_ms < 0 ? 0 : timeout_ms), &got) == 0) {
+            r = (int)got < cap ? (int)got : cap;
+            memcpy(buf, tmp, (size_t)r);
+        }
+    } else {
+        d->last_err = GetLastError();
+    }
+    if (tmp != stackbuf) free(tmp);
+    return r;
+}
+
+int padhost_dev_write(PadHostDevice* pd, const unsigned char* buf, int len)
+{
+    PhDev* d = ph_dev(pd);
+    if (!d || !buf || len <= 0) return -1;
+    if (s_cfg.readonly) return -1;
+    if (d->virt) {
+        PhVirt* v = d->virt;
+        EnterCriticalSection(&v->cs);
+        v->outlen = len < PH_VREP ? len : PH_VREP;
+        memcpy(v->out, buf, (size_t)v->outlen);
+        v->outcount++;
+        LeaveCriticalSection(&v->cs);
+        return len;
+    }
+    if (!d->can_write) return -1;
+    /* WriteFile wants the longest output report's length (Windows pads
+     * nothing itself); the report id in buf[0] tells the device which one. */
+    int n = len < d->pub.out_len ? d->pub.out_len : len;
+    unsigned char stackbuf[1024];
+    unsigned char* tmp = stackbuf;
+    OVERLAPPED stack_ov;
+    OVERLAPPED* ov = &stack_ov;
+    if (s_exiting) {
+        if (s_exit_io_stuck || n > (int)sizeof s_exit_buf) return -1;
+        tmp = s_exit_buf;
+        ov = &s_exit_ov;
+    } else if (n > (int)sizeof stackbuf) {
+        tmp = (unsigned char*)malloc((size_t)n);
+        if (!tmp) return -1;
+    }
+    memcpy(tmp, buf, (size_t)len);
+    memset(tmp + len, 0, (size_t)(n - len));
+    int ok = 0;
+    DWORD got = 0;
+    memset(ov, 0, sizeof *ov);
+    ov->hEvent = d->wr_ev;
+    ResetEvent(d->wr_ev);
+    if (pd->out_set_report) {
+        /* The device drops interrupt-pipe output silently (WriteFile would
+         * "succeed"): control pipe only. */
+        ok = ph_ioctl(d, PH_IOCTL_SET_OUTPUT, tmp, (DWORD)n, NULL, 0, NULL, PH_WRITE_TIMEOUT) == 0;
+        if (tmp != stackbuf && tmp != s_exit_buf) free(tmp);
+        return ok ? len : -1;
+    }
+    if (WriteFile(d->pub.handle, tmp, (DWORD)n, NULL, ov) || GetLastError() == ERROR_IO_PENDING)
+        ok = ph_wait_ov(d, ov, d->wr_ev, s_exiting ? 100 : PH_WRITE_TIMEOUT, &got) == 0;
+    else
+        d->last_err = GetLastError();
+    /* Some drivers (the Sony sixaxis one among them) take output reports only
+     * on the control pipe. */
+    if (!ok && d->last_err != ERROR_DEVICE_NOT_CONNECTED && !(s_exiting && d->last_err == ERROR_TIMEOUT)) {
+        DWORD werr = d->last_err;
+        ok = ph_ioctl(d, PH_IOCTL_SET_OUTPUT, tmp, (DWORD)n, NULL, 0, NULL, PH_WRITE_TIMEOUT) == 0;
+        if (s_cfg.log && !s_exiting)
+            padhost_logf("%s: WriteFile failed (%lu), SET_OUTPUT_REPORT %s (%lu)", d->pub.name,
+                         (unsigned long)werr, ok ? "worked" : "failed too", (unsigned long)d->last_err);
+    }
+    if (tmp != stackbuf && tmp != s_exit_buf) free(tmp);
+    return ok ? len : -1;
+}
+
+int padhost_dev_get_feature(PadHostDevice* pd, unsigned char* buf, int len)
+{
+    PhDev* d = ph_dev(pd);
+    if (!d || !buf || len <= 0) return -1;
+    if (d->virt) {
+        PhVirt* v = d->virt;
+        int r = -1;
+        EnterCriticalSection(&v->cs);
+        for (int i = 0; i < v->nfeat; i++) {
+            if (v->feat[i].len > 0 && v->feat[i].data[0] == buf[0]) {
+                r = v->feat[i].len < len ? v->feat[i].len : len;
+                memcpy(buf, v->feat[i].data, (size_t)r);
+                break;
+            }
+        }
+        LeaveCriticalSection(&v->cs);
+        return r;
+    }
+    DWORD got = 0;
+    if (ph_ioctl(d, PH_IOCTL_GET_FEATURE, NULL, 0, buf, (DWORD)len, &got, PH_FEATURE_TIMEOUT) < 0) {
+        PH_VLOG("%s: get feature 0x%02X (%d bytes) failed (%lu)", d->pub.name, buf[0], len, (unsigned long)d->last_err);
+        return -1;
+    }
+    if (got == 0) got = (DWORD)len;
+    else if (buf[0] == 0 && (int)got < len) got++;   /* unnumbered: the count excludes the id byte */
+    return (int)got;
+}
+
+int padhost_dev_set_feature(PadHostDevice* pd, const unsigned char* buf, int len)
+{
+    PhDev* d = ph_dev(pd);
+    if (!d || !buf || len <= 0) return -1;
+    if (s_cfg.readonly) return -1;
+    if (d->virt) {
+        PhVirt* v = d->virt;
+        EnterCriticalSection(&v->cs);
+        v->fsetlen = len < PH_VREP ? len : PH_VREP;
+        memcpy(v->fset, buf, (size_t)v->fsetlen);
+        v->fsetcount++;
+        LeaveCriticalSection(&v->cs);
+        return len;
+    }
+    if (ph_ioctl(d, PH_IOCTL_SET_FEATURE, (void*)(uintptr_t)buf, (DWORD)len, NULL, 0, NULL, PH_FEATURE_TIMEOUT) < 0) {
+        PH_VLOG("%s: set feature 0x%02X (%d bytes) failed (%lu)", d->pub.name, buf[0], len, (unsigned long)d->last_err);
+        return -1;
+    }
+    return len;
+}
+
+/* ---------------------------------------------------------------------------
+ * Device thread
+ * -----------------------------------------------------------------------*/
+
+static void ph_hex(char* out, size_t n, const unsigned char* p, int len, int max)
+{
+    size_t o = 0;
+    out[0] = 0;
+    for (int i = 0; i < len && i < max && o + 4 < n; i++)
+        o += (size_t)snprintf(out + o, n - o, "%02X ", p[i]);
+    if (len > max && o + 4 < n) snprintf(out + o, n - o, "...");
+}
+
+static void ph_dev_report(PhDev* d, const unsigned char* rep, int n)
+{
+    InterlockedIncrement(&d->reports);
+    if (d->dump_left > 0 && s_cfg.log) {
+        char hex[400];
+        d->dump_left--;
+        ph_hex(hex, sizeof hex, rep, n, 96);
+        padhost_logf("%s: report (%d bytes) %s", d->pub.name, n, hex);
+    }
+    if (!d->drv->parse) return;
+    int r = d->drv->parse(&d->pub, rep, n, &d->raw);
+    if (r < 0 && !d->idle) {
+        /* A receiver (DS4 USB wireless adapter) whose controller went away:
+         * the port goes back until a controller reports through it again. */
+        AcquireSRWLockExclusive(&s_lock);
+        InterlockedExchange(&d->idle, 1);
+        int p = (int)d->port_v;
+        if (p >= 0 && s_port[p].dev == d) ph_unbind(p);
+        ph_dup_reeval();
+        ReleaseSRWLockExclusive(&s_lock);
+        padhost_logf("%s: no controller behind the receiver%s", d->pub.name, p >= 0 ? ", port released" : "");
+        padhost_state_neutral(&d->raw);
+        return;
+    }
+    if (r != 1) return;
+    d->last_in = GetTickCount64();
+    if (d->silent) {
+        d->silent = 0;
+        padhost_logf("%s: reports again", d->pub.name);
+    }
+    if (d->idle) {
+        AcquireSRWLockExclusive(&s_lock);
+        InterlockedExchange(&d->idle, 0);
+        d->connect_seq = ++s_connect_seq;
+        int held = (int)s_hold_ports;
+        int p = (int)d->port_v < 0 && !held && !ph_virt_deferred(d->vsrc) ? ph_pick_port(d->ident) : -1;
+        if (p >= 0) ph_bind(p, d, -1, d->ident);
+        if (!held) ph_dup_reeval();
+        ReleaseSRWLockExclusive(&s_lock);
+        if (p >= 0)     padhost_logf("port %d: %s: controller connected through the receiver", p, d->pub.name);
+        else if (!held) padhost_logf("%s: controller connected through the receiver, no free port", d->pub.name);
+    }
+    int p = (int)d->port_v;
+    if (p < 0) return;
+    ph_publish(p, d->id, &d->raw, d->kind, d->pub.bus, d->pub.vid, d->pub.pid);
+    ph_battery_note(p, d->pub.name, d->raw.battery, &d->batt_logged);
+}
+
+/* Whether the periodic refresh is due at all: the same test ph_out_service
+ * applies, so ph_out_timeout never wakes the thread for a refresh that
+ * ph_out_service will not send (rumble=0 or a motor scaled to 0, readonly,
+ * no port, a write back-off) -- that mismatch made the wait time out at 0
+ * forever: a busy loop. */
+static int ph_out_refreshing(PhDev* d, int p, ULONGLONG now)
+{
+    if (p < 0 || d->pub.out_refresh_ms <= 0 || !d->drv->build_output || s_cfg.readonly) return 0;
+    if (d->out_retry_at && now < d->out_retry_at) return 0;
+    u8 small, large;
+    ph_act_scaled(p, &small, &large);
+    return small || large;
+}
+
+static void ph_out_service(PhDev* d, ULONGLONG now)
+{
+    int p = (int)d->port_v;
+    /* Nothing is sent from here: a deferred change (out_due) is void too, or
+     * ph_out_timeout keeps returning 0 for it (a receiver gone idle right
+     * after a rate-limited change spun until a controller came back). */
+    if (!d->drv->build_output || s_cfg.readonly || p < 0) { d->out_due = 0; return; }
+    /* A receiver that went idle and came back on the same port (DS4 USB
+     * adapter) has a controller behind it that never saw our LEDs. */
+    if (InterlockedExchange(&d->rebound, 0)) d->sent_port = -1;
+    u8 small, large;
+    ph_act_scaled(p, &small, &large);
+    int changed = p != d->sent_port || small != d->sent_small || large != d->sent_large;
+    int refresh = d->pub.out_refresh_ms > 0 && (small || large) &&
+                  now - d->last_out >= (ULONGLONG)d->pub.out_refresh_ms;
+    if (!changed && !refresh) { d->out_due = 0; return; }
+    if (d->out_retry_at && now < d->out_retry_at) { d->out_due = 0; return; }
+    if (d->last_out && now - d->last_out < PH_OUT_MIN_MS) { d->out_due = d->last_out + PH_OUT_MIN_MS; return; }
+    unsigned char buf[1024];
+    memset(buf, 0, sizeof buf);
+    int n = d->drv->build_output(&d->pub, small, large, p, buf, (int)sizeof buf);
+    d->sent_port = p; d->sent_small = small; d->sent_large = large;
+    d->last_out = now; d->out_due = 0;
+    if (n <= 0) return;
+    if (n > (int)sizeof buf) n = (int)sizeof buf;
+    if (padhost_dev_write(&d->pub, buf, n) < 0) {
+        /* A Bluetooth link can drop a few writes; back off instead of giving up. */
+        if (++d->out_fail >= 5) {
+            if (d->out_fail == 5) padhost_logf("port %d %s: output reports failing (error %lu), retrying every 2 s",
+                                               p, d->pub.name, (unsigned long)d->last_err);
+            d->out_retry_at = now + 2000;
+            d->sent_port = -1;            /* resend everything once it works again */
+        }
+    } else {
+        if (d->out_fail >= 5) padhost_logf("port %d %s: output reports working again", p, d->pub.name);
+        d->out_fail = 0;
+        d->out_retry_at = 0;
+    }
+}
+
+/* A streaming Bluetooth pad that stops reporting without disconnecting
+ * (battery dead, out of range) can stay present on Windows, its read just
+ * pending, until the link supervision timeout or a failed write -- SDL
+ * tickles the stack after 500 ms without a report, DS4Windows writes an
+ * output report after a 3 s read timeout. Meanwhile the port would hold the
+ * last state: a stick or button stuck on. So after PH_SILENT_MS the port's
+ * input is released (still connected) and the output is re-sent once a
+ * second, which lets the stack notice a dead link. */
+static void ph_silence_check(PhDev* d, ULONGLONG now)
+{
+    if (d->pub.bus != PADHOST_BUS_BT || !d->pub.streams || !d->last_in || now - d->last_in < PH_SILENT_MS)
+        return;
+    if (!d->silent) {
+        d->silent = 1;
+        int p = (int)d->port_v;
+        if (p >= 0) {
+            PadHostPortState n = d->raw;
+            n.buttons = 0; n.ps = 0;
+            n.lx = n.ly = n.rx = n.ry = 128;
+            memset(n.press, 0, sizeof n.press);
+            n.has_motion = 0;
+            ph_publish(p, d->id, &n, d->kind, d->pub.bus, d->pub.vid, d->pub.pid);
+            padhost_logf("port %d %s: no reports for %u ms, input released", p, d->pub.name,
+                         (unsigned)(now - d->last_in));
+        }
+    }
+    if (now - d->last_nudge >= PH_SILENT_MS) {
+        d->last_nudge = now;
+        d->sent_port = -1;            /* ph_out_service writes the output again */
+    }
+}
+
+static DWORD ph_out_timeout(PhDev* d, ULONGLONG now)
+{
+    ULONGLONG to = PH_OUT_TICK_MS;
+    if (d->out_due) to = d->out_due > now ? d->out_due - now : 0;
+    int p = (int)d->port_v;
+    if (ph_out_refreshing(d, p, now)) {
+        ULONGLONG due = d->last_out + (ULONGLONG)d->pub.out_refresh_ms;
+        ULONGLONG t = due > now ? due - now : 0;
+        if (t < to) to = t;
+    }
+    if (d->out_retry_at && d->out_retry_at > now && d->out_retry_at - now < to) to = d->out_retry_at - now;
+    return (DWORD)to;
+}
+
+static int ph_read_begin(PhDev* d)
+{
+    if (d->virt) return 0;
+    ResetEvent(d->rd_ev);
+    memset(&d->rd_ov, 0, sizeof d->rd_ov);
+    d->rd_ov.hEvent = d->rd_ev;
+    if (!ReadFile(d->pub.handle, d->rdbuf, (DWORD)d->rdcap, NULL, &d->rd_ov)) {
+        DWORD e = GetLastError();
+        if (e != ERROR_IO_PENDING) { d->gone_err = e; return -1; }
+    }
+    return 0;
+}
+
+/* bytes, -2 still pending / nothing yet, -1 device gone */
+static int ph_read_end(PhDev* d)
+{
+    if (d->virt) {
+        int n = ph_virt_pop(d->virt, d->rdbuf, d->rdcap);
+        if (n == -1) d->gone_err = ERROR_DEVICE_NOT_CONNECTED;
+        return n;
+    }
+    DWORD got = 0;
+    if (!GetOverlappedResult(d->pub.handle, &d->rd_ov, &got, FALSE)) {
+        DWORD e = GetLastError();
+        if (e == ERROR_IO_INCOMPLETE) return -2;
+        d->gone_err = e;
+        return -1;
+    }
+    return (int)got;
+}
+
+static void ph_dev_loop(PhDev* d)
+{
+    int pending = 0;
+    for (;;) {
+        if (!pending) {
+            if (ph_read_begin(d) < 0) { d->gone = 1; break; }
+            pending = 1;
+        }
+        HANDLE w[3] = { d->stop_ev, d->wake_ev, d->virt ? d->virt->ev : d->rd_ev };
+        DWORD r = WaitForMultipleObjects(3, w, FALSE, ph_out_timeout(d, GetTickCount64()));
+        if (r == WAIT_OBJECT_0) break;
+        if (r == WAIT_OBJECT_0 + 2) {
+            int n = ph_read_end(d);
+            if (n == -1) { pending = 0; d->gone = 1; break; }
+            if (n != -2) {
+                pending = 0;
+                if (n > 0) ph_dev_report(d, d->rdbuf, n);
+                if (d->virt) {
+                    InterlockedIncrement(&d->virt->consumed);
+                    SetEvent(d->virt->done_ev);
+                }
+            }
+        } else if (r == WAIT_FAILED) {
+            Sleep(1);
+        }
+        ph_silence_check(d, GetTickCount64());
+        ph_out_service(d, GetTickCount64());
+    }
+    if (pending && !d->virt) {
+        DWORD got;
+        CancelIoEx(d->pub.handle, &d->rd_ov);
+        GetOverlappedResult(d->pub.handle, &d->rd_ov, &got, TRUE);
+    }
+}
+
+static void ph_make_ident(PhDev* d)
+{
+    if (d->pub.serial[0]) {
+        char s[64];
+        ph_norm(d->pub.serial, s, sizeof s);
+        snprintf(d->ident, sizeof d->ident, "%04x:%04x:%s", d->pub.vid, d->pub.pid, s);
+    } else {
+        ph_norm(d->pathbuf, d->ident, sizeof d->ident);
+    }
+}
+
+/* Windows asking for a device we hold open -- a disable in Device Manager, a
+ * driver update, DsHidMini switching modes all remove or restart it -- is
+ * vetoed by an open handle ("restart required"). So on QUERYREMOVE the device
+ * thread stops (motors off, LEDs released, port freed) and the handle is
+ * closed before this returns; the path is then left alone for
+ * PH_QREMOVE_HOLD_MS (gone by then if the removal went ahead, re-opened if
+ * something else vetoed it). Runs on a system thread; ph_dev_free unregisters
+ * first, which waits for a callback still running, so d outlives it. */
+static DWORD CALLBACK ph_cm_handle_callback(HCMNOTIFICATION h, PVOID ctx, CM_NOTIFY_ACTION action,
+                                            PCM_NOTIFY_EVENT_DATA data, DWORD size)
+{
+    (void)h; (void)data; (void)size;
+    PhDev* d = (PhDev*)ctx;
+    if (action == CM_NOTIFY_ACTION_DEVICEQUERYREMOVE) {
+        InterlockedExchange(&d->qremove, 1);
+        InterlockedCompareExchange(&d->stop_req, PH_STOP_REMOVED, PH_STOP_NONE);
+        SetEvent(d->stop_ev);
+        /* The thread closes the handle itself once it sees qremove; if it had
+         * already finished without seeing it, close it here. */
+        if (WaitForSingleObject(d->closed_ev, 3000) == WAIT_OBJECT_0 && d->pub.handle) {
+            CloseHandle(d->pub.handle);
+            d->pub.handle = NULL;
+        }
+    } else if (action == CM_NOTIFY_ACTION_DEVICEQUERYREMOVEFAILED) {
+        if (s_ev_rescan) SetEvent(s_ev_rescan);
+    }
+    return ERROR_SUCCESS;
+}
+
+static void ph_watch_handle(PhDev* d)
+{
+    CM_NOTIFY_FILTER f;
+    memset(&f, 0, sizeof f);
+    f.cbSize = sizeof f;
+    f.FilterType = CM_NOTIFY_FILTER_TYPE_DEVICEHANDLE;
+    f.u.DeviceHandle.hTarget = d->pub.handle;
+    if (CM_Register_Notification(&f, d, ph_cm_handle_callback, &d->cm_handle) != CR_SUCCESS) d->cm_handle = NULL;
+}
+
+/* The device thread is done with the handle: after a query-remove it closes
+ * it now (Windows is waiting for that), else ph_dev_free does. */
+static void ph_dev_done(PhDev* d)
+{
+    if (d->qremove && d->pub.handle && !d->virt) {
+        CloseHandle(d->pub.handle);
+        d->pub.handle = NULL;
+    }
+    if (d->closed_ev) SetEvent(d->closed_ev);
+}
+
+static DWORD WINAPI ph_dev_thread(LPVOID arg)
+{
+    PhDev* d = (PhDev*)arg;
+    ph_name_thread(L"padhost-device");
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+
+    int rc = d->drv->open ? d->drv->open(&d->pub) : 0;
+    if (rc != 0 || d->stop_req) {
+        if (rc == PADHOST_OPEN_DECLINED) {
+            d->declined = 1;
+            PH_VLOG("%s (%s %04X:%04X): not used by %s", d->pub.name, padhost_bus_name(d->pub.bus),
+                    d->pub.vid, d->pub.pid, d->drv->name);
+        } else if (rc != 0) {
+            padhost_logf("%s (%s %04X:%04X): %s open failed (%d, last error %lu)", d->pub.name,
+                         padhost_bus_name(d->pub.bus), d->pub.vid, d->pub.pid, d->drv->name, rc,
+                         (unsigned long)d->last_err);
+        } else if (d->drv->close) {
+            d->drv->close(&d->pub);
+        }
+        ph_dev_done(d);
+        InterlockedExchange(&d->state, rc != 0 ? DEV_FAILED : DEV_DEAD);
+        SetEvent(s_ev_mgr);
+        return 0;
+    }
+    ph_make_ident(d);
+    d->opened_ms = GetTickCount64();
+
+    char note[400];
+    int has_note = 0;
+    AcquireSRWLockExclusive(&s_lock);
+    d->connect_seq = ++s_connect_seq;
+    PhDev* twin = ph_twin_on_port(d);
+    int twin_port = twin ? (int)twin->port_v : -1;
+    int held = (int)s_hold_ports;
+    /* A virtual pad gets its port (or none) from ph_dup_reeval, below. */
+    int p = (twin || held || ph_virt_deferred(d->vsrc)) ? -1 : ph_pick_port(d->ident);
+    InterlockedExchange(&d->state, DEV_RUNNING);
+    if (p >= 0) {
+        ph_bind(p, d, -1, d->ident);
+        has_note = ph_port0_note(p, ph_dev_rank(d), note, sizeof note);
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+
+    if (p >= 0) padhost_logf("port %d: %s connected (%s, %s %04X:%04X)", p, d->pub.name, d->drv->name,
+                             padhost_bus_name(d->pub.bus), d->pub.vid, d->pub.pid);
+    else if (twin_port >= 0)
+        padhost_logf("%s connected over %s too: it stays on port %d over the other link, this one takes over "
+                     "when that goes", d->pub.name, padhost_bus_name(d->pub.bus), twin_port);
+    else if (held)
+        PH_VLOG("%s opened; it gets its port at the end of the startup scan", d->pub.name);
+    else if (ph_virt_deferred(d->vsrc))
+        padhost_logf("%s connected (%s %04X:%04X): a virtual pad (%s: %s)", d->pub.name,
+                     padhost_bus_name(d->pub.bus), d->pub.vid, d->pub.pid, ph_vsrc_name(d->vsrc), ph_vsrc_who(d->vsrc));
+    else        padhost_logf("%s connected, but all %d ports are taken: it waits for a free one",
+                             d->pub.name, PADHOST_MAX_PORTS);
+    if (has_note) padhost_logf("%s", note);
+    if (!held) {
+        /* A physical pad hides its virtual copy (and takes its port); a
+         * virtual one is hidden or given a port. */
+        AcquireSRWLockExclusive(&s_lock);
+        ph_dup_reeval();
+        ReleaseSRWLockExclusive(&s_lock);
+    }
+    PH_VLOG("%s: ident %s, path %s, in/out/feature %d/%d/%d bytes%s%s", d->pub.name, d->ident, d->pathbuf,
+            d->pub.in_len, d->pub.out_len, d->pub.feat_len, d->can_write ? "" : ", read-only",
+            d->cm_handle ? ", removal notifications on" : "");
+    SetEvent(s_ev_mgr);
+
+    ph_dev_loop(d);
+
+    if (!d->gone && d->drv->close && !s_cfg.readonly)
+        d->drv->close(&d->pub);       /* motors off, LEDs released */
+    if (d->stop_req != PH_STOP_SHUTDOWN) {
+        char where[16] = "";
+        if (d->port_v >= 0) snprintf(where, sizeof where, "port %d: ", (int)d->port_v);
+        if (d->qremove)
+            padhost_logf("%s%s released: Windows is disabling, updating or restarting it", where, d->pub.name);
+        else if (d->stop_req == PH_STOP_BACKEND)
+            padhost_logf("%s%s released (backend off)", where, d->pub.name);
+        else if (d->gone)
+            padhost_logf("%s%s disconnected (error %lu)", where, d->pub.name, (unsigned long)d->gone_err);
+        else
+            padhost_logf("%s%s disconnected", where, d->pub.name);
+    }
+    ph_dev_done(d);
+    AcquireSRWLockExclusive(&s_lock);
+    /* DEAD first, or the port it frees is handed straight back to it as to a
+     * device waiting for one. The reaper cannot free it before the unlock. */
+    InterlockedExchange(&d->state, DEV_DEAD);
+    p = (int)d->port_v;
+    if (p >= 0 && s_port[p].dev == d) ph_unbind(p);
+    d->pub.port = -1;
+    InterlockedExchange(&d->port_v, -1);
+    ph_dup_reeval();                  /* a hidden copy of it takes over */
+    ReleaseSRWLockExclusive(&s_lock);
+    SetEvent(s_ev_mgr);
+    return 0;
+}
+
+static void ph_dev_free(PhDev* d)
+{
+    if (!d) return;
+    /* First: it waits for a ph_cm_handle_callback still running on d. */
+    if (d->cm_handle) CM_Unregister_Notification(d->cm_handle);
+    if (d->thread) CloseHandle(d->thread);
+    if (d->pub.handle) CloseHandle(d->pub.handle);
+    if (d->pub.preparsed) HidD_FreePreparsedData((PHIDP_PREPARSED_DATA)d->pub.preparsed);
+    HANDLE evs[6] = { d->stop_ev, d->wake_ev, d->rd_ev, d->wr_ev, d->io_ev, d->closed_ev };
+    for (int i = 0; i < 6; i++) if (evs[i]) CloseHandle(evs[i]);
+    if (d->virt) {
+        DeleteCriticalSection(&d->virt->cs);
+        if (d->virt->ev) CloseHandle(d->virt->ev);
+        if (d->virt->done_ev) CloseHandle(d->virt->done_ev);
+        free(d->virt);
+    }
+    free(d->rdbuf);
+    free(d);
+}
+
+static PhDev* ph_dev_new(const PadHostDriver* drv, int in_len)
+{
+    PhDev* d = (PhDev*)calloc(1, sizeof *d);
+    if (!d) return NULL;
+    d->drv = drv;
+    d->kind = drv->kind;
+    d->id = (int)InterlockedIncrement(&s_next_id);
+    d->pub.port = -1;
+    d->port_v = -1;
+    d->sent_port = -1;
+    d->batt_logged = 254;
+    d->dump_left = 3;
+    d->pub.path = d->pathbuf;
+    padhost_state_neutral(&d->raw);
+    d->rdcap = in_len > 0 ? in_len : 64;   /* one report per read, see padhost_dev_read */
+    d->rdbuf = (unsigned char*)calloc(1, (size_t)d->rdcap);
+    d->stop_ev = CreateEventW(NULL, TRUE, FALSE, NULL);
+    d->wake_ev = CreateEventW(NULL, FALSE, FALSE, NULL);
+    d->rd_ev   = CreateEventW(NULL, TRUE, FALSE, NULL);
+    d->wr_ev   = CreateEventW(NULL, TRUE, FALSE, NULL);
+    d->io_ev   = CreateEventW(NULL, TRUE, FALSE, NULL);
+    d->closed_ev = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!d->rdbuf || !d->stop_ev || !d->wake_ev || !d->rd_ev || !d->wr_ev || !d->io_ev || !d->closed_ev) {
+        ph_dev_free(d);
+        return NULL;
+    }
+    return d;
+}
+
+/* s_lock exclusive */
+static int ph_dev_add(PhDev* d)
+{
+    for (int i = 0; i < PH_MAX_DEVS; i++)
+        if (!s_devs[i]) { s_devs[i] = d; return 0; }
+    return -1;
+}
+
+static int ph_dev_start(PhDev* d)
+{
+    InterlockedExchange(&d->state, DEV_OPENING);
+    d->thread = CreateThread(NULL, 0, ph_dev_thread, d, 0, NULL);
+    if (!d->thread) { InterlockedExchange(&d->state, DEV_FAILED); return -1; }
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * HID enumeration
+ * -----------------------------------------------------------------------*/
+
+static int ph_drv_count(const PadHostDriver** out, int max)
+{
+    const PadHostDriver* builtin[] = { &padhost_drv_ds3, &padhost_drv_ds4, &padhost_drv_dualsense,
+                                       &padhost_drv_switchpro, &padhost_drv_generic };
+    int n = 0;
+    for (unsigned i = 0; i < sizeof builtin / sizeof builtin[0] && n < max; i++)
+        if (builtin[i]->name && builtin[i]->match) out[n++] = builtin[i];
+    LONG ne = s_nextra;
+    for (LONG i = 0; i < ne && n < max; i++)
+        if (s_extra[i] && s_extra[i]->match) out[n++] = s_extra[i];
+    return n;
+}
+
+int padhost_drivers(const PadHostDriver** out, int max)
+{
+    return ph_drv_count(out, max);
+}
+
+int padhost_register_driver(const PadHostDriver* drv)
+{
+    if (!drv || !drv->match) return -1;
+    ph_global_once();
+    LONG i = InterlockedIncrement(&s_nextra) - 1;
+    if (i >= PH_MAX_EXTRA_DRV) { InterlockedDecrement(&s_nextra); return -1; }
+    s_extra[i] = drv;
+    ph_request_reconfig();
+    return 0;
+}
+
+static void ph_lower(char* s) { for (; *s; s++) if (*s >= 'A' && *s <= 'Z') *s = (char)(*s - 'A' + 'a'); }
+
+static int ph_bus_of(const char* lower_path, DEVINST inst)
+{
+    DEVINST cur = inst;
+    for (int depth = 0; depth < 5 && inst; depth++) {
+        DEVINST parent;
+        if (CM_Get_Parent(&parent, cur, 0) != CR_SUCCESS) break;
+        cur = parent;
+        WCHAR id[256];
+        if (CM_Get_Device_IDW(cur, id, 256, 0) != CR_SUCCESS) break;
+        if (!_wcsnicmp(id, L"USB\\", 4)) return PADHOST_BUS_USB;
+        if (!_wcsnicmp(id, L"BTHENUM\\", 8) || !_wcsnicmp(id, L"BTHLEDEVICE\\", 12) ||
+            !_wcsnicmp(id, L"BTHLE\\", 6) || !_wcsnicmp(id, L"BTHPS3BUS\\", 10))
+            return PADHOST_BUS_BT;
+    }
+    if (strstr(lower_path, "{00001124-0000-1000-8000-00805f9b34fb}") ||
+        strstr(lower_path, "{00001812-0000-1000-8000-00805f9b34fb}"))
+        return PADHOST_BUS_BT;
+    if (strstr(lower_path, "hid#vid_")) return PADHOST_BUS_USB;
+    return PADHOST_BUS_OTHER;
+}
+
+static void ph_wide_to_utf8(const WCHAR* w, char* out, int n)
+{
+    if (!WideCharToMultiByte(CP_UTF8, 0, w, -1, out, n, NULL, NULL)) out[0] = 0;
+    out[n - 1] = 0;
+}
+
+/* A device node's registry property (a REG_MULTI_SZ joined with '|'), lower case. */
+static void ph_cm_lower(DEVINST inst, ULONG prop, char* out, int n)
+{
+    WCHAR w[512];
+    ULONG len = sizeof w - sizeof w[0], type = 0;
+    out[0] = 0;
+    memset(w, 0, sizeof w);
+    if (CM_Get_DevNode_Registry_PropertyW(inst, prop, &type, w, &len, 0) != CR_SUCCESS) return;
+    int nw = (int)(len / sizeof w[0]);
+    if (nw > 511) nw = 511;
+    w[nw] = 0;
+    for (int i = 0; i + 1 < nw; i++)
+        if (!w[i] && w[i + 1]) w[i] = L'|';
+    ph_wide_to_utf8(w, out, n);
+    ph_lower(out);
+}
+
+/* Virtual-duplicates test over a device's ancestors, itself first (see
+ * ph_vsrc_step). */
+static int ph_vsrc_of(DEVINST inst)
+{
+    DEVINST cur = inst;
+    for (int depth = 0; depth < 12; depth++) {
+        WCHAR wid[256];
+        char id[256], hw[512], svc[64];
+        if (CM_Get_Device_IDW(cur, wid, 256, 0) != CR_SUCCESS) break;
+        ph_wide_to_utf8(wid, id, sizeof id);
+        ph_lower(id);
+        ph_cm_lower(cur, CM_DRP_HARDWAREID, hw, sizeof hw);
+        ph_cm_lower(cur, CM_DRP_SERVICE, svc, sizeof svc);
+        int r = ph_vsrc_step(depth, id, hw, svc);
+        if (r >= 0) return r;
+        DEVINST parent;
+        if (CM_Get_Parent(&parent, cur, 0) != CR_SUCCESS) break;
+        cur = parent;
+    }
+    return PH_VSRC_NONE;
+}
+
+/* XInput slots -> their XUSB devices: each XUSB interface's LED state is the
+ * player number the driver gave it (= the XInput slot). */
+typedef struct {
+    int vsrc[PH_XSLOTS], known[PH_XSLOTS];
+    int unmatched_virtual, unmatched_physical;   /* XUSB devices whose LED could not be read */
+    int vsrc_unmatched;                          /* what the first unmatched virtual one is */
+} PhXusbMap;
+
+static const GUID ph_guid_xusb = { 0xEC87F1E3, 0xC13B, 0x4100, { 0xB5, 0xF7, 0x8B, 0x84, 0xD5, 0x42, 0x60, 0xCB } };
+
+/* One read-only XUSB request, bounded: a wedged device must not stall the XInput thread. */
+static int ph_xusb_ioctl(HANDLE h, HANDLE ev, DWORD code, void* in, DWORD inlen, void* out, DWORD outlen)
+{
+    OVERLAPPED ov;
+    DWORD got = 0;
+    memset(&ov, 0, sizeof ov);
+    ov.hEvent = ev;
+    ResetEvent(ev);
+    if (!DeviceIoControl(h, code, in, inlen, out, outlen, NULL, &ov) && GetLastError() != ERROR_IO_PENDING) return -1;
+    if (WaitForSingleObject(ev, 250) != WAIT_OBJECT_0) {
+        CancelIoEx(h, &ov);
+        GetOverlappedResult(h, &ov, &got, TRUE);
+        return -1;
+    }
+    if (!GetOverlappedResult(h, &ov, &got, FALSE)) return -1;
+    return (int)got;
+}
+
+static void ph_xusb_map(PhXusbMap* m)
+{
+    memset(m, 0, sizeof *m);
+    HDEVINFO set = SetupDiGetClassDevsW(&ph_guid_xusb, NULL, NULL, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
+    if (set == INVALID_HANDLE_VALUE) return;
+    HANDLE ev = CreateEventW(NULL, TRUE, FALSE, NULL);
+    union { SP_DEVICE_INTERFACE_DETAIL_DATA_W det; unsigned char raw[2048]; } u;
+    for (DWORD i = 0; ev && i < 64; i++) {
+        SP_DEVICE_INTERFACE_DATA ifd;
+        SP_DEVINFO_DATA dinfo;
+        memset(&ifd, 0, sizeof ifd);
+        ifd.cbSize = sizeof ifd;
+        if (!SetupDiEnumDeviceInterfaces(set, NULL, &ph_guid_xusb, i, &ifd)) break;
+        memset(&dinfo, 0, sizeof dinfo);
+        dinfo.cbSize = sizeof dinfo;
+        u.det.cbSize = sizeof u.det;
+        if (!SetupDiGetDeviceInterfaceDetailW(set, &ifd, &u.det, sizeof u, NULL, &dinfo)) continue;
+        int vs = ph_vsrc_of(dinfo.DevInst), read = 0;
+        HANDLE h = CreateFileW(u.det.DevicePath, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                               NULL, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+        if (h != INVALID_HANDLE_VALUE) {
+            unsigned char info[12];
+            memset(info, 0, sizeof info);
+            int devs = ph_xusb_ioctl(h, ev, PH_IOCTL_XUSB_INFO, NULL, 0, info, sizeof info) >= 3 ? info[2] : 1;
+            if (devs < 1) devs = 1;
+            if (devs > PH_XSLOTS) devs = PH_XSLOTS;
+            for (int dv = 0; dv < devs; dv++) {
+                unsigned char in[3] = { 0x01, 0x01, (unsigned char)dv }, out[3] = { 0, 0, 0 };
+                if (ph_xusb_ioctl(h, ev, PH_IOCTL_XUSB_LED, in, 3, out, 3) < 3) continue;
+                read = 1;
+                int s = ph_led_slot(out[2]);
+                if (s >= 0) { m->known[s] = 1; m->vsrc[s] = vs; }
+                if (s_cfg.log) {
+                    char path[160];
+                    ph_wide_to_utf8(u.det.DevicePath, path, sizeof path);
+                    padhost_logf("XUSB %s: device %d LED %u -> XInput pad %d%s", path, dv, out[2], s,
+                                 vs ? " (virtual)" : "");
+                }
+            }
+            CloseHandle(h);
+        }
+        if (!read) {
+            if (!vs) m->unmatched_physical++;
+            else if (!m->unmatched_virtual++) m->vsrc_unmatched = vs;
+        }
+    }
+    if (ev) CloseHandle(ev);
+    SetupDiDestroyDeviceInfoList(set);
+}
+
+static void ph_hid_strings(HANDLE h, char* name, int nn, char* serial, int ns)
+{
+    WCHAR w[128];
+    memset(w, 0, sizeof w);
+    if (name && HidD_GetProductString(h, w, sizeof w - sizeof w[0])) ph_wide_to_utf8(w, name, nn);
+    memset(w, 0, sizeof w);
+    if (serial && HidD_GetSerialNumberString(h, w, sizeof w - sizeof w[0])) ph_wide_to_utf8(w, serial, ns);
+}
+
+/* s_lock exclusive */
+static PhKnown* ph_known_find(const char* path)
+{
+    for (int i = 0; i < s_nknown; i++)
+        if (!_stricmp(s_known[i].path, path)) return &s_known[i];
+    return NULL;
+}
+
+/* prev_tries: failures so far of a device that was opened again from a
+ * KN_FAILED entry (ph_probe drops the entry when it opens the device, so the
+ * count would otherwise restart at 1 and a device its driver refuses was
+ * re-opened every 300 ms forever, the list reprinted each time); -1 = none. */
+static void ph_known_note_ex(const char* path, int status, const char* why, int bus, u16 vid, u16 pid,
+                             u16 up, u16 usage, const char* name, DWORD err, int prev_tries)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    PhKnown* k = ph_known_find(path);
+    if (!k && s_nknown < PH_MAX_KNOWN) {
+        k = &s_known[s_nknown++];
+        memset(k, 0, sizeof *k);
+        snprintf(k->path, sizeof k->path, "%s", path);
+    }
+    if (k) {
+        int was = k->status;
+        int changed = was != status || strcmp(k->why, why) != 0;
+        k->status = status; k->bus = bus; k->vid = vid; k->pid = pid; k->up = up; k->usage = usage;
+        k->err = err; k->seen = 1;
+        snprintf(k->why, sizeof k->why, "%s", why);
+        if (name) snprintf(k->name, sizeof k->name, "%s", name);
+        if (status == KN_FAILED || status == KN_NOACCESS) {
+            static const unsigned back[] = { 300, 2000, 5000, 10000, 10000 };
+            ULONGLONG now = GetTickCount64();
+            k->tries = prev_tries >= 0 ? prev_tries + 1 : (was == status) ? k->tries + 1 : 1;
+            /* After those, a game controller another program holds
+             * (DS4Windows, DsHidMini's exclusive mode) is still looked at
+             * every 30 s, so closing that program brings the pad back; one
+             * that fails, or that never told us what it is, waits for a
+             * replug. */
+            k->retry_at = k->tries <= 5 ? now + back[k->tries - 1] :
+                          status == KN_NOACCESS && usage ? now + PH_NOACCESS_RETRY_MS : 0;
+        }
+        /* Retries of the same failure do not reprint the device list. */
+        if (status >= KN_UNCLAIMED && prev_tries <= 0 && changed) InterlockedExchange(&s_list_dirty, 1);
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+/* A device let go for Windows (query-remove): its path is not probed again
+ * for PH_QREMOVE_HOLD_MS -- gone by then, or the removal was vetoed by
+ * someone else and it is opened again. */
+static void ph_known_hold(const PhDev* d)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    PhKnown* k = ph_known_find(d->pathbuf);
+    if (!k && s_nknown < PH_MAX_KNOWN) {
+        k = &s_known[s_nknown++];
+        memset(k, 0, sizeof *k);
+        snprintf(k->path, sizeof k->path, "%s", d->pathbuf);
+    }
+    if (k) {
+        k->status = KN_NOACCESS; k->bus = d->pub.bus; k->vid = d->pub.vid; k->pid = d->pub.pid;
+        k->up = d->pub.usage_page; k->usage = d->pub.usage; k->err = 0; k->seen = 1; k->tries = 0;
+        snprintf(k->why, sizeof k->why, "being removed");
+        snprintf(k->name, sizeof k->name, "%s", d->pub.name);
+        k->retry_at = GetTickCount64() + PH_QREMOVE_HOLD_MS;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+static void ph_known_note(const char* path, int status, const char* why, int bus, u16 vid, u16 pid,
+                          u16 up, u16 usage, const char* name, DWORD err)
+{
+    ph_known_note_ex(path, status, why, bus, vid, pid, up, usage, name, err, -1);
+}
+
+static void ph_probe(const WCHAR* wpath, const char* path, DEVINST inst)
+{
+    char lower[512];
+    snprintf(lower, sizeof lower, "%s", path);
+    ph_lower(lower);
+
+    /* A device that has just arrived may refuse even this for a moment:
+     * retried with the backoff rather than written off. */
+    HANDLE h = CreateFileW(wpath, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    if (h == INVALID_HANDLE_VALUE) {
+        ph_known_note(path, KN_NOACCESS, "not ready", PADHOST_BUS_OTHER, 0, 0, 0, 0, NULL, GetLastError());
+        return;
+    }
+    HIDD_ATTRIBUTES a;
+    HIDP_CAPS caps;
+    PHIDP_PREPARSED_DATA pp = NULL;
+    memset(&a, 0, sizeof a);
+    memset(&caps, 0, sizeof caps);
+    a.Size = sizeof a;
+    int ok = HidD_GetAttributes(h, &a) && HidD_GetPreparsedData(h, &pp) &&
+             HidP_GetCaps(pp, &caps) == HIDP_STATUS_SUCCESS;
+    int game = ok && caps.UsagePage == 0x01 &&
+               (caps.Usage == 0x04 || caps.Usage == 0x05 || caps.Usage == 0x08);
+    if (!ok) {
+        if (pp) HidD_FreePreparsedData(pp);
+        CloseHandle(h);
+        ph_known_note(path, KN_NOACCESS, "not ready", PADHOST_BUS_OTHER, 0, 0, 0, 0, NULL, GetLastError());
+        return;
+    }
+    if (!game) {
+        if (pp) HidD_FreePreparsedData(pp);
+        CloseHandle(h);
+        ph_known_note(path, KN_NOTGAME, "", PADHOST_BUS_OTHER, a.VendorID, a.ProductID,
+                      caps.UsagePage, caps.Usage, NULL, 0);
+        return;
+    }
+    char name[64] = "", serial[64] = "";
+    int bus = ph_bus_of(lower, inst);
+    u16 vid = a.VendorID, pid = a.ProductID;
+
+    /* Before the string requests: they are requests to the device (a GATT
+     * read for a Bluetooth LE Xbox pad, slow when it is asleep), and XInput
+     * pads are not ours anyway. */
+    if (strstr(lower, "&ig_") || (vid == 0x045E && caps.Usage == 0x05)) {
+        CloseHandle(h);
+        if (pp) HidD_FreePreparsedData(pp);
+        ph_known_note(path, KN_XINPUT, "via XInput", bus, vid, pid, caps.UsagePage, caps.Usage, name, 0);
+        return;
+    }
+    ph_hid_strings(h, name, sizeof name, serial, sizeof serial);
+    CloseHandle(h);
+
+    PadHostDevice probe;
+    memset(&probe, 0, sizeof probe);
+    probe.bus = bus; probe.vid = vid; probe.pid = pid; probe.version = a.VersionNumber;
+    probe.usage_page = caps.UsagePage; probe.usage = caps.Usage;
+    probe.in_len = caps.InputReportByteLength; probe.out_len = caps.OutputReportByteLength;
+    probe.feat_len = caps.FeatureReportByteLength;
+    probe.preparsed = pp; probe.path = path; probe.port = -1;
+    snprintf(probe.serial, sizeof probe.serial, "%s", serial);
+    snprintf(probe.name, sizeof probe.name, "%s", name);
+
+    const PadHostDriver* drvs[PH_MAX_EXTRA_DRV + 8];
+    int nd = ph_drv_count(drvs, (int)(sizeof drvs / sizeof drvs[0]));
+    const PadHostDriver* best = NULL;
+    const PadHostDriver* off = NULL;
+    int best_score = 0, off_score = 0;
+    for (int i = 0; i < nd; i++) {
+        int s = drvs[i]->match(&probe);
+        if (s <= 0) continue;
+        if (padhost_backend_enabled(drvs[i]->kind)) {
+            if (s > best_score) { best = drvs[i]; best_score = s; }
+        } else if (s > off_score) { off = drvs[i]; off_score = s; }
+    }
+    HidD_FreePreparsedData(pp);
+    probe.preparsed = NULL;
+    if (!best) {
+        if (off) {
+            char why[40];
+            snprintf(why, sizeof why, "backend off: %s", off->name);
+            ph_known_note(path, KN_DISABLED, why, bus, vid, pid, caps.UsagePage, caps.Usage, name, 0);
+        }
+        else     ph_known_note(path, KN_UNCLAIMED, caps.Usage == 0x08 ? "multi-axis: needs a map line" : "no driver",
+                               bus, vid, pid, caps.UsagePage, caps.Usage, name, 0);
+        return;
+    }
+    if (caps.InputReportByteLength == 0) {
+        ph_known_note(path, KN_UNCLAIMED, "no input report", bus, vid, pid, caps.UsagePage, caps.Usage, name, 0);
+        return;
+    }
+
+    int can_write = 1;
+    h = CreateFileW(wpath, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                    OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+    if (h == INVALID_HANDLE_VALUE) {
+        can_write = 0;
+        h = CreateFileW(wpath, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                        OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+    }
+    if (h == INVALID_HANDLE_VALUE) {
+        DWORD e = GetLastError();
+        AcquireSRWLockShared(&s_lock);
+        PhKnown* kn = ph_known_find(path);
+        int again = kn && kn->status == KN_NOACCESS && kn->err == e;   /* said so already */
+        ReleaseSRWLockShared(&s_lock);
+        ph_known_note(path, KN_NOACCESS, e == ERROR_SHARING_VIOLATION ? "in use (exclusive)" :
+                      e == ERROR_ACCESS_DENIED ? "access denied" : "open failed",
+                      bus, vid, pid, caps.UsagePage, caps.Usage, name, e);
+        if (!again)
+            padhost_logf("%s (%04X:%04X): cannot open it (error %lu)%s", name[0] ? name : "controller", vid, pid,
+                         (unsigned long)e, e == ERROR_SHARING_VIOLATION
+                             ? " -- another program (DS4Windows/DsHidMini exclusive mode?) holds it" : "");
+        return;
+    }
+    PhDev* d = ph_dev_new(best, caps.InputReportByteLength);
+    if (!d) { CloseHandle(h); return; }
+    d->pub = probe;
+    d->pub.path = d->pathbuf;
+    snprintf(d->pathbuf, sizeof d->pathbuf, "%s", path);
+    d->pub.handle = h;
+    d->pub.port = -1;
+    d->can_write = can_write;
+    d->vsrc = ph_vsrc_of(inst);     /* e.g. DS4Windows' virtual DUALSHOCK 4 on the ViGEm bus */
+    PHIDP_PREPARSED_DATA pp2 = NULL;
+    if (HidD_GetPreparsedData(h, &pp2)) d->pub.preparsed = pp2;
+    if (!d->pub.name[0]) snprintf(d->pub.name, sizeof d->pub.name, "%s", padhost_kind_name(best->kind));
+    if (!can_write) padhost_logf("%s: opened read-only, no rumble or LEDs", d->pub.name);
+
+    AcquireSRWLockExclusive(&s_lock);
+    int added = ph_dev_add(d) == 0;
+    PhKnown* k = ph_known_find(path);
+    if (k) {                                           /* claimed now; dropped at the end of this scan */
+        if (k->status == KN_FAILED) d->fail_tries = k->tries;   /* the backoff goes on if it fails again */
+        k->status = KN_NOTGAME; k->seen = 0;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    if (!added) { ph_dev_free(d); return; }
+    ph_watch_handle(d);
+    if (ph_dev_start(d) < 0) padhost_logf("%s: cannot start its thread", d->pub.name);
+}
+
+/* Manager thread: release finished devices. A device that died with its path
+ * still present (or whose open failed) is retried with a backoff. */
+static void ph_reap(void)
+{
+    PhDev* dead[PH_MAX_DEVS];
+    int nd = 0, rescan = 0;
+    AcquireSRWLockExclusive(&s_lock);
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* d = s_devs[i];
+        if (d && (d->state == DEV_DEAD || d->state == DEV_FAILED)) { dead[nd++] = d; s_devs[i] = NULL; }
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    for (int i = 0; i < nd; i++) {
+        PhDev* d = dead[i];
+        if (d->thread) WaitForSingleObject(d->thread, 2000);
+        if (!d->virt && d->stop_req == PH_STOP_BACKEND) rescan = 1;   /* list it as "backend off" */
+        if (!d->virt && d->qremove) {
+            ph_known_hold(d);
+        } else if (!d->virt && d->declined) {
+            char why[40];
+            snprintf(why, sizeof why, "declined by %s", d->drv->name);
+            ph_known_note(d->pathbuf, KN_UNCLAIMED, why, d->pub.bus, d->pub.vid, d->pub.pid,
+                          d->pub.usage_page, d->pub.usage, d->pub.name, 0);
+        } else if (!d->virt && !d->stop_req) {
+            if (d->state == DEV_FAILED)
+                ph_known_note_ex(d->pathbuf, KN_FAILED, "open failed", d->pub.bus, d->pub.vid, d->pub.pid,
+                                 d->pub.usage_page, d->pub.usage, d->pub.name, d->last_err, d->fail_tries);
+            else if (d->gone)   /* after reports: a hiccup, start over; before any: same failure again */
+                ph_known_note_ex(d->pathbuf, KN_FAILED, "read failed", d->pub.bus, d->pub.vid, d->pub.pid,
+                                 d->pub.usage_page, d->pub.usage, d->pub.name, d->gone_err,
+                                 d->reports ? 0 : d->fail_tries);
+        }
+        ph_dev_free(d);
+    }
+    if (rescan) SetEvent(s_ev_rescan);
+}
+
+static void ph_rescan(void)
+{
+    ph_reap();
+    int reconf = (int)InterlockedExchange(&s_reconfig, 0);
+    ULONGLONG now = GetTickCount64();
+
+    AcquireSRWLockExclusive(&s_lock);
+    if (reconf) {
+        /* Backends or registered drivers changed: re-probe everything that
+         * was not claimed, and stop devices whose backend is now off. */
+        int w = 0;
+        for (int i = 0; i < s_nknown; i++)
+            if (s_known[i].status == KN_NOTGAME || s_known[i].status == KN_XINPUT) s_known[w++] = s_known[i];
+        s_nknown = w;
+        ph_dup_reeval();                   /* prefer_physical may have changed */
+    }
+    for (int i = 0; i < s_nknown; i++) s_known[i].seen = 0;
+    int seen_dev[PH_MAX_DEVS];
+    memset(seen_dev, 0, sizeof seen_dev);
+    LONG first_new_id = s_next_id + 1;     /* devices opened by this scan count as seen */
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* d = s_devs[i];
+        if (d && !d->virt && !padhost_backend_enabled(d->kind) && !d->stop_req) {
+            InterlockedExchange(&d->stop_req, PH_STOP_BACKEND);
+            SetEvent(d->stop_ev);
+        }
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+
+    int seen = 0, probed = 0;
+    if (ph_hid_allowed()) {
+        GUID hid;
+        HidD_GetHidGuid(&hid);
+        HDEVINFO set = SetupDiGetClassDevsW(&hid, NULL, NULL, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
+        if (set != INVALID_HANDLE_VALUE) {
+            union { SP_DEVICE_INTERFACE_DETAIL_DATA_W det; unsigned char raw[4096]; } u;
+            for (DWORD i = 0; ; i++) {
+                SP_DEVICE_INTERFACE_DATA ifd;
+                SP_DEVINFO_DATA dinfo;
+                memset(&ifd, 0, sizeof ifd);
+                ifd.cbSize = sizeof ifd;
+                if (!SetupDiEnumDeviceInterfaces(set, NULL, &hid, i, &ifd)) break;
+                memset(&dinfo, 0, sizeof dinfo);
+                dinfo.cbSize = sizeof dinfo;
+                u.det.cbSize = sizeof u.det;
+                if (!SetupDiGetDeviceInterfaceDetailW(set, &ifd, &u.det, sizeof u, NULL, &dinfo)) continue;
+                char path[512];
+                ph_wide_to_utf8(u.det.DevicePath, path, sizeof path);
+
+                int known = 0, retry = 0;
+                AcquireSRWLockExclusive(&s_lock);
+                for (int k = 0; k < PH_MAX_DEVS; k++) {
+                    PhDev* d = s_devs[k];
+                    if (d && !d->virt && !_stricmp(d->pathbuf, path) && d->state != DEV_DEAD && d->state != DEV_FAILED) {
+                        seen_dev[k] = 1;
+                        known = 1;
+                    }
+                }
+                if (!known) {
+                    PhKnown* kn = ph_known_find(path);
+                    if (kn) {
+                        kn->seen = 1;
+                        known = 1;
+                        if ((kn->status == KN_FAILED || kn->status == KN_NOACCESS) && kn->retry_at && now >= kn->retry_at)
+                            retry = 1;
+                    }
+                }
+                ReleaseSRWLockExclusive(&s_lock);
+                if (!known || retry) { ph_probe(u.det.DevicePath, path, dinfo.DevInst); probed++; }
+                seen++;
+            }
+            SetupDiDestroyDeviceInfoList(set);
+            PH_VLOG("scan: %d HID collections, %d probed", seen, probed);
+        }
+    }
+
+    AcquireSRWLockExclusive(&s_lock);
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* d = s_devs[i];
+        if (d && !d->virt && !seen_dev[i] && d->id < first_new_id &&
+            (d->state == DEV_RUNNING || d->state == DEV_OPENING) && !d->stop_req) {
+            InterlockedExchange(&d->stop_req, PH_STOP_REMOVED);   /* its interface is gone */
+            SetEvent(d->stop_ev);
+        }
+    }
+    int w = 0;
+    for (int i = 0; i < s_nknown; i++) {
+        if (s_known[i].seen) s_known[w++] = s_known[i];
+        else if (s_known[i].status >= KN_UNCLAIMED) InterlockedExchange(&s_list_dirty, 1);
+    }
+    s_nknown = w;
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+/* ---------------------------------------------------------------------------
+ * XInput
+ * -----------------------------------------------------------------------*/
+
+static void ph_xinput_load(void)
+{
+    if (s_x.dll) return;
+    static const WCHAR* names[] = { L"xinput1_4.dll", L"xinput1_3.dll", L"xinput9_1_0.dll" };
+    for (unsigned i = 0; i < sizeof names / sizeof names[0] && !s_x.dll; i++)
+        s_x.dll = LoadLibraryW(names[i]);
+    if (!s_x.dll) { padhost_logf("XInput not available"); return; }
+    /* XInputGetStateEx (ordinal 100) is XInputGetState plus the Guide button. */
+    PFN_XGetState ex = (PFN_XGetState)(void*)GetProcAddress(s_x.dll, (LPCSTR)(uintptr_t)100);
+    s_x.get = ex ? ex : (PFN_XGetState)(void*)GetProcAddress(s_x.dll, "XInputGetState");
+    s_x.has_guide = ex != NULL;
+    s_x.set = (PFN_XSetState)(void*)GetProcAddress(s_x.dll, "XInputSetState");
+    s_x.batt = (PFN_XGetBattery)(void*)GetProcAddress(s_x.dll, "XInputGetBatteryInformation");
+    s_x.caps_ex = (PFN_XGetCapsEx)(void*)GetProcAddress(s_x.dll, (LPCSTR)(uintptr_t)108);
+    if (!s_x.get) { FreeLibrary(s_x.dll); s_x.dll = NULL; return; }
+    PH_VLOG("XInput loaded (Guide button %s, VID/PID %s, battery %s)", s_x.has_guide ? "yes" : "no",
+            s_x.caps_ex ? "yes" : "no", s_x.batt ? "yes" : "no");
+}
+
+static u8 ph_xaxis(SHORT v, int invert)
+{
+    int x = (int)v;
+    int r = (x >= 0 ? x + 128 : x - 128) / 256;        /* rounded, -128..128 */
+    int o = invert ? 128 - r : 128 + r;
+    return (u8)(o < 0 ? 0 : o > 255 ? 255 : o);
+}
+
+static void ph_xinput_state(const XINPUT_GAMEPAD* g, PadHostPortState* st)
+{
+    static const struct { WORD x; u16 ps3; } map[] = {
+        { XINPUT_GAMEPAD_BACK, 1u << 0 },           { XINPUT_GAMEPAD_LEFT_THUMB, 1u << 1 },
+        { XINPUT_GAMEPAD_RIGHT_THUMB, 1u << 2 },    { XINPUT_GAMEPAD_START, 1u << 3 },
+        { XINPUT_GAMEPAD_DPAD_UP, 1u << 4 },        { XINPUT_GAMEPAD_DPAD_RIGHT, 1u << 5 },
+        { XINPUT_GAMEPAD_DPAD_DOWN, 1u << 6 },      { XINPUT_GAMEPAD_DPAD_LEFT, 1u << 7 },
+        { XINPUT_GAMEPAD_LEFT_SHOULDER, 1u << 10 }, { XINPUT_GAMEPAD_RIGHT_SHOULDER, 1u << 11 },
+        { XINPUT_GAMEPAD_Y, 1u << 12 },             { XINPUT_GAMEPAD_B, 1u << 13 },
+        { XINPUT_GAMEPAD_A, 1u << 14 },             { XINPUT_GAMEPAD_X, 1u << 15 },
+    };
+    u16 b = 0;
+    for (unsigned i = 0; i < sizeof map / sizeof map[0]; i++)
+        if (g->wButtons & map[i].x) b |= map[i].ps3;
+    LONG thr = s_cfg.trig_thresh;
+    if (g->bLeftTrigger > thr)  b |= 1u << 8;    /* L2 */
+    if (g->bRightTrigger > thr) b |= 1u << 9;    /* R2 */
+    st->buttons = b;
+    st->ps = (g->wButtons & 0x0400) ? 1 : 0;     /* Guide, from XInputGetStateEx */
+    st->lx = ph_xaxis(g->sThumbLX, 0);
+    st->ly = ph_xaxis(g->sThumbLY, 1);
+    st->rx = ph_xaxis(g->sThumbRX, 0);
+    st->ry = ph_xaxis(g->sThumbRY, 1);
+    static const u16 pbit[10] = { 1u << 5, 1u << 7, 1u << 4, 1u << 6, 1u << 12, 1u << 13,
+                                  1u << 14, 1u << 15, 1u << 10, 1u << 11 };
+    for (int i = 0; i < 10; i++) st->press[i] = (b & pbit[i]) ? 255 : 0;
+    st->press[PADHOST_PRESS_L2] = g->bLeftTrigger;
+    st->press[PADHOST_PRESS_R2] = g->bRightTrigger;
+    st->has_pressure = 0;
+    st->has_motion = 0;
+}
+
+static void ph_xinput_battery(int i, ULONGLONG now)
+{
+    PhXSlot* x = &s_x.slot[i];
+    x->last_batt = now;
+    if (!s_x.batt) return;
+    XINPUT_BATTERY_INFORMATION bi;
+    memset(&bi, 0, sizeof bi);
+    if (s_x.batt((DWORD)i, BATTERY_DEVTYPE_GAMEPAD, &bi) != ERROR_SUCCESS) return;
+    x->wired = bi.BatteryType == BATTERY_TYPE_WIRED;
+    if (bi.BatteryType == BATTERY_TYPE_WIRED || bi.BatteryType == BATTERY_TYPE_DISCONNECTED ||
+        bi.BatteryType == BATTERY_TYPE_UNKNOWN) { x->battery = 255; return; }
+    static const u8 lv[4] = { 5, 30, 65, 100 };
+    x->battery = lv[bi.BatteryLevel & 3];
+}
+
+/* Whether connected XInput slot `slot` (caps VID/PID) is a virtual pad, and
+ * what made it; *known = matched to its device (else a deduction). */
+static int ph_xinput_vsrc(int slot, u16 vid, u16 pid, int* known)
+{
+    *known = 0;
+    if (vid == 0x28DE) { *known = 1; return PH_VSRC_STEAM; }      /* Valve: a Steam Input pad */
+    if (s_x.classify) return s_x.classify(slot, vid, pid, known);
+    PhXusbMap m;
+    ph_xusb_map(&m);
+    if (m.known[slot]) { *known = 1; return m.vsrc[slot]; }
+    /* No XUSB device lit for this player (an Xbox pad on Bluetooth, which
+     * XInput reads through HID, or the LED could not be read): virtual only
+     * when every XInput device there is virtual and none is on Bluetooth. */
+    int bt = 0, phys = m.unmatched_physical;
+    for (int s = 0; s < PH_XSLOTS; s++) if (m.known[s] && !m.vsrc[s]) phys++;
+    AcquireSRWLockShared(&s_lock);
+    for (int i = 0; i < s_nknown; i++)
+        if (s_known[i].status == KN_XINPUT && s_known[i].bus == PADHOST_BUS_BT) bt = 1;
+    ReleaseSRWLockShared(&s_lock);
+    return m.unmatched_virtual && !phys && !bt ? m.vsrc_unmatched : PH_VSRC_NONE;
+}
+
+static void ph_xinput_connect(int i, ULONGLONG now)
+{
+    PhXSlot* x = &s_x.slot[i];
+    PhXCapsEx ce;
+    memset(&ce, 0, sizeof ce);
+    x->vid = 0x045E; x->pid = 0;
+    if (s_x.caps_ex && s_x.caps_ex(1, (DWORD)i, 0, &ce) == ERROR_SUCCESS) { x->vid = ce.vid; x->pid = ce.pid; }
+    x->battery = 255;
+    x->batt_logged = 254;
+    ph_xinput_battery(i, now);
+    padhost_state_neutral(&x->raw);
+    x->packet = 0xFFFFFFFFu;
+    x->sent_act = 0;
+    int known = 0;
+    int vs = ph_xinput_vsrc(i, x->vid, x->pid, &known);
+    char id[16];
+    snprintf(id, sizeof id, "xinput#%d", i);
+    AcquireSRWLockExclusive(&s_lock);
+    x->connected = 1;
+    x->port = -1;
+    x->vsrc = vs; x->vknown = known; x->hidden = 0;
+    x->connect_seq = ++s_connect_seq;
+    int p = ph_virt_deferred(vs) ? -1 : ph_pick_port(id);   /* a virtual pad's port: ph_dup_reeval, below */
+    char note[400];
+    int has_note = 0;
+    if (p >= 0) {
+        ph_bind(p, NULL, i, id);
+        has_note = ph_port0_note(p, 0, note, sizeof note);
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    if (p >= 0) padhost_logf("port %d: XInput pad %d connected (%04X:%04X, %s)%s%s", p, i, x->vid, x->pid,
+                             x->wired ? "wired" : "wireless", vs ? ", a virtual pad: " : "", ph_vsrc_name(vs));
+    else if (ph_virt_deferred(vs)) padhost_logf("XInput pad %d connected (%04X:%04X, %s): a virtual pad (%s: %s)%s", i, x->vid,
+                              x->pid, x->wired ? "wired" : "wireless", ph_vsrc_name(vs), ph_vsrc_who(vs),
+                              known ? "" : " -- deduced: every XInput device here is virtual");
+    else        padhost_logf("XInput pad %d connected, but all ports are taken", i);
+    if (has_note) padhost_logf("%s", note);
+    AcquireSRWLockExclusive(&s_lock);
+    ph_dup_reeval();
+    ReleaseSRWLockExclusive(&s_lock);
+    /* Not matched yet (its LED may not be set this early): one more look. */
+    if (!known && !s_x.classify) s_x.reclass_at = now + 1500;
+}
+
+static void ph_xinput_disconnect(int i, const char* why)
+{
+    PhXSlot* x = &s_x.slot[i];
+    AcquireSRWLockExclusive(&s_lock);
+    int p = x->port, was_hidden = x->hidden;
+    /* Not connected first: ph_unbind hands the freed port to whoever waits
+     * for one, and a slot still marked connected with no port looks just
+     * like that -- the port went straight back to the pad that left, and
+     * stayed "connected" for good. */
+    x->connected = 0;
+    x->hidden = 0;
+    if (p >= 0 && s_port[p].xslot == i) ph_unbind(p);
+    x->port = -1;
+    ph_dup_reeval();
+    ReleaseSRWLockExclusive(&s_lock);
+    if (p >= 0) padhost_logf("port %d: XInput pad %d %s", p, i, why);
+    else        padhost_logf("XInput pad %d %s%s", i, why, was_hidden ? " (a hidden virtual duplicate)" : "");
+}
+
+/* Devices came or went (or a slot was not matched at connect): what each
+ * connected slot is, again. A slot whose answer changed is re-decided. */
+static void ph_xinput_reclassify(void)
+{
+    int vs[PH_XSLOTS], known[PH_XSLOTS], any = 0;
+    for (int i = 0; i < PH_XSLOTS; i++) {
+        vs[i] = -1; known[i] = 0;
+        if (!s_x.slot[i].connected) continue;
+        vs[i] = ph_xinput_vsrc(i, s_x.slot[i].vid, s_x.slot[i].pid, &known[i]);
+    }
+    AcquireSRWLockExclusive(&s_lock);
+    for (int i = 0; i < PH_XSLOTS; i++) {
+        PhXSlot* x = &s_x.slot[i];
+        if (!x->connected || vs[i] < 0) continue;
+        if (!known[i] && x->vknown) continue;     /* matched before, unreadable now: its device is going */
+        x->vknown = known[i];
+        if (vs[i] == x->vsrc) continue;
+        padhost_logf("XInput pad %d (%04X:%04X): %s", i, x->vid, x->pid,
+                     vs[i] ? "a virtual pad after all" : "a physical pad after all");
+        x->vsrc = vs[i];
+        if (!vs[i]) x->hidden = 0;
+        if (!vs[i] && x->port < 0) {
+            char id[16];
+            snprintf(id, sizeof id, "xinput#%d", i);
+            int p = ph_pick_port(id);
+            if (p >= 0) { ph_bind(p, NULL, i, id); padhost_logf("port %d: XInput pad %d", p, i); }
+        }
+        any = 1;
+    }
+    if (any) ph_dup_reeval();
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+static int ph_xinput_poll(ULONGLONG now)
+{
+    int any = 0;
+    int enabled = padhost_backend_enabled(PADHOST_KIND_XINPUT);
+    int probe = now >= s_x.next_probe || InterlockedExchange(&s_x.probe_now, 0);
+    if (probe) s_x.next_probe = now + PH_XPROBE_MS;
+    int reclass = (int)InterlockedExchange(&s_x.reclass, 0);
+    if (s_x.reclass_at && now >= s_x.reclass_at) { s_x.reclass_at = 0; reclass = 1; }
+    for (int i = 0; i < PH_XSLOTS; i++) {
+        PhXSlot* x = &s_x.slot[i];
+        if (!enabled) {
+            if (x->connected) {
+                if (x->sent_act && s_x.set && !s_cfg.readonly) {   /* it would keep rumbling */
+                    XINPUT_VIBRATION v = { 0, 0 };
+                    s_x.set((DWORD)i, &v);
+                    x->sent_act = 0;
+                }
+                ph_xinput_disconnect(i, "released (backend off)");
+            }
+            continue;
+        }
+        if (!x->connected && !probe) continue;
+        struct { XINPUT_STATE s; DWORD pad[4]; } st;   /* GetStateEx may write a little more */
+        memset(&st, 0, sizeof st);
+        DWORD r = s_x.get((DWORD)i, &st.s);
+        if (r != ERROR_SUCCESS) {
+            if (x->connected) ph_xinput_disconnect(i, "disconnected");
+            continue;
+        }
+        if (!x->connected) ph_xinput_connect(i, now);
+        any = 1;
+        if (st.s.dwPacketNumber != x->packet) {
+            x->packet = st.s.dwPacketNumber;
+            ph_xinput_state(&st.s.Gamepad, &x->raw);
+            x->raw.battery = x->battery;
+            if (x->port >= 0) ph_publish(x->port, -(i + 1), &x->raw, PADHOST_KIND_XINPUT, PADHOST_BUS_OTHER, x->vid, x->pid);
+        }
+        if (now - x->last_batt >= PH_XBATT_MS) {
+            ph_xinput_battery(i, now);
+            x->raw.battery = x->battery;
+            if (x->port >= 0) ph_battery_note(x->port, "XInput pad", x->battery, &x->batt_logged);
+        }
+        if (s_x.set && x->port >= 0 && !s_cfg.readonly) {
+            u8 sm, lg;
+            ph_act_scaled(x->port, &sm, &lg);
+            LONG want = sm | (lg << 8);
+            if (want != x->sent_act) {
+                /* Left = low-frequency (large) motor. The DS3's small motor is
+                 * on/off at a fixed speed: full high-frequency motor. */
+                XINPUT_VIBRATION v;
+                v.wLeftMotorSpeed  = (WORD)(lg * 257);
+                v.wRightMotorSpeed = sm ? 0xFFFF : 0;
+                if (s_x.set((DWORD)i, &v) == ERROR_SUCCESS) x->sent_act = want;
+            }
+        } else if (s_x.set && x->port < 0 && x->sent_act && !s_cfg.readonly) {
+            /* it lost its port while rumbling (hidden as a duplicate): stop it */
+            XINPUT_VIBRATION v = { 0, 0 };
+            if (s_x.set((DWORD)i, &v) == ERROR_SUCCESS) x->sent_act = 0;
+        }
+    }
+    /* After the slots: one whose device just went has been let go of. */
+    if (reclass && enabled) ph_xinput_reclassify();
+    return any;
+}
+
+static DWORD WINAPI ph_xinput_thread(LPVOID unused)
+{
+    (void)unused;
+    ph_name_thread(L"padhost-xinput");
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+    /* A high-resolution timer gives a real 4 ms period without raising the
+     * system timer resolution (Windows 10 1803+); plain timers fall back to
+     * the 15.6 ms tick, still fine for a pad. */
+    HANDLE timer = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* CREATE_WAITABLE_TIMER_HIGH_RESOLUTION */,
+                                          TIMER_ALL_ACCESS);
+    if (!timer) timer = CreateWaitableTimerW(NULL, FALSE, NULL);
+    int armed = 0;
+    for (;;) {
+        ULONGLONG now = GetTickCount64();
+        int any = ph_xinput_poll(now);
+        if (any && !armed && timer) {
+            LARGE_INTEGER due;
+            due.QuadPart = -(LONGLONG)PH_XPOLL_MS * 10000;
+            armed = SetWaitableTimer(timer, &due, PH_XPOLL_MS, NULL, NULL, FALSE) != 0;
+        } else if (!any && armed) {
+            CancelWaitableTimer(timer);
+            armed = 0;
+        }
+        ULONGLONG left = s_x.next_probe > now ? s_x.next_probe - now : 0;
+        HANDLE w[3] = { s_ev_xstop, s_ev_xwake, timer };
+        DWORD r = WaitForMultipleObjects(armed ? 3 : 2, w, FALSE, armed ? INFINITE : (DWORD)left);
+        if (r == WAIT_OBJECT_0) break;
+        if (r == WAIT_FAILED) Sleep(PH_XPOLL_MS);
+    }
+    if (timer) { CancelWaitableTimer(timer); CloseHandle(timer); }
+    for (int i = 0; i < PH_XSLOTS; i++) {
+        PhXSlot* x = &s_x.slot[i];
+        if (!x->connected) continue;
+        if (x->sent_act && s_x.set && !s_cfg.readonly) {
+            XINPUT_VIBRATION v = { 0, 0 };
+            s_x.set((DWORD)i, &v);
+            x->sent_act = 0;
+        }
+        AcquireSRWLockExclusive(&s_lock);
+        int p = x->port;
+        x->connected = 0;                      /* first: see ph_xinput_disconnect */
+        if (p >= 0 && s_port[p].xslot == i) ph_unbind(p);
+        x->port = -1;
+        ReleaseSRWLockExclusive(&s_lock);
+    }
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Hotplug and the manager thread
+ * -----------------------------------------------------------------------*/
+
+static DWORD CALLBACK ph_cm_callback(HCMNOTIFICATION h, PVOID ctx, CM_NOTIFY_ACTION action,
+                                     PCM_NOTIFY_EVENT_DATA data, DWORD size)
+{
+    (void)h; (void)data; (void)size;
+    if (action == CM_NOTIFY_ACTION_DEVICEINTERFACEARRIVAL || action == CM_NOTIFY_ACTION_DEVICEINTERFACEREMOVAL) {
+        if (ctx == (PVOID)1 && s_ev_rescan) SetEvent(s_ev_rescan);
+        InterlockedExchange(&s_x.probe_now, 1);
+        InterlockedExchange(&s_x.reclass, 1);     /* a remapper's virtual pad came or went */
+        if (s_ev_xwake) SetEvent(s_ev_xwake);
+    }
+    return ERROR_SUCCESS;
+}
+
+static void ph_ensure_backends(void)
+{
+    if (s_cfg.enabled && !s_cm_hid && ph_hid_allowed()) {
+        CM_NOTIFY_FILTER f;
+        memset(&f, 0, sizeof f);
+        f.cbSize = sizeof f;
+        f.FilterType = CM_NOTIFY_FILTER_TYPE_DEVICEINTERFACE;
+        HidD_GetHidGuid(&f.u.DeviceInterface.ClassGuid);
+        s_cm_ok = CM_Register_Notification(&f, (PVOID)1, ph_cm_callback, &s_cm_hid) == CR_SUCCESS;
+        if (!s_cm_ok) { s_cm_hid = NULL; padhost_logf("no hotplug notifications; rescanning every 3 s"); }
+        else PH_VLOG("hotplug notifications on (HID interface class)");
+    }
+    if (padhost_backend_enabled(PADHOST_KIND_XINPUT)) {
+        if (!s_cm_xusb) {
+            /* GUID_DEVINTERFACE_XUSB: wired 360-class pads, for a prompt re-probe */
+            static const GUID xusb = { 0xEC87F1E3, 0xC13B, 0x4100, { 0xB5, 0xF7, 0x8B, 0x84, 0xD5, 0x42, 0x60, 0xCB } };
+            CM_NOTIFY_FILTER f;
+            memset(&f, 0, sizeof f);
+            f.cbSize = sizeof f;
+            f.FilterType = CM_NOTIFY_FILTER_TYPE_DEVICEINTERFACE;
+            f.u.DeviceInterface.ClassGuid = xusb;
+            if (CM_Register_Notification(&f, (PVOID)2, ph_cm_callback, &s_cm_xusb) != CR_SUCCESS) s_cm_xusb = NULL;
+        }
+        ph_xinput_load();
+        InterlockedExchange(&s_x.probe_now, 1);
+        if (s_x_thread) SetEvent(s_ev_xwake);
+        if (s_x.dll && !s_x_thread) {
+            ResetEvent(s_ev_xstop);
+            s_x.next_probe = 0;
+            ph_xinput_poll(GetTickCount64());     /* pads present now get their ports before HID ones */
+            s_x_thread = CreateThread(NULL, 0, ph_xinput_thread, NULL, 0, NULL);
+        }
+    } else if (s_x_thread) {
+        SetEvent(s_ev_xwake);                     /* it releases its slots on the next poll */
+    }
+}
+
+static DWORD WINAPI ph_mgr_thread(LPVOID unused)
+{
+    (void)unused;
+    ph_name_thread(L"padhost-manager");
+    ph_rescan();
+    SetEvent(s_ev_initial);
+    ULONGLONG rescan_at = 0, log_at = 0, periodic_at = GetTickCount64() + 3000;
+    for (;;) {
+        ULONGLONG now = GetTickCount64();
+        ULONGLONG to = INFINITE;
+        if (rescan_at) to = rescan_at > now ? rescan_at - now : 0;
+        if (log_at) { ULONGLONG t = log_at > now ? log_at - now : 0; if (t < to) to = t; }
+        if (!s_cm_ok && ph_hid_allowed()) { ULONGLONG t = periodic_at > now ? periodic_at - now : 0; if (t < to) to = t; }
+        /* failed devices waiting for their retry */
+        AcquireSRWLockShared(&s_lock);
+        for (int i = 0; i < s_nknown; i++)
+            if ((s_known[i].status == KN_FAILED || s_known[i].status == KN_NOACCESS) && s_known[i].retry_at) {
+                ULONGLONG t = s_known[i].retry_at > now ? s_known[i].retry_at - now : 0;
+                if (t < to) to = t;
+            }
+        ReleaseSRWLockShared(&s_lock);
+
+        HANDLE w[3] = { s_ev_stop, s_ev_rescan, s_ev_mgr };
+        DWORD r = WaitForMultipleObjects(3, w, FALSE, to == INFINITE ? INFINITE : (DWORD)to);
+        if (r == WAIT_OBJECT_0) break;
+        now = GetTickCount64();
+        if (r == WAIT_OBJECT_0 + 1) {
+            if (s_reconfig) ph_ensure_backends();
+            /* Notifications come in bursts (one per interface of a device,
+             * and the device may not accept an open for a moment). */
+            rescan_at = now + 80;
+        }
+        int retry_due = 0;
+        AcquireSRWLockShared(&s_lock);
+        for (int i = 0; i < s_nknown; i++)
+            if ((s_known[i].status == KN_FAILED || s_known[i].status == KN_NOACCESS) &&
+                s_known[i].retry_at && now >= s_known[i].retry_at) retry_due = 1;
+        ReleaseSRWLockShared(&s_lock);
+        if ((rescan_at && now >= rescan_at) || retry_due || s_reconfig ||
+            (!s_cm_ok && ph_hid_allowed() && now >= periodic_at)) {
+            rescan_at = 0;
+            periodic_at = now + 3000;
+            ph_rescan();
+        }
+        ph_reap();
+        /* Changes before padhost_init has printed the startup list are in it. */
+        if (InterlockedExchange(&s_list_dirty, 0) && s_initial_done) log_at = now + 150;
+        if (log_at && now >= log_at) {
+            log_at = 0;
+            if (s_initial_done) padhost_log_devices("hotplug");
+        }
+    }
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Introspection
+ * -----------------------------------------------------------------------*/
+
+int padhost_enum_devices(PadHostDeviceInfo* out, int max)
+{
+    int n = 0;
+    AcquireSRWLockShared(&s_lock);
+    for (int i = 0; i < PH_XSLOTS; i++) {
+        PhXSlot* x = &s_x.slot[i];
+        if (!x->connected) continue;
+        if (n < max && out) {
+            PadHostDeviceInfo* o = &out[n];
+            memset(o, 0, sizeof *o);
+            o->claimed = 1; o->kind = PADHOST_KIND_XINPUT; o->bus = PADHOST_BUS_OTHER; o->port = x->port;
+            o->vid = x->vid; o->pid = x->pid; o->usage_page = 1; o->usage = 5;
+            o->battery = x->battery;
+            o->hidden = x->hidden;
+            snprintf(o->virt, sizeof o->virt, "%s", ph_vsrc_name(x->vsrc));
+            snprintf(o->driver, sizeof o->driver, "xinput");
+            snprintf(o->name, sizeof o->name, "XInput pad %d (%s)", i, x->wired ? "wired" : "wireless");
+            snprintf(o->path, sizeof o->path, "xinput#%d", i);
+        }
+        n++;
+    }
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* d = s_devs[i];
+        if (!d || (d->state != DEV_RUNNING && d->state != DEV_OPENING)) continue;
+        if (n < max && out) {
+            PadHostDeviceInfo* o = &out[n];
+            memset(o, 0, sizeof *o);
+            o->claimed = 1; o->kind = d->kind; o->bus = d->pub.bus; o->port = (int)d->port_v;
+            o->idle = (int)d->idle;
+            o->vid = d->pub.vid; o->pid = d->pub.pid; o->usage_page = d->pub.usage_page; o->usage = d->pub.usage;
+            o->battery = d->raw.battery;
+            o->hidden = (int)d->hidden;
+            snprintf(o->virt, sizeof o->virt, "%s", ph_vsrc_name(d->vsrc));
+            snprintf(o->driver, sizeof o->driver, "%s", d->drv->name);
+            snprintf(o->name, sizeof o->name, "%s", d->pub.name);
+            snprintf(o->path, sizeof o->path, "%s", d->pathbuf);
+        }
+        n++;
+    }
+    for (int i = 0; i < s_nknown; i++) {
+        PhKnown* k = &s_known[i];
+        if (k->status == KN_NOTGAME || (!k->up && !k->usage)) continue;   /* not a game controller / not known yet */
+        if (n < max && out) {
+            PadHostDeviceInfo* o = &out[n];
+            memset(o, 0, sizeof *o);
+            o->claimed = 0; o->kind = PADHOST_KIND_NONE; o->bus = k->bus; o->port = -1;
+            o->vid = k->vid; o->pid = k->pid; o->usage_page = k->up; o->usage = k->usage; o->battery = 255;
+            snprintf(o->driver, sizeof o->driver, "%s", k->why);
+            snprintf(o->name, sizeof o->name, "%s", k->name);
+            snprintf(o->path, sizeof o->path, "%s", k->path);
+        }
+        n++;
+    }
+    ReleaseSRWLockShared(&s_lock);
+    return n;
+}
+
+void padhost_log_devices(const char* why)
+{
+    enum { CAP = PH_MAX_DEVS + PH_MAX_KNOWN + PH_XSLOTS };
+    PadHostDeviceInfo* info = (PadHostDeviceInfo*)malloc(sizeof *info * CAP);
+    if (!info) return;
+    int n = padhost_enum_devices(info, CAP);
+    if (n > CAP) n = CAP;
+    int used = 0, xin = 0, sony = 0, hidden = 0;
+    for (int i = 0; i < n; i++) {
+        if (info[i].claimed && info[i].port >= 0) used++;
+        if (info[i].claimed && info[i].hidden) hidden++;
+        if (info[i].claimed && (info[i].vid == 0x054C || info[i].vid == 0x057E) && !info[i].virt[0]) sony = 1;
+    }
+    char p1[96];
+    AcquireSRWLockShared(&s_lock);
+    /* the old "seen twice?" hint: only for an XInput pad not matched to its device */
+    for (int i = 0; i < PH_XSLOTS; i++)
+        if (s_x.slot[i].connected && !s_x.slot[i].vsrc && !s_x.slot[i].vknown) xin = 1;
+    int has_p1 = ph_describe_locked(0, p1, (int)sizeof p1);
+    ReleaseSRWLockShared(&s_lock);
+    padhost_logf("controllers (%s): %d on pad ports%s", why, used,
+                 s_cfg.enabled ? "" : " -- physical controllers off (PAD_NO_HOST / controllers=0)");
+    for (int p = -1; p < PADHOST_MAX_PORTS; p++) {
+        for (int i = 0; i < n; i++) {
+            PadHostDeviceInfo* o = &info[i];
+            if (!o->claimed || o->port != p) continue;
+            char batt[16];
+            PadHostPortState st;
+            u8 b = o->battery;
+            if (p >= 0 && padhost_get(p, &st) && st.battery != 255) b = st.battery;
+            if (b == 255) snprintf(batt, sizeof batt, "-");
+            else          snprintf(batt, sizeof batt, "%u%%", b);
+            char where[24], drv[80];
+            if (p >= 0)         snprintf(where, sizeof where, "port %d", p);
+            else if (o->hidden) snprintf(where, sizeof where, "hidden");
+            else if (o->idle)   snprintf(where, sizeof where, "idle");
+            else                snprintf(where, sizeof where, "no port");
+            if (o->virt[0]) snprintf(drv, sizeof drv, "%s, virtual: %s", o->driver, o->virt);
+            else            snprintf(drv, sizeof drv, "%s", o->driver);
+            padhost_logf("  %-8s %-12s %-3s %04X:%04X  battery %-4s  %s  [%s]", where, padhost_kind_name(o->kind),
+                         padhost_bus_name(o->bus), o->vid, o->pid, batt, o->name, drv);
+        }
+    }
+    if (hidden)
+        padhost_logf("  (hidden: a remapper's virtual copy of a physical controller above -- one controller seen "
+                     "twice; it takes over if that one goes. prefer_physical = 0 in input.ini [controller] keeps it "
+                     "on a port)");
+    for (int i = 0; i < n; i++) {
+        PadHostDeviceInfo* o = &info[i];
+        if (o->claimed) continue;
+        if (!strcmp(o->driver, "via XInput") && !s_cfg.log) continue;
+        const char* what = !strcmp(o->driver, "via XInput") ? "HID side of an XInput pad" :
+                           !strcmp(o->driver, "no driver") ? "unclaimed game controller" : "not used";
+        padhost_logf("  --       %-12s %-3s %04X:%04X  %s \"%s\" (%s)", "", padhost_bus_name(o->bus),
+                     o->vid, o->pid, what, o->name, o->driver);
+    }
+    if (xin && sony)
+        padhost_logf("  (an XInput pad next to a PlayStation/Nintendo one: if that is one controller seen twice "
+                     "through Steam Input or DS4Windows, set PAD_BACKENDS=all,-xinput)");
+    if (has_p1) padhost_logf("Controller: %s on player 1", p1);
+    else        padhost_logf("Controller: none on player 1 (port 0)");
+    free(info);
+}
+
+/* ---------------------------------------------------------------------------
+ * Init / shutdown
+ * -----------------------------------------------------------------------*/
+
+static INIT_ONCE s_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK ph_once(PINIT_ONCE o, PVOID p, PVOID* c)
+{
+    (void)o; (void)p; (void)c;
+    for (int i = 0; i < PADHOST_MAX_PORTS; i++) {
+        padhost_state_neutral(&s_snap[i]);
+        s_port[i].xslot = -1;
+    }
+    for (int i = 0; i < PH_XSLOTS; i++) s_x.slot[i].port = -1;
+    s_ev_stop    = CreateEventW(NULL, TRUE, FALSE, NULL);
+    s_ev_rescan  = CreateEventW(NULL, FALSE, FALSE, NULL);
+    s_ev_mgr     = CreateEventW(NULL, FALSE, FALSE, NULL);
+    s_ev_initial = CreateEventW(NULL, TRUE, FALSE, NULL);
+    s_ev_xstop   = CreateEventW(NULL, TRUE, FALSE, NULL);
+    s_ev_xwake   = CreateEventW(NULL, FALSE, FALSE, NULL);
+    HMODULE nt = GetModuleHandleW(L"ntdll.dll");
+    if (nt) s_shutdown_in_progress = (PFN_ShutdownInProgress)(void*)GetProcAddress(nt, "RtlDllShutdownInProgress");
+    ph_config_env();
+    return TRUE;
+}
+
+static void ph_global_once(void) { InitOnceExecuteOnce(&s_once, ph_once, NULL, NULL); }
+
+static void ph_atexit(void) { padhost_shutdown(); }
+static void ph_shutdown_exiting(void);
+
+void padhost_init(void)
+{
+    ph_global_once();
+    if (InterlockedCompareExchange(&s_state, 1, 0) != 0) return;
+    InterlockedExchange(&s_quiet, 0);
+    InterlockedExchange(&s_initial_done, 0);
+    ResetEvent(s_ev_stop);
+    ResetEvent(s_ev_initial);
+    InterlockedExchange(&s_reconfig, 0);
+
+    if (!s_cfg.enabled)
+        padhost_logf("physical controllers off (PAD_NO_HOST / controllers=0)");
+    if (s_cfg.log) {
+        const PadHostDriver* dl[PH_MAX_EXTRA_DRV + 8];
+        int nd = ph_drv_count(dl, (int)(sizeof dl / sizeof dl[0]));
+        char names[256] = "";
+        for (int i = 0; i < nd; i++) {
+            size_t l = strlen(names);
+            snprintf(names + l, sizeof names - l, "%s%s%s", i ? " " : "", dl[i]->name,
+                     padhost_backend_enabled(dl[i]->kind) ? "" : "(off)");
+        }
+        padhost_logf("drivers: xinput%s %s", padhost_backend_enabled(PADHOST_KIND_XINPUT) ? "" : "(off)",
+                     nd ? names : "(no HID drivers linked)");
+    }
+    /* virtual pads: after the physical ones, below (prefer_physical) */
+    InterlockedExchange(&s_hold_virtual, s_cfg.prefer_physical ? 1 : 0);
+    ph_ensure_backends();                         /* XInput pads present now take the first ports */
+    InterlockedExchange(&s_hold_ports, 1);        /* HID ones get theirs by rank, below */
+    s_mgr_thread = CreateThread(NULL, 0, ph_mgr_thread, NULL, 0, NULL);
+
+    /* Return with the controllers that are plugged in now open and on their
+     * ports (titles look at GetInfo right after cellPadInit), each with its
+     * first report in if it comes quickly. */
+    ULONGLONG t0 = GetTickCount64();
+    if (s_mgr_thread) WaitForSingleObject(s_ev_initial, 2000);
+    for (;;) {
+        int busy = 0;
+        ULONGLONG now = GetTickCount64();
+        AcquireSRWLockShared(&s_lock);
+        for (int i = 0; i < PH_MAX_DEVS; i++) {
+            PhDev* d = s_devs[i];
+            if (!d || d->virt) continue;
+            if (d->state == DEV_OPENING) busy = 1;
+            if (d->state == DEV_RUNNING && d->reports == 0 && now - d->opened_ms < 150) busy = 1;
+        }
+        ReleaseSRWLockShared(&s_lock);
+        if (!busy || now - t0 > 2000) break;     /* a slower one arrives as a hotplug */
+        Sleep(5);
+    }
+    ph_release_held_ports();
+    InterlockedExchange(&s_initial_done, 1);
+    InterlockedExchange(&s_list_dirty, 0);
+    padhost_log_devices("startup");
+
+    static volatile LONG registered;
+    if (InterlockedExchange(&registered, 1) == 0) atexit(ph_atexit);
+}
+
+static int ph_exit_in_progress(void)
+{
+    if (s_shutdown_in_progress && s_shutdown_in_progress()) return 1;
+    /* Our threads were terminated without being asked: ExitProcess ran. */
+    if (s_mgr_thread && WaitForSingleObject(s_mgr_thread, 0) == WAIT_OBJECT_0 &&
+        WaitForSingleObject(s_ev_stop, 0) != WAIT_OBJECT_0)
+        return 1;
+    return 0;
+}
+
+void padhost_shutdown(void)
+{
+    if (s_state != 1) return;
+    if (ph_exit_in_progress()) { ph_shutdown_exiting(); return; }
+    if (InterlockedCompareExchange(&s_state, 2, 1) != 1) return;
+
+    if (s_cm_hid)  { CM_Unregister_Notification(s_cm_hid);  s_cm_hid = NULL; }
+    if (s_cm_xusb) { CM_Unregister_Notification(s_cm_xusb); s_cm_xusb = NULL; }
+    s_cm_ok = 0;
+
+    SetEvent(s_ev_stop);
+    if (s_mgr_thread) { WaitForSingleObject(s_mgr_thread, 3000); CloseHandle(s_mgr_thread); s_mgr_thread = NULL; }
+    SetEvent(s_ev_xstop);
+    if (s_x_thread) { WaitForSingleObject(s_x_thread, 1000); CloseHandle(s_x_thread); s_x_thread = NULL; }
+
+    /* Device threads turn their motors off and release LEDs on the way out. */
+    HANDLE th[PH_MAX_DEVS];
+    int nt = 0;
+    AcquireSRWLockExclusive(&s_lock);
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* d = s_devs[i];
+        if (!d) continue;
+        InterlockedExchange(&d->stop_req, PH_STOP_SHUTDOWN);
+        SetEvent(d->stop_ev);
+        if (d->thread) th[nt++] = d->thread;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    ULONGLONG deadline = GetTickCount64() + 2000;
+    for (int i = 0; i < nt; i++) {
+        ULONGLONG now = GetTickCount64();
+        WaitForSingleObject(th[i], now < deadline ? (DWORD)(deadline - now) : 0);
+    }
+    AcquireSRWLockExclusive(&s_lock);
+    for (int p = 0; p < PADHOST_MAX_PORTS; p++)       /* only a stuck device can still hold one */
+        if (!ph_port_free(p)) ph_unbind(p);
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* d = s_devs[i];
+        if (!d) continue;
+        if (d->thread && WaitForSingleObject(d->thread, 0) != WAIT_OBJECT_0) continue;   /* stuck: leak it */
+        s_devs[i] = NULL;
+        ph_dev_free(d);
+    }
+    s_nknown = 0;
+    ReleaseSRWLockExclusive(&s_lock);
+    InterlockedIncrement(&s_generation);
+    InterlockedExchange(&s_state, 0);
+}
+
+/* ExitProcess path: every other thread is gone and the loader lock may be
+ * held. No locks (a dead thread may own one), no waiting on threads, no stdio
+ * (a dead thread may own the stream lock): just motors off / LEDs released on
+ * the devices that were running, through the same driver close(). */
+static void ph_shutdown_exiting(void)
+{
+    if (InterlockedCompareExchange(&s_state, 2, 1) != 1) return;
+    InterlockedExchange(&s_quiet, 1);
+    InterlockedExchange(&s_exiting, 1);
+    if (s_cfg.readonly) return;
+    for (int i = 0; i < PH_MAX_DEVS; i++) {
+        PhDev* d = s_devs[i];
+        if (!d || d->state != DEV_RUNNING || d->gone) continue;
+        if (d->drv->close) d->drv->close(&d->pub);
+    }
+    if (s_x.set) {
+        for (int i = 0; i < PH_XSLOTS; i++) {
+            if (!s_x.slot[i].connected || !s_x.slot[i].sent_act) continue;
+            XINPUT_VIBRATION v = { 0, 0 };
+            s_x.set((DWORD)i, &v);
+        }
+    }
+}
+
+/* The loader calls an executable's TLS callbacks with DLL_PROCESS_DETACH when
+ * the process ends through ExitProcess, after the other threads are gone --
+ * the one hook that still runs when nobody called padhost_shutdown. */
+static void NTAPI ph_tls_callback(PVOID module, DWORD reason, PVOID reserved)
+{
+    (void)module; (void)reserved;
+    if (reason == DLL_PROCESS_DETACH && s_state == 1) ph_shutdown_exiting();
+}
+
+#if defined(_MSC_VER) && !defined(PADHOST_NO_TLS_CALLBACK)
+#  if defined(_M_IX86)
+#    pragma comment(linker, "/INCLUDE:__tls_used")
+#    pragma comment(linker, "/INCLUDE:_padhost_tls_callback")
+#  else
+#    pragma comment(linker, "/INCLUDE:_tls_used")
+#    pragma comment(linker, "/INCLUDE:padhost_tls_callback")
+#  endif
+#  pragma section(".CRT$XLP", long, read)
+extern const PIMAGE_TLS_CALLBACK padhost_tls_callback;
+__declspec(allocate(".CRT$XLP")) const PIMAGE_TLS_CALLBACK padhost_tls_callback = ph_tls_callback;
+#endif
+
+/* ---------------------------------------------------------------------------
+ * Virtual devices
+ * -----------------------------------------------------------------------*/
+
+static PhDev* ph_find_id(int id)
+{
+    for (int i = 0; i < PH_MAX_DEVS; i++)
+        if (s_devs[i] && s_devs[i]->id == id) return s_devs[i];
+    return NULL;
+}
+
+static PhDev* ph_virt_get(int id)
+{
+    AcquireSRWLockShared(&s_lock);
+    PhDev* d = ph_find_id(id);
+    if (d && !d->virt) d = NULL;
+    ReleaseSRWLockShared(&s_lock);
+    return d;
+}
+
+int padhost_virtual_prepare(const PadHostDriver* drv, int bus, u16 vid, u16 pid,
+                            const char* serial, int in_len, int out_len)
+{
+    if (!drv || s_state != 1) return -1;
+    if (in_len <= 0) in_len = 64;
+    if (out_len < 0) out_len = 64;
+    if (in_len > PH_VREP) in_len = PH_VREP;
+    PhDev* d = ph_dev_new(drv, in_len);
+    if (!d) return -1;
+    d->virt = (PhVirt*)calloc(1, sizeof *d->virt);
+    if (!d->virt) { ph_dev_free(d); return -1; }
+    InitializeCriticalSection(&d->virt->cs);
+    d->virt->ev = CreateEventW(NULL, TRUE, FALSE, NULL);
+    d->virt->done_ev = CreateEventW(NULL, FALSE, FALSE, NULL);
+    d->pub.bus = bus; d->pub.vid = vid; d->pub.pid = pid; d->pub.version = 0x0100;
+    d->pub.usage_page = 1; d->pub.usage = 5;
+    d->pub.in_len = in_len; d->pub.out_len = out_len; d->pub.feat_len = 64;
+    d->can_write = 1;
+    snprintf(d->pathbuf, sizeof d->pathbuf, "virtual:%d", d->id);
+    if (serial) snprintf(d->pub.serial, sizeof d->pub.serial, "%s", serial);
+    snprintf(d->pub.name, sizeof d->pub.name, "%s (virtual)", drv->name ? drv->name : "device");
+    AcquireSRWLockExclusive(&s_lock);
+    int ok = ph_dev_add(d) == 0;
+    ReleaseSRWLockExclusive(&s_lock);
+    if (!ok) { ph_dev_free(d); return -1; }
+    return d->id;
+}
+
+int padhost_virtual_start(int id)
+{
+    PhDev* d = ph_virt_get(id);
+    if (!d || d->state != DEV_NEW) return -1;
+    if (ph_dev_start(d) < 0) return -1;
+    ULONGLONG end = GetTickCount64() + 3000;
+    while (GetTickCount64() < end) {
+        AcquireSRWLockShared(&s_lock);       /* a failed device is reaped (freed) by the manager */
+        PhDev* e = ph_find_id(id);
+        LONG s = e ? e->state : DEV_DEAD;
+        ReleaseSRWLockShared(&s_lock);
+        if (s == DEV_RUNNING) return 0;
+        if (s == DEV_FAILED || s == DEV_DEAD) return -1;
+        Sleep(1);
+    }
+    return -1;
+}
+
+int padhost_virtual_attach(const PadHostDriver* drv, int bus, u16 vid, u16 pid,
+                           const char* serial, int in_len, int out_len)
+{
+    int id = padhost_virtual_prepare(drv, bus, vid, pid, serial, in_len, out_len);
+    if (id < 0) return -1;
+    return padhost_virtual_start(id) == 0 ? id : -1;
+}
+
+void padhost_virtual_set_feature(int id, const unsigned char* rep, int len)
+{
+    PhDev* d = ph_virt_get(id);
+    if (!d || !rep || len <= 0) return;
+    PhVirt* v = d->virt;
+    EnterCriticalSection(&v->cs);
+    int i;
+    for (i = 0; i < v->nfeat; i++) if (v->feat[i].data[0] == rep[0]) break;
+    if (i < 16) {
+        if (i == v->nfeat) v->nfeat++;
+        v->feat[i].len = len < PH_VREP ? len : PH_VREP;
+        memcpy(v->feat[i].data, rep, (size_t)v->feat[i].len);
+    }
+    LeaveCriticalSection(&v->cs);
+}
+
+int padhost_virtual_feed(int id, const unsigned char* rep, int len)
+{
+    PhDev* d = ph_virt_get(id);
+    if (!d || !rep || len <= 0) return -1;
+    PhVirt* v = d->virt;
+    /* A real HID read returns in_len bytes: zero-pad the same way. */
+    int n = len < d->pub.in_len ? d->pub.in_len : len;
+    if (n > PH_VREP) n = PH_VREP;
+    EnterCriticalSection(&v->cs);
+    if (v->count == PH_VQ) {
+        LeaveCriticalSection(&v->cs);
+        return -1;
+    }
+    int slot = (v->head + v->count) % PH_VQ;
+    memset(v->q[slot], 0, (size_t)n);
+    memcpy(v->q[slot], rep, (size_t)(len < n ? len : n));
+    v->qlen[slot] = n;
+    v->count++;
+    LONG ticket = InterlockedIncrement(&v->pushed);
+    SetEvent(v->ev);
+    LeaveCriticalSection(&v->cs);
+    ULONGLONG end = GetTickCount64() + 2000;
+    while (v->consumed < ticket) {
+        if (GetTickCount64() > end || d->state != DEV_RUNNING) return -1;
+        WaitForSingleObject(v->done_ev, 20);
+    }
+    return 0;
+}
+
+int padhost_virtual_last_output(int id, unsigned char* buf, int cap, int* count)
+{
+    PhDev* d = ph_virt_get(id);
+    if (!d) return -1;
+    PhVirt* v = d->virt;
+    EnterCriticalSection(&v->cs);
+    int n = v->outlen < cap ? v->outlen : cap;
+    if (buf && n > 0) memcpy(buf, v->out, (size_t)n);
+    if (count) *count = v->outcount;
+    LeaveCriticalSection(&v->cs);
+    return n;
+}
+
+int padhost_virtual_last_feature_set(int id, unsigned char* buf, int cap, int* count)
+{
+    PhDev* d = ph_virt_get(id);
+    if (!d) return -1;
+    PhVirt* v = d->virt;
+    EnterCriticalSection(&v->cs);
+    int n = v->fsetlen < cap ? v->fsetlen : cap;
+    if (buf && n > 0) memcpy(buf, v->fset, (size_t)n);
+    if (count) *count = v->fsetcount;
+    LeaveCriticalSection(&v->cs);
+    return n;
+}
+
+int padhost_virtual_port(int id)
+{
+    PhDev* d = ph_virt_get(id);
+    return d ? (int)d->port_v : -1;
+}
+
+void padhost_virtual_detach(int id)
+{
+    PhDev* d = ph_virt_get(id);
+    if (!d) return;
+    EnterCriticalSection(&d->virt->cs);
+    InterlockedExchange(&d->virt->gone, 1);
+    SetEvent(d->virt->ev);
+    LeaveCriticalSection(&d->virt->cs);
+    if (d->state == DEV_NEW) {
+        InterlockedExchange(&d->state, DEV_DEAD);
+        SetEvent(s_ev_mgr);
+        return;
+    }
+    ULONGLONG end = GetTickCount64() + 3000;
+    while (GetTickCount64() < end) {
+        AcquireSRWLockShared(&s_lock);
+        PhDev* e = ph_find_id(id);
+        int done = !e || e->state == DEV_DEAD;
+        ReleaseSRWLockShared(&s_lock);
+        if (done) return;
+        Sleep(1);
+    }
+}
+
+#else  /* !_WIN32: no host controllers here (cellPad uses SDL2); stubs so drivers link */
+
+int  padhost_dev_read(PadHostDevice* d, unsigned char* b, int c, int t) { (void)d; (void)b; (void)c; (void)t; return -1; }
