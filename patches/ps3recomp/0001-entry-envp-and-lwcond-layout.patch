+static void check_layouts(const ss_image* img)
+{
+    ss_reader r;
+    ss_reader_open(&r, img, FOURCC_A);
+    int64_t wide = 0;                                      /* a_int grew to 8 bytes */
+    const ss_field f1[] = { SS_FIELD_AS("a_int", wide), SS_FIELD(a_dbl), SS_FIELD(a_name), SS_FIELD(a_arr) };
+    const ss_list l1 = SS_LIST("fake_a", f1);
+    a_dbl = -1.0;
+    CHECK(ss_read_fields(&r, &l1) == SS_E_LAYOUT && strstr(ss_reader_what(&r), "fake_a.a_int: 4 bytes in the image, 8"),
+          "a size change: %s", ss_reader_what(&r));
+    CHECK(a_dbl == -1.0, "a refused read wrote a field");
+    ss_reader_open(&r, img, FOURCC_A);
+    const ss_field f2[] = { SS_FIELD(a_int), SS_FIELD(a_dbl), SS_FIELD(a_name) };   /* a_arr dropped */
+    const ss_list l2 = SS_LIST("fake_a", f2);
+    CHECK(ss_read_fields(&r, &l2) == SS_E_LAYOUT && strstr(ss_reader_what(&r), "fake_a.a_arr: in the image, not in"),
+          "a dropped field: %s", ss_reader_what(&r));
+    static int a_new;
+    ss_reader_open(&r, img, FOURCC_A);
+    const ss_field f3[] = { SS_FIELD(a_int), SS_FIELD(a_dbl), SS_FIELD(a_name), SS_FIELD(a_arr), SS_FIELD(a_new) };
+    const ss_list l3 = SS_LIST("fake_a", f3);
+    CHECK(ss_read_fields(&r, &l3) == SS_E_LAYOUT && strstr(ss_reader_what(&r), "fake_a.a_new: not in the image"),
+          "an added field: %s", ss_reader_what(&r));
+    ss_reader_open(&r, img, FOURCC_A);
+    a_new = 77;
+    const ss_field f4[] = { SS_FIELD(a_int), SS_FIELD(a_dbl), SS_FIELD(a_name), SS_FIELD(a_arr),
+                            SS_FIELD_F(a_new, SS_FF_OPTIONAL) };
+    const ss_list l4 = SS_LIST("fake_a", f4);
+    CHECK(ss_read_fields(&r, &l4) == SS_OK && a_new == 77 && a_dbl == 2.5, "an optional field: %s",
+          ss_reader_what(&r));
+    CHECK(ss_list_hash(&l1) != ss_list_hash(&k_a_list) && ss_list_hash(&l2) != ss_list_hash(&k_a_list),
+          "the list hash did not move");
+    ss_section_ops changed = k_a_ops;
+    const ss_list* const lists[] = { &l1, &k_obj_list, NULL };
+    changed.lists = lists;
+    CHECK(ss_section_layout_hash(&changed) != ss_section_layout_hash(&k_a_ops), "the section layout hash did not move");
+    ss_reader_open(&r, img, FOURCC_A);
+    const ss_field f5[] = { SS_MEMBER(obj, id), SS_MEMBER(obj, value) };   /* a record list lost "tag" */
+    const ss_list l5 = SS_LIST("objects", f5);
+    ss_recs_it it;
+    CHECK(ss_recs_open(&r, &l5, &it) == SS_E_LAYOUT && strstr(ss_reader_what(&r), "objects.tag"),
+          "a record layout change: %s", ss_reader_what(&r));
+}
