+        if (e0 == 0xFFFFFFFFu || e1 == 0xFFFFFFFFu || e1 - e0 != (u32)(o1 - o0) - 1u) { s_vr.skipped++; continue; }
+        const u32 s0 = e0, s1 = e1 + 1u;
+        int merged = 0;
+        for (int j = 0; j < nr && !merged; j++)
+            if (s0 <= rb[j] + 64u && s1 + 64u >= ra[j]) {
+                if (s0 < ra[j]) ra[j] = s0;
+                if (s1 > rb[j]) rb[j] = s1;
+                merged = 1;
+            }
+        if (!merged && nr < 16) { ra[nr] = s0; rb[nr] = s1; nr++; }
+    }
+    for (int j = 0; j < nr; j++) vr_copy(vm_base + ra[j], (u64)(rb[j] - ra[j]));
+}
+static u32 vraw_probe_run(rsx_vemit* e, const rsx_state* st, u32 prim, u32 first, u32 count,
+                          int indexed, u32 vmask)
+{
+    if (!s_vr.ring) {
+        s_vr.cap = 64ull << 20;
+        s_vr.ring = (u8*)VirtualAlloc(NULL, (SIZE_T)s_vr.cap, MEM_RESERVE | MEM_COMMIT,
+                                      PAGE_READWRITE | PAGE_WRITECOMBINE);
+        LARGE_INTEGER f, a, b;
+        QueryPerformanceFrequency(&f); QueryPerformanceCounter(&a);
+        const u64 t0 = __rdtsc();
+        Sleep(20);
+        QueryPerformanceCounter(&b);
+        const u64 t1 = __rdtsc();
+        s_vr.tsc_ms = ((double)(b.QuadPart - a.QuadPart) * 1000.0 / (double)f.QuadPart) / (double)(t1 - t0);
+        s_vr.win_t0 = t1;
+        fprintf(stderr, "[VRAW] probe on: ring %p, %.3f GHz TSC%c", (void*)s_vr.ring, 1e-6 / s_vr.tsc_ms, 10);
+    }
+    if (!s_vr.ring || !vm_base) return rsx_vemit_run(e);
+    const u32 fc = (u32)s_d3d.frame_count;
+    if (fc != s_vr.last_fc) { s_vr.last_fc = fc; s_vr.frames++; s_vr.fr[s_vr.frames & 1u]++; }
+    const int raw_first = (s_vr.frames & 1u) == 0;
+    u32 n;
+    u64 a, b, c;
+    if (raw_first) {
+        a = __rdtsc(); vr_entry(st, prim, first, count, indexed, vmask);
+        b = __rdtsc(); n = rsx_vemit_run(e); c = __rdtsc();
+        s_vr.t[1][0] += b - a; s_vr.t[0][1] += c - b;
+    } else {
+        a = __rdtsc(); n = rsx_vemit_run(e);
+        b = __rdtsc(); vr_entry(st, prim, first, count, indexed, vmask); c = __rdtsc();
+        s_vr.t[0][0] += b - a; s_vr.t[1][1] += c - b;
+    }
+    s_vr.ent++; s_vr.idx += rsx_vexpand_count(prim, count); s_vr.prim[prim <= 10u ? prim : 0]++;
+    if ((double)(c - s_vr.win_t0) * s_vr.tsc_ms >= 2000.0) {
+        const double fe = s_vr.fr[0] ? (double)s_vr.fr[0] : 1.0, fo = s_vr.fr[1] ? (double)s_vr.fr[1] : 1.0;
+        const double fn = (double)(s_vr.fr[0] + s_vr.fr[1] ? s_vr.fr[0] + s_vr.fr[1] : 1);
+        fprintf(stderr, "[VRAW] %.0f frames | per frame: vemit cold %.2f ms warm %.2f | raw cold %.2f ms warm %.2f"
+                        " | %.0f entries %.0fk indices raw %.2f MB skipped %llu | prims T%llu S%llu F%llu Q%llu other %llu%c",
+                fn, (double)s_vr.t[0][0] * s_vr.tsc_ms / fo, (double)s_vr.t[0][1] * s_vr.tsc_ms / fe,
+                (double)s_vr.t[1][0] * s_vr.tsc_ms / fe, (double)s_vr.t[1][1] * s_vr.tsc_ms / fo,
+                (double)s_vr.ent / fn, (double)s_vr.idx / fn / 1000.0, (double)s_vr.bytes / fn / 1048576.0,
+                (unsigned long long)s_vr.skipped,
+                (unsigned long long)s_vr.prim[RSX_PRIMITIVE_TRIANGLES], (unsigned long long)s_vr.prim[RSX_PRIMITIVE_TRIANGLE_STRIP],
+                (unsigned long long)s_vr.prim[RSX_PRIMITIVE_TRIANGLE_FAN], (unsigned long long)s_vr.prim[RSX_PRIMITIVE_QUADS],
+                (unsigned long long)(s_vr.ent - s_vr.prim[RSX_PRIMITIVE_TRIANGLES] - s_vr.prim[RSX_PRIMITIVE_TRIANGLE_STRIP]
+                                     - s_vr.prim[RSX_PRIMITIVE_TRIANGLE_FAN] - s_vr.prim[RSX_PRIMITIVE_QUADS]), 10);
+        memset(s_vr.t, 0, sizeof s_vr.t); memset(s_vr.fr, 0, sizeof s_vr.fr); memset(s_vr.prim, 0, sizeof s_vr.prim);
+        s_vr.ent = s_vr.idx = s_vr.bytes = s_vr.skipped = 0;
+        s_vr.win_t0 = c;
+    }
+    return n;
+}
