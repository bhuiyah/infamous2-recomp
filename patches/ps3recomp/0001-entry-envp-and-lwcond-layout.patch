new file mode 100644
index 0000000..0904e86
--- /dev/null
+++ b/tools/rpcs3_probe/rpcs3_mem.py
@@ -0,0 +1,165 @@
+"""rpcs3_mem.py: read a running RPCS3's guest memory straight from its process (Windows,
+ReadProcessMemory) -- GB/s instead of the GDB stub's ~100 KB/s.
+
+RPCS3 reserves one host region for the whole 4 GB guest address space (vm::g_base_addr)
+and commits pages in it as the title maps them, so guest EA x lives at base + x. The
+base is found by checking every allocation of 4 GB or more for the EBOOT's first text
+bytes at guest 0x10000 (--elf gives the expected bytes; without it the first candidate
+whose 0x10000 page is committed is taken).
+
+  py rpcs3_mem.py --elf EBOOT.elf --read 30400000-37D00000 --out dump.bin
+  py rpcs3_mem.py --elf EBOOT.elf --info
+Unreadable (uncommitted) pages come back as zeros.
+"""
+import argparse
+import ctypes
+import ctypes.wintypes as wt
+import struct
+import subprocess
+import sys
+
+PROCESS_QUERY_INFORMATION = 0x0400
+PROCESS_VM_READ = 0x0010
+MEM_COMMIT = 0x1000
+
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+
+class MBI(ctypes.Structure):
+    _fields_ = [("BaseAddress", ctypes.c_void_p), ("AllocationBase", ctypes.c_void_p),
+                ("AllocationProtect", wt.DWORD), ("PartitionId", wt.WORD),
+                ("RegionSize", ctypes.c_size_t), ("State", wt.DWORD), ("Protect", wt.DWORD),
+                ("Type", wt.DWORD)]
+
+
+k32.OpenProcess.restype = wt.HANDLE
+k32.VirtualQueryEx.argtypes = [wt.HANDLE, ctypes.c_void_p, ctypes.POINTER(MBI), ctypes.c_size_t]
+k32.VirtualQueryEx.restype = ctypes.c_size_t
+k32.ReadProcessMemory.argtypes = [wt.HANDLE, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t,
+                                  ctypes.POINTER(ctypes.c_size_t)]
+
+
+def rpcs3_pid():
+    out = subprocess.run(["tasklist", "/FI", "IMAGENAME eq rpcs3.exe", "/FO", "CSV", "/NH"],
+                         capture_output=True, text=True).stdout
+    for line in out.splitlines():
+        parts = [p.strip('"') for p in line.split('","')]
+        if parts and parts[0].lower() == "rpcs3.exe":
+            return int(parts[1])
+    return None
+
+
+def allocations(h):
+    """{allocation base: (span, committed regions [(addr, size)])}"""
+    allocs = {}
+    addr = 0
+    mbi = MBI()
+    while k32.VirtualQueryEx(h, ctypes.c_void_p(addr), ctypes.byref(mbi), ctypes.sizeof(mbi)):
+        base = mbi.AllocationBase or 0
+        if base:
+            span, regs = allocs.get(base, (0, []))
+            end = (mbi.BaseAddress or 0) + mbi.RegionSize
+            if mbi.State == MEM_COMMIT:
+                regs.append((mbi.BaseAddress or 0, mbi.RegionSize))
+            allocs[base] = (max(span, end - base), regs)
+        addr = (mbi.BaseAddress or 0) + mbi.RegionSize
+        if addr >= 0x7FFFFFFFFFFF:
+            break
+    return allocs
+
+
+def rpm(h, addr, n):
+    buf = ctypes.create_string_buffer(n)
+    got = ctypes.c_size_t(0)
+    if k32.ReadProcessMemory(h, ctypes.c_void_p(addr), buf, n, ctypes.byref(got)) and got.value == n:
+        return buf.raw
+    return None
+
+
+def elf_text_at(elf, ea, n):
+    f = open(elf, "rb").read()
+    phoff = struct.unpack(">Q", f[0x20:0x28])[0]
+    phn = struct.unpack(">H", f[0x38:0x3A])[0]
+    phs = struct.unpack(">H", f[0x36:0x38])[0]
+    for i in range(phn):
+        o = phoff + i * phs
+        t, _, off, va, _, fs, _, _ = struct.unpack(">IIQQQQQQ", f[o:o + 56])
+        if t == 1 and va <= ea < va + fs:
+            return f[off + ea - va: off + ea - va + n]
+    return None
+
+
+class Guest:
+    def __init__(self, elf=None, pid=None):
+        pid = pid or rpcs3_pid()
+        if not pid:
+            raise SystemExit("rpcs3.exe is not running")
+        self.h = k32.OpenProcess(PROCESS_QUERY_INFORMATION | PROCESS_VM_READ, False, pid)
+        if not self.h:
+            raise SystemExit("OpenProcess failed: %d" % ctypes.get_last_error())
+        want = elf_text_at(elf, 0x10000, 64) if elf else None
+        self.base = None
+        cands = []
+        # Each guest block is its own shared-memory view, so the main block's view (guest
+        # 0x00010000 up) is an allocation of its own: base = view - 0x10000. Older builds
+        # map one 4 GB+ view: base = view.
+        for base, (span, regs) in allocations(self.h).items():
+            for g, probe in ((base - 0x10000, base), (base, base + 0x10000)):
+                if span < 0x10000 or g < 0:
+                    continue
+                got = rpm(self.h, probe, 64)
+                if got is not None and (got == want if want else span >= 0x100000000):
+                    cands.append((g, span, True))
+        for base, span, ok in sorted(cands):
+            if ok:
+                self.base = base
+                break
+        self.cands = cands
+        if self.base is None:
+            raise SystemExit("guest base not found; candidates: %s" %
+                             ", ".join("%x(+%x)%s" % (b, s, "*" if ok else "") for b, s, ok in cands))
+
+    def read(self, ea, n, page=0x1000):
+        out = bytearray()
+        a = ea
+        while a < ea + n:
+            step = min(page - (a % page), ea + n - a)
+            d = rpm(self.h, self.base + a, step)
+            out += d if d is not None else b"\0" * step
+            a += step
+        return bytes(out)
+
+    def read_fast(self, ea, n, chunk=0x100000):
+        """Big reads; falls back to page reads for a chunk with holes."""
+        out = bytearray()
+        a = ea
+        while a < ea + n:
+            step = min(chunk, ea + n - a)
+            d = rpm(self.h, self.base + a, step)
+            out += d if d is not None else self.read(a, step)
+            a += step
+        return bytes(out)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--elf")
+    ap.add_argument("--pid", type=int)
+    ap.add_argument("--info", action="store_true")
+    ap.add_argument("--read", help="LO-HI (hex guest EAs)")
+    ap.add_argument("--out")
+    a = ap.parse_args()
+    g = Guest(a.elf, a.pid)
+    print("guest base 0x%x (candidates: %s)" % (g.base, ", ".join("%x+%x%s" % (b, s, "*" if ok else "")
+                                                                  for b, s, ok in g.cands)))
+    if a.read:
+        lo, hi = (int(x, 16) for x in a.read.split("-"))
+        data = g.read_fast(lo, hi - lo)
+        if a.out:
+            open(a.out, "wb").write(data)
+        print("read %x-%x: %d bytes, %d non-zero" % (lo, hi, len(data), len(data) - data.count(0)))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
