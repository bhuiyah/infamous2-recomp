+/* Save states (KOBJ's check and asserted_empty, ppu_sysprx.cpp): what the
+ * HLE SPURS tables hold. A title on the lifted libsre (inFamous 2) never
+ * reaches them; a save cannot hold an HLE instance, workload, task, job chain
+ * or event-flag waiter table yet (their kernel and job threads are host
+ * threads), so KOBJ refuses while any is in use. Plain reads, with every
+ * thread parked. */
+int cellSpurs_ss_live(char* why, size_t n)
+{
+    int inst = 0, wkl = 0, task = 0, jc = 0, ef = 0;
+    for (int i = 0; i < MAX_SPURS_INST; i++) inst += s_inst[i].ea != 0;
+    for (int i = 0; i < CELL_SPURS_MAX_WORKLOAD; i++) wkl += s_workloads[i].in_use != 0;
+    for (int i = 0; i < CELL_SPURS_MAX_TASK; i++) task += s_tasks[i].in_use != 0;
+    for (int i = 0; i < MAX_JOBCHAINS; i++) jc += s_jobchains[i].jc_ea != 0;
+    for (int i = 0; i < MAX_EVENT_FLAGS; i++) ef += s_ef_sync[i].ea != 0;
+    const int live = inst + wkl + task + jc + ef;
+    if (live && why && n)
+        snprintf(why, n, "HLE cellSpurs in use (%d instance(s), %d workload(s), %d task(s), %d job chain(s),"
+                         " %d event flag(s)): a save cannot hold one yet", inst, wkl, task, jc, ef);
+    return live;
+}
