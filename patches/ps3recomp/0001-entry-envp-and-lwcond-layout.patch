+static LRESULT CALLBACK d3d12_view_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg) {
+    case WM_NCHITTEST:  return HTTRANSPARENT;   /* input goes to the top-level window */
+    case WM_ERASEBKGND: return 1;               /* the swap chain covers it */
+    }
+    return DefWindowProcA(hwnd, msg, wp, lp);
+}
