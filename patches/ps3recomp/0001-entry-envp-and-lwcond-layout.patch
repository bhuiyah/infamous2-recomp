+/* Save states (M4c, KOBJ's teardown): a load leaves no sys_cond live (an
+ * image never holds one). The waiter records were on the stacks of threads
+ * the load discarded, so every list goes; and with no thread left to race a
+ * destroy, the slots' native locks go too -- the table is as at boot, and a
+ * later create initialises its slot again. */
+void sys_cond_ss_teardown(void)
+{
+    for (int i = 0; i < SYS_COND_MAX; i++) {
+        sys_cond_info* c = &g_sys_conds[i];
+        if (!c->initialized) continue;
+#ifdef _WIN32
+        DeleteCriticalSection(&c->signal_lock);
+#else
+        pthread_cond_destroy(&c->cv);
+        pthread_mutex_destroy(&c->signal_lock);
+#endif
+    }
+    memset(g_sys_conds, 0, sizeof(g_sys_conds));
+    memset(g_cond_id_addr, 0, sizeof(g_cond_id_addr));
