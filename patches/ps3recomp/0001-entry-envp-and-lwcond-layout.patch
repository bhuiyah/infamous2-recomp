+/* RSX_CAP_FILE=<path>: an on-demand trigger for RSX_CAP and VS_TRACE_ID. Unset:
+ * always armed. Set: armed from the first poll (at most every 250 ms) that
+ * finds the file, which is then deleted, so a script or a person can capture
+ * the exact moment a glitch is on screen: `echo > <path>`. */
+static int rsx_capfile_armed(void)
+{
+    static int st = -1;                 /* -1 unknown, 0 waiting, 1 armed */
+    static char path[512];
+    static ULONGLONG last;
+    if (st < 0) {
+        const char* e = getenv("RSX_CAP_FILE");
+        if (!e || !*e) { st = 1; return 1; }
+        snprintf(path, sizeof path, "%s", e);
+        DeleteFileA(path);
+        st = 0;
+        fprintf(stderr, "[RSXCAP] waiting for trigger file %s%c", path, 10);
+    }
+    if (st == 0) {
+        ULONGLONG now = GetTickCount64();
+        if (now - last < 250) return 0;
+        last = now;
+        if (GetFileAttributesA(path) == INVALID_FILE_ATTRIBUTES) return 0;
+        DeleteFileA(path);
+        st = 1;
+        fprintf(stderr, "[RSXCAP] trigger file seen: capture/trace armed (frame %llu)%c",
+                (unsigned long long)s_d3d.frame_count, 10);
+    }
+    return 1;
