diff --git a/libs/input/pad_hotkeys.h b/libs/input/pad_hotkeys.h
new file mode 100644
index 0000000..0c6001f
--- /dev/null
+++ b/libs/input/pad_hotkeys.h
@@ -0,0 +1,464 @@
+/*
+ * ps3recomp - window hotkeys: input.ini [hotkeys] (header-only)
+ *
+ * Keys the game window acts on itself and keeps from the game: save states
+ * (quick slot, slots 1..10, undo last load), borderless fullscreen, the FPS
+ * counter, the options overlay and the window menu. cellPad.c owns the table: it reads it
+ * from the same files as the keyboard bindings (input.ini, PAD_KBM) and the
+ * window procedure asks it on every WM_KEYDOWN / WM_SYSKEYDOWN
+ * (cellPad_host_hotkey); libs/video/rsx_winmenu.c carries the actions out.
+ *
+ * Two parts:
+ *   - the action ids (HK_*), always: the window menu needs only these;
+ *   - the parser, defaults, matcher and printer, when pad_kbm.h was included
+ *     before this header (the hotkeys' key names are pad_kbm.h's). It is
+ *     OS-free like pad_kbm.h; libs/input/tests/test_pad_hotkeys.c tests it.
+ *
+ * Syntax. In a [hotkeys] section the names below; anywhere else (other
+ * sections, PAD_KBM) a name needs the prefix "hotkey_", e.g.
+ * PAD_KBM="hotkey_quick_save=F6". pad_kbm.h's parser skips both.
+ *   quick_save  = F5               one or two combinations, ',' between them
+ *   save_slot_3 = Ctrl+Alt+3       modifiers Shift, Ctrl, Alt, joined by '+'
+ *   load_slots  = Ctrl+Shift+F1    all ten slots at once: slot 1's keys; slot n
+ *                                  takes the (n-1)th next key: F1 -> F2..F10,
+ *                                  1 -> 2..9, 0 (the number row), Num1 ->
+ *                                  Num2..Num9, Num0
+ *   show_fps    = none             unbound
+ *   undo_load   = Ctrl+Shift+Z     Load > Undo Last Load: back to the moment
+ *                                  before the last load
+ * A combination is exact: F5 does not fire while Shift is held, Shift+F5 does
+ * not fire without it. Giving a combination to a second action moves it there
+ * (the parser says so). Refused: mouse buttons and the wheel, a modifier on its
+ * own, the Windows keys, and what Windows or the window keep for themselves:
+ * Alt+F4 (close), Alt+Enter (fullscreen, always on), Alt+Tab, Alt+Esc,
+ * Alt+Space (system menu), Ctrl+Esc (Start menu).
+ */
+#ifndef PS3RECOMP_PAD_HOTKEYS_H
+#define PS3RECOMP_PAD_HOTKEYS_H
+
+#define HK_SLOTS 10                 /* numbered save-state slots, 1..HK_SLOTS */
+
+enum {
+    HK_NONE = 0,
+    HK_QUICK_SAVE,
+    HK_QUICK_LOAD,
+    HK_SAVE_SLOT1,                              /* slot n: HK_SAVE_SLOT1 + n - 1 */
+    HK_LOAD_SLOT1 = HK_SAVE_SLOT1 + HK_SLOTS,   /* slot n: HK_LOAD_SLOT1 + n - 1 */
+    HK_FULLSCREEN = HK_LOAD_SLOT1 + HK_SLOTS,
+    HK_SHOW_FPS,
+    HK_OPTIONS,
+    HK_MENU,                                    /* open the window menu from the keyboard */
+    HK_MARK,                                    /* note this moment in the play-session issues log */
+    HK_UNDO_LOAD,                               /* load the undo point: the moment before the last load */
+    HK_COUNT
+};
+
+/* Or'ed into cellPad_host_hotkey's result when the key press is an
+ * auto-repeat: the caller swallows it without acting again. */
+#define HK_REPEAT 0x1000
+
+#define HK_MOD_SHIFT 1
+#define HK_MOD_CTRL  2
+#define HK_MOD_ALT   4
+
+#endif /* PS3RECOMP_PAD_HOTKEYS_H */
+
+/* ------------------------------------------------------------------------
+ * Parser, defaults, matcher (needs pad_kbm.h: kbm_key_from_name & co.)
+ * ----------------------------------------------------------------------*/
+#if defined(PS3RECOMP_PAD_KBM_H) && !defined(PS3RECOMP_PAD_HOTKEYS_PARSER)
+#define PS3RECOMP_PAD_HOTKEYS_PARSER
+
+#define HK_MAX_COMBOS 2             /* combinations per action */
+#define HK_GROUP_SAVE (-2)          /* hk_action_from_name: "save_slots" */
+#define HK_GROUP_LOAD (-3)          /*                      "load_slots" */
+
+typedef struct { uint16_t vk; uint8_t mods; } HkCombo;
+
+typedef struct {
+    HkCombo c[HK_COUNT][HK_MAX_COMBOS];
+    uint8_t n[HK_COUNT];
+} HkConfig;
+
+/* The config-file name of an action: "quick_save", "save_slot_3", ... */
+static inline const char* hk_action_name(int a, char* buf, size_t n)
+{
+    if (a >= HK_SAVE_SLOT1 && a < HK_SAVE_SLOT1 + HK_SLOTS)
+        snprintf(buf, n, "save_slot_%d", a - HK_SAVE_SLOT1 + 1);
+    else if (a >= HK_LOAD_SLOT1 && a < HK_LOAD_SLOT1 + HK_SLOTS)
+        snprintf(buf, n, "load_slot_%d", a - HK_LOAD_SLOT1 + 1);
+    else {
+        const char* s = a == HK_QUICK_SAVE ? "quick_save" : a == HK_QUICK_LOAD ? "quick_load" :
+                        a == HK_FULLSCREEN ? "fullscreen" : a == HK_SHOW_FPS ? "show_fps" :
+                        a == HK_OPTIONS ? "options" : a == HK_MENU ? "menu" : a == HK_MARK ? "mark" :
+                        a == HK_UNDO_LOAD ? "undo_load" : "?";
+        snprintf(buf, n, "%s", s);
+    }
+    return buf;
+}
+
+/* An action id for a normalised name (kbm_norm), HK_GROUP_SAVE/LOAD, or -1. */
+static inline int hk_action_from_name(const char* nm)
+{
+    static const KbmName names[] = {
+        {"quicksave", HK_QUICK_SAVE}, {"quickload", HK_QUICK_LOAD},
+        {"saveslots", HK_GROUP_SAVE}, {"loadslots", HK_GROUP_LOAD},
+        {"fullscreen", HK_FULLSCREEN}, {"showfps", HK_SHOW_FPS}, {"fps", HK_SHOW_FPS},
+        {"options", HK_OPTIONS}, {"menu", HK_MENU}, {"mark", HK_MARK}, {"markproblem", HK_MARK},
+        {"undoload", HK_UNDO_LOAD}, {"undolastload", HK_UNDO_LOAD},
+    };
+    for (int i = 0; i < KBM_COUNT(names); i++)
+        if (!strcmp(nm, names[i].name)) return names[i].id;
+    int save = !strncmp(nm, "saveslot", 8), load = !strncmp(nm, "loadslot", 8);
+    if (save || load) {
+        char* end;
+        long v = strtol(nm + 8, &end, 10);
+        if (nm[8] && !*end && v >= 1 && v <= HK_SLOTS)
+            return (save ? HK_SAVE_SLOT1 : HK_LOAD_SLOT1) + (int)v - 1;
+    }
+    return -1;
+}
+
+static inline int hk_mod_of_vk(int vk)
+{
+    if (vk == 0x10 || vk == 0xA0 || vk == 0xA1) return HK_MOD_SHIFT;
+    if (vk == 0x11 || vk == 0xA2 || vk == 0xA3) return HK_MOD_CTRL;
+    if (vk == 0x12 || vk == 0xA4 || vk == 0xA5) return HK_MOD_ALT;
+    return 0;
+}
+
+/* "Ctrl+Shift+F1" etc. into *out. 1 = ok, -1 = error (message in err). */
+static inline int hk_parse_combo(const char* text, HkCombo* out, char* err, size_t errn)
+{
+    char buf[96];
+    snprintf(buf, sizeof buf, "%s", text);
+    char* p = kbm_trim(buf);
+    if (!*p) { snprintf(err, errn, "empty key combination"); return -1; }
+    int mods = 0, vk = -1;
+    for (;;) {
+        char* plus = strchr(p, '+');
+        if (plus) *plus = 0;
+        char* tok = kbm_trim(p);
+        if (!*tok) { snprintf(err, errn, "\"%s\": a '+' with nothing on one side", text); return -1; }
+        int k = kbm_key_from_name(tok);
+        if (k < 0) { snprintf(err, errn, "unknown key \"%s\"", tok); return -1; }
+        if (!plus) { vk = k; break; }
+        int m = hk_mod_of_vk(k);
+        if (!m) { snprintf(err, errn, "\"%s\": only Shift, Ctrl and Alt can come before '+'", tok); return -1; }
+        mods |= m;
+        p = plus + 1;
+    }
+    if (kbm_is_mouse_key(vk)) {
+        snprintf(err, errn, "\"%s\": mouse buttons and the wheel cannot be hotkeys", text);
+        return -1;
+    }
+    if (hk_mod_of_vk(vk)) { snprintf(err, errn, "\"%s\": a modifier alone cannot be a hotkey", text); return -1; }
+    if (vk == 0x5B || vk == 0x5C) { snprintf(err, errn, "\"%s\": the Windows keys belong to Windows", text); return -1; }
+    {
+        const int alt = mods & HK_MOD_ALT, ctrl = mods & HK_MOD_CTRL;
+        const char* why = NULL;
+        if (alt && vk == 0x73)                    why = "Alt+F4 closes the window";
+        else if (alt && vk == 0x0D)               why = "Alt+Enter is the fullscreen switch";
+        else if (alt && (vk == 0x09 || vk == 0x1B)) why = "Alt+Tab / Alt+Esc switch windows";
+        else if (alt && vk == 0x20)               why = "Alt+Space opens the system menu";
+        else if (ctrl && vk == 0x1B)              why = "Ctrl+Esc opens the Start menu";
+        if (why) { snprintf(err, errn, "\"%s\": %s", text, why); return -1; }
+    }
+    out->vk = (uint16_t)vk;
+    out->mods = (uint8_t)mods;
+    return 1;
+}
+
+/* "Ctrl+Alt+Shift+F1" (Windows' order); "" for no combination. */
+static inline const char* hk_combo_text(const HkCombo* k, char* buf, size_t n)
+{
+    char key[24];
+    if (!k || !k->vk) { if (n) buf[0] = 0; return buf; }
+    kbm_key_name(k->vk, key, sizeof key);
+    snprintf(buf, n, "%s%s%s%s", (k->mods & HK_MOD_CTRL) ? "Ctrl+" : "", (k->mods & HK_MOD_ALT) ? "Alt+" : "",
+             (k->mods & HK_MOD_SHIFT) ? "Shift+" : "", key);
+    return buf;
+}
+
+/* The first combination of an action as text, "" when unbound. */
+static inline const char* hk_action_text(const HkConfig* c, int a, char* buf, size_t n)
+{
+    if (a <= HK_NONE || a >= HK_COUNT || !c->n[a]) { if (n) buf[0] = 0; return buf; }
+    return hk_combo_text(&c->c[a][0], buf, n);
+}
+
+/* The action a key + modifiers (HK_MOD_*) fires, or HK_NONE. */
+static inline int hk_match(const HkConfig* c, int vk, int mods)
+{
+    for (int a = HK_NONE + 1; a < HK_COUNT; a++)
+        for (int i = 0; i < c->n[a]; i++)
+            if (c->c[a][i].vk == vk && c->c[a][i].mods == mods) return a;
+    return HK_NONE;
+}
+
+/* The key of slot k+1 (k = 0..9) when slot 1 has `vk`; -1 if the run does
+ * not fit (past F24, or a key that is not F1-F24, a digit or Num0-Num9). */
+static inline int hk_group_key(int vk, int k)
+{
+    if (vk >= 0x70 && vk <= 0x87) return vk + k <= 0x87 ? vk + k : -1;   /* F1..F24 */
+    static const char row[] = "1234567890";
+    for (int base = 0; base < 2; base++) {
+        const int first = base ? 0x60 : '0';          /* Num0 / '0' */
+        if (vk < first || vk > first + 9) continue;
+        int idx = (vk == first) ? 9 : vk - first - 1;
+        if (idx + k > 9) return -1;
+        return first + (row[idx + k] - '0');
+    }
+    return -1;
+}
+
+/* Set an action's combinations; a combination another action had moves here
+ * (note says which, "" if none). */
+static inline void hk_assign(HkConfig* c, int a, const HkCombo* k, int n, char* note, size_t noten)
+{
+    if (note && noten) note[0] = 0;
+    for (int i = 0; i < n; i++)
+        for (int b = HK_NONE + 1; b < HK_COUNT; b++) {
+            if (b == a) continue;
+            for (int j = 0; j < c->n[b]; j++) {
+                if (c->c[b][j].vk != k[i].vk || c->c[b][j].mods != k[i].mods) continue;
+                if (note && noten && !note[0]) {
+                    char t[32], an[24], bn[24];
+                    snprintf(note, noten, "%s moves from %s to %s", hk_combo_text(&k[i], t, sizeof t),
+                             hk_action_name(b, bn, sizeof bn), hk_action_name(a, an, sizeof an));
+                }
+                for (int m = j; m + 1 < c->n[b]; m++) c->c[b][m] = c->c[b][m + 1];
+                c->n[b]--;
+                j--;
+            }
+        }
+    for (int i = 0; i < n && i < HK_MAX_COMBOS; i++) c->c[a][i] = k[i];
+    c->n[a] = (uint8_t)(n < HK_MAX_COMBOS ? n : HK_MAX_COMBOS);
+}
+
+static inline void hk_set1(HkConfig* c, int a, int vk, int mods)
+{
+    HkCombo k;
+    k.vk = (uint16_t)vk;
+    k.mods = (uint8_t)mods;
+    hk_assign(c, a, &k, 1, NULL, 0);
+}
+
+/* Defaults. No key here is a game binding in pad_kbm.h's default table. The
+ * modifiers are read by the pad while they are held, so they are chosen by
+ * what that does: Left Ctrl is Walk (it only scales the keyboard's stick,
+ * nothing the game keeps), Left Shift is L3, a stick click the game acts on
+ * (the manual's "switch reticle side"). So a SAVE takes Ctrl only -- a Shift
+ * pressed just before the F-key would put an L3 press into the saved moment
+ * -- and a LOAD, which replaces the moment anyway, takes Ctrl+Shift: two
+ * modifiers, so no stray key throws progress away (F9, the PC games' quick
+ * load, is the one plain key; F8 marks a problem moment for the play-session
+ * issues log, harmless if pressed by mistake). Undo last load is Ctrl+Shift+Z
+ * (a load, so two modifiers; Z drives nothing in the game), and the moment it
+ * replaces is kept as the next undo point (a second Ctrl+Shift+Z goes back). Left alone: F1 (the options overlay's key),
+ * F10 (releases the mouse), F12 (debuggers, Steam screenshots) and every Alt
+ * combination (Alt releases the mouse; Alt+F1/F9/F10 belong to GPU overlays).
+ * A hotkey's keys, modifiers included, are kept from the game from the press
+ * until they are released (cellPad_host_hotkey). */
+static inline void hk_config_defaults(HkConfig* c)
+{
+    memset(c, 0, sizeof *c);
+    hk_set1(c, HK_QUICK_SAVE, 0x74, 0);                                 /* F5 */
+    hk_set1(c, HK_QUICK_LOAD, 0x78, 0);                                 /* F9 */
+    for (int k = 0; k < HK_SLOTS; k++) {
+        hk_set1(c, HK_SAVE_SLOT1 + k, 0x70 + k, HK_MOD_CTRL);                  /* Ctrl+F1..F10 */
+        hk_set1(c, HK_LOAD_SLOT1 + k, 0x70 + k, HK_MOD_CTRL | HK_MOD_SHIFT);   /* Ctrl+Shift+F1..F10 */
+    }
+    hk_set1(c, HK_FULLSCREEN, 0x7A, 0);                                 /* F11 */
+    hk_set1(c, HK_MARK, 0x77, 0);                                       /* F8 */
+    hk_set1(c, HK_UNDO_LOAD, 0x5A, HK_MOD_CTRL | HK_MOD_SHIFT);         /* Ctrl+Shift+Z */
+}
+
+/* One "name = value" line. in_section: inside [hotkeys]. Returns 1 applied,
+ * 0 not a hotkey line (or blank / comment), -1 error (err). A combination
+ * moved from another action is reported in note (not an error). */
+static inline int hk_parse_line(HkConfig* c, const char* line, int in_section,
+                                char* err, size_t errn, char* note, size_t noten)
+{
+    char buf[512];
+    if (note && noten) note[0] = 0;
+    snprintf(buf, sizeof buf, "%s", line);
+    for (char* p = buf; *p; p++)
+        if (*p == '#' || *p == ';') { *p = 0; break; }
+    char* s = kbm_trim(buf);
+    if (!*s || *s == '[') return 0;
+    char* eq = strchr(s, '=');
+    char nm[64];
+    if (!eq) {
+        if (!in_section) return 0;
+        snprintf(err, errn, "expected 'name = value': \"%s\"", s);
+        return -1;
+    }
+    *eq = 0;
+    char* name = kbm_trim(s);
+    char* val  = kbm_trim(eq + 1);
+    kbm_norm(name, nm, sizeof nm);
+    const char* key = nm;
+    if (!strncmp(nm, "hotkey", 6)) {                                 /* hotkey_x / hotkeys_x */
+        key = nm + 6;
+        if (hk_action_from_name(key) == -1 && nm[6] == 's') key = nm + 7;
+    } else if (!in_section) {
+        return 0;
+    }
+    int a = hk_action_from_name(key);
+    if (a == -1) { snprintf(err, errn, "unknown hotkey \"%s\"", name); return -1; }
+
+    HkCombo k[HK_MAX_COMBOS];
+    int n = 0;
+    char low[16];
+    kbm_norm(val, low, sizeof low);
+    if (*val && strcmp(low, "none")) {
+        char* p = val;
+        for (char* tok; (tok = kbm_next_token(&p)) != NULL; ) {
+            if (!*tok) continue;
+            if (n == HK_MAX_COMBOS) { snprintf(err, errn, "%s: more than %d combinations", name, HK_MAX_COMBOS); return -1; }
+            char e2[160];
+            if (hk_parse_combo(tok, &k[n], e2, sizeof e2) < 0) { snprintf(err, errn, "%s: %s", name, e2); return -1; }
+            int dup = 0;
+            for (int i = 0; i < n; i++) dup |= k[i].vk == k[n].vk && k[i].mods == k[n].mods;
+            if (!dup) n++;
+        }
+    }
+    if (a == HK_GROUP_SAVE || a == HK_GROUP_LOAD) {
+        const int first = a == HK_GROUP_SAVE ? HK_SAVE_SLOT1 : HK_LOAD_SLOT1;
+        HkCombo g[HK_SLOTS][HK_MAX_COMBOS];
+        for (int s2 = 0; s2 < HK_SLOTS; s2++)
+            for (int i = 0; i < n; i++) {
+                int vk = hk_group_key(k[i].vk, s2);
+                if (vk < 0) {
+                    char t[32];
+                    snprintf(err, errn, "%s: %s cannot start ten slots (use F1-F15, 1 or Num1)", name,
+                             hk_combo_text(&k[i], t, sizeof t));
+                    return -1;
+                }
+                g[s2][i].vk = (uint16_t)vk;
+                g[s2][i].mods = k[i].mods;
+            }
+        for (int s2 = 0; s2 < HK_SLOTS; s2++) {
+            char nt[160];
+            hk_assign(c, first + s2, g[s2], n, nt, sizeof nt);
+            if (nt[0] && note && noten && !note[0]) snprintf(note, noten, "%s", nt);
+        }
+        return 1;
+    }
+    hk_assign(c, a, k, n, note, noten);
+    return 1;
+}
+
+typedef void (*hk_warn_fn)(const void* ctx, const char* msg);
+
+/* A whole file, or an override string (env_style: items also end at ';' or
+ * '|'). Returns the number of bad lines; notes (moved combinations) go to
+ * warn too but do not count. */
+static inline int hk_parse_text(HkConfig* c, const char* text, int env_style, hk_warn_fn warn, const void* ctx)
+{
+    int errors = 0, lineno = 0, in_section = 0;
+    const char* p = text;
+    while (p && *p) {
+        const char* e = p;
+        while (*e && *e != '\n' && !(env_style && (*e == ';' || *e == '|'))) e++;
+        char line[512];
+        size_t n = (size_t)(e - p);
+        if (n >= sizeof line) n = sizeof line - 1;
+        memcpy(line, p, n);
+        line[n] = 0;
+        lineno++;
+        const char* s = line;
+        while (*s == ' ' || *s == '\t') s++;
+        if (*s == '[') {
+            char nm[32];
+            kbm_norm(s + 1, nm, sizeof nm);
+            in_section = !strncmp(nm, "hotkeys]", 8) || !strncmp(nm, "hotkey]", 7);
+        } else {
+            char err[220], note[160];
+            int r = hk_parse_line(c, line, in_section, err, sizeof err, note, sizeof note);
+            if (r < 0) errors++;
+            if (warn && (r < 0 || note[0])) {
+                char msg[300];
+                snprintf(msg, sizeof msg, "%s %d: %s%s", env_style ? "item" : "line", lineno,
+                         r < 0 ? "" : "note: ", r < 0 ? err : note);
+                warn(ctx, msg);
+            }
+        }
+        p = *e ? e + 1 : e;
+    }
+    return errors;
+}
+
+/* Is the action list a group: slots 1..10 = slot 1's single combination
+ * stepped by hk_group_key? */
+static inline int hk_is_group(const HkConfig* c, int first)
+{
+    if (c->n[first] != 1) return 0;
+    for (int s = 1; s < HK_SLOTS; s++) {
+        int vk = hk_group_key(c->c[first][0].vk, s);
+        if (c->n[first + s] != 1 || vk < 0 || c->c[first + s][0].vk != vk ||
+            c->c[first + s][0].mods != c->c[first][0].mods) return 0;
+    }
+    return 1;
+}
+
+/* The table, a few lines, each starting with pfx. */
+static inline void hk_print(const HkConfig* c, FILE* f, const char* pfx)
+{
+    char out[2048], t[40], t2[40], nm[24];
+    out[0] = 0;
+    kbm_appendf(out, sizeof out, "%s window hotkeys (input.ini [hotkeys]; they never reach the game):\n", pfx);
+    char line[512];
+    line[0] = 0;
+    for (int a = HK_NONE + 1; a < HK_COUNT; a++) {
+        const int sv = a >= HK_SAVE_SLOT1 && a < HK_SAVE_SLOT1 + HK_SLOTS;
+        const int ld = a >= HK_LOAD_SLOT1 && a < HK_LOAD_SLOT1 + HK_SLOTS;
+        char cell[128];
+        if ((sv || ld) && hk_is_group(c, sv ? HK_SAVE_SLOT1 : HK_LOAD_SLOT1)) {
+            if (a != HK_SAVE_SLOT1 && a != HK_LOAD_SLOT1) continue;
+            snprintf(cell, sizeof cell, "%s slots 1-%d = %s..%s", sv ? "save" : "load", HK_SLOTS,
+                     hk_combo_text(&c->c[a][0], t, sizeof t),
+                     hk_combo_text(&c->c[a + HK_SLOTS - 1][0], t2, sizeof t2));
+        } else {
+            hk_action_name(a, nm, sizeof nm);
+            if (!c->n[a]) snprintf(cell, sizeof cell, "%s = none", nm);
+            else if (c->n[a] == 1) snprintf(cell, sizeof cell, "%s = %s", nm, hk_combo_text(&c->c[a][0], t, sizeof t));
+            else snprintf(cell, sizeof cell, "%s = %s, %s", nm, hk_combo_text(&c->c[a][0], t, sizeof t),
+                          hk_combo_text(&c->c[a][1], t2, sizeof t2));
+        }
+        if (strlen(line) + strlen(cell) + 2 > 100 && line[0]) {
+            kbm_appendf(out, sizeof out, "%s   %s\n", pfx, line);
+            line[0] = 0;
+        }
+        size_t used = strlen(line);
+        snprintf(line + used, sizeof line - used, "%s%s", used ? "; " : "", cell);
+    }
+    if (line[0]) kbm_appendf(out, sizeof out, "%s   %s\n", pfx, line);
+    fputs(out, f);
+}
+
+/* Keys that are both a hotkey and a game binding: the game sees them too
+ * (it reads held keys directly), so say so. Modifiers are never a hotkey's
+ * key, so Shift+F1 with Left Shift bound to L3 is not reported. Returns how
+ * many were reported. */
+static inline int hk_report_conflicts(const HkConfig* c, const KbmConfig* k, hk_warn_fn warn, const void* ctx)
+{
+    int n = 0;
+    for (int a = HK_NONE + 1; a < HK_COUNT; a++)
+        for (int i = 0; i < c->n[a]; i++)
+            for (int t = 0; t < KBM_NUM_TARGETS; t++)
+                for (int j = 0; j < k->nkeys[t]; j++) {
+                    if (k->keys[t][j] != c->c[a][i].vk) continue;
+                    char msg[200], ct[32], nm[24], kn[24];
+                    snprintf(msg, sizeof msg, "hotkey %s (%s) uses %s, which is also bound to %s: the game "
+                             "sees that key too", hk_combo_text(&c->c[a][i], ct, sizeof ct),
+                             hk_action_name(a, nm, sizeof nm), kbm_key_name(c->c[a][i].vk, kn, sizeof kn),
+                             kbm_target_name(t));
+                    if (warn) warn(ctx, msg);
+                    n++;
+                }
+    return n;
+}
+
+#endif /* PS3RECOMP_PAD_HOTKEYS_PARSER */
