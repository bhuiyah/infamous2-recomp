+}
+/* RSX_RES_EDGECULL=auto|flavor|scale|off (rsx_res_scale.h, "Edge
+ * Geometry's small-primitive culling"): while the latched factor is >= 2, an
+ * SPU GET hook rewrites the job's copy of an Edge viewport of the display size
+ * so its culling keeps every triangle that covers a HOST sample -- without it
+ * the triangles dropped for missing every guest pixel centre leave holes in
+ * the scaled image (Cole's face at x2). Guest memory is never written. Off
+ * (and RES_SCALE unset or 1): no hook at all. */
+static int s_rs_edge_mode = -1;            /* RSX_RS_EDGE_*; read at the first latch */
+static volatile unsigned s_rs_edge_k;      /* the factor the hook applies, 0 = no hook */
+static volatile long s_rs_edge_n;          /* viewports rewritten (the log's count) */
+/* The hook sees every SPU program's 128-byte GETs, not only Edge's: each SPU
+ * image a block was rewritten for is logged once, so a viewport-shaped block
+ * another job fetches (a lighting job sharing the struct) shows up as a second
+ * image. RSX_RES_EDGECULL_LOG=1 also keeps the rewritten blocks' EAs and
+ * reports a later GET of one that no longer matches -- the patched bytes
+ * written back to guest memory by a PUT, or the block reused for another
+ * target. */
+static volatile long s_rs_edge_img[8];     /* image id + 1 */
+static int s_rs_edge_log;
+static volatile long s_rs_edge_ea[32];     /* RSX_RES_EDGECULL_LOG: the rewritten blocks' EAs */
+static volatile long s_rs_edge_back;       /* ... GETs of one that did not match again */
+static void rs_edge_note(int img, uint32_t ea)
+{
+    for (int i = 0; i < 8; i++) {
+        long v = s_rs_edge_img[i];
+        if (!v && !(v = InterlockedCompareExchange(&s_rs_edge_img[i], img + 1, 0))) {
+            fprintf(stderr, "[RSCALE] Edge viewport rewritten for SPU image %d (block at 0x%08X)%c", img, ea, 10);
+            break;
+        }
+        if (v == img + 1) break;
+    }
+    if (s_rs_edge_log)
+        for (int i = 0; i < 32; i++) {
+            long v = s_rs_edge_ea[i];
+            if (!v && !(v = InterlockedCompareExchange(&s_rs_edge_ea[i], (long)ea, 0))) break;
+            if (v == (long)ea) break;
         }
+}
+static void rs_edge_get_hook(int img, uint32_t ea, uint8_t* ls, uint32_t size)
+{
+    if (size != RSX_RS_EDGE_VP_SIZE) return;
+    if (rsx_rs_edge_vp_patch(ls, s_d3d.width, s_d3d.height, s_rs_edge_k, s_rs_edge_mode)) {
+        InterlockedIncrement(&s_rs_edge_n);
+        rs_edge_note(img, ea);
+    } else if (s_rs_edge_log) {
+        for (int i = 0; i < 32 && s_rs_edge_ea[i]; i++)
+            if (s_rs_edge_ea[i] == (long)ea) {
+                if (InterlockedIncrement(&s_rs_edge_back) <= 8)
+                    fprintf(stderr, "[RSCALE] EDGECULL_LOG: block 0x%08X (rewritten before) no longer matches: "
+                            "scissor %u,%u %ux%u scale (%g,%g) offset (%g,%g) flavor %u, SPU image %d%c",
+                            ea, rsx_rs_be16(ls), rsx_rs_be16(ls + 2), rsx_rs_be16(ls + 4), rsx_rs_be16(ls + 6),
+                            (double)rsx_rs_bef(ls + 0x50), (double)rsx_rs_bef(ls + 0x54),
+                            (double)rsx_rs_bef(ls + 0x60), (double)rsx_rs_bef(ls + 0x64), ls[0x70], img, 10);
+                break;
+            }
+    }
+}
+static void rs_edge_install(void)
+{
+    extern void (*g_spu_get_hook)(int image_id, uint32_t ea, uint8_t* ls, uint32_t size);
+    if (s_rs_edge_mode < 0) {
+        int ok = 1;
+        const char* e = getenv("RSX_RES_EDGECULL");
+        s_rs_edge_mode = rsx_rs_parse_edgecull(e, &ok);
+        if (!ok) fprintf(stderr, "[RSCALE] RSX_RES_EDGECULL=%s not understood (auto|flavor|scale|off): auto%c", e, 10);
+        e = getenv("RSX_RES_EDGECULL_LOG");
+        s_rs_edge_log = e && *e && *e != '0';
+    }
+    const int on = s_rs.on >= 2 && s_rs_edge_mode != RSX_RS_EDGE_OFF;
+    s_rs_edge_k = on ? (unsigned)s_rs.on : 0u;
+    g_spu_get_hook = on ? rs_edge_get_hook : NULL;
+    if (s_rs.on >= 2 || s_rs_edge_mode == RSX_RS_EDGE_OFF)
+        fprintf(stderr, "[RSCALE] Edge culling viewports: %s%c", !on ? "left as the title set them (RSX_RES_EDGECULL=off)"
+                : s_rs_edge_mode == RSX_RS_EDGE_SCALE ? "scaled to the host grid (scale)"
+                : (s_rs.on % 2) ? "scaled to the host grid (flavor; odd factor)"
+                : "the 2x2 sample pattern on the guest grid / 2 (flavor)", 10);
+}
+/* After a presented guest frame (in render_frame's Present branch): the
+ * census frame count, and the latch -- a requested factor takes effect for the
+ * next guest frame's records, prepass and replay alike (critique C3). */
+static void rs_legacy_dsv_fit(void);
+static void rs_frame_end(void)
+{
+    rsx_rcz_frame_end(s_rpc.frame_count + 1u);
+    if (s_rs.req != s_rs.on) {
+        fprintf(stderr, "[RSCALE] frame %llu: RES_SCALE %d -> %d from the next guest frame%c",
+                (unsigned long long)s_rpc.frame_count, s_rs.on, s_rs.req, 10);
+        s_rs.on = s_rs.req;
