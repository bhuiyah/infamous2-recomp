+/* a mutated DDS sits right before a no-access page: a read past the file faults */
+static uint8_t* g_guard_page;   /* the no-access page after the buffer */
+static uint8_t* guard_buf(size_t n)
+{
+    static uint8_t* region; static size_t cap;
+    if (!region) {
+        cap = 64u << 10;
+        region = (uint8_t*)VirtualAlloc(NULL, cap + 4096, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+        DWORD old; VirtualProtect(region + cap, 4096, PAGE_NOACCESS, &old);
+        g_guard_page = region + cap;
+    }
+    return n <= cap ? region + cap - n : NULL;
+}
