diff --git a/runtime/spu/tests/test_spu_helpers_avx512.c b/runtime/spu/tests/test_spu_helpers_avx512.c
new file mode 100644
index 0000000..e98c7a8
--- /dev/null
+++ b/runtime/spu/tests/test_spu_helpers_avx512.c
@@ -0,0 +1,169 @@
+/* The x86-64-v4 (AVX-512) forms in spu_helpers.h (SPU__AVX512) must return
+ * exactly what the scalar references return:
+ *   clz, frest, frsqest            all 2^32 lane values
+ *   cfltu, cflts                   all 2^32 lane values at 14 scales
+ *   csflt, cuflt                   all 2^32 lane values at 15 scales (the
+ *                                  RZDAZ form is a round-toward-zero conversion)
+ *   roti                           every immediate -64..63, constant and not
+ *   rot                            random values x every count 0..255 + random
+ *   rotqby shlqby rotqbybi shlqbybi rotqmby rotqmbybi (not AVX-512 forms;
+ *                                  checked here too) every low count byte
+ *                                  0..255 with random upper bits, random data
+ * in every MXCSR mode the build is defined for (an SPU_HELPERS_FP_RZDAZ build:
+ * rz+ftz/daz only). Built without AVX-512 it checks the same helpers' other
+ * forms, so it can run at every ISA level:
+ *   clang-cl /O2 -I.. -I../../../include /arch:AVX512 [-DSPU_HELPERS_FP_RZDAZ] test_spu_helpers_avx512.c
+ *   clang -O2 -I.. -I../../../include -march=x86-64-v4 [-DSPU_HELPERS_FP_RZDAZ] test_spu_helpers_avx512.c
+ *   test_spu_helpers_avx512 [exhaustive: 1|0] [random-vectors] */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xmmintrin.h>
+
+#if defined(_MSC_VER) && !defined(__clang__)
+#  define NOINL __declspec(noinline)
+#else
+#  define NOINL __attribute__((noinline))
+#endif
+
+static uint64_t g_s = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd32(void) { g_s ^= g_s << 13; g_s ^= g_s >> 7; g_s ^= g_s << 17; return (uint32_t)(g_s >> 32); }
+static u128 rnd_vec(void) { u128 r; for (int i = 0; i < 4; i++) r._u32[i] = rnd32(); return r; }
+static long long g_bad, g_n;
+static void check(const char* op, long arg, u128 a, u128 b, u128 got, u128 ref) {
+    g_n++;
+    if (!memcmp(&got, &ref, 16)) return;
+    if (g_bad++ < 20)
+        printf("  MISMATCH %s(%ld) a=%08X.%08X.%08X.%08X b=%08X.%08X.%08X.%08X got=%08X.%08X.%08X.%08X ref=%08X.%08X.%08X.%08X\n",
+               op, arg, a._u32[0], a._u32[1], a._u32[2], a._u32[3], b._u32[0], b._u32[1], b._u32[2], b._u32[3],
+               got._u32[0], got._u32[1], got._u32[2], got._u32[3], ref._u32[0], ref._u32[1], ref._u32[2], ref._u32[3]);
+}
+
+/* references the header has no *_ref for */
+static u128 roti_ref(u128 a, int sh) {
+    u128 r; sh &= 31;
+    for (int i = 0; i < 4; i++) r._u32[i] = sh ? ((a._u32[i] << sh) | (a._u32[i] >> (32 - sh))) : a._u32[i];
+    return r;
+}
+
+/* the conversion helpers with a CONSTANT scale (as lifted code calls them):
+ * one switch case per scale, so each is inlined with its immediate */
+#define CVT_SCALES(X) X(0) X(28) X(29) X(30) X(46) X(47) X(100) X(123) X(127) X(140) X(141) X(150) X(155) \
+                      X(156) X(158) X(173) X(200) X(249) X(250) X(251) X(255)
+static NOINL u128 cvt_k(int op, u128 a, int i8) {
+#define C(k) case k: return op == 0 ? spu_cflts(a, k) : op == 1 ? spu_cfltu(a, k) : op == 2 ? spu_csflt(a, k) : spu_cuflt(a, k);
+    switch (i8) { CVT_SCALES(C) default: break; }
+#undef C
+    return op == 0 ? spu_cflts(a, i8) : op == 1 ? spu_cfltu(a, i8) : op == 2 ? spu_csflt(a, i8) : spu_cuflt(a, i8);
+}
+static u128 cvt_ref(int op, u128 a, int i8) {
+    return op == 0 ? spu_cflts_ref(a, i8) : op == 1 ? spu_cfltu_ref(a, i8) : op == 2 ? spu_csflt_ref(a, i8) : spu_cuflt_ref(a, i8);
+}
+static NOINL u128 roti_k(u128 a, int sh) {
+#define R(k) case k: return spu_roti(a, k); case -(k) - 1: return spu_roti(a, -(k) - 1);
+    switch (sh) {
+        R(0) R(1) R(2) R(3) R(4) R(5) R(6) R(7) R(8) R(9) R(10) R(11) R(12) R(13) R(14) R(15)
+        R(16) R(17) R(18) R(19) R(20) R(21) R(22) R(23) R(24) R(25) R(26) R(27) R(28) R(29) R(30) R(31)
+        R(32) R(33) R(34) R(35) R(36) R(37) R(38) R(39) R(40) R(41) R(42) R(43) R(44) R(45) R(46) R(47)
+        R(48) R(49) R(50) R(51) R(52) R(53) R(54) R(55) R(56) R(57) R(58) R(59) R(60) R(61) R(62) R(63)
+    default: break;
+    }
+#undef R
+    return spu_roti(a, sh);
+}
+static int opq_i(int x) { volatile int t = x; return t; }
+
+/* all 2^32 lane values, four per vector, lanes rotating so every value
+ * visits every lane over the sweep */
+static u128 sweep_vec(uint64_t x) {
+    u128 a; const unsigned k = (unsigned)(x >> 2) & 3;
+    for (int i = 0; i < 4; i++) a._u32[(i + k) & 3] = (uint32_t)(x + (uint64_t)i);
+    return a;
+}
+static NOINL void exhaustive_unary(void) {
+    long long b0 = g_bad;
+    for (uint64_t x = 0; x < (1ull << 32); x += 4) {
+        const u128 a = sweep_vec(x);
+        const u128 g1 = spu_clz(a), r1 = spu_clz_ref(a), g2 = spu_frest(a), r2 = spu_frest_ref(a);
+        const u128 g3 = spu_frsqest(a), r3 = spu_frsqest_ref(a);
+        g_n += 3;
+        if (memcmp(&g1, &r1, 16) | memcmp(&g2, &r2, 16) | memcmp(&g3, &r3, 16)) {
+            g_n -= 3; check("clz", 0, a, a, g1, r1); check("frest", 0, a, a, g2, r2); check("frsqest", 0, a, a, g3, r3);
+        }
+    }
+    printf("  2^32 x {clz frest frsqest}: %lld mismatches\n", g_bad - b0);
+}
+static NOINL void exhaustive_cvt(int op, int i8) {
+    static const char* nm[4] = { "cflts", "cfltu", "csflt", "cuflt" };
+    long long b0 = g_bad;
+    for (uint64_t x = 0; x < (1ull << 32); x += 4) {
+        const u128 a = sweep_vec(x), g = cvt_k(op, a, i8), r = cvt_ref(op, a, i8);
+        g_n++;
+        if (memcmp(&g, &r, 16)) { g_n--; check(nm[op], i8, a, a, g, r); }
+    }
+    printf("  2^32 x %s(%d): %lld mismatches\n", nm[op], i8, g_bad - b0);
+}
+static NOINL void random_tests(long n) {
+    for (long it = 0; it < n; it++) {
+        u128 a = rnd_vec(), b = rnd_vec();
+        /* roti: every immediate as a constant and as a run-time value */
+        const int sh = (int)(it % 128) - 64;
+        check("roti", sh, a, a, roti_k(a, sh), roti_ref(a, sh));
+        check("roti/rt", sh, a, a, spu_roti(a, opq_i(sh)), roti_ref(a, sh));
+        /* rot: every count in lane 0 (others random) */
+        u128 c = b; c._u32[0] = (uint32_t)(it % 256) | (rnd32() & 0xFFFFFF00u);
+        if (it & 1) for (int i = 1; i < 4; i++) c._u32[i] = rnd32() % 80u;
+        check("rot", (long)c._u32[0], a, c, spu_rot(a, c), spu_rot_ref(a, c));
+        /* byte rotates/shifts: every low count byte, random upper bits */
+        u128 q = b; q._u32[0] = (uint32_t)(it % 256) | ((it & 2) ? (rnd32() & 0xFFFFFF00u) : 0u);
+        check("rotqby", (long)q._u32[0], a, q, spu_rotqby(a, q), spu_rotqby_ref(a, q));
+        check("shlqby", (long)q._u32[0], a, q, spu_shlqby(a, q), spu_shlqby_ref(a, q));
+        check("rotqbybi", (long)q._u32[0], a, q, spu_rotqbybi(a, q), spu_rotqbybi_ref(a, q));
+        check("shlqbybi", (long)q._u32[0], a, q, spu_shlqbybi(a, q), spu_shlqbybi_ref(a, q));
+        check("rotqmby", (long)q._u32[0], a, q, spu_rotqmby(a, q), spu_rotqmby_ref(a, q));
+        check("rotqmbybi", (long)q._u32[0], a, q, spu_rotqmbybi(a, q), spu_rotqmbybi_ref(a, q));
+        check("clz", 0, a, a, spu_clz(a), spu_clz_ref(a));
+        /* conversions at every scale, run-time and constant */
+        const int i8 = (int)(rnd32() % 256u);
+        for (int op = 0; op < 4; op++) {
+            u128 v = (op < 2) ? a : b;
+            if (it & 4) for (int i = 0; i < 4; i++) v._u32[i] >>= rnd32() % 32;
+            check(op == 0 ? "cflts" : op == 1 ? "cfltu" : op == 2 ? "csflt" : "cuflt", i8, v, v, cvt_k(op, v, i8), cvt_ref(op, v, i8));
+        }
+    }
+}
+
+int main(int argc, char** argv) {
+    const int ex = argc > 1 ? atoi(argv[1]) : 1;
+    const long n = argc > 2 ? atol(argv[2]) : 2000000;
+    static const unsigned modes[4] = { 0x1F80u, 0x7F80u, 0x9FC0u, 0xFFC0u };
+    static const char* names[4] = { "rn", "rz", "rn+ftz/daz", "rz+ftz/daz" };
+    printf("test_spu_helpers_avx512: SPU__AVX512=%d RZDAZ=%d\n", SPU__AVX512,
+#if defined(SPU_HELPERS_FP_RZDAZ)
+           1);
+    const int m0 = 3;                      /* the only mode an RZDAZ build is defined for */
+#else
+           0);
+    const int m0 = 0;
+#endif
+    long long total = 0;
+    for (int m = m0; m < 4; m++) {
+        const unsigned saved = _mm_getcsr();
+        _mm_setcsr(modes[m]);
+        g_bad = 0; g_n = 0;
+        random_tests(n);
+        if (ex) {
+            if (m == m0) exhaustive_unary();
+            static const int fs[] = { 173, 141, 158, 46, 47, 100, 127, 150, 200, 0, 255, 30, 140, 250 };
+            static const int is[] = { 155, 123, 250, 29, 28, 251, 100, 140, 150, 200, 0, 255, 30, 156, 249 };
+            for (int k = 0; k < (int)(sizeof fs / sizeof fs[0]); k++) { exhaustive_cvt(0, fs[k]); exhaustive_cvt(1, fs[k]); }
+            for (int k = 0; k < (int)(sizeof is / sizeof is[0]); k++) { exhaustive_cvt(2, is[k]); exhaustive_cvt(3, is[k]); }
+        }
+        _mm_setcsr(saved);
+        printf("  %-11s %lld checks, %lld mismatches\n", names[m], g_n, g_bad);
+        total += g_bad;
+    }
+    puts(total ? "test_spu_helpers_avx512: FAIL" : "test_spu_helpers_avx512: ok");
+    return total != 0;
+}
diff --git a/runtime/spu/tests/test_spu_helpers_constfold.c b/runtime/spu/tests/test_spu_helpers_constfold.c
new file mode 100644
index 0000000..a717042
--- /dev/null
+++ b/runtime/spu/tests/test_spu_helpers_constfold.c
@@ -0,0 +1,142 @@
+/* The float helpers with operands the COMPILER can see as constants must
+ * still return what the scalar reference returns. Lifted code builds such
+ * operands with il/ilhu/iohl, and once the helpers are inlined the stores to
+ * ctx->gpr forward straight into them (a register-caching lifter makes that
+ * the rule). clang folds float code assuming round-to-nearest and IEEE
+ * denormals -- it knows nothing of the MXCSR the SPU host threads run with
+ * (SPU_FPMODE rz, and DAZ+FTZ in an SPU_HELPERS_FP_RZDAZ build), so any fold
+ * that is exact only under IEEE assumptions shows up here: e.g. dropping the
+ * `+ 0.0f` that turns an FTZ -0 into +0 because "fadd x, C cannot be -0", or
+ * folding a conversion of a denormal constant that DAZ would read as zero.
+ * test_spu_helpers_simd.c feeds every operand from memory, so it cannot see
+ * these.
+ *
+ * Every fa/fs/fm/fma/fms/fnms/fcgt/fceq/fcmgt/fcmeq with each operand slot (or
+ * pair) constant, cflts/cfltu/csflt/cuflt of a constant: the helper inlined
+ * with the constant vs the reference on the same values from memory, over a
+ * list of variable operands that includes the constant's neighbours (tiny
+ * sums). Built once per ISA level and once with -DSPU_HELPERS_FP_RZDAZ (then
+ * only rz+ftz/daz is run, the mode that build is defined for):
+ *   clang-cl /O2 -I.. -I../../../include [/arch:AVX2 /clang:-ffp-contract=off | -msse4.1] [-DSPU_HELPERS_FP_RZDAZ] test_spu_helpers_constfold.c */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xmmintrin.h>
+
+#if defined(_MSC_VER) && !defined(__clang__)
+#  define NOINL __declspec(noinline)
+#else
+#  define NOINL __attribute__((noinline))
+#endif
+
+#define CONSTS(X) \
+    X(0, 0x00000000u) X(1, 0x80000000u) X(2, 0x3F800000u) X(3, 0xBF800000u) X(4, 0x40000000u) \
+    X(5, 0x3F000000u) X(6, 0x00800000u) X(7, 0x80800000u) X(8, 0x00800001u) X(9, 0x80800003u) \
+    X(10, 0x00000001u) X(11, 0x807FFFFFu) X(12, 0x0C000001u) X(13, 0x8C000001u) X(14, 0x7F7FFFFFu) \
+    X(15, 0xFF7FFFFFu) X(16, 0x7F800000u) X(17, 0x7FFFFFFFu) X(18, 0x42020000u) X(19, 0x8DA24260u) \
+    X(20, 0x006CE3EEu) X(21, 0x01000000u)
+static const uint32_t g_consts[] = {
+#define X(i, c) c,
+    CONSTS(X)
+#undef X
+};
+#define NC ((int)(sizeof g_consts / sizeof g_consts[0]))
+
+typedef void (*test_fn)(const u128* v, u128* got, u128* ref);
+static const u128* volatile g_launder;            /* the reference sees no constant */
+static u128 opq(u128 x) { u128 t = x; g_launder = &t; return *g_launder; }
+#define K(c) spu_splat_u32(c)
+
+/* one function per (helper, constant slots, constant): the constant is a
+ * literal inside it, the other operands come from v[] */
+#define T2(op, ci, c) \
+    static NOINL void t_##op##_a_##ci(const u128* v, u128* g, u128* r) { *g = op(K(c), v[0]); *r = op##_ref(opq(K(c)), v[0]); } \
+    static NOINL void t_##op##_b_##ci(const u128* v, u128* g, u128* r) { *g = op(v[0], K(c)); *r = op##_ref(v[0], opq(K(c))); }
+#define T3(op, ci, c) \
+    static NOINL void t_##op##_a_##ci(const u128* v, u128* g, u128* r)  { *g = op(K(c), v[0], v[1]); *r = op##_ref(opq(K(c)), v[0], v[1]); } \
+    static NOINL void t_##op##_b_##ci(const u128* v, u128* g, u128* r)  { *g = op(v[0], K(c), v[1]); *r = op##_ref(v[0], opq(K(c)), v[1]); } \
+    static NOINL void t_##op##_c_##ci(const u128* v, u128* g, u128* r)  { *g = op(v[0], v[1], K(c)); *r = op##_ref(v[0], v[1], opq(K(c))); } \
+    static NOINL void t_##op##_bc_##ci(const u128* v, u128* g, u128* r) { *g = op(v[0], K(c), K(c)); *r = op##_ref(v[0], opq(K(c)), opq(K(c))); } \
+    static NOINL void t_##op##_ab_##ci(const u128* v, u128* g, u128* r) { *g = op(K(c), K(c), v[0]); *r = op##_ref(opq(K(c)), opq(K(c)), v[0]); }
+#define TC(op, ci, c, i8) \
+    static NOINL void t_##op##_##i8##_##ci(const u128* v, u128* g, u128* r) { (void)v; *g = op(K(c), i8); *r = op##_ref(opq(K(c)), i8); }
+#define TCV(op, i8) \
+    static NOINL void t_##op##_v##i8(const u128* v, u128* g, u128* r) { *g = op(v[0], i8); *r = op##_ref(v[0], i8); }
+#define CVT_I8(X, op, ci, c) X(op, ci, c, 0) X(op, ci, c, 40) X(op, ci, c, 46) X(op, ci, c, 120) X(op, ci, c, 150) \
+                             X(op, ci, c, 173) X(op, ci, c, 200) X(op, ci, c, 255)
+#define DEFS(ci, c) \
+    T2(spu_fa, ci, c) T2(spu_fs, ci, c) T2(spu_fm, ci, c) \
+    T3(spu_fma, ci, c) T3(spu_fms, ci, c) T3(spu_fnms, ci, c) \
+    T2(spu_fcgt, ci, c) T2(spu_fceq, ci, c) T2(spu_fcmgt, ci, c) T2(spu_fcmeq, ci, c) \
+    CVT_I8(TC, spu_cflts, ci, c) CVT_I8(TC, spu_cfltu, ci, c) CVT_I8(TC, spu_csflt, ci, c) CVT_I8(TC, spu_cuflt, ci, c)
+CONSTS(DEFS)
+#define CVT_V(X, op) X(op, 0) X(op, 28) X(op, 29) X(op, 40) X(op, 46) X(op, 120) X(op, 150) X(op, 155) X(op, 173) X(op, 200) X(op, 250) X(op, 251) X(op, 255)
+CVT_V(TCV, spu_cflts) CVT_V(TCV, spu_cfltu) CVT_V(TCV, spu_csflt) CVT_V(TCV, spu_cuflt)
+
+static const struct { const char* name; test_fn fn; } g_tests[] = {
+#define E2(op, ci) { #op "/a/" #ci, t_##op##_a_##ci }, { #op "/b/" #ci, t_##op##_b_##ci },
+#define E3(op, ci) E2(op, ci) { #op "/c/" #ci, t_##op##_c_##ci }, { #op "/bc/" #ci, t_##op##_bc_##ci }, { #op "/ab/" #ci, t_##op##_ab_##ci },
+#define EC(op, ci, c, i8) { #op "/" #i8 "/" #ci, t_##op##_##i8##_##ci },
+#define ENTS(ci, c) \
+    E2(spu_fa, ci) E2(spu_fs, ci) E2(spu_fm, ci) E3(spu_fma, ci) E3(spu_fms, ci) E3(spu_fnms, ci) \
+    E2(spu_fcgt, ci) E2(spu_fceq, ci) E2(spu_fcmgt, ci) E2(spu_fcmeq, ci) \
+    CVT_I8(EC, spu_cflts, ci, c) CVT_I8(EC, spu_cfltu, ci, c) CVT_I8(EC, spu_csflt, ci, c) CVT_I8(EC, spu_cuflt, ci, c)
+    CONSTS(ENTS)
+#define ECV(op, i8) { #op "/v" #i8, t_##op##_v##i8 },
+    CVT_V(ECV, spu_cflts) CVT_V(ECV, spu_cfltu) CVT_V(ECV, spu_csflt) CVT_V(ECV, spu_cuflt)
+};
+
+static uint64_t g_s = 0x243F6A8885A308D3ull;
+static uint32_t rnd32(void) { g_s ^= g_s << 13; g_s ^= g_s >> 7; g_s ^= g_s << 17; return (uint32_t)(g_s >> 32); }
+static uint32_t lane(int k) {
+    static const uint32_t S[] = { 0, 0x80000000u, 1, 0x80000001u, 0x007FFFFFu, 0x807FFFFFu, 0x00800000u, 0x80800000u,
+        0x00800001u, 0x80800001u, 0x00FFFFFFu, 0x80FFFFFFu, 0x3F800000u, 0xBF800000u, 0x7F7FFFFFu, 0xFF7FFFFFu,
+        0x7F800000u, 0xFF800000u, 0x7FC00000u, 0x7FFFFFFFu, 0xFFFFFFFFu, 0x4F000000u, 0xCF000000u, 0x4F800000u };
+    const int ns = (int)(sizeof S / sizeof S[0]);
+    if (k < ns) return S[k];
+    if (k < ns + NC * 8) {                 /* +-C and its neighbours: tiny sums and differences */
+        k -= ns;
+        const uint32_t c = g_consts[k / 8];
+        return ((k & 4) ? (c ^ 0x80000000u) : c) + (uint32_t)((k & 3) - 1);
+    }
+    uint32_t r = rnd32();
+    switch (r & 7) { case 0: r &= 0x80FFFFFFu; break; case 1: r &= 0x807FFFFFu; break; case 2: r |= 0x7F800000u; break; default: break; }
+    return r;
+}
+
+int main(int argc, char** argv) {
+    const int nv = argc > 1 ? atoi(argv[1]) : 1024;
+    static const unsigned modes[4] = { 0x1F80u, 0x7F80u, 0x9FC0u, 0xFFC0u };
+    static const char* names[4] = { "rn", "rz", "rn+ftz/daz", "rz+ftz/daz" };
+#if defined(SPU_HELPERS_FP_RZDAZ)
+    const int m0 = 3;                      /* the only mode an RZDAZ build is defined for */
+#else
+    const int m0 = 0;
+#endif
+    const int nt = (int)(sizeof g_tests / sizeof g_tests[0]);
+    long long total_bad = 0;
+    for (int m = m0; m < 4; m++) {
+        const unsigned saved = _mm_getcsr();
+        _mm_setcsr(modes[m]);
+        long long bad = 0, n = 0;
+        for (int t = 0; t < nt; t++) {
+            g_s = 0x243F6A8885A308D3ull;
+            for (int i = 0; i < nv; i++) {
+                u128 v[2], got, ref;
+                for (int l = 0; l < 4; l++) { v[0]._u32[l] = lane((i + 7 * l) % nv); v[1]._u32[l] = lane((i * 5 + 3 * l + 1) % nv); }
+                g_tests[t].fn(v, &got, &ref);
+                n++;
+                if (memcmp(&got, &ref, 16) && bad++ < 12)
+                    printf("  MISMATCH [%s] %s v0=%08X.%08X.%08X.%08X got=%08X.%08X.%08X.%08X ref=%08X.%08X.%08X.%08X\n",
+                           names[m], g_tests[t].name, v[0]._u32[0], v[0]._u32[1], v[0]._u32[2], v[0]._u32[3],
+                           got._u32[0], got._u32[1], got._u32[2], got._u32[3], ref._u32[0], ref._u32[1], ref._u32[2], ref._u32[3]);
+            }
+        }
+        _mm_setcsr(saved);
+        printf("  %-11s %d functions, %lld checks, %lld mismatches\n", names[m], nt, n, bad);
+        total_bad += bad;
+    }
+    puts(total_bad ? "test_spu_helpers_constfold: FAIL" : "test_spu_helpers_constfold: ok");
+    return total_bad != 0;
+}
