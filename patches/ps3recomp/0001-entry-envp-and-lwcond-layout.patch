+        if (e && *e) {
+            on = 1;
+            if (*e == '*') all = 1;
+            else while (*e && nid < 8) {
+                char* end; ids[nid] = (u32)strtoul(e, &end, 16);
+                if (end == e) break;
+                nid++; e = (*end == ',') ? end + 1 : end;
+            }
+        }
+        const char* n = getenv("IMM_DIAG_N");
+        if (n && *n) cap = atoi(n);
