+        return s.rstrip()
+
+    # Exits that write back and leave share one block per (write-back set,
+    # way out): a region has an exit on every hop and back-edge safepoint.
+    exits = {}
+
+    def share(i):
+        def ex(mo):
+            if not flushset[i]:
+                return mo.group(1)
+            key = (tuple(sorted(flushset[i])), mo.group(1))
+            if key not in exits:
