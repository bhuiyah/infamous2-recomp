  * Game save data management with callback-driven flow.
  * Save data is stored under: {root}/gamedata/dev_hdd0/home/00000001/savedata/{dirName}/
+ * ({root} is the working directory; PS3_SAVEDATA_DIR replaces the whole path.)
+ *
+ * The on-disk layout is RPCS3's: a binary PARAM.SFO (PSF) next to the title's
+ * own files, unencrypted, so a save directory copies between RPCS3's
+ * dev_hdd0/home/00000001/savedata and ours in either direction.
+ *
+ * Testing knobs, all optional:
+ *   PS3_SAVEDATA_DIR=<dir>    use <dir> as the savedata directory
+ *   PS3_SAVEDATA_PICK=<name>  list save <name> first and load it from list dialogs
+ *   PS3_SAVEDATA_READONLY=1   run every save callback, write nothing to disk
+ * Host tooling can ask which directory is in use (ps3_savedata_root) and which
+ * save the last call loaded or wrote (ps3_savedata_last_op).
  */
 
 #include "cellSaveData.h"
 #include "ps3emu/guest_call.h"
 #include "../../runtime/ppu/ppu_memory.h"
 #include "../../runtime/memory/vm.h"
+#include "../../runtime/savestate/ss_core.h"    /* SS_REASON_GAME_SAVING */
+#include "../../runtime/savestate/ss_state.h"   /* field lists: this file's part of MISC */
