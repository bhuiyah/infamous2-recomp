+int      opt_reset(opt_id id);                      /* back to what the lower layers give */
+int      opt_locked(opt_id id, const char** env_name);
+opt_source_kind opt_source(opt_id id, const char** where, int* line);
+int      opt_preset_apply(int preset);              /* returns the rows changed; saves once */
+int      opt_preset_current(void);                  /* OPT_PRESET_*, or -1 = custom */
+int      opt_restart_pending(void);                 /* RESTART rows whose value != their startup value */
