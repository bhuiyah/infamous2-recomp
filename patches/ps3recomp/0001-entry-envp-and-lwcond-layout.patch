+    if ((r = sys_event_ss_check(why, n)) != 0) return r;
+    if ((r = sys_semaphore_ss_check(why, n)) != 0) return r;
+    if (sys_mutex_ss_live(why, n) || sys_cond_ss_live(why, n) || sys_rwlock_ss_live(why, n) ||
+        sys_timer_ss_live(why, n) || sys_vm_ss_live(why, n) || cellSpurs_ss_live(why, n))
+        return SS_REASON_SECTION;
+    unsigned tid = 0;
+    if (kobj_ss_intr_handlers(&tid)) {
+        snprintf(why, n, "PPU thread %u is an interrupt handler (sys_interrupt_thread_establish):"
+                         " a save cannot hold one yet", tid);
+        return SS_REASON_SECTION;
+    }
+#ifdef _WIN32
+    for (uint32_t i = 0; i < LWC_HASH; i++) {
+        const LwcSlot* c = &g_lwc[i];
+        if (!c->addr) continue;
+        if (c->waiters < 0 || lwc_ss_tokens(c->sem, LWC_SS_TOKEN_CAP) >= LWC_SS_TOKEN_CAP) {
+            snprintf(why, n, "lwcond 0x%08X: %ld waiter(s), %d+ pending token(s)",
+                     (uint32_t)c->addr, (long)c->waiters, LWC_SS_TOKEN_CAP);
+            return SS_REASON_SECTION;
+        }
+    }
+#endif
+    return 0;
+}
+
+static int kobj_ss_capture(ss_writer* w)
+{
+    sys_event_ss_capture(w);
+    sys_semaphore_ss_capture(w);
+    ss_recs_begin(w, &k_ss_lwm_list);
+#ifdef _WIN32
+    for (uint32_t k = 0, i = lw_ss_first(g_lwm, LWM_HASH); k < LWM_HASH; k++, i = (i + 1) & (LWM_HASH - 1)) {
+        const uint32_t a = (uint32_t)g_lwm[i].addr;
+        if (!a) continue;
+        lwm_ss_rec r;
+        r.addr = a;
+        r.held = (uint32_t)lwm_ss_taken(g_lwm[i].sem);
+        r.owner = ss_guest_rd32(a + LWM_OWNER);
+        r.recursion = ss_guest_rd32(a + LWM_RECUR);
+        ss_recs_add(w, a, &r);
+    }
+#endif
+    ss_recs_end(w);
+    ss_recs_begin(w, &k_ss_lwc_list);
+#ifdef _WIN32
+    for (uint32_t k = 0, i = lw_ss_first(g_lwc, LWC_HASH); k < LWC_HASH; k++, i = (i + 1) & (LWC_HASH - 1)) {
+        const uint32_t a = (uint32_t)g_lwc[i].addr;
+        if (!a) continue;
+        lwc_ss_rec r;
+        r.addr = a;
+        r.waiters = (int32_t)g_lwc[i].waiters;
+        r.tokens = (int32_t)lwc_ss_tokens(g_lwc[i].sem, LWC_SS_TOKEN_CAP);
+        ss_recs_add(w, a, &r);
+    }
+#endif
+    ss_recs_end(w);
+    ss_recs_begin(w, &k_ss_lwc_wait_list);       /* keyed by tid; M4c pairs it with PPUT's park */
+#ifdef _WIN32
+    for (uint32_t t = 1; t <= SS_GUEST_TIDS; t++)
+        if (s_lwc_wait[t].phase != LWC_WAIT_NONE) ss_recs_add(w, t, &s_lwc_wait[t]);
+#endif
+    ss_recs_end(w);
+    char scratch[160];                          /* (check() already named any of them) */
+    kobj_ss_empty e;
+    e.mutexes = sys_mutex_ss_live(scratch, sizeof scratch);
+    e.conds = sys_cond_ss_live(scratch, sizeof scratch);
+    e.rwlocks = sys_rwlock_ss_live(scratch, sizeof scratch);
+    e.timers = sys_timer_ss_live(scratch, sizeof scratch);
+    e.intr_handlers = kobj_ss_intr_handlers(nullptr);
+    e.vm_maps = sys_vm_ss_live(scratch, sizeof scratch);
+    e.spurs_hle = cellSpurs_ss_live(scratch, sizeof scratch);
+    ss_write_fields_at(w, &k_ss_empty_list, &e);
+    return ss_writer_error(w);
+}
+
+/* Outside a stop: the records as the writer lays them out (a key and every
+ * field 8-aligned), with room for objects created before the stop. */
+static uint64_t kobj_ss_size_hint(void)
+{
+    uint64_t lwm = 0, lwc = 0;
+#ifdef _WIN32
+    for (uint32_t i = 0; i < LWM_HASH; i++) lwm += g_lwm[i].addr != 0;
+    for (uint32_t i = 0; i < LWC_HASH; i++) lwc += g_lwc[i].addr != 0;
+#endif
+    const uint64_t b = sys_event_ss_size() + 256u * 40u + lwm * 40u + lwc * 32u +
+                       SS_GUEST_TIDS * 56u + 4096u;
+    return b + b / 4 + 65536u;
+}
+
+/* TEARDOWN (the load, no guest thread alive; see the top of this block). */
+static void kobj_ss_teardown(void)
+{
+    sys_timer_ss_teardown();                    /* first: a timer thread posts to the queues */
+    sys_event_ss_teardown();
+    sys_semaphore_ss_teardown();
+    sys_mutex_ss_teardown();
+    sys_cond_ss_teardown();
+    sys_rwlock_ss_teardown();
+#ifdef _WIN32
+    for (uint32_t i = 0; i < LWM_HASH; i++)
+        if (g_lwm[i].sem) CloseHandle(g_lwm[i].sem);
+    memset((void*)g_lwm, 0, sizeof g_lwm);
+    for (uint32_t i = 0; i < LWC_HASH; i++)
+        if (g_lwc[i].sem) CloseHandle(g_lwc[i].sem);
+    memset((void*)g_lwc, 0, sizeof g_lwc);
+    memset(s_lwc_wait, 0, sizeof s_lwc_wait);
+#endif
+    memset(s_spin_owner, 0, sizeof s_spin_owner);   /* (host thread ids of the old threads) */
+}
+
+#ifdef _WIN32
+/* The lw registries from the image, into the emptied registries (apply) or,
+ * for the check, into keys -- LWM_HASH + LWC_HASH zeroed words probed the
+ * same way, so a record listed twice or one too many is refused before the
+ * stop. Records come in the capture's order (lw_ss_first), which puts each
+ * in the slot it had. */
+static int kobj_ss_load_lw(ss_reader* r, int apply, uint32_t* keys)
+{
+    ss_recs_it it;
+    uint32_t key;
+    int k, e;
+    if ((e = ss_recs_open(r, &k_ss_lwm_list, &it)) != 0) return e;
+    for (;;) {
+        lwm_ss_rec t;
+        memset(&t, 0, sizeof t);
+        if ((k = ss_recs_next(&it, &key, &t)) != 1) break;
+        if (!key || t.addr != key)
+            return ss_reader_fail(r, SS_E_CORRUPT, "lwmutexes[0x%08X].addr: 0x%08X", key, t.addr);
+        if (t.held > 1) return ss_reader_fail(r, SS_E_CORRUPT, "lwmutexes[0x%08X].held: %u", key, t.held);
+        const long s = apply ? lw_ss_probe(LWM_HASH, key, [](uint32_t i) { return (uint32_t)g_lwm[i].addr; })
+                             : lw_ss_probe(LWM_HASH, key, [keys](uint32_t i) { return keys[i]; });
+        if (s < 0)
+            return ss_reader_fail(r, SS_E_CORRUPT, "lwmutexes[0x%08X]: listed twice, or more than the registry's %u",
+                                  key, (unsigned)LWM_HASH);
+        if (!apply) { keys[s] = key; continue; }
+        /* taken (count 0) or free (1): the owner and recursion words are
+         * GMEM's, as captured, so the holder goes on holding it */
+        HANDLE h = CreateSemaphoreA(NULL, t.held ? 0 : 1, 1, NULL);
+        if (!h)
+            return ss_reader_fail(r, SS_E_NOMEM, "lwmutexes[0x%08X]: CreateSemaphore failed (error %lu)", key,
+                                  (unsigned long)GetLastError());
+        g_lwm[s].sem = h;
+        g_lwm[s].addr = (long)key;
+    }
+    if (k < 0) return k;
+
+    if ((e = ss_recs_open(r, &k_ss_lwc_list, &it)) != 0) return e;
+    for (;;) {
+        lwc_ss_rec t;
+        memset(&t, 0, sizeof t);
+        if ((k = ss_recs_next(&it, &key, &t)) != 1) break;
+        if (!key || t.addr != key)
+            return ss_reader_fail(r, SS_E_CORRUPT, "lwconds[0x%08X].addr: 0x%08X", key, t.addr);
+        if (t.waiters < 0) return ss_reader_fail(r, SS_E_CORRUPT, "lwconds[0x%08X].waiters: %d", key, t.waiters);
+        if (t.tokens < 0 || t.tokens >= LWC_SS_TOKEN_CAP)
+            return ss_reader_fail(r, SS_E_CORRUPT, "lwconds[0x%08X].tokens: %d out of 0..%d", key, t.tokens,
+                                  LWC_SS_TOKEN_CAP - 1);
+        uint32_t* lk = keys ? keys + LWM_HASH : nullptr;
+        const long s = apply ? lw_ss_probe(LWC_HASH, key, [](uint32_t i) { return (uint32_t)g_lwc[i].addr; })
+                             : lw_ss_probe(LWC_HASH, key, [lk](uint32_t i) { return lk[i]; });
+        if (s < 0)
+            return ss_reader_fail(r, SS_E_CORRUPT, "lwconds[0x%08X]: listed twice, or more than the registry's %u",
+                                  key, (unsigned)LWC_HASH);
+        if (!apply) { lk[s] = key; continue; }
+        /* the signals' pending tokens, and the waiters still registered (a
+         * LWCOND park resumes by waiting for a token without registering) */
+        HANDLE h = CreateSemaphoreA(NULL, (LONG)t.tokens, 0x7FFFFFFF, NULL);
+        if (!h)
+            return ss_reader_fail(r, SS_E_NOMEM, "lwconds[0x%08X]: CreateSemaphore failed (error %lu)", key,
+                                  (unsigned long)GetLastError());
+        g_lwc[s].sem = h;
+        g_lwc[s].waiters = (long)t.waiters;
+        g_lwc[s].addr = (long)key;
+    }
+    if (k < 0) return k;
+
+    uint64_t seen = 0;
+    if ((e = ss_recs_open(r, &k_ss_lwc_wait_list, &it)) != 0) return e;
+    for (;;) {
+        lwc_wait_rec t;
+        memset(&t, 0, sizeof t);
+        if ((k = ss_recs_next(&it, &key, &t)) != 1) break;
+        if (key < 1 || key > SS_GUEST_TIDS)
+            return ss_reader_fail(r, SS_E_CORRUPT, "lwcond_waits[%u]: no such guest thread id", key);
+        if (seen & (1ull << (key - 1))) return ss_reader_fail(r, SS_E_CORRUPT, "lwcond_waits[%u]: listed twice", key);
+        seen |= 1ull << (key - 1);
+        if (t.phase != LWC_WAIT_SIGNAL && t.phase != LWC_WAIT_REACQ)
+            return ss_reader_fail(r, SS_E_CORRUPT, "lwcond_waits[%u].phase: %u", key, t.phase);
+        if (apply) s_lwc_wait[key] = t;
+    }
+    return k < 0 ? k : SS_OK;
+}
+#endif
+
+/* RESTORE (apply 1, after KMEM and GMEM) and check_image (apply 0, the world
+ * running, nothing written): the objects the image says are unused must be
+ * so (asserted_empty -- this build saves none of them, so it cannot restore
+ * one), then the event and semaphore tables, then the lw registries. */
+static int kobj_ss_load(ss_reader* r, int apply)
+{
+    kobj_ss_empty z;
+    memset(&z, 0, sizeof z);
+    int e = ss_read_fields_at(r, &k_ss_empty_list, &z);
+    if (e) return e;
+    for (uint32_t i = 0; i < k_ss_empty_list.n; i++) {
+        int32_t v;
+        memcpy(&v, (const uint8_t*)&z + (uintptr_t)k_ss_empty_list.f[i].at, sizeof v);
+        if (v)
+            return ss_reader_fail(r, SS_E_STATE, "asserted_empty.%s: %d in the image (this build restores none)",
+                                  k_ss_empty_list.f[i].name, v);
+    }
+    if ((e = sys_event_ss_restore(r, apply)) != 0) return e;
+    if ((e = sys_semaphore_ss_restore(r, apply)) != 0) return e;
+#ifdef _WIN32
+    uint32_t* keys = nullptr;
+    if (!apply && !(keys = (uint32_t*)calloc(LWM_HASH + LWC_HASH, sizeof *keys)))
+        return ss_reader_fail(r, SS_E_NOMEM, "lwmutexes: no memory to check the records");
+    e = kobj_ss_load_lw(r, apply, keys);
+    free(keys);
+#endif
+    return e;
+}
+static int kobj_ss_restore(ss_reader* r)     { return kobj_ss_load(r, 1); }
+static int kobj_ss_check_image(ss_reader* r) { return kobj_ss_load(r, 0); }
+
+static const ss_section_ops k_kobj_ops = {
+    SS_FOURCC('K', 'O', 'B', 'J'), 1, 0, SS_ORDER_KERNEL,
+    kobj_ss_check, kobj_ss_capture, kobj_ss_teardown, kobj_ss_restore, NULL,
+    "lv2 kernel objects", k_kobj_lists, kobj_ss_size_hint, NULL, kobj_ss_check_image,
+};
+SS_SECTION_REGISTER(k_kobj_ops)
+
+static const ss_field k_ss_sysprx_kmem_fields[] = {
+    SS_FIELD(s_tls_next), SS_FIELD(s_mm_sizes), SS_FIELD(s_mmapper_next_id), SS_FIELD(s_gcm_bump),
+    SS_FIELD(s_lwcond_id), SS_FIELD(s_seg_bump), SS_FIELD(s_spu_img_src), SS_FIELD(g_spu_image_src_ea),
+    SS_FIELD(g_spu_image_ls_start), SS_FIELD(g_spu_image_span), SS_FIELD(s_net_fd), SS_FIELD(g_net_errno_ea),
+};
+static const ss_list k_ss_sysprx_kmem_list = SS_LIST("sysprx", k_ss_sysprx_kmem_fields);
+static const ss_field k_ss_stack_fields[] = { SS_FIELD(g_vm_stack_alloc) };
+static const ss_list k_ss_stack_list = SS_LIST("stacks", k_ss_stack_fields);
+static const ss_list* const k_kmem_lists[] = {
+    &g_ss_list_kmem_allocs, &g_ss_list_kmem_containers, &g_ss_list_kmem_shared, &g_ss_list_kmem_sysmem,
+    &g_ss_list_kmem_vm, &g_ss_list_kmem_loader, &k_ss_sysprx_kmem_list, &k_ss_stack_list, NULL,
+};
+
+static int kmem_ss_capture(ss_writer* w)
+{
+    sys_memory_ss_capture(w);
+    sys_vm_ss_capture(w);
+    ppu_loader_ss_kmem(w);
+    ss_write_fields(w, &k_ss_sysprx_kmem_list);
+    ss_write_fields(w, &k_ss_stack_list);
+    return ss_writer_error(w);
+}
+
+/* RESTORE (apply 1, right after GMEM) and check_image (apply 0: the tables'
+ * keys and the loader's fixup count; the statics need no check beyond their
+ * layout, which the image's validation has compared). No teardown: KMEM
+ * holds no host object, and the restore replaces every value. */
+static int kmem_ss_load(ss_reader* r, int apply)
+{
+    int e;
+    if ((e = sys_memory_ss_restore(r, apply)) != 0) return e;
+    if ((e = ppu_loader_ss_kmem_restore(r, apply)) != 0) return e;
+    if (!apply) return SS_OK;
+    if ((e = ss_read_fields(r, &g_ss_list_kmem_vm)) != 0) return e;   /* sys_vm.c's window bump */
+    if ((e = ss_read_fields(r, &k_ss_sysprx_kmem_list)) != 0) return e;
+    return ss_read_fields(r, &k_ss_stack_list);
+}
+static int kmem_ss_restore(ss_reader* r)     { return kmem_ss_load(r, 1); }
+static int kmem_ss_check_image(ss_reader* r) { return kmem_ss_load(r, 0); }
+
+static const ss_section_ops k_kmem_ops = {
+    SS_FOURCC('K', 'M', 'E', 'M'), 1, 0, SS_ORDER_ALLOC,
+    NULL, kmem_ss_capture, NULL, kmem_ss_restore, NULL,
+    "guest allocators", k_kmem_lists, NULL, NULL, kmem_ss_check_image,
+};
+SS_SECTION_REGISTER(k_kmem_ops)
+
+#ifdef _WIN32
+static uint64_t ss_anchor_system_us(void)
+{
+    if (!s_systime_freq.QuadPart) return 0;
+    return systime_us_at(ps3_guest_qpc());
+}
+/* A load (M4c), inside TIME's restore with the guest clock frozen at the
+ * snapshot's instant: the base set so the clock reads the snapshot's value
+ * now (and goes on from it), or -- never read then -- unread again. */
+extern "C" int64_t ps3_guest_undilate_back(int64_t b, uint64_t d);   /* sys_timer.c */
+static void ss_anchor_system_restore(uint64_t saved, const ss_time_info* at)
+{
+    (void)at;
+    if (!saved) { s_systime_freq.QuadPart = 0; s_systime_base.QuadPart = 0; return; }
+    QueryPerformanceFrequency(&s_systime_freq);
+    const uint64_t f = (uint64_t)s_systime_freq.QuadPart;
+    const uint64_t ticks = (saved / 1000000ull) * f + (saved % 1000000ull) * f / 1000000ull;
+    s_systime_base.QuadPart = ps3_guest_undilate_back(ps3_guest_qpc(), ticks);
+}
+static const ss_time_anchor k_ss_anchor_systime = { "sys_time.system_us", ss_anchor_system_us,
+                                                    ss_anchor_system_restore };
+namespace { const int s_ss_anchor_systime_added = ss_time_anchor_add(&k_ss_anchor_systime); }
+#endif
diff --git a/runtime/ppu/ppu_vm_inline.h b/runtime/ppu/ppu_vm_inline.h
new file mode 100644
index 0000000..3b04775
--- /dev/null
+++ b/runtime/ppu/ppu_vm_inline.h
@@ -0,0 +1,210 @@
+/*
+ * ps3recomp - the guest memory accessors' fast path, shared by the out-of-line
+ * accessors (ppu_loader.cpp) and, with PPU_VM_INLINE, inlined into lifted code.
+ *
+ * Every lifted guest load and store calls vm_read8..64 / vm_write8..64
+ * (ppu_recomp.h). They live in ppu_loader.cpp, so each one is a call into
+ * another translation unit, and a PPU main thread spends a large share of its
+ * compute in those calls and their bodies (inFamous 2: ~43%). The decision
+ * whether an access is ordinary is a few predictable compares, and that
+ * decision is all this header holds:
+ *
+ *   - PPU_VM_RD_GATE() / PPU_VM_WR_GATE(): zero while no env-armed read / write
+ *     diagnostic, no POSIX bounds check (ppu_vm_size) and no run-time store
+ *     watch (g_barrier_sync_watch) is set (see vm_diag_init in ppu_loader.cpp);
+ *   - PPU_VM_FAST_RD_OK / PPU_VM_FAST_WR_OK: the address is not in the null
+ *     window ([null-read] / [null-write]) and not in the raw-SPU problem-state
+ *     window at 0xE0000000+ (MMIO side effects);
+ *   - reads of the GCM ref register (PPU_VM_GCM_REF_EA, GCM_REFPOLL) are never
+ *     ordinary;
+ *   - stores to a 128-byte line an SPU has reserved are never ordinary
+ *     (lock-line serialization + lost-reservation event).
+ *
+ * ppu_loader.cpp's vm_read* / vm_write* test exactly these macros, so the two
+ * paths cannot drift apart.
+ *
+ * PPU_VM_INLINE (the project defines it, and force-includes this header, for
+ * the lifted PPU translation units only): the accessors the lifted code calls
+ * become always-inline functions here. An ordinary access is the byte-swapped
+ * load or store in place; EVERY other access calls the out-of-line accessor of
+ * the same name with the same arguments, which tests again and takes its full
+ * path -- so null reports, dropped null stores, raw-SPU MMIO, GCM_REFPOLL, SPU
+ * lock-line coherence, the env-armed watches and the POSIX bounds check behave
+ * exactly as before, and their reports still name the lifted caller
+ * (__builtin_return_address(0) of the out-of-line call is in it).
+ * PPU_VM_INLINE_READS / PPU_VM_INLINE_WRITES (default 1 each) pick the kinds:
+ * inline stores carry the reserved-line test and grow the code more than they
+ * save, so the project's IF2_PPU_VM_INLINE=reads inlines loads only.
+ *
+ * The one difference is diagnostic: the HOTREAD spin detector ([HOTREAD*]
+ * "spinning on" lines, and STALL_DUMP / PPU_SPINBT, which hang off its report)
+ * is a per-thread counter bumped on every read of the out-of-line fast path;
+ * inline, that TLS update costs more than the call it replaces, so inline reads
+ * skip it. It only ever prints (STALL_DUMP also asks the SPUs to dump). Built
+ * with PPU_VM_INLINE_LIFTED, ppu_loader.cpp counts PPU_HOTREAD=1, STALL_DUMP
+ * and PPU_SPINBT as read diagnostics: setting one sends every lifted read
+ * through the out-of-line full path, where the detector runs as before.
+ *
+ * Loads and stores are volatile, unaligned-tolerant accesses (PPC allows
+ * unaligned lwz/stw; the out-of-line accessors memcpy): the compiler keeps
+ * every guest access, in program order, exactly as the opaque calls forced it
+ * to -- it cannot merge, drop, hoist or reorder them against each other (a
+ * guest spin on a word stays a spin) or move them across a call (the
+ * out-of-line accessors, syscalls, fences) -- and on x86-64 each one is one
+ * plain mov. The lifted vector loads/stores (memcpy at vm_base, not accessor
+ * calls) may now be scheduled across an inline access to a provably different
+ * address, which the PPC memory model allows anyway without a sync/lwsync,
+ * and those are fences in the lifted code.
+ *
+ * Clang/GCC only (statement attributes, __builtin_bswap*, __builtin_expect).
+ */
+#ifndef PPU_VM_INLINE_H
+#define PPU_VM_INLINE_H
+
+#include <stdint.h>
+#include "../spu/spu_raw.h"          /* SPU_RAW_BASE                       */
+#include "../spu/spu_coh_bitmap.h"   /* spu_coh_is_reserved_inline         */
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern uint8_t* vm_base;                /* guest address 0 (the host owns it)   */
+extern int      g_vm_rd_diag;           /* ppu_loader.cpp: vm_diag_init          */
+extern int      g_vm_wr_diag;
+extern uint32_t ppu_vm_size;            /* 0 = unchecked (Windows backs 4 GB)    */
+extern uint32_t g_barrier_sync_watch;   /* store watch armed at run time         */
+extern uint32_t ppu_hle_inject_base;    /* = VM_HLE_INJECT_BASE (memory/vm.h)    */
+#ifdef __cplusplus
+}
+#endif
+
+/* Address windows the fast path never serves. Reads: the 64 KB null window
+ * ([null-read]) and everything from the raw-SPU window up (vm_read32's
+ * problem-state loads). Writes: the 4 KB null page ([null-write], dropped
+ * stores) and the raw-SPU window (vm_write32's problem-state side effects).
+ * The other widths had nothing special there; sending them to the full path
+ * anyway costs nothing but keeps one rule. */
+#define PPU_VM_FAST_RD_OK(ea) ((uint32_t)((ea) - 0x10000u) < (SPU_RAW_BASE - 0x10000u))
+#define PPU_VM_FAST_WR_OK(ea) ((uint32_t)((ea) - 0x1000u)  < (SPU_RAW_BASE - 0x1000u))
+/* Nonzero while anything at all can apply to an access of that kind. */
+#define PPU_VM_RD_GATE() ((uint32_t)g_vm_rd_diag | ppu_vm_size)
+#define PPU_VM_WR_GATE() ((uint32_t)g_vm_wr_diag | ppu_vm_size | g_barrier_sync_watch)
+/* The GCM ref register: a read advances queued fences (GCM_REFPOLL). */
+#define PPU_VM_GCM_REF_EA() (ppu_hle_inject_base + 0x2008u)
+
+/* PPU_VM_INLINE_SHARED_ONLY: ppu_loader.cpp, which defines the out-of-line
+ * accessors and wants only the predicates above. */
+#if defined(PPU_VM_INLINE) && PPU_VM_INLINE && !defined(PPU_VM_INLINE_SHARED_ONLY)
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* The out-of-line accessors (ppu_loader.cpp): every access the inline test
+ * does not take goes here, unchanged. */
+uint8_t  vm_read8 (uint64_t addr);
+uint16_t vm_read16(uint64_t addr);
+uint32_t vm_read32(uint64_t addr);
+uint64_t vm_read64(uint64_t addr);
+void     vm_write8 (uint64_t addr, uint8_t  val);
+void     vm_write16(uint64_t addr, uint16_t val);
+void     vm_write32(uint64_t addr, uint32_t val);
+void     vm_write64(uint64_t addr, uint64_t val);
+
+#define PPU_VMI_FN static inline __attribute__((always_inline))
+
+/* One guest-width load or store at host address p (no byte swap). */
+typedef uint16_t ppu_vmi_u16 __attribute__((aligned(1), may_alias));
+typedef uint32_t ppu_vmi_u32 __attribute__((aligned(1), may_alias));
+typedef uint64_t ppu_vmi_u64 __attribute__((aligned(1), may_alias));
+PPU_VMI_FN uint8_t  ppu_vmi_ld8 (const uint8_t* p) { return *(const volatile uint8_t*)p; }
+PPU_VMI_FN uint16_t ppu_vmi_ld16(const uint8_t* p) { return *(const volatile ppu_vmi_u16*)p; }
+PPU_VMI_FN uint32_t ppu_vmi_ld32(const uint8_t* p) { return *(const volatile ppu_vmi_u32*)p; }
+PPU_VMI_FN uint64_t ppu_vmi_ld64(const uint8_t* p) { return *(const volatile ppu_vmi_u64*)p; }
+PPU_VMI_FN void ppu_vmi_st8 (uint8_t* p, uint8_t  v) { *(volatile uint8_t*)p = v; }
+PPU_VMI_FN void ppu_vmi_st16(uint8_t* p, uint16_t v) { *(volatile ppu_vmi_u16*)p = v; }
+PPU_VMI_FN void ppu_vmi_st32(uint8_t* p, uint32_t v) { *(volatile ppu_vmi_u32*)p = v; }
+PPU_VMI_FN void ppu_vmi_st64(uint8_t* p, uint64_t v) { *(volatile ppu_vmi_u64*)p = v; }
+
+#define PPU_VMI_RD_OK(ea)  __builtin_expect(PPU_VM_RD_GATE() == 0 && PPU_VM_FAST_RD_OK(ea), 1)
+#define PPU_VMI_WR_OK(ea)  __builtin_expect(PPU_VM_WR_GATE() == 0 && PPU_VM_FAST_WR_OK(ea) && \
+                                            !spu_coh_is_reserved_inline(ea), 1)
+
+PPU_VMI_FN uint8_t ppu_vmi_read8(uint64_t a)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (PPU_VMI_RD_OK(ea)) return ppu_vmi_ld8(vm_base + ea);
+    return vm_read8(a);
+}
+PPU_VMI_FN uint16_t ppu_vmi_read16(uint64_t a)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (PPU_VMI_RD_OK(ea)) return __builtin_bswap16(ppu_vmi_ld16(vm_base + ea));
+    return vm_read16(a);
+}
+PPU_VMI_FN uint32_t ppu_vmi_read32(uint64_t a)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (__builtin_expect(PPU_VM_RD_GATE() == 0 && PPU_VM_FAST_RD_OK(ea) &&
+                         ea != PPU_VM_GCM_REF_EA(), 1))
+        return __builtin_bswap32(ppu_vmi_ld32(vm_base + ea));
+    return vm_read32(a);
+}
+PPU_VMI_FN uint64_t ppu_vmi_read64(uint64_t a)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (PPU_VMI_RD_OK(ea)) return __builtin_bswap64(ppu_vmi_ld64(vm_base + ea));
+    return vm_read64(a);
+}
+PPU_VMI_FN void ppu_vmi_write8(uint64_t a, uint8_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (PPU_VMI_WR_OK(ea)) { ppu_vmi_st8(vm_base + ea, v); return; }
+    vm_write8(a, v);
+}
+PPU_VMI_FN void ppu_vmi_write16(uint64_t a, uint16_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (PPU_VMI_WR_OK(ea)) { ppu_vmi_st16(vm_base + ea, __builtin_bswap16(v)); return; }
+    vm_write16(a, v);
+}
+PPU_VMI_FN void ppu_vmi_write32(uint64_t a, uint32_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (PPU_VMI_WR_OK(ea)) { ppu_vmi_st32(vm_base + ea, __builtin_bswap32(v)); return; }
+    vm_write32(a, v);
+}
+PPU_VMI_FN void ppu_vmi_write64(uint64_t a, uint64_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (PPU_VMI_WR_OK(ea)) { ppu_vmi_st64(vm_base + ea, __builtin_bswap64(v)); return; }
+    vm_write64(a, v);
+}
+#ifdef __cplusplus
+}
+#endif
+
+/* The lifted code (and ppu_recomp.h's prototypes, which then redeclare these
+ * static functions) see the inline versions under the usual names. This header
+ * is force-included ahead of ppu_recomp.h, so the out-of-line names above were
+ * bound before the rename. */
+#ifndef PPU_VM_INLINE_READS
+#  define PPU_VM_INLINE_READS 1      /* 0: loads stay out-of-line calls  */
+#endif
+#ifndef PPU_VM_INLINE_WRITES
+#  define PPU_VM_INLINE_WRITES 1     /* 0: stores stay out-of-line calls */
+#endif
+#if PPU_VM_INLINE_READS
+#define vm_read8   ppu_vmi_read8
+#define vm_read16  ppu_vmi_read16
+#define vm_read32  ppu_vmi_read32
+#define vm_read64  ppu_vmi_read64
+#endif
+#if PPU_VM_INLINE_WRITES
+#define vm_write8  ppu_vmi_write8
+#define vm_write16 ppu_vmi_write16
+#define vm_write32 ppu_vmi_write32
+#define vm_write64 ppu_vmi_write64
+#endif
+
+#endif /* PPU_VM_INLINE */
+#endif /* PPU_VM_INLINE_H */
diff --git a/runtime/ppu/tests/hle_abi_mock.c b/runtime/ppu/tests/hle_abi_mock.c
new file mode 100644
index 0000000..4291a84
--- /dev/null
+++ b/runtime/ppu/tests/hle_abi_mock.c
@@ -0,0 +1,177 @@
+/*
+ * ps3recomp - mock HLE handlers for test_hle_abi.cpp.
+ *
+ * gen_hle_nids.py scans this file exactly as it scans libs/**: every
+ * definition below whose prototype has a float/double parameter or result (or
+ * more than eight parameters) must come out as an ELFv1 thunk registered with
+ * ps3_hle_register_abi, every other one as a plain ps3_hle_register. Each
+ * handler records what it received so the test can check the marshalling.
+ * The shapes copy the real ones they stand for (named in each comment).
+ */
+#include "ps3emu/ps3types.h"
+#include <stdint.h>
+#include <string.h>
+
+#ifdef __cplusplus   /* run_test_hle_abi.py may build everything as C++ */
+extern "C" {
+#endif
+
+typedef u32 CellMockPortId;                       /* scalar typedef (cellVoice) */
+typedef enum { MOCK_E0 = 0, MOCK_E1 = 7 } CellMockEnum;
+typedef struct CellMockFont { u32 x; } CellMockFont;
+typedef void (*CellMockCallback)(u32 a);
+
+/* What the last mock call received. */
+u64    g_mock_i[12];
+double g_mock_f[16];
+int    g_mock_calls;
+char   g_mock_last[48];
+
+static void mock_note(const char* name)
+{
+    g_mock_calls++;
+    strncpy(g_mock_last, name, sizeof g_mock_last - 1);
+    g_mock_last[sizeof g_mock_last - 1] = 0;
+}
+
+/* cellVideoOutSetGamma(u32 videoOut, float gamma): r3, f1 (r4 skipped). */
+s32 cellMockSetGamma(u32 videoOut, float gamma)
+{
+    mock_note("cellMockSetGamma");
+    g_mock_i[0] = videoOut; g_mock_f[0] = gamma;
+    return -5;   /* negative: r3 must be sign-extended */
+}
+
+/* cellFontRenderCharGlyphImage: r3 r4 r5 f1 f2 r8 r9. */
+s32 cellMockGlyph(CellMockFont* font, u32 code, void* surface, float x, float y,
+                  void* metrics, void* image)
+{
+    mock_note("cellMockGlyph");
+    g_mock_i[0] = (u64)(uintptr_t)font; g_mock_i[1] = code;
+    g_mock_i[2] = (u64)(uintptr_t)surface;
+    g_mock_f[0] = x; g_mock_f[1] = y;
+    g_mock_i[3] = (u64)(uintptr_t)metrics; g_mock_i[4] = (u64)(uintptr_t)image;
+    return 0;
+}
+
+/* The ELFv1 supplement's Figure 3-18 order, with our scalar types:
+ * c -> r3, ff -> f1, d -> r5, gg -> f2, e -> r7. */
+s32 cellMockMixed(s32 c, double ff, s32 d, float gg, s32 e)
+{
+    mock_note("cellMockMixed");
+    g_mock_i[0] = (u64)(s64)c; g_mock_f[0] = ff; g_mock_i[1] = (u64)(s64)d;
+    g_mock_f[1] = gg; g_mock_i[2] = (u64)(s64)e;
+    return 0;
+}
+
+/* cellRescAdjustAspectRatio(float, float): f1, f2. */
+s32 cellMockTwoFloats(float h, float v)
+{
+    mock_note("cellMockTwoFloats");
+    g_mock_f[0] = h; g_mock_f[1] = v;
+    return 0;
+}
+
+/* cellVoiceSetVolume(CellVoicePortId, float): typedef'd scalar, then f1. */
+s32 cellMockTypedef(CellMockPortId port, float volume)
+{
+    mock_note("cellMockTypedef");
+    g_mock_i[0] = port; g_mock_f[0] = volume;
+    return 0;
+}
+
+/* An enum and a function-pointer typedef next to a float. */
+s32 cellMockEnumCb(CellMockEnum e, CellMockCallback cb, float f)
+{
+    mock_note("cellMockEnumCb");
+    g_mock_i[0] = (u64)e; g_mock_i[1] = (u64)(uintptr_t)cb; g_mock_f[0] = f;
+    return 0;
+}
+
+/* Results in f1. */
+float cellMockRetFloat(float a, float b)
+{
+    mock_note("cellMockRetFloat");
+    g_mock_f[0] = a; g_mock_f[1] = b;
+    return a * b;
+}
+
+double cellMockRetDouble(u32 n, double a)
+{
+    mock_note("cellMockRetDouble");
+    g_mock_i[0] = n; g_mock_f[0] = a;
+    return a * 2.0 + n;
+}
+
+/* A void result: r3 must be left alone. */
+void cellMockVoidFloat(float v)
+{
+    mock_note("cellMockVoidFloat");
+    g_mock_f[0] = v;
+}
+
+/* Fourteen floats: f1..f13, then the 14th from its save-area doubleword. */
+s32 cellMockFourteen(float a0, float a1, float a2, float a3, float a4, float a5,
+                     float a6, float a7, float a8, float a9, float a10, float a11,
+                     float a12, double a13)
+{
+    mock_note("cellMockFourteen");
+    g_mock_f[0] = a0; g_mock_f[1] = a1; g_mock_f[2] = a2; g_mock_f[3] = a3;
+    g_mock_f[4] = a4; g_mock_f[5] = a5; g_mock_f[6] = a6; g_mock_f[7] = a7;
+    g_mock_f[8] = a8; g_mock_f[9] = a9; g_mock_f[10] = a10; g_mock_f[11] = a11;
+    g_mock_f[12] = a12; g_mock_f[13] = a13;
+    return 0;
+}
+
+/* Nine integers and a float past slot 8: the 9th integer comes from the
+ * save area (r1+0x70), the float still from f1. */
+s32 cellMockNinePlusFloat(u32 a0, u32 a1, u32 a2, u32 a3, u32 a4, u32 a5,
+                          u32 a6, u32 a7, u32 a8, float f)
+{
+    mock_note("cellMockNinePlusFloat");
+    g_mock_i[0] = a0; g_mock_i[1] = a1; g_mock_i[2] = a2; g_mock_i[3] = a3;
+    g_mock_i[4] = a4; g_mock_i[5] = a5; g_mock_i[6] = a6; g_mock_i[7] = a7;
+    g_mock_i[8] = a8; g_mock_f[0] = f;
+    return 0;
+}
+
+/* cellGcmSetZcull: twelve integer parameters, no float -- 9th..12th from the
+ * save area. */
+s32 cellMockTwelve(u8 index, u32 a1, u32 a2, u32 a3, u32 a4, u32 a5, u32 a6,
+                   u32 a7, u32 a8, u32 a9, u32 a10, u32 a11)
+{
+    mock_note("cellMockTwelve");
+    g_mock_i[0] = index; g_mock_i[1] = a1; g_mock_i[2] = a2; g_mock_i[3] = a3;
+    g_mock_i[4] = a4; g_mock_i[5] = a5; g_mock_i[6] = a6; g_mock_i[7] = a7;
+    g_mock_i[8] = a8; g_mock_i[9] = a9; g_mock_i[10] = a10; g_mock_i[11] = a11;
+    return 0;
+}
+
+/* A raw function-pointer parameter (its own commas inside the parentheses)
+ * before a float: three parameters, r3 / f1 / r5 -- not five. */
+s32 cellMockFnPtrFloat(void (*cb)(u32 a, u32 b), float f, u32 n)
+{
+    mock_note("cellMockFnPtrFloat");
+    g_mock_i[0] = (u64)(uintptr_t)cb; g_mock_f[0] = f; g_mock_i[1] = n;
+    return 0;
+}
+
+/* Integer-only, eight or fewer: stays on the integer adapter. */
+s32 cellMockIntOnly(u32 a, u32 b)
+{
+    mock_note("cellMockIntOnly");
+    g_mock_i[0] = a; g_mock_i[1] = b;
+    return 0;
+}
+
+/* A float POINTER is an integer argument (the guest address). */
+s32 cellMockFloatPtr(u32 a, float* out)
+{
+    mock_note("cellMockFloatPtr");
+    g_mock_i[0] = a; g_mock_i[1] = (u64)(uintptr_t)out;
+    return 0;
+}
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/runtime/ppu/tests/hle_abi_mock_bad.c b/runtime/ppu/tests/hle_abi_mock_bad.c
new file mode 100644
index 0000000..97ff641
--- /dev/null
+++ b/runtime/ppu/tests/hle_abi_mock_bad.c
@@ -0,0 +1,23 @@
+/*
+ * ps3recomp - prototypes gen_hle_nids.py must REFUSE (test_hle_abi.cpp runs
+ * the generator on this file and expects exit status 1 naming both): a float
+ * next to an aggregate passed by value, and a float in a varargs function.
+ * Neither can be marshalled by the ELFv1 thunk, and falling back to the
+ * integer adapter would hand the handler garbage without a word.
+ * Never compiled.
+ */
+#include "ps3emu/ps3types.h"
+
+typedef struct CellMockVec { float x, y; } CellMockVec;
+
+s32 cellMockBadStruct(CellMockVec v, float f)
+{
+    (void)v; (void)f;
+    return 0;
+}
+
+s32 cellMockBadVarargs(float f, ...)
+{
+    (void)f;
+    return 0;
+}
diff --git a/runtime/ppu/tests/run_test_hle_abi.py b/runtime/ppu/tests/run_test_hle_abi.py
new file mode 100644
index 0000000..85e2990
--- /dev/null
+++ b/runtime/ppu/tests/run_test_hle_abi.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Build and run the ELFv1 float/double HLE marshalling tests.
+
+    py runtime/ppu/tests/run_test_hle_abi.py [--lift DIR] [--cc COMPILER] [--out DIR]
+
+1. gen_hle_nids.py on hle_abi_mock.c -> the thunks under test;
+2. gen_hle_nids.py on hle_abi_mock_bad.c must FAIL, naming both prototypes;
+3. test_hle_abi (cursor rule + generated thunks);
+4. with --lift (a directory holding a lift's ppu_recomp.h, e.g. a port's
+   generated/ppu): test_hle_abi_dispatch against the real ppu_hle.cpp, once
+   normally and once with PS3_HLE_ABI=0.
+
+The compiler defaults to clang-cl on Windows, c++ elsewhere; an MSVC-style
+driver is recognised by its file name (cl, clang-cl). Stdlib only.
+"""
+import argparse
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(HERE)))   # external/ps3recomp
+
+
+def run(cmd, env=None, expect=0):
+    print("+ " + " ".join(cmd))
+    r = subprocess.run(cmd, capture_output=True, text=True, env=env)
+    sys.stdout.write(r.stdout)
+    sys.stdout.write(r.stderr)
+    if expect is not None and r.returncode != expect:
+        print("FAILED: exit status %d, expected %d" % (r.returncode, expect))
+        sys.exit(1)
+    return r
+
+
+def compile_exe(cc, srcs, incs, exe):
+    # cl / clang-cl take MSVC-style flags; clang, clang++, gcc, c++ do not
+    # (a substring test for "cl" also matched plain "clang").
+    base = os.path.splitext(os.path.basename(cc).lower())[0]
+    msvc = base == "cl" or base.endswith("-cl")
+    if msvc:
+        cmd = [cc, "/nologo", "/EHsc", "/O1", "/TP", "-std:c++17"]
+        cmd += ["-I" + i for i in incs] + srcs + ["/Fe:" + exe, "/Fo:" + os.path.dirname(exe) + os.sep]
+    else:
+        cmd = [cc, "-O1", "-x", "c++", "-std=c++17"]
+        cmd += ["-I" + i for i in incs] + srcs + ["-o", exe]
+    run(cmd)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--lift", help="directory with a lift's ppu_recomp.h (dispatch test)")
+    ap.add_argument("--cc", default="clang-cl" if os.name == "nt" else "c++")
+    ap.add_argument("--out", help="build directory (default: a temporary one)")
+    a = ap.parse_args()
+    out = a.out or tempfile.mkdtemp(prefix="hleabi_")
+    os.makedirs(out, exist_ok=True)
+    py = sys.executable
+    gen = os.path.join(ROOT, "tools", "gen_hle_nids.py")
+
+    good = os.path.join(out, "hle_abi_mock_gen.cpp")
+    run([py, gen, "--src", os.path.join(HERE, "hle_abi_mock.c"), "--out", good])
+
+    r = run([py, gen, "--src", os.path.join(HERE, "hle_abi_mock_bad.c"),
+             "--out", os.path.join(out, "bad.cpp")], expect=1)
+    if "cellMockBadStruct" not in r.stderr or "cellMockBadVarargs" not in r.stderr:
+        print("FAILED: the generator's refusal does not name both bad prototypes")
+        return 1
+    print("[PASS] gen_hle_nids.py refuses a float next to a by-value struct and a float varargs")
+
+    exe = os.path.join(out, "test_hle_abi" + (".exe" if os.name == "nt" else ""))
+    # Everything is compiled as C++ (hle_abi_mock.c has extern "C" guards).
+    compile_exe(a.cc, [os.path.join(HERE, "test_hle_abi.cpp"), os.path.join(HERE, "hle_abi_mock.c"), good],
+                [os.path.join(ROOT, "include")], exe)
+    run([exe])
+
+    if a.lift:
+        dexe = os.path.join(out, "test_hle_abi_dispatch" + (".exe" if os.name == "nt" else ""))
+        compile_exe(a.cc, [os.path.join(HERE, "test_hle_abi_dispatch.cpp"),
+                           os.path.join(ROOT, "runtime", "ppu", "ppu_hle.cpp")],
+                    [a.lift, os.path.join(ROOT, "include"), os.path.join(ROOT, "runtime", "ppu")], dexe)
+        run([dexe])
+        env = dict(os.environ, PS3_HLE_ABI="0")
+        run([dexe, "legacy"], env=env)
+    else:
+        print("(dispatch test skipped: pass --lift <dir with ppu_recomp.h>)")
+    if not a.out:
+        shutil.rmtree(out, ignore_errors=True)
+    print("run_test_hle_abi: OK")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/runtime/ppu/tests/test_cont_resume.cpp b/runtime/ppu/tests/test_cont_resume.cpp
new file mode 100644
index 0000000..ee0f188
--- /dev/null
+++ b/runtime/ppu/tests/test_cont_resume.cpp
@@ -0,0 +1,832 @@
+/*
+ * Regression test for save-state continuations: runtime/ppu/ppu_resume.cpp
+ * (continuation table, chain validation, dispatcher) and, through
+ * tools/test_ppu_cont.py, tools/ppu_lifter.py --cont-list.
+ *
+ * It is the save-state study's continuation-dispatch proof of concept
+ * (scratch critic/cont) kept as a test, now on the REAL runtime. Two guest
+ * threads in lifted shape run a frame barrier through an HLE call and an
+ * inline `sc`; the main thread's chain goes through a vtable call (bctrl) made
+ * from a TAIL FRAGMENT that shares its owner's frame. A save request parks
+ * both threads at an HLE / syscall ENTRY (a thread blocked in the barrier is
+ * cancelled back to its entry), validates both guest chains with
+ * ppu_resume_walk, writes ctx + park records + guest memory, and exits. A
+ * FRESH process loads that, validates again, and resumes each thread in a new
+ * host thread with ppu_resume_run: re-issue the parked call, then run
+ * continuations from ctx->lr -- the hardware's blr -- to the thread's root.
+ * The final hashes must equal an uninterrupted run's, for snapshots at five
+ * times and for a three-generation chain (save, load+save, load+save, load),
+ * and must equal the study's reference values (main CBE47D7BB88F303D, worker
+ * 02AD1D424229760D, counter 400000). In-process negative tests check that the
+ * walk refuses what it must (no continuation, a corrupted back chain, a
+ * misaligned r1, a syscall with no recorded return address, an unmodelled
+ * exit; with real guest code in memory also a call mismatch and a stale LR),
+ * that a table of the wrong ABI is refused, and PPU_RESUME_CHECK_EVERY's probe
+ * validates every live chain.
+ *
+ * Two guests:
+ *   default            the PoC's hand-written guest (lifted shape, the
+ *                      continuations written the way --cont-list emits them),
+ *                      self-contained: no lifter needed;
+ *   -DCONT_TEST_LIFTED the same program as real PPC code, lifted by
+ *                      ppu_lifter.py with --cont-list (lifted.h, the lifted
