+/* ======================================================================
+ * Per-draw fetch plan
+ * ==================================================================== */
+
+#define RSX_VF_PAGE_SHIFT 20u      /* cellGcmResolveOffset's page: offset >> 20 */
+#define RSX_VF_MAX_PAGE_CHECKS 512u
+
+/* Is element ei -> resolve(loc, off + ei*stride) linear over [elo, ehi]?
+ * Mirrors rsx_fetch_attrib's u32 arithmetic exactly: an offset that wraps
+ * 2^32 is left to the slow path rather than reasoned about. */
+static int rsx_vf_linear(const rsx_vf_slot* s, u32 elo, u32 ehi, u32* ea0)
+{
+    const u64 lo = (u64)s->off + (u64)elo * s->stride;
+    const u64 hi = (u64)s->off + (u64)ehi * s->stride;
+    if ((u64)ehi * s->stride > 0xFFFFFFFFull || hi > 0xFFFFFFFFull) return 0;
+    const u32 olo = (u32)lo, ohi = (u32)hi;
+    const int loc = s->loc ? 1 : 0;
+    const u32 e = cellGcmResolveLocated(loc, olo);
+    const u32 p0 = olo >> RSX_VF_PAGE_SHIFT, p1 = ohi >> RSX_VF_PAGE_SHIFT;
+    if (p1 - p0 > RSX_VF_MAX_PAGE_CHECKS) return 0;
+    for (u32 pg = p0 + 1; pg <= p1; pg++) {
+        const u32 o = pg << RSX_VF_PAGE_SHIFT;
+        if (cellGcmResolveLocated(loc, o) != (u32)(e + (o - olo))) return 0;
+    }
+    *ea0 = e;
+    return 1;
+}
+
+void rsx_vfetch_plan_init(rsx_vfetch_plan* p, const rsx_state* st, u32 mask,
+                          u32 vlo, u32 vhi)
+{
+    p->st = st;
+    p->mask = mask & 0xFFFFu;
+    p->nslots = 0;
+    p->vlo = vlo; p->vhi = vhi;
+    p->hashable = 1;
+    if (vhi < vlo) vhi = vlo;
+    for (u32 i = 0; i < 16; i++) {
+        if (!(p->mask & (1u << i))) continue;
+        rsx_vf_slot* s = &p->s[p->nslots++];
+        memset(s, 0, sizeof *s);
+        s->idx = (u8)i;
+        memcpy(s->k, st->vertex_data4f[i], sizeof s->k);
+        const rsx_vertex_attrib* a = &st->vertex_attribs[i];
+        if (!a->enabled || a->stride == 0 || !vm_base) { s->mode = RSX_VF_CONST; continue; }
+        s->stride = a->stride;
+        s->freq = a->frequency;
+        s->off = a->offset & 0x7FFFFFFFu;
+        s->loc = (a->offset & 0x80000000u) ? 0 : 1;
+        if (a->frequency > 1 && !rsx_vf_nofreq())
+            s->fmode = (st->frequency_divider_op & (1u << i)) ? 2 : 1;
+        u32 n = a->size ? a->size : 4; if (n > 4) n = 4;
+        s->n = (u8)n;
+        s->type = (u8)a->type;
+        switch (a->type) {
+        case 2:          s->bytes = (u8)(4 * n); break;
+        case 3: case 1:
+        case 5:          s->bytes = (u8)(2 * n); break;
+        case 4: case 7:  s->bytes = (u8)n;       break;
+        case 6:          s->bytes = 4;           break;
+        default:         s->mode = RSX_VF_SLOW;  break;   /* keeps VTX_TYPEDBG */
+        }
+        if (a->type > 7 || s->mode == RSX_VF_SLOW) { s->mode = RSX_VF_SLOW; p->hashable = 0; continue; }
+        u32 elo, ehi;
+        if (s->fmode == 0)      { elo = vlo; ehi = vhi; }
+        else if (s->fmode == 1) { elo = vlo / s->freq; ehi = vhi / s->freq; }
+        else {
+            const u32 f = s->freq;
+            if (vhi - vlo >= f - 1u) { elo = 0; ehi = f - 1u; }
+            else {
+                const u32 r0 = vlo % f, r1 = vhi % f;
+                if (r0 <= r1) { elo = r0; ehi = r1; } else { elo = 0; ehi = f - 1u; }
+            }
+        }
+        u32 ea0;
+        if (!rsx_vf_linear(s, elo, ehi, &ea0)) { s->mode = RSX_VF_SLOW; p->hashable = 0; continue; }
+        s->mode = RSX_VF_FAST;
+        s->elo = elo; s->ehi = ehi; s->ea0 = ea0;
+    }
+}
