+    run_request(SS_P_LOAD, 0, 3000, &res);
+    printf("phase 12b: load -> ok=%d reason=%s eligible=%.1f ms\n", res.ok, ss_reason_name(res.reason), res.eligible_ms);
+    CHECK(!res.ok && res.reason == SS_REASON_NOT_YET && res.eligible_ms >= 0 && res.attempts == 1,
+          "a load was not lenient-eligible (reason %s: %s)", ss_reason_name(res.reason), res.why);
+    strcpy(on.spu_audited, "none");              /* an empty table: the fake wait is unaudited */
+    ss_configure(&on);
+    InterlockedExchange(&g_walk_all_ok, 1);
+    run_request(SS_P_SAVE, 0.2, 3000, &res);
+    CHECK(!res.ok && res.reason == SS_REASON_SPU_BUSY && !strcmp(res.detail, "SPU 0x2002") && strstr(res.why, "unaudited"),
