+     * never latched as game input; it also holds game input while a menu is
+     * open. Menu commands only queue work (ss_ui.h). */
+    {
+        intptr_t r = 0;
+        if (rsx_winmenu_message(hwnd, msg, (uintptr_t)wp, (intptr_t)lp, &r))
+            return (LRESULT)r;
+    }
+    /* Keyboard + mouse pad input sees every other message first: capture on
+     * click / release on Alt, focus loss or close, the hidden cursor, key
+     * presses. */
+    {
+        intptr_t r = 0;
+        if (cellPad_host_window_message(hwnd, msg, (uintptr_t)wp, (intptr_t)lp, &r))
+            return (LRESULT)r;
+    }
     switch (msg) {
     case WM_CLOSE:
         s_d3d.window_closed = 1;
+        rt_drain();   /* R1: the render thread's Present is over before its window goes */
         DestroyWindow(hwnd);
         return 0;
     case WM_DESTROY:
         PostQuitMessage(0);
         return 0;
     case WM_KEYDOWN:
-        if (wp == VK_ESCAPE) {
-            s_d3d.window_closed = 1;
-            DestroyWindow(hwnd);
