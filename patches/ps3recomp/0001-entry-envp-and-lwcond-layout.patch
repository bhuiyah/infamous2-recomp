+/* CPU-only staging heap for SRVs (copy sources must not be shader-visible). */
+static int tc_cpu_heap(void)
+{
+    if (s_tc.cpu_heap) return 1;
+    if (s_tc.cpu_failed || !s_d3d.device || !s_d3d.srv_heap) return 0;
+    D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    hd.NumDescriptors = 1u + VP_TEX_SLOTS * TC_DESC_VARIANTS;
+    hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_NONE;
+    if (FAILED(s_d3d.device->lpVtbl->CreateDescriptorHeap(s_d3d.device, &hd,
+               &IID_ID3D12DescriptorHeap, (void**)&s_tc.cpu_heap))) {
+        s_tc.cpu_failed = 1; s_tc.cpu_heap = NULL; return 0;
+    }
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_tc.cpu_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_tc.cpu_heap, &h);
+    s_tc.cpu_base = h.ptr;
+    s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &h);
+    s_tc.vis_base = h.ptr;
+    /* [0]: exactly what srv_write(slot, NULL, R8G8B8A8_UNORM, default) builds */
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sv.Texture2D.MipLevels = 1;
+    h.ptr = s_tc.cpu_base;
+    s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, NULL, &sv, h);
+    return 1;
+}
