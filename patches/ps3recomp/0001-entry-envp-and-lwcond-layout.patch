+/* "70,90,110": seconds after start, into out[] (SS_SAVE_AT, SS_DUMP). */
+static void parse_times(const char* p, double* out, int* n)
+{
+    while (p && *p && *n < SS_SAVE_AT_MAX) {
+        char* end;
+        const double t = strtod(p, &end);
+        if (end == p) { p++; continue; }
+        if (t >= 0) out[(*n)++] = t;
+        p = end;
+    }
+}
