+/* ---------------- park records seen at a stop (the coordinator's hook) ---------------- */
+struct SeenPark { int valid, at; uint32_t num, obj; ppu_context ctx; ss_wait_rec rec; ss_sr_root root; int rv; };
+static SeenPark g_seen[PPU_THREAD_MAX + 1];
+static void on_capture(void*)
+{
+    for (unsigned tid = 1; tid <= PPU_THREAD_MAX && g_ppu_ss_park_of; tid++) {
+        SeenPark* s = &g_seen[tid];
+        int at = 0, tier = 0, rv = 0;
+        uint32_t num = 0, obj = 0;
+        const ppu_context* c = nullptr;
+        ss_sr_root root;
+        memset(&root, 0, sizeof root);
+        if (!g_ppu_ss_park_of(tid, &at, &tier, &num, &obj, &c, &root, &rv) || !c) continue;
+        s->at = at; s->num = num; s->obj = obj; s->ctx = *c; s->root = root; s->rv = rv;
+        memset(&s->rec, 0, sizeof s->rec);
+        if (at == SS_IN_WAIT) ss_ppu_wait_rec(tid, &s->rec);
+        s->valid = 1;
+    }
+}
+static void seen_clear(void) { memset(g_seen, 0, sizeof g_seen); }
