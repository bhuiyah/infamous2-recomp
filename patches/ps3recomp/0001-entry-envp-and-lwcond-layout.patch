+    CHECK(rsx_selfsample_need_copy(1, 1, 5, 5) == 0, "mode 1: same epoch reuses the copy");
+    CHECK(rsx_selfsample_need_copy(1, 1, 5, 6) == 1, "mode 1: a new epoch copies again");
+    CHECK(rsx_selfsample_need_copy(2, 1, 5, 5) == 1, "mode 2: every draw copies");
+    CHECK(rsx_selfsample_need_copy(0, 0, 0, 0) == 0, "mode 0: live view");
