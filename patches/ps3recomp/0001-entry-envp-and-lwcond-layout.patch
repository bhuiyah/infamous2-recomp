@@ -8,6 +8,8 @@
 #include "cellVideoOut.h"
 #include "ps3emu/endian.h"
 #include "../../runtime/ppu/ppu_memory.h"   /* vm_base (guest mem) */
+#include "../../runtime/savestate/ss_state.h"   /* field lists: this file's part of MISC */
+#include "rsx_videoout_gamma.h"                 /* the gamma it carries */
 #include <stdio.h>
 #include <string.h>
 #include <stdint.h>
@@ -253,3 +255,52 @@ s32 cellVideoOutGetResolutionAvailability(u32 videoOut, u32 resolutionId,
            videoOut, resolutionId);
     return (videoOut == CELL_VIDEO_OUT_PRIMARY) ? 1 : 0;
 }
+
+/* ---------------------------------------------------------------------------
+ * Save states: cellVideoOut's part of the MISC section (runtime/savestate/
+ * ss_state.h), written by cellSysmodule.c, which registers the section: the
+ * configured mode (resolution, buffer format, aspect, pitch) and the video-out
+ * gamma the title last set (cellVideoOutSetGamma, kept by
+ * rsx_videoout_gamma.c). A load re-applies the gamma through
+ * rsx_videoout_gamma_set, the setter the guest call uses (engine design 6.1,
+ * library rule (a)).
+ * -----------------------------------------------------------------------*/
+static float s_ss_gamma;   /* capture scratch */
+static const ss_field k_videoout_ss_fields[] = {
+    SS_FIELD(s_resolution_id), SS_FIELD(s_color_format), SS_FIELD(s_aspect),
+    SS_FIELD(s_pitch), SS_FIELD_AS("gamma", s_ss_gamma),
+};
+const ss_list cellVideoOut_ss_list = SS_LIST("videoout", k_videoout_ss_fields);
+
+/* Everything parked: the gamma into the scratch the list names. */
+void cellVideoOut_ss_prepare(void)
+{
+    s_ss_gamma = rsx_videoout_gamma_get();
+}
+
+/* A load (M4c; cellSysmodule.c reads the image, ss_read_fields writes the
+ * list back). Teardown: the boot configuration and the boot gamma (1.0, the
+ * identity) on the present pass. */
+void cellVideoOut_ss_teardown(void)
+{
+    s_resolution_id = CELL_VIDEO_OUT_RESOLUTION_720;
+    s_color_format  = CELL_VIDEO_OUT_BUFFER_COLOR_FORMAT_X8R8G8B8;
+    s_aspect        = CELL_VIDEO_OUT_ASPECT_16_9;
+    s_pitch         = 1280 * 4;
+    rsx_videoout_gamma_set(RSX_VOG_DEFAULT);
+}
+
+/* After the list is back: the loaded gamma re-applied through the setter
+ * the guest call uses (engine design 6.1, rule (a)) -- 1.0 or a value
+ * cellVideoOutSetGamma accepts; check_image refused any other. 0, or -1 with
+ * why. */
+int cellVideoOut_ss_apply(char* why, size_t n)
+{
+    if (s_ss_gamma != RSX_VOG_DEFAULT && !rsx_vog_in_range(s_ss_gamma)) {
+        snprintf(why, n, "videoout.gamma %g: outside %g..%g", (double)s_ss_gamma, (double)RSX_VOG_MIN,
+                 (double)RSX_VOG_MAX);
+        return -1;
+    }
+    rsx_videoout_gamma_set(s_ss_gamma);
+    return 0;
+}
diff --git a/libs/video/display_cfg.h b/libs/video/display_cfg.h
new file mode 100644
index 0000000..a4f24dd
--- /dev/null
+++ b/libs/video/display_cfg.h
@@ -0,0 +1,263 @@
+/*
+ * ps3recomp - display configuration (display.ini): parser and window geometry
+ *
+ * OS-free and header-only, like libs/input/pad_kbm.h, so the unit test
+ * (libs/video/tests/test_display_cfg.c) needs nothing else. The D3D12
+ * backend owns the store (rsx_display.h is its API); a title reads its own
+ * keys from the same file through rsx_display_cfg_get().
+ *
+ * The file is "name = value" lines; text after '#' or ';' is a comment,
+ * "[section]" lines are ignored, names ignore case, spaces, '_' and '-'.
+ * An override string (DISPLAY_CFG="aspect=21:9|fullscreen=1") uses '|' (or
+ * ';') between items. The store keeps raw values: whoever uses a key parses
+ * it with the helpers below and reports a bad value itself.
+ */
+#ifndef PS3RECOMP_DISPLAY_CFG_H
+#define PS3RECOMP_DISPLAY_CFG_H
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define DCFG_MAX     32
+#define DCFG_KEYLEN  32
+#define DCFG_VALLEN  96
+
+typedef struct {
+    int  n;
+    char key[DCFG_MAX][DCFG_KEYLEN];   /* normalised (dcfg_norm) */
+    char val[DCFG_MAX][DCFG_VALLEN];   /* trimmed, as written */
+} DisplayCfg;
+
+typedef void (*dcfg_warn_fn)(const void* ctx, const char* msg);
+
+/* "Full_Screen" == "fullscreen" == "full-screen". */
+static inline void dcfg_norm(const char* s, char* out, size_t n)
+{
+    size_t k = 0;
+    for (; *s && k + 1 < n; s++) {
+        if (*s == ' ' || *s == '\t' || *s == '_' || *s == '-') continue;
+        out[k++] = (char)tolower((unsigned char)*s);
+    }
+    out[k] = 0;
+}
+
+static inline char* dcfg_trim(char* s)
+{
+    while (*s == ' ' || *s == '\t' || *s == '\r' || *s == '\n') s++;
+    char* e = s + strlen(s);
+    while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n')) e--;
+    *e = 0;
+    return s;
+}
+
+static inline const char* dcfg_get(const DisplayCfg* c, const char* key)
+{
+    char k[DCFG_KEYLEN];
+    dcfg_norm(key, k, sizeof k);
+    for (int i = 0; i < c->n; i++)
+        if (!strcmp(c->key[i], k)) return c->val[i];
+    return NULL;
+}
+
+/* Set (or replace) a key. Returns 0 when the store is full. */
+static inline int dcfg_set(DisplayCfg* c, const char* key, const char* val)
+{
+    char k[DCFG_KEYLEN];
+    dcfg_norm(key, k, sizeof k);
+    if (!k[0]) return 0;
+    int i = 0;
+    while (i < c->n && strcmp(c->key[i], k)) i++;
+    if (i == c->n) {
+        if (c->n == DCFG_MAX) return 0;
+        c->n++;
+        snprintf(c->key[i], DCFG_KEYLEN, "%s", k);
+    }
+    snprintf(c->val[i], DCFG_VALLEN, "%s", val ? val : "");
+    return 1;
+}
+
+/* Raw file bytes (buf[0..n), buf[n] writable) -> text, in place: a UTF-8 BOM
+ * is skipped and UTF-16 with a BOM (PowerShell 5's '>' / Out-File) is folded
+ * to 8-bit (non-ASCII -> '?'). Same rules as input.ini. */
+static inline char* dcfg_text_prepare(char* buf, size_t n)
+{
+    const unsigned char* u = (const unsigned char*)buf;
+    buf[n] = 0;
+    if (n >= 3 && u[0] == 0xEF && u[1] == 0xBB && u[2] == 0xBF) return buf + 3;
+    if (n >= 2 && ((u[0] == 0xFF && u[1] == 0xFE) || (u[0] == 0xFE && u[1] == 0xFF))) {
+        int le = u[0] == 0xFF;
+        size_t o = 0;
+        for (size_t i = 2; i + 1 < n; i += 2) {
+            unsigned ch = le ? (unsigned)(u[i] | (u[i + 1] << 8)) : (unsigned)((u[i] << 8) | u[i + 1]);
+            if (!ch) break;
+            buf[o++] = (char)(ch < 0x80 ? ch : '?');
+        }
+        buf[o] = 0;
+    }
+    return buf;
+}
+
+/* One line: 1 = set a key, 0 = blank/comment/section, -1 = malformed. */
+static inline int dcfg_parse_line(DisplayCfg* c, const char* line, char* err, size_t errn)
+{
+    char buf[256];
+    snprintf(buf, sizeof buf, "%s", line);
+    for (char* p = buf; *p; p++)
+        if (*p == '#' || *p == ';') { *p = 0; break; }
+    char* s = dcfg_trim(buf);
+    if (!*s || *s == '[') return 0;
+    char* eq = strchr(s, '=');
+    if (!eq) { snprintf(err, errn, "expected 'name = value': \"%s\"", s); return -1; }
+    *eq = 0;
+    char* name = dcfg_trim(s);
+    char* val  = dcfg_trim(eq + 1);
+    if (!*name) { snprintf(err, errn, "missing name before '='"); return -1; }
+    if (!dcfg_set(c, name, val)) { snprintf(err, errn, "too many settings (max %d)", DCFG_MAX); return -1; }
+    return 1;
+}
+
+/* A whole file, or an override string (env_style: items also end at '|'
+ * or ';'). Bad lines are reported and skipped; returns how many. */
+static inline int dcfg_parse_text(DisplayCfg* c, const char* text, int env_style,
+                                  dcfg_warn_fn warn, const void* ctx)
+{
+    int errors = 0, lineno = 0;
+    const char* p = text;
+    while (p && *p) {
+        const char* e = p;
+        while (*e && *e != '\n' && !(env_style && (*e == ';' || *e == '|'))) e++;
+        char line[256];
+        size_t n = (size_t)(e - p);
+        if (n >= sizeof line) n = sizeof line - 1;
+        memcpy(line, p, n);
+        line[n] = 0;
+        lineno++;
+        char err[160];
+        if (dcfg_parse_line(c, line, err, sizeof err) < 0) {
+            errors++;
+            if (warn) {
+                char msg[200];
+                snprintf(msg, sizeof msg, "%s %d: %s", env_style ? "item" : "line", lineno, err);
+                warn(ctx, msg);
+            }
+        }
+        p = *e ? e + 1 : e;
+    }
+    return errors;
+}
+
+/* 1/0 for on/off words; -1 if it is neither. */
+static inline int dcfg_parse_bool(const char* v)
+{
+    char n[16];
+    if (!v) return -1;
+    dcfg_norm(v, n, sizeof n);
+    if (!strcmp(n, "1") || !strcmp(n, "true") || !strcmp(n, "yes") || !strcmp(n, "on"))   return 1;
+    if (!strcmp(n, "0") || !strcmp(n, "false") || !strcmp(n, "no") || !strcmp(n, "off")) return 0;
+    return -1;
+}
+
+#define DCFG_ASPECT_AUTO   0.0
+#define DCFG_ASPECT_OFF   (-1.0)
+#define DCFG_ASPECT_BAD   (-2.0)
+
+/* An aspect ratio: "auto", "off" (also "native", "stock"), "W:H" or "W/H" or
+ * "WxH" (e.g. 64:27, 21:9, 2560x1080), or a plain number (2.37). Returns the
+ * ratio, DCFG_ASPECT_AUTO, DCFG_ASPECT_OFF, or DCFG_ASPECT_BAD (also for
+ * ratios outside 0.5..8). "21:9" is the marketing name of 64:27-class panels
+ * and is taken literally (2.333); use 64:27 for a 2560x1080 monitor. */
+static inline double dcfg_parse_aspect(const char* v)
+{
+    char n[48];
+    if (!v) return DCFG_ASPECT_BAD;
+    dcfg_norm(v, n, sizeof n);
+    if (!n[0] || !strcmp(n, "auto")) return DCFG_ASPECT_AUTO;
+    if (!strcmp(n, "off") || !strcmp(n, "native") || !strcmp(n, "stock") || !strcmp(n, "none"))
+        return DCFG_ASPECT_OFF;
+    char* end;
+    double a = strtod(n, &end);
+    if (end == n) return DCFG_ASPECT_BAD;
+    if (*end == ':' || *end == '/' || *end == 'x') {
+        const char* q = end + 1;
+        double b = strtod(q, &end);
+        if (end == q || *end || !(b > 0.0)) return DCFG_ASPECT_BAD;
+        a = a / b;
+    } else if (*end) {
+        return DCFG_ASPECT_BAD;
+    }
+    if (!(a >= 0.5 && a <= 8.0)) return DCFG_ASPECT_BAD;
+    return a;
+}
+
+#define DCFG_SIZE_AUTO   0
+#define DCFG_SIZE_MAX    1
+#define DCFG_SIZE_EXACT  2
+#define DCFG_SIZE_BAD   (-1)
+
+/* A window client size: "auto", "max" (largest that fits the work area) or
+ * "WxH" (W,H in 64..16384). */
+static inline int dcfg_parse_size(const char* v, int* w, int* h)
+{
+    char n[48];
+    if (!v) return DCFG_SIZE_AUTO;      /* not configured: auto */
+    dcfg_norm(v, n, sizeof n);
+    if (!n[0] || !strcmp(n, "auto")) return DCFG_SIZE_AUTO;
+    if (!strcmp(n, "max") || !strcmp(n, "maximum") || !strcmp(n, "fit")) return DCFG_SIZE_MAX;
+    char* end;
+    long a = strtol(n, &end, 10);
+    if (end == n || (*end != 'x' && *end != '*')) return DCFG_SIZE_BAD;
+    const char* q = end + 1;
+    long b = strtol(q, &end, 10);
+    if (end == q || *end) return DCFG_SIZE_BAD;
+    if (a < 64 || b < 64 || a > 16384 || b > 16384) return DCFG_SIZE_BAD;
+    *w = (int)a;
+    *h = (int)b;
+    return DCFG_SIZE_EXACT;
+}
+
+/* The largest rectangle of aspect a (width/height) centred in cw x ch: the
+ * part of the client area the image covers, the rest being bars. Within one
+ * pixel of the full width or height counts as full (rounding of W' = H*a
+ * must not leave a 1-pixel bar on a monitor of exactly that aspect). */
+static inline void dcfg_fit_rect(int cw, int ch, double a, int* x, int* y, int* w, int* h)
+{
+    int rw = cw, rh = ch;
+    if (cw > 0 && ch > 0 && a > 0.0) {
+        double wa = (double)ch * a;
+        if (wa <= (double)cw) { rw = (int)(wa + 0.5); rh = ch; }
+        else                  { rw = cw; rh = (int)((double)cw / a + 0.5); }
+        if (rw > cw - 2 && rw < cw + 2) rw = cw;
+        if (rh > ch - 2 && rh < ch + 2) rh = ch;
+        if (rw > cw) rw = cw;
+        if (rh > ch) rh = ch;
+        if (rw < 1) rw = 1;
+        if (rh < 1) rh = 1;
+    }
+    *x = (cw - rw) / 2;
+    *y = (ch - rh) / 2;
+    *w = rw;
+    *h = rh;
+}
+
+/* Default windowed client size for content of aspect a: base_h * scale
+ * pixels high (the guest image's height at the monitor's DPI scale), as
+ * wide as the aspect asks, shrunk proportionally until it fits avail_w x
+ * avail_h (the work area minus the window frame). */
+static inline void dcfg_default_client(double a, int base_h, double scale, int avail_w, int avail_h,
+                                       int* w, int* h)
+{
+    if (!(a > 0.0)) a = 16.0 / 9.0;
+    if (!(scale > 0.0)) scale = 1.0;
+    double hh = (double)base_h * scale;
+    double ww = hh * a;
+    if (avail_w > 0 && ww > (double)avail_w) { ww = (double)avail_w; hh = ww / a; }
+    if (avail_h > 0 && hh > (double)avail_h) { hh = (double)avail_h; ww = hh * a; }
+    *w = (int)(ww + 0.5);
+    *h = (int)(hh + 0.5);
+    if (*w < 64) *w = 64;
+    if (*h < 64) *h = 64;
+}
+
+#endif /* PS3RECOMP_DISPLAY_CFG_H */
diff --git a/libs/video/gcm_ss.inc b/libs/video/gcm_ss.inc
new file mode 100644
index 0000000..12b0e70
--- /dev/null
+++ b/libs/video/gcm_ss.inc
@@ -0,0 +1,127 @@
+/*
+ * gcm_ss.inc -- the GCM_ save-state section's field list: every static of
+ * cellGcmSys.c (and the two RSX registers rsx_commands.c keeps) that the guest
+ * can observe or that decides what the FIFO walker does next. One FIELDS
+ * record, "gcm"; runtime/savestate/ss_state.h, engine design 6.2.
+ *
+ * Included once, at the END of cellGcmSys.c (it names that file's statics):
+ *     SS_F(v)   a static           -> SS_FIELD(v)
+ *     SS_FV(v)  a volatile static  -> the same field, its address cast through
+ *                                     uintptr_t (a plain (void*) drops the
+ *                                     qualifier, with a warning)
+ *     SS_FVH(v) the same, SS_FF_HOST: host state a load deliberately changes
+ *                                     (M4c's fidelity check skips it; flags
+ *                                     are not part of the layout hash)
+ * Names are the variables' own: renaming one makes old images refuse with its
+ * name, which is the point. A struct that changes size refuses the same way
+ * (s_rsx_state most of all: rsx_state is one field, 26 KB, no pointers -- a
+ * member added to it is saved with no change here).
+ *
+ * Deliberately NOT here (config/ss_manifest.txt has every one):
+ *   s_ref_q / s_ref_qhead / s_ref_qtail  the BLOB "ref_queue" instead: the
+ *       queued fences oldest first, the ring normalised to head 0
+ *   s_imm_verts (rsx_commands.c)          the BLOB "imm_verts": the vertices an
+ *       immediate-mode primitive has emitted so far (s_rsx_state.imm_count)
+ *   s_acq_t0 / s_park_t0                  TIME anchors gcm.acq_age_ms /
+ *       gcm.park_age_ms (ps3_ms_now instants; their age is what a load needs)
+ *   s_gcm_pumping                         0, asserted by the section's check()
+ *   s_wake, s_pass_early                  the idle wait's watch: re-derived by
+ *       the next pass (a load resets them to "none")
+ *   s_ref_poll_pub / s_ref_walk_pub       publication pacing (QPC instants)
+ *   s_gcm_fifo_lock, s_ref_pub_lock, s_gcm_kick_ev, s_qpc_*, s_ref_freq
+ *                                         host locks, a HANDLE, QPC constants
+ *   s_flip_handler .. s_queue_handler     legacy host-typed slots nothing
+ *       reads; the guest forms (*_opd / *_code) are here
+ *   g_ftr_*, s_tr_*, s_wdbg, s_wk_*, pacing (gcm_flip_pace, gcm_vsync_pace),
+ *   the function-local log limits         diagnostics, configuration, host
+ *       frame pacing
+ * Labels, the control register (put / get / ref) and the offset tables the
+ * guest indexes live in guest memory (VM_HLE_INJECT_BASE): GMEM has them.
+ */
+
+/* context and init */
+SS_F(s_gcm_initialized)
+SS_F(s_gcm_context_ea)
+SS_F(s_gcm_ctx_out_ea)
+SS_F(s_gcm_syscall_mode)
+SS_F(s_config)
+SS_F(s_control)
+SS_F(s_default_fifo_mode)
+SS_F(s_default_fifo_size)
+SS_F(s_debug_level)
+
+/* local memory and the IO maps */
+SS_F(s_local_offset_page)
+SS_F(s_io_address_table)
+SS_F(s_ea_address_table)
+SS_F(s_local_mem_allocated)
+SS_F(s_io_mappings)
+SS_F(s_io_mapping_count)
+SS_F(s_io_map_reserved)
+SS_F(s_io_alloc_next)
+
+/* display buffers and flips (s_last_flip_time: get_timestamp_ns, see M4c) */
+SS_F(s_flip_mode)
+SS_F(s_flip_status)
+SS_FV(s_flip_request_count)
+SS_FVH(s_flip_pending)        /* the frame clock's "present first": a load drops it */
+SS_F(s_display_buffers)
+SS_F(s_display_buffer_set)
+SS_F(s_current_display_buffer_id)
+SS_F(s_last_flip_time)
+SS_F(s_vblank_count)
+SS_F(s_vblank_frequency)
+SS_F(s_second_v_frequency)
+
+/* interrupts not yet delivered (ppu_gcm_pump) */
+SS_FV(s_gcm_pending)
+SS_FV(s_user_command)
+SS_FV(s_user_pending)
+
+/* the guest's handlers: OPD and code EAs */
+SS_F(g_gcm_handler_mask)
+SS_F(g_gcm_driver_info_ea)
+SS_F(s_flip_handler_opd)
+SS_F(s_vblank_handler_opd)
+SS_F(s_user_handler_opd)
+SS_F(s_second_v_handler_opd)
+SS_F(s_flip_handler_code)
+SS_F(s_vblank_handler_code)
+
+/* tiles, zcull, reports (1 MB), labels (a host copy), notify */
+SS_F(s_tiles)
+SS_F(s_zcull)
+SS_F(s_report_data)
+SS_F(s_labels)
+SS_F(s_notify_data)
+
+/* the FIFO walker: where it is, what it waits at, what its watchdogs remember */
+SS_F(s_fifo_getoff)
+SS_F(s_fifo_calloff)
+SS_F(s_last_ring_off)
+SS_FV(g_gcm_fifo_drained_ea)
+SS_F(s_sema_offset)
+SS_F(s_acq_pos)
+SS_F(s_park_off)
+SS_F(s_catchup_run)
+SS_F(s_circle_burned)
+SS_F(s_stuck_last)
+SS_F(s_stuck_n)
+SS_F(s_title_overran)
+SS_F(s_spu_blk)
+SS_F(s_spu_blk_w)
+
+/* the 2D engines' method state (NV3062 / NV308A, NV3089, NV309E) */
+SS_F(s_gcm2d)
+SS_F(s_nv3089)
+SS_F(s_nv309e)
+
+/* the command processor: its register file, and rsx_commands.c's two registers */
+SS_F(s_rsx_state)
+SS_F(s_rsx_inited)
+SS_F(g_rsx_last_reference)
+SS_F(g_rsx_sem_off)
+
+/* the VRAM upload registry (guest EAs and sizes) */
+SS_F(s_uploads)
+SS_F(s_upload_n)
diff --git a/libs/video/ovl.c b/libs/video/ovl.c
new file mode 100644
index 0000000..398ac3e
--- /dev/null
+++ b/libs/video/ovl.c
@@ -0,0 +1,1201 @@
+/*
+ * ps3recomp - the in-game options overlay: host, thread, input routing.
+ * Public API: include/ps3emu/overlay.h; the backend's side: libs/video/ovl.h;
+ * the menu itself: libs/video/ovl_menu.c; drawing: ovl_draw.h / ovl_gpu.h /
+ * ovl_font_gdi.h; the composition attachment: ovl_dcomp.cpp.
+ *
+ * Threads.
+ *   - The window thread (= frame clock = RSX walker) owns the open / closed
+ *     state: F1, the PS-button hook's posted message and ovl_open_options all
+ *     end in ovl_set_open on it, which releases or re-captures the mouse
+ *     (cellPad), starts / ends the system intercept (the PS3 XMB pause,
+ *     options_set_intercepted) and wakes the overlay thread. Its window
+ *     procedure only forwards keys and mouse messages into a queue while the
+ *     menu is open.
+ *   - The overlay thread (started the first time anything is shown) owns
+ *     everything else: the menu state, the controller polling for
+ *     navigation, the glyph atlas (built by a short-lived worker), its own
+ *     D3D12 queue, the composition swap chain and the DirectComposition
+ *     objects (created when something is to be shown, released when nothing
+ *     is). It never waits for the window thread, so the window thread may
+ *     wait for it (screen-grab hiding).
+ *   - Guest threads only call the PS-button hook, which posts a message.
+ *
+ * Input while open: keys and mouse go to the menu, not to cellPad (no game
+ * key is latched, a click does not capture the mouse); F11 and the Alt
+ * combinations (Alt+Enter, Alt+F4) still reach the window. The game itself
+ * sees neutral pads (cellPad intercept), its motors are off, keys held when
+ * the menu closes stay ignored until released (cellPad), and so do pad
+ * buttons held then.
+ */
+#ifdef _WIN32
+
+#include "ovl.h"
+#include "ovl_gpu.h"
+#include "ovl_menu.h"
+#include "pad_host.h"
+#include "cellPad.h"
+#include "ps3emu/options.h"
+#include "ps3emu/overlay.h"
+
+#include <dxgi1_4.h>
+#include <shellapi.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#pragma comment(lib, "shell32.lib")   /* ShellExecuteW: "Open the settings folder" */
+#pragma comment(lib, "ole32.lib")
+
+#define WM_APP_OVL       (WM_APP + 0x2D20)
+enum { OVL_CMD_OPEN = 1, OVL_CMD_CLOSE, OVL_CMD_TOGGLE, OVL_CMD_PAD };
+
+/* ovl_dcomp.cpp */
+extern int   ovl_dcomp_available(void);
+extern void* ovl_dcomp_attach(void* top, void* swapchain, long* hr_out);
+extern void  ovl_dcomp_release(void* d);
+extern void  ovl_dcomp_wait_composed(void* d);
+
+/* rsx_d3d12_backend.c */
+extern char g_rsx_title_base[128];
+
+/* ---------------------------------------------------------------- state */
+
+typedef enum { EV_KEY = 1, EV_MOVE, EV_BUTTON, EV_WHEEL, EV_LEAVE } ev_type;
+typedef struct { int type, a, b, c, d; } ovl_ev;
+
+static int            s_installed;
+static HWND           s_top;
+static DWORD          s_wnd_tid;
+static ID3D12Device*  s_dev;
+static UINT           s_capture_msg;
+static int            s_log;
+
+static volatile LONG  s_open;              /* written by the window thread */
+static int            s_was_captured;      /* window thread */
+static int            s_mouse_tracked;     /* window thread: TrackMouseEvent armed */
+
+static volatile LONG  s_thread_state;      /* 0 none, 1 starting, 2 running, -1 failed */
+static HANDLE         s_thread, s_wake;
+static CRITICAL_SECTION s_qlock;
+static ovl_ev         s_q[512];
+static int            s_qh, s_qt;
+
+static volatile LONG  s_capture_hold, s_hidden_seq;
+static HANDLE         s_hidden_evt;
+
+static SRWLOCK        s_notice_lock = SRWLOCK_INIT;
+static char           s_notice[200];
+static volatile LONG  s_notice_seq;
+static unsigned       s_notice_ms;
+
+static volatile LONG64 s_pres_t[256];
+static volatile LONG  s_pres_n;
+
+static volatile LONG  s_host;              /* 0 not chosen, 1 composition, 2 backbuffer */
+
+/* the fallback host's published draw list (the window thread records it) */
+static SRWLOCK        s_bb_lock = SRWLOCK_INIT;
+static ovl_list       s_bb_list;
+static volatile LONG  s_bb_visible;
+static ovl_gpu        s_gpu_bb;
+static int            s_gpu_bb_ok;
+
+static opt_id s_row_fps = -1, s_row_fps_pos = -1, s_row_scale = -1, s_row_combo = -1, s_row_pause = -1;
+
+static void ovl_logf(const char* fmt, ...)
+{
+    char b[512];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(b, sizeof b, fmt, ap);
+    va_end(ap);
+    printf("[ovl] %s\n", b);
+    fflush(stdout);
+}
+
+static double now_s(void)
+{
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart / (double)f.QuadPart;
+}
+
+static int in_front(void)
+{
+    HWND f = GetForegroundWindow();
+    if (!f) return 0;
+    if (f == s_top) return 1;
+    DWORD pid = 0;
+    GetWindowThreadProcessId(f, &pid);
+    return pid == GetCurrentProcessId();
+}
+
+static void push_ev(int type, int a, int b, int c, int d)
+{
+    EnterCriticalSection(&s_qlock);
+    int nt = (s_qt + 1) % (int)(sizeof s_q / sizeof s_q[0]);
+    if (nt != s_qh) {
+        ovl_ev* e = &s_q[s_qt];
+        e->type = type; e->a = a; e->b = b; e->c = c; e->d = d;
+        s_qt = nt;
+    }
+    LeaveCriticalSection(&s_qlock);
+    if (s_wake) SetEvent(s_wake);
+}
+
+static int pop_ev(ovl_ev* e)
+{
+    int got = 0;
+    EnterCriticalSection(&s_qlock);
+    if (s_qh != s_qt) { *e = s_q[s_qh]; s_qh = (s_qh + 1) % (int)(sizeof s_q / sizeof s_q[0]); got = 1; }
+    LeaveCriticalSection(&s_qlock);
+    return got;
+}
+
+/* ---------------------------------------------------------------- settings rows */
+
+#define OVL_NOPRESET { NULL, NULL, NULL, NULL, NULL }
+static const opt_def s_rows[] = {
+    /* home display.ini: its show_fps key (the window menu's View > Show FPS, rsx_winmenu.h) is this row */
+    { "fps_counter", "show_fps", "display", "overlay", "Frame", "Counter", "FPS counter",
+      "A small box in the picture's corner with the frames presented per second; Detailed adds the average and "
+      "the longest frame time of the last second. Drawn over the picture by the overlay, never into the game's "
+      "frames. While it shows, the desktop composes the window, which can rule out tearing and variable refresh.",
+      OPT_ENUM, OPT_LIVE, "off|on|detailed", "Off|On|Detailed", 0, 0, 0, "off", "FPS_COUNTER", "DISPLAY_CFG",
+      OVL_NOPRESET, OPT_F_ENHANCEMENT, "overlay", NULL },
+    { "fps_counter_corner", NULL, "options", "overlay", "Frame", "Counter", "Counter position",
+      "Which corner of the picture the FPS counter sits in.",
+      OPT_ENUM, OPT_LIVE, "top-left|top-right|bottom-left|bottom-right", "Top left|Top right|Bottom left|Bottom right",
+      0, 0, 0, "top-left", NULL, NULL, OVL_NOPRESET, 0, "overlay", NULL },
+    { "menu_pad_combo", NULL, "options", "overlay", "System", "Menu", "Controller shortcut",
+      "The PS / Guide / Home button opens this menu. Steam or the Xbox Game Bar may take that button, so holding "
+      "both sticks pressed (L3 + R3) for half a second opens it too; while both are held they do not reach the game.",
+      OPT_ENUM, OPT_LIVE, "l3+r3|none", "Hold L3 + R3|None", 0, 0, 0, "l3+r3", NULL, NULL, OVL_NOPRESET, 0,
+      "overlay", NULL },
