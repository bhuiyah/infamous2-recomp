+            int i = 0;
+            while (i < nall && all_ids[i] != dr->fp_id) i++;
+            if (i == nall && nall < 32) { all_ids[nall] = dr->fp_id; all_done[nall++] = 0; }
+            if (i < nall) dn = &all_done[i];
+        }
+    } else for (int i = 0; i < nid; i++) if (dr->fp_id == ids[i]) { dn = &done[i]; break; }
+    if (!dn || *dn >= cap || !rsx_capfile_armed()) return;
+    (*dn)++;
+    static const char* const pn[11] = { "?", "POINTS", "LINES", "LINE_LOOP", "LINE_STRIP", "TRIANGLES",
+                                        "TRIANGLE_STRIP", "TRIANGLE_FAN", "QUADS", "QUAD_STRIP", "POLYGON" };
+    const int vs_ok = dr->vs_idx >= 0 && dr->vs_idx < s_d3d.vp_vs_n;
+    const u32 vs_in = vs_ok ? (s_d3d.vp_vs[dr->vs_idx].in_mask & 0xFFFFu) : 0xFFFFu;
+    u32 rd_rt = 0;
+    for (int u = 0; u < RSX_DRAW_TEX_UNITS; u++)
