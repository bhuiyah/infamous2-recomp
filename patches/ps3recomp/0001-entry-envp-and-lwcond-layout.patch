+
+/* A display buffer is the swap-chain backbuffer here, but its guest memory is
+ * also an ordinary surface to the title. inFamous 2 renders the frame into
+ * display buffer 1 (0x734000) and the next frames use that memory as a
+ * G-buffer target it never clears: the pixels the G-buffer pass does not
+ * cover still hold the displayed image, and the glow pass blurs them into
+ * every frame. Without this they held whatever the surface was seeded with
+ * (flat green) and the whole menu came out green. At the end of a frame,
+ * copy the backbuffer into the offscreen RT aliasing the display buffer the
+ * frame drew to, if one exists. DISPLAY_WRITETHRU=1 enables: off by default
+ * because with it the menu's glow pass feeds the frame back with gain > 1 and
+ * blows out to white within seconds -- some input of that pass is still wrong. */
+static void display_write_through(u32 fi)
+{
+    static int en = -1;
+    if (en < 0) { const char* e = getenv("DISPLAY_WRITETHRU"); en = e ? atoi(e) : 0; }
+    if (!en) return;
+    u32 raw = s_batch_disp_raw;
+    s_batch_disp_raw = 0;              /* consumed: the next frame starts fresh */
+    { static int dbg = -1; if (dbg < 0) dbg = getenv("WRITETHRU_DBG") ? 1 : 0;
+      static int _n = 0;
+      if (dbg && _n++ < 12) fprintf(stderr, "[WRITETHRU] raw=0x%X%c", raw, 10); }
+    if (!raw) return;
+    int slot = -1;
+    for (int i = 0; i < MAX_OFF_RTS && slot < 0; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (r->res && r->off == raw && r->w == s_d3d.width && r->h == s_d3d.height &&
+            r->dxgi == DXGI_FORMAT_R8G8B8A8_UNORM) slot = i;
+    }
+    { static int dbg2 = -1; if (dbg2 < 0) dbg2 = getenv("WRITETHRU_DBG") ? 1 : 0;
+      static int _n2 = 0;
+      if (dbg2 && slot < 0 && _n2++ < 6)
+          for (int i = 0; i < MAX_OFF_RTS; i++)
+              if (s_d3d.off_rt[i].res && s_d3d.off_rt[i].off == raw)
+                  fprintf(stderr, "[WRITETHRU]   candidate slot %d %ux%u dxgi=%u (bb %ux%u)%c", i,
+                          s_d3d.off_rt[i].w, s_d3d.off_rt[i].h, s_d3d.off_rt[i].dxgi,
+                          s_d3d.width, s_d3d.height, 10); }
+    if (slot < 0) return;
+    OffRT* r = &s_d3d.off_rt[slot];
+    if (r->hw != r->w || r->hh != r->h) { static int w2 = 0; if (w2++ < 2)   /* RES_SCALE */
+        fprintf(stderr, "[WRITETHRU] surface 0x%X is scaled (host %ux%u): DISPLAY_WRITETHRU not supported "
+                        "with RES_SCALE -- not written through%c", raw, r->hw, r->hh, 10);
+        return; }
+    D3D12_RESOURCE_BARRIER b[2] = {0};
+    b[0].Type = b[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b[0].Transition.pResource = s_d3d.render_targets[fi];
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[1].Transition.pResource = r->res;
+    b[1].Transition.StateBefore = r->st;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    b[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, r->st != D3D12_RESOURCE_STATE_COPY_DEST ? 2 : 1, b);
+    s_d3d.cmd_list->lpVtbl->CopyResource(s_d3d.cmd_list, r->res, s_d3d.render_targets[fi]);
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 2, b);
+    r->st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    r->gpu_dirty = 1;
+    { static int _n = 0; if (_n++ < 3)
+        fprintf(stderr, "[D3D12] display write-through: backbuffer -> surface 0x%X%c", raw, 10); }
+}
+
+static const char* s_rf_reason = "?";
+/* Guest samplers. Every guest-FP draw used to sample through 16 fixed static
+ * samplers -- s0 point/clamp (for the dbgfont atlas PS), s1-s15 linear/wrap --
+ * whatever the title asked for: unit 0 was point-sampled everywhere (inFamous
+ * 2's composite reads its 320x180 depth-of-field blur on unit 0: the blocky
+ * blur), clamped render-target reads wrapped, and the G-buffer's NEAREST reads
+ * were filtered. Now each draw binds a table of 16 samplers built from its
+ * units' TEXTURE_FILTER (min 16-23, mag 24-27) and TEXTURE_ADDRESS (wrap s/t/r
+ * in bits 0-3 / 8-11 / 16-19). Tables live in one shader-visible heap, 128 x
+ * 16, cached by content; set 0 is the old fixed set, used by draws without a
+ * guest FP. render_frame starts after its GPU wait, so nothing in flight reads
+ * the heap: the cache restarted there; SAMP_KEEP (default) keeps the filled
+ * sets and rewrites only sets no draw of the batch binds (samp_pick). Both
+ * lean on that full wait. GUEST_SAMPLERS=0: set 0 always. */
+#define SAMP_SETS 128
+static ID3D12DescriptorHeap* s_samp_heap;
+static u32 s_samp_inc;
+static u64 s_samp_key[SAMP_SETS][RSX_DRAW_TEX_UNITS];
+static int s_samp_n, s_samp_last = -1;
+static int samp_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("GUEST_SAMPLERS"); on = (e && *e == '0') ? 0 : 1; }
+    return on;
+}
+/* code: bit0 min linear, bit1 mag linear, bit2 mip linear, bit3 mips on,
+ * bits 4-6 / 7-9 / 10-12 address U/V/W (0 wrap, 1 mirror, 2 clamp, 3 border,
+ * 4 mirror-once). Guest mip levels (samp_lod_bits) add, with bit 53 set:
+ * bits 13-25 the LOD bias (TEXTURE_FILTER 0-12, signed 4.8), 26-37 min LOD
+ * and 38-49 max LOD (TEXTURE_CONTROL0, unsigned 4.8; 0xFFF = no clamp),
+ * 50-52 max anisotropy (CONTROL0 4-6). */
+#define SAMP_LEGACY_POINT  (0u | 8u | (2u << 4) | (2u << 7) | (2u << 10))
+#define SAMP_LEGACY_LINEAR (1u | 2u | 4u | 8u)
+static u32 samp_addr(u32 m)
+{
+    switch (m & 0xFu) {
+    case 2: return 1u;                    /* MIRROR */
+    case 3: case 5: return 2u;            /* CLAMP_TO_EDGE, CLAMP */
+    case 4: return 3u;                    /* BORDER */
+    case 6: case 7: case 8: return 4u;    /* MIRROR_ONCE_* */
+    default: return 0u;                   /* WRAP (1), unset */
+    }
+}
+static u32 samp_code(u32 addr, u32 filt)
+{
+    const u32 mn = (filt >> 16) & 0xFFu, mg = (filt >> 24) & 0xFu;
+    u32 c = 0;
+    switch (mn) {
+    case 1: break;                                 /* NEAREST */
+    case 2: c |= 1u; break;                        /* LINEAR */
+    case 3: c |= 8u; break;                        /* NEAREST_MIPMAP_NEAREST */
+    case 4: c |= 1u | 8u; break;                   /* LINEAR_MIPMAP_NEAREST */
+    case 5: c |= 4u | 8u; break;                   /* NEAREST_MIPMAP_LINEAR */
+    default: c |= 1u | 4u | 8u; break;             /* LINEAR_MIPMAP_LINEAR, CONVOLUTION, unset */
+    }
+    if (mg != 1u) c |= 2u;                         /* LINEAR, CONVOLUTION_MAG, unset */
+    c |= samp_addr(addr) << 4 | samp_addr(addr >> 8) << 7 | samp_addr(addr >> 16) << 10;
+    return c;
+}
+/* samp_code plus the guest's LOD state, for a unit whose texture has `nlv`
+ * levels uploaded. The fields are normalised so equal sampling gets one key
+ * (the 128 sets per frame are shared by every draw): no LOD state for a
+ * non-mipmapped filter or a one-level texture (nothing to select), a max LOD
+ * at or past the last level is "none", min <= max, and a state that changes
+ * nothing (no bias, no clamp, no anisotropy) is the plain code. CONTROL0 = 0
+ * (never written) clamps nothing. Anisotropy only with LINEAR_MIPMAP_LINEAR
+ * and a linear mag filter (D3D12_FILTER_ANISOTROPIC is that, anisotropic).
+ * TEX_MIPS=0: samp_code exactly. */
+static inline u64 samp_lod_bits(u64 c, u32 filt, u32 ctrl0, u32 nlv, const tc_mipcfg_t* mc)
+{
+    if (!mc->on || !(c & 8u) || nlv <= 1u) return c;
+    u32 mn = 0, mx = 0xFFFu, bias = 0, an = 0;
+    if (mc->lod) {
+        bias = filt & 0x1FFFu;
+        if (ctrl0) { mn = (ctrl0 >> 19) & 0xFFFu; mx = (ctrl0 >> 7) & 0xFFFu; }
+        const u32 top = (nlv - 1u) << 8;
+        if (mx >= top) mx = 0xFFFu;
+        if (mn > top) mn = top;
+        if (mx != 0xFFFu && mn > mx) mn = mx;
+    }
+    if (mc->aniso && (c & 7u) == 7u) an = (ctrl0 >> 4) & 7u;
+    if (s_aniso_user && (c & 7u) == 7u) {   /* the store's anisotropy (0 = the game's): at least that */
+        s_aniso_tri++;
+        if (s_aniso_user > an) { s_aniso_none += !an; an = s_aniso_user; s_aniso_raised++; }
+    }
+    if (!bias && !mn && mx == 0xFFFu && !an) return c;   /* neutral: the plain code samples the same */
+    return c | (1ull << 53) | ((u64)bias << 13) | ((u64)mn << 26) | ((u64)mx << 38) | ((u64)an << 50);
+}
+/* TEX_BORDER: border colours in sampler codes, bits 54-58 = an index into
+ * this table (0 = D3D's zero border). An entry is a guest ARGB8 word and how
+ * the unit's view reads it: 0 an RGBA view of a colour format (R,G,B,A from
+ * the word's bits 23-16, 15-8, 7-0, 31-24); 1 a depth unit's packed RGBA8
+ * alias (A,R,G = depth bits 23-16, 15-8, 7-0); 2 a depth view whose red is
+ * the depth. For 1 and 2 the border depth is the word's low 24 bits (the
+ * X8_D24 reading; GL's "red is the depth" gives the same 1.0 for the title's
+ * 0x00FFFFFF, a D24S8-texel reading, bits 31-8, would give 0.0039 -- which one
+ * the RSX uses has no hardware test: TEX_BORDER=2 is opt-in). A colour
+ * unit's view carries the guest bytes in storage order with the crossbar in
+ * the SRV's component mapping, and whether D3D swizzles the border colour
+ * with the view is not pinned down here (Vulkan leaves it to the device), so
+ * at TEX_BORDER=1 only a colour whose four bytes are equal -- the same in any
+ * channel order, which every BORDER colour unit of this title uses
+ * (0x80808080, 0) -- is applied; another one keeps the zero border, said
+ * once per colour, and TEX_BORDER=2 applies it as R,G,B,A. Entries are
+ * never reused for another colour, so a code means one sampler for the whole
+ * run; past 31 colours a unit keeps the zero border, said once. */
+static u32 s_bpal[32]; static u8 s_bpal_kind[32]; static int s_bpal_n = 1;
+static u64 samp_border_bits(u64 code, const D3D12DrawRecord* dr, int u)
+{
+    const int m = tex_border_mode();
+    if (!m || !dr->tex[u].set) return code;
+    const u32 am = (u32)(code >> 4) & 0x1FFu;          /* U, V, W: 3 bits each, 3 = BORDER */
+    if ((am & 7u) != 3u && ((am >> 3) & 7u) != 3u && ((am >> 6) & 7u) != 3u) return code;
+    const u32 c = dr->tex[u].bcol;
+    const u32 tm = dr->fp_shash ? (dr->fp_tkey >> (2u * (u32)u)) & 3u : 0u;
+    const int depth = tm == RSX_FP_TEX_DEPTH_PACKED || tm == RSX_FP_TEX_DEPTH;
+    if (depth && m < 2) return code;
+    if (!(depth ? c & 0xFFFFFFu : c)) return code;      /* zero: what D3D gives anyway */
+    if (!depth && m < 2 && c != (c & 0xFFu) * 0x01010101u) {
+        static u32 said[8]; static int ns = 0; int k = 0;
+        for (int i = 0; i < ns; i++) k |= said[i] == c;
+        if (!k && ns < 8) { said[ns++] = c;
+            fprintf(stderr, "[TEXBORDER] border 0x%08X (unit %d, fmt 0x%02X) depends on the channel order:"
+                            " zero border (TEX_BORDER=2 applies it)%c", c, u, dr->tex[u].fmt, 10); }
+        return code;
+    }
+    const u8 kind = tm == RSX_FP_TEX_DEPTH ? 2u : depth ? 1u : 0u;
+    for (int i = 1; i < s_bpal_n; i++)
+        if (s_bpal[i] == c && s_bpal_kind[i] == kind) return code | ((u64)i << 54);
+    if (s_bpal_n >= 32) { static int full = 0; if (!full++)
+        fprintf(stderr, "[TEXBORDER] more than 31 border colours: 0x%08X keeps the zero border%c", c, 10);
+        return code; }
+    s_bpal[s_bpal_n] = c; s_bpal_kind[s_bpal_n] = kind;
+    return code | ((u64)(s_bpal_n++) << 54);
+}
+static void samp_write(u64 code, D3D12_CPU_DESCRIPTOR_HANDLE h)
+{
+    static const D3D12_TEXTURE_ADDRESS_MODE am[5] = {
+        D3D12_TEXTURE_ADDRESS_MODE_WRAP, D3D12_TEXTURE_ADDRESS_MODE_MIRROR,
+        D3D12_TEXTURE_ADDRESS_MODE_CLAMP, D3D12_TEXTURE_ADDRESS_MODE_BORDER,
+        D3D12_TEXTURE_ADDRESS_MODE_MIRROR_ONCE };
+    D3D12_SAMPLER_DESC sd = {0};
+    sd.Filter = (D3D12_FILTER)(((code & 1u) ? 0x10 : 0) | ((code & 2u) ? 0x4 : 0) | ((code & 4u) ? 0x1 : 0));
+    sd.AddressU = am[((code >> 4) & 7u) % 5u];
+    sd.AddressV = am[((code >> 7) & 7u) % 5u];
+    sd.AddressW = am[((code >> 10) & 7u) % 5u];
+    sd.MaxAnisotropy = 1;
+    sd.ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+    { const u32 bi = (u32)(code >> 54) & 31u;            /* TEX_BORDER (samp_border_bits) */
+      if (bi && (int)bi < s_bpal_n) {
+          const u32 c = s_bpal[bi], d = c & 0xFFFFFFu;
+          if (s_bpal_kind[bi] == 0u) {                       /* colour: ARGB8 */
+              sd.BorderColor[0] = (float)((c >> 16) & 0xFFu) / 255.0f;
+              sd.BorderColor[1] = (float)((c >> 8) & 0xFFu) / 255.0f;
+              sd.BorderColor[2] = (float)(c & 0xFFu) / 255.0f;
+              sd.BorderColor[3] = (float)(c >> 24) / 255.0f;
+          } else if (s_bpal_kind[bi] == 1u) {                /* packed alias: depth in A,R,G */
+              sd.BorderColor[0] = (float)((d >> 8) & 0xFFu) / 255.0f;
+              sd.BorderColor[1] = (float)(d & 0xFFu) / 255.0f;
+              sd.BorderColor[3] = (float)(d >> 16) / 255.0f;
+          } else                                             /* red = depth */
+              sd.BorderColor[0] = (float)((double)d / 16777215.0);
+      } }
+    sd.MinLOD = 0.0f;
+    sd.MaxLOD = (code & 8u) ? D3D12_FLOAT32_MAX : 0.0f;   /* no mipmapping: level 0 only */
+    if ((code & 8u) && ((code >> 53) & 1u)) {            /* guest LOD state (samp_lod_bits) */
+        int b = (int)((code >> 13) & 0x1FFFu);
+        if (b & 0x1000) b -= 0x2000;                      /* signed 4.8: -16 .. +15.996 */
+        sd.MipLODBias = (float)b / 256.0f;
+        if (sd.MipLODBias > 15.99f) sd.MipLODBias = 15.99f;   /* D3D12_MIP_LOD_BIAS_MAX */
+        sd.MinLOD = (float)((code >> 26) & 0xFFFu) / 256.0f;
+        const u32 mx = (u32)(code >> 38) & 0xFFFu;
+        sd.MaxLOD = (mx == 0xFFFu) ? D3D12_FLOAT32_MAX : (float)mx / 256.0f;
+        const u32 an = (u32)(code >> 50) & 7u;
+        if (an) {
+            static const UINT at[8] = {1, 2, 4, 6, 8, 10, 12, 16};
+            sd.Filter = D3D12_FILTER_ANISOTROPIC;
+            sd.MaxAnisotropy = at[an];
+        }
+    }
+    { float lo, hi; int pm;   /* texture packs: a replacement's shifted LOD clamps (rsx_texpack.h) */
+      if ((code & TP_SAMP_SHIFTED) && tp_samp_lod(code, &lo, &hi, &pm)) {
+          if (pm) sd.Filter = (D3D12_FILTER)(sd.Filter | 0x1);   /* + linear mip, levels [0, s] */
+          sd.MinLOD = lo; sd.MaxLOD = hi;
+      } }
+    rs_art_samp(code, &sd);   /* RSX_RES_ARTLOG */
+    rth_desc(4, h.ptr, NULL, &sd, sizeof sd);   /* RT_STREAM_LOG */
+    s_d3d.device->lpVtbl->CreateSampler(s_d3d.device, &sd, h);
+}
+static void samp_fill(int set, const u64* codes)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_samp_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_samp_heap, &h);
+    h.ptr += (SIZE_T)set * RSX_DRAW_TEX_UNITS * s_samp_inc;
+    for (int u = 0; u < RSX_DRAW_TEX_UNITS; u++) {
+        samp_write(codes[u], h);
+        s_samp_key[set][u] = codes[u];
+        h.ptr += s_samp_inc;
+        /* [TEXMIP] stats: a mipmapped unit CONTROL0 pins to level 0 */
+        if (((codes[u] >> 53) & 1u) && ((codes[u] >> 38) & 0xFFFu) == 0u) s_tc.st_clamp0++;
+    }
+    if (set > 0) s_tc.st_sampnew++;
+}
+static int samp_init(void)
+{
+    if (s_samp_heap) return 1;
+    D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+    hd.NumDescriptors = SAMP_SETS * RSX_DRAW_TEX_UNITS;
+    hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if (FAILED(s_d3d.device->lpVtbl->CreateDescriptorHeap(s_d3d.device, &hd,
+            &IID_ID3D12DescriptorHeap, (void**)&s_samp_heap)) || !s_samp_heap) {
+        fprintf(stderr, "[SAMP] sampler heap creation failed%c", 10);
+        s_samp_heap = NULL; return 0;
+    }
+    s_samp_inc = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(s_d3d.device,
+                     D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER);
+    u64 legacy[RSX_DRAW_TEX_UNITS];
+    legacy[0] = SAMP_LEGACY_POINT;
+    for (int u = 1; u < RSX_DRAW_TEX_UNITS; u++) legacy[u] = SAMP_LEGACY_LINEAR;
+    samp_fill(0, legacy);
+    s_samp_n = 1; s_samp_last = -1;
+    return 1;
+}
+/* Set lookup: a hash of the 16 codes -> the set last filled or found with
+ * it (index + 1, this frame); a collision falls back to the scan. Draws
+ * that change texture state look their set up in O(1) instead of comparing
+ * against every set built so far -- with the guest's LOD state in the codes a
+ * frame builds more of them. Returns the same set the scan would: sets are
+ * unique per content. */
+#define SAMP_HBUCKETS 512u
+static u8 s_samp_hb[SAMP_HBUCKETS];
+static inline u32 samp_hash(const u64* c)
+{
+    u64 h = 0x9E3779B97F4A7C15ull;
+    for (int u = 0; u < RSX_DRAW_TEX_UNITS; u++) { h ^= c[u]; h *= 0xBF58476D1CE4E5B9ull; h ^= h >> 31; }
+    return (u32)(h >> 40) & (SAMP_HBUCKETS - 1u);
+}
+/* PF3 SAMP_KEEP (default 1; 0 = every batch starts with all 127 sets free and
+ * builds the ones it binds again, as before). A set's 16 descriptors are a
+ * pure function of its 16 codes (samp_write: the border palette is
+ * append-only, an index means one colour for the whole run; texture packs'
+ * shifts and the store's anisotropy are in the codes), so a set kept from an
+ * earlier batch holds exactly what building it again would write. Sets stay
+ * filled across batches; a batch that needs a new one takes a free slot, else
+ * the least recently bound set no draw of THIS batch binds (its descriptors
+ * are rewritten; the GPU finished every earlier batch at render_frame's
+ * wait). The heap is full only when this batch itself binds all 127, exactly
+ * when the old per-batch heap was, and the "full" stand-in then searches only
+ * this batch's sets, as before. The heavy pier view built ~25 sets of 16
+ * samplers per batch, 5 batches a frame (~0.3 ms of CreateSampler). */
+static int samp_keep_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("SAMP_KEEP"); on = (e && *e == '0') ? 0 : 1; }
+    return on;
+}
+static u32 s_samp_use[SAMP_SETS];   /* SAMP_KEEP: the batch (s_samp_batch) that last bound the set */
+static u32 s_samp_batch;            /* SAMP_KEEP: batches started (samp_frame_start) */
+static u32 s_samp_nused;            /* SAMP_KEEP: sets this batch binds (the [TEXMIP] peak) */
+static inline void samp_mark(int i)
+{
+    if (s_samp_use[i] != s_samp_batch) {
+        s_samp_use[i] = s_samp_batch;
+        if (++s_samp_nused + 1u > s_tc.st_samp_peak) s_tc.st_samp_peak = s_samp_nused + 1u;
+    }
+}
+/* PF3_VERIFY: the old per-batch allocation, run beside SAMP_KEEP -- per draw
+ * the codes of the set it would bind are compared with the kept set's. */
+static u64 s_spv_key[SAMP_SETS][RSX_DRAW_TEX_UNITS];
+static int s_spv_n = 1;
+static void samp_verify(const u64* codes, int got, const tc_mipcfg_t* mc)
+{
+    int i = 1, idx = -1;
+    for (; i < s_spv_n; i++) if (!memcmp(s_spv_key[i], codes, 8u * RSX_DRAW_TEX_UNITS)) { idx = i; break; }
+    if (idx < 0 && s_spv_n < SAMP_SETS) { memcpy(s_spv_key[s_spv_n], codes, 8u * RSX_DRAW_TEX_UNITS); idx = s_spv_n++; }
+    if (idx < 0) {                                       /* the old "full" stand-in */
+        s_pf3v.sp_full++;
+        idx = 0;
+        if (mc->on) {
+            u64 plain[RSX_DRAW_TEX_UNITS]; int lod = 0;
+            for (int u = 0; u < RSX_DRAW_TEX_UNITS; u++) {
+                plain[u] = codes[u] & (0x1FFFull | (31ull << 54));
+                lod |= plain[u] != codes[u];
+            }
+            for (int k = 1; lod && k < s_spv_n; k++)
+                if (!memcmp(s_spv_key[k], plain, sizeof plain)) { idx = k; break; }
+        }
+    }
+    u64 legacy[RSX_DRAW_TEX_UNITS];
+    legacy[0] = SAMP_LEGACY_POINT;
+    for (int u = 1; u < RSX_DRAW_TEX_UNITS; u++) legacy[u] = SAMP_LEGACY_LINEAR;
+    const u8* a = (const u8*)(idx ? s_spv_key[idx] : legacy);
+    const u8* b = (const u8*)(got ? s_samp_key[got] : legacy);
+    for (u32 k = 0; k < 8u * RSX_DRAW_TEX_UNITS; k++) s_pf3v.sp_diff += a[k] != b[k];
+    s_pf3v.sp_cmp++;
+}
+/* render_frame, after its GPU wait: nothing in flight reads the heap, so
+ * every batch starts with all 127 sets free (SAMP_KEEP: all 127 may be
+ * rewritten; the filled ones are kept). That wait is what makes rewriting a
+ * set safe: if batches ever overlap on the GPU (an async readback), a set must
+ * also wait for the fence of the last batch that bound it (s_samp_use would
+ * hold that fence). */
+static void samp_frame_start(void)
+{
+    s_spv_n = 1;                                   /* PF3_VERIFY: the old heap starts empty */
+    if (samp_keep_on()) {
+        s_samp_batch++; s_samp_nused = 0;
+        s_samp_last = -1;
+        if (s_samp_n >= 1) return;                 /* the sets filled so far stay */
+        memset(s_samp_use, 0, sizeof s_samp_use);  /* (after a save-state load: none) */
+    }
+    s_samp_n = 1; s_samp_last = -1;
+    memset(s_samp_hb, 0, sizeof s_samp_hb);
+}
+/* The set holding `codes` for this batch's draw: found, filled, or the
+ * "full" stand-in (samp_set_for; SAMP_KEEP above). */
+static int samp_pick(const u64* codes, const tc_mipcfg_t* mc)
+{
+    const size_t cb = 8u * RSX_DRAW_TEX_UNITS;
+    const int keep = samp_keep_on();
+    if (s_samp_last > 0 && !memcmp(s_samp_key[s_samp_last], codes, cb)) return s_samp_last;
+    const u32 hb = samp_hash(codes);
+    { const int i = (int)s_samp_hb[hb] - 1;
+      if (i > 0 && i < s_samp_n && !memcmp(s_samp_key[i], codes, cb)) {
+          if (keep) samp_mark(i);
+          return s_samp_last = i; } }
+    for (int i = 1; i < s_samp_n; i++)
+        if (!memcmp(s_samp_key[i], codes, cb)) {
+            s_samp_hb[hb] = (u8)(i + 1);
+            if (keep) samp_mark(i);
+            return s_samp_last = i;
+        }
+    int slot = -1;
+    if (s_samp_n < SAMP_SETS) slot = s_samp_n;
+    else if (keep) {                  /* SAMP_KEEP: the least recently bound set this batch does not bind */
+        u32 best = 0xFFFFFFFFu;
+        for (int i = 1; i < SAMP_SETS; i++)
+            if (s_samp_use[i] != s_samp_batch && s_samp_use[i] < best) { best = s_samp_use[i]; slot = i; }
+    }
+    if (slot < 0) {
+        /* Out of sets: a set this frame already has with the same filters and
+         * wrap modes, without the guest's LOD state, is closer than the fixed
+         * set. (SAMP_KEEP: only this batch's sets, as the per-batch heap had.) */
+        if (mc->on) {
+            u64 plain[RSX_DRAW_TEX_UNITS]; int lod = 0;
+            for (int u = 0; u < RSX_DRAW_TEX_UNITS; u++) {
+                plain[u] = codes[u] & (0x1FFFull | (31ull << 54));   /* keeps TEX_BORDER's colour */
+                lod |= plain[u] != codes[u];
+            }
+            for (int i = 1; lod && i < s_samp_n; i++)
+                if ((!keep || s_samp_use[i] == s_samp_batch) && !memcmp(s_samp_key[i], plain, sizeof plain)) {
+                    static int nl = 0; if (nl++ < 4)
+                        fprintf(stderr, "[TEXMIP] all %d sampler sets in use this frame: a draw samples without"
+                                        " its LOD bias/clamp/anisotropy%c", SAMP_SETS, 10);
+                    return s_samp_last = i;
+                }
+        }
+        static int n = 0; if (n++ < 4)
+            fprintf(stderr, "[SAMP] all %d sampler sets in use this frame: the fixed set stands in%c",
+                    SAMP_SETS, 10);
+        return 0;
+    }
+    samp_fill(slot, codes);
+    s_samp_hb[hb] = (u8)(slot + 1);
+    if (slot == s_samp_n) s_samp_n++;
+    if (keep) samp_mark(slot);
+    else if ((u32)slot + 1u > s_tc.st_samp_peak) s_tc.st_samp_peak = (u32)slot + 1u;
+    return s_samp_last = slot;
+}
+static int samp_set_for(const D3D12DrawRecord* dr, int guest_fp)
+{
+    if (!guest_fp || !samp_on()) return 0;
+    u64 codes[RSX_DRAW_TEX_UNITS];
+    const tc_mipcfg_t* mc = tc_mipcfg();
+    if (mc->on) {
+        /* With the guest's LOD state in the key, a unit the program never
+         * samples (units stay set long after use) gets the fixed code, so it
+         * cannot split one sampler set into several. The level count is only
+         * worked out for a mipmapping filter. */
+        static u8 memo_ls[RSX_DRAW_TEX_UNITS];   /* texture packs: the replacement LOD shift memo[u] was made with */
+        /* (each unit's code is remembered with its inputs: consecutive draws
+         * mostly share them) */
+        static struct { u32 addr, filt, ctrl0, w, h, mips; u64 code; } memo[RSX_DRAW_TEX_UNITS];
+        static u32 memo_gen;   /* the codes depend on the store's anisotropy too */
+        if (memo_gen != s_aniso_gen) { memset(memo, 0, sizeof memo); memo_gen = s_aniso_gen; }
+        const u32 live = dr->fp_shash ? dr->fp_texmask : 0xFFFFu;
+        for (int u = 0; u < RSX_DRAW_TEX_UNITS; u++) {
+            if (!dr->tex[u].set || !(live & (1u << u))) { codes[u] = SAMP_LEGACY_LINEAR; continue; }
+            const u32 ad = dr->tex[u].addr, fl = dr->tex[u].filt, c0 = dr->tex[u].ctrl0;
+            const u32 tw = dr->tex[u].w, th = dr->tex[u].h, tm = dr->tex[u].mips;
+            const u32 ls = g_tp_on ? dr->tex[u].tp_ls : 0u;   /* texture packs: replacement LOD shift */
+            if (memo[u].code && memo[u].addr == ad && memo[u].filt == fl && memo[u].ctrl0 == c0 &&
+                memo[u].w == tw && memo[u].h == th && memo[u].mips == tm && memo_ls[u] == ls) { codes[u] = memo[u].code; continue; }
+            const u64 c = samp_code(ad, fl);
+            codes[u] = (c & 8u) ? samp_lod_bits(c, fl, c0, tc_up_levels(tc_guest_levels(tw, th, tm)), mc) : c;
+            if (ls) codes[u] = tp_samp_shift(codes[u], (int)ls - 8, s_tp.minify_mip);
+            memo[u].addr = ad; memo[u].filt = fl; memo[u].ctrl0 = c0; memo_ls[u] = (u8)ls;
+            memo[u].w = tw; memo[u].h = th; memo[u].mips = tm; memo[u].code = codes[u];
+        }
+    } else
+    for (int u = 0; u < RSX_DRAW_TEX_UNITS; u++)
+        codes[u] = dr->tex[u].set ? samp_code(dr->tex[u].addr, dr->tex[u].filt) : SAMP_LEGACY_LINEAR;
+    if (tex_border_mode())
+        for (int u = 0; u < RSX_DRAW_TEX_UNITS; u++) codes[u] = samp_border_bits(codes[u], dr, u);
+    const int set = samp_pick(codes, mc);
+    if (pf3_verify_on() && samp_keep_on()) samp_verify(codes, set, mc);
+    return set;
+}
+static D3D12_GPU_DESCRIPTOR_HANDLE samp_gpu(int set)
+{
+    D3D12_GPU_DESCRIPTOR_HANDLE g;
+    s_samp_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_samp_heap, &g);
+    g.ptr += (u64)set * RSX_DRAW_TEX_UNITS * s_samp_inc;
+    return g;
+}
+
+/* PRESENT_CAP=<hz> (default 0 = off): present on a fixed cadence of 1/hz s. The
+ * wait runs right before Present on this (the FIFO walker's) thread, so --
+ * like vsync today -- it holds the walker, the RSX labels it writes, and every
+ * guest thread waiting on them: the whole frame chain runs at the cap. With
+ * PRESENT_SYNC=0 it is the frame limiter for a target above the display's
+ * refresh. Each present's deadline is the previous one plus a period; a
+ * present more than a period late re-bases instead of bursting to catch up.
+ * A high-resolution waitable timer wakes ~0.5 ms late on a test PC (local
+ * bench_sleep), so the last 0.6 ms is a pause spin. */
+/* FRAME_LIMIT's vblank lock (cellGcmSys.c gcm_vsync_pace): k vblanks a frame,
+ * so each frame is shown for k refreshes; 0 = the PRESENT_SYNC interval. */
+extern volatile int g_pace_k;
+static UINT present_interval(int psync)
+{
+    const int k = g_pace_k;
+    return (UINT)(k > 0 && k <= 4 ? k : psync);
+}
+static void frame_pace_wait(void)
+{
+    if (s_lat_wait) WaitForSingleObjectEx(s_lat_wait, 250, FALSE);   /* PRESENT_LATENCY: a queue slot */
+    static int hz = -1;
+    static LONGLONG period, next;
+    static HANDLE timer;
+    static LARGE_INTEGER f;
+    if (hz < 0) {
+        const char* e = getenv("PRESENT_CAP");
+        hz = e ? atoi(e) : 0;
+        if (hz < 0 || hz > 1000) hz = 0;
+        QueryPerformanceFrequency(&f);
+        if (hz) {
+            period = f.QuadPart / hz;
+            timer = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* HIGH_RESOLUTION */, TIMER_ALL_ACCESS);
+            if (!timer) timer = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+            fprintf(stderr, "[present] PRESENT_CAP %d Hz (%s timer)%c", hz, timer ? "waitable" : "no", 10);
+        }
+    }
+    if (!hz) return;
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+    if (!next || now.QuadPart - next > period) next = now.QuadPart;   /* first, or late: re-base */
+    const LONGLONG spin = f.QuadPart * 6 / 10000;                     /* 0.6 ms */
+    const LONGLONG left = next - now.QuadPart;
+    if (left > spin && timer) {
+        LARGE_INTEGER due;
+        due.QuadPart = -(LONGLONG)((left - spin) * 10000000 / f.QuadPart);
+        if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE))
+            WaitForSingleObject(timer, 100);
+    }
+    for (;;) {
+        QueryPerformanceCounter(&now);
+        if (now.QuadPart >= next) break;
+        YieldProcessor();
+    }
+    next += period;
+}
+
+/* FRAMETIME_LOG=1: once a second, the present-to-present intervals of the
+ * frames actually presented (p50/p90/p99/max, ms) -- the pacing an fps average
+ * hides -- and how long Present itself held this thread per frame (vsync, a
+ * full present queue), plus the FPS_CAP wait. */
+static int ft_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("FRAMETIME_LOG"); v = (e && *e != '0') ? 1 : 0; }
+    return v;
+}
+static void ft_note_present(double t_cap0, double t_pr0, double t_pr1)
+{
+    static double last, t0, blk, capw, ints[2048];
+    static unsigned n;
+    blk += t_pr1 - t_pr0;
+    capw += t_pr0 - t_cap0;
+    if (last > 0.0 && n < 2048) ints[n++] = t_pr1 - last;
+    last = t_pr1;
+    if (t0 == 0.0) t0 = t_pr1;
+    if (t_pr1 - t0 >= 1.0 && n) {
+        for (unsigned i = 1; i < n; i++) {
+            const double x = ints[i]; unsigned j = i;
+            while (j && ints[j - 1] > x) { ints[j] = ints[j - 1]; j--; }
+            ints[j] = x;
+        }
+        fprintf(stderr, "[frametime] n=%u p50=%.2f p90=%.2f p99=%.2f max=%.2f ms | Present held %.2f ms/frame,"
+                        " PRESENT_CAP wait %.2f ms/frame%c",
+                n, 1e3 * ints[n / 2], 1e3 * ints[(n * 9) / 10], 1e3 * ints[(n * 99) / 100],
+                1e3 * ints[n - 1], 1e3 * blk / n, 1e3 * capw / n, 10);
+        n = 0; blk = 0.0; capw = 0.0; t0 = t_pr1;
+    }
+}
+
+/* FRAME_TRACE: the present just made (times on the ftr clock); the row is
+ * written by render_frame's wrapper once this batch's own time is in. */
+extern int g_ftr_on;
+extern long long g_ftr_req_qpc[64];
+extern volatile unsigned g_ftr_req_n, g_ftr_walk_n;
+extern double g_ftr_idle_s;
+extern long long g_ftr_ready_qpc;
+extern volatile int g_ftr_pad_rx;
+extern volatile unsigned g_ftr_fifo_catchup, g_ftr_backlog_max;
+static struct { int pending; double t_pace0, t_pr0, t_pr1, last_pr1; u64 n; unsigned last_wn; } s_ftp;
+static void ftr_note_present(double t_pace0, double t_pr0, double t_pr1)
+{
+    s_ftp.pending = 1; s_ftp.t_pace0 = t_pace0; s_ftp.t_pr0 = t_pr0; s_ftp.t_pr1 = t_pr1;
+}
+#include <psapi.h>
+static unsigned long ftr_pagefaults(void)    /* FRAME_TRACE pagefaults: the process's faults since the last row */
+{
+    static DWORD last;
+    PROCESS_MEMORY_COUNTERS pmc;
+    memset(&pmc, 0, sizeof pmc);
+    if (!K32GetProcessMemoryInfo(GetCurrentProcess(), &pmc, sizeof pmc)) return 0;
+    const DWORD d = last ? pmc.PageFaultCount - last : 0;
+    last = pmc.PageFaultCount;
+    return (unsigned long)d;
+}
+/* FRAME_TRACE vram_hw_mb (ST1 review): the process's local video memory high-water mark (sampled every 16 rows) */
+static double ftr_vram_mb(void)
+{
+    if ((s_ftp.n & 15u) == 0) (void)vram_sample(NULL, NULL);
+    return (double)s_vram.hw / 1048576.0;
+}
+static void ftr_write_row(void)
+{
+    s_ftp.pending = 0;
+    if (s_ftr_on == 2) {                 /* light: the issues log takes the frame; no DXGI stats, no file */
+        pi_frame_info fi;
+        memset(&fi, 0, sizeof fi);
+        fi.interval_ms = s_ftp.last_pr1 > 0.0 ? 1e3 * (s_ftp.t_pr1 - s_ftp.last_pr1) : 0.0;
+        s_ftp.last_pr1 = s_ftp.t_pr1;
+        fi.present_ms = 1e3 * (s_ftp.t_pr1 - s_ftp.t_pr0);
+        fi.pace_ms = 1e3 * (s_ftp.t_pr0 - s_ftp.t_pace0);
+        fi.render_ms = 1e3 * s_ftr.rf;
+        fi.gpu_wait_ms = 1e3 * s_ftr.gw;
+        fi.game_wait_ms = 1e3 * g_ftr_idle_s;
+        /* vs_new holds its own nested compile: the larger of the two, not the sum */
+        const double comp = s_ftr.ps_comp + s_ftr.sc_read + s_ftr.sc_wait;
+        fi.compile_ms = 1e3 * (s_ftr.vs_new > comp ? s_ftr.vs_new : comp);
+        fi.pipeline_ms = 1e3 * s_ftr.pso_create;
+        fi.readback_ms = 1e3 * s_ftr.rb;
+        fi.compiles = s_ftr.ps_comp_n + s_ftr.vs_new_n;
+        fi.pipelines = s_ftr.pso_create_n;
+        fi.readbacks = s_ftr.rb_n;
+        fi.tex_uploads = s_ftr.tex_up_n;
+        fi.tex_new = s_ftr.tex_new_n + s_ftr.tex_rec_n;
+        fi.tex_mb = (double)s_ftr.tex_bytes / 1048576.0;
+        fi.new_targets = s_ftr.rt_new_n + s_ftr.zeta_new_n;
+        pi_frame(&fi);
+        memset(&s_ftr, 0, sizeof s_ftr);
+        g_ftr_idle_s = 0.0; g_ftr_fifo_catchup = 0; g_ftr_backlog_max = 0;
+        s_ftp.last_wn = g_ftr_walk_n;
+        return;
+    }
+    static double t_first;
+    if (t_first == 0.0) t_first = s_ftp.t_pr1;
+    const double qf = (double)s_ftr_freq.QuadPart;
+    /* The frame this present shows: the last flip request the walker reached. */
+    const unsigned wn = g_ftr_walk_n;
+    double flip_dt = 0.0, f2p = 0.0;
+    if (wn >= 1 && g_ftr_req_n >= wn && g_ftr_req_n - wn < 60) {
+        const long long q1 = g_ftr_req_qpc[(wn - 1) & 63u];
+        f2p = s_ftp.t_pr1 - (double)q1 / qf;
+        if (wn >= 2) flip_dt = (double)(q1 - g_ftr_req_qpc[(wn - 2) & 63u]) / qf;
+    }
+    /* DXGI frame statistics: the latest present the display has shown and the
+     * vblank it was shown at (flip model: windowed too). */
+    DXGI_FRAME_STATISTICS fs; memset(&fs, 0, sizeof fs);
+    UINT lpc = 0;
+    if (FAILED(s_d3d.swap_chain->lpVtbl->GetFrameStatistics(s_d3d.swap_chain, &fs))) memset(&fs, 0, sizeof fs);
+    s_d3d.swap_chain->lpVtbl->GetLastPresentCount(s_d3d.swap_chain, &lpc);
+    const double iv = s_ftp.last_pr1 > 0.0 ? s_ftp.t_pr1 - s_ftp.last_pr1 : 0.0;
+    s_ftp.last_pr1 = s_ftp.t_pr1;
+    u64 vce[7]; vc_ftr_events(vce);
+    fprintf(s_ftr_f, "%llu,%.6f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,%u,%u,%u,%u,%u,%u,%.3f,%u,%.3f,%u,%.3f,%u,%.3f,"
+                     "%u,%.3f,%u,%u,%u,%.3f,%.3f,%.3f,%u,%u,%u,%.3f,%.3f,%u,%u,%u,%.3f,%d,%.4f,%d,%u,%.3f,%u,%d,"
+                     "%u,%u,%u,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%u,%u,%u,%.3f,%u,%.3f,%.3f,%lu,%u,%u,%.0f\n",
+            (unsigned long long)s_ftp.n++, s_ftp.t_pr1 - t_first, 1e3 * iv, 1e3 * flip_dt, 1e3 * f2p,
+            1e3 * (s_ftp.t_pr1 - s_ftp.t_pr0), 1e3 * (s_ftp.t_pr0 - s_ftp.t_pace0), 1e3 * s_ftr.rf,
+            1e3 * s_ftr.gw, 1e3 * g_ftr_idle_s, s_ftr.batches, s_ftr.fl_rb, s_ftr.fl_zp, s_ftr.fl_cap,
+            s_dbg_last_draws, s_ftr.pso_miss, 1e3 * s_ftr.pso, s_ftr.ps_comp_n, 1e3 * s_ftr.ps_comp,
+            s_ftr.sc_hit_n, 1e3 * s_ftr.sc_read, s_ftr.vs_new_n, 1e3 * s_ftr.vs_new, s_ftr.pso_create_n,
+            1e3 * s_ftr.pso_create, s_ftr.tex_up_n, s_ftr.tex_new_n, s_ftr.tex_rec_n,
+            (double)s_ftr.tex_bytes / 1048576.0, 1e3 * s_ftr.tex_up, 1e3 * s_ftr.tex_val, s_ftr.rt_new_n,
+            s_ftr.zeta_new_n, s_ftr.rb_n, 1e3 * s_ftr.rb, 1e3 * s_ftr.vtx, (unsigned)fs.PresentCount,
+            (unsigned)fs.PresentRefreshCount, (unsigned)fs.SyncRefreshCount,
+            fs.SyncQPCTime.QuadPart ? 1e3 * ((double)fs.SyncQPCTime.QuadPart / qf - t_first) : 0.0,
+            (int)(lpc - fs.PresentCount),
+            g_ftr_ready_qpc ? s_ftp.t_pr1 - (double)g_ftr_ready_qpc / qf : -1.0, g_ftr_pad_rx,
+            s_ftr.sc_wait_n, 1e3 * s_ftr.sc_wait, s_ftr.kick_n, sc_prewarm_left(),
+            wn - s_ftp.last_wn, g_ftr_fifo_catchup, g_ftr_backlog_max >> 10,
+            (unsigned long long)vce[0], (unsigned long long)vce[1], (unsigned long long)vce[2],
+            (unsigned long long)vce[3], (unsigned long long)vce[4], (unsigned long long)vce[5],
+            (unsigned long long)vce[6], s_ftr.fl_fz, s_ftr.fz_n,
+            s_ftr.tex_cr_n, 1e3 * s_ftr.tex_cr, s_ftr.upb_n, 1e3 * s_ftr.upb, 1e3 * s_ftr.rt_cr, ftr_pagefaults(),
+            s_ftr.pso_pre_n, s_ftr.sc_mem_n, ftr_vram_mb());
+    s_ftp.last_wn = wn;                  /* flips: guest frames this present covers (2+ = one never shown) */
+    memset(&s_ftr, 0, sizeof s_ftr);
+    g_ftr_idle_s = 0.0; g_ftr_fifo_catchup = 0; g_ftr_backlog_max = 0;
+    if ((s_ftp.n & 63u) == 0) fflush(s_ftr_f);
+}
+
+/* GPU_TIME=1: GPU time of every render_frame command list -- a timestamp
+ * at its start and one at its end, read back at the next render_frame after
+ * its wait_for_gpu (no extra wait), summed per presented frame. Every 60
+ * presented frames: [GPUTIME] busy ms/frame, lists/frame, longest list.
+ * Readback lists (rsx_d3d12_readback_surface) are not timed. */
+static ID3D12QueryHeap* s_gt_qh;
+static ID3D12Resource*  s_gt_rb;
+static u64    s_gt_freq;
+static int    s_gt_on = -1, s_gt_pending;
+static double s_gt_sum, s_gt_max;
+static u32    s_gt_lists, s_gt_frames;
+static int gpu_time_on(void)
+{
+    if (s_gt_on >= 0) return s_gt_on;
+    s_gt_on = 0;
+    const char* e = getenv("GPU_TIME");
+    if (!e || *e == '0' || !s_d3d.device || !s_d3d.cmd_queue) return 0;
+    D3D12_QUERY_HEAP_DESC qd = {0};
+    qd.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP; qd.Count = 4;   /* the list's start / end, the window pass's */
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = 32; bd.Height = 1;
+    bd.DepthOrArraySize = 1; bd.MipLevels = 1; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(s_d3d.device->lpVtbl->CreateQueryHeap(s_d3d.device, &qd, &IID_ID3D12QueryHeap, (void**)&s_gt_qh)) ||
+        FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+               D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_gt_rb)) ||
+        FAILED(s_d3d.cmd_queue->lpVtbl->GetTimestampFrequency(s_d3d.cmd_queue, &s_gt_freq)) || !s_gt_freq) {
+        fprintf(stderr, "[GPUTIME] timestamp queries unavailable -- off%c", 10);
+        return 0;
+    }
+    s_gt_on = 1;
+    return 1;
+}
+/* The window pass's own pair of timestamps (queries 2, 3; rs_window_present). */
+static struct { int mark, pend; double sum; u32 n; } s_gt_win;
+/* CHAIN_TRACE: GPU ms per list class -- 0 a presenting batch, 1 a readback
+ * flush, 2 any other flush (printed after [GPUTIME]) */
+static int s_gt_cls_pend;
+static double s_gt_cls_sum[3]; static u32 s_gt_cls_n[3];
+static void gpu_time_win(int end)
+{
+    if (s_gt_on != 1) return;
+    s_d3d.cmd_list->lpVtbl->EndQuery(s_d3d.cmd_list, s_gt_qh, D3D12_QUERY_TYPE_TIMESTAMP, end ? 3u : 2u);
+    if (end) s_gt_win.mark = 1;
+}
+/* After wait_for_gpu: the previous list has completed. */
+static void gpu_time_collect(void)
+{
+    if (!s_gt_pending || !s_gt_rb) return;
+    s_gt_pending = 0;
+    u64* t = NULL; D3D12_RANGE rr = {0, 32};
+    if (FAILED(s_gt_rb->lpVtbl->Map(s_gt_rb, 0, &rr, (void**)&t)) || !t) return;
+    const double ms = t[1] > t[0] ? (double)(t[1] - t[0]) * 1000.0 / (double)s_gt_freq : 0.0;
+    if (s_gt_win.pend && t[3] > t[2]) { s_gt_win.sum += (double)(t[3] - t[2]) * 1000.0 / (double)s_gt_freq; s_gt_win.n++; }
+    s_gt_win.pend = 0;
+    if (ps3_chain_on()) { s_gt_cls_sum[s_gt_cls_pend] += ms; s_gt_cls_n[s_gt_cls_pend]++; }
+    D3D12_RANGE wr = {0, 0};
+    s_gt_rb->lpVtbl->Unmap(s_gt_rb, 0, &wr);
+    s_gt_sum += ms; s_gt_lists++;
+    if (ms > s_gt_max) s_gt_max = ms;
+}
+
+/* ---- Exact ZPASS reports (rsx_report.c, rsx_d3d12_report.c) -----------------
+ * A record made while ZPASS_PIXEL_COUNT_ENABLE is on carries its counter
+ * segment (zp_seg, vp_record_cb). The replay wraps each such draw in an
+ * occlusion query (the exact count of samples that pass; one per pixel, no
+ * MSAA here), resolves the list's queries before Close, and after the GPU has
+ * run the list (the next render_frame's wait, or a report's own flush) adds
+ * each draw's samples to its segment. A report the title can observe before
+ * then is measured on demand (d3d12_report_measure). */
+#include "rsx_report.h"       /* segments, delivery, texture-cache epoch, RT_SELFSAMPLE */
+#include "rsx_d3d12_report.h" /* occlusion queries, snapshot copy */
+#include "rsx_d3d12_glight.h" /* GL1: the title's SPU lighting on the GPU */
+static void render_frame(void);
+static int zp_begin(const D3D12DrawRecord* dr)
+{
+    if (!dr->zp_seg || dr->is_clear || !rsx_zpass_init(s_d3d.device, MAX_DRAWS)) return -1;
+    return rsx_zpass_begin(s_d3d.cmd_list, dr->zp_seg);
+}
+/* rsx_report_backend.measure: every record counting into a segment <= seg_hi
+ * executed and collected. A pending one forces a flush (as an RT readback
+ * does) and a GPU wait. */
+static int d3d12_report_measure(void* ud, u32 seg_hi)
+{
+    (void)ud;
+    if (!s_d3d.initialized) return -1;
+    rt_drain();   /* R1: the replayed list's ZPASS queries are resolved before they are waited for */
+    int need = 0;
+    for (u32 d = 0; d < s_d3d.draw_count && d < MAX_DRAWS && !need; d++)
+        need = s_d3d.draws[d].is_vp && s_d3d.draws[d].zp_seg && s_d3d.draws[d].zp_seg <= seg_hi;
+    if (need) {
+        if (s_rf_flush) return 0;            /* inside a flush: not now */
+        const char* why = s_rf_reason;
+        s_rf_flush = 1; s_present_this_frame = 0; s_rf_reason = "zpass-report";
+        render_frame();
+        s_rf_flush = 0; s_present_this_frame = 1; s_rf_reason = why;
+        s_d3d.merge_prev_draw = 0;
+    }
+    if (rsx_zpass_resolved()) { wait_for_gpu(); rsx_zpass_collect(); rsx_rgpu_collected(); }
+    return 1;
+}
+static void d3d12_report_seg_break(void* ud) { (void)ud; s_d3d.merge_prev_draw = 0; }
+
+/* Save states (runtime/savestate, M4b): a SAVE's capture, with every guest
+ * thread parked and the walker drained to get == put, wants every result the
+ * guest can observe in guest memory: the reports still pending are
+ * delivered (their draws executed and counted, d3d12_report_measure), the
+ * batch recorded so far is executed WITHOUT a present -- the mid-frame flush
+ * an RT readback already does many times a frame -- and the GPU is waited
+ * for, so no copy or report write lands after the capture. Same thread as
+ * the walker (the frame clock). Returns 1 if it did, 0 with no device or
+ * from inside a flush, -1 if the fence is still behind after wait_for_gpu
+ * gave up (3 x 2 s, a hung GPU): work could land in guest memory after the
+ * capture, so the coordinator refuses that stop (SS_REASON_GPU). */
+static void gp_prepare(void);   /* GPUP (after rsx_d3d12_backend_ss_reset) */
+int rsx_d3d12_backend_ss_quiesce(void)
+{
+    if (!s_d3d.initialized || s_rf_flush) return 0;
+    rt_drain();   /* R1 */
+    if (rsx_report_pending()) rsx_report_sync("savestate");
+    if (s_d3d.draw_count > 0) {
+        const char* why = s_rf_reason;
+        s_rf_flush = 1; s_present_this_frame = 0; s_rf_reason = "savestate";
+        render_frame();
+        s_rf_flush = 0; s_present_this_frame = 1; s_rf_reason = why;
+        s_d3d.merge_prev_draw = 0;
+    }
+    wait_for_gpu();
+    if (s_d3d.fence->lpVtbl->GetCompletedValue(s_d3d.fence) < s_d3d.fence_values[s_d3d.frame_index]) return -1;
+    gp_prepare();                                 /* GPUP: the capture's readback buffer */
+    gp_probe_arm(1);                              /* GPUP_PROBE: the frames after a save (a load re-arms) */
+    return 1;
+}
+/* rsx_report_backend.draw_reads (REPORT_PRECISE; d3d12_report_draw_reads, after
+ * PF6's report_fp_scan below): the units the draw can fetch. The prepass uploads the units its
+ * record's program samples (fp_texmask, once fp_shash is set: the null-view
+ * rule in the prepass unit loop), and vp_record_fp takes the program's mask
+ * from fp_scan_memo -- whose entry is read here exactly as its hit test reads
+ * it, and left untouched. Unknown (0) for a draw that may not take the VP
+ * route (d3d12_draw_arrays / _indexed -> vnew_draw), that can end with
+ * fp_shash == 0 (no b1 ring, a memo miss -- REPORT_GPU scans it --, BATCH_SPLIT=0, inside a flush,
+ * where the b1 headroom batch_capacity_check keeps is not guaranteed), and
+ * while a diagnostic rewrites units or their sources. The prepass checks the
+ * result (rpt_skip): a skipped unit that uploads turns the rule off. */
+/* PF6 REPORT_GPU: a program the scan memo does not hold (the memo is one
+ * entry a bucket: the sun glow's box and consumer programs evict each other)
+ * is scanned here as fp_scan_memo's miss path scans it -- the same function
+ * on the same bytes, so the mask the record will take -- into scratch, the
+ * memo and the counters left as they were. 0 (unknown) without REPORT_GPU,
+ * as before, or when the scan fails (the record then has no program mask:
+ * every unit). */
+static int report_fp_scan(const u8* p, u32* mask)
+{
+    if (!rsx_report_gpu_on()) return 0;
+    static u32 k[RSX_FP_MAX_INLINE_CONSTANTS + 3][4];
+    u32 size = 0, tm = 0; u64 sh = 0;
+    const unsigned long long nf0 = g_rsx_fp_nonfinite_constants;
+    const int n = rsx_fp_scan_program(p, VP_FP_SCAN_MAX, 0, k, RSX_FP_MAX_INLINE_CONSTANTS, &size, &sh, &tm);
+    g_rsx_fp_nonfinite_constants = nf0;
+    if (n < 0 || !sh) return 0;
+    *mask = tm;
+    return 1;
+}
+static int d3d12_report_draw_reads(void* ud, const struct rsx_state* st, u32* mask)
+{
+    (void)ud;
+    static int diag = -1;
+    if (diag < 0) {
+        const char* bs = getenv("BATCH_SPLIT");
+        diag = (bs && *bs == '0') || getenv("FP_OFF") || getenv("RTT_VIEWRT") ||
+               getenv("RSX_ACCUM_FRAME") || getenv("TEX_OFF_BIAS") || getenv("TEX_REMAP");
+    }
+    if (diag || !st || s_rf_flush || !s_d3d.initialized) return 0;
+    if (!vnew_on() || !s_d3d.pipeline_ready || !s_d3d.vb_mapped ||
+        !s_d3d.vp_vb_mapped || !s_d3d.vp_root_sig) return 0;
+    const u32 prim = st->primitive_type;
+    if (!(prim == RSX_PRIMITIVE_QUADS ||
+          ((prim == RSX_PRIMITIVE_TRIANGLES || prim == RSX_PRIMITIVE_TRIANGLE_STRIP ||
+            prim == RSX_PRIMITIVE_TRIANGLE_FAN) && st->vp_ucode_bytes >= 16))) return 0;
+    if (!s_d3d.vp_fpcb_mapped || !st->shader_program) return 0;
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    const u32 foff = cellGcmResolveLocated((st->shader_program & 0x3u) == 1, st->shader_program & ~0x3u);
+    if (!vm_base || foff == 0xFFFFFFFFu) return 0;
+    const u8* p = vm_base + foff;
+    const FPScanMemo* e = &s_fpsm[(foff * 2654435761u) >> 24];
+    if (!e->valid || e->foff != foff) return report_fp_scan(p, mask);
+    for (u32 o = 0, si = 0; o < e->size; ) {           /* fp_scan_memo's hit test */
+        const u32 end = si < (u32)e->n ? e->slot[si] : e->size;
+        if (end > o && memcmp(p + o, e->code + o, end - o)) return report_fp_scan(p, mask);
+        if (si < (u32)e->n) { o = end + 16u; si++; } else o = end;
+    }
+    *mask = e->texmask;
+    return 1;
+}
+/* rsx_report_backend.plan_ok (PF6 REPORT_GPU): this backend composes a 4xh
+ * Y16_X16 record texture on the GPU (rsx_d3d12_report.c) unless a diagnostic
+ * reorders, drops or rewrites records or their texture sources (the compose
+ * finds a report's queries as one run in replay order), the CPU path would not
+ * upload the format at all, or a texture pack / the dump could see a texture
+ * of that format byte (the packs veto UN textures -- the gate's records). */
+static int d3d12_report_plan_ok(void* ud, int unit, u32 ea, u32 fmt, u32 w, u32 h)
+{
+    (void)ud;
+    /* the texture the record will carry for this unit (bind_texture pushed it
+     * before SET_BEGIN_END reached the report logic): the plan's, exactly */
+    if (unit < 0 || unit >= RSX_DRAW_TEX_UNITS) return 0;
+    { const u32 c = (u32)unit;
+      if (!s_d3d.cur_texs[c].set || s_d3d.cur_texs[c].off != ea || s_d3d.cur_texs[c].fmt != fmt ||
+          s_d3d.cur_texs[c].w != w || s_d3d.cur_texs[c].h != h || s_d3d.cur_texs[c].cube ||
+          s_d3d.cur_texs[c].pitch != 16u) return 0; }
+    static int diag = -1;
+    if (diag < 0)
+        diag = getenv("RTT_PASS") || getenv("RTT_VIEWRT") || getenv("DRAW_LIMIT") || getenv("DRAW_SKIP_TEX") ||
+               getenv("DRAW_KEEP_TEX") || getenv("DRAW_LAST_TEX") || getenv("DRAW_ONLY_FP") || getenv("DRAW_SKIP_FP") ||
+               getenv("DRAW_SKIP_ID") || getenv("TEX_OFF_BIAS") || getenv("TEX_REMAP") || getenv("TEX_BUDGET") ||
+               getenv("TEX_PROBE") || getenv("TEX_RESOLVE_AUTO") || getenv("RSX_ACCUM_FRAME") || getenv("FP_OFF") ||
+               getenv("VB_SKIP_WNEG");
+    if (diag || !s_d3d.initialized || !s_d3d.device) return 0;
+    if (!tex_format_uploadable(fmt & 0x9Fu)) return 0;
+    if ((g_tp_on || s_tp.dump) && !tp_reg_veto(fmt, 0)) return 0;
+    if (!rsx_zpass_init(s_d3d.device, MAX_DRAWS)) return 0;
+    return rsx_rgpu_ready(s_d3d.device, fmt, w, h);
+}
+/* The plan id of planned unit u of a record. */
+static u32 rgpu_plan_id(const D3D12DrawRecord* dr, int u)
+{
+    return dr->rplan_first + (u32)__builtin_popcount(dr->rplan_mask & ((1u << u) - 1u));
+}
+/* Prepass: a planned unit samples the texture the replay composes its record
+ * texels into, through the view the CPU upload's texture would get
+ * (R16G16_UNORM, its one level, the crossbar's component mapping). */
+static int rgpu_bind(u32 wslot, D3D12DrawRecord* dr, int u, u32 bf)
+{
+    const u32 id = rgpu_plan_id(dr, u);
+    u32 ea = 0, fmt = 0;
+    ID3D12Resource* t = rsx_rgpu_texture(id, &ea, &fmt);
+    if (!t || ea != dr->tex[u].off || fmt != dr->tex[u].fmt || dr->tex[u].w != 4u || dr->tex[u].cube) {
+        static int n = 0; if (n++ < 8)
+            fprintf(stderr, "[REPORT-GPU] plan %u (unit %d): texture 0x%08X fmt 0x%02X %ux%u, the plan's 0x%08X"
+                            " fmt 0x%02X%s%c", id, u, dr->tex[u].off, dr->tex[u].fmt, dr->tex[u].w, dr->tex[u].h,
+                    ea, fmt, t ? "" : " (not live or its rows not known)", 10);
+        rsx_report_plan_violation("a planned unit's texture is not its plan's");
+        /* Fallback: the CPU upload below reads guest memory. The reports whose
+         * draws are all collected (no draw of this batch counts into them) are
+         * written first -- a measurement here would flush recursively -- so the
+         * memory is the exact path's unless a report over the texture still has
+         * a draw in this very batch: then nothing exact is possible (counted). */
+        u32 lim = 0xFFFFFFFFu;
+        for (u32 d = 0; d < s_d3d.draw_count && d < MAX_DRAWS; d++)
+            if (s_d3d.draws[d].is_vp && !s_d3d.draws[d].is_clear && s_d3d.draws[d].zp_seg &&
+                s_d3d.draws[d].zp_seg < lim) lim = s_d3d.draws[d].zp_seg;
+        rsx_report_deliver_complete(lim, "plan fallback");
+        if (rsx_report_pending_overlap(dr->tex[u].off, 16u * (dr->tex[u].h ? dr->tex[u].h : 1u))) {
+            static int m = 0; if (m++ < 8)
+                fprintf(stderr, "[REPORT-GPU] BUG: plan %u (unit %d): a report over texture 0x%08X still waits for a"
+                                " draw of this batch -- this draw reads it before its delivery%c", id, u,
+                        dr->tex[u].off, 10);
+        }
+        return 0;
+    }
+    srv_write_ex(wslot, t, DXGI_FORMAT_R16G16_UNORM, rsx_remap_to_d3d(dr->tex[u].ctrl1, bf), 0);
+    dr->rplan_used |= 1u << u;
+    return 1;
+}
+/* Replay, before the draw (after any ztex pass; the draw sets its pipeline
+ * right after): compose each bound plan unless this list did already. */
+static void rgpu_compose_record(const D3D12DrawRecord* dr)
+{
+    for (u32 m = dr->rplan_used; m; m &= m - 1u)
+        if (rsx_rgpu_compose(s_d3d.cmd_list, rgpu_plan_id(dr, (int)__builtin_ctz(m))) < 0)
+            rsx_report_plan_violation("a planned unit's texels could not be composed");
+}
+static void zp_register(void)
+{
+    rsx_report_backend be;
+    memset(&be, 0, sizeof be);
+    be.measure = d3d12_report_measure;
+    be.seg_break = d3d12_report_seg_break;
+    be.draw_reads = d3d12_report_draw_reads;
+    be.plan_ok = d3d12_report_plan_ok;
+    be.ud = NULL;
+    rsx_report_set_backend(&be);
+}
+
+/* ---- A draw that samples its own colour target (RT_SELFSAMPLE) --------------
+ * The unit used to get an SRV on the live render target (no transition): a
+ * D3D12 read/write hazard with undefined results -- RPCS3's non-strict mode,
+ * the floor flicker of its #18628. Now the unit samples a copy of the target
+ * (rsx_selfsample_need_copy): by default one taken right before the draw --
+ * memory as the draw starts, as for every other texture here; RT_SELFSAMPLE=1
+ * keeps one copy per texture-cache epoch (INVALIDATE_TEXTURE_CACHE 0x1FD8:
+ * 0x3327EC and libgcm's 0x503894 in the EBOOT) and frame, the opt-in cache
+ * hypothesis; 0 = the old live view. The copy's SRV is the pre-pass RT bind's
+ * view (default mapping): keep the two in step. Depth read as colour already
+ * goes through a copy (ztex_convert). [SELFSAMPLE] lines count the copies per
+ * frame (the cost: one full-target copy each). */
+typedef struct {
+    ID3D12Resource* res; ID3D12Resource* src;
+    u64 frame;                               /* s_d3d.frame_count of the copy */
+    u32 w, h, dxgi, epoch; int valid;
+    D3D12_RESOURCE_STATES st;
+    u32 dop, dbatch;                         /* RES_SCALE: the op (+1) and batch it was copied for */
+    rsx_ss_copy ss;                          /* PF2: its standing in the replay loop (rsx_report.h);
+                                              * ss.wfirst indexes s_ssw */
+    u32 nwr;                                 /* census: draws that wrote the plane since the copy */
+    D3D12_RECT drc;                          /* census: the union of their scissor rects */
+    int rtv;                                 /* PF2: the copy is a render target (its RTV: ssc_rtv) */
+    u32 cop;                                 /* census: the op (+1) whose coverage update made it current */
+} RtSnap;
+static RtSnap s_rtsnap[MAX_OFF_RTS];
+static u64 s_rtsnap_fr = ~0ull;              /* frame the copy count below is for */
+static u32 s_rtsnap_nc;                      /* target copies in that frame */
+
+/* ---- Reusing a self-sample copy (PF2: RT_SELFSAMPLE_REUSE, default 2) --------
+ * Mode 2 copies the plane for every unit of every draw that samples it while
+ * it is bound. The copy taken earlier in the same replay (one render_frame op
+ * loop, s_rtsnap_loop) still holds exactly what the plane holds when nothing
+ * has written the plane since. The loop records into one command list in op
+ * order, so every write to the plane between the two draws is recorded by the
+ * loop between them, and the loop reports each kind:
+ *  - a draw writes the bound targets whose write-mask nibble is non-zero (its
+ *    PSO's RenderTargetWriteMask: rsx_rop_fill_blend from the record's cmask),
+ *    and every bound target when it runs without the guest's pipeline, when
+ *    an MRT plane follows a gap, or under CMASK_FORCE (rtsnap_wrote, after the
+ *    draw);
+ *  - a clear and a display snapshot (a copy into a surface) write planes
+ *    outside the draws; they, and conservatively a target rebind, the screen-
+ *    copy capture and the post-fx scene hook (which only read), end every
+ *    reuse of every copy taken before them, clean or written
+ *    (rtsnap_dirty_all, rsx_ss_barrier).
+ * A unit whose plane is clean samples the earlier copy: the bytes a new copy
+ * would hold (the same-op case, two units on one plane, is RES_SCALE's rs_dup
+ * at every scale). A copy the draws since have written is brought up to date
+ * over their coverage instead (ssc_update, below). Mode 2 only: mode 1 keeps
+ * its per-epoch rule.
+ * RT_SELFSAMPLE_REUSE (rsx_selfsample_reuse_level): 2 (default) both, 1 clean
+ * reuse only, 0 a copy for every unit, as before (kill switch).
+ * RT_SELFSAMPLE_VERIFY=1: every reuse also copies the reused copy and the live
+ * plane into two buffers and compares them on the GPU ([SSVERIFY]).
+ * RT_SELFSAMPLE_CENSUS=1: copies and bytes per case, any level ([SSREUSE]). */
+static u32 s_rtsnap_loop;                    /* replay loops (render_frame op loops) begun */
+static u32 s_rtsnap_live;                    /* the loop that last took a copy: before its first one,
+                                              * nothing a loop does concerns a copy (fast path) */
+static int rtsnap_reuse_on(void)             /* the level: 0, 1, 2 */
+{
+    static int m = -1;
+    if (m < 0) { m = rsx_selfsample_reuse_level();
+        fprintf(stderr, "[SELFSAMPLE] copy reuse level %d: %s%c", m,
+                m >= 2 ? "clean copies reused, written ones brought up to date over their writers' coverage" :
+                m ? "clean copies reused" : "a copy for every unit", 10); }
+    return m;
+}
+static int rtsnap_census_on(void)
+{
+    static int c = -1;
+    if (c < 0) { const char* e = getenv("RT_SELFSAMPLE_CENSUS"); c = (e && *e == '1') ? 1 : 0; }
+    return c;
+}
+static int rtsnap_verify_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RT_SELFSAMPLE_VERIFY"); v = (e && *e == '1') ? 1 : 0; }
+    return v;
+}
+/* Something other than a draw may have written any surface: no copy taken
+ * before it is reused after it. */
+static void rtsnap_dirty_all(void)
+{
+    if (s_rtsnap_live != s_rtsnap_loop) return;
+    for (int i = 0; i < MAX_OFF_RTS; i++)    /* written copies too: their writers' coverage misses it */
+        rsx_ss_barrier(&s_rtsnap[i].ss, s_rtsnap_loop);
+}
+static D3D12_RECT s_rtsnap_sc;               /* the scissor of the op being replayed */
+static D3D12_VIEWPORT s_rtsnap_vp;           /* ... and its viewport */
+/* The writers (ssc_update): every draw of this loop that wrote a plane whose
+ * copy was taken in this loop, with what draws its geometry again. */
+#define SSC_LOOPW 1024                       /* writer records per replay loop */
+typedef struct { u32 d; u64 planes; D3D12_VIEWPORT vp; D3D12_RECT sc; } SscW;
+static SscW s_ssw[SSC_LOOPW];
+static u32 s_ssw_n, s_ssw_loop;              /* records of loop s_ssw_loop */
+static u32 ssw_now(void) { return s_ssw_loop == s_rtsnap_loop ? s_ssw_n : 0u; }
+/* The vertex shader of a record's guest pipeline (vp_get_fp_pso_impl's rule:
+ * the recorded slot, re-resolved by its ucode hash, else the primary). */
+/* R1: the lookup runs in the prepass (the walker owns the VS cache); the replay reads the record's ssc_vsb. */
+static ID3DBlob* ssc_vs_lookup(const D3D12DrawRecord* dr)
+{
+    int vs_idx = dr->vs_idx;
+    if (vs_idx >= 0 && dr->vs_hash_rec &&
+        (vs_idx >= s_d3d.vp_vs_n || s_d3d.vp_vs[vs_idx].hash != dr->vs_hash_rec)) {
+        vs_idx = -1;
+        for (int i = 0; i < s_d3d.vp_vs_n; i++)
+            if (s_d3d.vp_vs[i].hash == dr->vs_hash_rec) { vs_idx = i; break; }
+        if (vs_idx < 0) return NULL;
+    }
+    ID3DBlob* vsb = (vs_idx >= 0 && vs_idx < s_d3d.vp_vs_n) ? s_d3d.vp_vs[vs_idx].vs : NULL;
+    return vsb ? vsb : s_d3d.vp_vs_blob;
+}
+/* (RENDER_THREAD=0: looked up at the replay, as before) */
+static ID3DBlob* ssc_vs(const D3D12DrawRecord* dr) { return rt_on() ? dr->ssc_vsb : ssc_vs_lookup(dr); }
+/* After a draw (its negative pass included): the planes it wrote
+ * (rsx_selfsample_writes: target A is RTV 0, MRT plane m RTV m + 1; a plane
+ * after a gap is counted), and, for planes with a copy of this loop, the
+ * writer record -- or wbad when its geometry cannot be drawn again (no guest
+ * pipeline, its vertex shader gone, user clip planes, the records full). */
+static void rtsnap_wrote(u32 d, const D3D12DrawRecord* dr, int cur_rt, const int* cur_m, int guest_pso)
+{
+    if (s_rtsnap_live != s_rtsnap_loop) return;   /* no copy of this loop yet */
+    static int cf = -1;
+    if (cf < 0) cf = getenv("CMASK_FORCE") ? 1 : 0;
+    const u32 bound = (cur_rt >= 0 ? 1u : 0u) | (cur_m[0] >= 0 ? 2u : 0u) |
+                      (cur_m[1] >= 0 ? 4u : 0u) | (cur_m[2] >= 0 ? 8u : 0u);
+    const u32 wm = rsx_selfsample_writes(bound, dr->cmask, cf || !guest_pso);
+    SscW* w = NULL;
+    int wok = -1;
+    for (int t = 0; t < 4; t++) {
+        const int s = t ? cur_m[t - 1] : cur_rt;
+        if (!((wm >> t) & 1u) || s < 0 || s >= MAX_OFF_RTS) continue;
+        RtSnap* sn = &s_rtsnap[s];
+        if (sn->nwr++ == 0) sn->drc = s_rtsnap_sc;
+        else {
+            if (s_rtsnap_sc.left < sn->drc.left) sn->drc.left = s_rtsnap_sc.left;
+            if (s_rtsnap_sc.top < sn->drc.top) sn->drc.top = s_rtsnap_sc.top;
+            if (s_rtsnap_sc.right > sn->drc.right) sn->drc.right = s_rtsnap_sc.right;
+            if (s_rtsnap_sc.bottom > sn->drc.bottom) sn->drc.bottom = s_rtsnap_sc.bottom;
+        }
+        if (!sn->valid || !rsx_ss_takes_writer(&sn->ss, s_rtsnap_loop)) { rsx_ss_written(&sn->ss, 1); continue; }
+        if (wok < 0) {
+            if (s_ssw_loop != s_rtsnap_loop) { s_ssw_loop = s_rtsnap_loop; s_ssw_n = 0; }
+            /* user clip planes: its clip distances are not redrawn conservatively (review L1) */
+            wok = guest_pso && !dr->uclip && s_ssw_n < SSC_LOOPW && ssc_vs(dr) != NULL;
+        }
+        rsx_ss_written(&sn->ss, wok);
+        if (!wok) continue;
+        if (!w) {
+            w = &s_ssw[s_ssw_n++];
+            w->d = d; w->planes = 0; w->vp = s_rtsnap_vp; w->sc = s_rtsnap_sc;
+        }
+        w->planes |= 1ull << s;
+    }
+}
+/* [SSREUSE] census: every unit that samples a bound plane, by what a copy for
+ * it would follow; summed per frame, printed as per-frame means every 120. */
+static struct {
+    u64 fr; u32 frames;
+    double units, reuse_op, reuse_x, cover, first, bar, wr1, wr4, wrn, unk, wcov;
+    double mb_saved, mb_cover, mb_copied, mb_first, mb_bar, mb_wr, rect;   /* rect: plane fraction under the writers' scissors */
+    double cov_draws, cov_verts;             /* ssc_update: writers' geometry drawn again */
+    double cov_multi;                        /* ... plane updates over 2+ writers */
+} s_ssc;
+static void rtsnap_census(const RtSnap* sn, const OffRT* r, u32 d, const D3D12DrawRecord* dr, int clean, int rs_dup)
+{
+    if (s_ssc.fr != s_rpc.frame_count) {
+        if (s_ssc.frames && (s_ssc.frames % 120u) == 0) {
+            const double f = (double)s_ssc.frames;
+            fprintf(stderr, "[SSREUSE] %u frames, per frame: %.1f units sample a bound plane; clean copy reused "
+                    "%.1f (same op %.1f, a copy of an earlier op %.1f) = %.1f MB; copy brought up to date over "
+                    "its writers' coverage %.1f (%.1f MB not copied; %.1f writer draws again, %.0f vertices; "
+                    "%.1f plane updates over 2+ writers); "
+                    "copies %.1f = %.1f MB: first in the replay %.1f (%.1f MB), after a clear / copy / rebind "
+                    "%.1f (%.1f MB), after the plane was written by 1 / 2-4 / 5+ draws %.1f / %.1f / %.1f "
+                    "(%.1f MB, the writers' scissors cover %.1f%% of it; %.1f of them coverable); units of a "
+                    "program with no read mask %.1f; reuse level %d%c",
+                    s_ssc.frames, s_ssc.units / f, (s_ssc.reuse_op + s_ssc.reuse_x) / f, s_ssc.reuse_op / f,
+                    s_ssc.reuse_x / f, s_ssc.mb_saved / f, s_ssc.cover / f, s_ssc.mb_cover / f,
+                    s_ssc.cov_draws / f, s_ssc.cov_verts / f, s_ssc.cov_multi / f,
+                    (s_ssc.first + s_ssc.bar + s_ssc.wr1 + s_ssc.wr4 + s_ssc.wrn) / f, s_ssc.mb_copied / f,
+                    s_ssc.first / f, s_ssc.mb_first / f, s_ssc.bar / f, s_ssc.mb_bar / f,
+                    s_ssc.wr1 / f, s_ssc.wr4 / f, s_ssc.wrn / f, s_ssc.mb_wr / f,
+                    (s_ssc.wr1 + s_ssc.wr4 + s_ssc.wrn) > 0 ? 100.0 * s_ssc.rect / (s_ssc.wr1 + s_ssc.wr4 + s_ssc.wrn) : 0.0,
+                    s_ssc.wcov / f, s_ssc.unk / f, rtsnap_reuse_on(), 10);
+            const u64 keep = s_rpc.frame_count;
+            memset(&s_ssc, 0, sizeof s_ssc);
+            s_ssc.fr = keep;
+        }
+        s_ssc.fr = s_rpc.frame_count; s_ssc.frames++;
+    }
+    const double mb = (double)r->hw * r->hh * rs_bpp(r->dxgi) / 1048576.0;
+    s_ssc.units += 1.0;
+    if (!dr->fp_shash) s_ssc.unk += 1.0;
+    if (clean || rs_dup) {
+        if (sn->cop == d + 1u) { s_ssc.cover += 1.0; s_ssc.mb_cover += mb; return; }
+        if (sn->dop == d + 1u) s_ssc.reuse_op += 1.0; else s_ssc.reuse_x += 1.0;
+        s_ssc.mb_saved += mb;
+        return;
+    }
+    s_ssc.mb_copied += mb;
+    if (!sn->valid || sn->ss.loop != s_rtsnap_loop) { s_ssc.first += 1.0; s_ssc.mb_first += mb; return; }
+    if (sn->ss.bar) { s_ssc.bar += 1.0; s_ssc.mb_bar += mb; return; }
+    if (sn->nwr <= 1u) s_ssc.wr1 += 1.0; else if (sn->nwr <= 4u) s_ssc.wr4 += 1.0; else s_ssc.wrn += 1.0;
+    s_ssc.mb_wr += mb;
+    if (!sn->ss.wbad && (r->dxgi == DXGI_FORMAT_R8G8B8A8_UNORM || r->dxgi == DXGI_FORMAT_B8G8R8A8_UNORM)) {
+        u32 k = 0;                            /* what ssc_update would take (its pipelines aside) */
+        for (u32 i = sn->ss.wfirst; i < ssw_now(); i++) k += (u32)((s_ssw[i].planes >> (r - s_d3d.off_rt)) & 1u);
+        if (k && k <= 8u) s_ssc.wcov += 1.0;
+    }
+    const double a = (double)(sn->drc.right > sn->drc.left ? sn->drc.right - sn->drc.left : 0) *
+                     (double)(sn->drc.bottom > sn->drc.top ? sn->drc.bottom - sn->drc.top : 0);
+    s_ssc.rect += r->hw && r->hh ? a / ((double)r->hw * r->hh) : 1.0;
+}
+
+/* RT_SELFSAMPLE_VERIFY=1: at every reuse, the reused copy and a new copy of
+ * the plane (what mode 2 would sample) land in two buffers, and a compute
+ * pass counts their differing 32-bit words into a UAV that the list copies
+ * out; after the list executes the count is read back (a GPU wait per list:
+ * diagnostic). The draw still samples the reused copy. */
+static ID3D12RootSignature* s_ssv_rs;
+static ID3D12PipelineState* s_ssv_pso;
+static ID3D12Resource* s_ssv_buf[2];         /* the reused copy, a new copy of the plane */
+static D3D12_RESOURCE_STATES s_ssv_bst[2];
+static u64 s_ssv_cap;                        /* bytes each */
+static ID3D12Resource* s_ssv_res;            /* u32: [0] differing words, [1] the last compare with any */
+static ID3D12Resource* s_ssv_rb;             /* its readback */
+static int s_ssv_pend, s_ssv_rbpend;         /* a result copy recorded / to read after the list */
+static int s_ssv_pso_dirty;                  /* a compare replaced the replay's pipeline state */
+static u32 s_ssv_n, s_ssv_skip, s_ssv_rep_n, s_ssv_rep_bad = ~0u;
+static double s_ssv_mb;
+static int ssv_pipeline(void)
+{
+    static int state = 0;
+    if (state) return state;
+    state = -1;
+    static const char cs[] =
+        "ByteAddressBuffer a : register(t0);\n"
+        "ByteAddressBuffer b : register(t1);\n"
+        "RWByteAddressBuffer r : register(u0);\n"
+        "cbuffer k : register(b0) { uint n; uint rowq; uint pitchq; uint ev; };\n"
+        "[numthreads(256, 1, 1)]\n"
+        "void main(uint3 id : SV_DispatchThreadID) {\n"
+        "    if (id.x >= n || id.x % pitchq >= rowq) return;\n"
+        "    uint4 x = a.Load4(id.x * 16u), y = b.Load4(id.x * 16u);\n"
+        "    uint m = (x.x != y.x ? 1u : 0u) + (x.y != y.y ? 1u : 0u) + (x.z != y.z ? 1u : 0u) + (x.w != y.w ? 1u : 0u);\n"
+        "    if (m) { r.InterlockedAdd(0, m); r.InterlockedMax(4, ev); }\n"
+        "}\n";
+    ID3DBlob* cb = NULL; ID3DBlob* e = NULL;
+    HRESULT hr = D3DCompile(cs, sizeof(cs) - 1, "ssv_cs", NULL, NULL, "main", "cs_5_0", 0, 0, &cb, &e);
+    if (FAILED(hr) || !cb) {
+        fprintf(stderr, "[SSVERIFY] compute shader failed: %s%c",
+                e ? (const char*)e->lpVtbl->GetBufferPointer(e) : "?", 10);
+        if (e) e->lpVtbl->Release(e);
+        return state;
+    }
+    D3D12_ROOT_PARAMETER rp[4];
+    memset(rp, 0, sizeof rp);
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; rp[0].Descriptor.ShaderRegister = 0;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; rp[1].Descriptor.ShaderRegister = 1;
+    rp[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV; rp[2].Descriptor.ShaderRegister = 0;
+    rp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[3].Constants.ShaderRegister = 0; rp[3].Constants.Num32BitValues = 4;
+    for (int i = 0; i < 4; i++) rp[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_ROOT_SIGNATURE_DESC rsd = {0};
+    rsd.NumParameters = 4; rsd.pParameters = rp;
+    ID3DBlob* sig = NULL; ID3DBlob* err = NULL;
+    hr = D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+    if (FAILED(hr) || !sig) {
+        fprintf(stderr, "[SSVERIFY] root signature failed%c", 10);
+        if (err) err->lpVtbl->Release(err);
+        cb->lpVtbl->Release(cb);
+        return state;
+    }
+    hr = s_d3d.device->lpVtbl->CreateRootSignature(s_d3d.device, 0,
+            sig->lpVtbl->GetBufferPointer(sig), sig->lpVtbl->GetBufferSize(sig),
+            &IID_ID3D12RootSignature, (void**)&s_ssv_rs);
+    sig->lpVtbl->Release(sig);
+    if (FAILED(hr) || !s_ssv_rs) { cb->lpVtbl->Release(cb); return state; }
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pd = {0};
+    pd.pRootSignature = s_ssv_rs;
+    pd.CS.pShaderBytecode = cb->lpVtbl->GetBufferPointer(cb);
+    pd.CS.BytecodeLength = cb->lpVtbl->GetBufferSize(cb);
+    hr = s_d3d.device->lpVtbl->CreateComputePipelineState(s_d3d.device, &pd,
+            &IID_ID3D12PipelineState, (void**)&s_ssv_pso);
+    cb->lpVtbl->Release(cb);
+    if (FAILED(hr) || !s_ssv_pso) { fprintf(stderr, "[SSVERIFY] compute PSO failed%c", 10); return state; }
+    state = 1;
+    return state;
+}
+static ID3D12Resource* ssv_buffer(u64 bytes, D3D12_HEAP_TYPE ht, D3D12_RESOURCE_FLAGS fl, D3D12_RESOURCE_STATES st)
+{
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = ht;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; rd.Width = bytes; rd.Height = 1;
+    rd.DepthOrArraySize = 1; rd.MipLevels = 1; rd.Format = DXGI_FORMAT_UNKNOWN;
+    rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; rd.Flags = fl;
+    ID3D12Resource* r = NULL;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &rd, st,
+                                                             NULL, &IID_ID3D12Resource, (void**)&r))) return NULL;
+    return r;
+}
+static void ssv_bar(ID3D12Resource* r, D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to)
+{
+    if (from == to) return;
+    D3D12_RESOURCE_BARRIER b;
+    memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = r;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = from; b.Transition.StateAfter = to;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+}
+static void ssv_compare(const RtSnap* sn, const OffRT* r)
+{
+    if (ssv_pipeline() <= 0) { s_ssv_skip++; return; }
+    const u64 bpp = rs_bpp(r->dxgi);
+    const u64 rowb = (u64)r->hw * bpp, pitch = (rowb + 255u) & ~(u64)255u, bytes = pitch * r->hh;
+    if (!bpp || (rowb % 16u) || bytes / 16u / 256u > 65535u) { s_ssv_skip++; return; }
+    if (!s_ssv_res) {
+        s_ssv_res = ssv_buffer(256, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS);   /* committed: zeroed */
+        s_ssv_rb = ssv_buffer(256, D3D12_HEAP_TYPE_READBACK, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST);
+        if (!s_ssv_res || !s_ssv_rb) { s_ssv_skip++; return; }
+    }
+    if (bytes > s_ssv_cap) {
+        for (int i = 0; i < 2; i++) {
+            if (s_ssv_buf[i]) res_grave_put(s_ssv_buf[i]);   /* earlier compares of this list may use it */
+            s_ssv_buf[i] = ssv_buffer(bytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_NONE,
+                                      D3D12_RESOURCE_STATE_COPY_DEST);
+            s_ssv_bst[i] = D3D12_RESOURCE_STATE_COPY_DEST;
+        }
+        s_ssv_cap = (s_ssv_buf[0] && s_ssv_buf[1]) ? bytes : 0;
+        if (!s_ssv_cap) { s_ssv_skip++; return; }
+    }
+    ID3D12GraphicsCommandList* cl = s_d3d.cmd_list;
+    for (int i = 0; i < 2; i++) { ssv_bar(s_ssv_buf[i], s_ssv_bst[i], D3D12_RESOURCE_STATE_COPY_DEST);
+                                  s_ssv_bst[i] = D3D12_RESOURCE_STATE_COPY_DEST; }
+    ssv_bar(sn->res, sn->st, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    ssv_bar(r->res, r->st, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    D3D12_TEXTURE_COPY_LOCATION dst, src;
+    memset(&dst, 0, sizeof dst); memset(&src, 0, sizeof src);
+    dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = (DXGI_FORMAT)r->dxgi;
+    dst.PlacedFootprint.Footprint.Width = r->hw; dst.PlacedFootprint.Footprint.Height = r->hh;
+    dst.PlacedFootprint.Footprint.Depth = 1; dst.PlacedFootprint.Footprint.RowPitch = (UINT)pitch;
+    src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.pResource = s_ssv_buf[0]; src.pResource = sn->res;
+    cl->lpVtbl->CopyTextureRegion(cl, &dst, 0, 0, 0, &src, NULL);
+    dst.pResource = s_ssv_buf[1]; src.pResource = r->res;
+    cl->lpVtbl->CopyTextureRegion(cl, &dst, 0, 0, 0, &src, NULL);
+    ssv_bar(sn->res, D3D12_RESOURCE_STATE_COPY_SOURCE, sn->st);
+    ssv_bar(r->res, D3D12_RESOURCE_STATE_COPY_SOURCE, r->st);
+    for (int i = 0; i < 2; i++) { ssv_bar(s_ssv_buf[i], D3D12_RESOURCE_STATE_COPY_DEST,
+                                          D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+                                  s_ssv_bst[i] = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE; }
+    cl->lpVtbl->SetComputeRootSignature(cl, s_ssv_rs);
+    cl->lpVtbl->SetPipelineState(cl, s_ssv_pso);
+    cl->lpVtbl->SetComputeRootShaderResourceView(cl, 0, s_ssv_buf[0]->lpVtbl->GetGPUVirtualAddress(s_ssv_buf[0]));
+    cl->lpVtbl->SetComputeRootShaderResourceView(cl, 1, s_ssv_buf[1]->lpVtbl->GetGPUVirtualAddress(s_ssv_buf[1]));
+    cl->lpVtbl->SetComputeRootUnorderedAccessView(cl, 2, s_ssv_res->lpVtbl->GetGPUVirtualAddress(s_ssv_res));
+    const u32 k[4] = { (u32)(bytes / 16u), (u32)(rowb / 16u), (u32)(pitch / 16u), ++s_ssv_n };
+    cl->lpVtbl->SetComputeRoot32BitConstants(cl, 3, 4, k, 0);
+    cl->lpVtbl->Dispatch(cl, (k[0] + 255u) / 256u, 1, 1);
+    D3D12_RESOURCE_BARRIER ub;
+    memset(&ub, 0, sizeof ub);
+    ub.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV; ub.UAV.pResource = s_ssv_res;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &ub);
+    s_ssv_pend = 1; s_ssv_pso_dirty = 1;
+    s_ssv_mb += (double)rowb * r->hh / 1048576.0;
+}
+/* Before the list closes: the counts out to the readback buffer. */
+static void ssv_list_end(void)
+{
+    if (!s_ssv_pend || !s_ssv_res || !s_ssv_rb) return;
+    ssv_bar(s_ssv_res, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    s_d3d.cmd_list->lpVtbl->CopyBufferRegion(s_d3d.cmd_list, s_ssv_rb, 0, s_ssv_res, 0, 16);
+    ssv_bar(s_ssv_res, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    s_ssv_pend = 0; s_ssv_rbpend = 1;
+}
+/* After the list is submitted: wait for it, read the counts (cumulative). */
+static void ssv_list_done(void)
+{
+    if (!s_ssv_rbpend) return;
+    s_ssv_rbpend = 0;
+    wait_for_gpu();
+    u32* p = NULL;
+    D3D12_RANGE rr = {0, 16};
+    if (FAILED(s_ssv_rb->lpVtbl->Map(s_ssv_rb, 0, &rr, (void**)&p)) || !p) return;
+    const u32 bad = p[0], last = p[1];
+    D3D12_RANGE wr = {0, 0};
+    s_ssv_rb->lpVtbl->Unmap(s_ssv_rb, 0, &wr);
+    if (bad != s_ssv_rep_bad || s_ssv_n - s_ssv_rep_n >= 1000u) {
+        fprintf(stderr, "[SSVERIFY] %u reuses compared with a new copy of the plane (%.0f MB a side), %u not "
+                "comparable: %u differing 32-bit words%s%c", s_ssv_n, s_ssv_mb, s_ssv_skip, bad,
+                bad ? " -- NOT EXACT (the last at compare " : "", 10);
+        if (bad) fprintf(stderr, "[SSVERIFY]   last differing compare: #%u%c", last, 10);
+        s_ssv_rep_n = s_ssv_n; s_ssv_rep_bad = bad;
+    }
+}
+
+/* ---- Bringing a written copy up to date over its writers' coverage --------
+ * (RT_SELFSAMPLE_REUSE=2, the default.) In the G-buffer's decal pass every
+ * draw that samples a plane while it is bound also writes that plane, so the
+ * next one's copy is never clean. But a draw writes a plane only inside its
+ * own rasterised coverage, so the copy differs from the plane only inside the
+ * coverage of the draws that wrote the plane since the copy (its writers,
+ * s_ssw). Before a draw that samples such planes (ssc_update), each writer's
+ * geometry is drawn again -- the vertex shader of its guest pipeline, its
+ * constants, vertices, viewport and scissor -- with no culling, no depth
+ * clip, no depth or stencil test and conservative rasterisation (every pixel
+ * the triangles touch: a superset of the writer's own coverage, which also
+ * absorbs any rounding difference between two pipelines built on the same
+ * vertex shader), and a pixel shader that loads the plane at its own pixel
+ * and writes it into the copy. Outside the writers' coverage the copy already
+ * held the plane's texels; inside, it gets them now: the copy equals the
+ * plane, as a new full copy would, and the draw samples it (the clean-reuse
+ * path). UNORM8 planes only (a UNORM8 load to float and store back is the
+ * identity), at most SSC_MAXW writers; a writer without the guest's pipeline
+ * or with user clip planes (wbad), a clear / copy / rebind (bar), any other
+ * format, a pipeline that cannot be built or no conservative rasterisation:
+ * the full copy as before. The pipelines: SSC_PSOS, the least recently used
+ * replaced when full (not one used this frame).
+ * RT_SELFSAMPLE_VERIFY=1 compares every such copy with a full one. */
+#define SSC_MAXW 8                           /* writers one update draws again */
+#define SSC_PSOS 64                          /* coverage-copy pipelines (VS x layout x format) */
+typedef struct { ID3DBlob* vs; u32 vmask, fmt; ID3D12PipelineState* pso; u64 used; } SscPso;
+static SscPso s_sscp[SSC_PSOS];              /* each holds a reference on its VS blob: the key stays unique */
+static int s_sscp_n;
+static ID3DBlob* s_ssc_ps;                   /* the copy pixel shader */
+static ID3D12DescriptorHeap* s_ssc_rtv;      /* the copies' RTVs (MAX_OFF_RTS, CPU only) */
+static int ssc_fmt_ok(u32 dxgi)
+{
+    return dxgi == DXGI_FORMAT_R8G8B8A8_UNORM || dxgi == DXGI_FORMAT_B8G8R8A8_UNORM;
+}
+static int ssc_on(void)
+{
