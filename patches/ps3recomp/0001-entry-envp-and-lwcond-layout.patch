+
+extern "C" {
+/* ---- what the units link against, kept small ---- */
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int edat_is_npd(const char* p)
+{
+    FILE* f = fopen(p, "rb");
+    if (!f) return 0;
+    char m[4] = { 0 };
+    const size_t n = fread(m, 1, 4, f);
+    fclose(f);
+    return n == 4 && !memcmp(m, "NPD\0", 4);
+}
+/* edat.c's choice without its decryptor: the cache when it is valid */
+const char* edat_resolve(const char* host, char* buf, size_t cap)
+{
+    if (!edat_is_npd(host) || (size_t)snprintf(buf, cap, "%s.dec", host) >= cap) return host;
+    struct _stat64 ss, ds;
+    return (_stat64(host, &ss) == 0 && _stat64(buf, &ds) == 0 && ds.st_mtime >= ss.st_mtime) ? buf : host;
+}
+int edat_license_check(const char*, const uint8_t*, char*, size_t) { return 1; }
+static ss_check_fn s_checks[8];
