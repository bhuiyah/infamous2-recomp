+/* PS3_SAVEDATA_PICK moves the named save to the head of every list, which is
+ * what a title that auto-loads dirList[0] then loads. */
+static u32 savedata_scan(const char* prefix, u32 sortType, u32 sortOrder, savedata_dirs* out)
+{
+    memset(out, 0, sizeof *out);
+    const char* root = save_root();
+    ensure_dirs(root);
+    savedata_names s;
+    if (list_dir(root, &s) < 0) return 0;
+    for (u32 i = 0; i < s.n; i++) {
+        size_t len = strlen(s.v[i]);
+        if (s.dir[i] && s.v[i][0] == '.' && len > 5 && !strcmp(s.v[i] + len - 4, ".old")) {
+            char name[64];
+            snprintf(name, sizeof name, "%.*s", (int)(len - 5), s.v[i] + 1);
+            savedata_recover(name);
+            if (names_add(&s, name, 1)) break;
+        }
+    }
+    out->e = (savedata_dir_entry*)calloc(s.n ? s.n : 1, sizeof *out->e);
+    if (!out->e) { names_free(&s); return 0; }
+    for (u32 i = 0; i < s.n; i++) {
+        const char* name = s.v[i];
+        if (!s.dir[i] || name[0] == '.' || strlen(name) >= CELL_SAVEDATA_DIRNAME_SIZE ||
+            !savedata_prefix_match(prefix, name))
+            continue;
+        int dup = 0;
+        for (u32 k = 0; k < out->n && !dup; k++) dup = !strcmp(out->e[k].list.dirName, name);
+        char path[1024], sfo[1024];
+        build_save_path(path, sizeof path, name);
+        path_join(sfo, sizeof sfo, path, "PARAM.SFO");
+        HOST_STAT_T st;
+        if (dup || !dir_exists(path) || HOST_STAT(sfo, &st) != 0) continue;
+        savedata_dir_entry* e = &out->e[out->n++];
+        CellSaveDataSystemFileParam param;
+        read_param_sfo(path, &param, NULL);
+        strncpy(e->list.dirName, name, CELL_SAVEDATA_DIRNAME_SIZE - 1);
+        memcpy(e->list.listParam, param.listParam, CELL_SAVEDATA_SYSP_LPARAM_SIZE);
+        memcpy(e->subTitle, param.subTitle, sizeof e->subTitle);
+        e->subTitle[sizeof e->subTitle - 1] = '\0';
+        s64 at, ct;
+        host_times(&st, &at, &e->mtime, &ct);
+    }
+    names_free(&s);
+    s_sort_type = sortType;
+    s_sort_order = sortOrder;
+    qsort(out->e, out->n, sizeof *out->e, savedata_dir_cmp);
+    const char* pick = getenv("PS3_SAVEDATA_PICK");
+    for (u32 i = 1; pick && *pick && i < out->n; i++) {
+        if (strcmp(out->e[i].list.dirName, pick)) continue;
+        savedata_dir_entry t = out->e[i];
+        memmove(&out->e[1], &out->e[0], i * sizeof *out->e);
+        out->e[0] = t;
+        break;
+    }
+    printf("[cellSaveData] saves matching '%s' (sort %u/%u): %u", prefix ? prefix : "",
+           sortType, sortOrder, out->n);
+    for (u32 i = 0; i < out->n && i < 12; i++)
+        printf("%s%s", i ? ", " : " -> ", out->e[i].list.dirName);
+    printf("\n");
+    return out->n;
+}
