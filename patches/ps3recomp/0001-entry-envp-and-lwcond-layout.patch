+static void test_config(void)
+{
+    GenOverride o;
+    char err[160];
+    memset(&o, 0, sizeof o);
+    int bad = gcfg_parse_device(&o, "Triangle=b1 Circle=b2 Cross=b3 Square=b4 RX=a3~ RY=a2, L2=b7/a4+ R2=a4- "
+                                    "Up=h0.up Dpad=h1 PS=none Select=b9/home L1=b5/dpad.left", err, sizeof err);
+    CHECK_EQ(bad, 0);
+    CHECK(!o.ignore);
+    CHECK(o.set[GT_TRIANGLE] && o.bind[GT_TRIANGLE].n == 1 && o.bind[GT_TRIANGLE].s[0].kind == GS_BUTTON &&
+          o.bind[GT_TRIANGLE].s[0].index == 1);
+    CHECK(o.bind[GT_RX].s[0].kind == GS_AXIS && o.bind[GT_RX].s[0].index == 3 && o.bind[GT_RX].s[0].mode == GA_INV);
+    CHECK(o.bind[GT_RY].s[0].index == 2 && o.bind[GT_RY].s[0].mode == GA_FULL);
+    CHECK_EQ(o.bind[GT_L2].n, 2);
+    CHECK(o.bind[GT_L2].s[1].kind == GS_AXIS && o.bind[GT_L2].s[1].mode == GA_POS);
+    CHECK(o.bind[GT_R2].s[0].kind == GS_AXIS && o.bind[GT_R2].s[0].index == 4 && o.bind[GT_R2].s[0].mode == GA_NEG);
+    CHECK(o.bind[GT_UP].s[0].kind == GS_HAT && o.bind[GT_UP].s[0].index == 1);   /* Dpad=h1 came later */
+    CHECK(o.bind[GT_LEFT].s[0].mode == GH_LEFT);
+    CHECK(o.set[GT_PS] && o.bind[GT_PS].n == 0);
+    CHECK(o.bind[GT_SELECT].n == 2 && o.bind[GT_SELECT].s[1].kind == GS_HOME);
+    CHECK(o.bind[GT_L1].n == 2 && o.bind[GT_L1].s[1].kind == GS_DPADBTN && o.bind[GT_L1].s[1].mode == GH_LEFT);
+    CHECK(!o.set[GT_START]);
+
+    /* bad items are skipped, good ones kept; the first is described */
+    memset(&o, 0, sizeof o);
+    err[0] = 0;
+    bad = gcfg_parse_device(&o, "Cross=b1 Foo=b2 LX=a0+ Dpad=b1 Square=h0 Circle=b0 Triangle=a16 junk", err, sizeof err);
+    CHECK_EQ(bad, 7);
+    CHECK_STR(err, "unknown target \"Foo\"");
+    CHECK(o.set[GT_CROSS] && !o.set[GT_LX] && !o.set[GT_SQUARE] && !o.set[GT_CIRCLE] && !o.set[GT_TRIANGLE] && !o.set[GT_UP]);
+    memset(&o, 0, sizeof o);
+    bad = gcfg_parse_device(&o, "LX=a0+", err, sizeof err);
+    CHECK_STR(err, "LX: source \"a0+\" does not fit this target");
+    memset(&o, 0, sizeof o);
+    CHECK_EQ(gcfg_parse_device(&o, " Ignore ", err, sizeof err), 0);
+    CHECK(o.ignore);
+    memset(&o, 0, sizeof o);
+    CHECK_EQ(gcfg_parse_device(&o, "Dpad=none", err, sizeof err), 0);
+    CHECK(o.set[GT_UP] && o.set[GT_DOWN] && o.bind[GT_UP].n == 0);
+
+    /* sources, one at a time */
+    GenSrc src;
+    CHECK_EQ(gcfg_parse_src("b12", GT_CROSS, &src), 1);
+    CHECK_EQ(gcfg_parse_src("B128", GT_CROSS, &src), 1);
+    CHECK_EQ(gcfg_parse_src("b129", GT_CROSS, &src), 0);
+    CHECK_EQ(gcfg_parse_src("a15", GT_LX, &src), 1);
+    CHECK_EQ(gcfg_parse_src("a16", GT_LX, &src), 0);
+    CHECK_EQ(gcfg_parse_src("a2+", GT_LX, &src), -1);
+    CHECK_EQ(gcfg_parse_src("a2-", GT_R2, &src), 1);
+    CHECK_EQ(src.mode, GA_NEG);
+    CHECK_EQ(gcfg_parse_src("a2~", GT_LY, &src), 1);
+    CHECK_EQ(gcfg_parse_src("h0.up", GT_LX, &src), -1);
+    CHECK_EQ(gcfg_parse_src("h0.1", GT_CROSS, &src), 1);
+    CHECK_EQ(src.mode, GH_UP);
+    CHECK_EQ(gcfg_parse_src("h0.sideways", GT_CROSS, &src), 0);
+    CHECK_EQ(gcfg_parse_src("h0", GT_DPAD, &src), 1);
+    CHECK_EQ(gcfg_parse_src("h4", GT_DPAD, &src), 0);
+    CHECK_EQ(gcfg_parse_src("x1", GT_CROSS, &src), 0);
+    CHECK_EQ(gcfg_parse_src("none", GT_RX, &src), 1);
+    CHECK_EQ(src.kind, GS_NONE);
+    CHECK_EQ(gen_target_from_name("dpad_up"), GT_UP);
+    CHECK_EQ(gen_target_from_name("Right X"), GT_RX);
+    CHECK_EQ(gen_target_from_name("Jump"), -1);
+
+    /* the line is found under map.VID:PID, or generic.VID:PID, however written */
+    cfg_clear();
+    cfg_set("Map.0079:0006", "Cross=b3");
+    cfg_set("gamepad_generic.1234:abcd", "Cross=b4");
+    CHECK(gen_cfg_line(0x0079, 0x0006) != NULL);
+    CHECK(gen_cfg_line(0x1234, 0xABCD) != NULL);
+    CHECK(gen_cfg_line(0x0079, 0x0007) == NULL);
+    cfg_clear();
+}
+
+static void test_override_applied_and_roundtrip(void)
+{
+    PadHostDevice d;
+    PadHostPortState st;
+    /* round trip: the printed default mapping parses back to the same map */
+    make_ds4();
+    dev_init(&d, 0x0F0D, 0x00C1);
+    cfg_clear();
+    padhost_drv_generic.open(&d);
+    CHECK(strstr(g_last_log, "map.0F0D:00C1 = Cross=b2 ") == g_last_log + 2);   /* logged as a config line */
+    char m[640], err[160];
+    map_of(&d, m, sizeof m);
+    GenOverride o;
+    memset(&o, 0, sizeof o);
+    CHECK_EQ(gcfg_parse_device(&o, m, err, sizeof err), 0);
+    GenMap back;
+    memset(&back, 0, sizeof back);
+    for (int t = 0; t < GT_COUNT; t++) if (o.set[t]) back.t[t] = o.bind[t];
+    CHECK(!memcmp(&back, &gen_priv(&d)->map, sizeof back));
+
+    /* a map line changes what open() builds */
+    cfg_clear();
+    cfg_set("map.0F0D:00C1", "Cross=b3 Circle=b2 LX=a0~ R2=a5+ Dpad=none");
+    padhost_drv_generic.open(&d);
+    CHECK_EQ(gen_priv(&d)->overridden, 1);
+    memset(&st, 0, sizeof st);
+    for (int i = 0; i < g_desc.nvalues; i++) g_raw[i] = 128;
+    set_raw(GEN_PAGE_GD, 0x33, 0); set_raw(GEN_PAGE_GD, 0x34, 0);   /* triggers released */
+    set_raw(GEN_PAGE_GD, 0x30, 255);
+    set_raw(GEN_PAGE_GD, 0x35, 255);            /* Rz: still RY, and now R2 too */
+    set_raw(GEN_PAGE_GD, 0x39, 0);
+    { u16 b[] = { 3 }; press(GEN_PAGE_BUTTON, b, 1); }
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.lx, 0);                         /* inverted */
+    CHECK_EQ(st.ry, 255);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_R2);   /* hat up ignored */
+    CHECK_EQ(st.press[11], 255);
+
+    /* a source the device lacks is reported, and reads as released */
+    cfg_clear();
+    cfg_set("map.0F0D:00C1", "Cross=b30 L2=a7");
+    padhost_drv_generic.open(&d);
+    press(GEN_PAGE_BUTTON, NULL, 0);
+    parse_id(&d, 0, &st);
+    CHECK_EQ(st.buttons & (CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_L2), 0);
+    cfg_clear();
+}
+
+static void test_match_and_open(void)
+{
+    PadHostDevice d;
+    cfg_clear();
+    cfg_set("map.0810:0001", "ignore");
+    cfg_set("generic.0810:0002", "Cross=b1, ignore");
+    dev_init(&d, 0x0079, 0x0006);
+    CHECK_EQ(padhost_drv_generic.match(&d), 1);
+    d.usage = 4;
+    CHECK_EQ(padhost_drv_generic.match(&d), 1);
+    d.usage = 8;                                /* Multi-axis (a 3D mouse): only with a map line */
+    CHECK_EQ(padhost_drv_generic.match(&d), 0);
+    cfg_set("map.0079:0006", "LX=a0 LY=a1");
+    CHECK_EQ(padhost_drv_generic.match(&d), 1);
+    cfg_set("map.0079:0006", "ignore");
+    CHECK_EQ(padhost_drv_generic.match(&d), 0);
+    d.usage = 2;                                /* a mouse */
+    CHECK_EQ(padhost_drv_generic.match(&d), 0);
+    d.usage = 5; d.usage_page = 0x0C;           /* consumer control */
+    CHECK_EQ(padhost_drv_generic.match(&d), 0);
+    dev_init(&d, 0x045E, 0x02FD);               /* Xbox One S over Bluetooth */
+    CHECK_EQ(padhost_drv_generic.match(&d), 0);
+    d.usage = 4;                                /* a Microsoft joystick that is not an Xbox pad */
+    CHECK_EQ(padhost_drv_generic.match(&d), 1);
+    dev_init(&d, 0x046D, 0xC21D);
+    d.path = "\\\\?\\HID#VID_046D&PID_C21D&IG_00#8&1f2a&0&0000#{4d1e55b2-f16f-11cf-88cb-001111000030}";
+    CHECK_EQ(padhost_drv_generic.match(&d), 0); /* XInput-served */
+    d.path = "\\\\?\\hid#vid_046d&pid_c21d&ig_00#x";
+    CHECK_EQ(padhost_drv_generic.match(&d), 0);
+    d.path = NULL;
+    CHECK_EQ(padhost_drv_generic.match(&d), 1);
+    dev_init(&d, 0x0810, 0x0001);
+    CHECK_EQ(padhost_drv_generic.match(&d), 0); /* ignored in input.ini */
+    dev_init(&d, 0x0810, 0x0002);
+    CHECK_EQ(padhost_drv_generic.match(&d), 0);
+
+    /* open() refuses what is not a gamepad */
+    desc_reset();
+    add_value(GEN_PAGE_GD, 0x30, 0, 8, 0, 255, 0, 0);
+    add_value(GEN_PAGE_GD, 0x31, 0, 8, 0, 255, 0, 0);
+    add_buttons(GEN_PAGE_BUTTON, 1, 1, 0);
+    dev_init(&d, 9, 9);
+    CHECK_EQ(padhost_drv_generic.open(&d), PADHOST_OPEN_DECLINED);   /* listed as not used, never retried */
+    desc_reset();
+    add_value(GEN_PAGE_GD, 0x39, 0, 4, 0, 7, 1, 0);     /* hat + buttons: an arcade stick */
+    add_buttons(GEN_PAGE_BUTTON, 1, 8, 0);
+    CHECK_EQ(padhost_drv_generic.open(&d), 0);
+    g_describe_rc = -1;
+    CHECK(padhost_drv_generic.open(&d) != 0);
+    CHECK(padhost_drv_generic.open(&d) != PADHOST_OPEN_DECLINED);    /* unreadable: a failure, retried */
+    g_describe_rc = 0;
+    u8 out[64];
+    CHECK_EQ(padhost_drv_generic.build_output(&d, 1, 255, 0, out, sizeof out), 0);   /* no rumble or LEDs */
+    padhost_drv_generic.close(&d);
+    CHECK_EQ(padhost_drv_generic.kind, PADHOST_KIND_GENERIC);
+    /* the product name the host found is kept; the descriptor's is a fallback */
+    desc_reset();
+    add_value(GEN_PAGE_GD, 0x39, 0, 4, 0, 7, 1, 0);
+    add_buttons(GEN_PAGE_BUTTON, 1, 8, 0);
+    dev_init(&d, 9, 9);
+    snprintf(d.name, sizeof d.name, "Arcade Stick");
+    padhost_drv_generic.open(&d);
+    CHECK_STR(d.name, "Arcade Stick");
+    dev_init(&d, 9, 9);
+    padhost_drv_generic.open(&d);
+    CHECK_STR(d.name, "Fake Pad");
+    cfg_clear();
+}
