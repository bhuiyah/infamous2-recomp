+SPU_FORCEINLINE __m128i spu__fcmeq_i(__m128i a, __m128i b) { return _mm_cmpeq_epi32(spu__fxmag_v(a), spu__fxmag_v(b)); }
+SPU_FORCEINLINE __m128i spu__fcmgt_i(__m128i a, __m128i b) { return _mm_cmpgt_epi32(spu__fxmag_v(a), spu__fxmag_v(b)); }
+#  if defined(SPU_HELPERS_FP_RZDAZ)
+/* Under DAZ the host's compares order SPU values exactly -- a denormal reads
+ * as zero, -0 == +0 -- for every value but exponent 255 (an infinity or NaN
+ * to the host). x - x is a NaN exactly for those, so one unordered compare
+ * finds them; such a vector takes the integer compare. One operand is made
+ * opaque so a compare of two constants cannot be folded (the fold would not
+ * apply DAZ). */
+#    if defined(__clang__) || defined(__GNUC__)
+#      define SPU__CMP_OPAQUE(v) __asm__("" : "+x"(v))
+#    else
