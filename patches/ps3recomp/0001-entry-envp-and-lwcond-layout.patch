+/* ---------------------------------------------------------------------------
+ * Save states: cellGcmSys's part of the GCM_ section (runtime/savestate/
+ * ss_state.h; engine design 6.2)
+ *
+ * The section is registered in libs/system/cellSysmodule.c, with its TIME
+ * anchors: this file only describes its part -- a field list, a check, the
+ * fence queue's runs, the immediate-mode vertices, two ages, and the load's
+ * teardown / restore / after-release steps -- and calls nothing of the
+ * save-state engine (the glue there reads the image), so the test that
+ * builds it alone (libs/video/tests/test_gcm_user_command.c) still links.
+ *
+ * What the guest can observe of cellGcm and the RSX, and everything that
+ * decides what the FIFO walker does next, as plain values: the configuration
+ * and IO maps, flips and the interrupts not yet delivered, the guest's
+ * handlers, tiles / zcull / reports, the walker's position, park, acquire and
+ * its watchdogs' memory, the 2D engines and the command processor's register
+ * file -- gcm_ss.inc, one FIELDS record "gcm" -- then the fences queued for
+ * paced publication (BLOB "ref_queue", u32s oldest first: the ring normalised
+ * to head 0) and the vertices of an immediate-mode primitive the walker is
+ * inside (BLOB "imm_verts", usually empty). Labels, the control register and
+ * the offset tables the guest indexes are guest memory (GMEM). The walker's
+ * two wait timers are TIME anchors (their ages, below).
+ *
+ * Everything here is read on the frame-clock thread -- the walker's own --
+ * with every guest PPU thread and SPU parked and the GPU idle, so nothing
+ * else touches these variables: no lock, no allocation, no logging.
+ *
+ * What a load (M4c) does with it is at the end of the file (the load's
+ * part): "gcm" back with ss_read_fields, the queue as head 0 / tail n, the
+ * vertices into rsx_imm_ss_verts(), the walker's watch and pacing reset, its
+ * two timers re-anchored, a pending flip dropped, and after the release
+ * every dirty flag of s_rsx_state set. The zcull bindings are rsx_report.c's
+ * record (rsx_report_ss_restore). s_last_flip_time and the report timestamps
+ * are get_timestamp_ns() values on the one guest clock (guest_clock.h): the
+ * load sets that clock to the snapshot's instant, so they come back as raw
+ * values -- within one process; a slot loaded into another one (M5) needs
+ * the clock's epoch carried.
+ * -------------------------------------------------------------------------*/
+extern u32 g_rsx_last_reference;      /* rsx_commands.c: the last NV406E_SET_REFERENCE */
+extern u32 g_rsx_sem_off;             /* rsx_commands.c: NV4097_SET_SEMAPHORE_OFFSET */
+void* rsx_imm_ss_verts(u32* bytes);   /* rsx_commands.c: the immediate-mode vertices */
+
+static const ss_field k_gcm_fields[] = {
+#define SS_F(v)   SS_FIELD(v),
+#define SS_FV(v)  { #v, (void*)(uintptr_t)&(v), (uint32_t)sizeof(v), 0u },
+#define SS_FVH(v) { #v, (void*)(uintptr_t)&(v), (uint32_t)sizeof(v), (uint32_t)SS_FF_HOST },
+#include "gcm_ss.inc"
+#undef SS_FVH
+#undef SS_FV
+#undef SS_F
+};
+const ss_list cellGcmSys_ss_list = SS_LIST("gcm", k_gcm_fields);
+
+/* Strict eligibility, the GCM part of engine design 4.2: nobody inside the
+ * handler pump (it calls guest handlers; a thread there cannot park, so this
+ * is the assertion that none is), and the walker at rest -- caught up with
+ * `put`, or standing on a self-jump park or at a SEMAPHORE_ACQUIRE. A pass
+ * that stopped at a flip with the next frame behind it is not at rest. (The
+ * coordinator judges the same from cellGcm_ss_walker_info before it gets
+ * here; this is the section's own word, after the GPU went idle.) 0, or
+ * SS_REASON_GPU with the blocker in why. */
+int cellGcmSys_ss_check(char* why, size_t n)
+{
+#ifdef _WIN32
+    if (s_gcm_pumping) {
+        snprintf(why, n, "a thread is delivering the vblank / flip / user handlers (ppu_gcm_pump)");
+        return SS_REASON_GPU;
+    }
+#endif
+    const u32 put = vm_read32(GCM_CONTROL_GUEST_ADDR + 0);
+    if (s_fifo_getoff != put && s_park_off != s_fifo_getoff && s_acq_pos != s_fifo_getoff) {
+        snprintf(why, n, "the FIFO walker is not at rest (get=0x%X put=0x%X park=0x%X acquire=0x%X)",
+                 s_fifo_getoff, put, s_park_off, s_acq_pos);
+        return SS_REASON_GPU;
+    }
+    return 0;
+}
+
+/* The fences queued for paced publication, oldest first, as the ring's two
+ * runs: *a (*na bytes), then *b (*nb bytes). Head and tail count freely (the
+ * overflow drops the oldest), so at most GCM_REF_QLEN are live, in at most
+ * two runs of the ring. */
+void cellGcmSys_ss_ref_queue(const void** a, uint32_t* na, const void** b, uint32_t* nb)
+{
+    const u32 h = s_ref_qhead, t = s_ref_qtail;
+    const u32 q = t - h < GCM_REF_QLEN ? t - h : GCM_REF_QLEN;
+    const u32 i0 = h % GCM_REF_QLEN;
+    const u32 run = GCM_REF_QLEN - i0 < q ? GCM_REF_QLEN - i0 : q;
+    *a = &s_ref_q[i0];
+    *na = run * 4u;
+    *b = &s_ref_q[0];
+    *nb = (q - run) * 4u;
+}
+
+/* An immediate-mode primitive cut by `put`: the vertices it has so far
+ * (imm_count is 0 outside SET_BEGIN_END, and never above the array), *n
+ * bytes of them; *cap the array's size. Either pointer may be NULL. */
+const void* cellGcmSys_ss_imm_verts(uint64_t* n, uint64_t* cap)
+{
+    u32 c = 0;
+    const void* v = rsx_imm_ss_verts(&c);
+    uint64_t nb = (uint64_t)s_rsx_state.imm_count * (RSX_MAX_VERTEX_ATTRIBS * 16u);
+    if (nb > c) nb = c;
+    if (n) *n = nb;
+    if (cap) *cap = c;
+    return v;
+}
+
+/* The most bytes this part can add: the fields (1.4 MB, s_report_data the
+ * most of it, each with room for its name), a full fence queue and a full
+ * immediate-mode primitive. Outside a stop. */
+uint64_t cellGcmSys_ss_size(void)
+{
+    uint64_t n = 0, cap = 0;
+    for (uint32_t i = 0; i < cellGcmSys_ss_list.n; i++)
+        n += (uint64_t)cellGcmSys_ss_list.f[i].size + 64u;
+    (void)cellGcmSys_ss_imm_verts(NULL, &cap);
+    return n + GCM_REF_QLEN * 4u + cap;
+}
+
+/* The walker's two wait timers are ps3_ms_now() instants: host time, which
+ * the guest never sees, so they are TIME anchors of their AGE at the capture
+ * (0 when the walker stands at no acquire / park -- s_acq_pos / s_park_off
+ * say which), turned back into instants on the load's clock (M4c: t0 = now -
+ * age). Copied raw they would be the old session's instants, and the first
+ * pass after a load would find a grace (GCM_SEMA_ACQUIRE, GCM_PARK_GRACE_MS)
+ * long gone and skip past the label the guest waits for. The age includes
+ * the part of the stop before the capture, which cellGcm_ss_walker_rebase
+ * hands back only at the release: well under a tenth of either grace. */
+uint64_t cellGcmSys_ss_acq_age(void)
+{
+    const unsigned long long now = ps3_ms_now();
+    return (s_acq_pos != 0xFFFFFFFFu && now > s_acq_t0) ? now - s_acq_t0 : 0;
+}
+uint64_t cellGcmSys_ss_park_age(void)
+{
+    const unsigned long long now = ps3_ms_now();
+    return (s_park_off != 0xFFFFFFFFu && now > s_park_t0) ? now - s_park_t0 : 0;
+}
+
+/* ---- the load (M4c) --------------------------------------------------------
+ * cellSysmodule.c's GCM_ teardown / restore / after_release call these, on
+ * the frame-clock thread -- the walker's own, so the walker cannot run in
+ * between -- with every guest thread discarded (none inside ppu_gcm_pump,
+ * none polling the ref register) and the GPU idle (ss_state.h "THE LOAD").
+ * No lock: nothing else can touch these variables until the release. */
+
+/* Teardown, the old state's guest memory still in place: the idle wait's
+ * watch back to "none" (gen / kicked keep counting, so a poke never takes an
+ * old generation for a new one), the fence queue emptied, the per-iteration
+ * early flag and the publication pacing cleared, and the handler pump's busy
+ * flag dropped -- a thread discarded inside ppu_gcm_pump (inside a guest
+ * handler) never reached GCM_PUMP_LEAVE, and left set the flag would stop
+ * every vblank / flip / user handler for good. The kick event and the locks
+ * are kept. Everything else stays the session's until the restore. */
+void cellGcmSys_ss_teardown(void)
+{
+    s_wake.kind = GCM_WAKE_NONE;
+    s_pass_early = 0;
+    s_ref_qhead = 0;
+    s_ref_qtail = 0;
+    s_ref_poll_pub = 0;
+    s_ref_walk_pub = 0;
+    GCM_PUMP_LEAVE();
+}
+
+/* The image's two blobs, by size alone (GCM_'s check_image, the world
+ * running; and again in the restore): "ref_queue" whole fences, at most a
+ * full queue; "imm_verts" whole vertices, at most the array. 0, or 1 with
+ * the blob and its size in why. */
+int cellGcmSys_ss_check_blobs(uint64_t nrefq, uint64_t nimm, char* why, size_t n)
+{
+    u32 cap = 0;
+    (void)rsx_imm_ss_verts(&cap);
+    const uint64_t vb = RSX_MAX_VERTEX_ATTRIBS * 16u;
+    if (nrefq % 4u || nrefq > GCM_REF_QLEN * 4u) {
+        if (why && n) snprintf(why, n, "ref_queue: %llu bytes (whole fences, at most %u)",
+                               (unsigned long long)nrefq, GCM_REF_QLEN * 4u);
+        return 1;
+    }
+    if (nimm % vb || nimm > cap) {
+        if (why && n) snprintf(why, n, "imm_verts: %llu bytes (whole %llu-byte vertices, at most %u)",
+                               (unsigned long long)nimm, (unsigned long long)vb, cap);
+        return 1;
+    }
+    return 0;
+}
+
+/* Restore, right after the glue read "gcm" back into the statics
+ * (ss_read_fields: every name and size checked). First the counts the walker
+ * and the method decoder index host arrays with -- the image is not trusted
+ * -- then what the record does not hold: the queued fences (refq, nrefq
+ * bytes, oldest first) as head 0 / tail n; the immediate-mode vertices (imm,
+ * nimm bytes: exactly s_rsx_state.imm_count of them); the watch, pacing and
+ * pump flag as the teardown left them; the walker's two wait timers re-
+ * anchored from their ages at the capture (the TIME anchors gcm.acq_age_ms /
+ * gcm.park_age_ms) -- the release then adds the time from here to the
+ * release (cellGcm_ss_walker_rebase), so a grace runs on from where the save
+ * stopped it. And a pending flip is dropped: the frame clock would present
+ * the reset renderer's batch, not the snapshot's frame. The next flip
+ * presents; the guest sees nothing (s_flip_pending is host state, the
+ * fidelity check skips it). 0, or 1 with the field and its value in why
+ * (past the point of no return: the load then ends the process). */
+int cellGcmSys_ss_restore(const void* refq, uint64_t nrefq, const void* imm, uint64_t nimm,
+                          uint64_t acq_age, uint64_t park_age, char* why, size_t n)
+{
+    if (cellGcmSys_ss_check_blobs(nrefq, nimm, why, n)) return 1;
+    u32 cap = 0;
+    void* verts = rsx_imm_ss_verts(&cap);
+    const uint64_t vb = RSX_MAX_VERTEX_ATTRIBS * 16u;
+    if ((uint64_t)s_rsx_state.imm_count * vb != nimm) {
+        if (why && n) snprintf(why, n, "gcm.s_rsx_state.imm_count: %u, but imm_verts holds %llu vertices",
+                               s_rsx_state.imm_count, (unsigned long long)(nimm / vb));
+        return 1;
+    }
+    const char* bad = NULL;
+    long long v = 0, hi = 0;
+#define GCM_SS_BAD(cond, name, val, max) \
+    do { if (!bad && (cond)) { bad = (name); v = (long long)(val); hi = (long long)(max); } } while (0)
+    GCM_SS_BAD(s_spu_blk_w < 0 || s_spu_blk_w >= GCM_SPU_BLK_N, "s_spu_blk_w", s_spu_blk_w, GCM_SPU_BLK_N - 1);
+    GCM_SS_BAD(s_io_mapping_count < 0 || s_io_mapping_count > CELL_GCM_MAX_IO_MAPPINGS, "s_io_mapping_count",
+               s_io_mapping_count, CELL_GCM_MAX_IO_MAPPINGS);
+    GCM_SS_BAD(s_current_display_buffer_id >= CELL_GCM_MAX_DISPLAY_BUFFER_NUM, "s_current_display_buffer_id",
+               s_current_display_buffer_id, CELL_GCM_MAX_DISPLAY_BUFFER_NUM - 1);
+    GCM_SS_BAD(s_rsx_state.vp_ucode_bytes > sizeof s_rsx_state.vp_ucode, "s_rsx_state.vp_ucode_bytes",
+               s_rsx_state.vp_ucode_bytes, sizeof s_rsx_state.vp_ucode);
+    GCM_SS_BAD(s_rsx_state.vp_ucode_write > sizeof s_rsx_state.vp_ucode, "s_rsx_state.vp_ucode_write",
+               s_rsx_state.vp_ucode_write, sizeof s_rsx_state.vp_ucode);
+#undef GCM_SS_BAD
+    if (bad) {
+        if (why && n) snprintf(why, n, "gcm.%s: %lld (0..%lld)", bad, v, hi);
+        return 1;
+    }
+    cellGcmSys_ss_teardown();             /* (the watch, the pacing, the pump flag; the queue head 0) */
+    if (nrefq) memcpy(s_ref_q, refq, (size_t)nrefq);
+    s_ref_qtail = (u32)(nrefq / 4u);
+    if (nimm) memcpy(verts, imm, (size_t)nimm);
+    s_flip_pending = 0;
+    const unsigned long long now = ps3_ms_now();
+    s_acq_t0  = (s_acq_pos  != 0xFFFFFFFFu && acq_age  < now) ? now - acq_age  : 0;
+    s_park_t0 = (s_park_off != 0xFFFFFFFFu && park_age < now) ? now - park_age : 0;
+    return 0;
+}
+
+/* After the release (the world runs again; the walker -- this thread -- has
+ * not run since the restore): every dirty flag of the register file set, so
+ * the next draw hands the backend the whole state again. The renderer
+ * dropped everything it derived from the old state (rsx_d3d12_backend_ss_
+ * reset), while the restored s_rsx_state carries the snapshot's flags,
+ * mostly clear: a register the snapshot's frame had already pushed would
+ * never reach the reset renderer (critique H9). The constants' dirty range
+ * becomes all of them. Here and not in the restore: the fidelity check
+ * compares s_rsx_state with the image, flags included. */
+void cellGcmSys_ss_after_release(void)
+{
+    rsx_state* st = &s_rsx_state;
+    st->surface_dirty = st->viewport_dirty = st->blend_dirty = st->depth_dirty = 1;
+    st->stencil_dirty = st->texture_dirty = st->vertex_dirty = 1;
+    st->color_mask_dirty = st->alpha_dirty = st->shader_dirty = 1;
+    st->vp_dirty = 1;
+    for (int i = 0; i < RSX_MAX_TEXTURES; i++) st->textures[i].dirty = 1;
+    for (int i = 0; i < RSX_MAX_VERTEX_TEXTURES; i++) st->vertex_textures[i].dirty = 1;
+    st->vertex_constants_dirty = 1;
+    st->vertex_constants_lo = 0;
+    st->vertex_constants_hi = RSX_MAX_VERTEX_CONSTANTS - 1;
 }
