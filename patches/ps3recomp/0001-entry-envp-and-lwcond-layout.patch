+        CHECK(strstr(ss_reason_text(SS_REASON_BOOTING), "once the game is running") != NULL, "booting text");
+        ss_frame_tick(++g_flip);                      /* (flipping again) */
+    }
+
+    /* ---- 12. LOAD is lenient: a chain with no continuation and an unaudited
