+    memset(g_files, 0, sizeof g_files);
+    memset(g_dirs, 0, sizeof g_dirs);
+    memset(g_fd_usm, 0, sizeof g_fd_usm);
+    memset(g_fd_wr, 0, sizeof g_fd_wr);
+    memset(g_fd_path, 0, sizeof g_fd_path);
+    memset(g_fd_hpath, 0, sizeof g_fd_hpath);
+    memset(g_fd_flags, 0, sizeof g_fd_flags);
+    memset(g_fd_sdata, 0, sizeof g_fd_sdata);
+    memset(g_fd_edat, 0, sizeof g_fd_edat);
+    memset(g_dir_read, 0, sizeof g_dir_read);
+    s_aio_next_id = 1;                              /* (the FIELDS bring the image's back) */
