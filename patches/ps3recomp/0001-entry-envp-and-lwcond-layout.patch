+static void test_r6g5b5_texels(void)
+{
+    u8 d[4];
+    { const u8 s[2] = { 0xFC, 0x00 };          /* R6 = 63 */
+      decode_one(FMT_R6G5B5, s, d);
+      CHECK_EQ(d[0], 255); CHECK_EQ(d[1], 0); CHECK_EQ(d[2], 0); CHECK_EQ(d[3], 255); }
+    { const u8 s[2] = { 0x04, 0x00 };          /* R6 = 1: six bits, not five */
+      decode_one(FMT_R6G5B5, s, d);
+      CHECK_EQ(d[0], 4); CHECK_EQ(d[1], 0); }
+    { const u8 s[2] = { 0x03, 0xE0 };          /* G5 = 31 */
+      decode_one(FMT_R6G5B5, s, d);
+      CHECK_EQ(d[0], 0); CHECK_EQ(d[1], 255); CHECK_EQ(d[2], 0); }
+    { const u8 s[2] = { 0x00, 0x1F };          /* B5 = 31 */
+      decode_one(FMT_R6G5B5, s, d);
+      CHECK_EQ(d[2], 255); CHECK_EQ(d[1], 0); }
+}
