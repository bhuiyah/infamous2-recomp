+/* ---- the load (M4c; ss_state.h "THE LOAD") ---------------------------------
+ * TEARDOWN: every guest thread is gone, so no queue or flag lock is held and
+ * nobody sleeps on a condition variable: each live object's lock goes, and
+ * the three tables are empty again, as sys_event_init leaves them.
+ * RESTORE: the four arrays back at their ids; each queue's ring is the
+ * image's buffer[0..count) with head 0 and tail count % capacity (the
+ * capture normalised it); every queue and flag gets a new lock and condition
+ * variable -- the waiters come back by issuing their receives / waits again.
+ * A port keeps its queue id even if that queue is gone (destroying a queue
+ * does not disconnect its ports). With apply 0 nothing is written: the
+ * records are only checked (KOBJ's check_image, the world running) -- ids,
+ * capacities, counts, every queued event there once -- and a bad one is
+ * refused with the field's name. */
+void sys_event_ss_teardown(void)
+{
+    for (int i = 0; i < SYS_EVENT_QUEUE_MAX; i++) {
+        sys_event_queue_info* q = &g_sys_event_queues[i];
+        if (!q->active) continue;
+#ifdef _WIN32
+        DeleteCriticalSection(&q->lock);
+#else
+        pthread_cond_destroy(&q->not_empty);
+        pthread_mutex_destroy(&q->lock);
+#endif
+    }
+    for (int i = 0; i < SYS_EVENT_FLAG_MAX; i++) {
+        sys_event_flag_info* f = &g_sys_event_flags[i];
+        if (!f->active) continue;
+#ifdef _WIN32
+        DeleteCriticalSection(&f->lock);
+#else
+        pthread_cond_destroy(&f->cv);
+        pthread_mutex_destroy(&f->lock);
+#endif
+    }
+    memset(g_sys_event_queues, 0, sizeof(g_sys_event_queues));
+    memset(g_sys_event_ports,  0, sizeof(g_sys_event_ports));
+    memset(g_sys_event_flags,  0, sizeof(g_sys_event_flags));
+}
+
+#define EVT_SS_BIT(set, i)  ((set)[(i) >> 5] & (1u << ((i) & 31u)))
+#define EVT_SS_SET(set, i)  ((set)[(i) >> 5] |= 1u << ((i) & 31u))
+
+int sys_event_ss_restore(ss_reader* r, int apply)
+{
+    int32_t  cap[SYS_EVENT_QUEUE_MAX + 1], cnt[SYS_EVENT_QUEUE_MAX + 1];
+    uint32_t got[SYS_EVENT_QUEUE_MAX + 1][(SYS_EVENT_QUEUE_BUF_MAX + 31) / 32];   /* events seen, per queue */
+    uint32_t pseen[(SYS_EVENT_PORT_MAX + 31) / 32], fseen[(SYS_EVENT_FLAG_MAX + 31) / 32];
+    ss_recs_it it;
+    uint32_t key;
+    int k, e;
+    memset(cap, 0, sizeof cap);
+    memset(cnt, 0, sizeof cnt);
+    memset(got, 0, sizeof got);
+
+    if ((e = ss_recs_open(r, &g_ss_list_kobj_queues, &it)) != 0) return e;
+    for (;;) {
+        sys_event_queue_info t;                       /* (the listed members only are written) */
+        memset(&t, 0, sizeof t);
+        if ((k = ss_recs_next(&it, &key, &t)) != 1) break;
+        if (key < 1 || key > SYS_EVENT_QUEUE_MAX)
+            return ss_reader_fail(r, SS_E_CORRUPT, "queues[%u]: no such queue id", key);
+        if (cap[key]) return ss_reader_fail(r, SS_E_CORRUPT, "queues[%u]: listed twice", key);
+        if (t.capacity <= 0 || t.capacity > SYS_EVENT_QUEUE_BUF_MAX)
+            return ss_reader_fail(r, SS_E_CORRUPT, "queues[%u].capacity: %d out of 1..%d", key, t.capacity,
+                                  SYS_EVENT_QUEUE_BUF_MAX);
+        if (t.count < 0 || t.count > t.capacity)
+            return ss_reader_fail(r, SS_E_CORRUPT, "queues[%u].count: %d out of 0..%d", key, t.count, t.capacity);
+        cap[key] = t.capacity;
+        cnt[key] = t.count;
+        if (!apply) continue;
+        sys_event_queue_info* q = &g_sys_event_queues[key - 1];
+        memset(q, 0, sizeof *q);
+        q->protocol = t.protocol;
+        q->type     = t.type;
+        memcpy(q->name, t.name, sizeof q->name);
+        q->key      = t.key;
+        q->capacity = t.capacity;
+        q->count    = t.count;
+        q->head     = 0;
+        q->tail     = t.count % t.capacity;
+        q->cancelled = t.cancelled;
+#ifdef _WIN32
+        InitializeCriticalSection(&q->lock);
+        InitializeConditionVariable(&q->not_empty);
+#else
+        pthread_mutex_init(&q->lock, NULL);
+        pthread_cond_init(&q->not_empty, NULL);
+#endif
+        q->active = 1;
+    }
+    if (k < 0) return k;
+
+    if ((e = ss_recs_open(r, &g_ss_list_kobj_events, &it)) != 0) return e;
+    for (;;) {
+        evt_ss_event v;
+        memset(&v, 0, sizeof v);
+        if ((k = ss_recs_next(&it, &key, &v)) != 1) break;
+        const uint32_t id = key >> 8, n = key & 0xFFu;
+        if (id < 1 || id > SYS_EVENT_QUEUE_MAX || !cap[id])
+            return ss_reader_fail(r, SS_E_CORRUPT, "events[0x%X]: queue %u is not in the image", key, id);
+        if (v.queue != id || v.n != n || (int32_t)n >= cnt[id])
+            return ss_reader_fail(r, SS_E_CORRUPT, "events[0x%X]: event %u of queue %u, which holds %d", key,
+                                  v.n, v.queue, cnt[id]);
+        if (EVT_SS_BIT(got[id], n)) return ss_reader_fail(r, SS_E_CORRUPT, "events[0x%X]: listed twice", key);
+        EVT_SS_SET(got[id], n);
+        if (!apply) continue;
+        sys_event_t* b = &g_sys_event_queues[id - 1].buffer[n];
+        b->source = v.source;
+        b->data1  = v.data1;
+        b->data2  = v.data2;
+        b->data3  = v.data3;
+    }
+    if (k < 0) return k;
+    for (uint32_t id = 1; id <= SYS_EVENT_QUEUE_MAX; id++) {
+        int have = 0;
+        for (int32_t n = 0; n < cnt[id]; n++) have += EVT_SS_BIT(got[id], (uint32_t)n) != 0;
+        if (have != cnt[id])
+            return ss_reader_fail(r, SS_E_CORRUPT, "queues[%u].count: %d, but %d of its events in the image", id,
+                                  cnt[id], have);
+    }
+
+    memset(pseen, 0, sizeof pseen);
+    if ((e = ss_recs_open(r, &g_ss_list_kobj_ports, &it)) != 0) return e;
+    for (;;) {
+        sys_event_port_info t;
+        memset(&t, 0, sizeof t);
+        if ((k = ss_recs_next(&it, &key, &t)) != 1) break;
+        if (key < 1 || key > SYS_EVENT_PORT_MAX)
+            return ss_reader_fail(r, SS_E_CORRUPT, "ports[%u]: no such port id", key);
+        if (EVT_SS_BIT(pseen, key - 1)) return ss_reader_fail(r, SS_E_CORRUPT, "ports[%u]: listed twice", key);
+        EVT_SS_SET(pseen, key - 1);
+        if (t.connected_queue < 0 || t.connected_queue > SYS_EVENT_QUEUE_MAX)
+            return ss_reader_fail(r, SS_E_CORRUPT, "ports[%u].connected_queue: %d is no queue id", key,
+                                  t.connected_queue);
+        if (!apply) continue;
+        sys_event_port_info* p = &g_sys_event_ports[key - 1];
+        memset(p, 0, sizeof *p);
+        p->type = t.type;
+        p->name = t.name;
+        p->connected_queue = t.connected_queue;
+        p->active = 1;
+    }
+    if (k < 0) return k;
+
+    memset(fseen, 0, sizeof fseen);
+    if ((e = ss_recs_open(r, &g_ss_list_kobj_eflags, &it)) != 0) return e;
+    for (;;) {
+        sys_event_flag_info t;
+        memset(&t, 0, sizeof t);
+        if ((k = ss_recs_next(&it, &key, &t)) != 1) break;
+        if (key < 1 || key > SYS_EVENT_FLAG_MAX)
+            return ss_reader_fail(r, SS_E_CORRUPT, "eflags[%u]: no such event flag id", key);
+        if (EVT_SS_BIT(fseen, key - 1)) return ss_reader_fail(r, SS_E_CORRUPT, "eflags[%u]: listed twice", key);
+        EVT_SS_SET(fseen, key - 1);
+        if (!apply) continue;
+        sys_event_flag_info* f = &g_sys_event_flags[key - 1];
+        memset(f, 0, sizeof *f);
+        f->protocol = t.protocol;
+        f->type     = t.type;
+        memcpy(f->name, t.name, sizeof f->name);
+        f->pattern  = t.pattern;
+#ifdef _WIN32
+        InitializeCriticalSection(&f->lock);
+        InitializeConditionVariable(&f->cv);
+#else
+        pthread_mutex_init(&f->lock, NULL);
+        pthread_cond_init(&f->cv, NULL);
+#endif
+        f->active = 1;
+    }
+    return k < 0 ? k : SS_OK;
+}
+#undef EVT_SS_BIT
+#undef EVT_SS_SET
+
