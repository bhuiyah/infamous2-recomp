+        const D3D12DrawRecord* dr = &s_d3d.draws[d];
+        if (!dr->is_vp) continue;
+        memset(&op, 0, sizeof op);
+        op.op = d; op.is_clear = dr->is_clear; op.clr_mask = dr->clr_mask;
+        op.rt_off = dr->rt_off; op.rt_fmt = dr->rt_fmt;
+        op.rt_w = dr->rt_w ? dr->rt_w : s_d3d.width; op.rt_h = dr->rt_h ? dr->rt_h : s_d3d.height;
+        for (int m = 0; m < 3; m++) op.mrt[m] = dr->rt_mrt[m];
+        op.display = (dr->rt_off && (cellGcmOffsetIsDisplay(dr->rt_off) || rd_has(dr->rt_off))) || dr->disp_raw;
+        op.backbuffer_draw = !dr->rt_off && !dr->is_clear;
+        op.zeta_off = dr->zeta_off; op.zeta_bound = depth_model_on();
+        op.ds_key = dr->ds_key;
+        op.vertex_count = dr->vertex_count; op.topology = dr->topology;
+        op.fullscreen = !dr->is_clear && dr->vertex_count <= 4u && dr->vp_w >= op.rt_w && dr->vp_h >= op.rt_h;
+        op.fp_id = dr->fp_shash ? dr->fp_id : dr->fp_addr;
+        for (int u = 0; u < RSX_DRAW_TEX_UNITS && !dr->is_clear; u++) {
+            if (!dr->tex[u].set || (dr->fp_shash && !(dr->fp_texmask & (1u << u)))) continue;   /* READ units only */
+            rsx_rcz_read* rd = &op.rd[op.nread];
