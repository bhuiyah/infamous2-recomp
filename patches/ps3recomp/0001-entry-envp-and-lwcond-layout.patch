+    }
+
+    /* ---- 13. SS_SAVE_AT and SS_CENSUS feed the same slot: both are served,
+     * and the census figures (numbers, summary) count census stops only ---- */
+    {
+        ss_request_stats s0, c0, s1, c1;
+        ss_stats t0, t1;
+        ss_get_request_stats(SS_P_SAVE, &s0);
+        ss_get_request_stats(SS_P_CENSUS, &c0);
+        ss_get_stats(&t0);
+        ss_config both = on;
+        both.period_s = 0.15;
+        both.n_save_at = 3;
+        both.save_at[0] = 0.5; both.save_at[1] = 0.1; both.save_at[2] = 0.3;   /* sorted by ss_configure */
+        strcpy(both.chains_path, chains);
+        ss_configure(&both);
+        run_clock(1500);
+        ss_get_request_stats(SS_P_SAVE, &s1);
+        ss_get_request_stats(SS_P_CENSUS, &c1);
+        ss_get_stats(&t1);
+        printf("phase 13: SS_SAVE_AT saves %u (ok %u), census requests %u; census stops %u of %u\n",
