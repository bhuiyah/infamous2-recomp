+void spurs_ef_set_from_spu(void) { unexpected("spurs_ef_set_from_spu"); }
+void spurs_pm_build_context(void) { unexpected("spurs_pm_build_context"); }
+void ydkj_wake_all_event_flags(void) { unexpected("ydkj_wake_all_event_flags"); }
+/* ppu_memory.h's store hooks (spu_workload.c's guest stores) */
