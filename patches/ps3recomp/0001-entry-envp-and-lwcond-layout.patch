+static void rsx_vf_check(const rsx_vfetch_plan* p, u32 vi, const float* got)
+{
+    static int left = 16;
+    for (u32 si = 0; si < p->nslots && left > 0; si++) {
+        float ref[4];
+        rsx_fetch_attrib(p->st, p->s[si].idx, vi, ref);
+        if (memcmp(ref, got + si * 4, sizeof ref)) {
+            left--;
+            fprintf(stderr, "[VFETCH] MISMATCH vi=%u attr=%u mode=%u type=%u n=%u: got (%g %g %g %g) want (%g %g %g %g)\n",
+                    vi, p->s[si].idx, p->s[si].mode, p->s[si].type, p->s[si].n,
+                    got[si * 4], got[si * 4 + 1], got[si * 4 + 2], got[si * 4 + 3],
+                    ref[0], ref[1], ref[2], ref[3]);
+        }
+    }
+}
