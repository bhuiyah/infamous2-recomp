+static void test_remap_other_formats(void)
+{
+    u8 m[4];
+    /* B8 {1,R,R,R}: identity gives alpha one; inFamous 2's shadow mask
+     * (0xA9FF: RGB from B, A forced one) reads the byte on R,G,B */
+    rsx_texture_component_remap(0xAAE4u, FMT_B8 | FMT_LN, m);
+    CHECK_EQ(m[A_], RSX_REMAP_ONE); CHECK_EQ(m[R_], 0); CHECK_EQ(m[G_], 0); CHECK_EQ(m[B_], 0);
+    rsx_texture_component_remap(0xA9FFu, FMT_B8 | FMT_LN, m);
+    CHECK_EQ(m[A_], RSX_REMAP_ONE); CHECK_EQ(m[R_], 0); CHECK_EQ(m[G_], 0); CHECK_EQ(m[B_], 0);
+    rsx_texture_component_remap(0xAAFFu, FMT_B8, m);
+    for (int i = 0; i < 4; i++) CHECK_EQ(m[i], 0);
+    /* depth and X32_FLOAT: the one value everywhere */
+    const u32 one[] = { FMT_DEPTH24, FMT_DEPTH24F, FMT_DEPTH16, FMT_DEPTH16F, FMT_X32F };
+    for (unsigned k = 0; k < 5; k++) {
+        rsx_texture_component_remap(0xAA1Bu, one[k], m);
+        for (int i = 0; i < 4; i++) CHECK_EQ(m[i], 0);
+    }
+    /* HILO {R,G,R,G} (+ 16-bit-block rewrite) */
+    rsx_texture_component_remap(0xAAE4u, FMT_HILO8, m);
+    CHECK_EQ(m[A_], 0); CHECK_EQ(m[R_], 1); CHECK_EQ(m[G_], 0); CHECK_EQ(m[B_], 1);
+    rsx_texture_component_remap(0xAAE4u, FMT_HILO_S8 | FMT_LN, m);
+    CHECK_EQ(m[R_], 1); CHECK_EQ(m[G_], 0);
+    /* the 4-channel float formats take no crossbar: identity whatever is set */
+    rsx_texture_component_remap(0xAA1Bu, FMT_W16F, m);
+    CHECK_EQ(m[R_], 0); CHECK_EQ(m[G_], 1); CHECK_EQ(m[B_], 2); CHECK_EQ(m[A_], 3);
+    rsx_texture_component_remap(0xAA1Bu, FMT_W32F | FMT_LN, m);
+    CHECK_EQ(m[R_], 0); CHECK_EQ(m[G_], 1); CHECK_EQ(m[B_], 2); CHECK_EQ(m[A_], 3);
+    rsx_texture_component_remap(0x00E4u, FMT_W16F, m);          /* forced zero still applies */
+    for (int i = 0; i < 4; i++) CHECK_EQ(m[i], RSX_REMAP_ZERO);
+    /* Y16_X16_FLOAT {R,G,R,G}, crossbar fixed at 0x66 */
+    rsx_texture_component_remap(0xAA1Bu, FMT_Y16X16F, m);
+    CHECK_EQ(m[A_], 0); CHECK_EQ(m[R_], 1); CHECK_EQ(m[G_], 0); CHECK_EQ(m[B_], 1);
+    /* the packed and 4:2:2 formats decode to RGBA: the A8R8G8B8 lanes */
+    u8 a[4];
+    rsx_texture_component_remap(0xAA1Bu, FMT_A8R8G8B8, a);
+    const u32 rgba[] = { FMT_A1R5G5B5, FMT_A4R4G4B4, FMT_R5G6B5, FMT_R6G5B5, FMT_R5G5B5A1,
+                         FMT_D1R5G5B5, FMT_D8R8G8B8, FMT_B8R8_G8R8, FMT_R8B8_R8G8,
+                         FMT_DXT1, FMT_DXT23, FMT_DXT45 };
+    for (unsigned k = 0; k < sizeof rgba / sizeof rgba[0]; k++) {
+        rsx_texture_component_remap(0xAA1Bu, rgba[k], m);
+        for (int i = 0; i < 4; i++) CHECK_EQ(m[i], a[i]);
+    }
+}
