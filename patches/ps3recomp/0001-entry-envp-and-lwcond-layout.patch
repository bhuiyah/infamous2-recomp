diff --git a/include/ps3emu/overlay.h b/include/ps3emu/overlay.h
new file mode 100644
index 0000000..599ae48
--- /dev/null
+++ b/include/ps3emu/overlay.h
@@ -0,0 +1,65 @@
+/*
+ * ps3recomp - the in-game options overlay: public entry points
+ * (libs/video/ovl.c; the presenting backend's side is libs/video/ovl.h).
+ *
+ * The overlay is a menu drawn over the game window -- tabs of settings from
+ * the settings store (include/ps3emu/options.h), sliders, toggles, choice
+ * lists, tooltips, RESTART / ENV badges, controller hints -- plus an optional
+ * FPS counter and short notices. It is opened with F1 (no modifier), the PS /
+ * Guide / Home button, holding L3+R3 for half a second (menu_pad_combo), or
+ * ovl_open_options(). While it is open the game gets no pad, keyboard or mouse
+ * input, the mouse is free, the motors are off, and the game is paused the
+ * way a PS3's XMB pauses it (options_set_intercepted; pause_mode = off keeps
+ * it running). F11 / Alt+Enter keep working.
+ *
+ * Nothing of it exists until it is first shown: no thread, no swap chain, no
+ * DirectComposition objects (a run that never opens it draws exactly what it
+ * drew before).
+ *
+ * Window menu bar (libs/video/rsx_winmenu.h, where present): plug these in as
+ *   rsx_winmenu_hooks h = { ovl_open_options, "F1", ovl_get_show_fps,
+ *                           ovl_set_show_fps, ovl_notice };
+ *   rsx_winmenu_set_hooks(&h);
+ *
+ * Screen grabs. The overlay is composed by DWM, so a grab of the SCREEN
+ * (tools\kbm_inject.ps1 "shot", the checkpoint READY / AutoSnap screenshots)
+ * would contain it; frame dumps (CELLMARK_DUMP, RSX_CAP) never do. A grabber
+ * in this process brackets its grab with ovl_capture_begin / _end; one in
+ * another process sends the window the registered message
+ * OVL_CAPTURE_MESSAGE (wParam 1 = hide and wait, 0 = show again; the reply is
+ * 1 when something was hidden) -- kbm_inject.ps1 does, unless -WithOverlay.
+ */
+#ifndef PS3EMU_OVERLAY_H
+#define PS3EMU_OVERLAY_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define OVL_CAPTURE_MESSAGE "ps3recomp_overlay_capture"
+
+/* Open the options menu (any thread; the menu bar's View > Options...). */
+void ovl_open_options(void);
+/* Open or close it (any thread). */
+void ovl_toggle_options(void);
+/* 1 while the menu is open. */
+int  ovl_options_open(void);
+
+/* The FPS counter (the store's fps_counter row; saved like any setting). */
+int  ovl_get_show_fps(void);
+void ovl_set_show_fps(int on);
+
+/* A short notice ("Saved to slot 3"), shown for ms milliseconds. Any thread. */
+void ovl_notice(const char* utf8, unsigned ms);
+
+/* Hide everything the overlay shows, and wait (at most timeout_ms) until the
+ * desktop no longer shows it; returns 1 if something was hidden. Pairs with
+ * ovl_capture_end, which shows it again. Any thread except the overlay's own;
+ * nests. */
+int  ovl_capture_begin(unsigned timeout_ms);
+void ovl_capture_end(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* PS3EMU_OVERLAY_H */
diff --git a/include/ps3emu/play_issues.h b/include/ps3emu/play_issues.h
new file mode 100644
index 0000000..dd1d9b0
--- /dev/null
+++ b/include/ps3emu/play_issues.h
@@ -0,0 +1,85 @@
+/*
+ * ps3recomp - the play-session issues log (runtime/diag/play_issues.c)
+ *
+ * A short text file beside the play log -- logs\play-<time>-issues.txt -- holding what a player would
+ * call a problem: frames that took too long (each with what the frame spent its time on), stretches
+ * below the frame-rate target, frames that stopped coming, problem lines from the log, crashes, and
+ * the moments the player marked (F8). Its header names the machine and the settings that are not at
+ * their defaults, so a file someone else sends can be read without asking them anything. It holds no
+ * user or computer name: paths under the profile or the game folder are written relative to them.
+ *
+ * Built to cost nothing while playing, on slower PCs too:
+ *   - the render thread's part (pi_frame) is a few compares and adds per presented frame on memory
+ *     only it touches; a frame worth writing about is copied into a small queue (one short lock);
+ *   - nothing is formatted or written on a game thread: one background thread (lowest CPU and I/O
+ *     priority, efficiency cores where the CPU has them) wakes every two seconds, writes what the
+ *     queue holds and reads what the log gained since its last look;
+ *   - the renderer's timers it reads are the light set (FRAME_TRACE's counters without the per-draw
+ *     ones), so turning this on adds no per-draw work.
+ * The file is written as the session goes: a crash or a kill leaves everything up to the last two
+ * seconds, and a crash adds its own lines (and a small minidump beside the file).
+ *
+ * Off unless started: play mode (the exe started with no arguments) starts it, PLAY_ISSUES=0 keeps it
+ * off there, PLAY_ISSUES=<file> starts it in any run. tools/play_triage.py reads the files.
+ */
+#ifndef PS3EMU_PLAY_ISSUES_H
+#define PS3EMU_PLAY_ISSUES_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(__GNUC__) || defined(__clang__)
+#define PI_PRINTF(f, a) __attribute__((format(printf, f, a)))
+#else
+#define PI_PRINTF(f, a)
+#endif
+
+/* What one presented frame cost (ms), from the renderer's light frame trace. */
+typedef struct pi_frame_info {
+    double interval_ms;      /* since the previous present */
+    double present_ms;       /* Present() held the render thread */
+    double pace_ms;          /* the frame limiter's wait before Present */
+    double render_ms;        /* the render thread's batch work (compiles and uploads included) */
+    double gpu_wait_ms;      /* waits for the GPU to finish earlier work */
+    double game_wait_ms;     /* the render thread idle, waiting for the game to send the frame */
+    double compile_ms;       /* shader compiles, cache reads, waits for a compile worker */
+    double pipeline_ms;      /* pipeline state creation */
+    double readback_ms;      /* GPU results copied back for the game, which waited for them */
+    unsigned compiles, pipelines, readbacks;
+    unsigned tex_uploads, tex_new, new_targets;
+    double tex_mb;
+} pi_frame_info;
+
+/* Start: create `path` (its folder must exist), write the header once the GPU is known (or after a
+ * few seconds), start the writer thread, install the crash handlers. `build` names this build.
+ * Returns 1 when started (0: already started, or the file could not be created). Any thread. */
+int  pi_start(const char* path, const char* build);
+int  pi_active(void);
+
+/* The session's own log (play mode's redirected output): read for problem lines. */
+void pi_set_log(const char* path);
+/* The GPU in use: an IDXGIAdapter* (any version; NULL = unknown). Its name, memory and driver go in
+ * the header; its video-memory budget and use are sampled once a minute. A reference is kept. */
+void pi_set_adapter(void* dxgi_adapter);
+
+/* The render thread, after each present (only it calls this). */
+void pi_frame(const pi_frame_info* f);
+
+/* Context: the game's own events (menus, movies, missions, loads), newest kept. `name` is copied. */
+void pi_signal(const char* name);
+/* A one-off problem the runtime knows about (any thread). */
+PI_PRINTF(1, 2) void pi_note(const char* fmt, ...);
+/* The player marked this moment (F8): the mark's number (1, 2, ..), 0 when off. Any thread. The hook,
+ * when set, is called with the number and a suggested screenshot path (beside the issues file). */
+int  pi_mark(void);
+void pi_set_mark_hook(void (*hook)(int n, const char* shot_path));
+
+/* The session ends (`how`: "quit from the menu", "window closed", ...): write the summary and close
+ * the file. Call from the render thread, or once it has stopped. */
+void pi_end(const char* how);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* PS3EMU_PLAY_ISSUES_H */
