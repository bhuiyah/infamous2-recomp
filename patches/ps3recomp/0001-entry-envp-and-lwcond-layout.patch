+uint64_t sys_event_ss_size(void)
+{
+    uint64_t q = 0, e = 0, p = 0, f = 0;
+    for (int i = 0; i < SYS_EVENT_QUEUE_MAX; i++)
+        if (g_sys_event_queues[i].active) { q++; e += (uint64_t)g_sys_event_queues[i].count; }
+    for (int i = 0; i < SYS_EVENT_PORT_MAX; i++) p += g_sys_event_ports[i].active != 0;
+    for (int i = 0; i < SYS_EVENT_FLAG_MAX; i++) f += g_sys_event_flags[i].active != 0;
+    return 4096u + q * 64u + e * 56u + p * 32u + f * 40u;
