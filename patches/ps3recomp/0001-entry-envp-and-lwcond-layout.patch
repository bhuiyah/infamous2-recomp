+ * and nobody holds a value lock: each live semaphore's handle and lock go,
+ * and the table is empty, as sys_semaphore_init leaves it.
+ * RESTORE: every semaphore at its id with the image's name, protocol, value
+ * and max, no waiter counted, and a new lock and an EMPTY wake channel (any
+ * token the old one held was an orphan; value is the only count) -- the
+ * waiters come back by issuing their waits again, and count themselves.
+ * apply 0 checks the records only (KOBJ's check_image, the world running). */
+void sys_semaphore_ss_teardown(void)
+{
+    for (int i = 0; i < SYS_SEMAPHORE_MAX; i++) {
+        sys_semaphore_info* s = &g_sys_semaphores[i];
