+/* A raw DS3 report 0x01. */
+static void ds3_raw(u8* r, int big_endian_sensors)
+{
+    memset(r, 0, 49);
+    r[0] = 0x01;
+    r[2] = 0x01 | 0x08 | 0x10;          /* SELECT START UP */
+    r[3] = 0x04 | 0x40;                 /* L1 CROSS */
+    r[4] = 0x01;                        /* PS */
+    r[6] = 0x20; r[7] = 0x00; r[8] = 0xFF; r[9] = 0x81;
+    r[14] = 0xC0;                       /* up pressure */
+    r[20] = 0x55;                       /* L1 */
+    r[24] = 0xFF;                       /* cross */
+    r[25] = 0x07;                       /* square (light touch, no bit) */
+    r[30] = 0x03;                       /* battery level 3 -> 50 % */
+    const unsigned s[4] = { 0x01F0, 0x0200, 0x018F, 0x01FA };   /* x, "z", "y", gyro */
+    for (int i = 0; i < 4; i++) {
+        if (big_endian_sensors) { r[41 + 2 * i] = (u8)(s[i] >> 8); r[42 + 2 * i] = (u8)s[i]; }
+        else                    { r[41 + 2 * i] = (u8)s[i]; r[42 + 2 * i] = (u8)(s[i] >> 8); }
+    }
+}
+
+static void check_ds3_state(const PadHostPortState* st, int sixaxis_sys)
+{
+    CHECK_EQ(st->buttons, CELL_PAD_CTRL_SELECT | CELL_PAD_CTRL_START | CELL_PAD_CTRL_UP |
+                          CELL_PAD_CTRL_L1 | CELL_PAD_CTRL_CROSS);
+    CHECK_EQ(st->ps, 1);
+    CHECK_EQ(st->lx, 0x20); CHECK_EQ(st->ly, 0x00); CHECK_EQ(st->rx, 0xFF); CHECK_EQ(st->ry, 0x81);
+    CHECK_EQ(st->press[PADHOST_PRESS_UP], 0xC0); CHECK_EQ(st->press[PADHOST_PRESS_L1], 0x55);
+    CHECK_EQ(st->press[PADHOST_PRESS_CROSS], 0xFF); CHECK_EQ(st->press[PADHOST_PRESS_SQUARE], 0x07);
+    CHECK_EQ(st->press[PADHOST_PRESS_DOWN], 0);
+    CHECK_EQ(st->has_pressure, 1); CHECK_EQ(st->has_motion, 1);
+    CHECK_EQ(st->battery, 50);
+    /* raw: x mirrored (1024 - 0x1F0 = 528), y = word 45, z = word 43, gyro as is;
+     * sixaxis.sys form: all four as delivered */
+    CHECK_EQ(st->sensor_x, sixaxis_sys ? 0x1F0 : 528);
+    CHECK_EQ(st->sensor_y, 0x18F); CHECK_EQ(st->sensor_z, 0x200); CHECK_EQ(st->sensor_g, 0x1FA);
+}
+
+static void test_ds3_native(void)
+{
+    printf("DS3 raw HID: open (0xF2 + 0xF4 42 0C 00 00), report 0x01, 0xFF report dropped, output 0x01\n");
+    mock_reset();
+    u8 f2[18] = { 0xF2, 0xFF, 0xFF, 0x00, 0x00, 0x1E, 0x3D, 0x4C, 0x5B, 0x6A };
+    mock_feature(f2, 18, 0);
+    PadHostDevice* d = new_dev(0x0268, PADHOST_BUS_USB, 49, 49, 49);
+    d->usage = 0x04;
+    CHECK_EQ(padhost_drv_ds3.match(d), 100);
+    CHECK_EQ(padhost_drv_ds3.open(d), 0);
+    CHECK_EQ(g_get_calls[0xF2], 1);
+    CHECK_EQ(g_setfs, 1);
+    CHECK_EQ(g_last_setf_len, 5);
+    { static const u8 en[5] = { 0xF4, 0x42, 0x0C, 0x00, 0x00 }; CHECK(same_bytes(g_last_setf, en, 5, "0xF4 enable")); }
+    CHECK(!strcmp(d->serial, "001e3d4c5b6a"));
+    CHECK_EQ(d->out_set_report, 1);                    /* report 0x01 must go out as SET_REPORT */
+    u8 r[49]; ds3_raw(r, 1);
+    PadHostPortState st; fresh(&st);
+    CHECK_EQ(padhost_drv_ds3.parse(d, r, 49, &st), 1);
+    check_ds3_state(&st, 0);
+    r[30] = 0xEE; fresh(&st); padhost_drv_ds3.parse(d, r, 49, &st); CHECK_EQ(st.battery, 100);
+    r[1] = 0xFF;
+    CHECK_EQ(padhost_drv_ds3.parse(d, r, 49, &st), 0);
+
+    u8 out[64]; memset(out, 0xEE, sizeof out);
+    int n = padhost_drv_ds3.build_output(d, 1, 0x40, 4, out, (int)sizeof out);
+    CHECK_EQ(n, 49);
+    CHECK(same_bytes(out, vec_ds3_out_p4, 36, "DS3 output"));
+    CHECK(zero_from(out, 36, 49));
+
+    /* SET_FEATURE rejected at 5 bytes: retried padded to the feature length. */
+    mock_reset();
+    g_set_feature_fails = 1;
+    d = new_dev(0x0268, PADHOST_BUS_USB, 49, 49, 49);
+    CHECK_EQ(padhost_drv_ds3.open(d), 0);
+}
+
+static void test_ds3_sxs(void)
+{
+    printf("DS3 SIXAXIS.SYS / SXS: feature 0 poll (LE sensors), fallback 12-byte report, output with 02 00 00\n");
+    mock_reset();
+    u8 f0[50]; u8 r[49]; ds3_raw(r, 0);
+    f0[0] = 0x00; f0[1] = 0x00; f0[2] = 0x3F;
+    memcpy(f0 + 3, r + 2, 47);
+    mock_feature(f0, 50, 0);
+    PadHostDevice* d = new_dev(0x0268, PADHOST_BUS_USB, 13, 49, 50);
+    CHECK_EQ(padhost_drv_ds3.open(d), 0);
+    CHECK_EQ(g_setfs, 0);                              /* the driver stack enables the pad */
+    CHECK_EQ(d->out_set_report, 0);                    /* sixaxis.sys / DsHidMini take WriteFile */
+    u8 rep[13] = { 0x00 };
+    PadHostPortState st; fresh(&st);
+    CHECK_EQ(padhost_drv_ds3.parse(d, rep, 13, &st), 1);
+    CHECK_EQ(g_get_calls[0x00], 1);
+    check_ds3_state(&st, 1);
+    /* no input report at all (manager poll on timeout) */
+    fresh(&st);
+    CHECK_EQ(padhost_drv_ds3.parse(d, NULL, 0, &st), 1);
+    check_ds3_state(&st, 1);
+
+    u8 out[64]; memset(out, 0xEE, sizeof out);
+    int n = padhost_drv_ds3.build_output(d, 0, 0xFF, 6, out, (int)sizeof out);
+    CHECK_EQ(n, 49);
+    CHECK(same_bytes(out, vec_ds3_sxs_out_p6, 39, "DS3 SXS output"));
+    CHECK(zero_from(out, 39, 49));
+
+    /* Feature 0 unavailable: the 12-byte joystick report still drives the pad. */
+    mock_reset();
+    d = new_dev(0x0268, PADHOST_BUS_USB, 13, 49, 50);
+    padhost_drv_ds3.open(d);
+    u8 j[13] = { 0x00,
+                 0x04 | 0x40,          /* cross, L1 */
+                 0x01 | 0x10,          /* start, PS */
+                 0x00, 0x06,           /* hat left */
+                 0x10, 0x20, 0x30, 0x40,
+                 0xFF - 0x00, 0xFF - 0xE0, 0xFF - 0x11, 0xFF - 0x22 };
+    fresh(&st);
+    CHECK_EQ(padhost_drv_ds3.parse(d, j, 13, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_L1 | CELL_PAD_CTRL_START | CELL_PAD_CTRL_LEFT);
+    CHECK_EQ(st.ps, 1);
+    CHECK_EQ(st.lx, 0x10); CHECK_EQ(st.ry, 0x40);
+    CHECK_EQ(st.press[PADHOST_PRESS_CROSS], 0xE0); CHECK_EQ(st.press[PADHOST_PRESS_L2], 0x11);
+    CHECK_EQ(st.press[PADHOST_PRESS_R2], 0x22); CHECK_EQ(st.press[PADHOST_PRESS_L1], 255);
+}
+
+static void test_ds3_dshm(void)
+{
+    printf("DS3 DsHidMini SDF / GPJ: buttons, pressure, digital-only mode, GPJ pressure collection refused\n");
+    mock_reset();
+    PadHostDevice* d = new_dev(0x0268, PADHOST_BUS_USB, 37, 0, 0);
+    CHECK_EQ(padhost_drv_ds3.open(d), 0);
+    u8 r[37]; memset(r, 0, sizeof r);
+    r[0] = 0x01; r[1] = 0x11; r[2] = 0x22; r[3] = 0x33; r[4] = 0x44;
+    r[5] = 0x02 | 0x40;                 /* hat right, cross */
+    r[6] = 0x08 | 0x40;                 /* start, L1 */
+    r[7] = 0x01;                        /* PS */
+    r[8] = 0x00; r[9] = 0x90;           /* L2 0, R2 0x90 (no R2 bit: pressure-only mode) */
+    r[11] = 0xA0;                       /* right pressure */
+    r[14] = 0x66;                       /* L1 */
+    r[17] = 0x50;                       /* circle pressure only */
+    r[18] = 0xF0;                       /* cross */
+    PadHostPortState st; fresh(&st);
+    CHECK_EQ(padhost_drv_ds3.parse(d, r, 37, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_RIGHT | CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_START | CELL_PAD_CTRL_L1 |
+                         CELL_PAD_CTRL_CIRCLE | CELL_PAD_CTRL_R2);
+    CHECK_EQ(st.ps, 1);
+    CHECK_EQ(st.lx, 0x11); CHECK_EQ(st.ry, 0x44);
+    CHECK_EQ(st.press[PADHOST_PRESS_RIGHT], 0xA0); CHECK_EQ(st.press[PADHOST_PRESS_L1], 0x66);
+    CHECK_EQ(st.press[PADHOST_PRESS_CIRCLE], 0x50); CHECK_EQ(st.press[PADHOST_PRESS_CROSS], 0xF0);
+    CHECK_EQ(st.press[PADHOST_PRESS_R2], 0x90); CHECK_EQ(st.press[PADHOST_PRESS_SQUARE], 0);
+    CHECK_EQ(st.has_pressure, 1); CHECK_EQ(st.has_motion, 0);
+    /* digital-only mode: bits, no pressure bytes -> 255 */
+    memset(r + 8, 0, 12);
+    r[5] = 0x08 | 0x80;                 /* hat none, square */
+    fresh(&st);
+    padhost_drv_ds3.parse(d, r, 37, &st);
+    CHECK_EQ(st.press[PADHOST_PRESS_SQUARE], 255); CHECK_EQ(st.press[PADHOST_PRESS_L1], 255);
+    CHECK_EQ(st.press[PADHOST_PRESS_CROSS], 0);
+    u8 out[64];
+    CHECK_EQ(padhost_drv_ds3.build_output(d, 1, 255, 0, out, (int)sizeof out), 0);   /* DsHidMini owns output */
+
+    d = new_dev(0x0268, PADHOST_BUS_USB, 12, 0, 0);
+    CHECK_EQ(padhost_drv_ds3.open(d), 0);
+    u8 g[12] = { 0x01, 0x80, 0x80, 0x80, 0x80, 0x08 | 0x20, 0x10 | 0x80, 0x00, 0xFE, 0x00, 0x00, 0x77 };
+    fresh(&st);
+    CHECK_EQ(padhost_drv_ds3.parse(d, g, 12, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CIRCLE | CELL_PAD_CTRL_L2 | CELL_PAD_CTRL_R1);
+    CHECK_EQ(st.press[PADHOST_PRESS_L2], 0xFE); CHECK_EQ(st.press[PADHOST_PRESS_R1], 0x77);
+    CHECK_EQ(st.press[PADHOST_PRESS_CIRCLE], 255);
+
+    d = new_dev(0x0268, PADHOST_BUS_USB, 9, 0, 0);
+    CHECK(padhost_drv_ds3.match(d) > 0);
+    CHECK(padhost_drv_ds3.open(d) != 0);
+}
+
+static void test_ds3_sensor_format_latch(void)
+{
+    printf("DS3 sensor word format: BE raw vs LE processed, latched once unambiguous\n");
+    mock_reset();
+    PadHostDevice* d = new_dev(0x0268, PADHOST_BUS_USB, 49, 49, 49);
+    padhost_drv_ds3.open(d);
+    u8 r[49]; ds3_raw(r, 0);              /* LE words on the raw collection (a filter driver that swaps) */
+    PadHostPortState st; fresh(&st);
+    padhost_drv_ds3.parse(d, r, 49, &st);
+    CHECK_EQ(st.sensor_y, 0x18F); CHECK_EQ(st.sensor_x, 0x1F0);
+    /* a later ambiguous report (all words < 4 in the low byte) keeps the latched format */
+    for (int i = 0; i < 4; i++) { r[41 + 2 * i] = 0x02; r[42 + 2 * i] = 0x02; }
+    fresh(&st);
+    padhost_drv_ds3.parse(d, r, 49, &st);
+    CHECK_EQ(st.sensor_y, 0x202);
+    /* all-zero sensor words: motion not running, neutral kept */
+    memset(r + 41, 0, 8);
+    fresh(&st);
+    padhost_drv_ds3.parse(d, r, 49, &st);
+    CHECK_EQ(st.has_motion, 0); CHECK_EQ(st.sensor_y, PADHOST_SENSOR_NEUTRAL_Y);
+}
+
+static void test_short_reports(void)
+{
+    printf("short / foreign reports are ignored\n");
+    mock_reset();
+    PadHostDevice* d = new_dev(0x0CE6, PADHOST_BUS_USB, 64, 48, 64);
+    padhost_drv_dualsense.open(d);
+    u8 rep[64] = { 0x05 };
+    PadHostPortState st; fresh(&st);
+    CHECK_EQ(padhost_drv_dualsense.parse(d, rep, 64, &st), 0);
+    CHECK_EQ(padhost_drv_dualsense.parse(d, rep, 5, &st), 0);
+    CHECK_EQ(padhost_drv_dualsense.parse(d, NULL, 0, &st), 0);
+    d = new_dev(0x05C4, PADHOST_BUS_USB, 64, 32, 64);
+    padhost_drv_ds4.open(d);
+    CHECK_EQ(padhost_drv_ds4.parse(d, rep, 64, &st), 0);
+    rep[0] = 0x11;                          /* BT report id on a USB pad, but too short for 0x11 */
+    CHECK_EQ(padhost_drv_ds4.parse(d, rep, 40, &st), 0);
+    /* output with a tiny buffer: nothing */
+    u8 out[8];
+    CHECK_EQ(padhost_drv_ds4.build_output(d, 0, 0, 0, out, (int)sizeof out), 0);
+}
+
+int main(void)
+{
+    test_crc();
+    test_match();
+    test_ds4_usb();
+    test_ds4_bt();
+    test_ds4_bt_bad_calibration();
+    test_ds4_dongle();
+    test_ds5_usb();
+    test_ds5_bt();
+    test_ds5_edge_config();
+    test_ds3_native();
+    test_ds3_sxs();
+    test_ds3_dshm();
+    test_ds3_sensor_format_latch();
+    test_short_reports();
+    printf("\n%d checks, %d failed (%d driver log lines)\n", g_checks, g_fail, g_log_lines);
+    return g_fail ? 1 : 0;
+}
