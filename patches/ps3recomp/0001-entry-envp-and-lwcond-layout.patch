+            if (ctx->stop_code == 0x110 && g_spu_pending_evt_valid && !spu_sbx_isolated(ctx)) {
                 spu_channel_read(&ctx->ch_out_mbox);      /* the SPU queue key */
                 ctx->rcv_evt[0] = 0;                      /* CELL_OK */
                 ctx->rcv_evt[1] = g_spu_pending_evt[0];
@@ -435,6 +613,12 @@ uint32_t spu_interp_run_until(spu_context* ctx, uint32_t start_lsa, uint32_t sto
                 for(int k=rn;k>0;k--) fprintf(stderr," %05X", ring[(rc-k)&63]);
                 fprintf(stderr,"\n"); fflush(stderr); _tr--; }
             return ctx->stop_code; }
+        /* SPU_INTERP_IMG: lifted code takes interrupts at its drain hops and
+         * back-edges; interpreting it, stop with one pending so the caller's
+         * drain takes it. After the step, never before: the drain may decline
+         * (g_sn_defer), and checking first would then never advance. */
+        if (g_spu_interp_irq_break && ctx->int_enable && (ctx->event_status & ctx->event_mask)) {
+            g_spu_interp_steps = steps; g_spu_interp_last_pc = ctx->pc; return ctx->pc; }
     }
 }
 
diff --git a/runtime/spu/spu_jobverify.inc b/runtime/spu/spu_jobverify.inc
new file mode 100644
index 0000000..86aec0f
--- /dev/null
+++ b/runtime/spu/spu_jobverify.inc
@@ -0,0 +1,847 @@
+/* spu_jobverify.inc -- SPU_JOB_VERIFY=<ids|lo-hi>[,...][:N]. Included by
+ * spu_channels.c (it uses that file's statics: the halt landing pad, the
+ * SPU_INTERP_IMG list, spu_in_wws_pm), built on spu_sandbox.h.
+ *
+ * Differential check of the lifted WWS job modules (images 200..226) against
+ * the SPU interpreter, with every externally visible side effect of the
+ * interpreted copy sandboxed. The Wws_Job PM (image 120, LS 0xA00) enters a
+ * job through ONE bisle bracket (generated/spu_pm/pm_00887080, region 0x3148):
+ * r0 = link 0x3218, int_enable = 1, pc = LS[0x1320] + LS[LS[0x1320] + 0x10],
+ * drain_ret_pc = 0x3218, spu_indirect_branch(), spu_drain_call(0x3218).
+ * spu_indirect_branch calls spu_job_verify first; for the first N entries of
+ * each listed module it
+ *   1. clones the context -- the entry state, exactly;
+ *   2. runs the REAL lifted job to its return under a recording sandbox:
+ *      every channel op, DMA element (descriptor + bytes), atomic (line +
+ *      result) and PM interrupt (the LS delta and channel state between take
+ *      and iret) is journaled -- observed, never altered;
+ *   3. runs the CLONE from the same entry in the interpreter (image 254:
+ *      nothing lifted, so the PM JobApi code it calls is interpreted too)
+ *      under a replay sandbox: reads answered from the journal, writes
+ *      compared with it and performed nowhere, handler effects applied at the
+ *      same op boundary, bounded in steps and wall clock;
+ *   4. reports the first divergence, the end state (pc, 128 registers, 256 KB
+ *      LS) and the two PUT journals.
+ * Real first: replaying the real job's own inputs (GET bytes, GETLLAR lines,
+ * decrementer, tag / atomic / stall status, mailbox words) is the only way both
+ * runs see the same world while other SPUs and the PPU keep writing -- and the
+ * clone then never reads guest memory and never waits. */
+#include <stdarg.h>
+
+#define JV_CLONE_IMAGE 254           /* registers nothing: pure interpretation */
+enum { JV_XFER = 4, JV_ATOM = 5, JV_IRQ_BEGIN = 6, JV_IRQ_END = 7 };
+static const char* const k_jv_ev[8] = { "?", "wrch", "rdch", "rchcnt", "dma", "atomic",
+                                        "irq-take", "irq-ret" };
+
+typedef struct jv_ev {
+    uint8_t  kind, irq, moved, pad;
+    uint32_t ch;          /* channel; dma/atomic: the MFC command                          */
+    uint32_t val;         /* channel value; dma: rc; atomic: RdAtomicStat; irq-take: srr0  */
+    uint32_t lsa, size;   /* irq-ret: size = changed 16-byte lines                         */
+    uint64_t ea;
+    uint32_t pc, lr;      /* clone: exact; real: last dispatched pc ("near")               */
+    uint32_t st[5];       /* wrch MFC_Cmd: lsa, eah, eal, size, tag at issue               */
+    uint32_t len;         /* payload bytes                                                 */
+    size_t   off;         /* payload offset in the arena                                   */
+} jv_ev;
+
+typedef struct jv_journal {
+    jv_ev*   ev;   uint32_t n, cap;
+    uint8_t* data; size_t used, dcap;
+    int      overflow;
+} jv_journal;
+
+/* Channel-side state an interrupt handler leaves behind. The clone takes no
+ * interrupts; it receives this with the handler's LS delta. */
+typedef struct jv_chstate {
+    uint32_t mfc[5], tag_mask, tag_status, ev_mask, ev_status, atomic_stat, resv_ea;
+    int      resv_valid;
+    uint8_t  resv_line[128];
+    uint32_t stall_mask, stall_stat, elem[32], rem[32], dest[32], cmd[32];
+    uint64_t eab[32];
+} jv_chstate;
+
+typedef struct jv_state {
+    spu_sbx      rec, rp;               /* real (REC) and clone (REPLAY) sandboxes     */
+    jv_journal   real, cput;            /* the real journal; the clone's PUT-class ops */
+    spu_context* sh;                    /* the clone                                   */
+    mfc_engine   eng;                   /* the clone's private MFC engine              */
+    uint8_t*     irq_before;            /* REC: LS at the interrupt take               */
+    uint8_t*     entry_dump;            /* SPU_JOB_VERIFY_DUMP: entry LS + GPRs        */
+    int          irq_depth, irq_open, nirq;
+    uint8_t      irq_dirty[SPU_LS_SIZE / 16 / 8];
+    uint32_t     cur, ops;              /* replay cursor; real non-irq ops matched     */
+    int          img, inv, real_end, stale_ovl;
+    uint32_t     entry, link, codebase;
+    uint32_t     real_pc, real_status, clone_pc, clone_status;
+    unsigned     nmis, ndata, nval;
+    int          first_set;
+    char         first[1536];
+    char         around[1024];          /* the real journal around the first divergence */
+    unsigned long long deadline;
+} jv_state;
+
+/* ---- configuration ------------------------------------------------------- */
+static int                s_jv_on = -1, s_jv_lim = 4, s_jv_strict, s_jv_nlsx;
+static unsigned char      s_jv_list[512];
+static uint32_t           s_jv_link = 0x3218u, s_jv_lsx[8][2];
+static unsigned long long s_jv_steps = 200000000ull, s_jv_ms = 30000ull;
+static size_t             s_jv_maxb = (size_t)64 << 20;
+static unsigned long long s_jv_after_ns, s_jv_t0;  /* SPU_JOB_VERIFY_AFTER=<s>: skip until then */
+static long               s_jv_every = 1;          /* SPU_JOB_VERIFY_EVERY=<k>: every k-th call */
+static const char*        s_jv_dump;
+static const char*        s_jv_jnl;        /* SPU_JOB_VERIFY_JOURNAL=<dir>: the real journal per call */
+static int                s_jv_noclone;    /* SPU_JOB_VERIFY_NOCLONE=1: journal only, no replay       */
+static volatile long      s_jv_cnt[512];
+static SPU_TLS int        t_jv_busy;
+static SPU_TLS spu_sbx*   t_jv_sbx;
+static spu_sbx* jv_sbx_cur(void) { return t_jv_sbx; }
+
+static volatile long s_jv_once;                 /* 0 idle, 1 initialising */
+static void jv_init(void)
+{
+    /* SPU threads start together: one parses, the rest wait for s_jv_on. */
+    if (_InterlockedCompareExchange(&s_jv_once, 1, 0) != 0) {
+        while (*(volatile int*)&s_jv_on < 0) Sleep(0);
+        return;
+    }
+    const char* e = getenv("SPU_JOB_VERIFY"); int any = 0;
+    while (e && *e && *e != ':') {                 /* ids and lo-hi ranges, ',' separated */
+        char* end; long lo = strtol(e, &end, 0), hi = lo;
+        if (end == e) break;
+        if (*end == '-') { const char* s2 = end + 1; hi = strtol(s2, &end, 0); if (end == s2) hi = lo; }
+        for (long i = lo; i <= hi && i < 512; i++) if (i > 0) { s_jv_list[i] = 1; any = 1; }
+        e = end; if (*e == ',') e++;
+    }
+    if (e && *e == ':') s_jv_lim = atoi(e + 1);
+    const char* v;
+    if ((v = getenv("SPU_JOB_VERIFY_LINK")))  s_jv_link = (uint32_t)strtoul(v, 0, 0) & SPU_LS_MASK;
+    if ((v = getenv("SPU_JOB_VERIFY_STEPS"))) s_jv_steps = strtoull(v, 0, 0);
+    if ((v = getenv("SPU_JOB_VERIFY_MS")))    s_jv_ms = strtoull(v, 0, 0);
+    if ((v = getenv("SPU_JOB_VERIFY_MAXMB"))) s_jv_maxb = (size_t)strtoul(v, 0, 0) << 20;
+    if ((v = getenv("SPU_JOB_VERIFY_AFTER"))) s_jv_after_ns = (unsigned long long)(atof(v) * 1e9);
+    if ((v = getenv("SPU_JOB_VERIFY_EVERY"))) { s_jv_every = atol(v); if (s_jv_every < 1) s_jv_every = 1; }
+    s_jv_t0 = spu_host_ns();
+    s_jv_strict = getenv("SPU_JOB_VERIFY_STRICT") != 0;
+    s_jv_dump   = getenv("SPU_JOB_VERIFY_DUMP");
+    s_jv_jnl    = getenv("SPU_JOB_VERIFY_JOURNAL");
+    s_jv_noclone = getenv("SPU_JOB_VERIFY_NOCLONE") != 0;
+    for (v = getenv("SPU_JOB_VERIFY_LSX"); v && *v && s_jv_nlsx < 8; ) {   /* hex lo-hi[,lo-hi] */
+        char* end; uint32_t lo = (uint32_t)strtoul(v, &end, 16), hi = lo + 16;
+        if (end == v) break;
+        if (*end == '-') { v = end + 1; hi = (uint32_t)strtoul(v, &end, 16); }
+        s_jv_lsx[s_jv_nlsx][0] = lo; s_jv_lsx[s_jv_nlsx][1] = hi; s_jv_nlsx++;
+        v = (*end == ',') ? end + 1 : end;
+    }
+    if (any) {
+        g_spu_sbx_cur = jv_sbx_cur;
+        fprintf(stderr, "[job-verify] armed SPU_JOB_VERIFY=%s: first %d invocation(s) per module, "
+                "link 0x%05X, clone budget %llu steps / %llu ms\n",
+                getenv("SPU_JOB_VERIFY"), s_jv_lim, s_jv_link, s_jv_steps, s_jv_ms);
+    }
+    _InterlockedExchange((volatile long*)&s_jv_on, any);
+}
+
+static uint32_t jv_be32(const uint8_t* q)
+{
+    return ((uint32_t)q[0] << 24) | ((uint32_t)q[1] << 16) | ((uint32_t)q[2] << 8) | q[3];
+}
+
+/* ---- journal ------------------------------------------------------------- */
+/* jv_push may move j->ev: never hold an event pointer across a later push. */
+static jv_ev* jv_push(jv_journal* j, const spu_context* c, int kind, int irq)
+{
+    if (j->overflow || (size_t)j->n * sizeof(jv_ev) + j->used >= s_jv_maxb) { j->overflow = 1; return NULL; }
+    if (j->n == j->cap) {
+        const uint32_t nc = j->cap ? j->cap * 2u : 4096u;
+        jv_ev* p = (jv_ev*)realloc(j->ev, (size_t)nc * sizeof *p);
+        if (!p) { j->overflow = 1; return NULL; }
+        j->ev = p; j->cap = nc;
+    }
+    jv_ev* e = &j->ev[j->n++];
+    memset(e, 0, sizeof *e);
+    e->kind = (uint8_t)kind; e->irq = (uint8_t)irq;
+    e->pc = c->pc & SPU_LS_MASK; e->lr = c->gpr[0]._u32[0] & SPU_LS_MASK;
+    return e;
+}
+static int jv_append(jv_journal* j, const void* p, size_t n)
+{
+    if (j->overflow || (size_t)j->n * sizeof(jv_ev) + j->used + n > s_jv_maxb) { j->overflow = 1; return 0; }
+    if (j->used + n > j->dcap) {
+        size_t nc = j->dcap ? j->dcap : ((size_t)1 << 20);
+        while (nc < j->used + n) nc *= 2;
+        uint8_t* q = (uint8_t*)realloc(j->data, nc);
+        if (!q) { j->overflow = 1; return 0; }
+        j->data = q; j->dcap = nc;
+    }
+    memcpy(j->data + j->used, p, n); j->used += n;
+    return 1;
+}
+static void jv_payload(jv_journal* j, jv_ev* e, const uint8_t* p, uint32_t n)
+{
+    const size_t at = j->used;
+    if (e && n && jv_append(j, p, n)) { e->off = at; e->len = n; }
+}
+
+static void jv_ch_get(const spu_context* c, jv_chstate* s)
+{
+    s->mfc[0] = c->mfc_lsa; s->mfc[1] = c->mfc_eah; s->mfc[2] = c->mfc_eal;
+    s->mfc[3] = c->mfc_size; s->mfc[4] = c->mfc_tag;
+    s->tag_mask = c->mfc_tag_mask; s->tag_status = c->mfc_tag_status;
+    s->ev_mask = c->event_mask; s->ev_status = c->event_status; s->atomic_stat = c->atomic_stat;
+    s->resv_ea = c->resv_ea; s->resv_valid = c->resv_valid;
+    memcpy(s->resv_line, c->resv_line, sizeof s->resv_line);
+    s->stall_mask = c->list_stall_mask; s->stall_stat = c->list_stall_stat;
+    memcpy(s->elem, c->list_stall_elem_lsa, sizeof s->elem);
+    memcpy(s->rem,  c->list_stall_remaining, sizeof s->rem);
+    memcpy(s->dest, c->list_stall_dest_lsa, sizeof s->dest);
+    memcpy(s->cmd,  c->list_stall_cmd, sizeof s->cmd);
+    memcpy(s->eab,  c->list_stall_ea_base, sizeof s->eab);
+}
+static void jv_ch_put(spu_context* c, const jv_chstate* s)
+{
+    c->mfc_lsa = s->mfc[0]; c->mfc_eah = s->mfc[1]; c->mfc_eal = s->mfc[2];
+    c->mfc_size = s->mfc[3]; c->mfc_tag = s->mfc[4];
+    c->mfc_tag_mask = s->tag_mask; c->mfc_tag_status = s->tag_status;
+    c->event_mask = s->ev_mask; c->event_status = s->ev_status; c->atomic_stat = s->atomic_stat;
+    c->resv_ea = s->resv_ea; c->resv_valid = s->resv_valid;
+    memcpy(c->resv_line, s->resv_line, sizeof s->resv_line);
+    c->list_stall_mask = s->stall_mask; c->list_stall_stat = s->stall_stat;
+    memcpy(c->list_stall_elem_lsa,  s->elem, sizeof s->elem);
+    memcpy(c->list_stall_remaining, s->rem,  sizeof s->rem);
+    memcpy(c->list_stall_dest_lsa,  s->dest, sizeof s->dest);
+    memcpy(c->list_stall_cmd,       s->cmd,  sizeof s->cmd);
+    memcpy(c->list_stall_ea_base,   s->eab,  sizeof s->eab);
+}
+
+/* ---- REC: the real job (observe only) ------------------------------------ */
+static void jv_rec_chan(spu_sbx* sb, spu_context* c, int kind, uint32_t ch, uint32_t v)
+{
+    jv_state* J = (jv_state*)sb->priv;
+    jv_ev* e = jv_push(&J->real, c, kind, J->irq_depth > 0);
+    if (!e) return;
+    e->ch = ch; e->val = v;
+    if (kind == SPU_SBX_EV_WRCH && ch == MFC_Cmd) {
+        e->st[0] = c->mfc_lsa; e->st[1] = c->mfc_eah; e->st[2] = c->mfc_eal;
+        e->st[3] = c->mfc_size; e->st[4] = c->mfc_tag;
+    }
+}
+static void jv_rec_xfer(spu_sbx* sb, spu_context* c, uint32_t lsa, uint64_t ea,
+                        uint32_t size, uint32_t cmd, int rc)
+{
+    jv_state* J = (jv_state*)sb->priv;
+    const int irq = J->irq_depth > 0;
+    jv_ev* e = jv_push(&J->real, c, JV_XFER, irq);
+    if (!e) return;
+    e->ch = cmd; e->lsa = lsa; e->ea = ea; e->size = size;
+    e->val = (uint32_t)rc; e->moved = (uint8_t)sb->moved;
+    const uint32_t m = lsa & SPU_LS_MASK;
+    if (e->moved && !irq && size <= MFC_MAX_DMA_SIZE && m + size <= SPU_LS_SIZE)
+        jv_payload(&J->real, e, c->ls + m, size);   /* GET: what landed; PUT: what was sent */
+}
+static void jv_rec_atomic(spu_sbx* sb, spu_context* c, uint32_t cmd)
+{
+    jv_state* J = (jv_state*)sb->priv;
+    const int irq = J->irq_depth > 0;
+    jv_ev* e = jv_push(&J->real, c, JV_ATOM, irq);
+    if (!e) return;
+    e->ch = cmd; e->ea = c->mfc_eal & ~127u; e->lsa = c->mfc_lsa & SPU_LS_MASK;
+    e->size = MFC_ATOMIC_LINE; e->val = c->atomic_stat; e->moved = 1;
+    if (!irq && e->lsa + MFC_ATOMIC_LINE <= SPU_LS_SIZE)   /* GETLLAR: line landed; PUT*: store data */
+        jv_payload(&J->real, e, c->ls + e->lsa, MFC_ATOMIC_LINE);
+}
+static void jv_rec_irq(spu_sbx* sb, spu_context* c, int begin)
+{
+    jv_state* J = (jv_state*)sb->priv;
+    if (begin) {
+        if (J->irq_depth++ == 0) {
+            memcpy(J->irq_before, c->ls, SPU_LS_SIZE);
+            jv_ev* e = jv_push(&J->real, c, JV_IRQ_BEGIN, 1);
+            if (e) e->val = c->srr0 & SPU_LS_MASK;
+            J->nirq++;
+        }
+        return;
+    }
+    if (J->irq_depth == 0 || --J->irq_depth != 0) return;
+    jv_ev* e = jv_push(&J->real, c, JV_IRQ_END, 1);
+    if (!e) return;
+    const size_t at = J->real.used; uint32_t nl = 0;
+    for (uint32_t a = 0; a < SPU_LS_SIZE; a += 16) {
+        if (!memcmp(c->ls + a, J->irq_before + a, 16)) continue;
+        J->irq_dirty[a >> 7] |= (uint8_t)(1u << ((a >> 4) & 7));
+        if (!jv_append(&J->real, &a, 4) || !jv_append(&J->real, c->ls + a, 16)) return;
+        nl++;
+    }
+    jv_chstate cs; jv_ch_get(c, &cs);
+    if (!jv_append(&J->real, &cs, sizeof cs)) return;
+    e->off = at; e->len = (uint32_t)(J->real.used - at); e->size = nl;
+}
+
+/* ---- REPLAY: the clone (nothing leaves it) ------------------------------- */
+static void jv_note(jv_state* J, int diverge, const char* fmt, ...) __attribute__((format(printf, 3, 4)));
+static void jv_note(jv_state* J, int diverge, const char* fmt, ...)
+{
+    J->nmis++;
+    if (!J->first_set) {
+        va_list ap; va_start(ap, fmt);
+        int n = vsnprintf(J->first, sizeof J->first, fmt, ap);
+        va_end(ap);
+        if (n > 0 && (size_t)n < sizeof J->first) {     /* the clone's last 16 pcs */
+            n += snprintf(J->first + n, sizeof J->first - (size_t)n, " | clone path:");
+            const uint64_t s = J->rp.steps;
+            for (uint64_t i = s > 16 ? s - 16 : 0; i < s && n > 0 && (size_t)n < sizeof J->first; i++)
+                n += snprintf(J->first + n, sizeof J->first - (size_t)n, " %05X", J->rp.ring[i & 31]);
+        }
+        J->first_set = 1;
+        /* the real journal around the cursor: #index kind ch value pc [irq] */
+        int q = 0; const uint32_t lo = J->cur > 6 ? J->cur - 6 : 0;
+        for (uint32_t i = lo; i < J->real.n && i < J->cur + 3 && q >= 0 && (size_t)q < sizeof J->around; i++) {
+            const jv_ev* e = &J->real.ev[i];
+            q += snprintf(J->around + q, sizeof J->around - (size_t)q, "%s#%u %s%s 0x%X=0x%X pc 0x%05X%s",
+                          i == lo ? "" : " |", i, i == J->cur ? ">" : "", k_jv_ev[e->kind & 7], e->ch, e->val,
+                          e->pc, e->irq ? " irq" : "");
+        }
+    }
+    if (diverge) J->rp.abort = SPU_SBX_ABORT_DIVERGED;
+}
+/* Apply every interrupt block that comes next: the handler's LS delta and
+ * channel state. Lifted code takes an interrupt at a trampoline transfer, so
+ * the real handler ran just before the code at srr0 -- somewhere between two
+ * ops. Applying it at the earlier op boundary let the clone read state the
+ * handler had not written yet (or overwrite what it had): unforced, the block
+ * waits until the clone's next pc is srr0 (the interpreter calls jv_at_pc);
+ * forced -- the next op is due, or the clone ended -- it lands now. */
+static void jv_apply_irq(jv_state* J, int force)
+{
+    while (J->cur < J->real.n && J->real.ev[J->cur].kind == JV_IRQ_BEGIN) {
+        const uint32_t srr0 = J->real.ev[J->cur].val & SPU_LS_MASK;
+        if (!force && (J->sh->pc & SPU_LS_MASK) != srr0) {
+            J->rp.wait = 1; J->rp.wait_pc = srr0;
+            return;
+        }
+        J->rp.wait = 0;
+        uint32_t k = J->cur + 1;
+        while (k < J->real.n && J->real.ev[k].kind != JV_IRQ_END) k++;
+        if (k >= J->real.n) { J->irq_open = 1; J->cur = J->real.n; J->rp.wait = 0; return; }   /* real ended inside it */
+        const jv_ev* e = &J->real.ev[k];
+        const uint8_t* p = J->real.data + e->off;
+        for (uint32_t i = 0; i < e->size; i++, p += 20) {
+            uint32_t a; memcpy(&a, p, 4);
+            if (a + 16 <= SPU_LS_SIZE) memcpy(J->sh->ls + a, p + 4, 16);
+        }
+        if (e->len == e->size * 20u + sizeof(jv_chstate)) {
+            jv_chstate cs; memcpy(&cs, p, sizeof cs); jv_ch_put(J->sh, &cs);
+        }
+        J->cur = k + 1;
+    }
+}
+/* After a replayed op: only ARM the next interrupt block (wait for srr0).
+ * Applying it here with force=0 would fire when srr0 happens to be the pc of
+ * the channel op just replayed -- one instruction early, before that op's own
+ * successor ran; the interpreter's at_pc hook applies it at the next srr0. */
+static void jv_arm_irq(jv_state* J)
+{
+    if (J->cur < J->real.n && J->real.ev[J->cur].kind == JV_IRQ_BEGIN) {
+        J->rp.wait = 1; J->rp.wait_pc = J->real.ev[J->cur].val & SPU_LS_MASK;
+    }
+}
+static const jv_ev* jv_take(jv_state* J, spu_context* sh, int kind, uint32_t ch)
+{
+    jv_apply_irq(J, 1);
+    if (J->cur >= J->real.n) {
+        jv_note(J, 1, "op #%u: clone %s 0x%X at pc 0x%05X (lr 0x%05X), but the real job issued no further op",
+                J->ops + 1, k_jv_ev[kind & 7], ch, sh->pc & SPU_LS_MASK, sh->gpr[0]._u32[0] & SPU_LS_MASK);
+        return NULL;
+    }
+    const jv_ev* e = &J->real.ev[J->cur];
+    if (e->kind != kind || e->ch != ch) {
+        jv_note(J, 1, "op #%u: real %s 0x%X (near pc 0x%05X lr 0x%05X) / clone %s 0x%X (pc 0x%05X lr 0x%05X)",
+                J->ops + 1, k_jv_ev[e->kind & 7], e->ch, e->pc, e->lr, k_jv_ev[kind & 7], ch,
+                sh->pc & SPU_LS_MASK, sh->gpr[0]._u32[0] & SPU_LS_MASK);
+        return NULL;
+    }
+    J->cur++; J->ops++;
+    return e;
+}
+static void jv_hex16(char* o, size_t cap, const uint8_t* p, uint32_t n)
+{
+    int k = 0; o[0] = 0;
+    for (uint32_t i = 0; i < n && i < 16 && (size_t)k + 4 < cap; i++)
+        k += snprintf(o + k, cap - (size_t)k, "%02X%s", p[i], (i & 3) == 3 ? " " : "");
+}
+/* First differing byte of a written payload, with its 16-byte window both ways. */
+static void jv_cmp(jv_state* J, const char* what, uint32_t cmd, uint64_t ea, uint32_t lsa,
+                   const uint8_t* r, const uint8_t* c, uint32_t n, uint32_t cpc, uint32_t rpc)
+{
+    uint32_t o = 0;
+    while (o < n && r[o] == c[o]) o++;
+    if (o == n) return;
+    const uint32_t w = o & ~15u, wn = (n - w) < 16 ? (n - w) : 16;
+    char a[64], b[64]; jv_hex16(a, sizeof a, r + w, wn); jv_hex16(b, sizeof b, c + w, wn);
+    J->ndata++;
+    jv_note(J, 0, "op #%u %s cmd 0x%02X ea=0x%08X size=0x%X: first byte diff at +0x%X (ea 0x%08X, ls 0x%05X); "
+            "+0x%X real [%s] clone [%s] (clone pc 0x%05X, real near 0x%05X)",
+            J->ops, what, cmd, (uint32_t)ea, n, o, (uint32_t)ea + o, (lsa + o) & SPU_LS_MASK, w, a, b, cpc, rpc);
+}
+/* The clone's PUT-class ops, for the end-of-run ordered PUT comparison. */
+static void jv_put_clone(jv_state* J, spu_context* sh, int kind, uint32_t cmd, uint64_t ea,
+                         uint32_t m, uint32_t n)
+{
+    jv_ev* ce = jv_push(&J->cput, sh, kind, 0);
+    if (!ce) return;
+    ce->ch = cmd; ce->ea = ea; ce->lsa = m; ce->size = n; ce->moved = 1;
+    jv_payload(&J->cput, ce, sh->ls + m, n);
+}
+static uint32_t jv_rdch(spu_sbx* sb, spu_context* sh, uint32_t ch)
+{
+    jv_state* J = (jv_state*)sb->priv;
+    if (sb->abort) return 0;
+    const jv_ev* e = jv_take(J, sh, SPU_SBX_EV_RDCH, ch);
+    if (!e) return 0;
+    const uint32_t v = e->val;          /* the value the lifted job read: never blocks */
+    jv_arm_irq(J);
+    return v;
+}
+static uint32_t jv_rchcnt(spu_sbx* sb, spu_context* sh, uint32_t ch)
+{
+    jv_state* J = (jv_state*)sb->priv;
+    if (sb->abort) return 0;
+    const jv_ev* e = jv_take(J, sh, SPU_SBX_EV_RCHCNT, ch);
+    if (!e) return 0;
+    const uint32_t v = e->val;
+    jv_arm_irq(J);
+    return v;
+}
+static void jv_atomic(jv_state* J, spu_context* sh, uint32_t cmd)
+{
+    const uint32_t ea = sh->mfc_eal & ~127u, lsa = sh->mfc_lsa & SPU_LS_MASK;
+    const jv_ev* e = jv_take(J, sh, JV_ATOM, cmd);
+    if (!e) return;
+    if ((uint32_t)e->ea != ea || e->lsa != lsa) {
+        jv_note(J, 1, "op #%u atomic 0x%02X operands: real ea=0x%08X lsa=0x%05X / clone ea=0x%08X lsa=0x%05X (clone pc 0x%05X)",
+                J->ops, cmd, (uint32_t)e->ea, e->lsa, ea, lsa, sh->pc & SPU_LS_MASK);
+        return;
+    }
+    const int line = e->len == MFC_ATOMIC_LINE && lsa + MFC_ATOMIC_LINE <= SPU_LS_SIZE;
+    if (cmd == MFC_GETLLAR_CMD) {               /* the line the lifted job reserved */
+        if (line) {
+            memcpy(sh->ls + lsa, J->real.data + e->off, MFC_ATOMIC_LINE);
+            memcpy(sh->resv_line, J->real.data + e->off, MFC_ATOMIC_LINE);
+        }
+        sh->resv_ea = ea; sh->resv_valid = 1;
+    } else {
+        /* PUTLLC that failed stores nothing; PUTLLC success / PUTLLUC store the line */
+        if (line && (cmd != MFC_PUTLLC_CMD || e->val == 0)) {
+            jv_put_clone(J, sh, JV_ATOM, cmd, ea, lsa, MFC_ATOMIC_LINE);
+            jv_cmp(J, cmd == MFC_PUTLLC_CMD ? "PUTLLC line" : "PUTLLUC line", cmd, ea, lsa,
+                   J->real.data + e->off, sh->ls + lsa, MFC_ATOMIC_LINE, sh->pc & SPU_LS_MASK, e->pc);
+        }
+        sh->resv_valid = 0;
+    }
+    sh->atomic_stat = e->val;                  /* retry loops run as often as the lifted job's */
+}
+static void jv_wrch(spu_sbx* sb, spu_context* sh, uint32_t ch, uint32_t v)
+{
+    jv_state* J = (jv_state*)sb->priv;
+    if (sb->abort) return;
+    const jv_ev* e = jv_take(J, sh, SPU_SBX_EV_WRCH, ch);
+    if (!e) return;
+    if (e->val != v) {
+        J->nval++;
+        jv_note(J, 0, "op #%u wrch ch%u: real 0x%08X / clone 0x%08X (clone pc 0x%05X, real near 0x%05X)",
+                J->ops, ch, e->val, v, sh->pc & SPU_LS_MASK, e->pc);
+    } else if (ch == MFC_Cmd &&
+               (e->st[0] != sh->mfc_lsa || e->st[1] != sh->mfc_eah || e->st[2] != sh->mfc_eal ||
+                e->st[3] != sh->mfc_size || e->st[4] != sh->mfc_tag)) {
+        J->nval++;
+        jv_note(J, 0, "op #%u MFC cmd 0x%02X operands: real lsa=0x%05X ea=0x%08X%08X size=0x%X tag=%u / "
+                "clone lsa=0x%05X ea=0x%08X%08X size=0x%X tag=%u (clone pc 0x%05X)",
+                J->ops, v, e->st[0], e->st[1], e->st[2], e->st[3], e->st[4],
+                sh->mfc_lsa, sh->mfc_eah, sh->mfc_eal, sh->mfc_size, sh->mfc_tag, sh->pc & SPU_LS_MASK);
+    }
+    switch (ch) {                      /* clone-local effects only */
+    case MFC_Cmd:
+        if (spu_sbx_is_atomic(v)) jv_atomic(J, sh, v);
+        else mfc_channel_write(&J->eng, sh, ch, v);   /* the real executor, private engine */
+        break;
+    case MFC_LSA: case MFC_EAH: case MFC_EAL: case MFC_Size: case MFC_TagID:
+    case MFC_WrTagMask: case MFC_WrTagUpdate: case MFC_WrListStallAck:
+        mfc_channel_write(&J->eng, sh, ch, v);
+        if (ch == MFC_WrTagUpdate && v && (sh->event_mask & 1u)) sh->event_status |= 1u;
+        break;
+    case SPU_WrEventMask: sh->event_mask = v; break;
+    case SPU_WrEventAck:  sh->event_status &= ~v; break;
+    case SPU_WrSRR0:      sh->srr0 = v; break;
+    case SPU_WrDec:       sh->decrementer = v; break;
+    default:              break;      /* mailboxes, MSSync, unknown: compared, never delivered */
+    }
+    if (!sb->abort) jv_arm_irq(J);
+}
+static int jv_xfer(spu_sbx* sb, spu_context* sh, uint32_t lsa, uint64_t ea, uint32_t size, uint32_t cmd)
+{
+    jv_state* J = (jv_state*)sb->priv;
+    if (sb->abort) return -1;
+    const jv_ev* e = jv_take(J, sh, JV_XFER, cmd);
+    if (!e) return -1;
+    if (e->lsa != lsa || e->ea != ea || e->size != size) {
+        jv_note(J, 1, "op #%u DMA cmd 0x%02X descriptor: real lsa=0x%05X ea=0x%08X%08X size=0x%X / "
+                "clone lsa=0x%05X ea=0x%08X%08X size=0x%X (clone pc 0x%05X, real near 0x%05X)",
+                J->ops, cmd, e->lsa, (uint32_t)(e->ea >> 32), (uint32_t)e->ea, e->size,
+                lsa, (uint32_t)(ea >> 32), (uint32_t)ea, size, sh->pc & SPU_LS_MASK, e->pc);
+        return -1;
+    }
+    const uint32_t m = lsa & SPU_LS_MASK;
+    if (e->moved && mfc_is_get(cmd)) {
+        if (e->len != size || m + size > SPU_LS_SIZE) { sb->abort = SPU_SBX_ABORT_OVERFLOW; return -1; }
+        memcpy(sh->ls + m, J->real.data + e->off, size);      /* the bytes the lifted job got */
+    } else if (e->moved && mfc_is_put(cmd) && e->len == size && m + size <= SPU_LS_SIZE) {
+        jv_put_clone(J, sh, JV_XFER, cmd, ea, m, size);
+        jv_cmp(J, "PUT data", cmd, ea, m, J->real.data + e->off, sh->ls + m, size,
+               sh->pc & SPU_LS_MASK, e->pc);
+    }
+    return (int)e->val;                       /* rejected transfers fail the same way */
+}
+static void jv_at_pc(spu_sbx* sb, spu_context* sh)
+{
+    (void)sh;
+    jv_state* J = (jv_state*)sb->priv;
+    if (!sb->abort) jv_apply_irq(J, 0);
+}
+static int jv_poll(spu_sbx* sb, spu_context* sh)
+{
+    (void)sh;
+    if (GetTickCount64() > ((jv_state*)sb->priv)->deadline) { sb->abort = SPU_SBX_ABORT_TIME; return 1; }
+    return 0;
+}
+static const spu_sbx_ops k_jv_ops = {
+    jv_rec_chan, jv_rec_xfer, jv_rec_atomic, jv_rec_irq,
+    jv_wrch, jv_rdch, jv_rchcnt, jv_xfer, jv_poll, jv_at_pc
+};
+
+/* ---- compare and report -------------------------------------------------- */
+static int jv_is_real_put(const jv_ev* e)
+{
+    if (e->irq || !e->len) return 0;
+    if (e->kind == JV_XFER) return e->moved && mfc_is_put(e->ch);
+    if (e->kind == JV_ATOM) return (e->ch == MFC_PUTLLC_CMD && e->val == 0) ||
+                                   e->ch == MFC_PUTLLUC_CMD || e->ch == MFC_PUTQLLUC_CMD;
+    return 0;
+}
+static int jv_lsx(uint32_t a)
+{
+    for (int i = 0; i < s_jv_nlsx; i++) if (a + 16 > s_jv_lsx[i][0] && a < s_jv_lsx[i][1]) return 1;
+    return 0;
+}
+static const char* jv_abort_name(int a)
+{
+    switch (a) {
+    case 0:                      return "";
+    case SPU_SBX_ABORT_DIVERGED: return " [clone stopped at the first I/O divergence]";
+    case SPU_SBX_ABORT_STEPS:    return " [clone stopped: step budget, SPU_JOB_VERIFY_STEPS]";
+    case SPU_SBX_ABORT_TIME:     return " [clone stopped: wall-clock budget, SPU_JOB_VERIFY_MS]";
+    case SPU_SBX_ABORT_OVERFLOW: return " [clone stopped: journal payload missing]";
+    default:                     return " [clone stopped: spu_halt/restart longjmp]";
+    }
+}
+static void jv_dump_ctx(const jv_state* J, const char* tag, const uint8_t* ls, const void* gpr)
+{
+    char fn[640]; snprintf(fn, sizeof fn, "%s/jv_%d_%d_%s.bin", s_jv_dump, J->img, J->inv, tag);
+    FILE* fp = fopen(fn, "wb");
+    if (!fp) return;
+    fwrite(ls, 1, SPU_LS_SIZE, fp); fwrite(gpr, 1, 128 * 16, fp); fclose(fp);
+}
+static void jv_report(jv_state* J, const spu_context* real)
+{
+    const size_t cap = 12288; char* buf = (char*)malloc(cap);
+    if (!buf) return;
+    int p = 0;
+#define JP(...) do { if (p >= 0 && (size_t)p < cap) p += snprintf(buf + p, cap - (size_t)p, __VA_ARGS__); } while (0)
+    JP("[job-verify] img=%d #%d entry=0x%05X (code 0x%05X+0x%X) spu=0x%X", J->img, J->inv, J->entry,
+       J->codebase, J->entry - J->codebase, real->spu_id);
+    if (J->stale_ovl) JP(" [WARNING: stale resident_ovl %d has a lifted function at the entry]", J->stale_ovl);
+    if (J->real.overflow) {
+        JP(": NOT VERIFIED -- the real job's journal passed %u MB (SPU_JOB_VERIFY_MAXMB)\n", (unsigned)(s_jv_maxb >> 20));
+    } else {
+        spu_context* const sh = J->sh;
+        if (!J->rp.abort) {                  /* real ops the clone never issued */
+            jv_apply_irq(J, 1);
+            unsigned left = 0; const jv_ev* nx = NULL;
+            for (uint32_t i = J->cur; i < J->real.n; i++) {
+                const jv_ev* e = &J->real.ev[i];
+                if (e->irq || e->kind >= JV_IRQ_BEGIN) continue;
+                if (!nx) nx = e;
+                left++;
+            }
+            if (left)
+                jv_note(J, 0, "clone ended at pc 0x%05X (status 0x%X) with %u real op(s) left; next real op #%u: "
+                        "%s 0x%X lsa=0x%05X ea=0x%08X near pc 0x%05X", J->clone_pc, J->clone_status, left,
+                        J->ops + 1, k_jv_ev[nx->kind & 7], nx->ch, nx->lsa, (uint32_t)nx->ea, nx->pc);
+        }
+        unsigned nreal = 0, nirqops = 0;
+        for (uint32_t i = 0; i < J->real.n; i++) {
+            const jv_ev* e = &J->real.ev[i];
+            if (e->kind < JV_IRQ_BEGIN) { if (e->irq) nirqops++; else nreal++; }
+        }
+        int ngd = 0; char gl[720]; int gp = 0; gl[0] = 0;
+        for (int r = 0; r < 128; r++) {
+            if (!memcmp(&sh->gpr[r], &real->gpr[r], 16)) continue;
+            if (ngd < 4 && gp >= 0 && (size_t)gp < sizeof gl)
+                gp += snprintf(gl + gp, sizeof gl - (size_t)gp, " r%d lift=%08X.%08X.%08X.%08X interp=%08X.%08X.%08X.%08X", r,
+                               real->gpr[r]._u32[0], real->gpr[r]._u32[1], real->gpr[r]._u32[2], real->gpr[r]._u32[3],
+                               sh->gpr[r]._u32[0], sh->gpr[r]._u32[1], sh->gpr[r]._u32[2], sh->gpr[r]._u32[3]);
+            ngd++;
+        }
+        int nst = (sh->int_enable != real->int_enable) + (sh->event_mask != real->event_mask) +
+                  (sh->mfc_tag_mask != real->mfc_tag_mask);
+        unsigned nld = 0, nld_irq = 0; uint32_t fl = 0, ll = 0, fi = 0;
+        for (uint32_t a = 0; a < SPU_LS_SIZE; a += 16) {
+            if (!memcmp(sh->ls + a, real->ls + a, 16) || jv_lsx(a)) continue;
+            if (!s_jv_strict && ((J->irq_dirty[a >> 7] >> ((a >> 4) & 7)) & 1)) { if (!nld_irq) fi = a; nld_irq++; continue; }
+            if (!nld) fl = a;
+            ll = a; nld++;
+        }
+        /* the two PUT journals, in issue order: (ea, size, bytes) */
+        unsigned npr = 0, npc = J->cput.n, pi = 0, pj = 0, ord = UINT32_MAX; char od[200]; od[0] = 0;
+        for (uint32_t i = 0; i < J->real.n; i++) if (jv_is_real_put(&J->real.ev[i])) npr++;
+        for (uint32_t i = 0; i < J->real.n && ord == UINT32_MAX; i++) {
+            const jv_ev* a = &J->real.ev[i];
+            if (!jv_is_real_put(a)) continue;
+            if (pj >= npc) { ord = pi; snprintf(od, sizeof od, " (real ea=0x%08X size=0x%X / clone: none)", (uint32_t)a->ea, a->len); break; }
+            const jv_ev* b = &J->cput.ev[pj];
+            if ((uint32_t)a->ea != (uint32_t)b->ea || a->len != b->len) {
+                ord = pi; snprintf(od, sizeof od, " (real ea=0x%08X size=0x%X / clone ea=0x%08X size=0x%X)",
+                                   (uint32_t)a->ea, a->len, (uint32_t)b->ea, b->len);
+            } else {
+                const uint8_t* ra = J->real.data + a->off; const uint8_t* rb = J->cput.data + b->off;
+                uint32_t o = 0; while (o < a->len && ra[o] == rb[o]) o++;
+                if (o < a->len) {
+                    char x[64], y[64]; const uint32_t w = o & ~15u, wn = (a->len - w) < 16 ? (a->len - w) : 16;
+                    jv_hex16(x, sizeof x, ra + w, wn); jv_hex16(y, sizeof y, rb + w, wn);
+                    ord = pi; snprintf(od, sizeof od, " (ea=0x%08X size=0x%X: +0x%X real [%s] clone [%s])",
+                                       (uint32_t)a->ea, a->len, o, x, y);
+                }
+            }
+            pi++; pj++;
+        }
+        if (ord == UINT32_MAX && npr != npc) ord = npr < npc ? npr : npc;
+        const int finished = !J->rp.abort && J->clone_pc == J->link && J->clone_status == SPU_STATUS_RUNNING;
+        const int returned = !J->real_end && J->real_pc == J->link;
+        const int bad = J->nmis || ngd || nld || nst || !finished || !returned || J->irq_open || ord != UINT32_MAX;
+        JP(": %s | real ops %u (+%u in %d interrupt%s) matched %u, clone steps %llu%s%s%s\n",
+           bad ? "MISMATCH" : "ok", nreal, nirqops, J->nirq, J->nirq == 1 ? "" : "s", J->ops,
+           (unsigned long long)J->rp.steps,
+           J->real_end == 1 ? " [real job HALTED]" : J->real_end == 2 ? " [real job RESTARTED dispatch]" : "",
+           J->irq_open ? " [real job ended inside an interrupt]" : "", jv_abort_name(J->rp.abort));
+        if (J->first_set) JP("[job-verify]   first: %s\n[job-verify]   real journal: %s\n", J->first, J->around);
+        if (J->nmis > 1) JP("[job-verify]   mismatches: %u (written data %u, channel values %u)\n", J->nmis, J->ndata, J->nval);
+        JP("[job-verify]   end: real pc=0x%05X status=0x%X, clone pc=0x%05X status=0x%X; gpr-diffs=%d%s; "
+           "int_enable %u/%u event_mask 0x%X/0x%X tag_mask 0x%X/0x%X; ls-diff-lines=%u",
+           J->real_pc, J->real_status, J->clone_pc, J->clone_status, ngd, gl,
+           real->int_enable, sh->int_enable, real->event_mask, sh->event_mask,
+           real->mfc_tag_mask, sh->mfc_tag_mask, nld);
+        if (nld) JP(" [0x%05X..0x%05X]", fl, ll + 15);
+        if (nld_irq) JP(" (+%u interrupt-written line%s differ from 0x%05X, not counted; SPU_JOB_VERIFY_STRICT=1 counts them)",
+                        nld_irq, nld_irq == 1 ? "" : "s", fi);
+        JP("\n");
+        if (nld) {
+            char a[64], b[64]; jv_hex16(a, sizeof a, real->ls + fl, 16); jv_hex16(b, sizeof b, sh->ls + fl, 16);
+            JP("[job-verify]   ls 0x%05X lift  : %s\n[job-verify]   ls 0x%05X interp: %s\n", fl, a, fl, b);
+        }
+        JP("[job-verify]   puts: real %u clone %u; ordered %s", npr, npc, ord == UINT32_MAX ? "equal" : "differ");
+        if (ord != UINT32_MAX) JP(" at #%u%s", ord, od);
+        JP("\n");
+        if (bad && s_jv_dump) {
+            if (J->entry_dump) jv_dump_ctx(J, "entry", J->entry_dump, J->entry_dump + SPU_LS_SIZE);
+            jv_dump_ctx(J, "lift", real->ls, real->gpr);
+            jv_dump_ctx(J, "interp", sh->ls, sh->gpr);
+        }
+    }
+#undef JP
+    fputs(buf, stderr); fflush(stderr);
+    free(buf);
+}
+
+/* SPU_JOB_VERIFY_JOURNAL: <dir>/jv_<img>_<inv>.jnl = "JVJ1", img, inv, entry,
+ * codebase, n (u32 LE), then per event: kind, irq, moved, 0 (u8), ch, val, lsa,
+ * size (u32), ea (u64), pc, len (u32) and len payload bytes (GET: what landed,
+ * PUT: what was sent; irq-ret: the handler's LS delta + channel state). */
+static void jv_write_journal(const jv_state* J)
+{
+    char fn[640]; snprintf(fn, sizeof fn, "%s/jv_%d_%d.jnl", s_jv_jnl, J->img, J->inv);
+    FILE* fp = fopen(fn, "wb");
+    if (!fp) return;
+    const uint32_t h[6] = { 0x314A564Au, (uint32_t)J->img, (uint32_t)J->inv, J->entry, J->codebase, J->real.n };
+    fwrite(h, 4, 6, fp);
+    for (uint32_t i = 0; i < J->real.n; i++) {
+        const jv_ev* e = &J->real.ev[i];
+        const uint8_t k[4] = { e->kind, e->irq, e->moved, 0 };
+        const uint32_t w[4] = { e->ch, e->val, e->lsa, e->size };
+        const uint32_t t[2] = { e->pc, e->len };
+        fwrite(k, 1, 4, fp); fwrite(w, 4, 4, fp); fwrite(&e->ea, 8, 1, fp); fwrite(t, 4, 2, fp);
+        if (e->len) fwrite(J->real.data + e->off, 1, e->len, fp);
+    }
+    fclose(fp);
+}
+
+/* ---- driver -------------------------------------------------------------- */
+static void jv_sbx_init(spu_sbx* s, spu_context* c, int mode, jv_state* J)
+{
+    memset(s, 0, sizeof *s);
+    s->ctx = c; s->mode = mode; s->ops = &k_jv_ops; s->priv = J;
+}
+static void jv_free(jv_state* J)
+{
+    free(J->real.ev); free(J->real.data); free(J->cput.ev); free(J->cput.data);
+    if (J->sh) _aligned_free(J->sh);
+    free(J->irq_before); free(J->entry_dump); free(J);
+}
+static void jv_clone_fixup(spu_context* sh)
+{
+    sh->ls = sh->ls_store;                        /* ctx->ls == ctx->ls_store: the copy carried the bytes */
+    memset(sh->resident_code, 0, sizeof sh->resident_code);
+    sh->resident_ovl = 0; sh->resident_task = 0; sh->policy_mode = 0; sh->module_img_a00 = 0;
+    sh->image_id = JV_CLONE_IMAGE;                /* PM JobApi code is interpreted too */
+    sh->host_depth = 0; sh->irq_frame = 0; sh->irq_saved = 0;
+    sh->drain_ret_pc = 0; sh->pic_bias = 0; sh->park_on_empty_inmbox = 0;
+    sh->ib_dep = 0; spu_res_changed(sh);          /* residency replaced: no cached dispatch */
+    sh->ch_wait_cv = 0; sh->ch_wait_lock = 0;     /* never the real context's waiters */
+    sh->ch_out_mbox.lock = sh->ch_in_mbox.lock = sh->ch_out_intr_mbox.lock = 0;
+    sh->ch_sig_notify[0].lock = sh->ch_sig_notify[1].lock = 0;
+    sh->status = SPU_STATUS_RUNNING;
+}
+/* SPU_JOB_VERIFY_SELFTEST=1: corrupt the journal copy of the first GET, so
+ * the replay MUST report a mismatch (proves the detector end to end). */
+static void jv_selftest(jv_state* J)
+{
+    if (!getenv("SPU_JOB_VERIFY_SELFTEST")) return;
+    for (uint32_t i = 0; i < J->real.n; i++) {
+        jv_ev* e = &J->real.ev[i];
+        if (e->irq || e->kind != JV_XFER || !e->moved || !mfc_is_get(e->ch) || !e->len) continue;
+        J->real.data[e->off] ^= 0x01;
+        fprintf(stderr, "[job-verify] SELFTEST: flipped bit 0 of real GET event %u (ea 0x%08X -> ls 0x%05X)\n",
+                i, (uint32_t)e->ea, e->lsa & SPU_LS_MASK);
+        return;
+    }
+}
+static void jv_run_clone(jv_state* J)
+{
+    spu_context* const sh = J->sh;
+    mfc_engine_init(&J->eng);
+    jv_sbx_init(&J->rp, sh, SPU_SBX_REPLAY, J);
+    J->rp.max_steps = s_jv_steps;
+    J->deadline = GetTickCount64() + s_jv_ms;
+    void (*const tr)(spu_context*) = g_spu_trampoline_fn;
+    const int gated = g_spu_lookup_gated, irqb = g_spu_interp_irq_break;
+    g_spu_interp_irq_break = 0;                   /* the clone takes no interrupts */
+    jmp_buf outer; memcpy(outer, s_spu_halt_env, sizeof outer);
+    const int outer_armed = s_spu_halt_armed;
+    t_jv_sbx = &J->rp; _InterlockedIncrement(&g_spu_sbx_live);
+    if (setjmp(s_spu_halt_env) == 0) {
+        s_spu_halt_armed = 1;                     /* a stray halt in the clone lands here */
+        sh->pc = J->entry;
+        jv_apply_irq(J, 0);                       /* an interrupt the real job took at its first hop */
+        spu_interp_run_until(sh, J->entry, J->link);
+    } else if (!J->rp.abort) {
+        J->rp.abort = SPU_SBX_ABORT_LONGJMP;
+    }
+    t_jv_sbx = 0; _InterlockedDecrement(&g_spu_sbx_live);
+    memcpy(s_spu_halt_env, outer, sizeof outer); s_spu_halt_armed = outer_armed;
+    g_spu_trampoline_fn = tr; g_spu_lookup_gated = gated; g_spu_interp_irq_break = irqb;
+    J->clone_pc = sh->pc & SPU_LS_MASK; J->clone_status = sh->status;
+}
+
+/* Called first thing by spu_indirect_branch. Returns 1 when it ran the job
+ * (verified); ctx is then at the link, exactly as after the bracket's own drain. */
+static int spu_job_verify(spu_context* ctx)
+{
+    if (s_jv_on < 0) jv_init();
+    /* s_spu_halt_armed: under spu_run_with_halt, so an abnormal end of the real
+     * job always longjmps (and is re-raised below) -- a normal return is at the link. */
+    if (!s_jv_on || t_jv_busy || !s_spu_halt_armed || ctx->ls != ctx->ls_store) return 0;
+    const uint32_t pc = ctx->pc & SPU_LS_MASK;
+    if (pc < 0x4000u || pc >= 0x3E000u) return 0;
+    if ((ctx->drain_ret_pc & SPU_LS_MASK) != s_jv_link ||
+        (ctx->gpr[0]._u32[0] & SPU_LS_MASK) != s_jv_link || !ctx->int_enable) return 0;
+    if (ctx->irq_saved || ctx->irq_frame || !spu_in_wws_pm(ctx)) return 0;
+    /* the PM's entry rule (region 0x3148): pc = codeBase + LS[codeBase + 0x10] */
+    const uint32_t cb = jv_be32(ctx->ls + 0x1320);
+    if (cb > SPU_LS_SIZE - 32u ||
+        ((jv_be32(ctx->ls + ((cb + 0x10u) & 0x3FFF0u)) + cb) & SPU_LS_MASK) != pc) {
+        static volatile long n_rule;
+        if (_InterlockedIncrement(&n_rule) <= 4)
+            fprintf(stderr, "[job-verify] link 0x%05X dispatch to 0x%05X is not codeBase(LS 0x1320)=0x%08X "
+                    "+ entry offset -- not treated as a job entry\n", s_jv_link, pc, cb);
+        return 0;
+    }
+    const int img = spu_overlay_match_sig(ctx->ls + cb);
+    if (img <= 0 || img >= 512 || !s_jv_list[img]) return 0;
+    if (s_interp_img_on < 0) spu_interp_img_init();
+    if (s_interp_img_on > 0 && s_interp_img[img]) return 0;   /* interpreted anyway: nothing lifted to check */
+    if (s_jv_after_ns && spu_host_ns() - s_jv_t0 < s_jv_after_ns) return 0;
+    static volatile long s_jv_seen[512];
+    if ((_InterlockedIncrement(&s_jv_seen[img]) - 1) % s_jv_every) return 0;
+    const long inv = _InterlockedIncrement(&s_jv_cnt[img]);
+    if (inv > s_jv_lim) return 0;
+
+    jv_state* const J = (jv_state*)calloc(1, sizeof *J);
+    if (!J) return 0;
+    J->sh = (spu_context*)_aligned_malloc(sizeof *J->sh, 64);
+    J->irq_before = (uint8_t*)malloc(SPU_LS_SIZE);
+    if (s_jv_dump) J->entry_dump = (uint8_t*)malloc(SPU_LS_SIZE + 128 * 16);
+    if (!J->sh || !J->irq_before) { jv_free(J); return 0; }
+    J->img = img; J->inv = (int)inv; J->entry = pc; J->link = s_jv_link; J->codebase = cb;
+    /* The resolver tries resident_ovl BEFORE the WWS signature match: a stale
+     * overlay with a function at this pc would run the previous module's lift. */
+    if (ctx->resident_ovl > 0 && ctx->resident_ovl != img) {
+        const int gated = g_spu_lookup_gated;
+        if (spu_lookup(pc, ctx->resident_ovl)) J->stale_ovl = ctx->resident_ovl;
+        g_spu_lookup_gated = gated;
+    }
+
+    /* (1) the clone: the entry state, exactly */
+    memcpy(J->sh, ctx, sizeof *J->sh);
+    jv_clone_fixup(J->sh);
+    if (J->entry_dump) { memcpy(J->entry_dump, ctx->ls, SPU_LS_SIZE); memcpy(J->entry_dump + SPU_LS_SIZE, ctx->gpr, 128 * 16); }
+    t_jv_busy = 1;
+
+    /* (2) the real lifted job, recorded. The bracket already counted the call
+     * (host_depth) and set drain_ret_pc; this is its spu_indirect_branch +
+     * spu_drain_call, one host frame deeper. A halt or restart inside lands
+     * here and is re-raised below, exactly as spu_run_with_halt nests. */
+    jv_sbx_init(&J->rec, ctx, SPU_SBX_REC, J);
+    jmp_buf outer; memcpy(outer, s_spu_halt_env, sizeof outer);
+    const int outer_armed = s_spu_halt_armed;
+    t_jv_sbx = &J->rec; _InterlockedIncrement(&g_spu_sbx_live);
+    g_spu_trampoline_fn = 0;
+    switch (setjmp(s_spu_halt_env)) {
+    case 0:
+        s_spu_halt_armed = outer_armed;           /* an unarmed spu_halt() keeps returning */
+        spu_indirect_branch(ctx);                 /* t_jv_busy: resolves and dispatches the job as usual */
+        spu_drain_call(ctx, J->link);
+        break;
+    case 1:  J->real_end = 1; break;              /* spu_halt */
+    default: J->real_end = 2; break;              /* spu_restart_dispatch / stack reset / task resume */
+    }
+    t_jv_sbx = 0; _InterlockedDecrement(&g_spu_sbx_live);
+    memcpy(s_spu_halt_env, outer, sizeof outer); s_spu_halt_armed = outer_armed;
+    J->real_pc = ctx->pc & SPU_LS_MASK; J->real_status = ctx->status;
+    if (J->irq_depth) J->irq_open = 1;
+
+    if (s_jv_jnl && !J->real.overflow) jv_write_journal(J);
+    /* (3) the clone, interpreted, replaying the real job; (4) compare */
+    if (s_jv_noclone) {
+        fprintf(stderr, "[job-verify] img=%d #%d entry=0x%05X spu=0x%X: journaled %u events (%zu payload bytes), not replayed%s\n",
+                J->img, J->inv, J->entry, ctx->spu_id, J->real.n, J->real.used,
+                J->real.overflow ? " [journal OVERFLOW (SPU_JOB_VERIFY_MAXMB): truncated, no .jnl written]" : "");
+    } else {
+        if (!J->real.overflow) { jv_selftest(J); jv_run_clone(J); }
+        jv_report(J, ctx);
+    }
+    const int real_end = J->real_end;
+    jv_free(J);
+    t_jv_busy = 0;
+    if (real_end == 1) { s_spu_halt_armed = 0; longjmp(s_spu_halt_env, 1); }   /* re-raise spu_halt */
+    if (real_end == 2) { g_spu_trampoline_fn = 0; longjmp(s_spu_halt_env, 2); } /* re-raise the restart */
+    g_spu_trampoline_fn = 0;                      /* the bracket's drain returns at once: pc == link */
+    return 1;
+}
