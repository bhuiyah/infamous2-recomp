+           s_tp.dump ? "on" : "off", s_tp.dump && s_tp.raw ? " (raw DDS)" : "", s_tp.dump && s_tp.dump_all ? " (all classes)" : "",
+           s_tp.packs ? "on" : "off", s_tp.dump_dir, s_tp.pack_dir, (unsigned long long)(s_tp.vram_budget >> 20),
