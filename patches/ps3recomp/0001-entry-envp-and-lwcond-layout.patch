+/* out_set_report: a device that ignores interrupt-pipe output (a DS3 under the
+ * stock HID driver) gets its reports as SET_REPORT only -- WriteFile, which
+ * would "succeed" into the void, is never tried. A pipe has no HID ioctls, so
+ * the control-pipe write fails and nothing may arrive through WriteFile. */
+static void test_out_set_report(void)
+{
+    printf("-- out_set_report: output reports on the control pipe only\n");
+    const char* name = "\\\\.\\pipe\\padhost_test_c";
+    HANDLE srv = CreateNamedPipeA(name, PIPE_ACCESS_DUPLEX, PIPE_TYPE_MESSAGE | PIPE_READMODE_MESSAGE | PIPE_WAIT,
+                                  1, 4096, 4096, 0, NULL);
+    HANDLE cli = CreateFileA(name, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+    CHECK(srv != INVALID_HANDLE_VALUE && cli != INVALID_HANDLE_VALUE, "pipe");
+    if (srv == INVALID_HANDLE_VALUE || cli == INVALID_HANDLE_VALUE) return;
+    PhDev* d = ph_dev_new(&stub_drv, 64);
+    d->pub.handle = cli;
+    d->can_write = 1;
+    d->pub.out_len = 4;
+    unsigned char out[4] = { 5, 1, 2, 3 }, m[64];
+    d->pub.out_set_report = 1;
+    CHECK(padhost_dev_write(&d->pub, out, 4) < 0, "SET_OUTPUT_REPORT is the only path (and a pipe refuses it)");
+    CHECK(pipe_read_msg(srv, m, sizeof m, 200) < 0, "nothing went out through WriteFile");
+    d->pub.out_set_report = 0;
+    CHECK(padhost_dev_write(&d->pub, out, 4) == 4, "without the flag: WriteFile");
+    CHECK(pipe_read_msg(srv, m, sizeof m, 500) == 4 && m[0] == 5 && m[3] == 3, "report arrived through WriteFile");
+    ph_dev_free(d);                                /* closes the client end */
+    CloseHandle(srv);
+}
