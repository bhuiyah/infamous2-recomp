+
+    def fall(mo):
+        return (f"do {{ ctx->pc = ({mo.group(1)}); if (SPU_UNLIKELY(g_spu_no_goto > 1)) {{ "
+                f"g_spu_trampoline_fn = ({mo.group(2)}); return; }} }} while (0);")
+    return _RC_MFALL.sub(fall, _RC_MGOTO.sub(go, t))
+
+
+class _RCStmt:
+    __slots__ = ("text", "uses", "defs", "kill", "flush", "reload", "falls", "gotos",
+                 "pre_defs", "post_defs", "flush0")
+
+
+def _rc_stmt(t0: str) -> _RCStmt:
+    """Classify and rewrite one emitted statement (see the block comment above)."""
+    st = _RCStmt()
+    st.flush = st.reload = st.flush0 = False
+    st.kill, st.pre_defs, st.post_defs = set(), set(), set()
+    m0 = _rc_mask(t0)
+    st.falls = not _rc_ends_in_transfer(m0)
+    st.gotos = _RC_GOTO.findall(m0) + [mo.group(4) for mo in _RC_MGOTO.finditer(m0)]
+    calls = {mo.group(1) for mo in _RC_CTXCALL.finditer(m0)}
+    asg = _RC_ASSIGN.match(t0)
+    simple = "return" not in m0 and "goto" not in m0 and calls <= _RC_LS_ONLY and \
+        not re.search(r"\bSPU_[A-Z_]+\(ctx\b", m0)
+    if simple and asg and "ctx->" not in _RC_GPR.sub("", asg.group(2)).replace("spu_ls_read128(ctx, ", ""):
+        st.text = _rc_rename(t0)
+        st.uses = {int(r) for r in _RC_GPR.findall(asg.group(2))}
+        st.defs = st.kill = {int(asg.group(1))}
+        return st
+    if simple and ("ctx" not in m0 or (t0.startswith("spu_ls_write128(ctx, ") and
+                                        "ctx->" not in _RC_GPR.sub("", t0))):
+        st.text = _rc_rename(t0)
+        st.uses = {int(r) for r in _RC_GPR.findall(t0)}
+        st.defs = set()
+        return st
+    # Channel ops: the write-back before (the runtime may print or journal the
+    # registers, or halt in a park), a reload after for _RC_CHAN_RELOAD; the
+    # value read is the statement's only (and last) def.
+    rd, wr = _RC_CHAN_RD.match(t0), _RC_CHAN_WR.match(t0)
+    if rd or wr:
+        st.text = "@F@ " + _rc_rename(t0)
+        st.flush = st.flush0 = True
+        if rd:
+            ch = rd.group(3) or rd.group(4)
+            st.uses = set()
+            st.defs = st.kill = st.post_defs = {int(rd.group(1))}
+        else:
+            ch = wr.group(1)
+            st.uses, st.defs = {int(wr.group(2))}, set()
+        if ch in _RC_CHAN_RELOAD:
+            st.text += " @R@"
+            st.reload = True
+        return st
+    if _RC_CHAN_ANY.search(m0):
+        raise RCacheUnsupported(f"channel op in an unexpected form: {t0}")
+    # Control flow, calls: sync around the parts that leave.
+    t = _rc_rename(_rc_expand_hops(t0))
+    # The safepoint exit of a back-edge is rare (an interrupt pending), and with
+    # the write-back on it, it is long: keep it out of the loop body.
+    t = t.replace("if (SPU_BACKEDGE_EXIT(ctx))", "if (SPU_UNLIKELY(SPU_BACKEDGE_EXIT(ctx)))")
+    m = _rc_mask(t)
+    for mo in _RC_CTXCALL.finditer(m):
+        name = mo.group(1)
+        if name not in _RC_KNOWN_CTX and not re.fullmatch(r"\w*spu_(func|region)_[0-9A-F]{8}", name):
+            raise RCacheUnsupported(f"call {name}(ctx...) in: {t0}")
+    call_block = "ctx->host_depth++" in m
+    events = []                                   # (position, insert-at, clobbers)
+    for mo in _RC_RETURN.finditer(m):
+        events.append((mo.start(), mo.start(), False))
+    for mo in _RC_RETM.finditer(m):
+        events.append((mo.start(), mo.start(), True))
+    for mo in _RC_CLOBBER.finditer(m):
+        p = mo.start()
+        s = _rc_stmt_start(m, p)
+        lead = m[s:p].strip()
+        if lead not in ("", "if ("):
+            raise RCacheUnsupported(f"call in an unexpected position: {t0}")
+        if not call_block:
+            # a clobbering call must be followed by leaving the function
+            blk = _rc_enclosing_block(m, p)
+            if blk is None:
+                if st.falls:
+                    raise RCacheUnsupported(f"call falls through: {t0}")
+            elif not _rc_ends_in_transfer(m[blk[0] + 1:blk[1]]):
+                raise RCacheUnsupported(f"call block falls through: {t0}")
+        events.append((p, s, True))
+    events.sort()
+    st.defs = {int(r) for r in _RC_LOCAL_DEF.findall(m)}
+    inserts, stale = [], False
+    for _, at, clob in events:
+        if stale:
+            continue
+        k = at
+        while k > 0 and m[k - 1] == " ":
+            k -= 1
+        if k > 0 and m[k - 1] not in ";{}":
+            raise RCacheUnsupported(f"sync point not at a statement boundary: {t0}")
+        if at not in inserts:
+            inserts.append(at)
+        if clob:
+            stale = True
+    for at in sorted(inserts, reverse=True):
+        while at < len(t) and t[at] == " ":
+            at += 1
+        t = t[:at] + ("" if at == 0 or t[at - 1] == " " else " ") + "@F@ " + t[at:]
+    st.flush = bool(inserts)
+    # registers this statement writes before (textually: no loops inside a
+    # statement) its last write-back point; one written after every write-back
+    # point -- after a nested call -- is dirty afterwards
+    last = max(inserts) if inserts else -1
+    st.pre_defs = {int(mo.group(1)) for mo in _RC_LOCAL_DEF.finditer(m) if mo.start(1) - 2 < last}
+    # a write-back at the very start of the statement runs on every path
+    # through it: afterwards only what the statement itself writes is dirty
+    st.flush0 = 0 in inserts
+    if call_block:
+        t += " @R@"
+        st.reload = True
+        st.post_defs = st.defs - st.pre_defs
+    st.text = t
+    st.uses = {int(r) for r in _RC_LOCAL_USE.findall(t.replace("ctx->gpr[0] = SPU_RU(_r0);", ""))}
+    return st
+
+
+_SK_ASSIGN = re.compile(r"^_r(\d+) = SPU_RV\((spu_\w+)\((.*)\)\);(?: ctx->gpr\[0\] = SPU_RU\(_r0\);)?$")
+_SK_REG = re.compile(r"^SPU_RU\(_r(\d+)\)$")
+_SK_SHUFB = re.compile(r"spu_shufb\(SPU_RU\(_r(\d+)\), SPU_RU\(_r(\d+)\), SPU_RU\(_r(\d+)\)\)")
+
+
+def _sk_args(s: str) -> list:
+    """Top-level comma-separated arguments of a helper call."""
+    out, depth, cur = [], 0, []
+    for c in s:
+        if c == "(":
+            depth += 1
+        elif c == ")":
+            depth -= 1
+        if c == "," and depth == 0:
+            out.append("".join(cur).strip())
+            cur = []
+        else:
+            cur.append(c)
+    out.append("".join(cur).strip())
+    return out
+
+
+def _sk_int(s: str):
+    try:
+        return int(s.rstrip("uU"), 0)
+    except ValueError:
+        return None
+
+
+def _sk_words(b: bytes) -> tuple:
+    return tuple(int.from_bytes(b[i:i + 4], "big") for i in range(0, 16, 4))
+
+
+def _sk_bytes(w) -> bytes:
+    return b"".join((x & 0xFFFFFFFF).to_bytes(4, "big") for x in w)
+
+
+def _sk_eval(op: str, args: list, regs: dict, image):
+    """Value (16 bytes, SPU byte order) of `op(args)` from known register
+    values (regs: N -> (bytes, from_image)), with whether it depends on an
+    image load; None when not known. Same semantics as spu_helpers.h."""
+    def R(a):
+        m = _SK_REG.match(a)
+        return regs.get(int(m.group(1))) if m else None
+    spec = False
+    if op == "spu_ls_rd" and len(args) == 4:
+        q = image(args[3]) if image else None
+        return (q, True) if q is not None else None
+    if op in ("spu_il", "spu_ila", "spu_ilh", "spu_ilhu", "spu_fsmbi"):
+        v = _sk_int(args[0]) if len(args) == 1 else None
+        if v is None:
+            return None
+        if op == "spu_il":
+            w = v & 0xFFFFFFFF
+        elif op == "spu_ila":
+            w = v & 0x3FFFF
+        elif op == "spu_ilh":
+            w = ((v & 0xFFFF) << 16) | (v & 0xFFFF)
+        elif op == "spu_ilhu":
+            w = (v & 0xFFFF) << 16
+        else:
+            return (bytes(0xFF if (v >> (15 - i)) & 1 else 0 for i in range(16)), False)
+        return (_sk_bytes([w] * 4), False)
+    ins = []
+    for a in args:
+        if _SK_REG.match(a):
+            r = R(a)
+            if r is None:
+                return None
+            ins.append(r[0])
+            spec |= r[1]
+        else:
+            v = _sk_int(a)
+            if v is None:
+                return None
+            ins.append(v)
+    def words(i):
+        return _sk_words(ins[i])
+    try:
+        if op == "spu_shufb":
+            a, b, c = ins
+            cat, r = a + b, bytearray(16)
+            for t in range(16):
+                s = c[t]
+                r[t] = 0x80 if s & 0xE0 == 0xE0 else 0xFF if s & 0xC0 == 0xC0 else 0 if s & 0xC0 == 0x80 else cat[s & 0x1F]
+            return (bytes(r), spec)
+        if op == "spu_selb":
+            a, b, c = ins
+            return (bytes((x & ~z | y & z) & 0xFF for x, y, z in zip(a, b, c)), spec)
+        bitw = {"spu_and": lambda x, y: x & y, "spu_or": lambda x, y: x | y, "spu_xor": lambda x, y: x ^ y,
+                "spu_andc": lambda x, y: x & ~y, "spu_orc": lambda x, y: x | ~y,
+                "spu_nor": lambda x, y: ~(x | y), "spu_nand": lambda x, y: ~(x & y)}
+        if op in bitw:
+            a, b = ins
+            return (bytes(bitw[op](x, y) & 0xFF for x, y in zip(a, b)), spec)
+        wimm = {"spu_ai": lambda x, k: x + k, "spu_andi": lambda x, k: x & k, "spu_ori": lambda x, k: x | k,
+                "spu_xori": lambda x, k: x ^ k, "spu_iohl": lambda x, k: x | (k & 0xFFFF)}
+        if op in wimm and isinstance(ins[1], int):
+            return (_sk_bytes([wimm[op](x, ins[1] & 0xFFFFFFFF) for x in words(0)]), spec)
+        if op == "spu_a":
+            return (_sk_bytes([x + y for x, y in zip(words(0), words(1))]), spec)
+        if op == "spu_rotqbyi" and isinstance(ins[1], int):
+            a, sh = ins[0], ins[1] & 0x0F
+            return (bytes(a[(i + sh) & 15] for i in range(16)), spec)
+        if op == "spu_shlqbyi" and isinstance(ins[1], int):
+            a, sh = ins[0], ins[1] & 0x1F
+            return (bytes(a[i + sh] if i + sh < 16 else 0 for i in range(16)), spec)
+        gen = {"spu_cbd": (0xF, 1, 3), "spu_chd": (0xE, 2, 2), "spu_cwd": (0xC, 4, 0), "spu_cdd": (0x8, 8, 0)}
+        if op in gen and isinstance(ins[1], int):
+            mask, n, first = gen[op]
+            p = (words(0)[0] + ins[1]) & mask
+            r = bytearray(0x10 + t for t in range(16))
+            for k in range(n):
+                r[p + k] = first + k
+            return (bytes(r), spec)
+    except (TypeError, ValueError):
+        return None
+    return None
+
+
+def _rc_shufb_consts(stmts: list, succ: list, starts: list, image) -> int:
+    """Forward constant propagation of register values over the statements
+    (see the comment above): each shufb whose control register has a known
+    value that depends on an image load becomes spu_shufb_k with that value.
+    Unknown at entries, after nested calls (a reload statement) except in the
+    callee-saved registers r80-r127 (SPU ABI: a callee restores them), and for
+    any register a statement defines other than as a recognised plain
+    assignment. Returns the number of shufbs rewritten."""
+    n = len(stmts)
+    din = [None] * n
+    work = []
+    # An entry (a region's switch case) loads its registers from ctx->gpr. At
+    # a block that the region also reaches by a jump -- every loop head is an
+    # entry, for the safepoint's trampoline -- those are the values the region
+    # stored there, so the guess comes from the in-region paths alone; an
+    # entry nothing in the region reaches starts unknown.
+    haspred = [False] * n
+    for i in range(n):
+        for j in succ[i]:
+            haspred[j] = True
+    pending = [s for s in starts if not haspred[s]] + [s for s in starts if haspred[s]]
+    parsed = [None] * n
+    for i, st in enumerate(stmts):
+        m = _SK_ASSIGN.match(st.text)
+        if m and not st.flush and not st.reload:
+            parsed[i] = (int(m.group(1)), m.group(2), _sk_args(m.group(3)))
+
+    def transfer(i, regs):
+        st = stmts[i]
+        if st.reload:
+            return {k: v for k, v in regs.items() if k >= 80 and k not in st.defs}
+        out = dict(regs)
+        for d in st.defs:
+            out.pop(d, None)
+        p = parsed[i]
+        if p is not None:
+            v = _sk_eval(p[1], p[2], regs, image)
+            if v is not None:
+                out[p[0]] = v
+        return out
+    while work or pending:
+        if not work:
+            s = pending.pop(0)
+            if din[s] is None:
+                din[s] = {}
+                work.append(s)
+            continue
+        i = work.pop()
+        out = transfer(i, din[i])
+        for j in succ[i]:
+            if din[j] is None:
+                din[j] = dict(out)
+                work.append(j)
+            else:
+                new = {k: v for k, v in din[j].items() if out.get(k) == v}
+                if len(new) != len(din[j]):
+                    din[j] = new
+                    work.append(j)
+    count = 0
+    for i, st in enumerate(stmts):
+        if din[i] is None or "spu_shufb(" not in st.text:
+            continue
+        def sub(mo):
+            nonlocal count
+            k = din[i].get(int(mo.group(3)))
+            if k is None or not k[1]:
+                return mo.group(0)
+            count += 1
+            return (f"spu_shufb_k(SPU_RU(_r{mo.group(1)}), SPU_RU(_r{mo.group(2)}), SPU_RU(_r{mo.group(3)}), "
+                    + ", ".join(f"0x{w:08X}u" for w in _sk_words(k[0])) + ")")
+        st.text = _SK_SHUFB.sub(sub, st.text)
+    return count
+
+
+_WIN_FLOAT = {"spu_fa", "spu_fs", "spu_fm", "spu_fma", "spu_fms", "spu_fnms"}
+_WIN_FCMP = {"spu_fcgt", "spu_fceq"}
+_WIN_CFLT = {"spu_cflts", "spu_cfltu"}
+_WIN_INSENS = _WIN_FLOAT | _WIN_FCMP | _WIN_CFLT       # read a -0 operand as a +0
+_WIN_STMT = re.compile(r"^_r(\d+) = SPU_RV\((spu_\w+)\((.*)\)\);$")
+_WIN_NOP = re.compile(r"^/\*[^*]*\*/;$")
+_WIN_REG = re.compile(r"^SPU_RU\((\w+)\)$")
+
+
+def _rc_cyclic(succ: list) -> list:
+    """Per statement: does it lie on a cycle of the statement graph?"""
+    n = len(succ)
+    index, low, onstk, stk = [None] * n, [0] * n, [False] * n, []
+    cyc = [False] * n
+    counter = 0
+    for v0 in range(n):
+        if index[v0] is not None:
+            continue
+        index[v0] = low[v0] = counter
+        counter += 1
+        stk.append(v0)
+        onstk[v0] = True
+        it = [(v0, iter(succ[v0]))]
+        while it:
+            v, nxt = it[-1]
+            advanced = False
+            for w in nxt:
+                if index[w] is None:
+                    index[w] = low[w] = counter
+                    counter += 1
+                    stk.append(w)
+                    onstk[w] = True
+                    it.append((w, iter(succ[w])))
+                    advanced = True
+                    break
+                if onstk[w]:
+                    low[v] = min(low[v], index[w])
+            if advanced:
+                continue
+            it.pop()
+            if it:
+                low[it[-1][0]] = min(low[it[-1][0]], low[v])
+            if low[v] == index[v]:
+                scc = []
+                while True:
+                    w = stk.pop()
+                    onstk[w] = False
+                    scc.append(w)
+                    if w == v:
+                        break
+                if len(scc) > 1 or v in succ[v]:
+                    for w in scc:
+                        cyc[w] = True
+    return cyc
+
+
+def _rc_win_stmt(text: str):
+    """(dest, op, args) of a statement a window may hold, "nop" for a comment
+    statement, or None: a plain helper assignment with no context access
+    other than an ungated-able local-store load, and no double-precision op
+    (those switch MXCSR)."""
+    if _WIN_NOP.match(text):
+        return "nop"
+    m = _WIN_STMT.match(text)
+    if not m:
+        return None
+    op, args = m.group(2), _sk_args(m.group(3))
+    if op.startswith("spu_df") or op in ("spu_fesd", "spu_frds"):
+        return None
+    if op == "spu_ls_rd":
+        if len(args) != 4 or args[:3] != ["ctx", "_ls", "_lsg"] or "ctx" in args[3]:
+            return None
+    elif "ctx" in m.group(3) or "_ls" in m.group(3):
+        return None
+    return int(m.group(1)), op, args
+
+
+def _rc_win_emit(k: int, run: list):
+    """The text lines of window k over the statements run [(text, parsed)]."""
+    pfx = f"_w{k}"
+    cnt = [0]
+
+    def new(kind):
+        cnt[0] += 1
+        return f"{pfx}{kind}{cnt[0]}"
+    cur, steps = {}, []
+    for text, p in run:
+        if p == "nop":
+            continue
+        d, op, args = p
+        a2 = [re.sub(r"\b_r(\d+)\b", lambda mo: cur.get(int(mo.group(1)), mo.group(0)), a) for a in args]
+        t = new("s")
+        steps.append((d, op, a2, t))
+        cur[d] = t
+    committed = set(cur.values())
+    uses = {}
+    for d, op, a2, t in steps:
+        for a in a2:
+            for nm in re.findall(r"\b" + pfx + r"s\d+\b", a):
+                uses.setdefault(nm, []).append(op)
+    vals, leaves, body = [], [], []
+    finite, guards = set(), {}
+    trees = {"r": [], "o": []}
+    xors = []
+
+    def push(tree, leaf):
+        st = trees[tree]
+        st.append((0, leaf))
+        while len(st) >= 2 and st[-1][0] == st[-2][0]:
+            (lv, b), (_, a) = st.pop(), st.pop()
+            m = new("l")
+            leaves.append(m)
+            body.append(f"{m} = _mm_max_epu32({a}, {b});")
+            st.append((lv + 1, m))
+
+    def close(tree):
+        st = trees[tree]
+        while len(st) >= 2:
+            (lv, b), (_, a) = st.pop(), st.pop()
+            m = new("l")
+            leaves.append(m)
+            body.append(f"{m} = _mm_max_epu32({a}, {b});")
+            st.append((lv + 1, m))
+        return st[0][1] if st else "_mm_setzero_si128()"
+
+    def opcheck(arg):
+        mo = _WIN_REG.match(arg)
+        if not mo:
+            raise RCacheUnsupported(f"window operand {arg}")
+        if mo.group(1) in finite:
+            return
+        lf = new("l")
+        leaves.append(lf)
+        body.append(f"{lf} = spu_wchk({arg});")
+        push("o", lf)
+        finite.add(mo.group(1))
+    gated = False
+    for d, op, a2, t in steps:
+        vals.append(t)
+        if op == "spu_ls_rd":
+            expr = f"spu_wls_rd(_ls, {a2[3]})"
+            gated = True
+        elif op in _WIN_FLOAT:
+            lf = new("l")
+            leaves.append(lf)
+            raw = t not in committed and all(u in _WIN_INSENS for u in uses.get(t, []))
+            body.append(f"{t} = SPU_RV(spu_w{op[4:]}{'_r' if raw else ''}({', '.join(a2)}, &{lf}));")
+            push("r", lf)
+            finite.add(t)
+            continue
+        elif op in _WIN_FCMP:
+            for a in a2:
+                opcheck(a)
+            expr = f"spu_w{op[4:]}({', '.join(a2)})"
+        elif op in _WIN_CFLT:
+            opcheck(a2[0])
+            expr = f"spu_w{op[4:]}({', '.join(a2)})"
+        elif op == "spu_shufb_k":
+            key = (a2[2],) + tuple(a2[3:])
+            if key not in guards:
+                g = new("l")
+                leaves.append(g)
+                guards[key] = g
+                body.append(f"{g} = spu_wguard({a2[2]}, {', '.join(a2[3:])});")
+                xors.append(g)
+            expr = f"spu_wshufb_k({a2[0]}, {a2[1]}, {', '.join(a2[3:])})"
+        else:
+            expr = f"{op}({', '.join(a2)})"
+        body.append(f"{t} = SPU_RV({expr});")
+    racc, oacc = close("r"), close("o")
+    while len(xors) >= 2:
+        a, b = xors.pop(0), xors.pop(0)
+        m = new("l")
+        leaves.append(m)
+        body.append(f"{m} = _mm_or_si128({a}, {b});")
+        xors.append(m)
+    xacc = xors[0] if xors else "_mm_setzero_si128()"
+    commit = " ".join(f"_r{r} = {v};" for r, v in sorted(cur.items()))
+    lab = f"_wd{k}"
+    out = ["{", "#if SPU_WIN_ENABLE",
+           f"  spu_reg {', '.join(vals)}; __m128i {', '.join(leaves)};",
+           f"  if (SPU_WIN_ON({'_lsg' if gated else '0'}, _wn)) {{"]
+    out += [f"    {b}" for b in body]
+    out += [f"    if (SPU_WIN_OK({racc}, {oacc}, {xacc})) {{ {commit} goto {lab}; }}",
+            "    SPU_WIN_FAILED(_wn);", "  }", "#endif"]
+    out += [f"  {text}" for text, _ in run]
