diff --git a/runtime/spu/tests/test_spu_regcache_ls.c b/runtime/spu/tests/test_spu_regcache_ls.c
new file mode 100644
index 0000000..912f23d
--- /dev/null
+++ b/runtime/spu/tests/test_spu_regcache_ls.c
@@ -0,0 +1,203 @@
+/*
+ * test_spu_regcache_ls.c -- the helpers register-cached lifted code
+ * (spu_lifter.py --reg-cache) uses in place of ctx->gpr / spu_ls_read128 /
+ * spu_ls_write128 (spu_helpers.h):
+ *   - spu_reg <-> u128 (SPU_RV/SPU_RU) round trips, SPU_RW0/SPU_RH0 = the
+ *     union's _u32[0]/_u16[0];
+ *   - spu_ls_rd/spu_ls_wr with the gate clear == spu_ls_read128/write128
+ *     (value, every byte of local store), for every quadword address and
+ *     unaligned / out-of-range addresses (the same masking);
+ *   - with the gate set they take the full path: the LS watch sees every
+ *     access with the same address, direction, pc, lr and bytes;
+ *   - spu_ls_gate is set exactly when one of the diagnostics the full path
+ *     runs could fire (SPU_LS_LOWREAD, SPU_SMC_WATCH, an LS watch, the
+ *     image-2 policy-module probes), and reads unread (-1) gates first;
+ *   - the DP arithmetic helpers of register-cached lifts propagate NaNs by the
+ *     expression's own operand order (first NaN operand, quieted), whatever
+ *     the operands' values or whether they are compile-time constants.
+ * Build with any of /arch:AVX2, -msse4.1, plain SSE2, -DSPU_HELPERS_NO_SIMD.
+ */
+#define SPU_LIFTED_WITH_REG_CACHE 1     /* as a --reg-cache lift's spu_recomp.h does */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* spu_channels.c's LS watch, as a recorder */
+int g_spu_ls_watch_n = 0;
+static unsigned long long s_watch_hash, s_watch_calls;
+void spu_ls_watch_slow(uint32_t lsa, int is_write, const uint8_t* p, uint32_t pc, uint32_t lr)
+{
+    unsigned long long h = s_watch_hash ^ 0x9E3779B97F4A7C15ull;
+    const uint32_t v[4] = { lsa, (uint32_t)is_write, pc, lr };
+    for (int i = 0; i < 4; i++) h = (h ^ v[i]) * 0x100000001B3ull;
+    for (int i = 0; i < 16; i++) h = (h ^ p[i]) * 0x100000001B3ull;
+    s_watch_hash = h; s_watch_calls++;
+}
+unsigned* spu_ls_watch_list(int* out_n)
+{
+    static unsigned l[4];
+    if (g_spu_ls_watch_n < 0) g_spu_ls_watch_n = 0;   /* "env unset" */
+    *out_n = g_spu_ls_watch_n;
+    return l;
+}
+
+static int s_fail, s_checks;
+#define CHECK(c, ...) do { s_checks++; if (!(c)) { if (s_fail++ < 20) { printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } } while (0)
+
+static uint64_t s_rng = 0x2545F4914F6CDD1Dull;
+static uint32_t rnd(void) { s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17; return (uint32_t)(s_rng >> 32); }
+
+static spu_context A, B;   /* static: 256 KB of local store each */
+
+/* ---- DP model: x86's NaN rule for each operation as written ---- */
+static uint64_t d2u(double d) { uint64_t u; memcpy(&u, &d, 8); return u; }
+static double u2d(uint64_t u) { double d; memcpy(&d, &u, 8); return d; }
+static int nan_u(uint64_t u) { return (u & 0x7FF0000000000000ull) == 0x7FF0000000000000ull && (u & 0x000FFFFFFFFFFFFFull); }
+static double m2(double x, double y, double r)
+{
+    if (nan_u(d2u(x))) return u2d(d2u(x) | 0x0008000000000000ull);
+    if (nan_u(d2u(y))) return u2d(d2u(y) | 0x0008000000000000ull);
+    return r;
+}
+static double vadd(double x, double y) { volatile double a = x, b = y; return a + b; }
+static double vsub(double x, double y) { volatile double a = x, b = y; return a - b; }
+static double vmul(double x, double y) { volatile double a = x, b = y; return a * b; }
+static double get_d(u128 r, int i) { return u2d(((uint64_t)r._u32[2 * i] << 32) | r._u32[2 * i + 1]); }
+static void set_d(u128* r, int i, double d) { uint64_t u = d2u(d); r->_u32[2 * i] = (uint32_t)(u >> 32); r->_u32[2 * i + 1] = (uint32_t)u; }
+static inline u128 dpconst(uint64_t d0, uint64_t d1)
+{
+    u128 r; r._u32[0] = (uint32_t)(d0 >> 32); r._u32[1] = (uint32_t)d0; r._u32[2] = (uint32_t)(d1 >> 32); r._u32[3] = (uint32_t)d1;
+    return r;
+}
+static double rnd_d(void)
+{
+    const uint32_t k = rnd() % 10u, s = rnd() & 0x80000000u;
+    const uint64_t m = ((uint64_t)rnd() << 32 | rnd()) & 0x000FFFFFFFFFFFFFull;
+    switch (k) {
+    case 0: case 1: case 2: return u2d((uint64_t)s << 32 | 0x7FF0000000000000ull | (m ? m : 1));   /* NaN, any */
+    case 3: return u2d((uint64_t)s << 32 | 0x7FF8000000000000ull | m);                              /* quiet NaN */
+    case 4: return u2d((uint64_t)s << 32 | 0x7FF0000000000000ull);                                  /* inf */
+    case 5: return u2d((uint64_t)s << 32);                                                          /* 0 */
+    case 6: return u2d((uint64_t)s << 32 | m);                                                      /* denormal */
+    default: return u2d((uint64_t)s << 32 | ((uint64_t)(1 + rnd() % 2045u) << 52) | m);             /* normal */
+    }
+}
+static void check_dp(u128 a, u128 b, u128 t)
+{
+    const u128 ra = spu_dfa(a, b), rs = spu_dfs(a, b), rm = spu_dfm(a, b);
+    const u128 r1 = spu_dfma(a, b, t), r2 = spu_dfms(a, b, t), r3 = spu_dfnms(a, b, t), r4 = spu_dfnma(a, b, t);
+    for (int i = 0; i < 2; i++) {
+        const double x = get_d(a, i), y = get_d(b, i), z = get_d(t, i), p = m2(x, y, vmul(x, y));
+        const uint64_t e[7] = { d2u(m2(x, y, vadd(x, y))), d2u(m2(x, y, vsub(x, y))), d2u(p),
+                                d2u(m2(p, z, vadd(p, z))), d2u(m2(p, z, vsub(p, z))), d2u(m2(z, p, vsub(z, p))),
+                                d2u(m2(p, z, vadd(p, z))) ^ 0x8000000000000000ull };
+        const u128* g[7] = { &ra, &rs, &rm, &r1, &r2, &r3, &r4 };
+        static const char* nm[7] = { "dfa", "dfs", "dfm", "dfma", "dfms", "dfnms", "dfnma" };
+        for (int j = 0; j < 7; j++)
+            CHECK(d2u(get_d(*g[j], i)) == e[j], "%s(%016llX, %016llX, %016llX) = %016llX, expected %016llX", nm[j],
+                  (unsigned long long)d2u(x), (unsigned long long)d2u(y), (unsigned long long)d2u(z),
+                  (unsigned long long)d2u(get_d(*g[j], i)), (unsigned long long)e[j]);
+    }
+}
+
+int main(void)
+{
+    /* 1. register conversions */
+    for (int k = 0; k < 100000; k++) {
+        u128 u; for (int i = 0; i < 4; i++) u._u32[i] = rnd();
+        spu_reg r = SPU_RV(u);
+        u128 back = SPU_RU(r);
+        CHECK(memcmp(&u, &back, 16) == 0, "SPU_RU(SPU_RV(x)) != x");
+        CHECK(SPU_RW0(r) == u._u32[0], "SPU_RW0 %08X != %08X", SPU_RW0(r), u._u32[0]);
+        CHECK(SPU_RH0(r) == u._u16[0], "SPU_RH0 %04X != %04X", SPU_RH0(r), u._u16[0]);
+    }
+
+    /* 2. gate clear: equal to the plain accessors, all of local store */
+    spu_context_init(&A, 0); spu_context_init(&B, 0);
+    for (int i = 0; i < SPU_LS_SIZE; i++) A.ls_store[i] = B.ls_store[i] = (uint8_t)rnd();
+    g_spu_ls_probe = 0; g_spu_smc_watch = 0; g_spu_ls_watch_n = 0;
+    CHECK(spu_ls_gate(&A) == 0, "gate set with every diagnostic off");
+    for (uint32_t a = 0; a < SPU_LS_SIZE; a += 16) {
+        const uint32_t lsa = a + (rnd() & 15u) + ((rnd() & 3u) << 18);   /* unaligned, out of range */
+        u128 x = spu_ls_read128(&A, lsa), y = spu_ls_rd(&B, B.ls, 0, lsa);
+        CHECK(memcmp(&x, &y, 16) == 0, "rd lsa=%05X", lsa);
+        u128 v; for (int i = 0; i < 4; i++) v._u32[i] = rnd();
+        spu_ls_write128(&A, lsa, v); spu_ls_wr(&B, B.ls, 0, lsa, v);
+    }
+    CHECK(memcmp(A.ls_store, B.ls_store, SPU_LS_SIZE) == 0, "local store differs after the writes");
+
+    /* 3. gate set: the full path, with the same LS-watch reports */
+    g_spu_ls_watch_n = 1;
+    A.pc = 0x1234; B.pc = 0x1234; A.gpr[0]._u32[0] = B.gpr[0]._u32[0] = 0x2A50;
+    {   /* the same access sequence through spu_ls_read128/write128 on A and
+         * spu_ls_rd/spu_ls_wr on B */
+        const uint64_t seed = s_rng;
+        s_watch_hash = 0; s_watch_calls = 0;
+        uint64_t ra = 0, rb = 0;
+        for (int k = 0; k < 4096; k++) {
+            const uint32_t lsa = rnd();
+            u128 v; for (int i = 0; i < 4; i++) v._u32[i] = rnd();
+            u128 x = spu_ls_read128(&A, lsa); ra = ra * 31 + x._u32[k & 3];
+            spu_ls_write128(&A, lsa ^ 0x40u, v);
+        }
+        const unsigned long long ha = s_watch_hash, ca = s_watch_calls;
+        s_rng = seed; s_watch_hash = 0; s_watch_calls = 0;
+        const int g = spu_ls_gate(&B);
+        CHECK(g != 0, "gate clear with an LS watch armed");
+        for (int k = 0; k < 4096; k++) {
+            const uint32_t lsa = rnd();
+            u128 v; for (int i = 0; i < 4; i++) v._u32[i] = rnd();
+            u128 x = spu_ls_rd(&B, B.ls, g, lsa); rb = rb * 31 + x._u32[k & 3];
+            spu_ls_wr(&B, B.ls, g, lsa ^ 0x40u, v);
+        }
+        CHECK(ca == 8192 && s_watch_calls == ca, "LS watch calls %llu / %llu", ca, s_watch_calls);
+        CHECK(ha == s_watch_hash, "LS watch reports differ");
+        CHECK(ra == rb, "values read differ (gated path)");
+        CHECK(memcmp(A.ls_store, B.ls_store, SPU_LS_SIZE) == 0, "local store differs (gated path)");
+    }
+
+    /* 4. the gate itself */
+    g_spu_ls_watch_n = 0;
+    CHECK(spu_ls_gate(&A) == 0, "gate (all off)");
+    g_spu_ls_probe = 1;  CHECK(spu_ls_gate(&A) != 0, "gate (SPU_LS_LOWREAD)"); g_spu_ls_probe = 0;
+    g_spu_smc_watch = 1; CHECK(spu_ls_gate(&A) != 0, "gate (SPU_SMC_WATCH)"); g_spu_smc_watch = 0;
+    g_spu_ls_watch_n = 2; CHECK(spu_ls_gate(&A) != 0, "gate (LS watch)"); g_spu_ls_watch_n = 0;
+    A.image_id = 2; A.policy_mode = 0; CHECK(spu_ls_gate(&A) == 0, "gate (image 2, no policy mode)");
+    A.policy_mode = 1; CHECK(spu_ls_gate(&A) != 0, "gate (image 2 policy module)");
+    A.image_id = 3; CHECK(spu_ls_gate(&A) == 0, "gate (policy mode, image 3)");
+    A.image_id = 0; A.policy_mode = 0;
+    g_spu_ls_probe = -1; g_spu_smc_watch = -1; g_spu_ls_watch_n = -1;    /* unread: read like the probes */
+    const int g0 = spu_ls_gate(&A);
+    CHECK(g_spu_ls_probe == (getenv("SPU_LS_LOWREAD") ? 1 : 0) && g_spu_smc_watch == (getenv("SPU_SMC_WATCH") ? 1 : 0) &&
+          g_spu_ls_watch_n == 0, "unread gates not read");
+    CHECK(g0 == ((g_spu_ls_probe | g_spu_smc_watch) != 0), "gate after reading the env");
+
+    /* 5. DP NaN propagation: the expression's operand order */
+    for (int k = 0; k < 400000; k++) {
+        u128 a, b, t;
+        for (int i = 0; i < 2; i++) {
+            set_d(&a, i, rnd_d()); set_d(&b, i, rnd_d()); set_d(&t, i, rnd_d());
+        }
+        check_dp(a, b, t);
+    }
+    {   /* constant NaN operands (as register caching lets clang see them) */
+        u128 v; set_d(&v, 0, u2d(0x7FF0000000000123ull)); set_d(&v, 1, u2d(0xFFF4000000000456ull));
+        const u128 c1 = dpconst(0x7FF8000000000ABCull, 0xFFF0000000000001ull);
+        const u128 c2 = dpconst(0x3FF0000000000000ull, 0x7FF8000012345678ull);
+        check_dp(c1, v, c2); check_dp(v, c1, c2); check_dp(c2, c1, v); check_dp(c1, c2, v);
+    }
+
+    printf("test_spu_regcache_ls: %d checks, %d failures (%s)\n", s_checks, s_fail,
+#if SPU_SIMD_X86 && defined(__AVX2__)
+           "AVX2"
+#elif SPU_SIMD_X86 && defined(__SSE4_1__)
+           "SSE4.1"
+#elif SPU_SIMD_X86
+           "SSE2"
+#else
+           "no SIMD"
+#endif
+           );
+    return s_fail != 0;
+}
diff --git a/runtime/spu/tests/test_spu_ss_load.c b/runtime/spu/tests/test_spu_ss_load.c
new file mode 100644
index 0000000..0930920
--- /dev/null
+++ b/runtime/spu/tests/test_spu_ss_load.c
@@ -0,0 +1,546 @@
+/*
+ * A save-state load of the SPU sections -- SPUG, SPUC, SPUH (M4c) -- through
+ * the real engine (runtime/savestate/ss_state.c) and the real section code:
+ * lv2_register.c compiled in, so the test can build its tables directly;
+ * spu_channels.c and spu_workload.c linked.
+ *
+ * The world is a group of three SPU threads. One runs on its lifted context
+ * and is parked mid-run: a lock-line reservation held, the decrementer armed
+ * for a while, an MFC engine with a tag held by a list parked at a stall,
+ * words queued in its inbound mailbox, interrupt and residency state, its
+ * host frames' depth -- and a host thread and finish event of its own. One
+ * has ended, its context kept (lv2 keeps it until the group is destroyed),
+ * its decrementer never armed, no engine. The third is a workload-registry
+ * worker between runs, with a lazily allocated local store and a mailbox word
+ * waiting for its next run. Plus the taskset HLE's tables: event bits owed to
+ * a wait object, a latched wake, a parked task.
+ *
+ * That is captured and held (state A), then everything is changed: registers,
+ * local stores, mailboxes, a group and a thread added, a handler dropped, the
+ * counters, the HLE tables. A load follows -- TEARDOWN and then RESTORE, as
+ * the coordinator runs them, with the guest clock frozen at A's instant -- and
+ * then the fidelity check, capture(restore(A)) == A, and the values one by one:
+ * what a load copies, what it rebuilds (ls, the locks, host_depth, the dispatch
+ * cache, the decrementer's anchor, the MFC engine), what it drops (handles,
+ * the parked list), and what RECREATE does to the resumed context before its
+ * thread runs (spu_channels_ss_resume). Last, what check_image refuses before a
+ * load stops anything: a running thread with no context, a local store that
+ * was a guest window, a fallback handler or SPU image tables this build does
+ * not have.
+ *
+ * No game code, and no SPU program runs: RECREATE's host threads and the
+ * resume itself are the coordinator's (test_ss_roundtrip.cpp, and in game).
+ *
+ * Build (Windows, clang-cl; from the toolkit root):
+ *   clang-cl /O1 /std:c17 -MD -msse4.1 -fno-strict-aliasing -ffp-contract=off /w \
+ *       -D_CRT_SECURE_NO_WARNINGS -I include -I runtime/spu -I runtime/platform \
+ *       runtime/spu/tests/test_spu_ss_load.c \
+ *       runtime/spu/spu_channels.c runtime/spu/spu_drain.c runtime/spu/spu_lockstep.c \
+ *       runtime/spu/spu_coherency.c runtime/spu/spu_workload.c runtime/spu/spurs_policy.c \
+ *       runtime/spu/spurs_job.c runtime/spu/spu_tsp_weak.c runtime/spu/spu_vm_pagemap.c \
+ *       runtime/spu/spurs_policy_blob_weak.c runtime/spu/spu_interp.c \
+ *       runtime/spu/spu_lifted_thread.c runtime/syscalls/spu_fallback.c \
+ *       runtime/syscalls/sdk_version_weak.c runtime/savestate/ss_state.c \
+ *       runtime/platform/win32_compat.c /Fe:test_spu_ss_load.exe
+ *
+ * Exit code: 0 if all passed, 1 if any failed. Final line prints a summary.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Guest memory: what lv2_register.c's helpers and the taskset HLE's signal
+ * path index through. The SPU sections keep nothing in it. */
+static uint8_t g_guest[1u << 20];
+uint8_t* vm_base = g_guest;
+uint32_t ppu_vm_size = sizeof g_guest;
+
+/* The unit under test. */
+#include "../../syscalls/lv2_register.c"
+#include "../../platform/guest_clock.h"
+
+/* spu_channels.c and spu_workload.c (linked): the parts this test drives. */
+uint32_t spu_channels_ss_dec(const spu_context* c, uint64_t now, uint32_t* armed);
+uint64_t spu_channels_ss_now(uint64_t qpc, uint64_t qpc_freq);
+void     spu_channels_ss_set_dec(spu_context* c, uint32_t value, int armed);
+void     spu_channels_ss_set_mfc(spu_context* c, uint32_t tags);
+void     spu_begin_image(int image_id);
+void     spu_register_function(uint32_t addr, void (*fn)(spu_context*));
+void     spu_coh_reserve(spu_context* ctx, uint32_t ea);
+void     spu_ef_bits_post(uint32_t obj, uint16_t bits);
+uint16_t spu_ef_bits_take(uint32_t obj);
+void     spu_taskset_latch_wake(uint32_t taskset_ea);
+int      spu_taskset_consume_wake(uint32_t taskset_ea);
+void     spu_taskset_parked_add(uint32_t taskset_ea, uint32_t taskId, uint32_t wait_obj);
+int      spu_taskset_signal_parked_obj(uint32_t taskset_ea, uint32_t wait_obj);
+
+/* ---------------------------------------------------------------------------
+ * Harness
+ * -----------------------------------------------------------------------*/
+static int g_pass, g_fail;
+static const char* g_current = "(none)";
+
+#define TEST(name) g_current = (name)
+#define CHECK(cond) do {                                          \
+    if (cond) { g_pass++; }                                       \
+    else {                                                        \
+        g_fail++;                                                 \
+        fprintf(stderr, "FAIL: %s\n  at %s:%d: %s\n",             \
+                g_current, __FILE__, __LINE__, #cond);            \
+    }                                                             \
+} while (0)
+
+/* ---------------------------------------------------------------------------
+ * The world
+ * -----------------------------------------------------------------------*/
+#define G_SLOT     2u              /* the group's table slot (not 0: keys are slots) */
+#define G_ID       0x1005u
+#define T_RUN      3u              /* slots: the running lifted thread, */
+#define T_END      4u              /* the ended one, */
+#define T_WRK      7u              /* the registry worker */
+#define TID_RUN    0x2003u
+#define TID_END    0x2004u
+#define TID_WRK    0x2007u
+#define LINE       0x00040080u     /* the reserved line */
+#define WRK_FP     0x5A5A0123456789A5ull
+#define TS_A       0x00032000u     /* tasksets / wait objects of the HLE tables */
+#define TS_B       0x00031000u
+#define OBJ_A      0x00030000u
+
+static void fake_entry(spu_context* c) { (void)c; }
+static int32_t fake_fallback(uint32_t tid, uint32_t a, uint32_t s, void* u)
+{ (void)tid; (void)a; (void)s; (void)u; return 0; }
+
+static spu_context* new_ctx(uint32_t tid, uint8_t seed)
+{
+    spu_context* c = (spu_context*)calloc(1, sizeof *c);
+    if (!c) { fprintf(stderr, "out of memory\n"); exit(2); }
+    spu_context_init(c, tid);
+    c->spu_group_id = G_ID;
+    for (int r = 0; r < 128; r++)
+        for (int k = 0; k < 4; k++) c->gpr[r]._u32[k] = (uint32_t)(seed << 24) ^ (uint32_t)(r * 0x10001 + k);
+    for (uint32_t i = 0; i < SPU_LS_SIZE; i++) c->ls_store[i] = (uint8_t)(i * 7u + seed);
+    c->image_id = seed & 0x3F;
+    return c;
+}
+
+static HANDLE g_run_thread_h, g_run_event_h, g_end_event_h;
+
+static void build_world(void)
+{
+    s_spu_next_group_id = G_ID + 1;
+    s_spu_next_thread_id = 0x2008;
+    s_spu_initialized = 1;
+    s_spu_seg_bump = 0x0D000180u;
+    s_spu_img_bump = SPU_IMAGE_STAGE_BASE + 0x400u;
+
+    spu_group_t* g = &s_spu_groups[G_SLOT];
+    memset(g, 0, sizeof *g);
+    g->in_use = 1;
+    g->id = G_ID;
+    g->state = SPU_GROUP_STATE_RUNNING;
+    g->num_threads = 3;
+    for (int k = 0; k < 8; k++) g->thread_indices[k] = 0xFFFFFFFFu;
+    g->thread_indices[0] = T_RUN;
+    g->thread_indices[1] = T_END;
+    g->thread_indices[5] = T_WRK;
+    strcpy(g->name, "ss_test_group");
+    g->event_queue_id = 9;
+    g->user_event_ports[3] = 77;
+
+    /* the running lifted thread, parked in an Lr wait (as SPURS kernels park) */
+    spu_thread_t* t = &s_spu_threads[T_RUN];
+    memset(t, 0, sizeof *t);
+    t->in_use = 1; t->tid = TID_RUN; t->group_id = G_ID; t->index = 0;
+    t->entry_point = 0x818; t->args_ea = 0x10000; t->img_ea = 0x10100; t->spu_cfg = 1;
+    for (int a = 0; a < 4; a++) t->args[a] = 0x1111111100000000ull * (uint64_t)(a + 1) + (uint64_t)a;
+    t->running = 1;
+    t->connected_queue = 5; t->connect_spup = 0x2A;
+    t->evt_bind[0].spup = 0x2A; t->evt_bind[0].queue = 5;
+    t->evt_bind[1].spup = 0x01; t->evt_bind[1].queue = 6;
+    t->evt_bind_n = 2;
+    t->q_bind[0].spuq_num = 0x10; t->q_bind[0].queue = 8;
+    t->q_bind_n = 1;
+    spu_context* c = t->sctx = new_ctx(TID_RUN, 0x31);
+    c->pc = 0x1178;
+    c->status = SPU_STATUS_WAITING_CHANNEL;
+    c->event_mask = SPU_EVENT_LR;
+    c->ch_in_mbox.q[0] = 0xAAAA0001u; c->ch_in_mbox.q[1] = 0xAAAA0002u;
+    c->ch_in_mbox.count = 2; c->ch_in_mbox.head = 0; c->ch_in_mbox.value = 0xAAAA0001u;
+    c->ch_out_mbox.value = 0x55;
+    c->rcv_evt[0] = 0; c->rcv_evt[1] = 0x77; c->rcv_evt_n = 3; c->rcv_evt_i = 1;
+    c->mfc_tag_mask = 0x9; c->mfc_tag_status = 0x1; c->mfc_lsa = 0x2000; c->mfc_size = 0x80;
+    c->resv_ea = LINE; c->resv_valid = 1; memset(c->resv_line, 0xC3, sizeof c->resv_line); c->atomic_stat = 2;
+    c->resident_ovl = 7;
+    c->resident_code[1].lsa = 0x4000; c->resident_code[1].size = 0x800; c->resident_code[1].image_id = 12;
+    c->steps = 12345; c->module_img_a00 = 3; c->int_enable = 1;
+    c->list_stall_mask = 1u << 3; c->list_stall_elem_lsa[3] = 0x2000; c->list_stall_remaining[3] = 4;
+    c->list_stall_ea_base[3] = 0x100000000ull; c->list_stall_cmd[3] = MFC_GETL_CMD;
+    c->irq_resume_pc = 0x880; c->irq_gpr[5]._u32[1] = 0xABCDEF;
+    c->pic_bias = 0x100;
+    /* host state a load must not carry over */
+    c->host_depth = 3; c->drain_ret_pc = 0x1200; c->dbg_getllar = 99;
+    c->ib_dep = 2; c->ib_ret = 0x40; c->ibc_ggen = 7; c->res_gen = 5;
+    c->irq_frame = (void*)c;                 /* a host frame: any non-NULL */
+    c->ibc[3].pc = 0x1178; c->ibc[3].fn = fake_entry;
+    spu_channels_ss_set_dec(c, 0x00100000u, 1);
+    c->dec_base_ns -= 2000000u;              /* armed 2 ms ago */
+    spu_channels_ss_set_mfc(c, 0xFFFFFFF7u); /* tag 3: the list parked at a stall */
+    spu_coh_reserve(c, LINE);                /* in the lock-line notify registry */
+    t->host_thread = g_run_thread_h = CreateEventA(NULL, TRUE, FALSE, NULL);   /* stand-in handles */
+    t->finish_event = g_run_event_h = CreateEventA(NULL, TRUE, FALSE, NULL);
+
+    /* the ended lifted thread */
+    t = &s_spu_threads[T_END];
+    memset(t, 0, sizeof *t);
+    t->in_use = 1; t->tid = TID_END; t->group_id = G_ID; t->index = 1;
+    t->entry_point = 0x818; t->exit_status = 7;
+    c = t->sctx = new_ctx(TID_END, 0x52);
+    c->pc = 0x2F0; c->status = SPU_STATUS_STOPPED_BY_STOP; c->stop_code = 0x102;
+    c->decrementer = 0x777;                  /* written, never armed */
+    t->finish_event = g_end_event_h = CreateEventA(NULL, TRUE, TRUE, NULL);
+
+    /* the registry worker between runs */
+    t = &s_spu_threads[T_WRK];
+    memset(t, 0, sizeof *t);
+    t->in_use = 1; t->tid = TID_WRK; t->group_id = G_ID; t->index = 5;
+    t->entry_point = 0x4444; t->pending_inmbox = 0xBEEF;
+    t->fb_handler = spu_registry_fallback;
+    t->fb_user = (void*)(uintptr_t)WRK_FP;
+    t->local_store = (uint8_t*)calloc(1, SPU_LS_SIZE);
+    for (uint32_t i = 0; i < SPU_LS_SIZE; i++) t->local_store[i] = (uint8_t)(i * 13u + 1u);
+    spu_workload_register_img(WRK_FP, fake_entry, 12, "ss_test_worker");
+
+    /* the taskset HLE */
+    spu_ef_bits_post(OBJ_A, 0x5);
+    spu_taskset_latch_wake(TS_B);
+    spu_taskset_parked_add(TS_A, 4, OBJ_A);
+}
+
+/* Everything changed, the way playing on from A changes it. */
+static void change_world(void)
+{
+    spu_context* c = s_spu_threads[T_RUN].sctx;
+    c->gpr[3]._u32[0] ^= 0xFFFFu;
+    c->pc = 0x2000;
+    c->ls_store[0x100] ^= 0xFF;
+    c->ch_in_mbox.count = 0;
+    c->resv_valid = 0;
+    c->event_status = SPU_EVENT_LR;
+    c->list_stall_mask = 0;
+    spu_channels_ss_set_dec(c, 0x42, 1);
+    spu_channels_ss_set_mfc(c, 0xFFFFFFFFu);
+    s_spu_threads[T_END].exit_status = 9;
+    s_spu_threads[T_END].sctx->pc = 0x10;
+    s_spu_threads[T_WRK].fb_handler = NULL;
+    s_spu_threads[T_WRK].local_store[0x20] ^= 0xFF;
+    s_spu_threads[T_WRK].pending_inmbox = 0;
+
+    spu_thread_t* t = &s_spu_threads[9];      /* a thread A never had */
+    memset(t, 0, sizeof *t);
+    t->in_use = 1; t->tid = 0x2009; t->group_id = 0x1006; t->running = 1;
+    t->sctx = new_ctx(0x2009, 0x77);
+    t->local_store = NULL;
+    spu_group_t* g = &s_spu_groups[5];        /* ...and a group */
+    memset(g, 0, sizeof *g);
+    g->in_use = 1; g->id = 0x1006; g->num_threads = 1;
+    for (int k = 0; k < 8; k++) g->thread_indices[k] = 0xFFFFFFFFu;
+    g->thread_indices[0] = 9;
+    s_spu_next_group_id = 0x1007;
+    s_spu_next_thread_id = 0x200A;
+    s_spu_seg_bump = 0x0D000300u;
+
+    spu_ef_bits_post(OBJ_A, 0x30);
+    spu_ef_bits_post(OBJ_A + 0x3000u, 0x1);
+    (void)spu_taskset_consume_wake(TS_B);
+    spu_taskset_parked_add(TS_A + 0x2000u, 1, 0);
+}
+
+static int handle_open(HANDLE h)
+{
+    DWORD f = 0;
+    return GetHandleInformation(h, &f) != 0;
+}
+
+static const ss_image* capture(char* why, size_t n)
+{
+    uint32_t fc = 0;
+    ss_capture_info ci;
+    memset(&ci, 0, sizeof ci);
+    if (ss_state_prepare(why, n) != SS_OK) return NULL;
+    if (ss_state_capture(&ci, why, n, &fc) != SS_OK) return NULL;
+    ss_state_seal();
+    return ss_image_last();
+}
+
+/* check_image on a fresh capture of the world as it stands now: 0, or the
+ * refusal with its words in why. */
+static int check_now(char* why, size_t n)
+{
+    const ss_image* img = capture(why, n);
+    if (!img) return -100;
+    uint32_t fc = 0;
+    why[0] = 0;
+    const int r = ss_state_check_image(img, why, n, &fc);
+    if (r) printf("  refused: %s\n", why);
+    return r;
+}
+
+int main(void)
+{
+    char why[256];
+    { LARGE_INTEGER q; QueryPerformanceCounter(&q); g_guest_qpc_frozen = q.QuadPart; }   /* as a stop freezes it */
+    ss_state_set_arena(NULL, 0);
+    ss_state_set_margin(8u << 20);
+    TEST("the save-state engine starts");
+    CHECK(ss_state_enable());
+
+    build_world();
+    const uint64_t now = spu_channels_ss_now(0, 0);
+    uint32_t armed = 0;
+    const uint32_t dec_a = spu_channels_ss_dec(s_spu_threads[T_RUN].sctx, now, &armed);
+    spu_context* run_a = (spu_context*)malloc(sizeof(spu_context));
+    spu_context* end_a = (spu_context*)malloc(sizeof(spu_context));
+    uint8_t* wls_a = (uint8_t*)malloc(SPU_LS_SIZE);
+    spu_group_t grp_a = s_spu_groups[G_SLOT];
+    spu_thread_t thr_a[3] = { s_spu_threads[T_RUN], s_spu_threads[T_END], s_spu_threads[T_WRK] };
+    if (!run_a || !end_a || !wls_a) return 2;
+    memcpy(run_a, s_spu_threads[T_RUN].sctx, sizeof *run_a);
+    memcpy(end_a, s_spu_threads[T_END].sctx, sizeof *end_a);
+    memcpy(wls_a, s_spu_threads[T_WRK].local_store, SPU_LS_SIZE);
+
+    TEST("state A captures, holds and passes check_image");
+    why[0] = 0;
+    CHECK(capture(why, sizeof why) != NULL);
+    if (why[0]) fprintf(stderr, "  capture: %s\n", why);
+    const ss_image* a = ss_image_hold();
+    CHECK(a != NULL);
+    if (!a) return 1;
+    uint32_t fc = 0;
+    CHECK(ss_state_check_image(a, why, sizeof why, &fc) == SS_OK);
+    if (fc) fprintf(stderr, "  check_image: %s\n", why);
+
+    change_world();
+
+    /* ---- the load: teardown, restore (the coordinator's order) ---- */
+    TEST("teardown leaves the boot state and closes every handle");
+    ss_state_teardown();
+    int empty = 1;
+    for (int i = 0; i < MAX_SPU_THREADS; i++) empty &= !s_spu_threads[i].in_use && !s_spu_threads[i].sctx;
+    for (int i = 0; i < MAX_SPU_GROUPS; i++) empty &= !s_spu_groups[i].in_use;
+    CHECK(empty);
+    CHECK(s_spu_next_group_id == 0x1000 && s_spu_next_thread_id == 0x2000 && !s_spu_initialized);
+    CHECK(s_spu_seg_bump == 0x0D000000u && s_spu_img_bump == SPU_IMAGE_STAGE_BASE);
+    CHECK(!handle_open(g_run_thread_h) && !handle_open(g_run_event_h) && !handle_open(g_end_event_h));
+    CHECK(spu_ef_bits_take(OBJ_A + 0x3000u) == 0);
+
+    TEST("A restores");
+    unsigned norestore = 0;
+    why[0] = 0;
+    CHECK(ss_state_restore(a, why, sizeof why, &fc, &norestore) == SS_OK);
+    if (why[0]) fprintf(stderr, "  restore: %s\n", why);
+
+    TEST("the fidelity check: capture(restore(A)) == A, section by section");
+    const ss_image* b = capture(why, sizeof why);
+    CHECK(b != NULL);
+    ss_verify_result v;
+    memset(&v, 0, sizeof v);
+    if (b) ss_state_verify(a, ss_image_captured(), &v);
+    CHECK(v.compared >= 3 && v.differ == 0);
+    printf("  fidelity check: %u section(s) compared, %u differ\n", v.compared, v.differ);
+    for (unsigned i = 0; i < v.n; i++)
+        if (v.sec[i].diffs) {
+            char f4[5];
+            fprintf(stderr, "  verify %s: %u difference(s), first: %s\n", ss_fourcc_str(v.sec[i].fourcc, f4),
+                    v.sec[i].diffs, v.sec[i].first);
+        }
+
+    TEST("SPUG: the statics, the group and the threads at their slots");
+    CHECK(s_spu_next_group_id == G_ID + 1 && s_spu_next_thread_id == 0x2008 && s_spu_initialized == 1);
+    CHECK(s_spu_seg_bump == 0x0D000180u && s_spu_img_bump == SPU_IMAGE_STAGE_BASE + 0x400u);
+    CHECK(s_spu_groups[G_SLOT].in_use && !memcmp(&s_spu_groups[G_SLOT], &grp_a, sizeof grp_a));
+    CHECK(!s_spu_groups[5].in_use && !s_spu_threads[9].in_use);
+    const uint32_t slots[3] = { T_RUN, T_END, T_WRK };
+    for (int k = 0; k < 3; k++) {
+        const spu_thread_t* t = &s_spu_threads[slots[k]];
+        const spu_thread_t* o = &thr_a[k];
+        CHECK(t->in_use && t->tid == o->tid && t->group_id == o->group_id && t->index == o->index);
+        CHECK(t->exit_status == o->exit_status && t->entry_point == o->entry_point && t->running == o->running);
+        CHECK(!memcmp(t->args, o->args, sizeof t->args) && t->img_ea == o->img_ea && t->spu_cfg == o->spu_cfg);
+        CHECK(t->pending_inmbox == o->pending_inmbox && t->connected_queue == o->connected_queue);
+        CHECK(t->evt_bind_n == o->evt_bind_n && !memcmp(t->evt_bind, o->evt_bind, sizeof t->evt_bind));
+        CHECK(t->q_bind_n == o->q_bind_n && !memcmp(t->q_bind, o->q_bind, sizeof t->q_bind));
+        CHECK(!t->host_thread && !t->finish_event && !t->live_ctx);   /* RECREATE's */
+    }
+    CHECK(s_spu_threads[T_WRK].fb_handler == spu_registry_fallback);
+    CHECK(s_spu_threads[T_WRK].fb_user == (void*)(uintptr_t)WRK_FP);
+    CHECK(!s_spu_threads[T_WRK].sctx && s_spu_threads[T_WRK].local_store &&
+          !memcmp(s_spu_threads[T_WRK].local_store, wls_a, SPU_LS_SIZE));
+    CHECK(!s_spu_threads[T_RUN].fb_handler && !s_spu_threads[T_RUN].local_store);
+    CHECK(lv2_spu_bound_queue(s_spu_threads[T_RUN].sctx, 0x10) == 8);   /* follows the new context */
+
+    TEST("SPUC: the running context, copied where it is guest state");
+    const spu_context* c = s_spu_threads[T_RUN].sctx;
+    CHECK(c != NULL);
+    if (!c) return 1;
+    CHECK(!memcmp(c->gpr, run_a->gpr, sizeof c->gpr) && !memcmp(c->ls_store, run_a->ls_store, SPU_LS_SIZE));
+    CHECK(c->pc == 0x1178 && c->status == SPU_STATUS_WAITING_CHANNEL && c->image_id == run_a->image_id);
+    CHECK(c->spu_id == TID_RUN && c->spu_group_id == G_ID);
+    CHECK(c->ch_in_mbox.count == 2 && c->ch_in_mbox.head == 0 && c->ch_in_mbox.value == 0xAAAA0001u &&
+          !memcmp(c->ch_in_mbox.q, run_a->ch_in_mbox.q, sizeof c->ch_in_mbox.q));
+    CHECK(c->ch_out_mbox.value == 0x55 && c->rcv_evt_n == 3 && c->rcv_evt_i == 1 && c->rcv_evt[1] == 0x77);
+    CHECK(c->mfc_tag_mask == 0x9 && c->mfc_tag_status == 0x1 && c->mfc_lsa == 0x2000 && c->mfc_size == 0x80);
+    CHECK(c->resv_valid == 1 && c->resv_ea == LINE && !memcmp(c->resv_line, run_a->resv_line, 128));
+    CHECK(c->event_mask == SPU_EVENT_LR && c->event_status == 0 && c->atomic_stat == 2);
+    CHECK(c->resident_ovl == 7 && !memcmp(c->resident_code, run_a->resident_code, sizeof c->resident_code));
+    CHECK(c->steps == 12345 && c->module_img_a00 == 3 && c->int_enable == 1 && c->pic_bias == 0x100);
+    CHECK(c->list_stall_mask == (1u << 3) && c->list_stall_elem_lsa[3] == 0x2000 &&
+          c->list_stall_remaining[3] == 4 && c->list_stall_ea_base[3] == 0x100000000ull &&
+          c->list_stall_cmd[3] == MFC_GETL_CMD);
+    CHECK(c->irq_resume_pc == 0x880 && !memcmp(c->irq_gpr, run_a->irq_gpr, sizeof c->irq_gpr));
+
+    TEST("SPUC: ...and rebuilt where it is the host's");
+    CHECK(c->ls == c->ls_store);
+    CHECK(c->host_depth == 0 && c->drain_ret_pc == 0 && c->dbg_getllar == 0);
+    CHECK(c->ib_dep == 0 && c->ib_ret == 0 && c->ibc_ggen == 0 && c->res_gen == 0 && c->ibc[3].fn == NULL);
+    CHECK(c->irq_frame == NULL && c->ch_wait_cv == NULL && c->ch_wait_lock == NULL && c->ch_in_mbox.lock == 0);
+    CHECK(spu_channels_ss_dec(c, now, &armed) == dec_a && armed == 1);   /* what A's read returned */
+    CHECK(spu_channels_ss_dec(c, now + 1000000u, &armed) == dec_a - 79800u);   /* and counting at 79.8 MHz */
+    uint32_t tags = 0, queued = 0;
+    CHECK(spu_channels_ss_mfc(c, &tags, &queued) >= 0 && tags == 0xFFFFFFF7u && queued == 0);
+    CHECK(!spu_coh_is_registered(c));        /* its next GETLLAR registers it */
+
+    TEST("SPUC: the ended context");
+    const spu_context* e = s_spu_threads[T_END].sctx;
+    CHECK(e != NULL);
+    if (!e) return 1;
+    CHECK(e->pc == 0x2F0 && e->stop_code == 0x102 && !memcmp(e->ls_store, end_a->ls_store, SPU_LS_SIZE));
+    CHECK(spu_channels_ss_dec(e, now + 5000000u, &armed) == 0x777 && armed == 0 && e->dec_base_ns == 0);
+    CHECK(spu_channels_ss_mfc(e, &tags, &queued) == -1 && tags == 0xFFFFFFFFu);
+
+    TEST("SPUH: the HLE tables, the parked list empty");
+    CHECK(spu_ef_bits_take(OBJ_A) == 0x5);
+    CHECK(spu_ef_bits_take(OBJ_A + 0x3000u) == 0);
+    CHECK(spu_taskset_consume_wake(TS_B) == 1);
+    CHECK(spu_taskset_signal_parked_obj(TS_A, 0) == 0 && spu_taskset_signal_parked_obj(TS_A + 0x2000u, 0) == 0);
+
+    TEST("RECREATE: the resumed context's reservation dropped, Lr raised");
+    spu_channels_ss_resume(s_spu_threads[T_RUN].sctx);
+    CHECK(c->resv_valid == 0 && (c->event_status & SPU_EVENT_LR));
+
+    /* ---- what check_image refuses, before a load stops anything ---- */
+    TEST("check_image: the world as restored passes");
+    s_spu_threads[T_RUN].sctx->resv_valid = 1;
+    CHECK(check_now(why, sizeof why) == SS_OK);
+
+    TEST("check_image: a running thread with no context (a fallback run) is refused");
+    s_spu_threads[T_WRK].running = 1;
+    CHECK(check_now(why, sizeof why) != SS_OK && strstr(why, "SPUG") && strstr(why, "not resumable"));
+    s_spu_threads[T_WRK].running = 0;
+
+    TEST("check_image: a context on a guest local-store window is refused");
+    s_spu_threads[T_END].sctx->ls = g_guest;
+    CHECK(check_now(why, sizeof why) != SS_OK && strstr(why, "SPUC") && strstr(why, "ls_saved"));
+    s_spu_threads[T_END].sctx->ls = s_spu_threads[T_END].sctx->ls_store;
+
+    TEST("check_image: a PPU fallback this build does not have is refused");
+    s_spu_threads[T_WRK].fb_handler = fake_fallback;
+    CHECK(check_now(why, sizeof why) != SS_OK && strstr(why, "no PPU fallback"));
+    spu_register_ppu_fallback(0x4444, fake_fallback, NULL);
+    CHECK(check_now(why, sizeof why) == SS_OK);
+
+    TEST("check_image: an image from other SPU image tables is refused");
+    {   const ss_image* img = capture(why, sizeof why);
+        CHECK(img != NULL);
+        spu_begin_image(63);
+        spu_register_function(0x3000, fake_entry);   /* the registry moves under the image */
+        CHECK(img && ss_state_check_image(img, why, sizeof why, &fc) != SS_OK && strstr(why, "image_table"));
