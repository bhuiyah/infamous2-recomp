+    if (s_tph.dfr.n) tph_drain();         /* ST1 TEX_PLACED: the blocks of resources buried in an earlier batch */
+    if (s_tc.batch % 60u == 0) vram_tick();   /* ST1: local video memory, its high-water mark, the budget */
+    else if (s_tc.ntmp) (void)vram_sample(NULL, NULL);   /* (the overflow buffers still held: their peak) */
