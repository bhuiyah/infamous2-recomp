+static void test_ds4_bt_bad_calibration(void)
+{
+    printf("DS4 Bluetooth: calibration with a bad CRC -> retried, then nominal scales\n");
+    mock_reset();
+    u8 bad[41]; memcpy(bad, vec_ds4_bt_cal, 41); bad[40] ^= 0x80;
