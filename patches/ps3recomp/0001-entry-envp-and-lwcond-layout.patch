+     { (void)d; (void)b; (void)v; (void)p; (void)s; (void)i; (void)o; return -1; }
+int  padhost_virtual_prepare(const PadHostDriver* d, int b, u16 v, u16 p, const char* s, int i, int o)
+     { (void)d; (void)b; (void)v; (void)p; (void)s; (void)i; (void)o; return -1; }
