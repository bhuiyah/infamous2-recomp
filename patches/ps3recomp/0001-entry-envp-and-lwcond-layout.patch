diff --git a/runtime/spu/spu_sandbox.h b/runtime/spu/spu_sandbox.h
new file mode 100644
index 0000000..7a4ff1a
--- /dev/null
+++ b/runtime/spu/spu_sandbox.h
@@ -0,0 +1,105 @@
+/* spu_sandbox.h -- per-thread SPU side-effect sandbox (SPU_JOB_VERIFY).
+ *
+ * A sandbox governs exactly ONE spu_context on the current host thread. It is
+ * consulted at the lowest layer every SPU side effect passes through, for
+ * lifted and interpreted code alike: spu_wrch / spu_rdch / spu_rchcnt
+ * (spu_channels.c), the DMA element executor mfc_do_transfer (spu_dma.h:
+ * single transfers, list elements and stall-ack resumes), the interrupt
+ * take / iret pair (spu_drain.c) and the interpreter step loop (spu_interp.c).
+ *
+ *   SPU_SBX_REC     the real context: every op is journaled, then performed
+ *                   exactly as without a sandbox;
+ *   SPU_SBX_REPLAY  a clone: reads are answered from a REC journal, writes are
+ *                   compared with it, and nothing leaves the clone.
+ *
+ * Hooks call through `ops`, so no hook site links against the implementation
+ * (spu_jobverify.inc). The gates are SPU_GATE (selectany / weak) data, so every
+ * target that includes spu_dma.h still links without spu_channels.c. Off, the
+ * cost is one load of g_spu_sbx_live and a not-taken branch. */
+#ifndef SPU_SANDBOX_H
+#define SPU_SANDBOX_H
+#include "spu_context.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { SPU_SBX_REC = 1, SPU_SBX_REPLAY = 2 };
+enum { SPU_SBX_EV_WRCH = 1, SPU_SBX_EV_RDCH = 2, SPU_SBX_EV_RCHCNT = 3 };
+enum { SPU_SBX_ABORT_DIVERGED = 1, SPU_SBX_ABORT_STEPS, SPU_SBX_ABORT_TIME,
+       SPU_SBX_ABORT_OVERFLOW, SPU_SBX_ABORT_LONGJMP };
+
+struct spu_sbx;
+typedef struct spu_sbx_ops {
+    /* REC: observe the real context; never change it */
+    void     (*rec_chan)(struct spu_sbx*, spu_context*, int kind, uint32_t ch, uint32_t value);
+    void     (*rec_xfer)(struct spu_sbx*, spu_context*, uint32_t lsa, uint64_t ea,
+                         uint32_t size, uint32_t cmd, int rc);
+    void     (*rec_atomic)(struct spu_sbx*, spu_context*, uint32_t cmd);
+    void     (*rec_irq)(struct spu_sbx*, spu_context*, int begin);
+    /* REPLAY: the clone's ops; nothing external is performed */
+    void     (*wrch)(struct spu_sbx*, spu_context*, uint32_t ch, uint32_t value);
+    uint32_t (*rdch)(struct spu_sbx*, spu_context*, uint32_t ch);
+    uint32_t (*rchcnt)(struct spu_sbx*, spu_context*, uint32_t ch);
+    int      (*xfer)(struct spu_sbx*, spu_context*, uint32_t lsa, uint64_t ea,
+                     uint32_t size, uint32_t cmd);
+    int      (*poll)(struct spu_sbx*, spu_context*);   /* every 64K steps: nonzero = stop */
+    void     (*at_pc)(struct spu_sbx*, spu_context*);  /* REPLAY: the next pc is wait_pc */
+} spu_sbx_ops;
+
+typedef struct spu_sbx {
+    spu_context*       ctx;        /* the one context governed */
+    int                mode;       /* SPU_SBX_REC / SPU_SBX_REPLAY */
+    int                moved;      /* REC: set where mfc_do_transfer_impl moves data */
+    int                abort;      /* REPLAY: nonzero = the interpreter stops */
+    uint64_t           steps, max_steps;
+    uint32_t           ring[32];   /* REPLAY: the clone's last interpreted pcs */
+    uint32_t           wait_pc;    /* REPLAY: with `wait`, call ops->at_pc when the */
+    int                wait;       /*   interpreter's next pc is wait_pc            */
+    const spu_sbx_ops* ops;
+    void*              priv;
+} spu_sbx;
+
+/* Sandboxes alive on any thread (the fast-path gate), and the accessor for
+ * this thread's sandbox (installed by spu_channels.c once SPU_JOB_VERIFY arms).
+ *
+ * Both live alone on one cache line. Every spu_wrch / spu_rdch / spu_rchcnt
+ * and every DMA element reads the gate, several times per transfer, and as a
+ * bare selectany global the linker had put it in the same 64 bytes as
+ * spu_depth_guard's ring counter and spu_drain_call's statics -- which every
+ * SPU host thread writes on every drain. Each of those reads was a cross-core
+ * miss: the gate load was the hottest instruction of spu_wrch, mfc_run_list
+ * and the DMA engine in the inFamous 2 gameplay profile. The struct is
+ * 64-byte aligned and 64 bytes long, so nothing else can share its line. */
