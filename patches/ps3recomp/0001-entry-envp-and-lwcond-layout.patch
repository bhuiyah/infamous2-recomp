+/* ---- wheel ------------------------------------------------------------ */
+
+static void test_wheel(void)
+{
+    KbmConfig c;
+    KbmRuntime rt;
+    KbmOut o;
+    kbm_config_defaults(&c);                           /* WheelUp = d-pad Up, 100 ms */
+    kbm_runtime_reset(&rt);
+    keys_clear();
+
+    /* two notches up in one report: two separate presses */
+    double t = 0.0;
+    kbm_eval(&c, &rt, fake_down, NULL, t, 0, 0, 2 * KBM_WHEEL_DELTA, &o);
+    int presses = 0, prev = 0, down_ms = 0;
+    if (o.buttons & CTRL_UP) { presses++; prev = 1; }
+    for (int i = 1; i <= 100; i++) {                   /* 400 ms of 4 ms reports */
+        t = i * 4.0;
+        kbm_eval(&c, &rt, fake_down, NULL, t, 0, 0, 0, &o);
+        int d = (o.buttons & CTRL_UP) != 0;
+        if (d && !prev) presses++;
+        down_ms += d ? 4 : 0;
+        prev = d;
+        CHECK(!(o.buttons & CTRL_DOWN));
+    }
+    CHECK_EQ(presses, 2);
+    CHECK(down_ms >= 180 && down_ms <= 220);           /* 2 x 100 ms */
+    CHECK(!prev);                                      /* released at the end */
+
+    /* a smooth-scrolling wheel: fractions accumulate to one notch down */
+    kbm_runtime_reset(&rt);
+    presses = 0; prev = 0;
+    for (int i = 0; i < 60; i++) {
+        kbm_eval(&c, &rt, fake_down, NULL, i * 4.0, 0, 0, i < 4 ? -30 : 0, &o);
+        int d = (o.buttons & CTRL_DOWN) != 0;
+        if (d && !prev) presses++;
+        prev = d;
+    }
+    CHECK_EQ(presses, 1);
+}
+
+/* ---- mouse -> right stick ---------------------------------------------- */
+
+typedef struct { double integral_x, integral_y; int last_rx, last_ry; } Run;
+
+/* Feed `n` reports `dt` ms apart with (dx, dy) counts each, then `tail`
+ * reports of no motion. Integrates the stick deflection over time (s). */
+static Run mouse_run(const KbmConfig* c, double dt, int n, long dx, long dy, int tail)
+{
+    KbmRuntime rt;
+    KbmOut o;
+    Run r = {0, 0, 128, 128};
+    kbm_runtime_reset(&rt);
+    keys_clear();
+    double t = 5000.0;
+    kbm_eval(c, &rt, fake_down, NULL, t, 0, 0, 0, &o);  /* prime */
+    for (int i = 0; i < n + tail; i++) {
+        t += dt;
+        long mx = i < n ? dx : 0, my = i < n ? dy : 0;
+        kbm_eval(c, &rt, fake_down, NULL, t, mx, my, 0, &o);
+        r.integral_x += o.rx * dt / 1000.0;
+        r.integral_y += o.ry * dt / 1000.0;
+        r.last_rx = kbm_axis_u8(o.rx);
+        r.last_ry = kbm_axis_u8(o.ry);
+    }
+    return r;
+}
+
+static void test_mouse_speed(void)
+{
+    KbmConfig c;
+    kbm_config_defaults(&c);
+    c.anti_deadzone = 0.0f;
+
+    /* 1500 counts/s (24 per 16 ms report) at sensitivity 1 = full deflection */
+    Run r = mouse_run(&c, 16.0, 10, 24, 0, 0);
+    CHECK_EQ(r.last_rx, 255);
+    CHECK_EQ(r.last_ry, 128);
+    /* half the speed: half deflection */
+    r = mouse_run(&c, 16.0, 10, 12, 0, 0);
+    CHECK_NEAR(r.last_rx, 192, 1);
+    /* sensitivity scales it */
+    c.mouse_sens = 2.0f;
+    r = mouse_run(&c, 16.0, 10, 6, 0, 0);
+    CHECK_NEAR(r.last_rx, 192, 1);
+    c.mouse_sens = 1.0f;
+    /* left / up */
+    r = mouse_run(&c, 16.0, 10, -12, 0, 0);
+    CHECK_NEAR(r.last_rx, 64, 1);
+    r = mouse_run(&c, 16.0, 10, 0, -12, 0);            /* mouse pushed away = look up */
+    CHECK_NEAR(r.last_ry, 64, 1);
+    CHECK_EQ(r.last_rx, 128);
+    /* invert Y */
+    c.invert_y = 1;
+    r = mouse_run(&c, 16.0, 10, 0, -12, 0);
+    CHECK_NEAR(r.last_ry, 192, 1);
+    c.invert_y = 0;
+    /* Y sensitivity multiplier */
+    c.mouse_sens_y = 0.5f;
+    r = mouse_run(&c, 16.0, 10, 0, 24, 0);
+    CHECK_NEAR(r.last_ry, 192, 1);
+    c.mouse_sens_y = 1.0f;
+    /* report rate does not matter: 4 ms reports, same speed */
+    r = mouse_run(&c, 4.0, 40, 3, 0, 0);
+    CHECK_NEAR(r.last_rx, 192, 1);
+    /* nor does a slow game poll (70 ms, longer than the window) */
+    r = mouse_run(&c, 70.0, 5, 52, 0, 0);
+    CHECK_NEAR(r.last_rx, 191, 2);
+}
+
+static void test_mouse_saturation(void)
+{
+    KbmConfig c;
+    kbm_config_defaults(&c);
+    Run r = mouse_run(&c, 16.0, 10, 100000, 0, 0);
+    CHECK_EQ(r.last_rx, 255);
+    r = mouse_run(&c, 16.0, 10, -100000, 0, 0);
+    CHECK_EQ(r.last_rx, 0);
+    /* diagonal: clamped to the unit circle, direction kept */
+    r = mouse_run(&c, 16.0, 10, 5000, 5000, 0);
+    CHECK_NEAR(r.last_rx, 218, 1);                     /* 128 + 128 * 0.707 */
+    CHECK_NEAR(r.last_ry, 218, 1);
+    {
+        KbmRuntime rt;
+        KbmOut o;
+        kbm_runtime_reset(&rt);
+        keys_clear();
+        kbm_eval(&c, &rt, fake_down, NULL, 0.0, 0, 0, 0, &o);
+        kbm_eval(&c, &rt, fake_down, NULL, 16.0, 9000, -9000, 0, &o);
+        CHECK(o.rx * o.rx + o.ry * o.ry <= 1.0001f);
+    }
+    /* mouse + a right-stick key: summed, each axis clamped */
+    {
+        KbmRuntime rt;
+        KbmOut o;
+        kbm_runtime_reset(&rt);
+        keys_clear();
+        press("L");
+        kbm_eval(&c, &rt, fake_down, NULL, 0.0, 0, 0, 0, &o);
+        kbm_eval(&c, &rt, fake_down, NULL, 16.0, 500, 0, 0, &o);
+        CHECK_EQ(kbm_axis_u8(o.rx), 255);
+        keys_clear();
+    }
+}
