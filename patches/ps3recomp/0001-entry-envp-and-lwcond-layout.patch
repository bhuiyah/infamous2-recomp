+    m(RSX_M_RENDER_ENABLE, 0x02000000u | 0x500u);  /* report there reads 0 */
+    rsx_report_begin(NULL);
+    CHECK(rsx_report_draw_allowed() == 1, "RENDER_COND=0 ignores the condition");
+    env("RENDER_COND=1");
