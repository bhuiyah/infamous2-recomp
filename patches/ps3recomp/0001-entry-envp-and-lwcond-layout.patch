+#    endif
+#    define SPU__FCMP(name, pre, cmp)                                                   \
+SPU_FORCEINLINE u128 spu_##name(u128 a, u128 b) {                                       \
+    const __m128i A = spu__v(a), B = spu__v(b);                                         \
+    __m128 x = pre(spu__f(A)); SPU__CMP_OPAQUE(x);                                      \
+    const __m128 y = pre(spu__f(B));                                                    \
+    if (SPU_HLP_UNLIKELY(_mm_movemask_ps(_mm_cmpunord_ps(_mm_sub_ps(x, x), _mm_sub_ps(y, y))))) \
