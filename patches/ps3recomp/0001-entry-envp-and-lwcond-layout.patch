+static void test_io(void)
+{
+    if (!tp_wic()) { printf("no WIC: image tests skipped\n"); CHECK(0); return; }
+    const uint32_t W = 64, H = 32;
+    uint8_t* bgra = (uint8_t*)malloc(W * H * 4); fill(bgra, W * H * 4);
+    size_t n = 0;
+    uint8_t* png = tp_png_encode(&GUID_WICPixelFormat32bppBGRA, W, H, W * 4, bgra, &n);
+    CHECK(png && n > 0);
+    uint32_t w = 0, h = 0; const char* err = NULL;
+    uint8_t* rgba = png ? tp_img_decode(png, n, &GUID_WICPixelFormat32bppRGBA, 4, &w, &h, &err) : NULL;
+    int exact = rgba && w == W && h == H;
+    for (uint32_t i = 0; exact && i < W * H; i++)
+        exact = rgba[i * 4] == bgra[i * 4 + 2] && rgba[i * 4 + 1] == bgra[i * 4 + 1] && rgba[i * 4 + 2] == bgra[i * 4] && rgba[i * 4 + 3] == bgra[i * 4 + 3];
+    CHECK(exact);                                                                 /* 8-bit RGBA: exact */
+    free(rgba);
+    { uint8_t g8[64 * 32]; fill(g8, sizeof g8); size_t gn = 0;
+      uint8_t* p = tp_png_encode(&GUID_WICPixelFormat8bppGray, W, H, W, g8, &gn);
+      uint8_t* back = p ? tp_img_decode(p, gn, &GUID_WICPixelFormat8bppGray, 1, &w, &h, &err) : NULL;
+      CHECK(back && !memcmp(back, g8, sizeof g8)); free(back); free(p); }
+    { uint16_t g16[64 * 32]; fill((uint8_t*)g16, sizeof g16); size_t gn = 0;
+      uint8_t* p = tp_png_encode(&GUID_WICPixelFormat16bppGray, W, H, W * 2, g16, &gn);
+      uint8_t* back = p ? tp_img_decode(p, gn, &GUID_WICPixelFormat16bppGray, 2, &w, &h, &err) : NULL;
+      CHECK(back && !memcmp(back, g16, sizeof g16)); free(back); free(p); }
+    { uint16_t c64[64 * 32 * 4]; fill((uint8_t*)c64, sizeof c64); size_t gn = 0;
+      uint8_t* p = tp_png_encode(&GUID_WICPixelFormat64bppRGBA, W, H, W * 8, c64, &gn);
+      uint8_t* back = p ? tp_img_decode(p, gn, &GUID_WICPixelFormat64bppRGBA, 8, &w, &h, &err) : NULL;
+      CHECK(back && !memcmp(back, c64, sizeof c64)); free(back); free(p); }
+    /* PNG -> RGBA8 class: full chain, level 1 = gamma box of level 0 */
+    tp_img im;
+    CHECK(!tp_img_load(png, n, TP_KIND_PNG, TP_CLS_BC3, 0, &im, &err));
+    CHECK(im.dxgi == TP_DXGI_R8G8B8A8_UNORM && im.w == W && im.h == H && im.levels == 7 && im.faces == 1);
+    { uint8_t l1[32 * 16 * 4]; tp_mip_down8(im.sub[0], W, H, 4, l1, 0); CHECK(!memcmp(l1, im.sub[1], sizeof l1)); }
+    CHECK(im.row_bytes[6] == 4 && im.rows[6] == 1);
+    int s = 0;
+    CHECK(!tp_img_fits(&im, 32, 16, 0, &s, &err) && s == 1);                     /* a 2x replacement of 32x16 */
+    CHECK(!tp_img_fits(&im, 16, 8, 0, &s, &err) && s == 2);
+    CHECK(tp_img_fits(&im, 32, 32, 0, &s, &err) != 0);                           /* aspect */
+    CHECK(tp_img_fits(&im, 32, 16, 1, &s, &err) != 0);                           /* not a cube */
+    tp_img_free(&im);
+    /* PNG -> R8G8 (R, G), R8 (gray), R16 */
+    CHECK(!tp_img_load(png, n, TP_KIND_PNG, TP_CLS_R8G8, 0, &im, &err) && im.dxgi == TP_DXGI_R8G8_UNORM);
+    CHECK(im.sub[0][0] == bgra[2] && im.sub[0][1] == bgra[1] && im.row_bytes[0] == W * 2);
+    tp_img_free(&im);
+    CHECK(!tp_img_load(png, n, TP_KIND_PNG, TP_CLS_R8G8S, 0, &im, &err) && im.dxgi == TP_DXGI_R8G8_SNORM);
+    { /* signed mips: -128 and +127 average to about 0, not 127 */
+      tp_img t; memset(&t, 0, sizeof t); uint8_t q[2 * 2 * 2] = { 0x80, 0x7F, 0x7F, 0x80, 0x80, 0x7F, 0x7F, 0x80 };
+      t.dxgi = TP_DXGI_R8G8_SNORM; t.w = 2; t.h = 2; t.levels = 1; t.faces = 1; t.sub[0] = q; t.row_bytes[0] = 4; t.rows[0] = 2;
+      CHECK(!tp_img_gen_mips(&t, 2, 0) && t.levels == 2 && (t.sub[1][0] == 0xFF || t.sub[1][0] == 0x00)); tp_img_free(&t); }
+    tp_img_free(&im);
+    CHECK(!tp_img_load(png, n, TP_KIND_PNG, TP_CLS_R8, 0, &im, &err) && im.dxgi == TP_DXGI_R8_UNORM && im.row_bytes[0] == W);
+    tp_img_free(&im);
+    CHECK(tp_img_load(png, n, TP_KIND_PNG, TP_CLS_F16X4, 0, &im, &err) != 0);    /* floats need DDS */
+    /* DDS: BC1 with one level stays one level; sRGB gets the UNORM view format */
+    { uint8_t hd[148]; const size_t hn = tp_dds_header(hd, TP_DXGI_BC7_UNORM_SRGB, 64, 64, 1, 0);
+      const size_t dn = hn + 16 * 16 * 16; uint8_t* f = (uint8_t*)malloc(dn); memcpy(f, hd, hn); fill(f + hn, dn - hn);
+      CHECK(!tp_img_load(f, dn, TP_KIND_DDS, TP_CLS_RGBA8, 0, &im, &err) && im.dxgi == TP_DXGI_BC7_UNORM && im.levels == 1);
+      CHECK(im.sub[0] == f + hn);
+      CHECK(!tp_img_fits(&im, 16, 16, 0, &s, &err) && s == 2);
+      tp_img_free(&im);
+      CHECK(tp_img_load(f, dn, TP_KIND_DDS, TP_CLS_R16, 0, &im, &err) != 0);     /* wrong class */
+      free(f); }
+    { /* B8G8R8A8 DDS becomes RGBA8, with generated levels */
+      uint8_t hd[148]; const size_t hn = tp_dds_header(hd, TP_DXGI_B8G8R8A8_UNORM, 8, 8, 1, 0);
+      const size_t dn = hn + 8 * 8 * 4; uint8_t* f = (uint8_t*)malloc(dn); memcpy(f, hd, hn); fill(f + hn, dn - hn);
+      CHECK(!tp_img_load(f, dn, TP_KIND_DDS, TP_CLS_RGBA8, 0, &im, &err) && im.dxgi == TP_DXGI_R8G8B8A8_UNORM && im.levels == 4);
+      CHECK(im.sub[0][0] == f[hn + 2] && im.sub[0][2] == f[hn] && im.sub[0][3] == f[hn + 3]);
+      tp_img_free(&im); free(f); }
+    { /* a cube DDS fits a cube texture only; a BC texture must be whole blocks */
+      uint8_t hd[148]; const size_t hn = tp_dds_header(hd, TP_DXGI_BC1_UNORM, 8, 8, 1, 1);
+      const size_t dn = hn + 6 * 4 * 8; uint8_t* f = (uint8_t*)malloc(dn); memcpy(f, hd, hn); fill(f + hn, dn - hn);
+      CHECK(!tp_img_load(f, dn, TP_KIND_DDS, TP_CLS_BC1, 0, &im, &err) && im.faces == 6);
+      CHECK(!tp_img_fits(&im, 4, 4, 1, &s, &err) && s == 1 && tp_img_fits(&im, 4, 4, 0, &s, &err) != 0);
+      tp_img_free(&im); free(f); }
+    { tp_img t; memset(&t, 0, sizeof t); t.dxgi = TP_DXGI_BC1_UNORM; t.w = 6; t.h = 6; t.faces = 1; t.levels = 1;
+      CHECK(tp_img_fits(&t, 3, 3, 0, &s, &err) != 0);
+      CHECK(!tp_img_fits_ex(&t, 3, 3, 0, 1, &s, &err) && s == 1); }   /* a device that takes unaligned BC */
+    /* garbage and huge images are refused (the header is read before decoding) */
+    { uint8_t junk[300]; fill(junk, sizeof junk);
+      CHECK(tp_img_load(junk, sizeof junk, TP_KIND_PNG, TP_CLS_RGBA8, 0, &im, &err) != 0); }
+    { uint8_t big[64]; memcpy(big, png, 33);
+      big[16] = 0; big[17] = 1; big[18] = 0x86; big[19] = 0xA0;            /* width 100000 */
+      big[20] = 0; big[21] = 1; big[22] = 0x86; big[23] = 0xA0;
+      err = NULL;
+      CHECK(tp_img_load(big, 33, TP_KIND_PNG, TP_CLS_RGBA8, 0, &im, &err) != 0);
+      uint32_t ww, hh; int dep, ct; CHECK(tp_png_ihdr(png, n, &ww, &hh, &dep, &ct) == 0 && ww == W && hh == H && dep == 8); }
+    { uint8_t big[64]; memcpy(big, png, 33);
+      big[16] = 0; big[17] = 0; big[18] = 0x30; big[19] = 0x00;            /* 12288 x 12288: over TP_MAX_REP_DIM */
+      big[20] = 0; big[21] = 0; big[22] = 0x30; big[23] = 0x00;
+      err = NULL;
+      CHECK(tp_img_load(big, 33, TP_KIND_PNG, TP_CLS_RGBA8, 0, &im, &err) != 0 && err && strstr(err, "too large")); }
+    free(png); free(bgra);
+}
+
+int main(void)
+{
+    test_identity();
+    test_uniform_veto();
+    test_names();
+    test_dds();
+    test_sfo_json();
+    test_sampler();
+    test_mips_bc();
+    test_io();
+    printf("test_texpack: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_texpack_d3d12.c b/libs/video/tests/test_texpack_d3d12.c
new file mode 100644
index 0000000..3308b78
--- /dev/null
+++ b/libs/video/tests/test_texpack_d3d12.c
@@ -0,0 +1,662 @@
+/*
+ * ps3recomp - texture packs on a real D3D12 device (WARP): the runtime's
+ * loader, copy queue, fences, views and sampler LOD shift
+ * (rsx_texpack_rt.h), the code rsx_d3d12_backend.c runs. Synthetic files only.
+ *
+ * A. Upload: a 64x64 RGBA8 DDS with 7 levels (each level one known colour)
+ *    and a BC1 DDS go through tp_load -> the loader's COPY queue (texture
+ *    created COMMON, no barriers); the direct queue then copies every
+ *    subresource out (implicit promotion of a decayed COMMON texture): the
+ *    texels / blocks are bit-identical to the file.
+ * B. PNG + generated mips: a 32x32 PNG becomes a 6-level chain whose level 1
+ *    is the gamma-space box filter of level 0. The scan's VRAM estimate of a
+ *    PNG (from its IHDR) and of a DDS (its size).
+ * C. LOD with a 4x replacement (s = 2) of a 16x16 original, drawn through a
+ *    view with tp_view_levels and a sampler from tp_samp_shift / tp_samp_lod
+ *    (as samp_write builds it), point-sampled:
+ *      - 1:1 screen footprint of the ORIGINAL (16x16 target): level 2 -- the
+ *        replacement level that has the original's size;
+ *      - magnified (64x64 target): level 0, the new detail;
+ *      - guest max LOD 0 (pinned) on a 4x4 target: level 2, never coarser;
+ *      - guest min LOD 1 on the 16x16 target: level 3;
+ *      - a non-mip guest filter on a 4x4 target: level 2 (minify = mip,
+ *        levels [0, s]); with minify = guest: level 0;
+ *      - a one-level guest with a mip filter, 1x1 target: level 2 (the view
+ *        ends at glv + s levels: never past the guest's coarsest level).
+ * D. Lifetimes: a released replacement survives until the direct-queue fence
+ *    value of its batch and its copy fence have both passed.
+ * E. A finished upload becomes usable only once its copy fence has passed;
+ *    one that finishes after packs were switched off is released, not kept.
+ * H. The render-thread path a slot takes (tp_rt_identify -> tp_rt_bind ->
+ *    loader -> copy fence -> bound), against a pack index made by
+ *    tp_apply_snapshot: a full-hash hit loads and binds; a texture whose mip
+ *    tail differs matches by its level-0 hash; a pack file naming another
+ *    size is refused; a one-colour texture, a UN texture and bytes an RSX
+ *    copy wrote are never replaced; a 3D / border format word keeps the
+ *    original; content changing at a key marks it dynamic (no dump) but it is
+ *    still looked up (critique M1); a new load is asked for only if it fits
+ *    the VRAM budget beside the resident replacements and the loads in
+ *    flight (one file bigger than the whole budget loads alone).
+ * G. VRAM budget: least recently bound first, never one bound in the last two
+ *    frames, until the use is under 90% of the budget; under the budget,
+ *    stale ones go when a held-back load needs the room (G2), and when the
+ *    replacement views run low (G3: a long session of small replacements).
+ * F. TEXPACK_VERIFY: an identity DDS (the guest's DXT1 blocks, every level)
+ *    of a synthetic guest texture is reported identical; with one guest
+ *    byte changed, it differs; a PNG of the CPU decode of level 0 is
+ *    identical at level 0.
+ * Runs with the D3D12 debug layer and GPU-based validation when the Graphics
+ * Tools are installed: any error message (a state the copy / direct queue
+ * did not promote, a released resource still referenced) fails the test.
+ *
+ * Windows only. From external/ps3recomp:
+ *   clang-cl /nologo /O1 -I include -I libs/video libs/video/tests/test_texpack_d3d12.c
+ *     libs/video/rsx_texture_layout.c d3d12.lib dxgi.lib d3dcompiler.lib dxguid.lib
+ *     /Fe:T/test_texpack_d3d12.exe
+ */
+#include "rsx_texpack_rt.h"
+#include <d3dcompiler.h>
+#include <stdio.h>
+#pragma comment(lib, "d3d12.lib")
+#pragma comment(lib, "dxgi.lib")
+#pragma comment(lib, "d3dcompiler.lib")
+#pragma comment(lib, "dxguid.lib")
+
+/* what the runtime links against in the game */
+const char* ppu_vfs_root = ".";
+uint8_t* vm_base;                    /* guest memory: test F points it at a synthetic texture */
+const char* cellGame_get_title_id(void) { return "TEST00000"; }
+
+static int g_fail, g_pass;
+static uint32_t g_seed = 777u;
+static void fill(uint8_t* p, size_t n) { for (size_t i = 0; i < n; i++) { g_seed = g_seed * 1664525u + 1013904223u; p[i] = (uint8_t)(g_seed >> 16); } }
+#define CHECK(c) do { if (c) g_pass++; else { g_fail++; printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+static ID3D12Device* D; static ID3D12CommandQueue* Q; static ID3D12CommandAllocator* A; static ID3D12GraphicsCommandList* L;
+static ID3D12Fence* F; static uint64_t FV; static HANDLE EV;
+
+static void submit_wait(void)
+{
+    L->lpVtbl->Close(L);
+    ID3D12CommandList* ls[1] = { (ID3D12CommandList*)L };
+    Q->lpVtbl->ExecuteCommandLists(Q, 1, ls);
+    Q->lpVtbl->Signal(Q, F, ++FV);
+    if (F->lpVtbl->GetCompletedValue(F) < FV) { F->lpVtbl->SetEventOnCompletion(F, FV, EV); WaitForSingleObject(EV, 10000); }
+    A->lpVtbl->Reset(A);
+    L->lpVtbl->Reset(L, A, NULL);
+}
+
+static ID3D12Resource* buffer(uint64_t n, D3D12_HEAP_TYPE t, D3D12_RESOURCE_STATES st)
+{
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = t;
+    D3D12_RESOURCE_DESC bd; memset(&bd, 0, sizeof bd);
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = n; bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* r = NULL;
+    D->lpVtbl->CreateCommittedResource(D, &hp, D3D12_HEAP_FLAG_NONE, &bd, st, NULL, &IID_ID3D12Resource, (void**)&r);
+    return r;
+}
+
+/* copy subresource `sub` of a COMMON texture out on the direct queue */
+static uint8_t* read_sub(ID3D12Resource* tex, UINT sub, uint32_t* rb, uint32_t* rows, uint32_t* pitch)
+{
+    D3D12_RESOURCE_DESC td; tex->lpVtbl->GetDesc(tex, &td);
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp; UINT nr; UINT64 rs, total;
+    D->lpVtbl->GetCopyableFootprints(D, &td, sub, 1, 0, &fp, &nr, &rs, &total);
+    ID3D12Resource* rbk = buffer(total, D3D12_HEAP_TYPE_READBACK, D3D12_RESOURCE_STATE_COPY_DEST);
+    D3D12_TEXTURE_COPY_LOCATION dst, src; memset(&dst, 0, sizeof dst); memset(&src, 0, sizeof src);
+    dst.pResource = rbk; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT; dst.PlacedFootprint = fp;
+    src.pResource = tex; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; src.SubresourceIndex = sub;
+    L->lpVtbl->CopyTextureRegion(L, &dst, 0, 0, 0, &src, NULL);
+    submit_wait();
+    uint8_t* m = NULL; D3D12_RANGE r = {0, (SIZE_T)total};
+    rbk->lpVtbl->Map(rbk, 0, &r, (void**)&m);
+    uint8_t* out = (uint8_t*)malloc((size_t)total);
+    memcpy(out, m, (size_t)total);
+    D3D12_RANGE w = {0, 0}; rbk->lpVtbl->Unmap(rbk, 0, &w);
+    rbk->lpVtbl->Release(rbk);
+    *rb = (uint32_t)rs; *rows = nr; *pitch = fp.Footprint.RowPitch;
+    return out;
+}
+
+static const uint8_t LEVEL_RGBA[8][4] = { {255, 0, 0, 255}, {0, 255, 0, 255}, {0, 0, 255, 255}, {255, 255, 0, 255},
+                                          {255, 0, 255, 255}, {0, 255, 255, 255}, {128, 128, 128, 255}, {255, 255, 255, 255} };
+
+static int write_file(const wchar_t* p, const void* d, size_t n) { return tp_write_atomic(p, d, n, 1) < 0 ? -1 : 0; }
+
+/* a DDS whose level k is LEVEL_RGBA[k] */
+static uint8_t* level_dds(uint32_t w, uint32_t lv, size_t* n)
+{
+    uint8_t hd[148]; const size_t hn = tp_dds_header(hd, TP_DXGI_R8G8B8A8_UNORM, w, w, lv, 0);
+    size_t tot = hn;
+    for (uint32_t m = 0; m < lv; m++) { const uint32_t s = (w >> m) ? (w >> m) : 1; tot += (size_t)s * s * 4; }
+    uint8_t* f = (uint8_t*)malloc(tot); memcpy(f, hd, hn);
+    size_t at = hn;
+    for (uint32_t m = 0; m < lv; m++) { const uint32_t s = (w >> m) ? (w >> m) : 1;
+        for (uint32_t i = 0; i < s * s; i++) memcpy(f + at + i * 4, LEVEL_RGBA[m], 4); at += (size_t)s * s * 4; }
+    *n = tot;
+    return f;
+}
+
+/* ---------------------------------------------------------------------------
+ * a point-sampled full-screen draw into a WxW RGBA8 target; returns texel (0,0)
+ * -----------------------------------------------------------------------*/
+static ID3D12RootSignature* RS; static ID3D12PipelineState* PSO;
+static ID3D12DescriptorHeap *SRVH, *SMPH, *RTVH;
+static const char* HLSL =
+    "struct V { float4 p : SV_Position; float2 uv : TEXCOORD0; };\n"
+    "V vs(uint id : SV_VertexID) { V o; float2 t = float2((id << 1) & 2, id & 2); o.uv = t; o.p = float4(t * float2(2, -2) + float2(-1, 1), 0, 1); return o; }\n"
+    "Texture2D tx : register(t0); SamplerState sm : register(s0);\n"
+    "float4 ps(V i) : SV_Target { return tx.Sample(sm, i.uv); }\n";
+
+static int pipe_init(void)
+{
+    D3D12_DESCRIPTOR_RANGE rg[2]; memset(rg, 0, sizeof rg);
+    rg[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; rg[0].NumDescriptors = 1;
+    rg[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER; rg[1].NumDescriptors = 1;
+    D3D12_ROOT_PARAMETER rp[2]; memset(rp, 0, sizeof rp);
+    for (int i = 0; i < 2; i++) { rp[i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; rp[i].DescriptorTable.NumDescriptorRanges = 1;
+                                  rp[i].DescriptorTable.pDescriptorRanges = &rg[i]; rp[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL; }
+    D3D12_ROOT_SIGNATURE_DESC rd; memset(&rd, 0, sizeof rd); rd.NumParameters = 2; rd.pParameters = rp;
+    ID3DBlob *sig = NULL, *err = NULL;
+    if (FAILED(D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err))) return -1;
+    D->lpVtbl->CreateRootSignature(D, 0, sig->lpVtbl->GetBufferPointer(sig), sig->lpVtbl->GetBufferSize(sig), &IID_ID3D12RootSignature, (void**)&RS);
+    ID3DBlob *vsb = NULL, *psb = NULL;
+    if (FAILED(D3DCompile(HLSL, strlen(HLSL), "t", NULL, NULL, "vs", "vs_5_0", 0, 0, &vsb, &err)) ||
+        FAILED(D3DCompile(HLSL, strlen(HLSL), "t", NULL, NULL, "ps", "ps_5_0", 0, 0, &psb, &err))) {
+        printf("shader: %s\n", err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?"); return -1; }
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd; memset(&pd, 0, sizeof pd);
+    pd.pRootSignature = RS;
+    pd.VS.pShaderBytecode = vsb->lpVtbl->GetBufferPointer(vsb); pd.VS.BytecodeLength = vsb->lpVtbl->GetBufferSize(vsb);
+    pd.PS.pShaderBytecode = psb->lpVtbl->GetBufferPointer(psb); pd.PS.BytecodeLength = psb->lpVtbl->GetBufferSize(psb);
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = 0xF;
+    pd.SampleMask = 0xFFFFFFFFu;
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID; pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1; pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM; pd.SampleDesc.Count = 1;
+    if (FAILED(D->lpVtbl->CreateGraphicsPipelineState(D, &pd, &IID_ID3D12PipelineState, (void**)&PSO))) return -1;
+    D3D12_DESCRIPTOR_HEAP_DESC hd; memset(&hd, 0, sizeof hd);
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV; hd.NumDescriptors = 1; hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    D->lpVtbl->CreateDescriptorHeap(D, &hd, &IID_ID3D12DescriptorHeap, (void**)&SRVH);
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER;
+    D->lpVtbl->CreateDescriptorHeap(D, &hd, &IID_ID3D12DescriptorHeap, (void**)&SMPH);
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV; hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_NONE;
+    D->lpVtbl->CreateDescriptorHeap(D, &hd, &IID_ID3D12DescriptorHeap, (void**)&RTVH);
+    return 0;
+}
+
+/* the sampler samp_write builds for `code` (point filters here) */
+static void sampler_for(uint64_t code, D3D12_SAMPLER_DESC* sd)
+{
+    memset(sd, 0, sizeof *sd);
+    sd->Filter = (D3D12_FILTER)(((code & 1u) ? 0x10 : 0) | ((code & 2u) ? 0x4 : 0) | ((code & 4u) ? 0x1 : 0));
+    sd->AddressU = sd->AddressV = sd->AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    sd->MaxAnisotropy = 1; sd->ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+    sd->MinLOD = 0.0f; sd->MaxLOD = (code & 8u) ? D3D12_FLOAT32_MAX : 0.0f;
+    if ((code & 8u) && ((code >> 53) & 1u)) {
+        sd->MinLOD = (float)((code >> 26) & 0xFFFu) / 256.0f;
+        const uint32_t mx = (uint32_t)(code >> 38) & 0xFFFu;
+        sd->MaxLOD = mx == 0xFFFu ? D3D12_FLOAT32_MAX : (float)mx / 256.0f;
+    }
+    float lo, hi; int pm;
+    if ((code & TP_SAMP_SHIFTED) && tp_samp_lod(code, &lo, &hi, &pm)) {
+        if (pm) sd->Filter = (D3D12_FILTER)(sd->Filter | 0x1);
+        sd->MinLOD = lo; sd->MaxLOD = hi;
+    }
+}
+
+/* draw with the replacement view (mapping identity, `levels` levels) */
+static int draw_level(tp_rep* r, uint32_t levels, uint64_t code, uint32_t W)
+{
