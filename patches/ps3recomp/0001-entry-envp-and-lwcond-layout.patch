+static const ss_field k_sysmodule_ss_fields[] = { SS_FIELD(s_module_loaded) };
+static const ss_list k_sysmodule_ss_list = SS_LIST("sysmodule", k_sysmodule_ss_fields);
+
+static void sysmod_ss_recs(ss_writer* w, const ss_list* l, sysmod_ss_rec_fn next)
+{
+    uint32_t key;
+    const void* rec;
+    ss_recs_begin(w, l);
+    for (uint32_t i = 0;; i++) {
+        const int r = next(i, &key, &rec);
+        if (r < 0) break;
+        if (r) ss_recs_add(w, key, rec);
+    }
+    ss_recs_end(w);
+}
+
+/* ---- the load (M4c): the helpers every section here (and PAD_ in cellKb.c)
+ * reads the image with. check_image, before the stop with the world
+ * running, reads only the image: each RECS list through its part's put
+ * without apply, and the few statics a restore bounds peeked at
+ * (cellSysmodule_ss_peek) -- the statics themselves are the running game's.
+ * restore writes each statics list straight back (ss_read_fields: by name,
+ * all or nothing), puts each RECS list with apply, then calls the parts'
+ * apply. Every refusal names the field or the record. ---- */
+
+/* Every record of a part's RECS list, read into a zeroed copy of the part's
+ * struct (size bytes: only the listed members are written, so the rest --
+ * the host side -- reads 0) and handed to put with its place i and its key.
+ * 0, or the reader's refusal naming the record. */
+int cellSysmodule_ss_recs_put(ss_reader* r, const ss_list* l, uint32_t size, sysmod_ss_put_fn put, int apply)
+{
+    ss_recs_it it;
+    int e = ss_recs_open(r, l, &it);
+    if (e) return e;
+    void* rec = malloc(size ? size : 1);
+    if (!rec) return ss_reader_fail(r, SS_E_NOMEM, "%s: no memory for a record (%u bytes)", l->name, size);
+    char why[160];
+    uint32_t key = 0;
+    for (uint32_t i = 0;; i++) {
+        memset(rec, 0, size);
+        const int k = ss_recs_next(&it, &key, rec);
+        if (k <= 0) { e = k; break; }
+        why[0] = '\0';
+        if (put(i, key, rec, apply, why, sizeof why) != 0) {
+            e = ss_reader_fail(r, SS_E_CORRUPT, "%s[%u]: %s", l->name, key, why);
+            break;
+        }
+    }
+    free(rec);
+    return e;
+}
+
+/* check_image: field `field` (size bytes) of a statics list as the image
+ * holds it, the statics untouched -- the record read through a shadow of
+ * the list (the same names and sizes, each at an offset in a scratch
+ * buffer). 0, or the reader's refusal. */
+int cellSysmodule_ss_peek(ss_reader* r, const ss_list* l, const char* field, void* out, uint32_t size)
+{
+    ss_field* f = (ss_field*)calloc(l->n ? l->n : 1, sizeof *f);
+    uint64_t off = 0;
+    int want = -1;
+    for (uint32_t i = 0; f && i < l->n; i++) {
+        f[i] = l->f[i];
+        f[i].at = (void*)(uintptr_t)off;
+        f[i].flags &= ~(uint32_t)SS_FF_NO_RESTORE;            /* (read it all) */
+        off += ((uint64_t)l->f[i].size + 7u) & ~(uint64_t)7u;
+        if (!strcmp(l->f[i].name, field)) want = (int)i;
+    }
+    uint8_t* buf = f ? (uint8_t*)calloc(1, off ? (size_t)off : 8u) : NULL;
+    int e;
+    if (!buf)
+        e = ss_reader_fail(r, SS_E_NOMEM, "%s: no memory to read it", l->name);
+    else if (want < 0 || l->f[want].size != size)
+        e = ss_reader_fail(r, SS_E_ARG, "%s.%s: no %u-byte field of that name here", l->name, field, size);
+    else {
+        const ss_list shadow = { l->name, f, l->n };
+        e = ss_read_fields_at(r, &shadow, buf);
+        if (!e) memcpy(out, buf + (uintptr_t)f[want].at, size);
+    }
+    free(buf);
+    free(f);
+    return e;
+}
+
+/* restore: the static field `field` of a statics list names, once
+ * ss_read_fields wrote it (a library's own static, read where its list
+ * points: the bound a restore checks again). NULL if the list has no such
+ * field of that size. */
+static const void* sysmod_ss_static(const ss_list* l, const char* field, uint32_t size)
+{
+    for (uint32_t i = 0; i < l->n; i++)
+        if (!strcmp(l->f[i].name, field) && l->f[i].size == size) return l->f[i].at;
+    return NULL;
+}
+
+/* ---- SUTL ---- */
+static const ss_list* const k_sutl_ss_lists[] = {
+    &cellSysutil_ss_list, &cellSysutil_ss_callbacks_list, &cellSysutil_ss_events_list,
+    &cellSysutil_ss_completions_list, NULL
+};
+
+static int sutl_ss_capture(ss_writer* w)
+{
+    cellSysutil_ss_prepare();
+    ss_write_fields(w, &cellSysutil_ss_list);
+    sysmod_ss_recs(w, &cellSysutil_ss_callbacks_list, cellSysutil_ss_callback);
+    sysmod_ss_recs(w, &cellSysutil_ss_events_list, cellSysutil_ss_event);
+    sysmod_ss_recs(w, &cellSysutil_ss_completions_list, cellSysutil_ss_completion);
+    return ss_writer_error(w);
+}
+
+/* The load: the callback slots (a registered OPD in a slot that exists),
+ * the event ring (in order from head 0, within its 31 entries) and the
+ * completions (in delivery order) -- checked before the stop, by value
+ * after teardown freed the old completion nodes and emptied the rest. */
+static int sutl_ss_recs(ss_reader* r, int apply)
+{
+    int e = cellSysmodule_ss_recs_put(r, &cellSysutil_ss_callbacks_list, cellSysutil_ss_callback_size,
+                                      cellSysutil_ss_callback_put, apply);
+    if (!e) e = cellSysmodule_ss_recs_put(r, &cellSysutil_ss_events_list, cellSysutil_ss_event_size,
+                                          cellSysutil_ss_event_put, apply);
+    if (!e) e = cellSysmodule_ss_recs_put(r, &cellSysutil_ss_completions_list, cellSysutil_ss_completion_size,
+                                          cellSysutil_ss_completion_put, apply);
+    return e;
+}
+
+static int sutl_ss_check_image(ss_reader* r) { return sutl_ss_recs(r, 0); }
+
+static int sutl_ss_restore(ss_reader* r)
+{
+    const int e = ss_read_fields(r, &cellSysutil_ss_list);
+    if (e) return e;
+    cellSysutil_ss_apply();
+    return sutl_ss_recs(r, 1);
+}
+
+static const ss_section_ops k_sutl_ss_ops = {
+    SS_FOURCC('S', 'U', 'T', 'L'), 1, 0, SS_ORDER_SYSUTIL,
+    cellSysutil_ss_check, sutl_ss_capture, cellSysutil_ss_teardown, sutl_ss_restore, NULL,
+    "cellSysutil", k_sutl_ss_lists, NULL,
+    NULL, sutl_ss_check_image,
+};
+SS_SECTION_REGISTER(k_sutl_ss_ops)
+
+/* ---- MISC ---- */
+static const ss_list* const k_misc_ss_lists[] = {
+    &cellGame_ss_list, &k_sysmodule_ss_list, &cellMsgDialog_ss_list, &cellSaveData_ss_list,
+    &sceNpTrophy_ss_list, &sceNpTrophy_ss_contexts_list, &sceNpTrophy_ss_handles_list,
+    &cellHttp_ss_list, &cellHttp_ss_clients_list, &cellHttp_ss_transactions_list,
+    &cellNetCtl_ss_list, &cellNetCtl_ss_handlers_list, &cellVideoOut_ss_list, &cellResc_ss_list,
+    &cellOskDialog_ss_list, &cellCamera_ss_list, &cellGem_ss_list, &cellSsl_ss_list, &cellHttps_ss_list,
+    &sceNp_ss_list, NULL
+};
+
+static int misc_ss_capture(ss_writer* w)
+{
+    ss_write_fields(w, &cellGame_ss_list);
+    ss_write_fields(w, &k_sysmodule_ss_list);
+    cellMsgDialog_ss_prepare();
+    ss_write_fields(w, &cellMsgDialog_ss_list);
+    ss_write_fields(w, &cellSaveData_ss_list);
+    ss_write_fields(w, &sceNpTrophy_ss_list);
+    sysmod_ss_recs(w, &sceNpTrophy_ss_contexts_list, sceNpTrophy_ss_context);
+    sysmod_ss_recs(w, &sceNpTrophy_ss_handles_list, sceNpTrophy_ss_handle);
+    ss_write_fields(w, &cellHttp_ss_list);
+    sysmod_ss_recs(w, &cellHttp_ss_clients_list, cellHttp_ss_client);
+    sysmod_ss_recs(w, &cellHttp_ss_transactions_list, cellHttp_ss_transaction);
+    ss_write_fields(w, &cellNetCtl_ss_list);
+    sysmod_ss_recs(w, &cellNetCtl_ss_handlers_list, cellNetCtl_ss_handler);
+    cellVideoOut_ss_prepare();
+    ss_write_fields(w, &cellVideoOut_ss_list);
+    ss_write_fields(w, &cellResc_ss_list);
+    ss_write_fields(w, &cellOskDialog_ss_list);
+    ss_write_fields(w, &cellCamera_ss_list);
+    ss_write_fields(w, &cellGem_ss_list);
+    ss_write_fields(w, &cellSsl_ss_list);
+    ss_write_fields(w, &cellHttps_ss_list);
+    sceNp_ss_prepare();
+    ss_write_fields(w, &sceNp_ss_list);
+    return ss_writer_error(w);
+}
+
+/* Everything but cellHttp's transactions fits in a few KB (the module set
+ * 2 KB, the trophy contexts 5 KB); a transaction carries its headers, 12 KB. */
+static uint64_t misc_ss_size(void)
+{
+    return 64u * 1024u + cellHttp_ss_size();
+}
+
+/* The load (engine design 6.2: "reset to boot defaults", then by value).
+ * Bounded before anything stops: the records' ids and counts (each part's
+ * put), the OSK result's length (UnloadAsync copies that many characters)
+ * and the gamma (the present pass's setter takes only a valid one). */
+static int misc_ss_recs(ss_reader* r, int apply, int part)
+{
+    switch (part) {
+    case 0:
+        return cellSysmodule_ss_recs_put(r, &sceNpTrophy_ss_contexts_list, sceNpTrophy_ss_context_size,
+                                         sceNpTrophy_ss_context_put, apply);
+    case 1:
+        return cellSysmodule_ss_recs_put(r, &sceNpTrophy_ss_handles_list, sceNpTrophy_ss_handle_size,
+                                         sceNpTrophy_ss_handle_put, apply);
+    case 2:
+        return cellSysmodule_ss_recs_put(r, &cellHttp_ss_clients_list, cellHttp_ss_client_size,
+                                         cellHttp_ss_client_put, apply);
+    case 3:
+        return cellSysmodule_ss_recs_put(r, &cellHttp_ss_transactions_list, cellHttp_ss_transaction_size,
+                                         cellHttp_ss_transaction_put, apply);
+    default:
+        return cellSysmodule_ss_recs_put(r, &cellNetCtl_ss_handlers_list, cellNetCtl_ss_handler_size,
+                                         cellNetCtl_ss_handler_put, apply);
+    }
+}
+
+static int misc_ss_check_image(ss_reader* r)
+{
+    uint32_t len = 0;
+    float gamma = 0.0f;
+    int e;
+    if ((e = cellSysmodule_ss_peek(r, &cellOskDialog_ss_list, "s_result_length", &len, 4)) != 0) return e;
+    if (len > CELL_OSK_MAX_TEXT_LENGTH)
+        return ss_reader_fail(r, SS_E_CORRUPT, "oskdialog.s_result_length: %u above the %d characters", len,
+                              CELL_OSK_MAX_TEXT_LENGTH);
+    if ((e = cellSysmodule_ss_peek(r, &cellVideoOut_ss_list, "gamma", &gamma, 4)) != 0) return e;
+    if (gamma != RSX_VOG_DEFAULT && !rsx_vog_in_range(gamma))
+        return ss_reader_fail(r, SS_E_CORRUPT, "videoout.gamma: %g outside %g..%g", (double)gamma,
+                              (double)RSX_VOG_MIN, (double)RSX_VOG_MAX);
+    for (int part = 0; part < 5; part++)
+        if ((e = misc_ss_recs(r, 0, part)) != 0) return e;
+    return SS_OK;
+}
+
+/* Every guest thread gone: each library at its boot state (the old state's
+ * sockets closed, its completion of a trophy registration already freed with
+ * SUTL's list). cellOskDialog, cellCamera, cellGem, cellSsl, cellHttps and
+ * sceNp hold plain values only, which their lists write back whole. */
+static void misc_ss_teardown(void)
+{
+    cellGame_ss_teardown();
+    memset(s_module_loaded, 0, sizeof(s_module_loaded));
+    cellMsgDialog_ss_teardown();
+    cellSaveData_ss_teardown();
+    sceNpTrophy_ss_teardown();
+    cellHttp_ss_teardown();
+    cellNetCtl_ss_teardown();
+    cellVideoOut_ss_teardown();
+    cellResc_ss_teardown();
+}
+
+static int misc_ss_restore(ss_reader* r)
+{
+    char why[160] = "";
+    int e = ss_read_fields(r, &cellGame_ss_list);
+    if (!e) { cellGame_ss_apply(); e = ss_read_fields(r, &k_sysmodule_ss_list); }
+    if (!e && !(e = ss_read_fields(r, &cellMsgDialog_ss_list))) cellMsgDialog_ss_apply();
+    if (!e) {
+        cellSaveData_ss_text_write(0);                 /* (its readers retry meanwhile) */
+        e = ss_read_fields(r, &cellSaveData_ss_list);
+        cellSaveData_ss_text_write(1);
+    }
+    if (!e && !(e = ss_read_fields(r, &sceNpTrophy_ss_list))) sceNpTrophy_ss_apply();
+    if (!e) e = misc_ss_recs(r, 1, 0);                  /* trophy contexts: merged with their files */
+    if (!e) e = misc_ss_recs(r, 1, 1);
+    if (!e && !(e = ss_read_fields(r, &cellHttp_ss_list))) cellHttp_ss_apply();
+    if (!e) e = misc_ss_recs(r, 1, 2);
+    if (!e) e = misc_ss_recs(r, 1, 3);                  /* offline: no socket, nothing received */
+    if (!e) e = ss_read_fields(r, &cellNetCtl_ss_list);
+    if (!e) e = misc_ss_recs(r, 1, 4);
+    if (!e) e = ss_read_fields(r, &cellVideoOut_ss_list);
+    if (!e && cellVideoOut_ss_apply(why, sizeof why)) e = ss_reader_fail(r, SS_E_CORRUPT, "%s", why);
+    if (!e) e = ss_read_fields(r, &cellResc_ss_list);
+    if (!e) e = ss_read_fields(r, &cellOskDialog_ss_list);
+    if (!e) {
+        const uint32_t* len = (const uint32_t*)sysmod_ss_static(&cellOskDialog_ss_list, "s_result_length", 4);
+        if (!len || *len > CELL_OSK_MAX_TEXT_LENGTH)
+            e = ss_reader_fail(r, SS_E_CORRUPT, "oskdialog.s_result_length: %u above the %d characters",
+                               len ? *len : 0u, CELL_OSK_MAX_TEXT_LENGTH);
+    }
+    if (!e) e = ss_read_fields(r, &cellCamera_ss_list);
+    if (!e) e = ss_read_fields(r, &cellGem_ss_list);
+    if (!e) e = ss_read_fields(r, &cellSsl_ss_list);
+    if (!e) e = ss_read_fields(r, &cellHttps_ss_list);
+    if (!e && !(e = ss_read_fields(r, &sceNp_ss_list))) sceNp_ss_apply();
+    return e;
+}
+
+static const ss_section_ops k_misc_ss_ops = {
+    SS_FOURCC('M', 'I', 'S', 'C'), 1, 0, SS_ORDER_SYSUTIL + 10,
+    cellSaveData_ss_check, misc_ss_capture, misc_ss_teardown, misc_ss_restore, NULL,
+    "other HLE libraries", k_misc_ss_lists, misc_ss_size,
+    NULL, misc_ss_check_image,
+};
+SS_SECTION_REGISTER(k_misc_ss_ops)
+
+/* ---- GCM_ ---- */
+/* cellGcmSys.c (what its part holds, and what a load does with it, is told
+ * there) and rsx_report.c (libs/video): one FIELDS record "gcm", the RSX
+ * report state as FIELDS "rsx_report", BLOBs "ref_queue" and "imm_verts".
+ * Strict-save blockers: the handler pump in use or the walker not at rest
+ * (cellGcmSys), a report still pending after the GPU flush (rsx_report).
+ * A load (M4c): the glue below reads the image -- the two files call nothing
+ * of the save-state engine -- and hands them plain values: the teardown
+ * empties the walker's watch, its fence queue and the report queue; the
+ * restore puts "gcm" and the report record back, the queue and the vertices
+ * from their blobs, the walker's timers from their TIME anchors;
+ * after_release sets every dirty flag of the command processor's registers.
+ * Only host state is skipped by the fidelity check (SS_FF_HOST:
+ * s_flip_pending, rsx_report.precise). */
+extern const ss_list cellGcmSys_ss_list, g_ss_list_gcm_report;
+int         cellGcmSys_ss_check(char* why, size_t n);
+void        cellGcmSys_ss_ref_queue(const void** a, uint32_t* na, const void** b, uint32_t* nb);
+const void* cellGcmSys_ss_imm_verts(uint64_t* n, uint64_t* cap);
+uint64_t    cellGcmSys_ss_size(void);
+uint64_t    cellGcmSys_ss_acq_age(void);
+uint64_t    cellGcmSys_ss_park_age(void);
+void        cellGcmSys_ss_teardown(void);
+int         cellGcmSys_ss_check_blobs(uint64_t nrefq, uint64_t nimm, char* why, size_t n);
+int         cellGcmSys_ss_restore(const void* refq, uint64_t nrefq, const void* imm, uint64_t nimm,
+                                  uint64_t acq_age, uint64_t park_age, char* why, size_t n);
+void        cellGcmSys_ss_after_release(void);
+int         rsx_report_ss_check(char* why, size_t n);
+const void* rsx_report_ss_record(void);
+void        rsx_report_ss_teardown(void);
+void*       rsx_report_ss_scratch(void);
+int         rsx_report_ss_validate(const void* rec, char* why, size_t n);
+int         rsx_report_ss_restore(const void* rec, char* why, size_t n);
+
+static const ss_list* const k_gcm_ss_lists[] = { &cellGcmSys_ss_list, &g_ss_list_gcm_report, NULL };
+
+static int gcm_ss_check(char* why, size_t n)
+{
+    const int r = cellGcmSys_ss_check(why, n);
+    if (r) return r;
+    return rsx_report_ss_check(why, n) ? SS_REASON_GPU : 0;
+}
+
+static int gcm_ss_capture(ss_writer* w)
+{
+    ss_write_fields(w, &cellGcmSys_ss_list);
+    ss_write_fields_at(w, &g_ss_list_gcm_report, rsx_report_ss_record());
+    const void *a, *b;
+    uint32_t na, nb;
+    cellGcmSys_ss_ref_queue(&a, &na, &b, &nb);
+    ss_blob_begin(w, "ref_queue", 0);
+    ss_blob_put(w, a, na);
+    ss_blob_put(w, b, nb);
+    ss_blob_end(w);
+    uint64_t nv = 0;
+    const void* v = cellGcmSys_ss_imm_verts(&nv, NULL);
+    ss_write_blob(w, "imm_verts", v, nv);
+    return ss_writer_error(w);
+}
+
+/* cellGcmSys's most, the report record's fields, room for the record
+ * headers and names. Outside a stop. */
+static uint64_t gcm_ss_size_hint(void)
+{
+    uint64_t n = 16384 + cellGcmSys_ss_size();
+    for (uint32_t i = 0; i < g_ss_list_gcm_report.n; i++)
+        n += (uint64_t)g_ss_list_gcm_report.f[i].size + 64u;
+    return n;
+}
+
+/* What a load takes besides "gcm": both blobs (in place, sizes checked) and
+ * the walker's two timer ages, then the report record, read into
+ * rsx_report.c's scratch and checked there -- nothing of the live state
+ * written. Shared by check_image (the world running) and the restore. */
+typedef struct gcm_ss_parts {
+    const void *refq, *imm;
+    uint64_t    nrefq, nimm, acq_age, park_age;
+    void*       report;
+} gcm_ss_parts;
+static int gcm_ss_parts_read(ss_reader* r, gcm_ss_parts* p)
+{
+    char why[160];
+    int e;
+    p->refq = p->imm = NULL;
+    p->nrefq = p->nimm = p->acq_age = p->park_age = 0;
+    p->report = NULL;
+    if ((e = ss_find_blob(r, "ref_queue", &p->refq, &p->nrefq)) != 0) return e;
+    if ((e = ss_find_blob(r, "imm_verts", &p->imm, &p->nimm)) != 0) return e;
+    why[0] = 0;
+    if (cellGcmSys_ss_check_blobs(p->nrefq, p->nimm, why, sizeof why))
+        return ss_reader_fail(r, SS_E_CORRUPT, "%s", why);
+    if (ss_time_anchor_read(r->img, "gcm.acq_age_ms", &p->acq_age) != SS_OK)
+        return ss_reader_fail(r, SS_E_NOT_FOUND, "TIME anchor gcm.acq_age_ms: not in the image");
+    if (ss_time_anchor_read(r->img, "gcm.park_age_ms", &p->park_age) != SS_OK)
+        return ss_reader_fail(r, SS_E_NOT_FOUND, "TIME anchor gcm.park_age_ms: not in the image");
+    p->report = rsx_report_ss_scratch();
+    if ((e = ss_read_fields_at(r, &g_ss_list_gcm_report, p->report)) != 0) return e;
+    if (rsx_report_ss_validate(p->report, why, sizeof why)) return ss_reader_fail(r, SS_E_CORRUPT, "%s", why);
+    return SS_OK;
+}
+
+/* Before a LOAD stops anything: refuse an image whose parts this build
+ * cannot take, with nothing discarded. ("gcm" itself is checked by name and
+ * size by ss_image_validate; its counts are checked in the restore, once
+ * read: they are statics, which this must not write.) */
+static int gcm_ss_check_image(ss_reader* r)
+{
+    gcm_ss_parts p;
+    return gcm_ss_parts_read(r, &p);
+}
+
+static void gcm_ss_teardown(void)
+{
+    cellGcmSys_ss_teardown();
+    rsx_report_ss_teardown();
+}
+
+static int gcm_ss_restore(ss_reader* r)
+{
+    gcm_ss_parts p;
+    int e = gcm_ss_parts_read(r, &p);
+    if (e) return e;
+    if ((e = ss_read_fields(r, &cellGcmSys_ss_list)) != 0) return e;
+    char why[160];
+    why[0] = 0;
+    if (cellGcmSys_ss_restore(p.refq, p.nrefq, p.imm, p.nimm, p.acq_age, p.park_age, why, sizeof why))
+        return ss_reader_fail(r, SS_E_CORRUPT, "%s", why);
+    if (rsx_report_ss_restore(p.report, why, sizeof why)) return ss_reader_fail(r, SS_E_CORRUPT, "%s", why);
+    return SS_OK;
+}
+
+static const ss_section_ops k_gcm_ss_ops = {
+    SS_FOURCC('G', 'C', 'M', '_'), 1, 0, SS_ORDER_GCM,
+    gcm_ss_check, gcm_ss_capture, gcm_ss_teardown, gcm_ss_restore, cellGcmSys_ss_after_release,
+    "gcm / RSX walker", k_gcm_ss_lists, gcm_ss_size_hint,
+    NULL, gcm_ss_check_image,          /* verify: the generic compare (SS_FF_HOST skipped) */
+};
+SS_SECTION_REGISTER(k_gcm_ss_ops)
+
+/* ---- AUDI ---- */
+/* cellAudio.c: FIELDS "audio", the open ports and the registered notify
+ * queues as RECS (what they hold is told there). No strict-save blocker of
+ * its own: the coordinator already refuses a stop where the mixer did not
+ * park. A load: the ports and keys back by value (each port checked against
+ * the windows cellAudioPortOpen gives it, before the stop), the start time
+ * re-anchored on the guest clock from TIME's "audio.start_elapsed_us"; the
+ * device side is cellAudio.c's (stream stopped at teardown, restarted at the
+ * release; device and mixer made only if this session has none). */
+extern const ss_list cellAudio_ss_list, cellAudio_ss_ports_list, cellAudio_ss_notify_list;
+int      cellAudio_ss_port(uint32_t i, uint32_t* key, const void** rec);
+int      cellAudio_ss_notify_queue(uint32_t i, uint32_t* key, const void** rec);
+uint64_t cellAudio_ss_start_elapsed(void);
+void     cellAudio_ss_teardown(void);
+extern const uint32_t cellAudio_ss_port_size, cellAudio_ss_notify_size;
+int      cellAudio_ss_port_put(SYSMOD_SS_PUT_ARGS);
+int      cellAudio_ss_notify_put(SYSMOD_SS_PUT_ARGS);
+void     cellAudio_ss_restore_done(int have_elapsed, uint64_t elapsed_us);
+void     cellAudio_ss_after_release(void);
+
+static const ss_list* const k_audi_ss_lists[] = {
+    &cellAudio_ss_list, &cellAudio_ss_ports_list, &cellAudio_ss_notify_list, NULL
+};
+
+static int audi_ss_capture(ss_writer* w)
+{
+    ss_write_fields(w, &cellAudio_ss_list);
+    sysmod_ss_recs(w, &cellAudio_ss_ports_list, cellAudio_ss_port);
+    sysmod_ss_recs(w, &cellAudio_ss_notify_list, cellAudio_ss_notify_queue);
+    return ss_writer_error(w);
+}
+
+static int audi_ss_recs(ss_reader* r, int apply)
+{
+    const int e = cellSysmodule_ss_recs_put(r, &cellAudio_ss_ports_list, cellAudio_ss_port_size,
+                                            cellAudio_ss_port_put, apply);
+    return e ? e : cellSysmodule_ss_recs_put(r, &cellAudio_ss_notify_list, cellAudio_ss_notify_size,
+                                             cellAudio_ss_notify_put, apply);
+}
+
+static int audi_ss_check_image(ss_reader* r) { return audi_ss_recs(r, 0); }
+
+static int audi_ss_restore(ss_reader* r)
+{
+    int e = ss_read_fields(r, &cellAudio_ss_list);
+    if (!e) e = audi_ss_recs(r, 1);
+    if (e) return e;
+    uint64_t elapsed = 0;
+    const int have = ss_time_anchor_read(r->img, "audio.start_elapsed_us", &elapsed) == SS_OK;
+    cellAudio_ss_restore_done(have, elapsed);
+    return SS_OK;
+}
+
+static const ss_section_ops k_audi_ss_ops = {
+    SS_FOURCC('A', 'U', 'D', 'I'), 1, 0, SS_ORDER_AUDIO,
+    NULL, audi_ss_capture, cellAudio_ss_teardown, audi_ss_restore, cellAudio_ss_after_release,
+    "cellAudio", k_audi_ss_lists, NULL,
+    NULL, audi_ss_check_image,
+};
+SS_SECTION_REGISTER(k_audi_ss_ops)
+
+/* ---- their TIME anchors ---- */
+/* The walker's two wait timers as their ages (cellGcmSys.c says why), and
+ * the time since cellAudioInit (0 before it): added at static init, as
+ * SS_SECTION_REGISTER does for the sections. */
+static const ss_time_anchor k_gcm_ss_acq_anchor   = { "gcm.acq_age_ms",  cellGcmSys_ss_acq_age,  NULL };
+static const ss_time_anchor k_gcm_ss_park_anchor  = { "gcm.park_age_ms", cellGcmSys_ss_park_age, NULL };
+static const ss_time_anchor k_audio_ss_start_anchor = {
+    "audio.start_elapsed_us", cellAudio_ss_start_elapsed, NULL
+};
+static void sysmod_ss_add_anchors(void)
+{
+    ss_time_anchor_add(&k_gcm_ss_acq_anchor);
+    ss_time_anchor_add(&k_gcm_ss_park_anchor);
+    ss_time_anchor_add(&k_audio_ss_start_anchor);
+}
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((constructor)) static void sysmod_ss_anchors_init(void) { sysmod_ss_add_anchors(); }
+#elif defined(_MSC_VER)
+#pragma section(".CRT$XCU", read)
+__declspec(allocate(".CRT$XCU")) static void (*sysmod_ss_anchors_init)(void) = sysmod_ss_add_anchors;
+#endif
