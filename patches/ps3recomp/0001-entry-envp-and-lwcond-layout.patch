+    CHECK(rsx_selfsample_writes(0xDu, 0x0007u, 0) == 0xDu, "B unbound: C and D counted after the gap");
+    CHECK(rsx_selfsample_writes(0x6u, 0x0070u, 0) == 0x2u, "A the backbuffer: B written, C not");
