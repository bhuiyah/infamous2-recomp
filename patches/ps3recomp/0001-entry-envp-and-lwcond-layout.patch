+       FP_PK_UP4 = 32, FP_PK_PK2 = 64, FP_PK_UP2 = 128, FP_PK_PK16 = 256, FP_PK_UP16 = 512,
+       FP_PK_L2S = 1024, FP_PK_S2L = 2048 };
