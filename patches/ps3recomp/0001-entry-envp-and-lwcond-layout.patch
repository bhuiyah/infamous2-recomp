+    }
+    if (rv) {
+        s->p.root_valid = 1;
+        s->p.root_lr = root.root_lr; s->p.root_sp = root.root_sp;
+        s->p.stack_lo = root.stack_lo; s->p.stack_hi = root.stack_hi;
+    }
+    ss_wait_rec wr;
+    if (at == SS_IN_WAIT && ss_ppu_wait_rec(tid, &wr)) {
+        s->p.nid_or_sc = wr.nid_or_sc;
+        s->p.wa = wr.a; s->p.wb = wr.b; s->p.wc = wr.c;
+        s->p.deadline_ns = wr.deadline_ns;
+    }
