+SPU_FORCEINLINE __m128i spu__d2fx_v(__m256d d) { __m256i t; __m256d m; return spu__fxpack(spu__d2fx_q(d, &t, &m)); }
+SPU_FORCEINLINE __m128i spu__d2fx2_v(__m256d u, __m256d v) {       /* spu__d2fx2, 4 lanes */
+    const __m256d s = _mm256_add_pd(u, v), bb = _mm256_sub_pd(s, u);
+    const __m256d err = _mm256_add_pd(_mm256_sub_pd(u, _mm256_sub_pd(s, bb)), _mm256_sub_pd(v, bb));
