+    padhost_virtual_detach(j);
+    padhost_virtual_detach(g);
+    padhost_virtual_detach(s);
+    CHECK(wait_state(0, 0, 1000) && wait_state(1, 0, 1000) && wait_state(2, 0, 1000), "all released");
+
+    /* after startup: a joystick that came first keeps port 0, and the gamepad
