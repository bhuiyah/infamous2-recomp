+/* ---- controller vs keyboard/mouse on port 0 (kbm_arbitrate) ------------- */
+
+typedef struct { int lx, ly, rx, ry, use_l, use_r; } Merged;
+
+/* One report merged the way cellPad.c's pad_poll_kbm does it: the
+ * controller's buttons and sticks (pb, plx..pry), then this report's
+ * keyboard/mouse with mdx/mdy mouse counts. */
+static Merged arb_step(const KbmConfig* c, KbmRuntime* rt, KbmArb* a, double now, long mdx, long mdy,
+                       uint16_t pb, uint8_t plx, uint8_t ply, uint8_t prx, uint8_t pry)
+{
+    KbmOut o;
+    kbm_eval(c, rt, fake_down, NULL, now, mdx, mdy, 0, &o);
+    Merged m = { plx, ply, prx, pry, 0, 0 };
+    kbm_arbitrate(c, a, 1, pb, plx, ply, prx, pry, &o, mdx, mdy, now, &m.use_l, &m.use_r);
+    if (m.use_l) { m.lx = kbm_axis_u8(o.lx); m.ly = kbm_axis_u8(o.ly); }
+    if (m.use_r == 1)      { m.rx = kbm_axis_u8(o.rx);  m.ry = kbm_axis_u8(o.ry); }
+    else if (m.use_r == 2) { m.rx = kbm_axis_u8(o.krx); m.ry = kbm_axis_u8(o.kry); }
+    return m;
+}
+
+/* A resting mouse's sensor noise: +1 / -1 count on alternate reports, every
+ * third report (or every report with `every` = 1); counts are `amp`. */
+static long jitter(int i, int every, int amp)
+{
+    if (i % every) return 0;
+    return ((i / every) & 1) ? -amp : amp;
+}
+
+/* Over n 16 ms reports from *t, with the controller's right stick at
+ * (prx, 128): how many reports the camera was not the controller's stick. */
+static int arb_jitter_run(const KbmConfig* c, KbmRuntime* rt, KbmArb* a, double* t, int n, int every,
+                          int amp, uint8_t prx)
+{
+    int stolen = 0;
+    for (int i = 0; i < n; i++) {
+        Merged m = arb_step(c, rt, a, *t += 16.0, jitter(i, every, amp), jitter(i + 1, every, amp), 0,
+                            128, 128, prx, 128);
+        if (m.rx != prx || m.ry != 128) stolen++;
+    }
+    return stolen;
+}
+
+static void test_arbitration(void)
+{
+    KbmConfig c;
+    KbmRuntime rt;
+    KbmArb a;
+    Merged m;
+    double t = 1000.0;
+    kbm_config_defaults(&c);
+    CHECK_EQ(c.last_device_wins, 1);
+    CHECK_NEAR(c.mouse_takeover, 40.0, 1e-6);
+    keys_clear();
+
+    /* 1. A controller player, the mouse lying on the desk with sensor noise
+     * (one count every 3rd report, and one every report): the camera is the
+     * controller's, stick at rest or held right. The old merge (last_device_wins
+     * = 0) let every noisy report through at the 0.20 anti-deadzone. */
+    kbm_runtime_reset(&rt); kbm_arb_reset(&a);
+    CHECK_EQ(arb_jitter_run(&c, &rt, &a, &t, 125, 3, 1, 128), 0);    /* 2 s, stick at rest */
+    CHECK_EQ(arb_jitter_run(&c, &rt, &a, &t, 125, 3, 1, 255), 0);    /* stick held right */
+    CHECK_EQ(arb_jitter_run(&c, &rt, &a, &t, 125, 1, 1, 128), 0);    /* noise on every report */
+    CHECK_EQ(arb_jitter_run(&c, &rt, &a, &t, 125, 1, 2, 200), 0);    /* 2 counts every report */
+    CHECK_EQ(arb_jitter_run(&c, &rt, &a, &t, 125, 1, 6, 128), 0);    /* shaking in place */
+    {
+        /* a slow drift one way (2 counts per report, ~4 mm/s at 800 DPI) is
+         * motion: it takes the camera within a second */
+        int took = -1;
+        for (int i = 0; i < 60 && took < 0; i++)
+            if (arb_step(&c, &rt, &a, t += 16.0, 2, 0, 0, 128, 128, 128, 128).use_r == 1) took = i;
+        CHECK(took > 10 && took < 60);
+        for (int i = 0; i < 6; i++) arb_step(&c, &rt, &a, t += 16.0, 0, 0, CTRL_CROSS * (i == 5), 128, 128, 128, 128);
+    }
+    {
+        KbmConfig old = c;
+        old.last_device_wins = 0;
+        KbmRuntime rt2; KbmArb a2; double t2 = 1000.0;
+        kbm_runtime_reset(&rt2); kbm_arb_reset(&a2);
+        int stolen = arb_jitter_run(&old, &rt2, &a2, &t2, 125, 3, 1, 128);
+        CHECK(stolen > 30);                                           /* the bug: ~every noisy report */
+        printf("arbitration: resting-mouse noise moved the camera in %d of 125 reports with "
+               "last_device_wins = 0, 0 with the default\n", stolen);
+    }
+
+    /* 2. The mouse really moved (10 counts per report = 625 counts/s): it
+     * takes the camera within ~5 reports (40 counts, leaky), the camera then
+     * follows it, and the controller's resting stick does not fight it. */
+    kbm_runtime_reset(&rt); kbm_arb_reset(&a);
+    for (int i = 0; i < 3; i++) arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 128, 128);
+    int took = -1;
+    for (int i = 0; i < 12; i++) {
+        m = arb_step(&c, &rt, &a, t += 16.0, 10, 0, 0, 128, 128, 128, 128);
+        if (took < 0 && m.use_r == 1) took = i;
+    }
+    CHECK(took >= 3 && took <= 5);
+    CHECK(m.rx > 128 + 20);
+    /* the mouse stops: once its smoothing has run out the camera is centred
+     * (the controller's resting stick) -- the mouse keeps ownership, so its
+     * own noise now nudges it, as it would without a controller */
+    for (int i = 0; i < 6; i++) m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 128, 128);
+    CHECK_EQ(m.rx, 128);
+    m = arb_step(&c, &rt, &a, t += 16.0, 1, 0, 0, 128, 128, 128, 128);
+    CHECK_EQ(m.use_r, 1);
+
+    /* 3. Back to the controller: its right stick leaving rest takes the camera
+     * at once; the mouse noise after that changes nothing. */
+    m = arb_step(&c, &rt, &a, t += 16.0, 1, 0, 0, 128, 128, 40, 128);
+    CHECK_EQ(m.use_r, 0);
+    CHECK_EQ(m.rx, 40);
+    CHECK_EQ(arb_jitter_run(&c, &rt, &a, &t, 60, 2, 1, 128), 0);
+
+    /* 4. ... or a button press (any controller button) does. */
+    for (int i = 0; i < 8; i++) arb_step(&c, &rt, &a, t += 16.0, 10, 0, 0, 128, 128, 128, 128);
+    m = arb_step(&c, &rt, &a, t += 16.0, 1, 0, 0, 128, 128, 128, 128);
+    CHECK_EQ(m.use_r, 1);                                        /* the mouse had it */
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, CTRL_CROSS, 128, 128, 128, 128);
+    CHECK_EQ(m.use_r, 0);
+    m = arb_step(&c, &rt, &a, t += 16.0, 1, 0, CTRL_CROSS, 128, 128, 128, 128);   /* held: not a new press */
+    CHECK_EQ(m.use_r, 0);
+    CHECK_EQ(m.rx, 128);
+
+    /* 5. Hybrid: the controller's stick held right while the mouse is swept
+     * left: the mouse wins while it moves, the stick as soon as it stops. */
+    kbm_runtime_reset(&rt); kbm_arb_reset(&a);
+    for (int i = 0; i < 3; i++) arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 255, 128);
+    int mouse_reports = 0;
+    for (int i = 0; i < 15; i++) {
+        m = arb_step(&c, &rt, &a, t += 16.0, -12, 0, 0, 128, 128, 255, 128);
+        if (m.use_r == 1 && m.rx < 128) mouse_reports++;
+    }
+    CHECK(mouse_reports >= 10);
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 255, 128);
+    CHECK_EQ(m.use_r, 0);
+    CHECK_EQ(m.rx, 255);
+
+    /* 6. A mouse button (LMB = R1, RMB = L1) gives the camera to the mouse at
+     * once: aiming with the mouse while holding a controller. */
+    for (int i = 0; i < 6; i++) m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 128, 128);
+    g_keys[0x02] = 1;                                            /* RMB */
+    m = arb_step(&c, &rt, &a, t += 16.0, 1, 0, 0, 128, 128, 128, 128);
+    CHECK_EQ(m.use_r, 1);
+    CHECK(m.rx > 128);
+    keys_clear();
+
+    /* 7. Camera keys: a press takes the camera like the mouse; keys held when
+     * the controller takes it back still turn it while its stick rests, and
+     * without the mouse's noise. */
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, CTRL_CIRCLE, 128, 128, 128, 128);   /* controller's */
+    press("L");
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 128, 128);
+    CHECK_EQ(m.use_r, 1);
+    CHECK_EQ(m.rx, 255);
+    m = arb_step(&c, &rt, &a, t += 16.0, 1, 0, CTRL_SQUARE, 128, 128, 128, 128);   /* controller button */
+    CHECK_EQ(m.use_r, 2);
+    CHECK_EQ(m.rx, 255);
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 60, 128);              /* its stick out */
+    CHECK_EQ(m.use_r, 0);
+    CHECK_EQ(m.rx, 60);
+    keys_clear();
+
+    /* 8. Keyboard vs left stick: the last one used wins; held keys still move
+     * while the controller's stick rests. */
+    kbm_runtime_reset(&rt); kbm_arb_reset(&a);
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 128, 128);
+    press("W");
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 128, 128);
+    CHECK_EQ(m.use_l, 1);
+    CHECK_EQ(m.ly, 0);
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 0, 128, 128, 128);                /* stick left, W held */
+    CHECK_EQ(m.use_l, 0);
+    CHECK_EQ(m.lx, 0);
+    CHECK_EQ(m.ly, 128);
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 128, 128);              /* stick back, W held */
+    CHECK_EQ(m.use_l, 1);
+    CHECK_EQ(m.ly, 0);
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 0, 128, 128, 128);                /* stick out again */
+    CHECK_EQ(m.use_l, 0);
+    keys_clear();
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 0, 128, 128, 128);
+    press("D");
+    m = arb_step(&c, &rt, &a, t += 16.0, 0, 0, 0, 0, 128, 128, 128);                /* D pressed last */
+    CHECK_EQ(m.use_l, 1);
+    CHECK_EQ(m.lx, 255);
+    keys_clear();
+
+    /* 9. A controller appearing while the mouse is noisy starts with both sticks. */
+    kbm_runtime_reset(&rt); kbm_arb_reset(&a);
+    CHECK_EQ(arb_jitter_run(&c, &rt, &a, &t, 40, 1, 2, 128), 0);
+
+    /* 10. Switches: mouse_takeover = 0 lets any motion take the camera (the
+     * old behaviour for the mouse); last_device_wins = 0 is the old merge for
+     * both sticks; no controller = no arbitration at all. */
+    {
+        KbmConfig z = c;
+        z.mouse_takeover = 0.0f;
+        kbm_runtime_reset(&rt); kbm_arb_reset(&a);
+        m = arb_step(&z, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 255, 128);
+        m = arb_step(&z, &rt, &a, t += 16.0, 1, 0, 0, 128, 128, 255, 128);
+        CHECK_EQ(m.use_r, 1);
+        z = c;
+        z.last_device_wins = 0;
+        kbm_runtime_reset(&rt); kbm_arb_reset(&a);
+        press("W");
+        m = arb_step(&z, &rt, &a, t += 16.0, 0, 0, 0, 0, 128, 128, 128);
+        CHECK_EQ(m.use_l, 1);                                    /* keys override the stick */
+        keys_clear();
+        KbmOut o;
+        int ul = -1, ur = -1;
+        kbm_eval(&c, &rt, fake_down, NULL, t += 16.0, 5, 0, 0, &o);
+        kbm_arbitrate(&c, &a, 0, 0, 128, 128, 128, 128, &o, 5, 0, t, &ul, &ur);
+        CHECK_EQ(ur, 1);
+        CHECK_EQ(a.started, 0);
+    }
+
+    /* 11. The settings parse. */
+    char err[64];
+    KbmConfig p;
+    kbm_config_defaults(&p);
+    CHECK_EQ(kbm_parse_line(&p, "last_device_wins = 0", err, sizeof err), 1);
+    CHECK_EQ(p.last_device_wins, 0);
+    CHECK_EQ(kbm_parse_line(&p, "mouse_takeover = 120", err, sizeof err), 1);
+    CHECK_NEAR(p.mouse_takeover, 120.0, 1e-6);
+    CHECK_EQ(kbm_parse_line(&p, "mouse_takeover = -3", err, sizeof err), -1);
+
+    /* 12. The threshold is hand motion: at mouse_sensitivity 0.5 (a 1600 DPI
+     * mouse turned down) it takes twice the counts. */
+    {
+        KbmConfig h = c;
+        int t1 = -1, t2 = -1;
+        kbm_runtime_reset(&rt); kbm_arb_reset(&a);
+        arb_step(&h, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 128, 128);
+        for (int i = 0; i < 40 && t1 < 0; i++)
+            if (arb_step(&h, &rt, &a, t += 16.0, 8, 0, 0, 128, 128, 128, 128).use_r == 1) t1 = i;
+        h.mouse_sens = 0.5f;
+        kbm_runtime_reset(&rt); kbm_arb_reset(&a);
+        arb_step(&h, &rt, &a, t += 16.0, 0, 0, 0, 128, 128, 128, 128);
+        for (int i = 0; i < 40 && t2 < 0; i++)
+            if (arb_step(&h, &rt, &a, t += 16.0, 8, 0, 0, 128, 128, 128, 128).use_r == 1) t2 = i;
+        CHECK(t1 >= 4 && t1 <= 5);
+        CHECK(t2 >= 2 * t1 - 1 && t2 <= 2 * t1 + 3);
+    }
+}
+
+static void test_print(void)
+{
+    KbmConfig c;
+    kbm_config_defaults(&c);
+    FILE* f = tmpfile();
+    if (!f) { printf("note: tmpfile() unavailable, print test skipped\n"); return; }
+    kbm_print_bindings(&c, f, "[t]");
+    char ln[400], all[8000];
+    all[0] = 0;
+    rewind(f);
+    while (fgets(ln, sizeof ln, f)) strncat(all, ln, sizeof all - strlen(all) - 1);
+    fclose(f);
+    CHECK(strstr(all, "Cross") && strstr(all, "Space, Enter"));
+    CHECK(strstr(all, "LStickUp") && strstr(all, "WheelUp"));
+    CHECK(strstr(all, "sensitivity 1.00") != NULL);
+    CHECK(strstr(all, "note:") == NULL);               /* defaults: no key on two inputs */
+    CHECK(strstr(all, "each stick follows the device used last") != NULL);
+    char err[64];
+    kbm_parse_line(&c, "Square = Space", err, sizeof err);
+    f = tmpfile();
+    if (!f) return;
+    kbm_print_bindings(&c, f, "[t]");
+    all[0] = 0;
+    rewind(f);
+    while (fgets(ln, sizeof ln, f)) strncat(all, ln, sizeof all - strlen(all) - 1);
+    fclose(f);
+    CHECK(strstr(all, "note: key Space drives") != NULL);
+}
+
+int main(void)
+{
+    test_key_names();
+    test_target_names();
+    test_defaults();
+    test_parse_lines();
+    test_parse_text();
+    test_text_prepare();
+    test_eval_keys();
+    test_axis_u8();
+    test_wheel();
+    test_mouse_speed();
+    test_mouse_saturation();
+    test_mouse_stop();
+    test_mouse_small_motion();
+    test_mouse_integral();
+    test_mouse_stale();
+    test_arbitration();
+    test_print();
+    printf("%s: %d checks, %d failure(s)\n", g_fail ? "FAILED" : "OK", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/input/tests/test_sony_virtual.c b/libs/input/tests/test_sony_virtual.c
new file mode 100644
index 0000000..08bfcb2
--- /dev/null
+++ b/libs/input/tests/test_sony_virtual.c
@@ -0,0 +1,276 @@
+/*
+ * End-to-end test of the Sony drivers through the real pad host manager
+ * (pad_host_win.c) on virtual devices: open() on the device thread with
+ * feature replies, port assignment, parse -> padhost_get snapshot, actuator ->
+ * build_output -> captured write, receiver idle/active, unplug -> close(),
+ * and a Bluetooth pad that goes silent without disconnecting.
+ *
+ * Physical controllers are off (PAD_NO_HOST=1 and controllers=0 before
+ * padhost_init), so the DualSense plugged into this machine is never opened
+ * and nothing is written to real hardware.
+ *
+ *   clang-cl /std:c17 /O2 /MD -I include -I libs/input -I libs/system libs/input/tests/test_sony_virtual.c
+ *            libs/input/pad_host_win.c libs/input/pad_hid_sony.c /Fe:test_sony_virtual.exe
+ */
+#ifndef _CRT_SECURE_NO_WARNINGS
+#define _CRT_SECURE_NO_WARNINGS
+#endif
+#include "pad_host.h"
+#include "cellPad.h"
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "sony_vectors.h"
+
+static int g_fail, g_checks;
+#define CHECK(cond) do { g_checks++; if (!(cond)) { g_fail++; \
+    printf("  FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); } } while (0)
+#define CHECK_EQ(a, b) do { long _a = (long)(a), _b = (long)(b); g_checks++; if (_a != _b) { g_fail++; \
+    printf("  FAIL %s:%d: %s == %ld, expected %ld\n", __FILE__, __LINE__, #a, _a, _b); } } while (0)
+
+static unsigned crc_le(const u8* p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((unsigned)p[3] << 24); }
+static int bt_crc_ok(u8 seed, const u8* rep, int n)
+{
+    return padhost_crc32(padhost_crc32(0, &seed, 1), rep, n - 4) == crc_le(rep + n - 4);
+}
+
+/* Wait until the device has written more than `after` output reports. */
+static int wait_output(int id, int after, u8* buf, int cap, int* count)
+{
+    ULONGLONG end = GetTickCount64() + 2000;
+    int n = 0;
+    do {
+        n = padhost_virtual_last_output(id, buf, cap, count);
+        if (*count > after) return n;
+        Sleep(2);
+    } while (GetTickCount64() < end);
+    return n;
+}
+
+static void test_dualsense_bt(void)
+{
+    printf("DualSense over Bluetooth, end to end\n");
+    int id = padhost_virtual_prepare(&padhost_drv_dualsense, PADHOST_BUS_BT, 0x054C, 0x0CE6, "7c66ef38edbd", 78, 78);
+    CHECK(id > 0);
+    padhost_virtual_set_feature(id, vec_ds5_bt_cal, 41);
+    padhost_virtual_set_feature(id, vec_ds5_bt_fw_0200, 64);
+    padhost_virtual_set_feature(id, vec_ds5_bt_pair, 20);
+    CHECK_EQ(padhost_virtual_start(id), 0);
+    int port = padhost_virtual_port(id);
+    CHECK(port >= 0);
+
+    /* open() wrote the lightbar reset (seq 0); the manager then sends the port's LEDs. */
+    u8 out[600]; int count = 0;
+    int n = wait_output(id, 1, out, (int)sizeof out, &count);
+    CHECK(count >= 2);
+    CHECK_EQ(n, 78);
+    CHECK_EQ(out[0], 0x31); CHECK_EQ(out[2], 0x10);
+    CHECK(bt_crc_ok(0xA2, out, 78));
+    {
+        u8 r, g, b; padhost_port_color(port, &r, &g, &b);
+        CHECK_EQ(out[3 + 44], r); CHECK_EQ(out[3 + 45], g); CHECK_EQ(out[3 + 46], b);
+        CHECK_EQ(out[3 + 1], 0x14);
+        CHECK_EQ(out[3 + 0], 0x03);                    /* fw 2.00: v1 compatible vibration */
+    }
+
+    /* Simple report first (padded like Windows), then the full one. */
+    u8 rep[78]; memset(rep, 0, sizeof rep);
+    rep[0] = 0x01; rep[1] = 0x80; rep[2] = 0x80; rep[3] = 0x80; rep[4] = 0x80;
+    rep[5] = 0x08 | 0x20; rep[6] = 0x20; rep[7] = 0x00;  /* cross, options */
+    CHECK_EQ(padhost_virtual_feed(id, rep, 78), 0);
+    PadHostPortState st;
+    CHECK_EQ(padhost_get(port, &st), 1);
+    CHECK_EQ(st.kind, PADHOST_KIND_DUALSENSE); CHECK_EQ(st.bus, PADHOST_BUS_BT);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_START);
+    CHECK_EQ(st.has_motion, 0);
+
+    CHECK_EQ(padhost_virtual_feed(id, vec_ds5_bt_in, 78), 0);
+    CHECK_EQ(padhost_get(port, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_TRIANGLE | CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_LEFT |
+                         CELL_PAD_CTRL_SELECT | CELL_PAD_CTRL_L3);
+    CHECK_EQ(st.has_motion, 1);
+    CHECK_EQ(st.sensor_x, 624); CHECK_EQ(st.sensor_g, 344);
+    CHECK_EQ(st.battery, 35);
+    CHECK_EQ(st.press[PADHOST_PRESS_L2], 0x33);
+
+    /* Rumble from the guest: small on/off, large 0..255. */
+    padhost_set_actuator(port, 1, 0x80);
+    n = wait_output(id, count, out, (int)sizeof out, &count);
+    CHECK_EQ(n, 78);
+    CHECK(bt_crc_ok(0xA2, out, 78));
+    CHECK_EQ(out[3 + 2], 255); CHECK_EQ(out[3 + 3], 0x80);
+    padhost_set_actuator(port, 0, 0);
+    n = wait_output(id, count, out, (int)sizeof out, &count);
+    CHECK_EQ(out[3 + 2], 0); CHECK_EQ(out[3 + 3], 0);
+
+    padhost_virtual_detach(id);                        /* close(): RELEASE_LEDS, motors off */
+    padhost_virtual_last_output(id, out, (int)sizeof out, &count);
+    CHECK_EQ(padhost_get(port, &st), 0);
+}
+
+/* A Bluetooth pad that stops reporting without a disconnect (battery dead,
+ * out of range): after a second its input is released (still connected) and
+ * its output re-sent, which makes the stack notice a dead link; the next
+ * report brings the input back. */
+static void test_bt_silence(void)
+{
+    printf("DualSense over Bluetooth going silent\n");
+    int id = padhost_virtual_prepare(&padhost_drv_dualsense, PADHOST_BUS_BT, 0x054C, 0x0CE6, "7c66ef38edbe", 78, 78);
+    CHECK(id > 0);
+    padhost_virtual_set_feature(id, vec_ds5_bt_cal, 41);
+    padhost_virtual_set_feature(id, vec_ds5_bt_fw_0200, 64);
+    padhost_virtual_set_feature(id, vec_ds5_bt_pair, 20);
+    CHECK_EQ(padhost_virtual_start(id), 0);
+    int port = padhost_virtual_port(id);
+    CHECK(port >= 0);
+    u8 rep[78];
+    memcpy(rep, vec_ds5_bt_in, 78);                  /* a full 0x31 report, buttons held */
+    CHECK_EQ(padhost_virtual_feed(id, rep, 78), 0);
+    PadHostPortState st;
+    padhost_get(port, &st);
+    CHECK(st.buttons != 0);
+    u8 out[600]; int outs0 = 0, outs = 0;
+    padhost_virtual_last_output(id, out, (int)sizeof out, &outs0);
+    Sleep(600);
+    padhost_get(port, &st);
+    CHECK(st.buttons != 0);                          /* 0.6 s: still the last state */
+    Sleep(1000);
+    padhost_get(port, &st);
+    padhost_virtual_last_output(id, out, (int)sizeof out, &outs);
+    CHECK_EQ(st.connected, 1);
+    CHECK_EQ(st.buttons, 0); CHECK_EQ(st.lx, 128); CHECK_EQ(st.ry, 128);
+    CHECK_EQ(st.press[PADHOST_PRESS_L2], 0); CHECK_EQ(st.has_motion, 0);
+    CHECK(outs > outs0);                              /* the output was written again */
+    CHECK(bt_crc_ok(0xA2, out, 78));
+    CHECK_EQ(padhost_virtual_feed(id, rep, 78), 0); /* reports again */
+    padhost_get(port, &st);
+    CHECK(st.buttons != 0 && st.has_motion == 1);
+    padhost_virtual_detach(id);
+}
+
+static void test_ds4_receiver(void)
+{
+    printf("DS4 USB wireless adapter: idle -> port released, controller -> calibration + port\n");
+    u8 cal[37] = { 0x02 };
+    const short calv[17] = { 0, 0, 0,  8000, 8000, 8000, -8000, -8000, -8000,  500, 500,
+                             8192, -8192, 8192, -8192, 8192, -8192 };
+    for (int i = 0; i < 17; i++) { cal[1 + 2 * i] = (u8)calv[i]; cal[2 + 2 * i] = (u8)((u16)calv[i] >> 8); }
+    int id = padhost_virtual_prepare(&padhost_drv_ds4, PADHOST_BUS_USB, 0x054C, 0x0BA0, "adapter", 64, 32);
+    padhost_virtual_set_feature(id, cal, 37);
+    CHECK_EQ(padhost_virtual_start(id), 0);
+    u8 rep[64] = { 0x01, 0x80, 0x80, 0x80, 0x80, 0x08 };
+    rep[1 + 30] = 0x04;                                /* no controller */
+    padhost_virtual_feed(id, rep, 64);
+    CHECK_EQ(padhost_virtual_port(id), -1);
+    rep[1 + 30] = 0x00;
+    rep[1 + 4] = 0x28;                                 /* cross */
+    rep[1 + 20] = 0x00; rep[1 + 21] = 0x20;            /* accel y +1 g */
+    padhost_virtual_feed(id, rep, 64);
+    int port = padhost_virtual_port(id);
+    CHECK(port >= 0);
+    PadHostPortState st;
+    CHECK_EQ(padhost_get(port, &st), 1);
+    CHECK_EQ(st.kind, PADHOST_KIND_DS4);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CROSS);
+    CHECK_EQ(st.sensor_y, 399);
+    rep[1 + 30] = 0x04;
+    padhost_virtual_feed(id, rep, 64);
+    CHECK_EQ(padhost_virtual_port(id), -1);
+    /* A controller behind the receiver again, on the same port: its lightbar
+     * is set again (the manager resends LEDs on every binding, not only when
+     * the port number differs). */
+    {
+        u8 out[1024];
+        int before = 0, after = 0;
+        padhost_virtual_last_output(id, out, (int)sizeof out, &before);
+        rep[1 + 30] = 0x00;
+        padhost_virtual_feed(id, rep, 64);
+        CHECK_EQ(padhost_virtual_port(id), port);
+        int n = wait_output(id, before, out, (int)sizeof out, &after);
+        CHECK(after > before);
+        CHECK(n > 0 && out[0] == 0x05);
+    }
+    padhost_virtual_detach(id);
+}
+
+static void test_ds4_bt(void)
+{
+    printf("DS4 over Bluetooth (547-byte reports), end to end\n");
+    u8 f02[37] = { 0x02 };
+    int id = padhost_virtual_prepare(&padhost_drv_ds4, PADHOST_BUS_BT, 0x054C, 0x05C4, "a4:ae:12:34:56:78", 547, 547);
+    padhost_virtual_set_feature(id, vec_ds4_bt_cal, 41);
+    padhost_virtual_set_feature(id, f02, 37);
+    CHECK_EQ(padhost_virtual_start(id), 0);
+    int port = padhost_virtual_port(id);
+    CHECK(port >= 0);
+    u8 rep[547]; memset(rep, 0, sizeof rep); memcpy(rep, vec_ds4_bt_in, 78);
+    padhost_virtual_feed(id, rep, 547);
+    PadHostPortState st;
+    CHECK_EQ(padhost_get(port, &st), 1);
+    CHECK_EQ(st.sensor_y, 399); CHECK_EQ(st.sensor_g, 648); CHECK_EQ(st.battery, 85);
+    CHECK_EQ(st.ps, 1);
+    u8 out[1024]; int count = 0;
+    padhost_set_actuator(port, 0, 0xFF);
+    int n = wait_output(id, 0, out, (int)sizeof out, &count);
+    for (int tries = 0; tries < 50 && out[7] != 0xFF; tries++) n = wait_output(id, count, out, (int)sizeof out, &count);
+    CHECK(n == 547 || n == 78);
+    CHECK_EQ(out[0], 0x11); CHECK_EQ(out[1], 0xC4);
+    CHECK_EQ(out[7], 0xFF);
+    CHECK(bt_crc_ok(0xA2, out, 78));
+    padhost_set_actuator(port, 0, 0);
+    padhost_virtual_detach(id);
+}
+
+static void test_ds3(void)
+{
+    printf("DS3 via SIXAXIS.SYS / DsHidMini SXS, and the GPJ pressure collection\n");
+    u8 r[49]; memset(r, 0, sizeof r);
+    r[0] = 0x01; r[2] = 0x08; r[3] = 0x40; r[6] = 0x10; r[7] = 0x20; r[8] = 0x30; r[9] = 0x40;
+    r[24] = 0xE5; r[30] = 0xEF;
+    const unsigned s[4] = { 0x0201, 0x01FE, 0x0190, 0x01FF };   /* sixaxis.sys form, little-endian */
+    for (int i = 0; i < 4; i++) { r[41 + 2 * i] = (u8)s[i]; r[42 + 2 * i] = (u8)(s[i] >> 8); }
+    u8 f0[50]; f0[0] = 0x00; f0[1] = 0x00; f0[2] = 0x3F; memcpy(f0 + 3, r + 2, 47);
+    int id = padhost_virtual_prepare(&padhost_drv_ds3, PADHOST_BUS_USB, 0x054C, 0x0268, "ds3", 13, 49);
+    padhost_virtual_set_feature(id, f0, 50);
+    CHECK_EQ(padhost_virtual_start(id), 0);
+    int port = padhost_virtual_port(id);
+    CHECK(port >= 0);
+    u8 j[13] = { 0 };
+    padhost_virtual_feed(id, j, 13);
+    PadHostPortState st;
+    CHECK_EQ(padhost_get(port, &st), 1);
+    CHECK_EQ(st.kind, PADHOST_KIND_DS3);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_START | CELL_PAD_CTRL_CROSS);
+    CHECK_EQ(st.has_pressure, 1); CHECK_EQ(st.press[PADHOST_PRESS_CROSS], 0xE5);
+    CHECK_EQ(st.has_motion, 1);
+    CHECK_EQ(st.sensor_x, 0x201); CHECK_EQ(st.sensor_z, 0x1FE); CHECK_EQ(st.sensor_y, 0x190); CHECK_EQ(st.sensor_g, 0x1FF);
+    CHECK_EQ(st.battery, 100);
+    u8 out[64]; int count = 0;
+    int n = wait_output(id, 0, out, (int)sizeof out, &count);
+    CHECK_EQ(n, 49);
+    CHECK_EQ(out[0], 0x00); CHECK_EQ(out[1], 0x02);
+    CHECK_EQ(out[3 + 10], (padhost_port_led_mask(port) & 0x0F) << 1);
+    padhost_virtual_detach(id);
+
+    int g = padhost_virtual_prepare(&padhost_drv_ds3, PADHOST_BUS_USB, 0x054C, 0x0268, "gpj2", 9, 0);
+    CHECK_EQ(padhost_virtual_start(g), -1);           /* refused: never a port */
+}
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    _putenv("PAD_NO_HOST=1");
+    CHECK_EQ(padhost_config_set("controllers", "0"), 1);
+    CHECK_EQ(padhost_config_set("deadzone", "0"), 1);
+    padhost_init();
+    test_dualsense_bt();
+    test_bt_silence();
+    test_ds4_receiver();
+    test_ds4_bt();
+    test_ds3();
+    padhost_shutdown();
+    printf("\n%d checks, %d failed\n", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
