+/*
+ * ps3recomp - the options overlay's menu (API and scope: ovl_menu.h).
+ *
+ * Look: a dark translucent panel over a dimmed game, tabs with L1 / R1 pills,
+ * a list of rows (group headers in accent caps, alternate shading, the focused
+ * row in accent with a bar) on the left, the focused row's help on the right
+ * (what it does, its default, when it applies, where its value came from),
+ * and a footer with the pending-restart count and the button hints for the
+ * keyboard or the controller in use. Widgets: selector < value > (every
+ * choice; Enter / Cross / a click opens the choice list), slider, toggle,
+ * action button; badges RESTART (amber; filled while a change waits for the
+ * restart) and ENV (the environment sets it: locked, the tooltip names the
+ * variable). Text is drawn 1:1 from the GDI atlas at integer pixels.
+ */
+#include "ovl_menu.h"
+#include "pad_host.h"      /* PADHOST_KIND_* (button glyphs) */
+#include "rsx_upscale.h"   /* rsx_vrr_cap_hz: the fps limit under a variable-refresh display */
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ---------------------------------------------------------------- style */
+#define C_TEXT    0xE9EDF3
+#define C_TEXT2   0xA3ADBC
+#define C_TEXT3   0x6F7988
+#define C_GROUP   0x3AA3FF
+#define C_ROW     0x1A1D24
+#define C_TRACK   0x2E333E
+#define C_ACCENT  0x3AA3FF
+#define C_AMBER   0xF2A93B
+#define C_GREEN   0x4CD3A0
+#define C_RED     0xFF6B6B
+#define C_ENV     0x8A94A6
+#define C_KEYCAP  0x2E3440
+#define C_KEYEDGE 0x5A6475
+
+enum { UI_SELECT = 1, UI_SLIDER, UI_TOGGLE, UI_BUTTON, UI_INFO };
+enum { DYN_NONE = 0, DYN_FPS, DYN_WINDOW, DYN_MONITOR };
+
+typedef struct {
+    const char* key;
+    int ui;
+    double lo, hi, step;
+    const char* fmt;        /* the number's format (slider) */
+    int word_stop;          /* the row's first word ("auto") is a stop left of lo */
+    const char* values;     /* choices ('|') */
+    const char* labels;
+    int dyn;
+    const char* label;      /* a better label for the row */
+} ovl_hint;
+
+/* How some rows are best shown. A row without a hint gets the widget its type
+ * suggests (bool: toggle, enum: selector, number: slider over its range). */
+static const ovl_hint s_hints[] = {
+    { "fullscreen", UI_SELECT, 0, 0, 0, NULL, 0, "0|1", "Windowed|Borderless fullscreen", 0, "Window mode" },
+    { "window", UI_SELECT, 0, 0, 0, NULL, 0, NULL, NULL, DYN_WINDOW, NULL },
+    { "monitor", UI_SELECT, 0, 0, 0, NULL, 0, NULL, NULL, DYN_MONITOR, NULL },
+    { "aspect", UI_SELECT, 0, 0, 0, NULL, 0, "auto|off|64:27|43:18|21:9|32:9|16:10",
+      "Auto (the monitor's shape)|16:9 (PS3)|64:27 (2560\xC3\x97" "1080)|43:18 (3440\xC3\x97" "1440)|21:9|32:9|16:10",
+      0, NULL },
+    { "brightness", UI_SLIDER, 0.5, 2.0, 0.05, "%.2f", 0, NULL, NULL, 0, NULL },
+    { "detail", UI_SLIDER, 0.5, 2.0, 0.05, "%.2f\xC3\x97", 0, NULL, NULL, 0, NULL },
+    { "fps_cap", UI_SELECT, 0, 0, 0, NULL, 0, NULL, NULL, DYN_FPS, NULL },
+    { "vsync", UI_SELECT, 0, 0, 0, NULL, 0, "0|1|2|3|4",
+      "Off|On (every refresh)|Every 2nd refresh|Every 3rd refresh|Every 4th refresh", 0, NULL },
+    { "mouse_sensitivity", UI_SLIDER, 0.1, 5.0, 0.05, "%.2f", 0, NULL, NULL, 0, NULL },
+    { "mouse_sensitivity_y", UI_SLIDER, 0.1, 3.0, 0.05, "%.2f", 0, NULL, NULL, 0, NULL },
+    { "deadzone", UI_SLIDER, 0, 40, 1, "%.0f%%", 1, NULL, NULL, 0, NULL },
+    { "deadzone_left", UI_SLIDER, 0, 40, 1, "%.0f%%", 1, NULL, NULL, 0, NULL },
+    { "deadzone_right", UI_SLIDER, 0, 40, 1, "%.0f%%", 1, NULL, NULL, 0, NULL },
+    { "rumble", UI_SLIDER, 0, 200, 10, "%.0f%%", 0, NULL, NULL, 0, NULL },
+    { "volume", UI_SLIDER, 0, 100, 5, "%.0f%%", 0, NULL, NULL, 0, NULL },
+    { "sharpen", UI_SLIDER, 0, 100, 5, "%.0f%%", 0, NULL, NULL, 0, NULL },
+    { "ui_scale", UI_SELECT, 0, 0, 0, NULL, 0, "auto|75|90|100|110|125|150|175|200",
+      "Auto|75%|90%|100%|110%|125%|150%|175%|200%", 0, NULL },
+};
+
+static const ovl_hint* hint_of(const char* key)
+{
+    for (unsigned i = 0; i < sizeof s_hints / sizeof s_hints[0]; i++)
+        if (!strcmp(s_hints[i].key, key)) return &s_hints[i];
+    return NULL;
+}
+
+/* ---------------------------------------------------------------- small helpers */
+
+static void norm(const char* s, char* out, size_t n)
+{
+    size_t k = 0;
+    for (; s && *s && k + 1 < n; s++) {
+        char c = *s;
+        if (c == ' ' || c == '_' || c == '-' || c == '\t') continue;
+        if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
+        out[k++] = c;
+    }
+    out[k] = 0;
+}
+
+static int same_text(const char* a, const char* b)
+{
+    char x[96], y[96];
+    norm(a, x, sizeof x);
+    norm(b, y, sizeof y);
+    return !strcmp(x, y);
+}
+
+/* the k-th '|' element of list into out; 0 if there is none */
+static int list_item(const char* list, int k, char* out, size_t n)
+{
+    if (!list) return 0;
+    const char* p = list;
+    for (int i = 0; i < k; i++) {
+        p = strchr(p, '|');
+        if (!p) return 0;
+        p++;
+    }
+    const char* e = strchr(p, '|');
+    size_t len = e ? (size_t)(e - p) : strlen(p);
+    if (len >= n) len = n - 1;
+    memcpy(out, p, len);
+    out[len] = 0;
+    return 1;
+}
+
+static int list_count(const char* list)
+{
+    if (!list || !*list) return 0;
+    int n = 1;
+    for (const char* p = list; *p; p++) n += *p == '|';
+    return n;
+}
+
+static float S(const ovl_menu* m, float v) { return floorf(v * m->s + 0.5f); }
+
+static int cap_h(const ovl_list* L, int face)
+{
+    int i = ovl_font_index('H');
+    int h = L->font->face[face].g[i].h;
+    return h > 0 ? h : L->font->face[face].px * 7 / 10;
+}
+/* baseline that centres a face's capitals on cy */
+static float base_c(const ovl_list* L, int face, float cy) { return floorf(cy + cap_h(L, face) * 0.5f + 0.5f); }
+
+static void set_msg(ovl_menu* m, unsigned col, double secs, const char* fmt, const char* a, const char* b)
+{
+    snprintf(m->msg, sizeof m->msg, fmt, a ? a : "", b ? b : "");
+    m->msg_col = col;
+    m->msg_until = m->now + secs;
+    m->dirty = 1;
+}
+
+/* ---------------------------------------------------------------- tabs */
+
+static const char* const s_fixed_tabs[] = { "Display", "Graphics", "Frame", "Controls", "Audio", "System" };
+#define NFIXED 6
+
+static const char* tab_of(const opt_def* d)
+{
+    const char* t = d->tab ? d->tab : "System";
+    if (!strcmp(t, "Performance")) return "Frame";
+    if (!strcmp(t, "Interface")) return "System";
+    if (!strcmp(t, "Effects")) return "Graphics";
+    return t;
+}
+
+static int row_shown(const opt_def* d) { return d && !(d->flags & OPT_F_HIDDEN); }
+
+static void build_tabs(ovl_menu* m)
+{
+    char cur[24];
+    snprintf(cur, sizeof cur, "%s", m->ntab ? m->tabs[m->tab] : "Display");
+    m->ntab = 0;
+    for (int i = 0; i < NFIXED; i++) snprintf(m->tabs[m->ntab++], sizeof m->tabs[0], "%s", s_fixed_tabs[i]);
+    const int n = opt_count();
+    for (int i = 0; i < n && m->ntab < OVL_MAXTAB; i++) {
+        const opt_def* d = opt_def_of(i);
+        if (!row_shown(d)) continue;
+        const char* t = tab_of(d);
+        int seen = 0;
+        for (int k = 0; k < m->ntab; k++) if (!strcmp(m->tabs[k], t)) seen = 1;
+        if (!seen) snprintf(m->tabs[m->ntab++], sizeof m->tabs[0], "%s", t);
+    }
+    m->tab = 0;
+    for (int k = 0; k < m->ntab; k++) if (!strcmp(m->tabs[k], cur)) m->tab = k;
+}
+
+const char* ovl_menu_tab_name(const ovl_menu* m) { return m->ntab ? m->tabs[m->tab] : ""; }
+
+/* ---------------------------------------------------------------- items */
+
+static ovl_item* add_item(ovl_menu* m, int kind, const char* label)
+{
+    if (m->nitems >= OVL_MAXITEM) return NULL;
+    ovl_item* it = &m->items[m->nitems++];
+    memset(it, 0, sizeof *it);
+    it->kind = kind;
+    it->id = -1;
+    snprintf(it->label, sizeof it->label, "%s", label ? label : "");
+    return it;
+}
+
+static const char* apply_text(opt_apply a)
+{
+    switch (a) {
+    case OPT_LIVE:   return "Instantly";
+    case OPT_FRAME:  return "At the next frame";
+    case OPT_RELOAD: return "At the next frame (reloads)";
+    default:         return "After a restart";
+    }
+}
+
+static int widget_of(const opt_def* d)
+{
+    const ovl_hint* h = hint_of(d->key);
+    if (h && h->ui) return h->ui;
+    if (d->type == OPT_BOOL) return UI_TOGGLE;
+    if (d->type == OPT_ENUM || d->type == OPT_TEXT) return UI_SELECT;
+    return UI_SLIDER;
+}
+
+static void build_items(ovl_menu* m)
+{
+    m->nitems = 0;
+    const char* tab = m->tabs[m->tab];
+    const int n = opt_count();
+    m->rows_seen = n;
+    if (!strcmp(tab, "Graphics")) {
+        ovl_item* it = add_item(m, OVL_IT_GROUP, "Quality");
+        it = add_item(m, OVL_IT_PRESET, "Preset");
+        if (it) it->ui = UI_SELECT;
+    }
+    const char* groups[24];
+    int ng = 0;
+    for (int i = 0; i < n; i++) {
+        const opt_def* d = opt_def_of(i);
+        if (!row_shown(d) || strcmp(tab_of(d), tab)) continue;
+        const char* g = d->group ? d->group : "";
+        int seen = 0;
+        for (int k = 0; k < ng; k++) if (!strcmp(groups[k], g)) seen = 1;
+        if (!seen && ng < 24) groups[ng++] = g;
+    }
+    for (int k = 0; k < ng; k++) {
+        if (groups[k][0]) add_item(m, OVL_IT_GROUP, groups[k]);
+        for (int i = 0; i < n; i++) {
+            const opt_def* d = opt_def_of(i);
+            if (!row_shown(d) || strcmp(tab_of(d), tab) || strcmp(d->group ? d->group : "", groups[k])) continue;
+            const ovl_hint* h = hint_of(d->key);
+            ovl_item* it = add_item(m, OVL_IT_SETTING, (h && h->label) ? h->label : (d->label ? d->label : d->key));
+            if (!it) break;
+            it->id = i;
+            it->ui = widget_of(d);
+        }
+    }
+    if (!strcmp(tab, "System")) {
+        add_item(m, OVL_IT_GROUP, "Settings");
+        ovl_item* it = add_item(m, OVL_IT_ACTION, "Reset every setting to its default");
+        if (it) { it->action = OVL_ACTION_RESET_ALL; it->ui = UI_BUTTON; }
+        it = add_item(m, OVL_IT_ACTION, "Open the settings folder");
+        if (it) { it->action = OVL_ACTION_OPEN_FOLDER; it->ui = UI_BUTTON; }
+        /* a controller has no other way out of the game (the footer's Triangle / Y hint is on every tab);
+         * not the tab's first row, so a double press on opening the tab cannot quit */
+        add_item(m, OVL_IT_GROUP, "Game");
+        it = add_item(m, OVL_IT_ACTION, "Quit game");
+        if (it) { it->action = OVL_ACTION_QUIT; it->ui = UI_BUTTON; }
+        add_item(m, OVL_IT_GROUP, "About");
+        int ex = 0;
+        const char* path = opt_file_path(&ex);
+        if ((it = add_item(m, OVL_IT_INFO, "Game"))) {
+            snprintf(it->info, sizeof it->info, "%s", m->env.title[0] ? m->env.title : "ps3recomp"); it->ui = UI_INFO; }
+        if ((it = add_item(m, OVL_IT_INFO, "Renderer"))) {
+            snprintf(it->info, sizeof it->info, "Direct3D 12%s%s", m->env.adapter[0] ? " \xC2\xB7 " : "", m->env.adapter);
+            it->ui = UI_INFO; }
+        if ((it = add_item(m, OVL_IT_INFO, "Overlay"))) {
+            snprintf(it->info, sizeof it->info, "%s", m->env.host[0] ? m->env.host : "-"); it->ui = UI_INFO; }
+        if ((it = add_item(m, OVL_IT_INFO, "Settings file"))) {
+            if (path && path[0]) snprintf(it->info, sizeof it->info, "%s%s", path, ex ? "" : " (not written yet)");
+            else snprintf(it->info, sizeof it->info, "none: OPTIONS_CONFIG=none (changes last this run)");
+            it->ui = UI_INFO; }
+        if (m->env.build[0] && (it = add_item(m, OVL_IT_INFO, "Build"))) {
+            snprintf(it->info, sizeof it->info, "%s", m->env.build); it->ui = UI_INFO; }
+    }
+    int* f = &m->focus[m->tab];
+    if (*f >= m->nitems) *f = m->nitems - 1;
+    if (*f < 0) *f = 0;
+    /* land on something focusable */
+    for (int k = 0; k < m->nitems; k++) {
+        int i = (*f + k) % (m->nitems ? m->nitems : 1);
+        int kd = m->items[i].kind;
+        if (kd == OVL_IT_SETTING || kd == OVL_IT_PRESET || kd == OVL_IT_ACTION) { *f = i; break; }
+    }
+}
+
+static int focusable(const ovl_item* it)
+{
+    return it->kind == OVL_IT_SETTING || it->kind == OVL_IT_PRESET || it->kind == OVL_IT_ACTION;
+}
+
+/* ---------------------------------------------------------------- values and choices */
+
+static const char* const s_preset_names[OPT_NPRESETS] = { "PS3 Original", "Low", "Medium", "High", "Ultra" };
+
+static void fmt_num(double v, char* out, size_t n)
+{
+    char b[48];
+    snprintf(b, sizeof b, "%.4f", v);
+    char* dot = strchr(b, '.');
+    if (dot) {
+        char* e = b + strlen(b) - 1;
+        while (e > dot && *e == '0') *e-- = 0;
+        if (e == dot) *e = 0;
+    }
+    snprintf(out, n, "%s", b);
+}
+
+/* Choices of a selector row: values (the ini text) and their labels. */
+static int choices(ovl_menu* m, const ovl_item* it, char (*val)[48], char (*lab)[80], int max)
+{
+    int n = 0;
+    if (it->kind == OVL_IT_PRESET) {
+        for (int p = 0; p < OPT_NPRESETS && n < max; p++, n++) {
+            snprintf(val[n], 48, "%d", p);
+            snprintf(lab[n], 80, "%s", s_preset_names[p]);
+        }
+        return n;
+    }
+    const opt_def* d = opt_def_of(it->id);
+    if (!d) return 0;
+    const ovl_hint* h = hint_of(d->key);
+    char cur[96] = "";
+    opt_text(it->id, cur, sizeof cur);
+    if (h && h->dyn == DYN_FPS) {
+        double r = m->env.refresh_hz > 20 ? m->env.refresh_hz : 60.0;
+        double c[10]; int nc = 0;
+        c[nc++] = 0; c[nc++] = 30; c[nc++] = r / 2; c[nc++] = 60; c[nc++] = r; c[nc++] = 120; c[nc++] = 144;
+        const int vcap = m->env.refresh_hz > 20 ? rsx_vrr_cap_hz(r) : 0;   /* the vrr row sets this one */
+        if (vcap > 0) c[nc++] = vcap;
+        /* sort, dedupe */
+        for (int i = 0; i < nc; i++) for (int j = i + 1; j < nc; j++) if (c[j] < c[i]) { double t = c[i]; c[i] = c[j]; c[j] = t; }
+        double curv = atof(cur);
+        int have = 0;
+        char rs[24];
+        fmt_num(r, rs, sizeof rs);
+        for (int i = 0; i < nc && n < max; i++) {
+            if (i && fabs(c[i] - c[i - 1]) < 1e-6) continue;
+            if (c[i] < 0 || (c[i] > 0 && c[i] < 10)) continue;
+            fmt_num(c[i], val[n], 48);
+            if (c[i] == 0) snprintf(lab[n], 80, "Off (unlimited)");
+            else if (fabs(c[i] - r) < 1e-6 && m->env.refresh_hz > 20)
+                snprintf(lab[n], 80, "%s fps (the monitor's refresh)", val[n]);
+            else if (fabs(c[i] - r / 2) < 1e-6 && m->env.refresh_hz > 20)
+                snprintf(lab[n], 80, "%s fps (half of %s Hz)", val[n], rs);
+            else if (vcap > 0 && fabs(c[i] - vcap) < 1e-6)
+                snprintf(lab[n], 80, "%s fps (variable refresh: just under %s Hz)", val[n], rs);
+            else snprintf(lab[n], 80, "%s fps", val[n]);
+            if (fabs(c[i] - curv) < 1e-6) have = 1;
+            n++;
+        }
+        if (!have && n < max) {       /* a value set in the file or the environment */
+            fmt_num(curv, val[n], 48);
+            snprintf(lab[n], 80, "%s fps", val[n]);
+            n++;
+        }
+        return n;
+    }
+    if (h && h->dyn == DYN_WINDOW) {
+        static const int sz[][2] = { {1280, 720}, {1600, 900}, {1707, 720}, {1920, 1080}, {2560, 1080},
+                                     {2560, 1440}, {3440, 1440}, {3840, 2160} };
+        snprintf(val[n], 48, "auto"); snprintf(lab[n++], 80, "Auto (720 lines at 100%% scaling)");
+        snprintf(val[n], 48, "max");  snprintf(lab[n++], 80, "As large as fits");
+        for (unsigned i = 0; i < sizeof sz / sizeof sz[0] && n < max; i++) {
+            if (m->env.work_w && (sz[i][0] > m->env.work_w || sz[i][1] > m->env.work_h)) continue;
+            snprintf(val[n], 48, "%dx%d", sz[i][0], sz[i][1]);
+            snprintf(lab[n], 80, "%d\xC3\x97%d", sz[i][0], sz[i][1]);
+            n++;
+        }
+    } else if (h && h->dyn == DYN_MONITOR) {
+        snprintf(val[n], 48, "primary"); snprintf(lab[n++], 80, "Primary");
+        snprintf(val[n], 48, "cursor");  snprintf(lab[n++], 80, "The one under the mouse");
+        for (int i = 0; i < m->env.nmon && n < max; i++) {
+            snprintf(val[n], 48, "%d", i + 1);
+            snprintf(lab[n], 80, "Monitor %d: %d\xC3\x97%d%s", i + 1, m->env.mon[i].w, m->env.mon[i].h,
+                     m->env.mon[i].primary ? " (primary)" : "");
+            n++;
+        }
+    } else if (h && h->values) {
+        const int k = list_count(h->values);
+        for (int i = 0; i < k && n < max; i++, n++) {
+            list_item(h->values, i, val[n], 48);
+            if (!list_item(h->labels, i, lab[n], 80)) snprintf(lab[n], 80, "%s", val[n]);
+        }
+    } else if (d->type == OPT_BOOL) {
+        snprintf(val[0], 48, "0"); snprintf(val[1], 48, "1");
+        if (!list_item(d->labels, 0, lab[0], 80)) snprintf(lab[0], 80, "Off");
+        if (!list_item(d->labels, 1, lab[1], 80)) snprintf(lab[1], 80, "On");
+        n = 2;
+    } else if (d->type == OPT_ENUM) {
+        const int k = list_count(d->values);
+        for (int i = 0; i < k && n < max; i++, n++) {
+            list_item(d->values, i, val[n], 48);
+            if (!list_item(d->labels, i, lab[n], 80)) snprintf(lab[n], 80, "%s", val[n]);
+        }
+    }
+    /* the current value when the list does not hold it (a hand-edited file) */
+    if (d->type == OPT_TEXT || (h && (h->values || h->dyn))) {
+        int have = 0;
+        for (int i = 0; i < n; i++) if (same_text(val[i], cur)) have = 1;
+        if (!have && cur[0] && n < max) {
+            snprintf(val[n], 48, "%s", cur);
+            snprintf(lab[n], 80, "%s", cur);
+            n++;
+        }
+    }
+    return n;
+}
+
+static int bool_of(const char* t)
+{
+    char n[16];
+    norm(t, n, sizeof n);
+    return !strcmp(n, "1") || !strcmp(n, "on") || !strcmp(n, "true") || !strcmp(n, "yes");
+}
+
+/* Is choice value `val` the row's value `text`? (numbers by value, bools by meaning) */
+static int choice_is(const opt_def* d, const char* val, const char* text)
+{
+    if (d && (d->type == OPT_INT || d->type == OPT_FLOAT)) {
+        char* e1; char* e2;
+        double a = strtod(val, &e1), b = strtod(text, &e2);
+        if (e1 != val && !*e1 && e2 != text && !*e2) return fabs(a - b) < 1e-9;
+    }
+    if (d && d->type == OPT_BOOL) return bool_of(val) == bool_of(text);
+    return same_text(val, text);
+}
+
+static int current_choice(ovl_menu* m, const ovl_item* it, char (*val)[48], int n)
+{
+    (void)m;
+    if (it->kind == OVL_IT_PRESET) return opt_preset_current();   /* -1 = custom */
+    const opt_def* d = opt_def_of(it->id);
+    char cur[96] = "";
+    opt_text(it->id, cur, sizeof cur);
+    for (int i = 0; i < n; i++)
+        if (choice_is(d, val[i], cur)) return i;
+    return -1;
+}
+
+typedef struct { double lo, hi, step; const char* fmt; int word_stop; char word[24]; } slider_t;
+
+static void slider_of(const opt_def* d, slider_t* sl)
+{
+    const ovl_hint* h = hint_of(d->key);
+    memset(sl, 0, sizeof *sl);
+    if (h && h->ui == UI_SLIDER) { sl->lo = h->lo; sl->hi = h->hi; sl->step = h->step; sl->fmt = h->fmt; sl->word_stop = h->word_stop; }
+    else { sl->lo = d->lo; sl->hi = d->hi; sl->step = d->step > 0 ? d->step : (d->type == OPT_INT ? 1 : (d->hi - d->lo) / 100);
+           sl->fmt = d->type == OPT_INT ? "%.0f" : "%.2f"; }
+    if (sl->step <= 0) sl->step = 1;
+    if (sl->word_stop && !list_item(d->values, 0, sl->word, sizeof sl->word)) sl->word_stop = 0;
+}
+
+/* slider position 0..1 of the current value (the word stop is position 0) */
+static double slider_pos(const opt_def* d, opt_id id, const slider_t* sl)
+{
+    const double v = opt_f(id);
+    const int words = sl->word_stop;
+    const double span = sl->hi - sl->lo;
+    if (v < 0 && d->values && words) return 0.0;                 /* the word ("auto") */
+    double t = span > 0 ? (v - sl->lo) / span : 0;
+    if (t < 0) t = 0;
+    if (t > 1) t = 1;
+    if (words) {                                                /* one step's room for the word */
+        const double nsteps = span / sl->step;
+        t = (t * nsteps + 1.0) / (nsteps + 1.0);
+    }
+    return t;
+}
+
+void ovl_menu_value_text(ovl_menu* m, opt_id id, char* out, size_t n)
+{
+    const opt_def* d = opt_def_of(id);
+    out[0] = 0;
+    if (!d) return;
+    ovl_item tmp;
+    memset(&tmp, 0, sizeof tmp);
+    tmp.kind = OVL_IT_SETTING; tmp.id = id; tmp.ui = widget_of(d);
+    char cur[96] = "";
+    opt_text(id, cur, sizeof cur);
+    if (tmp.ui == UI_SLIDER) {
+        slider_t sl;
+        slider_of(d, &sl);
+        const double v = opt_f(id);
+        if (v < 0 && d->values) {
+            char w[32];
+            int k = (int)(-v + 0.5) - 1;
+            if (list_item(d->values, k, w, sizeof w)) {
+                if (w[0] >= 'a' && w[0] <= 'z') w[0] = (char)(w[0] - 'a' + 'A');
+                snprintf(out, n, "%s", w);
+                return;
+            }
+        }
+        snprintf(out, n, sl.fmt ? sl.fmt : "%g", v);
+        return;
+    }
+    char (*val)[48] = (char (*)[48])malloc(OVL_MAXCHOICE * 48);
+    char (*lab)[80] = (char (*)[80])malloc(OVL_MAXCHOICE * 80);
+    if (val && lab) {
+        int k = choices(m, &tmp, val, lab, OVL_MAXCHOICE);
+        int c = current_choice(m, &tmp, val, k);
+        if (c >= 0) snprintf(out, n, "%s", lab[c]);
+        else snprintf(out, n, "%s", cur);
+    }
+    free(val); free(lab);
+}
+
+/* ---------------------------------------------------------------- changing values */
+
+static void locked_msg(ovl_menu* m, opt_id id)
+{
+    const char* env = NULL;
+    opt_locked(id, &env);
+    set_msg(m, C_AMBER, 3.0, "Locked: the environment variable %s sets it%s", env ? env : "?", "");
+}
+
+/* opt_set with the menu's messages: OPT_SET_* (a locked row: OPT_SET_REFUSED) */
+static int set_value_r(ovl_menu* m, opt_id id, const char* v)
+{
+    if (opt_locked(id, NULL)) { locked_msg(m, id); return OPT_SET_REFUSED; }
+    const int r = opt_set(id, v);
+    m->dirty = 1;
+    if (r == OPT_SET_REFUSED) { set_msg(m, C_RED, 3.0, "Not a value of this setting: %s%s", v, ""); return r; }
+    const opt_def* d = opt_def_of(id);
+    if (r == OPT_SET_CHANGED && d && d->apply == OPT_RESTART)
+        set_msg(m, C_AMBER, 3.0, "%s: applies after a restart%s", d->label ? d->label : d->key, "");
+    return r;
+}
+
+static int set_value(ovl_menu* m, opt_id id, const char* v) { return set_value_r(m, id, v) == OPT_SET_CHANGED; }
+
+static void change(ovl_menu* m, ovl_item* it, int dir, int big)
+{
+    if (!it || !focusable(it) || it->kind == OVL_IT_ACTION) return;
+    if (it->kind == OVL_IT_PRESET) {
+        int c = opt_preset_current();
+        int p = c < 0 ? (dir > 0 ? 0 : OPT_NPRESETS - 1) : c + dir;
+        if (p < 0) p = OPT_NPRESETS - 1;
+        if (p >= OPT_NPRESETS) p = 0;
+        int k = opt_preset_apply(p);
+        set_msg(m, C_TEXT2, 2.5, "Preset %s%s", s_preset_names[p], k ? "" : " (nothing to change)");
+        return;
+    }
+    const opt_def* d = opt_def_of(it->id);
+    if (!d) return;
+    if (opt_locked(it->id, NULL)) { locked_msg(m, it->id); return; }
+    if (it->ui == UI_TOGGLE) { set_value(m, it->id, opt_i(it->id) ? "0" : "1"); return; }
+    if (it->ui == UI_SLIDER) {
+        slider_t sl;
+        slider_of(d, &sl);
+        double v = opt_f(it->id);
+        const double step = sl.step * (big ? 5 : 1);
+        char buf[48];
+        if (v < 0 && d->values) {                         /* on the word stop */
+            if (dir > 0) { fmt_num(sl.lo, buf, sizeof buf); set_value(m, it->id, buf); }
+            return;
+        }
+        double nv = v + dir * step;
+        if (sl.word_stop && nv < sl.lo - 1e-9) { set_value(m, it->id, sl.word); return; }
+        nv = sl.lo + floor((nv - sl.lo) / sl.step + 0.5) * sl.step;
+        if (nv < sl.lo) nv = sl.lo;
+        if (nv > sl.hi) nv = sl.hi;
+        if (d->type == OPT_INT) nv = floor(nv + 0.5);
+        fmt_num(nv, buf, sizeof buf);
+        set_value(m, it->id, buf);
+        return;
+    }
+    char (*val)[48] = (char (*)[48])malloc(OVL_MAXCHOICE * 48);
+    char (*lab)[80] = (char (*)[80])malloc(OVL_MAXCHOICE * 80);
+    if (val && lab) {
+        int n = choices(m, it, val, lab, OVL_MAXCHOICE);
+        if (n > 0) {
+            int c = current_choice(m, it, val, n);
+            int k = c < 0 ? 0 : c + dir;
+            if (k < 0) k = n - 1;
+            if (k >= n) k = 0;
+            set_value(m, it->id, val[k]);
+        }
+    }
+    free(val); free(lab);
+}
+
+static void slider_set_at(ovl_menu* m, ovl_item* it, float x)
+{
+    const opt_def* d = opt_def_of(it->id);
+    if (!d || opt_locked(it->id, NULL)) { if (d) locked_msg(m, it->id); return; }
+    slider_t sl;
+    slider_of(d, &sl);
+    const float vw = S(m, 64);
+    const float t0 = it->cx0, t1 = it->cx1 - vw - S(m, 14);
+    double t = t1 > t0 ? (x - t0) / (t1 - t0) : 0;
+    if (t < 0) t = 0;
+    if (t > 1) t = 1;
+    const double nsteps = (sl.hi - sl.lo) / sl.step;
+    char buf[48];
+    if (sl.word_stop) {
+        double k = floor(t * (nsteps + 1.0) + 0.5);
+        if (k <= 0) { set_value(m, it->id, sl.word); return; }
+        t = (k - 1.0) / nsteps;
+    }
+    double nv = sl.lo + floor(t * nsteps + 0.5) * sl.step;
+    if (nv > sl.hi) nv = sl.hi;
+    if (d->type == OPT_INT) nv = floor(nv + 0.5);
+    fmt_num(nv, buf, sizeof buf);
+    char cur[48] = "";
+    opt_text(it->id, cur, sizeof cur);
+    if (strcmp(cur, buf)) set_value(m, it->id, buf);
+}
+
+static void reset_item(ovl_menu* m, ovl_item* it)
+{
+    if (!it || it->kind != OVL_IT_SETTING) {
+        if (it && it->kind == OVL_IT_PRESET) {
+            opt_preset_apply(OPT_PRESET_PS3);
+            set_msg(m, C_TEXT2, 2.5, "Preset %s%s", s_preset_names[0], "");
+        }
+        return;
+    }
+    if (opt_locked(it->id, NULL)) { locked_msg(m, it->id); return; }
+    const int r = opt_reset(it->id);
+    set_msg(m, C_TEXT2, 2.0, r == OPT_SET_CHANGED ? "%s: back to the default%s" : "%s is at its default%s",
+            it->label, "");
+}
+
+static void reset_all(ovl_menu* m)
+{
+    int n = 0, locked = 0;
+    opt_batch(1);
+    for (int i = 0; i < opt_count(); i++) {
+        const opt_def* d = opt_def_of(i);
+        if (!d || (d->flags & OPT_F_HIDDEN)) continue;
+        if (opt_locked(i, NULL)) { locked++; continue; }
+        if (opt_reset(i) == OPT_SET_CHANGED) n++;
+    }
+    opt_batch(0);
+    char a[32], b[64];
+    snprintf(a, sizeof a, "%d", n);
+    b[0] = 0;
+    if (locked) snprintf(b, sizeof b, " (%d set by the environment stay)", locked);
+    set_msg(m, C_GREEN, 3.5, "Every setting is at its default: %s changed%s", a, b);
+}
+
+/* ---------------------------------------------------------------- another front end (ovl_menu.h) */
+
+void ovl_menu_select_tab(ovl_menu* m, int tab)
+{
+    if (!m->ntab || m->rows_seen != opt_count()) build_tabs(m);
+    if (tab < 0 || tab >= m->ntab) return;
+    m->dd_open = 0;
+    m->tab = tab;
+    build_items(m);
+}
+
+/* The positions of row id (ovl_menu_row_positions): their ini values and labels. */
+static int positions(ovl_menu* m, opt_id id, char (*val)[48], char (*lab)[80], int max, int* cur)
+{
+    int n = 0;
+    *cur = -1;
+    if (max <= 0) return 0;
+    if (id == OVL_ROW_PRESET) {
+        for (int p = 0; p < OPT_NPRESETS && n < max; p++, n++) {
+            snprintf(val[n], 48, "%d", p);
+            snprintf(lab[n], 80, "%s", s_preset_names[p]);
+        }
+        const int c = opt_preset_current();
+        *cur = c >= 0 && c < n ? c : -1;
+        return n;
+    }
+    const opt_def* d = opt_def_of(id);
+    if (!d) return 0;
+    if (widget_of(d) == UI_SLIDER) {
+        slider_t sl;
+        slider_of(d, &sl);
+        const double v = opt_f(id);
+        const int on_word = v < 0 && d->values;
+        if (sl.word_stop) {
+            snprintf(val[n], 48, "%s", sl.word);
+            snprintf(lab[n], 80, "%s", sl.word);
+            if (lab[n][0] >= 'a' && lab[n][0] <= 'z') lab[n][0] = (char)(lab[n][0] - 'a' + 'A');
+            if (on_word) *cur = n;
+            n++;
+        }
+        const long nsteps = sl.hi > sl.lo ? (long)floor((sl.hi - sl.lo) / sl.step + 0.5) : 0;
+        long every = 1;                       /* thinned: room for the last stop and the current value */
+        while (every < nsteps && nsteps / every + 3 + n > max) every++;
+        const int first = n;
+        for (long i = 0; i <= nsteps && n < max; i += every) {
+            const double x = i == nsteps ? sl.hi : sl.lo + (double)i * sl.step;
+            fmt_num(x, val[n], 48);
+            snprintf(lab[n], 80, sl.fmt ? sl.fmt : "%g", x);
+            n++;
+        }
+        if (n > first && n < max && atof(val[n - 1]) < sl.hi - sl.step * 1e-6) {
+            fmt_num(sl.hi, val[n], 48);
+            snprintf(lab[n], 80, sl.fmt ? sl.fmt : "%g", sl.hi);
+            n++;
+        }
+        if (!on_word) {
+            int at = -1;
+            for (int k = first; k < n; k++) if (fabs(atof(val[k]) - v) < sl.step * 1e-6) at = k;
+            if (at < 0 && n < max) {          /* between two stops (a hand-edited file): a stop of its own */
+                at = first;
+                while (at < n && atof(val[at]) < v) at++;
+                memmove(val[at + 1], val[at], (size_t)(n - at) * sizeof val[0]);
+                memmove(lab[at + 1], lab[at], (size_t)(n - at) * sizeof lab[0]);
+                fmt_num(v, val[at], 48);
+                snprintf(lab[at], 80, sl.fmt ? sl.fmt : "%g", v);
+                n++;
+            }
+            *cur = at;
+        }
+    } else {
+        ovl_item tmp;
+        memset(&tmp, 0, sizeof tmp);
+        tmp.kind = OVL_IT_SETTING; tmp.id = id; tmp.ui = widget_of(d);
+        char (*cv)[48] = (char (*)[48])malloc(OVL_MAXCHOICE * 48);
+        char (*cl)[80] = (char (*)[80])malloc(OVL_MAXCHOICE * 80);
+        if (cv && cl) {
+            const int k = choices(m, &tmp, cv, cl, OVL_MAXCHOICE);
+            const int c = current_choice(m, &tmp, cv, k);
+            for (int i = 0; i < k && n < max; i++, n++) {
+                memcpy(val[n], cv[i], 48);
+                memcpy(lab[n], cl[i], 80);
+                if (i == c) *cur = n;
+            }
+        }
+        free(cv); free(cl);
+    }
+    if (*cur < 0 && n < max) {                /* a value none of them shows */
+        opt_text(id, val[n], 48);
+        ovl_menu_value_text(m, id, lab[n], 80);
+        *cur = n++;
+    }
+    return n;
+}
+
+int ovl_menu_row_positions(ovl_menu* m, opt_id id, char (*lab)[80], int max, int* cur)
+{
+    int c = -1, n = 0;
+    char (*val)[48] = max > 0 ? (char (*)[48])malloc((size_t)max * 48) : NULL;
+    if (val) n = positions(m, id, val, lab, max, &c);
+    free(val);
+    if (cur) *cur = c;
+    return n;
+}
+
+int ovl_menu_row_choose(ovl_menu* m, opt_id id, int pos, int max)
+{
+    if (id != OVL_ROW_PRESET && opt_locked(id, NULL)) { locked_msg(m, id); return OPT_SET_REFUSED; }
+    if (max <= 0 || pos < 0 || pos >= max) return OPT_SET_REFUSED;
+    char (*val)[48] = (char (*)[48])malloc((size_t)max * 48);
+    char (*lab)[80] = (char (*)[80])malloc((size_t)max * 80);
+    int r = OPT_SET_REFUSED, cur = -1;
+    if (val && lab && pos < positions(m, id, val, lab, max, &cur)) {
+        if (id == OVL_ROW_PRESET) {
+            const int k = opt_preset_apply(pos);
+            set_msg(m, C_TEXT2, 2.5, "Preset %s%s", s_preset_names[pos], k ? "" : " (nothing to change)");
+            r = k ? OPT_SET_CHANGED : OPT_SET_SAME;
+        } else {
+            r = pos == cur ? OPT_SET_SAME : set_value_r(m, id, val[pos]);
+        }
+    }
+    free(val); free(lab);
+    return r;
+}
+
+/* ---------------------------------------------------------------- the choice list */
+
+static void dd_close(ovl_menu* m) { if (m->dd_open) { m->dd_open = 0; m->dirty = 1; } }
+
+static void dd_open(ovl_menu* m, int item)
+{
+    ovl_item* it = &m->items[item];
+    if (it->kind == OVL_IT_SETTING && opt_locked(it->id, NULL)) { locked_msg(m, it->id); return; }
+    int n = choices(m, it, m->dd_val, m->dd_lab, OVL_MAXCHOICE);
+    if (n <= 0) return;
+    m->dd_open = 1;
+    m->dd_item = item;
+    m->dd_n = n;
+    int c = current_choice(m, it, m->dd_val, n);
+    m->dd_sel = c < 0 ? 0 : c;
+    m->dd_first = 0;
+    m->dirty = 1;
+}
+
+static void dd_apply(ovl_menu* m)
+{
+    if (!m->dd_open) return;
+    ovl_item* it = &m->items[m->dd_item];
+    const int k = m->dd_sel;
+    m->dd_open = 0;
+    m->dirty = 1;
+    if (k < 0 || k >= m->dd_n) return;
+    if (it->kind == OVL_IT_PRESET) {
+        int p = atoi(m->dd_val[k]);
+        int c = opt_preset_apply(p);
+        set_msg(m, C_TEXT2, 2.5, "Preset %s%s", s_preset_names[p], c ? "" : " (nothing to change)");
+        return;
+    }
+    set_value(m, it->id, m->dd_val[k]);
+}
+
+/* ---------------------------------------------------------------- navigation */
+
+static void ensure_visible(ovl_menu* m)
+{
+    int f = m->focus[m->tab];
+    if (f < 0 || f >= m->nitems) return;
+    ovl_item* it = &m->items[f];
+    float* sc = &m->scroll[m->tab];
+    /* it->y0 / y1 are scrolled by the old value; work in content space */
+    float c0 = it->y0 - m->ly0 + *sc, c1 = it->y1 - m->ly0 + *sc;
+    const float view = m->ly1 - m->ly0;
+    if (f > 0 && m->items[f - 1].kind == OVL_IT_GROUP) c0 = m->items[f - 1].y0 - m->ly0 + *sc;   /* show its header */
+    if (c0 < *sc) *sc = c0;
+    if (c1 > *sc + view) *sc = c1 - view;
+    if (*sc < 0) *sc = 0;
+    m->dirty = 1;
+}
+
+static void move_focus(ovl_menu* m, int dir, int wrap)
+{
+    int* f = &m->focus[m->tab];
+    if (!m->nitems) return;
+    int i = *f;
+    for (int k = 0; k < m->nitems; k++) {
+        i += dir;
+        if (i < 0) { if (!wrap) return; i = m->nitems - 1; }
+        if (i >= m->nitems) { if (!wrap) return; i = 0; }
+        if (focusable(&m->items[i])) { *f = i; break; }
+    }
+    ensure_visible(m);
+}
+
+static void switch_tab(ovl_menu* m, int dir)
+{
+    dd_close(m);
+    m->tab = (m->tab + dir + m->ntab) % m->ntab;
+    build_items(m);
+    m->dirty = 1;
+}
+
+/* Quit: a second press within 4 s (the System tab's button, Triangle / Y or Ctrl+Q on any tab). */
+static int quit_press(ovl_menu* m)
+{
+    if (m->confirm_what == OVL_ACTION_QUIT && m->now < m->confirm_until) {
+        m->confirm_until = 0; m->confirm_what = 0;
+        return OVL_ACT_QUIT;
+    }
+    m->confirm_what = OVL_ACTION_QUIT;
+    m->confirm_until = m->now + 4.0;
+    set_msg(m, C_AMBER, 4.0, "Press again to quit the game%s -- progress since your last save is lost%s", "", "");
+    return OVL_ACT_NONE;
+}
+
+static int activate(ovl_menu* m, ovl_item* it, int idx)
+{
+    if (!it || !focusable(it)) return OVL_ACT_NONE;
+    if (it->kind == OVL_IT_ACTION) {
+        if (it->action == OVL_ACTION_RESET_ALL) {
+            if (m->confirm_what == OVL_ACTION_RESET_ALL && m->now < m->confirm_until) {
+                m->confirm_until = 0; m->confirm_what = 0; reset_all(m);
+            } else {
+                m->confirm_what = OVL_ACTION_RESET_ALL;
+                m->confirm_until = m->now + 4.0;
+                set_msg(m, C_AMBER, 4.0, "Press again to reset every setting%s%s", "", "");
+            }
+            return OVL_ACT_NONE;
+        }
+        if (it->action == OVL_ACTION_QUIT) return quit_press(m);
+        if (it->action == OVL_ACTION_OPEN_FOLDER) return OVL_ACT_OPEN_FOLDER;
+        return OVL_ACT_NONE;
+    }
+    if (it->ui == UI_TOGGLE) { change(m, it, 1, 0); return OVL_ACT_NONE; }
+    if (it->ui == UI_SELECT) { dd_open(m, idx); return OVL_ACT_NONE; }
+    return OVL_ACT_NONE;
+}
+
+int ovl_menu_nav(ovl_menu* m, ovl_nav nav, int from_pad)
+{
+    m->input_pad = from_pad;
+    m->dirty = 1;
+    if (m->rows_seen != opt_count()) { build_tabs(m); build_items(m); }
+    if (m->dd_open) {
+        switch (nav) {
+        case OVL_NAV_UP:   if (m->dd_sel > 0) m->dd_sel--; return OVL_ACT_NONE;
+        case OVL_NAV_DOWN: if (m->dd_sel < m->dd_n - 1) m->dd_sel++; return OVL_ACT_NONE;
+        case OVL_NAV_HOME: m->dd_sel = 0; return OVL_ACT_NONE;
+        case OVL_NAV_END:  m->dd_sel = m->dd_n - 1; return OVL_ACT_NONE;
+        case OVL_NAV_PAGE_UP:   m->dd_sel = m->dd_sel > 6 ? m->dd_sel - 6 : 0; return OVL_ACT_NONE;
+        case OVL_NAV_PAGE_DOWN: m->dd_sel = m->dd_sel + 6 < m->dd_n ? m->dd_sel + 6 : m->dd_n - 1; return OVL_ACT_NONE;
+        case OVL_NAV_ACCEPT: dd_apply(m); return OVL_ACT_NONE;
+        case OVL_NAV_CLOSE: dd_close(m); return OVL_ACT_CLOSE;
+        default: dd_close(m); return OVL_ACT_NONE;   /* back, tabs, sideways: cancel */
+        }
+    }
+    ovl_item* it = (m->focus[m->tab] >= 0 && m->focus[m->tab] < m->nitems) ? &m->items[m->focus[m->tab]] : NULL;
+    switch (nav) {
+    case OVL_NAV_UP:   move_focus(m, -1, 1); break;
+    case OVL_NAV_DOWN: move_focus(m, +1, 1); break;
+    case OVL_NAV_HOME: m->focus[m->tab] = -1; move_focus(m, +1, 0); break;
+    case OVL_NAV_END:  m->focus[m->tab] = m->nitems; move_focus(m, -1, 0); break;
+    case OVL_NAV_PAGE_UP:   for (int i = 0; i < 6; i++) move_focus(m, -1, 0); break;
+    case OVL_NAV_PAGE_DOWN: for (int i = 0; i < 6; i++) move_focus(m, +1, 0); break;
+    case OVL_NAV_LEFT:  change(m, it, -1, 0); break;
+    case OVL_NAV_RIGHT: change(m, it, +1, 0); break;
+    case OVL_NAV_LEFT_BIG:  change(m, it, -1, 1); break;
+    case OVL_NAV_RIGHT_BIG: change(m, it, +1, 1); break;
+    case OVL_NAV_ACCEPT: return activate(m, it, m->focus[m->tab]);
+    case OVL_NAV_BACK:  return OVL_ACT_CLOSE;
+    case OVL_NAV_CLOSE: return OVL_ACT_CLOSE;
+    case OVL_NAV_TAB_PREV: switch_tab(m, -1); break;
+    case OVL_NAV_TAB_NEXT: switch_tab(m, +1); break;
+    case OVL_NAV_RESET: reset_item(m, it); break;
+    case OVL_NAV_QUIT:  return quit_press(m);
+    }
+    return OVL_ACT_NONE;
+}
+
+/* ---------------------------------------------------------------- mouse */
+
+static int hit_item(const ovl_menu* m, int x, int y)
+{
+    if (x < m->lx0 || x >= m->lx1 || y < m->ly0 || y >= m->ly1) return -1;
+    for (int i = 0; i < m->nitems; i++) {
+        const ovl_item* it = &m->items[i];
+        if (x >= it->x0 && x < it->x1 && y >= it->y0 && y < it->y1) return i;
+    }
+    return -1;
+}
+
+static int hit_dd(const ovl_menu* m, int x, int y)
+{
+    if (!m->dd_open || x < m->dd_x0 || x >= m->dd_x1 || y < m->dd_y0 || y >= m->dd_y1 || m->dd_ih <= 0) return -2;
+    int k = m->dd_first + (int)((y - m->dd_y0 - S(m, 6)) / m->dd_ih);
+    if (k < m->dd_first) k = m->dd_first;
+    return k < m->dd_n ? k : -1;
+}
+
+int ovl_menu_mouse_move(ovl_menu* m, int x, int y)
+{
+    if (x != m->mx || y != m->my || !m->mouse_in) m->dirty = 1;
+    m->mx = x; m->my = y; m->mouse_in = 1;
+    m->input_pad = 0;
+    if (m->drag_item >= 0 && m->drag_item < m->nitems) {
+        slider_set_at(m, &m->items[m->drag_item], (float)x);
+        return OVL_ACT_NONE;
+    }
+    if (m->dd_open) {
+        int k = hit_dd(m, x, y);
+        if (k >= 0 && k != m->dd_sel) { m->dd_sel = k; m->dirty = 1; }
+        return OVL_ACT_NONE;
+    }
+    int h = hit_item(m, x, y);
+    int badge = 0;
+    if (h >= 0) {
+        const ovl_item* it = &m->items[h];
+        badge = (x >= it->bx0 && x < it->bx1) ? 1 : 0;
+    }
+    if (h != m->hover_item || badge != m->hover_badge) {
+        m->hover_item = h;
+        m->hover_badge = badge;
+        m->hover_since = m->now;
+        m->dirty = 1;
+    }
+    if (h >= 0 && focusable(&m->items[h]) && m->focus[m->tab] != h) { m->focus[m->tab] = h; m->dirty = 1; }
+    return OVL_ACT_NONE;
+}
+
+void ovl_menu_mouse_leave(ovl_menu* m)
+{
+    m->mouse_in = 0;
+    m->hover_item = -1;
+    m->drag_item = -1;
+    m->dirty = 1;
+}
+
+int ovl_menu_mouse_button(ovl_menu* m, int button, int down, int x, int y)
+{
+    m->input_pad = 0;
+    m->dirty = 1;
+    m->mx = x; m->my = y;
+    if (!down) { m->drag_item = -1; return OVL_ACT_NONE; }
+    if (m->dd_open) {
+        int k = hit_dd(m, x, y);
+        if (k >= 0 && button == 0) { m->dd_sel = k; dd_apply(m); }
+        else if (k == -2) dd_close(m);
+        return OVL_ACT_NONE;
+    }
+    /* close button */
+    const float dx = x - m->close_cx, dy = y - m->close_cy;
+    if (dx * dx + dy * dy <= m->close_r * m->close_r) return OVL_ACT_CLOSE;
+    /* outside the panel: close, as a click beside a console's menu does nothing harmful */
+    if (x < m->px || x >= m->px + m->pw || y < m->py || y >= m->py + m->ph) return button == 0 ? OVL_ACT_CLOSE : OVL_ACT_NONE;
+    /* tabs */
+    if (y >= m->tab_y0 && y < m->tab_y1)
+        for (int t = 0; t < m->ntab; t++)
+            if (x >= m->tab_x0[t] && x < m->tab_x1[t]) {
+                if (t != m->tab) { m->tab = t; build_items(m); }
+                return OVL_ACT_NONE;
+            }
+    int h = hit_item(m, x, y);
+    if (h < 0) return OVL_ACT_NONE;
+    ovl_item* it = &m->items[h];
+    if (!focusable(it)) return OVL_ACT_NONE;
+    m->focus[m->tab] = h;
+    if (button == 1) { reset_item(m, it); return OVL_ACT_NONE; }
+    if (it->kind == OVL_IT_ACTION) return activate(m, it, h);
+    if (x < it->cx0 - S(m, 4)) return OVL_ACT_NONE;   /* on the label: focus only */
+    if (it->ui == UI_TOGGLE) { change(m, it, 1, 0); return OVL_ACT_NONE; }
+    if (it->ui == UI_SLIDER) {
+        if (opt_locked(it->id, NULL)) { locked_msg(m, it->id); return OVL_ACT_NONE; }
+        m->drag_item = h;
+        slider_set_at(m, it, (float)x);
+        return OVL_ACT_NONE;
+    }
+    if (it->ui == UI_SELECT) {
+        const float aw = S(m, 30);
+        if (x < it->cx0 + aw) change(m, it, -1, 0);
+        else if (x >= it->cx1 - aw) change(m, it, +1, 0);
+        else dd_open(m, h);
+    }
+    return OVL_ACT_NONE;
+}
+
+int ovl_menu_mouse_wheel(ovl_menu* m, int delta, int x, int y)
+{
+    m->dirty = 1;
+    if (m->dd_open) {
+        int k = delta > 0 ? -1 : 1;
+        m->dd_first += k;
+        if (m->dd_first > m->dd_n - m->dd_vis) m->dd_first = m->dd_n - m->dd_vis;
+        if (m->dd_first < 0) m->dd_first = 0;
+        return OVL_ACT_NONE;
+    }
+    if (x >= m->lx0 && x < m->lx1 && y >= m->ly0 && y < m->ly1) {
+        float* sc = &m->scroll[m->tab];
+        *sc -= (float)delta / 120.0f * S(m, 44) * 2;
+        const float maxs = m->content_h - (m->ly1 - m->ly0);
+        if (*sc > maxs) *sc = maxs;
+        if (*sc < 0) *sc = 0;
+    }
+    return OVL_ACT_NONE;
+}
+
+/* ---------------------------------------------------------------- drawing helpers */
+
+static float key_cap(ovl_menu* m, ovl_list* L, float x, float cy, const char* k)
+{
+    float w = ovl_text_w(L, OVL_F_SMALL, k) + S(m, 14), h = S(m, 22);
+    ovl_rect(L, x, cy - h / 2, x + w, cy + h / 2, ovl_col(C_KEYCAP, 1), S(m, 5));
+    ovl_frame(L, x, cy - h / 2, x + w, cy + h / 2, ovl_col(C_KEYEDGE, 1), S(m, 5), S(m, 1));
+    ovl_text(L, OVL_F_SMALL, x + S(m, 7), base_c(L, OVL_F_SMALL, cy), k, ovl_col(C_TEXT, 1));
+    return w;
+}
+
+/* A face button: 0 cross/A (bottom), 1 circle/B (right), 2 square/X (left), 3 triangle/Y (top). */
+static float pad_button(ovl_menu* m, ovl_list* L, float x, float cy, int which)
+{
+    const float r = S(m, 11);
+    const float cx = x + r;
+    const int kind = m->env.pad_kind;
+    ovl_circle(L, cx, cy, r, ovl_col(C_KEYCAP, 1), 0);
+    if (kind == PADHOST_KIND_XINPUT || kind == PADHOST_KIND_SWITCH_PRO || kind == PADHOST_KIND_GENERIC) {
+        static const char* xb[4] = { "A", "B", "X", "Y" };
+        static const char* sw[4] = { "B", "A", "Y", "X" };          /* Switch, by position */
+        static const unsigned xc[4] = { 0x6CC24A, 0xE5534B, 0x3B8EEA, 0xF2C53D };
+        const char* t = kind == PADHOST_KIND_SWITCH_PRO ? sw[which] : xb[which];
+        ovl_circle(L, cx, cy, r, ovl_col(kind == PADHOST_KIND_XINPUT ? xc[which] : C_KEYEDGE, 1), S(m, 1.4f));
+        ovl_text(L, OVL_F_TINY, cx - ovl_text_w(L, OVL_F_TINY, t) / 2, base_c(L, OVL_F_TINY, cy), t, ovl_col(C_TEXT, 1));
+        return 2 * r;
+    }
+    static const unsigned pc[4] = { 0x8FB6F0, 0xF0868C, 0xE59BD6, 0x6FD6B9 };   /* PlayStation symbol colours */
+    ovl_circle(L, cx, cy, r, ovl_col(C_KEYEDGE, 1), S(m, 1.2f));
+    const ovl_rgba ic = ovl_col(pc[which], 1);
+    const float k = S(m, 5), lw = S(m, 1.6f);
+    if (which == 0) {         /* a cross from two thin rotated... drawn as an x glyph */
+        const char* t = "\xC3\x97";
+        ovl_text(L, OVL_F_BODY, cx - ovl_text_w(L, OVL_F_BODY, t) / 2, base_c(L, OVL_F_BODY, cy), t, ic);
+    } else if (which == 1) ovl_circle(L, cx, cy, k, ic, lw);
+    else if (which == 2) ovl_frame(L, cx - k, cy - k, cx + k, cy + k, ic, S(m, 1), lw);
+    else ovl_tri(L, cx, cy + S(m, 1), k + S(m, 1), 0, ic, lw);
+    return 2 * r;
+}
+
+static float shoulder(ovl_menu* m, ovl_list* L, float x, float cy, const char* t)
+{
+    float w = ovl_text_w(L, OVL_F_TINY, t) + S(m, 14), h = S(m, 22);
+    ovl_rect(L, x, cy - h / 2, x + w, cy + h / 2, ovl_col(C_KEYCAP, 1), S(m, 6));
+    ovl_text(L, OVL_F_TINY, x + S(m, 7), base_c(L, OVL_F_TINY, cy), t, ovl_col(C_TEXT, 1));
+    return w;
+}
+
+static float badge_w(ovl_menu* m, const ovl_list* L, const char* t) { return ovl_text_w(L, OVL_F_TINY, t) + S(m, 12); }
+
+static float badge(ovl_menu* m, ovl_list* L, float x, float cy, const char* t, unsigned col, int filled)
+{
+    float w = badge_w(m, L, t), h = S(m, 18);
+    ovl_rect(L, x, cy - h / 2, x + w, cy + h / 2, ovl_col(col, filled ? 0.85f : 0.14f), S(m, 4));
+    ovl_frame(L, x, cy - h / 2, x + w, cy + h / 2, ovl_col(col, 0.6f), S(m, 4), S(m, 1));
+    ovl_text(L, OVL_F_TINY, x + S(m, 6), base_c(L, OVL_F_TINY, cy), t, filled ? ovl_col(0x15171C, 1) : ovl_col(col, 1));
+    return w;
+}
+
+/* Greedy word wrap into at most maxl lines of at most maxw pixels. */
+static int wrap(const ovl_list* L, int face, const char* s, float maxw, char (*lines)[200], int maxl)
+{
+    int n = 0;
+    const char* p = s;
+    while (p && *p && n < maxl) {
+        while (*p == ' ') p++;
+        if (!*p) break;
+        int best = 0, len = 0;
+        char buf[200];
+        while (p[len] && len < 198) {
+            int e = len;
+            while (p[e] && p[e] != ' ' && e < 198) e++;
+            memcpy(buf, p, (size_t)e);
+            buf[e] = 0;
+            if (ovl_text_w(L, face, buf) > maxw && best > 0) break;
+            best = e;
+            if (!p[e] || ovl_text_w(L, face, buf) > maxw) break;
+            len = e + 1;
+        }
+        if (best <= 0) best = (int)strlen(p) < 198 ? (int)strlen(p) : 198;
+        memcpy(lines[n], p, (size_t)best);
+        lines[n][best] = 0;
+        n++;
+        p += best;
+    }
+    return n;
+}
+
+static void tooltip(ovl_menu* m, ovl_list* L, float mx, float my, const char* text)
+{
+    char lines[8][200];
+    const float maxw = S(m, 440);
+    int n = wrap(L, OVL_F_SMALL, text, maxw, lines, 8);
+    if (!n) return;
+    float w = 0;
+    for (int i = 0; i < n; i++) { float lw = ovl_text_w(L, OVL_F_SMALL, lines[i]); if (lw > w) w = lw; }
+    const float lh = S(m, 21), pad = S(m, 12);
+    float bw = w + 2 * pad, bh = n * lh + 2 * pad - S(m, 4);
+    float x0 = mx + S(m, 16), y0 = my + S(m, 20);
+    if (x0 + bw > L->W - S(m, 8)) x0 = L->W - S(m, 8) - bw;
+    if (y0 + bh > L->H - S(m, 8)) y0 = my - S(m, 12) - bh;
+    if (x0 < S(m, 8)) x0 = S(m, 8);
+    if (y0 < S(m, 8)) y0 = S(m, 8);
+    ovl_shadow(L, x0, y0 + S(m, 4), x0 + bw, y0 + bh + S(m, 4), ovl_col(0, 0.5f), S(m, 8), S(m, 10));
+    ovl_rect(L, x0, y0, x0 + bw, y0 + bh, ovl_col(0x232731, 0.98f), S(m, 8));
+    ovl_frame(L, x0, y0, x0 + bw, y0 + bh, ovl_col(0xFFFFFF, 0.10f), S(m, 8), S(m, 1));
+    for (int i = 0; i < n; i++)
+        ovl_text(L, OVL_F_SMALL, x0 + pad, y0 + pad + S(m, 13) + i * lh, lines[i], ovl_col(i ? C_TEXT2 : C_TEXT, 1));
+}
