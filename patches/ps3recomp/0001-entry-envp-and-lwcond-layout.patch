+# ---------------------------------------------------------------------------
+# --cont-list: save-state continuations (M3)
+# ---------------------------------------------------------------------------
+# A thread parked at an HLE call or a syscall is resumed -- in a new host
+# thread, even in a new process -- by re-issuing the parked call and then doing
+# what the hardware's `blr` does: continue the guest function that LR names, at
+# that return address, until the thread's root. Lifted functions return to
+# their HOST caller, which no longer exists after a restore, so the rest of each
+# function that can sit on a parked chain is emitted a second time as a
+# CONTINUATION entered at the return address; runtime/ppu/ppu_resume.cpp keys
+# them by return address and runs them. A continuation is cloned from the body
+# as translated, before the _cs_ rewrite: its epilogue reloads r14-r31 and LR
+# from the guest frame exactly as the guest does (M1's --slotcheck measured
+# those slots trustworthy in inFamous 2), because the host copies the normal
+# body restores from died with the host frames. The normal lifted functions are
+# not touched; with no list nothing is emitted at all.
+#
+# The list (--cont-list FILE / PPU_LIFT_CONT_LIST): tokens separated by
+# whitespace or commas, `#` to end of line is a comment --
+#   0x0047851C, 0047851C, ra:0x0047851C   a return address
+#   func_0047840C+0xF8                    a return address (the [GSTACK] chain
+#                                         form, so chain lines paste as-is)
+#   func_0047840C, fn:0x0047840C          every return site in that lifted
+#                                         function
+# A symbol prefix before func_ (libsre_func_...) is accepted; each lift keeps
+# the addresses inside its own image and reports the rest. Other tokens (the
+# tag=/lr= fields of a pasted log line) are skipped and counted.
+_CONT_TOKEN_RE = re.compile(
+    r"(?:[A-Za-z0-9]+_)?func_(?P<f>[0-9A-Fa-f]{8})(?:\+(?P<off>0x[0-9A-Fa-f]+|\d+))?"
+    r"|fn:(?P<fn>(?:0x)?[0-9A-Fa-f]{1,8})"
+    r"|(?:ra:)?(?P<ra>0x[0-9A-Fa-f]{1,8}|[0-9A-Fa-f]{8})")
+
+
+def parse_cont_list(text: str):
+    """--cont-list text -> (return addresses, function starts, skipped tokens)."""
+    ras: set[int] = set()
+    funcs: set[int] = set()
+    skipped: list[str] = []
+    for line in text.splitlines():
+        for tok in re.split(r"[\s,;]+", line.split("#", 1)[0]):
+            if not tok:
+                continue
+            m = _CONT_TOKEN_RE.fullmatch(tok)
+            if not m:
+                skipped.append(tok)
+                continue
+            if m.group("f"):
+                v = int(m.group("f"), 16)
+                if m.group("off") is None:
+                    funcs.add(v)
+                    continue
+                v += int(m.group("off"), 0)
+            elif m.group("fn"):
+                funcs.add(int(m.group("fn"), 16))
+                continue
+            else:
+                v = int(m.group("ra"), 16)
+            if v & 3 or v < 4:
+                skipped.append(tok)        # a return address is word aligned
+                continue
+            ras.add(v)
+    return ras, funcs, skipped
+
