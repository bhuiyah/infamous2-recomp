+static void dcfg_load(void)
+{
+    char src[MAX_PATH + 64];
+    int errs = 0;
+    snprintf(src, sizeof src, "built-in defaults");
+    const char* pc = getenv("DISPLAY_CONFIG");
+    if (pc && *pc) {
+        if (strcmp(pc, "none") && strcmp(pc, "0")) {
+            if (dcfg_read_file(pc, &errs)) snprintf(src, sizeof src, "%s", pc);
+            else printf("[display] DISPLAY_CONFIG=%s: cannot open it, using the defaults\n", pc);
+        }
+    } else {
+        char exe_ini[MAX_PATH];
+        DWORD n = GetModuleFileNameA(NULL, exe_ini, MAX_PATH);
+        char* slash = (n && n < MAX_PATH) ? strrchr(exe_ini, '\\') : NULL;
+        if (slash) snprintf(slash + 1, (size_t)(MAX_PATH - (slash + 1 - exe_ini)), "display.ini");
+        else       exe_ini[0] = 0;
+        const char* cand[3] = { "display.ini", "config\\display.ini", exe_ini };
+        for (int i = 0; i < 3; i++) {
+            if (!cand[i][0] || !dcfg_read_file(cand[i], &errs)) continue;
+            if (!GetFullPathNameA(cand[i], (DWORD)sizeof src, src, NULL))
+                snprintf(src, sizeof src, "%s", cand[i]);
+            break;
+        }
+    }
+    {   /* config\options.ini's [display] section (include/ps3emu/options.h):
+         * over the file, under DISPLAY_CFG and RSX_*; "" without one. */
+        const char* lt = opt_layer_text("display");
+        if (lt && *lt) {
+            errs += dcfg_parse_text(&s_dcfg, lt, 0, dcfg_warn, "options.ini");
+            size_t used = strlen(src);
+            snprintf(src + used, sizeof src - used, " + options.ini");
+        }
+    }
+    const char* ov = getenv("DISPLAY_CFG");
+    if (ov && *ov) {
+        errs += dcfg_parse_text(&s_dcfg, ov, 1, dcfg_warn, "DISPLAY_CFG");
+        size_t used = strlen(src);
+        snprintf(src + used, sizeof src - used, " + DISPLAY_CFG");
+    }
+    static const char* const alias[][2] = {
+        { "RSX_FULLSCREEN", "fullscreen" }, { "RSX_WINDOW", "window" }, { "RSX_MONITOR", "monitor" },
+        { "RSX_MENU", "menu_bar" } };
+    for (int i = 0; i < 4; i++) {
+        const char* e = getenv(alias[i][0]);
+        if (e && *e) dcfg_set(&s_dcfg, alias[i][1], e);
+    }
+    printf("[display] settings from %s%s:", src, errs ? " (bad lines skipped, see above)" : "");
+    for (int i = 0; i < s_dcfg.n; i++) printf(" %s=%s", s_dcfg.key[i], s_dcfg.val[i]);
+    printf("%s\n", s_dcfg.n ? "" : " (none)");
+    disp_dpi_aware();
+    int idx = 0;
+    EnumDisplayMonitors(NULL, NULL, disp_list_mon, (LPARAM)&idx);
+    fflush(stdout);
+}
+
+/* Load once, from whichever thread asks first (the title's install hook on
+ * the main thread, or the window thread). */
+static void dcfg_ensure(void)
+{
+    if (InterlockedCompareExchange(&s_dcfg_ready, 2, 2) == 2) return;
+    if (InterlockedCompareExchange(&s_dcfg_ready, 1, 0) == 0) {
+        dcfg_load();
+        InterlockedExchange(&s_dcfg_ready, 2);
+        return;
+    }
+    while (InterlockedCompareExchange(&s_dcfg_ready, 2, 2) != 2) Sleep(1);
+}
+
+typedef struct { int want, idx; HMONITOR found; } DispMonPick;
+static BOOL CALLBACK disp_pick_mon(HMONITOR m, HDC dc, LPRECT r, LPARAM lp)
+{
+    (void)dc; (void)r;
+    DispMonPick* p = (DispMonPick*)lp;
+    if (++p->idx == p->want) { p->found = m; return FALSE; }
+    return TRUE;
+}
+
+/* display.ini monitor = primary (default) | cursor | <n> (1-based, the
+ * order of the "[display] monitor n" lines). */
+static HMONITOR disp_target_monitor(void)
+{
+    static int warned = 0;
+    const char* v = dcfg_get(&s_dcfg, "monitor");
+    char n[24];
+    dcfg_norm(v ? v : "", n, sizeof n);
+    if (!strcmp(n, "cursor") || !strcmp(n, "mouse")) {
+        POINT pt;
+        if (GetCursorPos(&pt)) return MonitorFromPoint(pt, MONITOR_DEFAULTTOPRIMARY);
+    } else if (n[0] >= '1' && n[0] <= '9') {
+        DispMonPick p = { atoi(n), 0, NULL };
+        EnumDisplayMonitors(NULL, NULL, disp_pick_mon, (LPARAM)&p);
+        if (p.found) return p.found;
+        if (!warned++) printf("[display] monitor = %s: no such monitor, using the primary\n", v);
+    } else if (n[0] && strcmp(n, "primary") && strcmp(n, "auto")) {
+        if (!warned++) printf("[display] monitor = %s: expected primary, cursor or a number\n", v);
+    }
+    POINT z = { 0, 0 };
+    return MonitorFromPoint(z, MONITOR_DEFAULTTOPRIMARY);
+}
+
+static UINT disp_monitor_dpi(HMONITOR m)
+{
+    typedef HRESULT (WINAPI *gdm_fn)(HMONITOR, int, UINT*, UINT*);
+    static gdm_fn f = (gdm_fn)(intptr_t)-1;
+    if (f == (gdm_fn)(intptr_t)-1) {
+        HMODULE sh = LoadLibraryA("shcore.dll");
+        f = sh ? (gdm_fn)(void*)GetProcAddress(sh, "GetDpiForMonitor") : NULL;
+    }
+    UINT dx = 96, dy = 96;
+    if (f && m && SUCCEEDED(f(m, 0 /* MDT_EFFECTIVE_DPI */, &dx, &dy)) && dx >= 48 && dx <= 960)
+        return dx;
+    return 96;
+}
+
+/* Frame size for a client rectangle at a DPI (AdjustWindowRectExForDpi when
+ * the system has it). menu: the window has a menu bar (one line of it), which
+ * the frame then includes, so the client area -- the picture -- keeps its
+ * size. The ForDpi call also at 96: in a per-monitor-aware process plain
+ * AdjustWindowRect measures at the SYSTEM DPI, which is not 96 when the
+ * primary monitor was scaled at sign-in -- the frame and the bar would then
+ * be sized for that scale on a 100% monitor. */
+static void disp_adjust_rect(RECT* r, DWORD style, BOOL menu, UINT dpi)
+{
+    typedef BOOL (WINAPI *adj_fn)(LPRECT, DWORD, BOOL, DWORD, UINT);
+    static adj_fn f = (adj_fn)(intptr_t)-1;
+    if (f == (adj_fn)(intptr_t)-1) {
+        HMODULE u = GetModuleHandleA("user32.dll");
+        f = u ? (adj_fn)(void*)GetProcAddress(u, "AdjustWindowRectExForDpi") : NULL;
+    }
+    if (f && f(r, style, menu, 0, dpi)) return;
+    AdjustWindowRect(r, style, menu);
+}
+
+static double disp_content_aspect(void)
+{
+    LONG v = s_content_aspect_u;
+    if (v > 0) return (double)v / 1e6;
+    return (s_d3d.width && s_d3d.height) ? (double)s_d3d.width / (double)s_d3d.height : 16.0 / 9.0;
+}
+
+/* Put the view on the largest content-aspect rectangle of the client area. */
+static void disp_layout(HWND top)
+{
+    if (!s_view_hwnd || !top) return;
+    RECT rc;
+    if (!GetClientRect(top, &rc) || rc.right <= 0 || rc.bottom <= 0) return;   /* minimised */
+    int x, y, w, h;
+    dcfg_fit_rect(rc.right, rc.bottom, disp_content_aspect(), &x, &y, &w, &h);
+    if (x == s_view_rc.left && y == s_view_rc.top &&
+        w == s_view_rc.right - s_view_rc.left && h == s_view_rc.bottom - s_view_rc.top)
+        return;
+    SetWindowPos(s_view_hwnd, NULL, x, y, w, h, SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER);
+    SetRect(&s_view_rc, x, y, x + w, y + h);
+    InvalidateRect(top, NULL, TRUE);   /* repaint the bars */
+    static int said = 0;
+    if (said++ < 40)
+        printf("[display] client %ldx%ld: image %dx%d at (%d,%d)\n", rc.right, rc.bottom, w, h, x, y);
+}
+
+static void disp_cover_monitor(HWND h)
+{
+    MONITORINFO mi;
+    mi.cbSize = sizeof mi;
+    if (!GetMonitorInfoA(MonitorFromWindow(h, MONITOR_DEFAULTTONEAREST), &mi)) return;
+    SetWindowPos(h, HWND_TOP, mi.rcMonitor.left, mi.rcMonitor.top,
+                 mi.rcMonitor.right - mi.rcMonitor.left, mi.rcMonitor.bottom - mi.rcMonitor.top,
+                 SWP_NOOWNERZORDER | SWP_FRAMECHANGED | SWP_SHOWWINDOW);
+}
+
+/* Borderless fullscreen on the monitor the window is on (no mode change:
+ * the desktop resolution stays, the swap chain stays the guest size).
+ * Entered from a maximised window, the fullscreen window is not left
+ * flagged WS_MAXIMIZE: the system re-fits maximised windows to the work
+ * area when it changes (taskbar moved, resized, auto-hide), which would
+ * uncover the taskbar. SetWindowPlacement re-maximises on the way back. */
+static void disp_set_fullscreen(HWND h, int on)
+{
+    if (!h || on == s_fullscreen) return;
+    if (on) {
+        s_saved_wp.length = sizeof s_saved_wp;
+        if (!GetWindowPlacement(h, &s_saved_wp)) s_saved_wp.length = 0;
+        s_saved_style = GetWindowLongA(h, GWL_STYLE);
+        SetWindowLongA(h, GWL_STYLE, (s_saved_style & ~(LONG)(WS_OVERLAPPEDWINDOW | WS_MAXIMIZE | WS_MINIMIZE)) |
+                                     (LONG)WS_POPUP);
+        s_fullscreen = 1;
+        rsx_winmenu_set_fullscreen(h, 1);   /* no menu bar over the picture */
+        disp_cover_monitor(h);
+    } else {
+        s_fullscreen = 0;
+        SetWindowLongA(h, GWL_STYLE, s_saved_style & ~(LONG)(WS_MAXIMIZE | WS_MINIMIZE));
+        /* The bar back before the placement: the saved window rectangle
+         * included it, so the client area is the old one again. */
+        rsx_winmenu_set_fullscreen(h, 0);
+        if (s_saved_wp.length) SetWindowPlacement(h, &s_saved_wp);
+        SetWindowPos(h, NULL, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER |
+                     SWP_NOOWNERZORDER | SWP_FRAMECHANGED);
+    }
+    disp_layout(h);
+    /* The settings store's fullscreen row follows every toggle (F11, Alt+Enter,
+     * the window menu), saved like a menu change; when the row itself asked
+     * for this one (its watcher below), the value is already the same. */
+    {
+        const opt_id id = opt_find("fullscreen");
+        if (id >= 0 && !opt_locked(id, NULL)) opt_set(id, on ? "1" : "0");
+    }
+    printf("[display] %s (F11 or Alt+Enter toggles)\n", on ? "borderless fullscreen" : "windowed");
+    fflush(stdout);
+}
+
+/* What the window menu (rsx_winmenu.c) asks of the display code. */
+static void disp_menu_toggle_fullscreen(void* h) { disp_set_fullscreen((HWND)h, !s_fullscreen); }
+static int  disp_menu_is_fullscreen(void) { return s_fullscreen; }
+static void disp_menu_picture_rect(void* h, int* x, int* y, int* w, int* hh)
+{
+    RECT rc = s_view_rc;
+    if (!s_view_hwnd && !GetClientRect((HWND)h, &rc)) SetRect(&rc, 0, 0, 0, 0);
+    *x = rc.left; *y = rc.top; *w = rc.right - rc.left; *hh = rc.bottom - rc.top;
+}
+
+/* Size/move and menu loops are modal loops inside DispatchMessage on this
+ * thread -- the frame clock thread, which drains the RSX FIFO -- so the game
+ * would stop while a window border is dragged. A timer keeps the clock's
+ * work running inside the loop (main.cpp registers it); without one the old
+ * behaviour stays (the game pauses until the mouse is released). */
+static void disp_modal_enter(HWND h)
+{
+    if (s_modal_tick && s_modal_depth++ == 0) SetTimer(h, DISP_MODAL_TIMER_ID, USER_TIMER_MINIMUM, NULL);
+}
+
+static void disp_modal_exit(HWND h)
+{
+    if (s_modal_depth > 0 && --s_modal_depth == 0) KillTimer(h, DISP_MODAL_TIMER_ID);
+}
