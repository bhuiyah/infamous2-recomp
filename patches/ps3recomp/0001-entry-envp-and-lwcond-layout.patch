+
+    /* the retry backoff: 5 quick ones, then a game controller another program
+     * holds every 30 s; repeats do not reprint the list */
+    {
+        const char* kp = "\\\\?\\hid#padhost-test-noaccess";
+        for (int i = 1; i <= 7; i++) {
+            InterlockedExchange(&s_list_dirty, 0);
+            ULONGLONG now = GetTickCount64();
+            ph_known_note(kp, KN_NOACCESS, "in use (exclusive)", PADHOST_BUS_USB, 0x054C, 0x09CC, 1, 5, "DS4",
+                          ERROR_SHARING_VIOLATION);
+            int found;
+            PhKnown k = ph_known_copy(kp, &found);
+            CHECK(found && k.tries == i, "try %d: %d", i, k.tries);
+            if (i <= 5) CHECK(k.retry_at > now && k.retry_at <= now + 10050, "try %d: quick retry", i);
+            else        CHECK(k.retry_at >= now + 29000 && k.retry_at <= now + 30050, "try %d: every 30 s (%llu)",
+                              i, k.retry_at - now);
+            CHECK(s_list_dirty == (i == 1), "try %d: list reprinted only the first time (%ld)", i, s_list_dirty);
+        }
+        const char* np = "\\\\?\\hid#padhost-test-notready";
+        for (int i = 1; i <= 6; i++)
+            ph_known_note(np, KN_NOACCESS, "not ready", PADHOST_BUS_OTHER, 0, 0, 0, 0, NULL, 5);
