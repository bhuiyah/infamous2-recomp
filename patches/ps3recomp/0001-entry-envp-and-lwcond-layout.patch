+#!/usr/bin/env python3
+"""Reference interpreter for RSX fragment-program microcode, and a
+differential driver against libs/video/tests/test_fp_warp.exe (the decompiled
+HLSL executed on D3D11 WARP).
+
+Semantics follow RPCS3 (rpcs3/Emu/RSX/Program/FragmentProgramDecompiler.cpp,
+RSXFragmentTextureOps.glsl), written independently of rsx_fp_decompiler.c.
+Numeric model = the HLSL's: fp32 for both register files, no fp16 rounding,
+`prec` clamps ignored; RSX's single register file is modelled only where the
+HLSL models it (an H export whose lane was last written through R exports
+that fp32's halves). Packed words (PKB/PKG/...) are carried as raw bits.
+
+  py tools/rsx_fp_ref.py run <ucode.bin> <inputs.txt> [-exp32] [-trace]
+  py tools/rsx_fp_ref.py diff <test_fp_warp.exe> <dir-of-.fp> <seeds> <name.fp>... | @listfile
+
+inputs.txt:  in <COL0|COL1|FOGC|TC0..TC9|WPOS> x y z w
+             tex <unit> r g b a      (1x1 texture: every sample of the unit)
+             bx2 <hex>               (fp_alpha.w: per unit 0-7 the TEX_bx2 RGBA nibble)
+             face <1|-1>
+Prints t0..t3 = H0,H4,H6,H8 (R0,R2,R3,R4 with -exp32). A killed pixel prints
+-7 everywhere (test_fp_warp's clear value); NaN prints 0 (the backend guard).
+Implemented ops: everything inFamous 2's 322 programs use except branches, plus
+the pack/unpack ops it does not use (PK4/UP4, PK2/UP2, PK16/UP16)."""
+import math, os, random, struct, subprocess, sys, tempfile, zlib
+
+def rw(buf, off):
+    be = struct.unpack_from('>I', buf, off)[0]
+    return ((be << 16) | (be >> 16)) & 0xFFFFFFFF
+
+def bits(x):
+    return struct.unpack('<I', struct.pack('<f', x))[0]
+
+def frombits(u):
+    return struct.unpack('<f', struct.pack('<I', u & 0xFFFFFFFF))[0]
+
+class Bits(int):
+    """A packed word in an fp32 register: raw bits, never re-rounded."""
+
+def fl(c):
+    return frombits(int(c)) if isinstance(c, Bits) else c
+
+def f32(x):
+    if isinstance(x, Bits):
+        return x
+    try:
+        return struct.unpack('<f', struct.pack('<f', x))[0]
+    except OverflowError:
+        return math.copysign(math.inf, x)
+
+INPUT_NAMES = ['WPOS', 'COL0', 'COL1', 'FOGC', 'TC0', 'TC1', 'TC2', 'TC3', 'TC4', 'TC5',
+               'TC6', 'TC7', 'TC8', 'TC9', 'SSA']
+
+def sat(x):
+    return 0.0 if x != x else min(max(x, 0.0), 1.0)
+
+def pack_unorm8(v):            # packUnorm4x8, x in the low byte
+    b = [int(math.floor(sat(c) * 255.0 + 0.5)) for c in v]
+    return Bits(b[0] | (b[1] << 8) | (b[2] << 16) | (b[3] << 24))
+
+def unpack_unorm8(f):          # unpackUnorm4x8
+    u = int(f) if isinstance(f, Bits) else bits(f)
+    return [((u >> s) & 0xFF) / 255.0 for s in (0, 8, 16, 24)]
+
+def pack_snorm8(v):            # packSnorm4x8
+    b = [int(math.floor(min(max(c, -1.0), 1.0) * 127.0 + 0.5)) & 0xFF if c == c else 0 for c in v]
+    return Bits(b[0] | (b[1] << 8) | (b[2] << 16) | (b[3] << 24))
+
+def unpack_snorm8(f):          # unpackSnorm4x8
+    u = int(f) if isinstance(f, Bits) else bits(f)
+    return [max((((u >> s) & 0xFF) ^ 0x80) - 0x80, -127) / 127.0 for s in (0, 8, 16, 24)]
+
+def half_bits(x):              # packHalf2x16's per-lane conversion (nearest even)
+    try:
+        return struct.unpack('<H', struct.pack('<e', x))[0]
+    except OverflowError:
+        return 0x7C00 | (0x8000 if x < 0 else 0)
+
+def pack_half2(v):             # packHalf2x16(v.xy)
+    return Bits(half_bits(v[0]) | (half_bits(v[1]) << 16))
+
+def unpack_half2(f):           # unpackHalf2x16(...).xyxy
+    u = int(f) if isinstance(f, Bits) else bits(f)
+    lo = struct.unpack('<e', struct.pack('<H', u & 0xFFFF))[0]
+    hi = struct.unpack('<e', struct.pack('<H', u >> 16))[0]
+    return [lo, hi, lo, hi]
+
+def pack_unorm16(v):           # packUnorm2x16(v.xy)
+    b = [int(math.floor(sat(c) * 65535.0 + 0.5)) for c in v[:2]]
+    return Bits(b[0] | (b[1] << 16))
+
+def unpack_unorm16(f):         # unpackUnorm2x16(...).xyxy
+    u = int(f) if isinstance(f, Bits) else bits(f)
+    lo, hi = (u & 0xFFFF) / 65535.0, (u >> 16) / 65535.0
+    return [lo, hi, lo, hi]
+
+PACK_OPS = (0x13, 0x24, 0x27, 0x29, 0x2C)
+
+def lin_to_srgb(c):            # RPCS3 linear_to_srgb (clamped)
+    if c != c:
+        return 0.0
+    return sat(c * 12.92 if c < 0.0031308 else 1.055 * (abs(c) ** (1 / 2.4)) - 0.055)
+
+def srgb_to_lin(c):            # RPCS3 srgb_to_linear
+    return ((c + 0.055) / 1.055) ** 2.4 if c > 0.04045 else c / 12.92
+
+def run(buf, inputs, texv, bx2w, face=1.0, exp32=False, trace=False):
+    R = [[0.0] * 4 for _ in range(64)]
+    H = [[0.0] * 4 for _ in range(64)]
+    cc = [[0.0] * 4, [0.0] * 4]
+    lastw = {}                 # (R index, lane) -> 'R'|'H': last writer of that 32-bit lane
+    off = n = 0
+    while off + 16 <= len(buf):
+        w0, w1, w2, w3 = (rw(buf, off + 4 * i) for i in range(4))
+        off += 16
+        if (w2 >> 31) & 1:
+            raise SystemExit('branch instructions not modelled')
+        op = (w0 >> 24) & 0x3F
+        k = None
+        if any((w & 3) == 2 for w in (w1, w2, w3)):
+            k = [frombits(rw(buf, off + 4 * i)) for i in range(4)]
+            off += 16
+        insrc = (w0 >> 13) & 15
+        lt, eq, gt = (w1 >> 18) & 1, (w1 >> 19) & 1, (w1 >> 20) & 1
+
+        def cond():
+            if lt and eq and gt:
+                return [1] * 4
+            creg = cc[(w1 >> 31) & 1]
+            cs = [fl(creg[(w1 >> (21 + 2 * i)) & 3]) for i in range(4)]
+            return [int((lt and v < 0) or (eq and v == 0) or (gt and v > 0)) for v in cs]
+
+        def src(w, idx, raw=False):
+            t = w & 3
+            if t == 0:
+                v = (H if (w >> 8) & 1 else R)[(w >> 2) & 63]
+            elif t == 1:
+                v = [face] * 4 if insrc == 14 else inputs.get(
+                    INPUT_NAMES[insrc] if insrc < len(INPUT_NAMES) else '?', [0.0] * 4)
+            elif t == 2:
+                v = k
+            else:
+                raise SystemExit('register type 3')
+            v = [v[(w >> (9 + 2 * i)) & 3] for i in range(4)]
+            ab = (w1 >> 29) & 1 if idx == 0 else (w >> 18) & 1   # SRC0 abs in word 1; SRC1/2 bit 18
+            neg = (w >> 17) & 1
+            if not raw or ab or neg:
+                v = [fl(c) for c in v]
+            if ab:
+                v = [abs(c) for c in v]
+            if neg:
+                v = [-c for c in v]
+            return v
+
+        a = lambda: src(w1, 0)
+        b = lambda: src(w2, 1)
+        c = lambda: src(w3, 2)
+        unit = (w0 >> 17) & 15
+
+        def sample():          # fp_texctl = 0 here: only TEX_bx2 processes the texel
+            t = list(texv.get(unit, [0.0] * 4))
+            m = ((bx2w >> (unit * 4)) & 0xF) if ((w0 >> 21) & 1) and unit < 8 else 0
+            return [2 * t[i] - 1 if (m >> i) & 1 else t[i] for i in range(4)]
+
+        r = None
+        if op == 0x01: r = src(w1, 0, raw=True)
+        elif op == 0x02: x, y = a(), b(); r = [x[i] * y[i] for i in range(4)]
+        elif op == 0x03: x, y = a(), b(); r = [x[i] + y[i] for i in range(4)]
+        elif op == 0x04: x, y, z = a(), b(), c(); r = [x[i] * y[i] + z[i] for i in range(4)]
+        elif op == 0x05: x, y = a(), b(); r = [sum(x[i] * y[i] for i in range(3))] * 4
+        elif op == 0x06: x, y = a(), b(); r = [sum(x[i] * y[i] for i in range(4))] * 4
+        elif op == 0x08: x, y = a(), b(); r = [min(x[i], y[i]) for i in range(4)]
+        elif op == 0x09: x, y = a(), b(); r = [max(x[i], y[i]) for i in range(4)]
+        elif op == 0x0A: x, y = a(), b(); r = [float(x[i] < y[i]) for i in range(4)]
+        elif op == 0x0B: x, y = a(), b(); r = [float(x[i] >= y[i]) for i in range(4)]
+        elif op == 0x0C: x, y = a(), b(); r = [float(x[i] <= y[i]) for i in range(4)]
+        elif op == 0x0D: x, y = a(), b(); r = [float(x[i] > y[i]) for i in range(4)]
+        elif op == 0x0E: x, y = a(), b(); r = [float(x[i] != y[i]) for i in range(4)]
+        elif op == 0x0F: x, y = a(), b(); r = [float(x[i] == y[i]) for i in range(4)]
+        elif op == 0x10: r = [v - math.floor(v) for v in a()]
+        elif op == 0x11: r = [float(math.floor(v)) for v in a()]
+        elif op == 0x12:       # KIL under the exec condition, any lane
+            if any(cond()) and (lt or eq or gt):
+                return [[-7.0] * 4 for _ in range(4)]
+        elif op in (0x15, 0x16): r = [0.0] * 4          # DDX/DDY: constant inputs
+        elif op in (0x17, 0x18, 0x2F, 0x31): r = sample()  # TEX TXP TXL TXB (1x1)
+        elif op == 0x1A: x = a()[0]; r = [1.0 / x if x else math.copysign(math.inf, x)] * 4
+        elif op == 0x1B: x = abs(a()[0]); r = [1.0 / math.sqrt(x) if x else math.inf] * 4
+        elif op == 0x1C: r = [2.0 ** a()[0]] * 4
+        elif op == 0x1D:
+            x = a()[0]; r = [math.log2(x) if x > 0 else (-math.inf if x == 0 else math.nan)] * 4
+        elif op == 0x1F: x, y, z = a(), b(), c(); r = [x[i] * y[i] + (1 - x[i]) * z[i] for i in range(4)]
+        elif op == 0x22: r = [math.cos(a()[0])] * 4
+        elif op == 0x23: r = [math.sin(a()[0])] * 4
+        elif op == 0x26:
+            try: r = [math.pow(a()[0], b()[0])] * 4
+            except (ValueError, OverflowError): r = [math.nan] * 4
+        elif op == 0x27: r = [pack_unorm8(a())] * 4                               # PKB
+        elif op == 0x2C: r = [pack_unorm8([lin_to_srgb(v) for v in a()])] * 4     # PKG
+        elif op == 0x28: r = unpack_unorm8(src(w1, 0, raw=True)[0])                # UPB
+        elif op == 0x2D: r = [srgb_to_lin(v) for v in unpack_unorm8(src(w1, 0, raw=True)[0])]  # UPG
+        elif op == 0x13: r = [pack_snorm8(a())] * 4                               # PK4
+        elif op == 0x14: r = unpack_snorm8(src(w1, 0, raw=True)[0])               # UP4
+        elif op == 0x24: r = [pack_half2(a())] * 4                                # PK2
+        elif op == 0x25: r = unpack_half2(src(w1, 0, raw=True)[0])                # UP2
+        elif op == 0x29: r = [pack_unorm16(a())] * 4                              # PK16
+        elif op == 0x2A: r = unpack_unorm16(src(w1, 0, raw=True)[0])              # UP16
+        elif op == 0x38: x, y = a(), b(); r = [x[0] * y[0] + x[1] * y[1]] * 4
+        elif op == 0x39:       # NRM: normalize(xyz).xyzz
+            x = a(); ln = math.sqrt(x[0] ** 2 + x[1] ** 2 + x[2] ** 2)
+            nv = [x[i] / ln for i in range(3)] if ln > 0 else x[:3]
+            r = [nv[0], nv[1], nv[2], nv[2]]
+        elif op == 0x3A: x, y = a(), b(); r = [x[i] / y[0] if y[0] else math.copysign(math.inf, x[i]) for i in range(4)]
+        elif op == 0x3B:       # DIVSQ: a / sqrt(|b.x|), 0 where a == 0
+            x, y = a(), b(); d = math.sqrt(abs(y[0]))
+            r = [(x[i] / d if d else math.copysign(math.inf, x[i])) if abs(x[i]) > 0 else 0.0 for i in range(4)]
+        elif op in (0x00, 0x3D, 0x3E): pass                                      # NOP FENCT FENCB
+        else:
+            raise SystemExit('opcode 0x%02X not modelled' % op)
+
+        if r is not None:
+            if op not in PACK_OPS:                       # a packed word is a bit pattern
+                r = [f32(v) for v in r]
+                scale = (w2 >> 28) & 7
+                if scale:
+                    s = {1: 2.0, 2: 4.0, 3: 8.0, 5: 0.5, 6: 0.25, 7: 0.125}[scale]
+                    r = [f32(fl(v) * s) for v in r]
+                if (w0 >> 31) & 1:
+                    r = [sat(fl(v)) for v in r]
+            mask = [(w0 >> (9 + i)) & 1 for i in range(4)]
+            en = cond()
+            if not (w0 >> 30) & 1:
+                half, di = (w0 >> 7) & 1, (w0 >> 1) & 63
+                dst = (H if half else R)[di]
+                for i in range(4):
+                    if mask[i] and en[i]:
+                        dst[i] = r[i]
+                        lastw[(di // 2, (di % 2) * 2 + i // 2) if half else (di, i)] = 'H' if half else 'R'
+                if (w0 >> 8) & 1:
+                    for i in range(4):
+                        if mask[i]: cc[(w1 >> 30) & 1][i] = dst[i]
+            elif (w0 >> 8) & 1:
+                for i in range(4):
+                    if mask[i] and en[i]: cc[(w1 >> 30) & 1][i] = r[i]
+            if trace:
+                print('%3d op%02X -> %s' % (n, op, [('%08X' % v) if isinstance(v, Bits) else '%.6g' % v for v in r]))
+        n += 1
+        if w0 & 1:
+            break
+    if exp32:
+        outs = [R[0], R[2], R[3], R[4]]
+    else:
+        outs = []
+        for hi in (0, 4, 6, 8):
+            o = []
+            for ci in range(4):
+                ri, lane = hi // 2, ci // 2
+                if lastw.get((ri, lane)) == 'R':    # one register file: the fp32's halves
+                    v = R[ri][lane]
+                    u = int(v) if isinstance(v, Bits) else bits(v)
+                    o.append(struct.unpack('<e', struct.pack('<H', (u >> 16) if ci & 1 else (u & 0xFFFF)))[0])
+                else:
+                    o.append(H[hi][ci])
+            outs.append(o)
+    return [[(lambda x: x if x == x else 0.0)(fl(v)) for v in o] for o in outs]
+
+def load_inputs(path):
+    inputs, texv, bx2w, face = {}, {}, 0, 1.0
+    for line in open(path):
+        p = line.split()
+        if not p or p[0].startswith('#'):
+            continue
+        if p[0] == 'in': inputs[p[1]] = [float(v) for v in p[2:6]]
+        elif p[0] == 'tex': texv[int(p[1])] = [float(v) for v in p[2:6]]
+        elif p[0] == 'bx2': bx2w = int(p[1], 16)
+        elif p[0] == 'face': face = float(p[1])
+    return inputs, texv, bx2w, face
+
+def gen_inputs(rng):
+    lines = []
+    for nm in ('COL0', 'COL1', 'FOGC', 'TC0', 'TC1', 'TC2', 'TC3', 'TC4', 'TC5', 'TC6', 'TC7'):
+        v = [rng.uniform(-1, 1) for _ in range(4)]
+        if nm == 'TC1':
+            v[3] = rng.choice((-1.0, 1.0))
+        lines.append('in %s %.6f %.6f %.6f %.6f' % (nm, *v))
+    for u in range(16):
+        lines.append('tex %d %.6f %.6f %.6f %.6f' % (u, *[rng.uniform(0.02, 0.98) for _ in range(4)]))
+    lines.append('bx2 %08X' % rng.choice((0xFFFFFFFF, 0x0, 0x7B5A3CF1)))
+    return '\n'.join(lines) + '\n'
+
+def parse_outputs(txt):
+    return [[float(v) for v in p[1:5]] for p in (l.split() for l in txt.splitlines())
+            if len(p) == 5 and p[0] in ('t0', 't1', 't2', 't3')]
+
+def diff(exe, rawdir, seeds, files, tol=2e-3):
+    td = tempfile.mkdtemp()
+    nrun = nbad = 0
+    for fn in files:
+        path = os.path.join(rawdir, fn)
+        buf = open(path, 'rb').read()
+        worst = 0.0
+        for s in range(seeds):
+            ip = os.path.join(td, 'in.txt')
+            open(ip, 'w').write(gen_inputs(random.Random(zlib.crc32(fn.encode()) ^ s)))
+            try:
+                ref = run(buf, *load_inputs(ip))
+            except SystemExit as e:
+                print('%s: not modelled (%s)' % (fn, e))
+                break
+            got = parse_outputs(subprocess.run([exe, path, ip], capture_output=True, text=True).stdout)
+            if len(got) != 4:
+                print('%s seed %d: %s failed' % (fn, s, exe)); nbad += 1
+                continue
+            nrun += 1
+            for t in range(4):
+                for ci in range(4):
+                    err = abs(ref[t][ci] - got[t][ci]) / max(1.0, abs(ref[t][ci]))
+                    worst = max(worst, err)
+                    if err > tol:
+                        nbad += 1
+                        print('%s seed %d t%d.%s ref %.6f hlsl %.6f' % (fn, s, t, 'xyzw'[ci], ref[t][ci], got[t][ci]))
