+        rsx_fp_decompile_buffered_ex(txp, sizeof(txp), CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+        check("ztex_txp_call", hlsl, "rsx_ztex(rsx_tex[1], rsx_samp[1], 1u, 1u, ((r[0]).xyzw), 1u)");
+        check("ztex_declared", hlsl, "float4 rsx_ztex(Texture2D t, SamplerState s, uint u, uint mode, float4 c, uint proj)");
+        check("ztex_gather_packed", hlsl, "t.GatherAlpha(s, g) * 255.0) * 65536.0");
+        check("ztex_ref_projected", hlsl, "const float zr = saturate(proj != 0u ? c.z / c.w : c.z);");
+        check("ztex_pcf", hlsl, "lerp(lerp(d.w, d.z, q.x), lerp(d.x, d.y, q.x), q.y)");
+        /* ZTEX_PCF (fp_texctl depth byte bits 5-6): exact gathers at the
+         * footprint's centre with the weights of the same coordinate; 1 is
+         * the old gather at uv with frac() weights */
+        check("ztex_pcf_exact", hlsl, "rsx_zpcf(t, s, mode, b, zr, p - f, (f + 1.0) / sz)");
+        check("ztex_pcf_gather", hlsl, "if (pcf == 1u) return (float4)rsx_zpcf(t, s, mode, b, zr, frac(p), uv);");
+        check_absent("ztex_no_texproc_wrap", hlsl, "rsx_texproc(rsx_ztex");
+        check_absent("ztex_no_texsx", hlsl, "rsx_texsx");
+        rsx_fp_set_tex_modes(RSX_FP_TEX_DEPTH << 2u);
+        rsx_fp_decompile_buffered_ex(tex, sizeof(tex), CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+        check("ztex_tex_call", hlsl, "rsx_ztex(rsx_tex[1], rsx_samp[1], 1u, 2u, ((input.tc0).xyzw), 0u)");
+        /* a cube unit is never a depth unit: sampled as before */
+        rsx_fp_decompile_buffered_ex(tex, sizeof(tex), CTRL_16BIT, 1u << 1, hlsl, sizeof(hlsl), &nk);
+        check_absent("ztex_not_on_cube", hlsl, "rsx_ztex(");
+        check("ztex_cube_sample", hlsl, "rsx_tex1.Sample(rsx_samp[1], ((input.tc0).xyzw).xyz)");
+        /* individually declared units (another unit is a cube): by name */
+        rsx_fp_decompile_buffered_ex(tex, sizeof(tex), CTRL_16BIT, 1u << 4, hlsl, sizeof(hlsl), &nk);
+        check("ztex_named_unit", hlsl, "rsx_ztex(rsx_tex1, rsx_samp[1], 1u, 2u,");
+        /* unbuffered programs have no per-draw texture state: unchanged */
+        rsx_fp_decompile(tex, sizeof(tex), CTRL_16BIT, hlsl, sizeof(hlsl));
+        check_absent("ztex_unbuffered_raw", hlsl, "rsx_ztex");
+
+        rsx_fp_set_tex_modes(RSX_FP_TEX_SIGNED << 2u);
+        rsx_fp_decompile_buffered_ex(tex, sizeof(tex), CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+        check("texsx_call", hlsl,
+              "rsx_texsx(rsx_tex[1].Sample(rsx_samp[1], ((input.tc0).xyzw).xy), "
+              "rsx_texproc(rsx_tex[1].Sample(rsx_samp[1], ((input.tc0).xyzw).xy), 1u), 1u)");
+        check("texsx_declared", hlsl, "float4 rsx_texsx(float4 raw, float4 c, uint u)");
+        check("texsx_twos_complement", hlsl, "max((v >= 128.0 ? v - 256.0 : v) / 127.0, -1.0)");
+        check_absent("texsx_no_ztex", hlsl, "rsx_ztex");
+        /* TEX_bx2 on a signed unit: the bx2 path processes the rest */
+        put_word(tex + 0, OPC(0x17) | OUTMASK_ALL | INSRC(4) | TEXU(1) | (1u << 21) | END);
+        rsx_fp_decompile_buffered_ex(tex, sizeof(tex), CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+        check("texsx_bx2", hlsl, "rsx_texsx(rsx_tex[1].Sample(rsx_samp[1], ((input.tc0).xyzw).xy), "
+                                 "rsx_texproc_bx2(rsx_tex[1].Sample(");
+        rsx_fp_set_tex_modes(0u);
+        rsx_fp_decompile_buffered_ex(tex, sizeof(tex), CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+        check_absent("texmode_reset", hlsl, "rsx_texsx");
+    }
+
+    /* Test 23: UN textures (rsx_fp_set_tex_unnorm): texel coordinates are
+     * divided by the bound texture's size before sampling; unset, unchanged. */
+    {
+        u8 tex[16], txp[16];
+        put_word(tex + 0, OPC(0x17) | OUTMASK_ALL | INSRC(4) | TEXU(1) | END);   /* TEX unit 1 */
+        put_word(tex + 4, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(tex + 8, 0); put_word(tex + 12, 0);
+        put_word(txp + 0, OPC(0x18) | OUTMASK_ALL | TEXU(1) | END);              /* TXP unit 1, r0 */
+        put_word(txp + 4, T_TEMP | REG(0) | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(txp + 8, 0); put_word(txp + 12, 0);
+        static char base[16384];
+        u32 nk = 0;
+        rsx_fp_decompile_buffered_ex(tex, sizeof(tex), CTRL_16BIT, 0, base, sizeof(base), &nk);
+        rsx_fp_set_tex_unnorm(1u << 3);                    /* another unit */
+        rsx_fp_decompile_buffered_ex(tex, sizeof(tex), CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+        check_true("unn_other_unit_identical", strcmp(base, hlsl) == 0);
+        rsx_fp_set_tex_unnorm(1u << 1);
+        rsx_fp_decompile_buffered_ex(tex, sizeof(tex), CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+        check("unn_tex", hlsl, "rsx_tex[1].Sample(rsx_samp[1], (rsx_unn((input.tc0).xyzw, rsx_tex[1])).xy)");
+        check("unn_declared", hlsl, "float4 rsx_unn(float4 c, Texture2D t) { uint w, h; t.GetDimensions(w, h);");
+        rsx_fp_decompile_buffered_ex(txp, sizeof(txp), CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+        check("unn_txp", hlsl, "(rsx_unn((r[0]).xyzw, rsx_tex[1])).xy / (rsx_unn((r[0]).xyzw, rsx_tex[1])).w");
+        /* with a depth mode: the comparison gets the scaled coordinate */
+        rsx_fp_set_tex_modes(RSX_FP_TEX_DEPTH << 2u);
+        rsx_fp_decompile_buffered_ex(txp, sizeof(txp), CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+        check("unn_ztex", hlsl, "rsx_ztex(rsx_tex[1], rsx_samp[1], 1u, 2u, (rsx_unn((r[0]).xyzw, rsx_tex[1])), 1u)");
+        rsx_fp_set_tex_modes(0u);
+        /* a cube unit is never UN */
+        rsx_fp_decompile_buffered_ex(tex, sizeof(tex), CTRL_16BIT, 1u << 1, hlsl, sizeof(hlsl), &nk);
+        check_absent("unn_not_on_cube", hlsl, "rsx_unn");
+        /* unbuffered: no per-draw state */
+        rsx_fp_decompile(tex, sizeof(tex), CTRL_16BIT, hlsl, sizeof(hlsl));
+        check_absent("unn_unbuffered", hlsl, "rsx_unn");
+        rsx_fp_set_tex_unnorm(0u);
+        rsx_fp_decompile_buffered_ex(tex, sizeof(tex), CTRL_16BIT, 0, hlsl, sizeof(hlsl), &nk);
+        check_true("unn_reset_identical", strcmp(base, hlsl) == 0);
+    }
+
+    /* Test 24: shadow filtering (rsx_fp_set_shadow_filter). The PS3 kernel is
+     * the default and its HLSL is byte-identical to a decompile that never
+     * touched the setting; a soft kernel replaces rsx_ztex only at a depth
+     * unit the program samples once, outside flow control; the title's
+     * multi-tap resolves (a centre TXP + four TEX on one unit) keep the PS3
+     * HLSL byte for byte; the per-axis weights are the tents' areas. */
+    {
+        u8 txp[16], two[32], tap5[80], mix[48], ife[48];
+        static char base[16384], hs[16384];
+        u32 nk = 0;
+        /* TXP r0, r0, TEX1 (END) */
+        put_word(txp + 0, OPC(0x18) | OUTMASK_ALL | TEXU(1) | END);
+        put_word(txp + 4, T_TEMP | REG(0) | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(txp + 8, 0); put_word(txp + 12, 0);
+        /* TXP r0, r0, TEX1 ; TEX r1, f[TEX0], TEX1 (END): two taps on unit 1 */
+        put_word(two + 0, OPC(0x18) | OUTMASK_ALL | TEXU(1));
+        put_word(two + 4, T_TEMP | REG(0) | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(two + 8, 0); put_word(two + 12, 0);
+        put_word(two + 16, OPC(0x17) | OUTMASK_ALL | OUTREG(1) | INSRC(4) | TEXU(1) | END);
+        put_word(two + 20, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(two + 24, 0); put_word(two + 28, 0);
+        /* the multi-tap shape: TXP + four TEX on unit 1 */
+        for (int i = 0; i < 5; i++) {
+            put_word(tap5 + 16 * i, OPC(i ? 0x17 : 0x18) | OUTMASK_ALL | OUTREG(i) | INSRC(4) | TEXU(1) | (i == 4 ? END : 0u));
+            put_word(tap5 + 16 * i + 4, (i ? T_INPUT : T_TEMP) | SWZ_IDENT | EXEC_ALWAYS);
+            put_word(tap5 + 16 * i + 8, 0); put_word(tap5 + 16 * i + 12, 0);
+        }
+        /* TXP r0, r0, TEX1 ; TEX r1, f[TEX0], TEX2 ; TEX r2, f[TEX0], TEX2 (END): unit 1 once, unit 2 twice */
+        put_word(mix + 0, OPC(0x18) | OUTMASK_ALL | TEXU(1));
+        put_word(mix + 4, T_TEMP | REG(0) | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(mix + 8, 0); put_word(mix + 12, 0);
+        put_word(mix + 16, OPC(0x17) | OUTMASK_ALL | OUTREG(1) | INSRC(4) | TEXU(2));
+        put_word(mix + 20, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(mix + 24, 0); put_word(mix + 28, 0);
+        put_word(mix + 32, OPC(0x17) | OUTMASK_ALL | OUTREG(2) | INSRC(4) | TEXU(2) | END);
+        put_word(mix + 36, T_INPUT | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(mix + 40, 0); put_word(mix + 44, 0);
+        /* @0 IFE(cc0.x > 0) end=@32 ; @16 TXP r0, r0, TEX1 ; @32 MOV r1, r0 (END): the tap inside a block */
+        put_word(ife + 0, OPC(0x02));
+        put_word(ife + 4, 1u << 20);
+        put_word(ife + 8, (1u << 31) | (32u >> 2));
+        put_word(ife + 12, 32u >> 2);
+        put_word(ife + 16, OPC(0x18) | OUTMASK_ALL | TEXU(1));
+        put_word(ife + 20, T_TEMP | REG(0) | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(ife + 24, 0); put_word(ife + 28, 0);
+        put_word(ife + 32, OPC(0x01) | OUTMASK_ALL | OUTREG(1) | END);
+        put_word(ife + 36, T_TEMP | REG(0) | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(ife + 40, 0); put_word(ife + 44, 0);
+
+        check_true("zsoft_default_ps3", rsx_fp_shadow_filter() == RSX_FP_SHADOW_PS3);
+        check_true("multi_fetch_none", rsx_fp_multi_fetch_units(txp, sizeof txp) == 0u);
+        check_true("multi_fetch_two", rsx_fp_multi_fetch_units(two, sizeof two) == (1u << 1));
+        check_true("multi_fetch_tap5", rsx_fp_multi_fetch_units(tap5, sizeof tap5) == (1u << 1));
+        check_true("multi_fetch_mix", rsx_fp_multi_fetch_units(mix, sizeof mix) == (1u << 2));
+        check_true("multi_fetch_unterminated", rsx_fp_multi_fetch_units(two, 16) == 0xFFFFu);
+
+        /* PS3: byte-identical to the decompile that never set the filter */
+        const u32 modes = (RSX_FP_TEX_DEPTH_PACKED << 2u) | (RSX_FP_TEX_DEPTH_PACKED << 4u);
+        static char p3[5][16384];
+        const u8* progs[5] = { txp, two, tap5, mix, ife };
+        const u32 sizes[5] = { sizeof txp, sizeof two, sizeof tap5, sizeof mix, sizeof ife };
+        rsx_fp_set_tex_modes(modes);
+        for (int i = 0; i < 5; i++)
+            rsx_fp_decompile_buffered_ex(progs[i], sizes[i], CTRL_16BIT, 0, p3[i], sizeof p3[i], &nk);
+        rsx_fp_set_shadow_filter(RSX_FP_SHADOW_PS3);
+        int same = 1;
+        for (int i = 0; i < 5; i++) {
+            rsx_fp_decompile_buffered_ex(progs[i], sizes[i], CTRL_16BIT, 0, hs, sizeof hs, &nk);
+            same &= strcmp(hs, p3[i]) == 0;
+        }
+        check_true("zsoft_ps3_identical", same);
+        check_absent("zsoft_ps3_no_ztexs", p3[0], "rsx_ztexs");
+
+        static const u32 kern[4] = { RSX_FP_SHADOW_SOFT, RSX_FP_SHADOW_SOFTER,
+                                     RSX_FP_SHADOW_SOFTER | RSX_FP_SHADOW_POISSON,
+                                     RSX_FP_SHADOW_SOFT | RSX_FP_SHADOW_PLANE };
+        static const char* const kn[4] = { "soft", "softer", "poisson", "soft_plane" };
+        for (int ki = 0; ki < 4; ki++) {
+            char nm[64];
+            rsx_fp_set_shadow_filter(kern[ki]);
+            rsx_fp_decompile_buffered_ex(txp, sizeof txp, CTRL_16BIT, 0, hs, sizeof hs, &nk);
+            snprintf(nm, sizeof nm, "zsoft_%s_call", kn[ki]);
+            check(nm, hs, "rsx_ztexs(rsx_tex[1], rsx_samp[1], 1u, 1u, ((r[0]).xyzw), 1u, input.position.xy)");
+            snprintf(nm, sizeof nm, "zsoft_%s_helper", kn[ki]);
+            check(nm, hs, "float4 rsx_ztexs(Texture2D t, SamplerState s, uint u, uint mode, float4 c, uint proj, float2 sp)");
+            snprintf(nm, sizeof nm, "zsoft_%s_ps3_fallback", kn[ki]);
+            check(nm, hs, "return rsx_ztex(t, s, u, mode, c, proj);");
+            snprintf(nm, sizeof nm, "zsoft_%s_ps3_helper_kept", kn[ki]);
+            check(nm, hs, "float4 rsx_ztex(Texture2D t, SamplerState s, uint u, uint mode, float4 c, uint proj)");
+            snprintf(nm, sizeof nm, "zsoft_%s_kernel", kn[ki]);
+            check(nm, hs, ki == 0 || ki == 3 ? "w1 = 0.75 - d * d" : ki == 1 ? "wc = 0.4375 - d * d * 0.25"
+                                                                                : "static const float2 o[12]");
+            snprintf(nm, sizeof nm, "zsoft_%s_plane", kn[ki]);
+            if (ki == 3) check(nm, hs, "ddx(p)"); else check_absent(nm, hs, "ddx(p)");
+            /* several taps on unit 1 (the title's multi-tap): the PS3 HLSL, byte for byte */
+            rsx_fp_decompile_buffered_ex(two, sizeof two, CTRL_16BIT, 0, hs, sizeof hs, &nk);
+            snprintf(nm, sizeof nm, "zsoft_%s_two_taps_ps3", kn[ki]);
+            check_true(nm, strcmp(hs, p3[1]) == 0);
+            rsx_fp_decompile_buffered_ex(tap5, sizeof tap5, CTRL_16BIT, 0, hs, sizeof hs, &nk);
+            snprintf(nm, sizeof nm, "zsoft_%s_multitap_ps3", kn[ki]);
+            check_true(nm, strcmp(hs, p3[2]) == 0);
+            /* unit 1 once (soft), unit 2 twice (PS3) */
+            rsx_fp_decompile_buffered_ex(mix, sizeof mix, CTRL_16BIT, 0, hs, sizeof hs, &nk);
+            snprintf(nm, sizeof nm, "zsoft_%s_mix_unit1_soft", kn[ki]);
+            check(nm, hs, "rsx_ztexs(rsx_tex[1], rsx_samp[1], 1u, 1u,");
+            snprintf(nm, sizeof nm, "zsoft_%s_mix_unit2_ps3", kn[ki]);
+            check(nm, hs, "rsx_ztex(rsx_tex[2], rsx_samp[2], 2u, 1u, ((input.tc0).xyzw), 0u)");
+            snprintf(nm, sizeof nm, "zsoft_%s_mix_unit2_not_soft", kn[ki]);
+            check_absent(nm, hs, "rsx_ztexs(rsx_tex[2]");
+            /* inside a flow-control block: the PS3 HLSL (derivatives) */
+            rsx_fp_decompile_buffered_ex(ife, sizeof ife, CTRL_16BIT, 0, hs, sizeof hs, &nk);
+            snprintf(nm, sizeof nm, "zsoft_%s_in_block_ps3", kn[ki]);
+            check_true(nm, strcmp(hs, p3[4]) == 0);
+        }
+        /* not a depth unit, unbuffered, cube: never the soft kernel */
+        rsx_fp_set_shadow_filter(RSX_FP_SHADOW_SOFT);
+        rsx_fp_set_tex_modes(0u);
+        rsx_fp_decompile_buffered_ex(txp, sizeof txp, CTRL_16BIT, 0, base, sizeof base, &nk);
+        check_absent("zsoft_no_depth_unit", base, "rsx_ztex");
+        rsx_fp_set_tex_modes(modes);
+        rsx_fp_decompile(txp, sizeof txp, CTRL_16BIT, hs, sizeof hs);
+        check_absent("zsoft_unbuffered", hs, "rsx_ztex");
+        rsx_fp_decompile_buffered_ex(txp, sizeof txp, CTRL_16BIT, 1u << 1, hs, sizeof hs, &nk);
+        check_absent("zsoft_not_on_cube", hs, "rsx_ztexs");
+        /* the plane (an A/B) and its limit are the text's */
+        rsx_fp_set_shadow_filter(RSX_FP_SHADOW_SOFT | RSX_FP_SHADOW_PLANE);
+        rsx_fp_set_shadow_plane_max(0.25);
+        rsx_fp_decompile_buffered_ex(txp, sizeof txp, CTRL_16BIT, 0, hs, sizeof hs, &nk);
+        check("zsoft_plane_limit", hs, "abs(pl.x) + abs(pl.y) <= 0.25);");
+        rsx_fp_set_shadow_plane_max(0.0);
+        rsx_fp_decompile_buffered_ex(txp, sizeof txp, CTRL_16BIT, 0, hs, sizeof hs, &nk);
+        check("zsoft_plane_unlimited", hs, "abs(pl.x) + abs(pl.y) <= 1e+30);");
+        check("zsoft_plane_two_sided", hs, "saturate(zr + pl.x * ox + pl.y * oy)");
+        rsx_fp_set_shadow_filter(RSX_FP_SHADOW_SOFT | RSX_FP_SHADOW_PLANE_LOWER);
+        rsx_fp_decompile_buffered_ex(txp, sizeof txp, CTRL_16BIT, 0, hs, sizeof hs, &nk);
+        check("zsoft_plane_lowering", hs, "saturate(zr + min(pl.x * ox + pl.y * oy, 0.0))");
+        rsx_fp_set_shadow_filter(RSX_FP_SHADOW_SOFT);
+        rsx_fp_decompile_buffered_ex(txp, sizeof txp, CTRL_16BIT, 0, hs, sizeof hs, &nk);
+        check("zsoft_default_no_plane", hs, "const float2 pl = (float2)0.0;");
+        check_absent("zsoft_default_no_ddx", hs, "ddx(");
+        rsx_fp_set_shadow_plane_max(RSX_FP_SHADOW_PLANE_MAX_DEFAULT);
+        /* back to PS3: identical again */
+        rsx_fp_set_shadow_filter(RSX_FP_SHADOW_PS3);
+        same = 1;
+        for (int i = 0; i < 5; i++) {
+            rsx_fp_decompile_buffered_ex(progs[i], sizes[i], CTRL_16BIT, 0, hs, sizeof hs, &nk);
+            same &= strcmp(hs, p3[i]) == 0;
+        }
+        check_true("zsoft_ps3_again_identical", same);
+        rsx_fp_set_tex_modes(0u);
+
+        /* the weights: >= 0, sum 1, mirror-symmetric, = the tents' areas over
+         * the texel squares (numerically integrated), PS3 = the bilinear pair */
+        int ok_sum = 1, ok_pos = 1, ok_sym = 1, ok_area = 1, ok_ps3 = 1;
+        double worst = 0.0;
+        for (int i = 0; i <= 1000; i++) {
+            const double d = -0.5 + i / 1000.0 * 0.999999;
+            for (u32 k = 0; k <= 2; k++) {
+                double w[5], wm[5], s = 0.0;
+                rsx_fp_shadow_weights(k, d, w);
+                rsx_fp_shadow_weights(k, -d, wm);
+                for (int j = 0; j < 5; j++) {
+                    s += w[j];
+                    if (w[j] < 0.0) ok_pos = 0;
+                    if (fabs(w[j] - wm[4 - j]) > 1e-12) ok_sym = 0;
+                }
+                if (fabs(s - 1.0) > 1e-12) ok_sum = 0;
+                if (k == 0) {
+                    const double f = d >= 0.0 ? d : 1.0 + d;   /* p - floor(p) */
+                    const int i0 = d >= 0.0 ? 2 : 1;          /* floor(p) - round(p) + 2 */
+                    if (fabs(w[i0] - (1.0 - f)) > 1e-12 || fabs(w[i0 + 1] - f) > 1e-12) ok_ps3 = 0;
+                    continue;
+                }
+                const double R = k == 1 ? 1.0 : 2.0;             /* tent radius */
+                for (int j = 0; j < 5; j++) {                    /* texel j - 2 covers [j-2.5, j-1.5] - d */
+                    double a = 0.0;
+                    const int n = 4000;
+                    for (int q = 0; q < n; q++) {
+                        const double x = (j - 2) - 0.5 + (q + 0.5) / n - d;
+                        a += (fabs(x) < R ? (R - fabs(x)) / (R * R) : 0.0) / n;
+                    }
+                    if (fabs(a - w[j]) > worst) worst = fabs(a - w[j]);
+                    if (fabs(a - w[j]) > 1e-6) ok_area = 0;
+                }
+            }
+        }
+        check_true("zsoft_weights_sum_1", ok_sum);
+        check_true("zsoft_weights_nonnegative", ok_pos);
+        check_true("zsoft_weights_symmetric", ok_sym);
+        check_true("zsoft_weights_ps3_bilinear", ok_ps3);
+        printf("    tent areas: worst |closed form - numeric| %.2e\n", worst);
+        check_true("zsoft_weights_tent_areas", ok_area);
+        /* an edge between texel 0 (shadowed) and 1 (lit) ramps over 1 / 2 / 4 texels, monotonically */
+        for (u32 k = 0; k <= 2; k++) {
+            double prev = -1.0, lo = 1e9, hi = -1e9;
+            int mono = 1;
+            for (int i = 0; i <= 8000; i++) {
+                const double p = -3.0 + i / 1000.0;              /* sample position, texel centres at integers */
+                const double r = floor(p + 0.5), d = p - r;
+                double w[5], v = 0.0;
+                rsx_fp_shadow_weights(k, d, w);
+                for (int j = 0; j < 5; j++) v += (r + j - 2 >= 1.0 ? 1.0 : 0.0) * w[j];
+                if (v < prev - 1e-12) mono = 0;
+                prev = v;
+                if (v > 1e-9 && p < lo) lo = p;
+                if (v < 1.0 - 1e-9 && p > hi) hi = p;
+            }
+            char nm[64];
+            snprintf(nm, sizeof nm, "zsoft_edge_monotone_k%u", k);
+            check_true(nm, mono);
+            snprintf(nm, sizeof nm, "zsoft_edge_ramp_k%u (%.3f texels)", k, hi - lo);
+            check_true(nm, fabs((hi - lo) - (k == 0 ? 1.0 : k == 1 ? 2.0 : 4.0)) < 0.01);
+        }
+    }
+
+    test_hw_semantics();
+    test_gate_pillar();
+
     printf("\n===========================================\n");
     printf("Results: %d passed, %d failed\n", g_pass, g_fail);
     return g_fail ? 1 : 0;
diff --git a/libs/video/tests/test_fp_srgb_output.c b/libs/video/tests/test_fp_srgb_output.c
new file mode 100644
index 0000000..a201650
--- /dev/null
+++ b/libs/video/tests/test_fp_srgb_output.c
@@ -0,0 +1,130 @@
+/* test_fp_srgb_output: rsx_fp_apply_srgb_output (NV4097_SET_SHADER_PACKER sRGB colour output).
+ * 1. synthetic HLSL tails: single target, MRT (3 targets + depth), unpatchable input, too-small
+ *    buffer.
+ * 2. optional, Windows: every raw program in an RPCS3 shader cache (raw/ *.fp) decompiled with
+ *    16-bit exports, patched with the dynamic alpha test + sRGB output and with sRGB output alone,
+ *    D3DCompile ps_5_0 -- all must compile and keep the body byte-identical. The ids file lists the
+ *    programs RPCS3 runs with RSX_SHADER_CONTROL_SRGB_FRAMEBUFFER (inFamous 2: 28 of 322); each
+ *    must be found.
+ * 3. the HLSL formula (saturate, then encode) against RPCS3's clamp(mix(high, low, c < 0.0031308)).
+ * Build (libs/video/tests): clang-cl -O2 -I../../../include -I.. test_fp_srgb_output.c
+ *                           ../rsx_fp_decompiler.c d3dcompiler.lib
+ * Run: test_fp_srgb_output [<rpcs3 shaders_cache/raw dir> <srgb ids file>] */
+#define _CRT_SECURE_NO_WARNINGS
+#include "rsx_fp_decompiler.h"
+#include <windows.h>
+#include <d3dcompiler.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int fails = 0, checks = 0;
+#define CHECK(c, ...) do { checks++; if (!(c)) { fails++; printf("FAIL: " __VA_ARGS__); printf("\n"); } } while (0)
+
+static char buf[512 * 1024], buf2[512 * 1024];
+static unsigned char fp[65536];
+
+static int compile_ps(const char* src, const char* name, char* err, size_t errn)
+{
+    ID3DBlob* b = NULL; ID3DBlob* e = NULL;
+    HRESULT hr = D3DCompile(src, strlen(src), name, NULL, NULL, "main", "ps_5_0", 0, 0, &b, &e);
+    if (e) { snprintf(err, errn, "%.*s", (int)e->lpVtbl->GetBufferSize(e), (const char*)e->lpVtbl->GetBufferPointer(e)); e->lpVtbl->Release(e); }
+    else err[0] = 0;
+    if (b) b->lpVtbl->Release(b);
+    return SUCCEEDED(hr);
+}
+
+int main(int argc, char** argv)
+{
+    /* ---- 1. synthetic tails */
+    {
+        char h[4096];
+        strcpy(h, "cbuffer PSConstants : register(b1) {\n    float4 fp_constants[1];\n    float4 fp_alpha;\n    uint4 fp_texctl;\n};\n"
+                  "float4 main(PSInput input) : SV_TARGET {\n    float4 r[2]; float4 h[2];\n"
+                  "    float4 _o = h[0];\n    return (_o == _o) ? _o : (float4)0;\n}\n");
+        CHECK(rsx_fp_apply_srgb_output(h, sizeof h) == 1, "single-target patch");
+        CHECK(strstr(h, "float4 _rsx_srgb = (_o == _o) ? _o : (float4)0;") != NULL, "single: wraps the export");
+        CHECK(strstr(h, "_rsx_srgb.rgb = _c < 0.0031308") != NULL, "single: converts rgb");
+        CHECK(strstr(h, "_rsx_srgb.a") == NULL && strstr(h, ".w =") == NULL, "single: alpha untouched");
+        CHECK(strstr(h, "    return _rsx_srgb;\n}\n") != NULL, "single: returns it");
+        /* idempotence guard is the caller's job; a second call wraps again (still valid HLSL) */
+    }
+    {
+        char h[4096];
+        strcpy(h, "struct PSOutput {\n    float4 t0 : SV_TARGET0;\n    float4 t1 : SV_TARGET1;\n    float4 t2 : SV_TARGET2;\n"
+                  "    float depth : SV_Depth;\n};\nPSOutput main(PSInput input) {\n    PSOutput _out;\n    _out.t0 = 0; _out.t1 = 0; _out.t2 = 0;\n"
+                  "    _out.depth = 0.5;\n    return _out;\n}\n");
+        CHECK(rsx_fp_apply_srgb_output(h, sizeof h) == 1, "mrt patch");
+        CHECK(strstr(h, "PSOutput _rsx_srgb = _out;") != NULL, "mrt: wraps");
+        CHECK(strstr(h, "_rsx_srgb.t0.rgb =") && strstr(h, "_rsx_srgb.t1.rgb =") && strstr(h, "_rsx_srgb.t2.rgb ="), "mrt: all 3 targets");
+        CHECK(strstr(h, "_rsx_srgb.t3") == NULL && strstr(h, "depth.rgb") == NULL, "mrt: no t3, no depth");
+    }
+    {
+        char h[64] = "float4 main() { return 1; }";   /* no "    return " marker */
+        CHECK(rsx_fp_apply_srgb_output(h, sizeof h) == -1, "unpatchable input refused");
+        char t[300];
+        strcpy(t, "float4 main(PSInput input) : SV_TARGET {\n    float4 _o = h[0];\n    return (_o == _o) ? _o : (float4)0;\n}\n");
+        CHECK(rsx_fp_apply_srgb_output(t, (u32)strlen(t) + 8) == -1, "too-small buffer refused");
+        CHECK(strstr(t, "_rsx_srgb") == NULL, "too-small buffer left untouched");
+    }
+    /* ---- 3. formula: saturate-then-encode == RPCS3 clamp(mix(high, low, c < 0.0031308)) */
+    {
+        const float xs[] = { -0.5f, 0.0f, 0.001f, 0.0031307f, 0.0031309f, 0.05f, 0.18f, 0.5f, 0.99f, 1.0f, 1.7f };
+        for (unsigned i = 0; i < sizeof xs / sizeof xs[0]; i++) {
+            float x = xs[i];
+            float c = x < 0 ? 0 : (x > 1 ? 1 : x);
+            float ours = c < 0.0031308f ? c * 12.92f : 1.055f * powf(c, 1.0f / 2.4f) - 0.055f;
+            float low = x * 12.92f, high = 1.055f * powf(fabsf(x), 1.0f / 2.4f) - 0.055f;   /* fabs: GLSL pow(neg) is undefined, mix discards it */
+            float ref = x < 0.0031308f ? low : high; ref = ref < 0 ? 0 : (ref > 1 ? 1 : ref);
+            CHECK(fabsf(ours - ref) < 1e-6f, "formula at %g: %g vs %g", x, ours, ref);
+        }
+    }
+    /* ---- 2. real programs */
+    if (argc >= 3) {
+        char ids[64][16]; int nid = 0;
+        FILE* f = fopen(argv[2], "r");
+        while (f && nid < 64 && fscanf(f, "%15s", ids[nid]) == 1) nid++;
+        if (f) fclose(f);
+        char pat[1024]; snprintf(pat, sizeof pat, "%s\\*.fp", argv[1]);
+        WIN32_FIND_DATAA fd; HANDLE hf = FindFirstFileA(pat, &fd);
+        int tot = 0, ok = 0, srgb_seen = 0, srgb_ok = 0, alpha_ok = 0;
+        do {
+            if (hf == INVALID_HANDLE_VALUE) break;
+            char path[1024]; snprintf(path, sizeof path, "%s\\%s", argv[1], fd.cFileName);
+            FILE* g = fopen(path, "rb"); if (!g) continue;
+            long len = (long)fread(fp, 1, sizeof fp, g); fclose(g);
+            u32 sz = rsx_fp_program_size(fp, (u32)len); if (!sz) sz = (u32)len;
+            u32 id = rsx_fp_code_hash(fp, sz);
+            char sid[16]; snprintf(sid, sizeof sid, "%08X", id);
+            int is_srgb = 0;
+            for (int i = 0; i < nid; i++) if (!strcmp(ids[i], sid)) is_srgb = 1;
+            u32 nconst = 0;
+            if (rsx_fp_decompile_buffered_ex(fp, sz, 0u, 0u, buf, sizeof buf, &nconst) <= 0) continue;
+            tot++;
+            strcpy(buf2, buf);
+            const int a = rsx_fp_apply_alpha_test_dynamic(buf2, sizeof buf2);   /* alpha + sRGB: the worst case */
+            const int s = rsx_fp_apply_srgb_output(buf2, sizeof buf2);
+            char err[2048];
+            const int c = (a == 1 && s == 1) && compile_ps(buf2, sid, err, sizeof err);
+            if (c) ok++;
+            else printf("program %s (%s): alpha=%d srgb=%d compile=%d %s\n", sid, fd.cFileName, a, s, c, err);
+            if (a == 1) alpha_ok++;
+            if (is_srgb) { srgb_seen++; if (c) srgb_ok++; }
+            /* the plain program must be a prefix of the patched one up to the old return */
+            char* r0 = NULL; for (char* p = strstr(buf, "    return "); p; p = strstr(p + 1, "    return ")) r0 = p;
+            CHECK(r0 && !strncmp(buf, buf2, (size_t)(r0 - buf)), "program %s: body changed by the patch", sid);
+            /* sRGB alone on the plain output, compiled too (the FB_SRGB path without alpha test) */
+            strcpy(buf2, buf);
+            const int s2 = rsx_fp_apply_srgb_output(buf2, sizeof buf2);
+            CHECK(s2 == 1 && compile_ps(buf2, sid, err, sizeof err), "program %s: sRGB-only variant does not compile: %s", sid, err);
+        } while (FindNextFileA(hf, &fd));
+        if (hf != INVALID_HANDLE_VALUE) FindClose(hf);
+        printf("corpus: %d programs decompiled, %d alpha-tested+sRGB variants compile (alpha patch %d), sRGB programs %d/%d compile\n",
+               tot, ok, alpha_ok, srgb_ok, srgb_seen);
+        CHECK(ok == tot, "every corpus program compiles patched");
+        CHECK(srgb_seen == nid && srgb_ok == nid, "all %d RPCS3 sRGB programs found and compile (%d, %d)", nid, srgb_seen, srgb_ok);
+    }
+    printf("%s: %d checks, %d failed\n", fails ? "FAIL" : "PASS", checks, fails);
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_fp_warp.c b/libs/video/tests/test_fp_warp.c
new file mode 100644
index 0000000..6ef9b54
--- /dev/null
+++ b/libs/video/tests/test_fp_warp.c
@@ -0,0 +1,744 @@
+/*
+ * Windows-only: execute decompiled RSX fragment programs on the D3D11 WARP
+ * rasterizer (one pixel, 4 x RGBA32F targets) -- the HLSL exactly as the
+ * D3D12 backend builds it (rsx_fp_decompile_buffered_ex, min 4 targets; b1 =
+ * inline constants + fp_alpha (.w = TEX_bx2 nibbles) + fp_texctl).
+ *
+ *   test_fp_warp                       self-test: the hand-assembled programs
+ *                                      of fp_pack_programs.h against values
+ *                                      computed here from the RPCS3 / GLSL
+ *                                      definitions of each op
+ *   test_fp_warp <ucode> <inputs.txt> [-exp32]
+ *                                      print t0..t3 (tools/rsx_fp_ref.py diff
+ *                                      drives this over a directory of programs)
+ *
+ * With FP_PACK=0 in the environment the self-test expects the decompiler's
+ * old output for the G-buffer program instead -- t0 = (0, mask.y, 0, 0), the
+ * green heads -- and skips the per-op checks.
+ *
+ * The P0-4 hardware-semantics checks (hw_semantics) run the FP and VP rules
+ * docs/GROUND_TRUTH.md sections 3 and 6 name -- source saturate, perspective
+ * correction against a clip w of 4, fx12 results, fp16 H storage, the NV_fp
+ * 3.11.4.4 CC rule, the VP colour clamp and the VP special cases -- and each
+ * one's env switch off.
+ *
+ * Build, from this directory:
+ *   clang-cl -O2 -std:c17 -I../../../include -I.. test_fp_warp.c ../rsx_fp_decompiler.c
+ *            ../rsx_vp_decompiler.c
+ * (links d3d11.lib; D3DCompile comes from d3dcompiler_47.dll at run time).
+ */
+#define COBJMACROS
+#define _CRT_SECURE_NO_WARNINGS
+#include "../rsx_fp_decompiler.h"
+#include "../rsx_vp_decompiler.h"
+#include <windows.h>
+#include <d3d11.h>
+#include <d3dcompiler.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#pragma comment(lib, "d3d11.lib")
+#include "fp_pack_programs.h"
+
+typedef HRESULT (WINAPI *PFN_Compile)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*,
+                                      LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+static PFN_Compile s_compile;
+static char s_hlsl[256 * 1024];
+static ID3D11Device* s_dev;
+static ID3D11DeviceContext* s_ctx;
+static ID3D11VertexShader* s_vs;
+
+#define REL(p) do { if (p) { (p)->lpVtbl->Release(p); (p) = NULL; } } while (0)
+
+typedef struct { float vin[16][4]; float tex[16][4]; unsigned bx2; unsigned texctl[4]; } Inputs;
+
+static void parse_inputs(const char* text, Inputs* in)
+{
+    static const char* names[] = { "COL0", "COL1", "FOGC", "TC0", "TC1", "TC2", "TC3", "TC4", "TC5", "TC6", "TC7" };
+    memset(in, 0, sizeof *in);
+    for (const char* l = text; l && *l; ) {
+        char nm[32]; float a, b, c, d; int u;
+        if (sscanf(l, "in %31s %f %f %f %f", nm, &a, &b, &c, &d) == 5) {
+            for (int i = 0; i < 11; i++)
+                if (!strcmp(nm, names[i])) { in->vin[i][0] = a; in->vin[i][1] = b; in->vin[i][2] = c; in->vin[i][3] = d; }
+        } else if (sscanf(l, "tex %d %f %f %f %f", &u, &a, &b, &c, &d) == 5 && u >= 0 && u < 16) {
+            in->tex[u][0] = a; in->tex[u][1] = b; in->tex[u][2] = c; in->tex[u][3] = d;
+        } else if (sscanf(l, "texctl %x %x %x %x", &in->texctl[0], &in->texctl[1], &in->texctl[2], &in->texctl[3]) == 4) {
+        } else sscanf(l, "bx2 %x", &in->bx2);
+        l = strchr(l, '\n'); if (l) l++;
+    }
+}
+
+static const char s_vs_src[] =
+    "cbuffer V : register(b0) { float4 v_in[16]; };\n"
+    "struct VSOut { float4 position : SV_POSITION; float4 col0 : COLOR0; float4 col1 : COLOR1;\n"
+    "  float4 fog : FOG; float4 tc0:TEXCOORD0; float4 tc1:TEXCOORD1; float4 tc2:TEXCOORD2; float4 tc3:TEXCOORD3;\n"
+    "  float4 tc4:TEXCOORD4; float4 tc5:TEXCOORD5; float4 tc6:TEXCOORD6; float4 tc7:TEXCOORD7; };\n"
+    "VSOut main(uint id : SV_VertexID) { VSOut o;\n"
+    "  float2 p = float2((id << 1) & 2, id & 2);\n"
+    /* v_in[11].x: the clip w of every vertex (0: 1), the same window position */
+    "  const float w = v_in[11].x > 0.0 ? v_in[11].x : 1.0;\n"
+    "  o.position = float4(p * float2(2, -2) + float2(-1, 1), 0, 1) * w;\n"
+    "  o.col0 = v_in[0]; o.col1 = v_in[1]; o.fog = v_in[2];\n"
+    "  o.tc0 = v_in[3]; o.tc1 = v_in[4]; o.tc2 = v_in[5]; o.tc3 = v_in[6];\n"
+    "  o.tc4 = v_in[7]; o.tc5 = v_in[8]; o.tc6 = v_in[9]; o.tc7 = v_in[10];\n"
+    "  return o; }\n";
+
+static ID3DBlob* compile(const char* src, const char* target)
+{
+    ID3DBlob *b = NULL, *e = NULL;
+    if (FAILED(s_compile(src, strlen(src), "x", NULL, NULL, "main", target, 0, 0, &b, &e))) {
+        printf("compile %s failed: %s\n", target, e ? (const char*)ID3D10Blob_GetBufferPointer(e) : "?");
+        REL(e);
+        return NULL;
+    }
+    REL(e);
+    return b;
+}
+
+static int init_device(void)
+{
+    if (s_dev) return 0;
+    D3D_FEATURE_LEVEL fl = D3D_FEATURE_LEVEL_11_0;
+    if (FAILED(D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_WARP, NULL, 0, &fl, 1, D3D11_SDK_VERSION, &s_dev, NULL, &s_ctx))) {
+        printf("no WARP device\n");
+        return 1;
+    }
+    ID3DBlob* vsb = compile(s_vs_src, "vs_5_0");
+    if (!vsb) return 1;
+    ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(vsb), ID3D10Blob_GetBufferSize(vsb), NULL, &s_vs);
+    REL(vsb);
+    return s_vs ? 0 : 1;
+}
+
+/* Run one program for one pixel; out[t][c]. Returns 0 on success. */
+static int run_warp(const u8* uc, u32 size, const Inputs* in, int exp32, float out[4][4])
+{
+    if (init_device()) return 1;
+    u32 nk = 0;
+    rsx_fp_set_min_targets(4);
+    int r = rsx_fp_decompile_buffered_ex(uc, size, exp32 ? 0x40u : 0u, 0, s_hlsl, sizeof s_hlsl, &nk);
+    rsx_fp_set_min_targets(1);
+    if (r <= 0) { printf("decompile failed\n"); return 1; }
+    static rsx_fp_constant_block kb;
+    const int kc = rsx_fp_collect_constants(uc, size, &kb);
+    const u32 slots = kc > 0 ? (u32)kc : 1u;
+    const u32 cbbytes = ((slots + 2u) * 16u + 255u) & ~255u;
+    u32* cb = (u32*)calloc(cbbytes, 1);
+    if (!cb) return 1;
+    if (kc > 0) memcpy(cb, kb.values, (size_t)kc * 16u);
+    cb[slots * 4u + 3u] = in->bx2;                            /* fp_alpha.w */
+    memcpy(cb + (slots + 1u) * 4u, in->texctl, 16);           /* fp_texctl */
+
+    ID3DBlob* psb = compile(s_hlsl, "ps_5_0");
+    if (!psb) { free(cb); return 1; }
+    ID3D11PixelShader* ps = NULL;
+    ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(psb), ID3D10Blob_GetBufferSize(psb), NULL, &ps);
+    REL(psb);
+
+    D3D11_BUFFER_DESC bd = {0}; bd.Usage = D3D11_USAGE_DEFAULT; bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    D3D11_SUBRESOURCE_DATA sd = {0};
+    ID3D11Buffer *vcb = NULL, *pcb = NULL;
+    bd.ByteWidth = sizeof in->vin; sd.pSysMem = in->vin; ID3D11Device_CreateBuffer(s_dev, &bd, &sd, &vcb);
+    bd.ByteWidth = cbbytes; sd.pSysMem = cb; ID3D11Device_CreateBuffer(s_dev, &bd, &sd, &pcb);
+    free(cb);
+
+    ID3D11Texture2D* tx[16] = {0}; ID3D11ShaderResourceView* srv[16] = {0}; ID3D11SamplerState* smp[16] = {0};
+    for (int u = 0; u < 16; u++) {
+        D3D11_TEXTURE2D_DESC td = {0}; td.Width = td.Height = 1; td.MipLevels = td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R32G32B32A32_FLOAT; td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_DEFAULT;
+        td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        D3D11_SUBRESOURCE_DATA ts = {0}; ts.pSysMem = in->tex[u]; ts.SysMemPitch = 16;
+        ID3D11Device_CreateTexture2D(s_dev, &td, &ts, &tx[u]);
+        ID3D11Device_CreateShaderResourceView(s_dev, (ID3D11Resource*)tx[u], NULL, &srv[u]);
+        D3D11_SAMPLER_DESC ss = {0}; ss.Filter = D3D11_FILTER_MIN_MAG_MIP_POINT;
+        ss.AddressU = ss.AddressV = ss.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP; ss.MaxLOD = D3D11_FLOAT32_MAX;
+        ss.ComparisonFunc = D3D11_COMPARISON_NEVER;
+        ID3D11Device_CreateSamplerState(s_dev, &ss, &smp[u]);
+    }
+    ID3D11Texture2D *rt[4] = {0}, *st[4] = {0}; ID3D11RenderTargetView* rtv[4] = {0};
+    for (int t = 0; t < 4; t++) {
+        D3D11_TEXTURE2D_DESC td = {0}; td.Width = td.Height = 1; td.MipLevels = td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R32G32B32A32_FLOAT; td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_DEFAULT;
+        td.BindFlags = D3D11_BIND_RENDER_TARGET;
+        ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &rt[t]);
+        ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource*)rt[t], NULL, &rtv[t]);
+        td.Usage = D3D11_USAGE_STAGING; td.BindFlags = 0; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &st[t]);
+        const float clr[4] = { -7, -7, -7, -7 };             /* a killed pixel keeps this */
+        ID3D11DeviceContext_ClearRenderTargetView(s_ctx, rtv[t], clr);
+    }
+    D3D11_RASTERIZER_DESC rd = {0}; rd.FillMode = D3D11_FILL_SOLID; rd.CullMode = D3D11_CULL_NONE; rd.DepthClipEnable = TRUE;
+    ID3D11RasterizerState* rs = NULL; ID3D11Device_CreateRasterizerState(s_dev, &rd, &rs);
+    D3D11_VIEWPORT vp = { 0, 0, 1, 1, 0, 1 };
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 4, rtv, NULL);
+    ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+    ID3D11DeviceContext_RSSetState(s_ctx, rs);
+    ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext_VSSetShader(s_ctx, s_vs, NULL, 0);
+    ID3D11DeviceContext_VSSetConstantBuffers(s_ctx, 0, 1, &vcb);
+    ID3D11DeviceContext_PSSetShader(s_ctx, ps, NULL, 0);
+    ID3D11DeviceContext_PSSetConstantBuffers(s_ctx, 1, 1, &pcb);
+    ID3D11DeviceContext_PSSetShaderResources(s_ctx, 0, 16, srv);
+    ID3D11DeviceContext_PSSetSamplers(s_ctx, 0, 16, smp);
+    ID3D11DeviceContext_Draw(s_ctx, 3, 0);
+    int rc = 0;
+    for (int t = 0; t < 4; t++) {
+        ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource*)st[t], (ID3D11Resource*)rt[t]);
+        D3D11_MAPPED_SUBRESOURCE ms;
+        if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource*)st[t], 0, D3D11_MAP_READ, 0, &ms))) { rc = 1; continue; }
+        memcpy(out[t], ms.pData, 16);
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource*)st[t], 0);
+    }
+    ID3D11DeviceContext_ClearState(s_ctx);
+    for (int t = 0; t < 4; t++) { REL(rtv[t]); REL(rt[t]); REL(st[t]); }
+    for (int u = 0; u < 16; u++) { REL(srv[u]); REL(tx[u]); REL(smp[u]); }
+    REL(rs); REL(vcb); REL(pcb); REL(ps);
+    return rc;
+}
+
+/* ---- expected values: the RPCS3 / GLSL definitions, in double ---------- */
+static double sat(double x) { return x != x ? 0.0 : x < 0.0 ? 0.0 : x > 1.0 ? 1.0 : x; }
+static double s2l(double c) { return c > 0.04045 ? pow((c + 0.055) / 1.055, 2.4) : c / 12.92; }
+static double l2s(double c) { return sat(c < 0.0031308 ? c * 12.92 : 1.055 * pow(fabs(c), 1.0 / 2.4) - 0.055); }
+static u32 pack_unorm8(const double v[4])
+{
+    u32 w = 0;
+    for (int i = 0; i < 4; i++) w |= (u32)floor(sat(v[i]) * 255.0 + 0.5) << (8 * i);
+    return w;
+}
+static u32 pack_snorm8(const double v[4])
+{
+    u32 w = 0;
+    for (int i = 0; i < 4; i++) {
+        double c = v[i] < -1.0 ? -1.0 : v[i] > 1.0 ? 1.0 : v[i];
+        w |= ((u32)(int)floor(c * 127.0 + 0.5) & 0xFFu) << (8 * i);
+    }
+    return w;
+}
+static u32 pack_unorm16(const double v[2])
+{
+    return (u32)floor(sat(v[0]) * 65535.0 + 0.5) | ((u32)floor(sat(v[1]) * 65535.0 + 0.5) << 16);
+}
+static double half_to_double(u32 h)
+{
+    const int e = (int)((h >> 10) & 31u), m = (int)(h & 1023u);
+    const double s = (h & 0x8000u) ? -1.0 : 1.0;
+    if (!e) return s * ldexp(m, -24);
+    return s * ldexp(1024 + m, e - 25);
+}
+static float asf(u32 w) { float f; memcpy(&f, &w, 4); return f; }
+static u32 asu(float f) { u32 w; memcpy(&w, &f, 4); return w; }
+
+static int s_fails, s_checks;
+static void expect4(const char* name, const float got[4], const double want[4])
+{
+    int ok = 1;
+    for (int i = 0; i < 4; i++)
+        if (!(fabs((double)got[i] - want[i]) <= 1e-4 * fmax(1.0, fabs(want[i])))) ok = 0;
+    printf("[%s] %s = (%.6f %.6f %.6f %.6f), want (%.6f %.6f %.6f %.6f)\n", ok ? "PASS" : "FAIL", name,
+           got[0], got[1], got[2], got[3], want[0], want[1], want[2], want[3]);
+    s_checks++; s_fails += !ok;
+}
+/* The value an H register holds: fp16 (NV_fragment_program 3.11.4.1;
+ * FP_HROUND, unless it is 0), through D3D's f32tof16, which rounds toward
+ * zero (measured on WARP) -- one of the "two nearest representable values"
+ * NV_fp 3.11.4.2 allows. For an export read from H. */
+static double hq(double v)
+{
+    const char* e = getenv("FP_HROUND");
+    if ((e && *e == '0') || v == 0.0 || v != v) return v;
+    int ex;
+    frexp(v, &ex);                              /* 2^(ex-1) <= |v| < 2^ex */
+    const double ulp = ldexp(1.0, ex - 11 < -24 ? -24 : ex - 11);
+    return trunc(v / ulp) * ulp;
+}
+static void expect4h(const char* name, const float got[4], const double want[4])
+{
+    const double w[4] = { hq(want[0]), hq(want[1]), hq(want[2]), hq(want[3]) };
+    expect4(name, got, w);
+}
+static void expect_bits(const char* name, const float got[4], u32 want)
+{
+    const int ok = asu(got[0]) == want && got[1] == 0.0f && got[2] == 0.0f && got[3] == 0.0f;
+    printf("[%s] %s = 0x%08X (%g %g %g), want 0x%08X\n", ok ? "PASS" : "FAIL", name, asu(got[0]),
+           got[1], got[2], got[3], want);
+    s_checks++; s_fails += !ok;
+}
+
+static int self_test(void)
+{
+    const char* fp = getenv("FP_PACK");
+    const int pack_on = !(fp && *fp == '0');
+    static Inputs in;
+    float out[4][4];
+    u8 prog[256];
+
+    /* 1. The G-buffer shape. Albedo texel = sRGB bytes (142, 124, 103, 255),
+     * normal texel (0.25, 0.75, 0.6, 0.1) on unit 1, mask (0.9, 0.95, 0.9, 1)
+     * on unit 7. Cases: fp_alpha.w nibble for unit 1, fp_texctl byte for unit
+     * 1 (bits 0-3 expand, 4-7 sRGB), and the t2 = H6 the RSX gives (.yw from
+     * the texel's G/A): _bx2 expands only its nibble's channels, overrides the
+     * unit's gamma, and a zero nibble falls back to rsx_texproc. */
+    static const struct { const char* name; unsigned bx2, tctl; double y, w; } cs[] = {
+        { "bx2 F",              0xF0u, 0x00u, 0.5,  -0.8 },
+        { "bx2 G only",         0x20u, 0x00u, 0.5,   0.1 },
+        { "bx2 R|B",            0x50u, 0x00u, 0.75,  0.1 },
+        { "bx2 off, expand",    0x00u, 0x0Fu, 0.5,  -0.8 },
+        { "bx2 F over gamma",   0xF0u, 0xF0u, 0.5,  -0.8 },
+        { "bx2 off, gamma",     0x00u, 0xF0u, -1.0, -1.0 },   /* s2l, filled in below */
+        { "bx2 off, raw",       0x00u, 0x00u, 0.75,  0.1 },
+    };
+    const u32 gsz = fpt_gbuffer(prog);
+    static const double tb[3] = { 142.0, 124.0, 103.0 };
+    double lin[4] = { 0, 0, 0, 0 }, alb[4] = { 0, 0, 0, 0 };
+    for (int i = 0; i < 3; i++) {
+        lin[i] = (double)(float)s2l(tb[i] / 255.0);
+        alb[i] = floor(l2s(lin[i]) * 255.0 + 0.5) / 255.0;   /* PKG then UPB */
+    }
+    for (u32 c = 0; c < sizeof cs / sizeof cs[0]; c++) {
+        memset(&in, 0, sizeof in);
+        in.vin[3][0] = 0.5f; in.vin[3][1] = 0.5f; in.vin[3][3] = 1.0f;            /* TC0 */
+        for (int i = 0; i < 3; i++) in.tex[0][i] = (float)(tb[i] / 255.0);
+        in.tex[0][3] = 1.0f;
+        in.tex[1][0] = 0.25f; in.tex[1][1] = 0.75f; in.tex[1][2] = 0.6f; in.tex[1][3] = 0.1f;
+        in.tex[7][0] = 0.9f;  in.tex[7][1] = 0.95f; in.tex[7][2] = 0.9f; in.tex[7][3] = 1.0f;
+        in.bx2 = cs[c].bx2;
+        in.texctl[0] = cs[c].tctl << 8;
+        if (run_warp(prog, gsz, &in, 0, out)) { printf("[FAIL] warp run\n"); return 1; }
+        char nm[96];
+        const double t0_on[4] = { alb[0], alb[1], alb[2], 0.0 }, t0_off[4] = { 0.0, (double)0.95f, 0.0, 0.0 };
+        const double t1_on[4] = { lin[0], lin[1], lin[2], 0.0 }, zero[4] = { 0, 0, 0, 0 };
+        double y = cs[c].y, w = cs[c].w;
+        if (y < -0.5) { y = s2l((double)0.75f); w = s2l((double)0.1f); }
+        const double t2[4] = { 0.0, y, 0.0, w };
+        snprintf(nm, sizeof nm, "gbuffer [%s] t0 albedo%s", cs[c].name, pack_on ? "" : " (FP_PACK=0: green)");
+        expect4h(nm, out[0], pack_on ? t0_on : t0_off);
+        snprintf(nm, sizeof nm, "gbuffer [%s] t1 linear", cs[c].name);
+        expect4h(nm, out[1], pack_on ? t1_on : zero);
+        snprintf(nm, sizeof nm, "gbuffer [%s] t2 normal", cs[c].name);
+        expect4h(nm, out[2], t2);
+        snprintf(nm, sizeof nm, "gbuffer [%s] t3", cs[c].name);
+        expect4(nm, out[3], zero);
+    }
+    if (!pack_on) {
+        printf("FP_PACK=0: per-op checks skipped\n");
+        return 0;
+    }
+
+    /* 2. Each unpack of the word 0x40C08020 (a normal float) from c[0].x. */
+    {
+        const u32 W = 0x40C08020u;
+        const float k[4] = { asf(W), 0.0f, 0.0f, 0.0f };
+        const double b[4] = { 0x20, 0x80, 0xC0, 0x40 };
+        double upb[4], upg[4], up4[4], up2[4], up16[4];
+        for (int i = 0; i < 4; i++) {
+            upb[i] = b[i] / 255.0;
+            upg[i] = s2l(upb[i]);
+            const double sb = b[i] >= 128.0 ? b[i] - 256.0 : b[i];
+            up4[i] = sb / 127.0 < -1.0 ? -1.0 : sb / 127.0;
+        }
+        up2[0] = up2[2] = half_to_double(W & 0xFFFFu); up2[1] = up2[3] = half_to_double(W >> 16);
+        up16[0] = up16[2] = (double)(W & 0xFFFFu) / 65535.0; up16[1] = up16[3] = (double)(W >> 16) / 65535.0;
+        static const struct { u32 op; const char* name; } ops[] = {
+            { FPT_OP_UPB, "UPB" }, { FPT_OP_UPG, "UPG" }, { FPT_OP_UP4, "UP4" },
+            { FPT_OP_UP2, "UP2" }, { FPT_OP_UP16, "UP16" } };
+        const double* want[] = { upb, upg, up4, up2, up16 };
+        for (int i = 0; i < 5; i++) {
+            memset(&in, 0, sizeof in);
+            const u32 sz = fpt_pack_op(prog, ops[i].op, 1, k);
+            if (run_warp(prog, sz, &in, 0, out)) { printf("[FAIL] warp run\n"); return 1; }
+            char nm[64]; snprintf(nm, sizeof nm, "%s H0, c[0] (0x%08X)", ops[i].name, W);
+            expect4h(nm, out[0], want[i]);
+        }
+    }
+
+    /* 3. Each pack, its word read back from R0.x through an fp32 export. The
+     * inputs keep every word a normal float and every channel off a .5 tie. */
+    {
+        static const struct { u32 op; const char* name; float k[4]; } ops[] = {
+            { FPT_OP_PKB,  "PKB",  { 0.2f, 0.6f, 0.8f, 0.25f } },
+            { FPT_OP_PKG,  "PKG",  { 0.2f, 0.6f, 0.8f, 0.25f } },
+            { FPT_OP_PK4,  "PK4",  { 0.3f, -0.6f, 1.0f, 0.45f } },
+            { FPT_OP_PK2,  "PK2",  { 1.5f, -2.25f, 0.0f, 0.0f } },
+            { FPT_OP_PK16, "PK16", { 0.25f, 0.75f, 0.0f, 0.0f } } };
+        for (int i = 0; i < 5; i++) {
+            double v[4], g[4];
+            for (int c = 0; c < 4; c++) { v[c] = (double)ops[i].k[c]; g[c] = l2s(v[c]); }
+            u32 want = 0;
+            switch (ops[i].op) {
+            case FPT_OP_PKB:  want = pack_unorm8(v); break;
+            case FPT_OP_PKG:  want = pack_unorm8(g); break;     /* all four channels, as RPCS3 */
+            case FPT_OP_PK4:  want = pack_snorm8(v); break;
+            case FPT_OP_PK2:  want = 0xC0803E00u; break;         /* half(1.5) | half(-2.25) << 16 */
+            default:          want = pack_unorm16(v); break;
+            }
+            memset(&in, 0, sizeof in);
+            const u32 sz = fpt_pack_op(prog, ops[i].op, 0, ops[i].k);
+            if (run_warp(prog, sz, &in, 1, out)) { printf("[FAIL] warp run\n"); return 1; }
+            char nm[64]; snprintf(nm, sizeof nm, "%s R0.x, c[0]", ops[i].name);
+            expect_bits(nm, out[0], want);
+        }
+    }
+
+    /* 4. A packed word carried in a register from PKB to UPB when its bits are
+     * a NaN (0xFFCC9933) or a denormal (0x00339933) as a float: the moves in
+     * between must not canonicalise or flush it. */
+    {
+        static const float ks[2][4] = { { 0.2f, 0.6f, 0.8f, 1.0f }, { 0.2f, 0.6f, 0.2f, 0.0f } };
+        for (int i = 0; i < 2; i++) {
+            double v[4], want[4];
+            for (int c = 0; c < 4; c++) v[c] = (double)ks[i][c];
+            const u32 w = pack_unorm8(v);
+            for (int c = 0; c < 4; c++) want[c] = (double)((w >> (8 * c)) & 0xFFu) / 255.0;
+            memset(&in, 0, sizeof in);
+            const u32 sz = fpt_pkb_upb(prog, ks[i]);
+            if (run_warp(prog, sz, &in, 0, out)) { printf("[FAIL] warp run\n"); return 1; }
+            char nm[64]; snprintf(nm, sizeof nm, "PKB->UPB via R1 (word 0x%08X)", w);
+            expect4h(nm, out[0], want);
+        }
+    }
+
+    /* 5. SRC2's abs bit: MAD R0, c, c, |c|. */
+    {
+        static const float k[4] = { -2.0f, 3.0f, -4.0f, 0.5f };
+        static const double want[4] = { 6.0, 12.0, 20.0, 0.75 };
+        memset(&in, 0, sizeof in);
+        const u32 sz = fpt_mad_src2_abs(prog, k);
+        if (run_warp(prog, sz, &in, 1, out)) { printf("[FAIL] warp run\n"); return 1; }
+        expect4("MAD R0, c, c, |c| (SRC2 abs)", out[0], want);
+    }
+    return 0;
+}
+
+/* ---- P0-4 hardware semantics, executed ---------------------------------- */
+/* Bit-for-value equal (INF included), or within tol[i] where the spec allows
+ * an approximation (tol NULL: exact everywhere). */
+static void expect_tol(const char* name, const float got[4], const float want[4], const float* tol)
+{
+    int ok = 1;
+    for (int i = 0; i < 4; i++) {
+        const int eq = got[i] == want[i] || (got[i] != got[i] && want[i] != want[i]);
+        if (!eq && !(tol && fabsf(got[i] - want[i]) <= tol[i])) ok = 0;
+    }
+    printf("[%s] %s = (%.9g %.9g %.9g %.9g), want (%.9g %.9g %.9g %.9g)\n", ok ? "PASS" : "FAIL", name,
+           got[0], got[1], got[2], got[3], want[0], want[1], want[2], want[3]);
+    s_checks++; s_fails += !ok;
+}
+#define expect_exact(n, g, w) expect_tol((n), (g), (w), NULL)
+
+#define HW_ALL       (FPT_MX | FPT_MY | FPT_MZ | FPT_MW)
+#define HW_SETCC     (1u << 8)
+#define HW_NODEST    (1u << 30)
+#define HW_PREC(p)   ((u32)(p) << 22)
+#define HW_NEG       (1u << 17)
+#define HW_SMOD(i,m) ((u32)(m) << (19 + 3 * (i)))
+#define HW_PERSP     (1u << 31)
+#define HW_IF(bits)  (((u32)(bits) << 18) | (0u << 21) | (1u << 23) | (2u << 25) | (3u << 27))
+#define HW_IF_LT     HW_IF(1u)
+#define HW_IF_GT     HW_IF(4u)
+
+/* One VP for one point at the 1x1 target's centre: o0 = c[0] there; the PS
+ * returns COL0, TEX0, TEX1, TEX2 unfiltered (nointerpolation). */
+static int run_vp_warp(const u8* uc, u32 size, const float (*c)[4], u32 nc, float out[4][4])
+{
+    if (init_device()) return 1;
+    static char vs[128 * 1024];
+    if (rsx_vp_decompile_compact_ex(uc, size, 0u, 0u, vs, sizeof vs) <= 0) { printf("vp decompile failed\n"); return 1; }
+    static const char ps_src[] =
+        "struct PSIn { float4 p : SV_Position; nointerpolation float4 col0 : COLOR0;\n"
+        "  nointerpolation float4 col1 : COLOR1; nointerpolation float4 fog : FOG;\n"
+        "  nointerpolation float4 t0 : TEXCOORD0; nointerpolation float4 t1 : TEXCOORD1;\n"
+        "  nointerpolation float4 t2 : TEXCOORD2; };\n"
+        "struct PSOut { float4 a : SV_TARGET0; float4 b : SV_TARGET1; float4 c : SV_TARGET2; float4 d : SV_TARGET3; };\n"
+        "PSOut main(PSIn i) { PSOut o; o.a = i.col0; o.b = i.t0; o.c = i.t1; o.d = i.t2; return o; }\n";
+    ID3DBlob* vb = compile(vs, "vs_5_0");
+    ID3DBlob* pb = compile(ps_src, "ps_5_0");
+    if (!vb || !pb) { REL(vb); REL(pb); return 1; }
+    ID3D11VertexShader* v = NULL; ID3D11PixelShader* p = NULL;
+    ID3D11Device_CreateVertexShader(s_dev, ID3D10Blob_GetBufferPointer(vb), ID3D10Blob_GetBufferSize(vb), NULL, &v);
+    ID3D11Device_CreatePixelShader(s_dev, ID3D10Blob_GetBufferPointer(pb), ID3D10Blob_GetBufferSize(pb), NULL, &p);
+    REL(vb); REL(pb);
+    static float cb[514][4];                   /* vp_c[512], vp_posscale, vp_posoffset */
+    memset(cb, 0, sizeof cb);
+    memcpy(cb, c, (size_t)nc * 16u);
+    cb[512][0] = cb[512][1] = cb[512][2] = 1.0f;
+    D3D11_BUFFER_DESC bd = {0}; bd.Usage = D3D11_USAGE_DEFAULT; bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    bd.ByteWidth = sizeof cb;
+    D3D11_SUBRESOURCE_DATA sd = {0}; sd.pSysMem = cb;
+    ID3D11Buffer* vcb = NULL; ID3D11Device_CreateBuffer(s_dev, &bd, &sd, &vcb);
+    ID3D11Texture2D *rt[4] = {0}, *st[4] = {0}; ID3D11RenderTargetView* rtv[4] = {0};
+    for (int t = 0; t < 4; t++) {
+        D3D11_TEXTURE2D_DESC td = {0}; td.Width = td.Height = 1; td.MipLevels = td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_R32G32B32A32_FLOAT; td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_DEFAULT;
+        td.BindFlags = D3D11_BIND_RENDER_TARGET;
+        ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &rt[t]);
+        ID3D11Device_CreateRenderTargetView(s_dev, (ID3D11Resource*)rt[t], NULL, &rtv[t]);
+        td.Usage = D3D11_USAGE_STAGING; td.BindFlags = 0; td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        ID3D11Device_CreateTexture2D(s_dev, &td, NULL, &st[t]);
+        const float clr[4] = { -7, -7, -7, -7 };
+        ID3D11DeviceContext_ClearRenderTargetView(s_ctx, rtv[t], clr);
+    }
+    D3D11_RASTERIZER_DESC rd = {0}; rd.FillMode = D3D11_FILL_SOLID; rd.CullMode = D3D11_CULL_NONE; rd.DepthClipEnable = TRUE;
+    ID3D11RasterizerState* rs = NULL; ID3D11Device_CreateRasterizerState(s_dev, &rd, &rs);
+    D3D11_VIEWPORT vp = { 0, 0, 1, 1, 0, 1 };
+    ID3D11DeviceContext_OMSetRenderTargets(s_ctx, 4, rtv, NULL);
+    ID3D11DeviceContext_RSSetViewports(s_ctx, 1, &vp);
+    ID3D11DeviceContext_RSSetState(s_ctx, rs);
+    ID3D11DeviceContext_IASetPrimitiveTopology(s_ctx, D3D11_PRIMITIVE_TOPOLOGY_POINTLIST);
+    ID3D11DeviceContext_VSSetShader(s_ctx, v, NULL, 0);
+    ID3D11DeviceContext_VSSetConstantBuffers(s_ctx, 0, 1, &vcb);
+    ID3D11DeviceContext_PSSetShader(s_ctx, p, NULL, 0);
+    ID3D11DeviceContext_Draw(s_ctx, 1, 0);
+    int rc = 0;
+    for (int t = 0; t < 4; t++) {
+        ID3D11DeviceContext_CopyResource(s_ctx, (ID3D11Resource*)st[t], (ID3D11Resource*)rt[t]);
+        D3D11_MAPPED_SUBRESOURCE ms;
+        if (FAILED(ID3D11DeviceContext_Map(s_ctx, (ID3D11Resource*)st[t], 0, D3D11_MAP_READ, 0, &ms))) { rc = 1; continue; }
+        memcpy(out[t], ms.pData, 16);
+        ID3D11DeviceContext_Unmap(s_ctx, (ID3D11Resource*)st[t], 0);
+    }
+    ID3D11DeviceContext_ClearState(s_ctx);
+    for (int t = 0; t < 4; t++) { REL(rtv[t]); REL(rt[t]); REL(st[t]); }
+    REL(rs); REL(vcb); REL(v); REL(p);
+    return rc;
+}
+
+/* VP instruction words (rsx_vp_decompiler.c header), little-endian */
+static u32 vpw(u8* p, u32 d0, u32 d1, u32 d2, u32 d3)
+{
+    const u32 w[4] = { d0, d1, d2, d3 };
+    for (int i = 0; i < 4; i++) { p[4*i] = (u8)w[i]; p[4*i+1] = (u8)(w[i] >> 8); p[4*i+2] = (u8)(w[i] >> 16); p[4*i+3] = (u8)(w[i] >> 24); }
+    return 16u;
+}
+#define VS_IDENT ((3u << 8) | (2u << 10) | (1u << 12) | (0u << 14))
+static u32 vp_vmov(u8* p, u32 dst, u32 cidx, int rel, int end)   /* MOV o[dst], c[cidx (+ A0.x)] */
+{
+    const u32 s = 3u | VS_IDENT;
+    return vpw(p, (1u << 30) | (0x3Fu << 15), (1u << 22) | (cidx << 12) | ((s >> 9) & 0xFFu), (s & 0x1FFu) << 23,
+               (end ? 1u : 0u) | ((u32)rel << 1) | (dst << 2) | (0x3Fu << 7) | (0xFu << 13));
+}
+static u32 vp_vsca(u8* p, u32 op, u32 dst, u32 smask, u32 cidx)     /* op o[dst].smask, c[cidx].x */
+{
+    const u32 s = 3u;                                                  /* .xxxx */
+    return vpw(p, 0x3Fu << 15, (op << 27) | (cidx << 12), (s >> 11) & 0x3Fu,
+               (dst << 2) | (0x3Fu << 7) | (smask << 17) | ((s & 0x7FFu) << 21));
+}
+static u32 vp_varl(u8* p, u32 cidx)                                   /* ARL A0.x, c[cidx].x */
+{
+    const u32 s = 3u;
+    return vpw(p, 0x3Fu << 15, (0x0Du << 22) | (cidx << 12) | ((s >> 9) & 0xFFu), (s & 0x1FFu) << 23,
+               (0x1Fu << 2) | (0x3Fu << 7) | (1u << 16));
+}
+
+static void hw_semantics(void)
+{
+    static Inputs in;
+    float out[4][4];
+    u8 prog[512];
+    static const char* sw[] = { "FP_SRCPREC", "FP_PERSP", "FP_DSTPREC", "FP_HROUND", "FP_CCRULE",
+                                "VP_COLSAT", "VP_SPEC" };
+    for (u32 i = 0; i < sizeof sw / sizeof sw[0]; i++) _putenv_s(sw[i], "");
+    const float INF = (float)HUGE_VAL;
+
+    /* 1. MOV R0, TEX0 [perspective_corr] with TEX0 = (8,12,16,4) at a clip w
+     * of 4: TEX0 * 1/w. D3D's SV_Position.w is that clip w. */
+    {
+        memset(&in, 0, sizeof in);
+        in.vin[3][0] = 8.0f; in.vin[3][1] = 12.0f; in.vin[3][2] = 16.0f; in.vin[3][3] = 4.0f;
+        in.vin[11][0] = 4.0f;
+        u32 sz = fpt_ins(prog, FPT_OPC(0x01) | FPT_DST(0, 0, HW_ALL) | FPT_INSRC(4) | FPT_END,
+                         FPT_INPUT | FPT_XYZW | FPT_ALWAYS, 0, HW_PERSP, NULL);
+        static const float persp[4] = { 2.0f, 3.0f, 4.0f, 1.0f }, raw[4] = { 8.0f, 12.0f, 16.0f, 4.0f };
+        if (!run_warp(prog, sz, &in, 1, out)) expect_exact("persp TEX0 * 1/w (w = 4)", out[0], persp);
+        _putenv_s("FP_PERSP", "0");
+        if (!run_warp(prog, sz, &in, 1, out)) expect_exact("persp FP_PERSP=0: raw TEX0", out[0], raw);
+        _putenv_s("FP_PERSP", "");
+        sz = fpt_ins(prog, FPT_OPC(0x01) | FPT_DST(0, 0, HW_ALL) | FPT_INSRC(4) | FPT_END,
+                     FPT_INPUT | FPT_XYZW | FPT_ALWAYS, 0, 0, NULL);
+        if (!run_warp(prog, sz, &in, 1, out)) expect_exact("persp flag clear: raw TEX0", out[0], raw);
+    }
+
+    /* 2. ADD R0, c, -sat(c) (the god-ray off-screen fade), c = (2,-1,.5,.25) */
+    {
+        static const float k[4] = { 2.0f, -1.0f, 0.5f, 0.25f };
+        static const float want[4] = { 1.0f, -1.0f, 0.0f, 0.0f }, zero[4] = { 0, 0, 0, 0 };
+        memset(&in, 0, sizeof in);
+        const u32 sz = fpt_ins(prog, FPT_OPC(0x03) | FPT_DST(0, 0, HW_ALL) | FPT_END,
+                               FPT_CONST | FPT_XYZW | FPT_ALWAYS, FPT_CONST | FPT_XYZW | HW_NEG | HW_SMOD(1, 4), 0, k);
+        if (!run_warp(prog, sz, &in, 1, out)) expect_exact("srcprec c - sat(c)", out[0], want);
+        _putenv_s("FP_SRCPREC", "0");
+        if (!run_warp(prog, sz, &in, 1, out)) expect_exact("srcprec FP_SRCPREC=0: c - c", out[0], zero);
+        _putenv_s("FP_SRCPREC", "");
+    }
+
+    /* 3. fx12 results: RCP R1.x, 0 (+INF); MUL_X_C RC.x, R1, 0 (NaN -> fx12
+     * 0 -> CC EQ); MOV R0.x (NE), 9 (not taken); MOV_X R0.yzw, (5, 5, -5) */
+    {
+        static const float k[4] = { 0.0f, 0.0f, 5.0f, -5.0f }, k9[4] = { 9.0f, 9.0f, 9.0f, 9.0f };
+        memset(&in, 0, sizeof in);
+        u32 o = 0;
+        o += fpt_ins(prog + o, FPT_OPC(0x1A) | FPT_DST(1, 0, FPT_MX), FPT_CONST | FPT_XYZW | FPT_ALWAYS, 0, 0, k);
+        o += fpt_ins(prog + o, FPT_OPC(0x02) | FPT_DST(0, 0, FPT_MX) | HW_PREC(2) | HW_SETCC | HW_NODEST,
+                     FPT_TEMP(1, 0) | FPT_SWZ(0, 0, 0, 0) | FPT_ALWAYS, FPT_CONST | FPT_SWZ(1, 1, 1, 1), 0, k);
+        o += fpt_ins(prog + o, FPT_OPC(0x01) | FPT_DST(0, 0, FPT_MX),
+                     FPT_CONST | FPT_XYZW | HW_IF(5u), 0, 0, k9);              /* NE: LT|GT */
+        o += fpt_ins(prog + o, FPT_OPC(0x01) | FPT_DST(0, 0, FPT_MY | FPT_MZ | FPT_MW) | HW_PREC(2) | FPT_END,
+                     FPT_CONST | FPT_SWZ(2, 2, 2, 3) | FPT_ALWAYS, 0, 0, k);
+        static const float want[4] = { 0.0f, 2047.0f / 1024.0f, 2047.0f / 1024.0f, -2.0f };
+        static const float off[4] = { 9.0f, 5.0f, 5.0f, -5.0f };
+        if (!run_warp(prog, o, &in, 1, out)) expect_exact("dstprec fx12 (NaN -> 0 -> CC EQ)", out[0], want);
+        _putenv_s("FP_DSTPREC", "0");
+        if (!run_warp(prog, o, &in, 1, out)) expect_exact("dstprec FP_DSTPREC=0 (NaN -> CC UN)", out[0], off);
+        _putenv_s("FP_DSTPREC", "");
+    }
+
+    /* 4. MOV H0, c: the H register holds fp16 (16-bit exports read H0) */
+    {
+        static const float k[4] = { 1.0f / 3.0f, 1e-6f, 65504.0f, 70000.0f };
+        memset(&in, 0, sizeof in);
+        const u32 sz = fpt_ins(prog, FPT_OPC(0x01) | FPT_DST(0, 1, HW_ALL) | FPT_END,
+                               FPT_CONST | FPT_XYZW | FPT_ALWAYS, 0, 0, k);
+        /* 1/3 -> 0x3555; 1e-6 is an fp16 denormal, 16.78 x 2^-24: "one of the
+         * two nearest" (NV_fp 3.11.4.2), WARP gives 16 x 2^-24 */
+        static const float r1[4] = { 0.333251953125f, 9.5367431640625e-07f, 65504.0f, 65504.0f };
+        const float r2[4] = { 0.333251953125f, 9.5367431640625e-07f, 65504.0f, INF };
+        static const float tol[4] = { 0.0f, 5.9604644775390625e-08f, 0.0f, 0.0f };   /* 2^-24 */
+        if (!run_warp(prog, sz, &in, 0, out)) expect_tol("hround H0 = fp16(c)", out[0], r1, tol);
+        _putenv_s("FP_HROUND", "2");
+        if (!run_warp(prog, sz, &in, 0, out)) expect_tol("hround=2 overflow to +INF", out[0], r2, tol);
+        _putenv_s("FP_HROUND", "0");
+        if (!run_warp(prog, sz, &in, 0, out)) expect_exact("hround=0 fp32 H0", out[0], k);
+        _putenv_s("FP_HROUND", "");
+    }
+
+    /* 5. NV_fp 3.11.4.4. MOVC RC, (1,-1,1,-1); RCP R3, 0 (+INF);
+     * MOV R3 (GT), 7; MOVC R2 (GT), -3; MOV R0 (LT), 1. A failing
+     * component keeps its old value (INF too) and its old CC. */
+    {
+        static const float kc[4] = { 1.0f, -1.0f, 1.0f, -1.0f }, k0[4] = { 0, 0, 0, 0 };
+        static const float k7[4] = { 7, 7, 7, 7 }, km3[4] = { -3, -3, -3, -3 }, k1[4] = { 1, 1, 1, 1 };
+        memset(&in, 0, sizeof in);
+        u32 o = 0;
+        o += fpt_ins(prog + o, FPT_OPC(0x01) | FPT_DST(0, 0, HW_ALL) | HW_SETCC | HW_NODEST,
+                     FPT_CONST | FPT_XYZW | FPT_ALWAYS, 0, 0, kc);
+        o += fpt_ins(prog + o, FPT_OPC(0x1A) | FPT_DST(3, 0, HW_ALL), FPT_CONST | FPT_XYZW | FPT_ALWAYS, 0, 0, k0);
+        o += fpt_ins(prog + o, FPT_OPC(0x01) | FPT_DST(3, 0, HW_ALL), FPT_CONST | FPT_XYZW | HW_IF_GT, 0, 0, k7);
+        o += fpt_ins(prog + o, FPT_OPC(0x01) | FPT_DST(2, 0, HW_ALL) | HW_SETCC,
+                     FPT_CONST | FPT_XYZW | HW_IF_GT, 0, 0, km3);
+        o += fpt_ins(prog + o, FPT_OPC(0x01) | FPT_DST(0, 0, HW_ALL) | FPT_END,
+                     FPT_CONST | FPT_XYZW | HW_IF_LT, 0, 0, k1);
+        const float t0[4] = { 1, 1, 1, 1 }, t1[4] = { -3, 0, -3, 0 }, t2[4] = { 7, INF, 7, INF };
+        const float o0[4] = { 1, 0, 1, 0 }, o2[4] = { 0, 0, 0, 0 };
+        if (!run_warp(prog, o, &in, 1, out)) {
+            expect_exact("ccrule R0 (LT on the kept CC)", out[0], t0);
+            expect_exact("ccrule R2", out[1], t1);
+            expect_exact("ccrule R3 keeps +INF", out[2], t2);
+        }
+        _putenv_s("FP_CCRULE", "0");
+        if (!run_warp(prog, o, &in, 1, out)) {
+            expect_exact("ccrule=0 R0 (CC took the old dest)", out[0], o0);
+            expect_exact("ccrule=0 R3 (lerp NaN, guarded to 0)", out[2], o2);
+        }
+        _putenv_s("FP_CCRULE", "");
+    }
+
+    /* 5b. The CC comes from the value the destination holds (NV_fp 3.11.4.4,
+     * GenerateCC(DstT)): MOVC H0.x, 1e-8 stores fp16 +0 (below half the
+     * smallest fp16 denormal, so under either rounding), the CC is EQ and
+     * MOV R0.x (EQ), 9 is taken. FP_HROUND=0 keeps 1e-8 in H0: GT, not taken. */
+    {
+        static const float ks[4] = { 1e-8f, 0, 0, 0 }, k9[4] = { 9, 9, 9, 9 };
+        memset(&in, 0, sizeof in);
+        u32 o = 0;
+        o += fpt_ins(prog + o, FPT_OPC(0x01) | FPT_DST(0, 1, FPT_MX) | HW_SETCC,
+                     FPT_CONST | FPT_XYZW | FPT_ALWAYS, 0, 0, ks);
+        o += fpt_ins(prog + o, FPT_OPC(0x01) | FPT_DST(0, 0, FPT_MX) | FPT_END,
+                     FPT_CONST | FPT_XYZW | HW_IF(2u), 0, 0, k9);           /* EQ */
+        const float taken[4] = { 9, 0, 0, 0 }, kept[4] = { 0, 0, 0, 0 };
+        if (!run_warp(prog, o, &in, 1, out)) expect_exact("ccrule CC from the stored fp16 (EQ)", out[0], taken);
+        _putenv_s("FP_HROUND", "0");
+        if (!run_warp(prog, o, &in, 1, out)) expect_exact("ccrule FP_HROUND=0: H0 = 1e-8, CC GT", out[0], kept);
+        _putenv_s("FP_HROUND", "");
+    }
+
+    /* 6. VP: COL0 clamp, RCC, RSQ(0), LG2(0), RCC(0), EXP, LOG */
+    {
+        static float c[9][4];
+        memset(c, 0, sizeof c);
+        c[0][2] = 0.5f; c[0][3] = 1.0f;                                    /* o0 */
+        c[1][0] = 2.0f; c[1][1] = -1.0f; c[1][2] = 0.5f; c[1][3] = 1.5f;   /* COL0 */
+        c[2][0] = -2.0f; c[4][0] = 2.5f; c[5][0] = -12.0f;
+        c[6][0] = 20.0f;                                                   /* A0.x */
+        c[8][0] = 11.0f; c[8][1] = 12.0f; c[8][2] = 13.0f; c[8][3] = 14.0f;
+        u32 o = 0;
+        o += vp_vmov(prog + o, 0, 0, 0, 0);
+        o += vp_vmov(prog + o, 1, 1, 0, 0);
+        o += vp_vsca(prog + o, 0x03, 7, 8u, 2);      /* RCC o7.x, c2.x  (-2)  */
+        o += vp_vsca(prog + o, 0x04, 7, 4u, 3);      /* RSQ o7.y, c3.x  (0)   */
+        o += vp_vsca(prog + o, 0x0D, 7, 2u, 3);      /* LG2 o7.z, c3.x  (0)   */
+        o += vp_vsca(prog + o, 0x03, 7, 1u, 3);      /* RCC o7.w, c3.x  (0)   */
+        o += vp_vsca(prog + o, 0x05, 8, 15u, 4);     /* EXP o8, c4.x    (2.5) */
+        o += vp_vsca(prog + o, 0x06, 9, 15u, 5);     /* LOG o9, c5.x    (-12) */
+        prog[o - 16 + 12] |= 1u;                      /* END */
+        const float col[4] = { 1.0f, 0.0f, 0.5f, 1.0f }, colr[4] = { 2.0f, -1.0f, 0.5f, 1.5f };
+        const float t0[4] = { -0.5f, INF, -INF, 18446744073709551616.0f };
+        const float ex[4] = { 4.0f, 0.5f, (float)pow(2.0, 2.5), 1.0f };
+        const float lg[4] = { 3.0f, 1.5f, (float)(log(12.0) / log(2.0)), 1.0f };
+        /* EXP/LOG z are approximations (1/2^11, NV_vp 2.14.1.11); x, y, w exact */
+        static const float ztol[4] = { 0.0f, 0.0f, 1e-5f, 0.0f }, atol[4] = { 1e-5f, 1e-5f, 1e-5f, 1e-5f };
+        if (!run_vp_warp(prog, o, (const float (*)[4])c, 9, out)) {
+            expect_exact("vp COL0 clamped per vertex", out[0], col);
+            expect_exact("vp RCC(-2), RSQ(0), LG2(0), RCC(0)", out[1], t0);
+            expect_tol("vp EXP(2.5)", out[2], ex, ztol);
+            expect_tol("vp LOG(-12)", out[3], lg, ztol);
+        }
+        _putenv_s("VP_COLSAT", "0"); _putenv_s("VP_SPEC", "0");
+        if (!run_vp_warp(prog, o, (const float (*)[4])c, 9, out)) {
+            expect_exact("vp VP_COLSAT=0 COL0 raw", out[0], colr);
+            const float e2 = (float)pow(2.0, 2.5);
+            const float exr[4] = { e2, e2, e2, e2 };
+            expect_tol("vp VP_SPEC=0 EXP replicated", out[2], exr, atol);
+        }
+        _putenv_s("VP_COLSAT", ""); _putenv_s("VP_SPEC", "");
+        /* relative read: ARL A0.x, c6.x (20); MOV o7, c[A0.x + 500] = c[520] */
+        o = 0;
+        o += vp_vmov(prog + o, 0, 0, 0, 0);
+        o += vp_varl(prog + o, 6);
+        o += vp_vmov(prog + o, 7, 500, 1, 1);
+        const float zero[4] = { 0, 0, 0, 0 };
+        if (!run_vp_warp(prog, o, (const float (*)[4])c, 9, out))
+            expect_exact("vp c[A0.x + 500] out of range = 0", out[1], zero);
+        _putenv_s("VP_SPEC", "0");
+        if (!run_vp_warp(prog, o, (const float (*)[4])c, 9, out))
+            expect_exact("vp VP_SPEC=0 wraps to c[8]", out[1], c[8]);
+        _putenv_s("VP_SPEC", "");
+    }
+}
+
+int main(int argc, char** argv)
+{
+    HMODULE m = LoadLibraryA("d3dcompiler_47.dll");
+    s_compile = m ? (PFN_Compile)GetProcAddress(m, "D3DCompile") : NULL;
+    if (!s_compile) { printf("no d3dcompiler_47.dll\n"); return 2; }
+
+    if (argc >= 3) {                                          /* driver mode */
+        static Inputs in;
+        float out[4][4];
+        static u8 buf[64 * 1024]; static char text[64 * 1024];
+        FILE* f = fopen(argv[1], "rb"); if (!f) return 2;
+        const size_t n = fread(buf, 1, sizeof buf, f); fclose(f);
+        f = fopen(argv[2], "rb"); if (!f) return 2;
+        const size_t tn = fread(text, 1, sizeof text - 1, f); fclose(f); text[tn] = 0;
+        parse_inputs(text, &in);
+        if (run_warp(buf, (u32)n, &in, argc > 3 && !strcmp(argv[3], "-exp32"), out)) return 1;
+        for (int t = 0; t < 4; t++) printf("t%d %.6f %.6f %.6f %.6f\n", t, out[t][0], out[t][1], out[t][2], out[t][3]);
+        return 0;
+    }
+
+    if (self_test()) return 1;
+    hw_semantics();
+    printf("Results: %d checks, %d failed\n", s_checks, s_fails);
+    return s_fails ? 1 : 0;
+}
