+/* RSX_RES_ARTLOG=1: a fingerprint of every graphics pipeline, sampler, swap
+ * chain and surface resource description created ([RSARTIFACT] lines; each
+ * distinct line once). Two runs -- RES_SCALE unset and RES_SCALE=1 -- must
+ * agree for every key both created (P1's artefact-identity check). */
+static u64 rs_fnv(const void* p, size_t n, u64 h)
+{
+    const unsigned char* b = (const unsigned char*)p;
+    for (size_t i = 0; p && i < n; i++) h = (h ^ b[i]) * 1099511628211ull;
+    return h;
+}
+static void rs_art_line(const char* tag, u64 key, u64 val)
+{
+    if (!s_rs.artlog) return;
+    static u64 seen[4096]; static int ns = 0;
+    const u64 k = rs_fnv(tag, strlen(tag), rs_fnv(&key, 8, rs_fnv(&val, 8, 1469598103934665603ull)));
+    for (int i = 0; i < ns; i++) if (seen[i] == k) return;
+    if (ns < 4096) seen[ns++] = k;
+    fprintf(stderr, "[RSARTIFACT] %s key=%016llX desc=%016llX%c", tag, (unsigned long long)key,
+            (unsigned long long)val, 10);
+}
+static void rs_art_pso(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, u64 key)
+{
+    if (!s_rs.artlog) return;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC c = *pd;
+    const u64 hv = rs_fnv(pd->VS.pShaderBytecode, pd->VS.BytecodeLength, 1469598103934665603ull);
+    const u64 hp = rs_fnv(pd->PS.pShaderBytecode, pd->PS.BytecodeLength, 1469598103934665603ull);
+    u64 h = rs_fnv(&hv, 8, rs_fnv(&hp, 8, 1469598103934665603ull));
+    for (UINT i = 0; i < pd->InputLayout.NumElements && pd->InputLayout.pInputElementDescs; i++) {
+        D3D12_INPUT_ELEMENT_DESC e = pd->InputLayout.pInputElementDescs[i];
+        if (e.SemanticName) h = rs_fnv(e.SemanticName, strlen(e.SemanticName), h);
+        e.SemanticName = NULL;
+        h = rs_fnv(&e, sizeof e, h);
+    }
+    c.pRootSignature = NULL; c.VS.pShaderBytecode = NULL; c.PS.pShaderBytecode = NULL;
+    c.DS.pShaderBytecode = NULL; c.HS.pShaderBytecode = NULL; c.GS.pShaderBytecode = NULL;
+    c.StreamOutput.pSODeclaration = NULL; c.StreamOutput.pBufferStrides = NULL;
+    c.InputLayout.pInputElementDescs = NULL; c.CachedPSO.pCachedBlob = NULL;
+    h = rs_fnv(&c, sizeof c, h);
+    rs_art_line("pso", key, h);   /* key: the guest-FP PSO cache key (vp_get_fp_pso) */
+}
+static void rs_art_samp(u64 code, const D3D12_SAMPLER_DESC* sd)
