+SPU_FORCEINLINE __m128i spu__fxpack(__m256i q) {                   /* the low dwords of 4 qwords */
+    return _mm256_castsi256_si128(_mm256_permutevar8x32_epi32(q, _mm256_setr_epi32(0, 2, 4, 6, 0, 2, 4, 6)));
