+/* Save states (KOBJ, M4b; engine design 4.2): the title creates no
+ * sys_rwlock, so the section saves none and asserts the table empty -- a save
+ * waits while one is live. Returns the live count, naming the first in why.
+ * Unlocked read (ppu_sysprx.cpp calls it with every guest thread parked). */
+int sys_rwlock_ss_live(char* why, size_t n)
+{
+    int live = 0, first = -1;
+    for (int i = 0; i < SYS_RWLOCK_MAX; i++)
+        if (g_sys_rwlocks[i].active) { if (first < 0) first = i; live++; }
+    if (live)
+        snprintf(why, n, "%d sys_rwlock live (id %d '%.8s'): a save cannot hold one yet",
+                 live, first + 1, g_sys_rwlocks[first].name);
+    return live;
+}
