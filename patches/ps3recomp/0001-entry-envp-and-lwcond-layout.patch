+void vm_write32(uint64_t a, uint32_t v) { for (int i = 0; i < 4; i++) vm_base[a + i] = (uint8_t)(v >> (24 - 8 * i)); }
+void vm_write64(uint64_t a, uint64_t v) { for (int i = 0; i < 8; i++) vm_base[a + i] = (uint8_t)(v >> (56 - 8 * i)); }
+struct hle { const char* name; void (*fn)(ppu_context*); };
+static hle s_hle[64];
+static int s_nhle;
+void ps3_hle_register_ctx(uint32_t, const char* name, void (*fn)(ppu_context*))
+{
+    if (s_nhle < 64) s_hle[s_nhle++] = { name, fn };
+}
+
+/* ---- the units ---- */
+extern const char* ppu_vfs_root;
+void ppu_fs_register(void);
+extern char g_sys_fs_root[512];
+int64_t sys_fs_open(ppu_context*);
+int64_t sys_fs_read(ppu_context*);
+int64_t sys_fs_close(ppu_context*);
+int64_t sys_fs_lseek(ppu_context*);
+int64_t sys_fs_opendir(ppu_context*);
+int64_t sys_fs_readdir(ppu_context*);
+void cellfs_set_root_path(const char* root);
+void cellfs_add_path_mapping(const char* ps3_prefix, const char* host_path);
+int32_t cellFsOpen(const char* path, int32_t flags, int32_t* fd, const void* arg, uint64_t size);
+int32_t cellFsClose(int32_t fd);
+int32_t cellFsRead(int32_t fd, void* buf, uint64_t nbytes, uint64_t* nread);
+int32_t cellFsLseek(int32_t fd, int64_t offset, int32_t whence, uint64_t* pos);
+int32_t cellFsOpendir(const char* path, int32_t* fd);
+int32_t cellFsReaddir(int32_t fd, void* entry, uint64_t* nread);
+}
+
+static int s_fail;
+#define CHECK(c, ...) do { if (!(c)) { s_fail++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); \
+                                       printf("\n"); } } while (0)
+
+/* ---- the files: contents known by formula ---- */
+static uint8_t pat_ab(uint64_t i) { return (uint8_t)(i * 7); }          /* a.bin, b.bin */
+static uint8_t pat_e(uint64_t i) { return (uint8_t)(i * 11 + 3); }      /* e.edat's plaintext (its cache) */
+static uint8_t pat_s(uint64_t i) { return (uint8_t)((i * 13) ^ 0x5A); } /* s.sdat's plaintext */
+static void make_file(const char* p, uint64_t n, uint8_t (*pat)(uint64_t))
+{
+    FILE* f = fopen(p, "wb");
+    for (uint64_t i = 0; i < n; i++) fputc(pat(i), f);
+    fclose(f);
+}
+static void put_be32(uint8_t* p, uint32_t v) { for (int i = 0; i < 4; i++) p[i] = (uint8_t)(v >> (24 - 8 * i)); }
+static void put_be64(uint8_t* p, uint64_t v) { for (int i = 0; i < 8; i++) p[i] = (uint8_t)(v >> (56 - 8 * i)); }
+/* The PS3's SDATA key is not part of this test: sdata_decrypt (runtime/ppu/sdata_decrypt.h) has
+ * its own copy, and this test only needs it to WRITE a container. Supply it to run the test:
+ *   PS3_SDAT_KEY=<32 hex digits>     or     a file sdat.key (16 raw bytes, or 32 hex digits)
+ * in the directory the test is started from. Without it the test prints
+ * "test_ss_fsfd: skipped: no SDAT key" and exits 0. */
+static uint8_t k_sdat_key[16];
+static int hexval(int c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; }
+static bool parse_hex16(const char* s, uint8_t out[16])
+{
+    int n = 0;
+    for (; *s && n < 32; s++) {
+        if (*s == ' ' || *s == '\r' || *s == '\n' || *s == '\t') continue;
+        const int v = hexval((unsigned char)*s);
+        if (v < 0) return false;
+        out[n / 2] = (uint8_t)(n % 2 ? (out[n / 2] | v) : (v << 4));
+        n++;
+    }
+    return n == 32;
+}
+static bool load_sdat_key(void)
+{
+    if (const char* e = getenv("PS3_SDAT_KEY")) return parse_hex16(e, k_sdat_key);
+    FILE* f = fopen("sdat.key", "rb");
+    if (!f) return false;
+    char buf[80] = {0};
+    const size_t n = fread(buf, 1, sizeof buf - 1, f);
+    fclose(f);
+    if (n == 16) { memcpy(k_sdat_key, buf, 16); return true; }
+    return parse_hex16(buf, k_sdat_key);
+}
+/* An SDATA container (NPD, self-keyed, uncompressed) of `plain` bytes of
+ * pat_s: the inverse of sdata_decrypt -- per block, the key from dev_hash
+ * and the block number, AES-CBC with the digest as IV. */
+static void make_sdata(const char* path, uint64_t plain, uint32_t bs)
+{
+    const uint64_t nb = (plain + bs - 1) / bs;
+    std::vector<uint8_t> f((size_t)(0x100 + nb * 0x10 + nb * bs), 0);
+    memcpy(&f[0], "NPD\0", 4);
+    uint8_t* digest = &f[0x40];
+    uint8_t* dev_hash = &f[0x60];
+    for (int i = 0; i < 16; i++) { digest[i] = (uint8_t)(i * 3 + 1); dev_hash[i] = (uint8_t)(i * 5 + 7); }
+    put_be32(&f[0x80], 0x01000000u);
+    put_be32(&f[0x84], bs);
+    put_be64(&f[0x88], plain);
+    uint8_t ck[16], rk[176];
+    for (int i = 0; i < 16; i++) ck[i] = dev_hash[i] ^ k_sdat_key[i];
+    sd_key_expand(ck, rk);
+    for (uint64_t bn = 0; bn < nb; bn++) {
+        uint8_t bk[16], kf[16], rkf[176], prev[16];
+        memcpy(bk, dev_hash, 12);
+        put_be32(bk + 12, (uint32_t)bn);
+        sd_encrypt_block(rk, bk, kf);
+        sd_key_expand(kf, rkf);
+        const uint64_t len = (bn == nb - 1 && plain % bs) ? plain % bs : bs;
+        const uint64_t pad = (len + 15) & ~15ull;
+        uint8_t* out = &f[(size_t)(0x100 + nb * 0x10 + bn * bs)];
+        memcpy(prev, digest, 16);
+        for (uint64_t o = 0; o < pad; o += 16) {
+            uint8_t x[16];
+            for (int i = 0; i < 16; i++) {
+                const uint64_t k = bn * bs + o + (uint64_t)i;
+                x[i] = (uint8_t)((o + (uint64_t)i < len ? pat_s(k) : 0) ^ prev[i]);
+            }
+            sd_encrypt_block(rkf, x, out + o);
+            memcpy(prev, out + o, 16);
+        }
+    }
+    FILE* fp = fopen(path, "wb");
+    fwrite(f.data(), 1, f.size(), fp);
+    fclose(fp);
+}
+static FILETIME get_mtime(const char* p)
+{
+    FILETIME t = { 0, 0 };
+    HANDLE h = CreateFileA(p, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                           OPEN_EXISTING, 0, NULL);
+    if (h != INVALID_HANDLE_VALUE) { GetFileTime(h, NULL, NULL, &t); CloseHandle(h); }
+    return t;
+}
+static void set_mtime(const char* p, FILETIME t)
+{
+    HANDLE h = CreateFileA(p, FILE_WRITE_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                           OPEN_EXISTING, 0, NULL);
+    CHECK(h != INVALID_HANDLE_VALUE, "open %s for its time", p);
+    if (h != INVALID_HANDLE_VALUE) { SetFileTime(h, NULL, NULL, &t); CloseHandle(h); }
+}
+static FILETIME later(FILETIME t, int64_t s)
+{
+    ULARGE_INTEGER u;
+    u.LowPart = t.dwLowDateTime; u.HighPart = t.dwHighDateTime;
+    u.QuadPart += (uint64_t)(s * 10000000ll);
+    FILETIME r; r.dwLowDateTime = u.LowPart; r.dwHighDateTime = u.HighPart;
+    return r;
+}
+
+/* ---- guest helpers ---- */
+static void (*hle_fn(const char* name))(ppu_context*)
+{
+    for (int i = 0; i < s_nhle; i++) if (!strcmp(s_hle[i].name, name)) return s_hle[i].fn;
+    printf("no HLE %s\n", name);
+    exit(2);
+}
+static uint32_t s_str = 0x1000;
+static uint32_t gstr(const char* s)                 /* each string at a new guest address */
+{
+    const uint32_t at = s_str;
+    strcpy((char*)vm_base + at, s);
+    s_str += (uint32_t)((strlen(s) + 16) & ~15u);
+    return at;
+}
+static uint32_t be32(uint32_t a)
+{
+    return (uint32_t)vm_base[a] << 24 | (uint32_t)vm_base[a + 1] << 16 | (uint32_t)vm_base[a + 2] << 8 | vm_base[a + 3];
+}
+static uint64_t be64(uint32_t a) { return (uint64_t)be32(a) << 32 | be32(a + 4); }
+enum : uint32_t { OUTP = 0x100, BUF = 0x20000, DIRENT = 0x30000, AIO = 0x40000 };
+
+/* one call per table: open / read n / lseek / opendir / readdir name / close */
+static ppu_context C;
+static ppu_context* ctx() { memset(&C, 0, sizeof C); return &C; }
+static int p_open(const char* path, uint32_t flags = 0, const char* fn = "cellFsOpen")
+{
+    ppu_context* c = ctx(); c->gpr[3] = gstr(path); c->gpr[4] = flags; c->gpr[5] = OUTP;
+    hle_fn(fn)(c);
+    return c->gpr[3] == 0 ? (int)be32(OUTP) : -1;
+}
+static int p_read(int fd, uint64_t n)               /* bytes read, -1: an error */
+{
+    ppu_context* c = ctx(); c->gpr[3] = (uint64_t)fd; c->gpr[4] = BUF; c->gpr[5] = n; c->gpr[6] = OUTP;
+    hle_fn("cellFsRead")(c);
+    return c->gpr[3] == 0 ? (int)be64(OUTP) : -1;
+}
+static void p_seek(int fd, int64_t off)
+{
+    ppu_context* c = ctx(); c->gpr[3] = (uint64_t)fd; c->gpr[4] = (uint64_t)off; c->gpr[5] = 0; c->gpr[6] = OUTP;
+    hle_fn("cellFsLseek")(c);
+}
+static int p_opendir(const char* path)
+{
+    ppu_context* c = ctx(); c->gpr[3] = gstr(path); c->gpr[4] = OUTP;
+    hle_fn("cellFsOpendir")(c);
+    return c->gpr[3] == 0 ? (int)be32(OUTP) : -1;
+}
+static std::string p_readdir(int fd)
+{
+    ppu_context* c = ctx(); c->gpr[3] = (uint64_t)fd; c->gpr[4] = DIRENT; c->gpr[5] = OUTP;
+    memset(vm_base + DIRENT, 0, 0x110);
+    hle_fn("cellFsReaddir")(c);
+    if (c->gpr[3] != 0) return "<error>";
+    return be64(OUTP) ? std::string((const char*)vm_base + DIRENT + 2, vm_base[DIRENT + 1]) : "<end>";
+}
+static void p_close(int fd, const char* fn = "cellFsClose") { ppu_context* c = ctx(); c->gpr[3] = (uint64_t)fd; hle_fn(fn)(c); }
+static int p_aio(int fd, uint64_t off, uint64_t n)  /* the request's id */
+{
+    vm_write32(AIO, (uint32_t)fd); vm_write64(AIO + 8, off); vm_write32(AIO + 0x10, BUF); vm_write64(AIO + 0x18, n);
+    ppu_context* c = ctx(); c->gpr[3] = AIO; c->gpr[4] = OUTP; c->gpr[5] = 0;
+    hle_fn("cellFsAioRead")(c);
+    return (int)be32(OUTP);
+}
+static int s_open(const char* path, uint32_t flags = 0)
+{
+    ppu_context* c = ctx(); c->gpr[3] = gstr(path); c->gpr[4] = flags; c->gpr[5] = OUTP;
+    return sys_fs_open(c) == 0 ? (int)be32(OUTP) : -1;
+}
+static int s_read(int fd, uint64_t n)
+{
+    ppu_context* c = ctx(); c->gpr[3] = (uint64_t)fd; c->gpr[4] = BUF; c->gpr[5] = n; c->gpr[6] = OUTP;
+    vm_write64(OUTP, ~0ull);
+    return sys_fs_read(c) == 0 ? (int)be64(OUTP) : -1;
+}
+static void s_seek(int fd, int64_t off)
+{
+    ppu_context* c = ctx(); c->gpr[3] = (uint64_t)fd; c->gpr[4] = (uint64_t)off; c->gpr[5] = 0; c->gpr[6] = OUTP;
+    sys_fs_lseek(c);
+}
+static int s_opendir(const char* path)
+{
+    ppu_context* c = ctx(); c->gpr[3] = gstr(path); c->gpr[4] = OUTP;
+    return sys_fs_opendir(c) == 0 ? (int)be32(OUTP) : -1;
+}
+static std::string s_readdir(int fd)
+{
+    ppu_context* c = ctx(); c->gpr[3] = (uint64_t)fd; c->gpr[4] = DIRENT; c->gpr[5] = OUTP;
+    memset(vm_base + DIRENT, 0, 0x110);
+    if (sys_fs_readdir(c) != 0) return "<error>";
+    return be64(OUTP) ? std::string((const char*)vm_base + DIRENT + 2, vm_base[DIRENT + 1]) : "<end>";
+}
+static void s_close(int fd) { ppu_context* c = ctx(); c->gpr[3] = (uint64_t)fd; sys_fs_close(c); }
+static int c_open(const char* path, int32_t flags = 0)
+{
+    const int32_t r = cellFsOpen((const char*)(uintptr_t)gstr(path), flags, (int32_t*)(uintptr_t)OUTP, NULL, 0);
+    return r == 0 ? (int)be32(OUTP) : -1;
+}
+static int c_read(int fd, uint64_t n)
+{
+    vm_write64(OUTP, 0);
+    const int32_t r = cellFsRead(fd, (void*)(uintptr_t)BUF, n, (uint64_t*)(uintptr_t)OUTP);
+    return r == 0 ? (int)be64(OUTP) : -1;
+}
+static int c_opendir(const char* path)
+{
+    return cellFsOpendir((const char*)(uintptr_t)gstr(path), (int32_t*)(uintptr_t)OUTP) == 0 ? (int)be32(OUTP) : -1;
+}
+static std::string c_readdir(int fd)
+{
+    memset(vm_base + DIRENT, 0, 0x110);
+    if (cellFsReaddir(fd, (void*)(uintptr_t)DIRENT, (uint64_t*)(uintptr_t)OUTP) != 0) return "<error>";
+    return be64(OUTP) ? std::string((const char*)vm_base + DIRENT + 2, vm_base[DIRENT + 1]) : "<end>";
+}
+/* the n bytes just read into BUF are the file's from `at` on */
+static bool got(uint64_t at, int n, uint8_t (*pat)(uint64_t))
+{
+    for (int i = 0; i < n; i++) if (vm_base[BUF + i] != pat(at + (uint64_t)i)) return false;
+    return true;
+}
+
+/* ---- the image ---- */
+static int capture(char* why, size_t n)
+{
+    static unsigned seq;
+    ss_capture_info ci;
+    memset(&ci, 0, sizeof ci);
+    ci.seq = ++seq;
+    ci.purpose = SS_P_SAVE;
+    uint32_t fc = 0;
+    if (ss_state_prepare(why, n) != SS_OK) return SS_E_NOMEM;
+    const int r = ss_state_capture(&ci, why, n, &fc);
+    if (r == SS_OK) ss_state_seal();
+    return r;
+}
+/* FSFD's records as a reader in another build declares them (by name) */
+typedef struct file_rec {
+    uint32_t table, fd, flags, sdata, edat; uint64_t pos, size, mtime; char path[1024], host_path[1024];
+} file_rec;
+static const ss_field k_file_f[] = {
+    SS_MEMBER(file_rec, table), SS_MEMBER(file_rec, fd), SS_MEMBER(file_rec, flags), SS_MEMBER(file_rec, sdata),
+    SS_MEMBER(file_rec, edat), SS_MEMBER(file_rec, pos), SS_MEMBER(file_rec, size), SS_MEMBER(file_rec, mtime),
+    SS_MEMBER(file_rec, path), SS_MEMBER(file_rec, host_path),
+};
+static const ss_list k_file_l = SS_LIST("files", k_file_f);
+typedef struct dir_rec { uint32_t table, fd, consumed; char path[1024], host_path[1024]; } dir_rec;
+static const ss_field k_dir_f[] = {
+    SS_MEMBER(dir_rec, table), SS_MEMBER(dir_rec, fd), SS_MEMBER(dir_rec, consumed), SS_MEMBER(dir_rec, path),
+    SS_MEMBER(dir_rec, host_path),
+};
+static const ss_list k_dir_l = SS_LIST("dirs", k_dir_f);
+/* FSFD's records in an image: files, dirs (-1: unreadable) */
+static void count(const ss_image* img, int* nf, int* nd)
+{
+    *nf = *nd = -1;
+    ss_reader r;
+    ss_recs_it it;
+    if (!img || ss_reader_open(&r, img, SS_FOURCC('F', 'S', 'F', 'D')) != SS_OK) return;
+    if (ss_recs_open(&r, &k_file_l, &it) == SS_OK) *nf = (int)it.count;
+    if (ss_recs_open(&r, &k_dir_l, &it) == SS_OK) *nd = (int)it.count;
+}
+/* LOAD img: check_image, teardown, restore, the fidelity check */
+static bool load(const ss_image* img, const char* tag)
+{
+    char why[256] = "";
+    uint32_t fc = 0;
+    int r = ss_state_check_image(img, why, sizeof why, &fc);
+    CHECK(r == SS_OK, "%s: check_image: %d %s", tag, r, why);
+    if (r != SS_OK) return false;
+    ss_state_teardown();
+    unsigned nores = 0;
+    r = ss_state_restore(img, why, sizeof why, &fc, &nores);
+    CHECK(r == SS_OK, "%s: restore: %d %s", tag, r, why);
+    if (r != SS_OK) return false;
+    r = capture(why, sizeof why);
+    CHECK(r == SS_OK, "%s: the fidelity check's capture: %s", tag, why);
+    static ss_verify_result v;
+    ss_state_verify(img, ss_image_captured(), &v);
+    bool fsfd = false;
+    for (unsigned i = 0; i < v.n; i++)
+        if (v.sec[i].fourcc == SS_FOURCC('F', 'S', 'F', 'D')) {
+            fsfd = true;
+            CHECK(v.sec[i].diffs == 0, "%s: verify FSFD: %u difference(s), first: %s", tag, v.sec[i].diffs, v.sec[i].first);
+        }
+    CHECK(fsfd, "%s: FSFD was compared", tag);
+    printf("%s: loaded; verify: %u section(s) compared, %u differ\n", tag, v.compared, v.differ);
+    return true;
+}
+/* check_image refuses img, naming each of `want` */
+static void refused(const ss_image* img, const char* tag, std::initializer_list<const char*> want)
+{
+    char why[256] = "";
+    const int r = ss_state_check_image(img, why, sizeof why, NULL);
+    bool all = r != SS_OK;
+    for (const char* w : want) all = all && strstr(why, w);
+    CHECK(all, "%s: refused (%d) naming it: '%s'", tag, r, why);
+    printf("%s: refused: %s\n", tag, why);
+}
+static void accepted(const ss_image* img, const char* tag)
+{
+    char why[256] = "";
+    const int r = ss_state_check_image(img, why, sizeof why, NULL);
+    CHECK(r == SS_OK, "%s: accepted again: %d %s", tag, r, why);
+}
+/* A corrupt copy of img: its raw bytes with the first 4-aligned u32 `from`
+ * in FSFD's data replaced by `to`, parsed again (the chunk CRCs, which a
+ * file's load checks first, are not what this is about). */
+static bool forge(const ss_image* img, uint32_t from, uint32_t to, std::vector<uint8_t>& buf, ss_image* out)
+{
+    char why[160] = "";
+    double ms = 0;
+    if (ss_image_write_file(img, "forge.p3ssraw", &ms, why, sizeof why) != SS_OK) return false;
+    FILE* f = fopen("forge.p3ssraw", "rb");
+    if (!f) return false;
+    fseek(f, 0, SEEK_END);
+    buf.resize((size_t)ftell(f));
+    fseek(f, 0, SEEK_SET);
+    const size_t n = fread(buf.data(), 1, buf.size(), f);
+    fclose(f);
+    if (n != buf.size() || ss_image_parse(out, buf.data(), buf.size(), why, sizeof why) != SS_OK) return false;
+    const ss_sec_ent* e = ss_image_section(out, SS_FOURCC('F', 'S', 'F', 'D'));
+    if (!e) return false;
+    uint8_t* p = buf.data() + out->hdr.data_off + e->offset;
+    for (uint64_t o = 0; o + 4 <= e->size; o += 4) {
+        uint32_t v;
+        memcpy(&v, p + o, 4);
+        if (v == from) { memcpy(p + o, &to, 4); return ss_image_parse(out, buf.data(), buf.size(), why, sizeof why) == SS_OK; }
+    }
+    return false;
+}
+
+int main(int argc, char** argv)
+{
+    const char* dir = argc > 1 ? argv[1] : ".";
+    if (!load_sdat_key()) {
+        printf("test_ss_fsfd: skipped: no SDAT key (set PS3_SDAT_KEY=<32 hex digits> or put sdat.key in the current directory)\n");
+        return 0;
+    }
+    if (_chdir(dir) != 0) { printf("no directory %s\n", dir); return 2; }
+    _mkdir("r");
+    _mkdir("r\\d");
+    make_file("r\\a.bin", 100000, pat_ab);
+    make_file("r\\b.bin", 5000, pat_ab);
+    make_file("r\\d\\x", 1, pat_ab);
+    make_file("r\\d\\y", 2, pat_ab);
+    make_file("r\\d\\z", 3, pat_ab);
+    { FILE* f = fopen("r\\e.edat", "wb"); fwrite("NPD\0", 1, 4, f); for (int i = 0; i < 60; i++) fputc(i, f); fclose(f); }
+    make_file("r\\e.edat.dec", 3000, pat_e);
+    set_mtime("r\\e.edat.dec", later(get_mtime("r\\e.edat"), 5));   /* the cache newer than its source */
+    make_sdata("r\\s.sdat", 0x5000, 0x4000);
+    vm_base = (uint8_t*)VirtualAlloc(NULL, 16u << 20, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    ppu_vm_size = 16u << 20;
+
+    const ss_section_ops* ops = ss_section_find(SS_FOURCC('F', 'S', 'F', 'D'));
+    CHECK(ops && ops->teardown && ops->restore && ops->check_image, "FSFD has teardown, restore and check_image");
+    ss_state_set_arena(NULL, 0);
+    CHECK(ss_state_enable(), "enable");
+    char why[256];
+    ppu_vfs_root = "r";
+    {   bool ppu_fs_fields = false;
+        for (const ss_list* const* l = ops ? ops->lists : NULL; l && *l; l++)
+            if ((*l)->name && !strcmp((*l)->name, "ppu_fs")) ppu_fs_fields = true;
+        CHECK(ppu_fs_fields, "FSFD's layout lacks ppu_fs's fields before ppu_fs_register (they must be there from static init)"); }
+    const uint64_t fsfd_layout0 = ops ? ss_section_layout_hash(ops) : 0;
+    ppu_fs_register();
+    CHECK(!ops || ss_section_layout_hash(ops) == fsfd_layout0, "ppu_fs_register moved FSFD's layout hash");
+    strcpy(g_sys_fs_root, "r");
+    cellfs_set_root_path("r");
+    cellfs_add_path_mapping("/app_home/", "");
+
+    /* ================= A ================= */
+    const int p_a = p_open("/app_home/a.bin");                     /* ppu_fs */
+    CHECK(p_aio(p_a, 0, 16) == 1, "first AIO id");
+    p_seek(p_a, 12345);
+    CHECK(p_read(p_a, 100) == 100, "ppu_fs read a");               /* -> 12445 */
+    const int p_d = p_opendir("/app_home/d");
+    p_readdir(p_d); p_readdir(p_d);                                 /* ".", ".." */
+    const int p_s = p_open("/app_home/s.sdat", 0, "cellFsSdataOpen");
+    p_seek(p_s, 0x4100);
+    CHECK(p_read(p_s, 16) == 16 && got(0x4100, 16, pat_s), "sdata plaintext through the tmpfile");   /* -> 0x4110 */
+    const int p_e = p_open("/app_home/e.edat");
+    CHECK(p_read(p_e, 7) == 7 && got(0, 7, pat_e), "EDAT served from its cache");                    /* -> 7 */
+    const int s_b = s_open("/app_home/b.bin");                     /* sys_fs */
+    CHECK(s_read(s_b, 10) == 10, "sys_fs read b");                  /* -> 10 */
+    const int s_d = s_opendir("/app_home/d");
+    for (int k = 0; k < 4; k++) s_readdir(s_d);                     /* ".", "..", "x", "y" */
+    const int s_e = s_open("/app_home/e.edat");
+    s_seek(s_e, 100);
+    const int c_a = c_open("/app_home/a.bin");                     /* libs cellFs */
+    cellFsLseek(c_a, 777, 0, (uint64_t*)(uintptr_t)OUTP);
+    const int c_d = c_opendir("/app_home/d");
+    c_readdir(c_d);                                                 /* "." */
+    printf("A: ppu_fs a=%d d=%d s=%d e=%d; sys_fs b=%d d=%d e=%d; cellFs a=%d d=%d\n", p_a, p_d, p_s, p_e, s_b, s_d,
+           s_e, c_a, c_d);
+    CHECK(p_a == 3 && p_d == 4 && p_s == 5 && p_e == 6 && s_b == 3 && s_d == 1 && s_e == 4 && c_a == 3 && c_d == 0,
+          "the fds A expects");
+    why[0] = 0;
+    CHECK(ops->check(why, sizeof why) == 0, "A: check: %s", why);
+    int r = capture(why, sizeof why);
+    CHECK(r == SS_OK, "A: capture: %s", why);
+    const ss_image* A = ss_image_hold();
+    CHECK(A != NULL, "A held");
+    int nf, nd;
+    count(A, &nf, &nd);
+    CHECK(nf == 6 && nd == 3, "A: 6 files, 3 dirs (%d, %d)", nf, nd);
+
+    /* ================= B ================= */
+    p_close(p_a);
+    p_close(p_d, "cellFsClosedir");
+    CHECK(p_open("/app_home/b.bin") == 3, "B: ppu_fs b at A's a");
+    CHECK(p_open("/app_home/a.bin") == 4, "B: ppu_fs a at A's directory");
+    CHECK(p_aio(3, 0, 8) == 2, "second AIO id");
+    p_read(p_s, 100);
+    p_close(p_e);
+    CHECK(p_open("/app_home/a.bin") == 6 && p_open("/app_home/b.bin") == 7, "B: ppu_fs 6, 7");
+    s_close(s_b);
+    CHECK(s_open("/app_home/a.bin") == 3 && s_read(3, 50) == 50, "B: sys_fs a at A's b");
+    CHECK(s_readdir(s_d) == "z", "B: sys_fs's directory read on");
+    s_close(s_e);
+    cellFsClose(c_a);
+    CHECK(c_opendir("/app_home/d") == 1, "B: cellFs dir 1");
+    c_readdir(c_d); c_readdir(c_d);
+
+    /* ================= LOAD A ================= */
+    {
+        why[0] = 0;
+        r = ss_state_check_image(A, why, sizeof why, NULL);
+        CHECK(r == SS_OK, "check_image A: %s", why);
+        ss_state_teardown();
+        CHECK(capture(why, sizeof why) == SS_OK, "capture after teardown: %s", why);
+        count(ss_image_captured(), &nf, &nd);
+        CHECK(nf == 0 && nd == 0, "teardown empties every table (%d files, %d dirs)", nf, nd);
+        CHECK(p_read(7, 1) < 0 && s_read(3, 1) < 0 && c_read(3, 1) < 0, "no fd is open after teardown");
+    }
+    load(A, "LOAD A");
+    CHECK(p_read(3, 4) == 4 && got(12445, 4, pat_ab), "ppu_fs fd 3 reads a.bin on from 12445");
+    CHECK(p_readdir(4) == "x", "ppu_fs dir fd 4 hands out its third entry");
+    CHECK(p_read(5, 16) == 16 && got(0x4110, 16, pat_s), "ppu_fs fd 5: the sdata plaintext from 0x4110");
+    CHECK(p_read(6, 4) == 4 && got(7, 4, pat_e), "ppu_fs fd 6: the EDAT cache from 7");
+    CHECK(p_read(7, 1) < 0, "ppu_fs fd 7 (B's only) is gone");
+    CHECK(p_aio(3, 0, 4) == 2, "the next AIO id is A's");
+    CHECK(s_read(3, 4) == 4 && got(10, 4, pat_ab), "sys_fs fd 3 reads b.bin on from 10");
+    CHECK(s_readdir(1) == "z", "sys_fs dir fd 1 hands out its fifth entry");
+    CHECK(s_read(4, 4) == 4 && got(100, 4, pat_e), "sys_fs fd 4: the EDAT cache from 100");
+    CHECK(c_read(3, 4) == 4 && got(777, 4, pat_ab), "cellFs fd 3 reads a.bin on from 777");
+    CHECK(c_readdir(0) == "..", "cellFs dir fd 0 hands out its second entry");
+    CHECK(c_readdir(1) == "<error>", "cellFs dir fd 1 (B's only) is gone");
+
+    /* ================= refusals (check_image on A) ================= */
+    {
+        const FILETIME ta = get_mtime("r\\a.bin");
+        set_mtime("r\\a.bin", later(ta, 3600));
+        refused(A, "a.bin touched", { "fd 3", "/app_home/a.bin", "changed on disk" });
+        set_mtime("r\\a.bin", ta);
+        accepted(A, "a.bin's time back");
+
+        const FILETIME tb = get_mtime("r\\b.bin");
+        make_file("r\\b.bin", 4999, pat_ab);
+        set_mtime("r\\b.bin", tb);
+        refused(A, "b.bin shorter", { "sys_fs fd 3", "/app_home/b.bin", "changed on disk" });
+        make_file("r\\b.bin", 5000, pat_ab);
+        set_mtime("r\\b.bin", tb);
+        accepted(A, "b.bin back");
+
+        const FILETIME te = get_mtime("r\\e.edat");
+        set_mtime("r\\e.edat", later(te, 3600));
+        refused(A, "EDAT cache stale", { "/app_home/e.edat", "EDAT cache" });
+        set_mtime("r\\e.edat", te);
+        accepted(A, "EDAT cache valid again");
+
+        DeleteFileA("r\\d\\y");
+        DeleteFileA("r\\d\\z");
+        refused(A, "directory shorter", { "sys_fs dir fd 1", "/app_home/d", "3 entries now" });
+        make_file("r\\d\\y", 2, pat_ab);
+        make_file("r\\d\\z", 3, pat_ab);
+        accepted(A, "directory back");
+
+        make_sdata("r\\s.sdat", 0x4F00, 0x4000);
+        refused(A, "sdata container changed", { "cellFs fd 5", "/app_home/s.sdat", "decrypts to" });
+        make_sdata("r\\s.sdat", 0x5000, 0x4000);
+        accepted(A, "sdata container back");
+
+        /* a corrupt record: sys_fs fd 3's key (table 1 << 16 | 3) says fd 5 */
+        {
+            std::vector<uint8_t> buf;
+            ss_image bad;
+            CHECK(forge(A, 0x00010003u, 0x00010005u, buf, &bad), "forge a key");
+            refused(&bad, "a key that is not its record's", { "files[0x10005]", "the key is not table 1, fd 3" });
+        }
+
+        /* a file open for writing: a save's check() refuses it; an image
+         * captured past it (no check here) is refused by check_image */
+        const int w = p_open("/app_home/w.bin", 1 | 0x200);      /* (ppu_fs's O_WRONLY | O_CREAT) */
+        CHECK(w > 0, "a write-open fd");
+        why[0] = 0;
+        CHECK(ops->check(why, sizeof why) == SS_REASON_FILE_WRITE, "check refuses the write-open fd: %s", why);
+        CHECK(capture(why, sizeof why) == SS_OK, "capture W: %s", why);
+        refused(ss_image_captured(), "a write-open record", { "/app_home/w.bin", "open for writing" });
+        p_close(w);
+        accepted(A, "A after all of them");
+    }
+
+    /* ================= LOAD A again, from the state the reads above left ================= */
+    load(A, "LOAD A (2)");
+    CHECK(p_read(3, 4) == 4 && got(12445, 4, pat_ab), "(2) ppu_fs fd 3 at 12445 again");
+    CHECK(s_readdir(1) == "z" && s_readdir(1) == "<end>", "(2) sys_fs dir fd 1: z, then the end");
+
+    /* ================= moved: the tree copied, every root pointed at the copy ================= */
+    {
+        r = capture(why, sizeof why);
+        CHECK(r == SS_OK, "S: capture: %s", why);
+        const ss_image* S = ss_image_hold();         /* (replaces A) */
+        _mkdir("r2");
+        _mkdir("r2\\d");
+        static const char* const files[] = { "a.bin", "b.bin", "e.edat", "e.edat.dec", "s.sdat", "d\\x", "d\\y", "d\\z" };
+        for (const char* f : files) {
+            char from[64], to[64];
+            snprintf(from, sizeof from, "r\\%s", f);
+            snprintf(to, sizeof to, "r2\\%s", f);
+            CHECK(CopyFileA(from, to, FALSE), "copy %s", f);   /* (keeps the last write) */
+        }
+        ppu_vfs_root = "r2";
+        strcpy(g_sys_fs_root, "r2");
+        cellfs_set_root_path("r2");
+        if (load(S, "LOAD moved")) {
+            CHECK(p_read(3, 4) == 4 && got(12449, 4, pat_ab), "moved: ppu_fs fd 3 at 12449, from the copy");
+            /* every stream is the copy's: the originals can go */
+            CHECK(DeleteFileA("r\\a.bin") && DeleteFileA("r\\b.bin") && DeleteFileA("r\\e.edat.dec"),
+                  "moved: no stream is left on the old tree (%lu)", GetLastError());
+        }
+    }
+
+    for (int i = 0; i < s_nchecks; i++) { char w[96] = ""; CHECK(s_checks[i](w, sizeof w) == 0, "ss_add_check %d: %s", i, w); }
+    printf(s_fail ? "test_ss_fsfd: %d FAILED\n" : "test_ss_fsfd: all passed\n", s_fail);
+    return s_fail ? 1 : 0;
+}
diff --git a/runtime/savestate/tests/test_ss_libs.c b/runtime/savestate/tests/test_ss_libs.c
new file mode 100644
index 0000000..1dd1fd7
--- /dev/null
+++ b/runtime/savestate/tests/test_ss_libs.c
@@ -0,0 +1,493 @@
+/*
+ * test_ss_libs -- save states M4c: the HLE libraries' sections (AUDI, PAD_,
+ * SUTL, MISC) through a LOAD, on the real library files (libs/), the real
+ * pad host (no physical controller: PAD_NO_HOST) and ss_state.c, each
+ * library driven through its own guest calls on a fake guest arena:
+ *
+ *   Z   nothing initialised yet: SAVE, held. cellAudio initialised and a port
+ *       opened; LOAD Z: the library is not initialised again, its mixer
+ *       (the session's) still the only one, and the guest's own
+ *       cellAudioInit afterwards succeeds without starting a second.
+ *   A   every library holds state: two audio ports and a notify key; the pad
+ *       (port settings, a motor request), a keyboard in packet mode with a
+ *       packet unread, a mouse with motion unread; sysutil callbacks, three
+ *       events and two completions queued, a disc-change callback; a
+ *       no-button dialog with its grace period running; a trophy context and
+ *       handle; an HTTP client and transaction; a NetCtl handler; the video-
+ *       out gamma; cellResc's display mode; a game-data check session; two
+ *       modules loaded. SAVE, held.
+ *   B   all of it changed: a port started, one closed, another opened; more
+ *       packets and motion; callbacks swapped, events and completions added;
+ *       the dialog closed; contexts and transactions replaced; the handler
+ *       removed; gamma, display mode, check session and module set changed.
+ *   LOAD A  check_image, teardown (every library at its boot state: checked
+ *       by a capture), restore; the fidelity check (capture again, compare:
+ *       the four sections equal); then each library answers its guest calls
+ *       as at A -- the ports' status, the packet, the callbacks and
+ *       completions delivered in A's order to A's OPDs, the dialog open, the
+ *       gamma, the display mode, the modules -- and the mixer is still one.
+ *   Q   cellAudioQuit (the host side gone: no device, no mixer), then LOAD A
+ *       again: the device made at the restore, the mixer at the release.
+ *   refusals  the parts' puts without apply -- what check_image runs before
+ *       anything stops -- on A's own records made to lie: a port number no
+ *       port has, a port record with another port's windows, an event out of
+ *       the ring's order or past its 31 entries; each refused, naming it.
+ *
+ * The coordinator is not linked: the guest clock is frozen by hand around
+ * each capture and load (the coordinator's freeze), the mixer is not parked
+ * (its ports are stopped whenever an image is taken or compared, so its
+ * reads change nothing), and the four sections' ops are called in their
+ * order. GCM_ is registered by cellSysmodule.c too: an empty part stands in
+ * for cellGcmSys.c.
+ *
+ * Build and run from external/ps3recomp (a local libstest.sh wrapper):
+ *   clang-cl /nologo /O1 /MD /std:c17 -D_CRT_SECURE_NO_WARNINGS -Iinclude -Ilibs/system -Ilibs/input
+ *            -Ilibs/audio -Ilibs/video -Ilibs/network -Ilibs/misc -Ilibs/hardware -Iruntime/ppu
+ *            runtime/savestate/tests/test_ss_libs.c runtime/savestate/ss_state.c
+ *            libs/audio/cellAudio.c libs/input/cellPad.c libs/input/cellKb.c libs/input/cellMouse.c
+ *            libs/input/pad_host_win.c libs/input/pad_hid_generic.c libs/input/pad_hid_sony.c
+ *            libs/input/pad_hid_switch.c libs/system/options.c libs/system/cellSysmodule.c
+ *            libs/system/cellSysutil.c libs/system/cellGame.c libs/system/cellMsgDialog.c
+ *            libs/system/cellSaveData.c libs/network/sceNpTrophy.c libs/network/cellHttp.c
+ *            libs/network/cellNetCtl.c libs/network/cellSsl.c libs/network/cellHttps.c libs/network/sceNp.c
+ *            libs/video/cellVideoOut.c libs/video/cellResc.c libs/video/rsx_videoout_gamma.c
+ *            libs/misc/cellOskDialog.c libs/hardware/cellCamera.c libs/hardware/cellGem.c
