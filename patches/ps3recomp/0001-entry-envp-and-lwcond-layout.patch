+/*
+ * ps3recomp - exact ZPASS reports and copy-on-sample on a real D3D12 device
+ * (WARP): rsx_report.c + rsx_d3d12_report.c, the code rsx_d3d12_backend.c runs.
+ *
+ * A. inFamous 2's sun query (T3: func_000D066C / func_00131A80): an occluder
+ *    fills the left half of a 64x64 target at depth 0.3; a 32x16 box at depth
+ *    0.5 straddling it is drawn twice with colour and depth writes off -- once
+ *    depth-tested (LESS), once with the depth test off -- each between
+ *    CLEAR_REPORT_VALUE + ZPASS enable and GET_REPORT into the title's
+ *    HOST_BUFFER records 0x14080 / 0x14090. Nothing reaches guest memory until
+ *    the consumer draw reads the records; then one measurement writes both:
+ *    the visible 16x16 = 256 samples and the whole 512, big-endian
+ *    {u64 timer, u32 count, u32 0}, as the hardware's ZPASS counter would.
+ * B. Copy-on-sample: a target is filled (0.5 red), copied with
+ *    rsx_d3d12_snapshot_copy while it stays bound, and a full-screen pass
+ *    writes copy + 0.125 into the same target (128/255 + 0.125 -> 160); then
+ *    the same again, as RT_SELFSAMPLE=2 (the default) does for the next such
+ *    draw -- the copy goes PIXEL_SHADER_RESOURCE -> COPY_DEST -> back and
+ *    holds the first pass's result: every pixel 160/255 + 0.125 -> 192, with
+ *    no read/write hazard (the debug layer, when installed, reports no error).
+ *
+ * C. REPORT_GPU (PF6): three lights in ONE list -- the box pair of A, a 32x8
+ *    box half behind the occluder, and A's pair again with the tested query
+ *    at RES_SCALE divisor 3 -- each into its own record pair, each consumer
+ *    planned and composed (rsx_rgpu_compose) right there; nothing measured.
+ *    The composed 4x2 textures, copied out, equal the CPU decoder's texels of
+ *    the records the exact path then writes (rsx_report_sync: 256/512,
+ *    192/256, 85/512). Composed again in a later list -- from the collected
+ *    samples (no query of the row's segments in that list) and, after the
+ *    delivery, from the written value -- the same texels. The pipeline is made as the game makes it: on its own
+ *    thread (rsx_rgpu_prewarm), plan_ok saying no until it is ready.
+ * D. (PF6 review) A row whose queries are not one run -- segment t, an
+ *    unrelated query, t again -- composes the collect's sum (512), and a row
+ *    with nothing pending composes memory's words.
+ *
+ * Windows only. From external/ps3recomp:
+ *   clang-cl /nologo -I include -I libs/video libs/video/tests/test_report_d3d12.c
+ *     libs/video/rsx_report.c libs/video/rsx_d3d12_report.c libs/video/rsx_texture_layout.c
+ *     d3d12.lib dxgi.lib d3dcompiler.lib dxguid.lib /Fe:T/test_report_d3d12.exe
+ */
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <d3d12.h>
+#include <d3d12sdklayers.h>
+#include <dxgi1_4.h>
+#include <d3dcompiler.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include "rsx_report.h"
+#include "rsx_d3d12_report.h"
+#include "rsx_commands.h"         /* rsx_state (C: the consumer's texture unit) */
+#include "rsx_texture_layout.h"   /* C: the CPU upload's decoder */
+
+#define W 64u
+#define H 64u
+#define PITCH 256u   /* 64 * 4 */
+
+/* ---- fakes: guest memory and the IO map (as in test_rsx_report.c) ---------- */
+uint32_t ppu_hle_inject_base = 0x20000000u;
+static uint8_t s_io[0x100000];                   /* IO 0.. at EA 0x40400000 */
+static uint8_t* host(uint64_t ea)
+{
+    if (ea >= 0x40400000u && ea + 4 <= 0x40400000u + sizeof s_io) return s_io + (ea - 0x40400000u);
+    return NULL;
+}
+uint32_t vm_read32(uint64_t a)
+{
+    const uint8_t* p = host(a);
+    return p ? ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3] : 0u;
+}
+void vm_write32(uint64_t a, uint32_t v)
+{
+    uint8_t* p = host(a);
+    if (p) { p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v; }
+}
+uint32_t cellGcmResolveIO(uint32_t io) { return io < sizeof s_io ? 0x40400000u + io : 0u; }
+uint32_t cellGcmResolveLocated(int local, uint32_t off) { return local ? 0xC0000000u + off : cellGcmResolveIO(off); }
+
+static int s_pass, s_fail;
+#define CHECK(c, ...) do { if (c) s_pass++; else { s_fail++; printf("[FAIL] line %d: ", __LINE__); \
+                           printf(__VA_ARGS__); printf("\n"); } } while (0)
+static int die(const char* what, HRESULT hr) { printf("[FAIL] %s (0x%08lX)\n", what, (unsigned long)hr); return 1; }
+
+static ID3D12Device* dev; static ID3D12CommandQueue* q; static ID3D12CommandAllocator* al;
+static ID3D12GraphicsCommandList* cl; static ID3D12Fence* fence; static UINT64 fval;
+static void run_and_wait(void)
+{
+    cl->lpVtbl->Close(cl);
+    q->lpVtbl->ExecuteCommandLists(q, 1, (ID3D12CommandList**)&cl);
+    q->lpVtbl->Signal(q, fence, ++fval);
+    HANDLE ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+    fence->lpVtbl->SetEventOnCompletion(fence, fval, ev);
+    WaitForSingleObject(ev, 20000);
+    CloseHandle(ev);
+    al->lpVtbl->Reset(al);
+    cl->lpVtbl->Reset(cl, al, NULL);
+}
+/* The backend's measure: run what is recorded, wait, hand the counts over. */
+static int s_measures;
+static int measure(void* ud, uint32_t seg_hi)
+{
+    (void)ud; (void)seg_hi;
+    s_measures++;
+    rsx_zpass_resolve(cl);
+    run_and_wait();
+    rsx_zpass_collect();
+    return 1;
+}
+
+/* C: the backend's draw_reads / plan_ok (the consumer samples unit 0; compose when the pipeline can) */
+static int c_draw_reads(void* ud, const struct rsx_state* st, uint32_t* mask)
+{
+    (void)ud; (void)st;
+    *mask = 1u;
+    return 1;
+}
+static int c_plan_ok(void* ud, int unit, uint32_t ea, uint32_t fmt, uint32_t w, uint32_t h)
+{
+    (void)ud; (void)unit; (void)ea;
+    return rsx_rgpu_ready(dev, fmt, w, h);
+}
+/* C: plan `id`'s composed texture, copied into the readback buffer at `off` (RowPitch 256). */
+static void c_copy_out(ID3D12Resource* prb, uint32_t id, UINT64 off)
+{
+    uint32_t ea = 0, fmt = 0;
+    ID3D12Resource* t = rsx_rgpu_texture(id, &ea, &fmt);
+    if (!t) return;
+    D3D12_RESOURCE_BARRIER b;
+    memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; b.Transition.pResource = t;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &b);
+    D3D12_TEXTURE_COPY_LOCATION s, d;
+    memset(&s, 0, sizeof s); memset(&d, 0, sizeof d);
+    s.pResource = t; s.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    d.pResource = prb; d.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    d.PlacedFootprint.Offset = off;
+    d.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R16G16_UNORM;
+    d.PlacedFootprint.Footprint.Width = 4; d.PlacedFootprint.Footprint.Height = 2;
+    d.PlacedFootprint.Footprint.Depth = 1; d.PlacedFootprint.Footprint.RowPitch = 256;
+    cl->lpVtbl->CopyTextureRegion(cl, &d, 0, 0, 0, &s, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &b);
+}
+
+static ID3DBlob* compile(const char* src, const char* target)
+{
+    ID3DBlob *b = NULL, *err = NULL;
+    if (FAILED(D3DCompile(src, strlen(src), NULL, NULL, NULL, "main", target, 0, 0, &b, &err))) {
+        printf("shader: %s\n", err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+        return NULL;
+    }
+    return b;
+}
+
+static ID3D12PipelineState* pso(ID3D12RootSignature* rs, ID3DBlob* vs, ID3DBlob* ps,
+                                int depth_test, int depth_write, UINT8 cmask)
+{
+    static const D3D12_INPUT_ELEMENT_DESC il[] = {
+        {"POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, 0, D3D12_INPUT_CLASSIFICATION_PER_VERTEX_DATA, 0} };
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC d;
+    memset(&d, 0, sizeof d);
+    d.pRootSignature = rs;
+    d.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs); d.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+    d.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps); d.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    d.BlendState.RenderTarget[0].RenderTargetWriteMask = cmask;
+    d.BlendState.RenderTarget[0].SrcBlend = D3D12_BLEND_ONE; d.BlendState.RenderTarget[0].DestBlend = D3D12_BLEND_ZERO;
+    d.BlendState.RenderTarget[0].BlendOp = D3D12_BLEND_OP_ADD;
+    d.BlendState.RenderTarget[0].SrcBlendAlpha = D3D12_BLEND_ONE; d.BlendState.RenderTarget[0].DestBlendAlpha = D3D12_BLEND_ZERO;
+    d.BlendState.RenderTarget[0].BlendOpAlpha = D3D12_BLEND_OP_ADD;
+    d.BlendState.RenderTarget[0].LogicOp = D3D12_LOGIC_OP_NOOP;
+    d.SampleMask = 0xFFFFFFFFu;
+    d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID; d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    d.RasterizerState.DepthClipEnable = TRUE;
+    d.DepthStencilState.DepthEnable = depth_test ? TRUE : FALSE;
+    d.DepthStencilState.DepthWriteMask = depth_write ? D3D12_DEPTH_WRITE_MASK_ALL : D3D12_DEPTH_WRITE_MASK_ZERO;
+    d.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_LESS;
+    d.InputLayout.pInputElementDescs = il; d.InputLayout.NumElements = 1;
+    d.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    d.NumRenderTargets = 1; d.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+    d.DSVFormat = DXGI_FORMAT_D32_FLOAT;
+    d.SampleDesc.Count = 1;
