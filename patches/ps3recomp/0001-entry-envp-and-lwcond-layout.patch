index 0000000..715f2a4
--- /dev/null
+++ b/libs/video/rsx_texpack_rt.h
@@ -0,0 +1,1767 @@
+/*
+ * ps3recomp - texture dump / replacement packs: the Windows runtime.
+ *
+ * Included by rsx_d3d12_backend.c (and the WARP test). Generic toolkit code:
+ * nothing here knows the title; the folders are named after the title id
+ * (cellGame's, from PARAM.SFO).
+ *
+ * Off by default, and off means off: every backend hook is behind one test of
+ * g_tp_on, which stays 0 unless TEXDUMP=1 or TEXPACK=1 (or a live setter) turns
+ * the feature on; no thread, allocation or device object exists until then.
+ *
+ * ---------------------------------------------------------------------------
+ * Threads and who owns what
+ * ---------------------------------------------------------------------------
+ *   render thread (the backend's FIFO walker)
+ *     - every tp_slot (inside VPTexSlot), the pack index (entries, maps),
+ *       every tp_rep, the dumped-hash set, the release list.
+ *     - per batch (tp_rt_batch_begin): signals its own fence on the direct
+ *       queue, takes the loader's finished uploads whose copy fence has
+ *       passed, applies a pack-folder snapshot, evicts over the VRAM budget,
+ *       releases resources both queues are done with. One GetCompletedValue
+ *       per fence per batch (critique B9).
+ *     - never waits on another thread or on the GPU (critique M4).
+ *   loader thread (below-normal priority)
+ *     - scans the pack folder (start, hot reload), decodes files (WIC PNG, our
+ *       DDS), builds mips, creates the texture and uploads it on its OWN copy
+ *       queue with its own allocators, list and fence. Its fence waits are
+ *       bounded and check for device removal (critique M8).
+ *   dump thread (below-normal priority)
+ *     - re-hashes each copied texture (a write that raced the copy drops the
+ *       job: it is retried), decodes it, writes PNG / DDS (temp file + rename,
+ *       once per hash ever), appends index.jsonl.
+ *   watcher thread (TEXPACK_HOTRELOAD=1)
+ *     - ReadDirectoryChangesW on the pack folder, 300 ms debounce, then asks
+ *       the loader for a rescan.
+ * Messages between them are small structs in SRWLOCK-guarded arrays; the
+ * render thread only ever holds a lock for a push or a swap.
+ *
+ * ---------------------------------------------------------------------------
+ * Lifetimes (critique C4/B5): a replacement texture is released only when the
+ * render thread's direct-queue fence has passed the value it signalled at the
+ * start of the first batch that no longer binds it, AND the copy fence has
+ * passed its upload. Both are fence values, so this stays right if the backend
+ * ever stops idling the GPU between batches.
+ */
+#ifndef PS3RECOMP_RSX_TEXPACK_RT_H
+#define PS3RECOMP_RSX_TEXPACK_RT_H
+#ifdef _WIN32
+
+#include "rsx_texpack_io.h"
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <time.h>
+#include <wchar.h>
+
+#include "../../include/ps3emu/options.h"   /* texture_packs / texture_dump rows */
+
+/* ---------------------------------------------------------------------------
+ * Settings: one accessor per knob (settings_manifest.txt lists them). Read
+ * from the environment once; the live ones also have a setter below.
+ * -----------------------------------------------------------------------*/
+static int tp_env_int(const char* name, int def)
+{
+    const char* e = getenv(name);
+    return (e && *e) ? atoi(e) : def;
+}
+/* The env variable, else the settings store's row (options menu; options.ini). */
+static int tp_env_or_opt(const char* name, const char* key)
+{
+    const char* e = getenv(name);
+    if (e && *e) return atoi(e) ? 1 : 0;
+    const opt_id id = opt_find(key);
+    return id >= 0 ? (opt_i(id) ? 1 : 0) : 0;
+}
+/* texture_dump: TEXDUMP=0|1, else the store's texture_dump (default 0). Live: rsx_texpack_set_dump. */
+static int tp_cfg_dump(void)        { static int v = -1; if (v < 0) v = tp_env_or_opt("TEXDUMP", "texture_dump"); return v; }
+/* texture_packs: TEXPACK=0|1, else the store's texture_packs (default 0 = PS3 original). Live: rsx_texpack_set_packs. */
+static int tp_cfg_packs(void)       { static int v = -1; if (v < 0) v = tp_env_or_opt("TEXPACK", "texture_packs"); return v; }
+/* pack folder: TEXPACK_DIR (default gamedata\textures\packs\<title id>). Restart. */
+static const char* tp_cfg_pack_dir(void) { const char* e = getenv("TEXPACK_DIR"); return (e && *e) ? e : NULL; }
+/* dump folder: TEXDUMP_DIR (default gamedata\textures\dump\<title id>). Restart. */
+static const char* tp_cfg_dump_dir(void) { const char* e = getenv("TEXDUMP_DIR"); return (e && *e) ? e : NULL; }
+/* hot reload: TEXPACK_HOTRELOAD=0|1 (default 0). Restart. */
+static int tp_cfg_hot_reload(void)  { static int v = -1; if (v < 0) v = tp_env_int("TEXPACK_HOTRELOAD", 0) ? 1 : 0; return v; }
+/* VRAM budget for replacements: TEXPACK_VRAM_MB (0 = auto: 35% of the
+ * adapter's local budget, at least 512 MB). Live: rsx_texpack_set_vram_mb. */
+static int tp_cfg_vram_mb(void)     { static int v = -1; if (v < 0) { v = tp_env_int("TEXPACK_VRAM_MB", 0); if (v < 0) v = 0; } return v; }
+/* TEXDUMP_RAW=1: dump DDS holding exactly what the uploader decodes (all guest
+ * levels, DXT blocks as-is): an identity pack. Default 0 (PNG). Restart. */
+static int tp_cfg_dump_raw(void)    { static int v = -1; if (v < 0) v = tp_env_int("TEXDUMP_RAW", 0) ? 1 : 0; return v; }
+/* TEXDUMP_WHAT=color|all (default color: colour classes only). Restart. */
+static int tp_cfg_dump_all(void)    { static int v = -1; if (v < 0) { const char* e = getenv("TEXDUMP_WHAT"); v = (e && !strcmp(e, "all")) ? 1 : 0; } return v; }
+/* TEXDUMP_BUDGET_MB: guest bytes the render thread copies for the dump per
+ * presented frame (default 8; a frame is many batches here). */
+static int tp_cfg_dump_budget_mb(void) { static int v = -1; if (v < 0) { v = tp_env_int("TEXDUMP_BUDGET_MB", 8); if (v < 1) v = 1; } return v; }
+/* TEXDUMP_MAX_MB: the dump folder's size cap (default 4096). Restart. */
+static int tp_cfg_dump_max_mb(void) { static int v = -1; if (v < 0) { v = tp_env_int("TEXDUMP_MAX_MB", 4096); if (v < 16) v = 16; } return v; }
+/* TEXPACK_MIPGEN=gamma|linear (default gamma: box filter on stored values, the
+ * PS3-era look; linear = averaged in linear light). Restart. */
+static int tp_cfg_mip_linear(void)  { static int v = -1; if (v < 0) { const char* e = getenv("TEXPACK_MIPGEN"); v = (e && !strcmp(e, "linear")) ? 1 : 0; } return v; }
+/* TEXPACK_MINIFY=mip|guest (default mip): a larger replacement of a texture
+ * the guest samples without mips gets levels [0, s] instead of level 0 only. */
+static int tp_cfg_minify_mip(void)  { static int v = -1; if (v < 0) { const char* e = getenv("TEXPACK_MINIFY"); v = (e && !strcmp(e, "guest")) ? 0 : 1; } return v; }
+/* TEXPACK_L0=1|0 (default 1): fall back to the level-0 hash when the full hash
+ * has no file (an unstable mip tail). */
+static int tp_cfg_l0(void)          { static int v = -1; if (v < 0) v = tp_env_int("TEXPACK_L0", 1) ? 1 : 0; return v; }
+/* TEXPACK_AB=<n> (debug, default 0): toggle packs every n frames, for
+ * same-process A/B captures. */
+static int tp_cfg_ab(void)          { static int v = -1; if (v < 0) { v = tp_env_int("TEXPACK_AB", 0); if (v < 0) v = 0; } return v; }
+/* TEXPACK_LOG=<n> (default 8): per-texture lines (loads, failures, dumps). */
+static int tp_cfg_log(void)         { static int v = -1; if (v < 0) v = tp_env_int("TEXPACK_LOG", 8); return v; }
+/* TEXPACK_ORDER="a|b|c": these pack folders first, in this order. */
+static const char* tp_cfg_order(void) { const char* e = getenv("TEXPACK_ORDER"); return e ? e : ""; }
+/* TEXPACK_VERIFY=1 (debug, default 0): the loader compares each same-size
+ * replacement with the guest texture it replaces (an identity pack must be
+ * identical) and logs the result. */
+static int tp_cfg_verify(void)      { static int v = -1; if (v < 0) v = tp_env_int("TEXPACK_VERIFY", 0) ? 1 : 0; return v; }
+
+/* ---------------------------------------------------------------------------
+ * Small containers
+ * -----------------------------------------------------------------------*/
+typedef struct { uint64_t* k; void** v; uint32_t cap, n; } tp_u64map;
+static void* tp_map_get(const tp_u64map* m, uint64_t k)
+{
+    if (!m->cap) return NULL;
+    if (!k) k = 1;
+    for (uint32_t i = (uint32_t)tp_hset_mix(k) & (m->cap - 1u); ; i = (i + 1u) & (m->cap - 1u)) {
+        if (m->k[i] == k) return m->v[i];
+        if (!m->k[i]) return NULL;
+    }
+}
+static int tp_map_put(tp_u64map* m, uint64_t k, void* v)
+{
+    if (!k) k = 1;
+    if ((m->n + 1u) * 4u >= m->cap * 3u) {
+        const uint32_t nc = m->cap ? m->cap * 2u : 1024u;
+        uint64_t* nk = (uint64_t*)calloc(nc, sizeof *nk);
+        void** nv = (void**)calloc(nc, sizeof *nv);
+        if (!nk || !nv) { free(nk); free(nv); return -1; }
+        for (uint32_t j = 0; j < m->cap; j++)
+            if (m->k[j])
+                for (uint32_t i = (uint32_t)tp_hset_mix(m->k[j]) & (nc - 1u); ; i = (i + 1u) & (nc - 1u))
+                    if (!nk[i]) { nk[i] = m->k[j]; nv[i] = m->v[j]; break; }
+        free(m->k); free(m->v); m->k = nk; m->v = nv; m->cap = nc;
+    }
+    for (uint32_t i = (uint32_t)tp_hset_mix(k) & (m->cap - 1u); ; i = (i + 1u) & (m->cap - 1u)) {
+        if (m->k[i] == k) { m->v[i] = v; return 0; }
+        if (!m->k[i]) { m->k[i] = k; m->v[i] = v; m->n++; return 0; }
+    }
+}
+static void tp_map_clear(tp_u64map* m) { if (m->cap) { memset(m->k, 0, m->cap * sizeof *m->k); memset(m->v, 0, m->cap * sizeof *m->v); } m->n = 0; }
+static void tp_map_free(tp_u64map* m) { free(m->k); free(m->v); memset(m, 0, sizeof *m); }
+
+/* Grow-by-doubling array push: `*arr` of `*n` elements of `sz` bytes. */
+static int tp_push(void** arr, int* n, int* cap, const void* el, size_t sz)
+{
+    if (*n == *cap) {
+        const int nc = *cap ? *cap * 2 : 64;
+        void* na = realloc(*arr, (size_t)nc * sz);
+        if (!na) return -1;
+        *arr = na; *cap = nc;
+    }
+    memcpy((uint8_t*)*arr + (size_t)*n * sz, el, sz);
+    (*n)++;
+    return 0;
+}
+
+static uint64_t tp_path_key(const wchar_t* p)
+{
+    uint64_t h = 1469598103934665603ull;
+    for (; *p; p++) { wchar_t c = *p; if (c >= L'A' && c <= L'Z') c = (wchar_t)(c + 32); if (c == L'/') c = L'\\';
+                      h = (h ^ (uint64_t)c) * 1099511628211ull; }
+    return h;
+}
+
+/* ---------------------------------------------------------------------------
+ * Pack index entries and replacements (render thread objects)
+ * -----------------------------------------------------------------------*/
+typedef struct tp_rep tp_rep;
+typedef struct tp_entry {
+    uint64_t hash, h0, pkey, mtime, size;
+    uint64_t vbytes;             /* video memory it will take (tp_file_vram_estimate), 0 = unknown */
+    uint32_t w, h, fmt;          /* the ORIGINAL's size and base format (from the name) */
+    int ln, cube, kind, prio, removed, seen;
+    uint32_t version;
+    wchar_t* path;
+    tp_rep* rep;
+} tp_entry;
+
+#define TP_DV 4
+struct tp_rep {
+    tp_entry* e;
+    ID3D12Resource* res;         /* usable resource, or NULL */
+    uint32_t dxgi, w, h, levels, faces;
+    int s;                       /* log2(scale) */
+    uint64_t bytes;
+    uint32_t last_bound;         /* batch (LRU order) */
+    uint64_t last_frame;         /* frame (s_tp.frame) it was last bound in */
+    uint32_t loaded_version;     /* entry version of res */
+    uint64_t pend;               /* VRAM estimate of its load in flight (the budget gate) */
+    int inflight, failed, desc;  /* desc: CPU descriptor block, -1 = none */
+    struct { uint32_t map, levels; int cube, valid; } dv[TP_DV];
+    uint32_t dv_next;
+};
+
+/* loader request / result */
+typedef struct {
+    tp_rep* rep; uint32_t version;
+    wchar_t* path; int kind, cls; uint32_t ow, oh; int cube;
+    tp_desc d; uint32_t off;     /* the requesting slot's texture (TEXPACK_VERIFY) */
+} tp_req;
+typedef struct {
+    tp_rep* rep; uint32_t version; int ok;
+    char err[128];
+    ID3D12Resource* res; uint32_t dxgi, w, h, levels, faces; int s; uint64_t bytes, cval;
+    double ms_read, ms_decode, ms_upload;
+} tp_res;
+/* scan record (loader -> render) */
+typedef struct {
+    wchar_t* path; uint64_t pkey, mtime, size, h0, vbytes;
+    tp_name_info ni; int prio;
+} tp_srec;
+
+/* dump job / usage note (render -> dump thread) */
+typedef struct {
+    uint8_t* buf; uint32_t bytes;
+    tp_desc d; uint64_t hash, h0;
+    tp_slot* ts; int raw, argb;
+    uint64_t frame; double t;
+    char ctx[96];
+} tp_djob;
+typedef struct {
+    uint64_t hash; uint32_t fp_id, unit, fmt, ctrl1, addr, filt;
+    uint8_t txl, at_en, at_func, at_ref;
+} tp_duse;
+typedef struct { tp_slot* ts; uint64_t hash; } tp_dretry;
+
+#define TP_DESC_BLOCKS 8192
+#define TP_DESC_LOW (TP_DESC_BLOCKS / 32)   /* free view blocks below this: tp_evict frees stale replacements */
+#define TP_RELOOKUP_PER_BATCH 256
+typedef struct {
+    int started, dead;
+    int unaligned_bc;            /* the device takes BC textures that are not whole blocks (OPTIONS8) */
+    /* live switches (render thread), and pending changes from setters */
+    int dump, packs, raw, dump_all, minify_mip, mip_linear, l0, ab, log;
+    volatile LONG set_packs, set_dump, set_vram, set_reload;   /* 0 = no change, else the value + 1 (zero-initialised
+                                                                  = no change: a setter may run before tp_rt_startup) */
+    uint64_t vram_budget, dump_budget, dump_cap;
+    wchar_t dump_dir[600], pack_dir[600];
+    char run_id[48], title[64];
+    double t0;
+    /* device */
+    ID3D12Device* dev; ID3D12CommandQueue* dq;
+    ID3D12Fence* dfence; uint64_t dval;          /* direct queue, render thread */
+    ID3D12Fence* cfence;                         /* copy queue: loader signals */
+    ID3D12DescriptorHeap* cpu_heap; SIZE_T cpu_base; UINT inc;
+    int desc_free[TP_DESC_BLOCKS]; int ndesc_free;
+    /* pack index (render thread) */
+    tp_entry** ent; int nent, capent;
+    tp_u64map by_path, by_hash, by_h0;
+    uint32_t gen, snap_seq;
+    int has_h0, npack_files;
+    uint64_t vram_used;
+    uint64_t vram_pending;                       /* estimated bytes of the loads in flight */
+    uint64_t evict_want;                         /* room the largest held-back load needs (tp_evict) */
+    tp_rep** live; int nlive, caplive;           /* reps holding a resource */
+    struct tp_rel { ID3D12Resource* r; uint64_t dval, cval; }* rel; int nrel, caprel;
+    tp_res* arr; int narr, caparr;               /* finished uploads waiting for the copy fence */
+    uint32_t relookups;                          /* this batch */
+    /* loader thread */
+    SRWLOCK lk; CONDITION_VARIABLE cv;
+    tp_req* req; int nreq, capreq;
+    tp_res* res; int nres, capres;
+    tp_srec* snap; int nsnap; int snap_ready;
+    int rescan, stop;
+    HANDLE th_loader, th_watch, th_dump;
+    /* dump thread */
+    SRWLOCK dlk; CONDITION_VARIABLE dcv;
+    tp_djob* dj; int ndj, capdj;
+    tp_duse* du; int ndu, capdu;                 /* handed to the dump thread (dlk) */
+    tp_duse* dul; int ndul, capdul;              /* render thread: this batch's new usage tuples */
+    uint64_t* ddone; int nddone, capddone;
+    tp_dretry* dret; int ndret, capdret;
+    volatile LONG64 dinflight;                   /* bytes queued, not yet written */
+    int dready_posted;
+    tp_hset dumped; int dumped_ready;
+    tp_hset useseen;                             /* usage tuples sent (render thread) */
+    uint64_t dbatch_bytes;                       /* copied for the dump this frame */
+    /* RSX-written ranges */
+    struct { uint32_t lo, hi; uint64_t frame; } rsxw[256]; volatile LONG rsxw_n;
+    uint64_t frame;
+    /* context callback ("where seen"), and the default: TEXDUMP_CTX, else the run
+     * harness's checkpoint / step variables */
+    const char* (*ctx_fn)(void);
+    char ctx_default[96];
+    /* stats (since the last [TEXPACK] line) */
+    uint32_t st_lookup, st_hit, st_hit0, st_bind, st_txl, st_load, st_fail, st_evict, st_reload, st_relook,
+             st_dumpq, st_dumpw, st_retry, st_rsx, st_uni, st_dyn, st_veto, st_held;
+    uint64_t st_loadbytes, st_dumpbytes;
+    double st_ms_decode, st_ms_upload;
+    volatile LONG st_written;                    /* dump thread */
+} tp_state;
+static tp_state s_tp;
+/* Hooks are active: set once dumping or packs were on in this process (the
+ * slots then keep their identity current even while both are switched off,
+ * so turning them on again never trusts a stale hash). */
+static volatile int g_tp_on;   /* 0 off, 1 on, 2 a setter asked: activate at the next batch */
+
+static void tp_log(const char* fmt, ...)
+{
+    char b[1024];
+    va_list ap; va_start(ap, fmt); vsnprintf(b, sizeof b, fmt, ap); va_end(ap);
+    fprintf(stderr, "[TEXPACK] %s%c", b, 10);
+}
+
+/* ---------------------------------------------------------------------------
+ * Bounded fence wait (critique M8)
+ * -----------------------------------------------------------------------*/
+static int tp_wait_fence(ID3D12Fence* f, uint64_t v, HANDLE ev, const char* what)
+{
+    if (f->lpVtbl->GetCompletedValue(f) >= v) return 0;
+    if (FAILED(f->lpVtbl->SetEventOnCompletion(f, v, ev))) return -1;
+    for (int tries = 0; tries < 5; tries++) {
+        if (WaitForSingleObject(ev, 2000) == WAIT_OBJECT_0) return 0;
+        const HRESULT rr = s_tp.dev->lpVtbl->GetDeviceRemovedReason(s_tp.dev);
+        if (rr != S_OK) {
+            tp_log("%s: device removed (0x%08lX) -- replacements stop loading", what, (unsigned long)rr);
+            s_tp.dead = 1;
+            return -1;
+        }
+        tp_log("%s: copy fence %llu not reached after %d s (at %llu)", what, (unsigned long long)v, 2 * (tries + 1),
+               (unsigned long long)f->lpVtbl->GetCompletedValue(f));
+    }
+    s_tp.dead = 1;
+    return -1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Pack folder scan (loader thread)
+ * -----------------------------------------------------------------------*/
+typedef struct { wchar_t name[260]; int prio; } tp_packdir;
+
+/* What a pack file will take in video memory, for the VRAM budget gate
+ * (tp_rt_bind): a DDS about its file size; a PNG its IHDR's width x height
+ * as RGBA8 (16-bit: 8 bytes) plus mips. Scan time, loader thread: 33 bytes
+ * read per PNG. 0 when the header cannot be read (the gate then guesses). */
+static uint64_t tp_file_vram_estimate(const wchar_t* path, int kind, uint64_t size)
+{
+    if (kind == TP_KIND_DDS) return size;
+    uint8_t hd[33]; DWORD got = 0;
+    HANDLE f = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                           OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE) return 0;
+    if (!ReadFile(f, hd, sizeof hd, &got, NULL)) got = 0;
+    CloseHandle(f);
+    uint32_t w = 0, h = 0; int depth = 0, ctype = 0;
+    if (got != sizeof hd || tp_png_ihdr(hd, sizeof hd, &w, &h, &depth, &ctype)) return 0;
+    return (uint64_t)w * h * (depth == 16 ? 8u : 4u) / 3u * 4u;
+}
+
+static void tp_scan_index_file(const wchar_t* path, tp_u64map* h0map)
+{
+    size_t n = 0; const char* err = NULL;
+    uint8_t* d = tp_read_file(path, 64ull << 20, &n, &err);
+    if (!d) return;
+    char line[4096];
+    size_t at = 0;
+    while (at < n) {
+        size_t e = at;
+        while (e < n && d[e] != '\n') e++;
+        if (e < n && e - at < sizeof line) {             /* a line without '\n' is torn: skipped */
+            memcpy(line, d + at, e - at); line[e - at] = 0;
+            uint64_t h = 0, h0 = 0;
+            if (!tp_json_hex64(line, "hash", &h) && !tp_json_hex64(line, "h0", &h0) && h0)
+                tp_map_put(h0map, h, (void*)(uintptr_t)(h0 ? h0 : 1));
+        }
+        at = e + 1;
+    }
+    free(d);
+}
+
+static void tp_scan_dir(const wchar_t* dir, int prio, int depth, tp_srec** out, int* n, int* cap, tp_u64map* h0map)
+{
+    if (depth > 8) return;
+    wchar_t pat[700];
+    if (swprintf(pat, 700, L"%ls\\*", dir) < 0) return;
+    WIN32_FIND_DATAW fd;
+    HANDLE h = FindFirstFileExW(pat, FindExInfoBasic, &fd, FindExSearchNameMatch, NULL, FIND_FIRST_EX_LARGE_FETCH);
+    if (h == INVALID_HANDLE_VALUE) return;
+    do {
+        if (fd.cFileName[0] == L'.' || fd.cFileName[0] == L'_') continue;   /* "_name": a disabled pack / folder */
+        wchar_t full[700];
+        if (swprintf(full, 700, L"%ls\\%ls", dir, fd.cFileName) < 0) continue;
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+            if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT)) tp_scan_dir(full, prio, depth + 1, out, n, cap, h0map);
+            continue;
+        }
+        if (!_wcsicmp(fd.cFileName, L"index.jsonl")) { tp_scan_index_file(full, h0map); continue; }
+        char an[260];
+        if (!WideCharToMultiByte(CP_UTF8, 0, fd.cFileName, -1, an, sizeof an, NULL, NULL)) continue;
+        tp_srec r; memset(&r, 0, sizeof r);
+        if (tp_parse_name(an, &r.ni)) continue;
+        r.path = _wcsdup(full);
+        if (!r.path) continue;
+        r.pkey = tp_path_key(full);
+        r.mtime = ((uint64_t)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime;
+        r.size = ((uint64_t)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+        r.vbytes = tp_file_vram_estimate(full, r.ni.kind, r.size);
+        r.prio = prio;
+        if (tp_push((void**)out, n, cap, &r, sizeof r)) free(r.path);
+    } while (FindNextFileW(h, &fd));
+    FindClose(h);
+}
+
+static int tp_packdir_cmp(const void* a, const void* b)
+{
+    const tp_packdir* x = (const tp_packdir*)a; const tp_packdir* y = (const tp_packdir*)b;
+    return x->prio != y->prio ? (x->prio < y->prio ? -1 : 1) : _wcsicmp(x->name, y->name);
+}
+
+/* Walk the pack root: every top-level folder is a pack (TEXPACK_ORDER first,
+ * then by name; "_name" folders are disabled); files directly in the root
+ * come last. Posts the snapshot for the render thread. */
+static void tp_scan(void)
+{
+    tp_srec* recs = NULL; int n = 0, cap = 0;
+    tp_u64map h0map; memset(&h0map, 0, sizeof h0map);
+    tp_packdir* dirs = NULL; int nd = 0, capd = 0;
+    wchar_t pat[700];
+    if (swprintf(pat, 700, L"%ls\\*", s_tp.pack_dir) >= 0) {
+        WIN32_FIND_DATAW fd;
+        HANDLE h = FindFirstFileExW(pat, FindExInfoBasic, &fd, FindExSearchNameMatch, NULL, 0);
+        if (h != INVALID_HANDLE_VALUE) {
+            do {
+                if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || fd.cFileName[0] == L'.' || fd.cFileName[0] == L'_') continue;
+                tp_packdir pd; memset(&pd, 0, sizeof pd);
+                wcsncpy(pd.name, fd.cFileName, 259);
+                pd.prio = 1000;
+                char an[260]; const char* order = tp_cfg_order(); int k = 0;
+                if (WideCharToMultiByte(CP_UTF8, 0, fd.cFileName, -1, an, sizeof an, NULL, NULL))
+                    for (const char* p = order; *p; k++) {
+                        const char* q = p; while (*q && *q != '|' && *q != ',') q++;
+                        if ((size_t)(q - p) == strlen(an) && !_strnicmp(p, an, (size_t)(q - p))) { pd.prio = k; break; }
+                        p = *q ? q + 1 : q;
+                    }
+                tp_push((void**)&dirs, &nd, &capd, &pd, sizeof pd);
+            } while (FindNextFileW(h, &fd));
+            FindClose(h);
+        }
+    }
+    if (nd) qsort(dirs, (size_t)nd, sizeof *dirs, tp_packdir_cmp);
+    for (int i = 0; i < nd; i++) {
+        wchar_t full[700];
+        if (swprintf(full, 700, L"%ls\\%ls", s_tp.pack_dir, dirs[i].name) < 0) continue;
+        tp_scan_dir(full, i + 1, 0, &recs, &n, &cap, &h0map);
+    }
+    /* root files: the lowest priority */
+    { WIN32_FIND_DATAW fd;
+      HANDLE h = FindFirstFileExW(pat, FindExInfoBasic, &fd, FindExSearchNameMatch, NULL, 0);
+      if (h != INVALID_HANDLE_VALUE) {
+          do {
+              if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+              wchar_t full[700];
+              if (swprintf(full, 700, L"%ls\\%ls", s_tp.pack_dir, fd.cFileName) < 0) continue;
+              if (!_wcsicmp(fd.cFileName, L"index.jsonl")) { tp_scan_index_file(full, &h0map); continue; }
+              char an[260];
+              if (!WideCharToMultiByte(CP_UTF8, 0, fd.cFileName, -1, an, sizeof an, NULL, NULL)) continue;
+              tp_srec r; memset(&r, 0, sizeof r);
+              if (tp_parse_name(an, &r.ni)) continue;
+              r.path = _wcsdup(full); if (!r.path) continue;
+              r.pkey = tp_path_key(full);
+              r.mtime = ((uint64_t)fd.ftLastWriteTime.dwHighDateTime << 32) | fd.ftLastWriteTime.dwLowDateTime;
+              r.size = ((uint64_t)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+              r.vbytes = tp_file_vram_estimate(full, r.ni.kind, r.size);
+              r.prio = nd + 1;
+              if (tp_push((void**)&recs, &n, &cap, &r, sizeof r)) free(r.path);
+          } while (FindNextFileW(h, &fd));
+          FindClose(h);
+      } }
+    for (int i = 0; i < n; i++) recs[i].h0 = (uint64_t)(uintptr_t)tp_map_get(&h0map, recs[i].ni.hash);
+    tp_map_free(&h0map);
+    free(dirs);
+    AcquireSRWLockExclusive(&s_tp.lk);
+    if (s_tp.snap_ready) {                         /* an unapplied older snapshot: replace it */
+        for (int i = 0; i < s_tp.nsnap; i++) free(s_tp.snap[i].path);
+        free(s_tp.snap);
+    }
+    s_tp.snap = recs; s_tp.nsnap = n; s_tp.snap_ready = 1;
+    ReleaseSRWLockExclusive(&s_tp.lk);
+    tp_log("pack scan: %d replacement files in %d pack folder(s) under %ls", n, nd, s_tp.pack_dir);
+}
+
+/* ---------------------------------------------------------------------------
+ * Loader thread: decode + upload on the copy queue
+ * -----------------------------------------------------------------------*/
+typedef struct {
+    ID3D12CommandQueue* q;
+    ID3D12CommandAllocator* al[4]; uint64_t al_val[4]; int al_i;
+    ID3D12GraphicsCommandList* list;
+    uint64_t cval;
+    HANDLE ev;
+    struct { ID3D12Resource* b; uint64_t v, bytes; } stg[64]; int nstg;
+    uint64_t stg_bytes;
+} tp_copier;
+
+static void tp_copier_collect(tp_copier* C, int wait_all)
+{
+    const uint64_t done = s_tp.cfence->lpVtbl->GetCompletedValue(s_tp.cfence);
+    int k = 0;
+    for (int i = 0; i < C->nstg; i++) {
+        if (C->stg[i].v <= done || (wait_all && !tp_wait_fence(s_tp.cfence, C->stg[i].v, C->ev, "texture pack upload"))) {
+            C->stg[i].b->lpVtbl->Release(C->stg[i].b);
+            C->stg_bytes -= C->stg[i].bytes;
+        } else C->stg[k++] = C->stg[i];
+    }
+    C->nstg = k;
+}
+
+static int tp_copier_init(tp_copier* C)
+{
+    memset(C, 0, sizeof *C);
+    D3D12_COMMAND_QUEUE_DESC qd; memset(&qd, 0, sizeof qd);
+    qd.Type = D3D12_COMMAND_LIST_TYPE_COPY;
+    if (FAILED(s_tp.dev->lpVtbl->CreateCommandQueue(s_tp.dev, &qd, &IID_ID3D12CommandQueue, (void**)&C->q))) return -1;
+    for (int i = 0; i < 4; i++)
+        if (FAILED(s_tp.dev->lpVtbl->CreateCommandAllocator(s_tp.dev, D3D12_COMMAND_LIST_TYPE_COPY,
+                   &IID_ID3D12CommandAllocator, (void**)&C->al[i]))) return -1;
+    if (FAILED(s_tp.dev->lpVtbl->CreateCommandList(s_tp.dev, 0, D3D12_COMMAND_LIST_TYPE_COPY, C->al[0], NULL,
+               &IID_ID3D12GraphicsCommandList, (void**)&C->list))) return -1;
+    C->list->lpVtbl->Close(C->list);
+    C->ev = CreateEventW(NULL, FALSE, FALSE, NULL);
+    return C->ev ? 0 : -1;
+}
+
+/* Create the replacement texture and copy `im` into it on the copy queue.
+ * No barriers: the texture is created COMMON, the copy queue promotes it to
+ * COPY_DEST and it decays to COMMON when the list completes; the direct queue
+ * then promotes it to a shader-resource state on first use (D3D12 implicit
+ * state promotion and decay for non-simultaneous-access textures). */
+static int tp_upload(tp_copier* C, const tp_img* im, ID3D12Resource** out, uint64_t* out_val, const char** err)
+{
+    *out = NULL;
+    D3D12_RESOURCE_DESC td; memset(&td, 0, sizeof td);
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = im->w; td.Height = im->h;
+    td.DepthOrArraySize = (UINT16)im->faces; td.MipLevels = (UINT16)im->levels;
+    td.Format = (DXGI_FORMAT)im->dxgi; td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    ID3D12Resource* tex = NULL;
+    HRESULT hr = s_tp.dev->lpVtbl->CreateCommittedResource(s_tp.dev, &hp, (D3D12_HEAP_FLAGS)0x1000 /* CREATE_NOT_ZEROED */,
+                     &td, D3D12_RESOURCE_STATE_COMMON, NULL, &IID_ID3D12Resource, (void**)&tex);
+    if (FAILED(hr))
+        hr = s_tp.dev->lpVtbl->CreateCommittedResource(s_tp.dev, &hp, D3D12_HEAP_FLAG_NONE, &td,
+                     D3D12_RESOURCE_STATE_COMMON, NULL, &IID_ID3D12Resource, (void**)&tex);
+    if (FAILED(hr) || !tex) { *err = "CreateCommittedResource failed (out of video memory?)"; return -1; }
+    const UINT nsub = im->faces * im->levels;
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp[TP_MAX_SUB]; UINT nrows[TP_MAX_SUB]; UINT64 rsz[TP_MAX_SUB]; UINT64 total = 0;
+    s_tp.dev->lpVtbl->GetCopyableFootprints(s_tp.dev, &td, 0, nsub, 0, fp, nrows, rsz, &total);
+    /* staging: bounded in flight (256 MB) */
+    tp_copier_collect(C, 0);
+    while ((C->stg_bytes + total > (256ull << 20) && C->nstg) || C->nstg >= 64) {
+        if (tp_wait_fence(s_tp.cfence, C->stg[0].v, C->ev, "texture pack upload")) { tex->lpVtbl->Release(tex); *err = "copy queue stalled"; return -1; }
+        tp_copier_collect(C, 0);
+    }
+    D3D12_HEAP_PROPERTIES hu; memset(&hu, 0, sizeof hu); hu.Type = D3D12_HEAP_TYPE_UPLOAD;
+    D3D12_RESOURCE_DESC bd; memset(&bd, 0, sizeof bd);
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = total; bd.Height = 1; bd.DepthOrArraySize = 1;
+    bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* stg = NULL;
+    if (FAILED(s_tp.dev->lpVtbl->CreateCommittedResource(s_tp.dev, &hu, D3D12_HEAP_FLAG_NONE, &bd,
+               D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&stg)) || !stg) {
+        tex->lpVtbl->Release(tex); *err = "staging buffer failed"; return -1;
+    }
+    uint8_t* map = NULL; D3D12_RANGE nr = {0, 0};
+    if (FAILED(stg->lpVtbl->Map(stg, 0, &nr, (void**)&map)) || !map) {
+        stg->lpVtbl->Release(stg); tex->lpVtbl->Release(tex); *err = "staging map failed"; return -1;
+    }
+    for (UINT i = 0; i < nsub; i++) {
+        const uint32_t m = i % im->levels;
+        const uint32_t rb = im->row_bytes[m];
+        const uint32_t cp = (uint64_t)rb <= rsz[i] ? rb : (uint32_t)rsz[i];
+        for (UINT r = 0; r < nrows[i] && r < im->rows[m]; r++)
+            memcpy(map + fp[i].Offset + (uint64_t)r * fp[i].Footprint.RowPitch, im->sub[i] + (size_t)r * rb, cp);
+    }
+    D3D12_RANGE wr = {0, (SIZE_T)total};
+    stg->lpVtbl->Unmap(stg, 0, &wr);
+    /* allocator: reusable once its last list completed */
+    const int ai = C->al_i; C->al_i = (C->al_i + 1) & 3;
+    if (C->al_val[ai] && tp_wait_fence(s_tp.cfence, C->al_val[ai], C->ev, "texture pack upload")) {
+        stg->lpVtbl->Release(stg); tex->lpVtbl->Release(tex); *err = "copy queue stalled"; return -1;
+    }
+    C->al[ai]->lpVtbl->Reset(C->al[ai]);
+    C->list->lpVtbl->Reset(C->list, C->al[ai], NULL);
+    for (UINT i = 0; i < nsub; i++) {
+        D3D12_TEXTURE_COPY_LOCATION dst, src;
+        memset(&dst, 0, sizeof dst); memset(&src, 0, sizeof src);
+        dst.pResource = tex; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; dst.SubresourceIndex = i;
+        src.pResource = stg; src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT; src.PlacedFootprint = fp[i];
+        C->list->lpVtbl->CopyTextureRegion(C->list, &dst, 0, 0, 0, &src, NULL);
+    }
+    if (FAILED(C->list->lpVtbl->Close(C->list))) {
+        stg->lpVtbl->Release(stg); tex->lpVtbl->Release(tex); *err = "copy list close failed"; return -1;
+    }
+    ID3D12CommandList* lists[1] = { (ID3D12CommandList*)C->list };
+    C->q->lpVtbl->ExecuteCommandLists(C->q, 1, lists);
+    const uint64_t v = ++C->cval;
+    C->q->lpVtbl->Signal(C->q, s_tp.cfence, v);
+    C->al_val[ai] = v;
+    C->stg[C->nstg].b = stg; C->stg[C->nstg].v = v; C->stg[C->nstg].bytes = total; C->nstg++;
+    C->stg_bytes += total;
+    *out = tex; *out_val = v;
+    return 0;
+}
+
+static double tp_ms(void) { return tc_now() * 1e3; }
+static void tp_verify(const tp_req* q, const tp_img* im, int s);
+
+static void tp_load(tp_copier* C, const tp_req* q, tp_res* r)
+{
+    memset(r, 0, sizeof *r);
+    r->rep = q->rep; r->version = q->version;
+    const char* err = NULL;
+    const double t0 = tp_ms();
+    size_t n = 0;
+    uint8_t* d = tp_read_file(q->path, TP_MAX_FILE_BYTES, &n, &err);
+    const double t1 = tp_ms();
+    r->ms_read = t1 - t0;
+    if (!d) { snprintf(r->err, sizeof r->err, "%s", err); return; }
+    tp_img im;
+    if (tp_img_load(d, n, q->kind, q->cls, s_tp.mip_linear, &im, &err)) { free(d); snprintf(r->err, sizeof r->err, "%s", err); return; }
+    int s = 0;
+    if (tp_img_fits_ex(&im, q->ow, q->oh, q->cube, s_tp.unaligned_bc, &s, &err)) {
+        const uint32_t fw = im.w, fh = im.h; const int fcube = im.faces == 6;
+        tp_img_free(&im); free(d);
+        snprintf(r->err, sizeof r->err, "%s (file %ux%u%s, texture %ux%u)", err, fw, fh, fcube ? " cube" : "", q->ow, q->oh);
+        return;
+    }
+    if (tp_cfg_verify()) tp_verify(q, &im, s);
+    const double t2 = tp_ms();
+    r->ms_decode = t2 - t1;
+    ID3D12Resource* res = NULL; uint64_t v = 0;
+    if (s_tp.dead || s_tp.stop || tp_upload(C, &im, &res, &v, &err)) {   /* (stop: the device may be going away) */
+        tp_img_free(&im); free(d);
+        snprintf(r->err, sizeof r->err, "%s", s_tp.dead ? "device lost" : s_tp.stop ? "shutting down" : err);
+        return;
+    }
+    r->ms_upload = tp_ms() - t2;
+    r->ok = 1; r->res = res; r->cval = v;
+    r->dxgi = im.dxgi; r->w = im.w; r->h = im.h; r->levels = im.levels; r->faces = im.faces; r->s = s;
+    r->bytes = tp_img_bytes(&im);
+    tp_img_free(&im);
+    free(d);
+}
+
+static DWORD WINAPI tp_loader_main(void* arg)
+{
+    (void)arg;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    tp_copier C;
+    if (tp_copier_init(&C)) { tp_log("copy queue creation failed: replacements disabled"); s_tp.dead = 1; return 0; }
+    tp_scan();
+    for (;;) {
+        AcquireSRWLockExclusive(&s_tp.lk);
+        while (!s_tp.stop && !s_tp.nreq && !s_tp.rescan)
+            SleepConditionVariableSRW(&s_tp.cv, &s_tp.lk, 500, 0);
+        if (s_tp.stop) { ReleaseSRWLockExclusive(&s_tp.lk); break; }
+        const int rescan = s_tp.rescan; s_tp.rescan = 0;
+        tp_req q; int have = 0;
+        if (!rescan && s_tp.nreq) { q = s_tp.req[--s_tp.nreq]; have = 1; }   /* newest first */
+        ReleaseSRWLockExclusive(&s_tp.lk);
+        if (rescan) { tp_scan(); continue; }
+        if (!have) continue;
+        tp_res r;
+        tp_load(&C, &q, &r);
+        free(q.path);
+        AcquireSRWLockExclusive(&s_tp.lk);
+        if (tp_push((void**)&s_tp.res, &s_tp.nres, &s_tp.capres, &r, sizeof r) && r.res) r.res->lpVtbl->Release(r.res);
+        ReleaseSRWLockExclusive(&s_tp.lk);
+        tp_copier_collect(&C, 0);
+    }
+    tp_copier_collect(&C, 1);
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Hot reload watcher
+ * -----------------------------------------------------------------------*/
+static DWORD WINAPI tp_watch_main(void* arg)
+{
+    (void)arg;
+    HANDLE dir = CreateFileW(s_tp.pack_dir, FILE_LIST_DIRECTORY, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                             NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OVERLAPPED, NULL);
+    if (dir == INVALID_HANDLE_VALUE) { tp_log("hot reload: cannot watch %ls", s_tp.pack_dir); return 0; }
+    OVERLAPPED ov; memset(&ov, 0, sizeof ov);
+    ov.hEvent = CreateEventW(NULL, TRUE, FALSE, NULL);
+    static __declspec(align(8)) uint8_t buf[32768];
+    int armed = 0, pending = 0; ULONGLONG last = 0;
+    while (!s_tp.stop) {
+        if (!armed) {
+            ResetEvent(ov.hEvent);
+            if (!ReadDirectoryChangesW(dir, buf, sizeof buf, TRUE, FILE_NOTIFY_CHANGE_FILE_NAME | FILE_NOTIFY_CHANGE_DIR_NAME |
+                                       FILE_NOTIFY_CHANGE_LAST_WRITE | FILE_NOTIFY_CHANGE_SIZE, NULL, &ov, NULL)) break;
+            armed = 1;
+        }
+        const DWORD w = WaitForSingleObject(ov.hEvent, pending ? 100 : 500);
+        if (w == WAIT_OBJECT_0) {
+            DWORD got = 0; GetOverlappedResult(dir, &ov, &got, FALSE);
+            armed = 0; pending = 1; last = GetTickCount64();
+            continue;
+        }
+        if (pending && GetTickCount64() - last >= 300) {     /* editors save via temp + rename: debounce */
+            pending = 0;
+            AcquireSRWLockExclusive(&s_tp.lk); s_tp.rescan = 1; ReleaseSRWLockExclusive(&s_tp.lk);
+            WakeConditionVariable(&s_tp.cv);
+        }
+    }
+    if (armed) CancelIoEx(dir, &ov);
+    CloseHandle(ov.hEvent);
+    CloseHandle(dir);
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Dump thread
+ * -----------------------------------------------------------------------*/
+static HANDLE s_tp_index_h = INVALID_HANDLE_VALUE;
+static uint64_t s_tp_dump_disk;      /* dump thread */
+static tp_hset s_tp_dwritten;        /* dump thread: keys written or present */
+static tp_hset s_tp_duses;           /* dump thread: usage tuples written this run */
+static tp_u64map s_tp_dusen;         /* dump thread: usage lines per hash */
+
+static void tp_json_escape(const char* s, char* out, size_t n)
+{
+    size_t o = 0;
+    for (; *s && o + 3 < n; s++) {
+        const unsigned char c = (unsigned char)*s;
+        if (c < 0x20) continue;
+        if (c == '"' || c == '\\') out[o++] = '\\';
+        out[o++] = (char)c;
+    }
+    out[o] = 0;
+}
+
+static void tp_index_append(const char* line)
+{
+    if (s_tp_index_h == INVALID_HANDLE_VALUE) return;
+    DWORD w = 0;
+    WriteFile(s_tp_index_h, line, (DWORD)strlen(line), &w, NULL);   /* FILE_APPEND_DATA: atomic at EOF */
+}
+
+static uint64_t tp_dir_bytes(const wchar_t* dir, int depth)
+{
+    if (depth > 4) return 0;
+    wchar_t pat[700]; uint64_t t = 0;
+    if (swprintf(pat, 700, L"%ls\\*", dir) < 0) return 0;
+    WIN32_FIND_DATAW fd;
+    HANDLE h = FindFirstFileExW(pat, FindExInfoBasic, &fd, FindExSearchNameMatch, NULL, FIND_FIRST_EX_LARGE_FETCH);
+    if (h == INVALID_HANDLE_VALUE) return 0;
+    do {
+        if (fd.cFileName[0] == L'.') continue;
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+            wchar_t full[700];
+            if (swprintf(full, 700, L"%ls\\%ls", dir, fd.cFileName) >= 0) t += tp_dir_bytes(full, depth + 1);
+        } else t += ((uint64_t)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+    } while (FindNextFileW(h, &fd));
+    FindClose(h);
+    return t;
+}
+
+/* Start of the dump thread: what was dumped before (index.jsonl records of
+ * this decoder version whose file still exists), the folder's size. */
+static void tp_dump_load_index(void)
+{
+    wchar_t ip[700];
+    swprintf(ip, 700, L"%ls\\index.jsonl", s_tp.dump_dir);
+    size_t n = 0; const char* err = NULL;
+    uint8_t* d = tp_read_file(ip, 256ull << 20, &n, &err);
+    uint64_t* keys = NULL; int nk = 0, ck = 0;
+    if (d) {
+        char line[4096];
+        size_t at = 0;
+        while (at < n) {
+            size_t e = at;
+            while (e < n && d[e] != '\n') e++;
+            if (e < n && e - at < sizeof line) {
+                memcpy(line, d + at, e - at); line[e - at] = 0;
+                uint64_t h = 0; long long dec = 0; char file[400];
+                if (!tp_json_hex64(line, "hash", &h) && !tp_json_int(line, "dec", &dec) && dec == TP_DECODER_VERSION &&
+                    !tp_json_str(line, "file", file, sizeof file)) {
+                    wchar_t wf[400], full[1100];
+                    tp_widen(file, wf, 400);
+                    for (wchar_t* p = wf; *p; p++) if (*p == L'/') *p = L'\\';
+                    swprintf(full, 1100, L"%ls\\%ls", s_tp.dump_dir, wf);
+                    if (tp_file_exists(full)) {
+                        const uint64_t k = tp_dump_key(h);
+                        if (tp_hset_add(&s_tp_dwritten, k) == 1) tp_push((void**)&keys, &nk, &ck, &k, sizeof k);
+                    }
+                }
+            }
+            at = e + 1;
+        }
+        free(d);
+    }
+    s_tp_dump_disk = tp_dir_bytes(s_tp.dump_dir, 0);
+    s_tp_index_h = CreateFileW(ip, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_ALWAYS,
+                               FILE_ATTRIBUTE_NORMAL, NULL);
+    AcquireSRWLockExclusive(&s_tp.dlk);
+    for (int i = 0; i < nk; i++) tp_push((void**)&s_tp.ddone, &s_tp.nddone, &s_tp.capddone, &keys[i], sizeof keys[i]);
+    s_tp.dready_posted = 1;
+    ReleaseSRWLockExclusive(&s_tp.dlk);
+    free(keys);
+    tp_log("dump: %d textures already in %ls (%.1f MB on disk, cap %d MB)", nk, s_tp.dump_dir,
+           (double)s_tp_dump_disk / 1048576.0, tp_cfg_dump_max_mb());
+}
+
+/* Decode face f level m of a guest texture into tight rows of the class's
+ * DXGI format (what the uploader puts in the resource). */
+static uint8_t* tp_decode_level(const tp_layout* L, const uint8_t* base, uint32_t f, uint32_t m, int argb, uint32_t* rb, uint32_t* rows)
+{
+    const rsx_tex_level* lv = &L->lv[m];
+    *rb = lv->tl.dst_row_bytes; *rows = lv->tl.rows;
+    uint8_t* d = (uint8_t*)malloc((size_t)*rb * *rows ? (size_t)*rb * *rows : 1u);
+    if (!d) return NULL;
+    rsx_texture_decode(d, *rb, base + (size_t)f * L->face_stride + lv->offset, lv->w, lv->h, &lv->tl, argb);
+    return d;
+}
+
+/* TEXPACK_VERIFY=1 (loader thread, debug): a same-size replacement against
+ * the guest texture it replaces, read from guest memory now. A file in the
+ * class's own format (an identity DDS from TEXDUMP_RAW=1) is compared level
+ * by level, every face; a PNG of a DXT texture by its level 0 against the
+ * dump's CPU decode of the guest blocks. "identical" proves the whole chain
+ * name -> hash -> file -> texels. (The guest may rewrite the texture while
+ * this reads it: a mismatch on a dynamic texture is not a pack error.) */
+static volatile LONG s_tp_ver_same, s_tp_ver_diff;
+static void tp_verify(const tp_req* q, const tp_img* im, int s)
+{
+    extern uint8_t* vm_base;
+    tp_layout L;
+    char path[300]; WideCharToMultiByte(CP_UTF8, 0, q->path, -1, path, sizeof path, NULL, NULL);
+    const char* name = strrchr(path, '\\') ? strrchr(path, '\\') + 1 : path;
+    if (s != 0 || !vm_base || tp_layout_of(&q->d, &L) || (uint64_t)q->off + L.guest_span > 0x100000000ull) {
+        if (s) tp_log("verify %s: not checked (a %s replacement)", name, s > 0 ? "larger" : "smaller");
+        else tp_log("verify %s: not checked (no guest texture)", name);
+        return;
+    }
+    const int cls = tp_class_of(q->d.fmt);
+    const int bc = cls == TP_CLS_BC1 ? 1 : cls == TP_CLS_BC2 ? 2 : cls == TP_CLS_BC3 ? 3 : 0;
+    const int same = im->dxgi == tp_class_dxgi(cls), bcpng = !same && bc && im->dxgi == TP_DXGI_R8G8B8A8_UNORM;
+    if (!same && !bcpng) { tp_log("verify %s: not checked (format %u)", name, im->dxgi); return; }
+    /* a DDS in the class's format: every level; a PNG: level 0 (its mips are generated) */
+    const int raw = same && q->kind == TP_KIND_DDS;
+    const uint32_t nlv = raw ? (im->levels < L.glv ? im->levels : L.glv) : 1u;
+    const uint8_t* base = vm_base + q->off;
+    uint32_t nsub = 0, bad = 0, fbad = 0, mbad = 0;
+    for (uint32_t f = 0; f < L.nfaces && f < im->faces; f++)
+        for (uint32_t m = 0; m < nlv; m++) {
+            uint32_t rb = 0, rows = 0;
+            uint8_t* g = tp_decode_level(&L, base, f, m, rsx_texture_argb_is_rgba(), &rb, &rows);
+            if (!g) return;
+            const uint8_t* want = g; uint8_t* rgba = NULL; size_t nb = (size_t)rb * rows;
+            if (bcpng) {
+                const uint32_t w = L.lv[m].w, h = L.lv[m].h;
+                rgba = (uint8_t*)malloc((size_t)w * h * 4);
+                if (!rgba) { free(g); return; }
+                tp_bc_decode(rgba, w * 4, g, w, h, bc);
+                want = rgba; nb = (size_t)w * h * 4;
+            }
+            const uint64_t have = (uint64_t)im->row_bytes[m] * im->rows[m];
+            nsub++;
+            if (have != nb || memcmp(im->sub[f * im->levels + m], want, nb)) { if (!bad) { fbad = f; mbad = m; } bad++; }
+            free(rgba); free(g);
+        }
+    const LONG ns = bad ? s_tp_ver_same : InterlockedIncrement(&s_tp_ver_same);
+    const LONG nd = bad ? InterlockedIncrement(&s_tp_ver_diff) : s_tp_ver_diff;
+    if (bad) tp_log("verify %s: DIFFERS from the guest texture (%u of %u subresources, first face %u level %u) [%ld identical, %ld differ]",
+                    name, bad, nsub, fbad, mbad, (long)ns, (long)nd);
+    else tp_log("verify %s: identical to the guest texture (%u subresource%s%s) [%ld identical, %ld differ]", name, nsub,
+                nsub == 1 ? "" : "s", raw ? "" : bcpng ? ", level 0 vs the CPU decode of the DXT blocks" : ", level 0", (long)ns, (long)nd);
+}
+
+static void tp_dump_one(tp_djob* j)
+{
+    tp_layout L;
+    if (tp_layout_of(&j->d, &L) || j->bytes < L.guest_span) return;
+    uint64_t full = 0, h0 = 0;
+    if (tp_hashes(&L, j->buf, &full, &h0)) return;
+    if (full != j->hash) {                       /* a write raced the copy: try again later */
+        tp_dretry rt; rt.ts = j->ts; rt.hash = j->hash;
+        AcquireSRWLockExclusive(&s_tp.dlk); tp_push((void**)&s_tp.dret, &s_tp.ndret, &s_tp.capdret, &rt, sizeof rt);
+        ReleaseSRWLockExclusive(&s_tp.dlk);
+        return;
+    }
+    const uint64_t key = tp_dump_key(full);
+    if (tp_hset_has(&s_tp_dwritten, key)) goto done;
+    if (s_tp_dump_disk > (uint64_t)tp_cfg_dump_max_mb() << 20) {
+        static int w = 0; if (!w++) tp_log("dump: the folder reached TEXDUMP_MAX_MB (%d MB): no more textures are written", tp_cfg_dump_max_mb());
+        return;
+    }
+    {
+    const int cls = tp_class_of(j->d.fmt);
+    const int dds = j->raw || j->d.cube || cls == TP_CLS_F16X2 || cls == TP_CLS_F16X4 || cls == TP_CLS_F32 || cls == TP_CLS_F32X4;
+    const char* fmtn = tp_fmt_name(j->d.fmt);
+    char name[160], rel[200];
+    tp_make_name(name, sizeof name, &j->d, full, dds ? ".dds" : ".png");
+    snprintf(rel, sizeof rel, "%s/%s", fmtn ? fmtn : "UNK", name);
+    wchar_t wdir[700], wpath[1100], wn[200];
+    swprintf(wdir, 700, L"%ls\\%hs", s_tp.dump_dir, fmtn ? fmtn : "UNK");
+    tp_mkdirs(wdir);
+    tp_widen(name, wn, 200);
+    swprintf(wpath, 1100, L"%ls\\%ls", wdir, wn);
+    uint8_t* file = NULL; size_t fn = 0;
+    if (dds) {
+        const uint32_t dxgi = tp_class_dxgi(cls);
+        uint64_t total = 148;
+        for (uint32_t m = 0; m < L.glv; m++) total += (uint64_t)L.lv[m].tl.dst_row_bytes * L.lv[m].tl.rows * L.nfaces;
+        if (total > (512ull << 20)) return;
+        file = (uint8_t*)malloc((size_t)total);
+        if (!file) return;
+        size_t at = tp_dds_header(file, dxgi, j->d.w, j->d.h, L.glv, j->d.cube);
+        for (uint32_t f = 0; f < L.nfaces; f++)
+            for (uint32_t m = 0; m < L.glv; m++) {
+                uint32_t rb, rows;
+                uint8_t* lvd = tp_decode_level(&L, j->buf, f, m, j->argb, &rb, &rows);
+                if (!lvd) { free(file); return; }
+                memcpy(file + at, lvd, (size_t)rb * rows); at += (size_t)rb * rows;
+                free(lvd);
+            }
+        fn = at;
+    } else {
+        uint32_t rb, rows;
+        uint8_t* lvd = tp_decode_level(&L, j->buf, 0, 0, j->argb, &rb, &rows);
+        if (!lvd) return;
+        const uint32_t w = j->d.w, h = j->d.h;
+        if (cls == TP_CLS_R8) file = tp_png_encode(&GUID_WICPixelFormat8bppGray, w, h, rb, lvd, &fn);
+        else if (cls == TP_CLS_R16) file = tp_png_encode(&GUID_WICPixelFormat16bppGray, w, h, rb, lvd, &fn);
+        else if (cls == TP_CLS_R16G16) {
+            uint16_t* p = (uint16_t*)malloc((size_t)w * h * 8);
+            if (p) {
+                for (uint32_t y = 0; y < h; y++) for (uint32_t x = 0; x < w; x++) {
+                    const uint16_t* s = (const uint16_t*)(lvd + (size_t)y * rb) + x * 2;
+                    uint16_t* o = p + ((size_t)y * w + x) * 4; o[0] = s[0]; o[1] = s[1]; o[2] = 0; o[3] = 0xFFFF; }
+                file = tp_png_encode(&GUID_WICPixelFormat64bppRGBA, w, h, w * 8, p, &fn);
+                free(p);
+            }
+        } else {
+            uint8_t* bgra = (uint8_t*)malloc((size_t)w * h * 4);
+            if (bgra) {
+                if (cls == TP_CLS_BC1 || cls == TP_CLS_BC2 || cls == TP_CLS_BC3) {
+                    tp_bc_decode(bgra, w * 4, lvd, w, h, cls == TP_CLS_BC1 ? 1 : cls == TP_CLS_BC2 ? 2 : 3);
+                    for (size_t i = 0; i < (size_t)w * h; i++) { const uint8_t t = bgra[i * 4]; bgra[i * 4] = bgra[i * 4 + 2]; bgra[i * 4 + 2] = t; }
+                } else
+                    for (uint32_t y = 0; y < h; y++) for (uint32_t x = 0; x < w; x++) {
+                        uint8_t* o = bgra + ((size_t)y * w + x) * 4;
+                        if (cls == TP_CLS_RGBA8) { const uint8_t* s = lvd + (size_t)y * rb + x * 4; o[0] = s[2]; o[1] = s[1]; o[2] = s[0]; o[3] = s[3]; }
+                        else { const uint8_t* s = lvd + (size_t)y * rb + x * 2; o[0] = 0; o[1] = s[1]; o[2] = s[0]; o[3] = 255; }   /* R8G8: (R, G) */
+                    }
+                file = tp_png_encode(&GUID_WICPixelFormat32bppBGRA, w, h, w * 4, bgra, &fn);
+                free(bgra);
+            }
+        }
+        free(lvd);
+    }
+    if (!file) { static int w = 0; if (w++ < 4) tp_log("dump: encoding %s failed", name); return; }
+    const int wr = tp_write_atomic(wpath, file, fn, 0);
+    free(file);
+    if (wr < 0) { static int w = 0; if (w++ < 4) tp_log("dump: writing %ls failed", wpath); return; }
+    if (wr == 0) s_tp_dump_disk += fn;
+    char ctx[200]; tp_json_escape(j->ctx, ctx, sizeof ctx);
+    char line[1024];
+    snprintf(line, sizeof line, "{\"hash\":\"%016llx\",\"h0\":\"%016llx\",\"w\":%u,\"h\":%u,\"fmt\":\"%s\",\"fmtb\":%u,\"ln\":%d,"
+             "\"levels\":%u,\"cube\":%d,\"file\":\"%s\",\"dec\":%d,\"hashv\":\"" TP_HASHV "\",\"raw\":%d,\"bytes\":%llu,"
+             "\"first\":{\"run\":\"%s\",\"frame\":%llu,\"sec\":%.1f,\"ctx\":\"%s\"}}\n",
+             (unsigned long long)full, (unsigned long long)h0, j->d.w, j->d.h, fmtn ? fmtn : "UNK", j->d.fmt & 0xFFu,
+             (j->d.fmt & 0x20u) ? 1 : 0, L.glv, j->d.cube, rel, TP_DECODER_VERSION, dds && j->raw, (unsigned long long)fn,
+             s_tp.run_id, (unsigned long long)j->frame, j->t, ctx);
+    tp_index_append(line);
+    InterlockedIncrement(&s_tp.st_written);
+    { static int nl = 0; if (nl++ < tp_cfg_log()) tp_log("dumped %s (%llu bytes)", rel, (unsigned long long)fn); }
+    }
+done:
+    tp_hset_add(&s_tp_dwritten, key);
+    AcquireSRWLockExclusive(&s_tp.dlk); tp_push((void**)&s_tp.ddone, &s_tp.nddone, &s_tp.capddone, &key, sizeof key);
+    ReleaseSRWLockExclusive(&s_tp.dlk);
+}
+
+static void tp_dump_use(const tp_duse* u)
+{
+    uint64_t k = u->hash;
+    k = tp_hset_mix(k ^ ((uint64_t)u->fp_id << 32 | u->unit)); k = tp_hset_mix(k ^ ((uint64_t)u->ctrl1 << 32 | u->addr));
+    k = tp_hset_mix(k ^ ((uint64_t)u->filt << 8 | (uint64_t)u->txl << 1 | u->at_en));
+    if (tp_hset_add(&s_tp_duses, k) != 1) return;
+    const uintptr_t n = (uintptr_t)tp_map_get(&s_tp_dusen, u->hash);
+    if (n >= 16) return;
+    tp_map_put(&s_tp_dusen, u->hash, (void*)(n + 1));
+    rsx_texproc_ctl pc; rsx_texture_texproc(u->fmt, u->ctrl1, u->addr, u->filt, &pc);
+    char line[512];
+    snprintf(line, sizeof line, "{\"use\":\"%016llx\",\"fp\":\"%08X\",\"unit\":%u,\"fmt\":\"%s\",\"ctrl1\":\"%04X\",\"addr\":\"%08X\","
+             "\"filt\":\"%08X\",\"gamma\":%u,\"expand\":%u,\"signed\":%u,\"txl\":%u,\"alpha_test\":%u,\"alpha_func\":%u,"
+             "\"alpha_ref\":%u,\"wrap_s\":%u,\"wrap_t\":%u,\"min\":%u,\"mag\":%u}\n",
+             (unsigned long long)u->hash, u->fp_id, u->unit, tp_fmt_name(u->fmt) ? tp_fmt_name(u->fmt) : "UNK", u->ctrl1 & 0xFFFFu,
+             u->addr, u->filt, pc.gamma, pc.expand, pc.sext, u->txl, u->at_en, u->at_func, u->at_ref,
+             u->addr & 0xFu, (u->addr >> 8) & 0xFu, (u->filt >> 16) & 0xFFu, (u->filt >> 24) & 0xFu);
+    tp_index_append(line);
+}
+
+static DWORD WINAPI tp_dump_main(void* arg)
+{
+    (void)arg;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    tp_wic();
+    tp_dump_load_index();
+    /* Each round takes the whole queues at once (pointer swaps under the lock),
+     * then works without it: the render thread's pushes never wait behind the
+     * dump's work. (One item at a time with a memmove under the lock made a
+     * level-load burst of usage tuples O(n^2) and stalled the render thread
+     * for 1.6 s in the first dump run.) */
+    for (;;) {
+        AcquireSRWLockExclusive(&s_tp.dlk);
+        while (!s_tp.stop && !s_tp.ndj && !s_tp.ndu) SleepConditionVariableSRW(&s_tp.dcv, &s_tp.dlk, 500, 0);
+        if (s_tp.stop && !s_tp.ndj && !s_tp.ndu) { ReleaseSRWLockExclusive(&s_tp.dlk); break; }
+        tp_djob* jobs = s_tp.dj; const int nj = s_tp.ndj;
+        tp_duse* uses = s_tp.du; const int nu = s_tp.ndu;
+        s_tp.dj = NULL; s_tp.ndj = s_tp.capdj = 0;
+        s_tp.du = NULL; s_tp.ndu = s_tp.capdu = 0;
+        ReleaseSRWLockExclusive(&s_tp.dlk);
+        for (int i = 0; i < nu; i++) tp_dump_use(&uses[i]);
+        for (int i = 0; i < nj; i++) {
+            if (!s_tp.stop) tp_dump_one(&jobs[i]);
+            InterlockedAdd64(&s_tp.dinflight, -(LONG64)jobs[i].bytes);
+            free(jobs[i].buf);
+        }
+        free(jobs); free(uses);
+    }
+    if (s_tp_index_h != INVALID_HANDLE_VALUE) { CloseHandle(s_tp_index_h); s_tp_index_h = INVALID_HANDLE_VALUE; }
+    return 0;
+}
