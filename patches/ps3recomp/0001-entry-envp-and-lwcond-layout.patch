+        padhost_config_set("deadzone", "8");
+        ph_publish(6, 424242, &raw, PADHOST_KIND_XINPUT, PADHOST_BUS_OTHER, 0x045E, 0x02EA);
+        padhost_get(6, &st);
+        CHECK(st.lx > 128 && st.rx > 128, "deadzone=8: XInput too (%u %u)", st.lx, st.rx);
+        ph_snap_set(6, 0, 0, PADHOST_KIND_NONE, PADHOST_BUS_OTHER, 0, 0);
+        padhost_config_set("deadzone", "0");
+    }
+
+    /* startup: devices opened while the hold is on get ports by rank, not by
+     * the order they opened in -- a joystick opened first still ends up last */
+    InterlockedExchange(&s_hold_ports, 1);
+    int j = vprep(&stub_drv, "joy", 0x04);
+    int g = vprep(&stub_drv, "pad", 0x05);
+    int s = vprep(&stub_ds_drv, "ds", 0x05);
