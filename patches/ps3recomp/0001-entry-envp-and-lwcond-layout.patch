+static int chk_window(const char* v) { int w, h; return dcfg_parse_size(v, &w, &h) != DCFG_SIZE_BAD; }
+static int chk_monitor(const char* v)
+{
+    char n[24];
+    dcfg_norm(v, n, sizeof n);
+    if (!strcmp(n, "primary") || !strcmp(n, "auto") || !strcmp(n, "cursor") || !strcmp(n, "mouse")) return 1;
+    char* end;
+    long k = strtol(n, &end, 10);
+    return end != n && !*end && k >= 1 && k <= 16;
+}
