+ * limit. Default RSX_FP_SHADOW_PLANE_MAX_DEFAULT. Set with the filter. */
+#define RSX_FP_SHADOW_PLANE_MAX_DEFAULT 0.0005
+void rsx_fp_set_shadow_plane_max(double max_per_texel);
+/* The per-axis texel weights of a kernel (CPU twin of the HLSL), at the
