+int  sceNpTrophy_ss_handle(uint32_t i, uint32_t* key, const void** rec);
+extern const ss_list cellHttp_ss_list, cellHttp_ss_clients_list, cellHttp_ss_transactions_list;
+int  cellHttp_ss_client(uint32_t i, uint32_t* key, const void** rec);
+int  cellHttp_ss_transaction(uint32_t i, uint32_t* key, const void** rec);
