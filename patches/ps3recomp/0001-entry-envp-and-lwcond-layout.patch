diff --git a/libs/video/rsx_vpc_norm.h b/libs/video/rsx_vpc_norm.h
new file mode 100644
index 0000000..57c0ddb
--- /dev/null
+++ b/libs/video/rsx_vpc_norm.h
@@ -0,0 +1,131 @@
+/*
+ * ps3recomp - vertex-program constant lane sums (RSX_CAP_VPC, VPC_NORM)
+ *
+ * inFamous 2 drives its glow pyramid's separable blur (fragment program
+ * 62949BCC, vertex program E073A4CCD77FD9ED in the RPCS3 cache) with tap
+ * offsets and weights in VP constants c[462..466]: tcN.xyz = c[466-N].xyz +
+ * (uv, 0), and the fragment program reads each tap's weight from tcN.z.
+ * Measured from the render targets of every capture since 2026-10-05 (menu,
+ * pier, gate): the horizontal pass of each level has a gain of 1.0, the
+ * vertical pass exactly 2.0, so each 2:1 level ends twice as bright as the
+ * one above it (x32 at 20x11) and the composite's glow is ~11x its source
+ * instead of ~1.7x. Whether the title uploads the 2.0 itself (then it is
+ * intended and the glow mask is what is too high) is what RSX_CAP_VPC (our
+ * bank) and tools/rpcs3_probe/tconst_scan.py (RPCS3's command buffer) settle.
+ *
+ * The same fragment program also blurs the 256x256 water reflection (two
+ * draws before the water pass, a different vertex program, vertical gain
+ * 0.90 with a different kernel). So VPC_NORM does not normalize every sum:
+ * by default it only rescales a lane whose sum is within 3% of 2.0 (the
+ * defect under test); "@0" rescales any positive sum (the first version's
+ * behaviour, which also brightened the reflection blur by ~11%).
+ *
+ * These helpers are what the capture manifest prints (RSX_CAP_VPC: the
+ * constants each draw really got, and their lane sums) and what the VPC_NORM
+ * experiment applies. Header-only so the unit test can use them without the
+ * D3D12 backend.
+ */
+#ifndef RSX_VPC_NORM_H
+#define RSX_VPC_NORM_H
+
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct {
+    unsigned fp_id;     /* fragment program id (FP_DUMP_ALL / manifest fphash) */
+    unsigned lo, hi;    /* constant slots, inclusive */
+    unsigned lane;      /* 0..3 = x..w */
+    float    from;      /* only a sum within RSX_VPC_NORM_TOL of this is rescaled;
+                         * 0 = any positive finite sum */
+} rsx_vpc_norm_cfg;
+
+#define RSX_VPC_NORM_TOL 0.03f   /* relative */
+
+/* Sum of one lane over constants [lo, hi] of a float4 bank (bank[slot*4+lane]). */
+static inline float rsx_vpc_lane_sum(const float* bank, unsigned lo, unsigned hi, unsigned lane)
+{
+    float s = 0.0f;
+    if (!bank || lane > 3u || lo > hi) return 0.0f;
+    for (unsigned i = lo; i <= hi; i++) s += bank[i * 4u + lane];
+    return s;
+}
+
+/* Does a lane sum qualify for rescaling under cfg? Positive, finite, not
+ * already 1 (within 1e-4), and -- unless cfg->from is 0 -- within
+ * RSX_VPC_NORM_TOL of cfg->from. */
+static inline int rsx_vpc_norm_wants(const rsx_vpc_norm_cfg* cfg, float s)
+{
+    if (!cfg || !(s > 0.0f) || !(s < 3.0e38f)) return 0;    /* <= 0, NaN, inf */
+    if (s > 0.9999f && s < 1.0001f) return 0;
+    if (cfg->from > 0.0f) {
+        const float d = s - cfg->from;
+        if (d > cfg->from * RSX_VPC_NORM_TOL || -d > cfg->from * RSX_VPC_NORM_TOL) return 0;
+    }
+    return 1;
+}
+
+/* Rescale that lane so it sums to 1. Only a positive, finite sum that is not
+ * already 1 (within 1e-4) is touched; returns the sum found. */
+static inline float rsx_vpc_normalize(float* bank, unsigned lo, unsigned hi, unsigned lane)
+{
+    const float s = rsx_vpc_lane_sum(bank, lo, hi, lane);
+    if (!(s > 0.0f) || !(s < 3.0e38f)) return s;           /* <= 0, NaN, inf */
+    if (s > 0.9999f && s < 1.0001f) return s;
+    const float k = 1.0f / s;
+    for (unsigned i = lo; i <= hi; i++) bank[i * 4u + lane] *= k;
+    return s;
+}
+
+/* "<hex fp id>[:<lo>-<hi>[.<x|y|z|w>]][@<sum>]" -> cfg (defaults 462-466, z,
+ * sum 2.0; "@0" = any sum). Returns 1 on success, 0 for an empty/invalid
+ * string (cfg zeroed). */
+static inline int rsx_vpc_norm_parse(const char* s, rsx_vpc_norm_cfg* cfg)
+{
+    char* end;
+    if (!cfg) return 0;
+    memset(cfg, 0, sizeof *cfg);
+    if (!s || !*s) return 0;
+    const unsigned long id = strtoul(s, &end, 16);
+    if (end == s || id == 0) return 0;
+    cfg->fp_id = (unsigned)id; cfg->lo = 462; cfg->hi = 466; cfg->lane = 2; cfg->from = 2.0f;
+    if (*end == ':') {
+        const char* p = end + 1;
+        const unsigned long lo = strtoul(p, &end, 10);
+        if (end == p || *end != '-') { memset(cfg, 0, sizeof *cfg); return 0; }
+        p = end + 1;
+        const unsigned long hi = strtoul(p, &end, 10);
+        if (end == p || hi < lo || hi > 511) { memset(cfg, 0, sizeof *cfg); return 0; }
+        cfg->lo = (unsigned)lo; cfg->hi = (unsigned)hi;
+        if (*end == '.') {
+            const char c = end[1];
+            if (c == 'x') cfg->lane = 0; else if (c == 'y') cfg->lane = 1;
+            else if (c == 'z') cfg->lane = 2; else if (c == 'w') cfg->lane = 3;
+            else { memset(cfg, 0, sizeof *cfg); return 0; }
+            end += 2;
+        }
+    }
+    if (*end == '@') {
+        const char* p = end + 1;
+        const double f = strtod(p, &end);
+        if (end == p || !(f >= 0.0) || f > 1.0e6) { memset(cfg, 0, sizeof *cfg); return 0; }
+        cfg->from = (float)f;
+    }
+    if (*end) { memset(cfg, 0, sizeof *cfg); return 0; }
+    return 1;
+}
+
+/* "<lo>-<hi>" (decimal slots) -> range; 0 if invalid. */
+static inline int rsx_vpc_range_parse(const char* s, unsigned* lo, unsigned* hi)
+{
+    char* end;
+    if (!s || !*s || !lo || !hi) return 0;
+    const unsigned long a = strtoul(s, &end, 10);
+    if (end == s) return 0;
+    unsigned long b = a;
+    if (*end == '-') { const char* p = end + 1; b = strtoul(p, &end, 10); if (end == p) return 0; }
+    if (*end || b < a || b > 511) return 0;
+    *lo = (unsigned)a; *hi = (unsigned)b;
+    return 1;
+}
+
+#endif /* RSX_VPC_NORM_H */
