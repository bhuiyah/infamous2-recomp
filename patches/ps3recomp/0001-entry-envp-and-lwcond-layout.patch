 }
+
+/* ---------------------------------------------------------------------------
+ * Save states: cellSysutil's part of the SUTL section (runtime/savestate/
+ * ss_state.h, engine design 6.2)
+ *
+ * cellSysmodule.c registers the section and writes it from what this file
+ * describes -- field lists, record iterators, a check -- so this file calls
+ * nothing of the save-state engine and the tests that link it alone (trophy
+ * registration, dialog callbacks) still build. Records:
+ *   sysutil      BGM enable / status, the system cache mount, whether the
+ *                title pumps sysutil, the disc-change callback (OPD, arg)
+ *   callbacks    each registered slot's OPD and userdata, keyed by slot
+ *   events       the event ring from head to tail (restored at head 0)
+ *   completions  the queued one-shot guest callbacks (dialog answers, the
+ *                trophy registration's completion) in delivery order: OPD
+ *                and arguments, by value
+ * Every writer of these is a guest thread inside an HLE call, so with every
+ * guest thread parked they hold still and are read without a lock. A batch
+ * drain_guest_completions has detached lives only while its callbacks run,
+ * and a thread inside a guest callback is never parked by a strict stop.
+ * -----------------------------------------------------------------------*/
+static uint32_t s_ss_disc_change_cb, s_ss_disc_change_arg;   /* capture scratch: the EAs */
+static const ss_field k_sysutil_ss_fields[] = {
+    SS_FIELD(s_bgm_enabled), SS_FIELD(s_bgm_status), SS_FIELD(s_cache_path),
+    SS_FIELD(s_cache_mounted), SS_FIELD(s_pump_seen),
+    SS_FIELD_AS("disc_change_cb", s_ss_disc_change_cb),
+    SS_FIELD_AS("disc_change_arg", s_ss_disc_change_arg),
+};
+const ss_list cellSysutil_ss_list = SS_LIST("sysutil", k_sysutil_ss_fields);
+static const ss_field k_sysutil_ss_cb_fields[] = {
+    SS_MEMBER(SysutilCallbackSlot, guest_opd), SS_MEMBER(SysutilCallbackSlot, userdata),
+};
+const ss_list cellSysutil_ss_callbacks_list = SS_LIST("callbacks", k_sysutil_ss_cb_fields);
+static const ss_field k_sysutil_ss_event_fields[] = {
+    SS_MEMBER(SysutilEvent, slot), SS_MEMBER(SysutilEvent, status), SS_MEMBER(SysutilEvent, param),
+};
+const ss_list cellSysutil_ss_events_list = SS_LIST("events", k_sysutil_ss_event_fields);
+static const ss_field k_sysutil_ss_completion_fields[] = {
+    SS_MEMBER(GuestCompletion, opd), SS_MEMBER(GuestCompletion, args),
+};
+const ss_list cellSysutil_ss_completions_list = SS_LIST("completions", k_sysutil_ss_completion_fields);
+
+/* Everything parked: the disc-change callback's guest values (the HLE
+ * adapter hands them over in pointer-typed parameters) into the scratch the
+ * "sysutil" list names. */
+void cellSysutil_ss_prepare(void)
+{
+    s_ss_disc_change_cb  = (uint32_t)(uintptr_t)s_disc_change_cb;
+    s_ss_disc_change_arg = (uint32_t)(uintptr_t)s_disc_change_arg;
+}
+
+/* The record iterators: called with i = 0, 1, 2, ... in order; -1 past the
+ * end, 0 nothing at i, 1 = *rec is record i, keyed *key. */
+int cellSysutil_ss_callback(uint32_t i, uint32_t* key, const void** rec)
+{
+    if (i >= CELL_SYSUTIL_MAX_CALLBACKS) return -1;
+    if (!s_callbacks[i].registered) return 0;
+    *key = i;
+    *rec = &s_callbacks[i];
+    return 1;
+}
+
+int cellSysutil_ss_event(uint32_t i, uint32_t* key, const void** rec)
+{
+    const int n = (s_event_tail - s_event_head + SYSUTIL_EVENT_QUEUE_SIZE) % SYSUTIL_EVENT_QUEUE_SIZE;
+    if ((int)i >= n) return -1;
+    *key = i;
+    *rec = &s_event_queue[(s_event_head + (int)i) % SYSUTIL_EVENT_QUEUE_SIZE];
+    return 1;
+}
+
+/* A cursor walks the list (i = 0 starts it), at most 4096 entries. */
+static const GuestCompletion* s_ss_completion_at;
+int cellSysutil_ss_completion(uint32_t i, uint32_t* key, const void** rec)
+{
+    s_ss_completion_at = i == 0 ? s_completion_head : s_ss_completion_at ? s_ss_completion_at->next : NULL;
+    if (!s_ss_completion_at || i >= 4096) return -1;
+    *key = i;
+    *rec = s_ss_completion_at;
+    return 1;
+}
+
+/* ---- the load (M4c): cellSysmodule.c reads the image, these put it back.
+ * By value, all of it (engine design 6.2): nothing here is a host object
+ * but the completion nodes, which are rebuilt. */
+
+/* Teardown, every guest thread gone (a batch a discarded thread had detached
+ * died with it): the completion list freed, the ring and the callback slots
+ * empty, the rest at its boot value. */
+void cellSysutil_ss_teardown(void)
+{
+    COMPLETION_LOCK();
+    GuestCompletion* c = s_completion_head;
+    s_completion_head = s_completion_tail = NULL;
+    COMPLETION_UNLOCK();
+    while (c) {
+        GuestCompletion* next = c->next;
+        free(c);
+        c = next;
+    }
+    memset(s_callbacks, 0, sizeof(s_callbacks));
+    memset(s_event_queue, 0, sizeof(s_event_queue));
+    s_event_head = s_event_tail = 0;
+    s_bgm_enabled = 1;
+    s_bgm_status = CELL_SYSUTIL_BGMPLAYBACK_STATUS_STOP;
+    s_cache_path[0] = '\0';
+    s_cache_mounted = 0;
+    s_pump_seen = 0;
+    s_disc_change_cb = NULL;
+    s_disc_change_arg = NULL;
+}
+
+/* After the "sysutil" record is back: the disc-change callback from the
+ * guest values it carries; the cache path ends inside its buffer. */
+void cellSysutil_ss_apply(void)
+{
+    s_disc_change_cb  = (void (*)(void*))(uintptr_t)s_ss_disc_change_cb;
+    s_disc_change_arg = (void*)(uintptr_t)s_ss_disc_change_arg;
+    s_cache_path[sizeof(s_cache_path) - 1] = '\0';
+}
+
+/* The records' puts: i = the record's place in its list, key its key, rec a
+ * zeroed copy of the struct with the listed members; check, and with apply
+ * store. 0, or -1 with why. */
+const uint32_t cellSysutil_ss_callback_size   = (uint32_t)sizeof(SysutilCallbackSlot);
+const uint32_t cellSysutil_ss_event_size      = (uint32_t)sizeof(SysutilEvent);
+const uint32_t cellSysutil_ss_completion_size = (uint32_t)sizeof(GuestCompletion);
+
+int cellSysutil_ss_callback_put(uint32_t i, uint32_t key, const void* rec, int apply, char* why, size_t n)
+{
+    const SysutilCallbackSlot* s = (const SysutilCallbackSlot*)rec;
+    (void)i;
+    if (key >= CELL_SYSUTIL_MAX_CALLBACKS || !s->guest_opd) {
+        snprintf(why, n, "slot %u, OPD 0x%08X: not a registered callback (%d slots)", key, s->guest_opd,
+                 CELL_SYSUTIL_MAX_CALLBACKS);
+        return -1;
+    }
+    if (!apply) return 0;
+    s_callbacks[key].guest_opd  = s->guest_opd;
+    s_callbacks[key].userdata   = s->userdata;
+    s_callbacks[key].registered = 1;
+    return 0;
+}
+
+/* The ring comes back from head 0, in order: record i is entry i. */
+int cellSysutil_ss_event_put(uint32_t i, uint32_t key, const void* rec, int apply, char* why, size_t n)
+{
+    if (key != i || i >= SYSUTIL_EVENT_QUEUE_SIZE - 1) {
+        snprintf(why, n, "entry %u at place %u: not the ring in order (it holds %d)", key, i,
+                 SYSUTIL_EVENT_QUEUE_SIZE - 1);
+        return -1;
+    }
+    if (!apply) return 0;
+    s_event_queue[i] = *(const SysutilEvent*)rec;
+    s_event_tail = (int)i + 1;
+    return 0;
+}
+
+/* In delivery order, each a new node at the tail. */
+int cellSysutil_ss_completion_put(uint32_t i, uint32_t key, const void* rec, int apply, char* why, size_t n)
+{
+    const GuestCompletion* c = (const GuestCompletion*)rec;
+    if (key != i || i >= 4096 || !c->opd) {
+        snprintf(why, n, "completion %u at place %u, OPD 0x%08X: not the list in order", key, i, c->opd);
+        return -1;
+    }
+    if (!apply) return 0;
+    GuestCompletion* item = (GuestCompletion*)malloc(sizeof(*item));
+    if (!item) {
+        snprintf(why, n, "out of memory for completion %u", i);
+        return -1;
+    }
+    item->next = NULL;
+    item->opd = c->opd;
+    memcpy(item->args, c->args, sizeof(item->args));
+    COMPLETION_LOCK();
+    if (s_completion_tail) s_completion_tail->next = item;
+    else s_completion_head = item;
+    s_completion_tail = item;
+    COMPLETION_UNLOCK();
+    return 0;
+}
+
+/* Strict save: refused while something holds the completion list's lock
+ * (only a guest thread queueing or detaching holds it, for a few
+ * instructions; a parked thread never does). A try, never a wait. */
+int cellSysutil_ss_check(char* why, size_t n)
+{
+#ifdef _WIN32
+    const int held = !TryAcquireSRWLockExclusive(&s_completion_lock);
+#else
+    const int held = pthread_mutex_trylock(&s_completion_lock) != 0;
+#endif
+    if (held) {
+        snprintf(why, n, "the sysutil completion list is being changed");
+        return SS_REASON_SECTION;
+    }
+    COMPLETION_UNLOCK();
+    return 0;
+}
