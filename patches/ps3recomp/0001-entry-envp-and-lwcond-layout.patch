-        if (op9 == 0x047 || op9 == 0x067) {                   /* stqr / lqr (rel) */
-            uint32_t a = (pc + ((uint32_t)i16 << 2)) & SPU_LS_MASK & ~15u;
-            if (op9 == 0x047) spu_ls_write128(ctx, a, ctx->gpr[rt]);
