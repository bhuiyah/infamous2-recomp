+/* ---------------------------------------------------------------------------
+ * The lean transfer path (no env-armed probe set)
+ *
+ * mfc_do_transfer_impl_diag above with every probe variable unset: the same
+ * rejections, copies, coherence notifications, hooks and always-on reports,
+ * in the same order. What it does differently is only HOW:
+ *
+ *  - the probes are not tested (mfc_diag_on() said none is armed);
+ *  - the reserved-line tests read the bitmap inline (spu_coh_bitmap.h), and
+ *    the whole PUT span is first tested a bitmap byte at a time instead of
+ *    one out-of-line call per 128-byte line, twice;
+ *  - the 0xC708C708 poison scan of every PUT payload compares four words per
+ *    SSE2 instruction instead of one per iteration (same words, same answer);
+ *  - the rare reports live in cold functions, so the common path keeps a
+ *    small frame. Their capped counters stop counting at the cap.
+ * -----------------------------------------------------------------------*/
+
+/* Any reserved line in [a0, a1] (128-byte aligned EAs, a0 <= a1)? The same
+ * predicate as testing spu_coh_is_reserved() on every line of the span. */
+static inline int mfc_coh_span_reserved(uint32_t a0, uint32_t a1)
+{
+    if (!__atomic_load_n(&g_spu_coh_armed, __ATOMIC_RELAXED)) return 0;
+    const uint32_t l0 = a0 >> SPU_COH_LINE_SHIFT, l1 = a1 >> SPU_COH_LINE_SHIFT;
+    const uint32_t b0 = l0 >> 3, b1 = l1 >> 3;
+    const unsigned m0 = 0xFFu << (l0 & 7), m1 = 0xFFu >> (7 - (l1 & 7));
+    if (b0 == b1)
+        return (__atomic_load_n(&g_spu_coh_bitmap[b0], __ATOMIC_RELAXED) & m0 & m1) != 0;
+    if (__atomic_load_n(&g_spu_coh_bitmap[b0], __ATOMIC_RELAXED) & m0) return 1;
+    for (uint32_t b = b0 + 1; b < b1; b++)
+        if (__atomic_load_n(&g_spu_coh_bitmap[b], __ATOMIC_RELAXED)) return 1;
+    return (__atomic_load_n(&g_spu_coh_bitmap[b1], __ATOMIC_RELAXED) & m1) != 0;
+}
