+static const ss_section_ops k_spuh_ops = {
+    SS_FOURCC('S', 'P', 'U', 'H'), 1, 0, SS_ORDER_SPU + 20,
+    spu_workload_ss_check, spuh_capture, spu_workload_ss_teardown, spuh_restore, NULL,
+    "SPU taskset HLE", k_spuh_lists, NULL,
