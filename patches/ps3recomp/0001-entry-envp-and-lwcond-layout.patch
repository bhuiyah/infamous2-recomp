+    j = vprep(&stub_drv, "joy2", 0x04);
+    s = vprep(&stub_ds_drv, "ds2", 0x05);
+    CHECK(padhost_virtual_port(j) == 0 && padhost_virtual_port(s) == 1, "hotplug order kept (%d %d)",
+          padhost_virtual_port(j), padhost_virtual_port(s));
+    {
+        char note[400] = "";
+        AcquireSRWLockExclusive(&s_lock);
+        int has = ph_port0_note(1, 0, note, sizeof note);
+        int none = ph_port0_note(1, 2, note + 399, 1);     /* another joystick: no note */
+        int zero = ph_port0_note(0, 0, note + 399, 1);
+        ReleaseSRWLockExclusive(&s_lock);
+        CHECK(has && strstr(note, "map.044F:B10A = ignore") != NULL, "note: %s", note);
+        CHECK(!none && !zero, "no note for a joystick, or for port 0");
+    }
+    padhost_virtual_detach(j);
+    padhost_virtual_detach(s);
+    wait_state(0, 0, 1000);
