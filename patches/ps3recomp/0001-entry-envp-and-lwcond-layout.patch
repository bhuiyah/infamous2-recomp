+def _sx16(v: int) -> int:
+    return v - 0x10000 if v & 0x8000 else v
+
+
+def _cont_decode(raw: int, addr: int):
+    """What one guest instruction does to the things a continuation's exit
+    model depends on -- control flow, r1, LR, and which GPRs it writes --
+    decoded from the raw word. None = not an instruction (data, padding)."""
+    if not raw:
+        return None
+    op = raw >> 26
+    rt, ra, rb = (raw >> 21) & 31, (raw >> 16) & 31, (raw >> 11) & 31
+    simm = _sx16(raw & 0xFFFF)
+    if op in (2, 3):                                     # tdi / twi
+        return ("trap",) if rt == 31 else ("nop",)
+    if op in (4, 10, 11, 59, 63):                        # VMX, cmp*i, FP
+        return ("nop",)
+    if op in (7, 8, 12, 13, 15):                         # mulli subfic addic addis
+        return ("def", (rt,))
+    if op == 14:                                         # addi / li
+        return ("def", (rt,)) if ra == 0 else ("addi", rt, ra, simm)
+    if op == 16:                                         # bc
+        bd = _sx16(raw & 0xFFFC)
+        tgt = (bd if raw & 2 else addr + bd) & 0xFFFFFFFF
+        if raw & 1:
+            return ("call", tgt)
+        return ("b", tgt) if (rt & 0x14) == 0x14 else ("bc", tgt)
+    if op == 17:
+        return ("sc",)
+    if op == 18:                                         # b / bl
+        li = raw & 0x03FFFFFC
+        li = li - 0x04000000 if li & 0x02000000 else li
+        tgt = (li if raw & 2 else addr + li) & 0xFFFFFFFF
+        return ("call", tgt) if raw & 1 else ("b", tgt)
+    if op == 19:
+        xo = (raw >> 1) & 0x3FF
+        cond = (rt & 0x14) != 0x14
+        if xo == 16:                                     # bclr
+            return ("call", None) if raw & 1 else ("ret", cond)
+        if xo == 528:                                    # bcctr
+            return ("call", None) if raw & 1 else ("ctr", cond)
+        return ("nop",)
+    if op in (20, 21, 23, 28, 29, 30):                   # rlw*, andi(s)., rld*
+        return ("def", (ra,))
+    if op in (24, 25, 26, 27):                           # ori oris xori xoris
+        if (raw & 0xFFFF) == 0:
+            return ("nop",) if ra == rt else ("mr", ra, rt)
+        return ("def", (ra,))
+    if op == 31:
+        xo = (raw >> 1) & 0x3FF
+        if ((raw >> 2) & 0x1FF) == 413:                  # sradi
+            return ("def", (ra,))
+        if xo in (4, 68):                                # tw / td
+            return ("trap",) if rt == 31 else ("nop",)
+        if xo in (339, 467):                             # mfspr / mtspr
+            spr = ((raw >> 16) & 31) | (((raw >> 11) & 31) << 5)
+            if xo == 339:
+                return ("mflr", rt) if spr == 8 else ("def", (rt,))
+            return ("mtlr", rt) if spr == 8 else ("nop",)
+        if xo == 444:                                    # or (mr when rS == rB)
+            return ("mr", ra, rt) if rt == rb else ("def", (ra,))
+        if xo in _X_RA_DEST:
+            return ("def", (ra,))
+        if xo in (181, 183) and ra == 1:                 # stdux/stwux rS,r1,rB: alloca
+            return ("alloca", rt)                        # (rS = the back chain it stores)
+        if xo in _X_ST:
+            return ("stx", ra, xo in _X_ST_U)
+        if xo in _X_LD:
+            return ("ldx", rt, ra, xo in _X_LD_U)
+        if xo in _X_FLD:
+            return ("fldx", ra, xo in _X_FLD_U)
+        if xo in _X_NOP:
+            return ("nop",)
+        return ("def", (rt,))
+    if op in (32, 33):                                   # lwz lwzu
+        return ("ld", rt, ra, simm, 4, op == 33)
+    if op in (34, 35, 40, 41, 42, 43):                   # lbz lhz lha (+u)
+        return ("ld", rt, ra, simm, 0, bool(op & 1))
+    if op in (36, 37):                                   # stw stwu
+        return ("st", rt, ra, simm, 4, op == 37)
+    if op in (38, 39):
+        return ("st", rt, ra, simm, 1, op == 39)
+    if op in (44, 45):
+        return ("st", rt, ra, simm, 2, op == 45)
+    if op == 46:
+        return ("lmw", rt, ra, simm)
+    if op == 47:                                         # stmw: a range store
+        return ("st", None, ra, simm, 4 * (32 - rt), False)
+    if op in (48, 49, 50, 51):                           # lfs lfd (+u)
+        return ("fld", ra, simm, bool(op & 1))
+    if op in (52, 53):
+        return ("st", None, ra, simm, 4, op == 53)
+    if op in (54, 55):
+        return ("st", None, ra, simm, 8, op == 55)
+    if op == 58:                                         # ld ldu lwa
+        ds, x = _sx16(raw & 0xFFFC), raw & 3
+        return ("ld", rt, ra, ds, 8 if x < 2 else 0, x == 1)
+    if op == 62:                                         # std stdu
+        ds, x = _sx16(raw & 0xFFFC), raw & 3
+        return ("st", rt, ra, ds, 8, x == 1) if x < 2 else ("nop",)
+    return None
+
