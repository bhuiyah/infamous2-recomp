+        const rsx_vertex_attrib* va = tr ? &tr->guest_arrays[a] : &st->vertex_attribs[a];
+        const rsx_vertex_attrib* nw = &st->vertex_attribs[a];
+        fprintf(stderr, "[IMMDIAG]  array a%d guest: en=%d type=%u size=%u stride=%u off=0x%08X(%s) freq=%u"
+                        " | this draw: %s, register=(%g %g %g %g)\n",
