+/*
+ * ps3recomp - save-state image (see ss_state.h for the model and the rules):
+ * the section registry, the staging buffer, the writer, the reader, CRC32C,
+ * the raw image file and its compression estimate, and the sections this
+ * file owns:
+ *   TIME  the guest clock at capture, the play time, the anchors other
+ *         owners add (the worked example: FIELDS of a struct + RECS)
+ *   MAPS  the guest address space: committed 64 KB blocks, the committed
+ *         regions with their protection, the bitmap of non-zero 4 KB pages
+ *   GMEM  the non-zero 4 KB pages themselves, in address order
+ *
+ * Everything a capture touches is static or in the staging buffer, which
+ * ss_state_prepare grows (and touches) outside a stop: the capture itself
+ * allocates nothing and takes no page fault in its own memory.
+ *
+ * M4c adds the load's half: two staging banks (a held image survives the
+ * next capture), every section's teardown / restore / after_release in
+ * order, the fidelity check (ss_state_verify), and the restore of the three
+ * sections owned here -- TIME (the one guest clock set to the snapshot's
+ * time base, then every anchor), MAPS (the snapshot's committed regions and
+ * their protection), GMEM (its pages; design 6.3).
+ */
+#include "ss_state.h"
+#include "../platform/win32_compat.h"
+#include "../platform/guest_clock.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#if defined(_M_X64) || defined(__x86_64__)
+#  define SS_X86 1
+#  include <immintrin.h>              /* _mm_crc32_u64 */
+#  if defined(_MSC_VER)
+#    include <intrin.h>               /* __cpuid */
+#  else
+#    include <cpuid.h>
+#  endif
+#endif
+
+_Static_assert(sizeof(ss_img_hdr) == 256, "ss_img_hdr is 256 bytes");
+_Static_assert(sizeof(ss_sec_ent) == 64, "ss_sec_ent is 64 bytes");
+_Static_assert(sizeof(ss_chunk_ent) == 16, "ss_chunk_ent is 16 bytes");
+
+#define MB (1024.0 * 1024.0)
+
+/* ---------------------------------------------------------------------------
+ * Small helpers
+ * -----------------------------------------------------------------------*/
+static uint64_t now_us(void)
+{
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (uint64_t)(c.QuadPart / f.QuadPart) * 1000000ull +
+           (uint64_t)(c.QuadPart % f.QuadPart) * 1000000ull / (uint64_t)f.QuadPart;
+}
+
+static uint64_t unix_ms_now(void)
+{
+#ifdef _WIN32
+    FILETIME ft;
+    GetSystemTimeAsFileTime(&ft);
+    const uint64_t t = ((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    return (t - 116444736000000000ull) / 10000ull;
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    return (uint64_t)ts.tv_sec * 1000ull + (uint64_t)ts.tv_nsec / 1000000ull;
+#endif
+}
+
+static uint64_t align_up(uint64_t v, uint64_t a) { return (v + a - 1) & ~(a - 1); }
+
+const char* ss_strerror(int e)
+{
+    switch (e) {
+    case SS_OK:          return "ok";
+    case SS_E_OVERFLOW:  return "staging buffer full";
+    case SS_E_NOT_FOUND: return "not found";
+    case SS_E_LAYOUT:    return "layout differs";
+    case SS_E_SIZE:      return "too large for the destination";
+    case SS_E_CORRUPT:   return "corrupt";
+    case SS_E_STATE:     return "misuse";
+    case SS_E_ARG:       return "bad argument";
+    case SS_E_IO:        return "i/o error";
+    case SS_E_NOMEM:     return "out of memory";
+    default:             return "?";
+    }
+}
+
+const char* ss_fourcc_str(uint32_t f, char b[5])
+{
+    for (int i = 0; i < 4; i++) {
+        const char c = (char)((f >> (8 * i)) & 0xFF);
+        b[i] = (c >= 32 && c < 127) ? c : '?';
+    }
+    b[4] = 0;
+    return b;
+}
+
+uint32_t ss_name_hash(const char* s)
+{
+    uint32_t h = 2166136261u;
+    for (; s && *s; s++) { h ^= (uint8_t)*s; h *= 16777619u; }
+    return h;
+}
+
+static uint64_t fnv64(uint64_t h, const void* p, size_t n)
+{
+    const uint8_t* b = (const uint8_t*)p;
+    for (size_t i = 0; i < n; i++) { h ^= b[i]; h *= 1099511628211ull; }
+    return h;
+}
+#define FNV64_INIT 1469598103934665603ull
+
+uint64_t ss_list_hash(const ss_list* l)
+{
+    uint64_t h = FNV64_INIT;
+    if (!l) return h;
+    if (l->name) h = fnv64(h, l->name, strlen(l->name) + 1);
+    for (uint32_t i = 0; i < l->n && l->f; i++) {
+        const ss_field* f = &l->f[i];
+        if (f->name) h = fnv64(h, f->name, strlen(f->name) + 1);
+        h = fnv64(h, &f->size, sizeof f->size);
+    }
+    return h;
+}
+
+/* ---------------------------------------------------------------------------
+ * CRC32C (Castagnoli, reflected 0x82F63B78): the SSE4.2 instruction when
+ * the CPU has it (every x86-64 this port runs on), a table otherwise.
+ * -----------------------------------------------------------------------*/
+static uint32_t s_crc_tab[256];
+static int s_crc_hw = -1;
+
+static void crc_init(void)
+{
+    for (uint32_t i = 0; i < 256; i++) {
+        uint32_t c = i;
+        for (int k = 0; k < 8; k++) c = (c >> 1) ^ (0x82F63B78u & (0u - (c & 1u)));
+        s_crc_tab[i] = c;
+    }
+    int hw = 0;
+#ifdef SS_X86
+#  if defined(_MSC_VER)
+    int r[4];
+    __cpuid(r, 1);
+    hw = (r[2] >> 20) & 1;
+#  else
+    unsigned a, b, c, d;
+    if (__get_cpuid(1, &a, &b, &c, &d)) hw = (c >> 20) & 1;
+#  endif
+#endif
+    s_crc_hw = hw;
+}
+
+#ifdef SS_X86
+#  if defined(__clang__) || defined(__GNUC__)
+__attribute__((target("sse4.2")))
+#  endif
+static uint32_t crc_hw(uint32_t c, const uint8_t* p, size_t n)
+{
+    uint64_t c64 = c;
+    while (n && ((uintptr_t)p & 7u)) { c64 = _mm_crc32_u8((uint32_t)c64, *p++); n--; }
+    while (n >= 32) {
+        uint64_t v[4];
+        memcpy(v, p, 32);
+        c64 = _mm_crc32_u64(c64, v[0]);
+        c64 = _mm_crc32_u64(c64, v[1]);
+        c64 = _mm_crc32_u64(c64, v[2]);
+        c64 = _mm_crc32_u64(c64, v[3]);
+        p += 32; n -= 32;
+    }
+    while (n >= 8) { uint64_t v; memcpy(&v, p, 8); c64 = _mm_crc32_u64(c64, v); p += 8; n -= 8; }
+    while (n--) c64 = _mm_crc32_u8((uint32_t)c64, *p++);
+    return (uint32_t)c64;
+}
+#endif
+
+uint32_t ss_crc32c(uint32_t crc, const void* p, size_t n)
+{
+    if (s_crc_hw < 0) crc_init();
+    const uint8_t* b = (const uint8_t*)p;
+    uint32_t c = ~crc;
+#ifdef SS_X86
+    if (s_crc_hw) return ~crc_hw(c, b, n);
+#endif
+    while (n--) c = (c >> 8) ^ s_crc_tab[(c ^ *b++) & 0xFF];
+    return ~c;
+}
+
+/* ---------------------------------------------------------------------------
+ * Section registry
+ * -----------------------------------------------------------------------*/
+static const ss_section_ops* s_sec[SS_SECTION_MAX];   /* registration order */
+static volatile LONG s_nsec;
+static int s_ord[SS_SECTION_MAX];                      /* capture order: indices into s_sec */
+static volatile LONG s_nord = -1;                      /* its length, published after it; -1: to sort */
+/* The order is built on its first use, and that use can come from two threads
+ * at once: at a launch with SS_LOAD the state's reader (ss_file_load) and the
+ * window menu's slot reader (ss_slots_read_info, when a slot file exists) are
+ * released together by the EBOOT hash and both check a header's sections. Both
+ * sorting s_ord in place left it, for the whole session, with a section twice
+ * and others missing -- the load then tore down and restored without PPUT or
+ * SPUC and died past its point of no return (SS1). One thread builds it, under
+ * this lock, into a copy that is published whole; registration takes it too. */
+static SRWLOCK s_ord_lk = SRWLOCK_INIT;
+
+int ss_section_register(const ss_section_ops* ops)
+{
+    char b[5];
+    if (!ops || !ops->fourcc) return 0;
+    AcquireSRWLockExclusive(&s_ord_lk);               /* (sort_sections reads the registry under it) */
+    const LONG n = s_nsec;
+    for (LONG i = 0; i < n && i < SS_SECTION_MAX; i++)
+        if (s_sec[i] && s_sec[i]->fourcc == ops->fourcc) {
+            ReleaseSRWLockExclusive(&s_ord_lk);
+            if (s_sec[i] != ops)
+                fprintf(stderr, "[ss] WARNING: save-state section %s registered twice -- the second is"
+                                " ignored\n", ss_fourcc_str(ops->fourcc, b));
+            return 0;
+        }
+    const LONG i = InterlockedIncrement(&s_nsec) - 1;
+    if (i >= SS_SECTION_MAX) {
+        InterlockedDecrement(&s_nsec);
+        ReleaseSRWLockExclusive(&s_ord_lk);
+        fprintf(stderr, "[ss] WARNING: more than %d save-state sections -- %s is not kept\n",
+                SS_SECTION_MAX, ss_fourcc_str(ops->fourcc, b));
+        return 0;
+    }
+    s_sec[i] = ops;
+    const int late = s_nord >= 0;                     /* the order was in use: built again in place */
+    InterlockedExchange(&s_nord, -1);                 /* built again at its next use */
+    ReleaseSRWLockExclusive(&s_ord_lk);
+    if (late) {
+        static volatile LONG warned;
+        if (!InterlockedExchange(&warned, 1))
+            fprintf(stderr, "[ss] WARNING: save-state section %s registered after the capture order was built --"
+                            " safe only while nothing saves, loads or walks it\n", ss_fourcc_str(ops->fourcc, b));
+    }
+    return 1;
+}
+
+/* The capture order, built once by one thread (s_ord_lk): a caller that finds
+ * it built reads the whole of it -- s_nord is published after the array, and
+ * read here with a full barrier. */
+static void sort_sections(void)
+{
+    if (InterlockedCompareExchange(&s_nord, -1, -1) >= 0) return;
+    AcquireSRWLockExclusive(&s_ord_lk);
+    if (s_nord < 0) {
+        int ord[SS_SECTION_MAX], n = 0;
+        const LONG m = s_nsec < SS_SECTION_MAX ? s_nsec : SS_SECTION_MAX;
+        for (LONG i = 0; i < m; i++) if (s_sec[i]) ord[n++] = (int)i;
+        for (int i = 1; i < n; i++) {                  /* stable: by order, then registration */
+            const int v = ord[i];
+            int j = i - 1;
+            while (j >= 0 && s_sec[ord[j]]->order > s_sec[v]->order) { ord[j + 1] = ord[j]; j--; }
+            ord[j + 1] = v;
+        }
+        memcpy(s_ord, ord, (size_t)n * sizeof ord[0]);
+        InterlockedExchange(&s_nord, n);
+    }
+    ReleaseSRWLockExclusive(&s_ord_lk);
+}
+
+int ss_state_order_check_list(const ss_section_ops* const* ord, long n, char* why, size_t why_n)
+{
+    char f4[5];
+    if (why && why_n) why[0] = 0;
+    const LONG m = s_nsec < SS_SECTION_MAX ? s_nsec : SS_SECTION_MAX;
+    LONG reg = 0;
+    for (LONG i = 0; i < m; i++) reg += s_sec[i] != NULL;
+    if (n != reg) {
+        if (why) snprintf(why, why_n, "the capture order holds %ld section(s), %ld are registered", n, (long)reg);
+        return 1;
+    }
+    for (long i = 0; i < n; i++) {
+        const ss_section_ops* o = ord[i];
+        LONG k = 0;
+        while (k < m && (!o || s_sec[k] != o)) k++;
+        if (k == m) {
+            if (why) snprintf(why, why_n, "capture order entry %ld names no registered section", i);
+            return 1;
+        }
+        for (long j = 0; j < i; j++)
+            if (ord[j] == o) {
+                if (why) snprintf(why, why_n, "section %s is twice in the capture order", ss_fourcc_str(o->fourcc, f4));
+                return 1;
+            }
+        if (i > 0 && ord[i - 1]->order > o->order) {
+            if (why) snprintf(why, why_n, "section %s is out of the capture order", ss_fourcc_str(o->fourcc, f4));
+            return 1;
+        }
+    }
+    return 0;
+}
+
+int ss_state_order_check(char* why, size_t why_n)
+{
+    const ss_section_ops* ord[SS_SECTION_MAX];
+    sort_sections();
+    const LONG m = s_nsec < SS_SECTION_MAX ? s_nsec : SS_SECTION_MAX;
+    const LONG n = s_nord;
+    if (n < 0 || n > SS_SECTION_MAX) {
+        if (why && why_n) snprintf(why, why_n, "the capture order is not built (%ld)", (long)n);
+        return 1;
+    }
+    for (LONG i = 0; i < n; i++) {
+        const int k = s_ord[i];
+        ord[i] = k >= 0 && k < m ? s_sec[k] : NULL;   /* (NULL: names no section) */
+    }
+    return ss_state_order_check_list(ord, (long)n, why, why_n);
+}
+
+int ss_section_count(void) { sort_sections(); return s_nord; }
+const ss_section_ops* ss_section_at(int i)
+{
+    sort_sections();
+    return (i >= 0 && i < s_nord) ? s_sec[s_ord[i]] : NULL;
+}
+const ss_section_ops* ss_section_find(uint32_t fourcc)
+{
+    const LONG m = s_nsec < SS_SECTION_MAX ? s_nsec : SS_SECTION_MAX;
+    for (LONG i = 0; i < m; i++) if (s_sec[i] && s_sec[i]->fourcc == fourcc) return s_sec[i];
+    return NULL;
+}
+
+uint64_t ss_section_layout_hash(const ss_section_ops* ops)
+{
+    uint64_t h = FNV64_INIT;
+    if (!ops) return h;
+    h = fnv64(h, &ops->fourcc, sizeof ops->fourcc);
+    h = fnv64(h, &ops->version, sizeof ops->version);
+    for (const ss_list* const* l = ops->lists; l && *l; l++) {
+        const uint64_t lh = ss_list_hash(*l);
+        h = fnv64(h, &lh, sizeof lh);
+    }
+    return h;
+}
+
+/* ---------------------------------------------------------------------------
+ * Staging buffer: one address range reserved at ss_enable (it costs no
+ * memory), committed and touched outside a stop as far as a capture can need.
+ * -----------------------------------------------------------------------*/
+#define SS_STAGING_RESERVE (0x100000000ull + 0x20000000ull)   /* the 4 GB arena + 512 MB */
+/* Two banks (M4c): captures write the current one (s_bank); a held image
+ * keeps the other (ss_image_hold). Each bank reserves its own range on first
+ * use, so a session that never holds an image costs one reserve, as before.
+ * The names below are the current bank's, so the writer reads as it did. */
+typedef struct ss_bank { uint8_t* stg; uint64_t cap, touched; } ss_bank;
+static ss_bank s_bk[2];
+static int     s_bank;              /* the bank captures write */
+static int     s_held = -1;         /* the bank the held image lives in; -1 none */
+#define s_stg         (s_bk[s_bank].stg)
+#define s_stg_cap     (s_bk[s_bank].cap)       /* committed */
+#define s_stg_touched (s_bk[s_bank].touched)   /* ... and touched (no demand-zero fault left below) */
+static uint64_t s_margin = 32ull << 20;
+static uint64_t s_need;             /* what the last capture wrote, or counted when it overflowed */
+
+static int bank_reserve(ss_bank* b)
+{
+    if (b->stg) return 1;
+    b->stg = (uint8_t*)VirtualAlloc(NULL, (SIZE_T)SS_STAGING_RESERVE, MEM_RESERVE, PAGE_READWRITE);
+    return b->stg != NULL;
+}
+static int stg_reserve(void) { return bank_reserve(&s_bk[s_bank]); }
+
+static int bank_grow(ss_bank* b, uint64_t want, int touch, char* why, size_t why_n)
+{
+    want = align_up(want, 1ull << 20);
+    if (want > SS_STAGING_RESERVE) {
+        if (why) snprintf(why, why_n, "a capture needs %.0f MB, more than the %.0f MB reserved",
+                          (double)want / MB, (double)SS_STAGING_RESERVE / MB);
+        return SS_E_NOMEM;
+    }
+    if (!bank_reserve(b)) {
+        if (why) snprintf(why, why_n, "could not reserve %.0f MB of address space for the staging buffer",
+                          (double)SS_STAGING_RESERVE / MB);
+        return SS_E_NOMEM;
+    }
+    if (want > b->cap) {
+        if (!VirtualAlloc(b->stg + b->cap, (SIZE_T)(want - b->cap), MEM_COMMIT, PAGE_READWRITE)) {
+            if (why) snprintf(why, why_n, "could not commit %.0f MB for the staging buffer (error %lu)",
+                              (double)want / MB, (unsigned long)GetLastError());
+            return SS_E_NOMEM;
+        }
+        b->cap = want;
+    }
+    if (touch && b->touched < want) {
+        /* one store per page: the capture's memcpy then takes no fault */
+        for (uint64_t o = b->touched; o < want; o += 4096) ((volatile uint8_t*)b->stg)[o] = 0;
+        b->touched = want;
+    }
+    return SS_OK;
+}
+static int stg_grow(uint64_t want, int touch, char* why, size_t why_n)
+{
+    return bank_grow(&s_bk[s_bank], want, touch, why, why_n);
+}
+
+void ss_state_set_margin(uint64_t bytes) { s_margin = bytes; }
+uint64_t ss_state_staging_bytes(void) { return s_stg_cap; }
+uint64_t ss_state_need(void) { return s_need; }
+
+/* ---------------------------------------------------------------------------
+ * The writer
+ *
+ * One section at a time, straight into the staging buffer: a record header
+ * (ss_rec_hdr below), its name, its payload. Offsets are from the staging
+ * start, which is data offset 0 of the image. Past the committed size the
+ * writer keeps counting (pos) without writing: that count is what the next
+ * prepare grows to.
+ * -----------------------------------------------------------------------*/
+typedef struct ss_rec_hdr {        /* 24 bytes before every record's name */
+    uint32_t type;
+    uint16_t name_len;             /* the name's bytes, NUL excluded */
+    uint16_t flags;
+    uint32_t skip;                 /* header end -> payload: the name, its NUL, padding */
+    uint32_t rsvd;
+    uint64_t len;                  /* payload bytes; the next record is 8-aligned after it */
+} ss_rec_hdr;
+_Static_assert(sizeof(ss_rec_hdr) == 24, "ss_rec_hdr is 24 bytes");
+
+/* FIELDS and RECS payloads: this, nfields descriptors, the names (each NUL
+ * terminated, the area padded to 8), then `count` records of rec_size bytes:
+ * a u32 key, 4 bytes of padding, every field 8-aligned at its data_off. */
+typedef struct ss_fl_hdr {
+    uint64_t layout_hash;
+    uint32_t nfields, names_len, rec_size, count;
+} ss_fl_hdr;
+typedef struct ss_fl_desc { uint32_t name_hash, size, name_off, data_off; } ss_fl_desc;
+_Static_assert(sizeof(ss_fl_hdr) == 24, "ss_fl_hdr is 24 bytes");
+#define FL_COUNT_AT 20u            /* offsetof(ss_fl_hdr, count) */
+
+struct ss_writer {
+    int         active;            /* inside ss_state_capture */
+    uint64_t    pos;               /* next byte (may run past the cap: counting) */
+    uint64_t    sec0;              /* the current section's first byte */
+    uint32_t    fourcc;
+    int         err;
+    char        what[160];
+    uint32_t    open;              /* the open record's type; 0 none */
+    const char* open_name;
+    uint64_t    rec_at, pay_at;
+    const ss_list* rl;             /* RECS: its list and record size */
+    uint32_t    rsize, rcount;
+    uint32_t    nrec;              /* records of the section */
+    ss_capture_info info;
+};
+static ss_writer s_w;
+
+static int w_fail(ss_writer* w, int e, const char* fmt, ...)
+{
+    if (!w->err) {
+        char b[5];
+        w->err = e;
+        int p = snprintf(w->what, sizeof w->what, "%s: ", ss_fourcc_str(w->fourcc, b));
+        if (p < 0 || p >= (int)sizeof w->what) p = 0;
+        va_list ap;
+        va_start(ap, fmt);
+        vsnprintf(w->what + p, sizeof w->what - (size_t)p, fmt, ap);
+        va_end(ap);
+    }
+    return w->err;
+}
+
+static uint8_t* stg_at(uint64_t off, uint64_t n)
+{
+    return (s_stg && off + n <= s_stg_cap) ? s_stg + off : NULL;
+}
+
+/* n bytes of p (NULL: zeros) at pos. */
+static int w_put(ss_writer* w, const void* p, uint64_t n)
+{
+    if (w->err && w->err != SS_E_OVERFLOW) return w->err;
+    if (!n) return w->err;
+    uint8_t* d = w->err ? NULL : stg_at(w->pos, n);
+    if (!d && !w->err)
+        w_fail(w, SS_E_OVERFLOW, "the staging buffer is full (%.1f MB)", (double)s_stg_cap / MB);
+    if (d) { if (p) memcpy(d, p, (size_t)n); else memset(d, 0, (size_t)n); }
+    w->pos += n;
+    return w->err;
+}
+
+static int w_usable(ss_writer* w)
+{
+    if (!w || !w->active) return SS_E_STATE;
+    if (w->err && w->err != SS_E_OVERFLOW) return w->err;
+    return SS_OK;
+}
+
+static int rec_begin(ss_writer* w, uint32_t type, const char* name, uint32_t align)
+{
+    const int e = w_usable(w);
+    if (e) return e;
+    if (w->open)
+        return w_fail(w, SS_E_STATE, "record '%s' still open when '%s' began",
+                      w->open_name ? w->open_name : "", name ? name : "");
+    if (!align) align = 8;
+    if ((align & (align - 1)) || align > 4096) return w_fail(w, SS_E_ARG, "alignment %u", align);
+    const size_t nl = name ? strlen(name) : 0;
+    if (nl > 4000) return w_fail(w, SS_E_ARG, "a record name of %zu bytes", nl);
+    w->pos = align_up(w->pos, 8);
+    const uint64_t at = w->pos;
+    uint64_t pay = align_up(at + sizeof(ss_rec_hdr) + nl + 1, 8);
+    if (align > 8) pay = align_up(pay, align);
+    ss_rec_hdr h;
+    memset(&h, 0, sizeof h);
+    h.type = type;
+    h.name_len = (uint16_t)nl;
+    h.skip = (uint32_t)(pay - at - sizeof h);
+    w_put(w, &h, sizeof h);
+    w_put(w, name, nl);
+    w_put(w, NULL, pay - (at + sizeof h + nl));         /* the NUL and the padding */
+    w->open = type;
+    w->open_name = name;
+    w->rec_at = at;
+    w->pay_at = pay;
+    return w->err;
+}
+
+static int rec_end(ss_writer* w)
+{
+    const int e = w_usable(w);
+    if (e == SS_E_STATE) return e;
+    if (!w->open) return w_fail(w, SS_E_STATE, "no record open");
+    const uint64_t len = w->pos - w->pay_at;
+    uint8_t* h = stg_at(w->rec_at, sizeof(ss_rec_hdr));
+    if (h && !w->err) memcpy(h + offsetof(ss_rec_hdr, len), &len, sizeof len);
+    w_put(w, NULL, align_up(w->pos, 8) - w->pos);
+    w->open = 0;
+    w->open_name = NULL;
+    w->nrec++;
+    return w->err;
+}
+
+static const uint8_t* field_src(const ss_field* f, const void* base)
+{
+    return base ? (const uint8_t*)base + (uintptr_t)f->at : (const uint8_t*)f->at;
+}
+
+/* Names and sizes of a list, checked: every field named, no name twice, a
+ * static list not read as member offsets. */
+static int fl_layout(ss_writer* w, const ss_list* l, const void* base, uint32_t* names_len, uint32_t* rec_size)
+{
+    if (!l || (l->n && !l->f)) return w_fail(w, SS_E_ARG, "a NULL field list");
+    uint64_t nl = 0, rs = 8;
+    for (uint32_t i = 0; i < l->n; i++) {
+        const ss_field* f = &l->f[i];
+        if (!f->name || !f->name[0]) return w_fail(w, SS_E_ARG, "list '%s': field %u has no name", l->name, i);
+        if (!base && (uintptr_t)f->at < 0x10000u)
+            return w_fail(w, SS_E_ARG, "list '%s': '%s' is a member offset -- write it with ss_write_fields_at"
+                          " / ss_recs_add", l->name, f->name);
+        const uint32_t h = ss_name_hash(f->name);
+        for (uint32_t j = 0; j < i; j++)
+            if (ss_name_hash(l->f[j].name) == h && !strcmp(l->f[j].name, f->name))
+                return w_fail(w, SS_E_ARG, "list '%s': field '%s' twice", l->name, f->name);
+        nl += strlen(f->name) + 1;
+        rs += align_up(f->size, 8);
+    }
+    if (rs > 0x7FFFFFFFull) return w_fail(w, SS_E_ARG, "list '%s': a record of %llu bytes", l->name,
+                                          (unsigned long long)rs);
+    *names_len = (uint32_t)align_up(nl, 8);
+    *rec_size = (uint32_t)rs;
+    return SS_OK;
+}
+
+static int fl_begin(ss_writer* w, uint32_t type, const ss_list* l, const void* base)
+{
+    uint32_t names_len = 0, rec_size = 0;
+    int e = w_usable(w);
+    if (e) return e;
+    if ((e = fl_layout(w, l, base, &names_len, &rec_size)) != 0) return e;
+    if ((e = rec_begin(w, type, l->name, 8)) != 0 && e != SS_E_OVERFLOW) return e;
+    ss_fl_hdr fh;
+    fh.layout_hash = ss_list_hash(l);
+    fh.nfields = l->n;
+    fh.names_len = names_len;
+    fh.rec_size = rec_size;
+    fh.count = type == SS_REC_FIELDS ? 1u : 0u;
+    w_put(w, &fh, sizeof fh);
+    uint32_t noff = 0, doff = 8;
+    for (uint32_t i = 0; i < l->n; i++) {
+        ss_fl_desc d;
+        d.name_hash = ss_name_hash(l->f[i].name);
+        d.size = l->f[i].size;
+        d.name_off = noff;
+        d.data_off = doff;
+        w_put(w, &d, sizeof d);
+        noff += (uint32_t)strlen(l->f[i].name) + 1;
+        doff += (uint32_t)align_up(l->f[i].size, 8);
+    }
+    uint32_t put = 0;
+    for (uint32_t i = 0; i < l->n; i++) {
+        const uint32_t k = (uint32_t)strlen(l->f[i].name) + 1;
+        w_put(w, l->f[i].name, k);
+        put += k;
+    }
+    w_put(w, NULL, names_len - put);
+    w->rl = l;
+    w->rsize = rec_size;
+    w->rcount = 0;
+    return w->err;
+}
+
+static int fl_record(ss_writer* w, uint32_t key, const void* base)
+{
+    const ss_list* l = w->rl;
+    const uint32_t kh[2] = { key, 0 };
+    w_put(w, kh, sizeof kh);
+    for (uint32_t i = 0; i < l->n; i++) {
+        const ss_field* f = &l->f[i];
+        if (!base && (uintptr_t)f->at < 0x10000u)
+            return w_fail(w, SS_E_ARG, "list '%s': '%s' is a member offset", l->name, f->name);
+        w_put(w, field_src(f, base), f->size);
+        w_put(w, NULL, align_up(f->size, 8) - f->size);
+    }
+    w->rcount++;
+    return w->err;
+}
+
+int ss_write_fields_at(ss_writer* w, const ss_list* l, const void* base)
+{
+    int e = fl_begin(w, SS_REC_FIELDS, l, base);
+    if (e && e != SS_E_OVERFLOW) return e;
+    fl_record(w, 0, base);
+    w->rl = NULL;
+    return rec_end(w);
+}
+int ss_write_fields(ss_writer* w, const ss_list* l) { return ss_write_fields_at(w, l, NULL); }
+
+int ss_recs_begin(ss_writer* w, const ss_list* l)
+{
+    if (l && l->n > 128) {
+        if (w_usable(w) == SS_E_STATE) return SS_E_STATE;
+        return w_fail(w, SS_E_ARG, "list '%s': %u fields (a RECS list holds up to 128)", l->name, l->n);
+    }
+    /* (base is checked per record: a RECS list is always member offsets) */
+    static const char k_dummy = 0;
+    return fl_begin(w, SS_REC_RECS, l, &k_dummy);
+}
+
+int ss_recs_add(ss_writer* w, uint32_t key, const void* base)
+{
+    const int e = w_usable(w);
+    if (e && e != SS_E_OVERFLOW) return e;
+    if (w->open != SS_REC_RECS || !w->rl) return w_fail(w, SS_E_STATE, "ss_recs_add with no ss_recs_begin");
+    if (!base) return w_fail(w, SS_E_ARG, "list '%s': a NULL record", w->rl->name);
+    return fl_record(w, key, base);
+}
+
+int ss_recs_end(ss_writer* w)
+{
+    const int e = w_usable(w);
+    if (e == SS_E_STATE) return e;
+    if (w->open != SS_REC_RECS) return w_fail(w, SS_E_STATE, "ss_recs_end with no ss_recs_begin");
+    uint8_t* c = stg_at(w->pay_at + FL_COUNT_AT, 4);
+    if (c && !w->err) memcpy(c, &w->rcount, 4);
+    w->rl = NULL;
+    return rec_end(w);
+}
+
+int ss_blob_begin(ss_writer* w, const char* name, uint32_t align)
+{
+    return rec_begin(w, SS_REC_BLOB, name, align);
+}
+int ss_blob_put(ss_writer* w, const void* p, uint64_t n)
+{
+    const int e = w_usable(w);
+    if (e && e != SS_E_OVERFLOW) return e;
+    if (w->open != SS_REC_BLOB) return w_fail(w, SS_E_STATE, "ss_blob_put with no blob open");
+    if (!p && n) return w_fail(w, SS_E_ARG, "blob '%s': NULL data", w->open_name ? w->open_name : "");
+    return w_put(w, p, n);
+}
+void* ss_blob_reserve(ss_writer* w, uint64_t n)
+{
+    if (w_usable(w) == SS_E_STATE || w->open != SS_REC_BLOB) {
+        if (w && w->active) w_fail(w, SS_E_STATE, "ss_blob_reserve with no blob open");
+        return NULL;
+    }
+    if (w->err && w->err != SS_E_OVERFLOW) return NULL;
+    uint8_t* d = w->err ? NULL : stg_at(w->pos, n);
+    if (!d && !w->err)
+        w_fail(w, SS_E_OVERFLOW, "the staging buffer is full (%.1f MB)", (double)s_stg_cap / MB);
+    w->pos += n;
+    return d;
+}
+int ss_blob_end(ss_writer* w)
+{
+    if (w_usable(w) == SS_E_STATE) return SS_E_STATE;
+    if (w->open != SS_REC_BLOB) return w_fail(w, SS_E_STATE, "ss_blob_end with no blob open");
+    return rec_end(w);
+}
+int ss_write_blob(ss_writer* w, const char* name, const void* p, uint64_t n)
+{
+    int e = ss_blob_begin(w, name, 8);
+    if (e && e != SS_E_OVERFLOW) return e;
+    ss_blob_put(w, p, n);
+    return ss_blob_end(w);
+}
+
+int ss_write_u64(ss_writer* w, const char* name, uint64_t v)
+{
+    int e = rec_begin(w, SS_REC_U64, name, 8);
+    if (e && e != SS_E_OVERFLOW) return e;
+    w_put(w, &v, sizeof v);
+    return rec_end(w);
+}
+
+int ss_write_tlv(ss_writer* w, uint32_t type, const char* name, const void* p, uint64_t n)
+{
+    if (type == SS_REC_FIELDS || type == SS_REC_RECS || type == 0) {
+        if (w_usable(w) == SS_E_STATE) return SS_E_STATE;
+        return w_fail(w, SS_E_ARG, "ss_write_tlv: type 0x%08X is reserved", type);
+    }
+    int e = rec_begin(w, type, name, 8);
+    if (e && e != SS_E_OVERFLOW) return e;
+    if (!p && n) return w_fail(w, SS_E_ARG, "tlv '%s': NULL data", name ? name : "");
+    w_put(w, p, n);
+    return rec_end(w);
+}
+
+int ss_text_begin(ss_writer* w, const char* name) { return rec_begin(w, SS_REC_TEXT, name, 8); }
+
+int ss_text_vprintf(ss_writer* w, const char* fmt, va_list ap)
+{
+    const int e = w_usable(w);
+    if (e && e != SS_E_OVERFLOW) return e;
+    if (w->open != SS_REC_TEXT) return w_fail(w, SS_E_STATE, "ss_text_printf with no text open");
+    char* d = (!w->err && s_stg && w->pos < s_stg_cap) ? (char*)s_stg + w->pos : NULL;
+    const uint64_t room = d ? s_stg_cap - w->pos : 0;
+    va_list cp;
+    va_copy(cp, ap);
+    const int k = vsnprintf(d, d ? (size_t)(room > 0x7FFFFFFFull ? 0x7FFFFFFFull : room) : 0, fmt, cp);
+    va_end(cp);
+    if (k < 0) return w_fail(w, SS_E_ARG, "text '%s': a bad format", w->open_name ? w->open_name : "");
+    if (!w->err && (uint64_t)k >= room)
+        w_fail(w, SS_E_OVERFLOW, "the staging buffer is full (%.1f MB)", (double)s_stg_cap / MB);
+    w->pos += (uint64_t)k;                            /* (vsnprintf's NUL is overwritten next) */
+    return w->err;
+}
+
+int ss_text_printf(ss_writer* w, const char* fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    const int e = ss_text_vprintf(w, fmt, ap);
+    va_end(ap);
+    return e;
+}
+
+int ss_text_end(ss_writer* w)
+{
+    if (w_usable(w) == SS_E_STATE) return SS_E_STATE;
+    if (w->open != SS_REC_TEXT) return w_fail(w, SS_E_STATE, "ss_text_end with no text open");
+    return rec_end(w);
+}
+
+int ss_writer_error(const ss_writer* w) { return w ? w->err : SS_E_ARG; }
+const char* ss_writer_what(const ss_writer* w) { return (w && w->err) ? w->what : ""; }
+uint64_t ss_writer_size(const ss_writer* w) { return w ? w->pos - w->sec0 : 0; }
+const ss_capture_info* ss_writer_info(const ss_writer* w) { return w ? &w->info : NULL; }
+
+/* ---------------------------------------------------------------------------
+ * The image of the last capture: tables in statics, data in staging.
+ * -----------------------------------------------------------------------*/
+static ss_sec_ent   s_tabs[2][SS_SECTION_MAX];   /* per bank */
+static ss_chunk_ent s_chks[2][SS_CHUNK_MAX];
+static ss_image     s_imgs[2];
+#define s_tab (s_tabs[s_bank])
+#define s_chk (s_chks[s_bank])
+#define s_img (s_imgs[s_bank])
+static int          s_capd[2];      /* the bank holds a complete capture (sealed or not) */
+static double       s_cap_ms;
+
+const ss_image* ss_image_last(void) { return s_img.sealed ? &s_img : NULL; }
+double ss_state_capture_ms(void) { return s_cap_ms; }
+
+/* A complete capture can be held before its seal: a selftest captures state
+ * A and loads it in the same stop, where no CRC is needed. */
+const ss_image* ss_image_hold(void)
+{
+    if (!s_capd[s_bank]) return NULL;
+    s_held = s_bank;                                  /* (replaces a held image in the other bank) */
+    s_bank ^= 1;
+    s_imgs[s_bank].sealed = 0;                        /* the other bank: next capture's */
+    s_capd[s_bank] = 0;
+    return &s_imgs[s_held];
+}
+const ss_image* ss_image_held(void) { return s_held >= 0 && s_capd[s_held] ? &s_imgs[s_held] : NULL; }
+void ss_image_release(void) { s_held = -1; }
+
+const ss_sec_ent* ss_image_section(const ss_image* img, uint32_t fourcc)
+{
+    if (!img || !img->sec) return NULL;
+    for (uint32_t i = 0; i < img->hdr.nsections; i++) if (img->sec[i].fourcc == fourcc) return &img->sec[i];
+    return NULL;
+}
+
+/* The metadata's CRC32C: the header (hdr_crc 0), the section table, the
+ * chunk table -- so a damaged table is refused before anything trusts it. */
+static uint32_t meta_crc(const ss_img_hdr* h, const ss_sec_ent* sec, const ss_chunk_ent* chk)
+{
+    ss_img_hdr c = *h;
+    c.hdr_crc = 0;
+    uint32_t crc = ss_crc32c(0, &c, sizeof c);
+    crc = ss_crc32c(crc, sec, (size_t)h->nsections * sizeof *sec);
+    return ss_crc32c(crc, chk, (size_t)h->nchunks * sizeof *chk);
+}
+
+int ss_state_check(char* why, size_t why_n, uint32_t* fourcc)
+{
+    sort_sections();
+    if (fourcc) *fourcc = 0;
+    for (int i = 0; i < s_nord; i++) {
+        const ss_section_ops* o = s_sec[s_ord[i]];
+        if (!o->check) continue;
+        if (why && why_n) why[0] = 0;
+        const int r = o->check(why, why_n);
+        if (r) {
+            if (fourcc) *fourcc = o->fourcc;
+            return r;
+        }
+    }
+    return 0;
+}
+
+static uint32_t s_cap_seq;          /* captures run (MAPS -> GMEM handshake) */
+static uint32_t s_maps_seq;
+static int s_arena_set;
+
+int ss_state_capture(const ss_capture_info* info, char* why, size_t why_n, uint32_t* fourcc)
+{
+    sort_sections();
+    ss_writer* w = &s_w;
+    memset(w, 0, sizeof *w);
+    if (info) w->info = *info;
+    if (!w->info.unix_ms) w->info.unix_ms = unix_ms_now();
+    if (!w->info.qpc || !w->info.qpc_freq) {            /* the capture's one instant (TIME's): */
+        w->info.qpc = (uint64_t)ps3_guest_qpc();        /* guest QPC, frozen by the coordinator */
+        w->info.qpc_freq = (uint64_t)ps3_guest_qpc_freq();
+    }
+    w->active = 1;
+    s_img.sealed = 0;
+    s_capd[s_bank] = 0;
+    s_cap_seq++;
+    if (fourcc) *fourcc = 0;
+    const uint64_t t0 = now_us();
+    uint32_t nsec = 0, nch = 0;
+    int bad = -1;
+    for (int i = 0; i < s_nord; i++) {
+        const ss_section_ops* o = s_sec[s_ord[i]];
+        w_put(w, NULL, align_up(w->pos, 4096) - w->pos);   /* sections start page-aligned */
+        w->sec0 = w->pos;
+        w->fourcc = o->fourcc;
+        w->nrec = 0;
+        const uint64_t t = now_us();
+        const int rc = o->capture ? o->capture(w) : 0;
+        const uint64_t dt = now_us() - t;
+        if (w->open) w_fail(w, SS_E_STATE, "record '%s' left open", w->open_name ? w->open_name : "");
+        if (rc < 0 && !w->err) w_fail(w, rc, "capture() returned %d (%s)", rc, ss_strerror(rc));
+        ss_sec_ent* e = &s_tab[nsec++];
+        memset(e, 0, sizeof *e);
+        e->fourcc = o->fourcc;
+        e->version = o->version;
+        e->flags = o->flags;
+        e->order = o->order;
+        e->layout_hash = ss_section_layout_hash(o);
+        e->offset = w->sec0;
+        e->size = w->pos - w->sec0;
+        e->records = w->nrec;
+        e->capture_us = dt > 0xFFFFFFFFull ? 0xFFFFFFFFu : (uint32_t)dt;
+        e->chunk0 = nch;
+        for (uint64_t off = 0; off < e->size; off += SS_CHUNK_BYTES) {
+            if (nch >= SS_CHUNK_MAX) {
+                w_fail(w, SS_E_OVERFLOW, "more than %u chunks", SS_CHUNK_MAX);
+                break;
+            }
+            ss_chunk_ent* c = &s_chk[nch++];
+            c->offset = e->offset + off;
+            c->size = (uint32_t)(e->size - off < SS_CHUNK_BYTES ? e->size - off : SS_CHUNK_BYTES);
+            c->crc = 0;
+        }
+        e->nchunks = nch - e->chunk0;
+        if (w->err && bad < 0) bad = i;
+        if (w->err && w->err != SS_E_OVERFLOW) break;   /* an overflow keeps counting */
+    }
+    w->active = 0;
+    s_need = w->pos;
+    s_cap_ms = (double)(now_us() - t0) / 1000.0;
+    if (w->err) {
+        if (fourcc && bad >= 0) *fourcc = s_sec[s_ord[bad]]->fourcc;
+        if (why) snprintf(why, why_n, "%s%s", w->what,
+                          w->err == SS_E_OVERFLOW ? " -- grown before the next try" : "");
+        return w->err;
+    }
+    ss_img_hdr* h = &s_img.hdr;
+    memset(h, 0, sizeof *h);
+    memcpy(h->magic, SS_RAW_MAGIC, 8);
+    h->version = SS_RAW_VERSION;
+    h->hdr_size = (uint32_t)sizeof *h;
+    h->nsections = nsec;
+    h->nchunks = nch;
+    h->sec_off = sizeof *h;
+    h->chunk_off = h->sec_off + (uint64_t)nsec * sizeof(ss_sec_ent);
+    h->data_off = align_up(h->chunk_off + (uint64_t)nch * sizeof(ss_chunk_ent), 4096);
+    h->data_size = w->pos;
+    h->file_size = h->data_off + h->data_size;
+    uint64_t lh = FNV64_INIT;
+    for (uint32_t i = 0; i < nsec; i++) {
+        if (s_tab[i].flags & SS_SEC_INFO) continue;
+        lh = fnv64(lh, &s_tab[i].fourcc, 4);
+        lh = fnv64(lh, &s_tab[i].layout_hash, 8);
+    }
+    h->layout_hash = lh;
+    h->created_unix_ms = w->info.unix_ms;
+    h->chunk_bytes = SS_CHUNK_BYTES;
+    h->flags = s_arena_set ? 0u : SS_IMG_NO_ARENA;
+    h->seq = w->info.seq;
+    snprintf(h->build, sizeof h->build, "ps3recomp ss_state %s %s", __DATE__, __TIME__);
+    s_img.sec = s_tab;
+    s_img.chunk = s_chk;
+    s_img.data = s_stg;
+    s_capd[s_bank] = 1;
+    return SS_OK;
+}
+
+double ss_state_seal(void)
+{
+    const uint64_t t0 = now_us();
+    ss_img_hdr* h = &s_img.hdr;
+    if (!s_img.sec || !h->nsections || s_img.sealed) return 0.0;
+    for (uint32_t i = 0; i < h->nchunks; i++)
+        s_chk[i].crc = ss_crc32c(0, s_stg + s_chk[i].offset, s_chk[i].size);
+    h->hdr_crc = meta_crc(h, s_tab, s_chk);
+    s_img.sealed = 1;
+    return (double)(now_us() - t0) / 1000.0;
+}
+
+/* ---------------------------------------------------------------------------
+ * The reader
+ * -----------------------------------------------------------------------*/
+static int r_fail(ss_reader* r, int e, const char* fmt, ...)
+{
+    if (!r->err) {
+        r->err = e;
+        va_list ap;
+        va_start(ap, fmt);
+        vsnprintf(r->what, sizeof r->what, fmt, ap);
+        va_end(ap);
+    }
+    return e;
+}
+
+const char* ss_reader_what(const ss_reader* r) { return (r && r->err) ? r->what : ""; }
+
+int ss_reader_fail(ss_reader* r, int err, const char* fmt, ...)
+{
+    if (!r) return err;
+    if (!r->err) {
+        r->err = err;
+        va_list ap;
+        va_start(ap, fmt);
+        vsnprintf(r->what, sizeof r->what, fmt, ap);
+        va_end(ap);
+    }
+    return err;
+}
+
+int ss_reader_open(ss_reader* r, const ss_image* img, uint32_t fourcc)
+{
+    if (!r) return SS_E_ARG;
+    memset(r, 0, sizeof *r);
+    r->img = img;
+    r->fourcc = fourcc;
+    const ss_sec_ent* e = ss_image_section(img, fourcc);
+    char b[5];
+    if (!e) return r_fail(r, SS_E_NOT_FOUND, "no section %s in the image", ss_fourcc_str(fourcc, b));
+    r->version = e->version;
+    r->flags = e->flags;
+    r->data = img->data + e->offset;
+    r->size = e->size;
+    return SS_OK;
+}
+
+/* The record at off: 1 and *o filled (and *next), or < 0. */
+static int rec_parse(ss_reader* r, uint64_t off, ss_rec* o, uint64_t* next)
+{
+    if (off + sizeof(ss_rec_hdr) > r->size) return r_fail(r, SS_E_CORRUPT, "a record header past the section end");
+    ss_rec_hdr h;
+    memcpy(&h, r->data + off, sizeof h);
+    const uint64_t pay = off + sizeof h + h.skip;
+    if ((uint64_t)h.name_len + 1 > h.skip || pay > r->size || h.len > r->size - pay)
+        return r_fail(r, SS_E_CORRUPT, "record at +0x%llX runs past the section", (unsigned long long)off);
+    memset(o, 0, sizeof *o);
+    o->type = h.type;
+    o->flags = h.flags;
+    const size_t k = h.name_len < sizeof o->name - 1 ? h.name_len : sizeof o->name - 1;
+    memcpy(o->name, r->data + off + sizeof h, k);
+    o->name[k] = 0;
+    o->data = r->data + pay;
+    o->len = h.len;
+    o->off = off;
+    *next = align_up(pay + h.len, 8);
+    return 1;
+}
+
+int ss_rec_next(ss_reader* r, uint64_t* cursor, ss_rec* out)
+{
+    if (!r || !cursor || !out) return SS_E_ARG;
+    if (*cursor >= r->size) return 0;
+    uint64_t next = 0;
+    const int k = rec_parse(r, *cursor, out, &next);
+    if (k < 0) return k;
+    *cursor = next;
+    return 1;
+}
+
+static int name_is(ss_reader* r, const ss_rec* rec, const char* name)
+{
+    ss_rec_hdr h;
+    memcpy(&h, r->data + rec->off, sizeof h);
+    const size_t n = name ? strlen(name) : 0;
+    return n == h.name_len && (!n || !memcmp(r->data + rec->off + sizeof h, name, n));
+}
+
+int ss_rec_find(ss_reader* r, uint32_t type, const char* name, ss_rec* out)
+{
+    if (!r || !out) return SS_E_ARG;
+    if (!r->data) return r_fail(r, SS_E_NOT_FOUND, "no section open");
+    for (int pass = 0; pass < 2; pass++) {
+        uint64_t c = pass ? 0 : r->pos;
+        const uint64_t end = pass ? r->pos : r->size;
+        while (c < end) {
+            uint64_t next = 0;
+            const int k = rec_parse(r, c, out, &next);
+            if (k < 0) return k;
+            if (out->type == type && name_is(r, out, name)) { r->pos = next; return SS_OK; }
+            c = next;
+        }
+    }
+    char b[5], t[5];
+    return r_fail(r, SS_E_NOT_FOUND, "%s: no %s record '%s'", ss_fourcc_str(r->fourcc, b),
+                  ss_fourcc_str(type, t), name ? name : "");
+}
+
+/* A FIELDS / RECS payload, bounds checked. */
+typedef struct fl_view {
+    ss_fl_hdr      h;
+    const uint8_t* desc;
+    const uint8_t* names;
+    const uint8_t* recs;
+} fl_view;
+
+static int fl_parse(ss_reader* r, const ss_rec* rec, fl_view* v)
+{
+    if (rec->len < sizeof(ss_fl_hdr)) return r_fail(r, SS_E_CORRUPT, "'%s': a short field list", rec->name);
+    memcpy(&v->h, rec->data, sizeof v->h);
+    const uint64_t dsz = (uint64_t)v->h.nfields * sizeof(ss_fl_desc);
+    const uint64_t body = sizeof(ss_fl_hdr) + dsz + v->h.names_len;
+    if (body > rec->len || v->h.rec_size < 8 ||
+        (uint64_t)v->h.rec_size * v->h.count > rec->len - body)
+        return r_fail(r, SS_E_CORRUPT, "'%s': the field list runs past its record", rec->name);
+    v->desc = rec->data + sizeof(ss_fl_hdr);
+    v->names = v->desc + dsz;
+    v->recs = v->names + v->h.names_len;
+    for (uint32_t j = 0; j < v->h.nfields; j++) {
+        ss_fl_desc d;
+        memcpy(&d, v->desc + (uint64_t)j * sizeof d, sizeof d);
+        if (d.name_off >= v->h.names_len || !memchr(v->names + d.name_off, 0, v->h.names_len - d.name_off) ||
+            d.data_off < 8 || (uint64_t)d.data_off + d.size > v->h.rec_size)
+            return r_fail(r, SS_E_CORRUPT, "'%s': field %u out of bounds", rec->name, j);
+    }
+    return SS_OK;
+}
+
+#define FL_NONE 0xFFFFFFFFu
+/* The image field named `name` (FL_NONE: none), its descriptor in *d. */
+static uint32_t fl_find(const fl_view* v, const char* name, ss_fl_desc* d)
+{
+    const uint32_t h = ss_name_hash(name);
+    for (uint32_t j = 0; j < v->h.nfields; j++) {
+        memcpy(d, v->desc + (uint64_t)j * sizeof *d, sizeof *d);
+        if (d->name_hash == h && !strcmp((const char*)v->names + d->name_off, name)) return j;
+    }
+    return FL_NONE;
+}
+
+/* The list against the image's: every field of l there with its size (an
+ * SS_FF_OPTIONAL one may be missing), every image field in l. map (if not
+ * NULL, map_n entries) gets the image field of each list field. Every
+ * mismatch is an SS_E_LAYOUT naming the field. */
+static int fl_match(ss_reader* r, const ss_list* l, const fl_view* v, uint32_t* map, uint32_t map_n)
+{
+    if (map && l->n > map_n)
+        return r_fail(r, SS_E_ARG, "list '%s': %u fields (a RECS list holds up to %u)", l->name, l->n, map_n);
+    for (uint32_t i = 0; i < l->n; i++) {
+        const ss_field* f = &l->f[i];
+        ss_fl_desc d;
+        const uint32_t j = fl_find(v, f->name, &d);
+        if (map) map[i] = j;
+        if (j == FL_NONE) {
+            if (f->flags & SS_FF_OPTIONAL) continue;
+            return r_fail(r, SS_E_LAYOUT, "%s.%s: not in the image", l->name, f->name);
+        }
+        if (d.size != f->size)
+            return r_fail(r, SS_E_LAYOUT, "%s.%s: %u bytes in the image, %u in this build",
+                          l->name, f->name, d.size, f->size);
+    }
+    for (uint32_t j = 0; j < v->h.nfields; j++) {
+        ss_fl_desc d;
+        memcpy(&d, v->desc + (uint64_t)j * sizeof d, sizeof d);
+        const char* nm = (const char*)v->names + d.name_off;
+        int known = 0;
+        for (uint32_t i = 0; i < l->n && !known; i++)
+            known = ss_name_hash(l->f[i].name) == d.name_hash && !strcmp(l->f[i].name, nm);
+        if (!known) return r_fail(r, SS_E_LAYOUT, "%s.%s: in the image, not in this build", l->name, nm);
+    }
+    return SS_OK;
+}
+
+/* One record's fields into base (or the statics); map NULL: looked up by name. */
+static void fl_copy(const ss_list* l, const fl_view* v, const uint32_t* map, const uint8_t* rec, void* base)
+{
+    for (uint32_t i = 0; i < l->n; i++) {
+        const ss_field* f = &l->f[i];
+        if (f->flags & SS_FF_NO_RESTORE) continue;
+        ss_fl_desc d;
+        const uint32_t j = map ? map[i] : fl_find(v, f->name, &d);
+        if (j == FL_NONE) continue;
+        if (map) memcpy(&d, v->desc + (uint64_t)j * sizeof d, sizeof d);
+        uint8_t* dst = base ? (uint8_t*)base + (uintptr_t)f->at : (uint8_t*)f->at;
+        memcpy(dst, rec + d.data_off, f->size);
+    }
+}
+
+int ss_read_fields_at(ss_reader* r, const ss_list* l, void* base)
+{
+    if (!r || !l || (l->n && !l->f)) return SS_E_ARG;
+    for (uint32_t i = 0; i < l->n; i++)
+        if (!base && (uintptr_t)l->f[i].at < 0x10000u)
+            return r_fail(r, SS_E_ARG, "list '%s': '%s' is a member offset -- read it with ss_read_fields_at",
+                          l->name, l->f[i].name);
+    ss_rec rec;
+    int e = ss_rec_find(r, SS_REC_FIELDS, l->name, &rec);
+    if (e) return e;
+    fl_view v;
+    if ((e = fl_parse(r, &rec, &v)) != 0) return e;
+    if (v.h.count != 1) return r_fail(r, SS_E_CORRUPT, "'%s': %u records in a FIELDS", l->name, v.h.count);
+    /* (a file's statics can run to hundreds: matched by name, no bounded map) */
+    if ((e = fl_match(r, l, &v, NULL, 0)) != 0) return e;
+    fl_copy(l, &v, NULL, v.recs, base);
+    return SS_OK;
+}
+int ss_read_fields(ss_reader* r, const ss_list* l) { return ss_read_fields_at(r, l, NULL); }
+
+int ss_recs_open(ss_reader* r, const ss_list* l, ss_recs_it* it)
+{
+    if (!r || !l || !it || (l->n && !l->f)) return SS_E_ARG;
+    memset(it, 0, sizeof *it);
+    ss_rec rec;
+    int e = ss_rec_find(r, SS_REC_RECS, l->name, &rec);
+    if (e) return e;
+    fl_view v;
+    if ((e = fl_parse(r, &rec, &v)) != 0) return e;
+    if ((e = fl_match(r, l, &v, it->map, (uint32_t)(sizeof it->map / sizeof it->map[0]))) != 0) return e;
+    it->r = r;
+    it->l = l;
+    it->count = v.h.count;
+    it->rec_size = v.h.rec_size;
+    it->nfields = v.h.nfields;
+    it->desc = v.desc;
+    it->names = v.names;
+    it->p = v.recs;
+    return SS_OK;
+}
+
+int ss_recs_next(ss_recs_it* it, uint32_t* key, void* base)
+{
+    if (!it || !it->r) return SS_E_ARG;
+    if (it->i >= it->count) return 0;
+    const uint8_t* rec = it->p + (uint64_t)it->i * it->rec_size;
+    uint32_t k;
+    memcpy(&k, rec, 4);
+    if (key) *key = k;
+    if (base) {
+        fl_view v;
+        memset(&v, 0, sizeof v);
+        v.desc = it->desc;
+        v.names = it->names;
+        v.h.nfields = it->nfields;
+        fl_copy(it->l, &v, it->map, rec, base);
+    }
+    it->i++;
+    return 1;
+}
+
+int ss_find_blob(ss_reader* r, const char* name, const void** p, uint64_t* len)
+{
+    ss_rec rec;
+    const int e = ss_rec_find(r, SS_REC_BLOB, name, &rec);
+    if (e) return e;
+    if (p) *p = rec.data;
+    if (len) *len = rec.len;
+    return SS_OK;
+}
+
+int ss_read_blob(ss_reader* r, const char* name, void* dst, uint64_t cap, uint64_t* len)
+{
+    const void* p = NULL;
+    uint64_t n = 0;
+    const int e = ss_find_blob(r, name, &p, &n);
+    if (e) return e;
+    if (len) *len = n;
+    if (n > cap)
+        return r_fail(r, SS_E_SIZE, "blob '%s': %llu bytes in the image, room for %llu", name,
+                      (unsigned long long)n, (unsigned long long)cap);
+    if (n) memcpy(dst, p, (size_t)n);
+    return SS_OK;
+}
+
+int ss_read_u64(ss_reader* r, const char* name, uint64_t* v)
+{
+    ss_rec rec;
+    const int e = ss_rec_find(r, SS_REC_U64, name, &rec);
+    if (e) return e;
+    if (rec.len != 8) return r_fail(r, SS_E_CORRUPT, "u64 '%s' of %llu bytes", name, (unsigned long long)rec.len);
+    memcpy(v, rec.data, 8);
+    return SS_OK;
+}
+
+int ss_find_text(ss_reader* r, const char* name, const char** p, uint64_t* len)
+{
+    ss_rec rec;
+    const int e = ss_rec_find(r, SS_REC_TEXT, name, &rec);
+    if (e) return e;
+    if (p) *p = (const char*)rec.data;
+    if (len) *len = rec.len;
+    return SS_OK;
+}
+
+/* ---------------------------------------------------------------------------
+ * Image files and validation
+ * -----------------------------------------------------------------------*/
+/* [off, off + len) inside [0, n), with no sum that can wrap: every offset
+ * and size below comes from the file. */
+static int span_in(uint64_t off, uint64_t len, uint64_t n) { return off <= n && len <= n - off; }
+
+int ss_image_parse(ss_image* img, const void* buf, uint64_t n, char* why, size_t why_n)
+{
+    if (!img || !buf) return SS_E_ARG;
+    memset(img, 0, sizeof *img);
+#define BAD(...) do { if (why) snprintf(why, why_n, __VA_ARGS__); return SS_E_CORRUPT; } while (0)
+    if (n < sizeof(ss_img_hdr)) BAD("%llu bytes: shorter than a header", (unsigned long long)n);
+    const uint8_t* b = (const uint8_t*)buf;
+    ss_img_hdr h;
+    memcpy(&h, b, sizeof h);
+    if (memcmp(h.magic, SS_RAW_MAGIC, 8)) BAD("not a raw save-state image (magic)");
+    if (h.version != SS_RAW_VERSION || h.hdr_size != sizeof h) BAD("image version %u (this build reads %u)",
+                                                                    h.version, SS_RAW_VERSION);
+    if (h.file_size > n) BAD("truncated: %llu of %llu bytes", (unsigned long long)n, (unsigned long long)h.file_size);
+    /* the counts first, then each table and the data as a span of the file
+     * (never off + size > n: a crafted offset wraps the sum) -- before the
+     * CRC reads the tables */
+    if (h.nsections > SS_SECTION_MAX || h.nchunks > SS_CHUNK_MAX ||
+        !span_in(h.sec_off, (uint64_t)h.nsections * sizeof(ss_sec_ent), n) ||
+        !span_in(h.chunk_off, (uint64_t)h.nchunks * sizeof(ss_chunk_ent), n) ||
+        !span_in(h.data_off, h.data_size, n) || (h.sec_off & 7u) || (h.chunk_off & 7u) ||
+        !h.chunk_bytes || h.chunk_bytes > SS_CHUNK_BYTES)
+        BAD("table bounds");
+    const ss_sec_ent* sec = (const ss_sec_ent*)(b + h.sec_off);
+    const ss_chunk_ent* chk = (const ss_chunk_ent*)(b + h.chunk_off);
+    if (meta_crc(&h, sec, chk) != h.hdr_crc) BAD("header CRC mismatch (header or tables damaged)");
+    for (uint32_t i = 0; i < h.nsections; i++) {
+        char f[5];
+        if (!span_in(sec[i].offset, sec[i].size, h.data_size) || sec[i].chunk0 + (uint64_t)sec[i].nchunks > h.nchunks)
+            BAD("section %s out of bounds", ss_fourcc_str(sec[i].fourcc, f));
+        uint64_t cov = 0;                             /* (<= the section's size throughout) */
+        for (uint32_t c = sec[i].chunk0; c < sec[i].chunk0 + sec[i].nchunks; c++) {
+            if (chk[c].offset != sec[i].offset + cov || chk[c].size > h.chunk_bytes ||
+                chk[c].size > sec[i].size - cov)
+                BAD("section %s: chunk %u misplaced", ss_fourcc_str(sec[i].fourcc, f), c);
+            cov += chk[c].size;
+        }
+        if (cov != sec[i].size) BAD("section %s: chunks cover %llu of %llu bytes", ss_fourcc_str(sec[i].fourcc, f),
+                                    (unsigned long long)cov, (unsigned long long)sec[i].size);
+    }
+#undef BAD
+    img->hdr = h;
+    img->sec = sec;
+    img->chunk = chk;
+    img->data = b + h.data_off;
+    img->sealed = 1;
+    return SS_OK;
+}
+
+int ss_image_verify(const ss_image* img, char* why, size_t why_n)
+{
+    if (!img || !img->sealed) { if (why) snprintf(why, why_n, "no sealed image"); return SS_E_STATE; }
+    if (meta_crc(&img->hdr, img->sec, img->chunk) != img->hdr.hdr_crc) {
+        if (why) snprintf(why, why_n, "header CRC mismatch (header or tables damaged)");
+        return SS_E_CORRUPT;
+    }
+    for (uint32_t i = 0; i < img->hdr.nsections; i++) {
+        const ss_sec_ent* s = &img->sec[i];
+        for (uint32_t c = s->chunk0; c < s->chunk0 + s->nchunks; c++) {
+            const ss_chunk_ent* k = &img->chunk[c];
+            if (ss_crc32c(0, img->data + k->offset, k->size) != k->crc) {
+                char f[5];
+                if (why) snprintf(why, why_n, "section %s: chunk %u (+0x%llX, %u bytes) fails its CRC32C",
+                                  ss_fourcc_str(s->fourcc, f), c - s->chunk0,
+                                  (unsigned long long)(k->offset - s->offset), k->size);
+                return SS_E_CORRUPT;
+            }
+        }
+    }
+    return SS_OK;
+}
+
+int ss_image_validate(const ss_image* img, char* why, size_t why_n)
+{
+    return ss_image_validate_ex(img, 1, why, why_n);
+}
+
+int ss_image_validate_ex(const ss_image* img, int check_crc, char* why, size_t why_n)
+{
+    int e;
+    if (check_crc) e = ss_image_verify(img, why, why_n);
+    else if (!img || !img->sealed) { if (why) snprintf(why, why_n, "no sealed image"); e = SS_E_STATE; }
+    else if (meta_crc(&img->hdr, img->sec, img->chunk) != img->hdr.hdr_crc) {
+        if (why) snprintf(why, why_n, "header CRC mismatch (header or tables damaged)");
+        e = SS_E_CORRUPT;
+    } else e = SS_OK;
+    if (e) return e;
+    for (uint32_t i = 0; i < img->hdr.nsections; i++) {
+        const ss_sec_ent* s = &img->sec[i];
+        char f[5];
+        ss_fourcc_str(s->fourcc, f);
+        ss_reader r;
+        ss_reader_open(&r, img, s->fourcc);
+        uint64_t cur = 0;
+        ss_rec rec;
+        uint32_t n = 0;
+        while ((e = ss_rec_next(&r, &cur, &rec)) == 1) {
+            n++;
+            if (rec.type == SS_REC_FIELDS || rec.type == SS_REC_RECS) {
+                fl_view v;
+                if (fl_parse(&r, &rec, &v)) break;
+            }
+        }
+        if (r.err) { if (why) snprintf(why, why_n, "section %s: %s", f, r.what); return r.err; }
+        if (n != s->records) {
+            if (why) snprintf(why, why_n, "section %s: %u records, the table says %u", f, n, s->records);
+            return SS_E_CORRUPT;
+        }
+        const ss_section_ops* o = ss_section_find(s->fourcc);
+        if (!o) {
+            if (s->flags & (SS_SEC_OPTIONAL | SS_SEC_INFO)) continue;
+            if (why) snprintf(why, why_n, "section %s is unknown to this build (and not optional)", f);
+            return SS_E_LAYOUT;
+        }
+        if (!(s->flags & SS_SEC_INFO) &&
+            (o->version != s->version || ss_section_layout_hash(o) != s->layout_hash)) {
+            if (why) snprintf(why, why_n, "section %s: version %u / layout %016llX in the image, %u / %016llX"
+                              " in this build", f, s->version, (unsigned long long)s->layout_hash, o->version,
+                              (unsigned long long)ss_section_layout_hash(o));
+            return SS_E_LAYOUT;
+        }
+    }
+    /* every registered section that is neither optional nor informational is
+     * in the image (a capture writes them all; restore skips an absent one) */
+    sort_sections();
+    for (int i = 0; i < s_nord; i++) {
+        const ss_section_ops* o = s_sec[s_ord[i]];
+        if (o->flags & (SS_SEC_OPTIONAL | SS_SEC_INFO)) continue;
+        if (!ss_image_section(img, o->fourcc)) {
+            char f[5];
+            ss_fourcc_str(o->fourcc, f);
+            if (why) snprintf(why, why_n, "section %s (%s) is missing from the image (and not optional)", f,
+                              o->name ? o->name : f);
+            return SS_E_LAYOUT;
+        }
+    }
+    return SS_OK;
+}
+
+int ss_image_write_file(const ss_image* img, const char* path, double* ms, char* why, size_t why_n)
+{
+    if (!img || !img->sealed || !path) { if (why) snprintf(why, why_n, "no sealed image"); return SS_E_STATE; }
+    const uint64_t t0 = now_us();
+    char tmp[600];
+    snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    const ss_img_hdr* h = &img->hdr;
+    static const uint8_t k_zero[4096];
+    const uint64_t tab_end = h->chunk_off + (uint64_t)h->nchunks * sizeof(ss_chunk_ent);
+#ifdef _WIN32
+    HANDLE f = CreateFileA(tmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+                           FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+    if (f == INVALID_HANDLE_VALUE) {
+        if (why) snprintf(why, why_n, "cannot create %s (error %lu)", tmp, (unsigned long)GetLastError());
+        return SS_E_IO;
+    }
+    struct { const void* p; uint64_t n; } part[5] = {
+        { h, sizeof *h },
+        { img->sec, (uint64_t)h->nsections * sizeof(ss_sec_ent) },
+        { img->chunk, (uint64_t)h->nchunks * sizeof(ss_chunk_ent) },
+        { k_zero, h->data_off - tab_end },
+        { img->data, h->data_size },
+    };
+    int ok = 1;
+    for (int i = 0; i < 5 && ok; i++) {
+        const uint8_t* p = (const uint8_t*)part[i].p;
+        for (uint64_t left = part[i].n; left && ok;) {
+            const DWORD k = (DWORD)(left > (64u << 20) ? (64u << 20) : left);
+            DWORD wr = 0;
+            ok = WriteFile(f, p, k, &wr, NULL) && wr == k;
+            p += k; left -= k;
+        }
+    }
+    const DWORD err = ok ? 0 : GetLastError();
+    CloseHandle(f);
+    if (!ok || !MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) {
+        if (why) snprintf(why, why_n, "cannot write %s (error %lu)", path, (unsigned long)(err ? err : GetLastError()));
+        DeleteFileA(tmp);
+        return SS_E_IO;
+    }
+#else
+    FILE* f = fopen(tmp, "wb");
+    if (!f) { if (why) snprintf(why, why_n, "cannot create %s", tmp); return SS_E_IO; }
+    int ok = fwrite(h, sizeof *h, 1, f) == 1 &&
+             fwrite(img->sec, sizeof(ss_sec_ent), h->nsections, f) == h->nsections &&
+             fwrite(img->chunk, sizeof(ss_chunk_ent), h->nchunks, f) == h->nchunks &&
+             fwrite(k_zero, 1, (size_t)(h->data_off - tab_end), f) == (size_t)(h->data_off - tab_end) &&
+             fwrite(img->data, 1, (size_t)h->data_size, f) == (size_t)h->data_size;
+    ok = (fclose(f) == 0) && ok;
+    if (!ok || rename(tmp, path) != 0) {
+        if (why) snprintf(why, why_n, "cannot write %s", path);
+        remove(tmp);
+        return SS_E_IO;
+    }
+#endif
+    if (ms) *ms = (double)(now_us() - t0) / 1000.0;
+    return SS_OK;
+}
+
+/* XPRESS_HUFF through cabinet.dll, loaded on first use (an OS component: no
+ * link dependency, nothing new shipped). */
+int ss_image_estimate_compressed(const ss_image* img, uint32_t fourcc, uint32_t max_chunks, ss_compress_est* o)
+{
+    if (!o) return SS_E_ARG;
+    memset(o, 0, sizeof *o);
+    o->ratio = 1.0;
+    const ss_sec_ent* s = ss_image_section(img, fourcc);
+    if (!s) return SS_E_NOT_FOUND;
+    o->of = s->nchunks;
+    if (!s->nchunks || !max_chunks) return SS_OK;
+#ifdef _WIN32
+    typedef BOOL (WINAPI *create_fn)(DWORD, void*, void**);
+    typedef BOOL (WINAPI *compress_fn)(void*, LPCVOID, SIZE_T, PVOID, SIZE_T, SIZE_T*);
+    typedef BOOL (WINAPI *close_fn)(void*);
+    static HMODULE s_cab;
+    if (!s_cab) s_cab = LoadLibraryA("cabinet.dll");
+    if (!s_cab) return SS_E_STATE;
+    create_fn create = (create_fn)(void*)GetProcAddress(s_cab, "CreateCompressor");
+    compress_fn compress = (compress_fn)(void*)GetProcAddress(s_cab, "Compress");
+    close_fn close_ = (close_fn)(void*)GetProcAddress(s_cab, "CloseCompressor");
+    if (!create || !compress || !close_) return SS_E_STATE;
+    enum { ALG_XPRESS_HUFF = 4, COMPRESS_RAW_FLAG = 1 << 29 };   /* compressapi.h */
+    void* c = NULL;
+    if (!create(ALG_XPRESS_HUFF | COMPRESS_RAW_FLAG, NULL, &c)) return SS_E_STATE;
+    const size_t cap = SS_CHUNK_BYTES + SS_CHUNK_BYTES / 2 + 4096;
+    uint8_t* out = (uint8_t*)malloc(cap);
+    if (!out) { close_(c); return SS_E_NOMEM; }
+    const uint32_t n = max_chunks < s->nchunks ? max_chunks : s->nchunks;
+    const uint64_t t0 = now_us();
+    for (uint32_t k = 0; k < n; k++) {
+        const uint32_t ci = s->chunk0 + (uint32_t)((uint64_t)k * s->nchunks / n);
+        const ss_chunk_ent* ch = &img->chunk[ci];
+        SIZE_T got = 0;
+        if (!compress(c, img->data + ch->offset, ch->size, out, cap, &got) || got >= ch->size) got = ch->size;
+        o->raw += ch->size;
+        o->stored += got;
+        o->chunks++;
+    }
+    const double ms = (double)(now_us() - t0) / 1000.0;
+    free(out);
+    close_(c);
+    o->ms = ms;
+    o->ratio = o->raw ? (double)o->stored / (double)o->raw : 1.0;
+    o->mb_s = ms > 0 ? ((double)o->raw / MB) / (ms / 1000.0) : 0.0;
+    return SS_OK;
+#else
+    (void)img;
+    return SS_E_STATE;
+#endif
+}
+
+/* ---------------------------------------------------------------------------
+ * The load (M4c; ss_state.h "THE LOAD"): teardown, restore, after_release,
+ * and the fidelity check. All on the coordinator, no guest thread alive.
+ * -----------------------------------------------------------------------*/
+int ss_state_teardown(void)
+{
+    sort_sections();
+    int n = 0;
+    for (int i = 0; i < s_nord; i++) {
+        const ss_section_ops* o = s_sec[s_ord[i]];
+        if (o->teardown) { o->teardown(); n++; }
+    }
+    return n;
+}
+
+int ss_state_check_image(const ss_image* img, char* why, size_t why_n, uint32_t* fourcc)
+{
+    sort_sections();
+    if (fourcc) *fourcc = 0;
+    if (why && why_n) why[0] = 0;
+    if (!img || !img->sec) { if (why) snprintf(why, why_n, "no image"); return SS_E_ARG; }
+    for (int i = 0; i < s_nord; i++) {
+        const ss_section_ops* o = s_sec[s_ord[i]];
+        if (!o->check_image || (o->flags & SS_SEC_INFO) || !ss_image_section(img, o->fourcc)) continue;
+        ss_reader r;
+        int rc = ss_reader_open(&r, img, o->fourcc);
+        if (rc == SS_OK) rc = o->check_image(&r);
+        if (rc != SS_OK) {
+            char f4[5];
+            if (fourcc) *fourcc = o->fourcc;
+            if (why) snprintf(why, why_n, "section %s: %s", ss_fourcc_str(o->fourcc, f4),
+                              r.err ? r.what : ss_strerror(rc));
+            return rc;
+        }
+    }
+    return SS_OK;
+}
+
+int ss_state_restore(const ss_image* img, char* why, size_t why_n, uint32_t* fourcc, unsigned* norestore)
+{
+    static uint32_t s_told[SS_SECTION_MAX];           /* "no restore yet", once per section */
+    static int s_ntold;
+    sort_sections();
+    if (fourcc) *fourcc = 0;
+    if (norestore) *norestore = 0;
+    if (why && why_n) why[0] = 0;
+    if (!img || !img->sec) { if (why) snprintf(why, why_n, "no image"); return SS_E_ARG; }
+    for (int i = 0; i < s_nord; i++) {
+        const ss_section_ops* o = s_sec[s_ord[i]];
+        char f4[5];
+        if (o->flags & SS_SEC_INFO) continue;
+        if (!ss_image_section(img, o->fourcc)) continue;   /* (validation refused a mandatory one missing) */
+        if (!o->restore) {
+            if (norestore) (*norestore)++;
+            int told = 0;
+            for (int k = 0; k < s_ntold; k++) told |= s_told[k] == o->fourcc;
+            if (!told && s_ntold < SS_SECTION_MAX) {
+                s_told[s_ntold++] = o->fourcc;
+                fprintf(stderr, "[ss] load: section %s (%s) has no restore yet -- it keeps the session's state\n",
+                        ss_fourcc_str(o->fourcc, f4), o->name ? o->name : "");
+            }
+            continue;
+        }
+        ss_reader r;
+        int rc = ss_reader_open(&r, img, o->fourcc);
+        if (rc == SS_OK) rc = o->restore(&r);
+        if (rc != SS_OK) {
+            if (fourcc) *fourcc = o->fourcc;
+            if (why) snprintf(why, why_n, "section %s: %s", ss_fourcc_str(o->fourcc, f4),
+                              r.err ? r.what : ss_strerror(rc));
+            return rc;
+        }
+    }
+    return SS_OK;
+}
+
+void ss_state_after_release(void)
+{
+    sort_sections();
+    for (int i = 0; i < s_nord; i++) {
+        const ss_section_ops* o = s_sec[s_ord[i]];
+        if (o->after_release) o->after_release();
+    }
+}
+
+const ss_image* ss_image_captured(void) { return s_capd[s_bank] ? &s_img : NULL; }
+
+/* The flags this build gives field `field` of list `name` in section o (0:
+ * not listed -- a list written under a name the ops do not declare). */
+static uint32_t field_flags(const ss_section_ops* o, const char* list, const char* field)
+{
+    for (const ss_list* const* l = o ? o->lists : NULL; l && *l; l++) {
+        if (!(*l)->name || strcmp((*l)->name, list)) continue;
+        for (uint32_t i = 0; i < (*l)->n; i++)
+            if ((*l)->f[i].name && !strcmp((*l)->f[i].name, field)) return (*l)->f[i].flags;
+    }
+    return 0;
+}
+
+/* "0x2A vs 0x2B" for a field of up to 8 bytes (little-endian), else the
+ * first byte that differs. */
+static void fmt_vs(char* b, size_t n, const uint8_t* x, const uint8_t* y, uint32_t size)
+{
+    if (size <= 8) {
+        uint64_t u = 0, v = 0;
+        memcpy(&u, x, size);
+        memcpy(&v, y, size);
+        snprintf(b, n, "0x%llX vs 0x%llX", (unsigned long long)u, (unsigned long long)v);
+        return;
+    }
+    uint32_t k = 0;
+    while (k < size && x[k] == y[k]) k++;
+    snprintf(b, n, "+0x%X: 0x%02X vs 0x%02X (%u bytes)", k, k < size ? x[k] : 0, k < size ? y[k] : 0, size);
+}
+
+#define VFIRST(...) do { if (!*first_done) { *first_done = 1; if (why) snprintf(why, why_n, __VA_ARGS__); } } while (0)
+
+/* One FIELDS / RECS record pair: record by record (by position; the keys
+ * must agree), field by field by name; SS_FF_HOST fields skipped. */
+static unsigned fl_diff(ss_reader* a, ss_reader* b, const ss_rec* ra, const ss_rec* rb, const ss_section_ops* o,
+                        char* why, size_t why_n, int* first_done)
+{
+    fl_view va, vb;
+    if (fl_parse(a, ra, &va) || fl_parse(b, rb, &vb)) { VFIRST("%s: unreadable field list", ra->name); return 1; }
+    unsigned d = 0;
+    if (va.h.count != vb.h.count) {
+        d++;
+        VFIRST("%s: %u records vs %u", ra->name, va.h.count, vb.h.count);
+    }
+    const uint32_t n = va.h.count < vb.h.count ? va.h.count : vb.h.count;
+    for (uint32_t i = 0; i < n; i++) {
+        const uint8_t* xa = va.recs + (uint64_t)i * va.h.rec_size;
+        const uint8_t* xb = vb.recs + (uint64_t)i * vb.h.rec_size;
+        uint32_t ka, kb;
+        memcpy(&ka, xa, 4);
+        memcpy(&kb, xb, 4);
+        char key[24] = "";
+        if (ra->type == SS_REC_RECS) snprintf(key, sizeof key, "[0x%X]", ka);
+        if (ka != kb) { d++; VFIRST("%s record %u: key 0x%X vs 0x%X", ra->name, i, ka, kb); continue; }
+        for (uint32_t j = 0; j < va.h.nfields; j++) {
+            ss_fl_desc da, db;
+            memcpy(&da, va.desc + (uint64_t)j * sizeof da, sizeof da);
+            const char* nm = (const char*)va.names + da.name_off;
+            if (field_flags(o, ra->name, nm) & SS_FF_HOST) continue;
+            if (fl_find(&vb, nm, &db) == FL_NONE) { d++; VFIRST("%s%s.%s: not in the new capture", ra->name, key, nm); continue; }
+            if (db.size != da.size) { d++; VFIRST("%s%s.%s: %u bytes vs %u", ra->name, key, nm, da.size, db.size); continue; }
+            if (memcmp(xa + da.data_off, xb + db.data_off, da.size)) {
+                d++;
+                char vs[96];
+                fmt_vs(vs, sizeof vs, xa + da.data_off, xb + db.data_off, da.size);
+                VFIRST("%s%s.%s: %s", ra->name, key, nm, vs);
+            }
+        }
+    }
+    return d;
+}
+
+int ss_verify_generic(ss_reader* a, ss_reader* b, char* why, size_t why_n)
+{
+    const ss_section_ops* o = ss_section_find(a->fourcc);
+    uint64_t ca = 0, cb = 0;
+    unsigned d = 0;
+    int first = 0;
+    int* first_done = &first;                         /* (what VFIRST reads) */
+    if (why && why_n) why[0] = 0;
+    for (;;) {
+        ss_rec ra, rb;
+        const int ka = ss_rec_next(a, &ca, &ra), kb = ss_rec_next(b, &cb, &rb);
+        if (ka < 0 || kb < 0) { d++; VFIRST("a corrupt record (%s)", ka < 0 ? a->what : b->what); break; }
+        if (!ka && !kb) break;
+        if (!ka || !kb) { d++; VFIRST("record '%s' only in the %s", ka ? ra.name : rb.name, ka ? "image" : "new capture"); break; }
+        if (ra.type != rb.type || strcmp(ra.name, rb.name)) {
+            d++;                                      /* the streams no longer line up: stop here */
+            VFIRST("record '%s' in the image, '%s' in the new capture", ra.name, rb.name);
+            break;
+        }
+        if (ra.type == SS_REC_FIELDS || ra.type == SS_REC_RECS) {
+            d += fl_diff(a, b, &ra, &rb, o, why, why_n, first_done);
+        } else if (ra.len != rb.len) {
+            d++;
+            VFIRST("%s: %llu bytes vs %llu", ra.name, (unsigned long long)ra.len, (unsigned long long)rb.len);
+        } else if (memcmp(ra.data, rb.data, (size_t)ra.len)) {
+            uint64_t k = 0;
+            while (k < ra.len && ra.data[k] == rb.data[k]) k++;
+            d++;
+            VFIRST("%s +0x%llX: 0x%02X vs 0x%02X", ra.name, (unsigned long long)k, ra.data[k], rb.data[k]);
+        }
+    }
+    return (int)d;
+}
+#undef VFIRST
+
+int ss_state_verify(const ss_image* a, const ss_image* b, ss_verify_result* out)
+{
+    const uint64_t t0 = now_us();
+    memset(out, 0, sizeof *out);
+    if (!a || !b) return 0;
+    for (uint32_t i = 0; i < a->hdr.nsections && out->n < SS_VERIFY_MAX; i++) {
+        const ss_sec_ent* e = &a->sec[i];
+        const ss_section_ops* o = ss_section_find(e->fourcc);
+        if (!o || (o->flags & (SS_SEC_NO_VERIFY | SS_SEC_INFO))) continue;
+        ss_verify_sec* v = &out->sec[out->n++];
+        v->fourcc = e->fourcc;
+        ss_reader ra, rb;
+        ss_reader_open(&ra, a, e->fourcc);
+        if (ss_reader_open(&rb, b, e->fourcc) != SS_OK) {
+            v->diffs = 1;
+            snprintf(v->first, sizeof v->first, "not in the new capture");
+        } else {
+            const int d = o->verify ? o->verify(&ra, &rb, v->first, sizeof v->first)
+                                    : ss_verify_generic(&ra, &rb, v->first, sizeof v->first);
+            v->diffs = d > 0 ? (unsigned)d : 0u;
+        }
+        out->compared++;
+        out->differ += v->diffs != 0;
+    }
+    out->ms = (double)(now_us() - t0) / 1000.0;
+    return (int)out->differ;
+}
+
+/* ---------------------------------------------------------------------------
+ * The coordinator's preparation (outside a stop)
+ * -----------------------------------------------------------------------*/
+static uint8_t* s_arena;
+static uint64_t s_arena_size;
+
+uint64_t ss_state_committed_now(void)
+{
+    if (!s_arena) return 0;
+    uint64_t sum = 0;
+    for (uint8_t* p = s_arena; p < s_arena + s_arena_size;) {
+        MEMORY_BASIC_INFORMATION mi;
+        if (!VirtualQuery(p, &mi, sizeof mi)) break;
+        uint8_t* b = (uint8_t*)mi.BaseAddress;
+        uint8_t* e = b + mi.RegionSize;
+        if (b < p) b = p;
+        if (e > s_arena + s_arena_size) e = s_arena + s_arena_size;
+        if (mi.State == MEM_COMMIT) sum += (uint64_t)(e - b);
+        if (e <= p) break;
+        p = e;
+    }
+    return sum;
+}
+
+int ss_state_enable(void)
+{
+    if (!stg_reserve()) return 0;
+    return stg_grow(ss_state_committed_now() + s_margin, 0, NULL, 0) == SS_OK;
+}
+
+/* What a capture can need now: every section's hint, the margin, or what an
+ * overflowed capture counted. */
+static uint64_t capture_want(void)
+{
+    sort_sections();
+    uint64_t want = s_margin;
+    for (int i = 0; i < s_nord; i++) {
+        const ss_section_ops* o = s_sec[s_ord[i]];
+        want += (o->size_hint ? o->size_hint() : SS_SECTION_SMALL) + 4096;   /* + its alignment */
+    }
+    want += 64u * 1024u;                              /* record headers, names */
+    if (s_need + s_margin > want) want = s_need + s_margin;   /* what an overflowed capture counted */
+    return want;
+}
+
+static int prepare_bank(int bank, char* why, size_t why_n)
+{
+    const uint64_t want = capture_want();
+    ss_bank* b = &s_bk[bank];
+    const uint64_t had = b->touched;
+    const uint64_t t0 = now_us();
+    const int e = bank_grow(b, want, 1, why, why_n);
+    if (e == SS_OK && b->touched > had)
+        fprintf(stderr, "[ss] staging buffer %d grown to %.0f MB, committed and touched (from %.0f MB) in %.0f ms,"
+                        " outside the stop\n", bank, (double)b->touched / MB, (double)had / MB,
+                (double)(now_us() - t0) / 1000.0);
+    return e;
+}
+
+int ss_state_prepare(char* why, size_t why_n) { return prepare_bank(s_bank, why, why_n); }
+
+/* The bank a capture uses while an image is held: the current one once
+ * something is held, else the other (a selftest holds its capture in the
+ * current bank, then the fidelity check captures into that one). */
+int ss_state_prepare_spare(char* why, size_t why_n)
+{
+    return prepare_bank(s_held >= 0 ? s_bank : (s_bank ^ 1), why, why_n);
+}
+
+/* ===========================================================================
+ * MAPS and GMEM: guest memory
+ *
+ * MAPS walks the arena with VirtualQuery: each committed region (its guest
+ * address, size, protection) goes into "regions" and marks its 64 KB blocks;
+ * every readable committed page is tested for any non-zero byte, which marks
+ * the 4 KB bitmap. GMEM then copies exactly the marked pages, in address
+ * order, into one 4096-aligned blob. A committed page the guest cannot read
+ * (a stack guard) is counted, never read: its contents are not guest state.
+ * GMEM's pages are the marked bits of MAPS's "nonzero_4k" in the same image
+ * (so M4c restores MAPS -- the commit layout -- before GMEM).
+ * =========================================================================*/
+#define GMEM_PAGE   4096u
+#define MAPS_BLOCK  0x10000u
+#define ARENA_MAX   0x100000000ull
+static uint64_t s_map64k[(ARENA_MAX / MAPS_BLOCK) / 64];   /* 8 KB */
+static uint64_t s_nz4k[(ARENA_MAX / GMEM_PAGE) / 64];      /* 128 KB */
+static ss_mem_stats s_mem;
+static int s_scan_unready;
+
+void ss_state_set_arena(void* base, uint64_t size)
+{
+    s_arena = (uint8_t*)base;
+    s_arena_size = size > ARENA_MAX ? ARENA_MAX : (size & ~(uint64_t)(GMEM_PAGE - 1));
+    s_arena_set = base != NULL && s_arena_size != 0;
+}
+
+void ss_state_mem_stats(ss_mem_stats* out) { if (out) *out = s_mem; }
+
+/* The default map of the guest address space, for the statistics only (the
+ * runtime's own placements: memory/vm.h, sys_memory.c, cellAudio.c). */
+typedef struct maps_area {
+    char     name[16];
+    uint64_t lo, hi, committed, nonzero, unreadable;
+} maps_area;
+static maps_area s_area[] = {
+    { "main",       0x00000000u, 0x10000000u, 0, 0, 0 },   /* the ELF, its data, the main stack */
+    { "tls/rsx-io", 0x10000000u, 0x20000000u, 0, 0, 0 },
+    { "inject",     0x20000000u, 0x30000000u, 0, 0, 0 },   /* VM_HLE_INJECT_BASE: GCM labels, control */
+    { "libsre/spu", 0x30000000u, 0x40000000u, 0, 0, 0 },
+    { "sys_memory", 0x40000000u, 0x50000000u, 0, 0, 0 },
+    { "hle-heap",   0x50000000u, 0x58000000u, 0, 0, 0 },
+    { "audio",      0x58000000u, 0x60000000u, 0, 0, 0 },
+    { "sys_vm",     0x60000000u, 0x70000000u, 0, 0, 0 },
+    { "other",      0x70000000u, 0xC0000000u, 0, 0, 0 },
+    { "rsx-local",  0xC0000000u, 0xD0000000u, 0, 0, 0 },
+    { "stacks",     0xD0000000u, 0xE0000000u, 0, 0, 0 },
+    { "high",       0xE0000000u, 0x100000000ull, 0, 0, 0 },
+};
+#define NAREA ((int)(sizeof s_area / sizeof s_area[0]))
+
+typedef struct maps_region { uint64_t guest, size; uint32_t protect, type; } maps_region;
+static const ss_field k_region_fields[] = {
+    SS_MEMBER(maps_region, guest), SS_MEMBER(maps_region, size),
+    SS_MEMBER(maps_region, protect), SS_MEMBER(maps_region, type),
+};
+static const ss_list k_region_list = SS_LIST("regions", k_region_fields);
+static const ss_field k_area_fields[] = {
+    SS_MEMBER(maps_area, name), SS_MEMBER(maps_area, lo), SS_MEMBER(maps_area, hi),
+    SS_MEMBER(maps_area, committed), SS_MEMBER(maps_area, nonzero), SS_MEMBER(maps_area, unreadable),
+};
+static const ss_list k_area_list = SS_LIST("areas", k_area_fields);
+
+typedef struct maps_sum {
+    uint64_t arena, committed, nonzero, unreadable;
+    uint32_t block, page, regions, pages, scan_us, flags;
+} maps_sum;
+static const ss_field k_maps_fields[] = {
+    SS_MEMBER(maps_sum, arena), SS_MEMBER(maps_sum, committed), SS_MEMBER(maps_sum, nonzero),
+    SS_MEMBER(maps_sum, unreadable), SS_MEMBER(maps_sum, block), SS_MEMBER(maps_sum, page),
+    SS_MEMBER(maps_sum, regions), SS_MEMBER(maps_sum, pages), SS_MEMBER_F(maps_sum, scan_us, SS_FF_NO_RESTORE | SS_FF_HOST),
+    SS_MEMBER(maps_sum, flags),
+};
+static const ss_list k_maps_list = SS_LIST("maps", k_maps_fields);
+static const ss_list* const k_maps_lists[] = { &k_maps_list, &k_region_list, &k_area_list, NULL };
+
+/* Any non-zero byte in the page (64 bytes at a time; memory-bound). */
+static int page_nonzero(const uint8_t* p)
+{
+    const uint64_t* q = (const uint64_t*)p;
+    for (unsigned i = 0; i < GMEM_PAGE / 8; i += 8)
+        if (q[i] | q[i + 1] | q[i + 2] | q[i + 3] | q[i + 4] | q[i + 5] | q[i + 6] | q[i + 7]) return 1;
+    return 0;
+}
+
+static int maps_capture(ss_writer* w)
+{
+    const uint64_t t0 = now_us();
+    memset(s_map64k, 0, sizeof s_map64k);
+    memset(s_nz4k, 0, sizeof s_nz4k);
+    memset(&s_mem, 0, sizeof s_mem);
+    for (int i = 0; i < NAREA; i++) s_area[i].committed = s_area[i].nonzero = s_area[i].unreadable = 0;
+    s_mem.arena = s_arena ? s_arena_size : 0;
+    ss_recs_begin(w, &k_region_list);
+    int ai = 0;
+    for (uint8_t* p = s_arena; s_arena && p < s_arena + s_arena_size;) {
+        MEMORY_BASIC_INFORMATION mi;
+        if (!VirtualQuery(p, &mi, sizeof mi)) break;
+        uint8_t* b = (uint8_t*)mi.BaseAddress;
+        uint8_t* e = b + mi.RegionSize;
+        if (b < p) b = p;
+        if (e > s_arena + s_arena_size) e = s_arena + s_arena_size;
+        if (e <= p) break;
+        if (mi.State == MEM_COMMIT) {
+            maps_region rg;
+            rg.guest = (uint64_t)(b - s_arena);
+            rg.size = (uint64_t)(e - b);
+            rg.protect = (uint32_t)mi.Protect;
+            rg.type = (uint32_t)mi.Type;
+            ss_recs_add(w, s_mem.regions++, &rg);
+            const int readable = mi.Protect && !(mi.Protect & (PAGE_NOACCESS | PAGE_GUARD));
+            for (uint64_t g = rg.guest; g < rg.guest + rg.size; g += GMEM_PAGE) {
+                s_map64k[(g / MAPS_BLOCK) / 64] |= 1ull << ((g / MAPS_BLOCK) % 64);
+                while (ai < NAREA - 1 && g >= s_area[ai].hi) ai++;
+                while (ai > 0 && g < s_area[ai].lo) ai--;
+                s_area[ai].committed += GMEM_PAGE;
+                if (!readable) { s_area[ai].unreadable += GMEM_PAGE; continue; }
+                if (page_nonzero(s_arena + g)) {
+                    s_nz4k[(g / GMEM_PAGE) / 64] |= 1ull << ((g / GMEM_PAGE) % 64);
+                    s_area[ai].nonzero += GMEM_PAGE;
+                    s_mem.pages++;
+                }
+            }
+            s_mem.committed += rg.size;
+            if (!readable) s_mem.unreadable += rg.size;
+        }
+        p = e;
+    }
+    ss_recs_end(w);
+    s_mem.nonzero = (uint64_t)s_mem.pages * GMEM_PAGE;
+    const uint64_t nblk = s_arena ? (s_arena_size + MAPS_BLOCK - 1) / MAPS_BLOCK : 0;
+    const uint64_t npg = s_arena ? s_arena_size / GMEM_PAGE : 0;
+    ss_write_blob(w, "committed_64k", s_map64k, (nblk + 7) / 8);
+    ss_write_blob(w, "nonzero_4k", s_nz4k, (npg + 7) / 8);
+    ss_recs_begin(w, &k_area_list);
+    for (int i = 0; i < NAREA; i++) if (s_area[i].committed) ss_recs_add(w, (uint32_t)i, &s_area[i]);
+    ss_recs_end(w);
+    s_mem.scan_ms = (double)(now_us() - t0) / 1000.0;
+    maps_sum m;
+    memset(&m, 0, sizeof m);
+    m.arena = s_mem.arena;
+    m.committed = s_mem.committed;
+    m.nonzero = s_mem.nonzero;
+    m.unreadable = s_mem.unreadable;
+    m.block = MAPS_BLOCK;
+    m.page = GMEM_PAGE;
+    m.regions = s_mem.regions;
+    m.pages = s_mem.pages;
+    m.scan_us = (uint32_t)(now_us() - t0);
+    m.flags = s_arena ? 0u : SS_IMG_NO_ARENA;
+    ss_write_fields_at(w, &k_maps_list, &m);
+    s_maps_seq = s_cap_seq;
+    s_scan_unready = 0;
+    return ss_writer_error(w);
+}
+
+static uint64_t maps_size_hint(void) { return 4u << 20; }   /* bitmaps 136 KB + regions */
+
+typedef struct gmem_sum { uint64_t pages, bytes; uint32_t page, copy_us; } gmem_sum;
+static const ss_field k_gmem_fields[] = {
+    SS_MEMBER(gmem_sum, pages), SS_MEMBER(gmem_sum, bytes), SS_MEMBER(gmem_sum, page),
+    SS_MEMBER_F(gmem_sum, copy_us, SS_FF_NO_RESTORE | SS_FF_HOST),
+};
+static const ss_list k_gmem_list = SS_LIST("gmem", k_gmem_fields);
+static const ss_list* const k_gmem_lists[] = { &k_gmem_list, NULL };
+
+static int gmem_capture(ss_writer* w)
+{
+    if (s_maps_seq != s_cap_seq || s_scan_unready)
+        return w_fail(w, SS_E_STATE, "GMEM needs MAPS's scan from the same capture (order MAPS < GMEM)");
+    const uint64_t t0 = now_us();
+    ss_blob_begin(w, "pages", GMEM_PAGE);
+    const uint64_t npg = s_arena ? s_arena_size / GMEM_PAGE : 0;
+    uint64_t copied = 0;
+    for (uint64_t i = 0; i < npg;) {
+        const uint64_t word = s_nz4k[i / 64];
+        if (!word && !(i % 64)) { i += 64; continue; }
+        if (!(word & (1ull << (i % 64)))) { i++; continue; }
+        uint64_t j = i + 1;                           /* a run of non-zero pages: one copy */
+        while (j < npg && (s_nz4k[j / 64] & (1ull << (j % 64)))) j++;
+        const uint64_t n = (j - i) * GMEM_PAGE;
+        uint8_t* d = (uint8_t*)ss_blob_reserve(w, n);
+        if (d) memcpy(d, s_arena + i * GMEM_PAGE, (size_t)n);
+        copied += j - i;
+        i = j;
+    }
+    ss_blob_end(w);
+    s_mem.copy_ms = (double)(now_us() - t0) / 1000.0;
+    gmem_sum g;
+    g.pages = copied;
+    g.bytes = copied * GMEM_PAGE;
+    g.page = GMEM_PAGE;
+    g.copy_us = (uint32_t)(now_us() - t0);
+    ss_write_fields_at(w, &k_gmem_list, &g);
+    return ss_writer_error(w);
+}
+
+static uint64_t gmem_size_hint(void) { return ss_state_committed_now(); }   /* at most every committed page */
+
+/* ---- MAPS and GMEM restore (M4c; engine design 6.3) ------------------------
+ * MAPS: every region committed in the snapshot is committed now, with its
+ * protection (a stack's NOACCESS guard page comes back; a guard page's old
+ * contents are zeroed first, so lifting it later shows zeros). A region
+ * committed now but not in the snapshot STAYS committed -- kernel writes
+ * such as ReadFile into an uncommitted page fail with ERROR_NOACCESS (the
+ * arena study) -- and is made read-write if it is not, so GMEM zeroes it:
+ * uncommitted in the snapshot reads as demand-zero read-write memory.
+ * GMEM: every page non-zero in the snapshot gets its bytes (compared first,
+ * copied only when it differs: a round trip rewrites almost nothing); every
+ * other readable page committed now that is not all zero is zeroed. */
+static uint64_t s_snap4k[(ARENA_MAX / GMEM_PAGE) / 64];    /* committed in the snapshot (MAPS restore) */
+static const ss_image* s_maps_restored;                   /* the image MAPS was restored from */
+static struct { uint64_t regions, reprotect, unshielded, copied, same, zeroed; double maps_ms, gmem_ms; } s_rst;
+
+static int maps_restore(ss_reader* r)
+{
+    const uint64_t t0 = now_us();
+    memset(&s_rst, 0, sizeof s_rst);
+    s_maps_restored = NULL;
+    maps_sum m;
+    memset(&m, 0, sizeof m);
+    int e = ss_read_fields_at(r, &k_maps_list, &m);
+    if (e) return e;
+    if (m.flags & SS_IMG_NO_ARENA) return SS_OK;      /* (a test image: nothing to restore) */
+    if (!s_arena) return r_fail(r, SS_E_STATE, "maps: the image has guest memory, this process declared no arena");
+    if (m.arena != s_arena_size || m.page != GMEM_PAGE || m.block != MAPS_BLOCK)
+        return r_fail(r, SS_E_LAYOUT, "maps.arena: %llu bytes in %u-byte pages in the image, %llu / %u here",
+                      (unsigned long long)m.arena, m.page, (unsigned long long)s_arena_size, GMEM_PAGE);
+    memset(s_snap4k, 0, sizeof s_snap4k);
+    ss_recs_it it;
+    if ((e = ss_recs_open(r, &k_region_list, &it)) != 0) return e;
+    maps_region rg;
+    uint32_t key;
+    int k;
+    while ((k = ss_recs_next(&it, &key, &rg)) == 1) {
+        if ((rg.guest | rg.size) & (GMEM_PAGE - 1) || !rg.size || rg.guest + rg.size > s_arena_size)
+            return r_fail(r, SS_E_CORRUPT, "maps.regions[%u]: 0x%llX + 0x%llX outside the arena", key,
+                          (unsigned long long)rg.guest, (unsigned long long)rg.size);
+        uint8_t* p = s_arena + rg.guest;
+        if (!VirtualAlloc(p, (SIZE_T)rg.size, MEM_COMMIT, PAGE_READWRITE))
+            return r_fail(r, SS_E_IO, "maps.regions[%u]: commit of 0x%llX + 0x%llX failed (error %lu)", key,
+                          (unsigned long long)rg.guest, (unsigned long long)rg.size, (unsigned long)GetLastError());
+        const int readable = rg.protect && !(rg.protect & (PAGE_NOACCESS | PAGE_GUARD));
+        DWORD old = 0;
+        MEMORY_BASIC_INFORMATION mi;
+        if (VirtualQuery(p, &mi, sizeof mi) && (mi.Protect != rg.protect || mi.RegionSize < rg.size)) {
+            if (!readable) {
+                VirtualProtect(p, (SIZE_T)rg.size, PAGE_READWRITE, &old);
+                memset(p, 0, (size_t)rg.size);        /* its old bytes are not the snapshot's */
+            }
+            if (!VirtualProtect(p, (SIZE_T)rg.size, rg.protect, &old))
+                return r_fail(r, SS_E_IO, "maps.regions[%u]: protection 0x%X on 0x%llX failed (error %lu)", key,
+                              rg.protect, (unsigned long long)rg.guest, (unsigned long)GetLastError());
+            s_rst.reprotect++;
+        }
+        for (uint64_t g = rg.guest; g < rg.guest + rg.size; g += GMEM_PAGE)
+            s_snap4k[(g / GMEM_PAGE) / 64] |= 1ull << ((g / GMEM_PAGE) % 64);
+        s_rst.regions++;
+    }
+    if (k < 0) return k;
+    /* committed now, not in the snapshot, not read-write: read-write (zeroed by GMEM) */
+    for (uint8_t* p = s_arena; p < s_arena + s_arena_size;) {
+        MEMORY_BASIC_INFORMATION mi;
+        if (!VirtualQuery(p, &mi, sizeof mi)) break;
+        uint8_t* b = (uint8_t*)mi.BaseAddress;
+        uint8_t* end = b + mi.RegionSize;
+        if (b < p) b = p;
+        if (end > s_arena + s_arena_size) end = s_arena + s_arena_size;
+        if (end <= p) break;
+        if (mi.State == MEM_COMMIT && mi.Protect != PAGE_READWRITE) {
+            for (uint8_t* q = b; q < end; q += GMEM_PAGE) {
+                const uint64_t g = (uint64_t)(q - s_arena);
+                if (s_snap4k[(g / GMEM_PAGE) / 64] & (1ull << ((g / GMEM_PAGE) % 64))) continue;
+                DWORD old = 0;
+                if (VirtualProtect(q, GMEM_PAGE, PAGE_READWRITE, &old)) s_rst.unshielded++;
+            }
+        }
+        p = end;
+    }
+    s_maps_restored = r->img;
+    s_rst.maps_ms = (double)(now_us() - t0) / 1000.0;
+    return SS_OK;
+}
+
+static int gmem_restore(ss_reader* r)
+{
+    const uint64_t t0 = now_us();
+    gmem_sum g;
+    memset(&g, 0, sizeof g);
+    int e = ss_read_fields_at(r, &k_gmem_list, &g);
+    if (e) return e;
+    const void* pages = NULL;
+    uint64_t plen = 0;
+    if ((e = ss_find_blob(r, "pages", &pages, &plen)) != 0) return e;
+    if (!s_arena) {
+        if (plen) return r_fail(r, SS_E_STATE, "gmem: the image has %llu bytes of guest memory, no arena here",
+                                (unsigned long long)plen);
+        return SS_OK;
+    }
+    if (s_maps_restored != r->img)
+        return r_fail(r, SS_E_STATE, "gmem: MAPS was not restored from the same image first (order MAPS < GMEM)");
+    if (g.page != GMEM_PAGE || plen != g.pages * (uint64_t)GMEM_PAGE)
+        return r_fail(r, SS_E_CORRUPT, "gmem.pages: %llu pages of %u bytes, the blob holds %llu bytes",
+                      (unsigned long long)g.pages, g.page, (unsigned long long)plen);
+    ss_reader mr;
+    if ((e = ss_reader_open(&mr, r->img, SS_FOURCC('M', 'A', 'P', 'S'))) != 0)
+        return r_fail(r, e, "gmem: no MAPS section in the image");
+    const uint8_t* bm = NULL;
+    uint64_t bmlen = 0;
+    const uint64_t npg = s_arena_size / GMEM_PAGE;
+    if ((e = ss_find_blob(&mr, "nonzero_4k", (const void**)&bm, &bmlen)) != 0)
+        return r_fail(r, e, "gmem: %s", mr.what);
+    if (bmlen != (npg + 7) / 8)
+        return r_fail(r, SS_E_LAYOUT, "maps.nonzero_4k: %llu bytes in the image, %llu here",
+                      (unsigned long long)bmlen, (unsigned long long)((npg + 7) / 8));
+    /* the snapshot's pages, in address order */
+    const uint8_t* src = (const uint8_t*)pages;
+    uint64_t n = 0;
+    for (uint64_t i = 0; i < npg; i++) {
+        if (!(bm[i / 8] & (1u << (i % 8)))) {
+            if (!(i % 64) && i + 64 <= npg) {             /* a whole zero word of the bitmap: skip it */
+                uint64_t w;
+                memcpy(&w, bm + i / 8, 8);
+                if (!w) i += 63;
+            }
+            continue;
+        }
+        if (n >= g.pages) return r_fail(r, SS_E_CORRUPT, "gmem.pages: the bitmap marks more than %llu pages",
+                                        (unsigned long long)g.pages);
+        uint8_t* d = s_arena + i * GMEM_PAGE;
+        if (memcmp(d, src, GMEM_PAGE)) { memcpy(d, src, GMEM_PAGE); s_rst.copied++; }
+        else s_rst.same++;
+        src += GMEM_PAGE;
+        n++;
+    }
+    if (n != g.pages) return r_fail(r, SS_E_CORRUPT, "gmem.pages: %llu in the blob, %llu marked",
+                                    (unsigned long long)g.pages, (unsigned long long)n);
+    /* every other readable committed page: zero */
+    for (uint8_t* p = s_arena; p < s_arena + s_arena_size;) {
+        MEMORY_BASIC_INFORMATION mi;
+        if (!VirtualQuery(p, &mi, sizeof mi)) break;
+        uint8_t* b = (uint8_t*)mi.BaseAddress;
+        uint8_t* end = b + mi.RegionSize;
+        if (b < p) b = p;
+        if (end > s_arena + s_arena_size) end = s_arena + s_arena_size;
+        if (end <= p) break;
+        const int readable = mi.State == MEM_COMMIT && mi.Protect && !(mi.Protect & (PAGE_NOACCESS | PAGE_GUARD));
+        if (readable) {
+            for (uint8_t* q = b; q < end; q += GMEM_PAGE) {
+                const uint64_t pg = (uint64_t)(q - s_arena) / GMEM_PAGE;
+                if (bm[pg / 8] & (1u << (pg % 8))) continue;
+                if (page_nonzero(q)) { memset(q, 0, GMEM_PAGE); s_rst.zeroed++; }
+            }
+        }
+        p = end;
+    }
+    s_rst.gmem_ms = (double)(now_us() - t0) / 1000.0;
+    return SS_OK;
+}
+
+/* The fidelity check of MAPS: which pages are non-zero (the committed layout
+ * may differ by design: regions committed after the snapshot stay so). */
+static int maps_verify(ss_reader* a, ss_reader* b, char* why, size_t why_n)
+{
+    const uint8_t *x = NULL, *y = NULL;
+    uint64_t nx = 0, ny = 0;
+    if (ss_find_blob(a, "nonzero_4k", (const void**)&x, &nx) || ss_find_blob(b, "nonzero_4k", (const void**)&y, &ny)) {
+        snprintf(why, why_n, "nonzero_4k: missing");
+        return 1;
+    }
+    if (nx != ny) { snprintf(why, why_n, "nonzero_4k: %llu bytes vs %llu", (unsigned long long)nx, (unsigned long long)ny); return 1; }
+    int d = 0;
+    for (uint64_t i = 0; i < nx; i++) {
+        const uint8_t c = (uint8_t)(x[i] ^ y[i]);
+        if (!c) continue;
+        if (!d) {
+            unsigned bit = 0;
+            while (!(c & (1u << bit))) bit++;
+            const uint64_t pg = i * 8 + bit;
+            snprintf(why, why_n, "nonzero_4k: page 0x%08llX is %s in the image, %s after the restore",
+                     (unsigned long long)(pg * GMEM_PAGE), (x[i] >> bit) & 1 ? "non-zero" : "zero",
+                     (y[i] >> bit) & 1 ? "non-zero" : "zero");
+        }
+        for (unsigned bit = 0; bit < 8; bit++) d += (c >> bit) & 1;
+    }
+    return d;
+}
+
+/* The fidelity check of GMEM: the pages both images hold, byte for byte
+ * (pages only one holds are MAPS's difference). */
+static int gmem_verify(ss_reader* a, ss_reader* b, char* why, size_t why_n)
+{
+    ss_reader ma, mb;
+    const uint8_t *xa = NULL, *xb = NULL, *pa = NULL, *pb = NULL;
+    uint64_t na = 0, nb = 0, la = 0, lb = 0;
+    if (ss_reader_open(&ma, a->img, SS_FOURCC('M', 'A', 'P', 'S')) || ss_reader_open(&mb, b->img, SS_FOURCC('M', 'A', 'P', 'S')) ||
+        ss_find_blob(&ma, "nonzero_4k", (const void**)&xa, &na) || ss_find_blob(&mb, "nonzero_4k", (const void**)&xb, &nb) ||
+        ss_find_blob(a, "pages", (const void**)&pa, &la) || ss_find_blob(b, "pages", (const void**)&pb, &lb) || na != nb) {
+        snprintf(why, why_n, "pages: the page maps cannot be compared");
+        return 1;
+    }
+    uint64_t oa = 0, ob = 0;
+    int d = 0;
+    for (uint64_t i = 0; i < na * 8; i++) {
+        const int ia = (xa[i / 8] >> (i % 8)) & 1, ib = (xb[i / 8] >> (i % 8)) & 1;
+        if (ia && ib && oa + GMEM_PAGE <= la && ob + GMEM_PAGE <= lb && memcmp(pa + oa, pb + ob, GMEM_PAGE)) {
+            if (!d) {
+                unsigned k = 0;
+                while (k < GMEM_PAGE && pa[oa + k] == pb[ob + k]) k++;
+                snprintf(why, why_n, "pages: 0x%08llX +0x%X: 0x%02X vs 0x%02X", (unsigned long long)(i * GMEM_PAGE),
+                         k, pa[oa + k], pb[ob + k]);
+            }
+            d++;
+        }
+        oa += (uint64_t)ia * GMEM_PAGE;
+        ob += (uint64_t)ib * GMEM_PAGE;
+    }
+    return d;
+}
+
+static const ss_section_ops k_maps_ops = {
+    SS_FOURCC('M', 'A', 'P', 'S'), 1, 0, SS_ORDER_MEMORY,
+    NULL, maps_capture, NULL, maps_restore, NULL,
+    "guest address space", k_maps_lists, maps_size_hint, maps_verify,
+};
+static const ss_section_ops k_gmem_ops = {
+    SS_FOURCC('G', 'M', 'E', 'M'), 1, 0, SS_ORDER_MEMORY + 10,
+    NULL, gmem_capture, NULL, gmem_restore, NULL,
+    "guest memory", k_gmem_lists, gmem_size_hint, gmem_verify,
+};
+SS_SECTION_REGISTER(k_maps_ops)
+SS_SECTION_REGISTER(k_gmem_ops)
+
+/* ===========================================================================
+ * TIME: the guest clock, the play time and the anchors (the worked example
+ * of a section: a FIELDS record of a struct, a RECS record of a table, the
+ * same lists for capture and -- M4c -- restore).
+ * =========================================================================*/
+static uint64_t (*s_tb_now)(void);
+static uint64_t s_tb_freq;
+#define SS_ANCHOR_MAX 32
+static const ss_time_anchor* s_anchor[SS_ANCHOR_MAX];
+static volatile LONG s_nanchor;
+
+void ss_time_set_guest_clock(uint64_t (*tb_now)(void), uint64_t tb_freq)
+{
+    s_tb_now = tb_now;
+    s_tb_freq = tb_freq;
+}
+
+int ss_time_anchor_add(const ss_time_anchor* a)
+{
+    if (!a || !a->name || !a->capture || strlen(a->name) >= 32) return 0;
+    const LONG i = InterlockedIncrement(&s_nanchor) - 1;
+    if (i >= SS_ANCHOR_MAX) {
+        InterlockedDecrement(&s_nanchor);
+        fprintf(stderr, "[ss] WARNING: more than %d time anchors -- '%s' is not kept\n", SS_ANCHOR_MAX, a->name);
+        return 0;
+    }
+    s_anchor[i] = a;
+    return 1;
+}
+
+static const ss_field k_time_fields[] = {
+    SS_MEMBER(ss_time_info, guest_tb), SS_MEMBER(ss_time_info, tb_freq), SS_MEMBER(ss_time_info, guest_ns),
+    SS_MEMBER(ss_time_info, play_ms), SS_MEMBER(ss_time_info, unix_ms), SS_MEMBER(ss_time_info, flip_count),
+};
+static const ss_list k_time_list = SS_LIST("time", k_time_fields);
+/* host values at capture: for the log and M4c's arithmetic, never restored */
+typedef struct time_host { uint64_t qpc, qpc_freq; } time_host;
+static const ss_field k_time_host_fields[] = {
+    SS_MEMBER_F(time_host, qpc, SS_FF_NO_RESTORE | SS_FF_HOST),
+    SS_MEMBER_F(time_host, qpc_freq, SS_FF_NO_RESTORE | SS_FF_HOST),
+};
+static const ss_list k_time_host_list = SS_LIST("host", k_time_host_fields);
+/* the same fields without NO_RESTORE, to read their values back (M5: a load
+ * puts the snapshot's QPC epoch back); not part of the layout hash */
+static const ss_field k_time_host_rd_fields[] = {
+    SS_MEMBER(time_host, qpc), SS_MEMBER(time_host, qpc_freq),
+};
+static const ss_list k_time_host_rd_list = SS_LIST("host", k_time_host_rd_fields);
+typedef struct time_anchor_rec { char name[32]; uint64_t value; } time_anchor_rec;
+static const ss_field k_anchor_fields[] = {
+    SS_MEMBER(time_anchor_rec, name), SS_MEMBER(time_anchor_rec, value),
+};
+static const ss_list k_anchor_list = SS_LIST("anchors", k_anchor_fields);
+static const ss_list* const k_time_lists[] = { &k_time_list, &k_time_host_list, &k_anchor_list, NULL };
+
+static int time_capture(ss_writer* w)
+{
+    const ss_capture_info* ci = ss_writer_info(w);
+    ss_time_info t;
+    memset(&t, 0, sizeof t);
+    t.guest_tb = s_tb_now ? s_tb_now() : 0;
+    t.tb_freq = s_tb_freq;
+    t.guest_ns = s_tb_freq ? (t.guest_tb / s_tb_freq) * 1000000000ull +
+                             (t.guest_tb % s_tb_freq) * 1000000000ull / s_tb_freq : 0;
+    t.play_ms = ci->play_ms;
+    t.unix_ms = ci->unix_ms;
+    t.flip_count = ci->flip_count;
+    ss_write_fields_at(w, &k_time_list, &t);
+    time_host h;                                /* the capture's instant, which later sections use too */
+    h.qpc = ci->qpc;
+    h.qpc_freq = ci->qpc_freq;
+    ss_write_fields_at(w, &k_time_host_list, &h);
+    ss_recs_begin(w, &k_anchor_list);
+    const LONG n = s_nanchor < SS_ANCHOR_MAX ? s_nanchor : SS_ANCHOR_MAX;
+    for (LONG i = 0; i < n; i++) {
+        const ss_time_anchor* a = s_anchor[i];
+        if (!a) continue;
+        time_anchor_rec r;
+        memset(&r, 0, sizeof r);
+        strncpy(r.name, a->name, sizeof r.name - 1);
+        r.value = a->capture();
+        ss_recs_add(w, (uint32_t)i, &r);
+    }
+    ss_recs_end(w);
+    return ss_writer_error(w);
+}
+
+int ss_time_read(const ss_image* img, ss_time_info* out)
+{
+    ss_reader r;
+    int e = ss_reader_open(&r, img, SS_FOURCC('T', 'I', 'M', 'E'));
+    if (e) return e;
+    memset(out, 0, sizeof *out);
+    return ss_read_fields_at(&r, &k_time_list, out);
+}
+
+int ss_time_anchor_read(const ss_image* img, const char* name, uint64_t* value)
+{
+    ss_reader r;
+    int e = ss_reader_open(&r, img, SS_FOURCC('T', 'I', 'M', 'E'));
+    if (e) return e;
+    ss_recs_it it;
+    if ((e = ss_recs_open(&r, &k_anchor_list, &it)) != 0) return e;
+    time_anchor_rec rec;
+    uint32_t key;
+    int k;
+    while ((k = ss_recs_next(&it, &key, &rec)) == 1) {
+        rec.name[sizeof rec.name - 1] = 0;
+        if (name && !strcmp(rec.name, name)) { if (value) *value = rec.value; return SS_OK; }
+    }
+    return k < 0 ? k : SS_E_NOT_FOUND;
+}
+
+/* The one guest clock's controls (sys_timer.c registers them). */
+static ss_guest_clock_ops s_clock;
+void ss_time_set_clock_ops(const ss_guest_clock_ops* ops) { if (ops) s_clock = *ops; }
+void ss_time_freeze(void) { if (s_clock.freeze) s_clock.freeze(); }
+void ss_time_thaw(void)   { if (s_clock.thaw) s_clock.thaw(); }
+
+/* A LOAD (M4c), first of all sections: the guest clock frozen at the instant
+ * the snapshot's time base read (so every guest clock reads the snapshot's
+ * time until the release thaws it, and the fidelity check's capture sees the
+ * same instant), then every anchor this build registers that the image has
+ * a record of, by name: its restore re-bases that clock or deadline on the
+ * frozen guest clock. An anchor the image does not have keeps its state. */
+static int time_restore(ss_reader* r)
+{
+    ss_time_info t;
+    memset(&t, 0, sizeof t);
+    int e = ss_read_fields_at(r, &k_time_list, &t);
+    if (e) return e;
+    time_host h;
+    memset(&h, 0, sizeof h);
+    if ((e = ss_read_fields_at(r, &k_time_host_rd_list, &h)) != 0) return e;   /* (the values: M5) */
+    if (t.tb_freq && s_tb_freq && t.tb_freq != s_tb_freq)
+        return r_fail(r, SS_E_LAYOUT, "time.tb_freq: %llu Hz in the image, %llu here",
+                      (unsigned long long)t.tb_freq, (unsigned long long)s_tb_freq);
+    /* M5: an image of another process (a slot file loaded after a restart)
+     * has another QPC epoch: the snapshot's guest QPC itself comes back (its
+     * frequency converted), and the time base re-anchored so it reads the
+     * snapshot's tb there -- every absolute guest-clock value the image holds
+     * (report and flip timestamps, deadlines in guest memory) then agrees
+     * with the clock again. In the process that saved it this is the same
+     * instant set() picks. */
+    if (s_clock.set_qpc && h.qpc && h.qpc_freq) s_clock.set_qpc(h.qpc, h.qpc_freq, t.guest_tb);
+    else if (s_clock.set) s_clock.set(t.guest_tb);
+    ss_recs_it it;
+    if ((e = ss_recs_open(r, &k_anchor_list, &it)) != 0) return e;
+    time_anchor_rec rec;
+    uint32_t key;
+    int k;
+    const LONG n = s_nanchor < SS_ANCHOR_MAX ? s_nanchor : SS_ANCHOR_MAX;
+    while ((k = ss_recs_next(&it, &key, &rec)) == 1) {
+        rec.name[sizeof rec.name - 1] = 0;
+        for (LONG i = 0; i < n; i++) {
+            const ss_time_anchor* a = s_anchor[i];
+            if (a && a->restore && !strcmp(a->name, rec.name)) a->restore(rec.value, &t);
+        }
+    }
+    return k < 0 ? k : SS_OK;
+}
+
+static const ss_section_ops k_time_ops = {
+    SS_FOURCC('T', 'I', 'M', 'E'), 1, SS_SEC_NO_VERIFY, SS_ORDER_TIME,
+    NULL, time_capture, NULL, time_restore, NULL,
+    "time", k_time_lists, NULL, NULL,
+};
+SS_SECTION_REGISTER(k_time_ops)
diff --git a/runtime/savestate/ss_state.h b/runtime/savestate/ss_state.h
new file mode 100644
index 0000000..bee3e7e
--- /dev/null
+++ b/runtime/savestate/ss_state.h
@@ -0,0 +1,637 @@
+/*
+ * ps3recomp - save-state image: sections, field lists, the writer and the
+ * reader (milestone M4b, the capture to RAM; engine design sections 4.2, 5, 6)
+ *
+ * A save state is an IMAGE held in RAM: a header, a section table, a chunk
+ * table and the data. Every subsystem that owns guest-visible state adds one
+ * SECTION, registered at static init in its own file (ss_section_register).
+ * At a SAVE the coordinator (ss_core.c) stops the world, flushes the renderer
+ * and waits for the GPU, runs every section's check(), then calls every
+ * section's capture() in `order` -- on the frame-clock thread, with every
+ * guest PPU thread, SPU thread and the audio mixer parked -- and releases.
+ * Nothing is written to disk here: SS_DUMP writes the raw image for
+ * tools/ss_inspect.py, the slot file is M5, the restore M4c.
+ *
+ * A SECTION's bytes are a stream of RECORDS, each self-describing:
+ *   FIELDS  named variables (a field list), e.g. a file's statics
+ *   RECS    an array of structs, one field list for all of them, each with a
+ *           u32 key (an id, a table index)
+ *   BLOB    raw bytes (a ring, a bitmap, guest pages), bounds-checked on read
+ *   TEXT    printf'd text (the census chains)
+ *   U64     one named number
+ *   or a type of the section's own (ss_write_tlv)
+ * Every record carries its name; FIELDS and RECS carry their fields' names,
+ * name hashes and sizes too, so the reader finds a field by NAME and refuses
+ * with that name when this build's list differs from the image's (a struct
+ * that grew, a field renamed or dropped) instead of misreading it; and
+ * tools/ss_inspect.py can print any section without knowing it.
+ *
+ * WHAT GOES IN A SECTION. Guest-visible values and ids only: never a host
+ * pointer, HANDLE, lock, condition variable or cache (engine design 6.1). A
+ * kernel object is saved as its plain fields and recreated on load; a pointer
+ * becomes the id or guest address it stands for. Every static of an owning
+ * file is classified SAVE / RESET / KEEP / DIAG / BOOT in
+ * config/ss_manifest.txt (tools/ss_manifest_check.py, a gate).
+ *
+ * THREADS AND MEMORY. check() and capture() run on the frame-clock thread,
+ * everything parked. capture() must not allocate: a parked thread may have
+ * stopped anywhere a safepoint is, and anything the capture shares a lock
+ * with -- the CRT heap first of all -- must not be needed. Write into the
+ * writer only (it is the preallocated staging buffer); keep scratch in
+ * statics. No logging inside capture (stderr's lock): return an error, the
+ * coordinator logs it after the release. size_hint() and everything marked
+ * "outside a stop" may allocate.
+ *
+ * ERRORS. Writer errors are sticky: after the first one every later write is
+ * a no-op that returns it, so a capture() may write everything and return
+ * ss_writer_error(w) at the end. SS_E_OVERFLOW (the staging buffer is full)
+ * keeps counting what the capture would have needed: the coordinator refuses
+ * that stop, grows the buffer outside the next one (ss_state_prepare) and
+ * retries.
+ *
+ * C and C++: plain C structs and functions; SS_SECTION_REGISTER works in both
+ * (a constructor function in C, a static object in C++). A worked example:
+ * the TIME section at the end of ss_state.c (FIELDS of a struct, RECS of the
+ * anchors other owners add); CHNS in ss_core.c is a TEXT-only one.
+ */
+#ifndef PS3RECOMP_SS_STATE_H
+#define PS3RECOMP_SS_STATE_H
+
+#include <stdarg.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* "GMEM" as it reads in a hex dump of the image (little-endian bytes). */
+#define SS_FOURCC(a, b, c, d) \
+    ((uint32_t)(uint8_t)(a) | ((uint32_t)(uint8_t)(b) << 8) | \
+     ((uint32_t)(uint8_t)(c) << 16) | ((uint32_t)(uint8_t)(d) << 24))
+
+/* ---- errors -------------------------------------------------------------- */
+enum ss_err {
+    SS_OK          = 0,
+    SS_E_OVERFLOW  = -1,   /* the staging buffer (or the chunk table) is full */
+    SS_E_NOT_FOUND = -2,   /* no such section or record */
+    SS_E_LAYOUT    = -3,   /* a field list differs from the image's (ss_reader_what names the field) */
+    SS_E_SIZE      = -4,   /* a record or blob is larger than the destination */
+    SS_E_CORRUPT   = -5,   /* bad magic, CRC, or a record running past its section */
+    SS_E_STATE     = -6,   /* misuse: a record left open, a write outside a capture, ... */
+    SS_E_ARG       = -7,   /* a bad argument */
+    SS_E_IO        = -8,   /* a file could not be written or read */
+    SS_E_NOMEM     = -9    /* the staging buffer could not grow (outside a stop) */
+};
+const char* ss_strerror(int err);
+
+/* ---- field lists ----------------------------------------------------------- */
+/* One field: a static (SS_FIELD: `at` is its address) or a struct member
+ * (SS_MEMBER: `at` is its offset, read against a base pointer). Names are
+ * unique within their list; the image stores each name, its FNV-1a hash and
+ * the size. Keep the variable's own name: renaming it in the source makes
+ * old images refuse with that name (an honest refusal), which is the point.
+ * An .inc file of SS_F(var) lines (the gcm_ss.inc style) keeps a long list
+ * next to the code it describes:
+ *     static const ss_field k_gcm_fields[] = {
+ *     #define SS_F(v) SS_FIELD(v),
+ *     #include "gcm_ss.inc"
+ *     #undef SS_F
+ *     };
+ *     static const ss_list k_gcm_list = SS_LIST("gcm", k_gcm_fields); */
+typedef struct ss_field {
+    const char* name;
+    void*       at;          /* &variable, or (void*)offsetof(type, member) */
+    uint32_t    size;
+    uint32_t    flags;       /* SS_FF_* */
+} ss_field;
+enum {
+    SS_FF_NO_RESTORE = 1u,   /* captured (inspection, M4c's fidelity check), never written back */
+    SS_FF_OPTIONAL   = 2u,   /* added later: an image without it leaves the variable as it is */
+    /* A host value: a statistic, a time a capture took, a host instant -- it
+     * differs from one capture of the same guest state to the next. Captured
+     * and (unless also NO_RESTORE) restored like any field, but M4c's
+     * fidelity check (SS_VERIFY: capture(restore(S)) == S) skips it. A
+     * NO_RESTORE field without this flag IS compared: a value a load does not
+     * write but must come back by itself (an lwmutex owner word read from
+     * guest memory). */
+    SS_FF_HOST       = 4u
+};
+#define SS_FIELD(var)            { #var, (void*)&(var), (uint32_t)sizeof(var), 0u }
+#define SS_FIELD_AS(name, var)   { name, (void*)&(var), (uint32_t)sizeof(var), 0u }
+#define SS_FIELD_F(var, flags)   { #var, (void*)&(var), (uint32_t)sizeof(var), (uint32_t)(flags) }
+#define SS_MEMBER(type, m) \
+    { #m, (void*)(uintptr_t)offsetof(type, m), (uint32_t)sizeof(((type*)0)->m), 0u }
+#define SS_MEMBER_F(type, m, flags) \
+    { #m, (void*)(uintptr_t)offsetof(type, m), (uint32_t)sizeof(((type*)0)->m), (uint32_t)(flags) }
+
+/* A named field list: the record's name in its section ("gcm", "semaphores"). */
+typedef struct ss_list {
+    const char*     name;
+    const ss_field* f;
+    uint32_t        n;
+} ss_list;
+#define SS_LIST(name, arr) { name, arr, (uint32_t)(sizeof(arr) / sizeof((arr)[0])) }
+
+uint32_t ss_name_hash(const char* s);      /* FNV-1a, 32 bit */
+/* The layout hash of a list: its name, then every field's name and size, in
+ * order. Two builds agree on a list iff they agree on this. */
+uint64_t ss_list_hash(const ss_list* l);
+
+/* ---- sections -------------------------------------------------------------- */
+enum {
+    SS_SEC_OPTIONAL  = 1u,   /* a build without this section still loads the image (skips it) */
+    SS_SEC_INFO      = 2u,   /* inspection only: never restored, not in the image's layout hash */
+    SS_SEC_NO_VERIFY = 4u    /* M4c's capture(restore(S)) == S check skips it (it holds the time) */
+};
+/* Restore order (engine design 4.3 step 3); capture runs in the same order. */
+enum ss_order {
+    SS_ORDER_TIME    = 100,  /* TIME */
+    SS_ORDER_MEMORY  = 200,  /* MAPS 200, GMEM 210 */
+    SS_ORDER_ALLOC   = 300,  /* KMEM */
+    SS_ORDER_KERNEL  = 400,  /* KOBJ */
+    SS_ORDER_PPU     = 500,  /* PPUT */
+    SS_ORDER_SPU     = 600,  /* SPUG, SPUC, SPUH */
+    SS_ORDER_PORTS   = 700,
+    SS_ORDER_FS      = 800,  /* FSFD */
+    SS_ORDER_GCM     = 900,  /* GCM_ */
+    SS_ORDER_GPU     = 1000, /* GPUP */
+    SS_ORDER_AUDIO   = 1100, /* AUDI */
+    SS_ORDER_PAD     = 1200, /* PAD_ */
+    SS_ORDER_SYSUTIL = 1300, /* SUTL, MISC */
+    SS_ORDER_TITLE   = 1400, /* TITL */
+    SS_ORDER_INFO    = 1500  /* THMB, CHNS */
+};
+
+struct ss_writer;
+struct ss_reader;
+typedef struct ss_section_ops {
+    uint32_t fourcc, version, flags;   /* SS_FOURCC('S','E','M','A'), 1, SS_SEC_* */
+    int      order;                    /* SS_ORDER_* (+ a small offset within a band) */
+    /* Strict save eligibility, everything parked, the GPU idle: 0 = fine; else an
+     * ss_reason (ss_core.h, e.g. SS_REASON_FILE_WRITE) -- anything else reads
+     * SS_REASON_SECTION -- with the blocker in why ("fd 7 open for writing").
+     * The save is refused at this stop and retried at a later one (M4a's
+     * retry window). Read your own state only, no lock: like ss_add_check.
+     * NULL: always fine. */
+    int  (*check)(char* why, size_t n);
+    /* Everything parked, the GPU idle: write the section (FIELDS, RECS,
+     * BLOBs ...) into w. Return 0, or an SS_E_* (ss_writer_error(w) at the
+     * end is the usual return). No allocation, no logging (see the top). */
+    int  (*capture)(struct ss_writer* w);
+    /* M4c, a LOAD after every thread was discarded: drop the old state's
+     * host objects (close handles, free contexts). NULL: none. The contract
+     * (what holds when it runs, what it may do) is "THE LOAD" below. */
+    void (*teardown)(void);
+    /* M4c: rebuild from the image (ss_reader_open'ed on this section). 0, or
+     * an SS_E_* with ss_reader_what(r) naming the field -- after the point of
+     * no return, so a failure ends the process (never a half state). */
+    int  (*restore)(struct ss_reader* r);
+    /* After the world is released again, e.g. restart a device stream. */
+    void (*after_release)(void);
+    /* -- appended (positional initialisers above stay valid) -- */
+    const char*           name;        /* for logs ("guest memory"); NULL: the fourcc */
+    /* The static field lists capture() writes, NULL-terminated: they make up
+     * the section's layout hash (ss_section_layout_hash), which a load checks
+     * before it stops anything. NULL: the version alone. */
+    const ss_list* const* lists;
+    /* The most bytes capture() could write now (staging sizing; outside a
+     * stop). NULL: SS_SECTION_SMALL. */
+    uint64_t (*size_hint)(void);
+    /* M4c's fidelity check for this section: `a` is the image that was
+     * loaded, `b` the capture taken right after the restore, both opened on
+     * this section. 0 = equal; else the number of differences, the first
+     * one in why ("pages: 0x30001000 +0x18: 0x00 vs 0x7F"). NULL: the
+     * generic check (ss_state_verify: record by record, field by field by
+     * name, SS_FF_HOST fields skipped, BLOB / TEXT / U64 / other records
+     * byte for byte). */
+    int (*verify)(struct ss_reader* a, struct ss_reader* b, char* why, size_t why_n);
+    /* M4c, before a LOAD stops anything (the world running, nothing
+     * discarded yet): can this section of the image be restored here? The
+     * reader is open on it. 0 = yes; else an SS_E_* with ss_reader_fail
+     * saying why ("files[2:4]: /dev_hdd0/x.psarc changed on disk since the
+     * save") -- the load is refused with nothing stopped, which a failure in
+     * restore() (past the point of no return) can no longer do. May
+     * allocate, log and stat files. NULL: always. */
+    int (*check_image)(struct ss_reader* r);
+} ss_section_ops;
+#define SS_SECTION_MAX   64
+#define SS_SECTION_SMALL (256u * 1024u)
+
+/* Register a section (static init, in the owning file). Returns 1, or 0 for
+ * NULL, a fourcc already taken (logged) or a full table. The ops are kept by
+ * pointer: make them static. One registered after the capture order's first
+ * use makes it be built again in place: safe only while no other thread can
+ * save, load or walk the order (a single-threaded test; logged once).
+ * The runtime is a static library: a section must live in a file the program
+ * already links for another reason, or its registration is dropped with it. */
+int ss_section_register(const ss_section_ops* ops);
+int ss_section_count(void);
+const ss_section_ops* ss_section_at(int i);           /* in capture order */
+/* The capture order is whole: every registered section in it once, by
+ * `order` (it is built on first use by one thread, from any thread). A load
+ * tears down and restores exactly these sections, so it checks this before
+ * its point of no return (ss_core.c load_checks). 0, or non-zero with why. */
+int ss_state_order_check(char* why, size_t why_n);
+/* The same check over a given order (the unit test's way in). */
+int ss_state_order_check_list(const ss_section_ops* const* ord, long n, char* why, size_t why_n);
+const ss_section_ops* ss_section_find(uint32_t fourcc);
+uint64_t ss_section_layout_hash(const ss_section_ops* ops);   /* fourcc, version, lists */
+const char* ss_fourcc_str(uint32_t fourcc, char b[5]);        /* "GMEM" into b; returns b */
+
+#define SS_CAT_(a, b) a##b
+#define SS_CAT(a, b)  SS_CAT_(a, b)
+/* SS_SECTION_REGISTER(k_my_ops); at file scope, after the ops (a plain
+ * name: in C++ the static-init object is ss_section_reg_<ops>, the name the
+ * linker map and the manifest give it). */
+#if defined(__cplusplus)
+#  define SS_SECTION_REGISTER(ops) \
+    namespace { const int SS_CAT(ss_section_reg_, ops) = ss_section_register(&(ops)); }
+#elif defined(__GNUC__) || defined(__clang__)
+#  define SS_SECTION_REGISTER(ops) \
+    __attribute__((constructor)) static void SS_CAT(ss_section_reg_, __LINE__)(void) \
+    { ss_section_register(&(ops)); }
+#elif defined(_MSC_VER)
+#  pragma section(".CRT$XCU", read)
+#  define SS_SECTION_REGISTER(ops) \
+    static void SS_CAT(ss_section_reg_, __LINE__)(void) { ss_section_register(&(ops)); } \
+    __declspec(allocate(".CRT$XCU")) static void (*SS_CAT(ss_section_regp_, __LINE__))(void) = \
+        SS_CAT(ss_section_reg_, __LINE__)
+#endif
+
+/* ---- the writer (inside capture) ------------------------------------------- */
+typedef struct ss_writer ss_writer;
+/* What the coordinator knows about the capture (also for TIME). */
+typedef struct ss_capture_info {
+    unsigned seq;              /* the request number ("request #N" in the log) */
+    int      purpose;          /* SS_P_SAVE, ... (ss_core.h) */
+    unsigned flip_count;       /* the guest's flips so far */
+    uint64_t play_ms;          /* play time: wall time since the first flip, stops excluded */
+    uint64_t unix_ms;          /* wall clock, ms since 1970 UTC */
+    double   t_s;              /* process time (s) */
+    /* The capture's one instant (appended): the GUEST QPC (guest_clock.h:
+     * QueryPerformanceCounter + the guest clock's bias), read by
+     * ss_state_capture just before the first section (0: read it there).
+     * The coordinator freezes the guest clock for a save's capture, so every
+     * guest clock reads this instant until the release. TIME records it as
+     * host.qpc and samples the guest clock and its anchors right after it; a
+     * later section that saves a value of a guest clock (an SPU
+     * decrementer) computes it at this instant, not at its own turn -- MAPS
+     * and GMEM run in between, ~20 ms -- so every time source in the image
+     * agrees (critique H12). */
+    uint64_t qpc, qpc_freq;
+} ss_capture_info;
+const ss_capture_info* ss_writer_info(const ss_writer* w);
+
+/* Record types (ss_write_tlv takes any other fourcc). */
+#define SS_REC_FIELDS SS_FOURCC('F', 'L', 'D', 'S')
+#define SS_REC_RECS   SS_FOURCC('R', 'E', 'C', 'S')
+#define SS_REC_BLOB   SS_FOURCC('B', 'L', 'O', 'B')
+#define SS_REC_TEXT   SS_FOURCC('T', 'E', 'X', 'T')
+#define SS_REC_U64    SS_FOURCC('U', '6', '4', ' ')
+
+/* Every write returns 0 or the writer's (sticky) error. */
+int ss_write_fields(ss_writer* w, const ss_list* l);                     /* statics (SS_FIELD) */
+int ss_write_fields_at(ss_writer* w, const ss_list* l, const void* base);  /* one struct (SS_MEMBER) */
+/* An array of structs: begin, one add per element you keep (a live table
+ * slot; key = its id or index, the reader gets it back), end. */
+int ss_recs_begin(ss_writer* w, const ss_list* l);
+int ss_recs_add(ss_writer* w, uint32_t key, const void* base);
+int ss_recs_end(ss_writer* w);
+int ss_write_blob(ss_writer* w, const char* name, const void* p, uint64_t n);
+/* A blob written in pieces; `align` (power of 2, up to 4096; 0 = 8) aligns
+ * its payload in the image (GMEM's pages are 4096-aligned). */
+int   ss_blob_begin(ss_writer* w, const char* name, uint32_t align);
+int   ss_blob_put(ss_writer* w, const void* p, uint64_t n);
+void* ss_blob_reserve(ss_writer* w, uint64_t n);   /* n bytes to fill in place; NULL after an error
+                                                    * (the bytes are still counted: keep going) */
+int   ss_blob_end(ss_writer* w);
+int ss_write_u64(ss_writer* w, const char* name, uint64_t v);
+int ss_write_tlv(ss_writer* w, uint32_t type, const char* name, const void* p, uint64_t n);
+/* TEXT: begin, any number of printfs (formatted straight into the staging
+ * buffer; vsnprintf, no allocation), end. */
+int ss_text_begin(ss_writer* w, const char* name);
+int ss_text_printf(ss_writer* w, const char* fmt, ...)
+#if defined(__GNUC__) || defined(__clang__)
+    __attribute__((format(printf, 2, 3)))
+#endif
+    ;
+int ss_text_vprintf(ss_writer* w, const char* fmt, va_list ap);
+int ss_text_end(ss_writer* w);
+int ss_writer_error(const ss_writer* w);
+const char* ss_writer_what(const ss_writer* w);    /* the first error, in words */
+uint64_t ss_writer_size(const ss_writer* w);       /* bytes of the current section so far */
+
+/* ---- the image ------------------------------------------------------------- */
+/* Raw image layout (the SS_DUMP file, little-endian; M5's P3SS file adds
+ * compression around the same sections):
+ *   ss_img_hdr (256 B) | ss_sec_ent[nsections] | ss_chunk_ent[nchunks] |
+ *   zero padding to data_off (4096-aligned) | data (data_size bytes)
+ * A section's bytes are data[offset, offset+size), cut into chunks of at most
+ * SS_CHUNK_BYTES, each with a CRC32C (Castagnoli) of its bytes. */
+#define SS_RAW_MAGIC   "P3SSRAW\x1a"
+#define SS_RAW_VERSION 1u
+#define SS_CHUNK_BYTES (1u << 20)
+#define SS_CHUNK_MAX   4800u          /* 4.5 GB of data */
+enum { SS_IMG_NO_ARENA = 1u };        /* no guest arena was declared: MAPS / GMEM are empty */
+typedef struct ss_img_hdr {
+    char     magic[8];
+    uint32_t version, hdr_size;       /* SS_RAW_VERSION, 256 */
+    uint64_t file_size;
+    uint32_t nsections, nchunks;
+    uint64_t sec_off, chunk_off, data_off, data_size;
+    uint64_t layout_hash;             /* every section's (not SS_SEC_INFO) */
+    uint64_t created_unix_ms;
+    uint32_t chunk_bytes, flags;      /* SS_CHUNK_BYTES, SS_IMG_* */
+    uint32_t seq, hdr_crc;            /* request number; CRC32C of the header (hdr_crc 0), then
+                                       * of the section table and the chunk table */
+    char     build[64];               /* informational */
+    uint8_t  reserved[256 - 160];
+} ss_img_hdr;
+typedef struct ss_sec_ent {
+    uint32_t fourcc, version, flags;
+    int32_t  order;
+    uint64_t layout_hash;
+    uint64_t offset, size;            /* in data */
+    uint32_t chunk0, nchunks;         /* its chunks in the chunk table */
+    uint32_t records, capture_us;     /* top-level records; how long capture() took */
+    uint32_t reserved[2];
+} ss_sec_ent;
+typedef struct ss_chunk_ent {
+    uint64_t offset;                  /* in data */
+    uint32_t size, crc;               /* CRC32C of the chunk's bytes */
+} ss_chunk_ent;
+
+/* A parsed image: the last capture (ss_image_last) or a raw file read into
+ * memory (ss_image_parse). Points into the bytes it was made from; fields
+ * read-only. */
+typedef struct ss_image {
+    ss_img_hdr          hdr;
+    const ss_sec_ent*   sec;
+    const ss_chunk_ent* chunk;
+    const uint8_t*      data;
+    int                 sealed;       /* CRCs computed (ss_state_seal / a file) */
+} ss_image;
+/* The last capture, sealed; NULL if none. Valid until the next capture
+ * starts (the staging buffer is reused). */
+const ss_image* ss_image_last(void);
+/* A raw image in memory (n bytes): checks magic, version, header CRC and
+ * every table bound. 0, or SS_E_CORRUPT with why. */
+int ss_image_parse(ss_image* img, const void* buf, uint64_t n, char* why, size_t why_n);
+/* Every chunk's CRC32C; 0, or SS_E_CORRUPT naming the section and chunk. */
+int ss_image_verify(const ss_image* img, char* why, size_t why_n);
+/* In-process validation before a load (M4c), with the world running: CRCs,
+ * every record well-formed, and every section this build registers agrees
+ * on its layout hash; an unknown mandatory section refuses with its name,
+ * an unknown optional one is skipped. */
+int ss_image_validate(const ss_image* img, char* why, size_t why_n);
+/* The same, with check_crc 0: every chunk's CRC32C is NOT checked again (a
+ * slot file's reader checked them as it decompressed: SS_RQ_CRC_CHECKED);
+ * the header's and the tables' CRC still is. */
+int ss_image_validate_ex(const ss_image* img, int check_crc, char* why, size_t why_n);
+const ss_sec_ent* ss_image_section(const ss_image* img, uint32_t fourcc);
+/* Write the raw image to path (a .tmp, then renamed over it). Outside a stop. */
+int ss_image_write_file(const ss_image* img, const char* path, double* ms, char* why, size_t why_n);
+uint32_t ss_crc32c(uint32_t crc, const void* p, size_t n);   /* SSE4.2 when the CPU has it */
+
+/* XPRESS_HUFF (Windows Compression API, cabinet.dll, raw 1 MB chunks) on up
+ * to `max_chunks` chunks of a section spread evenly over it, to estimate
+ * what the slot file will weigh. Outside a stop (it allocates). */
+typedef struct ss_compress_est {
+    uint32_t chunks, of;              /* sampled, out of */
+    uint64_t raw, stored;             /* bytes of the sample in and out */
+    double   ratio;                   /* stored / raw (1.0: nothing measured) */
+    double   ms, mb_s;                /* time, single-thread throughput */
+} ss_compress_est;
+int ss_image_estimate_compressed(const ss_image* img, uint32_t fourcc, uint32_t max_chunks,
+                                 ss_compress_est* out);
+
+/* ---- the reader ------------------------------------------------------------ */
+/* One section of an image. A plain struct (on the stack is fine); fields
+ * private. No allocation anywhere in the reader. */
+typedef struct ss_reader {
+    const ss_image* img;
+    uint32_t        fourcc, version, flags;
+    const uint8_t*  data;
+    uint64_t        size;
+    uint64_t        pos;              /* where the next search starts */
+    int             err;
+    char            what[128];        /* the first error: "semaphores.value: 4 bytes in the image, 8 here" */
+} ss_reader;
+int ss_reader_open(ss_reader* r, const ss_image* img, uint32_t fourcc);   /* 0 / SS_E_NOT_FOUND */
+const char* ss_reader_what(const ss_reader* r);
+/* A restore's own refusal, the way the readers report theirs: the first
+ * error sticks (err, and what -- name the field: "semaphores[3].value: 9
+ * above its max 4"); returns err, so `return ss_reader_fail(r, SS_E_STATE,
+ * ...);`. The coordinator prints what with the section's fourcc. */
+int ss_reader_fail(ss_reader* r, int err, const char* fmt, ...)
+#if defined(__GNUC__) || defined(__clang__)
+    __attribute__((format(printf, 3, 4)))
+#endif
+    ;
+
+typedef struct ss_rec {
+    uint32_t       type, flags;
+    char           name[64];          /* truncated copy (the image has the whole name) */
+    const uint8_t* data;              /* payload */
+    uint64_t       len;
+    uint64_t       off;               /* the record's offset in the section */
+} ss_rec;
+/* Every record in order: *cursor 0 to start; 1 = got one, 0 = the end, < 0 an error. */
+int ss_rec_next(ss_reader* r, uint64_t* cursor, ss_rec* out);
+/* The record of this type and name (searched from where the last one was found). */
+int ss_rec_find(ss_reader* r, uint32_t type, const char* name, ss_rec* out);
+
+/* Fields by name: every field of l must be in the image with the same size,
+ * and every field in the image must be in l (else SS_E_LAYOUT naming it --
+ * SS_FF_OPTIONAL fields may be missing). Nothing is written unless all
+ * match. SS_FF_NO_RESTORE fields are checked, not written. */
+int ss_read_fields(ss_reader* r, const ss_list* l);
+int ss_read_fields_at(ss_reader* r, const ss_list* l, void* base);
+typedef struct ss_recs_it {
+    ss_reader*     r;
+    const ss_list* l;
+    uint32_t       count, i;          /* records in the image; the next one */
+    const uint8_t* p;                 /* private */
+    uint32_t       rec_size, nfields;
+    const uint8_t* desc;
+    const uint8_t* names;
+    uint32_t       map[128];          /* list field -> image field (private) */
+} ss_recs_it;
+int ss_recs_open(ss_reader* r, const ss_list* l, ss_recs_it* it);   /* checks the layout */
+int ss_recs_next(ss_recs_it* it, uint32_t* key, void* base);        /* 1 / 0 the end / < 0 */
+/* A blob into dst: SS_E_SIZE if it holds more than cap (*len = its size). */
+int ss_read_blob(ss_reader* r, const char* name, void* dst, uint64_t cap, uint64_t* len);
+int ss_find_blob(ss_reader* r, const char* name, const void** p, uint64_t* len);   /* in place */
+int ss_read_u64(ss_reader* r, const char* name, uint64_t* v);
+int ss_find_text(ss_reader* r, const char* name, const char** p, uint64_t* len);  /* not NUL-terminated */
+
+/* ---- time (TIME section) ----------------------------------------------------- */
+/* TIME holds the guest clock at capture, the play time and every ANCHOR: a
+ * time value another owner keeps (a start time, a deadline base, an elapsed
+ * count) that a load must re-anchor (M4c: one guest clock, engine design 6.4).
+ * An owner adds its anchor at static init. */
+typedef struct ss_time_info {
+    uint64_t guest_tb;                /* the guest time base at capture (ticks) */
+    uint64_t tb_freq;                 /* its frequency (PS3: 79.8 MHz) */
+    uint64_t guest_ns;                /* the same in ns */
+    uint64_t play_ms, unix_ms;
+    uint32_t flip_count;
+} ss_time_info;
+typedef struct ss_time_anchor {
+    const char* name;                 /* unique, < 32 chars: "sys_time.base", "gcm.flip_time" */
+    uint64_t  (*capture)(void);       /* its value now (everything parked), in its own unit */
+    void      (*restore)(uint64_t saved, const ss_time_info* at);   /* M4c; NULL: nothing to do */
+} ss_time_anchor;
+int ss_time_anchor_add(const ss_time_anchor* a);   /* up to 32; returns 1 */
+/* The host's guest clock (main.cpp: ppu_timebase_now, PS3_TIMEBASE_FREQ). */
+void ss_time_set_guest_clock(uint64_t (*tb_now)(void), uint64_t tb_freq);
+int  ss_time_read(const ss_image* img, ss_time_info* out);   /* the image's TIME */
+/* An anchor's value in the image (what its capture returned), by name: 0,
+ * or SS_E_NOT_FOUND. For a section whose restore re-bases a clock itself
+ * (anchor restores run inside TIME's restore, before every other section's:
+ * a field list written later would undo theirs). */
+int  ss_time_anchor_read(const ss_image* img, const char* name, uint64_t* value);
+/* The one guest clock's controls (guest_clock.h; sys_timer.c registers them
+ * at its init): freeze guest time now, go on from the frozen instant, and
+ * freeze it at the instant the time base reads guest_tb. Any member NULL. */
+typedef struct ss_guest_clock_ops {
+    void (*freeze)(void);
+    void (*thaw)(void);
+    void (*set)(uint64_t guest_tb);
+    /* (appended, M5) frozen at the guest QPC guest_qpc (counted at qpc_freq:
+     * converted if this host's differs), with the time base re-anchored to
+     * read guest_tb there: the snapshot's QPC epoch comes back, so a slot
+     * saved by another process loads with every absolute guest-clock value
+     * it holds consistent. TIME's restore prefers it to set. */
+    void (*set_qpc)(uint64_t guest_qpc, uint64_t qpc_freq, uint64_t guest_tb);
+} ss_guest_clock_ops;
+void ss_time_set_clock_ops(const ss_guest_clock_ops* ops);
+/* The coordinator's calls: a SAVE freezes before its capture and thaws at
+ * its release (the game sees no jump); a LOAD's TIME restore sets the clock
+ * to the snapshot's time base and the release thaws it. No-ops without ops. */
+void ss_time_freeze(void);
+void ss_time_thaw(void);
+
+/* ---- guest memory (MAPS, GMEM) -------------------------------------------- */
+/* The host declares the guest arena (main.cpp: vm_base, 4 GB). Without it
+ * MAPS and GMEM are empty and the image is flagged SS_IMG_NO_ARENA. */
+void ss_state_set_arena(void* base, uint64_t size);
+typedef struct ss_mem_stats {
+    uint64_t arena;                   /* bytes declared */
+    uint64_t committed;               /* committed (VirtualQuery) */
+    uint64_t nonzero;                 /* in 4 KB pages that are not all zero: what GMEM holds */
+    uint64_t unreadable;              /* committed, no access / guard (not read, not saved) */
+    uint32_t regions, pages;          /* committed regions; non-zero pages */
+    double   scan_ms, copy_ms;        /* MAPS's scan, GMEM's copy */
+} ss_mem_stats;
+void ss_state_mem_stats(ss_mem_stats* out);   /* of the last capture */
+uint64_t ss_state_committed_now(void);        /* a fresh VirtualQuery walk (outside a stop) */
+
+/* ---- the coordinator's side (ss_core.c) ------------------------------------ */
+/* ss_enable: reserve the staging buffer's address range and commit its
+ * initial size (the committed arena, if declared, plus the margin). */
+int  ss_state_enable(void);
+/* Outside a stop, the world running: sort the sections, and grow the staging
+ * buffer to what a capture can need now (committed arena + every
+ * size_hint + the margin, or what the last overflowed capture counted),
+ * touching the new pages so the capture takes no page fault. 0, or
+ * SS_E_NOMEM with why. */
+int  ss_state_prepare(char* why, size_t why_n);
+/* Everything parked: every section's check(). 0, or the first one's reason
+ * (and its section in *fourcc, the blocker in why). */
+int  ss_state_check(char* why, size_t why_n, uint32_t* fourcc);
+/* Everything parked, the GPU idle: every capture() into the staging buffer.
+ * 0, or an SS_E_* with why (and the section in *fourcc). */
+int  ss_state_capture(const ss_capture_info* info, char* why, size_t why_n, uint32_t* fourcc);
+/* After the release: the CRC32C of every chunk and of the header; the image
+ * is then ss_image_last(). Returns ms spent. */
+double ss_state_seal(void);
+uint64_t ss_state_staging_bytes(void);      /* committed staging */
+uint64_t ss_state_need(void);               /* bytes the last capture needed (or counted) */
+double   ss_state_capture_ms(void);         /* the last capture */
+/* For tests: the margin over the committed arena (default 32 MB). */
+void ss_state_set_margin(uint64_t bytes);
+
+/* ---- held images (M4c) ----------------------------------------------------- */
+/* The staging memory is two BANKS of the same reserve: a capture writes into
+ * the current one. ss_image_hold() keeps the last (sealed) capture as THE
+ * HELD IMAGE -- a selftest's state A, the image a LOAD request carries -- and
+ * switches captures to the other bank, so a later save, or the fidelity
+ * check's capture right after a load, does not overwrite it. One held image
+ * at a time: a second hold replaces the first. Outside a stop, or on the
+ * coordinator inside one (a selftest captures and holds in the same stop). */
+const ss_image* ss_image_hold(void);     /* NULL if there is no sealed capture */
+const ss_image* ss_image_held(void);     /* NULL if none */
+void ss_image_release(void);
+/* The last capture as it stands, sealed or not (the fidelity check reads its
+ * capture in the stop, before any seal); NULL before the first. Valid until
+ * the next capture starts. */
+const ss_image* ss_image_captured(void);
+/* Outside a stop: grow the bank captures use to what a capture can need
+ * (ss_state_prepare's sizing) -- before a stop whose load runs the fidelity
+ * check, which captures into it. 0, or SS_E_NOMEM with why. */
+int  ss_state_prepare_spare(char* why, size_t why_n);
+
+/* ---- THE LOAD (M4c; engine design 4.3; the full contract is in the
+ * engine's design notes) ------------------------------------------------
+ * The coordinator (ss_core.c) runs a LOAD request -- and a SELFTEST, which
+ * captures state A and loads it in the same stop -- on the frame-clock
+ * thread, the only thread that does anything from DISCARD to RELEASE:
+ *   stop (lenient) -> GPU idle -> DISCARD: every guest PPU thread but main
+ *   and every SPU host thread is gone (its host thread has returned), main
+ *   waits at the load gate, the mixer stays parked; the old state is gone
+ *   (the point of no return: from here a failure ends the process)
+ *   -> TEARDOWN: every section's teardown(), in `order`
+ *   -> RESTORE: every section's restore(), in `order`, from the image
+ *   -> VERIFY (SS_VERIFY): every section captured again (into the other
+ *   bank) and compared with the image (ss_state_verify)
+ *   -> RECREATE: PPU and SPU threads in resume mode, held at the gate
+ *   -> RELEASE: guest clock thawed, gate opened, mixer released, frame clock
+ *   resynced, every section's after_release().
+ * So when teardown() and restore() run: no guest PPU / SPU thread exists
+ * (none can hold a lock, wait on a handle or touch guest memory), the mixer
+ * is parked, the walker is the caller, the GPU is idle (the batch executed,
+ * the fence waited for), the guest clock is frozen. teardown() runs with the
+ * OLD guest memory still in place (TIME, MAPS, GMEM restore first); restore()
+ * of every section after GMEM (order > SS_ORDER_MEMORY + 10) sees the
+ * snapshot's guest memory. Both may allocate, free, log and take their own
+ * locks; neither may start a thread, wait for a guest thread or call guest
+ * code. A section absent from the image keeps its state (an OPTIONAL one);
+ * a section with no restore keeps its state (logged once: not restored). */
+int  ss_state_teardown(void);           /* every teardown(), in order; returns how many ran */
+/* Before a LOAD's stop: every section's check_image() on its part of img. 0,
+ * or the first refusal's SS_E_* with the section in *fourcc (may be NULL)
+ * and "section XXXX: <its reason>" in why. */
+int  ss_state_check_image(const ss_image* img, char* why, size_t why_n, uint32_t* fourcc);
+/* Every restore(), in order. 0, or the first failure's SS_E_* with the
+ * section in *fourcc and the reader's message in why. *norestore (may be
+ * NULL) gets the sections in the image this build cannot restore yet. */
+int  ss_state_restore(const ss_image* img, char* why, size_t why_n, uint32_t* fourcc,
+                      unsigned* norestore);
+void ss_state_after_release(void);      /* every after_release(), in order */
+/* The fidelity check: section by section, a against b (ops->verify or the
+ * generic compare: records in order, FIELDS / RECS field by field by name
+ * with SS_FF_HOST fields skipped, everything else byte for byte). Sections
+ * flagged SS_SEC_NO_VERIFY or SS_SEC_INFO are skipped, a section missing
+ * from b is a difference. Returns the sections that differ. */
+#define SS_VERIFY_MAX 64
+typedef struct ss_verify_sec {
+    uint32_t fourcc;
+    unsigned diffs;              /* fields / bytes / records that differ (0: equal) */
+    char     first[192];         /* the first difference, by field name */
+} ss_verify_sec;
+typedef struct ss_verify_result {
+    unsigned n, compared, differ;    /* sections listed, compared, differing */
+    double   ms;
+    ss_verify_sec sec[SS_VERIFY_MAX];
+} ss_verify_result;
+int  ss_state_verify(const ss_image* a, const ss_image* b, ss_verify_result* out);
+/* The generic compare of one section (what a verify hook may fall back to). */
+int  ss_verify_generic(ss_reader* a, ss_reader* b, char* why, size_t why_n);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_SS_STATE_H */
diff --git a/runtime/savestate/ss_ui.c b/runtime/savestate/ss_ui.c
new file mode 100644
index 0000000..baa5705
--- /dev/null
+++ b/runtime/savestate/ss_ui.c
@@ -0,0 +1,681 @@
+/*
+ * ps3recomp - save states: the user-facing side (see ss_ui.h)
+ *
+ * One mailbox carries a request from the window to the coordinator:
+ * g_ss_ui_pending = (op << 8) | (slot + 1), set with a compare-exchange from
+ * 0, so a second request while one waits is refused ("busy") instead of
+ * replacing it. ss_ui_service (ss_frame_tick, frame-clock thread) empties it
+ * and calls the engine, or the stub while there is none. s_inflight holds the
+ * request the engine accepted until ss_ui_complete.
+ */
+#include "ss_ui.h"
+#include "../platform/win32_compat.h"   /* Interlocked*, Sleep off Windows */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/stat.h>
+#ifdef _WIN32
+#  include <windows.h>
+#  define SS_UI_SEP '\\'
+#else
+#  include <limits.h>
+#  include <unistd.h>
+#  define SS_UI_SEP '/'
+#endif
+
+volatile long g_ss_ui_pending = 0;
+
+static volatile long   s_inflight;          /* seq the engine is working on; 0 none */
+static volatile long   s_inflight_op, s_inflight_slot;
+static volatile long   s_seq;
+static ss_ui_engine_fn s_engine;
+static void*           s_engine_user;
+static ss_ui_notice_fn s_sink;
+static void*           s_sink_user;
+static ss_ui_avail_fn  s_avail;
+static void*           s_avail_user;
+
+/* ---------------------------------------------------------------------------
+ * savestates.ini
+ * -----------------------------------------------------------------------*/
+#define SS_CFG_MAX 48
+static struct { char name[32]; char value[200]; } s_cfgv[SS_CFG_MAX];
+static int           s_ncfg;
+static char          s_cfg_file[300];
+static volatile long s_cfg_state;           /* 0 unread, 1 reading, 2 ready */
+
+/* One "name = value" (a line, or one '|' item): the name lower case without
+ * blanks, the value trimmed, a '#' comment after a blank cut off. Later
+ * lines replace earlier ones. */
+static void cfg_put(const char* s, size_t n)
+{
+    while (n && (*s == ' ' || *s == '\t')) { s++; n--; }
+    if (!n || *s == '#' || *s == ';' || *s == '[') return;
+    const char* eq = (const char*)memchr(s, '=', n);
+    if (!eq) return;
+    char name[32];
+    size_t k = 0;
+    for (const char* q = s; q < eq && k + 1 < sizeof name; q++)
+        if (*q != ' ' && *q != '\t') name[k++] = (char)((*q >= 'A' && *q <= 'Z') ? *q + 32 : *q);
+    name[k] = 0;
+    if (!k) return;
+    const char* v = eq + 1;
+    const char* e = s + n;
+    while (v < e && (*v == ' ' || *v == '\t')) v++;
+    for (const char* q = v; q < e; q++)                    /* "value   # comment" */
+        if (*q == '#' && (q == v || q[-1] == ' ' || q[-1] == '\t')) { e = q; break; }
+    while (e > v && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r')) e--;
+    int i = 0;
+    while (i < s_ncfg && strcmp(s_cfgv[i].name, name)) i++;
+    if (i == s_ncfg) {
+        if (s_ncfg >= SS_CFG_MAX) return;
+        s_ncfg++;
+    }
+    snprintf(s_cfgv[i].name, sizeof s_cfgv[i].name, "%s", name);
+    snprintf(s_cfgv[i].value, sizeof s_cfgv[i].value, "%.*s", (int)(e - v), v);
+}
+
+void ss_ui_cfg_parse(const char* text, int pipe_sep)
+{
+    if (!text) return;
+    if ((unsigned char)text[0] == 0xEF && (unsigned char)text[1] == 0xBB && (unsigned char)text[2] == 0xBF) text += 3;
+    while (*text) {
+        const char* e = text;
+        while (*e && *e != '\n' && !(pipe_sep && *e == '|')) e++;
+        cfg_put(text, (size_t)(e - text));
+        text = *e ? e + 1 : e;
+    }
+}
+
+static int cfg_read_file(const char* path)
+{
+    FILE* f = path && *path ? fopen(path, "rb") : NULL;
+    if (!f) return 0;
+    char* buf = (char*)malloc(65536);
+    size_t n = buf ? fread(buf, 1, 65535, f) : 0;
+    fclose(f);
+    if (!buf) return 0;
+    buf[n] = 0;
+    ss_ui_cfg_parse(buf, 0);
+    free(buf);
+#ifdef _WIN32
+    if (!GetFullPathNameA(path, (DWORD)sizeof s_cfg_file, s_cfg_file, NULL)) snprintf(s_cfg_file, sizeof s_cfg_file, "%s", path);
+#else
+    snprintf(s_cfg_file, sizeof s_cfg_file, "%s", path);
+#endif
+    return 1;
+}
+
+static void cfg_load(void)
+{
+    if (InterlockedCompareExchange(&s_cfg_state, 2, 2) == 2) return;
+    if (InterlockedCompareExchange(&s_cfg_state, 1, 0) != 0) {
+        while (InterlockedCompareExchange(&s_cfg_state, 2, 2) != 2) Sleep(1);
+        return;
+    }
+    const char* e = getenv("SAVESTATES_CONFIG");
+    int found = e && *e ? cfg_read_file(e) : 0;
+    if (!found) found = cfg_read_file("savestates.ini");
+#ifdef _WIN32
+    if (!found) found = cfg_read_file("config\\savestates.ini");
+    char exe[MAX_PATH + 40];
+    DWORD n = GetModuleFileNameA(NULL, exe, MAX_PATH);
+    char* sl = (n && n < MAX_PATH) ? strrchr(exe, '\\') : NULL;
+    if (!found && sl) {                                   /* next to the exe */
+        snprintf(sl + 1, sizeof exe - (size_t)(sl + 1 - exe), "savestates.ini");
+        found = cfg_read_file(exe);
+    }
+    if (!found && sl) {                                   /* <exe dir>\..\config */
+        *sl = 0;
+        char* up = strrchr(exe, '\\');
+        if (up) {
+            snprintf(up + 1, sizeof exe - (size_t)(up + 1 - exe), "config\\savestates.ini");
+            found = cfg_read_file(exe);
+        }
+    }
+#else
+    if (!found) found = cfg_read_file("config/savestates.ini");
+#endif
+    const char* o = getenv("SAVESTATES_CFG");
+    if (o && *o) ss_ui_cfg_parse(o, 1);
+    InterlockedExchange(&s_cfg_state, 2);
+}
+
+const char* ss_ui_cfg(const char* name)
+{
+    cfg_load();
+    for (int i = 0; name && i < s_ncfg; i++)
+        if (!strcmp(s_cfgv[i].name, name)) return s_cfgv[i].value;
+    return NULL;
+}
+
+int ss_ui_cfg_int(const char* name, int dflt)
+{
+    const char* v = ss_ui_cfg(name);
+    if (!v || !*v) return dflt;
+    if (!_stricmp(v, "on") || !_stricmp(v, "yes") || !_stricmp(v, "true")) return 1;
+    if (!_stricmp(v, "off") || !_stricmp(v, "no") || !_stricmp(v, "false")) return 0;
+    char* end;
+    const long x = strtol(v, &end, 0);
+    return end != v ? (int)x : dflt;
+}
+
+double ss_ui_cfg_num(const char* name, double dflt)
+{
+    const char* v = ss_ui_cfg(name);
+    if (!v || !*v) return dflt;
+    char* end;
+    const double x = strtod(v, &end);
+    return end != v ? x : dflt;
+}
+
+const char* ss_ui_cfg_file(void) { cfg_load(); return s_cfg_file; }
+
+int ss_ui_slot_count(void)
+{
+    const int n = ss_ui_cfg_int("slots", SS_UI_SLOTS);
+    return n < 1 ? 1 : n > SS_UI_SLOTS ? SS_UI_SLOTS : n;
+}
+
+/* ---------------------------------------------------------------------------
+ * Notices
+ * -----------------------------------------------------------------------*/
+void ss_ui_set_notice_sink(ss_ui_notice_fn fn, void* user)
+{
+    s_sink_user = user;
+    s_sink = fn;
+}
+
+void ss_ui_notify(unsigned ms, const char* fmt, ...)
+{
+    char text[200];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(text, sizeof text, fmt, ap);
+    va_end(ap);
+    printf("[ss-ui] notice: %s\n", text);
+    fflush(stdout);
+    ss_ui_notice_fn fn = s_sink;
+    if (fn) fn(text, ms ? ms : 2500, s_sink_user);
+}
+
+/* ---------------------------------------------------------------------------
+ * The folder and the slot files
+ * -----------------------------------------------------------------------*/
+static char          s_dir[300];
+static volatile long s_dir_state;           /* 0 unresolved, 1 resolving, 2 ready */
+
+/* s_dir = d made absolute, without a trailing separator (s_dir_state 1). */
+static void dir_resolve(const char* d)
+{
+#ifdef _WIN32
+    DWORD r = GetFullPathNameA(d, (DWORD)sizeof s_dir, s_dir, NULL);
+    if (!r || r >= sizeof s_dir) snprintf(s_dir, sizeof s_dir, "%s", d);
+#else
+    char cwd[PATH_MAX];
+    if (d[0] != '/' && getcwd(cwd, sizeof cwd)) snprintf(s_dir, sizeof s_dir, "%s/%s", cwd, d);
+    else snprintf(s_dir, sizeof s_dir, "%s", d);
+#endif
+    size_t n = strlen(s_dir);
+    while (n > 1 && (s_dir[n - 1] == '\\' || s_dir[n - 1] == '/') && !(n == 3 && s_dir[1] == ':'))
+        s_dir[--n] = 0;
+}
+
+const char* ss_ui_dir(void)
+{
+    if (InterlockedCompareExchange(&s_dir_state, 2, 2) == 2) return s_dir;
+    if (InterlockedCompareExchange(&s_dir_state, 1, 0) == 0) {
+        const char* e = getenv("SS_DIR");
+        dir_resolve((e && *e) ? e : "savestates");
+        InterlockedExchange(&s_dir_state, 2);
+        return s_dir;
+    }
+    while (InterlockedCompareExchange(&s_dir_state, 2, 2) != 2) Sleep(1);
+    return s_dir;
+}
+
+void ss_ui_set_dir(const char* dir)
+{
+    if (!dir || !*dir) return;
+    for (;;) {                                      /* take it from unresolved or ready */
+        if (InterlockedCompareExchange(&s_dir_state, 1, 0) == 0) break;
+        if (InterlockedCompareExchange(&s_dir_state, 1, 2) == 2) break;
+        Sleep(1);
+    }
+    dir_resolve(dir);
+    InterlockedExchange(&s_dir_state, 2);
+}
+
+static int is_dir(const char* p)
+{
+#ifdef _WIN32
+    DWORD a = GetFileAttributesA(p);
+    return a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY);
+#else
+    struct stat st;
+    return stat(p, &st) == 0 && S_ISDIR(st.st_mode);
+#endif
+}
+
+int ss_ui_ensure_dir(void)
+{
+    const char* d = ss_ui_dir();
+    if (is_dir(d)) return 1;
+    char p[sizeof s_dir];
+    snprintf(p, sizeof p, "%s", d);
+    for (size_t i = 1; ; i++) {                     /* every prefix, parents first */
+        const char c = p[i];
+        if (c != '\\' && c != '/' && c != 0) continue;
+        p[i] = 0;
+        if (!(i == 2 && p[1] == ':') && !is_dir(p)) {
+#ifdef _WIN32
+            CreateDirectoryA(p, NULL);
+#else
+            mkdir(p, 0777);
+#endif
+        }
+        p[i] = c;
+        if (!c) break;
+    }
+    return is_dir(d);
+}
+
+int ss_ui_slot_path(int slot, const char* ext, char* buf, unsigned n)
+{
+    if (slot < 0 || slot > SS_UI_UNDO || !buf || !n) return 0;
+    int w = slot == SS_UI_QUICK ? snprintf(buf, n, "%s%cquick%s", ss_ui_dir(), SS_UI_SEP, ext ? ext : "")
+          : slot == SS_UI_UNDO  ? snprintf(buf, n, "%s%cundo%s", ss_ui_dir(), SS_UI_SEP, ext ? ext : "")
+                                : snprintf(buf, n, "%s%cslot%d%s", ss_ui_dir(), SS_UI_SEP, slot, ext ? ext : "");
+    return w > 0 && (unsigned)w < n;
+}
+
+static int file_time(const char* path, long long* t)
+{
+#ifdef _WIN32
+    struct _stat64 st;
+    if (_stat64(path, &st) != 0) return 0;
+#else
+    struct stat st;
+    if (stat(path, &st) != 0) return 0;
+#endif
+    if (t) *t = (long long)st.st_mtime;
+    return 1;
+}
+
+/* Copy s into d (cap bytes): control characters become spaces, cut on a
+ * UTF-8 character boundary. */
+static void copy_clean(char* d, size_t cap, const char* s)
+{
+    size_t k = 0;
+    for (; *s && k + 1 < cap; s++) d[k++] = ((unsigned char)*s < 0x20 || *s == 0x7F) ? ' ' : *s;
+    if (((unsigned char)*s & 0xC0) == 0x80) {       /* cut inside a character: drop its start */
+        while (k > 0 && ((unsigned char)d[k - 1] & 0xC0) == 0x80) k--;
+        if (k > 0 && ((unsigned char)d[k - 1] & 0x80)) k--;
+    }
+    d[k] = 0;
+    while (k > 0 && d[k - 1] == ' ') d[--k] = 0;
+}
+
+int ss_ui_parse_meta(const char* text, ss_meta_fields* out)
+{
+    memset(out, 0, sizeof *out);
+    if (!text) return 0;
+    if ((unsigned char)text[0] == 0xEF && (unsigned char)text[1] == 0xBB && (unsigned char)text[2] == 0xBF)
+        text += 3;
+    int known = 0, junk = 0;
+    for (const char* p = text; *p; ) {
+        const char* e = p;
+        while (*e && *e != '\n') e++;
+        char line[256];
+        size_t n = (size_t)(e - p);
+        if (n >= sizeof line) n = sizeof line - 1;
+        memcpy(line, p, n);
+        line[n] = 0;
+        p = *e ? e + 1 : e;
+        char* s = line;
+        while (*s == ' ' || *s == '\t' || *s == '\r') s++;
+        size_t l = strlen(s);
+        while (l && (s[l - 1] == ' ' || s[l - 1] == '\t' || s[l - 1] == '\r')) s[--l] = 0;
+        if (!*s || *s == '#') continue;             /* '#' starts a comment only at the line start */
+        char* eq = strchr(s, '=');
+        if (!eq) { junk++; continue; }
+        *eq = 0;
+        char name[24];
+        size_t k = 0;
+        for (const char* q = s; *q && k + 1 < sizeof name; q++)
+            if (*q != ' ' && *q != '\t' && *q != '_' && *q != '-') name[k++] = (char)((*q >= 'A' && *q <= 'Z') ? *q + 32 : *q);
+        name[k] = 0;
+        char* v = eq + 1;
+        while (*v == ' ' || *v == '\t') v++;
+        if (!strcmp(name, "format")) { out->format = atoi(v); known++; }
+        else if (!strcmp(name, "time")) {
+            char* end;
+            long long t = strtoll(v, &end, 10);
+            if (end != v && t > 0) out->time = t;
+            known++;
+        }
+        else if (!strcmp(name, "note")) copy_clean(out->note, sizeof out->note, v);
+        else if (!strcmp(name, "data")) { copy_clean(out->data, sizeof out->data, v); known++; }
+        /* slot and anything newer: informational */
+    }
+    return junk == 0 || known > 0;
+}
+
+static long days_civil(int y, int m, int d)   /* y full year, m 1..12 (H. Hinnant) */
+{
+    y -= m <= 2;
+    const long era = (y >= 0 ? y : y - 399) / 400;
+    const unsigned yoe = (unsigned)(y - era * 400);
+    const unsigned doy = (153u * (unsigned)(m + (m > 2 ? -3 : 9)) + 2u) / 5u + (unsigned)d - 1u;
+    const unsigned doe = yoe * 365u + yoe / 4u - yoe / 100u + doy;
+    return era * 146097L + (long)doe;
+}
+
+void ss_ui_format_when(int y, int mon, int mday, int hour, int min,
+                       int now_y, int now_mon, int now_mday, char* buf, unsigned n)
+{
+    const long d = days_civil(now_y + 1900, now_mon + 1, now_mday) - days_civil(y + 1900, mon + 1, mday);
+    if (d == 0)      snprintf(buf, n, "today %02d:%02d", hour, min);
+    else if (d == 1) snprintf(buf, n, "yesterday %02d:%02d", hour, min);
+    else             snprintf(buf, n, "%04d-%02d-%02d %02d:%02d", y + 1900, mon + 1, mday, hour, min);
+}
+
+void ss_ui_format_label(ss_slot_info* in)
+{
+    char raw[240], name[24];
+    if (in->slot == SS_UI_QUICK) snprintf(name, sizeof name, "Quick slot");
+    else if (in->slot == SS_UI_UNDO) snprintf(name, sizeof name, "Undo last load");
+    else snprintf(name, sizeof name, "Slot %d", in->slot);
+    const char* why = in->reason[0] ? in->reason : in->damaged ? "damaged" : NULL;
+    const char* when = (in->time && in->when[0]) ? in->when : NULL;
+    if (in->used) {
+        if (!when) when = "saved";
+        if (in->note[0]) snprintf(raw, sizeof raw, "%s  -  %s  -  %s", name, when, in->note);
+        else snprintf(raw, sizeof raw, "%s  -  %s", name, when);
+        if (in->tag[0]) {
+            const size_t u = strlen(raw);
+            snprintf(raw + u, sizeof raw - u, "  (%s)", in->tag);
+        }
+    } else if (why) {
+        if (when) snprintf(raw, sizeof raw, "%s  -  %s  -  (%s)", name, when, why);
+        else snprintf(raw, sizeof raw, "%s  -  (%s)", name, why);
+    } else {
+        snprintf(raw, sizeof raw, "%s  -  (%s)", name, in->slot == SS_UI_UNDO ? "nothing to undo" : "empty");
+    }
+    size_t k = 0;                                   /* '&' would underline the next letter */
+    for (const char* s = raw; *s && k + 2 < sizeof in->label; s++) {
+        if (*s == '\t') { in->label[k++] = ' '; continue; }
+        if (*s == '&') in->label[k++] = '&';
+        in->label[k++] = *s;
+    }
+    in->label[k] = 0;
+}
+
+static void local_tm(long long t, struct tm* out)
+{
+    time_t tt = (time_t)t;
+#ifdef _WIN32
+    if (localtime_s(out, &tt) != 0) memset(out, 0, sizeof *out);
+#else
+    if (!localtime_r(&tt, out)) memset(out, 0, sizeof *out);
+#endif
+}
+
+static ss_ui_slot_reader_fn s_reader;
+static void*                s_reader_user;
+
+void ss_ui_set_slot_reader(ss_ui_slot_reader_fn fn, void* user)
+{
+    s_reader_user = user;
+    s_reader = fn;
+}
+
+/* <dir>\slotN.meta into used / damaged / time / note. */
+static void read_meta_file(ss_slot_info* in)
+{
+    char path[320];
+    if (!ss_ui_slot_path(in->slot, ".meta", path, sizeof path)) return;
+    FILE* f = fopen(path, "rb");
+    if (!f) return;                                 /* nothing there */
+    char text[4096];
+    size_t n = fread(text, 1, sizeof text - 1, f);
+    fclose(f);
+    text[n] = 0;
+    ss_meta_fields m;
+    if (!ss_ui_parse_meta(text, &m)) in->damaged = 1;
+    in->time = m.time;
+    if (!in->time) file_time(path, &in->time);
+    if (!in->damaged && m.data[0]) {
+        /* a plain file name in the same folder, nothing else */
+        if (strpbrk(m.data, "\\/:") || !strcmp(m.data, "..")) in->damaged = 1;
+        else {
+            char dp[400];
+            snprintf(dp, sizeof dp, "%s%c%s", ss_ui_dir(), SS_UI_SEP, m.data);
+            if (!file_time(dp, NULL)) in->damaged = 1;
+        }
+    }
+    in->used = !in->damaged;
+    snprintf(in->note, sizeof in->note, "%s", m.note);
+}
+
+int ss_ui_slot_info(int slot, ss_slot_info* in)
+{
+    memset(in, 0, sizeof *in);
+    in->slot = slot;
+    if (slot < 0 || slot > SS_UI_UNDO) { snprintf(in->label, sizeof in->label, "?"); return 0; }
+    ss_ui_slot_reader_fn rd = s_reader;
+    if (rd) {
+        rd(slot, in, s_reader_user);
+        in->slot = slot;
+        in->used = in->used ? 1 : 0;
+        in->note[sizeof in->note - 1] = 0;
+        in->reason[sizeof in->reason - 1] = 0;
+        in->tag[sizeof in->tag - 1] = 0;
+    } else {
+        read_meta_file(in);
+    }
+    if (in->used) in->reason[0] = 0;
+    else {
+        in->tag[0] = 0;
+        if (in->damaged && !in->reason[0]) snprintf(in->reason, sizeof in->reason, "damaged");
+    }
+    if (in->time) {
+        struct tm a, b;
+        local_tm(in->time, &a);
+        local_tm((long long)time(NULL), &b);
+        ss_ui_format_when(a.tm_year, a.tm_mon, a.tm_mday, a.tm_hour, a.tm_min,
+                          b.tm_year, b.tm_mon, b.tm_mday, in->when, sizeof in->when);
+    } else {
+        in->when[0] = 0;
+    }
+    ss_ui_format_label(in);
+    return in->used;
+}
+
+int ss_ui_write_meta(int slot, long long t, const char* note, const char* data_name)
+{
+    char path[320], tmp[340];
+    if (!ss_ui_ensure_dir() || !ss_ui_slot_path(slot, ".meta", path, sizeof path)) return 0;
+    snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return 0;
+    char nb[48] = "", db[64] = "";
+    if (note) copy_clean(nb, sizeof nb, note);
+    if (data_name) copy_clean(db, sizeof db, data_name);
+    int ok = fprintf(f, "# ps3recomp save state: written by the save-state engine after the state\n"
+                        "# file, read by the window menu (runtime/savestate/ss_ui.h)\n"
+                        "format = 1\nslot = %d\ntime = %lld\n", slot, t > 0 ? t : (long long)time(NULL)) > 0;
+    if (ok && nb[0]) ok = fprintf(f, "note = %s\n", nb) > 0;
+    if (ok && db[0]) ok = fprintf(f, "data = %s\n", db) > 0;
+    ok = (fclose(f) == 0) && ok;
+    if (!ok) { remove(tmp); return 0; }
+#ifdef _WIN32
+    if (!MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) { DeleteFileA(tmp); return 0; }
+#else
+    if (rename(tmp, path) != 0) { remove(tmp); return 0; }
+#endif
+    return 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Requests
+ * -----------------------------------------------------------------------*/
+static void slot_names(int slot, char* lower, char* upper, size_t n)
+{
+    if (slot == SS_UI_QUICK) { snprintf(lower, n, "the quick slot"); snprintf(upper, n, "The quick slot"); }
+    else if (slot == SS_UI_UNDO) { snprintf(lower, n, "the undo point"); snprintf(upper, n, "The undo point"); }
+    else { snprintf(lower, n, "slot %d", slot); snprintf(upper, n, "Slot %d", slot); }
+}
+
+int ss_ui_busy(void)
+{
+    return g_ss_ui_pending != 0 || s_inflight != 0;
+}
+
+void ss_ui_set_availability(ss_ui_avail_fn fn, void* user)
+{
+    s_avail_user = user;
+    s_avail = fn;
+}
+
+int ss_ui_available(int op, char* why, unsigned why_n)
+{
+    if (why && why_n) why[0] = 0;
+    ss_ui_avail_fn fn = s_avail;
+    if (!fn) return 1;
+    char b[160];
+    b[0] = 0;
+    const int ok = fn(op, b, sizeof b, s_avail_user) ? 1 : 0;
+    if (!ok && why && why_n) snprintf(why, why_n, "%s", b[0] ? b : "not available now");
+    return ok;
+}
+
+/* slot is 0..SS_UI_SLOTS, or SS_UI_UNDO for a load (ss_ui_request_undo) */
+static int request(int op, int slot)
+{
+    if (slot < 0 || slot > SS_UI_UNDO || (slot == SS_UI_UNDO && op != SS_UI_OP_LOAD)) return SS_UI_BAD_SLOT;
+    const int undo = slot == SS_UI_UNDO;
+    char lo[24], up[24];
+    slot_names(slot, lo, up, sizeof lo);
+    /* The engine's own rule first (design 3.2): the game not running yet,
+     * save states off, another save or load still working. */
+    if (s_engine && s_avail) {
+        char why[160];
+        if (!ss_ui_available(op, why, sizeof why)) {
+            if (op == SS_UI_OP_SAVE) ss_ui_notify(3000, "Cannot save now: %s", why);
+            else if (undo)           ss_ui_notify(3000, "Cannot undo the last load now: %s", why);
+            else                     ss_ui_notify(3000, "Cannot load now: %s", why);
+            return SS_UI_UNAVAILABLE;
+        }
+    }
+    /* Without an engine the stub answers every request ("not available
+     * yet"), so it is not refused here for an empty slot. */
+    if (op == SS_UI_OP_LOAD && s_engine) {
+        ss_slot_info in;
+        ss_ui_slot_info(slot, &in);
+        if (!in.used) {
+            if (in.damaged && !strcmp(in.reason, "damaged"))
+                ss_ui_notify(3000, "%s cannot be loaded: its files are damaged", up);
+            else if (in.reason[0]) ss_ui_notify(3000, "%s cannot be loaded: %s", up, in.reason);
+            else if (undo)         ss_ui_notify(2500, "There is no load to undo");
+            else                   ss_ui_notify(2500, "%s is empty", up);
+            return SS_UI_EMPTY;
+        }
+    }
+    const long code = ((long)op << 8) | (long)(slot + 1);
+    if (s_inflight || InterlockedCompareExchange(&g_ss_ui_pending, code, 0) != 0) {
+        ss_ui_notify(2500, "Busy: a save state is still in progress");
+        return SS_UI_BUSY;
+    }
+    printf("[ss-ui] %s %s requested: queued for the save-state coordinator\n",
+           op == SS_UI_OP_SAVE ? "save to" : "load of", lo);
+    fflush(stdout);
+    return SS_UI_QUEUED;
+}
+
+int ss_ui_request_save(int slot) { return request(SS_UI_OP_SAVE, slot == SS_UI_UNDO ? -1 : slot); }
+int ss_ui_request_load(int slot) { return request(SS_UI_OP_LOAD, slot == SS_UI_UNDO ? -1 : slot); }
+int ss_ui_request_undo(void)     { return request(SS_UI_OP_LOAD, SS_UI_UNDO); }
+
+void ss_ui_set_engine(ss_ui_engine_fn fn, void* user)
+{
+    s_engine_user = user;
+    s_engine = fn;
+}
+
+void ss_ui_service(unsigned flip_count)
+{
+    if (!g_ss_ui_pending) return;
+    /* One at a time. A request from another thread can land in the mailbox
+     * while the last one is being handed over (after the exchange below,
+     * before s_inflight is set): it waits there until the engine is done
+     * with the one in flight, instead of being started on top of it. */
+    if (s_inflight) return;
+    const long code = InterlockedExchange(&g_ss_ui_pending, 0);
+    if (!code) return;
+    ss_ui_request r;
+    memset(&r, 0, sizeof r);
+    r.op   = (int)(code >> 8);
+    r.slot = (int)(code & 0xFF) - 1;
+    r.seq  = (unsigned)InterlockedIncrement(&s_seq);
+    r.flip = flip_count;
+    ss_ui_slot_path(r.slot, ".meta", r.meta_path, sizeof r.meta_path);
+    ss_ui_slot_path(r.slot, ".state", r.data_path, sizeof r.data_path);
+    char lo[24], up[24];
+    slot_names(r.slot, lo, up, sizeof lo);
+    const int save = r.op == SS_UI_OP_SAVE;
+    ss_ui_engine_fn eng = s_engine;
+    if (!eng) {
+        printf("[ss-ui] %s %s at flip %u: this build has no save-state engine yet (milestones M4-M7)"
+               " -- nothing %s\n", save ? "save to" : "load of", lo, flip_count, save ? "saved" : "loaded");
+        ss_ui_notify(3000, "Save states are not available yet");
+        return;
+    }
+    InterlockedExchange(&s_inflight_op, r.op);
+    InterlockedExchange(&s_inflight_slot, r.slot);
+    InterlockedExchange(&s_inflight, (long)r.seq);
+    const int undo = r.slot == SS_UI_UNDO;
+    if (save)      ss_ui_notify(10000, "Saving to %s...", lo);
+    else if (undo) ss_ui_notify(10000, "Undoing the last load...");
+    else           ss_ui_notify(10000, "Loading %s...", lo);
+    char why[160];
+    why[0] = 0;
+    if (eng(&r, why, sizeof why, s_engine_user) != SS_UI_ENGINE_STARTED) {
+        if (InterlockedCompareExchange(&s_inflight, 0, (long)r.seq) == (long)r.seq) {
+            if (save)      ss_ui_notify(4000, "Cannot save to %s: %s", lo, why[0] ? why : "refused");
+            else if (undo) ss_ui_notify(4000, "Cannot undo the last load: %s", why[0] ? why : "refused");
+            else           ss_ui_notify(4000, "Cannot load %s: %s", lo, why[0] ? why : "refused");
+        }
+    }
+}
+
+void ss_ui_complete(unsigned seq, int ok, const char* msg) { ss_ui_complete_ms(seq, ok, msg, 0); }
+
+void ss_ui_complete_ms(unsigned seq, int ok, const char* msg, unsigned ms)
+{
+    const int op = (int)s_inflight_op, slot = (int)s_inflight_slot;
+    if (InterlockedCompareExchange(&s_inflight, 0, (long)seq) != (long)seq) {
+        printf("[ss-ui] completion of request %u, which is not the one in progress: ignored\n", seq);
+        fflush(stdout);
+        return;
+    }
+    char lo[24], up[24];
+    slot_names(slot, lo, up, sizeof lo);
+    const int undo = slot == SS_UI_UNDO;
+    if (ok) {
+        if (!ms) ms = 2500;
+        if (msg && *msg)         ss_ui_notify(ms, "%s", msg);
+        else if (op == SS_UI_OP_SAVE) ss_ui_notify(ms, "Saved to %s", lo);
+        else if (undo)           ss_ui_notify(ms, "Undid the last load");
+        else                     ss_ui_notify(ms, "Loaded %s", lo);
+    } else {
+        if (!ms) ms = 5000;
+        const char* m = msg && *msg ? msg : "unknown error";
+        if (op == SS_UI_OP_SAVE) ss_ui_notify(ms, "Save to %s failed: %s", lo, m);
+        else if (undo)           ss_ui_notify(ms, "Undo of the last load failed: %s", m);
+        else                     ss_ui_notify(ms, "Load of %s failed: %s", lo, m);
+    }
+}
diff --git a/runtime/savestate/ss_ui.h b/runtime/savestate/ss_ui.h
new file mode 100644
index 0000000..b095f7d
--- /dev/null
+++ b/runtime/savestate/ss_ui.h
@@ -0,0 +1,210 @@
+/*
+ * ps3recomp - save states: the user-facing side (menu, hotkeys, slot files)
+ *
+ * The window menu (libs/video/rsx_winmenu.c) and the hotkeys ask for a save or
+ * a load through this API; nothing here touches the guest. A request is only
+ * QUEUED: the save-state coordinator takes it at its next frame-clock step
+ * (ss_frame_tick in ss_core.c, on the frame-clock thread, outside the window
+ * procedure) and hands it to the engine: runtime/savestate/ss_slots.c (M5),
+ * which registers itself (ss_ui_set_engine, _set_slot_reader, _set_dir,
+ * _set_availability) and keeps its own files, slotNN.p3ss. With no engine
+ * registered a stub answers instead: one log line and a notice on screen
+ * ("Save states are not available yet"). Nothing is saved.
+ *
+ * SLOTS. 10 numbered slots (1..SS_UI_SLOTS) and the quick slot (0, F5 / F9),
+ * one file pair each in the save-state folder:
+ *   <dir>\slot3.meta   written LAST, when the state is complete (so a .meta
+ *   <dir>\slot3.state  means a usable slot); quick.meta / quick.state
+ * <dir> is SS_DIR (env) or ".\savestates" (resolved against the working
+ * directory at first use; tools\run.ps1 runs from the project root).
+ *
+ * .meta is text, "name = value" lines, '#' comments (ss_ui_write_meta writes
+ * it, atomically: a temporary file renamed over the old one):
+ *   format = 1
+ *   time   = 1792512191         seconds since 1970-01-01 UTC (the menu shows
+ *                               local time; missing: the file's own time)
+ *   note   = New Marais docks   optional, shown in the menu after the time
+ *   data   = slot3.state        optional: the state file; when named and
+ *                               missing the slot shows "(damaged)"
+ *
+ * The engine may keep its own files instead (ss_ui_set_slot_reader,
+ * ss_ui_set_dir): the menu only needs a time, a note and loadable or not.
+ *
+ * THREADS. Requests, slot info and the folder: the window thread (any thread
+ * is safe). ss_ui_service: the coordinator (frame-clock thread). The engine
+ * calls ss_ui_complete from any thread. Notices go to a sink (the window's
+ * notice box) that must be thread-safe.
+ * In this port the window thread IS the frame-clock thread (main.cpp's
+ * frame_clock creates and pumps the window), so "not on the UI thread" means:
+ * a request is taken at the frame clock's own step, outside DispatchMessage --
+ * never inside the window procedure that queued it -- and work longer than a
+ * frame (compression, file writes) belongs on the engine's worker threads.
+ * Inside a modal loop (a window drag) the step runs from the backend's modal
+ * timer, as the census already does.
+ */
+#ifndef PS3RECOMP_SS_UI_H
+#define PS3RECOMP_SS_UI_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SS_UI_SLOTS 10              /* numbered slots 1..10 */
+#define SS_UI_QUICK 0               /* the quick slot */
+/* The undo point (M7b, savestates.ini backup_before_load): the moment before
+ * the last load, kept by the engine in <dir>\undo.* -- loaded by "Undo last
+ * load" (ss_ui_request_undo), never saved to by the user. Its slot info and
+ * paths work like a slot's; ss_ui_request_save / _load refuse it. */
+#define SS_UI_UNDO  (SS_UI_SLOTS + 1)
+
+enum { SS_UI_OP_SAVE = 1, SS_UI_OP_LOAD = 2 };
+
+/* ss_ui_request_save / _load results */
+enum {
+    SS_UI_QUEUED   = 1,             /* taken: the coordinator runs it at its next step */
+    SS_UI_BUSY     = 0,             /* another request is queued or running (notice shown) */
+    SS_UI_BAD_SLOT = -1,
+    SS_UI_EMPTY    = -2,            /* load: nothing in that slot (notice shown) */
+    SS_UI_UNAVAILABLE = -3          /* the engine says not now (ss_ui_set_availability; notice shown) */
+};
+
+/* ---- UI side --------------------------------------------------------- */
+int ss_ui_request_save(int slot);
+int ss_ui_request_load(int slot);
+/* "Undo last load": a load of the undo point (SS_UI_UNDO), with the same
+ * rules as a slot's (SS_UI_EMPTY: "There is no load to undo"). */
+int ss_ui_request_undo(void);
+int ss_ui_busy(void);               /* a request is queued or the engine is on one */
+/* Whether a save (SS_UI_OP_SAVE) or a load (SS_UI_OP_LOAD) can be asked for
+ * now -- the engine's rule (design 3.2: not before the game's first frame,
+ * not while another save or load runs, not with save states off): 1, or 0
+ * with the reason in why ("available once the game is running"). With no
+ * availability hook (and no engine) always 1. The menu greys its items by
+ * it; a request it refuses shows the reason. */
+int ss_ui_available(int op, char* why, unsigned why_n);
+typedef int (*ss_ui_avail_fn)(int op, char* why, unsigned why_n, void* user);
+void ss_ui_set_availability(ss_ui_avail_fn fn, void* user);
+/* The numbered slots the menus list: savestates.ini `slots` (1..SS_UI_SLOTS,
+ * default SS_UI_SLOTS). */
+int ss_ui_slot_count(void);
+
+typedef struct ss_slot_info {
+    int       slot;                 /* 0 quick, 1..10, SS_UI_UNDO */
+    int       used;                 /* a complete state is there: it can be loaded */
+    int       damaged;              /* a .meta, but unreadable or its data file is missing */
+    long long time;                 /* when it was saved (seconds since 1970 UTC), 0 unknown */
+    char      when[32];             /* "today 14:03", "yesterday 21:40", "2026-10-18 09:12" */
+    char      note[48];             /* the engine's description, "" if none */
+    char      reason[48];           /* why a slot with something in it cannot be loaded
+                                     * ("damaged", "another build: layout changed"), "" if it can */
+    char      tag[24];              /* a loadable slot's warning ("older build"), "" if none */
+    char      label[136];           /* menu text, '&' doubled: "Slot 3  -  today 14:03" */
+} ss_slot_info;
+/* Reads <dir>\slotN.meta now (no cache: the menu calls it as it opens), or
+ * asks the engine's reader (ss_ui_set_slot_reader). Returns info->used. */
+int ss_ui_slot_info(int slot, ss_slot_info* info);
+/* The engine's own reader, in place of the .meta files (e.g. its state
+ * file's header): fill used, time, note and reason of *info (slot is set,
+ * the rest zero) and return info->used; ss_ui formats `when` and the label.
+ * Called on the window thread while a menu opens and for each load request:
+ * keep it quick and safe against the engine's writer. NULL: the .meta files. */
+typedef int (*ss_ui_slot_reader_fn)(int slot, ss_slot_info* info, void* user);
+void ss_ui_set_slot_reader(ss_ui_slot_reader_fn fn, void* user);
+
+const char* ss_ui_dir(void);        /* the save-state folder (absolute) */
+int ss_ui_ensure_dir(void);         /* create it if missing; 1 = it exists */
+/* Another folder than SS_DIR / .\savestates (a relative one resolves against
+ * the working directory now). Call it before the window opens (ss_init). */
+void ss_ui_set_dir(const char* dir);
+/* "<dir>\slot3<ext>" ("quick<ext>" for slot 0, "undo<ext>" for SS_UI_UNDO).
+ * Returns 0 if it does not fit. */
+int ss_ui_slot_path(int slot, const char* ext, char* buf, unsigned n);
+
+/* ---- notices ("toasts") ------------------------------------------------ */
+/* A short line on screen for `ms` milliseconds (and in the log). */
+void ss_ui_notify(unsigned ms, const char* fmt, ...)
+#if defined(__GNUC__) || defined(__clang__)
+    __attribute__((format(printf, 2, 3)))
+#endif
+    ;
+typedef void (*ss_ui_notice_fn)(const char* text, unsigned ms, void* user);
+void ss_ui_set_notice_sink(ss_ui_notice_fn fn, void* user);
+
+/* ---- coordinator side -------------------------------------------------- */
+/* Non-zero while a request waits for the coordinator. main.cpp's frame clock
+ * calls ss_frame_tick when this or g_ss_armed is set. */
+extern volatile long g_ss_ui_pending;
+/* ss_frame_tick's first step: hand a queued request to the engine (or the
+ * stub). Cheap when nothing is queued. */
+void ss_ui_service(unsigned flip_count);
+
+/* ---- engine side (M4-M7) ----------------------------------------------- */
+typedef struct ss_ui_request {
+    int      op;                    /* SS_UI_OP_SAVE / SS_UI_OP_LOAD */
+    int      slot;                  /* 0 quick, 1..10 */
+    unsigned seq;                   /* pass to ss_ui_complete */
+    unsigned flip;                  /* the flip count at the hand-over */
+    char     meta_path[300];        /* <dir>\slotN.meta */
+    char     data_path[300];        /* <dir>\slotN.state */
+} ss_ui_request;
+enum { SS_UI_ENGINE_REFUSED = 0, SS_UI_ENGINE_STARTED = 1 };
+/* Runs on the coordinator's thread from ss_frame_tick: start the work (a
+ * stop at the next flip, ...) and return STARTED, then call ss_ui_complete
+ * exactly once when done; or return REFUSED with a reason in why (shown to the
+ * user). Do not block the frame clock for long here: it is also the window's
+ * message pump (a write of hundreds of MB belongs on a worker thread). */
+typedef int (*ss_ui_engine_fn)(const ss_ui_request* req, char* why, unsigned why_n, void* user);
+void ss_ui_set_engine(ss_ui_engine_fn fn, void* user);
+/* The engine is done with request seq: ok, or a reason (msg) it failed. On
+ * success a non-empty msg is the notice itself ("Saved slot 3 (14:32)"),
+ * else "Saved to slot 3" / "Loaded slot 3". _ms: the notice stays that long
+ * (0: the usual 2.5 s for a success, 5 s for a failure). */
+void ss_ui_complete(unsigned seq, int ok, const char* msg);
+void ss_ui_complete_ms(unsigned seq, int ok, const char* msg, unsigned ms);
+/* Write <dir>\slotN.meta (after the data file is complete). time 0 = now.
+ * note / data may be NULL. Returns 1 on success. */
+int ss_ui_write_meta(int slot, long long time, const char* note, const char* data_name);
+
+/* ---- savestates.ini (engine design 3.3) --------------------------------- */
+/* The save-state settings: "name = value" lines, '#' comments (also after a
+ * value), found through SAVESTATES_CONFIG, then .\savestates.ini, then
+ * .\config\savestates.ini, then next to the exe and in <exe dir>\..\config
+ * (a double-clicked exe starts in build\); SAVESTATES_CFG="k=v|k=v"
+ * overrides lines. Read once, on first use (any thread). Names are lower
+ * case ("give_up_s"); NULL when not set. */
+const char* ss_ui_cfg(const char* name);
+int         ss_ui_cfg_int(const char* name, int dflt);
+double      ss_ui_cfg_num(const char* name, double dflt);
+const char* ss_ui_cfg_file(void);   /* the file read, "" if none */
+/* Parse text into the settings (tests; sep '|' for the override string). */
+void        ss_ui_cfg_parse(const char* text, int pipe_sep);
+
+/* ---- pure helpers (tests) ---------------------------------------------- */
+typedef struct ss_meta_fields {
+    int       format;
+    long long time;                 /* 0: none */
+    char      note[48];
+    char      data[64];
+} ss_meta_fields;
+/* Parse .meta text; returns 1 if it is one (a "format", "time" or "data"
+ * line or an empty file of comments counts: the engine writes the meta last). */
+int  ss_ui_parse_meta(const char* text, ss_meta_fields* out);
+/* "today 14:03" / "yesterday 21:40" / "2026-10-18 09:12" from broken-down
+ * local times (struct tm fields: year-1900, mon 0-11, mday, hour, min). */
+void ss_ui_format_when(int y, int mon, int mday, int hour, int min,
+                       int now_y, int now_mon, int now_mday, char* buf, unsigned n);
+/* The menu label for a slot info whose used/damaged/time/when/note/reason/
+ * tag are set:
+ *   "Slot 3  -  today 14:03[  -  note][  (tag)]" loadable
+ *   "Slot 3  -  today 14:03  -  (reason)"       something there, not loadable
+ *   "Slot 3  -  (empty)"                        nothing there
+ * damaged with no reason reads "(damaged)"; no time leaves the time out.
+ * The undo point reads "Undo last load  -  ..." ("(nothing to undo)" when
+ * empty). */
+void ss_ui_format_label(ss_slot_info* info);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_SS_UI_H */
diff --git a/runtime/savestate/tests/ss_test_world.inc b/runtime/savestate/tests/ss_test_world.inc
new file mode 100644
index 0000000..5746feb
--- /dev/null
+++ b/runtime/savestate/tests/ss_test_world.inc
@@ -0,0 +1,427 @@
+/*
+ * ss_test_world.inc -- the world test_ss_roundtrip.cpp and test_ss_resumers.cpp
+ * share (save states M4c). Both run guest threads on the REAL runtime, linked
+ * as the game links it:
+ *   runtime/syscalls/sys_{semaphore,event,mutex,cond,timer,ppu_thread}.c  the
+ *       lv2 kernel objects, the PPU thread table (PPUT's capture / teardown /
+ *       restore, resume-mode thread creation)
+ *   runtime/ppu/ppu_sysprx.cpp   lwmutex / lwcond / spinlock / net HLE, the
+ *       KOBJ and KMEM sections, the lwcond resumers
+ *   runtime/savestate/ss_{core,state,ui}.c   the coordinator, the image, TIME,
+ *       MAPS and GMEM
+ * and the PPU resume path, #included here: runtime/ppu/ppu_resume.cpp and
+ * ppu_selfresume.cpp (the strict walk, the re-issue / resumer runs).
+ *
+ * This file stands in for the game's loader: a 4 GB guest arena with a main
+ * memory and a stack region committed (vm_init's layout, smaller), the
+ * lv2_syscall / ps3_hle_call entries with their S1 / S2 safepoints (as
+ * ppu_loader.cpp / ppu_hle.cpp have them), the HLE registry ppu_sysprx_register
+ * fills, the thread entry trampoline, a frame clock that ticks the coordinator,
+ * a fake walker that is always idle, and inert stand-ins for the libraries the
+ * linked files call into that the tests do not link (gcm, SPU, diagnostics).
+ *
+ * GUEST CODE. A test thread runs a hand-written guest function in the lifter's
+ * shape (runtime/ppu/tests/test_cont_resume.cpp): a 0x80-byte frame, its back
+ * chain at r1, the caller's LR at r1+0x90 (the caller frame's LR slot),
+ * callee-saved r28..r31 at r1+0x60..0x78; every call site's return address
+ * has a continuation -- the same function entered at that label -- so a
+ * parked thread resumes from its guest stack alone. Syscalls go through G_SC,
+ * a generic `sc` stub with its own 0x80-byte frame (r11 = the call), HLE
+ * calls through an import stub (frameless: the call site's own LR is the
+ * first return address). Code addresses are labels in zeroed guest memory, so
+ * the walk's call-at-ra-4 check has nothing to read; state that lives across
+ * a call is in r28..r31 or in guest memory, never in host locals.
+ */
+#define _CRT_SECURE_NO_WARNINGS 1
