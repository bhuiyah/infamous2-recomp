+      tp_slot sU; memset(&sU, 0, sizeof sU);
+      tp_rt_identify(&sU, 1, &dA, g2 + oU, oU, 0, 0, 102, s_tp.frame, 1);
+      CHECK((sU.flags & TP_F_UNIFORM) && (sU.flags & TP_F_NOREPLACE) && sU.rep == NULL);
+      /* UN: the same bytes as A, never replaced */
+      tp_slot sN; memset(&sN, 0, sizeof sN); const tp_desc dN = { 0x86u | 0x40u, 64, 64, 7, 0, 0 };
+      tp_rt_identify(&sN, 1, &dN, g2 + oN, oN, 0, 0, 102, s_tp.frame, 1);
+      CHECK((sN.flags & TP_F_NOREPLACE) && sN.rep == NULL);
+      /* written by an RSX copy just now: never replaced */
+      tp_rt_note_rsx_write(oR + 16, 64);
+      tp_slot sR; memset(&sR, 0, sizeof sR);
+      tp_rt_identify(&sR, 1, &dA, g2 + oR, oR, 0, 0, 103, s_tp.frame, 1);
+      CHECK((sR.flags & TP_F_RSXMADE) && sR.rep == NULL);
+      /* changing content at one key: dynamic after the second change, still looked up */
+      tp_slot sD; memset(&sD, 0, sizeof sD); static uint8_t dyn[0x8000];
+      memcpy(dyn, g2 + oB, (size_t)LA.guest_span);
+      tp_rt_identify(&sD, 1, &dA, dyn, 0x30000, 0, 0, 104, s_tp.frame, 1);
