+#!/usr/bin/env python3
+"""tools/ss_census.py --strict (save-state engine M4a-0): the strict-pass check
+over a census chains file, on synthetic stops.
+
+  * engine lines ("  strict ..."): a stop passes only if every parked thread's
+    walk is ok, its park kind has a resumer, it is outside a callback / libsre
+    bridge, there is no straggler, and every SPU is at a drain hop or an
+    audited host-wait pc; the uncovered return addresses are tallied and
+    written per image (libsre_ vs the EBOOT);
+  * an older chains file (no strict lines) judged from the lifter's
+    continuation reports (--cont): no-ra for a syscall with sc_ra 0 (the
+    unrelifted libsre), a chain that ends at a continuation that never
+    returns, a missing return address.
+Run: py -3 tools/test_ss_census.py
+"""
+import os
+import subprocess
+import sys
+import tempfile
+
+TOOL = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ss_census.py")
+FAILS = []
+
+
+def check(cond, msg):
+    if not cond:
+        FAILS.append(msg)
+        print("FAIL:", msg)
+
+
+SPU_OK = ("spu tid=0x2000 group=0x1000 kind=lifted parked where=ch-wait ms=1.0 pc=0x01178 img=41 depth=1 "
+          "status=0x0 irq=0 resv=1 foreign=0\n"
+          "spu tid=0x2006 group=0x1001 kind=lifted parked where=stop-receive ms=1.0 pc=0x0FA08 img=2 depth=1 "
+          "status=0x0 irq=0 resv=0 foreign=0\n")
+SPU_ODD = ("spu tid=0x2000 group=0x1000 kind=lifted parked where=ch-wait ms=1.0 pc=0x01234 img=41 depth=1 "
+           "status=0x0 irq=0 resv=1 foreign=0\n")
+
+
+def thread(tid, name, at, ra0, frames, strict=None, br=0, cb=0, sc_ra=0):
+    s = (f'thread tid={tid} name="{name}" tier=1 at={at} ms=1.00 cb={cb} br={br} icall=0 vcall=0 '
+         f"r1=0xD0008DA0 r2=0x30039AB0 lr=0x00000000 sc_ra=0x{sc_ra:08X}\n"
+         f"  ra0 ra=0x{ra0:08X} 0x{ra0:08X} link=sc\n")
+    for k, ra in enumerate(frames):
+        s += f"  frame {k} sp=0xD0008DA0 ra=0x{ra:08X} 0x{ra:08X} link=?\n"
+    s += f"  end root depth={len(frames)}\n"
+    if strict:
+        s += f"  strict {strict}\n"
+    return s
+
+
+def stop(n, body, spu=SPU_OK, extra=""):
+    return f"census {n} t={n * 5}.000 status=ok ppu_ms=1.0 spu_ms=1.0 walker_ms=0 stop_ms=30 threads=2\n" \
+           + body + extra + spu + f"end census {n}\n"
+
+
+def run(args):
+    r = subprocess.run([sys.executable, "-B", TOOL] + args, capture_output=True, text=True)
+    return r.returncode, r.stdout + r.stderr
+
+
+def main():
+    with tempfile.TemporaryDirectory() as d:
+        # ---- engine verdicts ------------------------------------------------
+        ok_main = thread(1, "main", "wait:usleep:0xA", 0x003374F4, [0x001DB7DC, 0], "ok frames=2 end=lr rec=1")
+        ok_spurs = thread(2, "SpursHdlr1", "wait:equeue:0x1", 0x3000B608, [0], "ok frames=1 end=lr rec=1")
+        miss_spurs = thread(2, "SpursHdlr1", "wait:equeue:0x1", 0x3000B700, [0],
+                            "not-covered:missing frames=1 end=none rec=1 at=0x3000B700 missing=0x3000B700")
+        miss_game = thread(1, "main", "wait:usleep:0xA", 0x00400004, [0],
+                           "not-covered:missing frames=2 end=none rec=1 at=0x00400004 missing=0x00400004,0x00500008")
+        stops = [stop(i, ok_main + ok_spurs) for i in range(1, 18)]           # 17 good stops
+        stops.append(stop(18, ok_main + miss_spurs))                           # a libsre gap
+        stops.append(stop(19, miss_game + ok_spurs))                           # an EBOOT gap
+        stops.append(stop(20, ok_main + ok_spurs, spu=SPU_ODD))               # an unaudited SPU pc
+        stops.append(stop(21, ok_main + thread(2, "SpursHdlr1", "wait:equeue:0x1", 0x3000B608, [0],
+                                               "ok frames=1 end=lr rec=1", br=1)))   # inside a bridge
+        stops.append(stop(22, ok_main, extra='straggler tid=2 name="SpursHdlr1" sc=0 hle=- prof_pc=0x0 '
+                                             'visits=0 refused=- host=\n'))
+        ch = os.path.join(d, "chains.txt")
+        open(ch, "w").write("# synthetic\n" + "".join(stops))
+        miss = os.path.join(d, "missing.txt")
+        rc, out = run(["--chains", ch, "--strict", "--missing", miss])
+        print(out)
+        check("17/22 converged stops" in out, "engine: 17 of 22 stops pass")
+        check(rc == 1, "engine: 77% < 95% fails the verdict")
+        check("0x3000B700 libsre" in out and "0x00400004 eboot" in out and "0x00500008 eboot" in out,
+              "engine: uncovered return addresses tallied per image")
+        check("bridge x1" in out and "straggler x1" in out and "spu x1" in out, "engine: blockers named")
+        txt = open(miss).read()
+        check(txt.index("0x3000B700") < txt.index("EBOOT") < txt.index("0x00400004"),
+              "engine: --missing groups libsre first, then the EBOOT")
+        rc, out = run(["--chains", ch, "--strict", "--strict-min", "0.75"])
+        check(rc == 0, "engine: --strict-min 0.75 passes 77%")
+
+        # ---- an older chains file, judged from the cont reports --------------
+        old = [stop(1, thread(1, "main", "wait:usleep:0xA", 0x003374F4, [0x001DB7DC, 0]) +
+                    thread(3, "SpursHdlr0", "wait:spu_join:0x1000", 0, [0])),     # no sc_ra: unrelifted
+               stop(2, thread(1, "main", "wait:usleep:0xA", 0x003374F4, [0x001DB7DC, 0]) +
+                    thread(3, "SpursHdlr0", "wait:spu_join:0x1000", 0x30009490, [0x12345678, 0]))]
+        och = os.path.join(d, "old.txt")
+        open(och, "w").write("".join(old))
+        rc, out = run(["--chains", och, "--strict"])
+        check(rc == 1 and "pass --cont reports" in out, "old file without --cont: refuses to guess")
+        main_rep = os.path.join(d, "main_cont.txt")
+        open(main_rep, "w").write("# --cont-list report (main image)\n"
+                                  "0x003374F4  func_003374BC+0x38  after sc  returns r1=sp+0x0 lr=[sp+0x10]\n"
+                                  "0x001DB7DC  func_001DB544+0x298  after bl 0x003374BC  returns r1=sp+0x90 lr=[sp+0xa0]\n")
+        lib_rep = os.path.join(d, "lib_cont.txt")
+        open(lib_rep, "w").write("# --cont-list report (libsre_ image)\n"
+                                 "0x30009490  libsre_func_3000930C+0x184  after sc  never returns\n")
+        rc, out = run(["--chains", och, "--strict", "--cont", main_rep, "--cont", lib_rep])
+        print(out)
+        check("1/2 converged stops" in out, "old file: the relifted stop passes (never returns ends the chain)")
+        check("no-ra x1" in out, "old file: the unrelifted SpursHdlr is no-ra")
+    print("PASS" if not FAILS else f"{len(FAILS)} FAILED")
+    return 1 if FAILS else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
