+/* The tokens in an lwcond's host semaphore, up to cap: drained, counted,
+ * given back. */
+static long lwc_ss_tokens(HANDLE s, long cap)
+{
+    long n = 0;
+    while (s && n < cap && WaitForSingleObject(s, 0) == WAIT_OBJECT_0) n++;
+    if (n) ReleaseSemaphore(s, n, NULL);
+    return n;
