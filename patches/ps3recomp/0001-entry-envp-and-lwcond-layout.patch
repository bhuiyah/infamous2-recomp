+static void test_mouse_stop(void)
+{
+    KbmConfig c;
+    kbm_config_defaults(&c);                           /* 50 ms window */
+    KbmRuntime rt;
+    KbmOut o;
+    kbm_runtime_reset(&rt);
+    keys_clear();
+    double t = 0.0;
+    kbm_eval(&c, &rt, fake_down, NULL, t, 0, 0, 0, &o);
+    for (int i = 0; i < 10; i++) { t += 16.0; kbm_eval(&c, &rt, fake_down, NULL, t, 20, 0, 0, &o); }
+    CHECK(kbm_axis_u8(o.rx) > 200);
+    double stop = t;
+    int centred_at = -1;
+    for (int i = 0; i < 20; i++) {
+        t += 16.0;
+        kbm_eval(&c, &rt, fake_down, NULL, t, 0, 0, 0, &o);
+        if (centred_at < 0 && kbm_axis_u8(o.rx) == 128) centred_at = (int)(t - stop);
+        if (centred_at >= 0) CHECK_EQ(kbm_axis_u8(o.rx), 128);   /* and stays there */
+    }
+    /* back to centre exactly one window after the last motion */
+    CHECK(centred_at >= 50 && centred_at <= 50 + 16);
+    CHECK(!o.r_active);
+}
