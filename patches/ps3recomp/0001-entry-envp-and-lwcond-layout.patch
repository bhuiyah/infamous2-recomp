+static void test_unresponsive_and_simple(void)
+{
+    PadHostDevice d;
+    fake_reset();
+    F.mute = 1;
+    dev_init(&d, PADHOST_BUS_BT, 3);
+    unsigned long long t0 = g_now;
+    CHECK_EQ(padhost_drv_switchpro.open(&d), 0);
+    SwPriv* p = sw_priv(&d);
+    /* device info 3 tries, factory sticks 3 tries, then one try for the other 8 */
+    CHECK_EQ(count_writes(0x01), 14);
+    CHECK(g_now - t0 < 5000);
+    CHECK_EQ(p->unresponsive, 1);
+    CHECK_EQ(p->mode_set, 0);
+    CHECK_EQ(p->imu_on, 0);
+    CHECK_EQ(p->sent_port, SW_PORT_UNSENT);
+    CHECK_STR(d.serial, "");                   /* no device info: the host's serial stays */
+    CHECK_EQ(p->stick[0][0].center, SW_STICK_CENTER);
+    CHECK(strstr(p->cal_src, "default/default") != NULL);
+
+    PadHostPortState st;
+    memset(&st, 0, sizeof st);
+    u8 r[64];
+    memset(r, 0, sizeof r);
+    r[0] = 0x3F;
+    r[1] = 0x01 /* B */ | 0x40 /* ZL */;
+    r[2] = 0x02 /* + */ | 0x10 /* HOME */;
+    r[3] = 0x02;                                /* hat right */
+    put_le16(r + 4, 0x8000); put_le16(r + 6, 0x8000);
+    put_le16(r + 8, 0xC000); put_le16(r + 10, 0x4000);
+    CHECK_EQ(padhost_drv_switchpro.parse(&d, r, 12, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_L2 | CELL_PAD_CTRL_START | CELL_PAD_CTRL_RIGHT);
+    CHECK_EQ(st.ps, 1);
+    CHECK_EQ(st.lx, 128); CHECK_EQ(st.ly, 128);
+    CHECK_EQ(st.rx, 255); CHECK_EQ(st.ry, 0);   /* half span reaches full at first ... */
+    CHECK_EQ(st.has_motion, 0);
+    CHECK_EQ(st.sensor_y, 399);                 /* neutral SIXAXIS defaults */
+    CHECK_EQ(st.battery, 255);
+    put_le16(r + 8, 0xFFFF);                    /* ... and widens to what the stick reaches */
+    padhost_drv_switchpro.parse(&d, r, 12, &st);
+    CHECK_EQ(st.rx, 255);
+    put_le16(r + 8, 0xC000);
+    padhost_drv_switchpro.parse(&d, r, 12, &st);
+    CHECK_EQ(st.rx, 192);
+    r[3] = 0x08;                                /* hat centred */
+    r[3 - 2] = 0x00;
+    padhost_drv_switchpro.parse(&d, r, 12, &st);
+    CHECK_EQ(st.buttons & (CELL_PAD_CTRL_UP | CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_LEFT | CELL_PAD_CTRL_RIGHT), 0);
+    r[3] = 0x07;                                /* up-left */
+    padhost_drv_switchpro.parse(&d, r, 12, &st);
+    CHECK_EQ(st.buttons & 0xF0, CELL_PAD_CTRL_UP | CELL_PAD_CTRL_LEFT);
+    /* lights go out with the first output once the pad's port is known */
+    u8 out[128];
+    g_now += 1000;
+    int n = padhost_drv_switchpro.build_output(&d, 0, 0, 3, out, sizeof out);
+    CHECK_EQ(n, 49);
+    CHECK_EQ(out[10], 0x30);
+    CHECK_EQ(out[11], 0x08);
+}
+
