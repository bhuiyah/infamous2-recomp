+/* ---- VRAW_PROBE=1: the CPU cost of GPU-side vertex fetch, measured in game ----
+ * Diagnostic only: the frame renders exactly as before. For every VCOMPACT
+ * entry the render thread ALSO runs the CPU half of a vertex-pulling path
+ * (the GPU would decode the raw big-endian attributes in the VS):
+ *   - indexed: the guest indices byte-swapped to u32 into a write-combined
+ *     scratch ring with their min/max (QUADS / TRIANGLE_FAN also expanded to
+ *     a list); non-indexed: nothing (the draw uses its vertex start);
+ *   - every array attribute the VS reads: its guest byte range for vertices
+ *     [lo, hi] (attributes interleaved in one buffer merged) copied raw into
+ *     the ring.
+ * Both paths are timed with the TSC; which runs first alternates by frame,
+ * so each is measured cold (first: guest lines not yet in cache) and warm.
+ * Every ~2 s:
+ *   [VRAW] N frames | per frame: vemit cold X ms warm Y | raw cold X warm Y |
+ *          entries, indices, raw MB, ranges skipped | prims T/S/F/Q/other */
+#include <intrin.h>
+#if defined(__SSE4_1__)
+#include <smmintrin.h>
+#endif
+static int vraw_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("VRAW_PROBE"); v = (e && *e != '0') ? 1 : 0; }
+    return v;
+}
+static struct {
+    u8* ring; u64 off, cap;
+    double tsc_ms;
+    u64 t[2][2];            /* [0 vemit, 1 raw][0 cold (first), 1 warm (second)] */
+    u64 fr[2];              /* frames by parity in the window */
+    u64 ent, idx, bytes, skipped, prim[11], win_t0;
+    u32 last_fc, frames;
+    u32 tmp[0x10000];
+} s_vr;
+static void vr_copy(const u8* s, u64 n)
+{
+    if (s_vr.off + n + 64u > s_vr.cap) s_vr.off = 0;
+    u8* d = s_vr.ring + s_vr.off;
+    u64 i = 0;
+#if defined(__SSE4_1__)
+    for (; i + 64u <= n; i += 64u) {
+        const __m128i a = _mm_loadu_si128((const __m128i*)(s + i)),      b = _mm_loadu_si128((const __m128i*)(s + i + 16));
+        const __m128i c = _mm_loadu_si128((const __m128i*)(s + i + 32)), e = _mm_loadu_si128((const __m128i*)(s + i + 48));
+        _mm_stream_si128((__m128i*)(d + i), a);      _mm_stream_si128((__m128i*)(d + i + 16), b);
+        _mm_stream_si128((__m128i*)(d + i + 32), c); _mm_stream_si128((__m128i*)(d + i + 48), e);
+    }
+#endif
+    if (i < n) memcpy(d + i, s + i, (size_t)(n - i));
+    s_vr.off = (s_vr.off + n + 255u) & ~(u64)255u;
+    s_vr.bytes += n;
