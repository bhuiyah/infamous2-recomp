+static void tc_copy_desc(u32 heap_slot, SIZE_T src_ptr)
+{
+    /* A per-draw window slot already holding the null view (s_win_null) is
+     * not copied onto again: the copy would write the same bytes. */
+    const u32 w = heap_slot - (u32)DRAW_SRV_BASE;
+    if (w < (u32)(MAX_DRAWS * RSX_DRAW_TEX_UNITS)) {
+        const u8 nul = src_ptr == s_tc.cpu_base;
+        if (nul && s_win_null[w]) return;
+        s_win_null[w] = nul;
+    }
+    D3D12_CPU_DESCRIPTOR_HANDLE dst, src;
+    dst.ptr = s_tc.vis_base + (SIZE_T)heap_slot * s_d3d.srv_inc;
+    src.ptr = src_ptr;
+    rth_desc(1, dst.ptr, (const void*)src.ptr, NULL, 0);   /* RT_STREAM_LOG */
+    s_d3d.device->lpVtbl->CopyDescriptorsSimple(s_d3d.device, 1, dst, src,
+                                                D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+}
+
+static void tc_slot_forget_views(VPTexSlot* t)
+{
+    for (int k = 0; k < TC_DESC_VARIANTS; k++) t->dv[k].res = NULL;
+}
+
+/* --- key map ----------------------------------------------------------- */
+/* The level count and the pitch share the hash's "levels" input (a pitch is
+ * rare: LINEAR textures only); the chain compare tells keys apart. */
+#define TC_KLV(kmips, kpitch) ((kmips) ^ ((kpitch) << 4))
+static int tc_map_find(u32 key, u32 w, u32 h, u32 fmt, int cube, u32 kmips, u32 kpitch)
+{
+    for (int i = s_tc.map[tc_key_hash(key, w, h, fmt, cube, TC_KLV(kmips, kpitch))]; i; ) {
+        const VPTexSlot* c = &s_d3d.vp_tex[i - 1];
+        if (c->key == key && c->w == w && c->h == h && c->fmt == fmt &&
+            c->cube == cube && c->kmips == kmips && c->kpitch == kpitch)
+            return i - 1;
+        i = c->hnext;
+    }
+    return -1;
+}
+static void tc_map_insert(int slot)
+{
+    VPTexSlot* t = &s_d3d.vp_tex[slot];
+    const u32 b = tc_key_hash(t->key, t->w, t->h, t->fmt, t->cube, TC_KLV(t->kmips, t->kpitch));
+    t->hnext = s_tc.map[b];
+    s_tc.map[b] = slot + 1;
+    t->mapped = 1;
+}
+static void tc_map_remove(int slot)
+{
+    VPTexSlot* t = &s_d3d.vp_tex[slot];
+    if (!t->mapped) return;
+    int* link = &s_tc.map[tc_key_hash(t->key, t->w, t->h, t->fmt, t->cube, TC_KLV(t->kmips, t->kpitch))];
+    while (*link && *link != slot + 1) link = &s_d3d.vp_tex[*link - 1].hnext;
+    if (*link) *link = t->hnext;
+    t->hnext = 0;
+    t->mapped = 0;
+}
+
+/* Rebuild the harvest bounds from the live spans once something untracked. */
+static void tc_rebuild_bounds(void)
+{
+    tc_wt_bounds_clear();
+    for (int i = 0; i < VP_TEX_SLOTS; i++)
+        if (s_d3d.vp_tex[i].trk_len) tc_wt_bounds_span(s_d3d.vp_tex[i].trk_off, s_d3d.vp_tex[i].trk_len);
+}
+
+/* Register [off, off+span) for the slot before its bytes are read. */
+static void tc_slot_track(VPTexSlot* t, u32 off, u32 span)
+{
+    if (t->trk_len && (t->trk_off != off || t->trk_len != span)) {
+        tc_wt_untrack(t->trk_off, t->trk_len);
+        t->trk_len = 0;
+    }
+    if (!t->trk_len && span) {
+        tc_wt_track(off, span);
+        t->trk_off = off; t->trk_len = span;
+    }
+}
+
+/* Take a slot out of the cache (an upload into it failed part-way): it is no
+ * longer found by key and reads nothing. Its resource, if any, is kept. */
+static void tc_drop(int slot)
+{
+    VPTexSlot* t = &s_d3d.vp_tex[slot];
+    tc_map_remove(slot);
+    if (t->trk_len) { tc_wt_untrack(t->trk_off, t->trk_len); t->trk_len = 0; }
+}
+
+/* A slot for a texture not in the map: an unused one, else the least
+ * recently bound one not bound in this batch. -1 when every slot is. */
+static int tc_alloc_slot(u32 w, u32 h, DXGI_FORMAT dxfmt, int cube, u32 nlv)
+{
+    int lru = -1, same = -1, kept = -1;
+    for (int i = 0; i < VP_TEX_SLOTS; i++) {
+        const VPTexSlot* c = &s_d3d.vp_tex[i];
+        if (!c->mapped) return i;
+        if (c->use_batch == s_tc.batch) continue;
+        /* TX1 TEX_FENCE: a slot this batch's fence copied, watches or hashed
+         * is kept for the record that samples it (taken only if nothing else
+         * is free: counted) */
+        if (tc_fz_protected(&s_tc.fz, (u32)i, s_tc.batch)) {
+            if (kept < 0 || c->use_batch < s_d3d.vp_tex[kept].use_batch) kept = i;
+            continue;
+        }
+        if (lru < 0 || c->use_batch < s_d3d.vp_tex[lru].use_batch) lru = i;
+        if (c->res && c->rw == w && c->rh == h && c->rfmt == dxfmt && c->rcube == cube &&
+            c->rmips == nlv &&
+            (same < 0 || c->use_batch < s_d3d.vp_tex[same].use_batch)) same = i;
+    }
+    if (lru < 0) {
+        if (kept < 0) return -1;
+        lru = kept; s_tc.st_fz_evict++;
+    }
+    /* Same shape and unbound for ~5 guest frames (30 batches): reuse its
+     * resource rather than release one and create another (a committed
+     * texture costs ~0.25-0.35 ms to create). Streaming new textures into a
+     * full cache otherwise re-creates on most misses. A texture idle that long
+     * is not in the current frame's working set; while the cache only cycles
+     * through one frame's textures no slot is that idle and LRU decides. */
+    const int v = (same >= 0 && s_d3d.vp_tex[same].use_batch + 30u <= s_tc.batch) ? same : lru;
+    VPTexSlot* t = &s_d3d.vp_tex[v];
+    tc_map_remove(v);
+    if (t->trk_len) { tc_wt_untrack(t->trk_off, t->trk_len); t->trk_len = 0; }
+    tc_fz_forget(&s_tc.fz, (u32)v);
+    s_tc.st_evict++;
+    return v;
+}
+
+/* ST1 TEX_UPCHUNK (default 1; TEX_UPCHUNK=0: a buffer of its own per texture,
+ * as before). A batch whose uploads outgrow the ring -- the first frame after
+ * a load: ~670 new textures, 83 MB, into a 16 MB ring -- made one committed
+ * upload buffer per texture (~300 of them, 90-170 ms of that frame in the ST1
+ * census). Overflows now share TC_UPCHUNK-byte chunks (a larger texture gets
+ * a chunk of its size), sub-allocated 512-aligned like the ring and released
+ * with the other overflow buffers at the next batch. A texture's bytes and its
+ * copy are the same; only the buffer and offset they are copied from differ. */
+#define TC_UPCHUNK (32ull << 20)
+static int tc_upchunk_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("TEX_UPCHUNK"); on = (e && *e == '0') ? 0 : 1; }
+    return on;
+}
+
+/* Upload memory for one texture: the ring if it fits, else a buffer of its
+ * own that is released at the next batch (the GPU is idle by then). */
+/* TEX_FAULT_UPLOAD=<n> / TEX_FAULT_CHUNK=<n> (ST1 diagnostics, the low-memory
+ * test): every n-th upload allocation fails as if no upload memory could be
+ * had, or every n-th 32 MB upload chunk is refused as if its creation had
+ * failed. Off (0) by default. */
+static int tc_fault(int which)
+{
+    static int n[2] = { -1, -1 };
+    static u64 c[2];
+    if (n[which] < 0) {
+        const char* e = getenv(which ? "TEX_FAULT_CHUNK" : "TEX_FAULT_UPLOAD");
+        n[which] = e ? atoi(e) : 0;
+        if (n[which] < 0) n[which] = 0;
+    }
+    if (n[which] <= 0 || ++c[which] % (u64)n[which]) return 0;
+    if (!which) s_tc.st_fault++;                 /* (a refused chunk is counted as one: st_ckfall) */
+    return 1;
+}
+static u8* tc_upload_alloc(u64 bytes, ID3D12Resource** res, u64* off)
+{
+    s_tc.ring_want += bytes + 512u;
+    if (tc_fault(0)) return NULL;
+    D3D12_HEAP_PROPERTIES hu = {0}; hu.Type = D3D12_HEAP_TYPE_UPLOAD;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    D3D12_RANGE nr = {0, 0};
+    if (!s_tc.ring) {
+        bd.Width = s_tc.ring_size;
+        void* m = NULL;
+        const double _fub0 = FTR_T0();
+        FTR_INC(upb_n);
+        if (SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hu,
+                D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                &IID_ID3D12Resource, (void**)&s_tc.ring))) {
+            if (FAILED(s_tc.ring->lpVtbl->Map(s_tc.ring, 0, &nr, &m)) || !m) {
+                s_tc.ring->lpVtbl->Release(s_tc.ring); s_tc.ring = NULL;
+            } else s_tc.ring_map = (u8*)m;
+        } else s_tc.ring = NULL;
+        s_tc.ring_off = 0;
+        FTR_ADD(upb, _fub0);
+    }
+    const u64 a = (s_tc.ring_off + 511u) & ~511ull;   /* placement alignment */
+    if (s_tc.ring && a + bytes <= s_tc.ring_size) {
+        s_tc.ring_off = a + bytes;
+        *res = s_tc.ring; *off = a;
+        return s_tc.ring_map + a;
+    }
+    s_tc.st_overflow++;
+    if (tc_upchunk_on() && s_tc.ck && ((s_tc.ck_off + 511u) & ~511ull) + bytes <= s_tc.ck_size) {
+        const u64 a2 = (s_tc.ck_off + 511u) & ~511ull;   /* ST1 TEX_UPCHUNK: the open chunk */
+        s_tc.ck_off = a2 + bytes;
+        *res = s_tc.ck; *off = a2;
+        return s_tc.ck_map + a2;
+    }
+    if (s_tc.ntmp == s_tc.captmp) {
+        const int nc = s_tc.captmp ? s_tc.captmp * 2 : 64;
+        ID3D12Resource** nt = (ID3D12Resource**)realloc(s_tc.tmp, (size_t)nc * sizeof *nt);
+        if (!nt) return NULL;
+        s_tc.tmp = nt; s_tc.captmp = nc;
+    }
+    ID3D12Resource* b = NULL; void* m = NULL;
+    /* ST1 TEX_UPCHUNK: a 32 MB chunk; when it cannot be had (low memory), a
+     * buffer of the texture's own size as before, which is not made the open
+     * chunk. TEX_UPCHUNK=0: that buffer only, exactly as before. */
+    int chunk = tc_upchunk_on();
+    if (chunk && bytes < TC_UPCHUNK && tc_fault(1)) { chunk = 0; s_tc.st_ckfall++; }
+    const double _fub1 = FTR_T0();
+    for (;;) {
+        bd.Width = chunk && bytes < TC_UPCHUNK ? TC_UPCHUNK : bytes;
+        FTR_INC(upb_n);
+        b = NULL; m = NULL;
+        if (SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hu,
+                D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                &IID_ID3D12Resource, (void**)&b)) && b) {
+            if (SUCCEEDED(b->lpVtbl->Map(b, 0, &nr, &m)) && m) break;
+            b->lpVtbl->Release(b);
+        }
+        if (!chunk || bd.Width == bytes) return NULL;   /* the texture's own size failed too: as before */
+        chunk = 0; s_tc.st_ckfall++;
+    }
+    FTR_ADD(upb, _fub1);
+    s_tc.tmp[s_tc.ntmp++] = b;
+    if (chunk) { s_tc.ck = b; s_tc.ck_map = (u8*)m; s_tc.ck_size = bd.Width; s_tc.ck_off = bytes; }
+    *res = b; *off = 0;
+    return (u8*)m;
+}
+
+/* ---------------------------------------------------------------------------
+ * ST1 (review): the process's local video memory, read with
+ * IDXGIAdapter3::QueryVideoMemoryInfo -- the use, its high-water mark and the
+ * budget the OS gives the process -- sampled every 60 texture batches, before
+ * a batch's overflow upload buffers are released, and when TEX_PLACED wants a
+ * heap; [VRAM] when the high-water mark moved (at most every 10 s) and at
+ * shutdown. TEX_PLACED_BUDGET_MB=<n> (diagnostic): the budget is taken as n
+ * MB (the low-memory path on a large GPU). Observation only: what it reads
+ * changes nothing that is drawn.
+ * -----------------------------------------------------------------------*/
+static struct { int on; IDXGIAdapter3* a; u64 use, hw, budget, ovr, hw_said; double t_said; } s_vram = { -1 };
+static int vram_on(void)
+{
+    if (s_vram.on >= 0) return s_vram.on;
+    s_vram.on = 0;
+    if (!s_d3d.device) return 0;
+    { const char* b = getenv("TEX_PLACED_BUDGET_MB"); if (b && *b && atoi(b) > 0) s_vram.ovr = (u64)atoi(b) << 20; }
+    LUID luid;
+    s_d3d.device->lpVtbl->GetAdapterLuid(s_d3d.device, &luid);   /* (the C binding returns the struct through a pointer) */
+    IDXGIFactory4* f4 = NULL;
+    if (SUCCEEDED(CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&f4)) && f4) {
+        if (SUCCEEDED(f4->lpVtbl->EnumAdapterByLuid(f4, luid, &IID_IDXGIAdapter3, (void**)&s_vram.a)) && s_vram.a)
+            s_vram.on = 1;
+        f4->lpVtbl->Release(f4);
+    }
+    return s_vram.on;
+}
+/* Local video memory now: 1 and *use, *budget (bytes); 0 when unknown. */
+static int vram_sample(u64* use, u64* budget)
+{
+    if (s_vram.on != 1) return 0;
+    DXGI_QUERY_VIDEO_MEMORY_INFO mi;
+    memset(&mi, 0, sizeof mi);
+    if (FAILED(s_vram.a->lpVtbl->QueryVideoMemoryInfo(s_vram.a, 0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &mi))) return 0;
+    s_vram.use = mi.CurrentUsage;
+    s_vram.budget = s_vram.ovr ? s_vram.ovr : mi.Budget;
+    if (mi.CurrentUsage > s_vram.hw) s_vram.hw = mi.CurrentUsage;
+    if (use) *use = mi.CurrentUsage;
+    if (budget) *budget = s_vram.budget;
+    return 1;
+}
+static void vram_say(const char* when)
+{
+    fprintf(stderr, "[VRAM] %s: local video memory %.0f MB in use, high-water %.0f MB, budget %.0f MB%s%c", when,
+            (double)s_vram.use / 1048576.0, (double)s_vram.hw / 1048576.0, (double)s_vram.budget / 1048576.0,
+            s_vram.ovr ? " (TEX_PLACED_BUDGET_MB)" : "", 10);
+    s_vram.hw_said = s_vram.hw;
+}
+static void vram_tick(void)
+{
+    if (!vram_sample(NULL, NULL) || s_vram.hw == s_vram.hw_said) return;
+    LARGE_INTEGER f, c; QueryPerformanceFrequency(&f); QueryPerformanceCounter(&c);
+    const double t = (double)c.QuadPart / (double)f.QuadPart;
+    if (t - s_vram.t_said < 10.0) return;
+    s_vram.t_said = t;
+    vram_say("high-water moved");
+}
+static void vram_shutdown(void)
+{
+    if (vram_sample(NULL, NULL)) vram_say("shutdown");
+    if (s_vram.a) s_vram.a->lpVtbl->Release(s_vram.a);
+    memset(&s_vram, 0, sizeof s_vram);
+    s_vram.on = -1;
+}
+
+/* ---------------------------------------------------------------------------
+ * ST1 TEX_PLACED (default 1; TEX_PLACED=0: every guest texture a committed
+ * resource of its own, exactly as before).
+ * A committed texture costs ~0.23 ms to create -- a kernel allocation of its
+ * own, zeroed and mapped -- and the textures that come into view together are
+ * created in the same frame: when the street walk turns into a pan, 14-45 new
+ * ones a frame made 3-11 ms of 23-43 ms frames (the ST1 census, FRAME_TRACE
+ * tex_create_ms). Here a texture of up to TPH_MAX_RES bytes is a placed
+ * resource in one of a set of 32 MB default heaps (ALLOW_ONLY_NON_RT_DS_
+ * TEXTURES), sub-allocated first fit from each heap's offset-sorted free
+ * ranges (coalesced on free), at the 4 KB small-resource alignment when the
+ * driver grants it for the description, else 64 KB.
+ * Exact: the resource has the description the committed one had (format,
+ * size, levels, array size, layout, flags); vp_upload_tex_slot writes every
+ * subresource (faces x levels) from the upload buffer before any draw samples
+ * it -- the rule the reuse of a slot's resource already depends on -- so
+ * what the memory held before is never read; its SRV is made the same way. A
+ * placed resource is activated with an aliasing barrier (tph_activate)
+ * recorded right before its first copy, once its upload memory was found:
+ * a resource given up before that was never named by the command list. A
+ * block is freed when its slot's resource is released, which happens only in
+ * a texture prepass for a slot not bound in this batch, after render_frame
+ * waited for the GPU: nothing in flight or already recorded uses it. A fresh
+ * resource given up in the batch that made it (no upload memory: tph_bury)
+ * goes to the resource graveyard and its block to a deferred list given back
+ * at the next batch's start, after the GPU wait -- never reused in its batch.
+ * Heaps are made ahead on a helper thread (TPH_SPARES kept), so the walker
+ * makes one itself only when a burst (a load) uses the spares up; a heap that
+ * cannot be made, a texture over TPH_MAX_RES, or a failed placement takes the
+ * committed path. Video memory (s_vram): a heap -- a spare or not -- is made
+ * only while the process's local use stays TPH_MARGIN under its budget (else
+ * the texture is committed: its own size, nothing reserved); at a batch start
+ * (the GPU idle) a heap nothing is placed in any more is released after
+ * TPH_IDLE_BATCHES batches empty (one empty heap kept), and at once, with the
+ * spares, while the use is over the budget. [TEXPLACED] while textures are
+ * made: every 30 s, and when a heap is added (counts, heaps, bytes used, free
+ * ranges, video memory).
+ * TEX_PLACED_VERIFY=1 (diagnostic, the oracle): every upload into a placed
+ * texture is copied back after its copy and, once the GPU finished the batch,
+ * compared row by row with the bytes uploaded ([TEXPLACED] verify: textures,
+ * subresources, bytes, differing); off it costs nothing.
+ * -----------------------------------------------------------------------*/
+#define TPH_HEAP_BYTES (32ull << 20)
+#define TPH_HEAPS_MAX  128               /* 4 GB at most; past that: committed */
+#define TPH_MAX_RES    (8ull << 20)      /* a larger texture stays committed */
+#define TPH_SPARES     2                 /* heaps the helper keeps made ahead */
+#define TPH_MARGIN     (96ull << 20)     /* local video memory kept free under the budget */
+#define TPH_IDLE_BATCHES 600u            /* an empty heap is released after this many batches (~10 s) */
+#include "rsx_tex_heap.h"                /* TphHeap: a heap's free ranges, tph_take / tph_give, TphDefer (unit-tested) */
+typedef struct {                         /* TEX_PLACED_VERIFY: one upload to compare */
+    ID3D12Resource* rb;                  /* [0, half): the texture copied back; [half, 2 half): the bytes uploaded */
+    u64 half;
+    u32 nsub;
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp[6u * RSX_MAX_TEXTURE_LEVELS];
+    u32 rows[6u * RSX_MAX_TEXTURE_LEVELS], rowb[6u * RSX_MAX_TEXTURE_LEVELS];
+} TphVer;
+static struct {
+    int on;                              /* -1 unknown, 0 off, 1 on */
+    int verify;
+    TphHeap h[TPH_HEAPS_MAX]; int nh;    /* a released heap leaves a hole (heap NULL), filled first */
+    u32 empty_since[TPH_HEAPS_MAX];      /* the batch a heap was first seen empty (0: in use) */
+    ID3D12Heap* volatile spare[TPH_SPARES];
+    HANDLE ev, th;                       /* wakes the helper; the helper (joined at shutdown) */
+    volatile LONG stop;
+    ID3D12Device* dev;                   /* the helper's (AddRef'd; released at shutdown) */
+    TphDefer dfr;                        /* blocks given back at the next batch's start */
+    u64 st_placed, st_committed, st_big, st_ahead, st_sync, st_fail, st_freed, st_deferred, st_released, st_budget;
+    double t_last;
+    TphVer* ver; int nver, capver;       /* this batch's uploads to compare */
+    u64 v_tex, v_sub, v_bytes, v_diff, v_difftex;
+} s_tph = { -1 };
+
+static ID3D12Heap* tph_make_heap(ID3D12Device* dev)
+{
+    D3D12_HEAP_DESC hd;
+    memset(&hd, 0, sizeof hd);
+    hd.SizeInBytes = TPH_HEAP_BYTES;
+    hd.Properties.Type = D3D12_HEAP_TYPE_DEFAULT;
+    hd.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+    hd.Flags = D3D12_HEAP_FLAG_ALLOW_ONLY_NON_RT_DS_TEXTURES;
+    ID3D12Heap* h = NULL;
+    if (FAILED(dev->lpVtbl->CreateHeap(dev, &hd, &IID_ID3D12Heap, (void**)&h))) return NULL;
+    return h;
+}
+/* Room under the video-memory budget for n more heaps, TPH_MARGIN kept free; 1 when the budget is unknown. */
+static int tph_room(int n)
+{
+    u64 use, bud;
+    if (!vram_sample(&use, &bud) || !bud) return 1;
+    return use + (u64)n * TPH_HEAP_BYTES + TPH_MARGIN <= bud;
+}
+/* The helper: keeps TPH_SPARES heaps made ahead while the budget has room (below-normal priority, any core). */
+static DWORD WINAPI tph_helper(LPVOID arg)
+{
+    (void)arg;
+    ps3_host_unplace_thread();
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    for (;;) {
+        WaitForSingleObject(s_tph.ev, INFINITE);
+        if (s_tph.stop) break;
+        for (int i = 0; i < TPH_SPARES; i++) {
+            if (s_tph.spare[i] || s_tph.nh + TPH_SPARES >= TPH_HEAPS_MAX) continue;
+            if (!tph_room(2)) break;                       /* (a spare only with room for one more besides) */
+            ID3D12Heap* h = tph_make_heap(s_tph.dev);
+            if (!h) break;
+            if (InterlockedCompareExchangePointer((PVOID volatile*)&s_tph.spare[i], h, NULL) != NULL)
+                h->lpVtbl->Release(h);
+        }
+    }
+    return 0;
+}
+static int tph_on(void)
+{
+    if (s_tph.on >= 0) return s_tph.on == 1 && s_tph.dev == s_d3d.device;   /* (another device: off) */
+    s_tph.on = 0;
+    const char* e = getenv("TEX_PLACED");
+    if ((e && *e == '0') || !s_d3d.device) return 0;
+    { const char* v = getenv("TEX_PLACED_VERIFY"); s_tph.verify = v && *v && *v != '0'; }
+    (void)vram_on();                                       /* (before the helper reads the budget) */
+    s_tph.ev = CreateEventA(NULL, FALSE, TRUE, NULL);      /* auto-reset, set: the first spares now */
+    if (!s_tph.ev) return 0;
+    s_tph.dev = s_d3d.device;
+    s_tph.dev->lpVtbl->AddRef(s_tph.dev);                  /* the helper's: released at shutdown */
+    s_tph.th = CreateThread(NULL, 0, tph_helper, NULL, 0, NULL);
+    s_tph.on = 1;
+    u64 use = 0, bud = 0;
+    (void)vram_sample(&use, &bud);
+    printf("[TEXPLACED] guest textures are placed in %llu MB heaps (TEX_PLACED=0: committed); local video memory"
+           " %.0f MB in use, budget %.0f MB%s\n", (unsigned long long)(TPH_HEAP_BYTES >> 20), (double)use / 1048576.0,
+           (double)bud / 1048576.0, s_tph.verify ? "; TEX_PLACED_VERIFY on" : "");
+    return 1;
+}
+/* A new heap: a spare the helper made, else one made here while the budget has room; into the first hole,
+ * else at the end. Its index, or -1. */
+static int tph_add_heap(void)
+{
+    int at = -1;
+    for (int i = 0; i < s_tph.nh && at < 0; i++) if (!s_tph.h[i].heap) at = i;
+    if (at < 0 && s_tph.nh >= TPH_HEAPS_MAX) return -1;
+    ID3D12Heap* h = NULL;
+    for (int i = 0; i < TPH_SPARES && !h; i++)
+        h = (ID3D12Heap*)InterlockedExchangePointer((PVOID volatile*)&s_tph.spare[i], NULL);
+    if (h) s_tph.st_ahead++;
+    else if (!tph_room(1)) { s_tph.st_budget++; return -1; }
+    else if ((h = tph_make_heap(s_d3d.device)) != NULL) s_tph.st_sync++;
+    if (!h) return -1;
+    const int i = at >= 0 ? at : s_tph.nh;
+    if (!tph_heap_init(&s_tph.h[i], h, TPH_HEAP_BYTES)) { h->lpVtbl->Release(h); return -1; }
+    s_tph.empty_since[i] = 0;
+    if (at < 0) s_tph.nh++;
+    SetEvent(s_tph.ev);                                   /* the helper makes the next spare */
+    return i;
+}
+/* Give a block back to heap hi (a failure to grow its range list loses the block to the pool: counted). */
+static void tph_free(int hi, u64 off, u64 len)
+{
+    if (tph_give(&s_tph.h[hi], off, len)) s_tph.st_freed++;
+    else s_tph.st_fail++;
+}
+/* A texture resource for td (COPY_DEST): placed (S_OK, *ph = heap + 1, its
+ * block) or S_FALSE -- the caller creates it committed. No barrier here:
+ * tph_activate records it before the first copy. */
+static HRESULT tph_create(D3D12_RESOURCE_DESC* td, ID3D12Resource** out, int* ph, u64* poff, u64* plen)
+{
+    *ph = 0; *poff = 0; *plen = 0;
+    if (!tph_on()) return S_FALSE;
+    D3D12_RESOURCE_ALLOCATION_INFO ai;
+    D3D12_RESOURCE_DESC d = *td;
+    d.Alignment = D3D12_SMALL_RESOURCE_PLACEMENT_ALIGNMENT;
+    s_d3d.device->lpVtbl->GetResourceAllocationInfo(s_d3d.device, &ai, 0, 1, &d);
+    if (ai.Alignment != D3D12_SMALL_RESOURCE_PLACEMENT_ALIGNMENT) {
+        d.Alignment = 0;
+        s_d3d.device->lpVtbl->GetResourceAllocationInfo(s_d3d.device, &ai, 0, 1, &d);
+    }
+    if (ai.SizeInBytes == UINT64_MAX || !ai.SizeInBytes || !ai.Alignment ||
+        ai.Alignment > D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT) { s_tph.st_fail++; return S_FALSE; }
+    const u64 size = (ai.SizeInBytes + 4095u) & ~4095ull;
+    if (size > TPH_MAX_RES) { s_tph.st_big++; s_tph.st_committed++; return S_FALSE; }
+    int hi = -1; u64 off = 0;
+    for (int i = 0; i < s_tph.nh && hi < 0; i++)
+        if (s_tph.h[i].heap && TPH_HEAP_BYTES - s_tph.h[i].used >= size &&
+            tph_take(&s_tph.h[i], size, ai.Alignment, &off)) hi = i;
+    if (hi < 0) { const int a = tph_add_heap(); if (a >= 0 && tph_take(&s_tph.h[a], size, ai.Alignment, &off)) hi = a; }
+    if (hi < 0) { s_tph.st_committed++; return S_FALSE; }
+    ID3D12Resource* r = NULL;
+    if (FAILED(s_d3d.device->lpVtbl->CreatePlacedResource(s_d3d.device, (ID3D12Heap*)s_tph.h[hi].heap, off, &d,
+               D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&r)) || !r) {
+        tph_free(hi, off, size);
+        s_tph.st_fail++; s_tph.st_committed++;
+        return S_FALSE;
+    }
+    *out = r; *ph = hi + 1; *poff = off; *plen = size;
+    s_tph.st_placed++;
+    return S_OK;
+}
+/* A fresh placed resource, right before its first copy: activated with an aliasing barrier (the memory may
+ * have held another texture, whose work is done). */
+static void tph_activate(ID3D12Resource* r)
+{
+    D3D12_RESOURCE_BARRIER b;
+    memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_ALIASING;
+    b.Aliasing.pResourceBefore = NULL;
+    b.Aliasing.pResourceAfter = r;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+}
+/* Release a slot's texture resource (GPU idle for it: see above) and its block. */
+static void tph_release(VPTexSlot* t)
+{
+    if (t->res) t->res->lpVtbl->Release(t->res);
+    t->res = NULL;
+    if (t->ph > 0 && t->ph <= s_tph.nh) tph_free(t->ph - 1, t->poff, t->plen);
+    t->ph = 0; t->poff = 0; t->plen = 0;
+}
+/* A slot's fresh resource given up in the batch that made it: released after the next GPU wait (the resource
+ * graveyard), its block given back at the next batch's start (tph_drain) -- nothing in this batch reuses it. */
+static void tph_bury(VPTexSlot* t)
+{
+    res_grave_put(t->res);
+    t->res = NULL;
+    if (t->ph > 0 && t->ph <= s_tph.nh) {
+        if (tph_defer_put(&s_tph.dfr, t->ph - 1, t->poff, t->plen)) s_tph.st_deferred++;
+        else s_tph.st_fail++;                              /* (no memory for the list: the block stays taken) */
+    }
+    t->ph = 0; t->poff = 0; t->plen = 0;
+}
+/* A batch's start (the GPU idle): the deferred blocks back to their heaps. */
+static void tph_drain(void)
+{
+    int lost = 0;
+    s_tph.st_freed += (u64)tph_defer_drain(&s_tph.dfr, s_tph.h, &lost);
+    s_tph.st_fail += (u64)lost;
+}
+/* A batch's start (the GPU idle): heaps nothing is placed in any more are released after TPH_IDLE_BATCHES
+ * empty, one kept; over the budget, every empty heap and the spares at once (the budget looked at every 60
+ * batches, or when a second empty heap appears). */
+static void tph_trim(void)
+{
+    if (s_tph.on != 1) return;
+    int nempty = 0;
+    for (int i = 0; i < s_tph.nh; i++) {
+        if (!s_tph.h[i].heap) continue;
+        if (s_tph.h[i].used) { s_tph.empty_since[i] = 0; continue; }
+        if (!s_tph.empty_since[i]) s_tph.empty_since[i] = s_tc.batch ? s_tc.batch : 1u;
+        nempty++;
+    }
+    if (nempty <= 1 && s_tc.batch % 60u) return;
+    const int over = !tph_room(0);
+    if (over)
+        for (int i = 0; i < TPH_SPARES; i++) {
+            ID3D12Heap* h = (ID3D12Heap*)InterlockedExchangePointer((PVOID volatile*)&s_tph.spare[i], NULL);
+            if (h) { h->lpVtbl->Release(h); s_tph.st_released++; }
+        }
+    int keep = over ? 0 : 1;                               /* one empty heap stays for the next burst */
+    for (int i = 0; i < s_tph.nh && nempty; i++) {
+        TphHeap* H = &s_tph.h[i];
+        if (!H->heap || H->used) continue;
+        if (keep) { keep = 0; continue; }
+        if (!over && s_tc.batch - s_tph.empty_since[i] < TPH_IDLE_BATCHES) continue;
+        ((ID3D12Heap*)H->heap)->lpVtbl->Release((ID3D12Heap*)H->heap);
+        tph_heap_clear(H);
+        s_tph.empty_since[i] = 0;
+        s_tph.st_released++;
+    }
+}
+/* Shutdown (the GPU idle): the helper stopped and joined; the slots' textures, the buried resources, the
+ * spares and the heaps released; a later init starts from nothing. */
+static void tph_shutdown(void)
+{
+    if (s_tph.on == 1) {
+        s_tph.stop = 1;
+        SetEvent(s_tph.ev);
+        if (s_tph.th && WaitForSingleObject(s_tph.th, 10000) != WAIT_OBJECT_0) {
+            fprintf(stderr, "[TEXPLACED] shutdown: the heap helper did not stop; the heaps are left as they are%c", 10);
+            return;
+        }
+        for (int i = 0; i < VP_TEX_SLOTS; i++) if (s_d3d.vp_tex[i].res) tph_release(&s_d3d.vp_tex[i]);
+        res_grave_drain();                                 /* the buried ones, before their heaps go */
+        for (int i = 0; i < s_tph.nver; i++) if (s_tph.ver[i].rb) s_tph.ver[i].rb->lpVtbl->Release(s_tph.ver[i].rb);
+        for (int i = 0; i < TPH_SPARES; i++) if (s_tph.spare[i]) s_tph.spare[i]->lpVtbl->Release(s_tph.spare[i]);
+        for (int i = 0; i < s_tph.nh; i++) {
+            if (s_tph.h[i].heap) ((ID3D12Heap*)s_tph.h[i].heap)->lpVtbl->Release((ID3D12Heap*)s_tph.h[i].heap);
+            free(s_tph.h[i].fr);
+        }
+        if (s_tph.dev) s_tph.dev->lpVtbl->Release(s_tph.dev);
+    }
+    if (s_tph.th) CloseHandle(s_tph.th);
+    if (s_tph.ev) CloseHandle(s_tph.ev);
+    free(s_tph.dfr.p); free(s_tph.ver);
+    memset(&s_tph, 0, sizeof s_tph);
+    s_tph.on = -1;
+}
+/* [TEXPLACED] when textures were made since: at most every 30 s, or at once
+ * when a heap was added or released. */
+static void tph_report(void)
+{
+    if (s_tph.on != 1) return;
+    static u64 last_n, last_rel;
+    static int last_nh;
+    const u64 n = s_tph.st_placed + s_tph.st_committed;
+    if (n == last_n && s_tph.st_released == last_rel) return;
+    LARGE_INTEGER f, c; QueryPerformanceFrequency(&f); QueryPerformanceCounter(&c);
+    const double t = (double)c.QuadPart / (double)f.QuadPart;
+    if (t - s_tph.t_last < 30.0 && s_tph.nh == last_nh && s_tph.st_released == last_rel) return;
+    s_tph.t_last = t; last_n = n; last_nh = s_tph.nh; last_rel = s_tph.st_released;
+    if (s_vskv.hits)
+        fprintf(stderr, "[VSKEY] verify: %llu hits, %llu with another store tail decompiled again: %llu same HLSL,"
+                        " %llu different%c", (unsigned long long)s_vskv.hits, (unsigned long long)s_vskv.checked,
+                (unsigned long long)s_vskv.same, (unsigned long long)s_vskv.differ, 10);
+    u64 used = 0; int nfr = 0, nheap = 0;
+    for (int i = 0; i < s_tph.nh; i++)
+        if (s_tph.h[i].heap) { used += s_tph.h[i].used; nfr += s_tph.h[i].nfr; nheap++; }
+    (void)vram_sample(NULL, NULL);
+    fprintf(stderr, "[TEXPLACED] placed %llu, committed %llu (over %llu MB: %llu, no heap under the budget: %llu,"
+                    " failed %llu), freed %llu (%llu deferred) | heaps %d (%llu made ahead, %llu on the walker, %llu"
+                    " released), %.1f of %llu MB used, %d free ranges | video memory %.0f MB, high-water %.0f MB,"
+                    " budget %.0f MB | upload faults injected %llu, 32 MB chunks refused %llu%c",
+            (unsigned long long)s_tph.st_placed, (unsigned long long)s_tph.st_committed,
+            (unsigned long long)(TPH_MAX_RES >> 20), (unsigned long long)s_tph.st_big,
+            (unsigned long long)s_tph.st_budget, (unsigned long long)s_tph.st_fail,
+            (unsigned long long)s_tph.st_freed, (unsigned long long)s_tph.st_deferred, nheap,
+            (unsigned long long)s_tph.st_ahead, (unsigned long long)s_tph.st_sync,
+            (unsigned long long)s_tph.st_released, (double)used / 1048576.0,
+            (unsigned long long)((u64)nheap * TPH_HEAP_BYTES >> 20), nfr, (double)s_vram.use / 1048576.0,
+            (double)s_vram.hw / 1048576.0, (double)s_vram.budget / 1048576.0, (unsigned long long)s_tc.st_fault,
+            (unsigned long long)s_tc.st_ckfall, 10);
+}
+/* TEX_PLACED_VERIFY: after the copy into placed texture r (COPY_DEST), copy it
+ * back into a readback buffer laid out as the upload was; compared later. */
+static void tph_verify_add(ID3D12Resource* r, ID3D12Resource* up, u64 upoff, u64 upbytes, u32 nsub,
+                           const D3D12_PLACED_SUBRESOURCE_FOOTPRINT* fp, const rsx_tex_level* lv, u32 nlv)
+{
+    if (s_tph.nver == s_tph.capver) {
+        const int nc = s_tph.capver ? s_tph.capver * 2 : 64;
+        TphVer* n = (TphVer*)realloc(s_tph.ver, (size_t)nc * sizeof *n);
+        if (!n) return;
+        s_tph.ver = n; s_tph.capver = nc;
+    }
+    TphVer* v = &s_tph.ver[s_tph.nver];
+    memset(v, 0, sizeof *v);
+    u64 total = 0;
+    for (u32 s = 0; s < nsub; s++) {
+        v->fp[s] = fp[s];
+        v->rows[s] = lv[s % nlv].tl.rows; v->rowb[s] = lv[s % nlv].tl.dst_row_bytes;
+        const u64 e = fp[s].Offset + (u64)fp[s].Footprint.RowPitch * v->rows[s];
+        if (e > total) total = e;
+    }
+    total = (total + 511u) & ~511ull;
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd; memset(&bd, 0, sizeof bd);
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = 2 * total; bd.Height = 1; bd.DepthOrArraySize = 1;
+    bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+               D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&v->rb)) || !v->rb) return;
+    v->half = total; v->nsub = nsub;
+    /* the upload's own bytes only (upbytes: its allocation; total is rounded up past it) */
+    s_d3d.cmd_list->lpVtbl->CopyBufferRegion(s_d3d.cmd_list, v->rb, total, up, upoff, upbytes < total ? upbytes : total);
+    D3D12_RESOURCE_BARRIER b; memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = r; b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST; b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    D3D12_TEXTURE_COPY_LOCATION src, dst;
+    memset(&src, 0, sizeof src); memset(&dst, 0, sizeof dst);
+    src.pResource = r; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.pResource = v->rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    for (u32 s = 0; s < nsub; s++) {
+        src.SubresourceIndex = s; dst.PlacedFootprint = fp[s];
+        s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &dst, 0, 0, 0, &src, NULL);
+    }
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE; b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    s_tph.nver++;
+}
+/* TEX_PLACED_VERIFY: the GPU finished the batch (tc_batch_begin, before the
+ * upload memory is reused): every copy-back against the bytes uploaded. */
+static void tph_verify_check(void)
+{
+    if (!s_tph.nver) return;
+    D3D12_RANGE none = { 0, 0 };
+    for (int i = 0; i < s_tph.nver; i++) {
+        TphVer* v = &s_tph.ver[i];
+        u8 *a = NULL;
+        if (SUCCEEDED(v->rb->lpVtbl->Map(v->rb, 0, NULL, (void**)&a)) && a) {
+            const u8* u = a + v->half;
+            int bad = 0;
+            for (u32 s = 0; s < v->nsub; s++) {
+                for (u32 y = 0; y < v->rows[s]; y++) {
+                    const u64 o = v->fp[s].Offset + (u64)y * v->fp[s].Footprint.RowPitch;
+                    if (memcmp(a + o, u + o, v->rowb[s])) { bad = 1; s_tph.v_diff++; }
+                    s_tph.v_bytes += v->rowb[s];
+                }
+                s_tph.v_sub++;
+            }
+            s_tph.v_tex++;
+            if (bad && s_tph.v_difftex++ < 8)
+                fprintf(stderr, "[TEXPLACED] verify: a placed texture DIFFERS from its upload (%u subresources)%c",
+                        v->nsub, 10);
+        }
+        if (a) v->rb->lpVtbl->Unmap(v->rb, 0, &none);
+        v->rb->lpVtbl->Release(v->rb);
+    }
+    s_tph.nver = 0;
+    static u64 last;
+    if (s_tph.v_tex - last >= 500 || (s_tph.v_tex && !last)) {
+        last = s_tph.v_tex;
+        fprintf(stderr, "[TEXPLACED] verify: %llu textures, %llu subresources, %.1f MB compared, %llu rows differ"
+                        " (%llu textures)%c", (unsigned long long)s_tph.v_tex, (unsigned long long)s_tph.v_sub,
+                (double)s_tph.v_bytes / 1048576.0, (unsigned long long)s_tph.v_diff,
+                (unsigned long long)s_tph.v_difftex, 10);
+    }
+}
+
+/* Backend (re)initialisation: forget every slot and the old device's objects. */
+static void tc_reset_all(void)
+{
+    for (int i = 0; i < s_tc.ntmp; i++) s_tc.tmp[i]->lpVtbl->Release(s_tc.tmp[i]);
+    free(s_tc.tmp);
+    free(s_tc.fz_cap);                     /* TX1 TEX_FENCE: the fence's copy buffer */
+    if (s_tc.ring) s_tc.ring->lpVtbl->Release(s_tc.ring);
+    if (s_tc.cpu_heap) s_tc.cpu_heap->lpVtbl->Release(s_tc.cpu_heap);
+    memset(&s_tc, 0, sizeof s_tc);
+    if (s_tcw.gen) VirtualFree(s_tcw.gen, 0, MEM_RELEASE);
+    free(s_tcw.hits);
+    memset(&s_tcw, 0, sizeof s_tcw);
+    s_tfv_batch = s_tfv_draws = 0;   /* PF3_VERIFY's fence oracle: the batch numbers start again */
+}
