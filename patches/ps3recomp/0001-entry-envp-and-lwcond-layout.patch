+/* --- per-texel processing ----------------------------------------------- */
+
+static void test_texproc(void)
+{
+    rsx_texproc_ctl c;
+    /* gamma: R,G,B (TEXTURE_ADDRESS 0x00730303 -- inFamous 2's albedo) */
+    rsx_texture_texproc(FMT_A8R8G8B8, 0xAAE4u, 0x00730303u, 0x02062000u, &c);
+    CHECK_EQ(c.gamma, 7); CHECK_EQ(c.expand, 0); CHECK_EQ(c.sext, 0); CHECK(!c.depth);
+    /* BIASED: every output the crossbar reads, minus gamma ones */
+    rsx_texture_texproc(FMT_A8R8G8B8 | FMT_LN, 0xAAE4u, 0x00031303u, 0x01012000u, &c);
+    CHECK_EQ(c.expand, 0xF); CHECK_EQ(c.gamma, 0);
+    rsx_texture_texproc(FMT_A8R8G8B8, 0xAAE4u, 0x00731303u, 0, &c);
+    CHECK_EQ(c.expand, 8); CHECK_EQ(c.gamma, 7);
+    rsx_texture_texproc(FMT_A8R8G8B8, 0xA9E4u, 0x00001000u, 0, &c);     /* A forced one */
+    CHECK_EQ(c.expand, 7);
+    /* signed: all lanes; gamma and expand step aside */
+    rsx_texture_texproc(FMT_DXT1, 0xAAE4u, 0x00731000u, 0xF0000000u, &c);
+    CHECK_EQ(c.sext, 0xF); CHECK_EQ(c.gamma, 0); CHECK_EQ(c.expand, 0); CHECK(!c.sext16);
+    /* the signed bits name presented lanes and follow the crossbar: lane R
+     * (bit 29) signed, 0xAA1B routes lane R to output G */
+    rsx_texture_texproc(FMT_A8R8G8B8, 0xAAE4u, 0, 0x20000000u, &c);
+    CHECK_EQ(c.sext, 1);                    /* output R */
+    rsx_texture_texproc(FMT_A8R8G8B8, 0xAA1Bu, 0, 0x20000000u, &c);
+    CHECK_EQ(c.sext, 2);                    /* output G */
+    rsx_texture_texproc(FMT_A8R8G8B8, 0xAAE4u, 0, 0x10000000u, &c);
+    CHECK_EQ(c.sext, 8);                    /* lane A -> output A */
+    rsx_texture_texproc(FMT_A8R8G8B8, 0x2AE4u, 0, 0xF0000000u, &c);     /* B forced zero */
+    CHECK_EQ(c.sext, 0xB);
+    /* X16: no gamma (it would hang the GPU), BIASED yes, signed ignored */
+    rsx_texture_texproc(FMT_X16 | FMT_LN, 0xAAEEu, 0x00731303u, 0xF2022000u, &c);
+    CHECK_EQ(c.gamma, 0); CHECK_EQ(c.sext, 0); CHECK_EQ(c.expand, 0xF);
+    rsx_texture_texproc(FMT_X16 | FMT_LN, 0xAAEEu, 0x00030303u, 0x02022000u, &c);   /* the lookup */
+    CHECK_EQ(c.gamma, 0); CHECK_EQ(c.sext, 0); CHECK_EQ(c.expand, 0); CHECK(!c.depth);
+    /* Y16_X16: signed works, on 16-bit channels */
+    rsx_texture_texproc(FMT_Y16X16, 0xAAE4u, 0x00700000u, 0x60000000u, &c);
+    CHECK(c.sext != 0); CHECK(c.sext16); CHECK_EQ(c.gamma, 0);
+    /* HILO_S8 and the float formats: nothing applies */
+    rsx_texture_texproc(FMT_HILO_S8, 0xAAE4u, 0x00731000u, 0xF0000000u, &c);
+    CHECK_EQ(c.sext | c.gamma | c.expand, 0);
+    rsx_texture_texproc(FMT_W16F | FMT_LN, 0xAAE4u, 0x00731000u, 0xF0000000u, &c);
+    CHECK_EQ(c.sext | c.gamma | c.expand, 0);
+    /* HILO8: BIASED only */
+    rsx_texture_texproc(FMT_HILO8, 0xAAE4u, 0x00731000u, 0xF0000000u, &c);
+    CHECK_EQ(c.sext, 0); CHECK_EQ(c.gamma, 0); CHECK_EQ(c.expand, 0xF);
+    /* depth: inFamous 2's sun shadow map (DEPTH24_D8 LN, ADDRESS 0x40030303:
+     * ZFUNC 4 = GREATER, FILTER 0x02022000: linear) */
+    rsx_texture_texproc(FMT_DEPTH24 | FMT_LN, 0xAAE4u, 0x40030303u, 0x02022000u, &c);
+    CHECK(c.depth); CHECK_EQ(c.zfunc, 4); CHECK(c.zlinear);
+    CHECK_EQ(c.sext | c.gamma | c.expand, 0);
+    rsx_texture_texproc(FMT_DEPTH16, 0xAAE4u, 0x00030303u, 0x01012000u, &c);
+    CHECK(c.depth); CHECK_EQ(c.zfunc, 0); CHECK(!c.zlinear);
+    rsx_texture_texproc(FMT_DEPTH16F, 0, 0x70000000u, 0x03032000u, &c);
+    CHECK(c.depth); CHECK_EQ(c.zfunc, 7); CHECK(!c.zlinear);     /* NEAREST_MIPMAP_NEAREST */
+    rsx_texture_texproc(FMT_DEPTH24F, 0, 0x10000000u, 0x06062000u, &c);
+    CHECK(c.depth); CHECK_EQ(c.zfunc, 1); CHECK(c.zlinear);
+    rsx_texture_texproc(FMT_A8R8G8B8, 0, 0x40030303u, 0, &c);   /* ZFUNC on a colour format: ignored */
+    CHECK(!c.depth);
+    /* feature table spot checks */
+    CHECK_EQ(rsx_texture_format_features(FMT_B8 | FMT_LN),
+             RSX_TEXFEAT_SIGNED | RSX_TEXFEAT_GAMMA | RSX_TEXFEAT_BIASED);
+    CHECK_EQ(rsx_texture_format_features(FMT_DEPTH24), RSX_TEXFEAT_BIASED);
+    CHECK_EQ(rsx_texture_format_features(FMT_X16), RSX_TEXFEAT_BIASED | RSX_TEXFEAT_16BIT);
+    CHECK_EQ(rsx_texture_format_features(0x8Au), 0);
+    rsx_texture_texproc(FMT_A8R8G8B8, 0, 0, 0, NULL);           /* must not crash */
+}
