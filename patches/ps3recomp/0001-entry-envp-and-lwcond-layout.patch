diff --git a/tools/test_ppu_cont.py b/tools/test_ppu_cont.py
new file mode 100644
index 0000000..812c7c7
--- /dev/null
+++ b/tools/test_ppu_cont.py
@@ -0,0 +1,449 @@
+#!/usr/bin/env python3
+"""--cont-list: save-state continuations, emission and end to end.
+
+`ppu_lifter.py --cont-list` emits, for listed guest return addresses (or
+whole functions), the rest of each lifted function from that return address
+as a separate continuation, plus a table runtime/ppu/ppu_resume.cpp registers
+and validates parked chains against. This test pins:
+
+  * the list parser (return addresses, func_X+0xOFF chain tokens, whole
+    functions, skipped junk);
+  * that the list never changes the normal lifted output (an empty list emits
+    nothing; a non-empty one only adds the continuation file);
+  * the clone: entered by `switch (ra)`, epilogue restoring r14-r31 from the
+    guest frame (the guest's own `ld`) where the normal body uses _cs_ copies;
+  * the exit model per return address -- the frame the continuation pops and
+    where it reloads LR -- including a TAIL FRAGMENT that pops its owner's
+    frame from a lifted function of its own (the critic's correction), a
+    thread main loop (never returns), an alloca'd frame popped through the
+    back chain, and a frameless syscall wrapper;
+  * P0 self-resume on that lifted program (Windows / clang-cl only):
+    runtime/savestate/tests/test_ss_selfresume.cpp with the real
+    runtime/savestate/ss_core.c and runtime/ppu/ppu_selfresume.cpp -- both
+    guest threads asked to resume over and over at their HLE / syscall
+    entries, each time from their guest stacks alone, must still end with the
+    reference hashes; and with the --legacy-indirect-lr lift the main
+    thread's stale saved LR must be refused every time (never resumed);
+  * end to end: the save-state study's continuation proof of concept as REAL
+    PPC code (the same program runtime/ppu/tests/test_cont_resume.cpp carries
+    hand-written), lifted with --cont-list, compiled with that driver and the
+    real runtime/ppu/ppu_resume.cpp: snapshots at five times and a
+    three-generation chain, each loaded in a fresh process, must end with the
+    study's reference hashes; the walk's refusals (including a call mismatch
+    and a stale saved LR, which need the guest code in memory) and the
+    PPU_RESUME_CHECK_EVERY probe; and the negative control -- the same program
+    lifted --legacy-indirect-lr (no LR store before bctrl) must be REFUSED at
+    save time as a stale LR.
+
+The compile step needs clang-cl (Windows; LLVM's default install path is
+tried) or a C++ compiler ($CXX, clang++, g++); without one it is skipped.
+Run: py -3 tools/test_ppu_cont.py
+"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+sys.path.insert(0, TOOLS)
+
+import ppu_disasm                                       # noqa: E402
+import ppu_lifter                                       # noqa: E402
+from ppu_lifter import PPULifter, parse_cont_list       # noqa: E402
+
+FAILS = []
+
+
+def check(cond, msg):
+    if not cond:
+        FAILS.append(msg)
+        print("FAIL:", msg)
+
+
+# ---- a tiny PPC assembler (the forms the program uses) ----------------------
+def D(op, rt, ra, d):      return (op << 26) | (rt << 21) | (ra << 16) | (d & 0xFFFF)
+def DS(op, rt, ra, d, x):  return (op << 26) | (rt << 21) | (ra << 16) | (d & 0xFFFC) | x
+def X(rs, ra, rb, xo):     return (31 << 26) | (rs << 21) | (ra << 16) | (rb << 11) | (xo << 1)
+def li(rt, v):             return D(14, rt, 0, v)
+def lis(rt, v):            return D(15, rt, 0, v)
+def addi(rt, ra, v):       return D(14, rt, ra, v)
+def mulli(rt, ra, v):      return D(7, rt, ra, v)
+def lwz(rt, ra, d):        return D(32, rt, ra, d)
+def stw(rs, ra, d):        return D(36, rs, ra, d)
+def ori(ra, rs, v):        return D(24, rs, ra, v)
+def ld(rt, ra, d):         return DS(58, rt, ra, d, 0)
+def std(rs, ra, d):        return DS(62, rs, ra, d, 0)
+def stdu(rs, ra, d):       return DS(62, rs, ra, d, 1)
+def mr(ra, rs):            return X(rs, ra, rs, 444)
+def xor(ra, rs, rb):       return X(rs, ra, rb, 316)
+def add(rt, ra, rb):       return X(rt, ra, rb, 266)
+def mulld(rt, ra, rb):     return X(rt, ra, rb, 233)
+def stdux(rs, ra, rb):     return X(rs, ra, rb, 181)
+def cmpld(ra, rb):         return (31 << 26) | (1 << 21) | (ra << 16) | (rb << 11) | (32 << 1)
+def md(op_xo, ra, rs, sh, m):                       # rldicl (0) / rldicr (1)
+    mf = ((m & 31) << 1) | (m >> 5)
+    return (30 << 26) | (rs << 21) | (ra << 16) | ((sh & 31) << 11) | (mf << 5) | (op_xo << 2) | ((sh >> 5) << 1)
+def srdi(ra, rs, n):       return md(0, ra, rs, 64 - n, n)
+def sldi(ra, rs, n):       return md(1, ra, rs, n, 63 - n)
+def mtctr(rs):             return 0x7C0903A6 | (rs << 21)
+MFLR_R0, MTLR_R0, BCTRL, SC, BLR, NOP = 0x7C0802A6, 0x7C0803A6, 0x4E800421, 0x44000002, 0x4E800020, 0x60000000
+
+
+class Asm:
+    def __init__(self, base):
+        self.base, self.w, self.fix = base, [], []
+
+    @property
+    def pc(self):
+        return self.base + 4 * len(self.w)
+
+    def __call__(self, *ws):
+        self.w.extend(ws)
+        return self
+
+    def bl(self, to):  self.w.append((18 << 26) | ((to - self.pc) & 0x3FFFFFC) | 1); return self.pc
+    def b(self, to):   self.w.append((18 << 26) | ((to - self.pc) & 0x3FFFFFC)); return self
+    def blt(self, to): self.w.append((16 << 26) | (12 << 21) | ((to - self.pc) & 0xFFFC)); return self
+
+
+# ---- the program (critic/cont/guest_cont.cpp as PPC code) -------------------
+OBJ_STUB = 0x19000
+NID = 0x12345678
+
+
+def program():
+    funcs, ras = {}, {}
+
+    a = Asm(0x10000)                                   # main thread entry, r3 = obj
+    a(stdu(1, 1, -0x90), MFLR_R0, std(29, 1, 0x78), std(30, 1, 0x80), std(31, 1, 0x88),
+      std(0, 1, 0xA0), mr(31, 3), li(30, 0), li(29, 7), stw(29, 1, 0x70))
+    loop = a.pc
+    a(mr(3, 31), mr(4, 30))
+    ras["main"] = a.bl(0x10100)
+    a(lwz(0, 1, 0x70), mulli(29, 29, 31), add(29, 29, 3), add(29, 29, 0), srdi(9, 29, 7),
+      stw(9, 1, 0x70), addi(30, 30, 1), lis(9, 0x80), lwz(9, 9, 0), cmpld(30, 9))
+    a.blt(loop)
+    a(lis(9, 0x80), std(29, 9, 0x10), ld(0, 1, 0xA0), ld(29, 1, 0x78), ld(30, 1, 0x80),
+      ld(31, 1, 0x88), MTLR_R0, addi(1, 1, 0x90), BLR)
+    funcs[0x10000] = a
+
+    a = Asm(0x10100)                                   # frame owner of the fragment below
+    a(stdu(1, 1, -0x80), MFLR_R0, std(31, 1, 0x78), std(0, 1, 0x90), std(3, 1, 0x70),
+      addi(31, 4, 100), mr(3, 4))
+    ras["leafcall"] = a.bl(0x10200)
+    a(mr(4, 3), ld(3, 1, 0x70)).b(0x10180)
+    funcs[0x10100] = a
+
+    a = Asm(0x10180)                                   # TAIL FRAGMENT: 0x10100's frame
+    a(lwz(9, 3, 0), lwz(9, 9, 0), lwz(0, 9, 0), std(2, 1, 0x28), mtctr(0), lwz(2, 9, 4))
+    ras["vcall"] = a.pc + 4
+    a(BCTRL, ld(2, 1, 0x28), xor(3, 3, 31), ld(0, 1, 0x90), ld(31, 1, 0x78), MTLR_R0,
+      addi(1, 1, 0x80), BLR)
+    funcs[0x10180] = a
+
+    a = Asm(0x10200)                                   # leaf
+    a(mulli(3, 3, 3), add(3, 3, 4), BLR)
+    funcs[0x10200] = a
+
+    a = Asm(0x10300)                                   # vtable target
+    a(stdu(1, 1, -0x90), MFLR_R0, std(30, 1, 0x80), std(31, 1, 0x88), std(0, 1, 0xA0),
+      mr(30, 3), mulli(31, 4, 3), li(3, 1))
+    ras["hle"] = a.bl(OBJ_STUB)
+    # (r10, not the PoC's r0: `addi r0,r0,1` is `li r0,1` -- rA=0 reads as 0)
+    a(lwz(10, 30, 8), addi(10, 10, 1), stw(10, 30, 8), add(3, 3, 31), add(3, 3, 10),
+      ld(0, 1, 0xA0), ld(30, 1, 0x80), ld(31, 1, 0x88), MTLR_R0, addi(1, 1, 0x90), BLR)
+    funcs[0x10300] = a
+
+    a = Asm(0x11000)                                   # worker thread entry
+    a(stdu(1, 1, -0x80), MFLR_R0, std(30, 1, 0x70), std(31, 1, 0x78), std(0, 1, 0x90),
+      li(31, 13), li(30, 0))
+    loop = a.pc
+    a(mr(3, 30))
+    ras["worker"] = a.bl(0x11100)
+    a(xor(31, 31, 3), li(9, 1), sldi(9, 9, 40), ori(9, 9, 0x1B3), mulld(31, 31, 9),
+      addi(30, 30, 1), lis(9, 0x80), lwz(9, 9, 0), cmpld(30, 9))
+    a.blt(loop)
+    a(lis(9, 0x80), std(31, 9, 0x18), ld(0, 1, 0x90), ld(30, 1, 0x70), ld(31, 1, 0x78),
+      MTLR_R0, addi(1, 1, 0x80), BLR)
+    funcs[0x11000] = a
+
+    a = Asm(0x11100)                                   # syscall site
+    a(stdu(1, 1, -0x80), MFLR_R0, std(31, 1, 0x78), std(0, 1, 0x90), mulld(31, 3, 3),
+      li(3, 2), li(11, 0x99))
+    ras["sc"] = a.pc + 4
+    a(SC, add(3, 3, 31), ld(0, 1, 0x90), ld(31, 1, 0x78), MTLR_R0, addi(1, 1, 0x80), BLR)
+    funcs[0x11100] = a
+
+    # Exit-model shapes the program itself does not run.
+    a = Asm(0x12000)                                   # a thread's main loop
+    a(stdu(1, 1, -0x70), MFLR_R0, std(0, 1, 0x80))
+    loop = a.pc
+    ras["noreturn"] = a.bl(0x10200)
+    a.b(loop)
+    funcs[0x12000] = a
+
+    a = Asm(0x12100)                                   # alloca, popped through the back chain
+    a(stdu(1, 1, -0x80), MFLR_R0, std(0, 1, 0x90))
+    ras["alloca1"] = a.bl(0x10200)
+    a(ld(0, 1, 0), stdux(0, 1, 9))
+    ras["alloca2"] = a.bl(0x10200)
+    a(ld(11, 1, 0), ld(0, 11, 0x10), MTLR_R0, mr(1, 11), BLR)
+    funcs[0x12100] = a
+
+    a = Asm(0x12200)                                   # frameless syscall wrapper
+    a(MFLR_R0, std(0, 1, 0x10), li(11, 0x99))
+    ras["frameless"] = a.pc + 4
+    a(SC, ld(0, 1, 0x10), MTLR_R0, BLR)
+    funcs[0x12200] = a
+
+    a = Asm(OBJ_STUB)                                  # import stub (lifted as ps3_hle_call)
+    a(NOP, NOP, NOP, NOP, NOP, NOP, NOP, BLR)
+    funcs[OBJ_STUB] = a
+    return funcs, ras
+
+
+def lift(funcs, cont_text=None, legacy=False):
+    lifter = PPULifter()
+    lifter.header_name = "lifted.h"
+    lifter.hle_stub_nids = {OBJ_STUB: NID}
+    lifter.legacy_indirect_lr = legacy
+    lifter.function_entries = {b for b in funcs if b not in (0x10180, OBJ_STUB)}
+    if cont_text is not None:
+        lifter.cont_ras, lifter.cont_funcs, _ = parse_cont_list(cont_text)
+    words = {}
+    for base, a in sorted(funcs.items()):
+        for i, w in enumerate(a.w):
+            words[base + 4 * i] = w
+        insns = [ppu_disasm.decode(w, base + 4 * i) for i, w in enumerate(a.w)]
+        lifter.lift_function(insns, base, base + 4 * len(a.w))
+    return lifter, words
+
+
+def rows_of(cont_src):
+    """{ra: (owner, callee, r1_off, lr_off, call_kind, exit_kind, flags)} from the table."""
+    out = {}
+    for l in cont_src.splitlines():
+        l = l.strip()
+        if l.startswith("{ 0x") and "cont_" in l:
+            f = [x.strip().rstrip("u") for x in l.strip("{}, ").split(",")]
+            out[int(f[0], 16)] = (int(f[1], 16), int(f[3], 16), int(f[4]), int(f[5]),
+                                  int(f[6]), int(f[7]), int(f[8]))
+    return out
+
+
+def test_abi_in_sync():
+    """The table entry the lifter emits and runtime/ppu/ppu_resume.h's must be
+    the same struct (token for token: one ODR definition), with the same ABI
+    number and the same exit/flag/call-kind values."""
+    import re
+    hdr = open(os.path.join(ROOT, "runtime", "ppu", "ppu_resume.h"), encoding="utf-8").read()
+
+    def toks(s):
+        a = s.index("typedef struct ppu_cont_entry {")
+        t = s[a:s.index("} ppu_cont_entry;", a)]
+        return " ".join(re.sub(r"/\*.*?\*/", " ", t, flags=re.S).split())
+    check(toks(hdr) == toks(ppu_lifter.CONT_PREAMBLE), "ppu_cont_entry differs between lifter and runtime")
+    defs = dict((k, int(v, 0)) for k, v in re.findall(r"\b(PPU_CONT_\w+)\s*=\s*(0x[0-9A-Fa-f]+|\d+)", hdr))
+    defs["PPU_CONT_ABI"] = int(re.search(r"#define PPU_CONT_ABI (\d+)", hdr).group(1))
+    for name, val in (("PPU_CONT_ABI", ppu_lifter.CONT_ABI),
+                      ("PPU_CONT_EXIT_UNKNOWN", ppu_lifter.CONT_EXIT_UNKNOWN),
+                      ("PPU_CONT_EXIT_RETURNS", ppu_lifter.CONT_EXIT_RETURNS),
+                      ("PPU_CONT_EXIT_NORETURN", ppu_lifter.CONT_EXIT_NORETURN),
+                      ("PPU_CONT_F_R1_BC", ppu_lifter.CONT_F_R1_BC),
+                      ("PPU_CONT_F_LR_BC", ppu_lifter.CONT_F_LR_BC),
+                      ("PPU_CONT_F_LR_W32", ppu_lifter.CONT_F_LR_W32),
+                      ("PPU_CONT_F_PARTIAL", ppu_lifter.CONT_F_PARTIAL),
+                      ("PPU_CONT_CALL_BL", 1), ("PPU_CONT_CALL_INDIRECT", 2),
+                      ("PPU_CONT_CALL_SC", 3), ("PPU_CONT_CALL_BCL", 4)):
+        check(defs.get(name) == val, f"{name}: runtime {defs.get(name)} lifter {val}")
+    check(f"#define PPU_CONT_ABI {ppu_lifter.CONT_ABI}" in ppu_lifter.CONT_PREAMBLE, "preamble ABI number")
+
+
+def test_parser():
+    ras, funcs, skipped = parse_cont_list(
+        "# comment 0x11111110\n"
+        "run-1.log tag=nc tid=1 lr=00478504 depth=2: func_0047840C+0xF8 func_00010338+0x184\n"
+        "0x00010034, 00010038 ra:0x1003C fn:0x00012000 libsre_func_3000B504 func_00011000\n"
+        "0x10035 [('func_0001024C', 362)]\n")
+    check(ras == {0x00478504, 0x000104BC, 0x10034, 0x10038, 0x1003C}, f"parser RAs {sorted(map(hex, ras))}")
+    check(funcs == {0x12000, 0x3000B504, 0x11000}, f"parser functions {sorted(map(hex, funcs))}")
+    check("0x10035" in skipped and "tag=nc" in skipped and "lr=00478504" in skipped,
+          f"parser skips junk and unaligned addresses: {skipped}")
+
+
+def test_emission(funcs, ras):
+    plain, _ = lift(funcs)
+    listed, words = lift(funcs, "fn:0x10000 fn:0x10100 fn:0x10180 fn:0x10300 fn:0x11000 fn:0x11100 "
+                                "fn:0x12000 fn:0x12100 fn:0x12200 0x10008 0x30001000")
+    check(plain.emit_source() == listed.emit_source() and plain.emit_header() == listed.emit_header(),
+          "a cont list must not change the normal lifted output")
+    src0, _, _ = plain.emit_cont_source(words)
+    check(src0 is None, "no list -> no continuation file")
+    src, rep, st = listed.emit_cont_source(words)
+    check(src is not None and st["ras"] == len(ras) + 0, f"one continuation per call site: {st}")
+    if src is None:
+        return None, None
+    check("static void contf_00010000(ppu_context* ctx, uint32_t ra) {" in src, "owner clone")
+    check(f"static void cont_{ras['main']:08X}(ppu_context* ctx) {{ contf_00010000(ctx, 0x{ras['main']:08X}u); }}" in src,
+          "per-RA entry")
+    clone = src.split("static void contf_00010000", 1)[1].split("\n}\n", 1)[0]
+    body = plain.emit_source().split("void func_00010000(ppu_context* ctx) {", 1)[1].split("\n}\n", 1)[0]
+    check("ctx->gpr[29] = vm_read64(ctx->gpr[1] + 0x78);" in clone and "_cs_" not in clone,
+          "the clone restores r29 from the guest frame")
+    check("ctx->gpr[29] = _cs_29;" in body, "the normal body keeps its _cs_ copy")
+    check(f"R_{ras['main']:08X}: ;" in clone and f"case 0x{ras['main']:08X}u: goto R_{ras['main']:08X};" in clone,
+          "entered at the return-site label")
+    check("s_cont_registered = ppu_cont_register(s_cont_table" in src, "table registered")
+    r = rows_of(src)
+    E_RET, E_NORET = ppu_lifter.CONT_EXIT_RETURNS, ppu_lifter.CONT_EXIT_NORETURN
+    BC = ppu_lifter.CONT_F_R1_BC | ppu_lifter.CONT_F_LR_BC
+    want = {
+        "main":      (0x10000, 0x10100, 0x90, 0xA0, 1, E_RET, 0),
+        "leafcall":  (0x10100, 0x10200, 0x80, 0x90, 1, E_RET, 0),
+        "vcall":     (0x10180, 0,       0x80, 0x90, 2, E_RET, 0),   # the fragment pops its OWNER's frame
+        "hle":       (0x10300, OBJ_STUB, 0x90, 0xA0, 1, E_RET, 0),
+        "worker":    (0x11000, 0x11100, 0x80, 0x90, 1, E_RET, 0),
+        "sc":        (0x11100, 0,       0x80, 0x90, 3, E_RET, 0),
+        "noreturn":  (0x12000, 0x10200, 0, 0, 1, E_NORET, 0),
+        "alloca1":   (0x12100, 0x10200, 0, 0x10, 1, E_RET, BC),
+        "alloca2":   (0x12100, 0x10200, 0, 0x10, 1, E_RET, BC),
+        "frameless": (0x12200, 0,       0, 0x10, 3, E_RET, 0),
+    }
+    for k, v in want.items():
+        check(r.get(ras[k]) == v, f"{k} @0x{ras[k]:08X}: table {r.get(ras[k])} want {v}")
+    check("not a lifted call site (no continuation): 0x00010008" in rep, "unresolved RA reported")
+    check("1 listed return address(es) outside this image" in rep, "outside-image RA reported")
+    return listed, words
+
+
+DRIVER = os.path.join(ROOT, "runtime", "ppu", "tests", "test_cont_resume.cpp")
+
+
+def find_cxx():
+    cands = [os.environ.get("CXX")] if os.environ.get("CXX") else []
+    if os.name == "nt":
+        cands += [shutil.which("clang-cl"), r"C:\Program Files\LLVM\bin\clang-cl.exe"]
+    cands += [shutil.which("clang++"), shutil.which("g++"), shutil.which("c++")]
+    for c in cands:
+        if c and os.path.exists(c):
+            return c
+    return None
+
+
+def build(cxx, tmp, lifter, words, name):
+    d = os.path.join(tmp, name)
+    os.makedirs(d, exist_ok=True)
+    legacy = lifter.legacy_indirect_lr
+    lifter.legacy_indirect_lr = False                # the header with sc_ra (same layout)
+    open(os.path.join(d, "lifted.h"), "w").write(lifter.emit_header())
+    lifter.legacy_indirect_lr = legacy
+    open(os.path.join(d, "lifted.cpp"), "w").write(lifter.emit_source())
+    src, _, _ = lifter.emit_cont_source(words)
+    open(os.path.join(d, "lifted_cont.cpp"), "w").write(
+        "\n".join(lifter._preamble_lines()) + "\n" + src)
+    base = min(words)
+    n = (max(words) - base) // 4 + 1
+    img = [words.get(base + 4 * i, 0) for i in range(n)]
+    with open(os.path.join(d, "guest_image.inc"), "w") as f:
+        f.write(f"static const uint32_t g_image_base = 0x{base:08X}u;\n")
+        f.write("static const uint32_t g_image[] = {\n")
+        for i in range(0, n, 8):
+            f.write("    " + ", ".join(f"0x{w:08X}u" for w in img[i:i + 8]) + ",\n")
+        f.write("};\n")
+    exe = os.path.join(d, "cont_e2e.exe" if os.name == "nt" else "cont_e2e")
+    srcs = [DRIVER, os.path.join(d, "lifted.cpp"), os.path.join(d, "lifted_cont.cpp")]
+    if os.path.basename(cxx).lower().startswith("clang-cl"):
+        cmd = ([cxx, "/nologo", "/std:c++20", "/EHsc", "/O1", "/w", "-DCONT_TEST_LIFTED",
+                "-D_CRT_SECURE_NO_WARNINGS", f"/I{d}"] + srcs + [f"/Fe:{exe}", f"/Fo:{d}\\"])
+    else:
+        cmd = ([cxx, "-std=c++20", "-O1", "-w", "-DCONT_TEST_LIFTED", f"-I{d}"] + srcs
+               + ["-o", exe, "-lpthread"])
+    r = subprocess.run(cmd, capture_output=True, text=True, cwd=d, timeout=900)
+    check(r.returncode == 0, f"{name}: compile failed:\n" + (r.stdout + r.stderr)[-3000:])
+    return (exe, d) if r.returncode == 0 else (None, d)
+
+
+SR_DRIVER = os.path.join(ROOT, "runtime", "savestate", "tests", "test_ss_selfresume.cpp")
+SR_GLUE = os.path.join(ROOT, "runtime", "savestate", "tests", "test_ss_selfresume_glue.c")
+SS_CORE = os.path.join(ROOT, "runtime", "savestate", "ss_core.c")
+# ss_core.c hands window-menu requests to ss_ui.c (ss_frame_tick -> ss_ui_service)
+SS_UI = os.path.join(ROOT, "runtime", "savestate", "ss_ui.c")
+# ... and captures a save's sections through ss_state.c (M4b)
+SS_STATE = os.path.join(ROOT, "runtime", "savestate", "ss_state.c")
+
+
+def build_sr(cxx, d):
+    """The P0 self-resume driver on the guest lifted into d by build().
+    runtime/savestate/ss_core.c is only built for Windows hosts so far."""
+    if not os.path.basename(cxx).lower().startswith("clang-cl"):
+        print("SKIP self-resume end to end: needs clang-cl")
+        return None
+    exe = os.path.join(d, "sr_e2e.exe")
+    cmd = [cxx, "/nologo", "/std:c++20", "/EHsc", "/O1", "/w", "-DCONT_TEST_LIFTED",
+           "-D_CRT_SECURE_NO_WARNINGS", f"/I{d}", SR_DRIVER, os.path.join(d, "lifted.cpp"),
+           os.path.join(d, "lifted_cont.cpp"), SR_GLUE, SS_CORE, SS_STATE, SS_UI, f"/Fe:{exe}", f"/Fo:{d}\\"]
+    r = subprocess.run(cmd, capture_output=True, text=True, cwd=d, timeout=900)
+    check(r.returncode == 0, "self-resume driver: compile failed:\n" + (r.stdout + r.stderr)[-3000:])
+    return exe if r.returncode == 0 else None
+
+
+def run_sr(exe, args, what):
+    r = subprocess.run([exe] + args, capture_output=True, text=True, timeout=900)
+    tail = [l for l in r.stdout.splitlines()
+            if l.startswith(("[test]", "[neg]", "[on]", "[timer]", "[atroot]", "[atroot-reuse]", "[on-legacy]",
+                           "PASS", "FAIL"))]
+    print("\n".join(tail))
+    check(r.returncode == 0, f"{what} failed (rc={r.returncode}):\n" + r.stdout[-4000:] + r.stderr[-1500:])
+    return r.returncode == 0
+
+
+def test_end_to_end(funcs, ras):
+    cxx = find_cxx()
+    if not cxx:
+        print("SKIP end-to-end: no C++ compiler (set CXX)")
+        return
+    every = " ".join(f"fn:0x{b:X}" for b in funcs if b != OBJ_STUB)
+    with tempfile.TemporaryDirectory() as tmp:
+        lifter, words = lift(funcs, every)
+        exe, d = build(cxx, tmp, lifter, words, "m1")
+        if exe:
+            r = subprocess.run([exe, "all", d], capture_output=True, text=True, timeout=900)
+            tail = [l for l in r.stdout.splitlines() if l.startswith(("[test]", "[neg]", "[probe]", "PASS", "FAIL"))]
+            print("\n".join(tail))
+            check(r.returncode == 0, "end to end failed:\n" + r.stdout[-4000:] + r.stderr[-1500:])
+            sr = build_sr(cxx, d)
+            if sr:
+                run_sr(sr, ["all", d], "self-resume end to end")
+        # The negative control: no LR store before the bctrl -> the slot
+        # 0x10300's prologue saves names the leaf call's return site; the
+        # snapshot must be refused as a stale LR.
+        lifter, words = lift(funcs, every, legacy=True)
+        exe, d = build(cxx, tmp, lifter, words, "legacy")
+        if exe:
+            r = subprocess.run([exe, "save", "20", os.path.join(d, "x.bin")], capture_output=True,
+                               text=True, timeout=300)
+            ok = r.returncode == 3 and "stale-lr" in r.stdout
+            print("[legacy] save refused (stale LR)" if ok else "[legacy] NOT refused")
+            check(ok, f"legacy lift must be refused at save (rc={r.returncode}):\n" + r.stdout[-2000:])
+            sr = build_sr(cxx, d)
+            if sr and run_sr(sr, ["on-legacy"], "self-resume on the legacy lift"):
+                print("[legacy] self-resume refused the stale LR every time (main never resumed)")
+
+
+def main():
+    test_abi_in_sync()
+    test_parser()
+    funcs, ras = program()
+    test_emission(funcs, ras)
+    test_end_to_end(funcs, ras)
+    if FAILS:
+        print(f"{len(FAILS)} FAILED")
+        return 1
+    print("ok: --cont-list parser, emission, exit models, resume end to end, self-resume, legacy refused")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/test_ppu_cs_restore_order.py b/tools/test_ppu_cs_restore_order.py
new file mode 100644
index 0000000..444febc
--- /dev/null
+++ b/tools/test_ppu_cs_restore_order.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""Callee-save snapshot: a load of a SAVED register from another slot.
+
+lift_function rewrites a callee-save restore `ld rN, off(r1)` to a value
+snapshotted at entry (`_cs_N`): a REGISTER snapshot when this body has the
+matching save (paired), a MEMORY snapshot of the slot in a pure tail entry
+(no `stdu`, slot never written here). Both kinds share the name `_cs_N`, and
+the paired kind wins the declaration.
+
+The restore pass runs in program order, so a load of rN from a DIFFERENT slot
+that comes BEFORE rN's paired epilogue restore used to be taken for a
+tail-entry restore: it became `_cs_N`, and once the paired restore made
+`_cs_N` a register snapshot it silently read the CALLER's rN.
+
+inFamous 2 func_004761F4 is exactly this shape: its prologue chunk 0x47618C
+(`stdu`, `std r4,0x448(r1)`, the `stvx` saves) is split off at the `mflr`, and
+the body does `std r31,0x5E8(r1); ld r31,0x448(r1)` to fetch a collision
+primitive. The lift returned the caller's r31 (the physics manager object)
+instead, the PPU-fallback narrowphase built contacts on it, and the game hung
+in a NULL-body unlink loop after debris broke loose.
+
+Case 2 pins the scope of the fix: an outgoing stack-argument store
+(`std r27,0x70(r1)`, never reloaded) is not a paired save, so the tail-entry
+restore `ld r27,0x238(r1)` keeps its memory snapshot.
+Case 3: a split body that does NOT save r31 itself keeps the memory snapshot
+of its spilled-argument reload (the first load of r31), unchanged.
+Case 4: case 1 lifted with --slotcheck (when the lifter has it) keeps the
+real load too.
+
+Synthetic encodings only (no game code). Run: python tools/test_ppu_cs_restore_order.py
+"""
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import ppu_disasm                       # noqa: E402
+from ppu_lifter import PPULifter        # noqa: E402
+
+BASE = 0x10000
+
+
+def w_ld(rt, ra, d):   return (58 << 26) | (rt << 21) | (ra << 16) | (d & 0xFFFC)
+def w_std(rs, ra, d):  return (62 << 26) | (rs << 21) | (ra << 16) | (d & 0xFFFC)
+def w_lwz(rt, ra, d):  return (32 << 26) | (rt << 21) | (ra << 16) | (d & 0xFFFF)
+def w_addi(rt, ra, s): return (14 << 26) | (rt << 21) | (ra << 16) | (s & 0xFFFF)
+def w_bl(frm, to):     return (18 << 26) | ((to - frm) & 0x3FFFFFC) | 1
+W_MFLR_R0 = 0x7C0802A6
+W_MTLR_R0 = 0x7C0803A6
+W_BLR = 0x4E800020
+
+
+def lift(words, slotcheck=None):
+    insns = [ppu_disasm.decode(w, BASE + 4 * i) for i, w in enumerate(words)]
+    lifter = PPULifter()
+    if slotcheck is not None:
+        lifter.slotcheck = slotcheck
+    func = lifter.lift_function(insns, BASE, BASE + 4 * len(words))
+    return "\n".join(func.body_lines)
+
+
+failed = 0
+
+
+def check(cond, what, body):
+    global failed
+    if cond:
+        print("PASS: " + what)
+    else:
+        failed += 1
+        print("FAIL: " + what + "\n" + body)
+
+
+# 1. func_004761F4's shape: body of a split function (its stdu is in the
+#    prologue chunk), saves r31, then reloads r31 from the spilled-argument
+#    slot 0x448, uses it, and restores r31 from its own save slot.
+CASE1 = [
+    W_MFLR_R0,
+    w_std(31, 1, 0x5E8),        # save r31 (paired with the restore below)
+    w_ld(31, 1, 0x448),         # reload the argument the prologue chunk spilled
+    w_std(0, 1, 0x600),
+    w_lwz(11, 31, 0xC),         # ... and use it
+    None,                       # bl (case 4 only; a plain lift gets a load)
+    w_ld(0, 1, 0x600),
+    W_MTLR_R0,
+    w_ld(31, 1, 0x5E8),         # epilogue: restore r31
+    w_addi(1, 1, 0x5F0),
+    W_BLR,
+]
+words1 = list(CASE1)
+words1[5] = w_lwz(12, 31, 0x10)
+body = lift(words1)
+check("ctx->gpr[31] = vm_read64(ctx->gpr[1] + 0x448);" in body,
+      "argument reload into a saved register stays a real load", body)
+check("uint64_t _cs_31 = ctx->gpr[31];" in body and body.count("ctx->gpr[31] = _cs_31;") == 1,
+      "the paired epilogue restore alone uses the register snapshot", body)
+
+# 2. Pure tail entry with an outgoing stack-argument store of r27 (never
+#    reloaded from 0x70): the epilogue restore from the original function's
+#    save slot keeps its memory snapshot.
+body = lift([
+    w_std(27, 1, 0x70),         # stack argument for a call, not a save
+    w_lwz(3, 27, 0x4),
+    w_ld(27, 1, 0x238),         # tail-entry restore (save lives upstream)
+    w_addi(1, 1, 0x250),
+    W_BLR,
+])
+check("uint64_t _cs_27 = vm_read64(ctx->gpr[1] + 0x238);" in body
+      and "ctx->gpr[27] = _cs_27;" in body,
+      "tail-entry restore keeps its memory snapshot next to an argument store", body)
+
+# 3. A split body that does not save r31 (its prologue chunk did): the
+#    spilled-argument reload is the first load of r31 and keeps its memory
+#    snapshot; the epilogue restore from another slot stays a real load.
+body = lift([
+    W_MFLR_R0,
+    w_ld(31, 1, 0x448),
+    w_std(0, 1, 0x600),
+    w_lwz(11, 31, 0xC),
+    w_ld(0, 1, 0x600),
+    W_MTLR_R0,
+    w_ld(31, 1, 0x5E8),
+    w_addi(1, 1, 0x5F0),
+    W_BLR,
+])
+check("uint64_t _cs_31 = vm_read64(ctx->gpr[1] + 0x448);" in body
+      and body.count("ctx->gpr[31] = _cs_31;") == 1
+      and "ctx->gpr[31] = vm_read64(ctx->gpr[1] + 0x5E8);" in body,
+      "unpaired split body: unchanged (memory snapshot, then a real load)", body)
+
+# 4. Case 1 with a call, lifted with --slotcheck "cs" (M1), if available.
+if hasattr(PPULifter(), "slotcheck"):
+    words4 = list(CASE1)
+    words4[5] = w_bl(BASE + 4 * 5, 0x20000)
+    body = lift(words4, slotcheck="cs")
+    check("ctx->gpr[31] = vm_read64(ctx->gpr[1] + 0x448);" in body
+          and body.count("ctx->gpr[31] = _cs_31;") == 1,
+          "--slotcheck lift keeps the argument reload a real load", body)
+else:
+    print("SKIP: this lifter has no --slotcheck")
+
+if failed:
+    print("%d check(s) failed" % failed)
+    sys.exit(1)
+print("all checks passed")
diff --git a/tools/test_ppu_indirect_lr.py b/tools/test_ppu_indirect_lr.py
new file mode 100644
index 0000000..8010a36
--- /dev/null
+++ b/tools/test_ppu_indirect_lr.py
@@ -0,0 +1,252 @@
+#!/usr/bin/env python3
+"""Return-address stores at indirect calls and `sc` (and their kill switch).
+
+Every linking branch sets LR = CIA+4 on the hardware. The lifter always did
+that for `bl` but not for the indirect forms -- bctrl, b<cond>ctrl/bcctrl,
+blrl, b<cond>lrl -- so a callee entered through a vtable or a function
+pointer saved a STALE LR in its prologue, and no guest stack walk (a
+diagnostic, a save-state resume) could get back through it. `sc` now records
+its return site in ctx->sc_ra (LR is untouched, as on hardware).
+--legacy-indirect-lr / PPU_LIFT_LEGACY_INDIRECT_LR=1 restores the old
+emission byte for byte, including the header without sc_ra.
+
+Checks: the emission of each form in both modes; that `sc` is still
+classified as a terminator for fall-through purposes exactly as before; the
+header field and its layout twin in runtime/ppu/ppu_context.h; and a real
+parallel (--jobs 2) CLI lift of a raw image, so the flags are known to reach
+the worker processes, from the command line and from the environment.
+
+Run: py -3 tools/test_ppu_indirect_lr.py
+"""
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+sys.path.insert(0, TOOLS)
+
+import ppu_disasm                                      # noqa: E402
+from ppu_disasm import Instruction                     # noqa: E402
+from ppu_lifter import (PPULifter, LiftedFunction,     # noqa: E402
+                        HEADER_PREAMBLE, _HEADER_PREAMBLE_LEGACY,
+                        _last_line_is_terminator)
+
+FAILS = []
+
+
+def check(cond, msg):
+    if not cond:
+        FAILS.append(msg)
+        print("FAIL:", msg)
+
+
+def emit(mnemonic, operands="", addr=0x1000, legacy=False):
+    lifter = PPULifter(prefix="")
+    lifter.legacy_indirect_lr = legacy
+    func = LiftedFunction(name="f", start_addr=0x1000, end_addr=0x2000)
+    return lifter._translate_op(Instruction(addr, 0, mnemonic, operands), func)
+
+
+def test_emission():
+    # bctrl: LR = return address, then the dispatch.
+    check(emit("bctrl", addr=0x1230) ==
+          "ctx->lr = 0x00001234; ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx);",
+          "bctrl: " + emit("bctrl", addr=0x1230))
+    check(emit("bctrl", legacy=True) == "ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx);",
+          "bctrl legacy: " + emit("bctrl", legacy=True))
+
+    # blrl: the target is the OLD LR -- copied to CTR before LR is overwritten.
+    blrl = emit("blrl", addr=0x1230)
+    check(blrl == "ctx->ctr = (uint32_t)ctx->lr; ctx->lr = 0x00001234; "
+                  "ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx);", "blrl: " + blrl)
+    check(emit("blrl", legacy=True) ==
+          "ctx->ctr = (uint32_t)ctx->lr; ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx);",
+          "blrl legacy")
+
+    # b<cond>ctrl: LK=1 writes LR whether or not the branch is taken.
+    bc = emit("beqctrl", "cr7", addr=0x1230)
+    check(bc.startswith("ctx->lr = 0x00001234; if (") and bc.endswith(
+          "{ ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx); }"), "beqctrl: " + bc)
+    check("((ctx->cr >> 0) & 2)" in bc, "beqctrl cr7 condition: " + bc)
+    check(emit("beqctrl", "cr7", legacy=True) ==
+          "if (((ctx->cr >> 0) & 2)) { ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx); }",
+          "beqctrl legacy")
+    # ... and the no-link conditional tail jump is untouched in both modes.
+    for lg in (False, True):
+        t = emit("beqctr", "cr7", legacy=lg)
+        check(t == "if (((ctx->cr >> 0) & 2)) { ps3_indirect_call(ctx); "
+                   "DRAIN_TRAMPOLINE(ctx); return; }", f"beqctr (legacy={lg}): {t}")
+        check(emit("bctr", legacy=lg) == "ps3_indirect_call(ctx); return;", "bctr")
+
+    # b<cond>lrl: old LR captured, LR written unconditionally, call if taken.
+    bl = emit("bnelrl", "cr7", addr=0x1230)
+    check(bl == "{ uint64_t _lrt = ctx->lr; ctx->lr = 0x00001234; "
+                "if ((!((ctx->cr >> 0) & 2))) { ctx->ctr = (uint32_t)_lrt; "
+                "ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx); } }", "bnelrl: " + bl)
+    check(emit("bnelrl", "cr7", legacy=True) ==
+          "if ((!((ctx->cr >> 0) & 2))) { ctx->ctr = (uint32_t)ctx->lr; "
+          "ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx); }", "bnelrl legacy")
+    bd = emit("bdnzlrl", addr=0x1230)
+    check("((ctx->ctr = (uint32_t)(ctx->ctr - 1)) != 0)" in bd and "_lrt" in bd, "bdnzlrl: " + bd)
+
+    # sc: return site in sc_ra, LR untouched.
+    sc = emit("sc", addr=0x1230)
+    check(sc == "ctx->sc_ra = 0x00001234; lv2_syscall(ctx);", "sc: " + sc)
+    check("ctx->lr" not in sc, "sc must not write LR")
+    check(emit("sc", legacy=True) == "lv2_syscall(ctx);", "sc legacy")
+
+    # bl and blr unchanged.
+    check(emit("bl", "0x1800", addr=0x1230) ==
+          "ctx->lr = 0x00001234; func_00001800(ctx); DRAIN_TRAMPOLINE(ctx);", "bl")
+    check(emit("blr") == "return;", "blr")
+
+    # Real encodings decode to the mnemonics used above.
+    for w, mn in ((0x4E800421, "bctrl"), (0x4E800021, "blrl"), (0x44000002, "sc"),
+                  (0x4D9E0421, "beqctrl"), (0x4C9E0021, "bnelrl")):
+        check(ppu_disasm.decode(w, 0x1000).mnemonic == mn, f"decode {w:#x} -> {mn}")
+
+
+def test_terminators():
+    # The fall-through classification must not move: `sc` ending a range was a
+    # terminator before the sc_ra store and still is; the call forms never were.
+    for lg in (False, True):
+        check(_last_line_is_terminator(["    " + emit("sc", legacy=lg)]),
+              f"sc terminator (legacy={lg})")
+        for mn, ops in (("bctrl", ""), ("blrl", ""), ("beqctrl", "cr7"), ("bnelrl", "cr7")):
+            check(not _last_line_is_terminator(["    " + emit(mn, ops, legacy=lg)]),
+                  f"{mn} must not be a terminator (legacy={lg})")
+
+
+def test_header():
+    check("uint32_t sc_ra;" in HEADER_PREAMBLE, "HEADER_PREAMBLE lacks sc_ra")
+    check("#define PPU_CONTEXT_HAS_SC_RA 1" in HEADER_PREAMBLE, "HEADER_PREAMBLE lacks the macro")
+    check("sc_ra" not in _HEADER_PREAMBLE_LEGACY, "legacy header must not have sc_ra")
+    # sc_ra is the LAST field, right after `int reserve_valid` (so it sits in
+    # the old tail padding and sizeof is unchanged), and the only addition.
+    new_s = HEADER_PREAMBLE[HEADER_PREAMBLE.index("typedef struct ppu_context"):]
+    new_s = new_s[:new_s.index("} ppu_context;")]
+    check(new_s.rstrip().endswith(
+        "int      reserve_valid; /* lwarx/stwcx. reservation flag    */\n"
+        "    uint32_t sc_ra;         /* return address of the last `sc` (lifter-written) */"),
+        "sc_ra must be a uint32_t right after reserve_valid, last")
+    check(HEADER_PREAMBLE.replace(
+        "    uint32_t sc_ra;         /* return address of the last `sc` (lifter-written) */\n", ""
+    ).replace("#define PPU_CONTEXT_HAS_SC_RA 1\n", "") == _HEADER_PREAMBLE_LEGACY,
+        "new header = legacy header + sc_ra + macro, nothing else")
+    for lg in (False, True):
+        lifter = PPULifter(prefix="libsre_")
+        lifter.legacy_indirect_lr = lg
+        h = lifter.emit_header()
+        check(("sc_ra" in h) != lg, f"emit_header legacy={lg}")
+        check("libsre_function_table" in h, "prefix still applied")
+    # The runtime twin has the same field, last, under the same macro.
+    ctxh = open(os.path.join(ROOT, "runtime", "ppu", "ppu_context.h")).read()
+    body = ctxh[ctxh.index("typedef struct ppu_context"):ctxh.index("} ppu_context;")]
+    fields = re.findall(r"^\s+(?:__declspec\(align\(16\)\) )?\w+\s+(\w+)(?:\[\d+\])?", body, re.M)
+    check(fields[-2:] == ["reserve_valid", "sc_ra"],
+          f"runtime ppu_context.h last fields: {fields[-3:]}")
+    check(re.search(r"^\s+uint32_t\s+sc_ra;", body, re.M) is not None,
+          "runtime ppu_context.h: sc_ra must be uint32_t (old tail padding)")
+    check("#define PPU_CONTEXT_HAS_SC_RA 1" in ctxh, "runtime ppu_context.h lacks the macro")
+    check("offsetof(ppu_context, sc_ra)" in ctxh and "_Static_assert(" in ctxh,
+          "runtime ppu_context.h must static-assert the sc_ra placement / sizeof")
+
+
+# --- a real CLI lift of a raw image, parallel ------------------------------
+
+BASE = 0x10000
+
+
+def w_std(rs, ra, d, u=0): return (62 << 26) | (rs << 21) | (ra << 16) | (d & 0xFFFC) | u
+def w_ld(rt, ra, d):       return (58 << 26) | (rt << 21) | (ra << 16) | (d & 0xFFFC)
+def w_addi(rt, ra, s):     return (14 << 26) | (rt << 21) | (ra << 16) | (s & 0xFFFF)
+def w_bl(frm, to):         return (18 << 26) | ((to - frm) & 0x3FFFFFC) | 1
+
+
+MFLR_R0, MTLR_R0, MTCTR_R3, BCTRL, SC, BLR, NOP = (
+    0x7C0802A6, 0x7C0803A6, 0x7C6903A6, 0x4E800421, 0x44000002, 0x4E800020, 0x60000000)
+
+
+def image():
+    """func A @0x10000: frame, saves r31, bctrl, sc, bl B, epilogue.
+       func B @0x10100: blr."""
+    a = [MFLR_R0, w_std(31, 1, -8), w_std(0, 1, 16), w_std(1, 1, -0x80, 1),
+         MTCTR_R3, BCTRL,                 # +0x14: bctrl -> RA 0x10018
+         SC,                              # +0x18: sc    -> RA 0x1001C
+         0, 0,                            # +0x1C: bl B (patched below), nop
+         w_addi(1, 1, 0x80), w_ld(0, 1, 16), MTLR_R0, w_ld(31, 1, -8), BLR]
+    a[7] = w_bl(BASE + 0x1C, BASE + 0x100)
+    a[8] = NOP
+    words = a + [NOP] * ((0x100 - 4 * len(a)) // 4) + [BLR]
+    return b"".join(w.to_bytes(4, "big") for w in words)
+
+
+def lift(tmp, extra, env_add=None):
+    out = os.path.join(tmp, "out_" + str(abs(hash((tuple(extra), str(env_add))))))
+    env = dict(os.environ)
+    env.pop("PPU_LIFT_LEGACY_INDIRECT_LR", None)
+    env.pop("PPU_LIFT_SLOTCHECK", None)
+    env.update(env_add or {})
+    r = subprocess.run([sys.executable, os.path.join(TOOLS, "ppu_lifter.py"),
+                        os.path.join(tmp, "img.bin"), "--raw", "--base", hex(BASE),
+                        "--functions", os.path.join(tmp, "funcs.json"),
+                        "--jobs", "2", "-o", out] + extra,
+                       capture_output=True, text=True, env=env, timeout=300)
+    check(r.returncode == 0, f"lift {extra} {env_add}: rc={r.returncode}\n{r.stderr[-2000:]}")
+    src = "".join(open(os.path.join(out, f)).read()
+                  for f in sorted(os.listdir(out)) if f.endswith(".cpp"))
+    hdr = open(os.path.join(out, "ppu_recomp.h")).read()
+    return src, hdr, r.stdout
+
+
+def test_cli():
+    with tempfile.TemporaryDirectory() as tmp:
+        open(os.path.join(tmp, "img.bin"), "wb").write(image())
+        json.dump([{"start": hex(BASE), "end": hex(BASE + 0x100)},
+                   {"start": hex(BASE + 0x100), "end": hex(BASE + 0x104)}],
+                  open(os.path.join(tmp, "funcs.json"), "w"))
+        src, hdr, so = lift(tmp, [])
+        check("ctx->lr = 0x00010018; ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx);" in src,
+              "worker lift: bctrl store missing")
+        check("ctx->sc_ra = 0x0001001C; lv2_syscall(ctx);" in src, "worker lift: sc_ra missing")
+        check("ctx->lr = 0x00010020; func_00010100(ctx);" in src, "worker lift: bl")
+        check("sc_ra" in hdr, "header lacks sc_ra")
+        check("return-address stores: 1 indirect calls (ctx->lr), 1 sc (ctx->sc_ra)" in so,
+              "lift summary line: " + so[-400:])
+        check("ppu_slotcheck" not in src, "slotcheck must be off by default")
+        for extra, env_add in (([ "--legacy-indirect-lr"], None),
+                               ([], {"PPU_LIFT_LEGACY_INDIRECT_LR": "1"})):
+            lsrc, lhdr, _ = lift(tmp, extra, env_add)
+            check("ctx->lr = 0x00010018" not in lsrc and "sc_ra" not in lsrc,
+                  f"legacy lift {extra or env_add} still stores")
+            check("    ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx);" in lsrc
+                  and "    lv2_syscall(ctx);" in lsrc, "legacy emission")
+            check("sc_ra" not in lhdr, "legacy header has sc_ra")
+            check(lsrc == src.replace("ctx->lr = 0x00010018; ", "")
+                             .replace("ctx->sc_ra = 0x0001001C; ", ""),
+                  "legacy differs from the default lift by more than the two stores")
+        ssrc, _, so = lift(tmp, [], {"PPU_LIFT_SLOTCHECK": "cs"})
+        check("ppu_slotcheck(ctx, _scd, _sc_v, 0x00010018u, -0x80);" in ssrc,
+              "PPU_LIFT_SLOTCHECK=cs reaches the workers")
+        check("slotcheck(cs): 1 functions, 3 call sites" in so, "slotcheck stats: " + so[-400:])
+
+
+def main():
+    test_emission()
+    test_terminators()
+    test_header()
+    test_cli()
+    if FAILS:
+        print(f"{len(FAILS)} FAILED")
+        return 1
+    print("ok: indirect calls store LR, sc stores sc_ra, legacy is the old emission, "
+          "flags reach the workers")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/test_ppu_jumptables.py b/tools/test_ppu_jumptables.py
index 4eef694..cdf4ccf 100644
--- a/tools/test_ppu_jumptables.py
+++ b/tools/test_ppu_jumptables.py
@@ -52,6 +52,7 @@ def w_li(rt, si):          return (14 << 26) | (rt << 21) | (si & 0xFFFF)
 def w_addis(rt, ra, si):   return (15 << 26) | (rt << 21) | (ra << 16) | (si & 0xFFFF)
 def w_stdu(rs, ra, d):     return (62 << 26) | (rs << 21) | (ra << 16) | (d & 0xFFFC) | 1
 def w_bc(bo, bi, rel):     return (16 << 26) | (bo << 21) | (bi << 16) | (rel & 0xFFFC)
+def w_b(rel):              return (18 << 26) | (rel & 0x03FFFFFC)
 
 
 def w_mtctr(rs):
@@ -192,6 +193,36 @@ def test_two_level_base_past_early_return():
           [0x11100, 0x11200])
 
 
+def test_two_level_base_past_early_tail_call():
+    """Like the early-return vector, but the early exit is a TAIL CALL.
+
+        lwz    r30, 8(r2)        <- prologue: the base's base
+        cmplwi cr0, r3, 2
