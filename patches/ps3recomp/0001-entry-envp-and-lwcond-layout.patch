+    {
+        PadHostPortState raw, st;
+        padhost_state_neutral(&raw);
+        raw.lx = 128 + 20; raw.rx = 128 + 20;           /* ~16 % */
+        AcquireSRWLockExclusive(&s_snap_lock);
+        s_snap_owner[6] = 424242;
+        ReleaseSRWLockExclusive(&s_snap_lock);
+        ph_publish(6, 424242, &raw, PADHOST_KIND_XINPUT, PADHOST_BUS_OTHER, 0x045E, 0x02EA);
+        padhost_get(6, &st);
+        CHECK(st.lx == 128 && st.rx == 128, "XInput: 16 %% is inside 24 %% (%u %u)", st.lx, st.rx);
+        raw.lx = 128 + 40;                               /* ~31 % */
+        ph_publish(6, 424242, &raw, PADHOST_KIND_XINPUT, PADHOST_BUS_OTHER, 0x045E, 0x02EA);
+        padhost_get(6, &st);
+        CHECK(st.lx > 128 && st.lx < 128 + 20, "XInput: 31 %% -> rescaled from 24 %% (%u)", st.lx);
+        raw.lx = 128 + 20;
+        ph_publish(6, 424242, &raw, PADHOST_KIND_DUALSENSE, PADHOST_BUS_USB, 0x054C, 0x0CE6);
