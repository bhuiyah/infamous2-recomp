+
+/* Save states (M4c, KOBJ's teardown): a load leaves no sys_mutex live -- an
+ * image never holds one (asserted_empty), and whatever the session had goes
+ * with its threads. Every guest thread is gone by then, so no lock is waited
+ * for (one a discarded thread held is deleted with it) and the table is
+ * empty, as sys_mutex_init leaves it. */
+void sys_mutex_ss_teardown(void)
+{
+    for (int i = 0; i < SYS_MUTEX_MAX; i++) {
+        sys_mutex_info* m = &g_sys_mutexes[i];
+        if (!m->active) continue;
+#ifdef _WIN32
+        DeleteCriticalSection(&m->cs);
+        if (m->wait_handle) CloseHandle(m->wait_handle);
+#else
+        pthread_mutex_destroy(&m->mtx);
+#endif
+    }
+    memset(g_sys_mutexes, 0, sizeof(g_sys_mutexes));
