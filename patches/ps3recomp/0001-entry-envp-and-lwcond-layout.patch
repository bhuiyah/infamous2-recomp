+#define SPU__FX_FAST2(name, op)                                                         \
+SPU__SLOW2(name)                                                                        \
+SPU_FORCEINLINE u128 name(u128 a, u128 b) {                                             \
+    const __m128i A = spu__v(a), B = spu__v(b);                                         \
+    __m128i bad = SPU__FXDEN2(A, B);                                                    \
+    __m128 x_ = spu__f(A); SPU__OPAQUE(x_);                                             \
+    __m128i r = SPU__FXRES(op(x_, spu__f(B)), &bad);                                    \
+    if (SPU_HLP_UNLIKELY(spu__any(bad))) r = name##_slow(A, B);                         \
+    return spu__u(r); }
+SPU__FX_FAST2(spu_fa, _mm_add_ps)
+SPU__FX_FAST2(spu_fs, _mm_sub_ps)
+SPU__FX_FAST2(spu_fm, _mm_mul_ps)
+#undef SPU__FX_FAST2
+/* fms = fmaf(a, b, -c), fnms = fmaf(a, -b, c): a negated operand is exact. */
+#define SPU__FX_FAST3(name, na, nb, nc)                                                 \
+SPU__SLOW3(name)                                                                        \
+SPU_FORCEINLINE u128 name(u128 a, u128 b, u128 c) {                                     \
+    const __m128i A = spu__v(a), B = spu__v(b), C = spu__v(c);                          \
+    __m128i bad = SPU__FXDEN3(A, B, C);                                                 \
+    __m128 x_ = na(spu__f(A)); SPU__OPAQUE(x_);                                         \
+    const __m128 f = spu__fmadd(x_, nb(spu__f(B)), nc(spu__f(C)), &bad);                \
+    __m128i r = SPU__FXRES(f, &bad);                                                    \
+    if (SPU_HLP_UNLIKELY(spu__any(bad))) r = name##_slow(A, B, C);                      \
+    return spu__u(r); }
+#define SPU__FX_ID(x) (x)
+SPU__FX_FAST3(spu_fma,  SPU__FX_ID, SPU__FX_ID, SPU__FX_ID)
+SPU__FX_FAST3(spu_fms,  SPU__FX_ID, SPU__FX_ID, spu__fneg)
+SPU__FX_FAST3(spu_fnms, SPU__FX_ID, spu__fneg,  SPU__FX_ID)
+#undef SPU__FX_FAST3
+#undef SPU__FX_ID
+#undef SPU__OPAQUE
+#undef SPU__FXDEN2
+#undef SPU__FXDEN3
+#undef SPU__FXRES
+
+/* Compares: the reference's total order (sign-magnitude, -0 == +0 ==
+ * denormals) as two's-complement integers. Exact, no fallback. */
+SPU_FORCEINLINE __m128i spu__fxmag_v(__m128i x) {    /* |x|, denormals -> 0 */
+    const __m128i m = _mm_and_si128(x, spu__k(0x7FFFFFFFu));
+    return _mm_andnot_si128(_mm_cmplt_epi32(m, spu__k(0x00800000u)), m);
+}
+SPU_FORCEINLINE __m128i spu__fxkey_v(__m128i x) {
+    const __m128i s = _mm_srai_epi32(x, 31);
+    return _mm_sub_epi32(_mm_xor_si128(spu__fxmag_v(x), s), s);
+}
+SPU_FORCEINLINE __m128i spu__fceq_i(__m128i a, __m128i b) { return _mm_cmpeq_epi32(spu__fxkey_v(a), spu__fxkey_v(b)); }
