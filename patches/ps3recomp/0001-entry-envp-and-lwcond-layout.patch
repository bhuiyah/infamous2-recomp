+/* ---------------------------------------------------------------------------
+ * The system language. A PS3 reports the language set in its System Settings;
+ * a title picks its text and voice from it (inFamous 2 reads it once at boot).
+ * Here a settings-store row "language" stands in for that setting (see
+ * cellSysutil.h); the value is resolved once and kept, as on a PS3, where it
+ * cannot change while a game runs.
+ * -----------------------------------------------------------------------*/
+static const char* const s_lang_keys[CELL_SYSUTIL_LANG_COUNT] = {
+    "japanese", "english_us", "french", "spanish", "german", "italian", "dutch", "portuguese",
