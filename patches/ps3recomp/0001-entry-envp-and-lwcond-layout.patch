+/* Turn the feature's machinery on (first TEXDUMP / TEXPACK use): g_tp_on
+ * becomes 1, or 0 when it cannot run. */
+static void tp_rt_activate(void)
+{
+    if (g_tp_on == 1) return;
+    g_tp_on = 0;
+    if (s_tp.dead || !s_tp.dev) return;
+    const char* veto = tp_debug_veto();
+    if (veto) { tp_log("%s is set: texture dump and packs stay off (the upload does not read guest memory as the hardware does)", veto);
+                s_tp.dead = 1; return; }
+    if (tp_rt_device_init()) { s_tp.dead = 1; return; }
+    g_tp_on = 1;
+    tp_rt_start_threads();
+}
+
+static void tp_rt_startup(ID3D12Device* dev, ID3D12CommandQueue* dq)
+{
+    if (s_tp.started) return;
+    s_tp.started = 1;
+    s_tp.dev = dev; s_tp.dq = dq;
+    InitializeSRWLock(&s_tp.lk); InitializeConditionVariable(&s_tp.cv);
+    InitializeSRWLock(&s_tp.dlk); InitializeConditionVariable(&s_tp.dcv);
+    /* (s_tp.set_*: kept -- a setter called before this, e.g. by the settings
+     * store at startup, still applies at the first batch: it left g_tp_on 2) */
+    s_tp.dump = tp_cfg_dump(); s_tp.packs = tp_cfg_packs();
+    if (!s_tp.dump && !s_tp.packs) return;          /* the default: nothing at all */
+    tp_rt_activate();
+}
