+                    s_tc.st_fz ? s_tc.st_fz_cap_s * 1e6 / s_tc.st_fz : 0.0, 10);
+        if (tc_mipcfg()->on)
+            fprintf(stderr, "[TEXMIP] %u multi-level uploads (+%.1f MB below level 0) | sampler sets: %u built,"
+                            " peak %u/%d per frame, %u units pinned to level 0 by CONTROL0 max LOD |"
+                            " %u LN uploads laid out by the CONTROL3 pitch%c",
+                    s_tc.st_mipup, (double)s_tc.st_mipbytes / 1048576.0, s_tc.st_sampnew,
+                    s_tc.st_samp_peak, 128, s_tc.st_clamp0, s_tc.st_lnpitch, 10);
+        s_tc.st_mipup = s_tc.st_sampnew = s_tc.st_clamp0 = s_tc.st_samp_peak = s_tc.st_lnpitch = 0;
+        s_tc.st_mipbytes = 0;
+        s_tc.st_bind = s_tc.st_dedup = s_tc.st_clean = s_tc.st_rehash_same = s_tc.st_csum = 0;
+        s_tc.st_upload = s_tc.st_miss = s_tc.st_evict = s_tc.st_recreate = s_tc.st_overflow = 0;
+        s_tc.st_fail = 0; s_tc.st_upbytes = s_tc.st_hashbytes = 0; s_tc.st_val_s = s_tc.st_up_s = 0.0;
+        s_tcw.harvests = s_tcw.dirty_tracked = s_tcw.dirty_other = s_tcw.resets = s_tcw.hot_kept = 0;
+        s_tcw.rsx_kept = 0;
+        s_tcw.harvest_s = 0.0;
+    }
+    /* cellGcmSys's RSX copies report what they wrote: TEX_WW_RSX and the
+     * texture packs (rsx_write_note_hook). */
+    { extern void (*g_gcm_rsx_write_note)(u32 ea, u32 len);
+      void (*const want)(u32, u32) = (s_tcw.rsx_round || g_tp_on == 1) ? rsx_write_note_hook : NULL;
+      if (g_gcm_rsx_write_note != want) g_gcm_rsx_write_note = want; }
+    if (g_tp_on) tp_batch_hook();
+}
+
+/* First use in a batch: begin its write-tracking round (harvest). */
+static void tc_round_ensure(void)
+{
+    if (s_tc.round_batch == s_tc.batch) return;
+    s_tc.round_batch = s_tc.batch;
+    if (s_tc.ww) {
+        /* TX1 TEX_FENCE: every record of this batch precedes its fence, and
+         * the fence's harvest is still the latest: judge the slots by it (a
+         * write after the fence is the next batch's harvest's). */
+        const int fzj = tc_fz_judge(&s_tc.fz, s_tc.batch, s_d3d.draw_count);
+        if (fzj > 0) { s_tc.st_fz_used++; return; }
+        if (fzj < 0) s_tc.st_fz_unused++;      /* lapsed: its copies / watches no longer count */
+        if (s_tcw.bounds_stale) tc_rebuild_bounds();
+        tc_wt_round_begin();
+    }
+}
+
+/* TX1 TEX_FENCE: where vp_upload_tex_slot reads guest bytes -- the fence's copy
+ * of the slot (tex_fence_capture) for a read wholly inside it, else the guest
+ * memory. */
+typedef struct { const u8* cap; u32 ea, len; } tc_fzsrc;
+static inline const u8* tc_fz_src(const tc_fzsrc* s, u32 ea, u32 len)
+{
+    extern uint8_t* vm_base;
+    if (s->cap && ea - s->ea < s->len && len <= s->len - (ea - s->ea)) return s->cap + (ea - s->ea);
+    return vm_base + ea;
+}
+/* The fence's copy of slot ts for this replay, if it has one. */
+static inline tc_fzsrc tc_fz_srcmap(int ts)
+{
+    tc_fzsrc s = { NULL, 0u, 0u };
+    if (ts >= 0 && tc_fz_active(&s_tc.fz, (u32)ts, s_tc.batch) && s_tc.fz.capo[ts]) {
+        s.cap = s_tc.fz_cap + (s_tc.fz.capo[ts] - 1u);
+        s.ea = s_d3d.vp_tex[ts].off; s.len = s_d3d.vp_tex[ts].span;
+    }
+    return s;
+}
+/* The fence's copy of a texture that had no slot at it (tex_fence_capture_new),
+ * for the replay that creates its slot. */
+static tc_fzsrc tc_fz_newsrc(u32 off, u32 w, u32 h, u32 fmt, int cube, u32 kmips, u32 kpitch)
+{
+    tc_fzsrc s = { NULL, 0u, 0u };
+    if (s_tc.fz.used != s_tc.batch) return s;
+    for (u32 i = 0; i < s_tc.fzn_n; i++) {
+        const tc_fznew* e = &s_tc.fzn[i];
+        if (e->capo && e->id == s_tc.fz.id && e->off == off && e->w == w && e->h == h && e->fmt == fmt &&
+            e->cube == (u32)cube && e->kmips == kmips && e->kpitch == kpitch) {
+            s.cap = s_tc.fz_cap + (e->capo - 1u); s.ea = off; s.len = e->span;
+            s_tc.st_fz_newuse++;
+            break;
+        }
+    }
+    return s;
+}
+/* A watched / hashed slot of this replay was written after its fence (counted). */
+static void tc_fz_lost(u32 key, u32 span)
+{
+    s_tc.st_fz_lost++;
+    static int nl = 0; if (nl++ < 8)
+        fprintf(stderr, "[TEXFENCE] texture 0x%X (%u bytes) was written after the fence, before its replay: the"
+                        " draws before the fence read the newer bytes%c", key, span, 10);
+}
+
+/* Per-draw window entry for a resident slot: a copy of a prebuilt view. */
+static void srv_write_ex(u32 heap_slot, ID3D12Resource* res, DXGI_FORMAT fmt,
+                         UINT mapping, int cube);   /* fwd */
+static void tc_srv_bind(u32 heap_slot, int ts, DXGI_FORMAT fmt, UINT mapping, int cube)
+{
+    VPTexSlot* t = &s_d3d.vp_tex[ts];
+    /* (the heap test inline: tc_cpu_heap is a call per binding otherwise) */
+    if (!t->res || (!s_tc.cpu_heap && !tc_cpu_heap())) { srv_write_ex(heap_slot, t->res, fmt, mapping, cube); return; }
+    int k = 0;
+    while (k < TC_DESC_VARIANTS && !(t->dv[k].res == t->res && t->dv[k].fmt == fmt &&
+                                      t->dv[k].map == mapping && t->dv[k].cube == cube)) k++;
+    if (k == TC_DESC_VARIANTS) {
+        k = (int)(t->dv_next++ % TC_DESC_VARIANTS);
+        D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};     /* as srv_write_ex builds it, */
+        sv.Format = fmt;                              /* over every level of res    */
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sv.Shader4ComponentMapping = mapping;
+        sv.Texture2D.MipLevels = t->rmips ? t->rmips : 1u;
+        if (cube) {
+            sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURECUBE;
+            sv.TextureCube.MipLevels = t->rmips ? t->rmips : 1u;
+            sv.TextureCube.MostDetailedMip = 0;
+            sv.TextureCube.ResourceMinLODClamp = 0.0f;
+        }
+        D3D12_CPU_DESCRIPTOR_HANDLE h;
+        h.ptr = s_tc.cpu_base + (SIZE_T)(1u + (u32)ts * TC_DESC_VARIANTS + (u32)k) * s_d3d.srv_inc;
+        rth_desc(3, h.ptr, t->res, &sv, sizeof sv);   /* RT_STREAM_LOG */
+        s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, t->res, &sv, h);
+        t->dv[k].res = t->res; t->dv[k].fmt = fmt; t->dv[k].map = mapping; t->dv[k].cube = cube;
+    }
+    tc_copy_desc(heap_slot, s_tc.cpu_base + (SIZE_T)(1u + (u32)ts * TC_DESC_VARIANTS + (u32)k) * s_d3d.srv_inc);
+}
+
+/* TEX_HASHLOG=<n>: a line for each of the first n re-hashes (a page under a
+ * resident texture was written since its bytes were read): which texture,
+ * the bytes hashed, and whether they had changed. The [TEXCACHE] line only
+ * counts these; this names the textures re-validated every frame. */
+static void tc_hashlog(const VPTexSlot* c, int same)
+{
+    static int cap = -1, n = 0;
+    if (cap < 0) { const char* e = getenv("TEX_HASHLOG"); cap = e ? atoi(e) : 0; }
+    if (n >= cap) return;
+    n++;
+    fprintf(stderr, "[TEXHASH] batch %u key 0x%08X src 0x%08X %ux%u fmt 0x%02X%s span %u: %s%c",
+            s_tc.batch, c->key, c->off, c->w, c->h, c->fmt, c->cube ? " cube" : "", c->span,
+            same ? "same bytes" : "changed, re-uploaded", 10);
+}
+
+/* Level-0 bytes of one face: what the sparse checksum samples (DXT: whole
+ * block rows). */
+static u32 tc_level0_bytes(const rsx_tex_layout* tl, u32 w, u32 h)
+{
+    return tl->compressed ? tl->row_bytes * tl->rows : w * h * tl->bytes_per_texel;
+}
+
+/* --- guest mip levels: helpers for vp_upload_tex_slot -------------------- */
+
+/* Placed footprints for every subresource (face f, level m at f * nlv + m)
+ * of a texture whose levels are lv[0..nlv), as GetCopyableFootprints lays
+ * them out (rows 256-byte pitched, subresources 512-byte placed, a
+ * block-compressed level's footprint rounded up to whole 4x4 blocks), with no
+ * device call. Returns the bytes the upload buffer needs. */
+static u64 tc_footprints(DXGI_FORMAT dxfmt, const rsx_tex_level* lv, u32 nlv, u32 nfaces,
+                         D3D12_PLACED_SUBRESOURCE_FOOTPRINT* fp)
+{
+    u64 at = 0, end = 0;
+    for (u32 f = 0; f < nfaces; f++)
+        for (u32 m = 0; m < nlv; m++) {
+            const rsx_tex_layout* tl = &lv[m].tl;
+            D3D12_PLACED_SUBRESOURCE_FOOTPRINT* p = &fp[f * nlv + m];
+            at = (at + 511u) & ~511ull;
+            p->Offset = at;
+            p->Footprint.Format   = dxfmt;
+            p->Footprint.Width    = tl->compressed ? (lv[m].w + 3u) & ~3u : lv[m].w;
+            p->Footprint.Height   = tl->compressed ? (lv[m].h + 3u) & ~3u : lv[m].h;
+            p->Footprint.Depth    = 1;
+            p->Footprint.RowPitch = (tl->dst_row_bytes + 255u) & ~255u;
+            end = at + (u64)p->Footprint.RowPitch * (tl->rows - 1u) + tl->dst_row_bytes;
+            at += (u64)p->Footprint.RowPitch * tl->rows;
+        }
+    return end;
+}
+
+/* TEX_MIPTINT: paint one decoded level a solid colour (by level), keeping
+ * alpha -- so a screenshot shows which level each surface samples. RGBA8 and
+ * BC1/2/3 only (BC1 keeps its punch-through texels transparent). */
+static void tc_tint_level(u8* d, u32 dpitch, const rsx_tex_layout* tl, u32 w, u32 level)
+{
+    static const u8 col[7][3] = { {255,0,0}, {0,255,0}, {0,0,255}, {255,255,0},
+                                  {255,0,255}, {0,255,255}, {255,255,255} };
+    const u8* c = col[(level - 1u) < 7u ? level - 1u : 6u];
+    if (tl->fmt == RSX_TEXFMT_R8G8B8A8) {
+        for (u32 y = 0; y < tl->rows; y++)
+            for (u32 x = 0; x < w; x++) {
+                u8* p = d + (size_t)y * dpitch + (size_t)x * 4u;
+                p[0] = c[0]; p[1] = c[1]; p[2] = c[2];
+            }
+        return;
+    }
+    if (!tl->compressed) return;
+    const u16 c565 = (u16)(((c[0] >> 3) << 11) | ((c[1] >> 2) << 5) | (c[2] >> 3));
+    const u32 bb = tl->block_bytes, nblk = tl->dst_row_bytes / bb;
+    for (u32 y = 0; y < tl->rows; y++)
+        for (u32 b = 0; b < nblk; b++) {
+            u8* k = d + (size_t)y * dpitch + (size_t)b * bb + (bb == 16u ? 8u : 0u);
+            const u16 o0 = (u16)(k[0] | (k[1] << 8)), o1 = (u16)(k[2] | (k[3] << 8));
+            u32 idx = (u32)k[4] | ((u32)k[5] << 8) | ((u32)k[6] << 16) | ((u32)k[7] << 24), ni = 0;
+            if (bb == 8u && o0 <= o1)            /* BC1 3-colour block: keep index 3 = transparent */
+                for (u32 i = 0; i < 16u; i++) if (((idx >> (2u * i)) & 3u) == 3u) ni |= 3u << (2u * i);
+            k[0] = k[2] = (u8)c565; k[1] = k[3] = (u8)(c565 >> 8);   /* c0 == c1: index 0 = colour */
+            k[4] = (u8)ni; k[5] = (u8)(ni >> 8); k[6] = (u8)(ni >> 16); k[7] = (u8)(ni >> 24);
+        }
+}
+
+/* TEX_MIPDUMP: a DXT block row decoded to RGBA8 (BC1/2/3 = DXT1/23/45). */
+static void tc_bc_decode_rgba(u8* out, u32 opitch, const u8* src, u32 w, u32 h, u32 bb, int bcn)
+{
+    for (u32 by = 0; by < (h + 3u) / 4u; by++)
+        for (u32 bx = 0; bx < (w + 3u) / 4u; bx++) {
+            const u8* blk = src + ((size_t)by * ((w + 3u) / 4u) + bx) * bb;
+            const u8* cb = bb == 16u ? blk + 8 : blk;
+            const u32 c0 = (u32)cb[0] | ((u32)cb[1] << 8), c1 = (u32)cb[2] | ((u32)cb[3] << 8);
+            u8 pal[4][4];
+            for (int i = 0; i < 2; i++) {
+                const u32 c = i ? c1 : c0;
+                pal[i][0] = (u8)(((c >> 11) & 31u) * 255u / 31u);
+                pal[i][1] = (u8)(((c >> 5) & 63u) * 255u / 63u);
+                pal[i][2] = (u8)((c & 31u) * 255u / 31u);
+                pal[i][3] = 255;
+            }
+            const int four = bcn != 1 || c0 > c1;
+            for (int ch = 0; ch < 3; ch++) {
+                pal[2][ch] = (u8)(four ? (2u * pal[0][ch] + pal[1][ch]) / 3u : (pal[0][ch] + pal[1][ch]) / 2u);
+                pal[3][ch] = (u8)(four ? (pal[0][ch] + 2u * pal[1][ch]) / 3u : 0u);
+            }
+            pal[2][3] = 255; pal[3][3] = four ? 255 : 0;
+            const u32 idx = (u32)cb[4] | ((u32)cb[5] << 8) | ((u32)cb[6] << 16) | ((u32)cb[7] << 24);
+            u8 a8[8] = {0};
+            if (bcn == 3) {
+                a8[0] = blk[0]; a8[1] = blk[1];
+                for (int i = 2; i < 8; i++)
+                    a8[i] = (u8)(blk[0] > blk[1]
+                        ? ((8 - i) * blk[0] + (i - 1) * blk[1]) / 7
+                        : (i < 6 ? ((6 - i) * blk[0] + (i - 1) * blk[1]) / 5 : (i == 6 ? 0 : 255)));
+            }
+            const u64 abits = bcn == 3 ? ((u64)blk[2] | ((u64)blk[3] << 8) | ((u64)blk[4] << 16) |
+                                          ((u64)blk[5] << 24) | ((u64)blk[6] << 32) | ((u64)blk[7] << 40)) : 0;
+            for (u32 i = 0; i < 16u; i++) {
+                const u32 x = bx * 4u + (i & 3u), y = by * 4u + (i >> 2);
+                if (x >= w || y >= h) continue;
+                u8* p = out + (size_t)y * opitch + (size_t)x * 4u;
+                memcpy(p, pal[(idx >> (2u * i)) & 3u], 4);
+                if (bcn == 2) p[3] = (u8)(((blk[i >> 1] >> (4u * (i & 1u))) & 15u) * 17u);
+                else if (bcn == 3) p[3] = a8[(abits >> (3u * i)) & 7u];
+            }
+        }
+}
+
+/* TEX_MIPDUMP: every uploaded level of face 0 as an RGB BMP (+ alpha), named
+ * with the upload's sequence number `seq`; first a line with where the bytes
+ * came from and what level 0's guest bytes look like (`guest` = face 0's
+ * level 0 in guest memory). */
+static void tc_mipdump(u32 key_off, u32 src_off, u32 fmt, const rsx_tex_level* lv, u32 nlv, const u8* up,
+                       const D3D12_PLACED_SUBRESOURCE_FOOTPRINT* fp, const u8* guest, int seq)
+{
+    { const u32 nb = lv[0].tl.face_bytes; u32 nz = 0, ff = 0;
+      for (u32 i = 0; i < nb; i++) { nz += guest[i] != 0; ff += guest[i] == 0xFF; }
+      char hx[16 * 3 + 1]; int at = 0;
+      for (u32 i = 0; i < 16u && i < nb; i++) at += snprintf(hx + at, sizeof hx - (size_t)at, "%02X ", guest[i]);
+      hx[at ? at - 1 : 0] = 0;
+      fprintf(stderr, "[TEXMIP] dump #%d (batch %u): key 0x%08X src 0x%08X %ux%u fmt 0x%02X, %u level(s) |"
+                      " level 0: %u bytes, %u non-zero, %u 0xFF | first bytes %s%c",
+              seq, s_tc.batch, key_off, src_off, lv[0].w, lv[0].h, fmt, nlv, nb, nz, ff, hx, 10); }
+    for (u32 m = 0; m < nlv; m++) {
+        const rsx_tex_layout* tl = &lv[m].tl;
+        const u32 w = lv[m].w, h = lv[m].h;
+        u8* rgba = (u8*)malloc((size_t)w * h * 4u);
+        if (!rgba) return;
+        const u8* src = up + fp[m].Offset;
+        const u32 sp = fp[m].Footprint.RowPitch;
+        if (tl->compressed) {
+            /* re-pack the block rows tightly for the decoder */
+            u8* blocks = (u8*)malloc((size_t)tl->dst_row_bytes * tl->rows);
+            if (!blocks) { free(rgba); return; }
+            for (u32 y = 0; y < tl->rows; y++) memcpy(blocks + (size_t)y * tl->dst_row_bytes, src + (size_t)y * sp, tl->dst_row_bytes);
+            tc_bc_decode_rgba(rgba, w * 4u, blocks, w, h, tl->block_bytes,
+                              tl->fmt == RSX_TEXFMT_BC1 ? 1 : tl->fmt == RSX_TEXFMT_BC2 ? 2 : 3);
+            free(blocks);
+        } else {
+            for (u32 y = 0; y < h; y++)
+                for (u32 x = 0; x < w; x++) {
+                    const u8* s = src + (size_t)y * sp + (size_t)x * tl->dst_bytes_per_texel;
+                    u8* p = rgba + ((size_t)y * w + x) * 4u;
+                    if (tl->fmt == RSX_TEXFMT_R8G8B8A8) memcpy(p, s, 4);
+                    else if (tl->fmt == RSX_TEXFMT_R8G8) { p[0] = s[0]; p[1] = s[1]; p[2] = 0; p[3] = 255; }
+                    else { p[0] = p[1] = p[2] = s[0]; p[3] = 255; }
+                }
+        }
+        for (int pass = 0; pass < 2; pass++) {
+            if (pass) for (size_t i = 0; i < (size_t)w * h; i++) rgba[i*4] = rgba[i*4+1] = rgba[i*4+2] = rgba[i*4+3];
+            char pn[160];
+            snprintf(pn, sizeof pn, "texmip_%08X_fmt%02X_L%u_%ux%u_u%02d%s.bmp", key_off, fmt, m, w, h, seq,
+                     pass ? "_a" : "");
+            cap_write_bmp(pn, rgba, w, h, w * 4u, DXGI_FORMAT_R8G8B8A8_UNORM);
+            if (!pass) fprintf(stderr, "[TEXMIP] dumped %s%c", pn, 10);
+        }
+        free(rgba);
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * Texture dump / replacement packs (rsx_texpack*.h): the backend's hooks.
+ * Each runs only when g_tp_on (TEXDUMP=1 / TEXPACK=1, or a live setter); with
+ * both off -- the default, the PS3 original -- each hook is one test of that
+ * flag and the output is unchanged.
+ * -----------------------------------------------------------------------*/
+static void tp_gcm_write_note(u32 ea, u32 len) { tp_rt_note_rsx_write(ea, len); }
+/* g_gcm_rsx_write_note (set in tc_batch_begin): the packs' note (g_tp_on == 1,
+ * as before) and the write-watch tracker's (TEX_WW_RSX). */
+/* TX1 TEX_FENCE: an RSX copy wrote [ea, ea+len) while the records before a
+ * fence are pending: a marked RSX-kept slot there no longer holds its bytes at
+ * the fence (counted, once a slot a fence; the replay's hash compare counts it
+ * too with the diagnostic TEX_FENCE_RSX_HASH=1). */
+static void tex_fence_rsx_note(u32 ea, u32 len)
+{
+    for (u32 i = 0; i < s_tc.fz_rsxn; i++) {
+        const u32 a = s_tc.fz_rsx[i][0], l = s_tc.fz_rsx[i][1];
+        if (!l || ea >= a + l || a >= ea + len) continue;
+        s_tc.fz_rsx[i][1] = 0; s_tc.st_fz_rsxw++;
+        static int nw = 0; if (nw++ < 8)
+            fprintf(stderr, "[TEXFENCE] an RSX copy (0x%X, %u bytes) wrote texture 0x%X after its fence, before the"
+                            " replay of the draws before it%c", ea, len, a, 10);
+    }
+}
+static void rsx_write_note_hook(u32 ea, u32 len)
+{
+    if (g_tp_on == 1) tp_gcm_write_note(ea, len);
+    tc_wt_rsx_write(ea, len);
+    if (s_tc.fz_rsxn && s_tc.fz.batch == s_tc.batch + 1u) tex_fence_rsx_note(ea, len);
+}
+
+/* tc_batch_begin. (s_d3d.frame_count is a once-a-second fps count: the
+ * runtime turns it into its own monotonic s_tp.frame, which the hooks use.) */
+static void tp_batch_hook(void)
+{
+    tp_rt_batch_begin(s_tc.batch, (uint64_t)s_d3d.frame_count, perf_on());
+    /* (g_gcm_rsx_write_note: tc_batch_begin, rsx_write_note_hook) */
+}
+
+/* vp_upload_tex_slot, after an upload into slot t: its identity. The cache's
+ * own hash is the pack hash when it hashed exactly the canonical stream:
+ * write watch, the v2 function, every guest level uploaded (tp_rt_identify
+ * also checks that the layout is contiguous and the span is the stream). */
+static void tp_note_upload(VPTexSlot* t, int newkey, u32 w, u32 h, u32 fmt, int cube, u32 kmips, u32 kpitch,
+                           u32 nlv, u32 src_span, const u8* src)
+{
+    const tp_desc d = { fmt, w, h, kmips, cube, kpitch };
+    int v2 = s_tc_hashfn == tc_hash64_v2;
+#ifdef TC_HAVE_AVX512_PATH
+    v2 |= s_tc_hashfn == tc_hash64_v2_avx512;
+#endif
+    const int reuse = s_tc.ww && v2 && nlv == rsx_texture_level_count(w, h, kmips);
+    tp_rt_identify(&t->tp, newkey, &d, src, t->off, reuse ? t->hash : 0, reuse ? src_span : 0,
+                   s_tc.batch, s_tp.frame, 1);
+}
+
+/* The prepass, after vp_upload_tex_slot gave unit u of draw dr the slot ts:
+ * bind the slot's replacement instead of the original when it has a usable
+ * one. The view takes the original's crossbar mapping (the replacement holds
+ * the same channels in the same order: its class) and the draw keeps its
+ * gamma / expand / signed constants, so every per-draw texture rule applies
+ * unchanged. A unit the program samples with TXL keeps the original unless
+ * the replacement has the same size and levels. Returns 1 when bound. */
+static int tp_bind_unit(u32 wslot, int ts, D3D12DrawRecord* dr, int u, u32 basef, int cube)
+{
+    VPTexSlot* t = &s_d3d.vp_tex[ts];
+    const tp_desc d = { t->fmt, t->w, t->h, t->kmips, t->cube, t->kpitch };
+    const tc_fzsrc fzs = tc_fz_srcmap(ts);          /* TX1: the fence's copy, if this replay read that */
+    tp_rep* r = tp_rt_bind(&t->tp, &d, tc_fz_src(&fzs, t->off, t->span), t->off, dr->tex[u].fword, s_tc.batch,
+                           s_tp.frame);
+    if (s_tp.dump && (t->tp.flags & TP_F_HASHED) && !(t->tp.flags & TP_F_NODUMP))
+        tp_rt_note_use(&t->tp, dr->fp_id, (u32)u, t->fmt, dr->tex[u].ctrl1, dr->tex[u].addr, dr->tex[u].filt,
+                       (int)((dr->fp_txlmask >> u) & 1u), dr->fp_alpha_en, (dr->alpha_ctl >> 8) & 0xFFu,
+                       dr->alpha_ctl & 0xFFu);
+    if (!r) return 0;
+    const u32 vlv = tp_view_levels(r->levels, t->rmips, r->s);
+    if (((dr->fp_txlmask >> u) & 1u) && !(r->s == 0 && vlv == t->rmips)) { s_tp.st_txl++; return 0; }
+    if ((r->faces == 6) != (cube != 0)) return 0;
+    if (!s_tc.cpu_heap && !tc_cpu_heap()) return 0;
+    const UINT map = (basef == 0x81 && !tex_b8xbar_on()) ? 0x1000 : rsx_remap_to_d3d(dr->tex[u].ctrl1, basef);
+    const SIZE_T v = tp_rt_rep_view(r, map, cube, vlv);
+    if (!v) return 0;
+    tc_copy_desc(wslot, v);
+    dr->tex[u].tp_ls = (u8)(r->s + 8);
+    s_tp.st_bind++;
+    return 1;
+}
+
+static int vp_upload_tex_slot(u32 off, u32 w, u32 h, u32 fmt, int cube, u32 mips, u32 ctrl3_pitch)
+{
+    /* TEX_BUDGET=<n>: cap texture uploads per frame. Off by default -- it was
+     * tried against the TDR and does not help, because PERF shows the upload
+     * path costing 0.01s for 775 calls. Kept because it is the right lever if a
+     * title ever does hit an upload-bound frame. */
+    { static int budget = -1;
+      if (budget < 0) { const char* e = getenv("TEX_BUDGET"); budget = e ? atoi(e) : 0; }
+      if (budget > 0) {
+          static u64 last_frame = ~0ull; static int used = 0;
+          if (last_frame != (u64)s_d3d.frame_count) { last_frame = (u64)s_d3d.frame_count; used = 0; }
+          if (++used > budget) return -1;   /* try again next frame */
+      } }
+    extern uint8_t* vm_base;
+
+    if (!off || !w || !h || !vm_base || !s_d3d.srv_heap) return -1;
+    const u32 key_off = off;         /* lookup key: the offset as bound */
+    const tc_mipcfg_t* const mc = tc_mipcfg();
+    /* Key: the guest's level count (how much is uploaded, and a cube's face
+     * stride) and a LINEAR texture's pitch (its rows, every level) shape the
+     * guest layout. TEX_MIPS=0: level 0 only -- the levels only matter to a
+     * cube's face stride, and the pitch is not read, exactly as before. */
+    const u32 kmips  = mc->on ? tc_guest_levels(w, h, mips) : (cube ? mips : 0u);
+    const u32 kpitch = (mc->on && mc->pitch && (fmt & 0x20u)) ? ctrl3_pitch : 0u;
+    /* The layout (rsx_texture_layout) is only needed to upload, so a binding
+     * the cache answers -- nearly every one of the thousands in a gameplay
+     * frame -- skips it (a call into another object file per binding, ~0.3%
+     * of the render thread). It is a pure function of (fmt, w, h). */
+    tc_init();
+    s_tc.st_bind++;
+    int slot = tc_map_find(key_off, w, h, fmt, cube, kmips, kpitch);
+    /* Bound this batch already: no round is needed (the first bind of the
+     * slot in this batch began it, or was volatile, and so is this one -- the
+     * same key decides the same way). */
+    if (slot >= 0 && s_d3d.vp_tex[slot].use_batch == s_tc.batch) { s_tc.st_dedup++; return slot; }
+    /* REPORT_TEX_VOLATILE (default 1): a small texture over report records
+     * the exact report path writes (the gate's sun glow: the 4x2 Y16_X16
+     * pair at IO 0x14080) is rewritten by every delivery, and every delivery
+     * flushes into a new batch -- so its validation started a write-watch
+     * round (a harvest, ~0.12 ms) per bind for a "changed" known in advance.
+     * Such a bind starts no round and re-reads the bytes (still once per
+     * batch, below); the slot stays untracked. Bounds: 16 bytes a texel (every
+     * format), the LN pitch when wider, x6 a cube, x2 mipmaps. */
+    int vol = 0;
+    { static int en = -1;
+      if (en < 0) { const char* e = getenv("REPORT_TEX_VOLATILE"); en = (e && *e == '0') ? 0 : 1; }
+      if (en && !s_tp.dump && (u64)w * h <= 1024u) {
+          u64 row = (u64)w * 16u;
+          if ((fmt & 0x20u) && ctrl3_pitch > row) row = ctrl3_pitch;
+          const u64 span = row * h * (cube ? 6u : 1u) * (mips > 1u ? 2u : 1u);
+          vol = span <= 4096u && rsx_report_written_overlap(key_off, (u32)span);
+      } }
+    if (!vol) tc_round_ensure();
+    /* TX1 TEX_FENCE (after the round is judged): a slot this replay's fence
+     * copied is validated and uploaded from the copy, not from guest memory a
+     * write after the fence may have changed; a watched / hashed one is
+     * checked for such a write (counted). Only for the batch the fence holds. */
+    tc_fzsrc fzs = tc_fz_srcmap(slot);
+    const int fzw = (slot >= 0 && !fzs.cap && tc_fz_active(&s_tc.fz, (u32)slot, s_tc.batch)) ? s_tc.fz.watch[slot] : 0;
+    int fzl = 0;                                     /* counted lost already */
+    s_tc.st_vol += (u32)vol;
+    u32 pre_csum = 0; int have_csum = 0;     /* computed by the validation below */
+    u64 pre_hash = 0; int have_hash = 0;
+    if (slot >= 0) {
+        VPTexSlot* c = &s_d3d.vp_tex[slot];
+        if (vol || c->vol) goto tc_reupload;   /* volatile, or untracked by an earlier volatile upload */
+        { static int nocache = -1;            /* TEX_NOCACHE=1: always re-upload */
+          if (nocache < 0) { const char* e = getenv("TEX_NOCACHE");
+                             nocache = e ? atoi(e) : 0; }
+          if (nocache) goto tc_reupload; }
+        /* Held from an earlier batch: re-upload only if the guest bytes
+         * changed. Most of this scene's textures are static, and converting
+         * every one of them every frame was ~70% of the frame's CPU time. */
+        { const double t0 = perf_on() ? perf_now() : 0.0;
+          int ok;
+          if (s_tc.ww) {
+              ok = !tc_wt_dirty_since(c->trk_off, c->trk_len, c->vround);
+              if (ok) {
+                  s_tc.st_clean++;
+                  if (pf3_verify_on() && s_tfv_bind) {    /* before its fence: tfv_check judges it */
+                      if (tc_hash64(vm_base + c->off, c->span) != c->hash) s_pf3v.fz_later++;
+                  } else if (pf3_verify_on()) {           /* PF3_VERIFY: is "clean" true? */
+                      s_pf3v.tc_cmp++;
+                      if (tc_hash64(vm_base + c->off, c->span) != c->hash) {
+                          s_pf3v.tc_stale++; s_pf3v.tc_bytes += c->span;
+                          static int nstale = 0; if (nstale++ < 8)
+                              fprintf(stderr, "[PF3VERIFY] a clean bind's bytes differ: texture 0x%X (at 0x%X) %ux%u"
+                                              " fmt 0x%02X, %u bytes, verified in round %u, now round %u, frame %llu%c",
+                                      key_off, c->off, w, h, fmt, c->span, c->vround, s_tcw.round,
+                                      (unsigned long long)s_d3d.frame_count, 10);
+                      }
+                  }
+              } else {
+                  /* A page under it was written: the bytes decide. Hashed
+                   * BEFORE any re-read, so a write racing the upload below can
+                   * only make the next validation see a mismatch. */
+                  /* TX1 TEX_FENCE: a watched slot (the fence's harvest, or a
+                   * reset, left its pages clean) asked before and after this
+                   * read; a hashed one (RSX-kept pages) compared with its hash
+                   * at the fence. Written since: the memory is newer than the
+                   * bytes at the fence (counted). */
+                  if (fzw == TC_FZ_HASH && s_tc.fz.hash[slot] == c->hash) {
+                      /* hashed, and at the fence its bytes were the ones
+                       * the slot holds: the draws before the fence read
+                       * those, whatever came since (its pages stay dirty:
+                       * the next batch's validation sees it) -- the fence's
+                       * hash stands in for this one, nothing is read */
+                      pre_hash = c->hash; have_hash = 1; ok = 1;
+                      c->vround = s_tcw.round; s_tc.st_rehash_same++; s_tc.st_fz_rsxsame++;
+                      tc_hashlog(c, ok);
+                  } else {
+                  fzl = fzw == TC_FZ_WATCH && tc_wt_written_now(c->trk_off, c->trk_len);
+                  pre_hash = tc_hash64(tc_fz_src(&fzs, c->off, c->span), c->span); have_hash = 1;
+                  if (!fzl && fzw == TC_FZ_WATCH) fzl = tc_wt_written_now(c->trk_off, c->trk_len);
+                  if (!fzl && fzw == TC_FZ_HASH) fzl = pre_hash != s_tc.fz.hash[slot];
+                  if (fzl) tc_fz_lost(key_off, c->span);
+                  s_tc.st_hashbytes += c->span;
+                  ok = (pre_hash == c->hash);
+                  if (ok) { c->vround = s_tcw.round; s_tc.st_rehash_same++; }
+                  tc_hashlog(c, ok);
+                  }
+              }
+          } else {
+              /* the bytes the upload sampled: every uploaded level and face
+               * (c->span), or level 0 of face 0 with TEX_MIPS=0 */
+              u32 nb;
+              if (mc->on) nb = c->span;
+              else { rsx_tex_layout tl0; rsx_texture_layout(fmt, w, h, &tl0); nb = tc_level0_bytes(&tl0, w, h); }
+              pre_csum = tex_csum(vm_base + c->off, nb); have_csum = 1;
+              s_tc.st_csum++;
+              ok = (pre_csum == c->csum);
+          }
+          if (perf_on()) s_tc.st_val_s += perf_now() - t0;
+          if (ok) { c->use_batch = s_tc.batch; return slot; } }
+        /* stale: fall through and redo it in place */
+    }
+tc_reupload:;
+    /* Format classes (base = fmt & 0x9F). The LBP loading screen uses:
+     * 0x85 A8R8G8B8 (swizzled UI art), 0x8B G8B8 (the 1024x2048 linear FONT
+     * atlas -- without it no text renders at all), 0x86/87/88 DXT1/23/45
+     * (512x512 detail/LUT layers bound at t1/t3 on every draw). */
+    /* Format class, row sizes and swizzling are RSX semantics: rsx_texture_
+     * layout.c owns them so the Metal backend can read a guest texture without
+     * re-deriving any of it. Only the DXGI mapping below is ours. */
+    rsx_tex_layout tl;
+    rsx_texture_layout(fmt, w, h, &tl);
+    u32 basef = fmt & 0x9F;              /* still needed for the SRV remap */
+    int argb = (tl.fmt == RSX_TEXFMT_R8G8B8A8);
+    int dxt  = tl.compressed;
+    /* Compressed rows are counted in blocks, so keep bpp at 1 for the byte
+     * arithmetic the diagnostics below do. */
+    u32 bpp = tl.compressed ? 1u : tl.bytes_per_texel;
+    /* The DECODED image's format, which is not always the guest's: the packed
+     * 16-bit colour formats arrive here unpacked to RGBA8, and DEPTH24_D8 as a
+     * float. rsx_texture_layout.h says which class each format byte lands in. */
+    DXGI_FORMAT dxfmt = (tl.fmt == RSX_TEXFMT_R8G8B8A8) ? DXGI_FORMAT_R8G8B8A8_UNORM
+                      /* COMPRESSED_HILO_S8: the bytes are two's complement */
+                      : (tl.fmt == RSX_TEXFMT_R8G8 && basef == 0x99u) ? DXGI_FORMAT_R8G8_SNORM
+                      : (tl.fmt == RSX_TEXFMT_R8G8)     ? DXGI_FORMAT_R8G8_UNORM
+                      : (tl.fmt == RSX_TEXFMT_BC1)      ? DXGI_FORMAT_BC1_UNORM
+                      : (tl.fmt == RSX_TEXFMT_BC2)      ? DXGI_FORMAT_BC2_UNORM
+                      : (tl.fmt == RSX_TEXFMT_BC3)      ? DXGI_FORMAT_BC3_UNORM
+                      : (tl.fmt == RSX_TEXFMT_R16)      ? DXGI_FORMAT_R16_UNORM
+                      : (tl.fmt == RSX_TEXFMT_R16G16)   ? DXGI_FORMAT_R16G16_UNORM
+                      : (tl.fmt == RSX_TEXFMT_R16G16F)  ? DXGI_FORMAT_R16G16_FLOAT
+                      : (tl.fmt == RSX_TEXFMT_R16G16B16A16F) ? DXGI_FORMAT_R16G16B16A16_FLOAT
+                      : (tl.fmt == RSX_TEXFMT_R32F)     ? DXGI_FORMAT_R32_FLOAT
+                      : (tl.fmt == RSX_TEXFMT_R32G32B32A32F) ? DXGI_FORMAT_R32G32B32A32_FLOAT
+                      : DXGI_FORMAT_R8_UNORM;
+    /* DXT data is stored as linear 4x4 block rows (compressed formats are
+     * never Morton-swizzled on RSX). Row of blocks = (w/4)*blocksize. */
+    u32 blkrow  = dxt ? tl.row_bytes : 0;
+    u32 blkrows = dxt ? tl.rows      : 0;
+    /* Level-0 bytes of one face: what the sparse checksum samples. */
+    const u32 nb0 = tc_level0_bytes(&tl, w, h);
+    /* The guest's mip chain (rsx_texture_mip_chain: each level packed right
+     * after the one above it, a LINEAR texture's rows at the pitch register)
+     * and how many of its levels are uploaded. TEX_MIPS=0: level 0 alone,
+     * laid out as rsx_texture_layout says (no pitch), as before. */
+    rsx_tex_level lv[RSX_MAX_TEXTURE_LEVELS];
+    u32 glv = 1u, nlv = 1u;
+    if (mc->on) {
+        glv = rsx_texture_mip_chain(fmt, w, h, mips, kpitch, lv);
+        nlv = tc_up_levels(glv);
+    } else {
+        lv[0].w = w; lv[0].h = h; lv[0].offset = 0; lv[0].tl = tl;
+    }
+    /* TEX_OFF_BIAS=1: sample the image one whole level-0 BELOW the bound offset.
+     * Measured on the Rubber Ducky demo: at the bind offset every texture reads
+     * as all-zero, while [off - w*h*bpp, off) holds the image (3800-4160 of 4298
+     * sampled bytes non-zero, for four different textures at three sizes). So
+     * the offset the guest programs points PAST level 0 rather than at it. */
+    /* TEX_OFF_BIAS: 1 = one level-0 below the bound offset, 2 = one full MIP
+     * CHAIN above it. The measured upload-to-bind deltas on the Rubber Ducky
+     * demo are 0x2AAB00 for a 2MB level 0 and 0x555580 for a 4MB one -- both
+     * exactly the mipmap pyramid total (L0 * 4/3), which is what the guest
+     * reserves per texture. */
+    { static int bias = -1;
+      if (bias < 0) { const char* e = getenv("TEX_OFF_BIAS"); bias = e ? atoi(e) : 0; }
+      if (bias == 1) { u32 sz = w * h * bpp; if (off > sz) off -= sz; }
+      else if (bias >= 2) {
+          u32 chain = 0;
+          for (u32 mw = w, mh = h; mw && mh; mw >>= 1, mh >>= 1) {
+              chain += mw * mh * bpp;
+              if (mw == 1 && mh == 1) break;
+          }
+          /* bias 3: only shift when the bound offset really is empty, so a
+           * texture that IS bound correctly keeps its own data. Applying the
+           * chain unconditionally fixes the mis-bound majority but breaks any
+           * correctly-bound minority, which shows up as objects going black. */
+          int shift = 1;
+          if (bias >= 3) {
+              u32 nz = 0, sz = w * h * bpp;
+              for (u32 i = 0; i < sz && i < 0x20000u; i += 97) if (vm_base[off + i]) nz++;
+              shift = (nz == 0);
+          }
+          if (shift) off += chain;
+      } }
+    /* TEX_REMAP=1: if the bound offset holds nothing, look the image up by size
+     * in the VRAM upload registry (cellGcmSys). For a title whose upload address
+     * and SET_TEXTURE_OFFSET disagree this puts the real bytes under the sampler
+     * without guessing a delta. */
+    { static int remap = -1;
+      if (remap < 0) { const char* e = getenv("TEX_REMAP"); remap = e ? atoi(e) : 0; }
+      if (remap) {
+        u32 nz = 0, sz = w * h * bpp;
+        for (u32 i = 0; i < sz && i < 0x20000u; i += 97) if (vm_base[off + i]) nz++;
+        if (!nz) {
+            extern u32 rsx_find_vram_upload(u32);
+            u32 alt = rsx_find_vram_upload(sz);
+            if (alt) {
+                static int _n = 0;
+                if (_n++ < 8) fprintf(stderr, "[TEXREMAP] 0x%08X (%ux%u, %u bytes) -> 0x%08X%c",
+                                      off, w, h, sz, alt, 10);
+                off = alt;
+            }
+        } } }
+    /* A stale cache entry (slot >= 0) is redone in its own slot; otherwise take
+     * an unused one or evict the least recently bound. */
+    if (slot < 0 && (slot = tc_alloc_slot(w, h, dxfmt, cube, nlv)) >= 0) {
+        s_tc.st_miss++;
+        tc_fz_forget(&s_tc.fz, (u32)slot);        /* TX1: another texture's copy / watch is not this one's */
+        if (s_tc.fzn_n) fzs = tc_fz_newsrc(key_off, w, h, fmt, cube, kmips, kpitch);   /* its bytes at the fence */
+    }
+    if (slot < 0) {                               /* every slot bound this batch */
+        static unsigned long n = 0;
+        if (++n <= 4 || (n & 1023ul) == 0)
+            fprintf(stderr, "[TEX] all %d texture slots in use this batch: 0x%08X %ux%u fmt 0x%02X "
+                    "samples nothing (#%lu)%c", VP_TEX_SLOTS, off, w, h, fmt, n, 10);
+        return -1;
+    }
+    /* TEX_SRCDBG=<N>: is the guest memory this slot uploads FROM actually
+     * populated? An empty source and a broken sampler both render flat. */
+    { static int cap = -1, n = 0;
+      if (cap < 0) { const char* e = getenv("TEX_SRCDBG"); cap = e ? atoi(e) : 0; }
+      if (cap && n < cap) { n++;
+        u32 nz = 0, tot = 0;
+        for (u32 i = 0; i < w * h * bpp && i < 0x40000u; i += 61) { tot++; if (vm_base[off + i]) nz++; }
+        /* Several of this title's textures are bound at EXACTLY the end address
+         * of an upload, so also sample the block immediately BELOW the bind
+         * offset: if that holds the image, the bind is one whole texture high. */
+        u32 nzb = 0, totb = 0;
+        { u32 sz = w * h * bpp; u32 base = (off > sz) ? off - sz : 0;
+          for (u32 i = 0; i < sz && i < 0x40000u; i += 61) { totb++; if (vm_base[base + i]) nzb++; } }
+        long nearest = 0; u32 found = 0;
+        if (!nz) {   /* empty: where IS the data? scan out from the bind offset */
+            for (long d = 0x1000; d <= 0x1000000 && !found; d += 0x1000) {
+                for (int s = 0; s < 2 && !found; s++) {
+                    long a = (long)off + (s ? -d : d);
+                    if (a < 0x1000) continue;
+                    u32 c = 0;
+                    for (u32 i = 0; i < 0x1000u; i += 61) if (vm_base[a + i]) c++;
+                    if (c > 8) { nearest = (s ? -d : d); found = c; }
+                }
+            }
+        }
+        fprintf(stderr, "[TEXSRC] off=0x%08X %ux%u fmt=0x%02X bpp=%u nonzero=%u/%u"
+                        "%s%+ld (page nonzero=%u)\n",
+                off, w, h, fmt, bpp, nz, tot,
+                nz ? "" : "  nearest data at ", nz ? 0L : nearest, found);
+        fprintf(stderr, "[TEXSRC]    block BELOW bind (off-%u): nonzero=%u/%u%c",
+                w * h * bpp, nzb, totb, 10);
+        /* Walk DOWN in 4KB steps to the first populated page whose predecessor
+         * is empty: that is where this texture's data actually begins, and the
+         * delta from the bound offset is the rule we are missing. */
+        { u32 step = 0x1000, prev_pop = 0; long start_delta = 0;
+          for (long d = 0; d >= -(long)(w * h * bpp) * 2; d -= step) {
+              u32 a = (u32)((long)off + d); u32 pop = 0;
+              if (a < 0x1000) break;
+              for (u32 i = 0; i < step; i += 53) if (vm_base[a + i]) pop++;
+              if (!pop && prev_pop) { start_delta = d + step; break; }
+              prev_pop = pop;
+          }
+          fprintf(stderr, "[TEXSRC]    data starts at off%+ld (level0=%u bytes)%c",
+                  start_delta, w * h * bpp, 10); } } }
+    VPTexSlot* t = &s_d3d.vp_tex[slot];
+    const double _ut0 = perf_on() ? perf_now() : 0.0;
+    int fresh = 0;
+    /* Cube textures store their 6 faces consecutively; each is converted into
+     * its own slices of the upload buffer. */
+    /* The face stride is NOT one mip-0 image: RSX stores each cube face as its
+     * own complete mip pyramid, so face f starts a whole pyramid (128-byte
+     * aligned) in. Assuming mip-0-sized strides made face 1 land inside face 0's
+     * mip chain -- which is exactly what the dumps showed, every face after the
+     * first a progressively smaller copy of the first. */
+    u32 _face_bytes = dxt ? (blkrow * blkrows) : (w * h * bpp);
+    if (mc->on) {
+        /* the whole guest pyramid (glv levels), whatever TEX_MIPS_MAX uploads */
+        _face_bytes = cube ? rsx_texture_cube_face_stride(fmt, w, h, mips, kpitch)
+                           : lv[glv - 1u].offset + lv[glv - 1u].tl.face_bytes;
+    } else if (cube) {
+        u32 total = 0;
+        for (u32 lw = w, lh = h, l = 0; l < (mips ? mips : 1u); l++) {
+            total += dxt ? (((lw + 3) / 4) * tl.block_bytes * ((lh + 3) / 4))
+                         : (lw * lh * bpp);
+            if (lw > 1) lw >>= 1;
+            if (lh > 1) lh >>= 1;
+        }
+        _face_bytes = (total + 127u) & ~127u;
+    }
+    const u32 _nfaces     = cube ? 6u : 1u;
+    /* Guest bytes the conversion reads: every uploaded level of every face
+     * (TEX_MIPS=0: level 0 of every face). The write watch, the content hash
+     * and the checksum all cover exactly this. */
