+      memcpy(b, rsx_report_ss_record(), rn);
+      const char* d = ss_rec_diff(a, b);
+      CHECK(!d, "a capture right after the restore reads A back (first difference: %s)", d ? d : "");
+      CHECK(rsx_zcull_get(5)->bound && rsx_zcull_get(5)->height == 704u && !rsx_zcull_get(1)->bound,
