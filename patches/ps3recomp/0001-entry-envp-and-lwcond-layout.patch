+/* B8R8_G8R8 = bytes B, R0, G, R1; R8B8_R8G8 = R0, B, R1, G. Texel 2k takes R0,
+ * texel 2k + 1 R1, both the word's B and G. Odd width: the last word's R1 is
+ * not a texel. */
+static void test_422_texels(void)
+{
+    const u8 s[8] = { 0x10, 0x20, 0x30, 0x40, 0x50, 0x60, 0x70, 0x80 };
+    u8 d[3 * 4];
+    rsx_tex_layout L;
+    rsx_texture_layout(FMT_B8R8_G8R8 | FMT_LN, 3, 1, &L);
+    memset(d, 0, sizeof d);
+    rsx_texture_decode(d, 12, s, 3, 1, &L, 0);
+    CHECK_EQ(d[0], 0x20); CHECK_EQ(d[1], 0x30); CHECK_EQ(d[2], 0x10); CHECK_EQ(d[3], 255);
+    CHECK_EQ(d[4], 0x40); CHECK_EQ(d[5], 0x30); CHECK_EQ(d[6], 0x10); CHECK_EQ(d[7], 255);
+    CHECK_EQ(d[8], 0x60); CHECK_EQ(d[9], 0x70); CHECK_EQ(d[10], 0x50); CHECK_EQ(d[11], 255);
+
+    rsx_texture_layout(FMT_R8B8_R8G8 | FMT_LN, 3, 1, &L);
+    rsx_texture_decode(d, 12, s, 3, 1, &L, 0);
+    CHECK_EQ(d[0], 0x10); CHECK_EQ(d[1], 0x40); CHECK_EQ(d[2], 0x20);
+    CHECK_EQ(d[4], 0x30); CHECK_EQ(d[5], 0x40); CHECK_EQ(d[6], 0x20);
+    CHECK_EQ(d[8], 0x50); CHECK_EQ(d[9], 0x80); CHECK_EQ(d[10], 0x60);
+
+    /* rows step by the source row (pitch), not by the decoded row */
+    u8 s2[2 * 16];
+    memset(s2, 0, sizeof s2);
+    s2[16 + 1] = 0xAB;                          /* row 1, texel 0's R0 */
+    u8 d2[2 * 2 * 4];
+    rsx_texture_layout_pitched(FMT_B8R8_G8R8 | FMT_LN, 2, 2, 16, &L);
+    rsx_texture_decode(d2, 8, s2, 2, 2, &L, 0);
+    CHECK_EQ(d2[8], 0xAB);
+}
