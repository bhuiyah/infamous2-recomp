+      "Auto follows the window's height and the monitor's scaling; a percentage scales that.",
+      OPT_INT, OPT_LIVE, "auto", NULL, 50, 300, 5, "auto", NULL, NULL, OVL_NOPRESET, 0, "overlay", NULL },
+};
