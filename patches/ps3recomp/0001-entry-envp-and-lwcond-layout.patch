+/* Directory rename that works for directories on every host. */
+static int host_rename(const char* from, const char* to)
+{
+#ifdef _WIN32
+    return MoveFileExA(from, to, 0) ? 0 : -1;
+#else
+    return rename(from, to);
+#endif
+}
