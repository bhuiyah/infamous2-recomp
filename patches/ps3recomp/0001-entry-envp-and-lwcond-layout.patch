+u32 rsx_texture_format_features(u32 rsx_fmt);
+
+typedef struct {
+    u32 expand;   /* outputs R,G,B,A (bits 0-3): 2c - 1                     */
+    u32 gamma;    /* outputs R,G,B,A: sRGB -> linear                        */
+    u32 sext;     /* outputs R,G,B,A: signed (two's complement) channels    */
+    int sext16;   /* sext is on 16-bit channels (Y16_X16)                   */
+    int depth;    /* depth format: depth value, or comparison if zfunc != 0 */
+    u32 zfunc;    /* depth: CELL_GCM_TEXTURE_ZFUNC_* (texel OP reference)   */
+    int zlinear;  /* depth: 2x2 bilinear filter of the results (PCF)        */
+} rsx_texproc_ctl;
+
+/* What the hardware does to a texel of `rsx_fmt` bound with these registers
+ * between the fetch and the program. Out-of-range (zero) control1 is the
+ * identity, as for rsx_texture_component_remap. */
+void rsx_texture_texproc(u32 rsx_fmt, u32 control1, u32 address, u32 filter,
+                         rsx_texproc_ctl* out);
