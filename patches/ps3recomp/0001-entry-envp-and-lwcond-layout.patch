+#  define SPU__FXDEN2(x, y)    _mm_setzero_si128()
+#  define SPU__FXDEN3(x, y, z) _mm_setzero_si128()
+#  define SPU__FXRES           spu__fxres_rzdaz
+#else
+#  define SPU__FXDEN2(x, y)    spu__fxden2(x, y)
+#  define SPU__FXDEN3(x, y, z) spu__fxden3(x, y, z)
+#  define SPU__FXRES           spu__fxres
+#endif
+/* a*b + c rounded once in the current MXCSR mode (what the reference's fmaf
+ * returns: the UCRT fmaf is vfmadd on every FMA3 CPU and agrees with it on the
+ * lanes kept here). Without FMA3: a*b is exact in double, a*b+c is rounded once
+ * to double and once more to float. Two directed roundings compose exactly;
+ * two to-nearest ones too, unless an inexact double sum lands exactly on a
+ * float halfway point (low 29 fraction bits 1000...0): those lanes are flagged
+ * in *bad.
+ * Overflow, the denormal range and FTZ then behave as the single rounding does
+ * on every lane the result test keeps. */
+SPU_FORCEINLINE __m128 spu__fmadd(__m128 a, __m128 b, __m128 c, __m128i* bad) {
+#  if defined(__FMA__)
+    (void)bad;
+    return _mm_fmadd_ps(a, b, c);
+#  else
+#    if defined(SPU_HELPERS_FP_RZDAZ)
+    /* DAZ zeroes a denormal in the cvtps2pd below at run time; a constant
+     * operand's conversion folded at compile time would not (a is opaque). */
+    SPU__RZ_OPAQUE(b); SPU__RZ_OPAQUE(c);
+#    endif
+    const __m128d plo = _mm_mul_pd(_mm_cvtps_pd(a), _mm_cvtps_pd(b)), clo = _mm_cvtps_pd(c);
+    const __m128d phi = _mm_mul_pd(_mm_cvtps_pd(_mm_movehl_ps(a, a)), _mm_cvtps_pd(_mm_movehl_ps(b, b)));
+    const __m128d chi = _mm_cvtps_pd(_mm_movehl_ps(c, c));
+    const __m128d lo = _mm_add_pd(plo, clo), hi = _mm_add_pd(phi, chi);
+    const __m128i mk = _mm_set_epi32(0, 0x1FFFFFFF, 0, 0x1FFFFFFF);
+    const __m128i md = _mm_set_epi32(-1, 0x10000000, -1, 0x10000000);   /* high dwords never match */
+    /* An exact double sum is a correctly rounded float input, so only an
+     * inexact one is a hazard. Under round-to-nearest, s = p + c rounded is
+     * exact iff s - p == c and s - c == p (Fast2Sum: whichever operand is the
+     * larger, s minus it is computed exactly). Other modes need no test. */
+    const __m128d xlo = _mm_or_pd(_mm_cmpneq_pd(_mm_sub_pd(lo, plo), clo), _mm_cmpneq_pd(_mm_sub_pd(lo, clo), plo));
+    const __m128d xhi = _mm_or_pd(_mm_cmpneq_pd(_mm_sub_pd(hi, phi), chi), _mm_cmpneq_pd(_mm_sub_pd(hi, chi), phi));
+    *bad = _mm_or_si128(*bad, _mm_or_si128(
+        _mm_and_si128(_mm_cmpeq_epi32(_mm_and_si128(_mm_castpd_si128(lo), mk), md), _mm_castpd_si128(xlo)),
+        _mm_and_si128(_mm_cmpeq_epi32(_mm_and_si128(_mm_castpd_si128(hi), mk), md), _mm_castpd_si128(xhi))));
+    return _mm_movelh_ps(_mm_cvtpd_ps(lo), _mm_cvtpd_ps(hi));
+#  endif
+}
+SPU_FORCEINLINE __m128 spu__fneg(__m128 x) { return _mm_xor_ps(x, _mm_castsi128_ps(spu__k(0x80000000u))); }
