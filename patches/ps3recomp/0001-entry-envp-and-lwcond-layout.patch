+#!/usr/bin/env python3
+"""Unit tests of the register-cache lift's speculative windows
+(spu_lifter.py _rc_windows / _rc_win_emit; the C side is spu_helpers.h
+"speculative windows", checked by runtime/spu/tests/test_spu_helpers_win.c).
+
+    python tools/test_spu_lifter_windows.py
+"""
+import os
+import re
+import sys
+import unittest
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import spu_lifter as L  # noqa: E402
+
+
+def F(op, d, *s):
+    return f"ctx->gpr[{d}] = {op}(" + ", ".join(f"ctx->gpr[{r}]" for r in s) + ");"
+
+
+def loop(body, tail=None):
+    """A one-block loop at 0x1000 (back-edge on r9) followed by a return."""
+    return (["loc_00001000:"] + body + (tail or []) +
+            ["if (ctx->gpr[9]._u32[0] != 0) { SPU_BACKGOTO(ctx, 0x1000u, f_00001000, loc_00001000); }",
+             "return;"])
+
+
+def lift(items):
+    decls, loads, body = L.rcache_function(items, ["loc_00001000"])
+    return decls, body
+
+
+def window_parts(body):
+    """[(fast lines, exact lines)] of each window in an emitted body."""
+    out, i = [], 0
+    while i < len(body):
+        if body[i] == "{" and i + 1 < len(body) and body[i + 1] == "#if SPU_WIN_ENABLE":
+            j = body.index("#endif", i)
+            k = body.index("}", j)
+            out.append((body[i + 2:j], body[j + 1:k]))
+            i = k
+        i += 1
+    return out
+
+
+FLOATS = [F("spu_fm", 10, 1, 2), F("spu_fa", 11, 10, 3), F("spu_fma", 12, 11, 4, 5),
+          F("spu_fs", 13, 12, 6), F("spu_fnms", 14, 13, 7, 8)]
+
+
+class Windows(unittest.TestCase):
+    def setUp(self):
+        for k in ("SPU_LIFT_WINDOWS", "SPU_LIFT_WIN_MIN", "SPU_LIFT_WIN_BIG"):
+            os.environ.pop(k, None)
+
+    def test_window_in_loop(self):
+        decls, body = lift(loop(FLOATS + [F("spu_fm", 10, 14, 1)]))
+        w = window_parts(body)
+        self.assertEqual(len(w), 1)
+        fast, exact = w[0]
+        # the exact copy is the statements themselves, in order
+        self.assertEqual([e.strip() for e in exact],
+                         [L._rc_rename(s) for s in FLOATS + [F("spu_fm", 10, 14, 1)]])
+        # every float op of the fast copy has a leaf; one test commits all
+        self.assertEqual(sum(1 for f in fast if re.search(r"spu_wf(a|s|m|ma|nms)(_r)?\(", f)), 6)
+        commit = [f for f in fast if "SPU_WIN_OK(" in f][0]
+        for r in (10, 11, 12, 13, 14):
+            self.assertIn(f"_r{r} = _w1s", commit)
+        self.assertIn("goto _wd1;", commit)
+        self.assertIn("_wd1: ;", body)
+        self.assertIn("int _wn = g_spu_win_tries;", decls)
+        # results read only by float ops and not committed skip the +0
+        self.assertTrue(any("spu_wfm_r(SPU_RU(_r1), SPU_RU(_r2)" in f for f in fast))   # first r10
+        self.assertTrue(any("spu_wfm(SPU_RU(_w1s5), SPU_RU(_r1)" in f for f in fast))   # last r10: committed
+        self.assertTrue(any("spu_wfnms(" in f for f in fast))       # r14: committed
+
+    def test_no_window_outside_loops(self):
+        items = ["loc_00001000:"] + FLOATS + ["return;"]
+        decls, loads, body = L.rcache_function(items, ["loc_00001000"])
+        self.assertEqual(window_parts(body), [])
+        self.assertNotIn("int _wn = g_spu_win_tries;", decls)
+
+    def test_off_and_min(self):
+        os.environ["SPU_LIFT_WINDOWS"] = "0"
+        self.assertEqual(window_parts(lift(loop(FLOATS))[1]), [])
+        os.environ["SPU_LIFT_WINDOWS"] = "1"
+        os.environ["SPU_LIFT_WIN_MIN"] = "6"
+        self.assertEqual(window_parts(lift(loop(FLOATS))[1]), [])
+
+    def test_store_ends_a_run(self):
+        body = FLOATS[:3] + ["spu_ls_write128(ctx, ctx->gpr[1]._u32[0] + 0x10, ctx->gpr[12]);"] + FLOATS[3:]
+        w = window_parts(lift(loop(body))[1])
+        self.assertEqual(len(w), 0)          # 3 + 2 float ops: neither part reaches 4
+
+    def test_estimate_split_and_tail_trim(self):
+        est = "ctx->gpr[20] = spu_frest(ctx->gpr[12]);"
+        tail = [F("spu_selb", 21, 20, 13, 14), F("spu_and", 22, 21, 1)]
+        body = FLOATS[:4] + [est] + FLOATS[4:] + tail
+        w = window_parts(lift(loop(body))[1])
+        # the frest splits the run (fewer than SPU_LIFT_WIN_BIG float ops):
+        # the 4 float ops before it form the window, and nothing after the
+        # last float op of a part stays in it
+        self.assertEqual(len(w), 1)
+        self.assertEqual([e.strip() for e in w[0][1]], [L._rc_rename(s) for s in FLOATS[:4]])
+        os.environ["SPU_LIFT_WIN_BIG"] = "4"
+        w = window_parts(lift(loop(body))[1])
+        self.assertEqual(len(w), 1)          # kept whole, trimmed after fnms
+        self.assertEqual([e.strip() for e in w[0][1]],
+                         [L._rc_rename(s) for s in FLOATS[:4] + [est] + FLOATS[4:]])
+
+    def test_checked_operands_and_guards(self):
+        body = FLOATS + ["ctx->gpr[30] = spu_fcgt(ctx->gpr[14], ctx->gpr[15]);",
+                         "ctx->gpr[31] = spu_cflts(ctx->gpr[16], 173);",
+                         "ctx->gpr[32] = spu_ls_read128(ctx, ctx->gpr[1]._u32[0] + 0x20);",
+                         F("spu_fm", 33, 32, 32)]
+        fast, exact = window_parts(lift(loop(body))[1])[0]
+        text = "\n".join(fast)
+        # r14 is a float result of the window: only r15 and r16 need a check
+        self.assertEqual(len(re.findall(r"spu_wchk\(", text)), 2)
+        self.assertIn("spu_wchk(SPU_RU(_r15))", text)
+        self.assertIn("spu_wchk(SPU_RU(_r16))", text)
+        self.assertIn("spu_wls_rd(_ls, ", text)
+        self.assertIn("SPU_WIN_ON(_lsg, _wn)", text)
+
+    def test_r0_and_written_through_end_runs(self):
+        # r0 is written through at every def: not a plain assignment
+        body = FLOATS[:2] + [F("spu_fm", 0, 1, 2)] + FLOATS[2:]
+        self.assertEqual(window_parts(lift(loop(body))[1]), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
