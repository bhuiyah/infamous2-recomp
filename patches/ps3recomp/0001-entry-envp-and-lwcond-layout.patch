+SPU_FORCEINLINE __m128i spu__fxpick(__m128 f, __m128i den, __m128i d) {
+    const __m128i t = _mm_add_epi32(_mm_and_si128(spu__i(f), spu__k(0x7FFFFFFFu)), spu__k(0x7F7FFFFFu));
+    return spu__blend(_mm_andnot_si128(den, _mm_cmpgt_epi32(spu__k(0xFEFFFFFEu), t)), spu__i(f), d);
