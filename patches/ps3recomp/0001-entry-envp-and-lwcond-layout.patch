+/* One read-back row into guest memory in RSX byte order. The readback buffer
+ * holds the resource's bytes (R,G,B,A, or little-endian float lanes) and each
+ * conversion is a fixed byte permutation within 4 bytes (2 for half floats):
+ *   RB_ARGB    R,G,B,A -> A,R,G,B   X8R8G8B8 / A8R8G8B8, and the zeta alias
+ *   RB_ABGR    R,G,B,A -> A,B,G,R   X8B8G8R8 / A8B8G8R8 (a 32-bit swap)
+ *   RB_SWAP16  each 16-bit lane byte-swapped   R16G16B16A16_FLOAT
+ *   RB_SWAP32  each 32-bit lane byte-swapped   R32 float formats
+ * These were byte-at-a-time loops over 3.7 MB per 1280x720 surface, and
+ * inFamous 2 reads two such surfaces back every frame (its depth and a
+ * G-buffer plane, for the SPU lighting jobs): ~0.75 ms per readback, copy
+ * and fence wait included, of which ~0.5 ms was this loop. One pshufb per 16
+ * bytes now; the tail, and a build without SSSE3, run the original byte
+ * loop. n is the row's byte count, a whole number of lanes. */
+#if defined(__SSSE3__) || defined(__SSE4_1__) || defined(__AVX__)
+#include <tmmintrin.h>
+#define RB_PSHUFB 1
+#endif
+enum { RB_ARGB, RB_ABGR, RB_SWAP16, RB_SWAP32 };
+static void rb_store_row(u8* d, const u8* s, u32 n, int kind)
+{
+    u32 i = 0;
+#ifdef RB_PSHUFB
+    const __m128i m =
+        kind == RB_ARGB   ? _mm_setr_epi8(3, 0, 1, 2, 7, 4, 5, 6, 11, 8, 9, 10, 15, 12, 13, 14) :
+        kind == RB_SWAP16 ? _mm_setr_epi8(1, 0, 3, 2, 5, 4, 7, 6, 9, 8, 11, 10, 13, 12, 15, 14) :
+                            _mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12);
+    for (; i + 64u <= n; i += 64u) {
+        const __m128i a = _mm_loadu_si128((const __m128i*)(s + i));
+        const __m128i b = _mm_loadu_si128((const __m128i*)(s + i + 16));
+        const __m128i c = _mm_loadu_si128((const __m128i*)(s + i + 32));
+        const __m128i e = _mm_loadu_si128((const __m128i*)(s + i + 48));
+        _mm_storeu_si128((__m128i*)(d + i),      _mm_shuffle_epi8(a, m));
+        _mm_storeu_si128((__m128i*)(d + i + 16), _mm_shuffle_epi8(b, m));
+        _mm_storeu_si128((__m128i*)(d + i + 32), _mm_shuffle_epi8(c, m));
+        _mm_storeu_si128((__m128i*)(d + i + 48), _mm_shuffle_epi8(e, m));
+    }
+    for (; i + 16u <= n; i += 16u)
+        _mm_storeu_si128((__m128i*)(d + i),
+                         _mm_shuffle_epi8(_mm_loadu_si128((const __m128i*)(s + i)), m));
+#endif
+    if (kind == RB_SWAP16) {
+        for (; i + 2u <= n; i += 2u) { d[i+0] = s[i+1]; d[i+1] = s[i+0]; }
+    } else if (kind == RB_ARGB) {
+        for (; i + 4u <= n; i += 4u) {
+            d[i+0] = s[i+3]; d[i+1] = s[i+0];
+            d[i+2] = s[i+1]; d[i+3] = s[i+2];
+        }
+    } else {
+        for (; i + 4u <= n; i += 4u) {
+            d[i+0] = s[i+3]; d[i+1] = s[i+2];
+            d[i+2] = s[i+1]; d[i+3] = s[i+0];
+        }
+    }
+}
+
+/* Depth read back. inFamous 2 copies its depth buffer (zeta 0x10000) to main
+ * memory with an NV3089 blit every frame, next to a G-buffer plane, and its
+ * sun pass samples both copies; depth lives in a D3D depth resource, so the
+ * guest memory under the zeta held whatever was there before. The copy is the
+ * zeta's RGBA8 alias (ztex_convert: the bytes RSX keeps, depth 23..0 then
+ * stencil), refreshed here and written back in guest order. ZETA_READBACK=0
+ * disables. */
+static int zeta_readback_on(void)
+{
+    static int en = -1;
+    if (en < 0) { const char* e = getenv("ZETA_READBACK"); en = (e && *e == '0') ? 0 : 1; }
+    return en && ztex_on();
+}
+static int zrec_writes(const D3D12DrawRecord* dr)
+{
+    return dr->is_clear ? (dr->clr_mask & 3u) != 0 : (dr->is_vp && ds_writes_zeta(dr));
+}
+/* Base of the zeta surface holding raw offset `off` (live surfaces at the
+ * reader's pitch, and the zetas records not yet executed write); *pending when
+ * such a record writes it. */
+static u32 zeta_surface_containing(u32 off, u32 pitch, int* pending)
+{
+    u32 best = 0;
+    *pending = 0;
+    for (int i = 0; i < MAX_ZETA; i++) {
+        const ZetaSurf* z = &s_zeta[i];
+        if (!z->res || z->off > off) continue;
+        if (pitch && z->w * 4u != pitch) continue;
+        if ((u64)off - z->off < (u64)z->w * 4u * z->h && z->off >= best) best = z->off;
+    }
+    for (u32 d = 0; d < s_d3d.draw_count && d < MAX_DRAWS; d++) {
+        const D3D12DrawRecord* dr = &s_d3d.draws[d];
+        if (!dr->zeta_off || dr->zeta_off > off || !zrec_writes(dr)) continue;
+        u32 w = dr->rt_w ? dr->rt_w : s_d3d.width, h = dr->rt_h ? dr->rt_h : s_d3d.height;
+        if ((u64)off - dr->zeta_off < (u64)w * 4u * h && dr->zeta_off >= best) best = dr->zeta_off;
+    }
+    if (!best) return 0;
+    for (u32 d = 0; d < s_d3d.draw_count && d < MAX_DRAWS && !*pending; d++)
+        if (s_d3d.draws[d].zeta_off == best && zrec_writes(&s_d3d.draws[d])) *pending = 1;
+    return best;
+}
+static int zeta_readback(u32 off, u32 base, u32 pitch, int local, int flushed, int dbg, int* nlog)
+{
+    const int zs = zeta_find(base);
+    if (zs < 0) return 0;
+    ZetaSurf* z = &s_zeta[zs];
+    if (!z->rb_dirty) return 0;
+    const u32 gpitch = z->w * 4u;
+    if (pitch && pitch != gpitch) {
+        static int _n = 0; if (_n++ < 4)
+            fprintf(stderr, "[RT_READBACK] zeta 0x%X %ux%u: reader pitch %u vs %u -- not read back%c",
+                    base, z->w, z->h, pitch, gpitch, 10);
+        return 0;
+    }
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    const u32 ea = cellGcmResolveLocated(local, base);
+    if (!vm_base || ea == 0xFFFFFFFFu || ztex_pipeline() <= 0) return 0;
+    /* RES_SCALE: a scaled zeta reads back through its guest-size pick alias. */
+    const int aid = ztex_alias_sp(zs, z->w, z->h, z->hw != z->w || z->hh != z->h);
+    if (aid < 0) return 0;
+    const int k = aid % ZALIAS_PER_ZETA;
+    const u32 w = z->aw[k], h = z->ah[k];
+    const u32 rp = (w * 4u + 255u) & ~255u;
+    if (!rb_prepare((u64)rp * h)) return 0;
+
+    ID3D12GraphicsCommandList* cl = s_rb_list;
+    s_rb_alloc->lpVtbl->Reset(s_rb_alloc);
+    cl->lpVtbl->Reset(cl, s_rb_alloc, NULL);
+    ID3D12DescriptorHeap* heaps[] = { s_d3d.srv_heap };
+    cl->lpVtbl->SetDescriptorHeaps(cl, 1, heaps);
+    D3D12_RESOURCE_BARRIER b[2] = {0};
+    b[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b[0].Transition.pResource = z->res;
+    b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    b[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b[1].Transition.pResource = z->alias[k];
+    b[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[1].Transition.StateBefore = z->alias_st[k];
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    cl->lpVtbl->ResourceBarrier(cl, z->alias_st[k] == D3D12_RESOURCE_STATE_UNORDERED_ACCESS ? 1 : 2, b);
+    if (!ztex_bind_cs(cl, z, k)) { cl->lpVtbl->Close(cl); return 0; }   /* plain, or a scaled zeta's pick */
+    D3D12_GPU_DESCRIPTOR_HANDLE gh;
+    s_d3d.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &gh);
+    gh.ptr += (u64)(ZCONV_BASE + 3u * (u32)aid) * s_d3d.srv_inc;
+    cl->lpVtbl->SetComputeRootDescriptorTable(cl, 0, gh);
+    cl->lpVtbl->Dispatch(cl, (w + 7u) / 8u, (h + 7u) / 8u, 1);
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    cl->lpVtbl->ResourceBarrier(cl, 2, b);
+    D3D12_TEXTURE_COPY_LOCATION dl = {0}, sl = {0};
+    dl.pResource = s_rb_buf;
+    dl.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dl.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    dl.PlacedFootprint.Footprint.Width = w;
+    dl.PlacedFootprint.Footprint.Height = h;
+    dl.PlacedFootprint.Footprint.Depth = 1;
+    dl.PlacedFootprint.Footprint.RowPitch = rp;
+    sl.pResource = z->alias[k];
+    sl.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    sl.SubresourceIndex = 0;
+    cl->lpVtbl->CopyTextureRegion(cl, &dl, 0, 0, 0, &sl, NULL);
+    b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &b[1]);
+    cl->lpVtbl->Close(cl);
+    ID3D12CommandList* lists[] = {(ID3D12CommandList*)cl};
+    s_d3d.cmd_queue->lpVtbl->ExecuteCommandLists(s_d3d.cmd_queue, 1, lists);
+    const double rbt0 = ps3_chain_on() ? rbt_now() : 0.0;   /* CHAIN_TRACE [RBT] */
+    wait_for_gpu();
+    if (ps3_chain_on()) { s_rbt.wait += rbt_now() - rbt0; s_rbt.n++; }
+    z->alias_st[k] = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    z->dirty[k] = 0;
+
+    void* mp = NULL; D3D12_RANGE rr = {0, (SIZE_T)((u64)rp * h)};
+    if (FAILED(s_rb_buf->lpVtbl->Map(s_rb_buf, 0, &rr, &mp)) || !mp) return 0;
+    u8* gp = vm_base + ea;
+    const double rbt1 = ps3_chain_on() ? rbt_now() : 0.0;
+    for (u32 y = 0; y < h; y++)             /* alias R,G,B,A -> guest A,R,G,B */
+        rb_store_row(gp + (u64)y * gpitch, (const u8*)mp + (u64)y * rp, w * 4u, RB_ARGB);
+    if (ps3_chain_on()) s_rbt.store += rbt_now() - rbt1;
+    if (g_tp_on) tp_rt_note_rsx_write(ea, gpitch * h);   /* texture packs: renderer-made bytes */
+    D3D12_RANGE wr = {0, 0};
+    s_rb_buf->lpVtbl->Unmap(s_rb_buf, 0, &wr);
+    z->rb_dirty = 0;
+    rsx_rcz_readback(base, z->w, z->h, 0, 1);   /* RSX_RES_DRYRUN */
+    if (dbg && *nlog < dbg) { (*nlog)++;
+        fprintf(stderr, "[RT_READBACK] off=0x%X -> zeta 0x%X (%ux%u pitch %u)%s ea=0x%08X%c",
+                off, base, w, h, gpitch, flushed ? " after flush" : "", ea, 10); }
+    return 1;
+}
+
+/* Base of the surface holding raw offset `off`: the nearest base at or below
+ * it whose pitch*height span covers it, among live RTs and the targets of
+ * records not yet executed (an RT is only created when its batch runs). */
+static u32 rt_surface_containing(u32 off, u32 pitch, int* pending)
+{
+    u32 best = 0;
+    *pending = 0;
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (!r->res || r->off > off) continue;
+        u32 p = r->w * dxgi_bpp(r->dxgi);   /* the surface's own (tight) pitch */
+        if (pitch && p != pitch) continue;  /* another-size surface at this offset */
+        if ((u64)off - r->off < (u64)p * r->h && r->off >= best) best = r->off;
+    }
+    for (u32 d = 0; d < s_d3d.draw_count && d < MAX_DRAWS; d++) {
+        const D3D12DrawRecord* dr = &s_d3d.draws[d];
+        if (!dr->is_vp) continue;
+        for (int m = -1; m < 3; m++) {
+            u32 b = m < 0 ? dr->rt_off : dr->rt_mrt[m];
+            /* a display write the replay will redirect (DISPLAY_REDIRECT) */
+            if (m < 0 && !b && rd_has(dr->disp_raw)) b = dr->disp_raw;
+            if (!b || b > off) continue;
+            u32 h = dr->rt_h ? dr->rt_h : s_d3d.height;
+            u32 p = (dr->rt_w ? dr->rt_w : s_d3d.width) *
+                    dxgi_bpp((u32)rsx_surface_dxgi(dr->rt_fmt));
+            if ((u64)off - b < (u64)p * h && b >= best) best = b;
+        }
+    }
+    if (!best) return 0;
+    for (u32 d = 0; d < s_d3d.draw_count && d < MAX_DRAWS && !*pending; d++) {
+        const D3D12DrawRecord* dr = &s_d3d.draws[d];
+        if (!dr->is_vp) continue;
+        if (dr->rt_off == best || dr->rt_mrt[0] == best ||
+            dr->rt_mrt[1] == best || dr->rt_mrt[2] == best ||
+            (!dr->rt_off && dr->disp_raw == best && rd_has(best))) *pending = 1;
+    }
+    return best;
+}
+
+static int rsx_d3d12_readback_surface_impl(u32 off, u32 pitch, int local);
+static int rsx_d3d12_readback_surface_ftr(u32 off, u32 pitch, int local);
+int rsx_d3d12_readback_surface(u32 off, u32 pitch, int local)
+{
+    if (!ps3_chain_on()) return rsx_d3d12_readback_surface_ftr(off, pitch, local);
+    ps3_chain_stamp(1);                /* CHAIN_TRACE: the walker's readback stamps */
+    const int r = rsx_d3d12_readback_surface_ftr(off, pitch, local);
+    ps3_chain_stamp(2);
+    return r;
+}
+static int rsx_d3d12_readback_surface_ftr(u32 off, u32 pitch, int local)
+{
+    if (s_ftr_on <= 0 && s_pl_min <= 0) return rsx_d3d12_readback_surface_impl(off, pitch, local);
+    const double t0 = s_ftr_on > 0 ? ftr_now() : 0.0;
+    const int r = rsx_d3d12_readback_surface_impl(off, pitch, local);
+    if (r && s_ftr_on > 0) { s_ftr.rb_n++; s_ftr.rb += ftr_now() - t0; }   /* flush + copy + wait */
+    if (r) passlog_readback(off);                                          /* PASSLOG */
+    return r;
+}
+static int rsx_d3d12_readback_surface_impl(u32 off, u32 pitch, int local)
+{
+    static int en = -1, dbg = -1, nlog = 0;
+    if (en < 0) { const char* e = getenv("RT_READBACK"); en = e ? atoi(e) : 1; }
+    if (dbg < 0) { const char* e = getenv("RT_READBACK_DBG"); dbg = e ? atoi(e) : 0; }
+    /* Only local memory holds surfaces: a main-memory read at the same raw
+     * offset is an IO address that merely collides with an RT's range. */
+    if (!en || !s_d3d.initialized || !off || !local || s_rf_flush) return 0;
+    rt_drain();   /* R1: the surfaces' state and the queue are the walker's again */
+
+    int pending = 0, zpend = 0;
+    u32 base = rt_surface_containing(off, pitch, &pending);
+    const u32 zbase = zeta_readback_on() ? zeta_surface_containing(off, pitch, &zpend) : 0;
+    if (!base && !zbase) return 0;
+    if (pending || zpend) {
+        const char* why = s_rf_reason;
+        const double rbt0 = ps3_chain_on() ? rbt_now() : 0.0;   /* CHAIN_TRACE [RBT] */
+        s_rf_flush = 1; s_present_this_frame = 0; s_rf_reason = "rt-readback";
+        render_frame();
+        s_rf_flush = 0; s_present_this_frame = 1; s_rf_reason = why;
+        s_d3d.merge_prev_draw = 0;
+        if (ps3_chain_on()) s_rbt.flush += rbt_now() - rbt0;
+    }
+    /* Colour or depth: the nearer surface below the offset; at one offset
+     * (the title points its zeta at a colour surface for passes without
+     * depth) whatever wrote it last. */
+    if (zbase && (zbase > base || (zbase == base && memw_is_zeta(zbase))))
+    {   const int zr = zeta_readback(off, zbase, pitch, local, pending || zpend, dbg, &nlog);
+        if (zr || !base) return zr; }   /* zeta not written: the colour surface below may be */
+    if (!base) return 0;
+    /* One offset can hold several surfaces: the one laid out at the
+     * reader's pitch, else the newest. */
+    int slot = -1;
+    for (int i = 0; i < MAX_OFF_RTS && slot < 0; i++) {
+        const OffRT* q = &s_d3d.off_rt[i];
+        if (q->res && q->off == base && pitch && q->w * dxgi_bpp(q->dxgi) == pitch) slot = i;
+    }
+    if (slot < 0) slot = off_rt_find(base);
+    if (slot < 0 || !s_d3d.off_rt[slot].gpu_dirty) return 0;
+    OffRT* r = &s_d3d.off_rt[slot];
+    /* The guest layout must be what the resource holds: 32-bit ARGB/ABGR
+     * surfaces as RGBA8, float surfaces in their own format. 16- and 8-bit
+     * surfaces are drawn as RGBA8 here, and writing 4 bytes per pixel over
+     * them would run past the surface (RT_FORCE_RGBA8 likewise). */
+    int abgr = 0;
+    switch (r->rsx_fmt) {
+    case 0x4: case 0x5: case 0x8:   /* X8R8G8B8 / A8R8G8B8 */
+        if (r->dxgi != DXGI_FORMAT_R8G8B8A8_UNORM) return 0; break;
+    case 0xE: case 0xF: case 0x10:  /* X8B8G8R8 / A8B8G8R8 */
+        if (r->dxgi != DXGI_FORMAT_R8G8B8A8_UNORM) return 0; abgr = 1; break;
+    case 0xB: if (r->dxgi != DXGI_FORMAT_R16G16B16A16_FLOAT) return 0; break;
+    case 0xC: if (r->dxgi != DXGI_FORMAT_R32G32B32A32_FLOAT) return 0; break;
+    case 0xD: if (r->dxgi != DXGI_FORMAT_R32_FLOAT) return 0; break;
+    default: { static int _n = 0; if (_n++ < 4)
+                   fprintf(stderr, "[RT_READBACK] surface 0x%X format 0x%X not read back%c",
+                           base, r->rsx_fmt, 10); }
+             return 0;
+    }
+
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    /* Where the reader looks (NV3089 resolves its source by DMA context). */
+    u32 ea = cellGcmResolveLocated(local, base);
+    if (!vm_base || ea == 0xFFFFFFFFu) return 0;
+    u32 bpp = dxgi_bpp(r->dxgi);
+    /* The guest layout must be known: dims from the surface clip (not the
+     * window fallback), and the reader's pitch equal to the surface's tight
+     * pitch -- the only layout the seed upload and this copy model. */
+    u32 gpitch = r->w * bpp;
+    if (r->guessed || (pitch && pitch != gpitch)) {
+        static int _n = 0; if (_n++ < 4)
+            fprintf(stderr, "[RT_READBACK] surface 0x%X %ux%u: reader pitch %u vs %u%s -- not read back%c",
+                    base, r->w, r->h, pitch, gpitch, r->guessed ? " (dims guessed)" : "", 10);
+        return 0;
+    }
+    u32 rp = (r->w * bpp + 255) & ~255u;               /* footprint row pitch */
+    u64 need = (u64)rp * r->h;
+    if (!rb_prepare(need)) return 0;
+
+    /* Same queue as the flush, so the copy is ordered after it. The list is
+     * idle: every use below ends in wait_for_gpu. */
+    s_rb_alloc->lpVtbl->Reset(s_rb_alloc);
+    s_rb_list->lpVtbl->Reset(s_rb_list, s_rb_alloc, NULL);
+    /* RES_SCALE: a scaled surface is resolved to the guest size first (the
+     * pick); guest memory only ever gets guest-size data. */
+    const int rs_pick = r->hw != r->w || r->hh != r->h;
+    ID3D12Resource* rb_src = rs_pick ? rs_pick_colour(s_rb_list, r) : r->res;
+    if (!rb_src) { s_rb_list->lpVtbl->Close(s_rb_list); return 0; }
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = r->res;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = r->st;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    if (!rs_pick && r->st != D3D12_RESOURCE_STATE_COPY_SOURCE)
+        s_rb_list->lpVtbl->ResourceBarrier(s_rb_list, 1, &b);
+    D3D12_TEXTURE_COPY_LOCATION dl = {0}, sl = {0};
+    dl.pResource = s_rb_buf;
+    dl.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dl.PlacedFootprint.Footprint.Format = (DXGI_FORMAT)r->dxgi;
+    dl.PlacedFootprint.Footprint.Width = r->w;
+    dl.PlacedFootprint.Footprint.Height = r->h;
+    dl.PlacedFootprint.Footprint.Depth = 1;
+    dl.PlacedFootprint.Footprint.RowPitch = rp;
+    sl.pResource = rb_src;   /* r->res, or its guest-size pick */
+    sl.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    sl.SubresourceIndex = 0;
+    s_rb_list->lpVtbl->CopyTextureRegion(s_rb_list, &dl, 0, 0, 0, &sl, NULL);
+    if (!rs_pick && r->st != D3D12_RESOURCE_STATE_COPY_SOURCE) {
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        b.Transition.StateAfter = r->st;
+        s_rb_list->lpVtbl->ResourceBarrier(s_rb_list, 1, &b);
+    }
+    s_rb_list->lpVtbl->Close(s_rb_list);
+    ID3D12CommandList* lists[] = {(ID3D12CommandList*)s_rb_list};
+    s_d3d.cmd_queue->lpVtbl->ExecuteCommandLists(s_d3d.cmd_queue, 1, lists);
+    const double rbt0 = ps3_chain_on() ? rbt_now() : 0.0;   /* CHAIN_TRACE [RBT] */
+    wait_for_gpu();
+    if (ps3_chain_on()) { s_rbt.wait += rbt_now() - rbt0; s_rbt.n++; }
+
+    void* mp = NULL; D3D12_RANGE rr = {0, (SIZE_T)need};
+    if (FAILED(s_rb_buf->lpVtbl->Map(s_rb_buf, 0, &rr, &mp)) || !mp) return 0;
+    u8* gp = vm_base + ea;
+    const double rbt1 = ps3_chain_on() ? rbt_now() : 0.0;
+    {   /* RGBA8 -> A,B,G,R or A,R,G,B; half and float lanes byte-swapped (BE) */
+        const int kind = r->dxgi == DXGI_FORMAT_R8G8B8A8_UNORM ? (abgr ? RB_ABGR : RB_ARGB)
+                       : r->dxgi == DXGI_FORMAT_R16G16B16A16_FLOAT ? RB_SWAP16 : RB_SWAP32;
+        for (u32 y = 0; y < r->h; y++)
+            rb_store_row(gp + (u64)y * gpitch, (const u8*)mp + (u64)y * rp, r->w * bpp, kind);
+    }
+    if (ps3_chain_on()) s_rbt.store += rbt_now() - rbt1;
+    if (g_tp_on) tp_rt_note_rsx_write(ea, gpitch * r->h);   /* texture packs: renderer-made bytes */
+    D3D12_RANGE wr = {0, 0};
+    s_rb_buf->lpVtbl->Unmap(s_rb_buf, 0, &wr);
+    r->gpu_dirty = 0;
+    rsx_rcz_readback(base, r->w, r->h, r->rsx_fmt, 0);   /* RSX_RES_DRYRUN */
+    if (dbg && nlog < dbg) { nlog++;
+        fprintf(stderr, "[RT_READBACK] off=0x%X -> surface 0x%X (%ux%u dxgi=%u pitch %u)%s ea=0x%08X%c",
+                off, base, r->w, r->h, r->dxgi, gpitch, pending ? " after flush" : "", ea, 10); }
+    return 1;
+}
+
+/* GL1: the walker's 2D copy of a whole G-buffer surface into one of the title's
+ * GPU lighting inputs (rsx_d3d12_glight.c): the surface is copied on the GPU,
+ * in order after its draws (the same flush the readback makes, without the
+ * wait), into the lighting's input buffer -- no readback, no CPU stores, no
+ * guest copy. 1: done (the caller skips the readback and the copy). */
+static int glight_capture_surface(u32 off, u32 pitch, u32 dst_ea, u32 w, u32 h)
+{
+    const int plane = rsx_glight_capture_plane(dst_ea, w, h);
+    if (plane < 0 || !s_d3d.initialized || !off || s_rf_flush) return 0;
+    rt_drain();
+    int pending = 0, zpend = 0;
+    const u32 base = rt_surface_containing(off, pitch, &pending);
+    const u32 zbase = zeta_readback_on() ? zeta_surface_containing(off, pitch, &zpend) : 0;
+    const int use_z = zbase && (zbase > base || (zbase == base && memw_is_zeta(zbase)));
+    if ((use_z ? zbase : base) != off) return 0;               /* whole surfaces only */
