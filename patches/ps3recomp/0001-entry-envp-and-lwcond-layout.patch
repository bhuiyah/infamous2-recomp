new file mode 100644
index 0000000..1016d21
--- /dev/null
+++ b/libs/input/tests/test_pad_host.c
@@ -0,0 +1,1512 @@
+/*
+ * test_pad_host - the device manager without hardware
+ *
+ * Stub drivers run end to end on virtual devices (open on the device thread,
+ * port assignment, parse -> snapshot, actuator -> build_output -> write,
+ * close on unplug/shutdown), plus the pieces that need no device at all:
+ * config parsing, deadzone, XInput mapping, CRC; and the startup port ranking,
+ * the retry backoff, query-remove, declined opens and XInput hotplug on a fake
+ * XInput; virtual duplicates (prefer_physical: a remapper's virtual pad next to
+ * the physical one it copies) on a four-slot fake XInput and stub pads. The
+ * physical side is off (controllers=0, or XInput-only with a fake XInput), so
+ * a pad plugged into the machine changes nothing.
+ *
+ * Includes pad_host_win.c to reach its static helpers.
+ *
+ * Build and run (Windows, from external/ps3recomp):
+ *   clang-cl /std:c17 /O2 /MD -D_CRT_SECURE_NO_WARNINGS -I include -I libs/input
+ *            libs/input/tests/test_pad_host.c /Fe:test_pad_host.exe
+ *   test_pad_host.exe [--hw]     (--hw: the exit paths with a real pad, reads only)
+ */
+
+#include "../pad_host_win.c"
+
+#include <stdio.h>
+
+static int s_pass, s_fail;
+#define CHECK(cond, ...) do {                                                        \
+        if (cond) s_pass++;                                                          \
+        else { s_fail++; printf("FAIL %s:%d: %s -- ", __FILE__, __LINE__, #cond);    \
+               printf(__VA_ARGS__); printf("\n"); fflush(stdout); }                  \
+    } while (0)
+
+/* ---------------------------------------------------------------------------
+ * Stub driver
+ *
+ * input report 0x01: [1..2] buttons LE, [3] ps, [4..7] lx ly rx ry, [8] battery,
+ *                    [9] bit0 has_motion, bit1 has_pressure, [10..17] sensors LE x y z g,
+ *                    [18..29] press[]
+ * input report 0x02: [1] battery only (partial update)
+ * input report 0x03: "no controller behind this receiver" (parse returns -1)
+ * feature 0x12 (read in open): [1] 0xEE = fail the open, [2] != 0 -> serial "mac-XX",
+ *                              [3] out_refresh_ms
+ * open() also sets feature [0x13, 0x01] (mode switch).
+ * output: 05 small large port; close: 05 00 00 FF
+ * -----------------------------------------------------------------------*/
+
+static volatile LONG s_open_calls, s_close_calls;
+static unsigned char s_close_out[4];
+static char s_marker[MAX_PATH];
+static DWORD s_main_tid;
+
+static int stub_match(const PadHostDevice* d) { (void)d; return 0; }
+
+static int stub_open(PadHostDevice* d)
+{
+    InterlockedIncrement(&s_open_calls);
+    unsigned char f[8] = { 0x12 };
+    int n = padhost_dev_get_feature(d, f, (int)sizeof f);
+    if (n > 1 && f[1] == 0xEE) return -5;
+    if (n > 2 && f[2]) snprintf(d->serial, sizeof d->serial, "mac-%02x", f[2]);
+    if (n > 3) d->out_refresh_ms = f[3];
+    unsigned char mode[2] = { 0x13, 0x01 };
+    padhost_dev_set_feature(d, mode, 2);
+    return 0;
+}
+
+static int stub_parse(PadHostDevice* d, const unsigned char* rep, int len, PadHostPortState* st)
+{
+    (void)d;
+    if (len < 2) return 0;
+    if (rep[0] == 0x02) { st->battery = rep[1]; return 1; }
+    if (rep[0] == 0x03) return -1;
+    if (rep[0] != 0x01 || len < 30) return 0;
+    st->buttons = (u16)(rep[1] | rep[2] << 8);
+    st->ps = rep[3];
+    st->lx = rep[4]; st->ly = rep[5]; st->rx = rep[6]; st->ry = rep[7];
+    st->battery = rep[8];
+    st->has_motion = rep[9] & 1;
+    st->has_pressure = (rep[9] >> 1) & 1;
+    st->sensor_x = (u16)(rep[10] | rep[11] << 8);
+    st->sensor_y = (u16)(rep[12] | rep[13] << 8);
+    st->sensor_z = (u16)(rep[14] | rep[15] << 8);
+    st->sensor_g = (u16)(rep[16] | rep[17] << 8);
+    memcpy(st->press, rep + 18, 12);
+    return 1;
+}
+
+static int stub_build(PadHostDevice* d, u8 small, u8 large, int port, unsigned char* out, int cap)
+{
+    (void)d;
+    if (cap < 4) return 0;
+    out[0] = 0x05; out[1] = small; out[2] = large; out[3] = (u8)port;
+    return 4;
+}
+
+static void stub_close(PadHostDevice* d)
+{
+    InterlockedIncrement(&s_close_calls);
+    unsigned char o[4] = { 0x05, 0, 0, 0xFF };
+    padhost_dev_write(d, o, 4);
+    memcpy(s_close_out, o, 4);
+    if (s_marker[0]) {
+        /* Win32 only: on the ExitProcess path the CRT may be unusable. */
+        HANDLE h = CreateFileA(s_marker, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+        if (h != INVALID_HANDLE_VALUE) {
+            const char* what = GetCurrentThreadId() == s_main_tid ? "close:caller" : "close:device";
+            DWORD w;
+            WriteFile(h, what, (DWORD)strlen(what), &w, NULL);
+            CloseHandle(h);
+        }
+    }
+}
+
+static const PadHostDriver stub_drv = { "stub", PADHOST_KIND_GENERIC, stub_match, stub_open, stub_parse, stub_build, stub_close };
+
+/* ---------------------------------------------------------------------------
+ * helpers
+ * -----------------------------------------------------------------------*/
+
+static int attach(const char* serial, int refresh_ms, int mac)
+{
+    int id = padhost_virtual_prepare(&stub_drv, PADHOST_BUS_BT, 0x1234, 0x5678, serial, 64, 64);
+    if (id < 0) return -1;
+    unsigned char f[4] = { 0x12, 0, (unsigned char)mac, (unsigned char)refresh_ms };
+    padhost_virtual_set_feature(id, f, 4);
+    return padhost_virtual_start(id) == 0 ? id : -1;
+}
+
+static void report(unsigned char* r, u16 buttons, u8 lx, u8 ly, u8 rx, u8 ry, u8 batt)
+{
+    memset(r, 0, 64);
+    r[0] = 0x01; r[1] = (u8)buttons; r[2] = (u8)(buttons >> 8);
+    r[4] = lx; r[5] = ly; r[6] = rx; r[7] = ry; r[8] = batt;
+}
+
+static int outputs(int id, unsigned char* last)
+{
+    int count = 0;
+    padhost_virtual_last_output(id, last, 4, &count);
+    return count;
+}
+
+/* Wait until the device's output count reaches n (or timeout). */
+static int wait_outputs(int id, int n, int ms, unsigned char* last)
+{
+    ULONGLONG end = GetTickCount64() + (ULONGLONG)ms;
+    int c;
+    while ((c = outputs(id, last)) < n && GetTickCount64() < end) Sleep(1);
+    return c;
+}
+
+static int connected_ports(void)
+{
+    int n = 0;
+    PadHostPortState st;
+    for (int p = 0; p < PADHOST_MAX_PORTS; p++) n += padhost_get(p, &st);
+    return n;
+}
+
+static void warn_collect(const char* m) { printf("    (warning as expected) %s\n", m); }
+
+/* ---------------------------------------------------------------------------
+ * tests
+ * -----------------------------------------------------------------------*/
+
+static void test_pure(void)
+{
+    printf("-- pure helpers\n");
+    const unsigned char* v = (const unsigned char*)"123456789";
+    CHECK(padhost_crc32(0, v, 9) == 0xCBF43926u, "crc %08X", padhost_crc32(0, v, 9));
+    CHECK(padhost_crc32(padhost_crc32(0, v, 4), v + 4, 5) == 0xCBF43926u, "chained");
+    CHECK(padhost_port_led_mask(0) == 1 && padhost_port_led_mask(3) == 8 && padhost_port_led_mask(4) == 9 &&
+          padhost_port_led_mask(6) == 0xC && padhost_port_led_mask(7) == 0, "led masks");
+    u8 r, g, b;
+    padhost_port_color(0, &r, &g, &b);
+    CHECK(r == 0 && g == 0 && b > 0, "port 0 is blue");
+    padhost_port_color(1, &r, &g, &b);
+    CHECK(r > 0 && g == 0 && b == 0, "port 1 is red");
+
+    /* XInput axis: centre exact, extremes reach 0/255, Y inverted (up = 0) */
+    CHECK(ph_xaxis(0, 0) == 128 && ph_xaxis(0, 1) == 128, "centre %u %u", ph_xaxis(0, 0), ph_xaxis(0, 1));
+    CHECK(ph_xaxis(32767, 0) == 255 && ph_xaxis(-32768, 0) == 0, "x extremes");
+    CHECK(ph_xaxis(32767, 1) == 0 && ph_xaxis(-32768, 1) == 255, "y extremes (up = 0)");
+    CHECK(ph_xaxis(100, 0) == 128 && ph_xaxis(-100, 1) == 128, "near centre stays 128");
+
+    XINPUT_GAMEPAD gp;
+    memset(&gp, 0, sizeof gp);
+    gp.wButtons = XINPUT_GAMEPAD_A | XINPUT_GAMEPAD_START | XINPUT_GAMEPAD_DPAD_LEFT | 0x0400;
+    gp.bLeftTrigger = 200; gp.bRightTrigger = 10;
+    gp.sThumbLY = 32767;
+    PadHostPortState st;
+    padhost_state_neutral(&st);
+    ph_xinput_state(&gp, &st);
+    CHECK(st.buttons == (0x4000 | 0x0008 | 0x0080 | 0x0100), "xinput buttons %04X", st.buttons);
+    CHECK(st.ps == 1, "guide -> ps");
+    CHECK(st.press[PADHOST_PRESS_L2] == 200 && st.press[PADHOST_PRESS_R2] == 10, "trigger pressure");
+    CHECK(st.press[PADHOST_PRESS_CROSS] == 255 && st.press[PADHOST_PRESS_LEFT] == 255 &&
+          st.press[PADHOST_PRESS_SQUARE] == 0, "digital pressure");
+    CHECK(st.ly == 0 && st.lx == 128, "stick up %u,%u", st.lx, st.ly);
+
+    /* radial deadzone, 8 % */
+    u8 x = 133, y = 128;
+    ph_deadzone(&x, &y, 80);
+    CHECK(x == 128 && y == 128, "inside -> centre (%u,%u)", x, y);
+    x = 200; y = 128;
+    ph_deadzone(&x, &y, 80);
+    CHECK(x == 195 && y == 128, "rescaled (%u,%u)", x, y);
+    x = 255; y = 0;
+    ph_deadzone(&x, &y, 80);
+    CHECK(x == 255 && y == 0, "corner kept (%u,%u)", x, y);
+    x = 0; y = 128;
+    ph_deadzone(&x, &y, 80);
+    CHECK(x == 0 && y == 128, "full left (%u,%u)", x, y);
+    x = 133; y = 120;
+    ph_deadzone(&x, &y, 0);
+    CHECK(x == 133 && y == 120, "0 = raw");
+}
+
+static void test_config(void)
+{
+    printf("-- config\n");
+    CHECK(padhost_config_set("backends", "all,-generic") == 1, "backends set");
+    CHECK(padhost_backend_enabled(PADHOST_KIND_DS4) && !padhost_backend_enabled(PADHOST_KIND_GENERIC) &&
+          padhost_backend_enabled(PADHOST_KIND_XINPUT), "all,-generic");
+    CHECK(padhost_config_set("PAD-Backends", "ds4 dualsense") == 1, "list");
+    CHECK(padhost_backend_enabled(PADHOST_KIND_DS4) && padhost_backend_enabled(PADHOST_KIND_DUALSENSE) &&
+          !padhost_backend_enabled(PADHOST_KIND_XINPUT), "ds4,dualsense");
+    CHECK(padhost_config_set("controller_backends", "-xinput") == 1, "leading minus = all but");
+    CHECK(!padhost_backend_enabled(PADHOST_KIND_XINPUT) && padhost_backend_enabled(PADHOST_KIND_SWITCH_PRO), "-xinput");
+    CHECK(padhost_config_set("backends", "ds4,bogus") == -1, "bad backend rejected");
