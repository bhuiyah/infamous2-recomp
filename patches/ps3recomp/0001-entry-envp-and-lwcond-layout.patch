+      CHECK(tp_rt_bind(&sA, &dA, g2 + oA, oA, fw2d & ~0x8u, 101, s_tp.frame) == NULL);            /* border */
+      /* B: level-0 match, same replacement */
+      tp_slot sB; memset(&sB, 0, sizeof sB);
+      const uint32_t h0hits = s_tp.st_hit0;
+      tp_rt_identify(&sB, 1, &dA, g2 + oB, oB, 0, 0, 102, s_tp.frame, 1);
+      CHECK(sB.rep == sA.rep && s_tp.st_hit0 == h0hits + 1);
