+        { const opt_id k = opt_find("vsync");   if (k >= 0) opt_text(k, vs, sizeof vs); }
+        { const opt_id k = opt_find("fps_cap"); if (k >= 0) opt_text(k, fc, sizeof fc); }
+        { const opt_id k = opt_find("tearing"); if (k >= 0) opt_text(k, te, sizeof te); }
+        { const opt_id k = opt_find("upscale"); if (k >= 0) opt_text(k, up, sizeof up); }
+        { const opt_id k = opt_find("frame_pacing"); if (k >= 0) opt_text(k, fp, sizeof fp); }
+        { const opt_id k = opt_find("render_scale"); if (k >= 0) opt_text(k, rs, sizeof rs); }
