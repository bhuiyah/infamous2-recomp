+    ID3D12Resource* tmp;   u32 tw, th; D3D12_RESOURCE_STATES tst;   /* anti-aliasing -> sharpen */
+    ID3D12Resource* out;   u32 ow, oh; D3D12_RESOURCE_STATES ost;   /* a scaled frame's picture */
