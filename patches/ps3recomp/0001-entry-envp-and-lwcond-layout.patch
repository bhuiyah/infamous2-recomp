+/* ------------------------------------------------------------------ d3d12 */
+
+static ID3D12Device* s_dev;
+static ID3D12CommandQueue* s_q;
+static ID3D12CommandAllocator* s_al;
+static ID3D12GraphicsCommandList* s_cl;
+static ID3D12Fence* s_fence;
+static UINT64 s_fv;
+static ID3D12Resource *s_rt, *s_ds, *s_up, *s_rb, *s_rbz;
+static D3D12_CPU_DESCRIPTOR_HANDLE s_rtv, s_dsv;
+static ID3D12RootSignature* s_rs;
+static ID3D12PipelineState *s_pso_wpos, *s_pso_old;
+static D3D12_PLACED_SUBRESOURCE_FOOTPRINT s_zfp;
+static float s_img[H][W][4];
+
+static int dx_fail(const char* what, HRESULT hr)
+{
+    printf("[FAIL] %s (0x%08lX)\n", what, (unsigned long)hr);
+    return 1;
+}
+
+static void barrier(ID3D12Resource* r, D3D12_RESOURCE_STATES a, D3D12_RESOURCE_STATES b)
+{
+    D3D12_RESOURCE_BARRIER rb;
+    memset(&rb, 0, sizeof rb);
+    rb.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; rb.Transition.pResource = r;
+    rb.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    rb.Transition.StateBefore = a; rb.Transition.StateAfter = b;
+    s_cl->lpVtbl->ResourceBarrier(s_cl, 1, &rb);
+}
+
+static void submit_wait(void)
+{
+    s_cl->lpVtbl->Close(s_cl);
+    s_q->lpVtbl->ExecuteCommandLists(s_q, 1, (ID3D12CommandList**)&s_cl);
+    s_q->lpVtbl->Signal(s_q, s_fence, ++s_fv);
+    HANDLE ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+    s_fence->lpVtbl->SetEventOnCompletion(s_fence, s_fv, ev);
+    WaitForSingleObject(ev, 20000);
+    CloseHandle(ev);
+    s_al->lpVtbl->Reset(s_al);
+    s_cl->lpVtbl->Reset(s_cl, s_al, NULL);
+}
+
+static void read_rt(void)
+{
+    D3D12_TEXTURE_COPY_LOCATION tl, bl;
+    memset(&tl, 0, sizeof tl); memset(&bl, 0, sizeof bl);
+    tl.pResource = s_rt; tl.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    bl.pResource = s_rb; bl.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    bl.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+    bl.PlacedFootprint.Footprint.Width = W; bl.PlacedFootprint.Footprint.Height = H;
+    bl.PlacedFootprint.Footprint.Depth = 1; bl.PlacedFootprint.Footprint.RowPitch = PITCH;
+    barrier(s_rt, D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    s_cl->lpVtbl->CopyTextureRegion(s_cl, &bl, 0, 0, 0, &tl, NULL);
+    barrier(s_rt, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    submit_wait();
+    void* m = NULL; D3D12_RANGE rr = {0, (SIZE_T)PITCH * H};
+    s_rb->lpVtbl->Map(s_rb, 0, &rr, &m);
+    for (unsigned y = 0; y < H; y++) memcpy(s_img[y], (const char*)m + (size_t)y * PITCH, W * 16u);
+    D3D12_RANGE wr = {0, 0};
+    s_rb->lpVtbl->Unmap(s_rb, 0, &wr);
+}
+
+static ID3DBlob* compile(const char* src, const char* entry, const char* target)
+{
+    ID3DBlob *b = NULL, *e = NULL;
+    HRESULT hr = D3DCompile(src, strlen(src), "trw", NULL, NULL, entry, target, 0, 0, &b, &e);
+    if (FAILED(hr)) {
+        printf("[FAIL] compile %s: %s\n", target, e ? (const char*)e->lpVtbl->GetBufferPointer(e) : "?");
+        if (e) e->lpVtbl->Release(e);
+        return NULL;
+    }
+    if (e) e->lpVtbl->Release(e);
+    return b;
+}
+
+/* The backend's VS epilogue line, verbatim, on a two-triangle quad given in
+ * NDC (quad = x0, y0, x1, y1) at clip w = wz.x, ndc z = wz.y. The output is
+ * the decompiler's PSInput up to TEXCOORD7. */
+static const char* s_vs =
+    "cbuffer VSC : register(b0) { float4 vp_posscale; float4 vp_posoffset; float4 quad; float4 wz; };\n"
+    "struct VSOut { float4 position : SV_POSITION; float4 col0 : COLOR0; float4 col1 : COLOR1;\n"
+    "    float4 fog : FOG;\n"
+    "    float4 tc0:TEXCOORD0; float4 tc1:TEXCOORD1; float4 tc2:TEXCOORD2; float4 tc3:TEXCOORD3;\n"
+    "    float4 tc4:TEXCOORD4; float4 tc5:TEXCOORD5; float4 tc6:TEXCOORD6; float4 tc7:TEXCOORD7; };\n"
+    "VSOut main(uint id : SV_VertexID) {\n"
+    "    const float2 c[6] = { float2(quad.x, quad.y), float2(quad.z, quad.y), float2(quad.x, quad.w),\n"
+    "                          float2(quad.z, quad.y), float2(quad.z, quad.w), float2(quad.x, quad.w) };\n"
+    "    const float4 _p = float4(c[id] * wz.x, wz.y * wz.x, wz.x);\n"
+    "    VSOut Out = (VSOut)0;\n"
+    "    Out.position = float4(_p.xyz * vp_posscale.xyz + _p.w * vp_posoffset.xyz, _p.w);\n"
+    "    return Out;\n"
+    "}\n";
+
+static ID3D12PipelineState* make_pso(ID3DBlob* vs, ID3DBlob* ps)
+{
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC d;
+    memset(&d, 0, sizeof d);
+    d.pRootSignature = s_rs;
+    d.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs); d.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+    d.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps); d.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    d.BlendState.RenderTarget[0].SrcBlend = D3D12_BLEND_ONE;
+    d.BlendState.RenderTarget[0].DestBlend = D3D12_BLEND_ZERO;
+    d.BlendState.RenderTarget[0].BlendOp = D3D12_BLEND_OP_ADD;
+    d.BlendState.RenderTarget[0].SrcBlendAlpha = D3D12_BLEND_ONE;
+    d.BlendState.RenderTarget[0].DestBlendAlpha = D3D12_BLEND_ZERO;
+    d.BlendState.RenderTarget[0].BlendOpAlpha = D3D12_BLEND_OP_ADD;
+    d.BlendState.RenderTarget[0].LogicOp = D3D12_LOGIC_OP_NOOP;
+    d.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    d.SampleMask = 0xFFFFFFFFu;
+    d.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    d.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    d.RasterizerState.DepthClipEnable = TRUE;
+    d.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    d.NumRenderTargets = 1;
+    d.RTVFormats[0] = DXGI_FORMAT_R32G32B32A32_FLOAT;
+    d.SampleDesc.Count = 1;
+    ID3D12PipelineState* p = NULL;
+    HRESULT hr = s_dev->lpVtbl->CreateGraphicsPipelineState(s_dev, &d, &IID_ID3D12PipelineState, (void**)&p);
+    if (FAILED(hr)) { dx_fail("CreateGraphicsPipelineState", hr); return NULL; }
+    return p;
+}
+
+/* MOV R0, f[WPOS] (END), in guest byte order (halves swapped, big-endian). */
+static void fp_put(u8* p, u32 w)
+{
+    const u32 be = (w << 16) | (w >> 16);
+    p[0] = (u8)(be >> 24); p[1] = (u8)(be >> 16); p[2] = (u8)(be >> 8); p[3] = (u8)be;
+}
+static ID3DBlob* wpos_ps(int on, char* hlsl, size_t n)
+{
+    u8 prog[16];
+    fp_put(prog + 0, (0x01u << 24) | (0xFu << 9) | (0x0u << 13) | 1u);              /* MOV R0.xyzw, f[WPOS] END */
+    fp_put(prog + 4, 1u | (0u << 9) | (1u << 11) | (2u << 13) | (3u << 15) |       /* INPUT, xyzw */
+                     (7u << 18) | (0u << 21) | (1u << 23) | (2u << 25) | (3u << 27)); /* always */
+    fp_put(prog + 8, 0); fp_put(prog + 12, 0);
+    u32 nc = 0;
+    rsx_fp_set_wpos_window(on);
+    const int r = rsx_fp_decompile_buffered_ex(prog, sizeof prog, 0x40u, 0u, hlsl, (u32)n, &nc);
+    rsx_fp_set_wpos_window(0);
+    if (r <= 0) { printf("[FAIL] decompile WPOS program (%d)\n", r); return NULL; }
+    return compile(hlsl, "main", "ps_5_0");
+}
+
+typedef struct { float posscale[4], posoffset[4], quad[4], wz[4]; } VSC;
+
+/* One draw: clear the target to 0, draw the quad. */
+static void draw(ID3D12PipelineState* pso, const VSC* vc, unsigned shader_window,
+                 D3D12_VIEWPORT vp, D3D12_RECT sc)
+{
+    char* m = NULL; D3D12_RANGE nr = {0, 0};
+    s_up->lpVtbl->Map(s_up, 0, &nr, (void**)&m);
+    memcpy(m, vc, sizeof *vc);
+    float b1[16];                                   /* fp_constants[1], fp_alpha, fp_texctl, fp_window */
+    memset(b1, 0, sizeof b1);
+    rsx_raster_wpos_consts(shader_window, b1 + 12);
+    memcpy(m + 256, b1, sizeof b1);
+    s_up->lpVtbl->Unmap(s_up, 0, NULL);
+    const float zero[4] = {0, 0, 0, 0};
+    s_cl->lpVtbl->ClearRenderTargetView(s_cl, s_rtv, zero, 0, NULL);
+    s_cl->lpVtbl->SetGraphicsRootSignature(s_cl, s_rs);
+    s_cl->lpVtbl->SetPipelineState(s_cl, pso);
+    const D3D12_GPU_VIRTUAL_ADDRESS va = s_up->lpVtbl->GetGPUVirtualAddress(s_up);
+    s_cl->lpVtbl->SetGraphicsRootConstantBufferView(s_cl, 0, va);
+    s_cl->lpVtbl->SetGraphicsRootConstantBufferView(s_cl, 1, va + 256);
+    s_cl->lpVtbl->RSSetViewports(s_cl, 1, &vp);
+    s_cl->lpVtbl->RSSetScissorRects(s_cl, 1, &sc);
+    s_cl->lpVtbl->OMSetRenderTargets(s_cl, 1, &s_rtv, FALSE, NULL);
+    s_cl->lpVtbl->IASetPrimitiveTopology(s_cl, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    s_cl->lpVtbl->DrawInstanced(s_cl, 6, 1, 0, 0);
+    read_rt();
+}
+
+/* The backend's way (raster_record_draw + raster_replay_draw): D3D viewport
+ * and epilogue from rsx_raster_host_map for a W x H frame (route 1, or route 2
+ * with s_force_epilogue), scissor the ownership rect inside the target. */
+static int s_force_epilogue;
+static void draw_guest(ID3D12PipelineState* pso, float sx, float sy, float ox, float oy,
+                       const float quad[4], float w, float z, rsx_rect own, unsigned shader_window)
+{
+    VSC vc;
+    memset(&vc, 0, sizeof vc);
+    float v4[4], k4[4];
+    rsx_raster_host_map(sx, sy, ox, oy, W, H, s_force_epilogue, v4, k4);
+    vc.posscale[0] = k4[0]; vc.posscale[1] = k4[1]; vc.posscale[2] = 1.0f;
+    vc.posoffset[0] = k4[2]; vc.posoffset[1] = k4[3];
+    memcpy(vc.quad, quad, sizeof vc.quad);
+    vc.wz[0] = w; vc.wz[1] = z;
+    D3D12_VIEWPORT vp = {v4[0], v4[1], v4[2], v4[3], 0.0f, 1.0f};
+    const rsx_rect r = rsx_rect_and(own, rsx_rect_xywh(0, 0, W, H));
+    D3D12_RECT sc = {0, 0, 0, 0};
+    if (!rsx_rect_empty(r)) { sc.left = r.x0; sc.top = r.y0; sc.right = r.x1; sc.bottom = r.y1; }
+    draw(pso, &vc, shader_window, vp, sc);
+}
+
+/* Reference coverage of the quad under window = ndc * s + o: pixel centres
+ * inside, left/top edge in; ambiguous (centre within 1e-3 of an edge) = -1. */
+static int ref_cover(unsigned i, unsigned j, float sx, float sy, float ox, float oy, const float q[4], rsx_rect own)
+{
+    const double ax = rsx_raster_window(q[0], sx, ox), bx = rsx_raster_window(q[2], sx, ox);
+    const double ay = rsx_raster_window(q[1], sy, oy), by = rsx_raster_window(q[3], sy, oy);
+    const double l = fmin(ax, bx), r = fmax(ax, bx), t = fmin(ay, by), b = fmax(ay, by);
+    const double cx = i + 0.5, cy = j + 0.5;
+    if (fabs(cx - l) < 1e-3 || fabs(cx - r) < 1e-3 || fabs(cy - t) < 1e-3 || fabs(cy - b) < 1e-3) return -1;
+    if ((int)i < own.x0 || (int)i >= own.x1 || (int)j < own.y0 || (int)j >= own.y1) return 0;
+    return cx >= l && cx < r && cy >= t && cy < b;
+}
+
+/* Coverage (alpha != 0: f[WPOS].w = 1/w and SV_Position.w = w are > 0)
+ * against the reference; the count of covered pixels out. */
+static int cover_matches(const char* name, float sx, float sy, float ox, float oy, const float q[4],
+                         rsx_rect own, unsigned* covered)
+{
+    unsigned bad = 0, amb = 0, n = 0;
+    for (unsigned j = 0; j < H; j++)
+        for (unsigned i = 0; i < W; i++) {
+            const int got = s_img[j][i][3] != 0.0f;
+            const int want = ref_cover(i, j, sx, sy, ox, oy, q, own);
+            n += (unsigned)got;
+            if (want < 0) { amb++; continue; }
+            if (got != want && bad++ < 4)
+                printf("    %s: pixel (%u, %u) covered %d, want %d\n", name, i, j, got, want);
+        }
+    if (covered) *covered = n;
+    check(name, bad == 0, "%u pixels differ (%u ambiguous skipped)", bad, amb);
+    return bad == 0;
+}
+
+/* A check name with the route: "[auto]" the backend's choice, "[epi]" route 2. */
+static const char* rn(const char* base)
+{
+    static char buf[4][96];
+    static int i = 0;
+    i = (i + 1) & 3;
+    snprintf(buf[i], sizeof buf[i], "%s[%s]", base, s_force_epilogue ? "epi" : "auto");
+    return buf[i];
+}
+
+static int warp_tests(void)
+{
+    IDXGIFactory4* fac = NULL; IDXGIAdapter* warp = NULL;
+    HRESULT hr = CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&fac);
+    if (FAILED(hr)) return dx_fail("CreateDXGIFactory1", hr);
+    if (FAILED(hr = fac->lpVtbl->EnumWarpAdapter(fac, &IID_IDXGIAdapter, (void**)&warp)))
+        return dx_fail("EnumWarpAdapter", hr);
+    if (FAILED(hr = D3D12CreateDevice((IUnknown*)warp, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&s_dev)))
+        return dx_fail("D3D12CreateDevice(WARP)", hr);
+    D3D12_COMMAND_QUEUE_DESC qd;
+    memset(&qd, 0, sizeof qd);
+    qd.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    if (FAILED(hr = s_dev->lpVtbl->CreateCommandQueue(s_dev, &qd, &IID_ID3D12CommandQueue, (void**)&s_q)) ||
+        FAILED(hr = s_dev->lpVtbl->CreateCommandAllocator(s_dev, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                                          &IID_ID3D12CommandAllocator, (void**)&s_al)) ||
+        FAILED(hr = s_dev->lpVtbl->CreateCommandList(s_dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, s_al, NULL,
+                                                     &IID_ID3D12GraphicsCommandList, (void**)&s_cl)) ||
+        FAILED(hr = s_dev->lpVtbl->CreateFence(s_dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&s_fence)))
+        return dx_fail("queue/list/fence", hr);
+
+    D3D12_HEAP_PROPERTIES hdef, hup, hrb;
+    memset(&hdef, 0, sizeof hdef); memset(&hup, 0, sizeof hup); memset(&hrb, 0, sizeof hrb);
+    hdef.Type = D3D12_HEAP_TYPE_DEFAULT; hup.Type = D3D12_HEAP_TYPE_UPLOAD; hrb.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC td;
+    memset(&td, 0, sizeof td);
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; td.Width = W; td.Height = H;
+    td.DepthOrArraySize = 1; td.MipLevels = 1; td.Format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+    td.SampleDesc.Count = 1; td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    if (FAILED(hr = s_dev->lpVtbl->CreateCommittedResource(s_dev, &hdef, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_RENDER_TARGET, NULL, &IID_ID3D12Resource, (void**)&s_rt)))
+        return dx_fail("render target", hr);
+    D3D12_RESOURCE_DESC zd = td;
+    zd.Format = DXGI_FORMAT_D32_FLOAT; zd.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+    if (FAILED(hr = s_dev->lpVtbl->CreateCommittedResource(s_dev, &hdef, D3D12_HEAP_FLAG_NONE, &zd,
+            D3D12_RESOURCE_STATE_DEPTH_WRITE, NULL, &IID_ID3D12Resource, (void**)&s_ds)))
+        return dx_fail("depth target", hr);
+    D3D12_RESOURCE_DESC bd;
+    memset(&bd, 0, sizeof bd);
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Height = 1; bd.DepthOrArraySize = 1;
+    bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    bd.Width = 4096;
+    if (FAILED(hr = s_dev->lpVtbl->CreateCommittedResource(s_dev, &hup, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&s_up)))
+        return dx_fail("upload buffer", hr);
+    bd.Width = (UINT64)PITCH * H;
+    if (FAILED(hr = s_dev->lpVtbl->CreateCommittedResource(s_dev, &hrb, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_rb)))
+        return dx_fail("readback buffer", hr);
+    UINT64 ztotal = 0;
+    s_dev->lpVtbl->GetCopyableFootprints(s_dev, &zd, 0, 1, 0, &s_zfp, NULL, NULL, &ztotal);
+    bd.Width = ztotal;
+    if (FAILED(hr = s_dev->lpVtbl->CreateCommittedResource(s_dev, &hrb, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_rbz)))
+        return dx_fail("depth readback buffer", hr);
+
+    D3D12_DESCRIPTOR_HEAP_DESC hd;
+    memset(&hd, 0, sizeof hd);
+    hd.NumDescriptors = 1; hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+    ID3D12DescriptorHeap *rh = NULL, *dh = NULL;
+    if (FAILED(hr = s_dev->lpVtbl->CreateDescriptorHeap(s_dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&rh)))
+        return dx_fail("RTV heap", hr);
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_DSV;
+    if (FAILED(hr = s_dev->lpVtbl->CreateDescriptorHeap(s_dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&dh)))
+        return dx_fail("DSV heap", hr);
+    rh->lpVtbl->GetCPUDescriptorHandleForHeapStart(rh, &s_rtv);
+    dh->lpVtbl->GetCPUDescriptorHandleForHeapStart(dh, &s_dsv);
+    s_dev->lpVtbl->CreateRenderTargetView(s_dev, s_rt, NULL, s_rtv);
+    s_dev->lpVtbl->CreateDepthStencilView(s_dev, s_ds, NULL, s_dsv);
+
+    /* Root signature: b0 (VS), b1 (PS) as root CBVs, as the backend's rp[0]/rp[2]. */
+    D3D12_ROOT_PARAMETER rp[2];
+    memset(rp, 0, sizeof rp);
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV; rp[0].Descriptor.ShaderRegister = 0;
+    rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV; rp[1].Descriptor.ShaderRegister = 1;
+    rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC rsd;
+    memset(&rsd, 0, sizeof rsd);
+    rsd.NumParameters = 2; rsd.pParameters = rp;
+    ID3DBlob *sig = NULL, *err = NULL;
+    if (FAILED(hr = D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err)))
+        return dx_fail("D3D12SerializeRootSignature", hr);
+    if (FAILED(hr = s_dev->lpVtbl->CreateRootSignature(s_dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+            sig->lpVtbl->GetBufferSize(sig), &IID_ID3D12RootSignature, (void**)&s_rs)))
+        return dx_fail("CreateRootSignature", hr);
+
+    ID3DBlob* vs = compile(s_vs, "main", "vs_5_0");
+    static char hlsl_on[65536], hlsl_off[65536];
+    ID3DBlob* ps_on = wpos_ps(1, hlsl_on, sizeof hlsl_on);
+    ID3DBlob* ps_off = wpos_ps(0, hlsl_off, sizeof hlsl_off);
+    if (!vs || !ps_on || !ps_off) return 1;
+    check("hlsl.wpos_on_reads_fp_window", strstr(hlsl_on, "float4 fp_window;") &&
+          strstr(hlsl_on, "input.position.y * fp_window.y + fp_window.z") &&
+          strstr(hlsl_on, "1.0 / input.position.w"), NULL);
+    check("hlsl.wpos_off_is_old", strstr(hlsl_off, "(float4)((input.position).xyzw)") &&
+          !strstr(hlsl_off, "fp_window") && !strstr(hlsl_off, "rsx_wpos"), NULL);
+    s_pso_wpos = make_pso(vs, ps_on);
+    s_pso_old = make_pso(vs, ps_off);
+    if (!s_pso_wpos || !s_pso_old) return 1;
+
+    const float full[4] = {-1.0f, -1.0f, 1.0f, 1.0f};
+    const rsx_rect all = rsx_rect_xywh(0, 0, W, H);
+    unsigned n = 0;
+
+    for (s_force_epilogue = 0; s_force_epilogue < 2; s_force_epilogue++) {
+    /* 1. The NDC square under a fractional transform covers exactly
+     *    rsx_raster_footprint (clip w 1, then 2.5). */
+    {
+        const float sx = 21.3f, sy = -13.7f, ox = 30.15f, oy = 22.9f;
+        const rsx_rect fp = rsx_raster_footprint(sx, sy, ox, oy);
+        for (int pass = 0; pass < 2; pass++) {
+            draw_guest(s_pso_wpos, sx, sy, ox, oy, full, pass ? 2.5f : 1.0f, 0.25f, all, 0x1000u | H);
+            unsigned bad = 0;
+            for (unsigned j = 0; j < H; j++)
+                for (unsigned i = 0; i < W; i++) {
+                    const int in = (int)i >= fp.x0 && (int)i < fp.x1 && (int)j >= fp.y0 && (int)j < fp.y1;
+                    if ((s_img[j][i][3] != 0.0f) != in) bad++;
+                }
+            check(rn(pass ? "warp.footprint_exact_w2.5" : "warp.footprint_exact"), bad == 0,
+                  "%u pixels differ from [%d,%d)x[%d,%d)", bad, fp.x0, fp.x1, fp.y0, fp.y1);
+        }
+        /* f[WPOS] there: origin bottom, half centres, w = 1/2.5 */
+        unsigned bad = 0;
+        for (unsigned j = 0; j < H; j++)
+            for (unsigned i = 0; i < W; i++) {
+                const float* p = s_img[j][i];
+                if (p[3] == 0.0f) continue;
+                if (p[0] != (float)i + 0.5f || p[1] != (float)H - ((float)j + 0.5f) ||
+                    fabsf(p[2] - 0.25f) > 1e-6f || fabsf(p[3] - 0.4f) > 1e-6f) {
+                    if (bad++ < 3) printf("    wpos (%u,%u) = (%g %g %g %g)\n", i, j, p[0], p[1], p[2], p[3]);
+                }
+            }
+        check(rn("warp.wpos_bottom_half_w"), bad == 0, "%u pixels", bad);
+    }
+
+    /* 3. A fractional transform and a sub-quad, clip w 3. */
+    {
+        const float sx = 19.37f, sy = 14.61f, ox = 31.23f, oy = 23.71f;   /* y up: NDC +1 at the bottom */
+        const float q[4] = {-0.37f, -0.83f, 0.61f, 0.29f};
+        draw_guest(s_pso_wpos, sx, sy, ox, oy, q, 3.0f, 0.1f, rsx_raster_footprint(sx, sy, ox, oy), 0x10000u | H);
+        cover_matches(rn("warp.fraction_subquad"), sx, sy, ox, oy, q, all, &n);
+        unsigned bad = 0;                              /* top, integer: (i, j) */
+        for (unsigned j = 0; j < H; j++)
+            for (unsigned i = 0; i < W; i++) {
+                const float* p = s_img[j][i];
+                if (p[3] != 0.0f && (p[0] != (float)i || p[1] != (float)j || fabsf(p[3] - 1.0f / 3.0f) > 1e-6f)) bad++;
+            }
+        check(rn("warp.wpos_top_integer"), bad == 0 && n > 50, "%u bad of %u", bad, n);
+    }
+
+    /* 5. The scissor clips; 6. the empty scissor draws nothing. */
+    {
+        const float sx = 20.0f, sy = -10.0f, ox = 30.0f, oy = 20.0f;
+        rsx_raster_regs g;
+        memset(&g, 0, sizeof g);
+        g.sx = sx; g.sy = sy; g.ox = ox; g.oy = oy;
+        g.scx = 5; g.scy = 7; g.scw = 20; g.sch = 11; g.cw = W; g.ch = H;
+        const rsx_rect own = rsx_raster_draw_own(&g, RSX_VPCLIP_FOOTPRINT, 1);
+        draw_guest(s_pso_wpos, sx, sy, ox, oy, full, 1.0f, 0.5f, own, 0x1000u | H);
+        cover_matches(rn("warp.scissor"), sx, sy, ox, oy, full, own, &n);
+        check(rn("warp.scissor_count"), n == 15u * 8u, "%u", n);
+        g.scw = 0;
+        draw_guest(s_pso_wpos, sx, sy, ox, oy, full, 1.0f, 0.5f, rsx_raster_draw_own(&g, RSX_VPCLIP_FOOTPRINT, 1),
+                   0x1000u | H);
+        unsigned any = 0;
+        for (unsigned j = 0; j < H; j++) for (unsigned i = 0; i < W; i++) any += s_img[j][i][3] != 0.0f;
+        check(rn("warp.empty_scissor_draws_nothing"), any == 0, "%u pixels", any);
+    }
+    /* 4. A transform reaching past the target (the old path fell back to the
+     *    full target here); f[WPOS] off = SV_Position. */
+    {
+        const float sx = 50.0f, sy = -40.0f, ox = 10.25f, oy = 30.5f;
+        const float q[4] = {-0.9f, -0.2f, 0.3f, 0.95f};
+        draw_guest(s_pso_old, sx, sy, ox, oy, q, 1.0f, 0.5f, rsx_raster_footprint(sx, sy, ox, oy), 0x1000u | H);
+        cover_matches(rn("warp.past_target"), sx, sy, ox, oy, q, all, &n);
+        unsigned bad = 0;
+        for (unsigned j = 0; j < H; j++)
+            for (unsigned i = 0; i < W; i++) {
+                const float* p = s_img[j][i];
+                if (p[3] != 0.0f && (p[0] != (float)i + 0.5f || p[1] != (float)j + 0.5f || p[3] != 1.0f)) bad++;
+            }
+        check(rn("warp.wpos_off_is_sv_position"), bad == 0 && n > 50, "%u bad of %u", bad, n);
+        if (s_force_epilogue) continue;     /* the old path's comparison: once */
+        /* The old path for this state: the integer rect (x = -39.75 -> wraps,
+         * w 100) leaves the target, so it drew with the full target as the
+         * viewport and identity x/y -- the comparison must see that. */
+        VSC vc;
+        memset(&vc, 0, sizeof vc);
+        vc.posscale[0] = vc.posscale[1] = vc.posscale[2] = 1.0f;
+        memcpy(vc.quad, q, sizeof vc.quad); vc.wz[0] = 1.0f; vc.wz[1] = 0.5f;
+        D3D12_VIEWPORT vp = {0.0f, 0.0f, (float)W, (float)H, 0.0f, 1.0f};
+        D3D12_RECT sc = {0, 0, (LONG)W, (LONG)H};
+        draw(s_pso_old, &vc, 0, vp, sc);
+        unsigned diff = 0;
+        for (unsigned j = 0; j < H; j++)
+            for (unsigned i = 0; i < W; i++) {
+                const int want = ref_cover(i, j, sx, sy, ox, oy, q, all);
+                if (want >= 0 && (s_img[j][i][3] != 0.0f) != want) diff++;
+            }
+        check("warp.old_path_past_target_wrong", diff > 100, "only %u pixels differ", diff);
+        printf("    old path: %u of %u pixels wrong for a transform reaching past the target\n", diff, W * H);
+    }
+
+    }   /* both routes */
+    s_force_epilogue = 0;
+
+    /* Route 1: integer window rects through the D3D viewport -- the title's
+     * off-surface rect shape (origin (-16, -8)), and a y-up, x-mirrored one. */
+    {
+        const float sx = 40.0f, sy = -20.0f, ox = 24.0f, oy = 12.0f;      /* window [-16, 64) x [-8, 32) */
+        float v4[4], k4[4];
+        check("route1.picked", rsx_raster_host_map(sx, sy, ox, oy, W, H, 0, v4, k4) == RSX_RASTER_ROUTE_VIEWPORT &&
+              v4[0] == -16.0f && v4[1] == -8.0f, NULL);
+        draw_guest(s_pso_wpos, sx, sy, ox, oy, full, 1.6f, 0.5f, rsx_raster_footprint(sx, sy, ox, oy), 0x1000u | H);
+        cover_matches("route1.negative_origin_full", sx, sy, ox, oy, full, all, &n);
+        check("route1.negative_origin_count", n == 64u * 32u, "%u", n);
+        const float q[4] = {-0.93f, -0.71f, 0.37f, 0.88f};
+        draw_guest(s_pso_wpos, sx, sy, ox, oy, q, 2.2f, 0.5f, rsx_raster_footprint(sx, sy, ox, oy), 0x1000u | H);
+        cover_matches("route1.negative_origin_subquad", sx, sy, ox, oy, q, all, &n);
+        unsigned bad = 0;
+        for (unsigned j = 0; j < H; j++)
+            for (unsigned i = 0; i < W; i++) {
+                const float* p = s_img[j][i];
+                if (p[3] != 0.0f && (p[0] != (float)i + 0.5f || p[1] != (float)H - ((float)j + 0.5f) ||
+                                     fabsf(p[3] - 1.0f / 2.2f) > 1e-6f)) bad++;
+            }
+        check("route1.wpos", bad == 0 && n > 100, "%u bad of %u", bad, n);
+        const float mx = -18.0f, my = 15.0f, mox = 29.0f, moy = 21.0f;   /* x mirrored, y up: [11, 47) x [6, 36) */
+        check("route1.mirror_picked", rsx_raster_host_map(mx, my, mox, moy, W, H, 0, v4, k4) ==
+              RSX_RASTER_ROUTE_VIEWPORT && k4[0] == -1.0f && k4[1] == -1.0f, NULL);
+        draw_guest(s_pso_old, mx, my, mox, moy, q, 1.3f, 0.5f, rsx_raster_footprint(mx, my, mox, moy), 0);
+        cover_matches("route1.mirrored_subquad", mx, my, mox, moy, q, all, &n);
+        check("route1.mirrored_nonempty", n > 100, "%u", n);
+    }
+
+    /* Why route 1 stops at integer edges: the fractional transform of check 1
+     * through a fractional D3D viewport (o - |s|, 2 |s|), identity epilogue. */
+    {
+        const float sx = 21.3f, sy = -13.7f, ox = 30.15f, oy = 22.9f;
+        VSC vc;
+        memset(&vc, 0, sizeof vc);
+        vc.posscale[0] = vc.posscale[1] = vc.posscale[2] = 1.0f;
+        memcpy(vc.quad, full, sizeof vc.quad); vc.wz[0] = 1.0f; vc.wz[1] = 0.5f;
+        D3D12_VIEWPORT vp = {ox - sx, oy + sy, 2.0f * sx, -2.0f * sy, 0.0f, 1.0f};
+        D3D12_RECT sc = {0, 0, (LONG)W, (LONG)H};
+        draw(s_pso_old, &vc, 0, vp, sc);
+        const rsx_rect fp = rsx_raster_footprint(sx, sy, ox, oy);
+        unsigned diff = 0;
+        for (unsigned j = 0; j < H; j++)
+            for (unsigned i = 0; i < W; i++) {
+                const int in = (int)i >= fp.x0 && (int)i < fp.x1 && (int)j >= fp.y0 && (int)j < fp.y1;
+                if ((s_img[j][i][3] != 0.0f) != in) diff++;
+            }
+        printf("    fractional: a D3D viewport (%g, %g) %gx%g covers %u pixels other than the footprint "
+               "[%d,%d)x[%d,%d) on this device -- route 2 for fractional edges\n",
+               (double)vp.TopLeftX, (double)vp.TopLeftY, (double)vp.Width, (double)vp.Height, diff,
+               fp.x0, fp.x1, fp.y0, fp.y1);
+    }
+
+    /* 2. libgcm's integer transform of a sub-rect (route 1, the backend's
+     *    default): identical, bit for bit, to the old path (D3D viewport =
+     *    the rect, identity epilogue, scissor = the rect), f[WPOS] off as
+     *    before. */
+    {
+        float s[2], o[2];
+        rsx_raster_rect_xform(8, 6, 40, 30, s, o);
+        const float q[4] = {-0.8f, -0.65f, 0.9f, 1.0f};
+        draw_guest(s_pso_old, s[0], s[1], o[0], o[1], q, 1.7f, 0.5f,
+                   rsx_raster_footprint(s[0], s[1], o[0], o[1]), 0);
+        static float now[H][W][4];
+        memcpy(now, s_img, sizeof now);
+        VSC vc;
+        memset(&vc, 0, sizeof vc);
+        vc.posscale[0] = vc.posscale[1] = vc.posscale[2] = 1.0f;
+        memcpy(vc.quad, q, sizeof vc.quad); vc.wz[0] = 1.7f; vc.wz[1] = 0.5f;
+        D3D12_VIEWPORT vp = {8.0f, 6.0f, 40.0f, 30.0f, 0.0f, 1.0f};
+        D3D12_RECT sc = {8, 6, 48, 36};
+        draw(s_pso_old, &vc, 0, vp, sc);
+        check("warp.libgcm_equals_old_path", !memcmp(now, s_img, sizeof now), NULL);
+        cover_matches("warp.libgcm_subrect_cover", s[0], s[1], o[0], o[1], q, all, &n);
+        check("warp.libgcm_subrect_nonempty", n > 100, "%u", n);
+    }
+
+
+    /* 7. Clears through the clear rect: colour and depth. */
+    {
+        rsx_raster_regs g;
+        memset(&g, 0, sizeof g);
+        g.scx = 5; g.scy = 7; g.scw = 20; g.sch = 11; g.cx = 0; g.cy = 0; g.cw = W; g.ch = 40;
+        const rsx_rect r = rsx_raster_clear_own(&g);
+        const float base[4] = {1, 2, 3, 4}, nine[4] = {9, 9, 9, 9};
+        s_cl->lpVtbl->ClearRenderTargetView(s_cl, s_rtv, base, 0, NULL);
+        D3D12_RECT rc = {r.x0, r.y0, r.x1, r.y1};
+        s_cl->lpVtbl->ClearRenderTargetView(s_cl, s_rtv, nine, 1, &rc);
+        s_cl->lpVtbl->ClearDepthStencilView(s_cl, s_dsv, D3D12_CLEAR_FLAG_DEPTH, 1.0f, 0, 0, NULL);
+        s_cl->lpVtbl->ClearDepthStencilView(s_cl, s_dsv, D3D12_CLEAR_FLAG_DEPTH, 0.25f, 0, 1, &rc);
+        barrier(s_ds, D3D12_RESOURCE_STATE_DEPTH_WRITE, D3D12_RESOURCE_STATE_COPY_SOURCE);
+        D3D12_TEXTURE_COPY_LOCATION tl, bl;
+        memset(&tl, 0, sizeof tl); memset(&bl, 0, sizeof bl);
+        tl.pResource = s_ds; tl.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        bl.pResource = s_rbz; bl.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT; bl.PlacedFootprint = s_zfp;
+        s_cl->lpVtbl->CopyTextureRegion(s_cl, &bl, 0, 0, 0, &tl, NULL);
+        barrier(s_ds, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_DEPTH_WRITE);
+        read_rt();
+        unsigned bad = 0, inside = 0;
+        for (unsigned j = 0; j < H; j++)
+            for (unsigned i = 0; i < W; i++) {
+                const int in = (int)i >= r.x0 && (int)i < r.x1 && (int)j >= r.y0 && (int)j < r.y1;
+                inside += (unsigned)in;
+                if (memcmp(s_img[j][i], in ? nine : base, 16)) bad++;
+            }
+        check("clear.colour_rect_only", bad == 0 && inside == 20u * 11u, "%u bad, %u inside", bad, inside);
+        void* m = NULL; D3D12_RANGE rr = {0, (SIZE_T)s_zfp.Footprint.RowPitch * H};
+        s_rbz->lpVtbl->Map(s_rbz, 0, &rr, &m);
+        bad = 0;
+        for (unsigned j = 0; j < H; j++)
+            for (unsigned i = 0; i < W; i++) {
+                const float z = ((const float*)((const char*)m + s_zfp.Offset + (size_t)j * s_zfp.Footprint.RowPitch))[i];
+                const int in = (int)i >= r.x0 && (int)i < r.x1 && (int)j >= r.y0 && (int)j < r.y1;
+                if (z != (in ? 0.25f : 1.0f)) bad++;
+            }
+        D3D12_RANGE wr = {0, 0};
+        s_rbz->lpVtbl->Unmap(s_rbz, 0, &wr);
+        check("clear.depth_rect_only", bad == 0, "%u bad", bad);
+    }
+    if (FAILED(hr = s_dev->lpVtbl->GetDeviceRemovedReason(s_dev))) return dx_fail("device removed", hr);
+    return 0;
+}
+
+int main(void)
+{
+    cpu_tests();
+    const int e = warp_tests();
+    printf("test_raster_warp: %d passed, %d failed%s\n", g_pass, g_fail, e ? " (setup error)" : "");
+    return (g_fail || e) ? 1 : 0;
+}
