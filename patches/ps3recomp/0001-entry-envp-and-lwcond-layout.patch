+
+/* ---------------------------------------------------------------- the overlay thread */
+
+typedef struct {
+    ID3D12CommandQueue*        q;
+    ID3D12CommandAllocator*    al;
+    ID3D12GraphicsCommandList* cl;
+    ID3D12Fence*               fence;
+    HANDLE                     fev;
+    UINT64                     fval;
+    IDXGISwapChain3*           sc;
+    HANDLE                     waitable;
+    ID3D12DescriptorHeap*      rtv_heap;
+    UINT                       rtv_inc;
+    int                        sc_w, sc_h;
+    void*                      dcomp;
+    int                        presented;       /* a frame of the current content was presented */
+    ovl_gpu                    gpu;
+} host_a;
+
+static host_a     A;
+static ovl_menu   s_menu;
+static ovl_font*  s_font;                       /* the atlas in use */
+static ovl_font* volatile s_font_ready;
+static volatile LONG s_font_busy;
+static ovl_list   s_list;
+
+static DWORD WINAPI atlas_worker(LPVOID p)
+{
+    const float s = (float)(uintptr_t)p / 1000.0f;
+    ovl_font* F = (ovl_font*)calloc(1, sizeof *F);
+    int faces[OVL_NFACE][2];
+    ovl_menu_faces(s, faces);
+    if (F && !ovl_font_build(F, "Segoe UI", (const int (*)[2])faces, OVL_NFACE, s)) { ovl_font_free(F); free(F); F = NULL; }
+    if (F) {
+        static int said;
+        if (!said++ || s_log)
+            ovl_logf("glyph atlas: %s, %dx%d, scale %.2f, built in %.1f ms (worker thread)", F->family, F->w, F->h, s, F->build_ms);
+        if (strcmp(F->family, "Segoe UI")) ovl_logf("Segoe UI is not installed: GDI substituted %s", F->family);
+    } else ovl_logf("glyph atlas: build failed (scale %.2f)", s);
+    InterlockedExchangePointer((PVOID volatile*)&s_font_ready, F);
+    InterlockedExchange(&s_font_busy, 0);
+    SetEvent(s_wake);
+    return 0;
+}
+
+static void want_atlas(float s)
+{
+    if (s_font && fabsf(s_font->scale - s) < 0.001f) return;
+    if (s_font_ready || InterlockedCompareExchange(&s_font_busy, 1, 0) != 0) return;
+    HANDLE t = CreateThread(NULL, 0, atlas_worker, (LPVOID)(uintptr_t)(s * 1000.0f + 0.5f), 0, NULL);
+    if (t) CloseHandle(t);
+    else InterlockedExchange(&s_font_busy, 0);
+}
+
+static void a_wait_idle(void)
+{
+    if (!A.fence) return;
+    if (A.fence->lpVtbl->GetCompletedValue(A.fence) < A.fval) {
+        A.fence->lpVtbl->SetEventOnCompletion(A.fence, A.fval, A.fev);
+        WaitForSingleObject(A.fev, 2000);
+    }
+}
+
+static int a_init_queue(void)
+{
+    ID3D12Device* dev = s_dev;
+    D3D12_COMMAND_QUEUE_DESC qd;
+    memset(&qd, 0, sizeof qd);
+    qd.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    if (FAILED(dev->lpVtbl->CreateCommandQueue(dev, &qd, &IID_ID3D12CommandQueue, (void**)&A.q)) ||
+        FAILED(dev->lpVtbl->CreateCommandAllocator(dev, D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator, (void**)&A.al)) ||
+        FAILED(dev->lpVtbl->CreateCommandList(dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, A.al, NULL,
+                                              &IID_ID3D12GraphicsCommandList, (void**)&A.cl)) ||
+        FAILED(dev->lpVtbl->CreateFence(dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&A.fence)) ||
+        !(A.fev = CreateEventA(NULL, FALSE, FALSE, NULL)))
+        return 0;
+    A.cl->lpVtbl->Close(A.cl);
+    D3D12_DESCRIPTOR_HEAP_DESC hd = { D3D12_DESCRIPTOR_HEAP_TYPE_RTV, 2, D3D12_DESCRIPTOR_HEAP_FLAG_NONE, 0 };
+    if (FAILED(dev->lpVtbl->CreateDescriptorHeap(dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&A.rtv_heap))) return 0;
+    A.rtv_inc = dev->lpVtbl->GetDescriptorHandleIncrementSize(dev, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    return 1;
+}
+
+static void a_make_rtvs(void)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    A.rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(A.rtv_heap, &h);
+    for (UINT i = 0; i < 2; i++) {
+        ID3D12Resource* b = NULL;
+        if (SUCCEEDED(A.sc->lpVtbl->GetBuffer(A.sc, i, &IID_ID3D12Resource, (void**)&b)) && b) {
+            D3D12_CPU_DESCRIPTOR_HANDLE hi = h;
+            hi.ptr += i * A.rtv_inc;
+            s_dev->lpVtbl->CreateRenderTargetView(s_dev, b, NULL, hi);
+            b->lpVtbl->Release(b);
+        }
+    }
+}
+
+/* The composition swap chain (FRAME_LATENCY_WAITABLE_OBJECT: every
+ * ResizeBuffers has to repeat the flag). */
+static int a_init_chain(int w, int h)
+{
+    IDXGIFactory2* fac = NULL;
+    if (FAILED(CreateDXGIFactory1(&IID_IDXGIFactory2, (void**)&fac))) return 0;
+    DXGI_SWAP_CHAIN_DESC1 d;
+    memset(&d, 0, sizeof d);
+    d.Width = (UINT)w; d.Height = (UINT)h;
+    d.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    d.SampleDesc.Count = 1;
+    d.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    d.BufferCount = 2;
+    d.SwapEffect = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
+    d.Scaling = DXGI_SCALING_STRETCH;
+    d.AlphaMode = DXGI_ALPHA_MODE_PREMULTIPLIED;
+    d.Flags = DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT;
+    IDXGISwapChain1* sc1 = NULL;
+    HRESULT hr = fac->lpVtbl->CreateSwapChainForComposition(fac, (IUnknown*)A.q, &d, NULL, &sc1);
+    fac->lpVtbl->Release(fac);
+    if (FAILED(hr)) { ovl_logf("composition swap chain failed 0x%08lX", (unsigned long)hr); return 0; }
+    hr = sc1->lpVtbl->QueryInterface(sc1, &IID_IDXGISwapChain3, (void**)&A.sc);
+    sc1->lpVtbl->Release(sc1);
+    if (FAILED(hr)) return 0;
+    A.sc->lpVtbl->SetMaximumFrameLatency(A.sc, 1);
+    A.waitable = A.sc->lpVtbl->GetFrameLatencyWaitableObject(A.sc);
+    A.sc_w = w; A.sc_h = h;
+    a_make_rtvs();
+    return 1;
+}
+
+static int a_resize(int w, int h)
+{
+    if (w <= 0 || h <= 0) return 0;                  /* minimised: ResizeBuffers(0x0) is E_INVALIDARG */
+    if (w == A.sc_w && h == A.sc_h) return 1;
+    a_wait_idle();
+    HRESULT hr = A.sc->lpVtbl->ResizeBuffers(A.sc, 2, (UINT)w, (UINT)h, DXGI_FORMAT_B8G8R8A8_UNORM,
+                                             DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT);
+    if (FAILED(hr)) { ovl_logf("ResizeBuffers %dx%d failed 0x%08lX", w, h, (unsigned long)hr); return 0; }
+    A.sc_w = w; A.sc_h = h;
+    a_make_rtvs();
+    A.presented = 0;
+    if (s_log) ovl_logf("overlay surface %dx%d", w, h);
+    return 1;
+}
+
+static void a_present(const ovl_list* L)
+{
+    if (A.waitable) WaitForSingleObject(A.waitable, 100);
+    a_wait_idle();
+    const UINT idx = A.sc->lpVtbl->GetCurrentBackBufferIndex(A.sc);
+    ID3D12Resource* bb = NULL;
+    if (FAILED(A.sc->lpVtbl->GetBuffer(A.sc, idx, &IID_ID3D12Resource, (void**)&bb)) || !bb) return;
+    A.al->lpVtbl->Reset(A.al);
+    A.cl->lpVtbl->Reset(A.cl, A.al, NULL);
+    D3D12_RESOURCE_BARRIER br;
+    memset(&br, 0, sizeof br);
+    br.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    br.Transition.pResource = bb;
+    br.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    br.Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT;
+    br.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    A.cl->lpVtbl->ResourceBarrier(A.cl, 1, &br);
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv;
+    A.rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(A.rtv_heap, &rtv);
+    rtv.ptr += idx * A.rtv_inc;
+    const float clr[4] = { 0, 0, 0, 0 };
+    A.cl->lpVtbl->ClearRenderTargetView(A.cl, rtv, clr, 0, NULL);
+    ovl_gpu_record(&A.gpu, A.cl, L, rtv, 0, 0, (float)L->W, (float)L->H);
+    br.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    br.Transition.StateAfter = D3D12_RESOURCE_STATE_PRESENT;
+    A.cl->lpVtbl->ResourceBarrier(A.cl, 1, &br);
+    A.cl->lpVtbl->Close(A.cl);
+    A.q->lpVtbl->ExecuteCommandLists(A.q, 1, (ID3D12CommandList**)&A.cl);
+    A.q->lpVtbl->Signal(A.q, A.fence, ++A.fval);
+    bb->lpVtbl->Release(bb);
+    HRESULT hr = A.sc->lpVtbl->Present(A.sc, 1, 0);
+    if (FAILED(hr)) { static int said; if (said++ < 3) ovl_logf("overlay Present failed 0x%08lX", (unsigned long)hr); }
+    A.presented = 1;
+}
+
+static void a_detach(void)
+{
+    if (!A.dcomp) return;
+    ovl_dcomp_release(A.dcomp);
+    A.dcomp = NULL;
+    if (s_log) ovl_logf("composition detached (nothing above the game's picture)");
+}
+
+static int a_attach(void)
+{
+    if (A.dcomp) return 1;
+    long hr = 0;
+    A.dcomp = ovl_dcomp_attach(s_top, A.sc, &hr);
+    if (!A.dcomp) { ovl_logf("DirectComposition attach failed 0x%08lX", (unsigned long)hr); return 0; }
+    if (s_log) ovl_logf("composition attached");
+    return 1;
+}
+
+/* The picture's rectangle in the client area (the view child, or all of it). */
+static void picture_rect(RECT* r, int cw, int ch)
+{
+    SetRect(r, 0, 0, cw, ch);
+    HWND v = FindWindowExA(s_top, NULL, "ps3recomp_d3d12_view", NULL);
+    if (v) {
+        RECT wr;
+        if (GetWindowRect(v, &wr)) {
+            POINT a = { wr.left, wr.top }, b = { wr.right, wr.bottom };
+            ScreenToClient(s_top, &a);
+            ScreenToClient(s_top, &b);
+            if (b.x > a.x && b.y > a.y) SetRect(r, a.x, a.y, b.x, b.y);
+        }
+    }
+}
