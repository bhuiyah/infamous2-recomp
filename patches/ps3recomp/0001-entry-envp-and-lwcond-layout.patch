+/* X16: one channel, presented {R,1,R,1}. inFamous 2's specular-power lookup
+ * (1024x8 X16, CONTROL1 0xAAEE) reads X on every output; with the generic
+ * ARGB lanes it read resource component 2 -- zero. */
+static void test_remap_x16(void)
+{
+    u8 m[4];
+    rsx_texture_component_remap(0x0000AAEEu, FMT_X16 | FMT_LN, m);
+    for (int i = 0; i < 4; i++) CHECK_EQ(m[i], 0);
+    rsx_texture_component_remap(0xAAE4u, FMT_X16, m);           /* -> 0x66 */
+    CHECK_EQ(m[A_], 0); CHECK_EQ(m[R_], RSX_REMAP_ONE);
+    CHECK_EQ(m[G_], 0); CHECK_EQ(m[B_], RSX_REMAP_ONE);
+    u8 z[4];
+    rsx_texture_component_remap(0u, FMT_X16, z);                /* unset = identity */
+    for (int i = 0; i < 4; i++) CHECK_EQ(z[i], m[i]);
+    rsx_texture_component_remap(0x0001AAE4u, FMT_X16, m);       /* -> 0x56 */
+    CHECK_EQ(m[A_], 0); CHECK_EQ(m[R_], RSX_REMAP_ONE);
+    CHECK_EQ(m[G_], RSX_REMAP_ONE); CHECK_EQ(m[B_], RSX_REMAP_ONE);
+    rsx_texture_component_remap(0xAA44u, FMT_X16, m);           /* -> 0x55 */
+    for (int i = 0; i < 4; i++) CHECK_EQ(m[i], RSX_REMAP_ONE);
+    rsx_texture_component_remap(0x50EEu, FMT_X16, m);           /* B,G one; R,A zero */
+    CHECK_EQ(m[A_], RSX_REMAP_ZERO); CHECK_EQ(m[R_], RSX_REMAP_ZERO);
+    CHECK_EQ(m[G_], RSX_REMAP_ONE);  CHECK_EQ(m[B_], RSX_REMAP_ONE);
+}
+
+/* Y16_X16: {G,R,G,R} like G8B8, with the 16-bit-block rewrite: 0xAAE4 reads
+ * (A,R,G,B) = (c1, c0, c1, c0) -- inFamous 2's water normal map. */
+static void test_remap_y16x16(void)
+{
+    u8 m[4];
+    rsx_texture_component_remap(0xAAE4u, FMT_Y16X16, m);
+    CHECK_EQ(m[A_], 1); CHECK_EQ(m[R_], 0); CHECK_EQ(m[G_], 1); CHECK_EQ(m[B_], 0);
+    rsx_texture_component_remap(0xAAEEu, FMT_Y16X16 | FMT_LN, m);   /* -> 0xAA: lane G */
+    for (int i = 0; i < 4; i++) CHECK_EQ(m[i], 1);
+    rsx_texture_component_remap(0xAA4Eu, FMT_Y16X16, m);            /* -> 0x99 */
+    CHECK_EQ(m[A_], 0); CHECK_EQ(m[R_], 1); CHECK_EQ(m[G_], 0); CHECK_EQ(m[B_], 1);
+    /* the words stay in memory order, each byte-swapped */
+    rsx_tex_layout L;
+    rsx_texture_layout(FMT_Y16X16 | FMT_LN, 1, 1, &L);
+    const u8 src[4] = {0x12, 0x34, 0xAB, 0xCD};
+    u8 dst[4] = {0};
+    rsx_texture_decode(dst, 4, src, 1, 1, &L, 0);
+    CHECK_EQ(dst[0], 0x34); CHECK_EQ(dst[1], 0x12); CHECK_EQ(dst[2], 0xCD); CHECK_EQ(dst[3], 0xAB);
+}
