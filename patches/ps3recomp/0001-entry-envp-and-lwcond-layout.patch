+/* A resource's integer factors (1 when not scaled). */
+static u32 rs_kx_of(u32 w, u32 hw) { return (w && hw > w && hw % w == 0) ? hw / w : 1u; }
+static u32 rs_bpp(u32 dxgi)
+{
