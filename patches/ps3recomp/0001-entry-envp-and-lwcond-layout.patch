+static void gcm_vsync_pace(void)
+{
+#ifdef _WIN32
+    pace_parse();
+    if (s_pace_mode <= 0) return;
+    static LARGE_INTEGER f;
+    static HANDLE tmr;
+    static LONGLONG next, last_rel, spin, ph, per_fb;
+    static int k_auto = 1, warned, logon = -1, hist_n, fit1_run;
+    static unsigned char miss_hist[10];
+    static unsigned n_fr, n_miss, n_up, n_down; static double w_sum, wait_sum; static LONGLONG log_t0;
+    if (!f.QuadPart) {
+        QueryPerformanceFrequency(&f);
+        spin = f.QuadPart / 2000;                                /* 0.5 ms */
+        ph = f.QuadPart / 2000;                                  /* release 0.5 ms after the vblank */
+        tmr = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+        if (!tmr) tmr = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+        DEVMODEA dm; memset(&dm, 0, sizeof dm); dm.dmSize = sizeof dm;
+        const DWORD hz = (EnumDisplaySettingsA(NULL, ENUM_CURRENT_SETTINGS, &dm) && dm.dmDisplayFrequency > 1)
+                         ? dm.dmDisplayFrequency : 60u;
+        per_fb = f.QuadPart / (LONGLONG)hz;
+        const char* e = getenv("FRAME_LIMIT_LOG");
+        logon = (e && *e && *e != '0') ? 1 : 0;
+    }
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+    LONGLONG vb = 0, per = 0;
+    const int have_vb = pace_vblank(&vb, &per);
+    if (!have_vb) per = per_fb;
+    const double refresh = (double)f.QuadPart / (double)per;
+    /* the guest's busy time since its last release: what auto decides on */
+    const LONGLONG work = last_rel ? now.QuadPart - last_rel : 0;
+    int k;
+    LONGLONG step;
+    if (s_pace_mode == 1) {
+        const double kk = refresh / s_pace_hz;
+        const int ki = (int)(kk + 0.5);
+        const double dk = kk - (double)ki;
+        if (ki >= 1 && ki <= 8 && (dk < 0 ? -dk : dk) < 0.005 * kk) { k = ki; step = (LONGLONG)k * per; }
+        else {
+            k = 0; step = (LONGLONG)((double)f.QuadPart / s_pace_hz + 0.5);
+            if (!warned++)
+                fprintf(stderr, "[pace] FRAME_LIMIT=%g is not the refresh rate (%.3f Hz) over a whole number: a"
+                                " plain %.3f ms cadence, shown as a mix of %d- and %d-vblank frames on a fixed-refresh"
+                                " display (even only with VRR)%c", s_pace_hz, refresh, 1000.0 / s_pace_hz,
+                        (int)kk, (int)kk + 1, 10);
+        }
+    } else {
+        /* the most vblanks a frame may take: 3, or down to auto:<min hz> */
+        int kmax = s_pace_hz > 0.0 ? (int)(refresh / s_pace_hz + 0.005) : 3;
+        if (kmax < 1) kmax = 1; if (kmax > 8) kmax = 8;
+        if (k_auto > kmax) k_auto = kmax;
+        if (work) {
+            const LONGLONG margin = f.QuadPart * 15 / 10000;     /* 1.5 ms */
+            const int fit_lo = k_auto > 1 && work + margin <= (LONGLONG)(k_auto - 1) * per - ph;
+            miss_hist[hist_n++ % 10] = (unsigned char)(work + margin > (LONGLONG)k_auto * per - ph);
+            int nm = 0; for (int i = 0; i < 10; i++) nm += miss_hist[i];
+            fit1_run = fit_lo ? fit1_run + 1 : 0;          /* frames in a row that fitted k-1 */
+            if (k_auto < kmax && nm >= 2) { k_auto++; n_up++; fit1_run = 0; memset(miss_hist, 0, sizeof miss_hist); }
+            else if (fit1_run >= 150) { k_auto--; n_down++; fit1_run = 0; memset(miss_hist, 0, sizeof miss_hist); }
+        }
+        k = k_auto; step = (LONGLONG)k * per;
+    }
+    g_pace_k = k;
+    LONGLONG target = next ? next : now.QuadPart;
+    if (k && have_vb) {                    /* onto the vblank grid, ph after a vblank */
+        LONGLONG d = target - vb - ph, j = d >= 0 ? (d + per / 2) / per : -((-d + per / 2) / per);
+        target = vb + ph + j * per;
+    }
+    if (now.QuadPart > target) {           /* missed: the next grid point, or now */
+        n_miss++;
+        if (k && have_vb) {
+            const LONGLONG d = now.QuadPart - vb - ph;
+            target = vb + ph + (d / per + 1) * per;
+        } else target = now.QuadPart;
+    }
+    if (now.QuadPart < target) {
+        const LONGLONG left = target - now.QuadPart;
+        if (tmr && left > spin) {
+            LARGE_INTEGER due;
+            due.QuadPart = -((left - spin) * 10000000 / f.QuadPart);
+            if (SetWaitableTimer(tmr, &due, 0, NULL, NULL, FALSE))
+                WaitForSingleObject(tmr, (DWORD)(left * 1000 / f.QuadPart) + 2u);
+        }
+        do { YieldProcessor(); QueryPerformanceCounter(&now); } while (now.QuadPart < target);
+        wait_sum += (double)left / (double)f.QuadPart;
+    }
+    last_rel = target;
+    next = target + step;
+    n_fr++; w_sum += (double)work / (double)f.QuadPart;
+    if (logon) {
+        if (!log_t0) log_t0 = now.QuadPart;
+        if (now.QuadPart - log_t0 >= f.QuadPart) {
+            fprintf(stderr, "[pace] %s k=%d (%.2f Hz of %.3f Hz%s) | %u frames, %u missed their vblank | guest busy"
+                            " %.2f ms/frame, held %.2f ms/frame | auto steps up %u down %u%c",
+                    s_pace_mode == 2 ? "auto" : "fixed", k, k ? refresh / k : s_pace_hz, refresh,
+                    have_vb ? ", DWM vblank grid" : ", no DWM timing: QPC", n_fr, n_miss,
+                    n_fr ? 1e3 * w_sum / n_fr : 0.0, n_fr ? 1e3 * wait_sum / n_fr : 0.0, n_up, n_down, 10);
+            log_t0 = now.QuadPart; n_fr = n_miss = n_up = n_down = 0; w_sum = wait_sum = 0.0;
+        }
+    }
+#endif
+}
