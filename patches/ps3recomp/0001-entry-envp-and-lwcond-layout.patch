+            SIZE_T len = 0; iq->lpVtbl->GetMessage(iq, i, NULL, &len);
+            D3D12_MESSAGE* msg = (D3D12_MESSAGE*)malloc(len);
+            if (msg && SUCCEEDED(iq->lpVtbl->GetMessage(iq, i, msg, &len)) &&
+                msg->Severity <= D3D12_MESSAGE_SEVERITY_ERROR) {
+                errors++; printf("  debug layer: %s\n", msg->pDescription);
+            }
+            free(msg);
+        }
+        CHECK(errors == 0, "debug layer errors: %u", errors);
+    }
+    printf("test_report_d3d12: %d passed, %d failed\n", s_pass, s_fail);
+    return s_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_res_pass_warp.c b/libs/video/tests/test_res_pass_warp.c
new file mode 100644
index 0000000..b0571fb
--- /dev/null
+++ b/libs/video/tests/test_res_pass_warp.c
@@ -0,0 +1,388 @@
+/*
+ * ps3recomp - the RES_SCALE passes (libs/video/rsx_res_pass.c) on a real D3D12
+ * device (WARP), against the pure rules of rsx_res_scale.h:
+ *
+ *   pick.x2 / pick.x3   rsx_rs_nearest_cs shrinking a host surface to the guest
+ *                       size returns exactly src[rsx_rs_pick(i), rsx_rs_pick(j)]
+ *                       for every guest pixel (the NV3089 readback's resolve:
+ *                       exact texels, never an average), RGBA8 and RGBA16F
+ *   up.x2               growing (the DB_SNAP spread / seed upscale) returns
+ *                       src[rsx_rs_guest_of(i), rsx_rs_guest_of(j)]
+ *   blit.1to1           rsx_rs_blit at 1:1 is the texel itself (any filter state)
+ *   blit.box2 / box3    an integer shrink is the k x k box mean (gamma space:
+ *                       within 1/255 of the exact mean; WARP filters a tap on a
+ *                       texel centre to that texel)
+ *   blit.gamma          the video-out exponent applied after the resample
+ *   up.twin.*           the window pass's kernels (opts.filter: bilinear, Catmull-Rom,
+ *                       Lanczos-2; rsx_upscale.h) against their CPU twin rsx_up_sample,
+ *                       with and without the anti-ringing clamp: upscale 2.0 x 1.5
+ *                       (1280x720 -> 2560x1080), 1.333 x 1 (-> 1707x720), downsample
+ *                       2 x 1.333 and 1.5 x 2 in linear light (RES_SCALE x2 / x3 ->
+ *                       2560x1080), 1:1 (exact): every channel within 1/255
+ *   up.flat             a flat colour stays exact through every kernel
+ *   up.ring             a hard step: Lanczos-2 unclamped over- and undershoots, clamped
+ *                       stays inside the step's two levels (no halo)
+ *   up.gamma            the video-out exponent after a kernel
+ *
+ * Windows only. From external/ps3recomp:
+ *   clang-cl /nologo -I libs/video libs/video/tests/test_res_pass_warp.c libs/video/rsx_res_pass.c
+ *     d3d12.lib dxgi.lib d3dcompiler.lib dxguid.lib /Fe:T/test_res_pass_warp.exe
+ */
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <math.h>
+#include "rsx_res_scale.h"
+#include "rsx_res_pass.h"
+#include "rsx_upscale.h"
+#pragma comment(lib, "d3d12.lib")
+#pragma comment(lib, "dxgi.lib")
+#pragma comment(lib, "dxguid.lib")
+
+static int g_fail, g_pass;
+#define CHECK(c, ...) do { if (c) g_pass++; else { g_fail++; printf("FAIL: "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static ID3D12Device* dev; static ID3D12CommandQueue* q; static ID3D12CommandAllocator* al;
+static ID3D12GraphicsCommandList* cl; static ID3D12Fence* fence; static UINT64 fv;
+
+static void run_list(void)
+{
+    cl->lpVtbl->Close(cl);
+    ID3D12CommandList* l[] = { (ID3D12CommandList*)cl };
+    q->lpVtbl->ExecuteCommandLists(q, 1, l);
+    q->lpVtbl->Signal(q, fence, ++fv);
+    HANDLE e = CreateEventA(NULL, FALSE, FALSE, NULL);
+    fence->lpVtbl->SetEventOnCompletion(fence, fv, e);
+    WaitForSingleObject(e, INFINITE); CloseHandle(e);
+    al->lpVtbl->Reset(al);
+    cl->lpVtbl->Reset(cl, al, NULL);
+}
+
+static ID3D12Resource* tex(unsigned w, unsigned h, DXGI_FORMAT f, D3D12_RESOURCE_FLAGS fl, D3D12_RESOURCE_STATES st)
+{
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; td.Width = w; td.Height = h; td.DepthOrArraySize = 1;
+    td.MipLevels = 1; td.Format = f; td.SampleDesc.Count = 1; td.Flags = fl;
+    ID3D12Resource* r = NULL;
+    dev->lpVtbl->CreateCommittedResource(dev, &hp, D3D12_HEAP_FLAG_NONE, &td, st, NULL, &IID_ID3D12Resource, (void**)&r);
+    return r;
+}
+static ID3D12Resource* buf(UINT64 n, D3D12_HEAP_TYPE t, D3D12_RESOURCE_STATES st)
+{
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = t;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = n; bd.Height = 1; bd.DepthOrArraySize = 1;
+    bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* r = NULL;
+    dev->lpVtbl->CreateCommittedResource(dev, &hp, D3D12_HEAP_FLAG_NONE, &bd, st, NULL, &IID_ID3D12Resource, (void**)&r);
+    return r;
+}
+static void barrier(ID3D12Resource* r, D3D12_RESOURCE_STATES a, D3D12_RESOURCE_STATES b)
+{
+    D3D12_RESOURCE_BARRIER t = {0};
+    t.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; t.Transition.pResource = r;
+    t.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    t.Transition.StateBefore = a; t.Transition.StateAfter = b;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &t);
+}
+/* Upload bytes (bpp bytes/texel) into a texture in COPY_DEST, leaves it in `after`. */
+static void upload(ID3D12Resource* t, unsigned w, unsigned h, unsigned bpp, DXGI_FORMAT f, const uint8_t* src,
+                   D3D12_RESOURCE_STATES after)
+{
+    const UINT pitch = (w * bpp + 255u) & ~255u;
+    ID3D12Resource* up = buf((UINT64)pitch * h, D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_STATE_GENERIC_READ);
+    uint8_t* m = NULL; D3D12_RANGE nr = {0, 0};
+    up->lpVtbl->Map(up, 0, &nr, (void**)&m);
+    for (unsigned y = 0; y < h; y++) memcpy(m + (size_t)y * pitch, src + (size_t)y * w * bpp, (size_t)w * bpp);
+    up->lpVtbl->Unmap(up, 0, NULL);
+    D3D12_TEXTURE_COPY_LOCATION d = {0}, s = {0};
+    d.pResource = t; d.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    s.pResource = up; s.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    s.PlacedFootprint.Footprint.Format = f; s.PlacedFootprint.Footprint.Width = w;
+    s.PlacedFootprint.Footprint.Height = h; s.PlacedFootprint.Footprint.Depth = 1; s.PlacedFootprint.Footprint.RowPitch = pitch;
+    cl->lpVtbl->CopyTextureRegion(cl, &d, 0, 0, 0, &s, NULL);
+    barrier(t, D3D12_RESOURCE_STATE_COPY_DEST, after);
+    run_list();
+    up->lpVtbl->Release(up);
+}
+/* Read a texture (in state `st`) back into out (tight rows). */
+static void readback(ID3D12Resource* t, unsigned w, unsigned h, unsigned bpp, DXGI_FORMAT f, D3D12_RESOURCE_STATES st,
+                     uint8_t* out)
+{
+    const UINT pitch = (w * bpp + 255u) & ~255u;
+    ID3D12Resource* rb = buf((UINT64)pitch * h, D3D12_HEAP_TYPE_READBACK, D3D12_RESOURCE_STATE_COPY_DEST);
+    barrier(t, st, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    D3D12_TEXTURE_COPY_LOCATION d = {0}, s = {0};
+    d.pResource = rb; d.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    d.PlacedFootprint.Footprint.Format = f; d.PlacedFootprint.Footprint.Width = w;
+    d.PlacedFootprint.Footprint.Height = h; d.PlacedFootprint.Footprint.Depth = 1; d.PlacedFootprint.Footprint.RowPitch = pitch;
+    s.pResource = t; s.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    cl->lpVtbl->CopyTextureRegion(cl, &d, 0, 0, 0, &s, NULL);
+    barrier(t, D3D12_RESOURCE_STATE_COPY_SOURCE, st);
+    run_list();
+    uint8_t* m = NULL; D3D12_RANGE rr = {0, (SIZE_T)pitch * h};
+    rb->lpVtbl->Map(rb, 0, &rr, (void**)&m);
+    for (unsigned y = 0; y < h; y++) memcpy(out + (size_t)y * w * bpp, m + (size_t)y * pitch, (size_t)w * bpp);
+    rb->lpVtbl->Unmap(rb, 0, NULL);
+    rb->lpVtbl->Release(rb);
+}
+
+static ID3D12DescriptorHeap* s_heap;
+/* The nearest CS from src (sw x sh) to a new dst (dw x dh); returns dst's bytes. */
+static uint8_t* nearest(const uint8_t* sbytes, unsigned sw, unsigned sh, unsigned dw, unsigned dh, unsigned bpp, DXGI_FORMAT f)
+{
+    ID3D12Resource* s = tex(sw, sh, f, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST);
+    ID3D12Resource* d = tex(dw, dh, f, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    upload(s, sw, sh, bpp, f, sbytes, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    cl->lpVtbl->SetDescriptorHeaps(cl, 1, &s_heap);
+    D3D12_CPU_DESCRIPTOR_HANDLE c; D3D12_GPU_DESCRIPTOR_HANDLE g;
+    s_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_heap, &c);
+    s_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_heap, &g);
+    const int ok = rsx_rs_nearest_cs(dev, cl, s, f, sw, sh, d, f, dw, dh, c,
+                                     dev->lpVtbl->GetDescriptorHandleIncrementSize(dev, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV), g);
+    CHECK(ok, "nearest_cs ran %ux%u -> %ux%u", sw, sh, dw, dh);
+    run_list();
+    uint8_t* out = (uint8_t*)malloc((size_t)dw * dh * bpp);
+    readback(d, dw, dh, bpp, f, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, out);
+    s->lpVtbl->Release(s); d->lpVtbl->Release(d);
+    return out;
+}
+/* rsx_rs_blit from src (sw x sh RGBA8) to a new dw x dh RGBA8 target; returns its bytes. filter / antiring:
+ * rsx_rs_blit_opts' kernel (0 = the plain resample). */
+static uint8_t* blitk(const uint8_t* sbytes, unsigned sw, unsigned sh, unsigned dw, unsigned dh, int lin, float e,
+                      int filter, int antiring)
+{
+    const DXGI_FORMAT f = DXGI_FORMAT_R8G8B8A8_UNORM;
+    ID3D12Resource* s = tex(sw, sh, f, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST);
+    ID3D12Resource* d = tex(dw, dh, f, D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    upload(s, sw, sh, 4, f, sbytes, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    ID3D12DescriptorHeap* rh = NULL;
+    D3D12_DESCRIPTOR_HEAP_DESC hd = {0}; hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV; hd.NumDescriptors = 1;
+    dev->lpVtbl->CreateDescriptorHeap(dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&rh);
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv; rh->lpVtbl->GetCPUDescriptorHandleForHeapStart(rh, &rtv);
+    dev->lpVtbl->CreateRenderTargetView(dev, d, NULL, rtv);
+    rsx_rs_blit_opts o; memset(&o, 0, sizeof o); o.linear_light = lin; o.gamma_e = e;
+    o.filter = filter; o.antiring = antiring;
+    const int ok = rsx_rs_blit(dev, cl, s, f, sw, sh, rtv, f, dw, dh, &o);
+    CHECK(ok, "blit ran %ux%u -> %ux%u", sw, sh, dw, dh);
+    run_list();
+    uint8_t* out = (uint8_t*)malloc((size_t)dw * dh * 4);
+    readback(d, dw, dh, 4, f, D3D12_RESOURCE_STATE_RENDER_TARGET, out);
+    s->lpVtbl->Release(s); d->lpVtbl->Release(d); rh->lpVtbl->Release(rh);
+    return out;
+}
+static uint8_t* blit(const uint8_t* sbytes, unsigned sw, unsigned sh, unsigned dw, unsigned dh, int lin, float e)
+{
+    return blitk(sbytes, sw, sh, dw, dh, lin, e, 0, 0);
+}
+/* The CPU twin's bytes for the same blit. */
+static uint8_t* twin(const uint8_t* sbytes, unsigned sw, unsigned sh, unsigned dw, unsigned dh, int lin, float e,
+                     int filter, int antiring)
+{
+    float* fs = (float*)malloc((size_t)sw * sh * 16);
+    for (size_t i = 0; i < (size_t)sw * sh * 4; i++) fs[i] = sbytes[i] / 255.0f;
+    uint8_t* out = (uint8_t*)malloc((size_t)dw * dh * 4);
+    const int l = rsx_up_linear(lin, sw, sh, dw, dh);
+    for (unsigned y = 0; y < dh; y++)
+        for (unsigned x = 0; x < dw; x++) {
+            float o[4];
+            rsx_up_sample(fs, sw, sh, filter, dw, dh, x, y, l, antiring, e, o);
+            for (int c = 0; c < 4; c++) out[((size_t)y * dw + x) * 4 + c] = (uint8_t)floor(o[c] * 255.0f + 0.5f);
+        }
+    free(fs);
+    return out;
+}
+
+static const char* fn_name(int f) { return f == 1 ? "bilinear" : f == 2 ? "bicubic" : f == 3 ? "lanczos" : "plain"; }
+static uint32_t rng = 12345u;
+static uint8_t rnd8(void) { rng = rng * 1664525u + 1013904223u; return (uint8_t)(rng >> 24); }
+
+int main(void)
+{
+    HRESULT hr;
+    IDXGIFactory4* fac = NULL; IDXGIAdapter* warp = NULL;
+    if (FAILED(hr = CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&fac)) ||
+        FAILED(hr = fac->lpVtbl->EnumWarpAdapter(fac, &IID_IDXGIAdapter, (void**)&warp)) ||
+        FAILED(hr = D3D12CreateDevice((IUnknown*)warp, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&dev))) {
+        printf("no WARP device (0x%08lX)\n", (unsigned long)hr); return 2; }
+    D3D12_COMMAND_QUEUE_DESC qd = {0}; qd.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    dev->lpVtbl->CreateCommandQueue(dev, &qd, &IID_ID3D12CommandQueue, (void**)&q);
+    dev->lpVtbl->CreateCommandAllocator(dev, D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator, (void**)&al);
+    dev->lpVtbl->CreateCommandList(dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, al, NULL, &IID_ID3D12GraphicsCommandList, (void**)&cl);
+    dev->lpVtbl->CreateFence(dev, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&fence);
+    D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV; hd.NumDescriptors = 2; hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    dev->lpVtbl->CreateDescriptorHeap(dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_heap);
+    printf("WARP device\n");
+
+    /* pick at x2 and x3 (RGBA8), a 160x90 guest surface; every texel unique-ish */
+    for (unsigned k = 2; k <= 3; k++) {
+        const unsigned gw = 160, gh = 90, sw = gw * k, sh = gh * k;
+        uint8_t* s = (uint8_t*)malloc((size_t)sw * sh * 4);
+        for (unsigned i = 0; i < sw * sh * 4; i++) s[i] = rnd8();
+        uint8_t* d = nearest(s, sw, sh, gw, gh, 4, DXGI_FORMAT_R8G8B8A8_UNORM);
+        unsigned bad = 0;
+        for (unsigned y = 0; y < gh; y++) for (unsigned x = 0; x < gw; x++) {
+            const unsigned px = rsx_rs_pick(x, gw, sw), py = rsx_rs_pick(y, gh, sh);
+            if (memcmp(d + ((size_t)y * gw + x) * 4, s + ((size_t)py * sw + px) * 4, 4)) bad++;
+        }
+        CHECK(bad == 0, "pick.x%u RGBA8: %u of %u guest pixels differ from src[pick]", k, bad, gw * gh);
+        free(s); free(d);
+    }
+    /* pick at x2, RGBA16F (bytes compared: a float load/store is exact) */
+    {
+        const unsigned gw = 64, gh = 36, sw = 128, sh = 72;
+        uint16_t* s = (uint16_t*)malloc((size_t)sw * sh * 8);
+        for (unsigned i = 0; i < sw * sh * 4; i++) s[i] = (uint16_t)(0x3C00u + (rnd8() << 1));   /* finite halves */
+        uint8_t* d = nearest((const uint8_t*)s, sw, sh, gw, gh, 8, DXGI_FORMAT_R16G16B16A16_FLOAT);
+        unsigned bad = 0;
+        for (unsigned y = 0; y < gh; y++) for (unsigned x = 0; x < gw; x++) {
+            const unsigned px = rsx_rs_pick(x, gw, sw), py = rsx_rs_pick(y, gh, sh);
+            if (memcmp(d + ((size_t)y * gw + x) * 8, (const uint8_t*)s + ((size_t)py * sw + px) * 8, 8)) bad++;
+        }
+        CHECK(bad == 0, "pick.x2 RGBA16F: %u differ", bad);
+        free(s); free(d);
+    }
+    /* up x2: guest 160x90 -> 320x180 nearest */
+    {
+        const unsigned gw = 160, gh = 90, dw = 320, dh = 180;
+        uint8_t* s = (uint8_t*)malloc((size_t)gw * gh * 4);
+        for (unsigned i = 0; i < gw * gh * 4; i++) s[i] = rnd8();
+        uint8_t* d = nearest(s, gw, gh, dw, dh, 4, DXGI_FORMAT_R8G8B8A8_UNORM);
+        unsigned bad = 0;
+        for (unsigned y = 0; y < dh; y++) for (unsigned x = 0; x < dw; x++) {
+            const unsigned gx = rsx_rs_guest_of(x, gw, dw), gy = rsx_rs_guest_of(y, gh, dh);
+            if (memcmp(d + ((size_t)y * dw + x) * 4, s + ((size_t)gy * gw + gx) * 4, 4)) bad++;
+        }
+        CHECK(bad == 0, "up.x2: %u differ from src[guest_of]", bad);
+        free(s); free(d);
+    }
+    /* blit 1:1 (with linear light requested: 1:1 ignores it) */
+    {
+        const unsigned w = 96, h = 54;
+        uint8_t* s = (uint8_t*)malloc((size_t)w * h * 4);
+        for (unsigned i = 0; i < w * h * 4; i++) s[i] = rnd8();
+        uint8_t* d = blit(s, w, h, w, h, 1, 1.0f);
+        CHECK(!memcmp(s, d, (size_t)w * h * 4), "blit.1to1 exact");
+        free(s); free(d);
+    }
+    /* blit box x2 / x3, gamma space */
+    for (unsigned k = 2; k <= 3; k++) {
+        const unsigned dw = 64, dh = 36, sw = dw * k, sh = dh * k;
+        uint8_t* s = (uint8_t*)malloc((size_t)sw * sh * 4);
+        for (unsigned i = 0; i < sw * sh * 4; i++) s[i] = rnd8();
+        uint8_t* d = blit(s, sw, sh, dw, dh, 0, 1.0f);
+        unsigned bad = 0, maxd = 0;
+        for (unsigned y = 0; y < dh; y++) for (unsigned x = 0; x < dw; x++) for (unsigned c = 0; c < 4; c++) {
+            double sum = 0;
+            for (unsigned j = 0; j < k; j++) for (unsigned i = 0; i < k; i++)
+                sum += s[(((size_t)(y * k + j)) * sw + x * k + i) * 4 + c];
+            const double want = sum / (k * k);
+            const unsigned got = d[((size_t)y * dw + x) * 4 + c];
+            const unsigned dd = (unsigned)fabs(got - want + 0.0);
+            if (fabs(got - want) > 1.0) bad++;
+            if (dd > maxd) maxd = dd;
+        }
+        CHECK(bad == 0, "blit.box%u: %u channel values more than 1/255 off the box mean (max %u)", k, bad, maxd);
+        free(s); free(d);
+    }
+    /* blit with the video-out exponent: a flat 128 grey at e = 1/1.2 */
+    {
+        const unsigned w = 32, h = 18;
+        const float e = 1.0f / 1.2f;
+        uint8_t* s2 = (uint8_t*)malloc((size_t)w * 2 * h * 2 * 4);
+        for (unsigned i = 0; i < w * 2 * h * 2; i++) { s2[i * 4] = s2[i * 4 + 1] = s2[i * 4 + 2] = 128; s2[i * 4 + 3] = 255; }
+        uint8_t* d = blit(s2, w * 2, h * 2, w, h, 0, e);
+        const int want = (int)floor(pow(128.0 / 255.0, e) * 255.0 + 0.5);
+        CHECK(abs((int)d[0] - want) <= 1 && d[3] == 255, "blit.gamma: %u want %d (alpha %u)", d[0], want, d[3]);
+        free(s2); free(d);
+    }
+    /* ---- the window pass's kernels (rsx_upscale.h) against the CPU twin */
+    {
+        static const struct { unsigned sw, sh, dw, dh; int lin; const char* what; } c[] = {
+            { 64, 36, 128, 54, 1, "upscale 2.0x1.5 (1280x720 -> 2560x1080)" },
+            { 48, 27, 64, 27, 1, "upscale 1.333x1 (1280x720 -> 1707x720)" },
+            { 128, 72, 64, 54, 1, "downsample 2x1.333 linear light (x2 -> 2560x1080)" },
+            { 96, 54, 64, 27, 1, "downsample 1.5x2 linear light (x3 -> 2560x1080)" },
+            { 37, 21, 37, 21, 1, "1:1" },
+        };
+        static const char* fn[4] = { "", "bilinear", "bicubic", "lanczos" };
+        for (unsigned k = 0; k < sizeof c / sizeof c[0]; k++) {
+            uint8_t* s = (uint8_t*)malloc((size_t)c[k].sw * c[k].sh * 4);
+            for (unsigned i = 0; i < c[k].sw * c[k].sh * 4; i++) s[i] = rnd8();
+            for (int f = RSX_UP_BILINEAR; f <= RSX_UP_LANCZOS; f++)
+                for (int ar = 0; ar < 2; ar++) {
+                    uint8_t* g = blitk(s, c[k].sw, c[k].sh, c[k].dw, c[k].dh, c[k].lin, 1.0f, f, ar);
+                    uint8_t* t = twin(s, c[k].sw, c[k].sh, c[k].dw, c[k].dh, c[k].lin, 1.0f, f, ar);
+                    unsigned bad = 0, maxd = 0;
+                    for (size_t i = 0; i < (size_t)c[k].dw * c[k].dh * 4; i++) {
+                        const unsigned dd = (unsigned)abs((int)g[i] - (int)t[i]);
+                        if (dd > 1) bad++;
+                        if (dd > maxd) maxd = dd;
+                    }
+                    const int one = c[k].sw == c[k].dw && c[k].sh == c[k].dh;
+                    if (one) CHECK(!memcmp(g, s, (size_t)c[k].dw * c[k].dh * 4), "up.twin %s %s%s: 1:1 not exact", fn[f],
+                                   c[k].what, ar ? " clamped" : "");
+                    CHECK(bad == 0, "up.twin %s %s%s: %u channel values more than 1/255 off the CPU twin (max %u)", fn[f],
+                          c[k].what, ar ? " clamped" : "", bad, maxd);
+                    printf("  up.twin %-8s %-50s %s max |gpu - cpu| %u/255\n", fn[f], c[k].what,
+                           ar ? "clamped  " : "unclamped", maxd);
+                    free(g); free(t);
+                }
+            free(s);
+        }
+    }
+    /* flat colour through every kernel, up and down */
+    for (int f = RSX_UP_BILINEAR; f <= RSX_UP_LANCZOS; f++) {
+        uint8_t* s = (uint8_t*)malloc(96 * 54 * 4);
+        for (unsigned i = 0; i < 96 * 54; i++) { s[i * 4] = 77; s[i * 4 + 1] = 140; s[i * 4 + 2] = 201; s[i * 4 + 3] = 255; }
+        uint8_t* a = blitk(s, 96, 54, 160, 81, 1, 1.0f, f, 1);
+        uint8_t* b = blitk(s, 96, 54, 64, 27, 1, 1.0f, f, 1);
+        unsigned bad = 0;
+        for (unsigned i = 0; i < 160 * 81; i++) bad += abs(a[i * 4] - 77) > 1 || abs(a[i * 4 + 1] - 140) > 1 || abs(a[i * 4 + 2] - 201) > 1;
+        for (unsigned i = 0; i < 64 * 27; i++) bad += abs(b[i * 4] - 77) > 1 || abs(b[i * 4 + 1] - 140) > 1 || abs(b[i * 4 + 2] - 201) > 1;
+        CHECK(bad == 0, "up.flat %s: %u pixels moved", fn_name(f), bad);
+        free(s); free(a); free(b);
+    }
+    /* a hard step 26 | 230 (HUD text on a dark scene), upscaled 2.0 x 1.5 */
+    {
+        const unsigned sw = 32, sh = 8, dw = 64, dh = 12;
+        uint8_t* s = (uint8_t*)malloc((size_t)sw * sh * 4);
+        for (unsigned y = 0; y < sh; y++) for (unsigned x = 0; x < sw; x++) {
+            const uint8_t v = (x == 8 || x >= 20) ? 230 : 26;
+            uint8_t* p = s + ((size_t)y * sw + x) * 4; p[0] = p[1] = p[2] = v; p[3] = 255; }
+        uint8_t* u = blitk(s, sw, sh, dw, dh, 1, 1.0f, RSX_UP_LANCZOS, 0);
+        uint8_t* k = blitk(s, sw, sh, dw, dh, 1, 1.0f, RSX_UP_LANCZOS, 1);
+        int umin = 255, umax = 0, kmin = 255, kmax = 0;
+        for (unsigned i = 0; i < dw * dh; i++) {
+            if (u[i * 4] < umin) umin = u[i * 4];
+            if (u[i * 4] > umax) umax = u[i * 4];
+            if (k[i * 4] < kmin) kmin = k[i * 4];
+            if (k[i * 4] > kmax) kmax = k[i * 4];
+        }
+        CHECK(umin < 26 && umax > 230, "up.ring: unclamped Lanczos-2 should ring (%d..%d)", umin, umax);
+        CHECK(kmin >= 26 && kmax <= 230, "up.ring: clamped Lanczos-2 leaves 26..230 (%d..%d)", kmin, kmax);
+        printf("  up.ring lanczos on a 26 | 230 step: unclamped %d..%d, clamped %d..%d\n", umin, umax, kmin, kmax);
+        free(s); free(u); free(k);
+    }
+    /* the video-out exponent after a kernel (the scaled display surface at RES_SCALE) */
+    {
+        uint8_t* s = (uint8_t*)malloc(64 * 36 * 4);
+        for (unsigned i = 0; i < 64 * 36; i++) { s[i * 4] = s[i * 4 + 1] = s[i * 4 + 2] = 128; s[i * 4 + 3] = 255; }
+        const float e = 1.0f / 1.2f;
+        uint8_t* d = blitk(s, 64, 36, 32, 27, 1, e, RSX_UP_BICUBIC, 1);
+        const int want = (int)floor(pow(128.0 / 255.0, e) * 255.0 + 0.5);
+        CHECK(abs((int)d[0] - want) <= 1, "up.gamma: %u want %d", d[0], want);
+        free(s); free(d);
+    }
+    printf("test_res_pass_warp: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_res_scale.c b/libs/video/tests/test_res_scale.c
new file mode 100644
index 0000000..e4cfad6
--- /dev/null
+++ b/libs/video/tests/test_res_scale.c
@@ -0,0 +1,461 @@
+/*
+ * ps3recomp - internal resolution scaling, the pure parts (CPU only):
+ * libs/video/rsx_res_scale.h (guest <-> host geometry, pick, seed upscale,
+ * factor parsing / clamping, occlusion-count normalisation), the classifier
+ * libs/video/rsx_res_class.h, and the census module libs/video/rsx_res_census.c
+ * fed a synthetic gate-like frame (no game data: offsets and sizes only).
+ *
+ *   clang-cl /nologo /O2 /W3 -I libs\video libs\video\tests\test_res_scale.c libs\video\rsx_res_census.c /Fe:t.exe && t.exe
+ *   cc -O2 -I libs/video libs/video/tests/test_res_scale.c libs/video/rsx_res_census.c -lm -o /tmp/t && /tmp/t
+ *
+ *   identity.*   factor 1 is the identity, bit for bit, against rsx_raster.h
+ *                (host map, rects, pick, guest_of; 19k rects)
+ *   own.*        host pixel ownership = the pixel-centre rule, edges monotone,
+ *                surface edges exact, at 10 factor sets x 10 title sizes
+ *   route.*      full-surface libgcm transforms take route 1 on the host frame
+ *   scalevp.*    integer factors: the replay-time viewport scaling of a
+ *                record's guest-frame map (rsx_rs_scale_vp) covers exactly
+ *                the pixels of the record-time host map (rsx_rs_host_map) and
+ *                keeps the baked epilogue lanes (route 1 and route 2)
+ *   pick.*       x3 picks the exact 1x sample, x2 is +0.25 px (critique C5),
+ *                pick then guest_of returns the guest pixel (seed round trip)
+ *   clamp.*      factors < 1 clamp to 1 per axis (C13), 16384 limit
+ *   parse.*      RES_SCALE values
+ *   norm.*       occlusion counts normalised by kx * ky, non-zero stays >= 1
+ *   class.*      the classifier on a synthetic frame: union over op binding
+ *                graphs (C8: 0xF770000 at 512x288 joins the particles' class),
+ *                zeta nodes keyed by bound size (256^2 reflection vs 512x288),
+ *                shadow by depth-mode reads, post, tiny, isotropic factors
+ *   census.*     the census module runs on synthetic ops without crashing and
+ *                its report names the keys (smoke test; prints the report)
+ *   edge.*       the Edge Geometry viewport rewrite (RSX_RES_EDGECULL): which
+ *                128-byte blocks match, the scale and flavor rewrites at x2 /
+ *                x3 / x4, what is left alone (other sizes, MSAA, offsets, k 1,
+ *                mode off, a scissor the u16 fields cannot hold), parsing
+ */
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include "rsx_res_scale.h"
+#include "rsx_res_class.h"
+#include "rsx_res_census.h"
+
+static int g_fail, g_pass;
+#define CHECK(c, ...) do { if (c) g_pass++; else { g_fail++; if (g_fail < 40) { printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } } while (0)
+
+typedef struct { const char* name; double sx, sy; } Factor;
+static const Factor k_factors[] = {
+    { "native 64:27 2560x1080", 2560.0 / 1280, 1080.0 / 720 },
+    { "window 1707x720",        1707.0 / 1280, 720.0 / 720 },
+    { "native 16:9 1920x1080",  1920.0 / 1280, 1080.0 / 720 },
+    { "x2",                     2.0, 2.0 },
+    { "x3",                     3.0, 3.0 },
+    { "x4",                     4.0, 4.0 },
+    { "150% native 3840x1620",  3840.0 / 1280, 1620.0 / 720 },
+    { "200% native 5120x2160",  5120.0 / 1280, 2160.0 / 720 },
+    { "3440x1440 43:18",        3440.0 / 1280, 1440.0 / 720 },
+    { "75% native 1920x810",    1920.0 / 1280, 810.0 / 720 },
+};
+typedef struct { unsigned w, h; } Surf;
+static const Surf k_surfs[] = {   /* the title's gameplay surface sizes (design 2.1) */
+    { 1280, 720 }, { 1280, 180 }, { 320, 180 }, { 160, 90 }, { 80, 45 },
+    { 40, 22 }, { 20, 11 }, { 512, 288 }, { 256, 256 }, { 1024, 1024 },
+};
+#define NF (sizeof k_factors / sizeof *k_factors)
+#define NS (sizeof k_surfs / sizeof *k_surfs)
+
+static int same_f(const float* a, const float* b, int n) { return memcmp(a, b, sizeof(float) * (size_t)n) == 0; }
+
+static void t_identity(void)
+{
+    rsx_rs_dims d = rsx_rs_surface(1280, 720, 1.0, 1.0);
+    CHECK(rsx_rs_is_identity(&d), "identity.dims");
+    unsigned n = 0, bad = 0;
+    for (int x = -40; x <= 1300; x += 7)
+        for (int w = 1; w <= 1320; w += 13) {
+            int y = (x * 3) % 700, h = (w * 5) % 740 + 1;
+            rsx_rect r = rsx_rect_xywh((unsigned)(x < 0 ? 0 : x), (unsigned)(y < 0 ? 0 : y), (unsigned)w, (unsigned)h);
+            if (!rsx_rect_eq(r, rsx_rs_rect(r, &d))) bad++;
+            float gs[2], go[2];
+            rsx_raster_rect_xform((unsigned)(x < 0 ? 0 : x), (unsigned)(y < 0 ? 0 : y), (unsigned)w, (unsigned)h, gs, go);
+            if (x < 0) go[0] = (float)x + gs[0];
+            float vp0[4], k0[4], vp1[4], k1[4], vp2[4];
+            int r0 = rsx_raster_host_map(gs[0], gs[1], go[0], go[1], 1280, 720, 0, vp0, k0);
+            int r1 = rsx_rs_host_map(gs[0], gs[1], go[0], go[1], &d, 0, vp1, k1);
+            if (r0 != r1 || !same_f(vp0, vp1, 4) || !same_f(k0, k1, 4)) bad++;
+            if (!rsx_rs_scale_vp(vp0, 1, 1, vp2) || !same_f(vp0, vp2, 4)) bad++;    /* replay scaling at x1 */
+            if (!rsx_rect_eq(r, rsx_rs_scale_rect(r, 1, 1))) bad++;
+            n++;
+        }
+    CHECK(bad == 0, "identity.rects: %u of %u differ", bad, n);
+    for (unsigned i = 0; i < 1280; i++)
+        if (rsx_rs_pick(i, 1280, 1280) != i || rsx_rs_guest_of(i, 1280, 1280) != i) { CHECK(0, "identity.pick %u", i); break; }
+    unsigned iw, ih;
+    rsx_rs_internal_size(RSX_RS_PS3, 0, 0, 0, 1280, 720, 2560, 1080, &iw, &ih);
+    CHECK(iw == 1280 && ih == 720, "identity.ps3 internal size %ux%u", iw, ih);
+    CHECK(rsx_rs_norm_count(12345, 1) == 12345 && rsx_rs_norm_count(0, 1) == 0, "identity.norm");
+    printf("[identity] %u rects: host map, rect, replay scaling, pick bitwise equal at factor 1\n", n);
+}
+
+static void t_ownership(void)
+{
+    unsigned bad = 0, checks = 0;
+    for (size_t f = 0; f < NF; f++)
+        for (size_t s = 0; s < NS; s++) {
+            rsx_rs_dims d = rsx_rs_surface(k_surfs[s].w, k_surfs[s].h, k_factors[f].sx, k_factors[f].sy);
+            for (int axis = 0; axis < 2; axis++) {
+                unsigned gl = axis ? d.gh : d.gw, hl = axis ? d.hh : d.hw;
+                checks++;
+                if (rsx_rs_edge(0, gl, hl) != 0 || rsx_rs_edge((int)gl, gl, hl) != (int)hl) bad++;
+                int prev = 0;
+                for (unsigned g = 1; g <= gl; g++) { int e = rsx_rs_edge((int)g, gl, hl); if (e < prev) bad++; prev = e; }
+                for (unsigned g0 = 0; g0 + 1 < gl; g0 += (gl / 7) + 1) {
+                    unsigned g1 = g0 + 1 + (gl / 3); if (g1 > gl) g1 = gl;
+                    int h0 = rsx_rs_edge((int)g0, gl, hl), h1 = rsx_rs_edge((int)g1, gl, hl);
+                    for (unsigned i = 0; i < hl; i++) {
+                        double c = ((double)i + 0.5) * (double)gl / (double)hl;
+                        int own = (int)i >= h0 && (int)i < h1, want = c >= g0 && c < g1;
+                        checks++;
+                        if (own != want) bad++;
+                    }
+                }
+                for (unsigned g = 0; g < gl; g++) {
+                    unsigned p = rsx_rs_pick(g, gl, hl);
+                    int a = rsx_rs_edge((int)g, gl, hl), b = rsx_rs_edge((int)g + 1, gl, hl);
+                    checks++;
+                    if (p >= hl || (b > a && ((int)p < a || (int)p >= b))) bad++;
+                    /* seed round trip: the guest pixel of the picked texel is g */
+                    if (rsx_rs_guest_of(p, gl, hl) != g) bad++;
+                }
+            }
+        }
+    CHECK(bad == 0, "own: %u of %u checks failed", bad, checks);
+    printf("[own] %u ownership / partition / pick-span / seed round-trip checks\n", checks);
+}
+
+static void t_route(void)
+{
+    printf("[route] full-surface viewport host dims per factor (1280x720 1280x180 320x180 512x288 256x256 1024x1024):\n");
+    for (size_t f = 0; f < NF; f++) {
+        printf("    %-24s", k_factors[f].name);
+        for (size_t s = 0; s < NS; s++) {
+            rsx_rs_dims d = rsx_rs_surface(k_surfs[s].w, k_surfs[s].h, k_factors[f].sx, k_factors[f].sy);
+            float gs[2], go[2], vp[4], k[4];
+            rsx_raster_rect_xform(0, 0, d.gw, d.gh, gs, go);
+            int route = rsx_rs_host_map(gs[0], gs[1], go[0], go[1], &d, 0, vp, k);
+            int ok = route == RSX_RASTER_ROUTE_VIEWPORT && vp[0] == 0.0f && vp[1] == 0.0f &&
+                     vp[2] == (float)d.hw && vp[3] == (float)d.hh && k[0] == 1.0f && k[1] == 1.0f;
+            CHECK(ok, "route.%s %ux%u: route %d vp %g,%g %gx%g host %ux%u", k_factors[f].name, d.gw, d.gh, route,
+                  vp[0], vp[1], vp[2], vp[3], d.hw, d.hh);
+            if (s < 3 || s >= 7) printf(" %ux%u", d.hw, d.hh);
+        }
+        printf("\n");
+    }
+}
+
+/* The pixels a D3D viewport vp (TopLeft, size) + epilogue lanes k cover for
+ * the NDC square, per axis, by the pixel-centre rule: x_window = (ndc' + 1) *
+ * W / 2 + X with ndc' = ndc * k0 + k2 (w = 1). */
+static void covered(const float vp[4], const float k[4], rsx_rect* r)
+{
+    double xa = (-1.0 * k[0] + k[2] + 1.0) * vp[2] / 2.0 + vp[0], xb = (1.0 * k[0] + k[2] + 1.0) * vp[2] / 2.0 + vp[0];
+    double ya = (1.0 - (1.0 * k[1] + k[3])) * vp[3] / 2.0 + vp[1], yb = (1.0 - (-1.0 * k[1] + k[3])) * vp[3] / 2.0 + vp[1];
+    if (xa > xb) { double t = xa; xa = xb; xb = t; }
+    if (ya > yb) { double t = ya; ya = yb; yb = t; }
+    r->x0 = rsx_raster_centre_edge(xa); r->x1 = rsx_raster_centre_edge(xb);
+    r->y0 = rsx_raster_centre_edge(ya); r->y1 = rsx_raster_centre_edge(yb);
+}
+
+static void t_scalevp(void)
+{
+    unsigned n = 0, bad = 0, r1 = 0, r2 = 0;
+    for (unsigned k = 2; k <= 4; k++) {
+        rsx_rs_dims d = rsx_rs_surface(1280, 720, (double)k, (double)k);
+        CHECK(rsx_rs_is_integer(&d), "scalevp.integer x%u", k);
+        for (int pass = 0; pass < 2; pass++)
+            for (int x = -64; x < 1280; x += 37)
+                for (int w = 2; w < 1400; w += 61) {
+                    const int y = (x * 5 + 700) % 700, h = 2 + (w * 3) % 720;
+                    float gs[2], go[2];
+                    /* pass 0: libgcm integer rects (route 1); pass 1: a fractional
+                     * transform or a forced epilogue (route 2) */
+                    rsx_raster_rect_xform(0, (unsigned)y, (unsigned)w, (unsigned)h, gs, go);
+                    go[0] = (float)x + gs[0];
+                    if (pass) { gs[0] += 0.25f; go[1] += 0.375f; }
+                    float vpg[4], kg[4], vph[4], kh[4], vps[4];
+                    const int rg = rsx_raster_host_map(gs[0], gs[1], go[0], go[1], 1280, 720, pass, vpg, kg);
+                    const int rh = rsx_rs_host_map(gs[0], gs[1], go[0], go[1], &d, pass, vph, kh);
+                    rsx_rs_scale_vp(vpg, k, k, vps);
+                    n++;
+                    if (rg == RSX_RASTER_ROUTE_VIEWPORT) r1++; else r2++;
+                    rsx_rect a, b;
+                    covered(vps, kg, &a);   /* replay: guest-frame lanes on the scaled viewport */
+                    covered(vph, kh, &b);   /* record at host size */
+                    if (rg != rh || !rsx_rect_eq(a, b)) { bad++; if (bad < 4)
+                        printf("  x%u pass %d x=%d w=%d: route %d/%d covers [%d,%d)x[%d,%d) vs [%d,%d)x[%d,%d)\n", k, pass,
+                               x, w, rg, rh, a.x0, a.x1, a.y0, a.y1, b.x0, b.x1, b.y0, b.y1); }
+                    /* the guest ownership rect times k is the host one */
+                    const rsx_rect go_ = rsx_rect_xywh(x < 0 ? 0u : (unsigned)x, (unsigned)y, (unsigned)w, (unsigned)h);
+                    if (!rsx_rect_eq(rsx_rs_scale_rect(go_, k, k), rsx_rs_rect(go_, &d))) bad++;
+                }
+    }
+    CHECK(bad == 0, "scalevp: %u of %u transforms differ between replay scaling and the host map", bad, n);
+    printf("[scalevp] x2..x4: %u transforms (%u route 1, %u route 2): replay scaling == record-time host map\n", n, r1, r2);
+}
+
+static void t_pick(void)
+{
+    unsigned bad3 = 0, bad2 = 0;
+    for (unsigned i = 0; i < 1280; i++) {
+        if (fabs(rsx_rs_pick_offset(i, 1280, 3840)) > 1e-12) bad3++;
+        if (fabs(rsx_rs_pick_offset(i, 1280, 2560) - 0.25) > 1e-12) bad2++;
+    }
+    CHECK(bad3 == 0, "pick.x3 exact: %u off", bad3);
+    CHECK(bad2 == 0, "pick.x2 +0.25: %u off", bad2);
+    CHECK(rsx_rs_pick(0, 1280, 2560) == 1 && rsx_rs_pick(10, 1280, 2560) == 21, "pick.x2 = 2i+1");
+    CHECK(rsx_rs_pick(0, 1280, 3840) == 1 && rsx_rs_pick(10, 1280, 3840) == 31, "pick.x3 = 3i+1");
+    CHECK(rsx_rs_pick(0, 720, 1080) == 0 && rsx_rs_pick(1, 720, 1080) == 2 && rsx_rs_pick(2, 720, 1080) == 3,
+          "pick.x1.5 0,2,3");
+    double mx = 0.0;
+    for (unsigned i = 0; i < 1280; i++) { double o = fabs(rsx_rs_pick_offset(i, 1280, 1707)); if (o > mx) mx = o; }
+    CHECK(mx <= 0.375 + 1e-9, "pick.window 1707: max offset %g", mx);
+    /* the shader's integer form floor((2i+1) * hw / (2 gw)) == the double form */
+    unsigned badi = 0;
+    for (unsigned hl = 1280; hl <= 5120; hl += 427)
+        for (unsigned i = 0; i < 1280; i++) {
+            unsigned p = (2u * i + 1u) * hl / (2u * 1280u); if (p > hl - 1u) p = hl - 1u;
+            if (p != rsx_rs_pick(i, 1280, hl)) badi++;
+        }
+    CHECK(badi == 0, "pick.shader integer form: %u differ", badi);
+    printf("[pick] x3 exact (0 px), x2 +0.25 px, window 1707x720 max %.3f px; shader form == pick\n", mx);
+}
+
+static void t_clamp_parse_norm(void)
+{
+    CHECK(rsx_rs_host_len(1280, 0.5) == 1280 && rsx_rs_host_len(720, 0.0) == 720, "clamp.below1");
+    rsx_rs_dims d = rsx_rs_surface(1280, 720, 0.75, 2.0);
+    CHECK(d.hw == 1280 && d.hh == 1440 && d.kx == 1.0 && d.ky == 2.0, "clamp.per-axis %ux%u", d.hw, d.hh);
+    CHECK(rsx_rs_host_len(4096, 8.0) == 16384, "clamp.max");
+    unsigned iw, ih;
+    rsx_rs_internal_size(RSX_RS_PERCENT, 50, 0, 0, 1280, 720, 2560, 1080, &iw, &ih);
+    CHECK(iw == 1280 && ih == 720, "clamp.50%% native -> guest %ux%u", iw, ih);
+    rsx_rs_internal_size(RSX_RS_NATIVE, 0, 0, 0, 1280, 720, 1707, 720, &iw, &ih);
+    CHECK(iw == 1707 && ih == 720, "clamp.native window %ux%u", iw, ih);
+    rsx_rs_internal_size(RSX_RS_MULT, 4, 0, 0, 1280, 720, 2560, 1080, &iw, &ih);
+    CHECK(iw == 5120 && ih == 2880, "internal.x4 %ux%u", iw, ih);
+    int ok;
+    CHECK(rsx_rs_parse_scale(NULL, &ok) == 0 && ok, "parse.unset");
+    CHECK(rsx_rs_parse_scale("0", &ok) == 0 && ok && rsx_rs_parse_scale("ps3", &ok) == 0 && ok, "parse.0");
+    CHECK(rsx_rs_parse_scale("1", &ok) == 1 && ok, "parse.1");
+    CHECK(rsx_rs_parse_scale("2", &ok) == 2 && ok && rsx_rs_parse_scale("x3", &ok) == 3 && ok, "parse.2/x3");
+    CHECK(rsx_rs_parse_scale("4", &ok) == 4 && ok, "parse.4");
+    CHECK(rsx_rs_parse_scale("5", &ok) == 0 && !ok && rsx_rs_parse_scale("2.5", &ok) == 0 && !ok, "parse.bad");
+    CHECK(rsx_rs_norm_count(4 * 256, 4) == 256, "norm.x2 half-screen occluder");
+    CHECK(rsx_rs_norm_count(1, 4) == 1 && rsx_rs_norm_count(0, 4) == 0, "norm.nonzero stays >= 1");
+    CHECK(rsx_rs_norm_count(9 * 1000 + 4, 9) == 1000 && rsx_rs_norm_count(9 * 1000 + 5, 9) == 1001, "norm.round");
+}
+
+/* An EdgeGeomViewportInfo as a title's PPU fills it (big-endian; SDK layout,
+ * synthetic values): full-target scissor, depth range, an arbitrary matrix,
+ * viewport scale (w/2, -h/2, s, 0) and offset (w/2, h/2, o, 0), flavor 0. */
+static void edge_vp(uint8_t* p, unsigned w, unsigned h, unsigned sx0, unsigned sy0, unsigned sw, unsigned sh)
+{
+    memset(p, 0xEE, RSX_RS_EDGE_VP_SIZE);   /* the padding carries whatever was there */
+    rsx_rs_put_be16(p, sx0); rsx_rs_put_be16(p + 2, sy0); rsx_rs_put_be16(p + 4, sw); rsx_rs_put_be16(p + 6, sh);
+    rsx_rs_put_bef(p + 0x08, -1.0f); rsx_rs_put_bef(p + 0x0C, 1.0f);
+    for (int i = 0; i < 16; i++) rsx_rs_put_bef(p + 0x10 + 4 * i, (float)(i % 5) * 0.25f - 0.5f);
+    rsx_rs_put_bef(p + 0x50, (float)w * 0.5f); rsx_rs_put_bef(p + 0x54, -(float)h * 0.5f);
+    rsx_rs_put_bef(p + 0x58, 1.0f); rsx_rs_put_bef(p + 0x5C, 0.0f);
+    rsx_rs_put_bef(p + 0x60, (float)w * 0.5f); rsx_rs_put_bef(p + 0x64, (float)h * 0.5f);
+    rsx_rs_put_bef(p + 0x68, 0.0f); rsx_rs_put_bef(p + 0x6C, 0.0f);
+    p[0x70] = 0;
+}
+static void t_edge(void)
+{
+    uint8_t v[RSX_RS_EDGE_VP_SIZE], o[RSX_RS_EDGE_VP_SIZE];
+    edge_vp(v, 1280, 720, 0, 0, 1280, 720);
+    CHECK(rsx_rs_edge_vp_match(v, 1280, 720), "edge.match full viewport");
+    CHECK(!rsx_rs_edge_vp_match(v, 1024, 1024) && !rsx_rs_edge_vp_match(v, 512, 288), "edge.other target sizes");
+    /* x2 flavor: nothing scaled, the 2x2 pattern; every other byte as it was */
+    memcpy(o, v, sizeof o);
+    CHECK(rsx_rs_edge_vp_patch(o, 1280, 720, 2, RSX_RS_EDGE_FLAVOR) == 1, "edge.x2 flavor patched");
+    CHECK(o[0x70] == RSX_RS_GCM_SQUARE_CENTERED_4 && !memcmp(o, v, 0x70) && !memcmp(o + 0x71, v + 0x71, 0x0F),
+          "edge.x2 flavor = pattern only");
+    /* x2 scale */
+    memcpy(o, v, sizeof o);
+    CHECK(rsx_rs_edge_vp_patch(o, 1280, 720, 2, RSX_RS_EDGE_SCALE) == 1, "edge.x2 scale patched");
+    CHECK(rsx_rs_be16(o + 4) == 2560 && rsx_rs_be16(o + 6) == 1440 && rsx_rs_be16(o) == 0 &&
+          rsx_rs_bef(o + 0x50) == 1280.0f && rsx_rs_bef(o + 0x54) == -720.0f &&
+          rsx_rs_bef(o + 0x60) == 1280.0f && rsx_rs_bef(o + 0x64) == 720.0f && o[0x70] == 0,
+          "edge.x2 scale values");
+    CHECK(!memcmp(o + 0x08, v + 0x08, 0x48) && !memcmp(o + 0x58, v + 0x58, 8) && !memcmp(o + 0x68, v + 0x68, 8) &&
+          !memcmp(o + 0x71, v + 0x71, 0x0F), "edge.x2 scale keeps depth, matrix, z lanes, padding");
+    /* x3: scale in either mode (no pattern for odd factors) */
+    memcpy(o, v, sizeof o);
+    CHECK(rsx_rs_edge_vp_patch(o, 1280, 720, 3, RSX_RS_EDGE_FLAVOR) == 1 && rsx_rs_be16(o + 4) == 3840 &&
+          rsx_rs_bef(o + 0x60) == 1920.0f && o[0x70] == 0, "edge.x3 flavor = scale x3");
+    /* x4 flavor: scale 2 plus the pattern */
+    memcpy(o, v, sizeof o);
+    CHECK(rsx_rs_edge_vp_patch(o, 1280, 720, 4, RSX_RS_EDGE_FLAVOR) == 1 && rsx_rs_be16(o + 4) == 2560 &&
+          rsx_rs_bef(o + 0x54) == -720.0f && o[0x70] == RSX_RS_GCM_SQUARE_CENTERED_4, "edge.x4 flavor = x2 + pattern");
+    memcpy(o, v, sizeof o);
+    CHECK(rsx_rs_edge_vp_patch(o, 1280, 720, 4, RSX_RS_EDGE_SCALE) == 1 && rsx_rs_be16(o + 4) == 5120 &&
+          rsx_rs_bef(o + 0x50) == 2560.0f, "edge.x4 scale");
+    /* a patched block no longer matches: a second GET of the same LS bytes is not rewritten twice */
+    CHECK(!rsx_rs_edge_vp_match(o, 1280, 720), "edge.patched block does not match again");
+    /* left alone */
+    memcpy(o, v, sizeof o);
+    CHECK(rsx_rs_edge_vp_patch(o, 1280, 720, 1, RSX_RS_EDGE_SCALE) == 0 && !memcmp(o, v, sizeof o), "edge.k1 untouched");
+    CHECK(rsx_rs_edge_vp_patch(o, 1280, 720, 2, RSX_RS_EDGE_OFF) == 0 && !memcmp(o, v, sizeof o), "edge.off untouched");
+    o[0x70] = 4;
+    CHECK(rsx_rs_edge_vp_patch(o, 1280, 720, 2, RSX_RS_EDGE_SCALE) == 0 && o[0x70] == 4, "edge.MSAA flavor untouched");
+    edge_vp(o, 1280, 720, 0, 0, 1280, 720);
+    rsx_rs_put_bef(o + 0x60, 700.0f);   /* a viewport not at the origin */
+    CHECK(!rsx_rs_edge_vp_match(o, 1280, 720), "edge.offset viewport untouched");
+    edge_vp(o, 1280, 720, 0, 0, 1280, 721);
+    CHECK(!rsx_rs_edge_vp_match(o, 1280, 720), "edge.scissor outside the target");
+    edge_vp(o, 1280, 720, 100, 50, 640, 360);   /* a scissor inside: matched, scaled with it */
+    CHECK(rsx_rs_edge_vp_patch(o, 1280, 720, 3, RSX_RS_EDGE_SCALE) == 1 && rsx_rs_be16(o) == 300 &&
+          rsx_rs_be16(o + 2) == 150 && rsx_rs_be16(o + 4) == 1920 && rsx_rs_be16(o + 6) == 1080, "edge.inner scissor x3");
+    edge_vp(o, 16384, 720, 0, 0, 16384, 720);   /* 16384 * 4 does not fit a u16 */
+    CHECK(rsx_rs_edge_vp_patch(o, 16384, 720, 4, RSX_RS_EDGE_SCALE) == 0 && rsx_rs_be16(o + 4) == 16384,
+          "edge.u16 overflow untouched");
+    int ok;
+    CHECK(rsx_rs_parse_edgecull(NULL, &ok) == RSX_RS_EDGE_FLAVOR && ok, "edge.parse unset = auto");
+    CHECK(rsx_rs_parse_edgecull("scale", &ok) == RSX_RS_EDGE_SCALE && ok &&
+          rsx_rs_parse_edgecull("flavor", &ok) == RSX_RS_EDGE_FLAVOR && ok &&
+          rsx_rs_parse_edgecull("off", &ok) == RSX_RS_EDGE_OFF && ok, "edge.parse values");
+    CHECK(rsx_rs_parse_edgecull("x", &ok) == RSX_RS_EDGE_FLAVOR && !ok, "edge.parse bad");
+}
+
+/* One op of the synthetic frame. */
+static void op(rsx_rc_table* t, unsigned a_off, unsigned w, unsigned h, unsigned fmt, const unsigned* mrt, int nm,
+               unsigned zoff, int depth_geom, int fullscreen, int display)
+{
+    rsx_rc_key k = { a_off, w, h, fmt, 0 };
+    int a = rsx_rc_add(t, &k);
+    unsigned f = (display ? RSX_RC_F_DISPLAY : 0u) |
+                 (fullscreen ? RSX_RC_F_FS : (RSX_RC_F_GEOM | (depth_geom ? RSX_RC_F_ZGEOM : 0u)));
+    rsx_rc_flag(t, a, f);
+    for (int i = 0; i < nm; i++) {
+        rsx_rc_key km = { mrt[i], w, h, fmt, 0 };
+        int m = rsx_rc_add(t, &km);
+        rsx_rc_flag(t, m, f);
+        rsx_rc_union(t, a, m);
+    }
+    rsx_rc_key kz = { zoff, w, h, 0, 1 };
+    int z = rsx_rc_add(t, &kz);
+    rsx_rc_flag(t, z, f & ~RSX_RC_F_DISPLAY);
+    rsx_rc_union(t, a, z);
+}
+static unsigned cls_of(rsx_rc_table* t, unsigned off, unsigned w, unsigned h, int zeta)
+{
+    for (int i = 0; i < t->count; i++)
+        if (t->n[i].k.off == off && t->n[i].k.w == w && t->n[i].k.h == h && t->n[i].k.zeta == zeta)
+            return rsx_rc_class(t, i);
+    return 999u;
+}
+
+static void t_class(void)
+{
+    rsx_rc_table t;
+    rsx_rc_init(&t, 1280, 720);
+    const unsigned gb[3] = { 0xE3C000, 0x3B0000, 0x11C0000 };
+    op(&t, 0xAB8000, 1280, 720, 8, gb, 3, 0x10000, 1, 0, 0);            /* G-buffer MRT, depth geometry */
+    op(&t, 0xF2F0000, 1024, 1024, 8, NULL, 0, 0xF2F0000, 1, 0, 0);      /* sun cascades */
+    { rsx_rc_key kz = { 0xF2F0000, 1024, 1024, 0, 1 };                  /* sampled as DEPTH (PCF) */
+      rsx_rc_flag(&t, rsx_rc_find(&t, &kz), RSX_RC_F_DEPTHTEX); }
+    op(&t, 0x11C0000, 1280, 720, 8, NULL, 0, 0x10000, 0, 1, 0);         /* sun / compose, full-screen */
+    op(&t, 0xF6F0000, 256, 256, 8, NULL, 0, 0xF770000, 1, 0, 0);        /* reflection */
+    op(&t, 0xAB8000, 1280, 180, 8, NULL, 0, 0xAB8000, 0, 1, 0);         /* separable downsample */
+    op(&t, 0xE3C000, 320, 180, 8, NULL, 0, 0xE3C000, 0, 1, 0);          /* DOF / bloom 320x180 */
+    op(&t, 0xF770000, 512, 288, 8, NULL, 0, 0xF770000, 0, 1, 0);        /* depth downsample, full-screen */
+    op(&t, 0xB9E000, 512, 288, 8, NULL, 0, 0xF770000, 1, 0, 0);         /* particles, depth-tested */
+    op(&t, 0xD06000, 20, 11, 8, NULL, 0, 0xD06000, 0, 1, 0);            /* exposure */
+    op(&t, 0x3B0000, 1280, 720, 8, NULL, 0, 0x10000, 1, 0, 1);          /* HUD into display 0 */
+    op(&t, 0x5000000, 700, 300, 8, NULL, 0, 0x5000000, 0, 0, 0);        /* odd shape, no depth: other */
+    CHECK(cls_of(&t, 0xAB8000, 1280, 720, 0) == RSX_RC_MAIN, "class.gbuffer main");
+    CHECK(cls_of(&t, 0x3B0000, 1280, 720, 0) == RSX_RC_MAIN, "class.display plane main");
+    CHECK(cls_of(&t, 0x10000, 1280, 720, 1) == RSX_RC_MAIN, "class.zeta 0x10000 main");
+    CHECK(cls_of(&t, 0xF2F0000, 1024, 1024, 0) == RSX_RC_SHADOW, "class.cascade colour shadow (propagated)");
+    CHECK(cls_of(&t, 0xF2F0000, 1024, 1024, 1) == RSX_RC_SHADOW, "class.cascade zeta shadow");
+    CHECK(cls_of(&t, 0xF6F0000, 256, 256, 0) == RSX_RC_AUX, "class.reflection aux");
+    CHECK(cls_of(&t, 0xF770000, 256, 256, 1) == RSX_RC_AUX, "class.0xF770000@256 aux");
+    CHECK(cls_of(&t, 0xF770000, 512, 288, 1) == RSX_RC_SCENE, "class.0xF770000@512x288 scene (not aux)");
+    /* C8: the 512x288 depth downsample colour is "post" by its own rule, scene by its group */
+    { rsx_rc_key k = { 0xF770000, 512, 288, 8, 0 }; int i = rsx_rc_find(&t, &k);
+      CHECK(i >= 0 && rsx_rc_own_class(&t, i) == RSX_RC_POST && rsx_rc_class(&t, i) == RSX_RC_SCENE,
+            "class.C8 propagation: own %s group %s", i >= 0 ? rsx_rc_name(rsx_rc_own_class(&t, i)) : "?",
+            i >= 0 ? rsx_rc_name(rsx_rc_class(&t, i)) : "?"); }
+    CHECK(cls_of(&t, 0xB9E000, 512, 288, 0) == RSX_RC_SCENE, "class.particles scene");
+    CHECK(cls_of(&t, 0xAB8000, 1280, 180, 0) == RSX_RC_POST, "class.1280x180 post");
+    CHECK(cls_of(&t, 0xE3C000, 320, 180, 0) == RSX_RC_POST, "class.320x180 post");
+    CHECK(cls_of(&t, 0xD06000, 20, 11, 0) == RSX_RC_TINY, "class.exposure tiny");
+    CHECK(cls_of(&t, 0x5000000, 700, 300, 0) == RSX_RC_OTHER, "class.other");
+    /* host sizes */
+    const rsx_rc_factors nat = { 2.0, 1.5, 2.0, 2.0, 1.0, 1.0 };
+    rsx_rs_dims d = rsx_rc_host(RSX_RC_AUX, 256, 256, &nat);
+    CHECK(d.hw == 512 && d.hh == 512, "class.aux isotropic %ux%u", d.hw, d.hh);
+    d = rsx_rc_host(RSX_RC_MAIN, 1280, 720, &nat);
+    CHECK(d.hw == 2560 && d.hh == 1080, "class.main native %ux%u", d.hw, d.hh);
+    d = rsx_rc_host(RSX_RC_TINY, 20, 11, &nat);
+    CHECK(d.hw == 20 && d.hh == 11, "class.tiny 1x");
+    CHECK(rsx_rc_screen_fraction(512, 288, 1280, 720) && rsx_rc_screen_fraction(160, 90, 1280, 720) &&
+          !rsx_rc_screen_fraction(256, 256, 1280, 720) && rsx_rc_screen_fraction(40, 22, 1280, 720),
+          "class.screen fraction");
+    printf("[class] %d keys; C8 propagation, zeta-by-size, shadow/aux/post/tiny/other as expected\n", t.count);
+}
+
+static void t_census(void)
+{
+    /* RSX_RES_DRYRUN must be set before the first call (rsx_rcz_on reads it once) */
+#ifdef _WIN32
+    _putenv("RSX_RES_DRYRUN=1");
+#else
+    setenv("RSX_RES_DRYRUN", "1", 1);
+#endif
+    CHECK(rsx_rcz_on() == 1, "census.on");
+    rsx_rcz_batch_begin(1280, 720, 0);
+    rsx_rcz_op o;
+    memset(&o, 0, sizeof o);
+    o.rt_off = 0xAB8000; o.rt_w = 1280; o.rt_h = 720; o.rt_fmt = 8;
+    o.mrt[0] = 0xE3C000; o.mrt[1] = 0x3B0000; o.zeta_off = 0x10000; o.zeta_bound = 1; o.ds_key = 0xF;
+    o.vertex_count = 300; o.fp_id = 0x11111111;
+    rsx_rcz_op_feed(&o);
+    memset(&o, 0, sizeof o);   /* the sun pass reads the G-buffer and the depth as colour */
+    o.rt_off = 0x11C0000; o.rt_w = 1280; o.rt_h = 720; o.rt_fmt = 8; o.zeta_off = 0x10000; o.zeta_bound = 1;
+    o.vertex_count = 3; o.fullscreen = 1; o.fp_id = 0x6B8AE6FE; o.nread = 2;
+    o.rd[0].src = RSX_RCZ_SRC_OFFRT; o.rd[0].off = 0xAB8000; o.rd[0].w = 1280; o.rd[0].h = 720; o.rd[0].fmt = 8;
+    o.rd[0].filt = 0x01010000u;
+    o.rd[1].src = RSX_RCZ_SRC_ZALIAS; o.rd[1].off = 0x10000; o.rd[1].w = 1280; o.rd[1].h = 720; o.rd[1].filt = 0x01010000u;
+    rsx_rcz_op_feed(&o);
+    memset(&o, 0, sizeof o);   /* zeta 0xF770000: 256^2 written, then 512x288 tested */
+    o.rt_off = 0xF6F0000; o.rt_w = 256; o.rt_h = 256; o.zeta_off = 0xF770000; o.zeta_bound = 1; o.ds_key = 0xF;
+    o.vertex_count = 900; o.fp_id = 0x22222222;
+    rsx_rcz_op_feed(&o);
+    o.rt_off = 0xB9E000; o.rt_w = 512; o.rt_h = 288; o.ds_key = 0x1 | (3u << 2);
+    rsx_rcz_op_feed(&o);
+    rsx_rcz_readback(0xE3C000, 1280, 720, 8, 0);
+    rsx_rcz_readback(0x10000, 1280, 720, 0, 1);
+    rsx_rcz_selfsample(0, 0xAB8000, 1280, 720, 4, 1);
+    rsx_rcz_selfsample(0, 0xAB8000, 1280, 720, 4, 0);
+    rsx_rcz_prim(1, 0x33333333);
+    for (int f = 0; f < 3; f++) rsx_rcz_frame_end((unsigned long long)f + 1);
+    rsx_rcz_report("test");
+    CHECK(1, "census.report ran");
+}
+
+int main(void)
+{
+    t_identity();
+    t_ownership();
+    t_route();
+    t_scalevp();
+    t_pick();
+    t_clamp_parse_norm();
+    t_class();
+    t_census();
+    t_edge();
+    printf("test_res_scale: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_rop_blend.c b/libs/video/tests/test_rop_blend.c
new file mode 100644
index 0000000..8c40cc5
--- /dev/null
+++ b/libs/video/tests/test_rop_blend.c
@@ -0,0 +1,328 @@
+/*
+ * ps3recomp - RSX ROP rules (libs/video/rsx_rop.h) without a GPU.
+ *
+ * Checks the PSO blend key and the shader epilogue variant the backend builds
+ * from the guest blend state:
+ *  - with every toggle off, the key is the backend's old one (old_key below is
+ *    the pre-change rsx_blend_key, kept here as the reference) for every
+ *    factor/equation code, and the MRT bits mirror target 0;
+ *  - the title's six SetBlendEquation(0xF006) sites (T3) become the two-pass
+ *    signed blend, with the factors ignored (both of the title's factor pairs
+ *    give the same key);
+ *  - SET_BLEND_ENABLE_MRT values the title writes (0x3, 0x9, 0x8);
+ *  - fp32 targets, fp16 targets, 0xF005/0xF007, unknown codes, XRGB rules,
+ *    CONSTANT_COLOR + CONSTANT_ALPHA, the blend constant decode, fp16;
+ *  - the HLSL epilogue text.
+ *
+ * From external/ps3recomp:
+ *   clang-cl /nologo -I libs/video libs/video/tests/test_rop_blend.c /Fe:T/trb.exe && T/trb.exe
+ */
+#ifndef _CRT_SECURE_NO_WARNINGS
+#define _CRT_SECURE_NO_WARNINGS
+#endif
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "rsx_rop.h"
+
+static int s_fail, s_pass;
+#define CHECK(c, ...) do { if (c) s_pass++; else { s_fail++; printf("[FAIL] " __VA_ARGS__); printf("\n"); } } while (0)
+
+/* ---- the backend's key before this change (reference for the legacy mode) */
+static uint32_t old_factor(uint32_t f, int is_alpha)
+{
+    switch (f & 0xFFFF) {
+    case 0x0000: return 1;  case 0x0001: return 2;
+    case 0x0300: return is_alpha ? 5u : 3u;  case 0x0301: return is_alpha ? 6u : 4u;
+    case 0x0302: return 5;  case 0x0303: return 6;  case 0x0304: return 7;  case 0x0305: return 8;
+    case 0x0306: return is_alpha ? 7u : 9u;  case 0x0307: return is_alpha ? 8u : 10u;
+    case 0x0308: return 11; case 0x8001: return 14; case 0x8002: return 15;
+    case 0x8003: return 14; case 0x8004: return 15;
+    default: return 2;
+    }
+}
+static uint32_t old_op(uint32_t e)
+{
+    switch (e & 0xFFFF) {
+    case 0x8007: return 4; case 0x8008: return 5; case 0x800A: return 2; case 0x800B: return 3;
+    default: return 1;
+    }
+}
+static uint32_t old_key(uint32_t enable, uint32_t sf, uint32_t df, uint32_t eq)
+{
+    if (!enable) return 0;
+    if (sf == 0 && df == 0)
+        return 1u | (5u << 1) | (6u << 6) | (2u << 11) | (6u << 16) | (1u << 21) | (1u << 24);
+    return 1u | (old_factor(sf, 0) << 1) | (old_factor(df, 0) << 6) | (old_factor(sf >> 16, 1) << 11)
+              | (old_factor(df >> 16, 1) << 16) | (old_op(eq) << 21) | (old_op(eq >> 16) << 24);
+}
+
+static rsx_rop_cfg cfg_old(void) { rsx_rop_cfg c; memset(&c, 0, sizeof c); return c; }
+static rsx_rop_cfg cfg_new(void)
+{
+    rsx_rop_cfg c; memset(&c, 0, sizeof c);
+    c.mrt = 1; c.sgn = 1; c.f32off = 1; c.round8 = 1; c.alpha_factor = 0; c.xrgb = 0;
+    return c;
+}
+static rsx_rop_in in_of(uint32_t en, uint32_t mrt, uint32_t sf, uint32_t df, uint32_t eq, uint32_t fmt)
+{
+    rsx_rop_in i; i.blend_enable = en; i.blend_enable_mrt = mrt; i.sfactor = sf; i.dfactor = df;
+    i.equation = eq; i.surface_format = fmt; return i;
+}
+#define KF_SC(k) (((k) >> 1) & 31u)
+#define KF_DC(k) (((k) >> 6) & 31u)
+#define KF_SA(k) (((k) >> 11) & 31u)
+#define KF_DA(k) (((k) >> 16) & 31u)
+#define KF_OC(k) (((k) >> 21) & 7u)
+#define KF_OA(k) (((k) >> 24) & 7u)
+
+int main(void)
+{
+    static const uint32_t factors[] = { 0x0000, 0x0001, 0x0300, 0x0301, 0x0302, 0x0303, 0x0304, 0x0305,
+                                        0x0306, 0x0307, 0x0308, 0x8001, 0x8002, 0x8003, 0x8004, 0x1234 };
+    static const uint32_t eqs[] = { 0x0000, 0x8006, 0x8007, 0x8008, 0x800A, 0x800B, 0xF005, 0xF006, 0xF007, 0x4321 };
+    const int nf = (int)(sizeof factors / sizeof factors[0]), ne = (int)(sizeof eqs / sizeof eqs[0]);
+
+    /* 1. legacy equivalence over every factor/equation pair in both halves */
+    {
+        const rsx_rop_cfg c = cfg_old();
+        int bad = 0, n = 0;
+        for (int en = 0; en < 2; en++)
+        for (int a = 0; a < nf; a++) for (int b = 0; b < nf; b++)
+        for (int e1 = 0; e1 < ne; e1++) for (int e2 = 0; e2 < ne; e2 += 3) {
+            const uint32_t sf = factors[a] | (factors[(a + 3) % nf] << 16);
+            const uint32_t df = factors[b] | (factors[(b + 5) % nf] << 16);
+            const uint32_t eq = eqs[e1] | (eqs[e2] << 16);
+            for (uint32_t fmt = 1; fmt <= 16; fmt += 5) {
+                const rsx_rop_in in = in_of((uint32_t)en, 0, sf, df, eq, fmt);
+                const rsx_rop_plan p = rsx_rop_make_plan(&in, &c);
+                const uint32_t want = old_key((uint32_t)en, sf, df, eq);
+                const uint32_t mirror = en ? RSX_ROP_KEY_MRT_MASK : 0u;
+                n++;
+                if ((p.key & 0x07FFFFFFu) != want || (p.key & RSX_ROP_KEY_MRT_MASK) != mirror ||
+                    (p.key & (RSX_ROP_KEY_SGN_RGB | RSX_ROP_KEY_SGN_A)) || p.rop) {
+                    if (bad++ < 4)
+                        printf("  legacy key en=%d sf=%08X df=%08X eq=%08X fmt=%u: %08X rop %X, want %08X\n",
+                               en, sf, df, eq, fmt, p.key, p.rop, want);
+                }
+            }
+        }
+        CHECK(bad == 0, "legacy mode: %d of %d keys differ from the old rsx_blend_key", bad, n);
+        /* the never-programmed factors and NULL-state legacy straight alpha */
+        const rsx_rop_in in = in_of(1, 0, 0, 0, 0, 8);
+        CHECK(rsx_rop_make_plan(&in, &c).key == (old_key(1, 0, 0, 0) | RSX_ROP_KEY_MRT_MASK),
+              "legacy straight alpha");
+    }
+
+    /* 2. the title's ADD_SIGNED sites (T3: func_00501680(0xF006) -> 0x320 = 0xF006F006) */
+    {
+        const rsx_rop_cfg c = cfg_new();
+        const rsx_rop_in one = in_of(1, 0, 0x00010001, 0x00010001, 0xF006F006, RSX_ROP_FMT_A8R8G8B8);
+        const rsx_rop_in sa  = in_of(1, 0, 0x03020302, 0x03030303, 0xF006F006, RSX_ROP_FMT_A8R8G8B8);
+        const rsx_rop_plan p1 = rsx_rop_make_plan(&one, &c), p2 = rsx_rop_make_plan(&sa, &c);
+        CHECK(p1.key == p2.key, "ADD_SIGNED ignores the factors: ONE/ONE key %08X vs SRC_ALPHA key %08X", p1.key, p2.key);
+        CHECK(KF_SC(p1.key) == RSX_ROP_D3D_ONE && KF_DC(p1.key) == RSX_ROP_D3D_ONE &&
+              KF_SA(p1.key) == RSX_ROP_D3D_ONE && KF_DA(p1.key) == RSX_ROP_D3D_ONE, "signed: ONE/ONE factors");
+        CHECK(KF_OC(p1.key) == RSX_ROP_D3D_OP_ADD && KF_OA(p1.key) == RSX_ROP_D3D_OP_ADD, "0xF006: positive pass ADD");
+        CHECK((p1.key & RSX_ROP_KEY_SGN_RGB) && (p1.key & RSX_ROP_KEY_SGN_A), "0xF006F006: both groups signed");
+        CHECK(p1.rop == (RSX_ROP_ROUND8 | RSX_ROP_PASS_P | RSX_ROP_SGN_RGB | RSX_ROP_SGN_A | (1u << RSX_ROP_SGN_T_SHIFT)),
+              "0xF006 rop %04X", p1.rop);
+        CHECK(p1.notes & RSX_ROP_NOTE_SIGNED, "signed note");
+        CHECK(rsx_rop_pass(p1.rop) == 1 && rsx_rop_pass(rsx_rop_pass_n(p1.rop)) == 2 &&
+              !(rsx_rop_pass_n(p1.rop) & RSX_ROP_PASS_P) && rsx_rop_pass_n(0) == 0, "pass P/N words");
+        /* the old mapping kept the factors: ADD with SRC_ALPHA/INV_SRC_ALPHA */
+        const rsx_rop_cfg o = cfg_old();
+        const rsx_rop_plan po = rsx_rop_make_plan(&sa, &o);
+        CHECK(KF_SC(po.key) == RSX_ROP_D3D_SRC_ALPHA && KF_OC(po.key) == RSX_ROP_D3D_OP_ADD && !po.rop,
+              "BLEND_SIGNED=0: the old ADD with the programmed factors");
+        /* 0xF005: dst - s8(src): positive pass REV_SUBTRACT */
+        const rsx_rop_in f5 = in_of(1, 0, 1, 1, 0xF005F005, RSX_ROP_FMT_A8R8G8B8);
+        const rsx_rop_plan p5 = rsx_rop_make_plan(&f5, &c);
+        CHECK(KF_OC(p5.key) == RSX_ROP_D3D_OP_REV_SUBTRACT && KF_OA(p5.key) == RSX_ROP_D3D_OP_REV_SUBTRACT &&
+              (p5.key & RSX_ROP_KEY_SGN_RGB), "0xF005: REV_SUBTRACT positive pass");
+        /* signed RGB only, alpha a plain ADD with its factors */
+        const rsx_rop_in mix = in_of(1, 0, 0x03020302, 0x03030303, 0x8006F006, RSX_ROP_FMT_A8R8G8B8);
+        const rsx_rop_plan pm = rsx_rop_make_plan(&mix, &c);
+        CHECK((pm.key & RSX_ROP_KEY_SGN_RGB) && !(pm.key & RSX_ROP_KEY_SGN_A) &&
+              KF_SA(pm.key) == RSX_ROP_D3D_SRC_ALPHA && KF_SC(pm.key) == RSX_ROP_D3D_ONE &&
+              (pm.rop & RSX_ROP_SGN_RGB) && !(pm.rop & RSX_ROP_SGN_A), "signed RGB, plain alpha");
+        /* 0xF007: approximated (said), not two-pass */
+        const rsx_rop_in f7 = in_of(1, 0, 1, 1, 0xF007F007, RSX_ROP_FMT_A8R8G8B8);
+        const rsx_rop_plan p7 = rsx_rop_make_plan(&f7, &c);
+        CHECK((p7.notes & RSX_ROP_NOTE_F007) && !(p7.key & RSX_ROP_KEY_SGN_RGB) && KF_OC(p7.key) == RSX_ROP_D3D_OP_ADD &&
+              !rsx_rop_pass(p7.rop), "0xF007 approximated as ADD and noted");
+        /* fp16 target: the plain add / subtract, no two-pass */
+        const rsx_rop_in fh = in_of(1, 0, 0x03020302, 1, 0xF005F006, RSX_ROP_FMT_F_W16Z16Y16X16);
+        const rsx_rop_plan ph = rsx_rop_make_plan(&fh, &c);
+        CHECK(!(ph.key & (RSX_ROP_KEY_SGN_RGB | RSX_ROP_KEY_SGN_A)) && KF_OC(ph.key) == RSX_ROP_D3D_OP_ADD &&
+              KF_OA(ph.key) == RSX_ROP_D3D_OP_REV_SUBTRACT && KF_SC(ph.key) == RSX_ROP_D3D_ONE &&
+              (ph.notes & RSX_ROP_NOTE_SIGNED_FLOAT) && !(ph.rop & RSX_ROP_ROUND8), "signed on fp16");
+        /* unknown equation */
+        const rsx_rop_in uq = in_of(1, 0, 1, 1, 0x80061234, RSX_ROP_FMT_A8R8G8B8);
+        const rsx_rop_plan pu = rsx_rop_make_plan(&uq, &c);
+        CHECK((pu.notes & RSX_ROP_NOTE_EQ_UNKNOWN) && pu.bad_eq == 0x1234 && KF_OC(pu.key) == RSX_ROP_D3D_OP_ADD,
+              "unknown equation noted");
+    }
+
+    /* 3. SET_BLEND_ENABLE_MRT values the title writes (func_005014F0(m): 0x310 = m&1, 0x36C = m&0xE) */
+    {
+        const rsx_rop_cfg c = cfg_new();
+        static const uint32_t ms[] = { 0x3, 0x9, 0x8, 0x1, 0x0 };
+        for (int i = 0; i < 5; i++) {
+            const uint32_t m = ms[i];
+            const rsx_rop_in in = in_of(m & 1u, m & 0xEu, 0x00010001, 0x00010001, 0x80068006, RSX_ROP_FMT_A8R8G8B8);
+            const rsx_rop_plan p = rsx_rop_make_plan(&in, &c);
+            int ok = 1;
+            for (int t = 0; t < 4; t++) ok &= rsx_rop_key_target_blends(p.key, t) == (int)((m >> t) & 1u);
+            CHECK(ok, "MRT enable 0x%X -> key %08X", m, p.key);
+            CHECK(((p.key & RSX_ROP_KEY_ANY_EN) != 0) == (m != 0), "MRT 0x%X: any-enable bit", m);
+            if (m == 0x8) CHECK(KF_SC(p.key) == RSX_ROP_D3D_ONE, "MRT 0x8: factors kept although target 0 is off");
+        }
+        /* legacy: target 0 decides for all */
+        const rsx_rop_cfg o = cfg_old();
+        const rsx_rop_in in8 = in_of(0, 0x8, 1, 1, 0x80068006, RSX_ROP_FMT_A8R8G8B8);
+        CHECK(rsx_rop_make_plan(&in8, &o).key == 0, "BLEND_MRT=0: 0x8 blends nothing (old)");
+        const rsx_rop_in in9 = in_of(1, 0x8, 1, 1, 0x80068006, RSX_ROP_FMT_A8R8G8B8);
+        const uint32_t k9 = rsx_rop_make_plan(&in9, &o).key;
+        CHECK(rsx_rop_key_target_blends(k9, 1) && rsx_rop_key_target_blends(k9, 2), "BLEND_MRT=0: 0x9 mirrors (old)");
+    }
+
+    /* 4. fp32 targets do not blend */
+    {
+        rsx_rop_cfg c = cfg_new();
+        const rsx_rop_in in = in_of(1, 0xE, 1, 1, 0x80068006, RSX_ROP_FMT_F_W32Z32Y32X32);
+        const rsx_rop_plan p = rsx_rop_make_plan(&in, &c);
+        CHECK(p.key == 0 && (p.notes & RSX_ROP_NOTE_F32_DROPPED), "fp32: no blend, noted");
+        const rsx_rop_in in2 = in_of(1, 0, 1, 1, 0x80068006, RSX_ROP_FMT_F_X32);
+        CHECK(rsx_rop_make_plan(&in2, &c).key == 0, "F_X32: no blend");
+        c.f32off = 0;
+        CHECK(rsx_rop_make_plan(&in, &c).key != 0, "BLEND_F32=0 blends fp32 (old)");
+        const rsx_rop_in in3 = in_of(1, 0, 1, 1, 0x80068006, RSX_ROP_FMT_F_W16Z16Y16X16);
+        CHECK(rsx_rop_make_plan(&in3, &c).key != 0, "fp16 blends");
+    }
+
+    /* 5. XRGB targets */
+    {
+        rsx_rop_cfg c = cfg_new(); c.xrgb = 1;
+        /* 1-DST_ALPHA / DST_ALPHA: DST_ALPHA reads 1 -> ZERO / ONE; alpha = forced src */
+        const rsx_rop_in z = in_of(1, 0, 0x03050305, 0x03040304, 0x80068006, RSX_ROP_FMT_X8R8G8B8_Z8R8G8B8);
+        const rsx_rop_plan pz = rsx_rop_make_plan(&z, &c);
+        CHECK(KF_SC(pz.key) == RSX_ROP_D3D_ZERO && KF_DC(pz.key) == RSX_ROP_D3D_ONE, "XRGB: DST_ALPHA -> 1 (%08X)", pz.key);
+        CHECK(KF_SA(pz.key) == RSX_ROP_D3D_ONE && KF_DA(pz.key) == RSX_ROP_D3D_ZERO &&
+              ((pz.rop >> RSX_ROP_XA_T_SHIFT) & 0xFu) == 0xFu && !(pz.rop & RSX_ROP_XA_ONE), "XRGB Z: alpha exported 0");
+        const rsx_rop_in o = in_of(1, 0, 0x03050305, 0x03040304, 0x80068006, RSX_ROP_FMT_X8R8G8B8_O8R8G8B8);
+        CHECK(rsx_rop_make_plan(&o, &c).rop & RSX_ROP_XA_ONE, "XRGB O: alpha exported 1");
+        /* SRC_ALPHA colour factors: the shader keeps its alpha, the stored one is forced by the blend */
+        const rsx_rop_in zs = in_of(1, 0, 0x03020302, 0x03030303, 0x80068006, RSX_ROP_FMT_X8R8G8B8_Z8R8G8B8);
+        const rsx_rop_plan pzs = rsx_rop_make_plan(&zs, &c);
+        CHECK(KF_SC(pzs.key) == RSX_ROP_D3D_SRC_ALPHA && KF_SA(pzs.key) == RSX_ROP_D3D_ZERO &&
+              KF_DA(pzs.key) == RSX_ROP_D3D_ZERO && ((pzs.rop >> RSX_ROP_XA_T_SHIFT) & 1u) == 0, "XRGB Z, SRC_ALPHA");
+        const rsx_rop_in os = in_of(1, 0, 0x03020302, 0x03030303, 0x80068006, RSX_ROP_FMT_X8R8G8B8_O8R8G8B8);
+        const rsx_rop_plan pos = rsx_rop_make_plan(&os, &c);
+        CHECK(KF_DA(pos.key) == RSX_ROP_D3D_ONE && (pos.notes & RSX_ROP_NOTE_XRGB_KEEPDST), "XRGB O, SRC_ALPHA: keep");
+        /* SRC_ALPHA_SATURATE: min(As, 1 - 1) = 0 */
+        const rsx_rop_in ss = in_of(1, 0, 0x00010308, 0x00000001, 0x80068006, RSX_ROP_FMT_X8B8G8R8_Z8B8G8R8);
+        CHECK(KF_SC(rsx_rop_make_plan(&ss, &c).key) == RSX_ROP_D3D_ZERO, "XRGB: SRC_ALPHA_SATURATE -> 0");
+        /* no blend: alpha exported as the X value on every target */
+        const rsx_rop_in nb = in_of(0, 0, 0, 0, 0, RSX_ROP_FMT_X1R5G5B5_O1R5G5B5);
+        const rsx_rop_plan pnb = rsx_rop_make_plan(&nb, &c);
+        CHECK(pnb.key == 0 && pnb.rop == ((0xFu << RSX_ROP_XA_T_SHIFT) | RSX_ROP_XA_ONE), "XRGB O, no blend");
+        /* off by default: A8R8G8B8 and ROP_XRGB=0 leave DST_ALPHA alone */
+        c.xrgb = 0;
+        CHECK(KF_SC(rsx_rop_make_plan(&z, &c).key) == RSX_ROP_D3D_INV_DEST_ALPHA, "ROP_XRGB=0: unchanged");
+        CHECK(rsx_rop_xrgb_class(RSX_ROP_FMT_A8R8G8B8) == 0 && rsx_rop_xrgb_class(4) == 1 &&
+              rsx_rop_xrgb_class(5) == 2 && rsx_rop_xrgb_class(14) == 1 && rsx_rop_xrgb_class(15) == 2 &&
+              rsx_rop_xrgb_class(1) == 1 && rsx_rop_xrgb_class(2) == 2, "XRGB classes");
+    }
+
+    /* 6. constant colour + constant alpha (the title's 0x41B17C: CONSTANT_COLOR / ONE_MINUS_CONSTANT_ALPHA) */
+    {
+        rsx_rop_cfg c = cfg_new();
+        const rsx_rop_in in = in_of(1, 0, 0x80018001, 0x80048004, 0x80068006, RSX_ROP_FMT_A8R8G8B8);
+        rsx_rop_plan p = rsx_rop_make_plan(&in, &c);
+        CHECK((p.notes & RSX_ROP_NOTE_KCONFLICT) && KF_DC(p.key) == RSX_ROP_D3D_INV_BLEND_FACTOR,
+              "no ALPHA_FACTOR: conflict noted");
+        c.alpha_factor = 1;
+        p = rsx_rop_make_plan(&in, &c);
+        CHECK(!(p.notes & RSX_ROP_NOTE_KCONFLICT) && KF_DC(p.key) == RSX_ROP_D3D_INV_ALPHA_FACTOR &&
+              KF_SC(p.key) == RSX_ROP_D3D_BLEND_FACTOR && KF_DA(p.key) == RSX_ROP_D3D_INV_BLEND_FACTOR,
+              "ALPHA_FACTOR in the colour slot only (%08X)", p.key);
+    }
+
+    /* 7. the blend constant */
+    {
+        float k[4];
+        rsx_rop_blend_constant(0xCC336699u, 0, RSX_ROP_FMT_A8R8G8B8, 0, 0, k);
+        CHECK(fabsf(k[0] - 0.2f) < 1e-6f && fabsf(k[1] - 0.4f) < 1e-6f && fabsf(k[2] - 0.6f) < 1e-6f &&
+              fabsf(k[3] - 0.8f) < 1e-6f, "ARGB8 constant");
+        rsx_rop_blend_constant(0xCC336699u, 0, RSX_ROP_FMT_A8R8G8B8, 0, 1, k);
+        CHECK(k[0] == k[3] && k[1] == k[3] && k[2] == k[3], "splat");
+        rsx_rop_blend_constant(0x38003C00u, 0x7C00C000u, RSX_ROP_FMT_F_W16Z16Y16X16, 1, 0, k);
+        CHECK(k[0] == 1.0f && k[1] == 0.5f && k[2] == -2.0f && isinf(k[3]) && k[3] > 0, "fp16 constant (%g %g %g %g)",
+              (double)k[0], (double)k[1], (double)k[2], (double)k[3]);
+        rsx_rop_blend_constant(0x38003C00u, 0x7C00C000u, RSX_ROP_FMT_F_W16Z16Y16X16, 0, 0, k);
+        CHECK(fabsf(k[3] - 56.0f / 255.0f) < 1e-6f, "BLEND_C16=0: fp16 targets read ARGB8 (old)");
+        int bad = 0;
+        for (uint32_t h = 0; h < 65536u; h++) {
+            const uint32_t e = (h >> 10) & 31u, m = h & 1023u;
+            double v = e == 0 ? ldexp((double)m, -24) : e == 31 ? (m ? NAN : INFINITY) : ldexp(1024.0 + m, (int)e - 25);
+            if (h & 0x8000u) v = -v;
+            const float f = rsx_rop_half(h);
+            if (isnan(v) ? !isnan(f) : (double)f != v) bad++;
+        }
+        CHECK(bad == 0, "fp16 decode: %d of 65536 wrong", bad);
+    }
+
+    /* 8. round8 only for blended 8-bit targets */
+    {
+        const rsx_rop_cfg c = cfg_new();
+        const rsx_rop_in b8 = in_of(1, 0, 0x03020302, 0x03030303, 0x80068006, RSX_ROP_FMT_A8R8G8B8);
+        CHECK(rsx_rop_make_plan(&b8, &c).rop == RSX_ROP_ROUND8, "8-bit blend: round8");
+        const rsx_rop_in nb = in_of(0, 0, 0x03020302, 0x03030303, 0x80068006, RSX_ROP_FMT_A8R8G8B8);
+        CHECK(rsx_rop_make_plan(&nb, &c).rop == 0, "no blend: no variant");
+        const rsx_rop_in fh = in_of(1, 0, 0x03020302, 0x03030303, 0x80068006, RSX_ROP_FMT_F_W16Z16Y16X16);
+        CHECK(rsx_rop_make_plan(&fh, &c).rop == 0, "fp16 blend: no round8");
+    }
+
+    /* 9. the HLSL epilogue */
+    {
+        static const char single[] =
+            "float4 main(PSInput input) : SV_TARGET {\n"
+            "    float4 _o = h[0];\n"
+            "    return (_o == _o) ? _o : (float4)0;\n}\n";
+        char buf[4096];
+        strcpy(buf, single);
+        CHECK(rsx_rop_apply_epilogue(buf, sizeof buf, 0) == 0 && !strcmp(buf, single), "rop 0: untouched");
+        strcpy(buf, single);
+        CHECK(rsx_rop_apply_epilogue(buf, sizeof buf, RSX_ROP_ROUND8) == 1 &&
+              strstr(buf, "    float4 _rsx_rop = (_o == _o) ? _o : (float4)0;\n") &&
+              strstr(buf, "floor(saturate(_c) * 255.0 + 0.5) / 255.0") &&
+              strstr(buf, "    return _rsx_rop;\n}\n") && !strstr(buf, "_s, 0.0"), "round8 epilogue");
+        const uint32_t sp = RSX_ROP_PASS_P | RSX_ROP_SGN_RGB | (1u << RSX_ROP_SGN_T_SHIFT);
+        strcpy(buf, single);
+        CHECK(rsx_rop_apply_epilogue(buf, sizeof buf, sp) == 1 && strstr(buf, "max(_s, 0.0)") &&
+              strstr(buf, "_c.rgb = _t.rgb;") && !strstr(buf, "_c.a = _t.a;"), "signed positive pass, RGB only");
+        strcpy(buf, single);
+        CHECK(rsx_rop_apply_epilogue(buf, sizeof buf, rsx_rop_pass_n(sp)) == 1 && strstr(buf, "max(-_s, 0.0)"),
+              "signed negative pass");
+        static const char mrt[] =
+            "struct PSOutput {\n    float4 t0 : SV_TARGET0;\n    float4 t1 : SV_TARGET1;\n    float4 t2 : SV_TARGET2;\n};\n"
+            "PSOutput main(PSInput input) {\n"
+            "    PSOutput _out;\n"
+            "    _out.t0 = h[0];\n    _out.t1 = h[4];\n    _out.t2 = h[6];\n"
+            "    return _out;\n}\n";
+        strcpy(buf, mrt);
+        CHECK(rsx_rop_apply_epilogue(buf, sizeof buf, sp | (0xBu << RSX_ROP_XA_T_SHIFT)) == 1 &&
+              strstr(buf, "    PSOutput _rsx_rop = _out;\n") && strstr(buf, "_rsx_rop.t0 = _c;") &&
+              strstr(buf, "_rsx_rop.t1 = _c;") && !strstr(buf, "_rsx_rop.t2 = _c;") && !strstr(buf, "t3"),
+              "MRT: per-target transform (signed t0, x-alpha t0/t1, nothing on t2)");
+        strcpy(buf, "float4 main() : SV_TARGET { return 1; }");
+        CHECK(rsx_rop_apply_epilogue(buf, sizeof buf, RSX_ROP_ROUND8) == -1, "unpatchable tail reported");
+        strcpy(buf, single);
+        CHECK(rsx_rop_apply_epilogue(buf, sizeof single + 8, RSX_ROP_ROUND8) == -1, "too small a buffer reported");
+    }
+
+    printf("test_rop_blend: %d passed, %d failed\n", s_pass, s_fail);
+    return s_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_rop_warp.c b/libs/video/tests/test_rop_warp.c
new file mode 100644
index 0000000..3045883
--- /dev/null
+++ b/libs/video/tests/test_rop_warp.c
@@ -0,0 +1,819 @@
+/*
+ * ps3recomp - the RSX ROP rules of libs/video/rsx_rop.h on a real D3D12 device
+ * (WARP), against the hardware rules written out here independently
+ * (docs/GROUND_TRUTH.md 5.1).
+ *
+ * Every case builds its pipelines exactly as the backend does --
+ * rsx_rop_make_plan (guest state -> key + epilogue variant),
+ * rsx_rop_apply_epilogue on a decompiler-shaped pixel shader,
+ * rsx_rop_fill_blend / rsx_rop_fill_ds for the PSO, a second draw for
+ * a signed blend's negative pass -- renders over a known destination, reads
+ * the target back and compares every texel:
+ *   W0  (no device) every toggle off: the blend description is the old
+ *       backend's, field for field
+ *   W1  ADD_SIGNED (0xF006F006, ONE/ONE): all 256 destination x 256 source
+ *       codes per channel, exact; the old mapping (FUNC_ADD) for contrast
+ *   W2  ADD_SIGNED with SRC_ALPHA / ONE_MINUS_SRC_ALPHA (the title's sites
+ *       0x2EC8F4 and 0x4274B0): the factors are ignored, exact
+ *   W3  REVERSE_SUBTRACT_SIGNED (0xF005), exact
+ *   W4  two overlapping primitives in one draw (-5 then +3): exact wherever
+ *       no intermediate sum saturates (the documented approximation)
+ *   W5  SET_BLEND_ENABLE_MRT 0x3 / 0x9 / 0x8 on four targets; the old mirror
+ *   W6  XRGB targets (ROP_XRGB=1): DST_ALPHA reads 1, the X byte 0 / 255
+ *   W7  no blending on an fp32 target
+ *   W8  CONSTANT_COLOR / ONE_MINUS_CONSTANT_ALPHA through
+ *       D3D12_BLEND_ALPHA_FACTOR (skipped when the device lacks it)
+ *   W9  the 8-bit source rounding before an alpha blend (ROP_ROUND8), exact;
+ *       the unrounded source for contrast
+ *   W10 a signed draw under a stencil-writing state (EQUAL 0, INCR): exact,
+ *       the stencil incremented once (rsx_rop_fill_ds: N does the stencil ops)
+ *   W11 depth LESS without writes against an equal stored depth: nothing drawn
+ *   W12 depth LESS with writes: exact, the depth written
+ *   W13 depth NOT_EQUAL with writes: exact
+ *       (W10-W13 also run the first version's rule -- N relaxed LESS ->
+ *       LESS_EQUAL always, no stencil ops -- for contrast: W10, W11, W13 differ)
+ *   WD  (no device) rsx_rop_fill_ds field by field
+ *
+ * Windows only. From external/ps3recomp:
+ *   clang-cl /nologo /O2 -I libs/video libs/video/tests/test_rop_warp.c d3d12.lib dxgi.lib dxguid.lib
+ *            d3dcompiler.lib /Fe:T/trw.exe && T/trw.exe
+ */
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
