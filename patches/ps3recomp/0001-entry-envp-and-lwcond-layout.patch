+static ss_host_ops s_host;
+static ss_ppu_ops  s_ppu;
+void ss_set_host_ops(const ss_host_ops* o) { if (o) s_host = *o; }
+void ss_set_ppu_ops(const ss_ppu_ops* o)   { if (o) s_ppu = *o; }
+
+/* ---------------------------------------------------------------------------
+ * Park/release plumbing
+ * -----------------------------------------------------------------------*/
+static SRWLOCK            s_lk = SRWLOCK_INIT;
+static CONDITION_VARIABLE s_cv = CONDITION_VARIABLE_INIT;
+static volatile long s_gen, s_spu_gen, s_mix_gen;
+static const ss_spu_ops* volatile s_spu_ops;
+
+static void wake_coordinator(void)
+{
+    if (s_host.wake_coordinator) s_host.wake_coordinator();
+}
+
+/* Watchdog. A parked thread that has waited far longer than any stop can take
+ * -- the coordinator stopped ticking: a frame clock wedged in a present, a
+ * closed window -- releases everything itself, so a census can never hang the
+ * game. Every parked thread checks on each 50 ms wakeup, with s_lk held.
+ * From a SAVE's GPU flush to its release (s_co_capturing) the coordinator is
+ * busy, not wedged -- a GPU fence wait alone may take 3 x 2 s before it gives
+ * up -- so the limit is capture_grace_ms longer; save_capture checks
+ * afterwards that it did not fire anyway (stop_intact). */
+static volatile uint64_t s_stop_t0;     /* when the current stop was requested; 0 = none */
+static volatile long s_watchdog_fired;
+static volatile long s_co_capturing;    /* a SAVE's GPU flush, check and capture, until its release */
+/* A LOAD between its discard and its release (M4c): the world is the
+ * coordinator's alone -- the watchdog never fires then (the mixer, still
+ * parked, would otherwise release itself into a half-restored state; H1). */
+static volatile long s_loading;
+static void release_all_locked(void)
+{
+    InterlockedExchange(&g_ss_req, 0);
+    InterlockedIncrement(&s_gen);
+    InterlockedExchange(&g_ss_mix_req, 0);
+    InterlockedIncrement(&s_mix_gen);
+    if (g_ss_spu_req) {
+        InterlockedExchange(&g_ss_spu_req, 0);
+        InterlockedIncrement(&s_spu_gen);
+        if (s_spu_ops && s_spu_ops->force_hops) s_spu_ops->force_hops(0);
+    }
+    s_stop_t0 = 0;
+    InterlockedExchange(&s_co_capturing, 0);
+    ss_time_thaw();                       /* (a save's frozen guest clock goes on) */
+    WakeAllConditionVariable(&s_cv);
+}
+static void watchdog(void)
+{
+    const uint64_t t0 = s_stop_t0;
+    if (!t0 || s_loading) return;
+    const uint64_t now = ss_now_us();
+    uint64_t lim = (uint64_t)(2u * s_cfg.timeout_ms + s_cfg.spu_timeout_ms +
+                              s_cfg.mixer_timeout_ms + 2000u) * 1000ull;
+    if (s_co_capturing) lim += (uint64_t)s_cfg.capture_grace_ms * 1000ull;
+    if (now < t0 || now - t0 < lim) return;
+    release_all_locked();
+    if (InterlockedIncrement(&s_watchdog_fired) <= 4) {
+        fprintf(stderr, "[ss] WATCHDOG: a stop has been pending %.0f ms without the coordinator"
+                        " finishing it -- released every parked thread\n", (double)(now - t0) / 1000.0);
+        fflush(stderr);
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * PPU threads
+ * -----------------------------------------------------------------------*/
+typedef struct ss_bridge_rec { uint32_t nid, caller_r1, slice_r1, caller_r2; } ss_bridge_rec;
+
+enum { REFUSE_NONE = 0, REFUSE_TIER1, REFUSE_CB, REFUSE_TRAMP, REFUSE_BRIDGE };
+static const char* const k_refuse[] = { "-", "tier1", "callback", "trampoline", "bridge" };
+
+typedef struct ss_thr {
+    volatile long state;          /* 1 = parked in stop `gen` */
+    volatile long gen;
+    int      at, tier;
+    uint32_t num, obj;
+    ss_wait_rec rec;              /* an S3 park's payload (M4c) */
+    unsigned long host_tid;       /* the host thread parked (a load's discard waits for it to exit) */
+    uint64_t t_park_us;
+    int      cb_depth, br_depth, icall_depth, vcall_sp, tramp;
+    ss_bridge_rec br[SS_BRIDGE_MAX];
+    ppu_context ctx;
+    /* safepoint visits during the current stop (straggler diagnosis) */
+    volatile long visit_gen;
+    uint64_t visit_us;
+    int      visit_at, visit_refuse;
+    uint32_t visit_num, visit_lr;
+    unsigned visits;
+    /* per-thread totals */
+    unsigned n_parks, n_tier1, n_straggler;
+    double   sum_ms, max_ms;
+} ss_thr;
+static ss_thr s_thr[SS_MAX_TID + 1];
+static volatile long s_unreg_visits;
+
+static PPU_THREAD_LOCAL int t_cb_depth;
+static PPU_THREAD_LOCAL int t_br_depth;
+static PPU_THREAD_LOCAL ss_bridge_rec t_br[SS_BRIDGE_MAX];
+
+void ss_cb_enter(void) { t_cb_depth++; }
+void ss_cb_leave(void) { if (t_cb_depth > 0) t_cb_depth--; }
+void ss_bridge_enter(uint32_t nid, uint32_t r1, uint32_t slice, uint32_t r2)
+{
+    int d = t_br_depth++;
+    if (d >= 0 && d < SS_BRIDGE_MAX) {
+        t_br[d].nid = nid; t_br[d].caller_r1 = r1; t_br[d].slice_r1 = slice; t_br[d].caller_r2 = r2;
+    }
+}
+void ss_bridge_leave(void) { if (t_br_depth > 0) t_br_depth--; }
+void ss_thread_root_reset(void) { t_cb_depth = 0; t_br_depth = 0; }
+
+static ss_thr* thr_of(const struct ppu_context* ctx)
+{
+    const uint64_t tid = ctx ? ctx->thread_id : 0;
+    if (tid == 0 || tid > SS_MAX_TID) { InterlockedIncrement(&s_unreg_visits); return 0; }
+    return &s_thr[tid];
+}
+
+static void note_visit(ss_thr* r, int at, uint32_t num, int refuse, uint32_t lr)
+{
+    const long g = s_gen;
+    if (r->visit_gen != g) { r->visit_gen = g; r->visits = 0; }
+    r->visits++;
+    r->visit_us = ss_now_us();
+    r->visit_at = at; r->visit_num = num; r->visit_refuse = refuse; r->visit_lr = lr;
+}
+
+static int refusal(long req, int tramp, int s3)
+{
+    if (t_cb_depth > 0) return REFUSE_CB;
+    if (tramp) return REFUSE_TRAMP;
+    if (t_br_depth > 0 && !s_cfg.bridge_park) return REFUSE_BRIDGE;
+    if (!s3 && req < 2) return REFUSE_TIER1;
+    return REFUSE_NONE;
+}
+
+/* A LOAD's discard verdicts (M4c): the PPU / SPU stop generation whose
+ * parked threads are thrown away instead of released (-1: none). Written by
+ * the coordinator under s_lk before it bumps the generation. */
+static volatile long s_discard_gen = -1, s_spu_discard_gen = -1;
+static void discard_self(void);
+
+/* An S3 park's payload, its defaults filled in: the call to re-issue is r11
+ * for a syscall wait and the NID ps3_hle_call entered with for an HLE one. */
+static void rec_fill(ss_wait_rec* d, const struct ppu_context* ctx, int at, uint32_t kind, const ss_wait_rec* rec)
+{
+    if (rec) *d = *rec; else memset(d, 0, sizeof *d);
+    if (at != SS_IN_WAIT || d->nid_or_sc) return;
+    if (ss_wait_is_syscall((int)kind)) d->nid_or_sc = (uint32_t)ctx->gpr[11];
+    else if (s_ppu.hle_nid) d->nid_or_sc = s_ppu.hle_nid();
+}
+
+static void ppu_park(struct ppu_context* ctx, ss_thr* r, int at, uint32_t num, uint32_t obj, const ss_wait_rec* rec)
+{
+    int icall = -1, vsp = -1;
+    if (s_ppu.icall_state) s_ppu.icall_state(&icall, &vsp);   /* this thread's own TLS */
+    const int tramp = s_ppu.tramp_pending ? s_ppu.tramp_pending() : 0;   /* (an S3 park allows one) */
+    const uint64_t t = ss_now_us();
+    ss_wait_rec wr;
+    rec_fill(&wr, ctx, at, num, rec);
+    AcquireSRWLockExclusive(&s_lk);
+    const long req = g_ss_req;
+    if (req) {
+        const long gen = s_gen;
+        r->at = at; r->num = num; r->obj = obj; r->tier = (int)req; r->t_park_us = t;
+        r->rec = wr;
+        r->host_tid = GetCurrentThreadId();
+        r->cb_depth = t_cb_depth; r->br_depth = t_br_depth;
+        r->icall_depth = icall; r->vcall_sp = vsp; r->tramp = tramp;
+        memcpy(r->br, t_br, sizeof r->br);
+        memcpy(&r->ctx, ctx, sizeof r->ctx);
+        r->gen = gen;
+        InterlockedExchange(&r->state, 1);
+        wake_coordinator();
+        while (g_ss_req && s_gen == gen) {
+            SleepConditionVariableSRW(&s_cv, &s_lk, 50, 0);
+            watchdog();
+        }
+        InterlockedExchange(&r->state, 0);
+        if (s_discard_gen == gen) {
+            /* A LOAD threw this stop's world away: no return into the call
+             * (its frames belong to the old state). The lock first. */
+            ReleaseSRWLockExclusive(&s_lk);
+            discard_self();
+        }
+    }
+    ReleaseSRWLockExclusive(&s_lk);
+}
+
+static void sr_safepoint(struct ppu_context* ctx, int at, uint32_t num, int tramp);
+
+void ss_ppu_safepoint(struct ppu_context* ctx, int at, uint32_t num, int tramp)
+{
+    if (!ctx) return;
+    const long req = g_ss_req;
+    if (req) {
+        ss_thr* r = thr_of(ctx);
+        if (r) {
+            const int why = refusal(req, tramp, 0);
+            note_visit(r, at, num, why, (uint32_t)ctx->lr);
+            if (why == REFUSE_NONE) ppu_park(ctx, r, at, num, 0, NULL);
+        }
+    }
+    /* P0 after a census park, never before: a released park just goes on. */
+    if (g_ss_sr_mask) sr_safepoint(ctx, at, num, tramp);
+}
+
+/* Would an S3 park point park this thread now? (No side effects: refusals
+ * are thread-local, so the answer holds for the rest of the caller's wait.) */
+static int ss_can_park(const struct ppu_context* ctx)
+{
+    const uint64_t tid = ctx ? ctx->thread_id : 0;
+    if (!g_ss_req || tid == 0 || tid > SS_MAX_TID) return 0;
+    return refusal(g_ss_req, 0, 1) == REFUSE_NONE;
+}
+
+uint64_t ss_ppu_wait_point_ex(struct ppu_context* ctx, int kind, uint32_t obj, const ss_wait_rec* rec)
+{
+    const long req = g_ss_req;
+    if (!req || !ctx) return 0;
+    ss_thr* r = thr_of(ctx);
+    if (!r) return 0;
+    const int why = refusal(req, 0, 1);
+    note_visit(r, SS_IN_WAIT, (uint32_t)kind, why, (uint32_t)ctx->lr);
+    if (why != REFUSE_NONE) return 0;
+    const uint64_t t0 = ss_now_us();
+    ppu_park(ctx, r, SS_IN_WAIT, (uint32_t)kind, obj, rec);
+    return ss_now_us() - t0;
+}
+
+uint64_t ss_ppu_wait_point(struct ppu_context* ctx, int kind, uint32_t obj)
+{
+    return ss_ppu_wait_point_ex(ctx, kind, obj, NULL);
+}
+
+uint64_t ss_guest_ns(void) { return ps3_guest_ns(); }
+
+/* ---- the S3 resumers (M4c): a kind's owner registers the rest of its call */
+static ss_wait_resume_fn s_resumer[SS_W__COUNT];
+/* The kinds a resume re-issues from the call's entry (ss_core.h's table). */
+static const unsigned char k_reissue[SS_W__COUNT] = {
+    0, /* none */ 1, /* sem */ 1, /* equeue */ 1, /* eflag */ 1, /* join */ 0, /* usleep */ 0, /* sleep */
+    1, /* spu_join */ 1, /* mutex */ 0, /* cond */ 1, /* lwmutex */ 0, /* lwcond */ 0, /* lwcond_reacq */
+    1, /* spinlock */ 1, /* net */
+};
+void ss_set_wait_resumer(int kind, ss_wait_resume_fn fn) { if (kind > 0 && kind < SS_W__COUNT) s_resumer[kind] = fn; }
+ss_wait_resume_fn ss_wait_resumer(int kind) { return (kind > 0 && kind < SS_W__COUNT) ? s_resumer[kind] : NULL; }
+int ss_wait_resumable(int kind)
+{
+    return kind > 0 && kind < SS_W__COUNT && (k_reissue[kind] || s_resumer[kind] != NULL);
+}
+
+#ifdef _WIN32
+/* Park policy for the wrapped waits: a thread parks when it is IDLE -- about
+ * to block, or blocked a whole slice -- and never at the moment it is woken
+ * with something to do. A woken waiter carries on, does its work and comes
+ * back to wait (and parks then); parking it before it consumed the wakeup
+ * would stall whoever is spinning on its result, and that thread may not have
+ * a safepoint at all. */
+unsigned long ss_wait_handle_ex(struct ppu_context* ctx, void* h, unsigned long ms, int kind, uint32_t obj,
+                                const ss_wait_rec* rec)
+{
+    if (!g_ss_armed) return WaitForSingleObject((HANDLE)h, ms);
+    const uint64_t t0 = ss_now_us();
+    uint64_t parked = 0;
+    if (g_ss_req) {                       /* about to block: take it if it is free, else park */
+        const DWORD r = WaitForSingleObject((HANDLE)h, 0);
+        if (r != WAIT_TIMEOUT || ms == 0) return r;
+        parked += ss_ppu_wait_point_ex(ctx, kind, obj, rec);
+    }
+    for (;;) {
+        DWORD slice = s_cfg.slice_ms;
+        if (ms != INFINITE) {
+            const uint64_t el = (ss_now_us() - t0 - parked) / 1000ull;
+            if (el >= ms) return WaitForSingleObject((HANDLE)h, 0);
+            if (ms - el < slice) slice = (DWORD)(ms - el);
+        }
+        const DWORD r = WaitForSingleObject((HANDLE)h, slice);
+        if (r != WAIT_TIMEOUT) return r;
+        if (g_ss_req) parked += ss_ppu_wait_point_ex(ctx, kind, obj, rec);
+    }
+}
+
+unsigned long ss_wait_handle(struct ppu_context* ctx, void* h, unsigned long ms, int kind, uint32_t obj)
+{
+    return ss_wait_handle_ex(ctx, h, ms, kind, obj, NULL);
+}
+
+/* One armed CV wait: at most one slice, then back to the caller. A slice that
+ * times out is handed back as a spurious wakeup, never slept on again here:
+ * a waiter whose slice expired is off the CV's wait list while it re-takes
+ * the lock, so a wake sent in that window (the signaller changes the
+ * predicate and wakes with the lock held) finds nobody, and only the
+ * caller's predicate loop can see that it came true. `dl` carries a timed
+ * wait's deadline across calls (NULL: ms is INFINITE or the time the caller
+ * has left, recomputed by it after every return). */
+static int cv_wait(struct ppu_context* ctx, CONDITION_VARIABLE* cv, CRITICAL_SECTION* cs,
+                   unsigned long ms, uint64_t* dl, int kind, uint32_t obj, const ss_wait_rec* rec)
+{
+    if (g_ss_req) {                       /* about to block (the caller's predicate is false) */
+        if (ss_can_park(ctx)) {
+            /* Park with the lock dropped. Whatever it guarded may have
+             * moved meanwhile, so hand back a spurious wakeup: the
+             * caller's loop re-checks its predicate. Time parked does not
+             * count against a deadline. (A load's discard leaves from the
+             * park with the lock dropped: nothing to undo.) */
+            LeaveCriticalSection(cs);
+            const uint64_t parked = ss_ppu_wait_point_ex(ctx, kind, obj, rec);
+            EnterCriticalSection(cs);
+            if (dl && *dl) *dl += parked;
+            return TRUE;
+        }
+        /* refused (inside a callback, say): record the visit -- it cannot
+         * park, so the lock may stay held -- and wait on normally */
+        (void)ss_ppu_wait_point_ex(ctx, kind, obj, rec);
+    }
+    DWORD slice = s_cfg.slice_ms;
+    int last = 0;                         /* this slice ends at the caller's deadline */
+    if (ms != INFINITE) {
+        uint64_t left = ms;
+        if (dl) {
+            const uint64_t now = ss_now_us();
+            if (!*dl) *dl = now + (uint64_t)ms * 1000ull;
+            left = *dl > now ? (*dl - now + 999) / 1000 : 0;
+        }
+        if (left == 0) { SetLastError(ERROR_TIMEOUT); return FALSE; }
+        if (left <= slice) { slice = (DWORD)left; last = 1; }
+    }
+    if (SleepConditionVariableCS(cv, cs, slice))
+        return TRUE;                      /* woken: let the caller look (a busy waiter parks on its next call) */
+    if (GetLastError() != ERROR_TIMEOUT || last) return FALSE;   /* (a timeout: ERROR_TIMEOUT) */
+    return TRUE;                          /* a whole slice idle: the caller re-checks and calls
+                                           * again, and parks then if a stop is pending */
+}
+
+int ss_sleep_cv_cs_ex(struct ppu_context* ctx, void* cv, void* cs, unsigned long ms, int kind, uint32_t obj,
+                      const ss_wait_rec* rec)
+{
+    if (!g_ss_armed)
+        return SleepConditionVariableCS((CONDITION_VARIABLE*)cv, (CRITICAL_SECTION*)cs, ms);
+    return cv_wait(ctx, (CONDITION_VARIABLE*)cv, (CRITICAL_SECTION*)cs, ms, 0, kind, obj, rec);
+}
+
+int ss_sleep_cv_cs_dl_ex(struct ppu_context* ctx, void* cv, void* cs, unsigned long ms, uint64_t* dl,
+                         int kind, uint32_t obj, const ss_wait_rec* rec)
+{
+    if (!g_ss_armed)
+        return SleepConditionVariableCS((CONDITION_VARIABLE*)cv, (CRITICAL_SECTION*)cs, ms);
+    return cv_wait(ctx, (CONDITION_VARIABLE*)cv, (CRITICAL_SECTION*)cs, ms, dl, kind, obj, rec);
+}
+
+int ss_sleep_cv_cs(struct ppu_context* ctx, void* cv, void* cs, unsigned long ms, int kind, uint32_t obj)
+{
+    return ss_sleep_cv_cs_ex(ctx, cv, cs, ms, kind, obj, NULL);
+}
+
+int ss_sleep_cv_cs_dl(struct ppu_context* ctx, void* cv, void* cs, unsigned long ms, uint64_t* dl,
+                      int kind, uint32_t obj)
+{
+    return ss_sleep_cv_cs_dl_ex(ctx, cv, cs, ms, dl, kind, obj, NULL);
+}
+#endif
+
+/* The last part of a sliced sleep, in one wait on the high-resolution timer
+ * the unarmed sys_timer_usleep uses: no spin (a 30 ms sleep needs no
+ * microsecond tail, and a spin that yields can lose its core for a quantum). */
+static void sleep_tail_us(uint64_t us)
+{
+#ifdef _WIN32
+    HANDLE t = CreateWaitableTimerW(NULL, TRUE, NULL);
+    if (t) {
+        LARGE_INTEGER due;
+        due.QuadPart = -(LONGLONG)(us * 10);  /* 100 ns units, negative = relative */
+        SetWaitableTimer(t, &due, 0, NULL, NULL, FALSE);
+        WaitForSingleObject(t, INFINITE);
+        CloseHandle(t);
+        return;
+    }
+#endif
+    Sleep((DWORD)((us + 999) / 1000));
+}
+
+void ss_ppu_sleep_us(struct ppu_context* ctx, uint64_t us, int kind)
+{
+    const uint64_t t0 = ss_now_us();
+    uint64_t parked = 0;
+    for (;;) {
+        const uint64_t el = ss_now_us() - t0 - parked;
+        if (el >= us) return;
+        const uint64_t rem = us - el;
+        if (rem > (uint64_t)s_cfg.slice_ms * 1000ull) Sleep(s_cfg.slice_ms);
+        else sleep_tail_us(rem);              /* the rest: the sleep ends unless it parks below */
+        if (g_ss_req) {
+            /* the park's payload: where the sleep ends on the guest clock, so
+             * a resumed sleep (a load) sleeps only what is left */
+            ss_wait_rec wr;
+            memset(&wr, 0, sizeof wr);
+            const uint64_t el2 = ss_now_us() - t0 - parked;
+            wr.deadline_ns = ss_guest_ns() + (el2 < us ? (us - el2) * 1000ull : 0ull) + 1ull;
+            parked += ss_ppu_wait_point_ex(ctx, kind, (uint32_t)us, &wr);
+        }
+    }
+}
