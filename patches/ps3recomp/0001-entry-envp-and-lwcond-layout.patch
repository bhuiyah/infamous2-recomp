+static void test_sampler(void)
+{
+    /* a mip code with guest LOD state: min 1.0, max 3.5, bias 0.25 */
+    const uint64_t base = 1u | 2u | 4u | 8u;
+    const uint64_t lod = base | (1ull << 53) | (64ull << 13) | (256ull << 26) | (896ull << 38);
+    const uint64_t neutral_mip = base;
+    const uint64_t nomip = 1u | 2u;                     /* LINEAR, no mips */
+    CHECK(tp_samp_shift(lod, 0, 1) == lod && tp_samp_shift(nomip, 0, 1) == nomip);           /* s = 0: today's codes */
+    CHECK(tp_samp_shift(neutral_mip, 2, 1) == neutral_mip);                                   /* no clamp: the view ends the chain */
+    CHECK(tp_samp_shift(nomip, 2, 0) == nomip);                                               /* minify = guest */
+    float a, b; int pm;
+    CHECK(!tp_samp_lod(lod, &a, &b, &pm));                                                    /* unshifted: nothing to apply */
+    const uint64_t s2 = tp_samp_shift(lod, 2, 1);
+    CHECK(s2 != lod && (s2 & ~(0x1Full << 59)) == lod);                                       /* only bits 59-63 added */
+    CHECK(!(s2 & (0x1Full << 54)) && !(tp_samp_shift(lod, -2, 1) & (0x1Full << 54)) &&
+          !(tp_samp_shift(nomip, 4, 1) & (0x1Full << 54)));                                    /* never TEX_BORDER's 54-58 */
+    { const uint64_t border = lod | (31ull << 54);                                            /* a border index alone */
+      CHECK(!tp_samp_lod(border, &a, &b, &pm)); }                                              /* is not a shift */
+    CHECK(tp_samp_lod(s2, &a, &b, &pm) && !pm && a == 3.0f && b == 5.5f);
+    const uint64_t zmin = base | (1ull << 53) | (0ull << 26) | (512ull << 38);               /* min 0 stays 0 */
+    CHECK(tp_samp_lod(tp_samp_shift(zmin, 1, 1), &a, &b, &pm) && a == 0.0f && b == 3.0f);
+    const uint64_t pn = tp_samp_shift(nomip, 2, 1);
+    CHECK(tp_samp_lod(pn, &a, &b, &pm) && pm && a == 0.0f && b == 2.0f);                     /* non-mip: levels [0, s] */
+    const uint64_t sm = tp_samp_shift(lod, -1, 1);                                            /* a half-size replacement */
+    CHECK(tp_samp_lod(sm, &a, &b, &pm) && a == 0.0f && b == 2.5f);
+    CHECK(tp_samp_shift(nomip, -1, 1) == nomip);
+    const uint64_t pinned = base | (1ull << 53) | (0ull << 26) | (0ull << 38);              /* max LOD 0 (pinned to level 0) */
+    CHECK(tp_samp_lod(tp_samp_shift(pinned, 2, 1), &a, &b, &pm) && a == 0.0f && b == 2.0f);
+    /* view levels: never past the guest's coarsest level */
+    CHECK(tp_view_levels(11, 9, 2) == 11 && tp_view_levels(11, 1, 2) == 3 && tp_view_levels(10, 10, 0) == 10);
+    CHECK(tp_view_levels(1, 9, 2) == 1 && tp_view_levels(5, 1, -2) == 1 && tp_view_levels(9, 9, -1) == 8);
+    /* scales */
+    int s;
+    CHECK(tp_scale_log2(512, 256, 1024, 512, &s) && s == 1);
+    CHECK(tp_scale_log2(512, 256, 8192, 4096, &s) && s == 4);
+    CHECK(tp_scale_log2(512, 256, 128, 64, &s) && s == -2);
+    CHECK(tp_scale_log2(300, 200, 1200, 800, &s) && s == 2);
+    CHECK(!tp_scale_log2(512, 256, 1024, 1024, &s) && !tp_scale_log2(512, 512, 1536, 1536, &s) && !tp_scale_log2(512, 512, 16384, 16384, &s));
+    CHECK(!tp_scale_log2(300, 200, 75, 50, &s) || s == -2);
+    CHECK(!tp_scale_log2(6, 6, 3, 3, &s) || s == -1);
+    CHECK(!tp_scale_log2(5, 5, 2, 2, &s));                                                    /* not exact */
+}
