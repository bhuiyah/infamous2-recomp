+      CHECK(rsx_ss_decide(&c, 1, 2, 0, 8) == RSX_SS_REUSE, "clean: reused");
+      CHECK(rsx_ss_decide(&c, 1, 1, 0, 8) == RSX_SS_REUSE, "clean at level 1: reused");
+      CHECK(rsx_ss_decide(&c, 1, 0, 0, 8) == RSX_SS_COPY, "level 0: copy");
+      CHECK(rsx_ss_decide(&c, 2, 2, 0, 8) == RSX_SS_COPY, "a copy of another loop: copy");
+      CHECK(rsx_ss_takes_writer(&c, 1) && !rsx_ss_takes_writer(&c, 2), "writers of its own loop only");
+      rsx_ss_written(&c, 1);
+      CHECK(rsx_ss_decide(&c, 1, 2, 1, 8) == RSX_SS_COVER, "one writer: brought up to date");
+      CHECK(rsx_ss_decide(&c, 1, 2, 8, 8) == RSX_SS_COVER, "maxw writers: brought up to date");
+      CHECK(rsx_ss_decide(&c, 1, 2, 9, 8) == RSX_SS_COPY, "more than maxw writers: copy");
+      CHECK(rsx_ss_decide(&c, 1, 1, 1, 8) == RSX_SS_COPY, "written at level 1: copy");
+      CHECK(rsx_ss_decide(&c, 1, 2, 0, 8) == RSX_SS_COPY, "written, no writer record: copy");
+      rsx_ss_covered(&c, 5);
+      CHECK(rsx_ss_decide(&c, 1, 2, 0, 8) == RSX_SS_REUSE && c.wfirst == 5u, "covered: clean, writers from 5 on");
