+/* ---------------------------------------------------------------------------
+ * On-disk DXBC cache for the guest shaders (SHADER_CACHE=0 disables it).
+ *
+ * Every vertex/fragment program the title uses is decompiled to HLSL and run
+ * through D3DCompile the first time it is seen -- 5-50 ms each, so a scene cut
+ * that brings in a few dozen new programs stalls the render thread for most
+ * of a second (71 pipeline misses took 0.84 s at inFamous 2's intro). The
+ * compiled bytecode is a pure function of (HLSL text, target, flags), so it is
+ * cached by content: the file name is two independent 64-bit hashes of the
+ * source plus the target, and a hit is used only if the file is a DXBC blob of
+ * the recorded size. Files go to SHADER_CACHE_DIR, default "shadercache" next
+ * to the executable; a write is a temp file renamed into place, so a crash or
+ * a second instance never leaves a partial entry behind. Compile failures are
+ * not cached.
+ * -----------------------------------------------------------------------*/
+static const char* sc_dir(void)
+{
+    static char dir[MAX_PATH + 32];
+    static int state = -1;                       /* -1 unknown, 0 off, 1 on */
+    if (state < 0) {
+        const char* e = getenv("SHADER_CACHE");
+        state = (e && *e == '0') ? 0 : 1;
+        if (state) {
+            const char* d = getenv("SHADER_CACHE_DIR");
+            if (d && *d) snprintf(dir, sizeof dir, "%s", d);
+            else {
+                char exe[MAX_PATH]; DWORD n = GetModuleFileNameA(NULL, exe, MAX_PATH);
+                char* slash = (n && n < MAX_PATH) ? strrchr(exe, '\\') : NULL;
+                if (slash) { *slash = 0; snprintf(dir, sizeof dir, "%s\\shadercache", exe); }
+                else snprintf(dir, sizeof dir, "shadercache");
+            }
+            CreateDirectoryA(dir, NULL);         /* ERROR_ALREADY_EXISTS is fine */
+            DWORD at = GetFileAttributesA(dir);
+            if (at == INVALID_FILE_ATTRIBUTES || !(at & FILE_ATTRIBUTE_DIRECTORY)) state = 0;
+        }
+    }
+    return state ? dir : NULL;
+}
+
+#include "rsx_shader_async.h"   /* sc_path / sc_file_read / sc_build and the compile workers */
+
+/* ---------------------------------------------------------------------------
+ * Shader compile workers (SHADER_ASYNC, default 1; 0 = every compile on the
+ * render thread, as before).
+ *
+ * D3DCompile of one decompiled program takes 25-85 ms on a test PC (the VS
+ * ~30-80, the PS ~25-35), and the render thread did each one the moment a
+ * draw needed it: turning the camera onto something new cost a 90-160 ms
+ * frame per new VS + PS pair. The disk cache above removes that from the
+ * second session on -- until the decompiler's output changes (any update
+ * that touches it), when every program compiles again on first sight.
+ * Workers take the compiles that can be known in advance:
+ *   - the shader list (SHADER_PREWARM, sl_* below): every program the
+ *     renderer has used, kept as its guest code plus the inputs its HLSL
+ *     depends on; at startup the walker regenerates each one's HLSL while it
+ *     waits for the guest and a worker compiles whatever the cache lacks --
+ *     after an update the list rebuilds the cache in the background, during
+ *     the boot and the menus;
+ *   - record-time kicks (SHADER_KICK): a pixel shader whose key is first seen
+ *     while the walker records a draw is compiled from then on, in parallel
+ *     with the rest of the batch and with the batch's other new shaders, not
+ *     at replay one after the other.
+ * When the render thread needs a source a worker is building it waits for
+ * that worker (raised to above-normal priority) and reads the cache file; one
+ * still queued is taken back and compiled on the render thread as before.
+ * Every program still compiles from the same HLSL text to the same DXBC (the
+ * cache is keyed by content), so what is drawn cannot change, only when the
+ * compile happens. SHADER_THREADS=<n> (default a quarter of the logical CPUs,
+ * 1..4; below-normal priority). SHADER_PREWARM_LOG=1: progress lines.
+ * -----------------------------------------------------------------------*/
+static int sc_async_on(void)
+{
+    if (s_scp.on >= 0) return s_scp.on;
+    s_scp.on = 0;
+    const char* e = getenv("SHADER_ASYNC");
+    if ((e && *e == '0') || !sc_dir()) return 0;
+    int n = (int)GetActiveProcessorCount(ALL_PROCESSOR_GROUPS) / 4;
+    const char* t = getenv("SHADER_THREADS");
+    if (t && *t) n = atoi(t);
+    else if (n > 4) n = 4;
+    if (!sc_pool_start(n)) return 0;
+    printf("[shader] %d compile worker(s) (SHADER_THREADS), below-normal priority\n", s_scp.threads);
+    return 1;
+}
+
+/* dxname (48 bytes, may be NULL): the cache file's name, "" without the cache
+ * (ST1 PSO_PREWARM: the pipeline list names shaders by it). */
+static HRESULT sc_compile(const char* src, size_t len, const char* name, const char* target,
+                          ID3DBlob** out, ID3DBlob** err, char* dxname)
+{
+    *out = NULL; if (err) *err = NULL;
+    if (dxname) dxname[0] = 0;
+    const char* dir = sc_dir();
+    char path[MAX_PATH + 96]; path[0] = 0;
+    const double ft0 = FTR_T0();
+    if (dir) {
+        sc_path(dir, src, len, target, path, sizeof path);
+        {   /* ST1 PSO_PREWARM: the file's name; a blob the prewarm read is in memory */
+            const char* bn = strrchr(path, '\\');
+            bn = bn ? bn + 1 : path;
+            if (dxname && strlen(bn) < 48) memcpy(dxname, bn, strlen(bn) + 1);
+            if ((*out = sc_mem_find(bn)) != NULL) {
+                FTR_INC(sc_hit_n); FTR_INC(sc_mem_n); FTR_ADD(sc_read, ft0);
+                return S_OK;
+            }
+        }
+        if (sc_file_read(path, out)) {
+            FTR_INC(sc_hit_n); FTR_ADD(sc_read, ft0);
+            return S_OK;                                             /* hit */
+        }
+        /* a worker building this very source (SHADER_ASYNC): its result */
+        if (sc_job_wait(path) && sc_file_read(path, out)) {
+            FTR_INC(sc_wait_n); FTR_ADD(sc_wait, ft0);
+            return S_OK;
+        }
+    }
+    HRESULT hr = sc_build(src, len, name, target, path, out, err);
+    FTR_INC(ps_comp_n); FTR_ADD(ps_comp, ft0);    /* every target: VS and PS compiles */
+    return hr;
+}
+static int sl_init(void);              /* the shader list (below vp_get_vs's helpers) */
+static int sl_idle(void);
+/* ST1 SHADER_PREWARM_THREAD: the decompilers keep process-wide state (the VP
+ * decompiler's body / leader buffers, the FP decompiler's per-call setters and
+ * first-use tables), so every decompile -- the walker's and the shader-list
+ * prewarm thread's -- runs under this lock. The walker takes it only for a
+ * program new to its caches; the prewarm holds it for one program at a time.
+ * The prewarm thread runs below normal priority: while it holds the lock it
+ * runs above normal (a walker waiting behind a preempted low-priority holder
+ * would wait for whatever ran instead), and between records it yields while
+ * another thread waits for the lock (s_dec_wait), so the walker goes first. */
+static SRWLOCK s_dec_lk = SRWLOCK_INIT;
+static volatile LONG s_dec_wait;       /* threads other than the prewarm's waiting for s_dec_lk */
+static volatile DWORD s_dec_bg;        /* the prewarm thread's id while it runs (0: none) */
+static void dec_lock(void)
+{
+    if (s_dec_bg && GetCurrentThreadId() == s_dec_bg) {
+        SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+        AcquireSRWLockExclusive(&s_dec_lk);
+        return;
+    }
+    if (TryAcquireSRWLockExclusive(&s_dec_lk)) return;
+    InterlockedIncrement(&s_dec_wait);
+    AcquireSRWLockExclusive(&s_dec_lk);
+    InterlockedDecrement(&s_dec_wait);
+}
+static void dec_unlock(void)
+{
+    ReleaseSRWLockExclusive(&s_dec_lk);
+    if (s_dec_bg && GetCurrentThreadId() == s_dec_bg) SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+}
+#define DEC_LOCK()   dec_lock()
+#define DEC_UNLOCK() dec_unlock()
