+    /* Mode 1: no texture cache keeps a surface across a frame of other fetches. */
+    if (sn->valid && sn->frame != s_rpc.frame_count) sn->valid = 0;
+    /* RES_SCALE: one copy per (op, plane), not per unit (critique C2): a
+     * second unit of the same op reading the same plane sees the same bytes. */
+    const int rs_dup = rs_plumb() && sn->valid && sn->dop == d + 1u && sn->dbatch == s_rpc.vbatch;
+    /* PF2: this replay's copy, and nothing has written the plane since (above). */
+    const int clean = mode == 2 && sn->valid && sn->ss.loop == s_rtsnap_loop && sn->ss.clean;
+    const int reuse = clean && rsx_ss_decide(&sn->ss, s_rtsnap_loop, rtsnap_reuse_on(), 0, 0) == RSX_SS_REUSE;
+    if (rtsnap_census_on()) rtsnap_census(sn, r, d, dr, clean, rs_dup);
+    int rs_copied = 0;
+    if (!rs_dup && !reuse && rsx_selfsample_need_copy(mode, sn->valid, sn->epoch, dr->tinv_epoch)) {
+        rsx_d3d12_snapshot_copy(s_d3d.cmd_list, sn->res, &sn->st, r->res, r->st);
+        sn->valid = 1; sn->epoch = dr->tinv_epoch; sn->frame = s_rpc.frame_count;
+        s_rtsnap_nc++;
+        sn->dop = d + 1u; sn->dbatch = s_rpc.vbatch; rs_copied = 1;
+        rsx_ss_copied(&sn->ss, s_rtsnap_loop, ssw_now()); sn->nwr = 0; sn->cop = 0;
+        s_rtsnap_live = s_rtsnap_loop;
+    }
+    if (reuse && !rs_dup && rtsnap_verify_on()) ssv_compare(sn, r);   /* RT_SELFSAMPLE_VERIFY */
+    rsx_rcz_selfsample(d, r->off, r->hw, r->hh, rs_bpp(r->dxgi), rs_copied);   /* RSX_RES_DRYRUN */
+    srv_write(DRAW_SRV_BASE + d * RSX_DRAW_TEX_UNITS + (u32)u, sn->res, (DXGI_FORMAT)r->dxgi,
+              D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING);
+}
