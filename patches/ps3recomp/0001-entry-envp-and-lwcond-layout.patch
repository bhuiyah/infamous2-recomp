+/* ---- speculative windows (spu_lifter.py --reg-cache, _rc_windows) ----
+ * Every float helper above tests its result (and fcgt/fceq/cflts/cfltu their
+ * operands) and branches to the exact path when a lane needs it. The tests
+ * themselves are cheap, but in a long float loop they are a third of the
+ * vector work and a branch per op: plug_00821000's hot loop (the top lifted
+ * SPU loop of inFamous 2) spent 22% of its time on them.
+ * The lifter therefore emits each long straight run of side-effect-free
+ * statements in a loop (a "window": at least 4 float ops, no store, call,
+ * channel op or label inside) twice:
+ *   - a fast copy, into fresh temporaries, made of the forms below: each is
+ *     the fast path of its helper with the test taken out -- the float ops
+ *     return the leaf their helper would test, fcgt/fceq/cflts/cfltu trust
+ *     operands that a leaf covers (spu_wchk), shufb_k uses its literal and
+ *     returns the guard (control ^ literal), local-store loads skip the gate;
+ *   - the original statements, unchanged.
+ * The fast copy runs first; if every leaf passes -- exactly when no statement
+ * of the window would have left its fast path -- its results are committed
+ * to the registers and the original statements are skipped; otherwise they
+ * run as before. So a window computes the same bits as its statements in
+ * every case: the fast copy is never committed unless each of its results is
+ * what the statement's helper returns (the same instructions in the same
+ * MXCSR mode), and nothing in a window has a side effect to undo.
+ *   - float op (fa/fs/fm/fma/fms/fnms): leaf = f << 1, the result before the
+ *     +0 (sign dropped); bad iff (f << 1) >= 0xFEFFFFFE, i.e. |f| >
+ *     0x7F7FFFFE: the RZDAZ result test (spu__fxres_rzdaz). The leaves meet in
+ *     a tree of unsigned maxima.
+ *   - fcgt/fceq: the host compare is the helper's fast path, exact unless an
+ *     operand lane is exponent 255; cflts/cfltu: spu__cflt[su]_x, exact
+ *     unless the operand has an exponent-255 lane. Such an operand is a float
+ *     result of the window (a leaf already bounds it below 0x7F7FFFFF) or is
+ *     checked once, spu_wchk = x & 0x7F800000 (max == 0x7F800000: exponent
+ *     255) in a second tree.
+ *   - shufb_k: the guard (control ^ literal) of each distinct (control,
+ *     literal) pair is ORed together; nonzero means the generic path.
+ *   - the +0 that turns a -0 result into the SPU's +0 is skipped
+ *     (spu_w<op>_r) for a result that is not committed and is read only by
+ *     float ops, float compares and float->int conversions of the window:
+ *     with a -0 instead of a +0 those give the same leaf and the same bits
+ *     but a zero sign of their own result (fa/fs/fm/fma: a zero operand
+ *     changes no nonzero result; fcgt/fceq under DAZ: -0 == +0; cflts/cfltu:
+ *     0), and a result of that kind is itself either normalized or read only
+ *     by such ops. The same holds for a denormal in place of the +0: clang
+ *     folds x*1, x-0, x+(-0) to x, so a raw result can be a denormal operand
+ *     passed through where the statement's +0 flushed it -- and every reader
+ *     above runs under DAZ, which reads it as a zero of its sign.
+ *   - the fast copy runs only when the local-store gate is clear (the loads
+ *     then are spu_ls_rd's ungated path) and the function invocation has
+ *     failed fewer than g_spu_win_tries (spu_drain.c, env SPU_WINDOWS, 4 by
+ *     default) fast attempts: code whose operands keep leaving the fast paths
+ *     (Newton steps on zero lanes) stops paying for the attempt. (With the
+ *     fast copies not taken, the statements may run slower than in a build
+ *     without windows: SPU_WINDOWS=0 is no speed baseline, see spu_drain.c.)
+ * The forms need SPU_HELPERS_FP_RZDAZ (the result tests are the RZDAZ ones)
+ * and FMA3; elsewhere, or with -DSPU_WIN_ENABLE=0, the fast copies compile
+ * out and every window is its statements. Failed attempts reach
+ * SPU_HELPERS_SLOW_HOOK("window"). */
+#ifndef SPU_WIN_ENABLE
+#  if SPU_SIMD_X86 && defined(SPU_HELPERS_FP_RZDAZ) && defined(__AVX2__) && defined(__FMA__) && \
+      (defined(__clang__) || defined(__GNUC__))
+#    define SPU_WIN_ENABLE 1
+#  else
+#    define SPU_WIN_ENABLE 0
+#  endif
+#endif
+#if SPU_WIN_ENABLE
+extern int g_spu_win_tries;
+#  ifndef SPU_WIN_ON      /* (test builds may redefine these two) */
+#    define SPU_WIN_ON(gate, n) (((gate) == 0) & ((n) > 0))
+#  endif
+#  ifndef SPU_WIN_OK
+#    define SPU_WIN_OK(r, o, x) __builtin_expect(spu_w_ok((r), (o), (x)), 1)
+#  endif
+#  define SPU_WIN_FAILED(n)   do { SPU_HELPERS_SLOW_HOOK("window"); (n)--; } while (0)
+#  define SPU__W_OPAQUE(v)    __asm__("" : "+x"(v))
+SPU_FORCEINLINE u128 spu_wls_rd(const uint8_t* ls, uint32_t lsa) {
+    return spu_ls_load_be(ls + (lsa & (SPU_LS_MASK & ~0xFu)));
+}
+SPU_FORCEINLINE __m128i spu__wnorm(__m128 f) { SPU__W_OPAQUE(f); return spu__i(_mm_add_ps(f, _mm_setzero_ps())); }
+#  define SPU__WF2(name, op)                                                            \
+SPU_FORCEINLINE u128 spu_w##name(u128 a, u128 b, __m128i* leaf) {                       \
+    __m128 x_ = spu__f(spu__v(a)); SPU__W_OPAQUE(x_);                                   \
+    const __m128 f_ = op(x_, spu__f(spu__v(b)));                                        \
+    *leaf = _mm_slli_epi32(spu__i(f_), 1);                                              \
+    return spu__u(spu__wnorm(f_)); }                                                    \
+SPU_FORCEINLINE u128 spu_w##name##_r(u128 a, u128 b, __m128i* leaf) {                   \
+    __m128 x_ = spu__f(spu__v(a)); SPU__W_OPAQUE(x_);                                   \
+    const __m128 f_ = op(x_, spu__f(spu__v(b)));                                        \
+    *leaf = _mm_slli_epi32(spu__i(f_), 1);                                              \
+    return spu__u(spu__i(f_)); }
