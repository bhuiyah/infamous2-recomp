+      CHECK(!ss_rec_diff(a, bad), "precise is skipped like the fidelity check skips it");
+      /* the image is not trusted: refused by name, nothing written */
+      const uint32_t ep = rsx_report_tex_epoch();
+      memcpy(bad, a, rn);
+      *(int32_t*)ss_rec_field(bad, "nwr") = 33;
+      *(uint32_t*)ss_rec_field(bad, "tex_epoch") = ep + 100u;
+      why[0] = 0;
+      CHECK(rsx_report_ss_validate(bad, why, sizeof why) == 1 && strstr(why, "rsx_report.nwr: 33"), "'%s'", why);
+      CHECK(rsx_report_ss_restore(bad, why, sizeof why) == 1 && rsx_report_tex_epoch() == ep,
+            "a refused record writes nothing");
+      memcpy(bad, a, rn);
+      *(int32_t*)ss_rec_field(bad, "zp_counted") = 2;
+      why[0] = 0;
+      CHECK(rsx_report_ss_validate(bad, why, sizeof why) == 1 && strstr(why, "zp_counted"), "'%s'", why); }
+
+    /* 18. PF6 REPORT_GPU (the default) with a backend that can compose: the sun glow's ten consumers are
+     * planned -- nothing measured or written there --, each plan's rows are the two records as the old
+     * delivery would have written them at that draw (the compose, modelled, gives the old values), and
+     * the reports are owed: the walker stop writes all twenty, one measurement, FIFO order. */
+    { uint32_t want[10][2], got[10][2], ts[2] = {0, 0};
+      int planned = 0, rows_ok = 1;
+      fresh();
+      rsx_report_backend be = { fake_measure, fake_break, NULL, fake_draw_reads, fake_plan_ok };
+      rsx_report_set_backend(&be);
+      s_plan_ok = 1; s_plan_ok_calls = 0;
+      rsx_state cons;
+      memset(&cons, 0, sizeof cons);
+      m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
+      for (int L = 0; L < 10; L++) {
+          s_reads_known = 1; s_reads_mask = 0u;            /* the box program samples nothing */
+          m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+          rsx_report_begin(&cons); draw(100u + (uint32_t)L);
+          m(RSX_M_GET_REPORT, (1u << 24) | 0x14080u);
+          m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+          m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+          rsx_report_begin(&cons); draw(900u + (uint32_t)L);
+          m(RSX_M_GET_REPORT, (1u << 24) | 0x14090u);
+          m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+          bind_report_texture(&cons, 0x14080u);
+          s_reads_mask = 1u;                               /* the consumer samples unit 0 */
+          rsx_report_begin(&cons);
+          uint32_t first = 0;
+          if (rsx_report_unit_plans(&first) == 1u) planned++;
+          rsx_rplan_row rows[4]; uint32_t ea = 0, fmt = 0;
+          const int h = rsx_report_plan_rows(first, rows, &ea, &fmt);
+          if (h != 2 || ea != 0x40414080u || fmt != 0xF5u || rows[0].mode || rows[1].mode || rows[1].w[3]) rows_ok = 0;
+          got[L][0] = compose_row(&rows[0]); got[L][1] = compose_row(&rows[1]);
+          want[L][0] = 100u + (uint32_t)L; want[L][1] = 900u + (uint32_t)L;
+          ts[0] = rows[1].w[0]; ts[1] = rows[1].w[1];
+      }
+      CHECK(planned == 10 && rows_ok, "REPORT_GPU: 10 consumers planned (%d), rows as the records (%d)", planned, rows_ok);
+      CHECK(s_measures == 0 && rsx_report_pending() == 20 && rd(0x40414080u, 2) == 0u,
+            "REPORT_GPU: no measurement, 20 pending, memory untouched (%d, %d)", s_measures, rsx_report_pending());
+      CHECK(!memcmp(got, want, sizeof got), "REPORT_GPU: composed = the old delivery's values (light 10: %u %u)",
+            got[9][0], got[9][1]);
+      CHECK(s_plan_ok_calls == 10, "plan_ok asked once a consumer (%d)", s_plan_ok_calls);
+      rsx_report_idle("walker stop");
+      CHECK(rsx_report_pending() == 0 && s_measures == 1 && rd(0x40414080u, 2) == 109u && rd(0x40414090u, 2) == 909u,
+            "REPORT_GPU: owed, delivered at the walker stop with one measurement (%d): %u %u", s_measures,
+            rd(0x40414080u, 2), rd(0x40414090u, 2));
+      CHECK(rd(0x40414090u, 0) == ts[0] && rd(0x40414090u, 1) == ts[1], "the last plan's timer is the record's"); }
+
+    /* 19. A plan whose report is delivered before its compose (a label in between) carries the written
+     * value; a row with nothing pending carries the words memory held at the draw. Plans die with the
+     * replay of their records, except the latest BEGIN's (a record carried into the next batch). */
+    { fresh();
+      rsx_report_backend be = { fake_measure, fake_break, NULL, fake_draw_reads, fake_plan_ok };
+      rsx_report_set_backend(&be);
+      s_plan_ok = 1; s_reads_known = 1; s_reads_mask = 1u;
+      rsx_state cons; bind_report_texture(&cons, 0x14080u);
+      m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
+      vm_write32(0x40414090u, 0x11111111u); vm_write32(0x40414094u, 0x22222222u);
+      vm_write32(0x40414098u, 0x33333333u); vm_write32(0x4041409Cu, 0x44444444u);
+      m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+      draw(321);
+      m(RSX_M_GET_REPORT, (1u << 24) | 0x14080u);
+      m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+      rsx_report_begin(&cons);
+      uint32_t first = 0;
+      CHECK(rsx_report_unit_plans(&first) == 1u && s_measures == 0, "one record pending: planned");
+      rsx_rplan_row rows[4]; uint32_t ea = 0, fmt = 0;
+      int h = rsx_report_plan_rows(first, rows, &ea, &fmt);
+      CHECK(h == 2 && rows[0].mode == 0 && compose_row(&rows[0]) == 321u && rows[1].mode == 2 &&
+            rows[1].w[0] == 0x11111111u && rows[1].w[3] == 0x44444444u,
+            "row 0 the pending report, row 1 memory's words (modes %u %u)", rows[0].mode, rows[1].mode);
+      vm_write32(0x40414090u, 0x55555555u);                /* memory after the draw: not what it read */
+      rsx_report_sync("label");
+      h = rsx_report_plan_rows(first, rows, &ea, &fmt);
+      CHECK(h == 2 && rows[0].mode == 1 && rows[0].w[2] == 321u && rows[0].w[0] == rd(0x40414080u, 0) &&
+            rows[0].w[1] == rd(0x40414080u, 1) && rows[1].w[0] == 0x11111111u,
+            "delivered first: the row carries the written record (%u); row 1 as at the draw", rows[0].w[2]);
+      rsx_report_plans_replayed();
+      CHECK(rsx_report_plan_info(first, NULL, NULL) == 2, "the latest BEGIN's plan lives through a replay");
+      memset(&cons, 0, sizeof cons);
+      rsx_report_begin(&cons);
+      rsx_report_plans_replayed();
+      CHECK(rsx_report_plan_info(first, NULL, NULL) == 0 && rsx_report_plan_rows(first, rows, &ea, &fmt) == 0,
+            "dead after the next BEGIN's replay"); }
+
+    /* 20. What cannot be planned takes the old delivery, measured at the consumer: no plan_ok, plan_ok
+     * says no, a draw the backend cannot judge, another shape, a report only partly in a row; and
+     * REPORT_GPU=0, the kill switch. */
+    { static const char* const names[6] = { "no plan_ok", "plan_ok 0", "route unknown", "8x2 texture",
+                                            "report straddling a row", "REPORT_GPU=0" };
+      for (int arm = 0; arm < 6; arm++) {
+          if (arm == 5) env("REPORT_GPU=0");
+          fresh();
+          rsx_report_backend be = { fake_measure, fake_break, NULL, fake_draw_reads, arm == 0 ? NULL : fake_plan_ok };
+          rsx_report_set_backend(&be);
+          s_plan_ok = arm != 1; s_reads_known = arm != 2; s_reads_mask = 1u;
+          rsx_state cons; bind_report_texture(&cons, 0x14080u);
+          if (arm == 3) cons.textures[0].image_rect = (8u << 16) | 2u;
+          m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
+          m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+          draw(55);
+          m(RSX_M_GET_REPORT, (1u << 24) | (arm == 4 ? 0x14088u : 0x14080u));
+          m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+          rsx_report_begin(&cons);
+          CHECK(rsx_report_unit_plans(NULL) == 0 && rsx_report_pending() == 0 && s_measures == 1,
+                "%s: delivered at the consumer as before (pending %d, measures %d)", names[arm],
+                rsx_report_pending(), s_measures);
+          if (arm == 5) { CHECK(!rsx_report_gpu_on(), "REPORT_GPU=0: off"); env("REPORT_GPU=1"); }
+      } }
+
+    /* 21. A 2D-engine operation lets owed reports land first; a later report stays pending, as at a walker
+     * stop; with nothing owed it does nothing. A load (teardown) drops every plan. */
+    { fresh();
+      rsx_report_backend be = { fake_measure, fake_break, NULL, fake_draw_reads, fake_plan_ok };
+      rsx_report_set_backend(&be);
+      s_plan_ok = 1; s_reads_known = 1; s_reads_mask = 1u;
+      rsx_state cons; bind_report_texture(&cons, 0x14080u);
+      m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
+      m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+      draw(7);
+      m(RSX_M_GET_REPORT, (1u << 24) | 0x14080u);
+      m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+      rsx_report_engine2d("2D engine");
+      CHECK(rsx_report_pending() == 1 && s_measures == 0, "nothing owed: the 2D engine delivers nothing");
+      rsx_report_begin(&cons);
+      uint32_t first = 0;
+      CHECK(rsx_report_unit_plans(&first) == 1u, "planned: owed");
+      m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+      draw(8);
+      m(RSX_M_GET_REPORT, (1u << 24) | 0x140A0u);
+      m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+      rsx_report_engine2d("2D engine");
+      CHECK(rsx_report_pending() == 1 && rd(0x40414080u, 2) == 7u && s_measures == 1 && rd(0x404140A0u, 2) == 0u,
+            "owed: written at the 2D engine (%u); the later report pending (%d)", rd(0x40414080u, 2),
+            rsx_report_pending());
+      bind_report_texture(&cons, 0x140A0u);
+      rsx_report_begin(&cons);
+      CHECK(rsx_report_unit_plans(&first) == 1u, "the later report's consumer: planned");
+      rsx_report_ss_teardown();
+      CHECK(rsx_report_unit_plans(NULL) == 0 && rsx_report_plan_info(first, NULL, NULL) == 0 && !rsx_report_pending(),
+            "a load drops every plan and pending report"); }
+
+    /* 22. REPORT_GPU_VERIFY's tables: the value the GPU composed is compared with the value the delivery
+     * writes, whichever comes first. */
+    { env("REPORT_GPU_VERIFY=1"); fresh();
+      rsx_report_backend be = { fake_measure, fake_break, NULL, fake_draw_reads, fake_plan_ok };
+      rsx_report_set_backend(&be);
+      s_plan_ok = 1; s_reads_known = 1; s_reads_mask = 1u;
+      rsx_state cons; bind_report_texture(&cons, 0x14080u);
+      m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
+      for (int k = 0; k < 2; k++) {
+          m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+          draw(40u + (uint32_t)k);
+          m(RSX_M_GET_REPORT, (1u << 24) | (0x14080u + 16u * (uint32_t)k));
+          m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+      }
+      rsx_report_begin(&cons);
+      uint32_t first = 0, v = 0;
+      rsx_rplan_row rows[4]; uint32_t ea = 0, fmt = 0;
+      CHECK(rsx_report_unit_plans(&first) == 1u && rsx_report_plan_rows(first, rows, &ea, &fmt) == 2, "planned");
+      CHECK(rsx_report_seq_value(rows[0].seq, &v) == 1 && v == 0u, "pending, nothing measured yet: %u", v);
+      fake_measure(NULL, 0xFFFFFFFFu);                    /* the list ran: counts collected */
+      CHECK(rsx_report_seq_value(rows[0].seq, &v) == 1 && v == 40u, "pending, collected: %u", v);
+      rsx_report_verify_gpu_value(rows[0].seq, 40u);      /* composed right */
+      rsx_report_verify_gpu_value(rows[1].seq, 99u);      /* composed wrong */
+      unsigned long long cmp = 0, bad = 0;
+      rsx_report_verify_counts(&cmp, &bad);
+      CHECK(cmp == 0 && bad == 0, "nothing delivered yet: nothing compared");
+      rsx_report_sync("label");
+      rsx_report_verify_counts(&cmp, &bad);
+      CHECK(cmp == 2 && bad == 1, "at the delivery: 2 compared, 1 differs (%llu, %llu)", cmp, bad);
+      CHECK(rsx_report_seq_value(rows[1].seq, &v) == 2 && v == 41u, "delivered: the written value %u", v);
+      rsx_report_verify_gpu_value(rows[1].seq, 41u);      /* a later compose of a delivered report */
+      rsx_report_verify_counts(&cmp, &bad);
+      CHECK(cmp == 3 && bad == 1, "after the delivery: compared at once (%llu, %llu)", cmp, bad);
+      env("REPORT_GPU_VERIFY=0"); }
+
+    /* 23. PF6 review: plan_ok is asked with the unit and the texture's address; a violation stops NEW plans only
+     * -- a live plan still learns its report's value at the delivery, owed reports still land at the 2D engine,
+     * a new consumer delivers as before; rsx_report_deliver_complete writes the prefix whose draws are all
+     * collected, without a measurement. */
+    { fresh();
+      rsx_report_backend be = { fake_measure, fake_break, NULL, fake_draw_reads, fake_plan_ok };
+      rsx_report_set_backend(&be);
+      s_plan_ok = 1; s_reads_known = 1; s_reads_mask = 1u;
+      rsx_state cons; bind_report_texture(&cons, 0x14080u);
+      m(RSX_M_SET_CONTEXT_DMA_REPORT, RSX_DMA_HOST_BUFFER);
+      m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+      draw(31);
+      m(RSX_M_GET_REPORT, (1u << 24) | 0x14080u);
+      m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+      rsx_report_begin(&cons);
+      uint32_t first = 0;
+      CHECK(rsx_report_unit_plans(&first) == 1u && s_plan_ok_unit == 0 && s_plan_ok_ea == 0x40414080u,
+            "plan_ok asked for unit 0 at the texture's address (%d, 0x%08X)", s_plan_ok_unit, s_plan_ok_ea);
+      rsx_report_plan_violation("test");
+      rsx_report_engine2d("2D engine");
+      CHECK(rsx_report_pending() == 0 && rd(0x40414080u, 2) == 31u, "after a violation: the owed report still lands at"
+            " the 2D engine (%u)", rd(0x40414080u, 2));
+      rsx_rplan_row rows[4]; uint32_t ea = 0, fmt = 0;
+      CHECK(rsx_report_plan_rows(first, rows, &ea, &fmt) == 2 && rows[0].mode == 1 && rows[0].w[2] == 31u,
+            "after a violation: the live plan carries the written value");
+      m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+      draw(5);
+      m(RSX_M_GET_REPORT, (1u << 24) | 0x14080u);
+      m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+      const int m0 = s_measures;
+      rsx_report_begin(&cons);
+      CHECK(rsx_report_unit_plans(NULL) == 0 && rsx_report_pending() == 0 && s_measures == m0 + 1 &&
+            rd(0x40414080u, 2) == 5u, "after a violation: a new consumer delivers as before");
+      /* deliver_complete: A's draw collected, B's not yet run */
+      m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+      draw(7);
+      m(RSX_M_GET_REPORT, (1u << 24) | 0x14100u);                  /* A */
+      m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+      fake_measure(NULL, 0xFFFFFFFFu);                             /* A's list ran */
+      m(RSX_M_CLEAR_REPORT_VALUE, 1); m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 1);
+      draw(9);
+      m(RSX_M_GET_REPORT, (1u << 24) | 0x14110u);                  /* B */
+      m(RSX_M_ZPASS_PIXEL_COUNT_ENABLE, 0);
+      const int m1 = s_measures;
+      CHECK(rsx_report_pending_overlap(0x40414100u, 32u) && !rsx_report_pending_overlap(0x40414120u, 16u),
+            "pending_overlap");
+      CHECK(rsx_report_deliver_complete(s_draws[s_ndraws - 1].seg, "test") == 1 && rsx_report_pending() == 1 &&
+            s_measures == m1 && rd(0x40414100u, 2) == 7u && rd(0x40414110u, 2) == 0u,
+            "deliver_complete: A written without a measurement, B (its draw not run) pending");
+      rsx_report_sync("label");
+      CHECK(rsx_report_pending() == 0 && rd(0x40414110u, 2) == 9u, "B at the label: %u", rd(0x40414110u, 2)); }
+
+    CHECK(s_bad_access == 0, "no access outside the fake windows (%u)", s_bad_access);
+    printf("test_rsx_report: %d passed, %d failed\n", s_pass, s_fail);
+    return s_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_rsx_report_fifo.c b/libs/video/tests/test_rsx_report_fifo.c
new file mode 100644
index 0000000..c76aa98
--- /dev/null
+++ b/libs/video/tests/test_rsx_report_fifo.c
@@ -0,0 +1,160 @@
+/*
+ * ps3recomp - reports through the method decoder (rsx_commands.c + rsx_report.c):
+ * the hooks in rsx_process_method, SET_BEGIN_END and the draw methods.
+ *
+ *   A  inFamous 2's query pair as the FIFO carries it (0x1A8 = 0xFEED0001,
+ *      CLEAR_REPORT_VALUE 1, ZPASS enable, an immediate-mode box, GET_REPORT,
+ *      ZPASS disable), then the consumer: texture unit 0 set to the records
+ *      (TEXTURE_OFFSET/FORMAT/CONTROL0/IMAGE_RECT/CONTROL3 as func_00131924
+ *      builds them) and a BEGIN -- the records are in memory before the draw.
+ *   B  a back-end label write (0x1D6C/0x1D70) and SET_REFERENCE deliver the
+ *      reports before them.
+ *   C  RENDER_ENABLE 0x02000000 | offset drops the draws (immediate-mode and
+ *      DRAW_ARRAYS) while that report is 0; 0x01000000 draws again.
+ *   D  INVALIDATE_TEXTURE_CACHE (0x1FD8) moves the texture-cache epoch.
+ * The backend counts each draw as (vertex count x 10) samples.
+ *
+ * Build (clang-cl, from libs/video/tests):
+ *   clang-cl -O2 -msse4.1 -I.. -I../../../include test_rsx_report_fifo.c ../rsx_commands.c
+ *            ../rsx_vertex_fetch.c ../rsx_report.c -Fe:test_rsx_report_fifo.exe
+ */
+#include "rsx_commands.h"
+#include "rsx_report.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* --- the runtime pieces rsx_commands.c / rsx_report.c link against --------- */
+uint8_t* vm_base;
+uint32_t ppu_hle_inject_base = 0x20000000u;
+void ps3_ms(const char* key) { (void)key; }
+#define MEM 0x00400000u                   /* host-backed EAs [0, 4 MB) */
+#define EA_IO 0x00100000u                 /* IO offset 0 */
+#define EA_LOCAL 0x00300000u              /* RSX local memory (imm scratch etc.) */
+static uint8_t* p8(uint64_t a) { a &= 0xFFFFFFFFu; return a + 4 <= MEM ? vm_base + a : NULL; }
+void vm_write32(uint64_t a, uint32_t v)
+{
+    uint8_t* p = p8(a);
+    if (p) { p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v; }
+}
+uint32_t vm_read32(uint64_t a)
+{
+    const uint8_t* p = p8(a);
+    return p ? ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3] : 0u;
+}
+u32 cellGcmResolveIO(u32 io) { return io < 0x100000u ? EA_IO + io : 0u; }
+u32 cellGcmResolveLocated(int local, u32 off) { return local ? EA_LOCAL + (off & 0xFFFFFu) : cellGcmResolveIO(off); }
+u32 cellGcmResolveOffset(u32 off) { return cellGcmResolveLocated(1, off); }
+/* WAIT_EVENTS (runtime/syscalls/wait_events.h): rsx_commands.c's label writes
+ * call wev_note; off here. Unused where rsx_commands.c predates it. */
+volatile uint32_t g_wev_on, g_wev_any;
+void wev_poke(uint32_t src, uint32_t ea, uint32_t size) { (void)src; (void)ea; (void)size; }
+
+static int s_pass, s_fail;
+#define CHECK(c, ...) do { if (c) s_pass++; else { s_fail++; printf("[FAIL] line %d: ", __LINE__); \
+                           printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+/* --- the backend: records each draw's segment; measure "runs" them --------- */
+typedef struct { uint32_t seg; uint64_t samples; int done; } Rec;
+static Rec s_rec[64]; static int s_nrec, s_ndraws, s_measures;
+static void be_draw_arrays(void* ud, u32 prim, u32 first, u32 count)
+{
+    (void)ud; (void)prim; (void)first;
+    s_ndraws++;
+    const uint32_t seg = rsx_report_draw_tag();          /* as vp_record_cb does */
+    if (seg && s_nrec < 64) { s_rec[s_nrec].seg = seg; s_rec[s_nrec].samples = (uint64_t)count * 10u;
+                              s_rec[s_nrec].done = 0; s_nrec++; }
+}
+static int be_measure(void* ud, uint32_t seg_hi)
+{
+    (void)ud; s_measures++;
+    for (int i = 0; i < s_nrec; i++)
+        if (!s_rec[i].done && s_rec[i].seg <= seg_hi) { rsx_report_add_samples(s_rec[i].seg, s_rec[i].samples); s_rec[i].done = 1; }
+    return 1;
+}
+
+static rsx_backend g_be;
+static rsx_state   g_state;
+static void m(u32 method, u32 data) { rsx_process_method(&g_state, method, data); }
+static u32 fbits(float f) { u32 u; memcpy(&u, &f, 4); return u; }
+
+/* An immediate-mode primitive of n vertices (SET_VERTEX_DATA4F_M attribute 0). */
+static void imm_box(int n)
+{
+    m(0x1808u, 5u);                                       /* BEGIN triangles */
+    for (int v = 0; v < n; v++)
+        for (int w = 0; w < 4; w++) m(0x1C00u + 4u * (u32)w, fbits((float)(v + w)));
+    m(0x1808u, 0u);                                       /* END: the draw */
+}
+static void query(u32 offset, int n)                       /* func_00131A80 */
+{
+    m(0x17C8u, 1u); m(0x17CCu, 1u);
+    imm_box(n);
+    m(0x1800u, (1u << 24) | offset);
+    m(0x17CCu, 0u);
+}
+
+int main(void)
+{
+    vm_base = (uint8_t*)calloc(1, MEM);
+#ifdef _WIN32
+    _putenv("REPORT_LOG=0");
+#else
+    putenv((char*)"REPORT_LOG=0");
+#endif
+    rsx_state_init(&g_state);
+    g_be.draw_arrays = be_draw_arrays;
+    rsx_set_backend(&g_be);
+    rsx_report_reset();
+    { rsx_report_backend rb = { be_measure, NULL, NULL }; rsx_report_set_backend(&rb); }
+
+    /* A */
+    m(0x01A8u, 0xFEED0001u);
+    query(0x14080u, 36);
+    query(0x14090u, 12);
+    CHECK(s_ndraws == 2 && s_nrec == 2, "two counted draws (%d, %d)", s_ndraws, s_nrec);
+    CHECK(rsx_report_pending() == 2 && vm_read32(EA_IO + 0x14088u) == 0u, "pending, memory untouched");
+    m(0x1A00u, 0x14080u);                                 /* unit 0: offset */
+    m(0x1A04u, 0x0001F52Au);                              /* format: main, Y16_X16 | LN | UN */
+    m(0x1A0Cu, 0x80078000u);                              /* control0: enabled */
+    m(0x1A18u, (4u << 16) | 2u);                          /* image rect 4x2 */
+    m(0x1840u, (1u << 20) | 16u);                         /* control3: pitch 16 */
+    m(0x1808u, 5u);                                       /* the consumer's BEGIN */
+    CHECK(rsx_report_pending() == 0 && s_measures == 1, "consumer BEGIN delivered both (measures %d)", s_measures);
+    CHECK(vm_read32(EA_IO + 0x14088u) == 360u && vm_read32(EA_IO + 0x14098u) == 120u,
+          "values %u / %u, want 360 / 120", vm_read32(EA_IO + 0x14088u), vm_read32(EA_IO + 0x14098u));
+    m(0x1808u, 0u);
+    m(0x1A0Cu, 0u);                                       /* unit 0 off again */
+
+    /* B */
+    query(0x200u, 3);
+    CHECK(rsx_report_pending() == 1, "pending before the label");
+    m(0x1D6Cu, 0x40u); m(0x1D70u, 1u);                    /* back-end label */
+    CHECK(rsx_report_pending() == 0 && vm_read32(EA_IO + 0x208u) == 30u, "label write delivered (%u)",
+          vm_read32(EA_IO + 0x208u));
+    query(0x210u, 6);
+    m(0x0050u, 7u);                                       /* SET_REFERENCE */
+    CHECK(rsx_report_pending() == 0 && vm_read32(EA_IO + 0x218u) == 60u, "reference delivered");
+
+    /* C */
+    m(0x17C8u, 1u); m(0x17CCu, 1u);
+    m(0x1800u, (1u << 24) | 0x300u);                      /* nothing drawn: 0 */
+    m(0x17CCu, 0u);
+    m(0x1E98u, 0x02000000u | 0x300u);
+    const int before = s_ndraws;
+    imm_box(3);
+    m(0x1808u, 5u); m(0x1814u, (2u << 24) | 0u); m(0x1808u, 0u);   /* DRAW_ARRAYS 3 */
+    CHECK(s_ndraws == before, "RENDER_ENABLE on a 0 report: draws dropped (%d)", s_ndraws - before);
+    m(0x1E98u, 0x01000000u);
+    imm_box(3);
+    CHECK(s_ndraws == before + 1, "RENDER_ENABLE 0x01000000: drawn");
+
+    /* D */
+    { const u32 e = rsx_report_tex_epoch(); m(0x1FD8u, 1u);
+      CHECK(rsx_report_tex_epoch() == e + 1u, "0x1FD8 epoch"); }
+
+    printf("test_rsx_report_fifo: %d passed, %d failed\n", s_pass, s_fail);
+    return s_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_rthread.c b/libs/video/tests/test_rthread.c
new file mode 100644
index 0000000..3c827d9
--- /dev/null
+++ b/libs/video/tests/test_rthread.c
@@ -0,0 +1,181 @@
+/* test_rthread.c -- R1's render-thread hand-off (rsx_rthread.h) under stress, the backend's pattern:
+ *   the producer fills a packet and one of two record buffers, kicks, then writes the next batch into the OTHER
+ *   buffer while the job reads its own; it drains before it reads the job's results or touches the job's buffer.
+ * Checks: every kick runs exactly one job; jobs never overlap; a job sees exactly the packet and records written
+ * before its kick; its buffer does not change under it; the producer sees the job's results after the drain;
+ * drains with nothing in flight return at once; stop joins and a new start works; a job that SendMessages to the
+ * producer's window is answered inside the drain (run_window). Planted faults (-DRTT_MUTANT=1:
+ * the drain does not wait; =2: the producer writes into the job's buffer; =3: the drain waits without a pump,
+ * so the window test deadlocks and its watchdog fails it) must fail.
+ *   clang-cl /nologo /O1 -I libs/video libs/video/tests/test_rthread.c
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#pragma comment(lib, "user32.lib")
+#if RTT_MUTANT == 1
+#define rtt_drain rtt_drain_real
+#endif
+#include "rsx_rthread.h"
+#if RTT_MUTANT == 1
+#undef rtt_drain
+static void rtt_drain(RtThread* t) { (void)t; }   /* planted fault: returns at once */
+#endif
+#if RTT_MUTANT == 3
+static void rtt_drain_wait(RtThread* t)   /* planted fault: the old drain, waiting without a pump */
+{
+    if (!t->th) return;
+    while (InterlockedCompareExchange(&t->busy, 0, 0)) WaitForSingleObject(t->done, INFINITE);
+}
+#define rtt_drain rtt_drain_wait
+#endif
+
+#define NREC 512
+typedef struct { unsigned seq; unsigned n; const unsigned* rec; } Packet;
+static unsigned s_buf[2][NREC];
+static Packet s_pk;
+static volatile LONG s_in_job;
+static unsigned long long s_result;       /* the job's output: the records' sum, plus seq */
+static unsigned s_seen_seq;
+static unsigned long long s_bad_overlap, s_bad_packet, s_bad_changed;
+static unsigned s_rng = 12345;
+static unsigned rnd(void) { s_rng = s_rng * 1103515245u + 12345u; return s_rng >> 8; }
+static void spin(unsigned n) { for (volatile unsigned i = 0; i < n; i++) { } }
+
+static unsigned long long sum(const unsigned* r, unsigned n)
+{
+    unsigned long long s = 0;
+    for (unsigned i = 0; i < n; i++) s = s * 31u + r[i];
+    return s;
+}
+static void job(void* arg)
+{
+    (void)arg;
+    if (InterlockedIncrement(&s_in_job) != 1) s_bad_overlap++;
+    const Packet p = s_pk;
+    /* the records are a function of the seq: the job sees what was written before the kick */
+    for (unsigned i = 0; i < p.n; i++) if (p.rec[i] != p.seq * 7919u + i) { s_bad_packet++; break; }
+    const unsigned long long a = sum(p.rec, p.n);
+    static unsigned jr = 777;                            /* the job's own random state */
+    jr = jr * 1103515245u + 12345u;
+    spin((jr >> 8) % 4000);                              /* the replay's time: the producer runs meanwhile */
+    if (sum(p.rec, p.n) != a) s_bad_changed++;           /* nobody wrote the job's buffer */
+    s_result = a + p.seq;
+    s_seen_seq = p.seq;
+    InterlockedDecrement(&s_in_job);
+}
+static int run(int rounds, int fault2)
+{
+    RtThread t; memset(&t, 0, sizeof t);
+    if (!rtt_start(&t, job, NULL, L"test", THREAD_PRIORITY_NORMAL)) { printf("FAIL: no thread\n"); return 1; }
+    int cur = 0, fails = 0;
+    unsigned long long expect = 0; unsigned prev = 0; int have_prev = 0;
+    for (int k = 1; k <= rounds; k++) {
+        rtt_drain(&t);                                     /* render_frame's start */
+        if (have_prev) {                                   /* the previous job's results */
+            if (s_seen_seq != prev || s_result != expect) fails++;
+        }
+        unsigned* rec = s_buf[cur];
+        const unsigned n = 1u + rnd() % NREC;
+        for (unsigned i = 0; i < n; i++) rec[i] = (unsigned)k * 7919u + i;   /* the prepass's last writes */
+        s_pk.seq = (unsigned)k; s_pk.n = n; s_pk.rec = rec;
+        expect = sum(rec, n) + (unsigned)k; prev = (unsigned)k; have_prev = 1;
+        rtt_kick(&t);
+        cur ^= 1;                                          /* the next batch records into the other buffer */
+        unsigned* nx = fault2 ? s_buf[cur ^ 1] : s_buf[cur];
+        const unsigned m = rnd() % NREC;
+        for (unsigned i = 0; i < m; i++) nx[i] = rnd();    /* the walker records meanwhile */
+        if ((rnd() & 63u) == 0) rtt_drain(&t);             /* a readback / report measure: an extra drain */
+        if ((rnd() & 1023u) == 0) { rtt_drain(&t); rtt_drain(&t); }   /* drains with nothing in flight */
+    }
+    rtt_drain(&t);
+    if (s_seen_seq != prev || s_result != expect) fails++;
+    const unsigned long long jobs = t.jobs;
+    rtt_stop(&t);
+    if (jobs != (unsigned long long)rounds) { printf("jobs %llu != kicks %d\n", jobs, rounds); fails++; }
+    /* a new thread after a stop */
+    if (!rtt_start(&t, job, NULL, L"test2", THREAD_PRIORITY_NORMAL)) fails++;
+    s_pk.seq = 1; s_pk.n = 1; s_buf[0][0] = 7919u; s_pk.rec = s_buf[0];
+    rtt_kick(&t); rtt_drain(&t);
+    if (s_seen_seq != 1 || s_result != 7919ull + 1) fails++;
+    rtt_stop(&t);
+    printf("rounds %d: result mismatches %d, overlapping jobs %llu, stale packets %llu, buffers changed under a job %llu,"
+           " drains that waited %llu\n", rounds, fails, s_bad_overlap, s_bad_packet, s_bad_changed, t.n_wait);
+    return fails || s_bad_overlap || s_bad_packet || s_bad_changed;
+}
+/* The window test: the producer owns a window, and some jobs SendMessage to it and wait for the reply (a Present
+ * that talks to the window thread). Every drain must still return, each message handled once, on the producer's
+ * thread, inside the drain (never a posted message: one posted to the window before each kick stays queued). A
+ * watchdog fails the test if a drain never returns (-DRTT_MUTANT=3: the drain only waits -- it must time out). */
+static HWND s_win;
+static DWORD s_main_tid;
+static volatile LONG s_sent_handled, s_wrong_thread, s_posted_handled;
+static unsigned s_send_every;
+static LRESULT CALLBACK wproc(HWND h, UINT m, WPARAM w, LPARAM l)
+{
+    if (m == WM_APP + 1) { if (GetCurrentThreadId() != s_main_tid) s_wrong_thread++; s_sent_handled++; return 7; }
+    if (m == WM_APP + 2) { s_posted_handled++; return 0; }
+    return DefWindowProcW(h, m, w, l);
+}
+static volatile LONG s_send_bad;
+static void send_job(void* arg)
+{
+    (void)arg;
+    static unsigned k = 0;
+    if (++k % s_send_every == 0) {
+        if (SendMessageW(s_win, WM_APP + 1, 0, 0) != 7) s_send_bad++;
+    } else spin(2000);
+}
+static DWORD WINAPI watchdog(LPVOID p)
+{
+    Sleep((DWORD)(uintptr_t)p);
+    printf("FAIL: a drain did not return within %lu ms (the window test)\ntest_rthread: FAIL\n",
+           (unsigned long)(uintptr_t)p);
+    fflush(stdout);
+    ExitProcess(3);
+    return 0;
+}
+static int run_window(int rounds)
+{
+    s_main_tid = GetCurrentThreadId();
+    WNDCLASSW wc; memset(&wc, 0, sizeof wc);
+    wc.lpfnWndProc = wproc; wc.hInstance = GetModuleHandleW(NULL); wc.lpszClassName = L"rtt_test";
+    RegisterClassW(&wc);
+    s_win = CreateWindowExW(0, L"rtt_test", L"", 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, wc.hInstance, NULL);
+    if (!s_win) { printf("FAIL: no window\n"); return 1; }
+    RtThread t; memset(&t, 0, sizeof t);
+    if (!rtt_start(&t, send_job, NULL, L"test-window", THREAD_PRIORITY_NORMAL)) { printf("FAIL: no thread\n"); return 1; }
+    HANDLE wd = CreateThread(NULL, 0, watchdog, (LPVOID)(uintptr_t)60000, 0, NULL);
+    s_send_every = 25;
+    int posted = 0;
+    for (int k = 1; k <= rounds; k++) {
+        if (PostMessageW(s_win, WM_APP + 2, 0, 0)) posted++;   /* input the drain must leave queued */
+        rtt_kick(&t);
+        rtt_drain(&t);
+    }
+    const unsigned long long jobs = t.jobs, pumped = t.n_pumped;
+    rtt_stop(&t);
+    TerminateThread(wd, 0); CloseHandle(wd);
+    const LONG sent = s_sent_handled, posted_in_drain = s_posted_handled;
+    MSG m; while (PeekMessageW(&m, NULL, 0, 0, PM_REMOVE)) DispatchMessageW(&m);   /* the producer's own pump */
+    const int expect_sent = rounds / (int)s_send_every;
+    const int fails = (jobs != (unsigned long long)rounds) + (sent != expect_sent) + (s_wrong_thread != 0) +
+                      (s_send_bad != 0) + (posted_in_drain != 0) + (s_posted_handled != posted) + (pumped == 0);
+    printf("window: rounds %d, jobs %llu, sent messages handled %ld of %d (wrong thread %ld, bad replies %ld), posted"
+           " messages handled inside drains %ld (later %ld of %d), drains that pumped %llu\n", rounds, jobs, sent,
+           expect_sent, s_wrong_thread, s_send_bad, posted_in_drain, s_posted_handled, posted, pumped);
+    DestroyWindow(s_win);
+    return fails;
+}
+int main(void)
+{
+#if RTT_MUTANT == 2
+    const int f2 = 1;
+#else
+    const int f2 = 0;
+#endif
+    int bad = run(200000, f2);
+    bad |= run_window(200);
+    printf(bad ? "test_rthread: FAIL\n" : "test_rthread: all passed\n");
+    return bad;
+}
diff --git a/libs/video/tests/test_tex_cache_rsx.c b/libs/video/tests/test_tex_cache_rsx.c
new file mode 100644
index 0000000..312eece
--- /dev/null
+++ b/libs/video/tests/test_tex_cache_rsx.c
@@ -0,0 +1,413 @@
+/*
+ * ps3recomp - PF3 TEX_WW_RSX (rsx_tex_cache.h): pages the RSX's own copies
+ * write are left dirty, on a real write-watched arena, without a GPU.
+ *
+ * A "texture" slot over 32 pages is tracked and validated every round the way
+ * vp_upload_tex_slot does (clean by the write watch, else re-hashed). Frames of
+ * 5 rounds: an "RSX copy" rewrites the span once a frame and notes it
+ * (tc_wt_rsx_write), and other writes land between rounds on one page of it.
+ * Checked: no clean validation ever holds bytes that differ from the ones
+ * hashed (the cache's invariant: every write after a read is seen), with the
+ * rule on and off; with the rule on the copied pages stop being reset (no fault
+ * per copy) while the copies go on, and are reset again once they stop.
+ * Single-threaded: the other writes land between rounds. A write by another
+ * thread racing the harvest (between GetWriteWatch and ResetWriteWatch) is
+ * caught because the harvest marks the page's slots dirty before it resets it;
+ * the PF3 review's probe (pf3/review/ww_race2.c, a writer thread, 300k rounds,
+ * the rule on and off) missed none after a quiescent point.
+ *
+ * TX1 (TEX_FENCE): a writer THREAD released by a fence (inFamous 2's water job,
+ * released by the frame's SET_REFERENCE) rewrites a texture whose draws came
+ * before the fence, before their batch is validated. With the rule the batch is
+ * judged by the fence's harvest (tc_wt_fence_harvest / tc_wt_fence_current):
+ * every bind holds the bytes at the fence; without it (a harvest at the
+ * replay) every bind of the frames where the write lands first holds the new
+ * bytes. Either way the next batch (draws after the fence) sees the write: no
+ * write is missed. Some frames the writer goes before the fence instead (a
+ * write the draws are unordered with): the fence's harvest sees it.
+ * The capture case: the texture is also written before the fence, after it was
+ * last read (inFamous 2's water map in a frame whose only water draws are in
+ * its last batch; or a page the hot rule leaves dirty after a loading screen),
+ * so the replay must read it again -- after the writer the fence released. The
+ * backend copies such a slot's bytes at the fence (tex_fence_capture) and the
+ * replay reads the copy: every bind holds the bytes at the fence; reading the
+ * guest memory instead, every one holds the later write.
+ * The watched case: a large slot written before the fence is not copied; the
+ * fence's harvest reset its pages, so at the replay tc_wt_written_now must say
+ * whether something wrote it since -- and when nothing did, the guest memory
+ * must hold the bytes at the fence.
+ * The fence's state (TX1 review): the helpers the backend calls (tc_fz_open,
+ * tc_fz_judge, tc_fz_mark, tc_fz_active, tc_fz_protected, tc_fz_forget). A
+ * fence that lapses -- a record after it, or a harvest since -- takes its
+ * marks with it (the replay reads no copy of it); a slot the fence copied,
+ * watches or hashed is not the eviction victim while its batch's prepass runs
+ * unless nothing else is free (lru_pick: the backend's tc_alloc_slot choice);
+ * a hot slot (left dirty by every harvest) over the copy cap, reset at the
+ * fence (tc_wt_reset_span), is watched like any other.
+ *
+ * From external/ps3recomp:
+ *   clang-cl /nologo /O1 -I libs/video libs/video/tests/test_tex_cache_rsx.c /Fe:T/test_tex_cache_rsx.exe
+ */
+#include "rsx_tex_cache.h"
+
+static int s_fail;
+#define CHECK(c, ...) do { if (!(c)) { s_fail++; printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+typedef struct { uint32_t off, len, vround; uint64_t hash; } slot_t;
+
+/* one scenario; returns the resets of the span's pages counted over the copy frames */
+static uint32_t scenario(int rule_on, uint32_t frames_copying, uint32_t frames_after)
+{
+    _putenv(rule_on ? "TEX_WW_RSX=1" : "TEX_WW_RSX=0");
+    const SIZE_T G = (SIZE_T)256 << 20;
+    uint8_t* a = (uint8_t*)VirtualAlloc(NULL, G, MEM_RESERVE | MEM_WRITE_WATCH, PAGE_READWRITE);
+    CHECK(a != NULL, "reserve");
+    if (!a) return 0;
+    VirtualAlloc(a, G, MEM_COMMIT, PAGE_READWRITE);
+    memset(&s_tcw, 0, sizeof s_tcw);
+    CHECK(tc_wt_init(a, 1) == 1, "tc_wt_init: write watch on the arena");
+    CHECK(rule_on ? s_tcw.rsx_round != NULL : s_tcw.rsx_round == NULL, "TEX_WW_RSX switch");
+    slot_t t = { 0x01000000u, 32u * 4096u, 0, 0 };
+    tc_wt_track(t.off, t.len);
+    t.hash = tc_hash64(a + t.off, t.len); t.vround = s_tcw.round;
+    uint32_t stale = 0, clean = 0, rehash = 0, resets_copying = 0, reported_late = 0, seed = 12345u;
+    const uint32_t p0 = t.off >> TC_PAGE_SHIFT;
+    for (uint32_t f = 0; f < frames_copying + frames_after; f++) {
+        for (uint32_t k = 0; k < 5; k++) {
+            const uint32_t res0 = s_tcw.resets, dt0 = s_tcw.dirty_tracked;
+            const uint32_t r = tc_wt_round_begin();
+            if (f < frames_copying) resets_copying += s_tcw.resets - res0;
+            if (f >= frames_copying + 15 && k == 4) reported_late += s_tcw.dirty_tracked - dt0;
+            /* validate (vp_upload_tex_slot's write-watch path) */
+            if (!tc_wt_dirty_since(t.off, t.len, t.vround)) {
+                clean++;
+                if (tc_hash64(a + t.off, t.len) != t.hash) stale++;
+            } else {
+                rehash++;
+                t.hash = tc_hash64(a + t.off, t.len); t.vround = r;
+            }
+            /* between rounds: the RSX copy once a frame, other writers now and then */
+            if (k == 1 && f < frames_copying) {
+                memset(a + t.off, (int)(f & 0xFF), t.len);
+                tc_wt_rsx_write(t.off, t.len);
+            }
+            seed = seed * 1103515245u + 12345u;
+            if ((seed >> 16) % 7u == 0) a[t.off + ((seed >> 8) % t.len)] ^= 0x5A;
+        }
+    }
+    CHECK(stale == 0, "rule %d: %u clean validations held stale bytes", rule_on, stale);
+    /* 75+ rounds after the last copy (past TC_RSX_ROUNDS and a 64-round re-arm): only the other writer's pages */
+    CHECK(reported_late <= 2u * (frames_after - 15u), "rule %d: %u pages still reported after the copies stopped",
+          rule_on, reported_late);
+    printf("rule %s: %u clean, %u re-hashed, %u stale; resets of tracked pages while copying %u; pages reported in"
+           " rounds 75+ after the copies stopped %u\n", rule_on ? "on " : "off", clean, rehash, stale,
+           resets_copying, reported_late);
+    (void)p0;
+    VirtualFree(s_tcw.gen, 0, MEM_RELEASE); free(s_tcw.hits);
+    memset(&s_tcw, 0, sizeof s_tcw);
+    VirtualFree(a, 0, MEM_RELEASE);
+    return resets_copying;
+}
+
+/* TX1: the fence case with a real writer thread. Returns the binds of records
+ * before the fence that did not hold the bytes at the fence; *missed counts
+ * binds after it (the next batch) that did not hold the bytes then. */
+typedef struct { uint8_t* a; uint32_t off, len; HANDLE go, done; volatile LONG stop; volatile LONG val; } fz_writer;
+static DWORD WINAPI fz_writer_main(LPVOID p)
+{
+    fz_writer* w = (fz_writer*)p;
+    for (;;) {
+        WaitForSingleObject(w->go, INFINITE);
+        if (w->stop) return 0;
+        memset(w->a + w->off, (int)(w->val & 0xFF), w->len);   /* the job's PUTs */
+        SetEvent(w->done);
+    }
+}
+static uint32_t fence_scenario(int rule_on, uint32_t frames, uint32_t* missed)
+{
+    const SIZE_T G = (SIZE_T)256 << 20;
+    uint8_t* a = (uint8_t*)VirtualAlloc(NULL, G, MEM_RESERVE | MEM_WRITE_WATCH, PAGE_READWRITE);
+    CHECK(a != NULL, "reserve");
+    if (!a) return 0;
+    VirtualAlloc(a, G, MEM_COMMIT, PAGE_READWRITE);
+    memset(&s_tcw, 0, sizeof s_tcw);
+    CHECK(tc_wt_init(a, 1) == 1, "tc_wt_init: write watch on the arena");
+    /* two 64x64 Y16_X16 maps with their mip chains, as the water job's */
+    slot_t t = { 0x02000000u + 0x900u, 21840u, 0, 0 };
+    tc_wt_track(t.off, t.len);
+    t.hash = tc_hash64(a + t.off, t.len); t.vround = s_tcw.round;
+    fz_writer w = { a, t.off, t.len, CreateEventA(NULL, FALSE, FALSE, NULL), CreateEventA(NULL, FALSE, FALSE, NULL), 0, 0 };
+    HANDLE th = CreateThread(NULL, 0, fz_writer_main, &w, 0, NULL);
+    uint32_t differ = 0, miss = 0, seed = 777u;
+    for (uint32_t f = 0; f < frames; f++) {
+        seed = seed * 1103515245u + 12345u;
+        const int before = (seed >> 16) % 5u == 0;     /* this frame the writer goes before the fence */
+        /* the draws are recorded (nothing to do); an unordered write may land now */
+        if (before) { w.val = (LONG)(f * 2u + 1u); SetEvent(w.go); WaitForSingleObject(w.done, INFINITE); }
+        /* the fence: the backend's tex_fence_hook with records pending */
+        uint32_t fz = 0;
+        if (rule_on) fz = tc_wt_fence_harvest();
+        const uint64_t at_fence = tc_hash64(a + t.off, t.len);
+        /* the fence is visible: the writer it releases rewrites the texture before the replay */
+        if (!before) { w.val = (LONG)(f * 2u + 2u); SetEvent(w.go); WaitForSingleObject(w.done, INFINITE); }
+        /* the replay of the batch before the fence (tc_round_ensure, then vp_upload_tex_slot) */
+        if (!(rule_on && tc_wt_fence_current(fz))) tc_wt_round_begin();
+        if (tc_wt_dirty_since(t.off, t.len, t.vround)) {
+            const uint64_t h = tc_hash64(a + t.off, t.len);
+            if (h != t.hash) { t.hash = h; }
+            t.vround = s_tcw.round;
+        }
+        if (t.hash != at_fence) differ++;
+        /* the next batch: the draws after the fence */
+        tc_wt_round_begin();
+        if (tc_wt_dirty_since(t.off, t.len, t.vround)) {
+            t.hash = tc_hash64(a + t.off, t.len); t.vround = s_tcw.round;
+        }
+        if (t.hash != tc_hash64(a + t.off, t.len)) miss++;
+    }
+    w.stop = 1; SetEvent(w.go); WaitForSingleObject(th, INFINITE);
+    CloseHandle(th); CloseHandle(w.go); CloseHandle(w.done);
+    VirtualFree(s_tcw.gen, 0, MEM_RELEASE); free(s_tcw.hits);
+    memset(&s_tcw, 0, sizeof s_tcw);
+    VirtualFree(a, 0, MEM_RELEASE);
+    *missed = miss;
+    return differ;
+}
+
+/* TX1, the capture case: a write before the fence (the slot was last read in
+ * the previous frame) and one after it, every frame; every 40 frames `warm`
+ * rounds that each see a write (a loading screen: the page goes hot).
+ * capture = the backend's tex_fence_capture. Returns the binds before the
+ * fence not holding its bytes; *copies counts the fences that copied. */
+static uint32_t fence_capture_scenario(int capture, uint32_t frames, uint32_t warm, uint32_t* copies)
+{
+    const SIZE_T G = (SIZE_T)256 << 20;
+    uint8_t* a = (uint8_t*)VirtualAlloc(NULL, G, MEM_RESERVE | MEM_WRITE_WATCH, PAGE_READWRITE);
+    CHECK(a != NULL, "reserve");
+    if (!a) return 0;
+    VirtualAlloc(a, G, MEM_COMMIT, PAGE_READWRITE);
+    memset(&s_tcw, 0, sizeof s_tcw);
+    CHECK(tc_wt_init(a, 1) == 1, "tc_wt_init: write watch on the arena");
+    slot_t t = { 0x03000000u + 0x900u, 21840u, 0, 0 };
+    tc_wt_track(t.off, t.len);
+    t.hash = tc_hash64(a + t.off, t.len); t.vround = s_tcw.round;
+    static uint8_t cap[21840];
+    fz_writer w = { a, t.off, t.len, CreateEventA(NULL, FALSE, FALSE, NULL), CreateEventA(NULL, FALSE, FALSE, NULL), 0, 0 };
+    HANDLE th = CreateThread(NULL, 0, fz_writer_main, &w, 0, NULL);
+    uint32_t differ = 0, ncap = 0, v = 1;
+    for (uint32_t f = 0; f < frames; f++) {
+        if (f % 40u == 0)                        /* a loading screen: a write before every round's harvest */
+            for (uint32_t k = 0; k < warm; k++) {
+                w.val = (LONG)v++; SetEvent(w.go); WaitForSingleObject(w.done, INFINITE);
+                tc_wt_round_begin();
+            }
+        /* this frame's map, written before the fence (after the slot was last read) */
+        w.val = (LONG)v++; SetEvent(w.go); WaitForSingleObject(w.done, INFINITE);
+        const uint32_t fz = tc_wt_fence_harvest();
+        const uint64_t at_fence = tc_hash64(a + t.off, t.len);
+        int copied = 0;
+        if (capture && tc_wt_dirty_since(t.off, t.len, t.vround) && !tc_wt_span_rsx(t.off, t.len)) {
+            memcpy(cap, a + t.off, t.len); copied = 1; ncap++;
+        }
+        /* the fence is visible: the writer rewrites the texture before the replay */
+        w.val = (LONG)v++; SetEvent(w.go); WaitForSingleObject(w.done, INFINITE);
+        /* the replay, judged by the fence's harvest; a copied slot is read from the copy */
+        CHECK(tc_wt_fence_current(fz), "no harvest may run between the fence and its batch's replay");
+        if (tc_wt_dirty_since(t.off, t.len, t.vround)) {
+            t.hash = tc_hash64(copied ? cap : a + t.off, t.len); t.vround = s_tcw.round;
+        }
+        if (t.hash != at_fence) differ++;
+        /* the next batch sees the write after the fence */
+        tc_wt_round_begin();
+        if (tc_wt_dirty_since(t.off, t.len, t.vround)) { t.hash = tc_hash64(a + t.off, t.len); t.vround = s_tcw.round; }
+        CHECK(t.hash == tc_hash64(a + t.off, t.len), "capture case: the next batch missed a write (frame %u)", f);
+    }
+    w.stop = 1; SetEvent(w.go); WaitForSingleObject(th, INFINITE);
+    CloseHandle(th); CloseHandle(w.go); CloseHandle(w.done);
+    VirtualFree(s_tcw.gen, 0, MEM_RELEASE); free(s_tcw.hits);
+    memset(&s_tcw, 0, sizeof s_tcw);
+    VirtualFree(a, 0, MEM_RELEASE);
+    *copies = ncap;
+    return differ;
+}
+
+/* TX1, the watched case: a 1 MB slot written before every fence, after it in
+ * every other frame (a writer thread). Returns the frames tc_wt_written_now
+ * got wrong; *exact counts the frames with no write after the fence whose
+ * guest memory held the bytes at the fence. */
+static uint32_t fence_watch_scenario(uint32_t frames, uint32_t* exact)
+{
+    const SIZE_T G = (SIZE_T)256 << 20;
+    uint8_t* a = (uint8_t*)VirtualAlloc(NULL, G, MEM_RESERVE | MEM_WRITE_WATCH, PAGE_READWRITE);
+    CHECK(a != NULL, "reserve");
+    if (!a) return frames;
+    VirtualAlloc(a, G, MEM_COMMIT, PAGE_READWRITE);
+    memset(&s_tcw, 0, sizeof s_tcw);
+    CHECK(tc_wt_init(a, 1) == 1, "tc_wt_init: write watch on the arena");
+    slot_t t = { 0x04000000u, 1u << 20, 0, 0 };
+    tc_wt_track(t.off, t.len);
+    t.hash = tc_hash64(a + t.off, t.len); t.vround = s_tcw.round;
+    fz_writer w = { a, t.off, t.len, CreateEventA(NULL, FALSE, FALSE, NULL), CreateEventA(NULL, FALSE, FALSE, NULL), 0, 0 };
+    HANDLE th = CreateThread(NULL, 0, fz_writer_main, &w, 0, NULL);
+    uint32_t wrong = 0, ok = 0, v = 1;
+    for (uint32_t f = 0; f < frames; f++) {
+        w.val = (LONG)v++; SetEvent(w.go); WaitForSingleObject(w.done, INFINITE);   /* before the fence */
+        const uint32_t fz = tc_wt_fence_harvest();
+        const uint64_t at_fence = tc_hash64(a + t.off, t.len);
+        CHECK(tc_wt_dirty_since(t.off, t.len, t.vround) && !tc_wt_span_hot(t.off, t.len), "watched: stale, not hot");
+        const int after = (f & 1u) != 0;
+        if (after) { w.val = (LONG)v++; SetEvent(w.go); WaitForSingleObject(w.done, INFINITE); }
+        CHECK(tc_wt_fence_current(fz), "no harvest between the fence and the replay");
+        const int seen = tc_wt_written_now(t.off, t.len);              /* the replay's question */
+        if (seen != after) wrong++;
+        if (!after && tc_hash64(a + t.off, t.len) == at_fence) ok++;
+        t.hash = tc_hash64(a + t.off, t.len); t.vround = s_tcw.round;  /* the replay reads the memory */
+        tc_wt_round_begin();                                            /* the next batch */
+        if (tc_wt_dirty_since(t.off, t.len, t.vround)) { t.hash = tc_hash64(a + t.off, t.len); t.vround = s_tcw.round; }
+        tc_wt_round_begin(); tc_wt_round_begin();                       /* the frame's other batches: no write */
+    }
+    w.stop = 1; SetEvent(w.go); WaitForSingleObject(th, INFINITE);
+    CloseHandle(th); CloseHandle(w.go); CloseHandle(w.done);
+    VirtualFree(s_tcw.gen, 0, MEM_RELEASE); free(s_tcw.hits);
+    memset(&s_tcw, 0, sizeof s_tcw);
+    VirtualFree(a, 0, MEM_RELEASE);
+    *exact = ok;
+    return wrong;
+}
+
+/* TX1 review: the fence's state. */
+static tc_fence s_fz;
+/* tc_alloc_slot's victim (rsx_d3d12_backend.c): not bound this batch; a slot
+ * the fence keeps only if nothing else is free (*kept_taken: counted there). */
+static int lru_pick(const uint32_t* use_batch, int n, uint32_t batch, int* kept_taken)
+{
+    int lru = -1, kept = -1;
+    *kept_taken = 0;
+    for (int i = 0; i < n; i++) {
+        if (use_batch[i] == batch) continue;
+        if (tc_fz_protected(&s_fz, (uint32_t)i, batch)) {
+            if (kept < 0 || use_batch[i] < use_batch[kept]) kept = i;
+            continue;
+        }
+        if (lru < 0 || use_batch[i] < use_batch[lru]) lru = i;
+    }
+    if (lru < 0 && kept >= 0) { *kept_taken = 1; return kept; }
+    return lru;
+}
+static void fence_state_scenario(void)
+{
+    const SIZE_T G = (SIZE_T)256 << 20;
+    uint8_t* a = (uint8_t*)VirtualAlloc(NULL, G, MEM_RESERVE | MEM_WRITE_WATCH, PAGE_READWRITE);
+    CHECK(a != NULL, "reserve");
+    if (!a) return;
+    VirtualAlloc(a, G, MEM_COMMIT, PAGE_READWRITE);
+    memset(&s_tcw, 0, sizeof s_tcw);
+    CHECK(tc_wt_init(a, 1) == 1, "tc_wt_init: write watch on the arena");
+    memset(&s_fz, 0, sizeof s_fz);
+    /* a fence with batch 5's 3 records pending: slot 1 copied, 2 watched, 3 hashed, 4 looked at (clean) */
+    tc_fz_open(&s_fz, 5, 3);
+    CHECK(tc_fz_mark(&s_fz, 1) && tc_fz_mark(&s_fz, 2) && tc_fz_mark(&s_fz, 3) && tc_fz_mark(&s_fz, 4), "mark");
+    CHECK(!tc_fz_mark(&s_fz, 1), "a slot is marked once a fence");
+    s_fz.capo[1] = 1; s_fz.watch[2] = TC_FZ_WATCH; s_fz.watch[3] = TC_FZ_HASH;
+    CHECK(tc_fz_protected(&s_fz, 1, 5) && tc_fz_protected(&s_fz, 2, 5) && tc_fz_protected(&s_fz, 3, 5),
+          "the fence's copy, watch and hash keep their slots in batch 5's prepass");
+    CHECK(!tc_fz_protected(&s_fz, 4, 5) && !tc_fz_protected(&s_fz, 0, 5), "nothing kept for a clean or unmarked slot");
+    CHECK(!tc_fz_protected(&s_fz, 1, 6), "kept only in the fenced batch");
+    /* the eviction victim: slots 0-7, 6 and 7 bound in batch 5; least recent first: 1, 2, 3, 0, 4, 5 */
+    { uint32_t ub[8] = { 3, 0, 1, 2, 4, 4, 5, 5 };
+      int taken = 0, v = lru_pick(ub, 8, 5, &taken);
+      CHECK(v == 0 && !taken, "the least recent slot the fence does not keep (%d, kept taken %d)", v, taken);
+      uint32_t full[8] = { 5, 0, 1, 2, 5, 5, 5, 5 };
+      v = lru_pick(full, 8, 5, &taken);
+      CHECK(v == 1 && taken, "nothing else free: the least recent kept slot, counted (%d, %d)", v, taken); }
+    CHECK(!tc_fz_active(&s_fz, 1, 5), "no copy is read before the batch is judged");
+    CHECK(tc_fz_judge(&s_fz, 5, 3) == 1, "every record precedes the fence, no harvest since: it holds batch 5");
+    CHECK(tc_fz_active(&s_fz, 1, 5) && tc_fz_active(&s_fz, 2, 5) && tc_fz_active(&s_fz, 3, 5), "batch 5 reads them");
+    CHECK(!tc_fz_active(&s_fz, 1, 6), "batch 6 does not");
+    CHECK(tc_fz_judge(&s_fz, 6, 1) == 0, "batch 6 has no fence");
+    tc_fz_forget(&s_fz, 1);
+    CHECK(!tc_fz_protected(&s_fz, 1, 5) && !s_fz.capo[1], "a slot given to another texture loses the copy");
+    /* a lapse: a record after the fence (the batch began a round after all) */
+    tc_fz_open(&s_fz, 7, 3);
+    CHECK(!tc_fz_active(&s_fz, 2, 5), "a new fence ends the last one's");
+    tc_fz_mark(&s_fz, 1); s_fz.capo[1] = 1;
+    CHECK(tc_fz_judge(&s_fz, 7, 4) == -1, "a record after the fence: lapsed");
+    CHECK(!tc_fz_active(&s_fz, 1, 7) && !tc_fz_protected(&s_fz, 1, 7), "a lapsed fence's copy is neither read nor kept");
+    /* a lapse: a harvest between the fence and the replay */
+    tc_fz_open(&s_fz, 9, 2);
+    tc_fz_mark(&s_fz, 2); s_fz.watch[2] = TC_FZ_WATCH;
+    tc_wt_round_begin();
+    CHECK(tc_fz_judge(&s_fz, 9, 2) == -1, "a harvest since the fence: lapsed");
+    CHECK(!tc_fz_active(&s_fz, 2, 9) && !tc_fz_protected(&s_fz, 2, 9), "a lapsed fence's watch is neither asked nor kept");
+    /* marks do not carry from one fence to the next */
+    tc_fz_open(&s_fz, 11, 1); tc_fz_mark(&s_fz, 3); s_fz.capo[3] = 1;
+    tc_fz_open(&s_fz, 12, 1);
+    CHECK(!tc_fz_protected(&s_fz, 3, 12), "an earlier fence's copy is not kept for the next");
+    CHECK(tc_fz_judge(&s_fz, 12, 1) == 1 && !tc_fz_active(&s_fz, 3, 12), "nor read");
+    s_fz.id = 0xFFFFFFFFu;
+    tc_fz_open(&s_fz, 13, 1);
+    CHECK(s_fz.id == 1u && s_fz.chk[100] != s_fz.id, "the serial skips 0 (never an unmarked slot's)");
+    /* a hot slot over the copy cap (300 KB): reset at the fence, then watched */
+    { slot_t t = { 0x05000000u, 300u << 10, 0, 0 };
+      tc_wt_track(t.off, t.len);
+      for (int k = 0; k < 6; k++) { memset(a + t.off, k, t.len); tc_wt_round_begin(); }   /* a loading screen */
+      memset(a + t.off, 0x40, t.len);                                                     /* before the fence */
+      tc_fz_open(&s_fz, 15, 1);
+      t.vround = s_tcw.round;
+      CHECK(tc_wt_span_hot(t.off, t.len), "hot after the loading rounds");
+      CHECK(tc_wt_written_now(t.off, t.len), "a hot page stays dirty: its write watch cannot tell");
+      tc_wt_reset_span(t.off, t.len);
+      CHECK(!tc_wt_written_now(t.off, t.len), "reset at the fence: nothing written since");
+      a[t.off + (200u << 10)] = 0x41;                                                     /* after the fence */
+      CHECK(tc_wt_written_now(t.off, t.len), "a write after the fence is seen at the replay");
+      CHECK(tc_fz_judge(&s_fz, 15, 1) == 1, "the reset is not a harvest: the fence holds");
+      tc_wt_round_begin();
+      CHECK(tc_wt_dirty_since(t.off, t.len, t.vround), "the next batch's harvest still reports the write"); }
+    VirtualFree(s_tcw.gen, 0, MEM_RELEASE); free(s_tcw.hits);
+    memset(&s_tcw, 0, sizeof s_tcw);
+    VirtualFree(a, 0, MEM_RELEASE);
+    printf("fence state: lapse, eviction, serial and hot-slot checks done\n");
+}
+
+int main(void)
+{
+    const uint32_t off_resets = scenario(0, 40, 30);
+    const uint32_t on_resets = scenario(1, 40, 30);
+    /* with the rule on, the copied pages are reset only in the first frame (before the first note is seen) */
+    CHECK(on_resets < off_resets / 4, "rule on: %u resets while copying vs %u with it off", on_resets, off_resets);
+    /* TX1: the fence */
+    { const uint32_t frames = 400u;
+      uint32_t miss_on = 0, miss_off = 0;
+      const uint32_t d_on = fence_scenario(1, frames, &miss_on);
+      const uint32_t d_off = fence_scenario(0, frames, &miss_off);
+      printf("fence: %u frames, binds before the fence not holding its bytes: %u with TEX_FENCE, %u without;"
+             " binds after it missing a write: %u / %u\n", frames, d_on, d_off, miss_on, miss_off);
+      CHECK(d_on == 0, "TEX_FENCE: %u binds before the fence held bytes written after it", d_on);
+      CHECK(d_off > frames / 2, "the old rule should take the write after the fence (%u of %u)", d_off, frames);
+      CHECK(miss_on == 0 && miss_off == 0, "a write missed by the next batch: %u / %u", miss_on, miss_off); }
+    /* TX1: written both before and after the fence (normal pages, then hot ones) */
+    for (uint32_t warm = 0; warm <= 6u; warm += 6u) {
+      const uint32_t frames = 200u;
+      uint32_t c_on = 0, c_off = 0;
+      const uint32_t d_on = fence_capture_scenario(1, frames, warm, &c_on);
+      const uint32_t d_off = fence_capture_scenario(0, frames, warm, &c_off);
+      printf("fence, written before and after it (%s): %u frames, %u copies at the fence; binds before the fence"
+             " not holding its bytes: %u with the copy, %u reading the guest memory\n",
+             warm ? "hot after loading rounds" : "normal pages", frames, c_on, d_on, d_off);
+      CHECK(c_on == frames, "every fence should copy the written slot (%u of %u)", c_on, frames);
+      CHECK(d_on == 0, "capture: %u binds before the fence held bytes written after it", d_on);
+      CHECK(d_off == frames, "reading the guest memory, every bind should hold the later write (%u of %u)", d_off, frames); }
+    /* TX1: a large slot watched instead of copied */
+    { const uint32_t frames = 200u;
+      uint32_t exact = 0;
+      const uint32_t wrong = fence_watch_scenario(frames, &exact);
+      printf("fence, watched: %u frames (a write after the fence in every other one): tc_wt_written_now wrong %u;"
+             " frames with none where the memory held the bytes at the fence %u of %u\n", frames, wrong, exact,
+             frames / 2u);
+      CHECK(wrong == 0, "watched: tc_wt_written_now was wrong in %u frames", wrong);
+      CHECK(exact == frames / 2u, "watched: %u of %u frames without a later write held the bytes at the fence",
+            exact, frames / 2u); }
+    fence_state_scenario();                       /* TX1 review: the fence's state helpers */
+    printf("%s (%d failures)\n", s_fail ? "FAILED" : "all passed", s_fail);
+    return s_fail ? 1 : 0;
+}
diff --git a/libs/video/tests/test_tex_heap.c b/libs/video/tests/test_tex_heap.c
new file mode 100644
index 0000000..a563180
--- /dev/null
+++ b/libs/video/tests/test_tex_heap.c
@@ -0,0 +1,165 @@
+/*
+ * ps3recomp - ST1 TEX_PLACED's range allocator (rsx_tex_heap.h), no GPU.
+ *
+ * A 32 MB heap gets random takes (4 KB .. 3 MB in 4 KB steps, aligned 4 KB or 64 KB like the small and default
+ * placement alignments) and gives (random live blocks), 200,000 operations over 16 seeds, against a model of the
+ * live blocks. A third of the gives are deferred (TphDefer: the backend's failure path, a resource buried until the
+ * next GPU wait) and the list is drained every 40 operations: a deferred block must stay taken -- no take may
+ * overlap it -- until the drain gives it back. After every operation: every live or deferred block lies in the heap
+ * at its alignment and overlaps no other; the free ranges are sorted, non-empty, never adjacent (coalesced) and
+ * overlap no live or deferred block; free + live + deferred bytes = the heap and `used` = the live + deferred
+ * bytes. A take that fails must have had no aligned gap of that size (checked against the free ranges). Then
+ * everything is given back: one free range [0, 32 MB), used 0. Plus fixed cases: an exact fit, a head-and-tail
+ * split, merging with the previous, the next and both neighbours; deferral across two heaps; a cleared (released)
+ * heap takes nothing until it is initialised again.
+ *
+ * Build (clang-cl): clang-cl /nologo /O2 /W3 test_tex_heap.c /Fe:test_tex_heap.exe   (include path: libs/video)
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../rsx_tex_heap.h"
+
+#define HEAP (32ull << 20)
+static int fails;
+#define CHECK(c, ...) do { if (!(c)) { if (fails++ < 20) { printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } } while (0)
+
+typedef struct { unsigned long long off, len; } Blk;
+static Blk live[4096], pend[4096];
+static int nlive, npend;
+
+static unsigned long long rng = 88172645463325252ull;
+static unsigned long long rnd(void) { rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17; return rng; }
+
+static void check(const TphHeap* H, const char* where)
+{
+    unsigned long long freeb = 0, liveb = 0;
+    for (int i = 0; i < H->nfr; i++) {
+        CHECK(H->fr[i].len > 0, "%s: empty free range %d", where, i);
+        CHECK(H->fr[i].off + H->fr[i].len <= HEAP, "%s: free range %d past the heap", where, i);
+        if (i) CHECK(H->fr[i - 1].off + H->fr[i - 1].len < H->fr[i].off, "%s: free ranges %d/%d adjacent or overlapping", where, i - 1, i);
+        freeb += H->fr[i].len;
+    }
+    for (int s = 0; s < 2; s++) {
+        const Blk* B = s ? pend : live;
+        const int nb = s ? npend : nlive;
+        for (int k = 0; k < nb; k++) {
+            liveb += B[k].len;
+            for (int i = 0; i < H->nfr; i++)
+                CHECK(B[k].off + B[k].len <= H->fr[i].off || H->fr[i].off + H->fr[i].len <= B[k].off,
+                      "%s: %s block %d overlaps free range %d", where, s ? "deferred" : "live", k, i);
+        }
+    }
+    CHECK(freeb + liveb == HEAP, "%s: free %llu + live/deferred %llu != heap", where, freeb, liveb);
+    CHECK(H->used == liveb, "%s: used %llu != live + deferred %llu", where, H->used, liveb);
+}
+static int gap_exists(const TphHeap* H, unsigned long long size, unsigned long long align)
+{
+    for (int i = 0; i < H->nfr; i++) {
+        const unsigned long long a = (H->fr[i].off + align - 1) & ~(align - 1);
+        if (a + size <= H->fr[i].off + H->fr[i].len) return 1;
+    }
+    return 0;
+}
+static int overlaps_any(unsigned long long off, unsigned long long size)
+{
+    for (int k = 0; k < nlive; k++) if (!(off + size <= live[k].off || live[k].off + live[k].len <= off)) return 1;
+    for (int k = 0; k < npend; k++) if (!(off + size <= pend[k].off || pend[k].off + pend[k].len <= off)) return 1;
+    return 0;
+}
+
+int main(void)
+{
+    TphHeap H;
+    unsigned long long o1, o2, o3;
+    /* fixed cases */
+    CHECK(tph_heap_init(&H, NULL, HEAP), "init");
+    CHECK(tph_take(&H, HEAP, 4096, &o1) && o1 == 0 && H.nfr == 0, "exact fit of the whole heap");
+    CHECK(!tph_take(&H, 4096, 4096, &o2), "a full heap takes nothing");
+    CHECK(tph_give(&H, 0, HEAP) && H.nfr == 1 && H.fr[0].len == HEAP && H.used == 0, "whole heap back");
+    CHECK(tph_take(&H, 4096, 4096, &o1) && o1 == 0, "first 4 KB");
+    CHECK(tph_take(&H, 65536, 65536, &o2) && o2 == 65536 && H.nfr == 2, "64 KB aligned: a head range stays (%d)", H.nfr);
+    CHECK(H.fr[0].off == 4096 && H.fr[0].len == 61440 && H.fr[1].off == 131072, "head [4K,64K) and tail from 128K");
+    CHECK(tph_take(&H, 8192, 4096, &o3) && o3 == 4096, "the head is used first fit");
+    CHECK(tph_give(&H, o3, 8192) && H.nfr == 2, "give into the head: merges with the head's rest");
+    CHECK(tph_give(&H, o1, 4096) && H.nfr == 2 && H.fr[0].off == 0 && H.fr[0].len == 65536, "merge with the next");
+    CHECK(tph_give(&H, o2, 65536) && H.nfr == 1 && H.fr[0].off == 0 && H.fr[0].len == HEAP && H.used == 0, "merge both sides");
+    nlive = npend = 0; check(&H, "fixed");
+    free(H.fr);
+
+    /* deferral across two heaps; a cleared heap */
+    {
+        TphHeap HH[2];
+        TphDefer D;
+        memset(&D, 0, sizeof D);
+        unsigned long long a, b, c;
+        int lost = 0;
+        CHECK(tph_heap_init(&HH[0], NULL, HEAP) && tph_heap_init(&HH[1], NULL, HEAP), "init two heaps");
+        CHECK(tph_take(&HH[0], 1ull << 20, 4096, &a) && a == 0, "a: [0, 1 MB) of heap 0");
+        CHECK(tph_take(&HH[1], 2ull << 20, 65536, &b) && b == 0, "b: [0, 2 MB) of heap 1");
+        CHECK(tph_defer_put(&D, 0, a, 1ull << 20) && tph_defer_put(&D, 1, b, 2ull << 20) && D.n == 2, "defer a and b");
+        CHECK(HH[0].used == (1ull << 20) && HH[1].used == (2ull << 20), "deferred blocks still count as taken");
+        CHECK(tph_take(&HH[0], 4096, 4096, &c) && c == (1ull << 20), "a take after the deferral does not reuse a (%llu)", c);
+        CHECK(tph_defer_drain(&D, HH, &lost) == 2 && !lost && D.n == 0, "the drain gives both back");
+        CHECK(HH[1].used == 0 && HH[1].nfr == 1 && HH[1].fr[0].len == HEAP, "heap 1 whole again");
+        CHECK(tph_give(&HH[0], c, 4096) && HH[0].used == 0 && HH[0].nfr == 1, "heap 0 whole again");
+        CHECK(tph_take(&HH[0], 4096, 4096, &c) && c == 0, "a's space is taken first fit after the drain");
+        tph_heap_clear(&HH[0]);
+        CHECK(HH[0].heap == NULL && HH[0].size == 0 && !tph_take(&HH[0], 4096, 4096, &c), "a cleared heap takes nothing");
+        CHECK(tph_heap_init(&HH[0], NULL, HEAP) && tph_take(&HH[0], 4096, 4096, &c) && c == 0, "initialised again after a clear");
+        free(HH[0].fr); free(HH[1].fr); free(D.p);
+    }
+
+    /* random */
+    long ops = 0, takes = 0, gives = 0, defers = 0, drains = 0, nofit = 0;
+    for (int seed = 1; seed <= 16; seed++) {
+        rng = 0x9E3779B97F4A7C15ull * (unsigned long long)seed;
+        TphDefer D;
+        memset(&D, 0, sizeof D);
+        CHECK(tph_heap_init(&H, NULL, HEAP), "init %d", seed);
+        nlive = npend = 0;
+        for (int n = 0; n < 12500; n++, ops++) {
+            const int take = nlive == 0 || (nlive < 4096 && (rnd() % 100) < 55);
+            if (take) {
+                const unsigned long long size = 4096ull * (1 + rnd() % (rnd() % 8 ? 64 : 768));
+                const unsigned long long align = (rnd() % 3) ? 4096 : 65536;
+                unsigned long long off;
+                if (tph_take(&H, size, align, &off)) {
+                    CHECK(off % align == 0 && off + size <= HEAP, "take: misaligned or past the heap");
+                    CHECK(!overlaps_any(off, size), "take: overlaps a live or deferred block");
+                    live[nlive].off = off; live[nlive].len = size; nlive++;
+                    takes++;
+                } else {
+                    nofit++;
+                    CHECK(!gap_exists(&H, size, align), "take refused although a gap fits (size %llu align %llu)", size, align);
+                }
+            } else {
+                const int k = (int)(rnd() % (unsigned long long)nlive);
+                if (npend < 4096 && rnd() % 3 == 0) {
+                    CHECK(tph_defer_put(&D, 0, live[k].off, live[k].len), "defer");
+                    pend[npend++] = live[k];
+                    defers++;
+                } else {
+                    CHECK(tph_give(&H, live[k].off, live[k].len), "give");
+                    gives++;
+                }
+                live[k] = live[--nlive];
+            }
+            if (n % 40 == 39 || npend == 4096) {
+                int lost = 0;
+                const int back = tph_defer_drain(&D, &H, &lost);
+                CHECK(back == npend && !lost && D.n == 0, "drain: %d of %d back, %d lost", back, npend, lost);
+                npend = 0; drains++;
+            }
+            if ((n & 15) == 0) check(&H, "random");
+        }
+        { int lost = 0; CHECK(tph_defer_drain(&D, &H, &lost) == npend && !lost, "final drain"); npend = 0; }
+        while (nlive) { CHECK(tph_give(&H, live[nlive - 1].off, live[nlive - 1].len), "drain"); nlive--; }
+        CHECK(H.nfr == 1 && H.fr[0].off == 0 && H.fr[0].len == HEAP && H.used == 0, "seed %d: all back, one range", seed);
+        free(H.fr); free(D.p);
+    }
+    printf("test_tex_heap: %ld random operations (%ld takes, %ld gives, %ld deferred in %ld drains, %ld refused with no"
+           " aligned gap), 16 seeds: %s (%d failure(s))\n", ops, takes, gives, defers, drains, nofit,
+           fails ? "FAIL" : "PASS", fails);
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_texpack.c b/libs/video/tests/test_texpack.c
new file mode 100644
index 0000000..edd9906
--- /dev/null
+++ b/libs/video/tests/test_texpack.c
@@ -0,0 +1,594 @@
+/*
+ * ps3recomp - texture dump / replacement packs: the pure parts and the image
+ * I/O (rsx_texpack.h, rsx_texpack_io.h). Synthetic data only.
+ *
+ *   1. Identity: the canonical texel stream and its pack hash, against a
+ *      reference written from the layout rules alone (not from
+ *      rsx_texture_mip_chain), for every format, LN / swizzled / NPOT, mip
+ *      counts, cubes and CONTROL3 pitches; padding, cube gaps and X bits
+ *      never change it, any texel byte does; the cache's own hash is it when
+ *      the layout is contiguous; portable == AVX-512; the level-0 hash.
+ *   2. Uniform textures, register vetoes (depth, UN, 3D, border), classes.
+ *   3. File names: make -> parse round trip, malformed names rejected.
+ *   4. DDS: header writer -> parser round trip per format, truncated /
+ *      oversized / inconsistent headers rejected, and 200k random mutations
+ *      of valid files parse or fail without touching memory past the file
+ *      (each mutated file sits at the end of a page followed by a guard page).
+ *   5. PARAM.SFO TITLE_ID, index.jsonl fields, torn lines.
+ *   6. Sampler LOD shift: unshifted codes are bit-identical, clamps move by s,
+ *      0 stays 0, non-mip promotion, view level caps, scales.
+ *   7. Mip generation (gamma-space box, linear light, signed bytes) and the
+ *      BC1/2/3 decoder.
+ *   8. WIC: PNG round trips (BGRA8, gray8, gray16, RGBA16) are exact; pack
+ *      files decode to each class with full mip chains; sRGB DDS gets a UNORM
+ *      view format; wrong class / shape / scale is refused; garbage and huge
+ *      images are refused before decoding.
+ *
+ * Windows only. From external/ps3recomp:
+ *   clang-cl /nologo /O1 -I include -I libs/video libs/video/tests/test_texpack.c
+ *     libs/video/rsx_texture_layout.c /Fe:T/test_texpack.exe
+ */
+#include "rsx_texpack_io.h"
+#include <stdio.h>
+#include <string.h>
+
+static int g_fail, g_pass;
+#define CHECK(c) do { if (c) g_pass++; else { g_fail++; printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+static uint32_t g_seed = 12345u;
+static uint32_t rnd(void) { g_seed = g_seed * 1664525u + 1013904223u; return g_seed >> 8; }
+static void fill(uint8_t* p, size_t n) { for (size_t i = 0; i < n; i++) p[i] = (uint8_t)rnd(); }
+
+/* ---------------------------------------------------------------------------
+ * Reference layout, from the rules (libgcm / nouveau layout as documented in
+ * rsx_texture_layout.h), independent of rsx_texture_mip_chain.
+ * -----------------------------------------------------------------------*/
+typedef struct { uint32_t bpp, block, pair; } ref_fmt;
+static int ref_fmt_of(uint32_t f, ref_fmt* r)
+{
+    memset(r, 0, sizeof *r);
+    switch (f & 0x9Fu) {
+    case 0x81: r->bpp = 1; return 0;
+    case 0x82: case 0x83: case 0x84: case 0x8F: case 0x97: case 0x9D: case 0x92: case 0x93: case 0x94: r->bpp = 2; return 0;
+    case 0x8B: case 0x98: case 0x99: r->bpp = 2; return 0;
+    case 0x8D: case 0x8E: r->bpp = 2; r->pair = 1; return 0;
+    case 0x85: case 0x9E: case 0x90: case 0x91: case 0x95: case 0x9C: case 0x9F: r->bpp = 4; return 0;
+    case 0x9A: r->bpp = 8; return 0;
+    case 0x9B: r->bpp = 16; return 0;
+    case 0x86: r->block = 8; return 0;
+    case 0x87: case 0x88: r->block = 16; return 0;
+    default: return -1;
+    }
+}
+static uint32_t ref_packed_row(const ref_fmt* r, uint32_t w)
+{
+    return r->block ? ((w + 3) / 4) * r->block : r->pair ? ((w + 1) / 2) * 4 : w * r->bpp;
+}
+static uint32_t ref_rows(const ref_fmt* r, uint32_t h) { return r->block ? (h + 3) / 4 : h; }
+static uint32_t ref_levels(uint32_t w, uint32_t h, uint32_t mips)
+{
+    uint32_t n = 1, m = w > h ? w : h;
+    while (m > 1) { m >>= 1; n++; }
+    if (!mips) mips = 1;
+    if (mips > 14) mips = 14;
+    return mips < n ? mips : n;
+}
+/* the canonical stream, byte by byte */
+static uint8_t* ref_stream(const tp_desc* d, const uint8_t* base, size_t* n, size_t* n0, uint64_t* span)
+{
+    ref_fmt rf; if (ref_fmt_of(d->fmt, &rf)) return NULL;
+    const uint32_t lv = ref_levels(d->w, d->h, d->levels);
+    const int ln = (d->fmt & 0x20u) != 0;
+    const uint32_t row0 = ref_packed_row(&rf, d->w);
+    const uint32_t upitch = (ln && d->pitch >= row0) ? d->pitch : 0;
+    uint32_t off[16], rowb[16], rows[16], pk[16], pyramid = 0;
+    for (uint32_t m = 0, w = d->w, h = d->h; m < lv; m++) {
+        pk[m] = ref_packed_row(&rf, w); rows[m] = ref_rows(&rf, h);
+        rowb[m] = upitch ? upitch : pk[m];
+        off[m] = pyramid; pyramid += rowb[m] * rows[m];
+        if (w > 1) w >>= 1; if (h > 1) h >>= 1;
+    }
+    const uint32_t faces = d->cube ? 6 : 1;
+    const uint32_t stride = d->cube ? (ln ? pyramid : ((pyramid + 127u) & ~127u)) : pyramid;
+    size_t total = 0;
+    for (uint32_t m = 0; m < lv; m++) total += (size_t)pk[m] * rows[m] * faces;
+    uint8_t* s = (uint8_t*)malloc(total ? total : 1);
+    size_t o = 0;
+    const uint32_t bf = d->fmt & 0x9Fu;
+    *n0 = 0;
+    for (uint32_t f = 0; f < faces; f++)
+        for (uint32_t m = 0; m < lv; m++)
+            for (uint32_t r = 0; r < rows[m]; r++)
+                for (uint32_t b = 0; b < pk[m]; b++) {
+                    uint8_t v = base[(size_t)f * stride + off[m] + (size_t)r * rowb[m] + b];
+                    if (bf == 0x9Eu && (b % 4u) == 0) v = 0;
+                    if (bf == 0x9Du && (b % 2u) == 0) v &= 0x7Fu;
+                    s[o++] = v;
+                }
+    for (uint32_t f = 0; f < faces; f++) *n0 += (size_t)pk[0] * rows[0];
+    *n = o;
+    *span = (uint64_t)(faces - 1) * stride + pyramid;
+    return s;
+}
+/* the level-0 part of the reference stream (face by face) */
+static uint64_t ref_h0(const tp_desc* d, const uint8_t* stream, size_t n)
+{
+    ref_fmt rf; ref_fmt_of(d->fmt, &rf);
+    const uint32_t faces = d->cube ? 6 : 1;
+    const size_t per_face = n / faces, l0 = (size_t)ref_packed_row(&rf, d->w) * ref_rows(&rf, d->h);
+    uint8_t* t = (uint8_t*)malloc(l0 * faces);
+    for (uint32_t f = 0; f < faces; f++) memcpy(t + f * l0, stream + f * per_face, l0);
+    const uint64_t h = tc_hash64_v2(t, l0 * faces);
+    free(t);
+    return h;
+}
+
+static void test_identity(void)
+{
+    static const uint32_t fmts[] = { 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x8B, 0x8D, 0x8E, 0x8F,
+                                     0x94, 0x95, 0x97, 0x98, 0x99, 0x9A, 0x9B, 0x9C, 0x9D, 0x9E, 0x9F };
+    static const uint32_t sizes[][2] = { {64, 64}, {128, 32}, {16, 128}, {300, 200}, {5, 8}, {1, 1}, {256, 1}, {4, 4} };
+    const size_t arena_n = 8u << 20;
+    uint8_t* arena = (uint8_t*)malloc(arena_n);
+    fill(arena, arena_n);
+    int cases = 0, contiguous_cases = 0;
+    for (size_t fi = 0; fi < sizeof fmts / sizeof fmts[0]; fi++)
+        for (int ln = 0; ln < 2; ln++)
+            for (size_t si = 0; si < sizeof sizes / sizeof sizes[0]; si++)
+                for (int mi = 0; mi < 3; mi++)
+                    for (int cube = 0; cube < 2; cube++)
+                        for (int pi = 0; pi < 3; pi++) {
+                            const uint32_t w = sizes[si][0], h = sizes[si][1];
+                            if (cube && w != h) continue;
+                            if (!ln && pi) continue;                  /* pitch only on LN */
+                            tp_desc d; memset(&d, 0, sizeof d);
+                            d.fmt = fmts[fi] | (ln ? 0x20u : 0u); d.w = w; d.h = h; d.cube = cube;
+                            d.levels = mi == 0 ? 1 : mi == 1 ? 3 : 14;
+                            ref_fmt rf; ref_fmt_of(d.fmt, &rf);
+                            const uint32_t row0 = ref_packed_row(&rf, w);
+                            d.pitch = pi == 0 ? 0 : pi == 1 ? row0 : row0 + 64;
+                            tp_layout L;
+                            if (tp_layout_of(&d, &L)) { CHECK(0); continue; }
+                            size_t rn, rn0; uint64_t rspan;
+                            uint8_t* rs = ref_stream(&d, arena + 4096, &rn, &rn0, &rspan);
+                            if (!rs) { CHECK(0); continue; }
+                            if (rspan + 8192 > arena_n) { free(rs); continue; }
+                            cases++;
+                            CHECK(L.stream_bytes == rn);
+                            CHECK(L.stream0_bytes == rn0);
+                            CHECK(L.guest_span == rspan);
+                            uint64_t full = 0, h0 = 0;
+                            CHECK(!tp_hashes(&L, arena + 4096, &full, &h0));
+                            CHECK(full == tc_hash64_v2(rs, rn));
+                            CHECK(h0 == ref_h0(&d, rs, rn));
+                            if (L.glv == 1) CHECK(h0 == full);
+                            if (L.contiguous) {                       /* the cache's own hash IS the pack hash */
+                                contiguous_cases++;
+                                CHECK(full == tc_hash64_v2(arena + 4096, (size_t)L.guest_span));
+                            }
+#ifdef TC_HAVE_AVX512_PATH
+                            if (tc_cpu_avx512()) { uint64_t f2 = 0; uint8_t* g = (uint8_t*)malloc(rn); tp_gather(&L, arena + 4096, g, 0);
+                                                   f2 = tc_hash64_v2_avx512(g, rn); CHECK(f2 == full); free(g); }
+#endif
+                            /* the same bytes at another address: the same name */
+                            uint8_t* copy = (uint8_t*)malloc((size_t)rspan + 64);
+                            memcpy(copy + 13, arena + 4096, (size_t)rspan);
+                            uint64_t fc = 0; tp_hashes(&L, copy + 13, &fc, NULL); CHECK(fc == full);
+                            /* any texel byte changes it: flip the last stream byte's source */
+                            { uint32_t f = L.nfaces - 1, m = L.glv - 1;
+                              const size_t a = (size_t)f * L.face_stride + L.lv[m].offset + (size_t)(L.lv[m].tl.rows - 1) * L.lv[m].tl.row_bytes +
+                                               L.packed_row[m] - 1;
+                              const uint8_t keep = copy[13 + a];
+                              copy[13 + a] ^= 0x01u;
+                              uint64_t fx = 0; tp_hashes(&L, copy + 13, &fx, NULL);
+                              const int xbit = ((d.fmt & 0x9Fu) == 0x9Du && ((L.packed_row[m] - 1) % 2) == 0) ||
+                                               ((d.fmt & 0x9Fu) == 0x9Eu && ((L.packed_row[m] - 1) % 4) == 0);
+                              CHECK(xbit ? fx == full : fx != full);
+                              copy[13 + a] = keep; }
+                            /* padding after a pitched row, and a cube's alignment gap, do not */
+                            if (L.packed_row[0] < L.lv[0].tl.row_bytes) {
+                                copy[13 + L.packed_row[0]] ^= 0xFFu;
+                                uint64_t fp = 0; tp_hashes(&L, copy + 13, &fp, NULL); CHECK(fp == full);
+                                copy[13 + L.packed_row[0]] ^= 0xFFu;
+                            }
+                            if (d.cube && L.face_stride > L.pyramid) {
+                                copy[13 + L.pyramid] ^= 0xFFu;
+                                uint64_t fg = 0; tp_hashes(&L, copy + 13, &fg, NULL); CHECK(fg == full);
+                                copy[13 + L.pyramid] ^= 0xFFu;
+                            }
+                            /* the X byte of D8R8G8B8 / X bit of D1R5G5B5 do not */
+                            if ((d.fmt & 0x9Fu) == 0x9Eu || (d.fmt & 0x9Fu) == 0x9Du) {
+                                copy[13] ^= (d.fmt & 0x9Fu) == 0x9Eu ? 0xFFu : 0x80u;
+                                uint64_t fxm = 0; tp_hashes(&L, copy + 13, &fxm, NULL); CHECK(fxm == full);
+                            }
+                            free(copy);
+                            free(rs);
+                        }
+    printf("identity: %d layouts checked against the reference stream (%d contiguous)\n", cases, contiguous_cases);
+    CHECK(cases > 400 && contiguous_cases > 100);
+    /* the design prototype's names */
+    { tp_desc d = {0x88, 512, 512, 10, 0, 0}; char nm[128];
+      tp_make_name(nm, sizeof nm, &d, 0xc095f01e9261e877ull, ".png");
+      CHECK(!strcmp(nm, "c095f01e9261e877_512x512_DXT45_m10.png")); }
+    { tp_desc d = {0x86, 256, 256, 9, 1, 0}; char nm[128];
+      tp_make_name(nm, sizeof nm, &d, 0x8a70e85d51491392ull, ".dds");
+      CHECK(!strcmp(nm, "8a70e85d51491392_256x256_DXT1_m9_cube.dds")); }
+    { tp_desc d = {0xA5, 300, 200, 1, 0, 2048}; char nm[128];
+      tp_make_name(nm, sizeof nm, &d, 0x5210e4d64ed1fca9ull, ".png");
+      CHECK(!strcmp(nm, "5210e4d64ed1fca9_300x200_A8R8G8B8_ln.png")); }
+    free(arena);
+}
+
+static void test_uniform_veto(void)
+{
+    uint8_t* b = (uint8_t*)calloc(1, 1u << 20);
+    tp_desc d = {0x85, 64, 64, 1, 0, 0}; tp_layout L; tp_layout_of(&d, &L);
+    CHECK(tp_is_uniform(&L, &d, b));                       /* all zero */
+    for (int i = 0; i < 64 * 64; i++) { b[i * 4] = 1; b[i * 4 + 1] = 2; b[i * 4 + 2] = 3; b[i * 4 + 3] = 4; }
+    CHECK(tp_is_uniform(&L, &d, b));                       /* one colour */
+    b[4 * 100 + 2] = 9;
+    CHECK(!tp_is_uniform(&L, &d, b));
+    /* D8R8G8B8: a differing X byte is still one colour */
+    tp_desc dx = {0x9E, 64, 64, 1, 0, 0}; tp_layout LX; tp_layout_of(&dx, &LX);
+    for (int i = 0; i < 64 * 64; i++) { b[i * 4] = (uint8_t)i; b[i * 4 + 1] = 2; b[i * 4 + 2] = 3; b[i * 4 + 3] = 4; }
+    CHECK(tp_is_uniform(&LX, &dx, b));
+    /* DXT1: identical blocks */
+    tp_desc dd = {0x86, 64, 64, 1, 0, 0}; tp_layout LD; tp_layout_of(&dd, &LD);
+    for (int i = 0; i < 16 * 16; i++) memcpy(b + i * 8, "\x12\x34\x56\x78\x9A\xBC\xDE\xF0", 8);
+    CHECK(tp_is_uniform(&LD, &dd, b));
+    b[8 * 77] ^= 1;
+    CHECK(!tp_is_uniform(&LD, &dd, b));
+    free(b);
+    /* register vetoes */
+    CHECK(tp_reg_veto(0x90, 0) != NULL && tp_reg_veto(0x92 | 0x20, 0) != NULL);     /* depth */
+    CHECK(tp_reg_veto(0x85 | 0x40, 0) != NULL);                                     /* UN */
+    CHECK(tp_reg_veto(0x85, (0x85u << 8) | (3u << 4) | 8u) != NULL);                 /* 3D */
+    CHECK(tp_reg_veto(0x85, (0x85u << 8) | (2u << 4)) != NULL);                      /* border bit clear */
+    CHECK(tp_reg_veto(0x85, (0x85u << 8) | (2u << 4) | 8u) == NULL);                 /* plain 2D */
+    CHECK(tp_reg_veto(0x8C, 0) != NULL);                                            /* not a format */
+    CHECK(tp_reg_veto(0x86, 0) == NULL && tp_reg_veto(0xA5, 0) == NULL);
+    /* classes */
+    CHECK(tp_class_of(0x85) == TP_CLS_RGBA8 && tp_class_of(0x84) == TP_CLS_RGBA8 && tp_class_of(0x8D) == TP_CLS_RGBA8);
