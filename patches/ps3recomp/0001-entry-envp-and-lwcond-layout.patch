+            due.QuadPart = -((left - spin) * 10000000 / f.QuadPart);   /* 100 ns, relative */
+            if (SetWaitableTimer(tmr, &due, 0, NULL, NULL, FALSE))
+                WaitForSingleObject(tmr, (DWORD)(left * 1000 / f.QuadPart) + 2u);
+        }
+        do { YieldProcessor(); QueryPerformanceCounter(&now); } while (now.QuadPart < next);
+    }
+    next += period;
+#endif
+}
