diff --git a/libs/video/tests/test_upscale.c b/libs/video/tests/test_upscale.c
new file mode 100644
index 0000000..8a04186
--- /dev/null
+++ b/libs/video/tests/test_upscale.c
@@ -0,0 +1,381 @@
+/*
+ * ps3recomp - the window-sized present, the pure parts (CPU only):
+ * libs/video/rsx_upscale.h (kernels, taps, the CPU twin of the window pass's
+ * kernel path, the anti-ringing clamp, the swap-chain decision, the VRR plan)
+ * with libs/video/display_cfg.h (the picture's rectangle in the window: the
+ * bars). Synthetic images only (no game data).
+ *
+ *   clang-cl /nologo /O2 /W3 -I libs/video libs/video/tests/test_upscale.c /Fe:t.exe && t.exe
+ *   cc -O2 -I libs/video libs/video/tests/test_upscale.c -lm -o /tmp/t && /tmp/t
+ *
+ *   kernel.*    K(0) = 1, zero at the radius and beyond, Catmull-Rom and the
+ *               tent are partitions of unity, Lanczos-2's 1-D sums stay within
+ *               2.5% of 1 (the shader divides by the sum: exactly 1)
+ *   taps.*      every texel whose centre is within the support is a tap, no
+ *               tap outside it has weight, taps <= 16, at 1x / 2.0x1.5 /
+ *               1.333x / x2 x3 x4 downsamples / odd sizes
+ *   sum.*       the normalised 2-D weights of every destination pixel sum to 1
+ *   id.*        1:1 is the texel itself for every filter (random image)
+ *   flat.*      a flat colour stays exact at every ratio, every filter
+ *   ring.*      a hard step and a 1-pixel HUD-like stroke upscaled 2.0 x 1.5:
+ *               without the clamp bicubic / Lanczos over- and undershoot (halos),
+ *               with it nothing leaves the 2x2 min / max (no halo pixel at all)
+ *   lin.*       linear light only when an axis shrinks
+ *   bars.*      the swap chain's size = the picture's rectangle in the client
+ *               (display_cfg's fit): no bars when the aspect matches, symmetric
+ *               bars otherwise, the whole client with present = stretch; the
+ *               source maps onto it edge to edge
+ *   pm.*        the swap-chain decision: the defaults change nothing
+ *   vrr.*       the cap (75 -> 72 ...) and what switching the row sets
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include "rsx_upscale.h"
+#include "display_cfg.h"
+
+static int g_fail, g_pass;
+#define CHECK(c, ...) do { if (c) g_pass++; else { g_fail++; if (g_fail < 60) { printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } } while (0)
+
+static const int k_filters[3] = { RSX_UP_BILINEAR, RSX_UP_BICUBIC, RSX_UP_LANCZOS };
+static const struct { unsigned s, d; } k_axes[] = {
+    { 1280, 2560 }, { 720, 1080 }, { 1280, 1707 }, { 720, 720 }, { 1280, 1920 }, { 1280, 3440 }, { 720, 1440 },
+    { 2560, 2560 }, { 1440, 1080 }, { 3840, 2560 }, { 2160, 1080 }, { 5120, 2560 }, { 2880, 1080 }, { 2560, 1280 },
+    { 1280, 1280 }, { 37, 101 }, { 101, 37 }, { 7, 3 }, { 5120, 640 },
+};
+#define NAXES (int)(sizeof k_axes / sizeof k_axes[0])
+
+static unsigned g_rng = 2463534242u;
+static float rndf(void) { g_rng ^= g_rng << 13; g_rng ^= g_rng >> 17; g_rng ^= g_rng << 5; return (float)(g_rng % 256u) / 255.0f; }
+
+static void test_kernel(void)
+{
+    for (int i = 0; i < 3; i++) {
+        const int f = k_filters[i];
+        const double r = rsx_up_radius(f);
+        CHECK(fabs(rsx_up_kernel(f, 0.0) - 1.0) < 1e-12, "kernel.K0 f%d", f);
+        CHECK(fabs(rsx_up_kernel(f, r)) < 1e-9 && rsx_up_kernel(f, r + 0.5) == 0.0, "kernel.radius f%d", f);
+        CHECK(fabs(rsx_up_kernel(f, 1.0)) < 1e-9, "kernel.zero at 1 f%d", f);   /* interpolating */
+        for (double x = 0.0; x < 3.0; x += 0.0625)
+            CHECK(fabs(rsx_up_kernel(f, x) - rsx_up_kernel(f, -x)) < 1e-12, "kernel.even f%d x %g", f, x);
+        double worst = 0.0;
+        for (double ph = 0.0; ph < 1.0; ph += 1.0 / 64) {   /* sum over integer shifts at every phase */
+            double s = 0.0;
+            for (int k = -3; k <= 3; k++) s += rsx_up_kernel(f, ph + k);
+            if (fabs(s - 1.0) > worst) worst = fabs(s - 1.0);
+        }
+        if (f == RSX_UP_LANCZOS) CHECK(worst < 0.025, "kernel.lanczos sum within 2.5%% of 1 (worst %.4f)", worst);
+        else                     CHECK(worst < 1e-12, "kernel.partition of unity f%d (worst %g)", f, worst);
+    }
+    CHECK(rsx_up_kernel(RSX_UP_BICUBIC, 1.5) < -0.06 && rsx_up_kernel(RSX_UP_LANCZOS, 1.5) < -0.06,
+          "kernel.negative lobes (the halos the clamp removes)");
+    CHECK(rsx_up_radius(RSX_UP_OFF) == 0.0, "kernel.off has none");
+}
+
+static void test_taps(void)
+{
+    for (int i = 0; i < 3; i++)
+        for (int a = 0; a < NAXES; a++) {
+            const int f = k_filters[i];
+            const unsigned S = k_axes[a].s, D = k_axes[a].d;
+            const rsx_up_axis ax = rsx_up_axis_of(f, S, D);
+            CHECK(ax.taps >= 1 && ax.taps <= RSX_UP_MAX_TAPS, "taps.count f%d %u->%u: %d", f, S, D, ax.taps);
+            CHECK(ax.scale >= 1.0, "taps.scale >= 1");
+            int miss = 0, extra = 0;
+            double wbuf[RSX_UP_MAX_TAPS];
+            for (unsigned d = 0; d < D; d += (D > 400 ? 7 : 1)) {
+                const double c = rsx_up_centre(&ax, d);
+                const int j0 = rsx_up_weights(f, &ax, d, wbuf, NULL);
+                for (int j = j0 - 3; j < j0 + ax.taps + 3; j++) {
+                    const double dist = fabs((double)j + 0.5 - c);
+                    const int in = j >= j0 && j < j0 + ax.taps;
+                    if (dist < ax.support - 1e-9 && !in) miss++;
+                    if (!in && rsx_up_kernel(f, ((double)j + 0.5 - c) / ax.scale) != 0.0) extra++;
+                }
+            }
+            CHECK(!miss && !extra, "taps.cover f%d %u->%u: %d texels inside the support missed, %d weighted outside",
+                  f, S, D, miss, extra);
+        }
+}
+
+static void test_sum(void)
+{
+    for (int i = 0; i < 3; i++)
+        for (int a = 0; a < NAXES; a++) {
+            const int f = k_filters[i];
+            const unsigned S = k_axes[a].s, D = k_axes[a].d;
+            const rsx_up_axis ax = rsx_up_axis_of(f, S, D);
+            double worst = 0.0, wsum_min = 1e9;
+            double w[RSX_UP_MAX_TAPS];
+            for (unsigned d = 0; d < D; d++) {
+                rsx_up_weights(f, &ax, d, w, NULL);
+                double s = 0.0;
+                for (int k = 0; k < ax.taps; k++) s += w[k];
+                if (s < wsum_min) wsum_min = s;
+                double n = 0.0;
+                for (int k = 0; k < ax.taps; k++) n += w[k] / s;   /* the shader's normalisation */
+                if (fabs(n - 1.0) > worst) worst = fabs(n - 1.0);
+            }
+            CHECK(worst < 1e-12 && wsum_min > 0.5, "sum.normalised f%d %u->%u (worst %g, smallest raw sum %g)", f, S,
+                  D, worst, wsum_min);
+        }
+}
+
+/* the CPU twin on a w x h random / flat RGBA image */
+static float* img(unsigned w, unsigned h, int flat, float v)
+{
+    float* p = (float*)malloc((size_t)w * h * 16);
+    for (size_t i = 0; i < (size_t)w * h * 4; i++) p[i] = flat ? v : rndf();
+    return p;
+}
+
+static void test_identity_flat(void)
+{
+    for (int i = 0; i < 3; i++) {
+        const int f = k_filters[i];
+        float* s = img(37, 23, 0, 0);
+        int bad = 0;
+        for (unsigned y = 0; y < 23; y++)
+            for (unsigned x = 0; x < 37; x++) {
+                float o[4];
+                rsx_up_sample(s, 37, 23, f, 37, 23, x, y, 0, 0, 1.0, o);
+                for (int c = 0; c < 4; c++) if (fabs(o[c] - s[((size_t)y * 37 + x) * 4 + c]) > 1e-6) bad++;
+            }
+        CHECK(!bad, "id.1to1 f%d: %d channel values differ", f, bad);
+        free(s);
+        const struct { unsigned sw, sh, dw, dh; } r[] = { { 64, 36, 128, 54 }, { 64, 36, 85, 36 }, { 128, 72, 64, 36 },
+                                                          { 96, 54, 64, 27 }, { 160, 90, 40, 15 } };
+        for (int k = 0; k < 5; k++) {
+            float* fl = img(r[k].sw, r[k].sh, 1, 0.3725f);
+            int bad2 = 0;
+            for (unsigned y = 0; y < r[k].dh; y++)
+                for (unsigned x = 0; x < r[k].dw; x++)
+                    for (int lin = 0; lin < 2; lin++) {
+                        float o[4];
+                        rsx_up_sample(fl, r[k].sw, r[k].sh, f, r[k].dw, r[k].dh, x, y, lin, 1, 1.0, o);
+                        if (fabs(o[0] - 0.3725f) > 1e-5 || fabs(o[3] - 0.3725f) > 1e-5) bad2++;
+                    }
+            CHECK(!bad2, "flat.exact f%d %ux%u->%ux%u: %d pixels moved", f, r[k].sw, r[k].sh, r[k].dw, r[k].dh, bad2);
+            free(fl);
+        }
+    }
+}
+
+/* A HUD-like source (dark background 0.1, a bright 1-px vertical stroke and a hard step to 0.9) upscaled 2.0 x 1.5 */
+static void test_ring(void)
+{
+    const unsigned sw = 32, sh = 8, dw = 64, dh = 12;
+    float* s = img(sw, sh, 1, 0.1f);
+    for (unsigned y = 0; y < sh; y++) {
+        for (unsigned x = 0; x < sw; x++) {
+            float v = x == 8 ? 0.9f : x >= 20 ? 0.9f : 0.1f;
+            for (int c = 0; c < 3; c++) s[((size_t)y * sw + x) * 4 + c] = v;
+            s[((size_t)y * sw + x) * 4 + 3] = 1.0f;
+        }
+    }
+    for (int i = 1; i < 3; i++) {
+        const int f = k_filters[i];
+        int halo_off = 0, halo_on = 0, outside_lobe = 0;
+        double lo_off = 1, hi_off = 0;
+        for (unsigned y = 0; y < dh; y++)
+            for (unsigned x = 0; x < dw; x++) {
+                float a[4], b[4];
+                rsx_up_sample(s, sw, sh, f, dw, dh, x, y, 0, 0, 1.0, a);
+                rsx_up_sample(s, sw, sh, f, dw, dh, x, y, 0, 1, 1.0, b);
+                if (a[0] < 0.1f - 1e-4f || a[0] > 0.9f + 1e-4f) halo_off++;
+                if (b[0] < 0.1f - 1e-6f || b[0] > 0.9f + 1e-6f) halo_on++;
+                if (a[0] < lo_off) lo_off = a[0];
+                if (a[0] > hi_off) hi_off = a[0];
+                /* clamped: within the 2x2 texels around the centre */
+                const double cx = ((double)x + 0.5) * sw / dw;
+                int j = (int)floor(cx - 0.5);
+                float mn = 1, mx = 0;
+                for (int q = j; q <= j + 1; q++) {
+                    const int qq = q < 0 ? 0 : q >= (int)sw ? (int)sw - 1 : q;
+                    const float v = s[(size_t)qq * 4];
+                    if (v < mn) mn = v;
+                    if (v > mx) mx = v;
+                }
+                if (b[0] < mn - 1e-6f || b[0] > mx + 1e-6f) outside_lobe++;
+            }
+        CHECK(halo_off > 0, "ring.unclamped f%d rings (%d pixels outside [0.1, 0.9], range %.3f..%.3f)", f, halo_off,
+              lo_off, hi_off);
+        CHECK(halo_on == 0, "ring.clamped f%d: %d halo pixels", f, halo_on);
+        CHECK(outside_lobe == 0, "ring.2x2 f%d: %d pixels outside the 2x2 min / max", f, outside_lobe);
+        printf("  ring f%d: unclamped %.4f..%.4f (%d halo pixels), clamped 0\n", f, lo_off, hi_off, halo_off);
+    }
+    free(s);
+}
