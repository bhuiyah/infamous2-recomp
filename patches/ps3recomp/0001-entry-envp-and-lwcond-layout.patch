+static void gpu_time_mark(int end)
+{
+    if (!gpu_time_on()) return;
+    s_d3d.cmd_list->lpVtbl->EndQuery(s_d3d.cmd_list, s_gt_qh, D3D12_QUERY_TYPE_TIMESTAMP, end ? 1u : 0u);
+    if (end) {
+        s_d3d.cmd_list->lpVtbl->ResolveQueryData(s_d3d.cmd_list, s_gt_qh, D3D12_QUERY_TYPE_TIMESTAMP,
+                                                 0, s_gt_win.mark ? 4u : 2u, s_gt_rb, 0);
+        s_gt_pending = 1;
+        s_gt_win.pend = s_gt_win.mark;
+        s_gt_win.mark = 0;
+        if (ps3_chain_on()) s_gt_cls_pend = !s_rpc.flush ? 0 : !strcmp(s_rpc.reason, "rt-readback") ? 1 : 2;
+    }
+}
+static void gpu_time_frame(void)
+{
+    if (s_gt_on != 1 || ++s_gt_frames < 60) return;
+    char wp[64] = "";
+    if (s_gt_win.n) snprintf(wp, sizeof wp, ", window pass %.3f ms", s_gt_win.sum / s_gt_win.n);
+    fprintf(stderr, "[GPUTIME] %.2f ms/frame GPU busy (render_frame lists), %.1f lists/frame, longest list %.2f ms%s%c",
+            s_gt_sum / s_gt_frames, (double)s_gt_lists / s_gt_frames, s_gt_max, wp, 10);
+    if (s_gt_cls_n[0] + s_gt_cls_n[1] + s_gt_cls_n[2])
+        fprintf(stderr, "[GPUTIME]   per list: present %.3f ms (%u), readback flush %.3f ms (%u), other flush %.3f ms (%u)%c",
+                s_gt_cls_n[0] ? s_gt_cls_sum[0] / s_gt_cls_n[0] : 0.0, s_gt_cls_n[0],
+                s_gt_cls_n[1] ? s_gt_cls_sum[1] / s_gt_cls_n[1] : 0.0, s_gt_cls_n[1],
+                s_gt_cls_n[2] ? s_gt_cls_sum[2] / s_gt_cls_n[2] : 0.0, s_gt_cls_n[2], 10);
+    for (int i = 0; i < 3; i++) { s_gt_cls_sum[i] = 0.0; s_gt_cls_n[i] = 0; }
+    s_gt_sum = 0.0; s_gt_max = 0.0; s_gt_lists = 0; s_gt_frames = 0;
+    s_gt_win.sum = 0.0; s_gt_win.n = 0;
+}
