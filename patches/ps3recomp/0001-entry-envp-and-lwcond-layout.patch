+int  cellSysutil_ss_callback(uint32_t i, uint32_t* key, const void** rec);
+int  cellSysutil_ss_event(uint32_t i, uint32_t* key, const void** rec);
+int  cellSysutil_ss_completion(uint32_t i, uint32_t* key, const void** rec);
+/* cellGame.c, cellMsgDialog.c, cellSaveData.c */
+extern const ss_list cellGame_ss_list, cellMsgDialog_ss_list, cellSaveData_ss_list;
+void cellMsgDialog_ss_prepare(void);
+int  cellSaveData_ss_check(char* why, size_t n);
+/* sceNpTrophy.c, cellHttp.c, cellNetCtl.c (libs/network) */
