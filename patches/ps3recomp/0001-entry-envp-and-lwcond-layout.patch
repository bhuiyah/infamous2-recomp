+/* Debug layout overrides make the uploaded bytes differ from the hardware's
+ * reading of guest memory: no identity is trustworthy then. */
+static const char* tp_debug_veto(void)
+{
+    static const char* const keys[] = { "TEX_OFF_BIAS", "TEX_REMAP", "TEX_RGBA" };
+    for (int i = 0; i < 3; i++) { const char* e = getenv(keys[i]); if (e && *e && strcmp(e, "0")) return keys[i]; }
+    { const char* e = getenv("TEX_MIPS"); if (e && *e == '0') return "TEX_MIPS=0"; }
+    { const char* e = getenv("TEX_PITCH"); if (e && *e == '0') return "TEX_PITCH=0"; }
+    return NULL;
+}
