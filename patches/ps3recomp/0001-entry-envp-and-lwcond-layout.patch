+/* The float depth formats (RPCS3 get_depth_clear_value): DEPTH24_D8_FLOAT is
+ * an unsigned e8m16 float in the top 24 bits (float32 bits = d24 << 7),
+ * DEPTH16_FLOAT an unsigned e4m12 one with exponent bias 16. */
+static void test_float_depth(void)
+{
+    rsx_tex_layout L;
+    float f = -1.0f;
+    rsx_texture_layout(FMT_DEPTH24F | FMT_LN, 1, 1, &L);
+    { const u8 s[4] = { 0x7F, 0x00, 0x00, 0x55 };     /* 1.0 (0x3F800000 >> 7), stencil 0x55 */
+      rsx_texture_decode(&f, 4, s, 1, 1, &L, 0); CHECK(f == 1.0f); }
+    { const u8 s[4] = { 0x7E, 0x00, 0x00, 0x00 };     /* 0.5 */
+      rsx_texture_decode(&f, 4, s, 1, 1, &L, 0); CHECK(f == 0.5f); }
+    { const u8 s[4] = { 0x7E, 0x80, 0x00, 0xFF };     /* 0.75 */
+      rsx_texture_decode(&f, 4, s, 1, 1, &L, 0); CHECK(f == 0.75f); }
+    rsx_texture_layout(FMT_DEPTH16F | FMT_LN, 1, 1, &L);
+    { const u8 s[2] = { 0xF0, 0x00 };                 /* E 15: 2^(15-16) */
+      rsx_texture_decode(&f, 4, s, 1, 1, &L, 0); CHECK(f == 0.5f); }
+    { const u8 s[2] = { 0xE8, 0x00 };                 /* E 14, M 0x800: 0.25 * 1.5 */
+      rsx_texture_decode(&f, 4, s, 1, 1, &L, 0); CHECK(f == 0.375f); }
+    { const u8 s[2] = { 0x00, 0x00 };
+      rsx_texture_decode(&f, 4, s, 1, 1, &L, 0); CHECK(f == 0.0f); }
+    { const u8 s[2] = { 0xFF, 0xFF };                 /* the largest: just under 1 */
+      rsx_texture_decode(&f, 4, s, 1, 1, &L, 0); CHECK(f > 0.9998f && f < 1.0f); }
+}
