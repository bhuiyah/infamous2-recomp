+/* Main's slot (ppu_thread_register_main): the only one without a stack of
+ * its own -- a create always allocates one (16 KB at least). Its ctx in the
+ * table holds the id alone; the live one is g_ppu_main_ctx. */
+static int pput_is_main(const ppu_thread_info* t) { return t->stack_size == 0; }
+
+/* The live context of a slot, for when there is no park record. */
+static const ppu_context* pput_live_ctx(const ppu_thread_info* t, unsigned tid, uint32_t* src)
+{
+    if (!pput_is_main(t)) { *src = PPUT_CTX_TABLE; return &t->ctx; }
+    if (g_ppu_main_ctx && g_ppu_main_ctx->thread_id == tid) { *src = PPUT_CTX_MAIN; return g_ppu_main_ctx; }
