+
+/* ---------------------------------------------------------------- load */
+
+static int keep_display(const char* sec) { return !strcmp(sec, "display"); }
+static int keep_input(const char* sec)
+{
+    return !strcmp(sec, "bindings") || !strcmp(sec, "mouse") || !strcmp(sec, "options") ||
+           !strcmp(sec, "keyboard") || !strncmp(sec, "controller", 10) || !strncmp(sec, "gamepad", 7);
+}
+
+static opt_id register_locked(const opt_def* d);
+
+static int has_active_key(const char* text)
+{
+    const char* end = text ? text + strlen(text) : NULL;
+    for (const char* p = text; p && p < end; ) {
+        size_t len, eol;
+        const char* nx = ini_next_line(p, end, &len, &eol);
+        ini_line L;
+        ini_parse_line(p, len, &L);
+        if (L.kind == INI_L_KEY) return 1;
+        p = nx;
+    }
+    return 0;
+}
+
+static void load(void)
+{
+    ini_buf raw = {0};
+    int off = 0;
+    ini_buf_clear(&s_txt_display); ini_buf_clear(&s_txt_input); ini_buf_clear(&s_txt_opts);
+    ini_buf_clear(&s_layer_display); ini_buf_clear(&s_layer_input);
+    if (find_and_read("DISPLAY_CONFIG", "display.ini", s_display_path, sizeof s_display_path, &raw, &off))
+        ini_text_decode((const unsigned char*)raw.p, raw.n, &s_txt_display);
+    if (find_and_read("PAD_CONFIG", "input.ini", s_input_path, sizeof s_input_path, &raw, &off))
+        ini_text_decode((const unsigned char*)raw.p, raw.n, &s_txt_input);
+    s_opts_exists = find_and_read("OPTIONS_CONFIG", "options.ini", s_opts_path, sizeof s_opts_path, &raw, &off);
+    if (s_opts_exists) {
+        s_opts_enc = ini_text_decode((const unsigned char*)raw.p, raw.n, &s_txt_opts);
+    } else if (!off && !s_opts_path[0]) {
+        /* not found: where the first save creates it */
+        if (path_is_dir("config")) full_path("config" OPT_SEP "options.ini", s_opts_path, sizeof s_opts_path);
+        else {
+            char ex[1024];
+            exe_dir_file("options.ini", ex, sizeof ex);
+            snprintf(s_opts_path, sizeof s_opts_path, "%s", ex[0] ? ex : "options.ini");
+        }
+    }
+    ini_buf_free(&raw);
+    ini_section_lines(s_txt_opts.p, keep_display, &s_layer_display);
+    ini_section_lines(s_txt_opts.p, keep_input, &s_layer_input);
+    /* a layer with no active "key = value" line is no layer: the home parsers
+     * then log exactly what they did before options.ini existed */
+    if (!has_active_key(s_layer_display.p)) ini_buf_clear(&s_layer_display);
+    if (!has_active_key(s_layer_input.p))   ini_buf_clear(&s_layer_input);
+    for (unsigned i = 0; i < sizeof s_builtin / sizeof s_builtin[0]; i++) register_locked(&s_builtin[i]);
+}
+
+static void ensure(void)
+{
+    if (InterlockedCompareExchange(&s_state, 2, 2) == 2) return;
+    if (InterlockedCompareExchange(&s_state, 1, 0) == 0) {
+        AcquireSRWLockExclusive(&s_lock);
+        load();
+        ReleaseSRWLockExclusive(&s_lock);
+        InterlockedExchange(&s_state, 2);
+        return;
+    }
+    while (InterlockedCompareExchange(&s_state, 2, 2) != 2) Sleep(1);
+}
+
+static void opt_logf(const char* fmt, ...)
+{
+    char b[600];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(b, sizeof b, fmt, ap);
+    va_end(ap);
+    fprintf(stderr, "[options] %s%c", b, 10);
+    fflush(stderr);
+}
+
+/* ---------------------------------------------------------------- registry */
+
+static int find_locked(const char* key)
+{
+    char a[64], b[64];
+    ini_norm(key, strlen(key), a, sizeof a);
+    const int n = (int)s_n;
+    for (int i = 0; i < n; i++) {
+        ini_norm(s_slot[i].d->key, strlen(s_slot[i].d->key), b, sizeof b);
+        if (!strcmp(a, b) || ini_name_is(a, b, s_slot[i].d->alias)) return i;
+    }
+    return -1;
+}
+
+static opt_id register_locked(const opt_def* d)
+{
+    if (!d || !d->key || !d->dflt || (int)s_n >= OPT_MAX) return -1;
+    if (find_locked(d->key) >= 0) return -1;
+    double x;
+    char c[OPT_VALLEN];
+    if (!parse_value(d, d->dflt, &x, c, sizeof c)) {
+        opt_logf("row %s: its default \"%s\" is not one of its own values: not registered", d->key, d->dflt);
+        return -1;
+    }
+    opt_slot* s = &s_slot[s_n];
+    memset(s, 0, sizeof *s);
+    s->d = d;
+    resolve(s);
+    _ReadWriteBarrier();
+    return (opt_id)InterlockedIncrement(&s_n) - 1;
+}
+
+opt_id opt_register(const opt_def* d)
+{
+    ensure();
+    AcquireSRWLockExclusive(&s_lock);
+    opt_id id = register_locked(d);
+    ReleaseSRWLockExclusive(&s_lock);
+    return id;
+}
+
+opt_id opt_find(const char* key)
+{
+    if (!key) return -1;
+    ensure();
+    AcquireSRWLockShared(&s_lock);
+    int i = find_locked(key);
+    ReleaseSRWLockShared(&s_lock);
+    return i;
+}
+
+int opt_count(void) { ensure(); return (int)s_n; }
+
+static int valid(opt_id id) { return id >= 0 && id < (int)s_n; }
+
+const opt_def* opt_def_of(opt_id id) { ensure(); return valid(id) ? s_slot[id].d : NULL; }
+
+/* ---------------------------------------------------------------- getters */
+
+double opt_f(opt_id id)
+{
+    if (!valid(id)) return 0.0;
+    return d_from_bits(s_slot[id].bits);      /* an aligned 64-bit load: atomic on x64 / arm64 */
+}
+
+int opt_i(opt_id id)
+{
+    double x = opt_f(id);
+    return (int)(x < 0 ? x - 0.5 : x + 0.5);
+}
+
+int opt_text(opt_id id, char* buf, size_t n)
+{
+    if (!valid(id) || !buf || !n) return 0;
+    AcquireSRWLockShared(&s_lock);
+    int k = snprintf(buf, n, "%s", s_slot[id].val);
+    ReleaseSRWLockShared(&s_lock);
+    return k;
+}
+
+unsigned opt_generation(void) { return (unsigned)s_generation; }
+unsigned opt_gen(opt_id id)   { return valid(id) ? (unsigned)s_slot[id].gen : 0u; }
+
+int opt_is_default(opt_id id)
+{
+    if (!valid(id)) return 1;
+    AcquireSRWLockShared(&s_lock);
+    int r = same_value(s_slot[id].d, s_slot[id].val, s_slot[id].d->dflt);
+    ReleaseSRWLockShared(&s_lock);
+    return r;
+}
+
+int opt_locked(opt_id id, const char** env_name)
+{
+    if (!valid(id)) return 0;
+    const char* l = s_slot[id].lock;
+    if (env_name) *env_name = l;
+    return l != NULL;
+}
+
+opt_source_kind opt_source(opt_id id, const char** where, int* line)
+{
+    if (where) *where = "";
+    if (line) *line = 0;
+    if (!valid(id)) return OPT_SRC_DEFAULT;
+    const opt_slot* s = &s_slot[id];
+    switch (s->src) {
+    case OPT_SRC_HOME:
+        if (where) *where = home_is(s->d, "display") ? s_display_path : s_input_path;
+        if (line) *line = s->home_line;
+        break;
+    case OPT_SRC_FILE:
+        if (where) *where = s_opts_path;
+        if (line) *line = s->file_line;
+        break;
+    case OPT_SRC_ENV:
+        if (where) *where = s->lock ? s->lock : "";
+        break;
+    default: break;
+    }
+    return s->src;
+}
+
+const char* opt_file_path(int* exists)
+{
+    ensure();
+    if (exists) *exists = s_opts_exists;
+    return s_opts_path;
+}
+
+const char* opt_layer_text(const char* home)
+{
+    ensure();
+    if (home && !strcmp(home, "display")) return s_layer_display.p ? s_layer_display.p : "";
+    if (home && !strcmp(home, "input"))   return s_layer_input.p ? s_layer_input.p : "";
+    return "";
+}
+
+/* ---------------------------------------------------------------- watchers */
+
+int opt_watch(opt_id id, opt_fn fn, void* user, int where)
+{
+    ensure();
+    if (!fn) return 0;
+    AcquireSRWLockExclusive(&s_lock);
+    int ok = 0;
+    if ((int)s_nwatch < OPT_MAXWATCH) {
+        opt_watcher* w = &s_watch[s_nwatch];
+        w->id = id; w->fn = fn; w->user = user; w->where = where;
+        _ReadWriteBarrier();
+        InterlockedIncrement(&s_nwatch);
+        ok = 1;
+    }
+    ReleaseSRWLockExclusive(&s_lock);
+    return ok;
+}
+
+static int has_render_watch(opt_id id)
+{
+    const int n = (int)s_nwatch;
+    for (int i = 0; i < n; i++)
+        if (s_watch[i].where == OPT_ON_RENDER && (s_watch[i].id == id || s_watch[i].id < 0)) return 1;
+    return 0;
+}
+
+static void call_watchers(opt_id id, const char* old_v, const char* new_v, int where)
+{
+    const int n = (int)s_nwatch;
+    for (int i = 0; i < n; i++)
+        if (s_watch[i].where == where && (s_watch[i].id == id || s_watch[i].id < 0))
+            s_watch[i].fn(id, old_v, new_v, s_watch[i].user);
+}
+
+/* ---------------------------------------------------------------- changes */
+
+/* to_lower: reset (the value the layers below options.ini give). */
+static int set_impl(opt_id id, const char* v, int to_lower)
+{
+    ensure();
+    if (!valid(id)) return OPT_SET_REFUSED;
+    opt_slot* s = &s_slot[id];
+    char canon[OPT_VALLEN], old[OPT_VALLEN], nv[OPT_VALLEN];
+    double num;
+    AcquireSRWLockExclusive(&s_lock);
+    if (s->lock) { ReleaseSRWLockExclusive(&s_lock); return OPT_SET_REFUSED; }
+    if (to_lower) v = s->home_val[0] ? s->home_val : s->d->dflt;
+    if (!parse_value(s->d, v, &num, canon, sizeof canon)) { ReleaseSRWLockExclusive(&s_lock); return OPT_SET_REFUSED; }
+    if (same_value(s->d, s->val, canon) && !(to_lower && s->src == OPT_SRC_FILE)) {
+        ReleaseSRWLockExclusive(&s_lock);
+        return OPT_SET_SAME;
+    }
+    const int changed = !same_value(s->d, s->val, canon);
+    snprintf(old, sizeof old, "%s", s->val);
+    snprintf(s->val, sizeof s->val, "%s", canon);
+    snprintf(nv, sizeof nv, "%s", canon);
+    s->src = OPT_SRC_MENU;
+    s->dirty = 1;
+    if (changed) {
+        InterlockedExchange64(&s->bits, bits_from_d(num));
+        InterlockedIncrement(&s->gen);
+        InterlockedIncrement(&s_generation);
+        if (has_render_watch(id)) { s->rpend = 1; InterlockedExchange(&s_rpend_any, 1); }
+    }
+    const int defer = s_batch > 0;
+    if (defer) s_batch_dirty = 1;
+    ReleaseSRWLockExclusive(&s_lock);
+    if (changed) {
+        call_watchers(id, old, nv, OPT_ON_SETTER);
+        opt_logf("%s = %s (was %s%s)", s->d->key, nv, old, to_lower ? "; reset" : "");   /* one line per change */
+    }
+    if (!defer) opt_save();
+    return changed ? OPT_SET_CHANGED : OPT_SET_SAME;
+}
+
+int opt_set(opt_id id, const char* v) { return set_impl(id, v, 0); }
+int opt_reset(opt_id id)              { return set_impl(id, NULL, 1); }
+
+void opt_batch(int begin)
+{
+    ensure();
+    AcquireSRWLockExclusive(&s_lock);
+    int save = 0;
+    if (begin) s_batch++;
+    else if (s_batch > 0 && --s_batch == 0) { save = s_batch_dirty; s_batch_dirty = 0; }
+    ReleaseSRWLockExclusive(&s_lock);
+    if (save) opt_save();
+}
+
+int opt_preset_apply(int preset)
+{
+    if (preset < 0 || preset >= OPT_NPRESETS) return 0;
+    ensure();
+    int changed = 0;
+    opt_batch(1);
+    for (opt_id i = 0; i < (int)s_n; i++) {
+        const char* v = s_slot[i].d->preset[preset];
+        if (v && set_impl(i, v, 0) == OPT_SET_CHANGED) changed++;
+    }
+    opt_batch(0);
+    return changed;
+}
+
+int opt_preset_current(void)
+{
+    ensure();
+    for (int p = 0; p < OPT_NPRESETS; p++) {
+        int all = 1;
+        AcquireSRWLockShared(&s_lock);
+        for (int i = 0; i < (int)s_n && all; i++) {
+            const char* v = s_slot[i].d->preset[p];
+            if (v && !same_value(s_slot[i].d, v, s_slot[i].val)) all = 0;
+        }
+        ReleaseSRWLockShared(&s_lock);
+        if (all) return p;
+    }
+    return -1;
+}
+
+int opt_restart_pending(void)
+{
+    ensure();
+    int n = 0;
+    AcquireSRWLockShared(&s_lock);
+    for (int i = 0; i < (int)s_n; i++)
+        if (s_slot[i].d->apply == OPT_RESTART && !same_value(s_slot[i].d, s_slot[i].val, s_slot[i].start)) n++;
+    ReleaseSRWLockShared(&s_lock);
+    return n;
+}
+
+int opt_restart_pending_row(opt_id id)
+{
+    if (!valid(id)) return 0;
+    AcquireSRWLockShared(&s_lock);
+    const int r = s_slot[id].d->apply == OPT_RESTART && !same_value(s_slot[id].d, s_slot[id].val, s_slot[id].start);
+    ReleaseSRWLockShared(&s_lock);
+    return r;
+}
+
+/* ---------------------------------------------------------------- saving */
+
+static const char* apply_word(opt_apply a)
+{
+    switch (a) {
+    case OPT_LIVE: return "live";
+    case OPT_FRAME: return "next frame";
+    case OPT_RELOAD: return "next frame, reloads";
+    default: return "restart";
+    }
+}
+
+/* A new options.ini: every row as its commented default, by section. */
+static void template_text(ini_buf* out)
+{
+#ifdef _WIN32
+    const char* nl = "\r\n";
+#else
+    const char* nl = "\n";
+#endif
+    ini_buf_clear(out);
+    static const char* const head[] = {
+        "# Options (ps3recomp) -- written by the game when a setting changes; you can edit it too.",
+        "#",
+        "# Read after config\\display.ini and config\\input.ini (their keys can be set here as",
+        "# well: the [display], [bindings], [mouse], [options] and [controller] sections) and",
+        "# before the environment: a variable that sets a key (FPS_CAP, IF2_ASPECT, DISPLAY_CFG,",
+        "# OPTIONS_CFG=\"k=v|k=v\", ...) wins and locks it. OPTIONS_CONFIG=<file> uses another file,",
+        "# OPTIONS_CONFIG=none none (tools\\run.ps1 test runs: -Options reads this one).",
+        "#",
+        "# Every line below is commented out and shows the BUILT-IN DEFAULT (the PS3 picture",
+        "# and today's behaviour). A changed setting is uncommented; set back, it is commented",
+        "# out again. Text after '#' or ';' is a comment. When a change applies is noted per key.",
+    };
+    for (unsigned i = 0; i < sizeof head / sizeof head[0]; i++) { ini_buf_puts(out, head[i]); ini_buf_puts(out, nl); }
+    const char* done[32];
+    int nd = 0;
+    for (int i = 0; i < (int)s_n; i++) {
+        const char* sec = s_slot[i].d->section ? s_slot[i].d->section : "options";
+        int seen = 0;
+        for (int k = 0; k < nd; k++) if (!strcmp(done[k], sec)) seen = 1;
+        if (seen || nd >= 32) continue;
+        done[nd++] = sec;
+        ini_buf_puts(out, nl);
+        ini_buf_puts(out, "["); ini_buf_puts(out, sec); ini_buf_puts(out, "]"); ini_buf_puts(out, nl);
+        for (int j = i; j < (int)s_n; j++) {
+            const opt_def* d = s_slot[j].d;
+            if (strcmp(d->section ? d->section : "options", sec) || (d->flags & OPT_F_HIDDEN)) continue;
+            char line[400];
+            int w = snprintf(line, sizeof line, "# %s = %s", d->key, d->dflt);
+            while (w < 34 && w < (int)sizeof line - 1) line[w++] = ' ';
+            line[w] = 0;
+            ini_buf_puts(out, line);
+            snprintf(line, sizeof line, " # %s (%s)", d->label ? d->label : d->key, apply_word(d->apply));
+            ini_buf_puts(out, line);
+            ini_buf_puts(out, nl);
+        }
+    }
+}
+
+int opt_save(void)
+{
+    ensure();
+    static int said_ro = 0;
+    AcquireSRWLockExclusive(&s_lock);
+    int any = 0;
+    for (int i = 0; i < (int)s_n; i++) any |= s_slot[i].dirty;
+    if (!any) { ReleaseSRWLockExclusive(&s_lock); return 0; }
+    if (!s_opts_path[0]) {
+        for (int i = 0; i < (int)s_n; i++) s_slot[i].dirty = 0;
+        ReleaseSRWLockExclusive(&s_lock);
+        if (!said_ro++) opt_logf("OPTIONS_CONFIG=none: changes apply to this run only, nothing is saved");
+        return 0;
+    }
+    ini_buf cur = {0}, nxt = {0};
+    if (s_opts_exists) ini_buf_puts(&cur, s_txt_opts.p ? s_txt_opts.p : "");
+    else template_text(&cur);
+    for (int i = 0; i < (int)s_n; i++) {
+        opt_slot* s = &s_slot[i];
+        if (!s->dirty) continue;
+        const opt_def* d = s->d;
+        const char* below = s->home_val[0] ? s->home_val : d->dflt;
+        /* aliases too: the line resolve() read may spell the key another way */
+        if (same_value(d, s->val, below)) ini_reset_a(cur.p, d->section, d->key, d->alias, d->dflt, &nxt);
+        else                              ini_set_a(cur.p, d->section, d->key, d->alias, s->val, &nxt);
+        ini_buf t = cur; cur = nxt; nxt = t;
+    }
+    int ok = file_replace(s_opts_path, cur.p, s_opts_enc);
+    if (ok) {
+        for (int i = 0; i < (int)s_n; i++) s_slot[i].dirty = 0;
+        ini_buf_clear(&s_txt_opts);
+        ini_buf_puts(&s_txt_opts, cur.p);
+        s_opts_exists = 1;
+    }
+    ini_buf_free(&cur); ini_buf_free(&nxt);
+    ReleaseSRWLockExclusive(&s_lock);
+    if (!ok) opt_logf("could not write %s: the change applies to this run only", s_opts_path);
+    return ok ? 1 : -1;
+}
+
+/* ---------------------------------------------------------------- render point */
+
+static void test_file_poll(void);
+
+void opt_render_point(void)
+{
+    static int first = 1;
+    if (first) { first = 0; opt_log_summary(); }
+    if (InterlockedCompareExchange(&s_rpend_any, 0, 0)) {
+        InterlockedExchange(&s_rpend_any, 0);
+        for (opt_id i = 0; i < (int)s_n; i++) {
+            char old[OPT_VALLEN], nv[OPT_VALLEN];
+            AcquireSRWLockExclusive(&s_lock);
+            int p = s_slot[i].rpend;
+            if (p) {
+                s_slot[i].rpend = 0;
+                snprintf(old, sizeof old, "%s", s_slot[i].rold);
+                snprintf(nv, sizeof nv, "%s", s_slot[i].val);
+                snprintf(s_slot[i].rold, sizeof s_slot[i].rold, "%s", nv);
+                if (same_value(s_slot[i].d, old, nv)) p = 0;   /* changed and back: nothing to apply */
+            }
+            ReleaseSRWLockExclusive(&s_lock);
+            if (p) call_watchers(i, old, nv, OPT_ON_RENDER);
+        }
+    }
+    test_file_poll();
+}
+
+/* ---------------------------------------------------------------- summary */
+
+void opt_log_summary(void)
+{
+    static volatile LONG done = 0;
+    ensure();
+    if (InterlockedExchange(&done, 1)) return;
+    if (!s_opts_path[0]) opt_logf("OPTIONS_CONFIG=none: no options.ini (changes are not saved)");
+    else opt_logf("options.ini: %s%s", s_opts_path, s_opts_exists ? "" : " (not there yet: written on the first change)");
+    char line[2048];
+    int k = snprintf(line, sizeof line, "non-default:");
+    int n = 0;
+    AcquireSRWLockShared(&s_lock);
+    for (int i = 0; i < (int)s_n; i++) {
+        const opt_slot* s = &s_slot[i];
+        if (same_value(s->d, s->val, s->d->dflt)) continue;
+        char where[160];
+        switch (s->src) {
+        case OPT_SRC_HOME: snprintf(where, sizeof where, "%s:%d", home_is(s->d, "display") ? "display.ini" : "input.ini",
+                                    s->home_line); break;
+        case OPT_SRC_FILE: snprintf(where, sizeof where, "options.ini:%d", s->file_line); break;
+        case OPT_SRC_ENV:  snprintf(where, sizeof where, "env %s", s->lock ? s->lock : "?"); break;
+        default:           snprintf(where, sizeof where, "set"); break;
+        }
+        if (k < (int)sizeof line - 200) k += snprintf(line + k, sizeof line - (size_t)k, " %s=%s (%s)", s->d->key, s->val, where);
+        n++;
+    }
+    int locked = 0;
+    for (int i = 0; i < (int)s_n; i++) locked += s_slot[i].lock != NULL;
+    const int rows = (int)s_n;
+    ReleaseSRWLockShared(&s_lock);
+    if (n) opt_logf("%s", line);
+    else   opt_logf("every setting at its built-in default (%d rows%s)", rows, locked ? ", some locked by env" : "");
+}
+
+/* ---------------------------------------------------------------- system pause */
+
+/* libs/input/cellPad.c */
+extern void cellPad_host_intercept(int on, int report_flag);
+extern int  cellPad_host_intercepted(void);
+
+static volatile LONG s_intercepted;
+
+void options_set_intercepted(int on)
+{
+    ensure();
+    on = on ? 1 : 0;
+    if (InterlockedExchange(&s_intercepted, on) == on) return;
+    static opt_id pm = -2;
+    if (pm == -2) pm = opt_find("pause_mode");
+    const int flag = on && (pm < 0 || opt_i(pm) == 0);    /* 0 = system */
+    cellPad_host_intercept(on, flag);
+}
+
+int options_intercepted(void) { return (int)s_intercepted; }
+
+/* ---------------------------------------------------------------- OPTIONS_TEST_FILE */
+
+static void test_file_poll(void)
+{
+    static int on = -1;
+    static char path[1024];
+    static unsigned long long next;
+    if (on < 0) {
+        const char* e = getenv("OPTIONS_TEST_FILE");
+        on = (e && *e) ? 1 : 0;
+        if (on) { snprintf(path, sizeof path, "%s", e); opt_logf("OPTIONS_TEST_FILE=%s (test scaffolding)", e); }
+    }
+    if (!on) return;
+    const unsigned long long t = now_ms();
+    if (t < next) return;
+    next = t + 100;
+    ini_buf raw = {0}, txt = {0};
+    if (!file_read_all(path, &raw)) return;
+    remove(path);
+    ini_text_decode((const unsigned char*)raw.p, raw.n, &txt);
+    ini_buf_free(&raw);
+    for (const char* p = txt.p; p && *p; ) {
+        const char* e = p;
+        while (*e && *e != '\n' && *e != '|') e++;
+        char item[200], key[64], val[OPT_VALLEN];
+        size_t n = (size_t)(e - p);
+        if (n >= sizeof item) n = sizeof item - 1;
+        memcpy(item, p, n); item[n] = 0;
+        p = *e ? e + 1 : e;
+        char* eq = strchr(item, '=');
+        if (!eq) continue;
+        *eq = 0;
+        trim_copy(item, key, sizeof key);
+        trim_copy(eq + 1, val, sizeof val);
+        if (!strcmp(key, "intercept")) {
+            options_set_intercepted(atoi(val));
+            opt_logf("test: intercept = %d", atoi(val));
+            continue;
+        }
+        if (!strcmp(key, "reset")) {
+            const opt_id id = opt_find(val);
+            const int r = opt_reset(id);
+            char now[OPT_VALLEN] = "";
+            opt_text(id, now, sizeof now);
+            opt_logf("test: reset %s -> %s (%s)", val, now, r == OPT_SET_CHANGED ? "changed" : r ? "same" : "refused");
+            continue;
+        }
+        const opt_id id = opt_find(key);
+        const int r = id >= 0 ? opt_set(id, val) : OPT_SET_REFUSED;
+        opt_logf("test: %s = %s (%s)", key, val,
+                 id < 0 ? "no such setting" : r == OPT_SET_CHANGED ? "changed" : r == OPT_SET_SAME ? "same" : "refused");
+    }
+    ini_buf_free(&txt);
+}
diff --git a/libs/system/tests/test_options_store.c b/libs/system/tests/test_options_store.c
new file mode 100644
index 0000000..1dd0098
--- /dev/null
+++ b/libs/system/tests/test_options_store.c
@@ -0,0 +1,747 @@
+/*
+ * ps3recomp - the settings store (libs/system/options.c) and its
+ * comment-preserving ini editor (libs/system/opt_ini.h). No game data: the
+ * files are written by the test into %TEMP%; with a config folder argument it
+ * also round-trips every commented key of the project's own display.ini and
+ * input.ini (read only) and checks the real parsers agree.
+ *
+ * From external/ps3recomp (Windows; the store's file layer is Win32 here):
+ *   clang-cl /nologo /W3 -D_CRT_SECURE_NO_WARNINGS -I include -I libs/system -I libs/video
+ *     -I libs/input libs/system/tests/test_options_store.c libs/system/options.c /Fe:T/tos.exe
+ *   T/tos.exe [<project>\config]
+ * The suite starts itself again for the cases that need a fresh process
+ * (OPTIONS_CONFIG=none, a new options.ini from the template, a UTF-16 file).
+ *
+ * Covers: in-place edits keep comments, columns, line endings and encodings;
+ * section-scoped edits; the layers (default < display.ini/input.ini <
+ * options.ini < env) and where each value came from; env locks (single and
+ * multi variables) are refused and never saved; save on every change, and a
+ * file set back to its values is byte-identical; reset goes to what the lower
+ * layers give; presets apply / are detected / PS3 Original = defaults;
+ * callbacks once per change (setter and render point), none on a no-op; late
+ * registration; restart-pending; the system pause API; the layer text the
+ * home parsers read (display_cfg.h, pad_kbm.h agree).
+ */
+#include "ps3emu/options.h"
+#include "opt_ini.h"
+#include "display_cfg.h"
+#include "pad_kbm.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+#include <process.h>
+#endif
+
+static int g_fail, g_checks;
+#define CHECK(c) do { g_checks++; if (!(c)) { printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #c); g_fail++; } } while (0)
+#define CHECK_STR(a, b) do { const char* _a = (a); const char* _b = (b); g_checks++; \
+    if (!_a || strcmp(_a, _b)) { printf("FAIL %s:%d  %s = \"%s\", want \"%s\"\n", __FILE__, __LINE__, #a, \
+                                        _a ? _a : "(null)", _b); g_fail++; } } while (0)
+#define CHECK_EQ(a, b) do { long _a = (long)(a), _b = (long)(b); g_checks++; \
+    if (_a != _b) { printf("FAIL %s:%d  %s = %ld, want %ld\n", __FILE__, __LINE__, #a, _a, _b); g_fail++; } } while (0)
+
+/* ---------------------------------------------------------------- stubs: libs/input/cellPad.c */
+static int g_icpt_on = -1, g_icpt_flag = -1, g_icpt_calls;
+void cellPad_host_intercept(int on, int report_flag) { g_icpt_on = on; g_icpt_flag = report_flag; g_icpt_calls++; }
+int  cellPad_host_intercepted(void) { return g_icpt_on == 1; }
+
+/* ---------------------------------------------------------------- helpers */
+static char g_dir[1024];
+
+static void path_of(const char* name, char* out, size_t n) { snprintf(out, n, "%s\\%s", g_dir, name); }
+
+static void write_bytes(const char* name, const void* b, size_t n)
+{
+    char p[1100];
+    path_of(name, p, sizeof p);
+    FILE* f = fopen(p, "wb");
+    if (!f) { printf("cannot write %s\n", p); exit(2); }
+    fwrite(b, 1, n, f);
+    fclose(f);
+}
+static void write_text(const char* name, const char* t) { write_bytes(name, t, strlen(t)); }
+
+static char* read_bytes(const char* path, size_t* n)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) { *n = 0; return NULL; }
+    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);
+    char* b = (char*)malloc((size_t)sz + 1);
+    *n = fread(b, 1, (size_t)sz, f);
+    b[*n] = 0;
+    fclose(f);
+    return b;
+}
+static char* read_file(const char* name)
+{
+    char p[1100]; size_t n;
+    path_of(name, p, sizeof p);
+    return read_bytes(p, &n);
+}
+static int file_exists(const char* name)
+{
+    char p[1100];
+    path_of(name, p, sizeof p);
+    FILE* f = fopen(p, "rb");
+    if (f) fclose(f);
+    return f != NULL;
+}
+
+/* lines that differ (line by line); show prints them */
+static int diff_lines(const char* a, const char* b, int show)
+{
+    int d = 0, ln = 1;
+    while (*a || *b) {
+        const char* ea = a; while (*ea && *ea != '\n') ea++;
+        const char* eb = b; while (*eb && *eb != '\n') eb++;
+        if ((ea - a) != (eb - b) || memcmp(a, b, (size_t)(ea - a))) {
+            d++;
+            if (show) printf("    line %d:\n      - %.*s\n      + %.*s\n", ln, (int)(ea - a), a, (int)(eb - b), b);
+        }
+        a = *ea ? ea + 1 : ea; b = *eb ? eb + 1 : eb; ln++;
+    }
+    return d;
+}
+
+static void setenv_(const char* k, const char* v) { _putenv_s(k, v ? v : ""); }
+
+static int run_child(const char* self, const char* mode)
+{
+    char cmd[1400];
+    snprintf(cmd, sizeof cmd, "\"\"%s\" %s\"", self, mode);
+    fflush(stdout);
+    return system(cmd);
+}
+
+/* ---------------------------------------------------------------- part A: the ini editor */
+static void test_ini(void)
+{
+    ini_buf o = {0}, o2 = {0};
+    printf("A. ini editor\n");
+    /* insertion lands inside its section */
+    CHECK_EQ(ini_set("[a]\nx = 1\n\n[b]\ny = 2\n", "a", "z", "3", &o), INI_SET_APPENDED);
+    CHECK_STR(o.p, "[a]\nx = 1\nz = 3\n\n[b]\ny = 2\n");
+    /* section scope: the [graphics] line is someone else's */
+    CHECK_EQ(ini_set("[graphics]\r\nfps_cap = 1\r\n[performance]\r\n# fps_cap = 0\r\n", "performance", "fps_cap", "60", &o),
+             INI_SET_UNCOMMENTED);
+    CHECK_STR(o.p, "[graphics]\r\nfps_cap = 1\r\n[performance]\r\nfps_cap = 60\r\n");
+    /* without a section (display.ini / input.ini): the last active line anywhere */
+    CHECK_EQ(ini_set("[x]\nk = 1\n[y]\nk = 2\n", NULL, "k", "3", &o), INI_SET_REPLACED);
+    CHECK_STR(o.p, "[x]\nk = 1\n[y]\nk = 3\n");
+    /* in place: the trailing comment keeps its column, CRLF stays */
+    CHECK_EQ(ini_set("[mouse]\r\nmouse_sensitivity = 2.25   # my value\r\n", "mouse", "mouse_sensitivity", "1.5", &o),
+             INI_SET_REPLACED);
+    CHECK_STR(o.p, "[mouse]\r\nmouse_sensitivity = 1.5    # my value\r\n");
+    CHECK_EQ(ini_reset(o.p, "mouse", "mouse_sensitivity", "1.0", &o2), 1);
+    CHECK_STR(o2.p, "[mouse]\r\n# mouse_sensitivity = 1.0    # my value\r\n");
+    /* same value: unchanged */
+    CHECK_EQ(ini_set("a = 1\n", NULL, "a", "1", &o), INI_SET_UNCHANGED);
+    /* a missing section is created at the end, with the file's line ending */
+    CHECK_EQ(ini_set("[graphics]\r\nanisotropy = 16\r\n", "overlay", "menu_key", "F1", &o), INI_SET_APPENDED);
+    CHECK_STR(o.p, "[graphics]\r\nanisotropy = 16\r\n\r\n[overlay]\r\nmenu_key = F1\r\n");
+    CHECK_EQ(ini_set("", "graphics", "anisotropy", "16", &o), INI_SET_APPENDED);
+    CHECK_STR(o.p, "[graphics]\nanisotropy = 16\n");
+    /* names ignore case, '_', '-', blanks; prose comments are not keys */
+    CHECK_EQ(ini_set("# Note: x = 1 here\n# set Mouse-Sensitivity=2\n# MOUSE_SENSITIVITY = 1.0\n", NULL,
+                     "mouse_sensitivity", "3", &o), INI_SET_UNCOMMENTED);
+    CHECK_STR(o.p, "# Note: x = 1 here\n# set Mouse-Sensitivity=2\nMOUSE_SENSITIVITY = 3\n");
+    /* ini_get: last active line, aliases, section scope, line numbers */
+    {
+        char v[32];
+        const char* t = "[mouse]\nsensitivity = 2\n[graphics]\nmouse_sensitivity = 9\n";
+        CHECK_EQ(ini_get(t, "mouse", "mouse_sensitivity", "sensitivity", v, sizeof v), 2);
+        CHECK_STR(v, "2");
+        CHECK_EQ(ini_get(t, NULL, "mouse_sensitivity", "sensitivity", v, sizeof v), 4);
+        CHECK_STR(v, "9");
+        CHECK_EQ(ini_get(t, "display", "mouse_sensitivity", NULL, v, sizeof v), 0);
+    }
+    /* aliases: the active line ini_get reads is the one set (its name kept), and a
+     * reset comments out every spelling -- else the old value came back next launch */
+    {
+        const char* t = "[performance]\r\nframe_limit = 30   # mine\r\n";
+        CHECK_EQ(ini_set_a(t, "performance", "fps_cap", "frame_limit", "60", &o), INI_SET_REPLACED);
+        CHECK_STR(o.p, "[performance]\r\nframe_limit = 60   # mine\r\n");
+        CHECK_EQ(ini_reset_a(o.p, "performance", "fps_cap", "frame_limit", "0", &o2), 1);
+        CHECK_STR(o2.p, "[performance]\r\n# frame_limit = 0    # mine\r\n");
+        char v[16];
+        CHECK_EQ(ini_get(o2.p, "performance", "fps_cap", "frame_limit", v, sizeof v), 0);
+        CHECK_EQ(ini_reset_a("[p]\nfps_cap = 5\nframe_limit = 7\n", "p", "fps_cap", "frame_limit", "0", &o2), 2);
+        CHECK_STR(o2.p, "[p]\n# fps_cap = 0\n# frame_limit = 0\n");
+        CHECK_EQ(ini_set_a("[p]\n# frame_limit = 0\n", "p", "fps_cap", "frame_limit", "40", &o), INI_SET_UNCOMMENTED);
+        CHECK_STR(o.p, "[p]\nframe_limit = 40\n");
+        /* without aliases an alias line is not this key */
+        CHECK_EQ(ini_set(t, "performance", "fps_cap", "60", &o), INI_SET_APPENDED);
+        CHECK_STR(o.p, "[performance]\r\nframe_limit = 30   # mine\r\nfps_cap = 60\r\n");
+    }
+    /* encodings round-trip byte for byte */
+    {
+        ini_buf u = {0}, t = {0}, back = {0};
+        const char* src = "# Caf\xC3\xA9 \xE2\x80\x94 comment \xF0\x9F\x98\x80\r\n[display]\r\n# aspect     = auto\r\n";
+        for (int enc = INI_ENC_UTF8; enc <= INI_ENC_UTF16BE; enc++) {
+            ini_text_encode(src, enc, &u);
+            CHECK_EQ(ini_text_decode((const unsigned char*)u.p, u.n, &t), enc);
+            CHECK_STR(t.p, src);
+            ini_text_encode(t.p, enc, &back);
+            CHECK(back.n == u.n && !memcmp(back.p, u.p, u.n));
+        }
+        ini_buf_free(&u); ini_buf_free(&t); ini_buf_free(&back);
+    }
+    ini_buf_free(&o); ini_buf_free(&o2);
+}
+
+/* every commented key of a shipped file: set, then reset, byte-identical */
+static void test_shipped(const char* dir)
+{
+    char p[1100];
+    printf("A2. the project's display.ini / input.ini (read only): %s\n", dir);
+    const char* names[2] = { "display.ini", "input.ini" };
+    int keys = 0;
+    for (int f = 0; f < 2; f++) {
+        size_t n;
+        snprintf(p, sizeof p, "%s\\%s", dir, names[f]);
+        char* raw = read_bytes(p, &n);
+        if (!raw) { printf("  cannot read %s\n", p); CHECK(0); continue; }
+        ini_buf t = {0}, o = {0}, o2 = {0};
+        ini_text_decode((const unsigned char*)raw, n, &t);
+        const char* end = t.p + strlen(t.p);
+        for (const char* q = t.p; q < end; ) {
+            size_t len, eol;
+            const char* nx = ini_next_line(q, end, &len, &eol);
+            ini_line L; ini_parse_line(q, len, &L);
+            if (L.kind == INI_L_CKEY) {
+                char key[64], dv[96];
+                size_t kn = L.name_e - L.name_b; if (kn >= sizeof key) kn = sizeof key - 1;
+                memcpy(key, q + L.name_b, kn); key[kn] = 0;
+                size_t vn = L.val_e - L.val_b; if (vn >= sizeof dv) vn = sizeof dv - 1;
+                memcpy(dv, q + L.val_b, vn); dv[vn] = 0;
+                if (ini_set(t.p, NULL, key, "X", &o) == INI_SET_UNCOMMENTED) {
+                    int d = diff_lines(t.p, o.p, 0);
+                    if (d != 1) { printf("    %s: %d lines changed\n", key, d); CHECK(d == 1); }
+                    if (f == 0) {   /* the real display.ini parser sees it */
+                        static DisplayCfg c; static char b[32768];
+                        memset(&c, 0, sizeof c);
+                        snprintf(b, sizeof b, "%s", o.p);
+                        dcfg_parse_text(&c, b, 0, NULL, NULL);
+                        CHECK_STR(dcfg_get(&c, key), "X");
+                    }
+                    CHECK_EQ(ini_reset(o.p, NULL, key, dv, &o2), 1);
+                    if (!(o2.n == strlen(t.p) && !memcmp(o2.p, t.p, o2.n))) {
+                        printf("    %s: reset not byte-identical\n", key); diff_lines(t.p, o2.p, 1); CHECK(0);
+                    }
+                    keys++;
+                }
+            }
+            q = nx;
+        }
+        /* input.ini: the real kbm parser reads an edit */
+        if (f == 1) {
+            CHECK_EQ(ini_set(t.p, NULL, "mouse_sensitivity", "1.5", &o), INI_SET_UNCOMMENTED);
+            KbmConfig k; kbm_config_defaults(&k);
+            CHECK_EQ(kbm_parse_text(&k, o.p, 0, NULL, NULL), 0);
+            CHECK(fabs(k.mouse_sens - 1.5f) < 1e-6);
+        }
+        ini_buf_free(&t); ini_buf_free(&o); ini_buf_free(&o2);
+        free(raw);
+    }
+    printf("    %d commented keys set and reset\n", keys);
+    CHECK(keys >= 40);
+}
+
+/* ---------------------------------------------------------------- part B: the store */
+static int g_set_calls, g_render_calls;
+static char g_last_old[96], g_last_new[96];
+static void on_set(opt_id id, const char* o, const char* n, void* u)
+{
+    (void)id; (void)u; g_set_calls++;
+    snprintf(g_last_old, sizeof g_last_old, "%s", o); snprintf(g_last_new, sizeof g_last_new, "%s", n);
+}
+static void on_render(opt_id id, const char* o, const char* n, void* u)
+{
+    (void)id; (void)u; g_render_calls++;
+    snprintf(g_last_old, sizeof g_last_old, "%s", o); snprintf(g_last_new, sizeof g_last_new, "%s", n);
+}
+
+static const char* kDisplayIni =
+    "# test display.ini\r\n"
+    "[display]\r\n"
+    "# aspect = auto\r\n"
+    "fullscreen = 0\r\n"
+    "# window = auto\r\n"
+    "monitor = 2\r\n"
+    "show_fps = 1\r\n";
+static const char* kInputIni =
+    "[mouse]\r\n"
+    "# mouse_sensitivity = 1.0\r\n"
+    "mouse_invert_y = 1\r\n"
+    "[controller]\r\n"
+    "# deadzone = auto\r\n"
+    "rumble = 50\r\n";
+static const char* kOptionsIni =
+    "# my options\r\n"
+    "[performance]\r\n"
+    "fps_cap = 60          # capped\r\n"
+    "# vsync = 1\r\n"
+    "[graphics]\r\n"
+    "# anisotropy = game\r\n"
+    "late_key = b\r\n"
+    "[display]\r\n"
+    "monitor = 1       ; back to the first\r\n"
+    "[mouse]\r\n"
+    "mouse_sensitivity = 2.5\r\n";
+
+static const opt_def kLate = { "late_key", NULL, "options", "graphics", "Test", "Test", "Late", "",
+    OPT_ENUM, OPT_LIVE, "a|b", "A|B", 0, 0, 0, "a", NULL, NULL, { NULL, NULL, NULL, NULL, NULL }, 0, "test", NULL };
+static const opt_def kQ = { "test_q", NULL, "options", "graphics", "Test", "Test", "Quality", "",
+    OPT_INT, OPT_FRAME, NULL, NULL, 0, 4, 1, "0", NULL, NULL, { "0", "1", "2", "3", "4" }, 0, "test", NULL };
+/* the overlay's FPS counter row: an off / on enum whose home is display.ini's show_fps (the window menu's key) */
+static const opt_def kFpsRow = { "fps_counter", "show_fps", "display", "overlay", "Frame", "Counter", "FPS", "",
+    OPT_ENUM, OPT_LIVE, "off|on|detailed", NULL, 0, 0, 0, "off", NULL, "DISPLAY_CFG", { NULL, NULL, NULL, NULL, NULL },
+    0, "test", NULL };
+static const opt_def kBadDefault = { "bad_default", NULL, "options", "graphics", "Test", "Test", "Bad", "",
+    OPT_INT, OPT_LIVE, NULL, NULL, 0, 4, 1, "9", NULL, NULL, { NULL, NULL, NULL, NULL, NULL }, 0, "test", NULL };
+
+static void test_store(const char* self)
+{
+    char opath[1100], v[96];
+    printf("B. the store: layers, env locks, saving, presets, callbacks\n");
+    write_text("display.ini", kDisplayIni);
+    write_text("input.ini", kInputIni);
+    write_text("options.ini", kOptionsIni);
+    write_text("options.ini.tmp", "junk left by a crash");      /* must not matter */
+    char p[1100];
+    path_of("display.ini", p, sizeof p); setenv_("DISPLAY_CONFIG", p);
+    path_of("input.ini", p, sizeof p);   setenv_("PAD_CONFIG", p);
+    path_of("options.ini", opath, sizeof opath); setenv_("OPTIONS_CONFIG", opath);
+    setenv_("PRESENT_SYNC", "2");
+    setenv_("DISPLAY_CFG", "window=1920x810|dpi_aware=1");
+    setenv_("OPTIONS_CFG", "pause_mode=off");
+    setenv_("PAD_DEADZONE", "");
+    setenv_("TEX_ANISO", "16");   /* the game's CONTROL0 anisotropy switch: must not touch the row */
+
+    /* layers and sources */
+    const opt_id fps = opt_find("fps_cap"), vs = opt_find("vsync"), win = opt_find("window"),
+                 mon = opt_find("monitor"), inv = opt_find("mouse_invert_y"), rum = opt_find("rumble"),
+                 an = opt_find("anisotropy"), pm = opt_find("pause_mode"), fs = opt_find("fullscreen"),
+                 ms = opt_find("sensitivity"), dz = opt_find("deadzone");
+    CHECK(fps >= 0 && vs >= 0 && win >= 0 && mon >= 0 && inv >= 0 && rum >= 0 && an >= 0 && pm >= 0 && fs >= 0);
+    CHECK(ms >= 0 && ms == opt_find("mouse_sensitivity") && ms == opt_find("Mouse-Sensitivity"));
+    CHECK_EQ(opt_find("no_such_key"), -1);
+    const char* where; int line;
+    CHECK_EQ(opt_i(fps), 60);
+    CHECK_EQ(opt_source(fps, &where, &line), OPT_SRC_FILE); CHECK_EQ(line, 3);
+    CHECK_EQ(opt_i(vs), 2);   CHECK_EQ(opt_source(vs, &where, &line), OPT_SRC_ENV); CHECK_STR(where, "PRESENT_SYNC");
+    opt_text(win, v, sizeof v); CHECK_STR(v, "1920x810");
+    CHECK(opt_locked(win, &where)); CHECK_STR(where, "DISPLAY_CFG");
+    opt_text(mon, v, sizeof v); CHECK_STR(v, "1");                        /* options.ini over display.ini */
+    CHECK_EQ(opt_source(mon, &where, &line), OPT_SRC_FILE);
+    CHECK_EQ(opt_i(inv), 1);  CHECK_EQ(opt_source(inv, &where, &line), OPT_SRC_HOME); CHECK_EQ(line, 3);
+    CHECK_EQ(opt_i(rum), 50);
+    CHECK(opt_f(ms) == 2.5);                                              /* options.ini [mouse] */
+    CHECK_EQ(opt_i(an), 0);   CHECK(opt_is_default(an));   CHECK(!opt_locked(an, NULL));   /* TEX_ANISO is not its env */
+    CHECK_EQ(opt_i(fs), 0);   CHECK(opt_is_default(fs));                  /* explicit default in display.ini */
+    CHECK_EQ(opt_i(dz), -1);                                              /* "auto": the first extra word */
+    CHECK_EQ(opt_i(pm), 1);   CHECK(opt_locked(pm, &where)); CHECK_STR(where, "OPTIONS_CFG");
+    CHECK(!opt_locked(fps, NULL));
+
+    /* the layers the home parsers read */
+    {
+        const char* ld = opt_layer_text("display");
+        CHECK(strstr(ld, "monitor = 1") != NULL);
+        CHECK(strstr(ld, "fps_cap") == NULL && strstr(ld, "mouse_sensitivity") == NULL);
+        static DisplayCfg c; static char b[8192];
+        memset(&c, 0, sizeof c);
+        snprintf(b, sizeof b, "%s", kDisplayIni); dcfg_parse_text(&c, b, 0, NULL, NULL);
+        CHECK_EQ(dcfg_parse_text(&c, ld, 0, NULL, NULL), 0);
+        CHECK_STR(dcfg_get(&c, "monitor"), "1");
+        CHECK_STR(dcfg_get(&c, "fullscreen"), "0");
+        CHECK(dcfg_get(&c, "fpscap") == NULL);
+        const char* li = opt_layer_text("input");
+        CHECK(strstr(li, "mouse_sensitivity = 2.5") != NULL && strstr(li, "monitor") == NULL);
+        KbmConfig k; kbm_config_defaults(&k);
+        CHECK_EQ(kbm_parse_text(&k, li, 0, NULL, NULL), 0);
+        CHECK(fabs(k.mouse_sens - 2.5f) < 1e-6);
+        CHECK_STR(opt_layer_text("nothing"), "");
+    }
+
+    /* registration rules */
+    CHECK_EQ(opt_register(&kBadDefault), -1);
+    {
+        opt_def dup = kLate; dup.key = "FPS-Cap";
+        CHECK_EQ(opt_register(&dup), -1);
+    }
+    const opt_id late = opt_register(&kLate);                             /* resolves from options.ini */
+    CHECK(late >= 0);
+    opt_text(late, v, sizeof v); CHECK_STR(v, "b");
+    CHECK_EQ(opt_source(late, &where, &line), OPT_SRC_FILE);
+    const opt_id q = opt_register(&kQ);
+    CHECK(q >= 0);
+    /* an enum with off / on choices takes the bool words: display.ini "show_fps = 1" is fps_counter = on */
+    {
+        const opt_id fr = opt_register(&kFpsRow);
+        CHECK(fr >= 0);
+        opt_text(fr, v, sizeof v); CHECK_STR(v, "on");
+        CHECK_EQ(opt_source(fr, &where, &line), OPT_SRC_HOME); CHECK_EQ(line, 7);
+        CHECK(!opt_locked(fr, NULL));
+        CHECK_EQ(opt_set(fr, "1"), OPT_SET_SAME);
+        CHECK_EQ(opt_set(fr, "Yes"), OPT_SET_SAME);
+        CHECK_EQ(opt_set(late, "1"), OPT_SET_REFUSED);                      /* a|b has no on / off */
+        CHECK_EQ(opt_set(late, "true"), OPT_SET_REFUSED);
+    }
+
+    /* changes: saved at once, one line each, comments kept */
+    CHECK(opt_watch(fps, on_set, NULL, OPT_ON_SETTER));
+    CHECK(opt_watch(an, on_render, NULL, OPT_ON_RENDER));
+    const unsigned g0 = opt_generation();
+    CHECK_EQ(opt_set(fps, "30"), OPT_SET_CHANGED);
+    CHECK_EQ(g_set_calls, 1); CHECK_STR(g_last_old, "60"); CHECK_STR(g_last_new, "30");
+    CHECK(opt_generation() != g0);
+    CHECK_EQ(opt_i(fps), 30);
+    CHECK_EQ(opt_set(fps, "30.0"), OPT_SET_SAME);                         /* the same number */
+    CHECK_EQ(g_set_calls, 1);
+    CHECK_EQ(opt_set(fps, "abc"), OPT_SET_REFUSED);
+    CHECK_EQ(opt_set(fps, "1001"), OPT_SET_REFUSED);
+    CHECK_EQ(opt_set(opt_find("volume"), "12.5"), OPT_SET_REFUSED);       /* an INT row */
+    CHECK_EQ(opt_set(fps, "37.5"), OPT_SET_CHANGED);                      /* fps_cap is FLOAT: half of 75 Hz */
+    CHECK(fabs(opt_f(fps) - 37.5) < 1e-9);
+    CHECK_EQ(opt_set(fps, "30"), OPT_SET_CHANGED);
+    CHECK_EQ(g_set_calls, 3);
+    {
+        char* t = read_file("options.ini");
+        CHECK(t && strstr(t, "fps_cap = 30          # capped\r\n") != NULL);
+        CHECK_EQ(diff_lines(kOptionsIni, t, 1), 1);
+        free(t);
+    }
+    CHECK_EQ(opt_set(vs, "0"), OPT_SET_REFUSED);                          /* env-locked */
+    CHECK_EQ(opt_i(vs), 2);
+    CHECK_EQ(opt_set(an, "16"), OPT_SET_CHANGED);
+    CHECK_EQ(g_render_calls, 0);                                          /* queued for the render point */
+    CHECK_EQ(opt_i(an), 4);
+    opt_render_point();
+    CHECK_EQ(g_render_calls, 1); CHECK_STR(g_last_old, "game"); CHECK_STR(g_last_new, "16");
+    opt_render_point();
+    CHECK_EQ(g_render_calls, 1);                                          /* once */
+    CHECK_EQ(opt_set(an, "banana"), OPT_SET_REFUSED);
+    {
+        char* t = read_file("options.ini");
+        CHECK(t && strstr(t, "\r\nanisotropy = 16\r\n") != NULL);
+        CHECK_EQ(diff_lines(kOptionsIni, t, 0), 2);
+        CHECK(strstr(t, "\r\nvsync") == NULL);                            /* a locked row is never written */
+        free(t);
+    }
+    CHECK(!file_exists("options.ini.tmp"));                               /* replaced, not left behind */
+
+    /* reset: what the layers below options.ini give */
+    CHECK_EQ(opt_reset(fps), OPT_SET_CHANGED);
+    CHECK_EQ(opt_i(fps), 0);
+    CHECK_EQ(opt_reset(mon), OPT_SET_CHANGED);
+    opt_text(mon, v, sizeof v); CHECK_STR(v, "2");                        /* display.ini's */
+    {
+        char* t = read_file("options.ini");
+        CHECK(t && strstr(t, "\r\n# fps_cap = 0 ") != NULL && strstr(t, "# capped\r\n") != NULL);
+        CHECK(t && strstr(t, "\r\n# monitor = primary ; back to the first\r\n") != NULL);
+        CHECK(t && !ini_get(t, "performance", "fps_cap", NULL, v, sizeof v));
+        free(t);
+    }
+    /* set back to the file's values: byte-identical */
+    CHECK_EQ(opt_set(fps, "60"), OPT_SET_CHANGED);
+    CHECK_EQ(opt_set(mon, "1"), OPT_SET_CHANGED);
+    CHECK_EQ(opt_set(an, "game"), OPT_SET_CHANGED);
+    {
+        char* t = read_file("options.ini");
+        CHECK(t && !strcmp(t, kOptionsIni));
+        if (t && strcmp(t, kOptionsIni)) diff_lines(kOptionsIni, t, 1);
+        free(t);
+    }
+    /* a value equal to the home file's needs no options.ini line */
+    CHECK_EQ(opt_set(inv, "0"), OPT_SET_CHANGED);
+    CHECK_EQ(opt_set(inv, "1"), OPT_SET_CHANGED);
+    {
+        char* t = read_file("options.ini");
+        CHECK(t && !ini_get(t, "mouse", "mouse_invert_y", NULL, v, sizeof v));   /* no active line */
+        free(t);
+    }
+    /* reset of a row that options.ini sets to its default: commented out */
+    CHECK_EQ(opt_set(ms, "1.0"), OPT_SET_CHANGED);
+    {
+        char* t = read_file("options.ini");
+        CHECK(t && strstr(t, "\r\n# mouse_sensitivity = 1.0\r\n") != NULL);
+        free(t);
+    }
+
+    /* presets */
+    CHECK_EQ(opt_preset_current(), OPT_PRESET_PS3);
+    CHECK_EQ(opt_preset_apply(OPT_PRESET_HIGH), 5);       /* anisotropy 16, aa fast, sharpen 25, shadow soft, test_q 3 */
+    CHECK_EQ(opt_preset_current(), OPT_PRESET_HIGH);
+    CHECK_EQ(opt_i(an), 4); CHECK_EQ(opt_i(q), 3);
+    {   /* the post-processing rows (rsx_postfx.h): off / 0 by default and in PS3 Original */
+        const opt_id aa = opt_find("aa"), sh = opt_find("sharpening");
+        CHECK(aa >= 0 && sh >= 0);
+        CHECK_EQ(opt_i(aa), 1); CHECK_EQ(opt_i(sh), 25);
+        CHECK(opt_find("anti_aliasing") == aa);
+        CHECK_EQ(opt_set(sh, "101"), OPT_SET_REFUSED);
+        CHECK_EQ(opt_set(aa, "high"), OPT_SET_REFUSED);
+        const opt_def* d = opt_def_of(aa);
+        CHECK(d && d->apply == OPT_FRAME && !strcmp(d->env, "GFX_AA") && !strcmp(d->dflt, "off"));
+        d = opt_def_of(sh);
+        CHECK(d && d->apply == OPT_FRAME && !strcmp(d->env, "GFX_SHARPEN") && !strcmp(d->dflt, "0"));
+    }
+    {   /* shadow filtering (rsx_fp_set_shadow_filter): a restart row, ps3 = the PS3 kernel (today's HLSL) */
+        const opt_id sf = opt_find("shadow_filter");
+        CHECK(sf >= 0 && opt_find("shadow_filtering") == sf && opt_find("shadow softness") == sf);
+        CHECK_EQ(opt_i(sf), 1);                                            /* High: soft */
+        const opt_def* d = opt_def_of(sf);
+        CHECK(d && d->apply == OPT_RESTART && d->type == OPT_ENUM && !strcmp(d->env, "GFX_SHADOW_FILTER") &&
+              !strcmp(d->dflt, "ps3") && !strcmp(d->values, "ps3|soft|softer") && !strcmp(d->labels, "PS3|Soft|Softer") &&
+              !strcmp(d->tab, "Graphics") && !strcmp(d->group, "Shadows") && (d->flags & OPT_F_ENHANCEMENT) &&
+              !strcmp(d->preset[OPT_PRESET_PS3], "ps3") && !strcmp(d->preset[OPT_PRESET_LOW], "ps3") &&
+              !strcmp(d->preset[OPT_PRESET_MED], "ps3") && !strcmp(d->preset[OPT_PRESET_HIGH], "soft") &&
+              !strcmp(d->preset[OPT_PRESET_ULTRA], "softer"));
+        CHECK_EQ(opt_restart_pending_row(sf), 1);                         /* High changed it: next launch */
+        CHECK_EQ(opt_set(sf, "blurry"), OPT_SET_REFUSED);
+        CHECK_EQ(opt_set(sf, "1"), OPT_SET_REFUSED);                      /* the store's words only */
+        CHECK_EQ(opt_set(sf, "Softer"), OPT_SET_CHANGED);
+        char t[32];
+        opt_text(sf, t, sizeof t);
+        CHECK_STR(t, "softer");
+        CHECK_EQ(opt_set(sf, "soft"), OPT_SET_CHANGED);                   /* back to High's value */
+    }
+    {   /* the window-sized present (rsx_upscale.h): restart rows, off / 0 = today's swap chain */
+        const opt_id up = opt_find("upscale"), vr = opt_find("vrr");
+        CHECK(up >= 0 && vr >= 0);
+        CHECK(opt_find("upscaling") == up && opt_find("variable_refresh") == vr && opt_find("freesync") == vr);
+        CHECK(opt_is_default(up) && opt_is_default(vr));
+        CHECK_EQ(opt_i(up), 0); CHECK_EQ(opt_i(vr), 0);
+        const opt_def* d = opt_def_of(up);
+        CHECK(d && d->apply == OPT_RESTART && !strcmp(d->env, "GFX_UPSCALE") && !strcmp(d->dflt, "off") &&
+              d->type == OPT_ENUM && !strcmp(d->values, "off|bilinear|bicubic|lanczos") &&
+              d->preset[OPT_PRESET_PS3] && !strcmp(d->preset[OPT_PRESET_PS3], "off") && !d->preset[OPT_PRESET_HIGH] &&
+              !strcmp(d->tab, "Graphics"));
+        d = opt_def_of(vr);
+        CHECK(d && d->apply == OPT_RESTART && !strcmp(d->env, "PRESENT_VRR") && !strcmp(d->dflt, "0") &&
+              d->type == OPT_BOOL && !strcmp(d->tab, "Frame"));
+        CHECK_EQ(opt_set(up, "sharp"), OPT_SET_REFUSED);
+        CHECK_EQ(opt_set(up, "Lanczos"), OPT_SET_CHANGED);
+        CHECK_EQ(opt_i(up), 3);
+        char t[32];
+        opt_text(up, t, sizeof t);
+        CHECK_STR(t, "lanczos");
+        CHECK_EQ(opt_restart_pending_row(up), 1);
+        CHECK_EQ(opt_set(vr, "on"), OPT_SET_CHANGED);
+        CHECK_EQ(opt_i(vr), 1);
+        CHECK_EQ(opt_restart_pending_row(vr), 1);
+        CHECK_EQ(opt_reset(up), OPT_SET_CHANGED);
+        CHECK_EQ(opt_reset(vr), OPT_SET_CHANGED);
+        CHECK(opt_is_default(up) && opt_is_default(vr) && !opt_restart_pending_row(up));
+    }
+    CHECK_EQ(opt_set(q, "2"), OPT_SET_CHANGED);
+    CHECK_EQ(opt_preset_current(), -1);                                   /* custom */
+    CHECK(opt_preset_apply(OPT_PRESET_PS3) > 0);
+    CHECK_EQ(opt_preset_current(), OPT_PRESET_PS3);
+    for (opt_id i = 0; i < opt_count(); i++) {                            /* PS3 Original == defaults */
+        const opt_def* d = opt_def_of(i);
+        if (!d->preset[OPT_PRESET_PS3]) continue;
+        CHECK(opt_is_default(i));
+        if (!opt_is_default(i)) printf("    %s is not at its default after PS3 Original\n", d->key);
+    }
+    opt_render_point();          /* since the last one: 16 -> game -> 16 -> game, one call */
+    CHECK_EQ(g_render_calls, 2); CHECK_STR(g_last_old, "16"); CHECK_STR(g_last_new, "game");
+    CHECK_EQ(opt_set(an, "4"), OPT_SET_CHANGED);
+    CHECK_EQ(opt_set(an, "game"), OPT_SET_CHANGED);
+    opt_render_point();          /* back where it was at the last render point: no call */
+    CHECK_EQ(g_render_calls, 2);
+
+    /* restart-pending */
+    const opt_id tear = opt_find("tearing");
+    CHECK_EQ(opt_restart_pending(), 0);
+    CHECK_EQ(opt_set(tear, "on"), OPT_SET_CHANGED);
+    CHECK_EQ(opt_restart_pending(), 1);
+    CHECK_EQ(opt_set(tear, "0"), OPT_SET_CHANGED);
+    CHECK_EQ(opt_restart_pending(), 0);
+
+    /* every built-in row: its default parses, PS3 preset = default */
+    for (opt_id i = 0; i < opt_count(); i++) {
+        const opt_def* d = opt_def_of(i);
+        CHECK(d && d->key && d->dflt && d->home && d->section && d->label);
+    }
+
+    /* the system pause API: pause_mode is locked to off here, so no flag */
+    CHECK_EQ(options_intercepted(), 0);
+    options_set_intercepted(1);
+    CHECK_EQ(options_intercepted(), 1); CHECK_EQ(g_icpt_on, 1); CHECK_EQ(g_icpt_flag, 0);
+    options_set_intercepted(1);
+    CHECK_EQ(g_icpt_calls, 1);                                            /* no-op */
+    options_set_intercepted(0);
+    CHECK_EQ(options_intercepted(), 0); CHECK_EQ(g_icpt_on, 0); CHECK_EQ(g_icpt_calls, 2);
+
+    /* fresh processes */
+    printf("B2. a new options.ini from the template\n");
+    path_of("new_options.ini", p, sizeof p);
+    remove(p);
+    setenv_("OPTIONS_CONFIG", p);
+    CHECK_EQ(run_child(self, "--child-new"), 0);
+    CHECK_EQ(run_child(self, "--child-readback"), 0);
+    printf("B3. OPTIONS_CONFIG=none\n");
+    setenv_("OPTIONS_CONFIG", "none");
+    CHECK_EQ(run_child(self, "--child-none"), 0);
+    printf("B4. a UTF-16 options.ini (PowerShell 5) stays UTF-16\n");
+    {
+        ini_buf u = {0};
+        ini_text_encode("[performance]\r\n# fps_cap = 0\r\n# caf\xC3\xA9\r\n", INI_ENC_UTF16LE, &u);
+        write_bytes("u16_options.ini", u.p, u.n);
+        ini_buf_free(&u);
+    }
+    path_of("u16_options.ini", p, sizeof p);
+    setenv_("OPTIONS_CONFIG", p);
+    CHECK_EQ(run_child(self, "--child-utf16-edit"), 0);
+    printf("B5. pause_mode = system reports the flag\n");
+    setenv_("OPTIONS_CFG", "");
+    setenv_("OPTIONS_CONFIG", "none");
+    CHECK_EQ(run_child(self, "--child-pause"), 0);
+    printf("B6. a key the user spelt with an alias: set and reset edit that line\n");
+    write_text("alias_options.ini", "[performance]\r\nframe_limit = 30 # mine\r\n");
+    path_of("alias_options.ini", p, sizeof p);
+    setenv_("OPTIONS_CONFIG", p);
+    CHECK_EQ(run_child(self, "--child-alias"), 0);
+    CHECK_EQ(run_child(self, "--child-alias-readback"), 0);
+    printf("B7. GFX_UPSCALE / PRESENT_VRR lock the rows in the store's grammar (what the menus show runs)\n");
+    setenv_("OPTIONS_CONFIG", "none");
+    setenv_("GFX_UPSCALE", "Bicubic");
+    setenv_("PRESENT_VRR", "on");
+    CHECK_EQ(run_child(self, "--child-p7-env"), 0);
+    setenv_("GFX_UPSCALE", "sharp");          /* not a value: locked, the lower layer's value (off) runs and shows */
+    setenv_("PRESENT_VRR", "2");
+    CHECK_EQ(run_child(self, "--child-p7-bad"), 0);
+    setenv_("GFX_UPSCALE", "");
+    setenv_("PRESENT_VRR", "");
+    printf("B8. GFX_SHADOW_FILTER locks the shadow_filter row in the store's grammar\n");
+    setenv_("GFX_SHADOW_FILTER", "Soft");
+    CHECK_EQ(run_child(self, "--child-p8a-env"), 0);
+    setenv_("GFX_SHADOW_FILTER", "1");        /* not a value of the row: locked, the lower layer's ps3 runs and shows */
+    CHECK_EQ(run_child(self, "--child-p8a-bad"), 0);
+    setenv_("GFX_SHADOW_FILTER", "");
+}
+
+static int child(const char* mode)
+{
+    char v[96];
+    const opt_id fps = opt_find("fps_cap");
+    if (!strcmp(mode, "--child-new")) {
+        int ex = 1;
+        const char* p = opt_file_path(&ex);
+        CHECK(!ex && p[0]);
+        CHECK_EQ(opt_set(fps, "75"), OPT_SET_CHANGED);
+        size_t n; char* t = read_bytes(p, &n);
+        CHECK(t && strstr(t, "\r\nfps_cap = 75 ") != NULL);
+        CHECK(t && strstr(t, "\r\n# vsync = 1 ") != NULL);
+        CHECK(t && strstr(t, "\r\n[performance]\r\n") != NULL && strstr(t, "\r\n[display]\r\n") != NULL);
+        CHECK(t && strstr(t, "\r\n# mouse_sensitivity = 1.0 ") != NULL);
+        free(t);
+        opt_file_path(&ex);
+        CHECK(ex);
+    } else if (!strcmp(mode, "--child-readback")) {
+        CHECK_EQ(opt_i(fps), 75);
+        const char* where; int line;
+        CHECK_EQ(opt_source(fps, &where, &line), OPT_SRC_FILE);
+        CHECK(opt_is_default(opt_find("vsync")) || opt_locked(opt_find("vsync"), NULL));
+    } else if (!strcmp(mode, "--child-none")) {
+        int ex = 1;
+        CHECK_STR(opt_file_path(&ex), ""); CHECK(!ex);
+        CHECK_EQ(opt_set(fps, "45"), OPT_SET_CHANGED);                    /* applies, not saved */
+        CHECK_EQ(opt_i(fps), 45);
+        CHECK_EQ(opt_save(), 0);
+        CHECK_STR(opt_layer_text("display"), "");
+    } else if (!strcmp(mode, "--child-pause")) {
+        options_set_intercepted(1);
+        CHECK_EQ(g_icpt_on, 1); CHECK_EQ(g_icpt_flag, 1);
+        CHECK_EQ(opt_set(opt_find("pause_mode"), "off"), OPT_SET_CHANGED);
+        options_set_intercepted(0);
+        options_set_intercepted(1);
+        CHECK_EQ(g_icpt_flag, 0);
+    } else if (!strcmp(mode, "--child-alias")) {
+        CHECK_EQ(opt_i(fps), 30);
+        CHECK_EQ(opt_reset(fps), OPT_SET_CHANGED);
+        CHECK_EQ(opt_i(fps), 0);
+        size_t n; char* t = read_bytes(opt_file_path(NULL), &n);
+        CHECK(t && !strcmp(t, "[performance]\r\n# frame_limit = 0  # mine\r\n"));   /* comment column kept */
+        free(t);
+        CHECK_EQ(opt_set(fps, "40"), OPT_SET_CHANGED);
+        t = read_bytes(opt_file_path(NULL), &n);
+        CHECK(t && !strcmp(t, "[performance]\r\nframe_limit = 40 # mine\r\n"));
+        free(t);
+        CHECK_EQ(opt_reset(fps), OPT_SET_CHANGED);
+    } else if (!strcmp(mode, "--child-alias-readback")) {
+        CHECK_EQ(opt_i(fps), 0);                                          /* the reset held */
+        CHECK(opt_is_default(fps));
+    } else if (!strcmp(mode, "--child-p7-env")) {
+        const opt_id up = opt_find("upscale"), vr = opt_find("vrr");
+        const char* env = NULL;
+        CHECK(opt_locked(up, &env) && env && !strcmp(env, "GFX_UPSCALE"));
+        CHECK_EQ(opt_i(up), 2);
+        opt_text(up, v, sizeof v);
+        CHECK_STR(v, "bicubic");
+        CHECK(opt_locked(vr, &env) && env && !strcmp(env, "PRESENT_VRR"));
+        CHECK_EQ(opt_i(vr), 1);
+        CHECK_EQ(opt_set(up, "lanczos"), OPT_SET_REFUSED);                /* locked */
+    } else if (!strcmp(mode, "--child-p8a-env")) {
+        const opt_id sf = opt_find("shadow_filter");
+        const char* env = NULL;
+        CHECK(opt_locked(sf, &env) && env && !strcmp(env, "GFX_SHADOW_FILTER"));
+        CHECK_EQ(opt_i(sf), 1);
+        opt_text(sf, v, sizeof v);
+        CHECK_STR(v, "soft");
+        CHECK_EQ(opt_set(sf, "softer"), OPT_SET_REFUSED);                 /* locked */
+        CHECK_EQ(opt_preset_apply(OPT_PRESET_ULTRA) >= 0, 1);
+        CHECK_EQ(opt_i(sf), 1);                                           /* a preset cannot move a locked row */
+    } else if (!strcmp(mode, "--child-p8a-bad")) {
+        const opt_id sf = opt_find("shadow_filter");
+        CHECK(opt_locked(sf, NULL));
+        CHECK_EQ(opt_i(sf), 0);                                           /* ps3 runs and shows */
+        opt_text(sf, v, sizeof v);
+        CHECK_STR(v, "ps3");
+    } else if (!strcmp(mode, "--child-p7-bad")) {
+        const opt_id up = opt_find("upscale"), vr = opt_find("vrr");
+        CHECK(opt_locked(up, NULL) && opt_locked(vr, NULL));
+        CHECK_EQ(opt_i(up), 0);                                           /* the default runs and shows */
+        CHECK_EQ(opt_i(vr), 0);
+    }
+    (void)v;
+    printf("  child %s: %d checks, %d failures\n", mode, g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
+
+/* B4 needs a UTF-16 file before a process loads it */
+static int child_utf16_edit(void)
+{
+    const opt_id fps = opt_find("fps_cap");
+    CHECK_EQ(opt_i(fps), 0);
+    CHECK_EQ(opt_set(fps, "50"), OPT_SET_CHANGED);
+    size_t n; char* t = read_bytes(opt_file_path(NULL), &n);
+    CHECK(t && n > 2 && (unsigned char)t[0] == 0xFF && (unsigned char)t[1] == 0xFE);
+    ini_buf d = {0};
+    if (t) ini_text_decode((const unsigned char*)t, n, &d);
+    CHECK_STR(d.p, "[performance]\r\nfps_cap = 50\r\n# caf\xC3\xA9\r\n");
+    ini_buf_free(&d);
+    free(t);
+    printf("  child --child-utf16-edit: %d checks, %d failures\n", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
+
+int main(int argc, char** argv)
+{
+    const char* tmp = getenv("TEMP");
+    snprintf(g_dir, sizeof g_dir, "%s\\ps3recomp_test_options", tmp ? tmp : ".");
+    if (argc > 1 && !strcmp(argv[1], "--child-utf16-edit")) return child_utf16_edit();
+    if (argc > 1 && !strncmp(argv[1], "--child-", 8)) return child(argv[1]);
+#ifdef _WIN32
+    CreateDirectoryA(g_dir, NULL);
+#endif
+    test_ini();
+    if (argc > 1) test_shipped(argv[1]);
+    test_store(argv[0]);
+    printf("%s: %d checks, %d failures (children report their own)\n", g_fail ? "FAILED" : "PASSED", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/libs/system/tests/test_savedata_flow.c b/libs/system/tests/test_savedata_flow.c
new file mode 100644
index 0000000..8eed0e6
--- /dev/null
+++ b/libs/system/tests/test_savedata_flow.c
@@ -0,0 +1,608 @@
+/* clang -std=gnu17 -I include libs/system/tests/test_savedata_flow.c
+ * -Wl,-dead_strip -o /tmp/test_savedata_flow && /tmp/test_savedata_flow
+ * (Windows: clang-cl /std:c17 -Iinclude libs\system\tests\test_savedata_flow.c)
+ *
+ * Drives the save-data service through a fake guest callback set shaped like
+ * inFamous 2's (BCUS98125): ListAutoLoad at boot whose funcFixed loads
+ * dirList[0]; AutoSave2 whose funcStat edits getParam in place, asks for
+ * RECREATE_YES and writes ICON0 + a SECUREFILE "STATE"; Load/Save Game menus
+ * through ListLoad2 (focus LATEST) and ListSave2 (a new-data slot). Checks the
+ * PARAM.SFO against RPCS3's layout, the stat data a reload hands back, list
+ * order, recreate modes, failure atomicity, the legacy text format, the
+ * PS3_SAVEDATA_* testing knobs and what host tooling is told
+ * (ps3_savedata_root, ps3_savedata_last_op). */
+#include "../cellSaveData.c"
+#include <assert.h>
+#ifdef _WIN32
+#  include <sys/utime.h>
+static char* mkdtemp(char* t)
+{
+    size_t n = strlen(t);
+    for (unsigned s = 0; s < 1000; s++) {
+        snprintf(t + n - 6, 7, "%06u", (unsigned)(GetCurrentProcessId() * 7u + s) % 1000000u);
+        if (_mkdir(t) == 0) return t;
+    }
+    return NULL;
+}
+static void set_env(const char* k, const char* v) { _putenv_s(k, v ? v : ""); }
+static void set_mtime(const char* p, long long t)
+{
+    struct __utimbuf64 u = { t, t };
+    assert(_utime64(p, &u) == 0);
+}
+#  define TMP_TEMPLATE ".\\ps3recomp-savedata-flow-XXXXXX"
+#else
+#  include <utime.h>
+static void set_env(const char* k, const char* v) { if (v) setenv(k, v, 1); else unsetenv(k); }
+static void set_mtime(const char* p, long long t)
+{
+    struct utimbuf u = { (time_t)t, (time_t)t };
+    assert(utime(p, &u) == 0);
+}
+#  define TMP_TEMPLATE "/tmp/ps3recomp-savedata-flow-XXXXXX"
+#endif
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*))
+{ (void)nid; (void)name; (void)fn; }
+ps3_guest_caller_fn g_ps3_guest_caller;
+
+/* Guest memory used by the test (the service's scratch is 0x100000..0x120000). */
+enum {
+    SET_LIST = 0x100, SET_BUF = 0x200, PREFIX = 0x300, DIR0 = 0x340, DIR1 = 0x360,
+    NAME_STATE = 0x380, NEW_DIR = 0x3C0, NEW_DATA = 0x3E0, BAD_DIR = 0x400,
+    DIR5 = 0x420, LIST_BUF = 0x8000, ICON_BUF = 0x9000, STATE_BUF = 0xA000,
+    READ_BUF = 0xB000, USERDATA = 0xCAFE,
+};
+enum { CB_FIXED = 0x800, CB_LIST_LOAD = 0x810, CB_LIST_SAVE = 0x820,
+       CB_STAT_SAVE = 0x900, CB_STAT_LOAD = 0x910, CB_FILE_SAVE = 0xA00, CB_FILE_LOAD = 0xA10 };
+
+typedef struct { u32 op, type, name, buf, size; } file_op;
+
+static struct {
+    /* what the title does */
+    u32 recreate;
+    const char* subtitle;
+    file_op plan[4];
+    u32 nplan, fail_at;
+    int offer_new;
+    u32 parental;            /* written to getParam.reserved2 (RPCS3: parental_level) */
+    /* what the title saw */
+    u32 fixed_calls, stat_calls, file_calls, list_calls;
+    u32 dir_num, dir_listed;
+    char first_listed[32], stat_dir[32];
+    u32 is_new, size_kb, sys_kb, file_num, file_list_num, parental_seen;
+    char title[128], subtitle_seen[128], detail[1024];
+    struct { char name[16]; u32 type; u64 size; } files[8];
+    u32 exc_seen[8];
+} g;
+
+static void clear_seen(void)
+{
+    g.fixed_calls = g.stat_calls = g.file_calls = g.list_calls = 0;
+    g.dir_num = g.dir_listed = 0;
+    g.first_listed[0] = g.stat_dir[0] = 0;
+}
+
+static void callback(u32 opd, u64 cb64, u64 get64, u64 set64,
+                     u64 a, u64 b, u64 c, u64 d, u64 e)
+{
+    const u32 cb = (u32)cb64, get = (u32)get64, set = (u32)set64;
+    assert(!a && !b && !c && !d && !e);
+    assert(vm_read32(cb + 16) == USERDATA);       /* userdata echoed back */
+    switch (opd) {
+    case CB_FIXED: {      /* inFamous 2 0x123D18: nothing listed -> OK_LAST, else dirList[0] */
+        g.fixed_calls++;
+        g.dir_num = vm_read32(get); g.dir_listed = vm_read32(get + 4);
+        u32 list = vm_read32(get + 8);
+        vm_write32(set, 0); vm_write32(set + 4, 0); vm_write32(set + 8, 0);
+        if (!g.dir_listed) { vm_write32(cb, CELL_SAVEDATA_CBRESULT_OK_LAST); return; }
+        snprintf(g.first_listed, sizeof g.first_listed, "%s", (char*)vm_base + list);
+        vm_write32(set, list);
+        return;
+    }
+    case CB_LIST_LOAD:    /* inFamous 2 0x123378: everything, focused on the newest */
+    case CB_LIST_SAVE:
+        g.list_calls++;
+        g.dir_num = vm_read32(get); g.dir_listed = vm_read32(get + 4);
+        if (g.dir_listed)
+            snprintf(g.first_listed, sizeof g.first_listed, "%s", (char*)vm_base + vm_read32(get + 8));
+        vm_write32(set + 0, CELL_SAVEDATA_FOCUSPOS_LATEST);
+        vm_write32(set + 8, g.dir_listed);
+        vm_write32(set + 12, vm_read32(get + 8));
+        vm_write32(set + 16, opd == CB_LIST_SAVE && g.offer_new ? NEW_DATA : 0);
+        return;
+    case CB_STAT_SAVE:
+    case CB_STAT_LOAD: {
+        g.stat_calls++;
+        snprintf(g.stat_dir, sizeof g.stat_dir, "%s", (char*)vm_base + get + 32);
+        g.is_new = vm_read32(get + 4);
+        memcpy(g.title, vm_base + get + 64, 128);
+        memcpy(g.subtitle_seen, vm_base + get + 64 + 128, 128);
+        memcpy(g.detail, vm_base + get + 64 + 256, 1024);
+        g.parental_seen = vm_read32(get + 64 + 1284);
+        g.size_kb = vm_read32(get + 1620); g.sys_kb = vm_read32(get + 1624);
+        g.file_num = vm_read32(get + 1628); g.file_list_num = vm_read32(get + 1632);
+        u32 list = vm_read32(get + 1636);
+        for (u32 i = 0; i < g.file_list_num && i < 8; i++) {
+            snprintf(g.files[i].name, sizeof g.files[i].name, "%s", (char*)vm_base + list + i * 56 + 40);
+            g.files[i].type = vm_read32(list + i * 56);
+            g.files[i].size = vm_read64(list + i * 56 + 8);
+        }
+        if (opd == CB_STAT_LOAD) return;
+        /* 0x129744: the title edits getParam in place and hands it back. */
+        const u32 p = get + 64;
+        memset(vm_base + p, 0, 1552);
+        strcpy((char*)vm_base + p, "inFAMOUS 2");
+        strcpy((char*)vm_base + p + 128, g.subtitle);
+        strcpy((char*)vm_base + p + 256, "Completion: 1%\nPowers and Upgrades: 13\n");
+        vm_write32(p + 1280, 0);
+        vm_write32(p + 1284, g.parental);
+        vm_write32(set + 0, p);
+        vm_write32(set + 4, g.recreate);
+        vm_write32(set + 8, 0);
+        return;
+    }
+    case CB_FILE_SAVE:
+    case CB_FILE_LOAD: {
+        const u32 step = g.file_calls++;
+        g.exc_seen[step < 8 ? step : 7] = vm_read32(get);
+        if (step == g.fail_at) { vm_write32(cb, (u32)CELL_SAVEDATA_CBRESULT_ERR_FAILURE); return; }
+        if (step >= g.nplan) { vm_write32(cb, CELL_SAVEDATA_CBRESULT_OK_LAST); return; }
+        const file_op* f = &g.plan[step];
+        vm_write32(set + 0, f->op);
+        vm_write32(set + 8, f->type);
+        vm_write32(set + 28, f->name);
+        vm_write32(set + 32, 0);
+        vm_write32(set + 36, f->size);
+        vm_write32(set + 40, f->size);
+        vm_write32(set + 44, f->buf);
+        return;
+    }
+    default:
+        assert(!"unexpected callback");
+    }
+}
+
+static char root[260];
+
+static void path_of(char* out, const char* dir, const char* file)
+{
+    if (file) snprintf(out, 1024, "%s/%s/%s", root, dir, file);
+    else      snprintf(out, 1024, "%s/%s", root, dir);
+}
+
+static long file_size(const char* dir, const char* file)
+{
+    char p[1024];
+    path_of(p, dir, file);
+    FILE* f = fopen(p, "rb");
+    if (!f) return -1;
+    fseek(f, 0, SEEK_END);
+    long n = ftell(f);
+    fclose(f);
+    return n;
+}
+
+static int file_is(const char* dir, const char* file, u32 ea, u32 size)
+{
+    char p[1024];
+    path_of(p, dir, file);
+    FILE* f = fopen(p, "rb");
+    if (!f) return 0;
+    u8 buf[1024];
+    size_t n = fread(buf, 1, sizeof buf, f);
+    fclose(f);
+    return n == size && !memcmp(buf, vm_base + ea, size);
+}
+
+/* No ".NAME.tmp" / ".NAME.old" work directory left behind. */
+static void assert_no_work_dirs(void)
+{
+    savedata_names s;
+    assert(list_dir(root, &s) == 0);
+    for (u32 i = 0; i < s.n; i++) assert(s.v[i][0] != '.');
+    names_free(&s);
+}
+
+/* Independent PSF reader: key, format, len, max, value. */
+typedef struct { char key[32]; u32 fmt, len, max; u8 v[1024]; } sfo_entry;
+
+static u32 read_sfo(const char* dir, sfo_entry* out, u32 cap, long* size)
+{
+    char p[1024];
+    path_of(p, dir, "PARAM.SFO");
+    FILE* f = fopen(p, "rb");
+    assert(f);
+    static u8 d[8192];
+    *size = (long)fread(d, 1, sizeof d, f);
+    fclose(f);
+    assert(*size >= 20 && !memcmp(d, "\0PSF", 4));
+    assert(d[4] == 1 && d[5] == 1);                     /* version 1.1 */
+    const u32 ks = psf_le32(d + 8), ds = psf_le32(d + 12), n = psf_le32(d + 16);
+    assert(n <= cap && ks == 0x14 + n * 0x10);
+    for (u32 i = 0; i < n; i++) {
+        const u8* e = d + 0x14 + i * 0x10;
+        snprintf(out[i].key, sizeof out[i].key, "%s", (const char*)d + ks + psf_le16(e));
+        out[i].fmt = psf_le16(e + 2); out[i].len = psf_le32(e + 4); out[i].max = psf_le32(e + 8);
+        assert(out[i].len <= out[i].max && out[i].max <= sizeof out[i].v);
+        memcpy(out[i].v, d + ds + psf_le32(e + 12), out[i].len);
+    }
+    return n;
+}
+
+static const sfo_entry* sfo_get(const sfo_entry* e, u32 n, const char* key)
+{
+    for (u32 i = 0; i < n; i++) if (!strcmp(e[i].key, key)) return &e[i];
+    return NULL;
+}
+
+static void set_plan(const file_op* ops, u32 n)
+{
+    for (u32 i = 0; i < n; i++) g.plan[i] = ops[i];
+    g.nplan = n;
+    g.fail_at = 99;
+    g.file_calls = 0;
+}
+#define PLAN(...) do { const file_op ops_[] = { __VA_ARGS__ }; \
+        set_plan(ops_, (u32)(sizeof ops_ / sizeof ops_[0])); } while (0)
+#define NO_FILES() set_plan(NULL, 0)
+
+static s32 auto_save(u32 dir)
+{
+    return cellSaveDataAutoSave2(0, (const char*)(uintptr_t)dir, 2, (CellSaveDataSetBuf*)SET_BUF,
+                                 (CellSaveDataStatCallback)CB_STAT_SAVE,
+                                 (CellSaveDataFileCallback)CB_FILE_SAVE, 0xFFFFFFFFu,
+                                 (void*)(uintptr_t)USERDATA);
+}
+
+static s32 list_auto_load(void)
+{
+    return cellSaveDataListAutoLoad(0, 2, (CellSaveDataSetList*)SET_LIST,
+                                    (CellSaveDataSetBuf*)SET_BUF,
+                                    (CellSaveDataFixedCallback)CB_FIXED,
+                                    (CellSaveDataStatCallback)CB_STAT_LOAD,
+                                    (CellSaveDataFileCallback)CB_FILE_LOAD, 0xFFFFFFFFu,
+                                    (void*)(uintptr_t)USERDATA);
+}
+
+/* ps3_savedata_last_op: exactly one more completed operation, on `dir`, or none. */
+static u32 g_ops;
+static void expect_op(const char* dir, int wrote)
+{
+    char d[CELL_SAVEDATA_DIRNAME_SIZE];
+    int w = -1;
+    const u32 n = ps3_savedata_last_op(d, &w);
+    assert(n == g_ops + 1 && !strcmp(d, dir) && w == wrote);
+    g_ops = n;
+}
+static void expect_no_op(void) { assert(ps3_savedata_last_op(NULL, NULL) == g_ops); }
+
+#define ICON(n)   ((file_op){ CELL_SAVEDATA_FILEOP_WRITE, CELL_SAVEDATA_FILETYPE_CONTENT_ICON0, 0, ICON_BUF, n })
+#define STATE(n)  ((file_op){ CELL_SAVEDATA_FILEOP_WRITE, CELL_SAVEDATA_FILETYPE_SECUREFILE, NAME_STATE, STATE_BUF, n })
+#define READ(n)   ((file_op){ CELL_SAVEDATA_FILEOP_READ, CELL_SAVEDATA_FILETYPE_SECUREFILE, NAME_STATE, READ_BUF, n })
+
+int main(void)
+{
+    snprintf(root, sizeof root, "%s", TMP_TEMPLATE);
+    assert(mkdtemp(root));
+    vm_base = calloc(1, 0x200000); assert(vm_base);
+    assert(cellSaveData_set_scratch_region(0x100000, 0x20000) == CELL_OK);
+    g_ps3_guest_caller = callback;
+
+    /* PS3_SAVEDATA_DIR picks the savedata directory (read once, at first use),
+     * and host tooling can ask for it; nothing has completed yet. */
+    char last[CELL_SAVEDATA_DIRNAME_SIZE];
+    int wrote = -1;
+    assert(ps3_savedata_last_op(last, &wrote) == 0 && !last[0] && wrote == 0);
+    set_env("PS3_SAVEDATA_DIR", root);
+    assert(!strcmp(save_root(), root) && !strcmp(ps3_savedata_root(), root));
+    set_env("PS3_SAVEDATA_DIR", "elsewhere");          /* a running title's saves do not move */
+    assert(!strcmp(ps3_savedata_root(), root));
+    {
+        char p0[1024], want[1024];
+        build_save_path(p0, sizeof p0, "TEST00000_SAVE_0");
+        snprintf(want, sizeof want, "%s/TEST00000_SAVE_0", root);
+#ifdef _WIN32
+        for (char* q = want; *q; q++) if (*q == '/') *q = '\\';
+#endif
+        assert(!strcmp(p0, want));
+    }
+
+    /* inFamous 2's SetList/SetBuf (0x123454 / 0x123410): MODIFIEDTIME,
+     * DESCENT, prefix "<title>_INFAMOUS2_"; 10 dirs into a 480-byte buffer. */
+    strcpy((char*)vm_base + PREFIX, "TEST00000_SAVE_");
+    vm_write32(SET_LIST + 0, CELL_SAVEDATA_SORTTYPE_MODIFIEDTIME);
+    vm_write32(SET_LIST + 4, CELL_SAVEDATA_SORTORDER_DESCENT);
+    vm_write32(SET_LIST + 8, PREFIX);
+    vm_write32(SET_BUF + 0, 10);
+    vm_write32(SET_BUF + 4, 4);
+    vm_write32(SET_BUF + 32, 480);
+    vm_write32(SET_BUF + 36, LIST_BUF);
+    strcpy((char*)vm_base + DIR0, "TEST00000_SAVE_0");
+    strcpy((char*)vm_base + DIR1, "TEST00000_SAVE_1");
+    strcpy((char*)vm_base + DIR5, "TEST00000_SAVE_5");
+    strcpy((char*)vm_base + NAME_STATE, "STATE");
+    strcpy((char*)vm_base + NEW_DIR, "TEST00000_SAVE_3");
+    vm_write32(NEW_DATA + 4, NEW_DIR);
+    strcpy((char*)vm_base + BAD_DIR, "../escape");
+    for (u32 i = 0; i < 512; i++) {
+        vm_base[ICON_BUF + i] = (u8)(i * 7 + 1);
+        vm_base[STATE_BUF + i] = (u8)(i * 13 + 5);
+    }
+
+    /* 1. Boot with no saves: funcFixed sees an empty list and ends the load. */
+    clear_seen();
+    assert(list_auto_load() == CELL_OK);
+    expect_no_op();
+    assert(g.fixed_calls == 1 && g.dir_num == 0 && g.stat_calls == 0);
+
+    /* 2. First autosave: a new save, written in RPCS3's layout. */
+    clear_seen();
+    g.recreate = CELL_SAVEDATA_RECREATE_YES; g.subtitle = "(Autosave) 3. Forward Momentum";
+    PLAN(ICON(100), STATE(300));
+    assert(auto_save(DIR0) == CELL_OK);
+    expect_op("TEST00000_SAVE_0", 1);
+    assert(g.stat_calls == 1 && g.is_new == 1 && g.size_kb == 0 && g.sys_kb == 35);
+    assert(g.file_calls == 3 && g.exc_seen[0] == 0 && g.exc_seen[1] == 100 && g.exc_seen[2] == 300);
+    assert(file_is("TEST00000_SAVE_0", "ICON0.PNG", ICON_BUF, 100));
+    assert(file_is("TEST00000_SAVE_0", "STATE", STATE_BUF, 300));
+    assert(file_size("TEST00000_SAVE_0", "PARAM.PFD") < 0);
+    assert_no_work_dirs();
+    {
+        sfo_entry e[24];
+        long size;
+        u32 n = read_sfo("TEST00000_SAVE_0", e, 24, &size);
+        static const char* keys[] = {
+            "*ICON0.PNG", "*STATE", "ACCOUNT_ID", "ATTRIBUTE", "CATEGORY", "DETAIL",
+            "PARAMS", "PARAMS2", "PARENTAL_LEVEL", "RPCS3_BLIST", "SAVEDATA_DIRECTORY",
+            "SAVEDATA_LIST_PARAM", "SUB_TITLE", "TITLE" };
+        assert(n == 14);
+        for (u32 i = 0; i < n; i++) assert(!strcmp(e[i].key, keys[i]));
+        /* Same keys, formats and slot sizes as an RPCS3 save of ICON0.PNG +
+         * STATE, so the same file size (BCUS98125's is 2804 bytes). */
+        assert(size == 2804);
+        assert(e[0].fmt == 0x0404 && psf_le32(e[0].v) == 0);       /* ICON0: normal */
+        assert(e[1].fmt == 0x0404 && psf_le32(e[1].v) == 1);       /* STATE: secure */
+        assert(e[2].fmt == 0x0004 && e[2].len == 16 && !memcmp(e[2].v, "0000000000000000", 16));
+        const sfo_entry* x;
+        x = sfo_get(e, n, "CATEGORY");   assert(x->fmt == 0x0204 && x->len == 3 && x->max == 4 && !strcmp((const char*)x->v, "SD"));
+        x = sfo_get(e, n, "DETAIL");     assert(x->max == 1024 && !strcmp((const char*)x->v, "Completion: 1%\nPowers and Upgrades: 13\n"));
+        x = sfo_get(e, n, "PARAMS");     assert(x->fmt == 0x0204 && x->len == 1 && x->max == 1024);
+        x = sfo_get(e, n, "PARAMS2");    assert(x->len == 1 && x->max == 12);
+        x = sfo_get(e, n, "RPCS3_BLIST"); assert(x->len == 16 && x->max == 16 && !strcmp((const char*)x->v, "ICON0.PNG/STATE"));
+        x = sfo_get(e, n, "SAVEDATA_DIRECTORY"); assert(x->max == 32 && !strcmp((const char*)x->v, "TEST00000_SAVE_0"));
+        x = sfo_get(e, n, "SAVEDATA_LIST_PARAM"); assert(x->len == 1 && x->max == 8);
+        x = sfo_get(e, n, "SUB_TITLE");  assert(x->max == 128 && !strcmp((const char*)x->v, "(Autosave) 3. Forward Momentum"));
+        x = sfo_get(e, n, "TITLE");      assert(x->max == 128 && !strcmp((const char*)x->v, "inFAMOUS 2"));
+    }
+
+    /* 3. Autosave over it: the stat callback gets the save back (multi-line
+     * DETAIL intact, files typed from PARAM.SFO, sizes), and RECREATE_YES
+     * drops what this save does not write again. */
+    clear_seen();
+    g.subtitle = "(Autosave) 4. Next";
+    g.parental = 7;
+    memset(vm_base + STATE_BUF, 0x5A, 200);
+    PLAN(STATE(200));
+    assert(auto_save(DIR0) == CELL_OK);
+    expect_op("TEST00000_SAVE_0", 1);
+    assert(g.is_new == 0 && !strcmp(g.title, "inFAMOUS 2"));
+    assert(!strcmp(g.subtitle_seen, "(Autosave) 3. Forward Momentum"));
+    assert(!strcmp(g.detail, "Completion: 1%\nPowers and Upgrades: 13\n"));
+    assert(g.file_num == 2 && g.file_list_num == 2 && g.size_kb == 1 + 1 + 35);
+    for (u32 i = 0; i < 2; i++) {
+        if (!strcmp(g.files[i].name, "STATE"))
+            assert(g.files[i].type == CELL_SAVEDATA_FILETYPE_SECUREFILE && g.files[i].size == 300);
+        else
+            assert(!strcmp(g.files[i].name, "ICON0.PNG") &&
+                   g.files[i].type == CELL_SAVEDATA_FILETYPE_CONTENT_ICON0 && g.files[i].size == 100);
+    }
+    assert(file_size("TEST00000_SAVE_0", "ICON0.PNG") < 0);
+    assert(file_is("TEST00000_SAVE_0", "STATE", STATE_BUF, 200));
+    {
+        sfo_entry e[24];
+        long size;
+        u32 n = read_sfo("TEST00000_SAVE_0", e, 24, &size);
+        assert(!sfo_get(e, n, "*ICON0.PNG") && psf_le32(sfo_get(e, n, "*STATE")->v) == 1);
+        assert(!strcmp((const char*)sfo_get(e, n, "RPCS3_BLIST")->v, "STATE"));
+        assert(!strcmp((const char*)sfo_get(e, n, "SUB_TITLE")->v, "(Autosave) 4. Next"));
+        /* getParam.reserved2 is RPCS3's parental_level: written as PARENTAL_LEVEL... */
+        assert(psf_le32(sfo_get(e, n, "PARENTAL_LEVEL")->v) == 7);
+    }
+
+    /* 4. RECREATE_NO keeps the files it does not touch. */
+    clear_seen();
+    g.recreate = CELL_SAVEDATA_RECREATE_NO;
+    PLAN(ICON(100));
+    g.parental = 0;
+    assert(auto_save(DIR0) == CELL_OK);
+    expect_op("TEST00000_SAVE_0", 1);
+    assert(g.file_num == 1 && g.file_list_num == 1);
+    assert(g.parental_seen == 7);                /* ...and handed back in getParam */
+    assert(file_is("TEST00000_SAVE_0", "STATE", STATE_BUF, 200));
+    assert(file_is("TEST00000_SAVE_0", "ICON0.PNG", ICON_BUF, 100));
+
+    /* 5. A save whose callback fails half way leaves the old save as it was.
+     * (inFamous 2's fileListMax is 1: fileNum still counts every file.) */
+    clear_seen();
+    g.recreate = CELL_SAVEDATA_RECREATE_YES;
+    vm_write32(SET_BUF + 4, 1);
+    PLAN(STATE(50));
+    g.fail_at = 1;
+    memset(vm_base + STATE_BUF, 0x11, 50);
+    assert(auto_save(DIR0) == CELL_SAVEDATA_ERROR_CBRESULT);
+    expect_no_op();
+    assert(g.file_num == 2 && g.file_list_num == 1);
+    vm_write32(SET_BUF + 4, 4);
+    memset(vm_base + STATE_BUF, 0x5A, 200);
+    assert(file_is("TEST00000_SAVE_0", "STATE", STATE_BUF, 200));
+    assert(file_size("TEST00000_SAVE_0", "ICON0.PNG") == 100);
+    assert_no_work_dirs();
+
+    /* ...and an unusable directory name is refused before anything is made. */
+    assert(auto_save(BAD_DIR) == CELL_SAVEDATA_ERROR_PARAM);
+    expect_no_op();
+
+    /* 6. Boot with two saves: ListAutoLoad lists the newest first, which is
+     * the one inFamous 2's funcFixed loads ("Continue"). */
+    g.subtitle = "Manual 1";
+    PLAN(STATE(64));
+    assert(auto_save(DIR1) == CELL_OK);
+    expect_op("TEST00000_SAVE_1", 1);
+    char p[1024];
+    path_of(p, "TEST00000_SAVE_0", "PARAM.SFO"); set_mtime(p, 2000000000LL);
+    path_of(p, "TEST00000_SAVE_1", "PARAM.SFO"); set_mtime(p, 1900000000LL);
+    clear_seen();
+    PLAN(READ(200));
+    memset(vm_base + READ_BUF, 0, 512);
+    assert(list_auto_load() == CELL_OK);
+    expect_op("TEST00000_SAVE_0", 0);
+    assert(g.dir_num == 2 && g.dir_listed == 2 && !strcmp(g.first_listed, "TEST00000_SAVE_0"));
+    assert(g.stat_calls == 1 && !strcmp(g.stat_dir, "TEST00000_SAVE_0") && g.is_new == 0);
+    assert(!memcmp(vm_base + READ_BUF, vm_base + STATE_BUF, 200));
+
+    vm_write32(SET_LIST + 4, CELL_SAVEDATA_SORTORDER_ASCENT);
+    clear_seen();
+    NO_FILES();
+    assert(list_auto_load() == CELL_OK && !strcmp(g.first_listed, "TEST00000_SAVE_1"));
+    expect_op("TEST00000_SAVE_1", 0);
+
+    /* PS3_SAVEDATA_PICK puts a named save first, so a test run can choose
+     * which checkpoint "Continue" loads. */
+    vm_write32(SET_LIST + 4, CELL_SAVEDATA_SORTORDER_DESCENT);
+    set_env("PS3_SAVEDATA_PICK", "TEST00000_SAVE_1");
+    clear_seen();
+    assert(list_auto_load() == CELL_OK && !strcmp(g.stat_dir, "TEST00000_SAVE_1"));
+    expect_op("TEST00000_SAVE_1", 0);
+    set_env("PS3_SAVEDATA_PICK", NULL);
+
+    /* 7. Load Game menu: focus LATEST picks the newest whatever the order. */
+    vm_write32(SET_LIST + 4, CELL_SAVEDATA_SORTORDER_ASCENT);
+    clear_seen();
+    PLAN(READ(200));
+    assert(cellSaveDataListLoad2(0, (CellSaveDataSetList*)SET_LIST, (CellSaveDataSetBuf*)SET_BUF,
+                                 (CellSaveDataListCallback)CB_LIST_LOAD,
+                                 (CellSaveDataStatCallback)CB_STAT_LOAD,
+                                 (CellSaveDataFileCallback)CB_FILE_LOAD, 0xFFFFFFFFu,
+                                 (void*)(uintptr_t)USERDATA) == CELL_OK);
+    expect_op("TEST00000_SAVE_0", 0);
+    assert(g.list_calls == 1 && g.dir_listed == 2 && !strcmp(g.first_listed, "TEST00000_SAVE_1"));
+    assert(!strcmp(g.stat_dir, "TEST00000_SAVE_0"));
+    /* the list went to the title's own buffer, CellSaveDataSetBuf.buf */
+    assert(!strcmp((char*)vm_base + LIST_BUF, "TEST00000_SAVE_1"));
+    vm_write32(SET_LIST + 4, CELL_SAVEDATA_SORTORDER_DESCENT);
+
+    /* 8. Save Game menu: an offered new-data slot is used before anything is
+     * overwritten -- PS3_SAVEDATA_PICK only chooses what is loaded. */
+    clear_seen();
+    g.offer_new = 1; g.subtitle = "3. Slot";
+    set_env("PS3_SAVEDATA_PICK", "TEST00000_SAVE_1");
+    PLAN(ICON(100), STATE(300));
+    assert(cellSaveDataListSave2(0, (CellSaveDataSetList*)SET_LIST, (CellSaveDataSetBuf*)SET_BUF,
+                                 (CellSaveDataListCallback)CB_LIST_SAVE,
+                                 (CellSaveDataStatCallback)CB_STAT_SAVE,
+                                 (CellSaveDataFileCallback)CB_FILE_SAVE, 0xFFFFFFFFu,
+                                 (void*)(uintptr_t)USERDATA) == CELL_OK);
+    expect_op("TEST00000_SAVE_3", 1);
+    assert(!strcmp(g.stat_dir, "TEST00000_SAVE_3") && g.is_new == 1);
+    assert(file_size("TEST00000_SAVE_3", "STATE") == 300);
+    assert(file_size("TEST00000_SAVE_1", "STATE") == 64);
+    set_env("PS3_SAVEDATA_PICK", NULL);
+    g.offer_new = 0;
+
+    /* 9. Nothing to choose from is the user backing out of the dialog --
+     * CELL_SAVEDATA_RET_CANCEL, not an error (inFamous 2 answers an error
+     * with "There was an error loading." and asks again). */
+    strcpy((char*)vm_base + PREFIX, "NOSUCH_");
+    clear_seen();
+    assert(cellSaveDataListLoad2(0, (CellSaveDataSetList*)SET_LIST, (CellSaveDataSetBuf*)SET_BUF,
+                                 (CellSaveDataListCallback)CB_LIST_LOAD,
+                                 (CellSaveDataStatCallback)CB_STAT_LOAD,
+                                 (CellSaveDataFileCallback)CB_FILE_LOAD, 0xFFFFFFFFu,
+                                 (void*)(uintptr_t)USERDATA) == CELL_SAVEDATA_RET_CANCEL);
+    expect_no_op();
+    assert(g.list_calls == 1 && g.dir_num == 0 && g.stat_calls == 0);
+    strcpy((char*)vm_base + PREFIX, "TEST00000_SAVE_");
+
+    /* 10. PS3_SAVEDATA_READONLY: the title's save runs to completion and
+     * succeeds, and the checkpoint on disk stays as it was. */
+    set_env("PS3_SAVEDATA_READONLY", "1");
+    clear_seen();
+    g.recreate = CELL_SAVEDATA_RECREATE_YES; g.subtitle = "should not land";
+    PLAN(STATE(10));
+    assert(auto_save(DIR0) == CELL_OK && g.file_calls == 2);
+    expect_op("TEST00000_SAVE_0", 0);   /* completed, nothing written */
+    assert(file_is("TEST00000_SAVE_0", "STATE", STATE_BUF, 200));
+    assert(file_size("TEST00000_SAVE_0", "ICON0.PNG") == 100);
+    assert_no_work_dirs();
+    set_env("PS3_SAVEDATA_READONLY", NULL);
+
+    /* 11. A save in the text format this service used to write still loads,
+     * secure flags included, and is converted the next time it is saved. */
+    path_of(p, "TEST00000_SAVE_5", NULL); ensure_dirs(p);
+    path_of(p, "TEST00000_SAVE_5", "PARAM.SFO");
+    FILE* f = fopen(p, "wb"); assert(f);
+    fputs("TITLE=Old title\nSUB_TITLE=Legacy\nDETAIL=line one\nATTRIBUTE=0\nLIST_PARAM=\n", f);
+    fclose(f);
+    path_of(p, "TEST00000_SAVE_5", "PARAM.PFD");
+    f = fopen(p, "wb"); assert(f); fputs("STATE\n", f); fclose(f);
+    path_of(p, "TEST00000_SAVE_5", "STATE");
+    f = fopen(p, "wb"); assert(f); fwrite(vm_base + STATE_BUF, 1, 200, f); fclose(f);
+    clear_seen();
+    g.recreate = CELL_SAVEDATA_RECREATE_NO; g.subtitle = "Converted";
+    PLAN(ICON(100));
+    assert(auto_save(DIR5) == CELL_OK);
+    expect_op("TEST00000_SAVE_5", 1);
+    assert(g.is_new == 0 && !strcmp(g.title, "Old title") && !strcmp(g.subtitle_seen, "Legacy"));
+    assert(g.file_num == 1 && !strcmp(g.files[0].name, "STATE") &&
+           g.files[0].type == CELL_SAVEDATA_FILETYPE_SECUREFILE);
+    assert(file_size("TEST00000_SAVE_5", "PARAM.PFD") < 0);
+    assert(file_is("TEST00000_SAVE_5", "STATE", STATE_BUF, 200));
+    {
+        sfo_entry e[24];
+        long size;
+        u32 n = read_sfo("TEST00000_SAVE_5", e, 24, &size);
+        assert(psf_le32(sfo_get(e, n, "*STATE")->v) == 1 && psf_le32(sfo_get(e, n, "*ICON0.PNG")->v) == 0);
+        assert(size == 2804);
+    }
+
+    /* 12. A crash between the two renames of a commit leaves ".NAME.old";
+     * the next look at the directory puts the save back. */
+    char from[1024], to[1024];
+    path_of(from, "TEST00000_SAVE_1", NULL);
+    path_of(to, ".TEST00000_SAVE_1.old", NULL);
+    assert(host_rename(from, to) == 0);
+    clear_seen();
+    NO_FILES();
+    assert(list_auto_load() == CELL_OK && g.dir_num == 4);
+    expect_op("TEST00000_SAVE_0", 0);
+    assert(dir_has_save(from) && !dir_exists(to));
+
+    /* clean up */
+    savedata_names s;
+    assert(list_dir(root, &s) == 0);
+    for (u32 i = 0; i < s.n; i++) {
+        path_of(p, s.v[i], NULL);
+        remove_save_dir(p);
+    }
+    names_free(&s);
+#ifdef _WIN32
+    assert(_rmdir(root) == 0);
+#else
+    assert(rmdir(root) == 0);
+#endif
+    free(vm_base);
+    puts("Save-data flow (inFamous 2 shaped): RPCS3 PARAM.SFO, reload stat data, list order, "
+         "recreate, atomic commit, cancel, legacy format, test knobs and last-op checks passed");
+    return 0;
+}
diff --git a/libs/system/tests/test_sysutil_lang.c b/libs/system/tests/test_sysutil_lang.c
new file mode 100644
index 0000000..c1126c0
--- /dev/null
+++ b/libs/system/tests/test_sysutil_lang.c
@@ -0,0 +1,161 @@
+/*
+ * ps3recomp - the system language (libs/system/cellSysutil.c): the PS3
+ * language keys, the Windows UI language -> PS3 language map, the auto pick
+ * against a title's offered list, and what GetSystemParamInt(LANG) returns for
+ * a title's "language" row in the settings store (libs/system/options.c).
+ *
+ * From external/ps3recomp (Windows):
+ *   clang-cl /nologo /W3 -D_CRT_SECURE_NO_WARNINGS -I include -I libs/system -I libs/video -I libs/input
+ *     libs/system/tests/test_sysutil_lang.c libs/system/options.c /Fe:T/tsl.exe
+ *   T/tsl.exe
+ * The test includes cellSysutil.c itself (its other entry points are stubbed
+ * below), and starts itself again with IF2_LANGUAGE-style env locks for the
+ * cases that need a fresh store.
+ */
+#define _CRT_SECURE_NO_WARNINGS
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ---- what cellSysutil.c needs from the rest of the runtime ---- */
+uint8_t* vm_base;
+static uint8_t s_mem[0x1000];
+static uint32_t s_last_w32;
+void vm_write8(uint64_t addr, uint8_t v) { s_mem[addr & 0xFFF] = v; }
+void vm_write32(uint64_t addr, uint32_t v) { (void)addr; s_last_w32 = v; }
+void cellMsgDialog_tick(void) {}
+const char* cellGame_get_title_id(void) { return "TEST00000"; }
+void cellPad_host_intercept(int on, int report_flag) { (void)on; (void)report_flag; }   /* options.c */
+int  cellPad_host_intercepted(void) { return 0; }
+
+#include "../cellSysutil.c"
+
+static int g_fail, g_checks;
+#define CHECK(c) do { g_checks++; if (!(c)) { g_fail++; printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+static const opt_def kRow = {
+    "language", "system_language|lang", "options", "system", "System", "Language", "Language", "test",
+    OPT_ENUM, OPT_RESTART, "auto|english_us|french|spanish|portuguese",
+    "Auto|English|French|Spanish|Portuguese", 0, 0, 0, "auto", "TSL_LANGUAGE", NULL,
+    { NULL, NULL, NULL, NULL, NULL }, 0, "cellSysutil", NULL };
+
+static int child(const char* mode)
+{
+    if (!strcmp(mode, "norow")) {
+        CHECK(cellSysutil_system_language() == CELL_SYSUTIL_LANG_ENGLISH_US);
+    } else if (!strcmp(mode, "spanish")) {           /* TSL_LANGUAGE=spanish */
+        CHECK(opt_register(&kRow) >= 0);
+        CHECK(cellSysutilGetSystemParamInt(CELL_SYSUTIL_SYSTEMPARAM_ID_LANG, 0x100) == CELL_OK);
+        CHECK(s_last_w32 == CELL_SYSUTIL_LANG_SPANISH);
+        /* resolved once: a later change of the row does not reach the title (a PS3 cannot change it mid-game) */
+        CHECK(opt_set(opt_find("language"), "french") == OPT_SET_REFUSED);   /* env-locked anyway */
+        CHECK(cellSysutil_system_language() == CELL_SYSUTIL_LANG_SPANISH);
+    } else if (!strcmp(mode, "russian")) {           /* TSL_LANGUAGE=russian: not one of the row's values */
+        CHECK(opt_register(&kRow) >= 0);
+        CHECK(cellSysutil_system_language() == CELL_SYSUTIL_LANG_ENGLISH_US);
+    } else if (!strcmp(mode, "auto")) {              /* no env: the default auto, this machine's UI language */
+        CHECK(opt_register(&kRow) >= 0);
+        const s32 got = cellSysutil_system_language();
+        CHECK(got == cellSysutil_lang_auto(GetUserDefaultUILanguage(), kRow.values));
+        CHECK(got == CELL_SYSUTIL_LANG_ENGLISH_US || got == CELL_SYSUTIL_LANG_FRENCH ||
+              got == CELL_SYSUTIL_LANG_SPANISH || got == CELL_SYSUTIL_LANG_PORTUGUESE_PT);
+    }
+    printf("child %s: %d checks, %d failed\n", mode, g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
+
+static int run_child(const char* self, const char* mode, const char* env)
+{
+    char cmd[2048];
+    _putenv_s("TSL_LANGUAGE", env ? env : "");
+    snprintf(cmd, sizeof cmd, "\"\"%s\" --child %s\"", self, mode);
+    return system(cmd);
+}
+
+int main(int argc, char** argv)
+{
+    vm_base = s_mem;
+    _putenv_s("OPTIONS_CONFIG", "none");
+    if (argc > 2 && !strcmp(argv[1], "--child")) return child(argv[2]);
+
+    /* keys: index = CELL_SYSUTIL_LANG_*, round trip, out of range */
+    for (s32 i = 0; i < CELL_SYSUTIL_LANG_COUNT; i++) CHECK(cellSysutil_lang_from_key(cellSysutil_lang_key(i)) == i);
+    CHECK(!strcmp(cellSysutil_lang_key(CELL_SYSUTIL_LANG_RUSSIAN), "russian"));
+    CHECK(!strcmp(cellSysutil_lang_key(CELL_SYSUTIL_LANG_ENGLISH_GB), "english_uk"));
+    CHECK(!strcmp(cellSysutil_lang_key(CELL_SYSUTIL_LANG_PORTUGUESE_BR), "portuguese_br"));
+    CHECK(cellSysutil_lang_key(-1) == NULL && cellSysutil_lang_key(CELL_SYSUTIL_LANG_COUNT) == NULL);
+    CHECK(cellSysutil_lang_from_key("klingon") == -1 && cellSysutil_lang_from_key(NULL) == -1);
+
+    /* Windows LANGIDs */
+    CHECK(cellSysutil_lang_from_windows(0x0409) == CELL_SYSUTIL_LANG_ENGLISH_US);
+    CHECK(cellSysutil_lang_from_windows(0x1009) == CELL_SYSUTIL_LANG_ENGLISH_US);   /* en-CA */
+    CHECK(cellSysutil_lang_from_windows(0x0809) == CELL_SYSUTIL_LANG_ENGLISH_GB);
+    CHECK(cellSysutil_lang_from_windows(0x0C09) == CELL_SYSUTIL_LANG_ENGLISH_GB);   /* en-AU */
+    CHECK(cellSysutil_lang_from_windows(0x0419) == CELL_SYSUTIL_LANG_RUSSIAN);
+    CHECK(cellSysutil_lang_from_windows(0x040C) == CELL_SYSUTIL_LANG_FRENCH);
+    CHECK(cellSysutil_lang_from_windows(0x0C0C) == CELL_SYSUTIL_LANG_FRENCH);       /* fr-CA */
+    CHECK(cellSysutil_lang_from_windows(0x080A) == CELL_SYSUTIL_LANG_SPANISH);      /* es-MX */
+    CHECK(cellSysutil_lang_from_windows(0x0C0A) == CELL_SYSUTIL_LANG_SPANISH);
+    CHECK(cellSysutil_lang_from_windows(0x0416) == CELL_SYSUTIL_LANG_PORTUGUESE_BR);
+    CHECK(cellSysutil_lang_from_windows(0x0816) == CELL_SYSUTIL_LANG_PORTUGUESE_PT);
+    CHECK(cellSysutil_lang_from_windows(0x0411) == CELL_SYSUTIL_LANG_JAPANESE);
+    CHECK(cellSysutil_lang_from_windows(0x0412) == CELL_SYSUTIL_LANG_KOREAN);
+    CHECK(cellSysutil_lang_from_windows(0x0404) == CELL_SYSUTIL_LANG_CHINESE_T);
+    CHECK(cellSysutil_lang_from_windows(0x0C04) == CELL_SYSUTIL_LANG_CHINESE_T);    /* zh-HK */
+    CHECK(cellSysutil_lang_from_windows(0x0804) == CELL_SYSUTIL_LANG_CHINESE_S);
+    CHECK(cellSysutil_lang_from_windows(0x0407) == CELL_SYSUTIL_LANG_GERMAN);
+    CHECK(cellSysutil_lang_from_windows(0x0410) == CELL_SYSUTIL_LANG_ITALIAN);
+    CHECK(cellSysutil_lang_from_windows(0x0413) == CELL_SYSUTIL_LANG_DUTCH);
+    CHECK(cellSysutil_lang_from_windows(0x0415) == CELL_SYSUTIL_LANG_POLISH);
+    CHECK(cellSysutil_lang_from_windows(0x041F) == CELL_SYSUTIL_LANG_TURKISH);
+    CHECK(cellSysutil_lang_from_windows(0x041D) == CELL_SYSUTIL_LANG_SWEDISH);
