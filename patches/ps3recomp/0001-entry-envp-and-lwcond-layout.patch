+/* ---------------------------------------------------------------------------
+ * Virtual duplicates (prefer_physical)
+ *
+ * A fake XInput with four slots: s_vx says which are plugged in, their
+ * VID/PID (XInputGetCapabilitiesEx) and what their device tree would say
+ * (s_x.classify stands in for ph_xusb_map's LED match); stub HID pads, some
+ * marked as on a virtual bus (d->vsrc, which ph_probe sets from the device's
+ * ancestry). HID scanning stays off (backends = xinput, and XInput is the
+ * fake): nothing on this machine is opened. Ports' remembered owners are
+ * cleared between the cases, so each starts like a fresh session.
+ * -----------------------------------------------------------------------*/
+static struct { int present, vsrc; u16 vid, pid; } s_vx[PH_XSLOTS];
+static DWORD WINAPI vx_get(DWORD i, XINPUT_STATE* st)
+{
+    if (i >= PH_XSLOTS || !s_vx[i].present) return ERROR_DEVICE_NOT_CONNECTED;
+    memset(st, 0, sizeof *st);
+    st->dwPacketNumber = 1;
+    return ERROR_SUCCESS;
+}
+static DWORD WINAPI vx_set(DWORD i, XINPUT_VIBRATION* v) { (void)i; (void)v; return ERROR_SUCCESS; }
+static DWORD WINAPI vx_caps(DWORD a, DWORD i, DWORD b, PhXCapsEx* c)
+{
+    (void)a; (void)b;
+    if (i >= PH_XSLOTS || !s_vx[i].present) return ERROR_DEVICE_NOT_CONNECTED;
+    memset(c, 0, sizeof *c);
+    c->vid = s_vx[i].vid; c->pid = s_vx[i].pid;
+    return ERROR_SUCCESS;
+}
+static int vx_classify(int slot, u16 vid, u16 pid, int* known)
+{
+    (void)vid; (void)pid;
+    *known = 1;
+    return s_vx[slot].vsrc;
+}
+static void vx_plug(int slot, int vsrc, u16 vid, u16 pid)
+{
+    s_vx[slot].present = 1; s_vx[slot].vsrc = vsrc; s_vx[slot].vid = vid; s_vx[slot].pid = pid;
+    InterlockedExchange(&s_x.probe_now, 1);
+    ph_xinput_poll(GetTickCount64());
+}
+static void vx_unplug(int slot)
+{
+    s_vx[slot].present = 0;
+    InterlockedExchange(&s_x.probe_now, 1);
+    ph_xinput_poll(GetTickCount64());
+}
+static const PadHostDriver stub_ds4_drv = { "stub-ds4", PADHOST_KIND_DS4, stub_match, stub_open, stub_parse, stub_build, stub_close };
+/* A stub pad; vsrc != 0: on a remapper's virtual bus. */
+static int vdev(const PadHostDriver* drv, u16 vid, u16 pid, const char* serial, int vsrc)
+{
+    int id = padhost_virtual_prepare(drv, PADHOST_BUS_USB, vid, pid, serial, 64, 64);
+    if (id < 0) return -1;
+    PhDev* d = ph_virt_get(id);
+    if (d) d->vsrc = vsrc;
+    return padhost_virtual_start(id) == 0 ? id : -1;
+}
+static int dev_hidden(int id)
+{
+    PhDev* d = ph_virt_get(id);
+    return d ? (int)d->hidden : -1;
+}
+static void ports_forget(void)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    for (int p = 0; p < PADHOST_MAX_PORTS; p++) s_port[p].last_ident[0] = 0;
+    ReleaseSRWLockExclusive(&s_lock);
+}
+static void dup_reeval(void)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    ph_dup_reeval();
+    ReleaseSRWLockExclusive(&s_lock);
+}
+#define WAIT_FOR(cond, ms) do { ULONGLONG e_ = GetTickCount64() + (ms); \
+                                while (!(cond) && GetTickCount64() < e_) Sleep(1); } while (0)
+
+static void test_virtual_dups(void)
+{
+    printf("-- virtual duplicates (prefer_physical)\n");
+
+    /* The ancestry rules, on a test PC's real chains (DS4Windows 3.3.3 on
+     * ViGEmBus; _evidence/pnp_chains.txt), lower case as ph_vsrc_of passes them. */
+    CHECK(ph_vsrc_step(0, "usb\\vid_045e&pid_028e\\01", "usb\\vid_045e&pid_028e", "xusb22") == -1,
+          "the virtual X360's XUSB device itself: undecided");
+    CHECK(ph_vsrc_step(1, "root\\system\\0001", "nefarius\\vigembus\\gen1", "vigembus") == PH_VSRC_VIGEM,
+          "its parent, the ViGEm bus");
+    CHECK(ph_vsrc_step(1, "root\\system\\0001", "", "vigembus") == PH_VSRC_VIGEM, "the ViGEm bus by its service");
+    CHECK(ph_vsrc_step(1, "root\\scpvbus\\0000", "root\\scpvbus", "scpvbus") == PH_VSRC_SCP, "SCP's bus");
+    CHECK(ph_vsrc_step(0, "hid\\vid_28de&pid_11ff&ig_00\\1&2&0&0000", "hid\\vid_28de&pid_11ff&ig_00", "") ==
+          PH_VSRC_STEAM, "Steam's virtual gamepad ids");
+    CHECK(ph_vsrc_step(0, "hid\\vid_054c&pid_0ce6&mi_03\\a&21a1713&0&0000",
+                       "hid\\vid_054c&pid_0ce6&rev_0100&mi_03|hid\\vid_054c&pid_0ce6&mi_03", "") == -1 &&
+          ph_vsrc_step(1, "usb\\vid_054c&pid_0ce6&mi_03\\9&10db2f99&0&0003", "usb\\vid_054c&pid_0ce6&mi_03",
+                       "hidusb") == -1 &&
+          ph_vsrc_step(2, "usb\\vid_054c&pid_0ce6\\8&6c00884&0&11", "usb\\vid_054c&pid_0ce6", "usbccgp") == -1 &&
+          ph_vsrc_step(3, "usb\\root_hub30\\7&360c8ead&0&0", "usb\\root_hub30", "usbhub3") == PH_VSRC_NONE,
+          "the DualSense on USB: physical at its root hub");
+    CHECK(ph_vsrc_step(2, "bthenum\\{00001124-0000-1000-8000-00805f9b34fb}_vid&0002054c_pid&0ce6\\8&1", "", "hidbth") ==
+          PH_VSRC_NONE && ph_vsrc_step(2, "bthledevice\\{00001812}\\8&2", "", "") == PH_VSRC_NONE,
+          "a Bluetooth radio: physical");
+    CHECK(ph_vsrc_step(0, "root\\vid_1234&pid_bead\\0000", "root\\vid_1234&pid_bead", "vjoy") == -1 &&
+          ph_vsrc_step(1, "htree\\root\\0", "", "") == PH_VSRC_NONE,
+          "a root-enumerated device itself (vJoy) is not a remapper's copy");
+    CHECK(ph_vsrc_step(2, "root\\system\\0003", "some\\virtualbus", "vbus") == PH_VSRC_SOFTBUS,
+          "a pad below a software bus");
+    CHECK(ph_led_slot(6) == 0 && ph_led_slot(7) == 1 && ph_led_slot(9) == 3 && ph_led_slot(2) == 0 &&
+          ph_led_slot(5) == 3 && ph_led_slot(0) == -1 && ph_led_slot(1) == -1 && ph_led_slot(10) == -1 &&
+          ph_led_slot(14) == -1, "XUSB LED state -> XInput player slot");
+
+    PFN_XGetState og = s_x.get;
+    PFN_XSetState os = s_x.set;
+    PFN_XGetBattery ob = s_x.batt;
+    PFN_XGetCapsEx oc = s_x.caps_ex;
+    LONG oe = s_cfg.enabled, obk = s_cfg.backends;
+    s_x.get = vx_get; s_x.set = vx_set; s_x.batt = NULL; s_x.caps_ex = vx_caps; s_x.classify = vx_classify;
+    InterlockedExchange(&s_cfg.enabled, 1);
+    InterlockedExchange(&s_cfg.backends, 1L << PADHOST_KIND_XINPUT);
+    InterlockedExchange(&s_cfg.prefer_physical, 1);
+    memset(s_vx, 0, sizeof s_vx);
+    ports_forget();
+    char who[96];
+    PadHostDeviceInfo info[16];
+
+    /* 1. Startup with DS4Windows running (a test PC on 2026-10-20): its virtual
+     * Xbox 360 pad on XInput next to the DualSense it reads. The copy used to
+     * take port 0 (XInput pads first); now the DualSense is player 1 and the
+     * copy is hidden. */
+    InterlockedExchange(&s_hold_virtual, 1);       /* padhost_init's first scan */
+    InterlockedExchange(&s_hold_ports, 1);
+    vx_plug(0, PH_VSRC_VIGEM, 0x045E, 0x028E);
+    CHECK(s_x.slot[0].connected && s_x.slot[0].vsrc == PH_VSRC_VIGEM && s_x.slot[0].port < 0,
+          "the virtual pad waits for the physical ones (port %d)", s_x.slot[0].port);
+    int ds = vdev(&stub_ds_drv, 0x054C, 0x0CE6, "ds-a", 0);
+    ph_release_held_ports();
+    CHECK(!s_hold_virtual && !s_hold_ports, "holds released");
+    CHECK(padhost_virtual_port(ds) == 0, "DualSense on port 0 (%d)", padhost_virtual_port(ds));
+    CHECK(s_x.slot[0].hidden && s_x.slot[0].port < 0, "the ViGEm copy hidden (hidden %d port %d)",
+          s_x.slot[0].hidden, s_x.slot[0].port);
+    CHECK(connected_ports() == 1, "one controller, one port (%d)", connected_ports());
+    CHECK(padhost_port_describe(0, who, (int)sizeof who) == 1 && strstr(who, "stub-ds") && strstr(who, "(USB)") &&
+          !strstr(who, "virtual Xbox"), "player 1: %s", who);
+    {
+        int n = padhost_enum_devices(info, 16), seen = 0;
+        for (int i = 0; i < n && i < 16; i++)
+            if (!strcmp(info[i].path, "xinput#0")) {
+                seen = 1;
+                CHECK(info[i].hidden && info[i].port < 0 && !strcmp(info[i].virt, "ViGEm bus"),
+                      "listed as hidden, virtual \"%s\"", info[i].virt);
+            }
+        CHECK(seen, "the hidden copy is still listed");
+    }
+
+    /* 2. DS4Windows stops: its pad goes, nothing moves. */
+    unsigned gen = padhost_generation();
+    vx_unplug(0);
+    CHECK(!s_x.slot[0].connected && padhost_virtual_port(ds) == 0 && padhost_generation() == gen,
+          "copy gone, DualSense still port 0, no port change");
+
+    /* 3. DS4Windows started while the game runs: hidden at once. */
+    vx_plug(0, PH_VSRC_VIGEM, 0x045E, 0x028E);
+    CHECK(s_x.slot[0].connected && s_x.slot[0].hidden && s_x.slot[0].port < 0 && padhost_virtual_port(ds) == 0 &&
+          padhost_generation() == gen, "a copy that arrives later: hidden, no port change (port %d)", s_x.slot[0].port);
+
+    /* 4. The DualSense unplugged (or hidden by HidHide) while DS4Windows still
+     * feeds its copy: the copy takes over port 0. */
+    padhost_virtual_detach(ds);
+    CHECK(s_x.slot[0].port == 0 && !s_x.slot[0].hidden, "standby copy takes port 0 (port %d hidden %d)",
+          s_x.slot[0].port, s_x.slot[0].hidden);
+    CHECK(padhost_port_describe(0, who, (int)sizeof who) == 1 && !strcmp(who, "virtual Xbox controller (ViGEm bus)"),
+          "player 1: %s", who);
+
+    /* 5. Replugged: DS4Windows' copy is on port 0 already (it can be quicker
+     * than our open); the DualSense opens on port 1, then takes port 0 over. */
+    ds = vdev(&stub_ds_drv, 0x054C, 0x0CE6, "ds-a", 0);
+    WAIT_FOR(padhost_virtual_port(ds) == 0 && s_x.slot[0].hidden, 1000);
+    CHECK(padhost_virtual_port(ds) == 0 && s_x.slot[0].hidden && s_x.slot[0].port < 0,
+          "replug: DualSense back on port 0 (%d), copy hidden (%d)", padhost_virtual_port(ds), s_x.slot[0].hidden);
+    CHECK(wait_state(1, 0, 500) && connected_ports() == 1, "port 1 empty again");
+
+    /* 6. prefer_physical switched at run time. */
+    InterlockedExchange(&s_cfg.prefer_physical, 0);
+    dup_reeval();
+    CHECK(!s_x.slot[0].hidden && s_x.slot[0].port == 1 && padhost_virtual_port(ds) == 0,
+          "prefer_physical=0: the copy is an ordinary pad (port %d)", s_x.slot[0].port);
+    InterlockedExchange(&s_cfg.prefer_physical, 1);
+    dup_reeval();
+    CHECK(s_x.slot[0].hidden && s_x.slot[0].port < 0 && ph_port_free(1), "prefer_physical=1 again: hidden");
+    vx_unplug(0);
+    padhost_virtual_detach(ds);
+    CHECK(connected_ports() == 0, "clean");
+    ports_forget();
+
+    /* 7. A real Xbox pad next to a DualSense: not on any virtual bus, so both
+     * keep a port -- and DS4Windows' copy of the DualSense is still hidden. */
+    InterlockedExchange(&s_hold_virtual, 1);
+    InterlockedExchange(&s_hold_ports, 1);
+    vx_plug(0, PH_VSRC_NONE, 0x045E, 0x0B12);
+    ds = vdev(&stub_ds_drv, 0x054C, 0x0CE6, "ds-b", 0);
+    ph_release_held_ports();
+    CHECK(s_x.slot[0].port == 0 && !s_x.slot[0].hidden && padhost_virtual_port(ds) == 1,
+          "Xbox port 0 (XInput first, %d), DualSense port 1 (%d)", s_x.slot[0].port, padhost_virtual_port(ds));
+    CHECK(padhost_port_describe(0, who, (int)sizeof who) == 1 && strstr(who, "Xbox controller (XInput") == who,
+          "player 1: %s", who);
+    vx_plug(1, PH_VSRC_VIGEM, 0x045E, 0x028E);
+    CHECK(s_x.slot[1].hidden && s_x.slot[1].port < 0 && s_x.slot[0].port == 0 && padhost_virtual_port(ds) == 1,
+          "DS4Windows' copy of the DualSense hidden; the two real pads keep 0 and 1");
+    CHECK(connected_ports() == 2, "two controllers, two ports");
+    vx_unplug(1);
+    vx_unplug(0);
+    padhost_virtual_detach(ds);
+    CHECK(connected_ports() == 0, "clean");
+    ports_forget();
+
+    /* 8. Steam Input: Valve's virtual pads (28DE), which may copy an Xbox pad
+     * as well as a PlayStation one. */
+    vx_plug(0, PH_VSRC_NONE, 0x045E, 0x0B12);
+    vx_plug(1, PH_VSRC_NONE, 0x28DE, 0x11FF);          /* the VID alone says Steam */
+    CHECK(s_x.slot[0].port == 0 && s_x.slot[1].vsrc == PH_VSRC_STEAM && s_x.slot[1].hidden && s_x.slot[1].port < 0,
+          "Steam's copy of the Xbox pad hidden (vsrc %d hidden %d port %d)", s_x.slot[1].vsrc, s_x.slot[1].hidden,
+          s_x.slot[1].port);
+    ds = vdev(&stub_ds_drv, 0x054C, 0x0CE6, "ds-c", 0);
+    WAIT_FOR(padhost_virtual_port(ds) == 1, 1000);
+    vx_plug(2, PH_VSRC_NONE, 0x28DE, 0x11FF);
+    CHECK(padhost_virtual_port(ds) == 1 && s_x.slot[2].hidden && s_x.slot[2].port < 0,
+          "Steam's copy of the DualSense hidden too");
+    vx_plug(3, PH_VSRC_NONE, 0x28DE, 0x11FF);
+    CHECK(!s_x.slot[3].hidden && s_x.slot[3].port == 2,
+          "a third Steam pad, with nothing left to copy, is an ordinary pad (port %d)", s_x.slot[3].port);
+    CHECK(connected_ports() == 3, "three ports (%d)", connected_ports());
+    for (int i = 3; i >= 0; i--) vx_unplug(i);
+    padhost_virtual_detach(ds);
+    CHECK(connected_ports() == 0, "clean");
+    ports_forget();
+
+    /* 9. DS4Windows' DUALSHOCK 4 output mode: the copy is a HID pad on the
+     * ViGEm bus that our own DS4 driver opens. */
+    ds = vdev(&stub_ds_drv, 0x054C, 0x0CE6, "ds-d", 0);
+    WAIT_FOR(padhost_virtual_port(ds) == 0, 1000);
+    int v4 = vdev(&stub_ds4_drv, 0x054C, 0x05C4, "vds4", PH_VSRC_VIGEM);
+    WAIT_FOR(dev_hidden(v4) == 1, 1000);
+    CHECK(v4 > 0 && dev_hidden(v4) == 1 && padhost_virtual_port(v4) < 0 && padhost_virtual_port(ds) == 0,
+          "virtual DS4 hidden (hidden %d port %d)", dev_hidden(v4), padhost_virtual_port(v4));
+    padhost_virtual_detach(ds);
+    WAIT_FOR(padhost_virtual_port(v4) == 0, 1000);
+    CHECK(padhost_virtual_port(v4) == 0 && dev_hidden(v4) == 0, "and takes over when the DualSense goes (%d)",
+          padhost_virtual_port(v4));
+    CHECK(padhost_port_describe(0, who, (int)sizeof who) == 1 && strstr(who, "virtual ") == who && strstr(who, "ViGEm"),
+          "player 1: %s", who);
+    padhost_virtual_detach(v4);
+    CHECK(connected_ports() == 0, "clean");
+    ports_forget();
+
+    /* 10. Two DualSenses, one copy (the other pad's copy hidden from us, or
+     * DS4Windows mapping one pad only): one hidden, the rest are pads. */
+    int da = vdev(&stub_ds_drv, 0x054C, 0x0CE6, "ds-e", 0);
+    int db = vdev(&stub_ds_drv, 0x054C, 0x0CE6, "ds-f", 0);
+    WAIT_FOR(padhost_virtual_port(da) >= 0 && padhost_virtual_port(db) >= 0, 1000);
+    vx_plug(0, PH_VSRC_VIGEM, 0x045E, 0x028E);
+    vx_plug(1, PH_VSRC_VIGEM, 0x045E, 0x028E);
+    vx_plug(2, PH_VSRC_VIGEM, 0x045E, 0x028E);
+    CHECK(s_x.slot[0].hidden && s_x.slot[1].hidden && !s_x.slot[2].hidden && s_x.slot[2].port == 2,
+          "as many copies hidden as there are physical pads (%d %d %d, port %d)", s_x.slot[0].hidden,
+          s_x.slot[1].hidden, s_x.slot[2].hidden, s_x.slot[2].port);
+    padhost_virtual_detach(db);
+    CHECK(!s_x.slot[1].hidden && s_x.slot[1].port == 1 && s_x.slot[0].hidden,
+          "one physical pad left: one copy takes the port it freed (port %d)", s_x.slot[1].port);
+    for (int i = 2; i >= 0; i--) vx_unplug(i);
+    padhost_virtual_detach(da);
+    CHECK(connected_ports() == 0, "clean");
+    ports_forget();
+
+    /* 11. prefer_physical = 0 from the start: exactly the old order (padhost_init
+     * holds nothing back for it) -- the copy is player 1. */
+    InterlockedExchange(&s_cfg.prefer_physical, 0);
+    InterlockedExchange(&s_hold_virtual, s_cfg.prefer_physical ? 1 : 0);
+    InterlockedExchange(&s_hold_ports, 1);
+    vx_plug(0, PH_VSRC_VIGEM, 0x045E, 0x028E);
+    CHECK(s_x.slot[0].port == 0, "prefer_physical=0: the copy gets port 0 at connect (%d)", s_x.slot[0].port);
+    ds = vdev(&stub_ds_drv, 0x054C, 0x0CE6, "ds-g", 0);
+    ph_release_held_ports();
+    CHECK(s_x.slot[0].port == 0 && !s_x.slot[0].hidden && padhost_virtual_port(ds) == 1,
+          "old order: XInput copy 0, DualSense 1 (%d %d)", s_x.slot[0].port, padhost_virtual_port(ds));
+    vx_unplug(0);
+    padhost_virtual_detach(ds);
+    CHECK(connected_ports() == 0, "clean");
+    ports_forget();
+
+    InterlockedExchange(&s_cfg.prefer_physical, 1);
+    InterlockedExchange(&s_cfg.backends, obk);
+    InterlockedExchange(&s_cfg.enabled, oe);
+    s_x.get = og; s_x.set = os; s_x.batt = ob; s_x.caps_ex = oc; s_x.classify = NULL;
+}
+
+static volatile LONG s_stop_reader, s_torn, s_reads;
+static int s_reader_port;
+
+static DWORD WINAPI reader(LPVOID unused)
+{
+    (void)unused;
+    PadHostPortState st;
+    while (!s_stop_reader) {
+        if (padhost_get(s_reader_port, &st)) {
+            if (!(st.lx == st.ly && st.ly == st.rx && st.rx == st.ry && st.press[0] == st.lx)) InterlockedIncrement(&s_torn);
+            InterlockedIncrement(&s_reads);
+        }
+    }
+    return 0;
+}
+
+static void test_concurrency(void)
+{
+    printf("-- snapshot consistency under load\n");
+    int a = attach("T", 0, 0);
+    s_reader_port = padhost_virtual_port(a);
+    unsigned char r[64];
+    report(r, 0, 0, 0, 0, 0, 50);
+    padhost_virtual_feed(a, r, 64);
+    HANDLE th[3];
+    for (int i = 0; i < 3; i++) th[i] = CreateThread(NULL, 0, reader, NULL, 0, NULL);
+    for (int k = 0; k < 3000; k++) {
+        u8 v = (u8)(k * 7);
+        report(r, (u16)k, v, v, v, v, 50);
+        r[18] = v;
+        padhost_virtual_feed(a, r, 64);
+    }
+    InterlockedExchange(&s_stop_reader, 1);
+    WaitForMultipleObjects(3, th, TRUE, 5000);
+    for (int i = 0; i < 3; i++) CloseHandle(th[i]);
+    CHECK(s_torn == 0, "%ld torn snapshots in %ld reads", s_torn, s_reads);
+    printf("    %ld snapshot reads by 3 threads during 3000 reports\n", s_reads);
+
+    LARGE_INTEGER f, t0, t1;
+    PadHostPortState st;
+    QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&t0);
+    for (int i = 0; i < 1000000; i++) padhost_get(s_reader_port, &st);
+    QueryPerformanceCounter(&t1);
+    double ns = (double)(t1.QuadPart - t0.QuadPart) * 1e9 / (double)f.QuadPart / 1e6;
+    printf("    padhost_get: %.1f ns per call\n", ns);
+    CHECK(ns < 2000, "padhost_get is cheap (%.1f ns)", ns);
+    padhost_virtual_detach(a);
+}
+
+static void test_shutdown(void)
+{
+    printf("-- shutdown and re-init\n");
+    unsigned char last[4];
+    int a = attach("Z", 0, 0);
+    int p = padhost_virtual_port(a);
+    wait_outputs(a, 1, 500, last);
+    padhost_set_actuator(p, 1, 128);
+    wait_outputs(a, 2, 500, last);
+    LONG closes = s_close_calls;
+    padhost_shutdown();
+    CHECK(s_close_calls == closes + 1, "close() ran on shutdown");
+    CHECK(s_close_out[0] == 5 && s_close_out[1] == 0 && s_close_out[2] == 0 && s_close_out[3] == 0xFF, "motors off");
+    PadHostPortState st;
+    CHECK(padhost_get(p, &st) == 0, "nothing connected after shutdown");
+    padhost_set_actuator(p, 1, 1);           /* harmless after shutdown */
+    padhost_shutdown();                       /* idempotent */
+    padhost_init();
+    int b = attach("Z", 0, 0);
+    CHECK(b > 0 && padhost_virtual_port(b) == 0, "works again after re-init");
+    padhost_virtual_detach(b);
+}
