diff --git a/runtime/spu/tests/test_spu_mfc_slots.c b/runtime/spu/tests/test_spu_mfc_slots.c
index 229e62f..ae730e0 100644
--- a/runtime/spu/tests/test_spu_mfc_slots.c
+++ b/runtime/spu/tests/test_spu_mfc_slots.c
@@ -23,6 +23,11 @@
