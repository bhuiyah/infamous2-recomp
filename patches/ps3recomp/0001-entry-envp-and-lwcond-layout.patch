+++ b/runtime/spu/spu_coh_bitmap.h
@@ -0,0 +1,48 @@
+/*
+ * ps3recomp - the SPU reserved-line bitmap, for inline readers
+ *
+ * One bit per 128-byte guest line, set by an SPU GETLLAR (spu_coh_reserve in
+ * spu_coherency.c, which owns the storage) and never cleared. A PPU store to a
+ * marked line has to go through the lock-line lock and notify the reserving
+ * SPU; every other store is a plain store.
+ *
+ * spu_coh_is_reserved() in spu_coherency.c answers that question, but every
+ * lifted guest store asks it, and a call into another translation unit (the
+ * runtime is a static library, no LTO) cost more than the lookup itself. This
+ * header exposes the bitmap so the PPU store fast path (ppu_loader.cpp) can do
+ * the lookup inline. No dependencies, so it is cheap to include from C++.
+ *
+ * Read without the lock, exactly as spu_coh_is_reserved always did: a stale
+ * zero can only miss a line in the instant it is first reserved.
+ */
+#ifndef SPU_COH_BITMAP_H
+#define SPU_COH_BITMAP_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SPU_COH_LINE_SHIFT  7                                  /* 128-byte lines */
+#define SPU_COH_LINES       (1u << (32 - SPU_COH_LINE_SHIFT))   /* 2^25 lines */
+#define SPU_COH_BITMAP_SZ   (SPU_COH_LINES / 8)                 /* 4 MiB */
+
+/* Defined in spu_coherency.c. */
+extern unsigned char g_spu_coh_bitmap[SPU_COH_BITMAP_SZ];
+/* Zero until the first GETLLAR anywhere: keeps a title that runs no SPU code
+ * off the bitmap's cache lines entirely. */
+extern int g_spu_coh_armed;
+
+static inline int spu_coh_is_reserved_inline(uint32_t addr)
+{
+    if (!__atomic_load_n(&g_spu_coh_armed, __ATOMIC_RELAXED)) return 0;
+    uint32_t line = addr >> SPU_COH_LINE_SHIFT;
+    return (__atomic_load_n(&g_spu_coh_bitmap[line >> 3], __ATOMIC_RELAXED) >> (line & 7)) & 1u;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SPU_COH_BITMAP_H */
