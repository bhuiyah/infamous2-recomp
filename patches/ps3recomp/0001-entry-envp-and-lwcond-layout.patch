+/* Write all of text in the file's encoding: <path>.tmp, then an atomic replace. */
+static int file_replace(const char* path, const char* text, int enc)
+{
+    ini_buf bytes = {0};
+    ini_text_encode(text, enc, &bytes);
+    char tmp[1100];
+    snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    FILE* f = fopen(tmp, "wb");
+    if (!f) { ini_buf_free(&bytes); return 0; }
+    size_t w = fwrite(bytes.p, 1, bytes.n, f);
+    int ok = (w == bytes.n) && fflush(f) == 0;
+    ok = (fclose(f) == 0) && ok;
+    ini_buf_free(&bytes);
+    if (!ok) { remove(tmp); return 0; }
+#ifdef _WIN32
+    if (!MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) { remove(tmp); return 0; }
+#else
+    if (rename(tmp, path) != 0) { remove(tmp); return 0; }
+#endif
+    return 1;
+}
