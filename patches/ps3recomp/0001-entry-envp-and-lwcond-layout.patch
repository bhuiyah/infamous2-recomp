+/* ---------------------------------------------------------------- values */
+
+/* index of v in a '|' list (normalised compare), -1 if absent; the list's
+ * spelling of it into canon */
+static int list_index(const char* list, const char* v, char* canon, size_t cn)
+{
+    char want[64];
+    ini_norm(v, strlen(v), want, sizeof want);
+    int idx = 0;
+    for (const char* p = list; p && *p; idx++) {
+        const char* e = strchr(p, '|');
+        size_t n = e ? (size_t)(e - p) : strlen(p);
+        char w[64];
+        ini_norm(p, n, w, sizeof w);
+        if (w[0] && !strcmp(w, want)) {
+            if (canon) { if (n >= cn) n = cn - 1; memcpy(canon, p, n); canon[n] = 0; }
+            return idx;
+        }
+        if (!e) break;
+        p = e + 1;
+    }
+    return -1;
+}
+
+static void trim_copy(const char* v, char* out, size_t n)
+{
+    while (*v == ' ' || *v == '\t') v++;
+    size_t k = strlen(v);
+    while (k && (v[k - 1] == ' ' || v[k - 1] == '\t' || v[k - 1] == '\r' || v[k - 1] == '\n')) k--;
+    if (k >= n) k = n - 1;
+    memcpy(out, v, k);
+    out[k] = 0;
+}
+
+/* Validate v for d: 1 with *num and the canonical text, 0 if it is not a value of d. */
+static int parse_value(const opt_def* d, const char* v, double* num, char* canon, size_t cn)
+{
+    char t[OPT_VALLEN], n[64];
+    if (!v) return 0;
+    trim_copy(v, t, sizeof t);
+    ini_norm(t, strlen(t), n, sizeof n);
+    switch (d->type) {
+    case OPT_BOOL:
+        if (!strcmp(n, "1") || !strcmp(n, "on") || !strcmp(n, "true") || !strcmp(n, "yes")) {
+            *num = 1; snprintf(canon, cn, "1"); return 1; }
+        if (!strcmp(n, "0") || !strcmp(n, "off") || !strcmp(n, "false") || !strcmp(n, "no")) {
+            *num = 0; snprintf(canon, cn, "0"); return 1; }
+        return 0;
+    case OPT_INT: case OPT_FLOAT: {
+        int k = d->values ? list_index(d->values, t, canon, cn) : -1;
+        if (k >= 0) { *num = -(double)(k + 1); return 1; }
+        char* end;
+        double x = strtod(t, &end);
+        if (end == t || *end || x != x || x < d->lo || x > d->hi) return 0;
+        if (d->type == OPT_INT && x != floor(x)) return 0;
+        *num = x;
+        snprintf(canon, cn, "%s", t);
+        return 1;
+    }
+    case OPT_ENUM: {
+        int k = list_index(d->values, t, canon, cn);
+        if (k < 0) {   /* an enum with "on" / "off" choices takes the bool words too (display.ini show_fps = 1) */
+            const char* w = (!strcmp(n, "1") || !strcmp(n, "true") || !strcmp(n, "yes")) ? "on"
+                          : (!strcmp(n, "0") || !strcmp(n, "false") || !strcmp(n, "no")) ? "off" : NULL;
+            if (w) k = list_index(d->values, w, canon, cn);
+        }
+        if (k < 0) return 0;
+        *num = k;
+        return 1;
+    }
+    default:
+        if (d->check && !d->check(t)) return 0;
+        *num = 0;
+        snprintf(canon, cn, "%s", t);
+        return 1;
+    }
+}
+
+/* Two values of d the same? (numbers by value, text by normalised spelling) */
+static int same_value(const opt_def* d, const char* a, const char* b)
+{
+    double x, y;
+    char ca[OPT_VALLEN], cb[OPT_VALLEN];
+    if (parse_value(d, a, &x, ca, sizeof ca) && parse_value(d, b, &y, cb, sizeof cb)) {
+        if (d->type == OPT_TEXT) {
+            char na[96], nb[96];
+            ini_norm(ca, strlen(ca), na, sizeof na);
+            ini_norm(cb, strlen(cb), nb, sizeof nb);
+            return !strcmp(na, nb);
+        }
+        return x == y;
+    }
+    return !strcmp(a, b);
+}
+
+/* "k=v|k=v" (also ';'): the value given for key (or an alias), last one wins */
+static int multi_get(const char* text, const char* key, const char* alias, char* out, size_t n)
+{
+    char want[64];
+    ini_norm(key, strlen(key), want, sizeof want);
+    int found = 0;
+    for (const char* p = text; p && *p; ) {
+        const char* e = p;
+        while (*e && *e != '|' && *e != ';') e++;
+        const char* eq = (const char*)memchr(p, '=', (size_t)(e - p));
+        if (eq) {
+            char nm[64];
+            ini_norm(p, (size_t)(eq - p), nm, sizeof nm);
+            if (ini_name_is(nm, want, alias)) {
+                size_t vn = (size_t)(e - eq - 1);
+                char tmp[OPT_VALLEN];
+                if (vn >= sizeof tmp) vn = sizeof tmp - 1;
+                memcpy(tmp, eq + 1, vn); tmp[vn] = 0;
+                trim_copy(tmp, out, n);
+                found = 1;
+            }
+        }
+        p = *e ? e + 1 : e;
+    }
+    return found;
+}
+
+static int home_is(const opt_def* d, const char* h) { return d->home && !strcmp(d->home, h); }
+
+/* Resolve a row's value from the layers (store lock held or not yet shared). */
+static void resolve(opt_slot* s)
+{
+    const opt_def* d = s->d;
+    char canon[OPT_VALLEN], buf[OPT_VALLEN];
+    double num = 0;
+    if (!parse_value(d, d->dflt, &num, canon, sizeof canon)) { snprintf(canon, sizeof canon, "%s", d->dflt); num = 0; }
+    snprintf(s->val, sizeof s->val, "%s", canon);
+    s->src = OPT_SRC_DEFAULT;
+    s->lock = NULL;
+    s->home_val[0] = s->file_val[0] = 0;
+    s->home_line = s->file_line = 0;
+
+    const ini_buf* home = home_is(d, "display") ? &s_txt_display : home_is(d, "input") ? &s_txt_input : NULL;
+    if (home && home->p && home->n) {
+        int ln = ini_get(home->p, NULL, d->key, d->alias, buf, sizeof buf);
+        if (ln) {
+            if (parse_value(d, buf, &num, canon, sizeof canon)) {
+                snprintf(s->val, sizeof s->val, "%s", canon);
+                snprintf(s->home_val, sizeof s->home_val, "%s", canon);
+                s->home_line = ln;
+                s->src = OPT_SRC_HOME;
+            } else {
+                opt_logf("%s:%d: %s = %s is not one of this row's values: its own parser decides what it "
+                         "means, the store keeps the default", home_is(d, "display") ? "display.ini" : "input.ini",
+                         ln, d->key, buf);
+            }
+        }
+    }
+    if (s_txt_opts.p && s_txt_opts.n) {
+        int ln = ini_get(s_txt_opts.p, d->section, d->key, d->alias, buf, sizeof buf);
+        if (ln) {
+            if (parse_value(d, buf, &num, canon, sizeof canon)) {
+                snprintf(s->val, sizeof s->val, "%s", canon);
+                snprintf(s->file_val, sizeof s->file_val, "%s", canon);
+                s->file_line = ln;
+                s->src = OPT_SRC_FILE;
+            } else {
+                opt_logf("options.ini:%d: %s = %s is not a value of this setting: ignored", ln, d->key, buf);
+            }
+        }
+    }
+    const char* envs[3] = { d->env_multi, "OPTIONS_CFG", d->env };
+    for (int k = 0; k < 3; k++) {
+        const char* name = envs[k];
+        const char* ev = name ? getenv(name) : NULL;
+        if (!ev || !*ev) continue;
+        int got = 0;
+        if (k < 2) got = multi_get(ev, d->key, d->alias, buf, sizeof buf);
+        else { trim_copy(ev, buf, sizeof buf); got = 1; }
+        if (!got) continue;
+        s->lock = name;
+        s->src = OPT_SRC_ENV;
+        if (parse_value(d, buf, &num, canon, sizeof canon)) snprintf(s->val, sizeof s->val, "%s", canon);
+        else opt_logf("%s: %s = %s is not a value of this setting; it is locked by %s anyway "
+                      "(its own module reads the variable)", name, d->key, buf, name);
+    }
+    double x;
+    char c2[OPT_VALLEN];
+    if (!parse_value(d, s->val, &x, c2, sizeof c2)) x = 0;
+    InterlockedExchange64(&s->bits, bits_from_d(x));
+    snprintf(s->start, sizeof s->start, "%s", s->val);
+    snprintf(s->rold, sizeof s->rold, "%s", s->val);
+}
