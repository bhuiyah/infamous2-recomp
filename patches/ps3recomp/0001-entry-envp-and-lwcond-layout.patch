+extern "C" const ppu_cont_entry* ppu_cont_lookup(uint32_t ra)
+{
+    for (int k = 0; k < s_nimg; k++) {
+        const ppu_cont_entry* t = s_img[k].t;
+        uint32_t lo = 0, hi = s_img[k].n;
+        if (ra < t[0].ra || ra > t[hi - 1].ra) continue;
+        while (lo < hi) {
+            uint32_t mid = (lo + hi) / 2;
+            if (t[mid].ra < ra) lo = mid + 1;
+            else hi = mid;
+        }
+        if (lo < s_img[k].n && t[lo].ra == ra) return &t[lo];
+    }
+    return nullptr;
+}
+
+extern "C" uint32_t ppu_cont_count(void)
+{
+    uint32_t n = 0;
+    for (int k = 0; k < s_nimg; k++) n += s_img[k].n;
+    return n;
+}
+
+/* FNV-1a over every continuation's return address and exit kind, image by
+ * image: a save-state file records the saving build's (informational). */
+extern "C" uint64_t ppu_cont_hash(void)
+{
+    uint64_t h = 1469598103934665603ull;
+    for (int k = 0; k < s_nimg; k++)
+        for (uint32_t i = 0; i < s_img[k].n; i++) {
+            const uint32_t v[2] = { s_img[k].t[i].ra, s_img[k].t[i].exit_kind };
+            const uint8_t* b = (const uint8_t*)v;
+            for (size_t j = 0; j < sizeof v; j++) { h ^= b[j]; h *= 1099511628211ull; }
+        }
+    return h;
+}
+
+extern "C" void ppu_cont_bad_entry(ppu_context* ctx, uint32_t owner, uint32_t ra)
+{
+    fprintf(stderr, "[resume] FATAL: continuation of func_%08X entered at 0x%08X, which is not "
+                    "one of its return sites (table and clones out of step; relift) tid=%llu\n",
+            owner, ra, ctx ? (unsigned long long)ctx->thread_id : 0ull);
+    fflush(stderr);
+    abort();
+}
+
+/* ------------------------------------------------------------------------ */
+/* Guest code decoding (the call at ra-4, a callee's prologue)               */
+/* ------------------------------------------------------------------------ */
+static int decode_call(uint32_t w, uint32_t addr, uint32_t* target)
+{
+    const uint32_t op = w >> 26;
+    *target = 0;
+    if (w == 0x44000002u) return PPU_CONT_CALL_SC;
+    if (op == 18 && (w & 1)) {                                   /* bl / bla */
+        int32_t li = (int32_t)(w & 0x03FFFFFCu);
+        if (li & 0x02000000) li -= 0x04000000;
+        *target = (w & 2) ? (uint32_t)li : addr + (uint32_t)li;
+        return PPU_CONT_CALL_BL;
+    }
+    if (op == 16 && (w & 1)) {                                   /* bcl */
+        int32_t bd = (int16_t)(w & 0xFFFCu);
+        *target = (w & 2) ? (uint32_t)bd : addr + (uint32_t)bd;
+        return PPU_CONT_CALL_BCL;
+    }
+    if (op == 19 && (w & 1)) {
+        const uint32_t xo = (w >> 1) & 0x3FF;
+        if (xo == 528 || xo == 16) return PPU_CONT_CALL_INDIRECT; /* bcctrl / bclrl */
+    }
+    return 0;
+}
+
+/* The frame a call to `fn` allocates: its `stdu|stwu r1,-N(r1)` within the
+ * first instructions, through up to two unconditional branches (thunks).
+ * -1 = a leaf: it reaches an unconditional blr with no frame and no other
+ * branch, so it cannot have made (or tail-called into the maker of) any
+ * frame. 0 = undecidable (a conditional branch, a call, an indirect jump
+ * first, or too far). */
+static int32_t callee_frame_size(uint32_t fn)
+{
+    uint32_t a = fn;
+    for (int hops = 0, i = 0; i < 16; i++, a += 4) {
+        uint32_t w;
+        if (!rd32(a, &w)) return 0;
+        const uint32_t op = w >> 26;
+        if ((op == 62 && (w & 3) == 1) || op == 37) {            /* stdu / stwu */
+            if (((w >> 21) & 31) == 1 && ((w >> 16) & 31) == 1) {
+                int32_t d = (int16_t)(w & (op == 62 ? 0xFFFCu : 0xFFFFu));
+                return d < 0 ? -d : 0;
+            }
+        }
+        if (op == 18 && !(w & 1) && hops < 2) {                  /* b thunk */
+            int32_t li = (int32_t)(w & 0x03FFFFFCu);
+            if (li & 0x02000000) li -= 0x04000000;
+            a = ((w & 2) ? (uint32_t)li : a + (uint32_t)li) - 4;
+            hops++;
+            continue;
+        }
+        if (op == 19 && ((w >> 1) & 0x3FF) == 16 && !(w & 1) && (((w >> 21) & 0x14) == 0x14))
+            return -1;                                           /* blr */
+        if (op == 16 || op == 18 || op == 19 || op == 17) return 0;
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Chain validation                                                          */
+/* ------------------------------------------------------------------------ */
+extern "C" uint32_t ppu_resume_first_ra(const ppu_context* ctx, int kind)
+{
+    if (!ctx) return 0;
+    return kind == PPU_PARK_SC ? (uint32_t)ctx->sc_ra : (uint32_t)ctx->lr;
+}
+
+static int fail(ppu_resume_chain* c, int err, uint32_t ra, uint32_t sp, const char* fmt, ...)
+{
+    c->err = err;
+    c->err_ra = ra;
+    c->err_sp = sp;
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(c->why, sizeof c->why, fmt, ap);
+    va_end(ap);
+    return err;
+}
+
+/* Walk the chain a resume of ctx would run, checking at each frame what the
+ * resume relies on:
+ *   - the return address has a continuation;
+ *   - the guest code at ra-4 is the call the lifter saw there (a bl to the
+ *     same target, an indirect call, an sc) -- the image in memory is the
+ *     image that was lifted, and the saved LR really is a return address;
+ *   - r1 is word aligned, inside the stack bounds if given, and never goes
+ *     down from one frame to the next;
+ *   - FRAME SHAPE: the continuation's exit model -- how its epilogue pops the
+ *     frame and where it reloads LR, found by the lifter from the guest code
+ *     after ra -- agrees with the stack: for a static frame of N bytes, the
+ *     back chain word at r1 must be exactly r1 + N. The model is the frame
+ *     the return address RUNS in, not the frame of the lifted function that
+ *     holds it: a tail fragment's model is its owner's frame (the critic's
+ *     correction -- "the callee at ra-4 owns the next frame" is wrong for
+ *     fragments), so fragments validate like any other frame;
+ *   - the next return address is read from the slot that epilogue reloads LR
+ *     from, the next r1 is what it leaves in r1.
+ * The walk ends at park->root_lr (the LR the thread entry was called with),
+ * at a continuation that never returns (a thread's main loop), or at the
+ * process's first frame (back chain 0) when that continuation never returns.
+ * A soft check is reported, not refused: when the next frame was entered by
+ * `bl T`, T's prologue should allocate the frame we just left (a sibling
+ * tail call legitimately breaks it). */
+static int walk_impl(const ppu_context* ctx, const ppu_resume_park* park, ppu_resume_chain* c,
+                     int census)
+{
+    memset(c, 0, sizeof *c);
+    uint32_t ra = ppu_resume_first_ra(ctx, park->kind);
+    uint32_t sp = (uint32_t)ctx->gpr[1];
+    /* (An HLE call whose LR is the root's -- an import stub tail-called by a
+     * thread's frameless entry -- returns straight to the root: a chain of no
+     * frames, accepted below. An `sc` never returns to the root, so a zero
+     * sc_ra means the code that issued it did not record one.) */
+    if (!ra && park->kind == PPU_PARK_SC)
+        return fail(c, PPU_RESUME_ERR_NO_RA, 0, sp,
+                    "the parked syscall recorded no return address (code lifted without sc_ra?)");
+    const uint32_t lo = park->stack_lo, hi = park->stack_hi;
+    uint32_t prev_frame = 0;            /* static frame size of the frame just left */
+    for (;;) {
+        if (ra == park->root_lr) {
+            /* The root's return address must come with the root's r1: a saved
+             * LR that merely happens to hold the same value (0) deeper in the
+             * stack would end the resume early -- the thread would "return"
+             * from its entry with frames still on its stack. */
+            if (park->root_sp && sp != park->root_sp)
+                return fail(c, PPU_RESUME_ERR_ROOT, ra, sp,
+                            "the chain reaches the root's return address 0x%08X with r1 0x%08X,"
+                            " not the root's 0x%08X", ra, sp, park->root_sp);
+            c->root = PPU_RESUME_ROOT_LR;
+            return PPU_RESUME_OK;
+        }
+        if (c->n >= PPU_RESUME_MAX_FRAMES)
+            return fail(c, PPU_RESUME_ERR_DEPTH, ra, sp, "more than %d frames", PPU_RESUME_MAX_FRAMES);
+        if ((sp & 7) || sp < 0x10000u || (hi && (sp < lo || sp >= hi)))
+            return fail(c, PPU_RESUME_ERR_SP, ra, sp, "r1 0x%08X out of range or misaligned", sp);
+        const ppu_cont_entry* e = ppu_cont_lookup(ra);
+        if (!e && !census)
+            return fail(c, PPU_RESUME_ERR_NO_CONT, ra, sp,
+                        "no continuation for return address 0x%08X (frame %d)", ra, c->n);
+        if (!e) {
+            /* Census (the probe): note the frame, step over it with the ABI
+             * back chain (its function's frame is at r1, its saved LR at
+             * back chain + 0x10), and keep checking the frames above. */
+            ppu_resume_frame* m = &c->f[c->n++];
+            m->ra = ra; m->sp = sp; m->e = nullptr; m->link = 0;
+            c->missing++;
+            uint64_t b64 = 0, l64 = 0;
+            const uint32_t b = rd64(sp, &b64) ? (uint32_t)b64 : 1u;
+            if (!b) { c->root = PPU_RESUME_ROOT_ZERO_BC; return PPU_RESUME_OK; }
+            if (b <= sp || (b & 7) || !rd64(b + 0x10, &l64)) { c->cut = 1; return PPU_RESUME_OK; }
+            sp = b;
+            ra = (uint32_t)l64;
+            prev_frame = 0;
+            continue;
+        }
+        ppu_resume_frame* f = &c->f[c->n++];
+        f->ra = ra; f->sp = sp; f->e = e; f->link = 0;
+
+        /* An `sc` leaves LR alone and pushes no frame, so only the parked call
+         * itself can be one, and a parked syscall's first return address must
+         * be one: a SAVED LR that follows an `sc`, or an HLE park whose LR
+         * does, is stale. (By the table's call kind, which the check below
+         * holds to the guest code when that is in memory.) */
+        {
+            const int want_sc = c->n == 1 && park->kind == PPU_PARK_SC;
+            if ((e->call_kind == PPU_CONT_CALL_SC) != want_sc)
+                return fail(c, PPU_RESUME_ERR_CALL_MISMATCH, ra, sp,
+                            want_sc ? "the parked syscall's return address 0x%08X does not follow an `sc`"
+                            : c->n == 1 ? "the parked HLE call's return address 0x%08X follows an `sc`"
+                                        : "the saved LR 0x%08X follows an `sc` (a stale LR: an `sc` pushes"
+                                          " no frame)", ra);
+        }
+        uint32_t w = 0, tgt = 0;
+        if (rd32(ra - 4, &w) && w) {
+            const int k = decode_call(w, ra - 4, &tgt);
+            if (k != e->call_kind ||
+                ((k == PPU_CONT_CALL_BL || k == PPU_CONT_CALL_BCL) && tgt != e->callee))
+                return fail(c, PPU_RESUME_ERR_CALL_MISMATCH, ra, sp,
+                            "guest code at 0x%08X is 0x%08X, not the call the continuation "
+                            "follows (kind %u -> 0x%08X)", ra - 4, w, e->call_kind, e->callee);
+            /* The frame just left was entered by this call. A leaf callee
+             * cannot have made it (a stale saved LR): refuse. A callee with a
+             * frame of another size: report (a sibling tail call does that). */
+            if (c->n >= 2 && k == PPU_CONT_CALL_BL && prev_frame) {
+                const int32_t n = callee_frame_size(tgt);
+                ppu_resume_frame* callee = &c->f[c->n - 2];
+                if (n < 0)
+                    return fail(c, PPU_RESUME_ERR_LINK, ra, sp,
+                                "the 0x%X-byte frame at 0x%08X returns to 0x%08X, after a call to "
+                                "the leaf 0x%08X: a stale saved LR", prev_frame, callee->sp, ra, tgt);
+                if (n > 0) {
+                    callee->link = ((uint32_t)n == prev_frame) ? 1 : 2;
+                    if ((uint32_t)n != prev_frame) c->soft++;
+                }
+            }
+        }
+
+        uint64_t bc64;
+        if (!rd64(sp, &bc64))
+            return fail(c, PPU_RESUME_ERR_READ, ra, sp, "back chain at 0x%08X unreadable", sp);
+        const uint32_t bc = (uint32_t)bc64;
+        if (e->exit_kind == PPU_CONT_EXIT_NORETURN) {
+            c->root = bc ? PPU_RESUME_ROOT_NORETURN : PPU_RESUME_ROOT_ZERO_BC;
+            return PPU_RESUME_OK;
+        }
+        if (e->exit_kind != PPU_CONT_EXIT_RETURNS)
+            return fail(c, PPU_RESUME_ERR_EXIT_UNKNOWN, ra, sp,
+                        "the continuation at 0x%08X has no exit model (the lifter could not "
+                        "follow its epilogue)", ra);
+        if (e->exit_flags & PPU_CONT_F_PARTIAL) c->partial++;
+
+        uint32_t base_r1 = sp;
+        if (e->exit_flags & PPU_CONT_F_R1_BC) {
+            if (bc <= sp || (bc & 7))
+                return fail(c, PPU_RESUME_ERR_SP, ra, sp,
+                            "back chain 0x%08X at r1 0x%08X does not point up the stack", bc, sp);
+            base_r1 = bc;
+            prev_frame = 0;
+        } else if (e->r1_off > 0) {
+            if (bc != sp + (uint32_t)e->r1_off)
+                return fail(c, PPU_RESUME_ERR_FRAME_SHAPE, ra, sp,
+                            "back chain 0x%08X != r1 0x%08X + frame 0x%X of the continuation at "
+                            "0x%08X", bc, sp, (unsigned)e->r1_off, ra);
+            prev_frame = (uint32_t)e->r1_off;
+        } else {
+            prev_frame = 0;                       /* frameless: r1 unchanged */
+        }
+        const uint32_t next_sp = base_r1 + (uint32_t)e->r1_off;
+        const uint32_t lr_base = (e->exit_flags & PPU_CONT_F_LR_BC) ? bc : sp;
+        uint32_t next_ra;
+        if (e->exit_flags & PPU_CONT_F_LR_W32) {
+            if (!rd32(lr_base + (uint32_t)e->lr_off, &next_ra))
+                return fail(c, PPU_RESUME_ERR_READ, ra, sp, "LR slot unreadable");
+        } else {
+            uint64_t v;
+            if (!rd64(lr_base + (uint32_t)e->lr_off, &v))
+                return fail(c, PPU_RESUME_ERR_READ, ra, sp, "LR slot unreadable");
+            next_ra = (uint32_t)v;
+        }
+        if (next_sp < sp)
+            return fail(c, PPU_RESUME_ERR_SP, ra, sp, "the next frame 0x%08X is below r1 0x%08X",
+                        next_sp, sp);
+        sp = next_sp;
+        ra = next_ra;
+    }
+}
+
+extern "C" int ppu_resume_walk(const ppu_context* ctx, const ppu_resume_park* park,
+                               ppu_resume_chain* c)
+{
+    return walk_impl(ctx, park, c, 0);
+}
+
+extern "C" int ppu_resume_walk_census(const ppu_context* ctx, const ppu_resume_park* park,
+                                      ppu_resume_chain* c)
+{
+    return walk_impl(ctx, park, c, 1);
+}
+
+extern "C" const char* ppu_resume_strerror(int err)
+{
+    switch (err) {
+    case PPU_RESUME_OK:                return "ok";
+    case PPU_RESUME_ERR_NO_RA:         return "no-ra";
+    case PPU_RESUME_ERR_NO_CONT:       return "no-continuation";
+    case PPU_RESUME_ERR_CALL_MISMATCH: return "call-mismatch";
+    case PPU_RESUME_ERR_SP:            return "bad-sp";
+    case PPU_RESUME_ERR_FRAME_SHAPE:   return "frame-shape";
+    case PPU_RESUME_ERR_EXIT_UNKNOWN:  return "exit-unknown";
+    case PPU_RESUME_ERR_DEPTH:         return "too-deep";
+    case PPU_RESUME_ERR_READ:          return "unreadable";
+    case PPU_RESUME_ERR_LINK:          return "stale-lr";
+    case PPU_RESUME_ERR_ROOT:          return "root-sp";
+    }
+    return "?";
+}
+
+extern "C" void ppu_resume_format_chain(const ppu_resume_chain* c, char* buf, size_t n)
+{
+    size_t p = 0;
+    if (!n) return;
+    buf[0] = 0;
+    for (int i = 0; i < c->n && p + 1 < n; i++) {
+        const ppu_resume_frame* f = &c->f[i];
+        int k = f->e ? snprintf(buf + p, n - p, " func_%08X+0x%X", f->e->owner, f->ra - f->e->owner)
+                     : snprintf(buf + p, n - p, " 0x%08X(no-continuation)", f->ra);
+        if (k < 0) break;
+        p += (size_t)k;
+        if (f->link == 2 && p + 1 < n) { k = snprintf(buf + p, n - p, "(link?)"); if (k > 0) p += (size_t)k; }
+    }
+    if (c->err && p + 1 < n)
+        snprintf(buf + p, n - p, " | %s at 0x%08X: %s", ppu_resume_strerror(c->err), c->err_ra, c->why);
+    else if (p + 1 < n)
+        snprintf(buf + p, n - p, " | root=%s",
+                 c->root == PPU_RESUME_ROOT_LR ? "lr" : c->root == PPU_RESUME_ROOT_ZERO_BC ? "zero-bc"
+                                                                                        : "noreturn");
+}
+
+/* ------------------------------------------------------------------------ */
+/* The dispatcher                                                            */
+/* ------------------------------------------------------------------------ */
+extern "C" uint32_t ppu_resume_dispatch(ppu_context* ctx, uint32_t ra, uint32_t root_lr)
+{
+    uint32_t steps = 0;
+    g_trampoline_fn = 0;
+    while (ra != root_lr) {
+        const ppu_cont_entry* e = ppu_cont_lookup(ra);
+        if (!e) {
+            fprintf(stderr, "[resume] FATAL: tid=%llu returned to 0x%08X after %u continuation(s), "
+                            "and there is no continuation for it (validate the chain first; add "
+                            "it to the --cont-list)\n",
+                    (unsigned long long)ctx->thread_id, ra, steps);
+            fflush(stderr);
+            abort();
+        }
+        e->fn(ctx);                                   /* the rest of that function, to its blr */
+        while (g_trampoline_fn) {                     /* ...or into its tail fragments */
+            void (*tf)(void*) = g_trampoline_fn;
+            g_trampoline_fn = 0;
+            tf(ctx);
+        }
+        steps++;
+        ra = (uint32_t)ctx->lr;                       /* blr */
+    }
+    return steps;
+}
+
+extern "C" uint32_t ppu_resume_park_ra(const ppu_context* ctx, const ppu_resume_park* park)
+{
+    if (!ctx || !park) return 0;
+    const int sc = park->kind == PPU_PARK_SC || (park->kind == PPU_PARK_WAIT && park->wait_sc);
+    return sc ? (uint32_t)ctx->sc_ra : (uint32_t)ctx->lr;
+}
+
+extern "C" uint32_t ppu_resume_run(ppu_context* ctx, const ppu_resume_park* park)
+{
+    /* (read before the call: lv2_syscall consumes sc_ra on its way out) */
+    const uint32_t ra = ppu_resume_park_ra(ctx, park);
+    const int sc = park->kind == PPU_PARK_SC || (park->kind == PPU_PARK_WAIT && park->wait_sc);
+    g_trampoline_fn = 0;
+    if (park->kind == PPU_PARK_WAIT && park->resume) {
+        park->resume(ctx, park);                  /* the rest of the call */
+        if (sc) ctx->sc_ra = 0;                   /* consumed, as lv2_syscall's exit does */
+    }
+    else if (!sc) ps3_hle_call(park->nid, ctx);   /* the import stub's body */
+    else          lv2_syscall(ctx);               /* the inline sc */
+    return ppu_resume_dispatch(ctx, ra, park->root_lr);
+}
+
+/* ------------------------------------------------------------------------ */
+/* PPU_RESUME_CHECK_EVERY: validate live chains, resume nothing              */
+/* ------------------------------------------------------------------------ */
+static int s_every;
+static std::atomic<uint64_t> s_n_samples, s_n_ok, s_n_err[16], s_n_root[4], s_n_soft,
+    s_n_partial, s_n_bridge, s_n_cov, s_n_cut, s_n_frames, s_n_frames_cont;
+static std::mutex s_log_mx;
+static uint32_t s_missing[1024];
+static int s_nmissing;
+static uint32_t s_bad_ra[64];
+static int s_nbad;
+static uint64_t s_ok_sig[32];
+static int s_nok_sig;
+static PPU_THREAD_LOCAL uint32_t t_probe_n;
+
+static const char* func_name(uint32_t ra, char* buf, size_t n)
+{
+#ifdef PPU_RESUME_HAVE_FUNCTION_TABLE
+    uint32_t best = 0, top = 0;
+    for (uint64_t k = 0; k < function_table_count; k++) {
+        const uint32_t a = (uint32_t)function_table[k].addr;
+        if (a <= ra && a > best) best = a;
+        if (a > top) top = a;
+    }
+    /* (a return address past the title's last function is another image's: libsre_) */
+    if (best && ra < top + 0x10000u) { snprintf(buf, n, "func_%08X+0x%X", best, ra - best); return buf; }
+#endif
+    snprintf(buf, n, "0x%08X", ra);
+    return buf;
+}
+
+extern "C" const char* ppu_resume_name(uint32_t addr, char* buf, size_t n)
+{
+    return func_name(addr, buf, n);
+}
+
+static void probe_summary(const char* when)
+{
+    fprintf(stderr, "[resume-check] %s: samples=%llu resumable=%llu (root lr=%llu zero-bc=%llu"
+                    " noreturn=%llu soft-link=%llu partial-model=%llu) not-yet-listed=%llu"
+                    " (missing return addresses: %d distinct) bridge=%llu cut=%llu | frames=%llu"
+                    " with-continuation=%llu checked-ok | REFUSED: no-ra=%llu call-mismatch=%llu"
+                    " bad-sp=%llu frame-shape=%llu exit-unknown=%llu too-deep=%llu unreadable=%llu"
+                    " stale-lr=%llu | %u continuations registered\n",
+            when, (unsigned long long)s_n_samples.load(), (unsigned long long)s_n_ok.load(),
+            (unsigned long long)s_n_root[PPU_RESUME_ROOT_LR].load(),
+            (unsigned long long)s_n_root[PPU_RESUME_ROOT_ZERO_BC].load(),
+            (unsigned long long)s_n_root[PPU_RESUME_ROOT_NORETURN].load(),
+            (unsigned long long)s_n_soft.load(), (unsigned long long)s_n_partial.load(),
+            (unsigned long long)s_n_cov.load(), s_nmissing,
+            (unsigned long long)s_n_bridge.load(), (unsigned long long)s_n_cut.load(),
+            (unsigned long long)s_n_frames.load(), (unsigned long long)s_n_frames_cont.load(),
+            (unsigned long long)s_n_err[PPU_RESUME_ERR_NO_RA].load(),
+            (unsigned long long)s_n_err[PPU_RESUME_ERR_CALL_MISMATCH].load(),
+            (unsigned long long)s_n_err[PPU_RESUME_ERR_SP].load(),
+            (unsigned long long)s_n_err[PPU_RESUME_ERR_FRAME_SHAPE].load(),
+            (unsigned long long)s_n_err[PPU_RESUME_ERR_EXIT_UNKNOWN].load(),
+            (unsigned long long)s_n_err[PPU_RESUME_ERR_DEPTH].load(),
+            (unsigned long long)s_n_err[PPU_RESUME_ERR_READ].load(),
+            (unsigned long long)s_n_err[PPU_RESUME_ERR_LINK].load(), ppu_cont_count());
+    fflush(stderr);
+}
+
+/* One sample: a census walk (frames with no continuation are stepped over with
+ * the ABI back chain, so every frame that HAS one is still checked against
+ * the stack, and every missing return address of the chain is reported, not
+ * just the first). Verdicts:
+ *   resumable        every frame has a continuation and checks out -- a resume
+ *                    of this thread here would be accepted;
+ *   not-yet-listed   frames without a continuation (logged once each, in a
+ *                    form that pastes into the --cont-list), the rest check out;
+ *   REFUSED          a frame WITH a continuation failed a check (frame shape,
+ *                    call at ra-4, stale LR, ...): the thing that must stay 0;
+ *   bridge / cut     inside the libsre r1-isolation bridge (not walked), or the
+ *                    ABI step over an unlisted frame found no sane back chain. */
+static void probe(ppu_context* ctx, int kind, uint32_t nid)
+{
+    /* sc_ra is only meaningful for a syscall issued by code lifted with the
+     * store; an older lift (libsre_ns before its relift) leaves the previous
+     * one. Consume it so such a syscall reads 0 and is skipped. */
+    uint32_t sc_ra = 0;
+    if (kind == PPU_PARK_SC) { sc_ra = ctx->sc_ra; ctx->sc_ra = 0; }
+    if (++t_probe_n % (uint32_t)s_every) return;
+    if (kind == PPU_PARK_SC && !sc_ra) return;
+    s_n_samples++;
+    if (g_ppu_bridge_depth > 0) { s_n_bridge++; return; }
+
+    ppu_context tmp;
+    const ppu_context* c = ctx;
+    if (kind == PPU_PARK_SC) { memcpy(&tmp, ctx, sizeof tmp); tmp.sc_ra = sc_ra; c = &tmp; }
+    ppu_resume_park park = { kind, nid, 0, 0, 0, 0 };
+    static thread_local ppu_resume_chain ch;
+    const int err = walk_impl(c, &park, &ch, 1);
+    char line[1400], nm[48];
+    int with_cont = 0;
+    for (int i = 0; i < ch.n; i++) with_cont += ch.f[i].e != nullptr;
+    s_n_frames += (uint64_t)ch.n;
+    if (err) {
+        s_n_err[err & 15]++;
+        std::lock_guard<std::mutex> lk(s_log_mx);
+        for (int i = 0; i < s_nbad; i++) if (s_bad_ra[i] == ch.err_ra) return;
+        if (s_nbad < 64) {
+            s_bad_ra[s_nbad++] = ch.err_ra;
+            ppu_resume_format_chain(&ch, line, sizeof line);
+            fprintf(stderr, "[resume-check] REFUSED tid=%llu %s nid/sc=0x%X:%s\n",
+                    (unsigned long long)ctx->thread_id, kind == PPU_PARK_SC ? "sc" : "hle", nid,
+                    line);
+        }
+        return;
+    }
+    s_n_frames_cont += (uint64_t)with_cont;
+    if (ch.cut) s_n_cut++;
+    if (ch.soft) s_n_soft++;
+    if (ch.partial) s_n_partial++;
+    std::lock_guard<std::mutex> lk(s_log_mx);
+    if (ch.missing || ch.cut) {
+        s_n_cov++;
+        for (int i = 0; i < ch.n; i++) {
+            if (ch.f[i].e) continue;
+            int seen = 0;
+            for (int j = 0; j < s_nmissing && !seen; j++) seen = s_missing[j] == ch.f[i].ra;
+            if (seen || s_nmissing >= 1024) continue;
+            s_missing[s_nmissing++] = ch.f[i].ra;
+            /* Pastes into the --cont-list as is: its parser keeps the 0x
+             * address and skips the other tokens. */
+            fprintf(stderr, "[resume-check] missing 0x%08X (%s) tid=%llu depth=%d\n", ch.f[i].ra,
+                    func_name(ch.f[i].ra, nm, sizeof nm), (unsigned long long)ctx->thread_id, i);
+        }
+        return;
+    }
+    s_n_ok++;
+    s_n_root[ch.root & 3]++;
+    uint64_t sig = 1469598103934665603ull;
+    for (int i = 0; i < ch.n; i++) sig = (sig ^ ch.f[i].ra) * 1099511628211ull;
+    for (int i = 0; i < s_nok_sig; i++) if (s_ok_sig[i] == sig) return;
+    if (s_nok_sig < 32) {
+        s_ok_sig[s_nok_sig++] = sig;
+        ppu_resume_format_chain(&ch, line, sizeof line);
+        fprintf(stderr, "[resume-check] RESUMABLE tid=%llu %s nid/sc=0x%X frames=%d:%s\n",
+                (unsigned long long)ctx->thread_id, kind == PPU_PARK_SC ? "sc" : "hle", nid, ch.n,
+                line);
+    }
+}
+
+static void probe_hook(ppu_context* ctx, int kind, uint32_t nid)
+{
+    probe(ctx, kind, nid);
+    /* A summary every 10 s of wall time (whichever thread gets there). */
+    static std::atomic<int64_t> s_next{0};
+    const int64_t now = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    int64_t nx = s_next.load(std::memory_order_relaxed);
+    if (nx == 0) { s_next.compare_exchange_strong(nx, now + 10000); return; }
+    if (now >= nx && s_next.compare_exchange_strong(nx, now + 10000)) probe_summary("periodic");
+}
+
+static void probe_atexit(void) { probe_summary("exit"); }
+
+static int probe_init(void)
+{
+    const char* e = getenv("PPU_RESUME_CHECK_EVERY");
+    const int every = e ? atoi(e) : 0;
+    if (every <= 0) return 0;
+    s_every = every;
+    g_ppu_resume_probe = probe_hook;
+    atexit(probe_atexit);
+    fprintf(stderr, "[resume-check] PPU_RESUME_CHECK_EVERY=%d: validating guest chains at every "
+                    "%d-th HLE call / syscall per thread (nothing is resumed)\n", every, every);
+    return 1;
+}
+static const int s_probe_installed = probe_init();
diff --git a/runtime/ppu/ppu_resume.h b/runtime/ppu/ppu_resume.h
new file mode 100644
index 0000000..88ead01
--- /dev/null
+++ b/runtime/ppu/ppu_resume.h
@@ -0,0 +1,200 @@
+/*
+ * ps3recomp - PPU continuations: resume a parked guest thread from its guest
+ * stack (save states, M3).
+ *
+ * A guest thread parked at an HLE call or a syscall is resumed -- in a new
+ * host thread, even in a new process -- by re-issuing the parked call and then
+ * doing what `blr` does on the hardware: continue the guest function that LR
+ * names, at that return address, until the thread's root. Lifted functions
+ * return to their HOST caller, which does not exist any more after a restore,
+ * so `ppu_lifter.py --cont-list` emits the rest of every function that can sit
+ * on a parked chain a second time, as a continuation entered at a return
+ * address (generated <base>_cont.cpp). Each continuation reloads r14-r31 and
+ * LR from the guest frame on its way out, exactly as the guest does, and
+ * returns to us with ctx->lr naming the next frame to continue.
+ *
+ * This file is that runtime half:
+ *   - the continuation table, registered by every generated _cont.cpp at
+ *     static-init time and keyed by guest return address;
+ *   - chain validation: walk a parked thread's guest back chain and refuse,
+ *     with a reason, anything a resume could not rebuild exactly;
+ *   - the dispatcher: re-issue the parked call, then run continuations until
+ *     the thread's root.
+ * Nothing here runs unless a caller asks for it (or PPU_RESUME_CHECK_EVERY is
+ * set -- a diagnostic that validates live chains without resuming anything).
+ *
+ * The parked context is the thread's ppu_context at the ENTRY of the HLE call
+ * (ps3_hle_call) or of the syscall (lv2_syscall): nothing done yet, so
+ * re-issuing it is exactly the call the thread was about to make.
+ */
+#ifndef PPU_RESUME_H
+#define PPU_RESUME_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ppu_context;
+
+/* One continuation. MUST stay layout-identical to the copy ppu_lifter.py
+ * emits into <base>_cont.cpp (CONT_PREAMBLE); ppu_cont_register refuses a
+ * table whose ABI number or entry size differs. */
+#define PPU_CONT_ABI 1
+typedef struct ppu_cont_entry {
+    uint32_t ra;          /* guest return address */
+    uint32_t owner;       /* guest start of the lifted function it is cloned from */
+    void   (*fn)(struct ppu_context* ctx);
+    uint32_t callee;      /* call_kind BL/BCL: the branch target at ra-4 */
+    int32_t  r1_off;      /* exit model: r1 = (r1 at ra | back chain) + r1_off */
+    int32_t  lr_off;      /* exit model: LR = mem[(r1 at ra | back chain) + lr_off] */
+    uint8_t  call_kind;   /* PPU_CONT_CALL_* */
+    uint8_t  exit_kind;   /* PPU_CONT_EXIT_* */
+    uint8_t  exit_flags;  /* PPU_CONT_F_* */
+    uint8_t  reserved;
+} ppu_cont_entry;
+
+/* The call at ra-4 (checked against the guest code in memory). */
+enum { PPU_CONT_CALL_BL = 1, PPU_CONT_CALL_INDIRECT = 2, PPU_CONT_CALL_SC = 3,
+       PPU_CONT_CALL_BCL = 4 };
+/* How the continuation leaves the frame it runs in (the lifter's exit model:
+ * a dataflow over the guest code from ra to every return). */
+enum { PPU_CONT_EXIT_UNKNOWN = 0,   /* not modelled: a chain through it is refused */
+       PPU_CONT_EXIT_RETURNS = 1,   /* every return agrees on r1_off / lr_off */
+       PPU_CONT_EXIT_NORETURN = 2 }; /* never returns (a thread's main loop, exit) */
+enum { PPU_CONT_F_R1_BC = 1,        /* r1 at return = back chain word + r1_off (alloca, `ld r1,0(r1)`) */
+       PPU_CONT_F_LR_BC = 2,        /* LR slot is back chain + lr_off, else r1 at ra + lr_off */
+       PPU_CONT_F_LR_W32 = 4,       /* LR slot is a 32-bit word */
+       PPU_CONT_F_PARTIAL = 8 };    /* some paths could not be followed (model from the rest) */
+
+/* Called by generated code (static init). Returns 1 if the table was taken. */
+int  ppu_cont_register(const ppu_cont_entry* table, uint32_t count, uint32_t entry_size,
+                       uint32_t abi, const char* image);
+/* A generated continuation was entered with a return address it does not
+ * hold: a table/clone mismatch. Fatal. */
+void ppu_cont_bad_entry(struct ppu_context* ctx, uint32_t owner, uint32_t ra);
+
+const ppu_cont_entry* ppu_cont_lookup(uint32_t ra);
+uint32_t ppu_cont_count(void);
+/* A hash of the table (every return address and exit kind): what a
+ * save-state slot file records of the build that made it. */
+uint64_t ppu_cont_hash(void);
+
+/* ---- a parked thread ---------------------------------------------------- */
+/* PPU_PARK_WAIT (save states M4c): a thread parked INSIDE a blocking wait of
+ * an HLE call or a syscall (an S3 park), not at its entry. Its context holds
+ * the call's entry arguments still (each wait site is audited for it), so
+ * the call is either re-issued from its entry, as for HLE / SC, or finished
+ * by a RESUMER -- the rest of the call from the park point, the wait owner's
+ * code (runtime/savestate/ss_core.h's resumer table) -- and then the
+ * continuations run from sc_ra (wait_sc) or lr, as for HLE / SC. */
+enum { PPU_PARK_NONE = 0, PPU_PARK_HLE = 1, PPU_PARK_SC = 2, PPU_PARK_WAIT = 3 };
+
+struct ppu_resume_park;
+typedef void (*ppu_resume_wait_fn)(struct ppu_context* ctx, const struct ppu_resume_park* park);
+
+typedef struct ppu_resume_park {
+    int      kind;        /* PPU_PARK_HLE (ctx = ps3_hle_call entry) / PPU_PARK_SC (lv2_syscall entry) /
+                           * PPU_PARK_WAIT (ctx = inside the call's wait) */
+    uint32_t nid;         /* PPU_PARK_HLE, a WAIT in an HLE call: the NID to re-issue */
+    uint32_t root_lr;     /* LR the thread's entry function was called with (0 for lv2 threads and main) */
+    uint32_t stack_lo;    /* optional bounds of the thread's guest stack, [lo, hi); 0/0 = unchecked */
+    uint32_t stack_hi;
+    uint32_t root_sp;     /* optional: r1 the entry function was called with; the chain must
+                           * reach root_lr with exactly this r1 (0 = unchecked) */
+    /* PPU_PARK_WAIT (appended, M4c) */
+    int      wait_sc;     /* 1: a syscall's wait (first return address sc_ra; re-issue lv2_syscall),
+                           * 0: an HLE call's (lr; re-issue ps3_hle_call(nid)) */
+    ppu_resume_wait_fn resume;   /* the rest of the call from the park; NULL: re-issue */
+    void*    user;        /* for resume */
+} ppu_resume_park;
+/* The first return address of a parked call: sc_ra for a syscall (or a
+ * syscall's wait), lr for an HLE call. */
+uint32_t ppu_resume_park_ra(const struct ppu_context* ctx, const ppu_resume_park* park);
+
+/* ---- chain validation --------------------------------------------------- */
+#define PPU_RESUME_MAX_FRAMES 64
+
+enum { PPU_RESUME_OK = 0,
+       PPU_RESUME_ERR_NO_RA,          /* the parked call has no return address (sc_ra 0: unrelifted code) */
+       PPU_RESUME_ERR_NO_CONT,        /* a return address with no continuation: list it, relift */
+       PPU_RESUME_ERR_CALL_MISMATCH,  /* the guest code at ra-4 is not the call the table says */
+       PPU_RESUME_ERR_SP,             /* r1 / back chain out of range, misaligned or not increasing */
+       PPU_RESUME_ERR_FRAME_SHAPE,    /* back chain != r1 + the continuation's static frame size */
+       PPU_RESUME_ERR_EXIT_UNKNOWN,   /* the continuation's exit is not modelled */
+       PPU_RESUME_ERR_DEPTH,          /* more than PPU_RESUME_MAX_FRAMES frames */
+       PPU_RESUME_ERR_READ,           /* a stack word outside guest memory */
+       PPU_RESUME_ERR_LINK,           /* a frame returns into a call to a leaf, which
+                                       * cannot have made it: a stale saved LR */
+       PPU_RESUME_ERR_ROOT };         /* the chain reaches root_lr at an r1 other than
+                                       * park->root_sp (a 0 saved LR that is not the root's) */
+
+/* How the walk reached the end of the chain. */
+enum { PPU_RESUME_ROOT_LR = 1,        /* the next return address is park->root_lr */
+       PPU_RESUME_ROOT_ZERO_BC = 2,   /* a frame whose back chain is 0 (the process's first frame) */
+       PPU_RESUME_ROOT_NORETURN = 3 }; /* a continuation that never returns */
+
+typedef struct ppu_resume_frame {
+    uint32_t ra;                 /* return address continued at */
+    uint32_t sp;                 /* r1 at ra */
+    const ppu_cont_entry* e;     /* its continuation */
+    uint8_t  link;               /* 0 not checked, 1 consistent, 2 SOFT mismatch (see .c) */
+} ppu_resume_frame;
+
+typedef struct ppu_resume_chain {
+    int      n;                  /* frames in f[] */
+    int      err;                /* PPU_RESUME_OK or PPU_RESUME_ERR_* */
+    int      root;               /* PPU_RESUME_ROOT_* when err == OK */
+    int      soft;               /* soft link mismatches (reported, not refused) */
+    int      partial;            /* frames whose exit model is PARTIAL */
+    int      missing;            /* census walks (the probe) only: frames with no continuation */
+    int      cut;                /* census: an unlisted frame's back chain did not lead on */
+    uint32_t err_ra, err_sp;     /* where it failed */
+    ppu_resume_frame f[PPU_RESUME_MAX_FRAMES];
+    char     why[200];
+} ppu_resume_chain;
+
+/* The first return address of a thread parked with this context. */
+uint32_t ppu_resume_first_ra(const struct ppu_context* ctx, int kind);
+
+/* Walk and validate the chain a resume of `ctx` would run. 0 = resumable. */
+int ppu_resume_walk(const struct ppu_context* ctx, const ppu_resume_park* park,
+                    ppu_resume_chain* out);
+/* The same walk, but a frame with no continuation is stepped over with the
+ * ABI back chain (counted in out->missing, the walk goes on) so that every
+ * missing return address of the chain is found, not just the first; a chain
+ * is resumable only when the result is 0 AND out->missing == 0. An error
+ * after a missing frame may come from that ABI step, not from the stack. */
+int ppu_resume_walk_census(const struct ppu_context* ctx, const ppu_resume_park* park,
+                           ppu_resume_chain* out);
+/* "func_XXXXXXXX+0xOFF" for a guest address (the lifted function table), or
+ * "0xXXXXXXXX". For logs: a linear scan of the table. */
+const char* ppu_resume_name(uint32_t addr, char* buf, size_t n);
+
+/* One line per frame into buf (for logs). */
+void ppu_resume_format_chain(const ppu_resume_chain* c, char* buf, size_t n);
+const char* ppu_resume_strerror(int err);
+
+/* ---- the dispatcher ----------------------------------------------------- */
+/* The hardware's `blr`, done in software: run the continuation for `ra`,
+ * drain its trampolines, continue at ctx->lr, ... until ra == root_lr.
+ * Returns the number of continuations run; never returns if one of them
+ * never returns (a thread's main loop). A return address with no
+ * continuation is fatal (validate first). */
+uint32_t ppu_resume_dispatch(struct ppu_context* ctx, uint32_t ra, uint32_t root_lr);
+
+/* Resume a parked thread on the calling host thread: *ctx = the parked
+ * context, re-issue the parked call (ps3_hle_call / lv2_syscall) -- or, for
+ * PPU_PARK_WAIT with a resumer, finish it with park->resume --, then
+ * ppu_resume_dispatch from its return address to park->root_lr. The caller
+ * provides the thread root (the host thread proc's setjmp / exit handling)
+ * and must have validated the chain. */
+uint32_t ppu_resume_run(struct ppu_context* ctx, const ppu_resume_park* park);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PPU_RESUME_H */
diff --git a/runtime/ppu/ppu_selfresume.cpp b/runtime/ppu/ppu_selfresume.cpp
new file mode 100644
index 0000000..7f56af1
--- /dev/null
+++ b/runtime/ppu/ppu_selfresume.cpp
@@ -0,0 +1,326 @@
+/*
+ * ps3recomp - save states, P0: per-thread self-resume, the PPU half.
+ *
+ * runtime/savestate/ss_core.c runs the protocol (SS_SELFRESUME; see the P0
+ * section of ss_core.h): requests, eligibility at the S1/S2 entries, the
+ * longjmp to the thread root, the restore, the counters. This file is what it
+ * asks of the PPU side, through ss_sr_ops:
+ *
+ *   check  may this thread, parked at the entry of an HLE call / syscall, be
+ *          resumed from its guest stack? Walks its chain with
+ *          ppu_resume_walk_census (runtime/ppu/ppu_resume.cpp): every frame
+ *          must have a continuation and agree with the stack (call at ra-4,
+ *          frame shape, saved LR, r1 range), and the chain must reach the
+ *          thread root's return address with the root's r1. Logs, once each,
+ *          the return addresses that have no continuation (for
+ *          config/ss_cont_list.txt) and the chains that HAVE continuations
+ *          but fail a check (REFUSED -- a finding, never expected).
+ *   run    at the root: re-issue the parked call and run continuations to the
+ *          root (ppu_resume_run): the hardware's blr, done in software.
+ *   run_wait  (M4c) the same for a thread a save-state load resumes from a
+ *          park INSIDE a blocking wait: the wait kind's resumer or a re-issue
+ *          (PPU_PARK_WAIT), then the continuations.
+ *   walk   the strict walk a census / a save runs (no side effects).
+ *
+ * Registered at static init; the scaffold does not otherwise depend on it.
+ * check / run run only under SS_SELFRESUME; walk at a census or a save;
+ * run / run_wait at a load (ss_root_load_run).
+ *
+ * runtime/savestate/tests/test_ss_selfresume.cpp #includes this file after
+ * defining PPU_RESUME_HAVE_CONTEXT and its own ppu_context.
+ */
+#ifndef PPU_RESUME_HAVE_CONTEXT
+#  include "ppu_tls.h"      /* PPU_THREAD_LOCAL */
+#  include "ppu_recomp.h"   /* ppu_context (the generated header) */
+#endif
+#include "ppu_resume.h"
+#include "../savestate/ss_core.h"
+
+#include <mutex>
+#include <stdio.h>
+#include <string.h>
+
+extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*);
+extern "C" PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+
+namespace {
+
+/* Return addresses already reported as missing (open addressing, 0 = empty).
+ * Inserts under the mutex; lookups lock-free (aligned 32-bit slots). */
+enum { SR_SEEN_N = 8192, SR_REFUSED_N = 64 };
+uint32_t   s_seen[SR_SEEN_N];
+int        s_nseen;
+std::mutex s_mx;
+uint64_t   s_refused_key[SR_REFUSED_N];
+int        s_nrefused;
+PPU_THREAD_LOCAL unsigned t_fast;
+
+unsigned seen_slot(uint32_t ra) { return (ra * 2654435761u) % SR_SEEN_N; }
+
+bool seen_has(uint32_t ra)
+{
+    if (!ra) return false;
+    for (unsigned i = seen_slot(ra), n = 0; n < SR_SEEN_N; n++, i = (i + 1) % SR_SEEN_N) {
+        const uint32_t v = ((volatile uint32_t*)s_seen)[i];
+        if (v == ra) return true;
+        if (!v) return false;
+    }
+    return false;
+}
+
+/* Insert; true if it was new (the caller logs it). */
+bool seen_add(uint32_t ra)
+{
+    if (!ra) return false;
+    std::lock_guard<std::mutex> lk(s_mx);
+    if (s_nseen >= SR_SEEN_N * 3 / 4) return false;
+    for (unsigned i = seen_slot(ra), n = 0; n < SR_SEEN_N; n++, i = (i + 1) % SR_SEEN_N) {
+        if (s_seen[i] == ra) return false;
+        if (!s_seen[i]) {
+            ((volatile uint32_t*)s_seen)[i] = ra;
+            s_nseen++;
+            return true;
+        }
+    }
+    return false;
+}
+
+void report_missing(const ppu_context* ctx, const ppu_resume_chain* ch)
+{
+    char nm[64];
+    for (int i = 0; i < ch->n; i++) {
+        if (ch->f[i].e || !seen_add(ch->f[i].ra)) continue;
+        /* Pastes into the --cont-list as is: its parser keeps the 0x address
+         * and skips the other tokens (tools/ss_selfresume.py collects them). */
+        fprintf(stderr, "[ss-resume] missing 0x%08X (%s) tid=%llu depth=%d\n", ch->f[i].ra,
+                ppu_resume_name(ch->f[i].ra, nm, sizeof nm), (unsigned long long)ctx->thread_id, i);
+    }
+}
+
+void report_unmodelled(const ppu_context* ctx, const ppu_resume_chain* ch)
+{
+    if (!seen_add(ch->err_ra)) return;
+    char nm[64];
+    fprintf(stderr, "[ss-resume] unmodelled 0x%08X (%s) tid=%llu: %s (%s) -- not resumable from"
+                    " here; nothing to list\n", ch->err_ra, ppu_resume_name(ch->err_ra, nm, sizeof nm),
+            (unsigned long long)ctx->thread_id, ppu_resume_strerror(ch->err), ch->why);
+}
+
+void report_refused(const ppu_context* ctx, int at, uint32_t num, const ppu_resume_chain* ch)
+{
+    const uint64_t key = ((uint64_t)(uint32_t)ch->err << 32) | ch->err_ra;
+    {
+        std::lock_guard<std::mutex> lk(s_mx);
+        for (int i = 0; i < s_nrefused; i++) if (s_refused_key[i] == key) return;
+        if (s_nrefused >= SR_REFUSED_N) return;
+        s_refused_key[s_nrefused++] = key;
+    }
+    static thread_local char line[1400];
+    ppu_resume_format_chain(ch, line, sizeof line);
+    fprintf(stderr, "[ss-resume] REFUSED tid=%llu %s 0x%X:%s\n", (unsigned long long)ctx->thread_id,
+            at == SS_AT_SC ? "sc" : "hle", num, line);
+}
+
+/* A PARTIAL exit model (the lifter could not follow every path from that
+ * return address, and modelled the frame from the paths it could) is fine for
+ * the census probe, but a resume would TRUST it: if the run takes one of the
+ * unfollowed paths and leaves the frame another way, the dispatcher reads a
+ * return address the walk never checked -- an abort mid-resume, or a wrong
+ * continuation. Not resumable from here; reported once like an unmodelled one. */
+void report_partial(const ppu_context* ctx, const ppu_resume_chain* ch)
+{
+    for (int i = 0; i < ch->n; i++) {
+        const ppu_cont_entry* e = ch->f[i].e;
+        if (!e || !(e->exit_flags & PPU_CONT_F_PARTIAL) || !seen_add(ch->f[i].ra)) continue;
+        char nm[64];
+        fprintf(stderr, "[ss-resume] unmodelled 0x%08X (%s) tid=%llu: partial exit model (some paths"
+                        " from this return address were not followed by the lifter) -- not resumable"
+                        " through it\n", ch->f[i].ra, ppu_resume_name(ch->f[i].ra, nm, sizeof nm),
+                (unsigned long long)ctx->thread_id);
+    }
+}
+
+/* The last not-covered verdict on this thread, by the call's own return
+ * address: while a thread stays requested every S1/S2 entry it makes asks
+ * again, and a chain whose FIRST return address is covered but a deeper one
+ * is not would be walked in full at each of them (thousands a second on the
+ * main thread). The same first return address is taken to lead to the same
+ * verdict for the next 63 asks; then it is walked again. */
+PPU_THREAD_LOCAL uint32_t t_nc_ra;
+PPU_THREAD_LOCAL unsigned t_nc_skip;
+
+int sr_check(const ppu_context* ctx, int at, uint32_t num, const ss_sr_root* root, int* frames)
+{
+    const int kind = at == SS_AT_SC ? PPU_PARK_SC : PPU_PARK_HLE;
+    const uint32_t ra = ppu_resume_first_ra(ctx, kind);
+    if (kind == PPU_PARK_SC && !ra) return SS_SR_NO_RA;
+    /* Fast path: the call's own return address is known to have no
+     * continuation. Walk anyway every 64th time, so the missing return
+     * addresses further up the chains through it get reported too. */
+    if (ra != root->root_lr && seen_has(ra) && (++t_fast & 63) != 0) return SS_SR_NOT_COVERED;
+    if (ra && ra == t_nc_ra && t_nc_skip) { t_nc_skip--; return SS_SR_NOT_COVERED; }
+    ppu_resume_park park;
+    memset(&park, 0, sizeof park);
+    park.kind = kind;
+    park.nid = num;
+    park.root_lr = root->root_lr;
+    park.stack_lo = root->stack_lo;
+    park.stack_hi = root->stack_hi;
+    park.root_sp = root->root_sp;
+    static thread_local ppu_resume_chain ch;
+    const int err = ppu_resume_walk_census(ctx, &park, &ch);
+    int verdict;
+    if (ch.missing) {                 /* (an error after a missing frame may be the ABI step's) */
+        report_missing(ctx, &ch);
+        verdict = SS_SR_NOT_COVERED;
+    } else if (err == PPU_RESUME_ERR_NO_RA) {
+        return SS_SR_NO_RA;
+    } else if (err == PPU_RESUME_ERR_EXIT_UNKNOWN || err == PPU_RESUME_ERR_DEPTH) {
+        /* Not a disagreement with the stack: the lifter could not model this
+         * continuation's exit (or the chain is deeper than a walk goes). */
+        report_unmodelled(ctx, &ch);
+        verdict = SS_SR_NOT_COVERED;
+    } else if (err) {
+        report_refused(ctx, at, num, &ch);
+        return SS_SR_REFUSED_BASE + err;
+    } else if (ch.partial) {
+        report_partial(ctx, &ch);
+        verdict = SS_SR_NOT_COVERED;
+    } else {
+        t_nc_ra = 0;
+        *frames = ch.n;
+        return SS_SR_OK;
+    }
+    t_nc_ra = ra;
+    t_nc_skip = 63;
+    return verdict;
+}
+
+uint32_t sr_run(ppu_context* ctx, int at, uint32_t num, const ss_sr_root* root)
+{
+    g_active_ctx = ctx;               /* what ps3_indirect_call and the diagnostics read */
+    g_trampoline_fn = 0;
+    ppu_resume_park park;
+    memset(&park, 0, sizeof park);
+    park.kind = at == SS_AT_SC ? PPU_PARK_SC : PPU_PARK_HLE;
+    park.nid = num;
+    park.root_lr = root->root_lr;
+    park.root_sp = root->root_sp;
+    return ppu_resume_run(ctx, &park);
+}
+
+/* A load's resume of a thread parked INSIDE a wait (an S3 park, M4c): the
+ * wait kind's resumer -- the rest of the call, registered by the wait's
+ * owner in ss_core's table -- or, for a kind that re-issues, the call again
+ * from its entry; then the continuations, from sc_ra for a syscall's wait
+ * and lr for an HLE call's. */
+struct WaitResume { ss_wait_resume_fn fn; uint32_t obj; ss_wait_rec rec; };
+void wait_resume_thunk(ppu_context* ctx, const ppu_resume_park* park)
+{
+    const WaitResume* w = (const WaitResume*)park->user;
+    w->fn(ctx, w->obj, &w->rec);
+}
+
+uint32_t sr_run_wait(ppu_context* ctx, int kind, uint32_t obj, const ss_wait_rec* rec, const ss_sr_root* root)
+{
+    g_active_ctx = ctx;
+    g_trampoline_fn = 0;
+    ppu_resume_park park;
+    memset(&park, 0, sizeof park);
+    park.kind = PPU_PARK_WAIT;
+    park.wait_sc = ss_wait_is_syscall(kind);
+    park.root_lr = root->root_lr;
+    park.root_sp = root->root_sp;
+    WaitResume w;
+    memset(&w, 0, sizeof w);
+    if (rec) w.rec = *rec;
+    w.obj = obj;
+    w.fn = ss_wait_resumer(kind);
+    park.nid = w.rec.nid_or_sc;
+    /* a syscall wait re-issues with r11 as it parked (the payload's copy) */
+    if (park.wait_sc && w.rec.nid_or_sc) ctx->gpr[11] = w.rec.nid_or_sc;
+    if (w.fn) {
+        park.resume = wait_resume_thunk;
+        park.user = &w;
+    } else if (!ss_wait_resumable(kind)) {
+        fprintf(stderr, "[ss-resume] FATAL: tid=%llu parked in a %s wait, and nothing in this build resumes"
+                        " that kind\n", (unsigned long long)ctx->thread_id, ss_wait_name(kind));
+        fflush(stderr);
+        abort();
+    }
+    return ppu_resume_run(ctx, &park);
+}
+
+uint32_t sr_count(void) { return ppu_cont_count(); }
+const char* sr_strerror(int err) { return ppu_resume_strerror(err); }
+
+/* The census's strict walk (ss_sr_ops.walk): sr_check's verdict for a thread
+ * parked anywhere -- at an S1/S2 entry or inside a blocking wait, whose first
+ * return address is sc_ra (a syscall) or lr (an HLE call) all the same -- with
+ * no side effects: nothing logged, no memo, no seen-set. Every return address
+ * of the chain with no continuation is collected (the census walk steps over
+ * such a frame by the ABI back chain and checks the frames above it). Runs on
+ * the coordinator with the thread parked, so its stack holds still. */
+void sr_walk(const ppu_context* ctx, int at, const ss_sr_root* root, ss_sr_walk_out* o)
+{
+    memset(o, 0, sizeof *o);
+    ppu_resume_park park;
+    memset(&park, 0, sizeof park);
+    park.kind = at == SS_AT_SC ? PPU_PARK_SC : PPU_PARK_HLE;
+    if (root) {
+        park.root_lr = root->root_lr;
+        park.root_sp = root->root_sp;
+        park.stack_lo = root->stack_lo;
+        park.stack_hi = root->stack_hi;
+    }
+    static thread_local ppu_resume_chain ch;
+    const int err = ppu_resume_walk_census(ctx, &park, &ch);
+    o->frames = ch.n;
+    for (int i = 0; i < ch.n; i++) {
+        if (ch.f[i].e) continue;
+        if (!o->err_ra) o->err_ra = ch.f[i].ra;
+        if (o->nmiss < SS_SRW_MAXMISS) o->miss[o->nmiss] = ch.f[i].ra;
+        o->nmiss++;
+    }
+    if (o->nmiss > SS_SRW_MAXMISS) o->nmiss = SS_SRW_MAXMISS;
+    if (ch.missing) {
+        o->verdict = SS_SR_NOT_COVERED;
+        o->why = SS_SRW_MISSING;
+    } else if (err == PPU_RESUME_ERR_NO_RA) {
+        o->verdict = SS_SR_NO_RA;
+    } else if (err == PPU_RESUME_ERR_EXIT_UNKNOWN || err == PPU_RESUME_ERR_DEPTH) {
+        o->verdict = SS_SR_NOT_COVERED;
+        o->why = SS_SRW_UNMODELLED;
+        o->err_ra = ch.err_ra;
+    } else if (err) {
+        o->verdict = SS_SR_REFUSED_BASE + err;
+        o->err_ra = ch.err_ra;
+    } else if (ch.partial) {
+        o->verdict = SS_SR_NOT_COVERED;
+        o->why = SS_SRW_PARTIAL;
+        for (int i = 0; i < ch.n; i++)
+            if (ch.f[i].e && (ch.f[i].e->exit_flags & PPU_CONT_F_PARTIAL)) { o->err_ra = ch.f[i].ra; break; }
+    } else {
+        o->verdict = SS_SR_OK;
+        o->root = ch.root;
+    }
+}
+
+/* ss_sr_ops.cont_lookup (M5): a load's check that every return address of
+ * the image's chains has a continuation here (sys_ppu_thread.c). */
+int sr_cont_lookup(uint32_t ra, int* noreturn)
+{
+    const ppu_cont_entry* e = ppu_cont_lookup(ra);
+    if (noreturn) *noreturn = e && e->exit_kind == PPU_CONT_EXIT_NORETURN;
+    return e != nullptr;
+}
+
+int sr_install(void)
+{
+    static const ss_sr_ops ops = { sr_check, sr_run, sr_count, sr_strerror, sr_walk, sr_run_wait, sr_cont_lookup };
+    ss_set_sr_ops(&ops);
+    return 1;
+}
+const int s_sr_installed = sr_install();
+
+}  /* namespace */
diff --git a/runtime/ppu/ppu_slotcheck.h b/runtime/ppu/ppu_slotcheck.h
new file mode 100644
index 0000000..2076469
--- /dev/null
+++ b/runtime/ppu/ppu_slotcheck.h
@@ -0,0 +1,386 @@
+/*
+ * ps3recomp - runtime half of the PPU lifter's --slotcheck diagnostic.
+ *
+ * A save-state resume (re-entering a parked thread's frames from guest memory)
+ * reloads the saved LR, the callee-saved registers and the back chain from the
+ * guest stack. The lifter stopped trusting those slots once -- the _cs_ host
+ * copies in tools/ppu_lifter.py exist because a frame-drift bug overwrote them
+ * in an earlier title -- so before any resume code is built on them, a
+ * --slotcheck lift measures whether they hold up in the title at hand: after
+ * every call a checked function makes returns, ppu_slotcheck() re-reads the
+ * slots and compares them with what the host still holds. This file counts and
+ * reports the mismatches; it costs nothing in a normal lift (no checks are
+ * emitted, so nothing here is ever called).
+ *
+ * Descriptor (static, one per checked lifted function; tools/ppu_lifter.py
+ * _slotcheck_decls):
+ *     d[0] = guest entry address, d[1] = n slots,
+ *     d[2 + 2i] = kind << 8 | reg, d[3 + 2i] = (int32_t) offset from the entry r1
+ * Values (on the host stack of that function, filled at its entry):
+ *     v[0] = entry r1, v[1 + i] = the value slot i must hold
+ * Kinds:
+ *     LR   the slot the prologue saved LR to (entry_sp+0x10 for a normal frame)
+ *                                         vs ctx->lr at entry
+ *     CS   callee-save slot of rN             vs the _cs_N copy
+ *     BC   back chain at the frame (64-bit)   vs the entry r1
+ *     BC32 same, for a 32-bit stwu frame
+ *     FBC  a frameless fragment's back-chain word at entry_sp   vs its value at fragment entry
+ *     FLR  that fragment's owner LR slot (FBC value + 0x10)     vs its value at fragment entry
+ *     SP   (not a slot) r1 after the call     vs entry_sp + the call's sp_delta
+ *
+ * Environment, read at the first check:
+ *     SLOTCHECK=0              disarm (an instrumented build then only pays the calls)
+ *     SLOTCHECK_LOG=<path>     where reports go (default: stderr), truncated at start
+ *     SLOTCHECK_DETAILS=<n>    detailed mismatch reports in total (default 64)
+ *     SLOTCHECK_PER_KEY=<n>    detailed reports per function+slot (default 1)
+ *     SLOTCHECK_EVERY=<sec>    summary interval (default 60; 0 = only at exit)
+ *     SLOTCHECK_TOP=<n>        function+slot rows per summary (default 40)
+ *     SLOTCHECK_STACK=<n>      guest frames walked in a detailed report (default 12)
+ *     SLOTCHECK_FUNCS=<path>   rewritten at each summary: every checked function
+ *                              that ran, with its check count
+ *
+ * Every line starts with "[slotcheck]". The verdict is the summary's
+ * "mismatches=N"; a nonzero N names the function and slot in the rows below.
+ *
+ * The includer (runtime/ppu/ppu_loader.cpp; runtime/ppu/tests/test_slotcheck.cpp)
+ * defines, before including this file:
+ *     static int ppu_sc_guest_read(uint32_t ea, unsigned width, uint64_t* out);
+ * which reads 4 or 8 big-endian guest bytes WITHOUT side effects (no hot-read
+ * counters, no watchpoints) and returns 0 for an address it will not touch.
+ * It also needs ppu_context (gpr[1], thread_id), PPU_THREAD_LOCAL,
+ * GetTickCount64 and SRWLOCK (win32_compat.h off Windows).
+ */
+#ifndef PS3RECOMP_PPU_SLOTCHECK_H
+#define PS3RECOMP_PPU_SLOTCHECK_H
+
+#include <atomic>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum {
+    PPU_SC_LR = 1, PPU_SC_CS = 2, PPU_SC_BC = 3, PPU_SC_BC32 = 4,
+    PPU_SC_FBC = 5, PPU_SC_FLR = 6, PPU_SC_SP = 7
+};
+#ifndef PPU_SC_NOSP
+#define PPU_SC_NOSP 0x7FFFFFFF
+#endif
+/* An FBC/FLR value ppu_slotcheck_enter could not read: that slot is skipped. */
+#define PPU_SC_SKIP 0xFFFFFFFFFFFFFFFFull
+#define PPU_SC_KEYS  4096          /* distinct function+slot keys tracked */
+#define PPU_SC_FUNCS 65536         /* distinct checked functions tracked (power of 2) */
+
+static const char* ppu_sc_kind_name(unsigned k)
+{
+    switch (k) {
+    case PPU_SC_LR: return "LR";   case PPU_SC_CS: return "CS";
+    case PPU_SC_BC: return "BC";   case PPU_SC_BC32: return "BC32";
+    case PPU_SC_FBC: return "FBC"; case PPU_SC_FLR: return "FLR";
+    case PPU_SC_SP: return "SP";   default: return "?";
+    }
+}
+
+struct ppu_sc_key {
+    uint64_t key, count, want, got;
+    uint32_t func, ra_first, ra_last, tid, details;
+    int32_t  off;
+    uint8_t  kind, reg, readable;
+};
+
+static ppu_sc_key        s_sc_keys[PPU_SC_KEYS];
+static uint32_t          s_sc_nkeys, s_sc_key_overflow, s_sc_details;
+static SRWLOCK           s_sc_lock = SRWLOCK_INIT;
+static FILE*             s_sc_out;
+static std::atomic<int>  s_sc_state{0};          /* 0 new, 1 starting, 2 armed, 3 off */
+static std::atomic<uint64_t> s_sc_checks{0}, s_sc_mismatches{0}, s_sc_next_ms{0};
+static std::atomic<uint32_t> s_sc_func[PPU_SC_FUNCS];
+static uint32_t          s_sc_func_hits[PPU_SC_FUNCS];   /* racy counts: diagnostics */
+static std::atomic<uint32_t> s_sc_nfuncs{0};
+static uint64_t          s_sc_t0_ms;
+static uint32_t          s_sc_details_max = 64, s_sc_per_key = 1, s_sc_every_s = 60,
+                         s_sc_top = 40, s_sc_stack = 12;
+static char              s_sc_funcs_path[512];
+static PPU_THREAD_LOCAL uint32_t t_sc_batch;     /* checks not yet added to s_sc_checks */
+static PPU_THREAD_LOCAL uint32_t t_sc_last_func, t_sc_last_slot;
+
+static uint32_t ppu_sc_env_u32(const char* name, uint32_t dflt)
+{
+    const char* e = getenv(name);
+    return (e && *e) ? (uint32_t)strtoul(e, 0, 0) : dflt;
+}
+
+static void ppu_sc_summary(const char* why);
+static void ppu_sc_atexit(void) { ppu_sc_summary("exit"); }
+
+/* Arm on first use. Returns 1 when checks are on. */
+static int ppu_sc_ready(void)
+{
+    int st = s_sc_state.load(std::memory_order_acquire);
+    if (__builtin_expect(st >= 2, 1)) return st == 2;
+    int expect = 0;
+    if (s_sc_state.compare_exchange_strong(expect, 1)) {
+        const char* on = getenv("SLOTCHECK");
+        const int armed = !(on && on[0] == '0' && on[1] == 0);
+        s_sc_details_max = ppu_sc_env_u32("SLOTCHECK_DETAILS", 64);
+        s_sc_per_key     = ppu_sc_env_u32("SLOTCHECK_PER_KEY", 1);
+        s_sc_every_s     = ppu_sc_env_u32("SLOTCHECK_EVERY", 60);
+        s_sc_top         = ppu_sc_env_u32("SLOTCHECK_TOP", 40);
+        s_sc_stack       = ppu_sc_env_u32("SLOTCHECK_STACK", 12);
+        const char* fp = getenv("SLOTCHECK_FUNCS");
+        snprintf(s_sc_funcs_path, sizeof s_sc_funcs_path, "%s", fp ? fp : "");
+        const char* lp = getenv("SLOTCHECK_LOG");
+        s_sc_out = (lp && *lp) ? fopen(lp, "w") : NULL;
+        if (!s_sc_out) s_sc_out = stderr;
+        s_sc_t0_ms = GetTickCount64();
+        s_sc_next_ms.store(s_sc_every_s ? s_sc_t0_ms + 1000ull * s_sc_every_s : ~0ull);
+        fprintf(s_sc_out, "[slotcheck] %s: details=%u per-key=%u summary every %us log=%s\n",
+                armed ? "armed" : "disarmed (SLOTCHECK=0)", s_sc_details_max, s_sc_per_key,
+                s_sc_every_s, (lp && *lp && s_sc_out != stderr) ? lp : "stderr");
+        fflush(s_sc_out);
+        static int s_atexit_set;
+        if (armed && !s_atexit_set) { s_atexit_set = 1; atexit(ppu_sc_atexit); }
+        s_sc_state.store(armed ? 2 : 3, std::memory_order_release);
+        return armed;
+    }
+    while ((st = s_sc_state.load(std::memory_order_acquire)) == 1) { /* another thread arms */ }
+    return st == 2;
+}
+
+static int ppu_sc_rd(uint64_t a, unsigned w, uint64_t* out)
+{
+    return ppu_sc_guest_read((uint32_t)a, w, out);
+}
+
+/* Count a check against its function (the coverage list). A per-thread
+ * one-entry cache skips the probe for the common back-to-back case. */
+static void ppu_sc_cover(uint32_t func)
+{
+    if (t_sc_last_func == func) { s_sc_func_hits[t_sc_last_slot]++; return; }
+    uint32_t h = ((func >> 2) * 2654435761u) & (PPU_SC_FUNCS - 1);
+    for (uint32_t n = 0; n < PPU_SC_FUNCS; n++, h = (h + 1) & (PPU_SC_FUNCS - 1)) {
+        uint32_t cur = s_sc_func[h].load(std::memory_order_relaxed);
+        if (cur == 0) {
+            if (s_sc_func[h].compare_exchange_strong(cur, func)) { s_sc_nfuncs++; cur = func; }
+        }
+        if (cur == func) {
+            t_sc_last_func = func; t_sc_last_slot = h;
+            s_sc_func_hits[h]++;
+            return;
+        }
+    }
+}
+
+/* Walk the guest back chain from sp: "sp:return-address" per frame. */
+static void ppu_sc_stack(uint64_t sp)
+{
+    char ln[1024];
+    int p = snprintf(ln, sizeof ln, "[slotcheck]   guest stack:");
+    for (uint32_t i = 0; i < s_sc_stack && p < (int)sizeof ln - 40; i++) {
+        uint64_t bc, ra;
+        if (!ppu_sc_rd(sp, 8, &bc)) { p += snprintf(ln + p, sizeof ln - p, " 0x%08X:?", (uint32_t)sp); break; }
+        if (!bc || bc <= sp || bc - sp > 0x100000) {
+            p += snprintf(ln + p, sizeof ln - p, " 0x%08X:end(bc=0x%llX)", (uint32_t)sp, (unsigned long long)bc);
+            break;
+        }
+        if (!ppu_sc_rd(bc + 16, 8, &ra)) ra = 0;
+        p += snprintf(ln + p, sizeof ln - p, " 0x%08X:0x%08X", (uint32_t)sp, (uint32_t)ra);
+        sp = bc;
+    }
+    fprintf(s_sc_out, "%s\n", ln);
+}
+
+static void ppu_sc_mismatch(ppu_context* ctx, const uint32_t* d, unsigned kind, unsigned reg,
+                            int32_t off, uint64_t addr, uint64_t want, uint64_t got,
+                            int readable, uint32_t ra, uint64_t sp0)
+{
+    s_sc_mismatches.fetch_add(1, std::memory_order_relaxed);
+    const uint32_t func = d[0];
+    const uint32_t tid = ctx ? (uint32_t)ctx->thread_id : 0u;
+    const uint64_t key = ((uint64_t)func << 32) | ((uint64_t)kind << 24) | ((uint64_t)reg << 16)
+                       | (uint16_t)off;
+    AcquireSRWLockExclusive(&s_sc_lock);
+    ppu_sc_key* e = NULL;
+    uint32_t h = (uint32_t)((key * 0x9E3779B97F4A7C15ull) >> 52) & (PPU_SC_KEYS - 1);
+    for (uint32_t n = 0; n < PPU_SC_KEYS; n++, h = (h + 1) & (PPU_SC_KEYS - 1)) {
+        if (s_sc_keys[h].count && s_sc_keys[h].key == key) { e = &s_sc_keys[h]; break; }
+        if (!s_sc_keys[h].count) {
+            if (s_sc_nkeys >= PPU_SC_KEYS * 3 / 4) break;     /* keep probes short */
+            e = &s_sc_keys[h];
+            memset(e, 0, sizeof *e);
+            e->key = key; e->func = func; e->kind = (uint8_t)kind; e->reg = (uint8_t)reg;
+            e->off = off; e->ra_first = ra; e->tid = tid; e->want = want; e->got = got;
+            e->readable = (uint8_t)readable;
+            s_sc_nkeys++;
+            break;
+        }
+    }
+    if (!e) {
+        s_sc_key_overflow++;
+    } else {
