+# Opcode-31 groups for _cont_decode (10-bit extended opcode; Rc is bit 0 and
+# not part of it, OE of the XO-form arithmetic is, and none of those collide).
+_X_ST = {151, 183, 149, 181, 215, 247, 407, 439, 662, 918, 660, 663, 695, 727, 759,
+         983, 231, 487, 135, 167, 199, 647, 679, 903, 935, 150, 214, 725, 661, 1014}
+_X_ST_U = {183, 181, 247, 439, 695, 759}
+_X_LD = {23, 55, 21, 53, 87, 119, 279, 311, 343, 375, 341, 373, 534, 790, 532, 20, 84,
+         597, 533}
+_X_LD_U = {55, 53, 119, 311, 375, 373}
+_X_FLD = {535, 567, 599, 631, 103, 359, 7, 39, 71, 6, 38, 519, 551, 775, 807}
+_X_FLD_U = {567, 631}
+_X_RA_DEST = {28, 60, 124, 284, 316, 412, 476, 24, 536, 792, 824, 27, 539, 794, 26, 58,
+              954, 922, 986, 122}
+_X_NOP = {0, 32, 144, 54, 86, 278, 246, 982, 470, 598, 854, 566, 306, 274, 498, 402,
+          434, 370}
