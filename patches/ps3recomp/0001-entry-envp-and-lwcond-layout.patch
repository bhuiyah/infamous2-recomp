+       CK_TRIGGER, CK_LOG, CK_READONLY, CK_MOTION, CK_PREFER, CK_COUNT };
+
+#define PH_BACKENDS_ALL ((1L << PADHOST_KIND_XINPUT) | (1L << PADHOST_KIND_DS3) | \
+                         (1L << PADHOST_KIND_DS4) | (1L << PADHOST_KIND_DUALSENSE) | \
+                         (1L << PADHOST_KIND_SWITCH_PRO) | (1L << PADHOST_KIND_GENERIC))
+#define PH_BACKENDS_HID (PH_BACKENDS_ALL & ~(1L << PADHOST_KIND_XINPUT))
+
+/* Deadzone: radial, rescaled so full deflection still reaches 0/255. The game
+ * applies its own deadzone, tuned for a DUALSHOCK 3, on top of ours, so ours
+ * only has to hide the rest offset a DS3 would not show. Unless set, it is per
+ * kind: 24 % for XInput pads -- XInput's recommended value and what the old
+ * XInput path used (per axis), since Xbox sticks are the ones that drift --
+ * and 8 % for the rest (a DualSense here rests within 5 %, DS4s within ~3 %). */
+#define PH_DZ_KIND (-1)
+static struct {
+    volatile LONG enabled, backends, dz_left, dz_right;  /* dz in per-mille, PH_DZ_KIND = by kind */
+    volatile LONG focus_only, rumble_pct, trig_thresh, log, readonly;
+    volatile LONG motion;                                 /* 0: every port reads a pad lying still */
+    volatile LONG prefer_physical;                        /* 1: virtual duplicates get no port (ph_dup_reeval) */
+    volatile LONG pinned;                                 /* bit per CK_*: set by the environment */
+} s_cfg = { 1, PH_BACKENDS_ALL, PH_DZ_KIND, PH_DZ_KIND, 0, 100, 30, 0, 0, 1, 1, 0 };
+
+static LONG ph_dz_default(int kind) { return kind == PADHOST_KIND_XINPUT ? 240 : 80; }
+
+/* Driver keys; a generic pad's "map.VID:PID = ..." line runs to ~170 characters. */
+static struct { char key[48]; char val[480]; } s_kv[64];
+static int s_nkv;
+
+static void ph_norm(const char* in, char* out, size_t n)
+{
+    size_t o = 0;
+    for (; in && *in && o + 1 < n; in++) {
+        char c = *in;
+        if (c == ' ' || c == '\t' || c == '_' || c == '-' || c == '.') continue;
+        if (c >= 'A' && c <= 'Z') c = (char)(c - 'A' + 'a');
+        out[o++] = c;
+    }
+    out[o] = 0;
+}
+
+static int ph_starts(const char* s, const char* p) { return strncmp(s, p, strlen(p)) == 0; }
+
+/* Normalised key with an optional "controller(s)"/"gamepad(s)"/"pad" prefix
+ * removed ("controllers" alone stays a key of its own). */
+static void ph_key(const char* key, char* out, size_t n)
+{
+    char k[96];
+    ph_norm(key, k, sizeof k);
+    static const char* pre[] = { "controllers", "controller", "gamepads", "gamepad", "padhost", "pad" };
+    for (unsigned i = 0; i < sizeof pre / sizeof pre[0]; i++) {
+        size_t l = strlen(pre[i]);
+        if (ph_starts(k, pre[i])) { snprintf(out, n, "%s", k[l] ? k + l : k); return; }
+    }
+    snprintf(out, n, "%s", k);
+}
+
+static int ph_parse_bool(const char* v, LONG* out)
+{
+    char n[16];
+    ph_norm(v, n, sizeof n);
+    if (!strcmp(n, "1") || !strcmp(n, "true") || !strcmp(n, "yes") || !strcmp(n, "on"))   { *out = 1; return 1; }
+    if (!strcmp(n, "0") || !strcmp(n, "false") || !strcmp(n, "no") || !strcmp(n, "off")) { *out = 0; return 1; }
+    return 0;
+}
+
+static int ph_parse_pct(const char* v, double lo, double hi, double* out)
+{
+    char* end;
+    double d = strtod(v, &end);
+    if (end == v) return 0;
+    while (*end == ' ' || *end == '\t' || *end == '%') end++;
+    if (*end || d != d || d < lo || d > hi) return 0;
+    *out = d;
+    return 1;
+}
+
+static int ph_backend_bit(const char* name)
+{
+    static const struct { const char* n; int kind; } t[] = {
+        { "xinput", PADHOST_KIND_XINPUT },   { "xbox", PADHOST_KIND_XINPUT },
+        { "ds3", PADHOST_KIND_DS3 },         { "sixaxis", PADHOST_KIND_DS3 },
+        { "ps3", PADHOST_KIND_DS3 },         { "dualshock3", PADHOST_KIND_DS3 },
+        { "ds4", PADHOST_KIND_DS4 },         { "ps4", PADHOST_KIND_DS4 },
+        { "dualshock4", PADHOST_KIND_DS4 },
+        { "dualsense", PADHOST_KIND_DUALSENSE }, { "ds5", PADHOST_KIND_DUALSENSE },
+        { "ps5", PADHOST_KIND_DUALSENSE },
+        { "switchpro", PADHOST_KIND_SWITCH_PRO }, { "switch", PADHOST_KIND_SWITCH_PRO },
+        { "nintendo", PADHOST_KIND_SWITCH_PRO },  { "procon", PADHOST_KIND_SWITCH_PRO },
+        { "generic", PADHOST_KIND_GENERIC }, { "hid", PADHOST_KIND_GENERIC },
+        { "dinput", PADHOST_KIND_GENERIC },  { "directinput", PADHOST_KIND_GENERIC },
+    };
+    for (unsigned i = 0; i < sizeof t / sizeof t[0]; i++)
+        if (!strcmp(name, t[i].n)) return t[i].kind;
+    return -1;
+}
+
+static int ph_parse_backends(const char* v, LONG* out)
+{
+    LONG m = 0;
+    int first = 1;
+    const char* p = v;
+    while (*p) {
+        while (*p == ',' || *p == ' ' || *p == '+' || *p == '\t') p++;
+        if (!*p) break;
+        const char* e = p;
+        while (*e && *e != ',' && *e != ' ' && *e != '+' && *e != '\t') e++;
+        char tok[32], n[32];
+        size_t l = (size_t)(e - p);
+        if (l >= sizeof tok) return 0;
+        memcpy(tok, p, l);
+        tok[l] = 0;
+        p = e;
+        int neg = tok[0] == '-' || tok[0] == '!';
+        ph_norm(neg ? tok + 1 : tok, n, sizeof n);
+        if (first && neg) m = PH_BACKENDS_ALL;
+        first = 0;
+        LONG bits;
+        if (!strcmp(n, "all") || !strcmp(n, "default")) bits = PH_BACKENDS_ALL;
+        else if (!strcmp(n, "none") || !strcmp(n, "off")) { if (!neg) m = 0; continue; }
+        else {
+            int k = ph_backend_bit(n);
+            if (k < 0) return 0;
+            bits = 1L << k;
+        }
+        if (neg) m &= ~bits;
+        else     m |= bits;
+    }
+    *out = m;
+    return 1;
+}
+
+static void ph_kv_store(const char* k, const char* v)
+{
+    AcquireSRWLockExclusive(&s_kv_lock);
+    int i;
+    for (i = 0; i < s_nkv; i++)
+        if (!strcmp(s_kv[i].key, k)) break;
+    if (i == s_nkv && s_nkv < (int)(sizeof s_kv / sizeof s_kv[0])) {
+        s_nkv++;
+        snprintf(s_kv[i].key, sizeof s_kv[i].key, "%s", k);
+    }
+    int stored = i < s_nkv, cut = 0;
+    if (stored) cut = snprintf(s_kv[i].val, sizeof s_kv[i].val, "%s", v) >= (int)sizeof s_kv[i].val;
+    ReleaseSRWLockExclusive(&s_kv_lock);
+    if (!stored)   padhost_logf("config: too many controller settings, \"%s\" ignored", k);
+    else if (cut)  padhost_logf("config: the value of \"%s\" is too long, cut to %d characters",
+                                k, (int)sizeof s_kv[0].val - 1);
+}
+
+const char* padhost_config_get(const char* key)
+{
+    char k[96];
+    const char* r = NULL;
+    if (!key) return NULL;
+    ph_global_once();
+    ph_key(key, k, sizeof k);
+    /* On the ExitProcess path (a driver's close()) a killed thread may own the lock. */
+    int lock = !s_exiting;
+    if (lock) AcquireSRWLockShared(&s_kv_lock);
+    for (int i = 0; i < s_nkv; i++)
+        if (!strcmp(s_kv[i].key, k)) { r = s_kv[i].val; break; }
+    if (lock) ReleaseSRWLockShared(&s_kv_lock);
+    return r;
+}
+
+static void ph_request_reconfig(void)
+{
+    InterlockedExchange(&s_reconfig, 1);
+    if (s_state == 1 && s_ev_rescan) SetEvent(s_ev_rescan);
+}
+
+static int ph_config_apply(const char* key, const char* value, int from_env)
+{
+    char k[96];
+    if (!key || !value) return -1;
+    ph_key(key, k, sizeof k);
+    while (*value == ' ' || *value == '\t') value++;
+
+    static const struct { const char* n; int id; } names[] = {
+        { "controllers", CK_CONTROLLERS }, { "controller", CK_CONTROLLERS },
+        { "gamepads", CK_CONTROLLERS },    { "gamepad", CK_CONTROLLERS },
+        { "enabled", CK_CONTROLLERS },     { "enable", CK_CONTROLLERS },
+        { "physicalcontrollers", CK_CONTROLLERS },
+        { "backends", CK_BACKENDS },       { "backend", CK_BACKENDS },
+        { "deadzone", CK_DZ_LEFT },        { "stickdeadzone", CK_DZ_LEFT },
+        { "deadzoneleft", CK_DZ_LEFT },    { "leftdeadzone", CK_DZ_LEFT },
+        { "deadzoneright", CK_DZ_RIGHT },  { "rightdeadzone", CK_DZ_RIGHT },
+        { "focusonly", CK_FOCUS },
+        { "rumble", CK_RUMBLE },           { "vibration", CK_RUMBLE },
+        { "triggerthreshold", CK_TRIGGER },
+        { "log", CK_LOG },                 { "verbose", CK_LOG },
+        { "readonly", CK_READONLY },
+        { "motion", CK_MOTION },           { "motionsensors", CK_MOTION },
+        { "preferphysical", CK_PREFER },   { "physicalfirst", CK_PREFER },
+    };
+    int id = -1;
+    for (unsigned i = 0; i < sizeof names / sizeof names[0]; i++)
+        if (!strcmp(k, names[i].n)) { id = names[i].id; break; }
+    int both_dz = !strcmp(k, "deadzone") || !strcmp(k, "stickdeadzone");
+
+    if (id < 0) {
+        static const char* drv_pre[] = { "ds3", "ds4", "dualsense", "switchpro", "switch",
+                                         "generic", "xinput", "map" };
+        for (unsigned i = 0; i < sizeof drv_pre / sizeof drv_pre[0]; i++)
+            if (ph_starts(k, drv_pre[i])) { ph_kv_store(k, value); return 1; }
+        return 0;
+    }
+    LONG bit = 1L << id;
+    if (!from_env && (s_cfg.pinned & bit)) {
+        if (s_cfg.log) padhost_logf("config: %s ignored, set by the environment", key);
+        return 1;
+    }
+    LONG v = 0;
+    double d = 0;
+    switch (id) {
+    case CK_CONTROLLERS:
+        if (!ph_parse_bool(value, &v)) return -1;
+        if (InterlockedExchange(&s_cfg.enabled, v) != v) ph_request_reconfig();
+        break;
+    case CK_BACKENDS:
+        if (!ph_parse_backends(value, &v)) return -1;
+        if (InterlockedExchange(&s_cfg.backends, v) != v) ph_request_reconfig();
+        break;
+    case CK_DZ_LEFT:
+    case CK_DZ_RIGHT: {
+        char n[16];
+        ph_norm(value, n, sizeof n);
+        if (!strcmp(n, "auto") || !strcmp(n, "default")) v = PH_DZ_KIND;
+        else if (!ph_parse_pct(value, 0, 90, &d)) return -1;
+        else v = (LONG)(d * 10.0 + 0.5);
+        if (both_dz || id == CK_DZ_LEFT) InterlockedExchange(&s_cfg.dz_left, v);
+        if (both_dz || id == CK_DZ_RIGHT) InterlockedExchange(&s_cfg.dz_right, v);
+        if (both_dz && from_env) bit |= 1L << CK_DZ_RIGHT;
+        break;
+    }
+    case CK_FOCUS:    if (!ph_parse_bool(value, &v)) return -1; InterlockedExchange(&s_cfg.focus_only, v); break;
+    case CK_LOG:      if (!ph_parse_bool(value, &v)) return -1; InterlockedExchange(&s_cfg.log, v); break;
+    case CK_READONLY: if (!ph_parse_bool(value, &v)) return -1; InterlockedExchange(&s_cfg.readonly, v); break;
+    case CK_MOTION:   if (!ph_parse_bool(value, &v)) return -1; InterlockedExchange(&s_cfg.motion, v); break;
+    case CK_PREFER:
+        if (!ph_parse_bool(value, &v)) return -1;
+        if (InterlockedExchange(&s_cfg.prefer_physical, v) != v) ph_request_reconfig();
+        break;
+    case CK_RUMBLE:
+        /* A number is a percentage ("rumble = 1" is 1 %, not "on"); only the
+         * words mean on (100) / off. */
+        if (ph_parse_pct(value, 0, 200, &d)) v = (LONG)(d + 0.5);
+        else if (ph_parse_bool(value, &v)) v *= 100;
+        else return -1;
+        InterlockedExchange(&s_cfg.rumble_pct, v);
+        break;
+    case CK_TRIGGER:
+        if (!ph_parse_pct(value, 0, 100, &d)) return -1;
+        InterlockedExchange(&s_cfg.trig_thresh, (LONG)(d * 255.0 / 100.0 + 0.5));
+        break;
+    default:
+        return 0;
+    }
+    if (from_env) InterlockedOr(&s_cfg.pinned, bit);
+    ph_kv_store(k, value);
+    return 1;
+}
+
+int padhost_config_set(const char* key, const char* value)
+{
+    ph_global_once();
+    return ph_config_apply(key, value, 0);
+}
+
+static char* ph_trim(char* s)
+{
+    while (*s == ' ' || *s == '\t' || *s == '\r') s++;
+    char* e = s + strlen(s);
+    while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r')) *--e = 0;
+    return s;
+}
+
+static int ph_parse_text(const char* text, int env_style, int from_env, void (*warn)(const char*))
+{
+    int bad = 0, lineno = 0, section = 0;   /* 0 none, 1 controller, 2 other */
+    const char* p = text;
+    while (p && *p) {
+        const char* e = p;
+        while (*e && *e != '\n' && !(env_style && (*e == ';' || *e == '|'))) e++;
+        char line[512];
+        size_t n = (size_t)(e - p);
+        if (n >= sizeof line) n = sizeof line - 1;
+        memcpy(line, p, n);
+        line[n] = 0;
+        p = *e ? e + 1 : e;
+        lineno++;
+        for (char* c = line; *c; c++)
+            if (*c == '#' || (!env_style && *c == ';')) { *c = 0; break; }
+        char* s = ph_trim(line);
+        if (!*s) continue;
+        if (*s == '[') {
+            char sec[64];
+            char* close = strchr(s, ']');
+            if (close) *close = 0;
+            ph_norm(s + 1, sec, sizeof sec);
+            /* The same test pad_kbm.h uses to leave a section to us, so no
+             * section is dropped by both ([Controller settings]). */
+            section = (ph_starts(sec, "controller") || ph_starts(sec, "gamepad")) ? 1 : 2;
+            continue;
+        }
+        char* eq = strchr(s, '=');
+        char nm[96];
+        if (!eq) {
+            if (section == 1) {
+                bad++;
+                if (warn) { char m[160]; snprintf(m, sizeof m, "line %d: expected 'name = value'", lineno); warn(m); }
+            }
+            continue;
+        }
+        *eq = 0;
+        char* name = ph_trim(s);
+        char* val  = ph_trim(eq + 1);
+        ph_norm(name, nm, sizeof nm);
+        int mine = section == 1 || ph_starts(nm, "controller") || ph_starts(nm, "gamepad");
+        if (!mine) continue;
+        int r = ph_config_apply(name, val, from_env);
+        if (r <= 0) {
+            bad++;
+            if (warn) {
+                char m[300];
+                snprintf(m, sizeof m, r == 0 ? "line %d: unknown controller setting \"%s\""
+                                             : "line %d: %s: bad value \"%s\"", lineno, name, val);
+                warn(m);
+            }
+        }
+    }
+    return bad;
+}
+
+int padhost_config_parse_text(const char* text, int env_style, void (*warn)(const char* msg))
+{
+    ph_global_once();
+    return ph_parse_text(text, env_style, 0, warn);
+}
+
+int padhost_backend_enabled(int kind)
+{
+    if (kind <= PADHOST_KIND_NONE || kind >= PADHOST_KIND_COUNT) return 0;
+    return s_cfg.enabled && (s_cfg.backends & (1L << kind)) != 0;
+}
+
+static int ph_hid_allowed(void) { return s_cfg.enabled && (s_cfg.backends & PH_BACKENDS_HID); }
+
+static void ph_cfg_warn(const char* m) { padhost_logf("PAD_HOST: %s", m); }
+
+static const char* ph_env(const char* name, char* buf, DWORD n)
+{
+    DWORD r = GetEnvironmentVariableA(name, buf, n);
+    return (r && r < n) ? buf : NULL;
+}
+
+static void ph_config_env(void)
+{
+    /* Every key in PAD_HOST is a controller key: one implicit [controller]. */
+    char eb[900], vb[200];
+    const char* e = ph_env("PAD_HOST", eb, sizeof eb);
+    if (e && *e) {
+        char buf[1024];
+        snprintf(buf, sizeof buf, "[controller]|%s", e);
+        ph_parse_text(buf, 1, 1, ph_cfg_warn);
+    }
+    struct { const char* env; const char* key; int invert; } m[] = {
+        { "PAD_NO_HOST",    "controllers", 1 },
+        { "PAD_BACKENDS",   "backends",    0 },
+        { "PAD_DEADZONE",   "deadzone",    0 },
+        { "PAD_FOCUS_ONLY", "focus_only",  0 },
+        { "PAD_PREFER_PHYSICAL", "prefer_physical", 0 },
+        { "PAD_LOG",        "log",         0 },
+    };
+    for (unsigned i = 0; i < sizeof m / sizeof m[0]; i++) {
+        const char* v = ph_env(m[i].env, vb, sizeof vb);
+        if (!v || !*v) continue;
+        const char* use = v;
+        if (m[i].invert) {
+            LONG b = 1;
+            if (!ph_parse_bool(v, &b)) b = 1;          /* PAD_NO_HOST=anything but 0 */
+            use = b ? "0" : "1";
+        }
+        if (ph_config_apply(m[i].key, use, 1) < 0)
+            padhost_logf("%s=%s: bad value, ignored", m[i].env, v);
+    }
+}
