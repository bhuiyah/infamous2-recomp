+/* ---------------------------------------------------------------------------
+ * Save states: FSFD (fsfd_ss.inc) -- the open files and directories of all
+ * three fd tables: this one, and the two cellFs layers that add their parts
+ * (ppu_fs.cpp at ppu_fs_register, cellFs.c at static init).
+ *
+ * check(), everything parked (engine design 4.2): no file open for writing
+ * -- its contents would not match the snapshot of its writer; the tables'
+ * ss_add_check functions apply the same rule before every stop and to a
+ * load, this is the last word at the stop -- and every open file
+ * representable: a guest path to reopen it by and a position that reads.
+ *
+ * capture(): two RECS arrays, "files" and "dirs", keyed table << 16 | fd,
+ * then each part's own statics (FIELDS, named by the part's list). The
+ * position, size and last write come from the open stream: no allocation,
+ * no stream lock (_ftelli64_nolock). The per-handle lowio lock the seek
+ * inside it takes is free, as the stream is: a guest thread parks only at a
+ * call's entry or in a kernel wait, never inside a stdio call on one of
+ * these streams, and no host thread uses them.
+ *
+ * A LOAD (M4c, at the end): check_image() before the stop -- every record
+ * resolved again by its table's own translator (and the EDAT step) and
+ * found unchanged: the file's size and last write, the directory at least
+ * `consumed` entries long --; teardown() closes everything all three tables
+ * hold; restore() reopens every record read-only at the same fd of the same
+ * table, sought to pos (sdata 2 decrypted again into a new tmpfile), every
+ * directory with `consumed` entries skipped, and reads the parts' FIELDS
+ * back. host_path is the one host-only field (SS_FF_HOST): a load opens
+ * what the guest path resolves to now.
+ * -----------------------------------------------------------------------*/
+#define FSFD_PART_MAX 4
+
+typedef struct fsfd_file_rec {
+    uint32_t table, fd;             /* FSFD_T_*, the fd the guest holds */
+    uint32_t flags;                 /* the guest's open flags, as passed */
+    uint32_t sdata, edat;           /* FSFD_SD_*; 1 = served from the EDAT cache */
+    uint64_t pos;                   /* the next read's offset */
+    uint64_t size, mtime;           /* of what is open (mtime: unix s, 0 for a tmpfile): the same file? */
+    char     path[FSFD_PATH_MAX];   /* the guest path: a load resolves it again */
+    char     host_path[FSFD_PATH_MAX];
+} fsfd_file_rec;
+static const ss_field k_fsfd_file_fields[] = {
+    SS_MEMBER(fsfd_file_rec, table), SS_MEMBER(fsfd_file_rec, fd), SS_MEMBER(fsfd_file_rec, flags),
+    SS_MEMBER(fsfd_file_rec, sdata), SS_MEMBER(fsfd_file_rec, edat), SS_MEMBER(fsfd_file_rec, pos),
+    SS_MEMBER(fsfd_file_rec, size), SS_MEMBER(fsfd_file_rec, mtime), SS_MEMBER(fsfd_file_rec, path),
+    SS_MEMBER_F(fsfd_file_rec, host_path, SS_FF_HOST),   /* a load opens what path resolves to now */
+};
+static const ss_list k_fsfd_file_list = SS_LIST("files", k_fsfd_file_fields);
+
+typedef struct fsfd_dir_rec {
+    uint32_t table, fd;
+    uint32_t consumed;              /* entries the guest was given: a load skips as many */
+    char     path[FSFD_PATH_MAX];
+    char     host_path[FSFD_PATH_MAX];
+} fsfd_dir_rec;
+static const ss_field k_fsfd_dir_fields[] = {
+    SS_MEMBER(fsfd_dir_rec, table), SS_MEMBER(fsfd_dir_rec, fd), SS_MEMBER(fsfd_dir_rec, consumed),
+    SS_MEMBER(fsfd_dir_rec, path), SS_MEMBER_F(fsfd_dir_rec, host_path, SS_FF_HOST),
+};
+static const ss_list k_fsfd_dir_list = SS_LIST("dirs", k_fsfd_dir_fields);
+
+/* This table's part: files are slots [0, SYS_FS_FD_MAX), directories follow. */
+static int sys_fs_ss_slot(int i, fsfd_ent* e)
+{
+    if (i < SYS_FS_FD_MAX) {
+        const sys_fs_fd_info* f = &g_sys_fs_fds[i];
+        if (!f->active || !f->fp) return 0;
+        e->fd = i + 3;                              /* FD is slot + 3 (sys_fs_open) */
+        e->wr = (f->flags & CELL_FS_O_ACCMODE) != CELL_FS_O_RDONLY;
+        e->flags = (uint32_t)f->flags;
+        e->edat = s_fd_edat[i];
+        e->fp = f->fp;
+        e->path = s_fd_gpath[i];
+        e->host_path = f->path;
+        return 1;
+    }
+    i -= SYS_FS_FD_MAX;
+    const sys_fs_dir_info* d = &g_sys_fs_dirs[i];
+    if (!d->active) return 0;
+    e->fd = i + 1;                                  /* dir fd is slot + 1 (sys_fs_opendir) */
+    e->dir = 1;
+    e->consumed = s_dir_read[i];
+    e->path = s_dir_gpath[i];
+    e->host_path = d->path;
+    return 1;
+}
+
+/* A LOAD (fsfd_ss.inc): where sys_fs_open / sys_fs_opendir resolve a guest
+ * path (their 1024-byte buffer), the fds they hand out, the table emptied,
+ * one record put back. */
+static int sys_fs_ss_translate(const char* path, char* host, size_t cap)
+{
+    char h[1024];
+    sys_fs_translate_path(path, h, sizeof h);
+    snprintf(host, cap, "%s", h);
+    return 0;
+}
+static int sys_fs_ss_fd_ok(int fd, int dir)
+{
+    return dir ? fd >= 1 && fd <= SYS_FS_DIR_MAX : fd >= 3 && fd < SYS_FS_FD_MAX + 3;
+}
+static void sys_fs_ss_teardown(void)
+{
+    for (int i = 0; i < SYS_FS_FD_MAX; i++)
+        if (g_sys_fs_fds[i].active && g_sys_fs_fds[i].fp) fclose(g_sys_fs_fds[i].fp);
+    for (int i = 0; i < SYS_FS_DIR_MAX; i++) {
+        sys_fs_dir_info* d = &g_sys_fs_dirs[i];
+        if (!d->active) continue;
+#ifdef _WIN32
+        if (d->find_handle && d->find_handle != INVALID_HANDLE_VALUE) FindClose(d->find_handle);
+#else
+        if (d->dp) closedir(d->dp);
+#endif
+    }
+    memset(g_sys_fs_fds, 0, sizeof g_sys_fs_fds);
+    memset(g_sys_fs_dirs, 0, sizeof g_sys_fs_dirs);
+    memset(s_fd_gpath, 0, sizeof s_fd_gpath);
+    memset(s_fd_edat, 0, sizeof s_fd_edat);
+    memset(s_dir_gpath, 0, sizeof s_dir_gpath);
+    memset(s_dir_read, 0, sizeof s_dir_read);
+}
+static int sys_fs_ss_put(const fsfd_put* p, FILE* fp, char* why, size_t n)
+{
+    if (!p->dir) {
+        const int slot = p->fd - 3;
+        sys_fs_fd_info* f = &g_sys_fs_fds[slot];
+        if (f->active) { fclose(fp); snprintf(why, n, "fd %d is taken", p->fd); return -1; }
+        memset(f, 0, sizeof *f);
+        f->active = 1;
+        f->fp     = fp;
+        f->flags  = (int)p->flags;
+        strncpy(f->path, p->host, sizeof(f->path) - 1);
+        strncpy(s_fd_gpath[slot], p->path, FSFD_PATH_MAX - 1);
+        s_fd_gpath[slot][FSFD_PATH_MAX - 1] = '\0';
+        s_fd_edat[slot] = (uint8_t)p->edat;
+        return 0;
+    }
+    const int slot = p->fd - 1;
+    sys_fs_dir_info* d = &g_sys_fs_dirs[slot];
+    if (d->active) { snprintf(why, n, "dir fd %d is taken", p->fd); return -1; }
+    memset(d, 0, sizeof *d);
+#ifdef _WIN32
+    char search_path[1024];
+    snprintf(search_path, sizeof(search_path), "%s\\*", p->host);
+    d->find_handle = FindFirstFileA(search_path, &d->find_data);
+    if (d->find_handle == INVALID_HANDLE_VALUE) { snprintf(why, n, "the directory does not open"); return -1; }
+    d->first_read = 1;
+    /* sys_fs_readdir's walk over the entries the guest was given: the first
+     * is FindFirstFile's, each later one a FindNextFile */
+    for (uint32_t k = 0; k < p->consumed; k++) {
+        if (d->first_read) d->first_read = 0;
+        else if (!FindNextFileA(d->find_handle, &d->find_data)) break;   /* (at its end, as the guest was) */
+    }
+#else
+    d->dp = opendir(p->host);
+    if (!d->dp) { snprintf(why, n, "the directory does not open"); return -1; }
+    for (uint32_t k = 0; k < p->consumed && readdir(d->dp); k++) {}
+#endif
+    d->active = 1;
+    strncpy(d->path, p->host, sizeof(d->path) - 1);
+    strncpy(s_dir_gpath[slot], p->path, FSFD_PATH_MAX - 1);
+    s_dir_gpath[slot][FSFD_PATH_MAX - 1] = '\0';
+    s_dir_read[slot] = p->consumed;
+    return 0;
+}
+static const fsfd_part k_sys_fs_part = {
+    FSFD_T_SYS_FS, SYS_FS_FD_MAX + SYS_FS_DIR_MAX, sys_fs_ss_slot, NULL,
+    sys_fs_ss_translate, 1, sys_fs_ss_fd_ok, 0, NULL, sys_fs_ss_teardown, sys_fs_ss_put,
+};
+
+/* The parts by table, and the section's lists: the two arrays, then the
+ * parts' own fields in table order (the layout hash). Set at static init and
+ * boot, read at a save. */
+static const fsfd_part* s_fsfd_part[FSFD_PART_MAX] = { &k_sys_fs_part };
+static int s_fsfd_nparts = 1;
+static const ss_list* s_fsfd_lists[2 + FSFD_PART_MAX + 1] = { &k_fsfd_file_list, &k_fsfd_dir_list };
+
+int fsfd_ss_add_part(const fsfd_part* p)
+{
+    if (!p || !p->slot) return 0;
+    int i = 0;
+    while (i < s_fsfd_nparts && s_fsfd_part[i]->table < p->table) i++;
+    if (i < s_fsfd_nparts && s_fsfd_part[i]->table == p->table) {
+        s_fsfd_part[i] = p;
+    } else {
+        if (s_fsfd_nparts >= FSFD_PART_MAX) return 0;
+        for (int j = s_fsfd_nparts; j > i; j--) s_fsfd_part[j] = s_fsfd_part[j - 1];
+        s_fsfd_part[i] = p;
+        s_fsfd_nparts++;
+    }
+    int n = 2;
+    for (int j = 0; j < s_fsfd_nparts; j++)
+        if (s_fsfd_part[j]->fields) s_fsfd_lists[n++] = s_fsfd_part[j]->fields;
+    s_fsfd_lists[n] = NULL;
+    return 1;
+}
+
+static const char* fsfd_table_name(uint32_t t)
+{
+    return t == FSFD_T_SYS_FS ? "sys_fs" : t == FSFD_T_PPU_FS ? "cellFs" : t == FSFD_T_CELLFS ? "libs cellFs" : "?";
+}
+
+/* Every open slot of every part, in table order. */
+typedef struct fsfd_it { int k, i; } fsfd_it;
+static int fsfd_next(fsfd_it* it, const fsfd_part** p, fsfd_ent* e)
+{
+    for (; it->k < s_fsfd_nparts; it->k++, it->i = 0) {
+        const fsfd_part* q = s_fsfd_part[it->k];
+        while (it->i < q->nslots) {
+            memset(e, 0, sizeof *e);
+            if (q->slot(it->i++, e) == 1) { *p = q; return 1; }
+        }
+    }
+    return 0;
+}
+
+/* An open stream's position: 0, or -1 if it does not read. */
+static int fsfd_tell(FILE* fp, uint64_t* pos)
+{
+    *pos = 0;
+    if (!fp) return -1;
+#if defined(_MSC_VER)
+    const __int64 p = _ftelli64_nolock(fp);         /* no stream lock (see above) */
+#elif defined(_WIN32)
+    const __int64 p = _ftelli64(fp);
+#else
+    const off_t p = ftello(fp);                     /* takes the stream lock: free, as above */
+#endif
+    if (p < 0) return -1;
+    *pos = (uint64_t)p;
+    return 0;
+}
+
+/* Its size and last write (unix s; none for a tmpfile, whose time means
+ * nothing): what a load compares to tell the same file from a changed one. */
+static void fsfd_file_stat(FILE* fp, int tmp, uint64_t* size, uint64_t* mtime)
+{
+    *size = *mtime = 0;
+    if (!fp) return;
+#ifdef _WIN32
+    HANDLE h = (HANDLE)_get_osfhandle(_fileno(fp));
+    if (h == INVALID_HANDLE_VALUE) return;
+    LARGE_INTEGER sz;
+    FILETIME wt;
+    if (GetFileSizeEx(h, &sz)) *size = (uint64_t)sz.QuadPart;
+    if (!tmp && GetFileTime(h, NULL, NULL, &wt)) {
+        const uint64_t t = ((uint64_t)wt.dwHighDateTime << 32) | wt.dwLowDateTime;   /* 100 ns since 1601 */
+        *mtime = t > 116444736000000000ull ? (t - 116444736000000000ull) / 10000000ull : 0;
+    }
+#else
+    struct stat st;
+    if (fstat(fileno(fp), &st) == 0) {
+        *size = (uint64_t)st.st_size;
+        if (!tmp) *mtime = (uint64_t)st.st_mtime;
+    }
+#endif
+}
+
+static void fsfd_copy_path(char* dst, const char* src)   /* dst: FSFD_PATH_MAX bytes, zeroed */
+{
+    for (size_t k = 0; src && k < FSFD_PATH_MAX - 1 && src[k]; k++) dst[k] = src[k];
+}
+
+static int fsfd_check(char* why, size_t n)
+{
+    fsfd_it it;
+    const fsfd_part* p;
+    fsfd_ent e;
+    /* a file open for writing first: the reason the user is told */
+    for (it.k = it.i = 0; fsfd_next(&it, &p, &e);)
+        if (!e.dir && e.wr) {
+            snprintf(why, n, "%s", e.path && e.path[0] ? e.path : e.host_path ? e.host_path : "?");
+            return SS_REASON_FILE_WRITE;
+        }
+    for (it.k = it.i = 0; fsfd_next(&it, &p, &e);) {
+        uint64_t pos;
+        if (!e.path || !e.path[0]) {
+            snprintf(why, n, "%s %s %d has no guest path to reopen it by", fsfd_table_name(p->table),
+                     e.dir ? "dir fd" : "fd", e.fd);
+            return SS_REASON_SECTION;
+        }
+        if (!e.dir && fsfd_tell(e.fp, &pos) != 0) {
+            snprintf(why, n, "%s fd %d: no file position (%s)", fsfd_table_name(p->table), e.fd, e.path);
+            return SS_REASON_SECTION;
+        }
+    }
+    return 0;
+}
+
+static int fsfd_capture(ss_writer* w)
+{
+    fsfd_it it;
+    const fsfd_part* p;
+    fsfd_ent e;
+    fsfd_file_rec f;
+    fsfd_dir_rec d;
+    ss_recs_begin(w, &k_fsfd_file_list);
+    for (it.k = it.i = 0; fsfd_next(&it, &p, &e);) {
+        if (e.dir) continue;
+        memset(&f, 0, sizeof f);
+        f.table = p->table;
+        f.fd = (uint32_t)e.fd;
+        f.flags = e.flags;
+        f.sdata = (uint32_t)e.sdata;
+        f.edat = (uint32_t)e.edat;
+        fsfd_tell(e.fp, &f.pos);                    /* check() refused one that does not read */
+        fsfd_file_stat(e.fp, e.sdata == FSFD_SD_TMPFILE, &f.size, &f.mtime);
+        fsfd_copy_path(f.path, e.path);
+        fsfd_copy_path(f.host_path, e.host_path);
+        ss_recs_add(w, p->table << 16 | ((uint32_t)e.fd & 0xFFFFu), &f);
+    }
+    ss_recs_end(w);
+    ss_recs_begin(w, &k_fsfd_dir_list);
+    for (it.k = it.i = 0; fsfd_next(&it, &p, &e);) {
+        if (!e.dir) continue;
+        memset(&d, 0, sizeof d);
+        d.table = p->table;
+        d.fd = (uint32_t)e.fd;
+        d.consumed = e.consumed;
+        fsfd_copy_path(d.path, e.path);
+        fsfd_copy_path(d.host_path, e.host_path);
+        ss_recs_add(w, p->table << 16 | ((uint32_t)e.fd & 0xFFFFu), &d);
+    }
+    ss_recs_end(w);
+    for (int k = 0; k < s_fsfd_nparts; k++)
+        if (s_fsfd_part[k]->fields) ss_write_fields(w, s_fsfd_part[k]->fields);
+    return ss_writer_error(w);
+}
+
+/* Outside a stop: a record per open slot now, and slack for opens racing it. */
+static uint64_t fsfd_size_hint(void)
+{
+    fsfd_it it = { 0, 0 };
+    const fsfd_part* p;
+    fsfd_ent e;
+    uint64_t n = 16;
+    while (fsfd_next(&it, &p, &e)) n++;
+    return n * (sizeof(fsfd_file_rec) + 64) + 64u * 1024u;
+}
+
+/* ---- a LOAD (M4c): check_image, teardown, restore --------------------------
+ * Every record is checked against this build before it is used: in
+ * check_image (before the stop, so a refusal stops nothing) and again in
+ * restore (a SELFTEST's image has no check_image, and an image is never
+ * trusted). A record is named by its table and fd, "cellFs fd 3", then its
+ * guest path. */
+#define FSFD_HOST_MAX 1200                          /* a host path, an EDAT cache's ".dec" included */
+
+static const fsfd_part* fsfd_part_of(uint32_t table)
+{
+    for (int k = 0; k < s_fsfd_nparts; k++)
+        if (s_fsfd_part[k]->table == table) return s_fsfd_part[k];
+    return NULL;
+}
+
+/* A record as a part's put() takes it (the strings stay in the record). */
+static void fsfd_file_put(const fsfd_file_rec* f, fsfd_put* q)
+{
+    memset(q, 0, sizeof *q);
+    q->fd = (int)f->fd;
+    q->flags = f->flags;
+    q->sdata = (int)f->sdata;
+    q->edat = (int)f->edat;
+    q->pos = f->pos;
+    q->size = f->size;
+    q->path = f->path;
+}
+static void fsfd_dir_put(const fsfd_dir_rec* d, fsfd_put* q)
+{
+    memset(q, 0, sizeof *q);
+    q->fd = (int)d->fd;
+    q->dir = 1;
+    q->consumed = d->consumed;
+    q->path = d->path;
+}
+
+/* One record against this build: its key, a table here that can put it
+ * back, an fd that table hands out, a guest path that ends, and -- a file
+ * -- a read-only open with known sdata / EDAT values (a save refuses a
+ * write-open fd). 0 and *pp, its name in who; or an error naming it. */
+static int fsfd_rec_ok(ss_reader* r, const char* list, uint32_t key, uint32_t table, const fsfd_put* q,
+                       const fsfd_part** pp, char* who, size_t who_n)
+{
+    const fsfd_part* p = fsfd_part_of(table);
+    *pp = NULL;
+    snprintf(who, who_n, "%s %s %d", fsfd_table_name(table), q->dir ? "dir fd" : "fd", q->fd);
+    if (key != (table << 16 | ((uint32_t)q->fd & 0xFFFFu)))
+        return ss_reader_fail(r, SS_E_CORRUPT, "%s[0x%X]: the key is not table %u, fd %d", list, key, table, q->fd);
+    if (!p || !p->translate || !p->fd_ok || !p->put)
+        return ss_reader_fail(r, SS_E_STATE, "%s[0x%X]: this build cannot reopen table %u's fds", list, key, table);
+    if (q->fd < 0 || q->fd > 0xFFFF || !p->fd_ok(q->fd, q->dir))
+        return ss_reader_fail(r, SS_E_CORRUPT, "%s: not an fd this table hands out", who);
+    if (!memchr(q->path, 0, FSFD_PATH_MAX) || !q->path[0])
+        return ss_reader_fail(r, SS_E_CORRUPT, "%s: no guest path, or one that does not end", who);
+    if (!q->dir) {
+        if (q->flags & CELL_FS_O_ACCMODE)
+            return ss_reader_fail(r, SS_E_STATE, "%s %s: open for writing (flags 0x%X)", who, q->path, q->flags);
+        if (q->sdata < FSFD_SD_NONE || q->sdata > FSFD_SD_TMPFILE || (q->sdata != FSFD_SD_NONE && !p->check_sdata))
+            return ss_reader_fail(r, SS_E_CORRUPT, "%s %s: sdata %d", who, q->path, q->sdata);
+        if (q->edat < 0 || q->edat > 1 || (q->edat && !p->edat_opens))
+            return ss_reader_fail(r, SS_E_CORRUPT, "%s %s: edat %d", who, q->path, q->edat);
+    }
+    *pp = p;
+    return SS_OK;
+}
+
+/* check_image: no slot named twice. One bit per part, kind (files,
+ * directories; one kind for a table whose kinds share the numbers) and fd. */
+static int fsfd_once(ss_reader* r, uint8_t* seen, const fsfd_part* p, const fsfd_put* q, const char* who)
+{
+    int k = 0;
+    while (k < s_fsfd_nparts && s_fsfd_part[k] != p) k++;
+    const size_t bit = ((size_t)k * 2u + (size_t)(p->shared_fds ? 0 : q->dir)) * 65536u + (size_t)q->fd;
+    if (seen[bit / 8] & (1u << (bit % 8)))
+        return ss_reader_fail(r, SS_E_CORRUPT, "%s: two records for it", who);
+    seen[bit / 8] |= (uint8_t)(1u << (bit % 8));
+    return SS_OK;
+}
+
+/* What edat_resolve (edat.c) answers for host, without decrypting: 1 and
+ * the cache's path when host is an NPD file whose "<host>.dec" exists and
+ * is not older than it, else 0 -- also where edat_resolve would decrypt
+ * now: a check before the stop must not, and a cache made again is another
+ * file anyway (its last write). Mirrors edat.c, PS3_EDAT=0 included. */
+static int fsfd_edat_cached(const char* host, char* cache, size_t cap)
+{
+    const char* off = getenv("PS3_EDAT");
+    if ((off && off[0] == '0') || !edat_is_npd(host)) return 0;
+    if ((size_t)snprintf(cache, cap, "%s.dec", host) >= cap) return 0;
+    struct stat ss, ds;
+    return stat(host, &ss) == 0 && stat(cache, &ds) == 0 && ds.st_mtime >= ss.st_mtime;
+}
+
+/* A record's host path now: its table's translator, then -- a file of a
+ * table whose opens take it -- the EDAT step, which must agree with the
+ * record's (served from the cache then, or not). 0, or an error naming it. */
+static int fsfd_host(ss_reader* r, const fsfd_part* p, const fsfd_put* q, const char* who, char* host, size_t cap)
+{
+    if (p->translate(q->path, host, cap) != 0 || !host[0])
+        return ss_reader_fail(r, SS_E_STATE, "%s %s: no host path for it in this session", who, q->path);
+    if (q->dir || !p->edat_opens) return SS_OK;
+    char cache[FSFD_HOST_MAX];
+    const int c = fsfd_edat_cached(host, cache, sizeof cache);
+    if (c != q->edat)
+        return ss_reader_fail(r, SS_E_STATE, "%s %s: %s", who, q->path,
+                              q->edat ? "its EDAT cache is gone or older than the file"
+                                      : "served from an EDAT cache now, not when it was saved");
+    if (c) snprintf(host, cap, "%s", cache);
+    return SS_OK;
+}
+
+static int fsfd_seek(FILE* fp, uint64_t pos)
+{
+    if (pos > (uint64_t)INT64_MAX) return -1;
+#ifdef _WIN32
+    return _fseeki64(fp, (__int64)pos, SEEK_SET);
+#else
+    return fseeko(fp, (off_t)pos, SEEK_SET);
+#endif
+}
+
+/* A record's file opened read-only at q->host and found to be the one that
+ * was open -- its size and last write as the capture reads them; an sdata
+ * tmpfile's container checked by its table --, and (seek) at q->pos. The
+ * stream (an sdata tmpfile's container at 0), or NULL after ss_reader_fail. */
+static FILE* fsfd_open_file(ss_reader* r, const fsfd_part* p, const fsfd_put* q, uint64_t mtime, const char* who,
+                            int seek)
+{
+    FILE* fp = fopen(q->host, "rb");
+    if (!fp) {
+        ss_reader_fail(r, SS_E_STATE, "%s %s: gone, or it cannot be read (%s)", who, q->path, strerror(errno));
+        return NULL;
+    }
+    if (q->sdata == FSFD_SD_TMPFILE) {
+        char why[96] = "";
+        if (p->check_sdata(q->host, q->size, why, sizeof why) == 0) return fp;
+        fclose(fp);
+        ss_reader_fail(r, SS_E_STATE, "%s %s: %s", who, q->path, why);
+        return NULL;
+    }
+    uint64_t size = 0, mt = 0;
+    fsfd_file_stat(fp, 0, &size, &mt);
+    if (size != q->size || mt != mtime) {
+        fclose(fp);
+        ss_reader_fail(r, SS_E_STATE, "%s %s: changed on disk since the save (size %llu, now %llu; written %llu, now %llu)",
+                       who, q->path, (unsigned long long)q->size, (unsigned long long)size,
+                       (unsigned long long)mtime, (unsigned long long)mt);
+        return NULL;
+    }
+    if (seek && fsfd_seek(fp, q->pos) != 0) {
+        fclose(fp);
+        ss_reader_fail(r, SS_E_STATE, "%s %s: no seek to %llu", who, q->path, (unsigned long long)q->pos);
+        return NULL;
+    }
+    return fp;
+}
+
+/* The entries a directory enumerates now (the readdir of every table: "."
+ * and ".." included), counted up to `upto`; -1 if it does not open. */
+static long fsfd_dir_len(const char* host, uint32_t upto)
+{
+    long k = 0;
+#ifdef _WIN32
+    char pat[FSFD_HOST_MAX + 4];
+    size_t n = strlen(host);
+    while (n && (host[n - 1] == '/' || host[n - 1] == '\\')) n--;
+    snprintf(pat, sizeof pat, "%.*s\\*", (int)n, host);
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(pat, &fd);
+    if (h == INVALID_HANDLE_VALUE) return -1;
+    for (k = 1; (uint32_t)k < upto && FindNextFileA(h, &fd); k++) {}
+    FindClose(h);
+#else
+    DIR* d = opendir(host);
+    if (!d) return -1;
+    while ((uint32_t)k < upto && readdir(d)) k++;
+    closedir(d);
+#endif
+    return k;
+}
+
+/* Before the LOAD's stop, the world running (the tables untouched): can
+ * every record be put back here? Its table and fd, its path resolved again,
+ * the file unchanged on disk (an sdata container still decrypting to the
+ * same size), the directory at least as long as the guest has read. */
+static int fsfd_check_image(ss_reader* r)
+{
+    uint8_t* seen = (uint8_t*)calloc((size_t)FSFD_PART_MAX * 2u, 65536u / 8u);
+    if (!seen) return ss_reader_fail(r, SS_E_NOMEM, "no memory to check the records");
+    char host[FSFD_HOST_MAX], who[48];
+    fsfd_file_rec f;
+    fsfd_dir_rec d;
+    fsfd_put q;
+    const fsfd_part* p;
+    ss_recs_it it;
+    uint32_t key;
+    int k, e;
+    if ((e = ss_recs_open(r, &k_fsfd_file_list, &it)) != 0) goto out;
+    while ((k = ss_recs_next(&it, &key, &f)) == 1) {
+        fsfd_file_put(&f, &q);
+        if ((e = fsfd_rec_ok(r, "files", key, f.table, &q, &p, who, sizeof who)) != 0 ||
+            (e = fsfd_once(r, seen, p, &q, who)) != 0 || (e = fsfd_host(r, p, &q, who, host, sizeof host)) != 0)
+            goto out;
+        q.host = host;
+        FILE* fp = fsfd_open_file(r, p, &q, f.mtime, who, 0);
+        if (!fp) { e = r->err ? r->err : SS_E_STATE; goto out; }
+        fclose(fp);
+    }
+    if ((e = k) < 0) goto out;
+    if ((e = ss_recs_open(r, &k_fsfd_dir_list, &it)) != 0) goto out;
+    while ((k = ss_recs_next(&it, &key, &d)) == 1) {
+        fsfd_dir_put(&d, &q);
+        if ((e = fsfd_rec_ok(r, "dirs", key, d.table, &q, &p, who, sizeof who)) != 0 ||
+            (e = fsfd_once(r, seen, p, &q, who)) != 0 || (e = fsfd_host(r, p, &q, who, host, sizeof host)) != 0)
+            goto out;
+        const long n = fsfd_dir_len(host, q.consumed);
+        if (n < 0) { e = ss_reader_fail(r, SS_E_STATE, "%s %s: gone, or not a directory", who, q.path); goto out; }
+        if ((uint64_t)n < q.consumed) {
+            e = ss_reader_fail(r, SS_E_STATE, "%s %s: %ld entries now, the guest had read %u", who, q.path, n, q.consumed);
+            goto out;
+        }
+    }
+    e = k < 0 ? k : SS_OK;
+out:
+    free(seen);
+    return e;
+}
+
+/* After the discard: every table closes what it holds and is empty. */
+static void fsfd_teardown(void)
+{
+    for (int k = 0; k < s_fsfd_nparts; k++)
+        if (s_fsfd_part[k]->teardown) s_fsfd_part[k]->teardown();
+}
+
+/* Every record back at its fd of its table (the tables are empty: teardown
+ * ran), then the parts' FIELDS. Checked as check_image checks (the file
+ * still the one that was open), as a SELFTEST's image has no check_image;
+ * a failure here ends the process (the coordinator's point of no return). */
+static int fsfd_restore(ss_reader* r)
+{
+    char host[FSFD_HOST_MAX], who[48], why[128];
+    fsfd_file_rec f;
+    fsfd_dir_rec d;
+    fsfd_put q;
+    const fsfd_part* p;
+    ss_recs_it it;
+    uint32_t key;
+    int k, e, nf = 0, nd = 0;
+    if ((e = ss_recs_open(r, &k_fsfd_file_list, &it)) != 0) return e;
+    while ((k = ss_recs_next(&it, &key, &f)) == 1) {
+        fsfd_file_put(&f, &q);
+        if ((e = fsfd_rec_ok(r, "files", key, f.table, &q, &p, who, sizeof who)) != 0 ||
+            (e = fsfd_host(r, p, &q, who, host, sizeof host)) != 0)
+            return e;
+        q.host = host;
+        FILE* fp = fsfd_open_file(r, p, &q, f.mtime, who, 1);
+        if (!fp) return r->err ? r->err : SS_E_STATE;
+        why[0] = 0;
+        if (p->put(&q, fp, why, sizeof why) != 0) return ss_reader_fail(r, SS_E_STATE, "%s %s: %s", who, q.path, why);
+        nf++;
+    }
+    if (k < 0) return k;
+    if ((e = ss_recs_open(r, &k_fsfd_dir_list, &it)) != 0) return e;
+    while ((k = ss_recs_next(&it, &key, &d)) == 1) {
+        fsfd_dir_put(&d, &q);
+        if ((e = fsfd_rec_ok(r, "dirs", key, d.table, &q, &p, who, sizeof who)) != 0 ||
+            (e = fsfd_host(r, p, &q, who, host, sizeof host)) != 0)
+            return e;
+        q.host = host;
+        why[0] = 0;
+        if (p->put(&q, NULL, why, sizeof why) != 0) return ss_reader_fail(r, SS_E_STATE, "%s %s: %s", who, q.path, why);
+        nd++;
+    }
+    if (k < 0) return k;
+    for (int i = 0; i < s_fsfd_nparts; i++)
+        if (s_fsfd_part[i]->fields && (e = ss_read_fields(r, s_fsfd_part[i]->fields)) != 0) return e;
+    fprintf(stderr, "[ss] load: open files: %d file(s) and %d directory(ies) reopened at their fds\n", nf, nd);
+    return SS_OK;
+}
