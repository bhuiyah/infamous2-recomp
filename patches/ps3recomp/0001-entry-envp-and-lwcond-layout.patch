@@ -0,0 +1,546 @@
+/*
+ * ps3recomp - RSX ROP (blend / output merger) rules for the D3D12 backend.
+ *
+ * Pure C; the backend and libs/video/tests share it. D3D12 enum values are
+ * spelled as numbers (RSX_ROP_D3D_*: ABI-stable, checked against d3d12.h
+ * below when d3d12.h is included first, which also enables the D3D12 half).
+ *
+ * What the RSX does (docs/GROUND_TRUTH.md section 5.1; tiers as there):
+ *  - Blend equations pack RGB in bits 0-15 and alpha in bits 16-31 (T2:
+ *    PSL1GHT rsxSetBlendEquation; T4: Mesa nouveau nv30-40_3d.xml.h
+ *    NV40_3D_BLEND_EQUATION). Besides the GL modes the RSX has three signed ones:
+ *      0xF005 REVERSE_SUBTRACT_SIGNED  dst - s8(src)
+ *      0xF006 ADD_SIGNED               s8(src) + dst
+ *      0xF007 REVERSE_ADD_SIGNED       sat(src) + s8(dst)
+ *    s8(v): u8 = round(sat(v) * 255) reinterpreted as a signed byte, / 255;
+ *    the signed modes ignore the blend factors and only exist on 8-bit
+ *    targets (on fp16 ones they are the plain add/subtract: T4 only). T4: RPCS3 PR
+ *    #19410 (hardware suite of ~700 tests; issue #19269 "narrow test": a
+ *    significant number of modes ignore the factors). T3: the title's
+ *    SetBlendEquation (func_00501680 writes 0x320 = eq << 16 | eq) is called
+ *    with 0xF006 at 6 sites (0x0E0E7C, 0x2AEFE4, 0x2B6650, 0x2EC8F4,
+ *    0x362B54, 0x4274B0), each an additive draw with depth test off that is
+ *    followed by a reset to 0x8006: the refraction offset accumulation.
+ *    Four pass ONE/ONE, two SRC_ALPHA/ONE_MINUS_SRC_ALPHA, which the signed
+ *    mode ignores.
+ *  - SET_BLEND_ENABLE_MRT (0x036C): bits 1-3 enable blending on MRT 1-3,
+ *    SET_BLEND_ENABLE (0x0310) on target 0. T4: Mesa nouveau nv30_state.c
+ *    (NV40_3D_MRT_BLEND_ENABLE 0x36c, rt[i].blend_enable << i); T2: PSL1GHT
+ *    rsxSetBlendEnableMrt (mrt3<<3 | mrt2<<2 | mrt1<<1); T3: the title's
+ *    func_005014F0 writes 0x310 = m & 1 and 0x36C = m & 0xE, called with
+ *    m = 0x3, 0x9, 0x8, 0x1, 0x0 (0x8: only MRT 3 blends).
+ *  - No blending on fp32 targets (F_W32Z32Y32X32, F_X32): NV40 blends fp16
+ *    at most (T4 RPCS3 note; GeForce 6 series: fp16 blending).
+ *  - XRGB targets (X1R5G5B5_Z/O, X8R8G8B8_Z/O, X8B8G8R8_Z/O): DST_ALPHA
+ *    reads 1 whatever is stored; the X byte is stored as 0 (Z) or 1 (O).
+ *    T1a/T4: PR #19410 commit 5bc2c0d. No title use known (ROP_XRGB=1).
+ *  - ROP order sRGB -> round to 8 bits -> alpha test -> blend, blending the
+ *    stored bytes (T1a/T4: commit fbf1f96). D3D12 blends the unrounded float
+ *    source; rounding it in the shader first gives the hardware's operands.
+ *  - SRC_ALPHA_SATURATE = (min(As, 1 - Ad) x3, 1), MIN/MAX ignore the
+ *    factors, the 8-bit source is saturated first: D3D12 does the same.
+ *  - 16-bit (fp16 target) blend constants: R | G << 16 in BLEND_COLOR,
+ *    B | A << 16 in BLEND_COLOR2 (0x037C), each an fp16 (T4: Mesa nouveau
+ *    nv30_validate_blend_colour, which then rewrites BLEND_COLOR as ARGB8 --
+ *    the two T4 readings conflict, so BLEND_C16=1 is opt-in).
+ *
+ * How it maps to D3D12 (this file):
+ *  - The PSO blend key: bit 0 target-0 enable, [5:1] srcC, [10:6] dstC,
+ *    [15:11] srcA, [20:16] dstA (D3D12_BLEND), [23:21] opC, [26:24] opA
+ *    (D3D12_BLEND_OP), [29:27] MRT 1-3 enable, bit 30/31 RGB/alpha signed.
+ *    With every toggle off, bits 0-26 are the key the backend used before and
+ *    bits 27-29 mirror bit 0: the same pipeline as before.
+ *  - Signed equations: two draws. Pass P outputs max(s8, 0) with the group's
+ *    op (ADD for 0xF006, REV_SUBTRACT for 0xF005), pass N outputs max(-s8, 0)
+ *    with the other op and writes only the signed channels of the blended
+ *    targets. Per fragment that is clamp(dst +- s8(src)) exactly. Within one
+ *    draw all positive parts land before all negative ones, so overlapping
+ *    primitives differ from the hardware's primitive order only if an
+ *    intermediate sum saturates (documented approximation; an offset buffer
+ *    around 128 does not). Depth and stencil: rsx_rop_fill_ds (P tests and
+ *    writes depth, N does the stencil ops). 0xF007 is approximated as ADD
+ *    (logged; no title use).
+ *  - The rop word: a shader epilogue variant (rsx_rop_apply_epilogue).
+ */
+#ifndef RSX_ROP_H
+#define RSX_ROP_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+/* ---- guest values -------------------------------------------------------- */
+#define RSX_ROP_EQ_FUNC_ADD                 0x8006u
+#define RSX_ROP_EQ_MIN                      0x8007u
+#define RSX_ROP_EQ_MAX                      0x8008u
+#define RSX_ROP_EQ_FUNC_SUBTRACT            0x800Au
+#define RSX_ROP_EQ_FUNC_REVERSE_SUBTRACT    0x800Bu
+#define RSX_ROP_EQ_REVERSE_SUBTRACT_SIGNED  0xF005u
+#define RSX_ROP_EQ_ADD_SIGNED               0xF006u
+#define RSX_ROP_EQ_REVERSE_ADD_SIGNED       0xF007u
+
+/* CELL_GCM_SURFACE_* colour formats (SET_SURFACE_FORMAT bits 0-4). */
+#define RSX_ROP_FMT_X1R5G5B5_Z1R5G5B5  1u
+#define RSX_ROP_FMT_X1R5G5B5_O1R5G5B5  2u
+#define RSX_ROP_FMT_R5G6B5             3u
+#define RSX_ROP_FMT_X8R8G8B8_Z8R8G8B8  4u
+#define RSX_ROP_FMT_X8R8G8B8_O8R8G8B8  5u
+#define RSX_ROP_FMT_A8R8G8B8           8u
+#define RSX_ROP_FMT_B8                 9u
+#define RSX_ROP_FMT_G8B8              10u
+#define RSX_ROP_FMT_F_W16Z16Y16X16    11u
+#define RSX_ROP_FMT_F_W32Z32Y32X32    12u
+#define RSX_ROP_FMT_F_X32             13u
+#define RSX_ROP_FMT_X8B8G8R8_Z8B8G8R8 14u
+#define RSX_ROP_FMT_X8B8G8R8_O8B8G8R8 15u
+#define RSX_ROP_FMT_A8B8G8R8          16u
+
+/* ---- D3D12 enum values (D3D12_BLEND / D3D12_BLEND_OP) --------------------- */
+enum {
+    RSX_ROP_D3D_ZERO = 1, RSX_ROP_D3D_ONE = 2, RSX_ROP_D3D_SRC_COLOR = 3, RSX_ROP_D3D_INV_SRC_COLOR = 4,
+    RSX_ROP_D3D_SRC_ALPHA = 5, RSX_ROP_D3D_INV_SRC_ALPHA = 6, RSX_ROP_D3D_DEST_ALPHA = 7,
+    RSX_ROP_D3D_INV_DEST_ALPHA = 8, RSX_ROP_D3D_DEST_COLOR = 9, RSX_ROP_D3D_INV_DEST_COLOR = 10,
+    RSX_ROP_D3D_SRC_ALPHA_SAT = 11, RSX_ROP_D3D_BLEND_FACTOR = 14, RSX_ROP_D3D_INV_BLEND_FACTOR = 15,
+    RSX_ROP_D3D_ALPHA_FACTOR = 20, RSX_ROP_D3D_INV_ALPHA_FACTOR = 21
+};
+enum {
+    RSX_ROP_D3D_OP_ADD = 1, RSX_ROP_D3D_OP_SUBTRACT = 2, RSX_ROP_D3D_OP_REV_SUBTRACT = 3,
+    RSX_ROP_D3D_OP_MIN = 4, RSX_ROP_D3D_OP_MAX = 5
+};
+
+/* ---- the PSO blend key ---------------------------------------------------- */
+#define RSX_ROP_KEY_EN0        0x00000001u
+#define RSX_ROP_KEY_MRT_SHIFT  27
+#define RSX_ROP_KEY_MRT_MASK   (7u << RSX_ROP_KEY_MRT_SHIFT)
+#define RSX_ROP_KEY_SGN_RGB    0x40000000u
+#define RSX_ROP_KEY_SGN_A      0x80000000u
+#define RSX_ROP_KEY_ANY_EN     (RSX_ROP_KEY_EN0 | RSX_ROP_KEY_MRT_MASK)
+
+/* Does target t (0-3) blend under this key? */
+static inline int rsx_rop_key_target_blends(uint32_t key, int t)
+{
+    if (t <= 0) return (int)(key & 1u);
+    if (t > 3) return 0;
+    return (int)((key >> (RSX_ROP_KEY_MRT_SHIFT + t - 1)) & 1u);
+}
+
+/* ---- the rop word: the shader epilogue variant ----------------------------- */
+#define RSX_ROP_ROUND8       0x0001u  /* round colour exports to 8 bits (blending 8-bit target) */
+#define RSX_ROP_PASS_P       0x0002u  /* signed blend, positive pass */
+#define RSX_ROP_PASS_N       0x0004u  /* signed blend, negative pass */
+#define RSX_ROP_SGN_RGB      0x0008u  /* the signed transform applies to R,G,B */
+#define RSX_ROP_SGN_A        0x0010u  /* ... and/or to A */
+#define RSX_ROP_XA_ONE       0x0020u  /* forced alpha is 1 (else 0) */
+#define RSX_ROP_SGN_T_SHIFT  8        /* bits 8-11: targets the signed transform applies to */
+#define RSX_ROP_XA_T_SHIFT   12       /* bits 12-15: targets whose exported alpha is forced */
+
+static inline int rsx_rop_pass(uint32_t rop)
+{
+    return (rop & RSX_ROP_PASS_N) ? 2 : (rop & RSX_ROP_PASS_P) ? 1 : 0;
+}
+/* The negative pass of a signed draw (0 when the draw has none). */
+static inline uint32_t rsx_rop_pass_n(uint32_t rop)
+{
+    if (!(rop & RSX_ROP_PASS_P)) return 0u;
+    return (rop & ~RSX_ROP_PASS_P) | RSX_ROP_PASS_N;
+}
+
+/* ---- surface formats ------------------------------------------------------ */
+static inline int rsx_rop_fmt_is_float(uint32_t fmt)
+{
+    fmt &= 0x1Fu;
+    return fmt == RSX_ROP_FMT_F_W16Z16Y16X16 || fmt == RSX_ROP_FMT_F_W32Z32Y32X32 || fmt == RSX_ROP_FMT_F_X32;
+}
+static inline int rsx_rop_fmt_is_fp32(uint32_t fmt)
+{
+    fmt &= 0x1Fu;
+    return fmt == RSX_ROP_FMT_F_W32Z32Y32X32 || fmt == RSX_ROP_FMT_F_X32;
+}
+/* XRGB class: 0 = has alpha (or float), 1 = X stored as 0 (Z), 2 = X stored as
+ * 1 (O). R5G6B5 has no alpha bits: DST_ALPHA reads 1, and the alpha plane of
+ * our RGBA8 stand-in is kept at 1 like an O format. */
+static inline int rsx_rop_xrgb_class(uint32_t fmt)
+{
+    switch (fmt & 0x1Fu) {
+    case RSX_ROP_FMT_X1R5G5B5_Z1R5G5B5: case RSX_ROP_FMT_X8R8G8B8_Z8R8G8B8:
+    case RSX_ROP_FMT_X8B8G8R8_Z8B8G8R8:
+        return 1;
+    case RSX_ROP_FMT_X1R5G5B5_O1R5G5B5: case RSX_ROP_FMT_X8R8G8B8_O8R8G8B8:
+    case RSX_ROP_FMT_X8B8G8R8_O8B8G8R8: case RSX_ROP_FMT_R5G6B5:
+        return 2;
+    default:
+        return 0;
+    }
+}
+static inline const char* rsx_rop_fmt_name(uint32_t fmt)
+{
+    static const char* const nm[17] = {
+        "?0", "X1R5G5B5_Z", "X1R5G5B5_O", "R5G6B5", "X8R8G8B8_Z", "X8R8G8B8_O", "?6", "?7",
+        "A8R8G8B8", "B8", "G8B8", "F_W16Z16Y16X16", "F_W32Z32Y32X32", "F_X32", "X8B8G8R8_Z",
+        "X8B8G8R8_O", "A8B8G8R8" };
+    fmt &= 0x1Fu;
+    return fmt <= 16u ? nm[fmt] : "?";
+}
+
+/* fp16 -> float (the 16-bit blend constants). */
+static inline float rsx_rop_half(uint32_t h)
+{
+    const uint32_t s = (h & 0x8000u) << 16, e = (h >> 10) & 0x1Fu, m = h & 0x3FFu;
+    uint32_t bits;
+    if (e == 0u) {
+        if (m == 0u) bits = s;
+        else {                                   /* denormal: m * 2^-24 */
+            uint32_t ee = 113u, mm = m;          /* 127 - 15 + 1 */
+            while (!(mm & 0x400u)) { mm <<= 1; ee--; }
+            bits = s | (ee << 23) | ((mm & 0x3FFu) << 13);
+        }
+    } else if (e == 31u) bits = s | 0x7F800000u | (m << 13);
+    else bits = s | ((e + 112u) << 23) | (m << 13);
+    float f;
+    memcpy(&f, &bits, 4);
+    return f;
+}
+
+/* The constant blend colour as D3D's blend factor (R,G,B,A). 8-bit targets:
+ * BLEND_COLOR = 0xAARRGGBB. fp16 targets with c16: R|G<<16 and B|A<<16 as
+ * fp16 (see the header note). splat: copy A into RGB (a CONSTANT_ALPHA colour
+ * factor without D3D12_BLEND_ALPHA_FACTOR). */
+static inline void rsx_rop_blend_constant(uint32_t c, uint32_t c2, uint32_t fmt, int c16, int splat,
+                                          float out[4])
+{
+    if (c16 && (fmt & 0x1Fu) == RSX_ROP_FMT_F_W16Z16Y16X16) {
+        out[0] = rsx_rop_half(c & 0xFFFFu);  out[1] = rsx_rop_half(c >> 16);
+        out[2] = rsx_rop_half(c2 & 0xFFFFu); out[3] = rsx_rop_half(c2 >> 16);
+    } else {
+        out[0] = (float)((c >> 16) & 0xFFu) / 255.0f;
+        out[1] = (float)((c >> 8) & 0xFFu) / 255.0f;
+        out[2] = (float)(c & 0xFFu) / 255.0f;
+        out[3] = (float)((c >> 24) & 0xFFu) / 255.0f;
+    }
+    if (splat) out[0] = out[1] = out[2] = out[3];
+}
+
+/* ---- the plan: guest state -> PSO key + epilogue variant ------------------- */
+typedef struct rsx_rop_in {
+    uint32_t blend_enable;      /* SET_BLEND_ENABLE (target 0) */
+    uint32_t blend_enable_mrt;  /* SET_BLEND_ENABLE_MRT (bits 1-3) */
+    uint32_t sfactor, dfactor;  /* SET_BLEND_FUNC_SFACTOR/DFACTOR: alpha << 16 | rgb */
+    uint32_t equation;          /* SET_BLEND_EQUATION: alpha << 16 | rgb */
+    uint32_t surface_format;    /* SET_SURFACE_FORMAT (colour format in bits 0-4) */
+} rsx_rop_in;
+
+typedef struct rsx_rop_cfg {
+    int mrt;          /* BLEND_MRT: honour SET_BLEND_ENABLE_MRT (else MRT 1-3 mirror target 0) */
+    int sgn;          /* BLEND_SIGNED: the signed equations (else: ADD with the factors) */
+    int xrgb;         /* ROP_XRGB: DST_ALPHA = 1 and the forced X byte on XRGB targets */
+    int f32off;       /* BLEND_F32: no blending on fp32 targets */
+    int round8;       /* ROP_ROUND8: round the source to 8 bits before an 8-bit blend */
+    int alpha_factor; /* the device supports D3D12_BLEND_ALPHA_FACTOR (and BLEND_KALPHA != 0) */
+} rsx_rop_cfg;
+
+/* What the logs should say about a plan. */
+#define RSX_ROP_NOTE_EQ_UNKNOWN      0x001u  /* an equation outside the known set: ADD */
+#define RSX_ROP_NOTE_F007            0x002u  /* REVERSE_ADD_SIGNED approximated as ADD */
+#define RSX_ROP_NOTE_F32_DROPPED     0x004u  /* blend enable on an fp32 target ignored */
+#define RSX_ROP_NOTE_FACTOR_UNKNOWN  0x008u  /* a factor outside the known set: ONE */
+#define RSX_ROP_NOTE_KCONFLICT       0x010u  /* CONSTANT_COLOR and CONSTANT_ALPHA without ALPHA_FACTOR */
+#define RSX_ROP_NOTE_XRGB_KEEPDST    0x020u  /* O target, RGB factors read src alpha: stored A kept */
+#define RSX_ROP_NOTE_SIGNED          0x040u  /* two-pass signed blend */
+#define RSX_ROP_NOTE_LEGACY_SA       0x080u  /* factors never programmed: straight alpha */
+#define RSX_ROP_NOTE_SIGNED_FLOAT    0x100u  /* a signed equation on an fp16 target: plain add/sub */
+
+typedef struct rsx_rop_plan {
+    uint32_t key;     /* PSO blend key */
+    uint32_t rop;     /* epilogue variant; 0 = none */
+    uint32_t notes;   /* RSX_ROP_NOTE_* */
+    uint32_t bad_eq;  /* the unknown equation half, for the log */
+    uint32_t bad_factor;
+} rsx_rop_plan;
+
+static inline uint32_t rsx_rop_factor_d3d(uint32_t f, int is_alpha, int alpha_factor, uint32_t* unknown)
+{
+    switch (f & 0xFFFFu) {
+    case 0x0000: return RSX_ROP_D3D_ZERO;
+    case 0x0001: return RSX_ROP_D3D_ONE;
+    case 0x0300: return is_alpha ? RSX_ROP_D3D_SRC_ALPHA     : RSX_ROP_D3D_SRC_COLOR;
+    case 0x0301: return is_alpha ? RSX_ROP_D3D_INV_SRC_ALPHA : RSX_ROP_D3D_INV_SRC_COLOR;
+    case 0x0302: return RSX_ROP_D3D_SRC_ALPHA;
+    case 0x0303: return RSX_ROP_D3D_INV_SRC_ALPHA;
+    case 0x0304: return RSX_ROP_D3D_DEST_ALPHA;
+    case 0x0305: return RSX_ROP_D3D_INV_DEST_ALPHA;
+    case 0x0306: return is_alpha ? RSX_ROP_D3D_DEST_ALPHA     : RSX_ROP_D3D_DEST_COLOR;
+    case 0x0307: return is_alpha ? RSX_ROP_D3D_INV_DEST_ALPHA : RSX_ROP_D3D_INV_DEST_COLOR;
+    case 0x0308: return RSX_ROP_D3D_SRC_ALPHA_SAT;
+    case 0x8001: return RSX_ROP_D3D_BLEND_FACTOR;            /* CONSTANT_COLOR */
+    case 0x8002: return RSX_ROP_D3D_INV_BLEND_FACTOR;
+    case 0x8003: return (!is_alpha && alpha_factor) ? RSX_ROP_D3D_ALPHA_FACTOR : RSX_ROP_D3D_BLEND_FACTOR;
+    case 0x8004: return (!is_alpha && alpha_factor) ? RSX_ROP_D3D_INV_ALPHA_FACTOR : RSX_ROP_D3D_INV_BLEND_FACTOR;
+    default:
+        if (unknown) *unknown = f & 0xFFFFu;
+        return RSX_ROP_D3D_ONE;
+    }
+}
+
+/* One equation half. *sgn: 1 = signed (two-pass), 0 = not. *ignore: the
+ * factors do not apply (ONE/ONE). */
+static inline uint32_t rsx_rop_eq_d3d(uint32_t e, int is8, const rsx_rop_cfg* cfg, int* sgn, int* ignore,
+                                      uint32_t* notes, uint32_t* bad)
+{
+    *sgn = 0; *ignore = 0;
+    switch (e & 0xFFFFu) {
+    case 0x0000u:                               /* never programmed: the reset value FUNC_ADD */
+    case RSX_ROP_EQ_FUNC_ADD:                return RSX_ROP_D3D_OP_ADD;
+    case RSX_ROP_EQ_MIN:                     return RSX_ROP_D3D_OP_MIN;
+    case RSX_ROP_EQ_MAX:                     return RSX_ROP_D3D_OP_MAX;
+    case RSX_ROP_EQ_FUNC_SUBTRACT:           return RSX_ROP_D3D_OP_SUBTRACT;
+    case RSX_ROP_EQ_FUNC_REVERSE_SUBTRACT:   return RSX_ROP_D3D_OP_REV_SUBTRACT;
+    case RSX_ROP_EQ_ADD_SIGNED:
+    case RSX_ROP_EQ_REVERSE_SUBTRACT_SIGNED:
+    case RSX_ROP_EQ_REVERSE_ADD_SIGNED:
+        if (!cfg->sgn) return RSX_ROP_D3D_OP_ADD;        /* the old mapping */
+        *ignore = 1;
+        if (!is8) { *notes |= RSX_ROP_NOTE_SIGNED_FLOAT;
+                    return (e & 0xFFFFu) == RSX_ROP_EQ_REVERSE_SUBTRACT_SIGNED ? RSX_ROP_D3D_OP_REV_SUBTRACT
+                                                                               : RSX_ROP_D3D_OP_ADD; }
+        if ((e & 0xFFFFu) == RSX_ROP_EQ_REVERSE_ADD_SIGNED) { *notes |= RSX_ROP_NOTE_F007; return RSX_ROP_D3D_OP_ADD; }
+        *sgn = 1;
+        return (e & 0xFFFFu) == RSX_ROP_EQ_ADD_SIGNED ? RSX_ROP_D3D_OP_ADD : RSX_ROP_D3D_OP_REV_SUBTRACT;
+    default:
+        *notes |= RSX_ROP_NOTE_EQ_UNKNOWN; *bad = e & 0xFFFFu;
+        return RSX_ROP_D3D_OP_ADD;
+    }
+}
+
+static inline uint32_t rsx_rop_xrgb_rgb_factor(uint32_t f)
+{
+    if (f == RSX_ROP_D3D_DEST_ALPHA) return RSX_ROP_D3D_ONE;
+    if (f == RSX_ROP_D3D_INV_DEST_ALPHA) return RSX_ROP_D3D_ZERO;
+    if (f == RSX_ROP_D3D_SRC_ALPHA_SAT) return RSX_ROP_D3D_ZERO;    /* min(As, 1 - 1) */
+    return f;
+}
+
+static inline rsx_rop_plan rsx_rop_make_plan(const rsx_rop_in* in, const rsx_rop_cfg* cfg)
+{
+    rsx_rop_plan p;
+    memset(&p, 0, sizeof p);
+    const uint32_t fmt = in->surface_format & 0x1Fu;
+    const int is8 = !rsx_rop_fmt_is_float(fmt);
+    const int xcls = (cfg->xrgb && is8) ? rsx_rop_xrgb_class(fmt) : 0;
+    const uint32_t en0 = in->blend_enable ? 1u : 0u;
+    uint32_t tmask = en0 | (cfg->mrt ? (in->blend_enable_mrt & 0xEu) : (en0 ? 0xEu : 0u));
+    if (cfg->f32off && rsx_rop_fmt_is_fp32(fmt) && tmask) { p.notes |= RSX_ROP_NOTE_F32_DROPPED; tmask = 0; }
+    const uint32_t xa_value = (xcls == 2) ? RSX_ROP_XA_ONE : 0u;
+    if (!tmask) {
+        if (xcls) p.rop = (0xFu << RSX_ROP_XA_T_SHIFT) | xa_value;
+        return p;
+    }
+    const uint32_t ken = (tmask & 1u) | ((tmask & 0xEu) << (RSX_ROP_KEY_MRT_SHIFT - 1));
+    const uint32_t r8 = (cfg->round8 && is8) ? RSX_ROP_ROUND8 : 0u;
+    if (in->sfactor == 0u && in->dfactor == 0u) {
+        /* Factors never programmed: the legacy straight alpha (dbgfont-style
+         * text enables blending without setting factors). */
+        p.notes |= RSX_ROP_NOTE_LEGACY_SA;
+        p.key = ken | ((uint32_t)RSX_ROP_D3D_SRC_ALPHA << 1) | ((uint32_t)RSX_ROP_D3D_INV_SRC_ALPHA << 6)
+                    | ((uint32_t)RSX_ROP_D3D_ONE << 11) | ((uint32_t)RSX_ROP_D3D_INV_SRC_ALPHA << 16)
+                    | ((uint32_t)RSX_ROP_D3D_OP_ADD << 21) | ((uint32_t)RSX_ROP_D3D_OP_ADD << 24);
+        p.rop = r8;
+        return p;
+    }
+    uint32_t fsc = rsx_rop_factor_d3d(in->sfactor,       0, cfg->alpha_factor, &p.bad_factor);
+    uint32_t fdc = rsx_rop_factor_d3d(in->dfactor,       0, cfg->alpha_factor, &p.bad_factor);
+    uint32_t fsa = rsx_rop_factor_d3d(in->sfactor >> 16, 1, cfg->alpha_factor, &p.bad_factor);
+    uint32_t fda = rsx_rop_factor_d3d(in->dfactor >> 16, 1, cfg->alpha_factor, &p.bad_factor);
+    if (p.bad_factor) p.notes |= RSX_ROP_NOTE_FACTOR_UNKNOWN;
+    {   /* one D3D blend factor: CONSTANT_COLOR and CONSTANT_ALPHA in the RGB
+         * factors at once need ALPHA_FACTOR (title: 0x41B17C, 0x41A9C0) */
+        const uint32_t sc = in->sfactor & 0xFFFFu, dc = in->dfactor & 0xFFFFu;
+        const int cc = sc == 0x8001u || sc == 0x8002u || dc == 0x8001u || dc == 0x8002u;
+        const int ca = sc == 0x8003u || sc == 0x8004u || dc == 0x8003u || dc == 0x8004u;
+        if (cc && ca && !cfg->alpha_factor) p.notes |= RSX_ROP_NOTE_KCONFLICT;
+    }
+    int sgc, sga, igc, iga;
+    uint32_t opc = rsx_rop_eq_d3d(in->equation,       is8, cfg, &sgc, &igc, &p.notes, &p.bad_eq);
+    uint32_t opa = rsx_rop_eq_d3d(in->equation >> 16, is8, cfg, &sga, &iga, &p.notes, &p.bad_eq);
+    if (igc) fsc = fdc = RSX_ROP_D3D_ONE;
+    if (iga) fsa = fda = RSX_ROP_D3D_ONE;
+    uint32_t rop = r8;
+    if (xcls) {
+        fsc = rsx_rop_xrgb_rgb_factor(fsc);
+        fdc = rsx_rop_xrgb_rgb_factor(fdc);
+        sga = 0;
+        const int refs = fsc == RSX_ROP_D3D_SRC_ALPHA || fsc == RSX_ROP_D3D_INV_SRC_ALPHA ||
+                         fdc == RSX_ROP_D3D_SRC_ALPHA || fdc == RSX_ROP_D3D_INV_SRC_ALPHA;
+        opa = RSX_ROP_D3D_OP_ADD;
+        if (!refs) {            /* the shader exports the X value; the blend passes it */
+            fsa = RSX_ROP_D3D_ONE; fda = RSX_ROP_D3D_ZERO;
+            rop |= (0xFu << RSX_ROP_XA_T_SHIFT) | xa_value;
+        } else {                /* the RGB blend needs the shader's alpha */
+            fsa = RSX_ROP_D3D_ZERO; fda = (xcls == 2) ? RSX_ROP_D3D_ONE : RSX_ROP_D3D_ZERO;
+            if (xcls == 2) p.notes |= RSX_ROP_NOTE_XRGB_KEEPDST;
+            rop |= ((~tmask & 0xFu) << RSX_ROP_XA_T_SHIFT) | xa_value;
+        }
+    }
+    p.key = ken | (fsc << 1) | (fdc << 6) | (fsa << 11) | (fda << 16) | (opc << 21) | (opa << 24)
+              | (sgc ? RSX_ROP_KEY_SGN_RGB : 0u) | (sga ? RSX_ROP_KEY_SGN_A : 0u);
+    if (sgc || sga) {
+        p.notes |= RSX_ROP_NOTE_SIGNED;
+        rop |= RSX_ROP_PASS_P | (sgc ? RSX_ROP_SGN_RGB : 0u) | (sga ? RSX_ROP_SGN_A : 0u)
+             | (tmask << RSX_ROP_SGN_T_SHIFT);
+    }
+    p.rop = rop;
+    return p;
+}
+
+/* ---- the shader epilogue ---------------------------------------------------
+ * Patches the decompiler's final "    return <expr>;\n}\n" (as the alpha-test
+ * and sRGB patches do; run it after both: sRGB -> round8 -> blend operands).
+ * Per target in the variant: round to 8 bits (floor(x*255 + 0.5)); the signed
+ * pass transform on the signed channels; the forced X alpha. Returns 1 when
+ * patched, 0 when the variant needs no code, -1 when the tail is not
+ * patchable or the buffer is too small. */
+static inline int rsx_rop_apply_epilogue(char* hlsl, size_t out_size, uint32_t rop)
+{
+    if (!hlsl || !out_size) return -1;
+    const int pass = rsx_rop_pass(rop);
+    if (!(rop & (RSX_ROP_ROUND8 | (0xFu << RSX_ROP_XA_T_SHIFT))) && !pass) return 0;
+    char* marker = NULL;
+    for (char* q = strstr(hlsl, "    return "); q; q = strstr(q + 1, "    return ")) marker = q;
+    if (!marker) return -1;
+    char* expr = marker + strlen("    return ");
+    char* term = strstr(expr, ";\n}\n");
+    if (!term || term == expr || (size_t)(term - expr) >= 96) return -1;
+    char output[96];
+    memcpy(output, expr, (size_t)(term - expr));
+    output[term - expr] = '\0';
+    const int mrt = strstr(hlsl, "struct PSOutput") != NULL;
+    uint32_t targets = 1;
+    if (mrt) {
+        targets = 0;
+        for (uint32_t t = 0; t < 4u; t++) {
+            char member[48];
+            snprintf(member, sizeof member, "    float4 t%u : SV_TARGET%u;\n", t, t);
+            if (strstr(hlsl, member)) targets = t + 1;
+        }
+        if (!targets) return -1;
+    }
+    char suffix[3072];
+    int n = snprintf(suffix, sizeof suffix, "    %s _rsx_rop = %s;\n", mrt ? "PSOutput" : "float4", output);
+    int any = 0;
+    for (uint32_t t = 0; t < targets && n > 0 && (size_t)n < sizeof suffix; t++) {
+        const int sg = pass && ((rop >> (RSX_ROP_SGN_T_SHIFT + t)) & 1u);
+        const int xa = (int)((rop >> (RSX_ROP_XA_T_SHIFT + t)) & 1u);
+        const int q8 = (rop & RSX_ROP_ROUND8) || sg;
+        if (!sg && !xa && !q8) continue;
+        any = 1;
+        char lane[8] = "";
+        if (mrt) snprintf(lane, sizeof lane, ".t%u", t);
+        n += snprintf(suffix + n, sizeof suffix - (size_t)n, "    { float4 _c = _rsx_rop%s;\n", lane);
+        if (q8)
+            n += snprintf(suffix + n, sizeof suffix - (size_t)n,
+                          "      _c = floor(saturate(_c) * 255.0 + 0.5) / 255.0;\n");
+        if (sg)
+            n += snprintf(suffix + n, sizeof suffix - (size_t)n,
+                          "      { const float4 _u = floor(_c * 255.0 + 0.5);\n"
+                          "        const float4 _s = _u - 256.0 * (float4)(_u >= 128.0);\n"
+                          "        const float4 _t = max(%s_s, 0.0) / 255.0;\n"
+                          "%s%s"
+                          "      }\n",
+                          pass == 2 ? "-" : "",
+                          (rop & RSX_ROP_SGN_RGB) ? "        _c.rgb = _t.rgb;\n" : "",
+                          (rop & RSX_ROP_SGN_A) ? "        _c.a = _t.a;\n" : "");
+        if (xa)
+            n += snprintf(suffix + n, sizeof suffix - (size_t)n, "      _c.a = %s;\n",
+                          (rop & RSX_ROP_XA_ONE) ? "1.0" : "0.0");
+        n += snprintf(suffix + n, sizeof suffix - (size_t)n, "      _rsx_rop%s = _c; }\n", lane);
+    }
+    if (!any) return 0;
+    if (n > 0 && (size_t)n < sizeof suffix)
+        n += snprintf(suffix + n, sizeof suffix - (size_t)n, "    return _rsx_rop;\n}\n");
+    if (n < 0 || (size_t)n >= sizeof suffix) return -1;
+    const size_t prefix = (size_t)(marker - hlsl);
+    if (prefix + (size_t)n + 1 > out_size) return -1;
+    memcpy(marker, suffix, (size_t)n + 1);
+    return 1;
+}
+
+/* ---- D3D12 half ------------------------------------------------------------ */
+#ifdef __d3d12_h__
+_Static_assert((int)D3D12_BLEND_ZERO == (int)RSX_ROP_D3D_ZERO && (int)D3D12_BLEND_ONE == (int)RSX_ROP_D3D_ONE &&
+               (int)D3D12_BLEND_SRC_ALPHA == (int)RSX_ROP_D3D_SRC_ALPHA &&
+               (int)D3D12_BLEND_INV_DEST_ALPHA == (int)RSX_ROP_D3D_INV_DEST_ALPHA &&
+               (int)D3D12_BLEND_SRC_ALPHA_SAT == (int)RSX_ROP_D3D_SRC_ALPHA_SAT &&
+               (int)D3D12_BLEND_BLEND_FACTOR == (int)RSX_ROP_D3D_BLEND_FACTOR &&
+               (int)D3D12_BLEND_INV_BLEND_FACTOR == (int)RSX_ROP_D3D_INV_BLEND_FACTOR &&
+               (int)D3D12_BLEND_ALPHA_FACTOR == (int)RSX_ROP_D3D_ALPHA_FACTOR &&
+               (int)D3D12_BLEND_INV_ALPHA_FACTOR == (int)RSX_ROP_D3D_INV_ALPHA_FACTOR,
+               "D3D12_BLEND values");
+_Static_assert((int)D3D12_BLEND_OP_ADD == (int)RSX_ROP_D3D_OP_ADD &&
+               (int)D3D12_BLEND_OP_REV_SUBTRACT == (int)RSX_ROP_D3D_OP_REV_SUBTRACT &&
+               (int)D3D12_BLEND_OP_MAX == (int)RSX_ROP_D3D_OP_MAX, "D3D12_BLEND_OP values");
+
+/* The PSO blend state for a key, a rop word, nrt targets and the D3D write
+ * masks (one nibble per target). The negative pass of a signed draw swaps
+ * ADD and REV_SUBTRACT on the signed groups and writes only those channels of
+ * the blended targets. */
+static inline void rsx_rop_fill_blend(D3D12_BLEND_DESC* bd, uint32_t key, uint32_t rop, int nrt, uint32_t wcmask)
+{
+    if (nrt < 1) nrt = 1;
+    if (nrt > 8) nrt = 8;
+    const int neg = rsx_rop_pass(rop) == 2;
+    uint32_t opc = (key >> 21) & 7u, opa = (key >> 24) & 7u;
+    if (neg) {
+        if (key & RSX_ROP_KEY_SGN_RGB)
+            opc = opc == RSX_ROP_D3D_OP_ADD ? RSX_ROP_D3D_OP_REV_SUBTRACT : RSX_ROP_D3D_OP_ADD;
+        if (key & RSX_ROP_KEY_SGN_A)
+            opa = opa == RSX_ROP_D3D_OP_ADD ? RSX_ROP_D3D_OP_REV_SUBTRACT : RSX_ROP_D3D_OP_ADD;
+    }
+    const UINT8 gmask = (UINT8)(((key & RSX_ROP_KEY_SGN_RGB) ? 7u : 0u) | ((key & RSX_ROP_KEY_SGN_A) ? 8u : 0u));
+    bd->AlphaToCoverageEnable = FALSE;
+    bd->IndependentBlendEnable = nrt > 1 ? TRUE : FALSE;
+    for (int r = 0; r < nrt; r++) {
+        D3D12_RENDER_TARGET_BLEND_DESC* d = &bd->RenderTarget[r];
+        const int en = r < 4 && rsx_rop_key_target_blends(key, r);
+        d->BlendEnable = en ? TRUE : FALSE;
+        d->LogicOpEnable = FALSE;
+        d->SrcBlend       = en ? (D3D12_BLEND)((key >> 1) & 0x1Fu)  : D3D12_BLEND_ONE;
+        d->DestBlend      = en ? (D3D12_BLEND)((key >> 6) & 0x1Fu)  : D3D12_BLEND_ZERO;
+        d->BlendOp        = en ? (D3D12_BLEND_OP)opc                : D3D12_BLEND_OP_ADD;
+        d->SrcBlendAlpha  = en ? (D3D12_BLEND)((key >> 11) & 0x1Fu) : D3D12_BLEND_ONE;
+        d->DestBlendAlpha = en ? (D3D12_BLEND)((key >> 16) & 0x1Fu) : D3D12_BLEND_ZERO;
+        d->BlendOpAlpha   = en ? (D3D12_BLEND_OP)opa                : D3D12_BLEND_OP_ADD;
+        UINT8 m = (UINT8)((wcmask >> (4 * r)) & 0xFu);
+        if (neg) m = en ? (UINT8)(m & gmask) : (UINT8)0;
+        d->RenderTargetWriteMask = m;
+    }
+}
+
+/* Depth/stencil of a signed draw's two passes (rop: pass P or N; anything
+ * else leaves ds alone). A fragment gets its positive part in pass P or its
+ * negative part in pass N, never both, so the passes commute; what matters is
+ * that both see the coverage the guest's state gives and that the depth and
+ * stencil buffers are updated once:
+ *  - pass P: the guest's depth test and depth writes (an occlusion count taken
+ *    around the draw counts it), no stencil writes;
+ *  - pass N: no depth writes; the guest's stencil test and ops, against the
+ *    stencil pass P left untouched; the guest's depth test, except where pass
+ *    P wrote the fragment's own depth: LESS -> LESS_EQUAL, GREATER ->
+ *    GREATER_EQUAL, NOT_EQUAL -> ALWAYS (after P every tested fragment equals
+ *    the stored depth; ALWAYS is wrong only where it already did before P).
+ * Exact for primitives that do not overlap within the draw. */
+static inline void rsx_rop_fill_ds(D3D12_DEPTH_STENCIL_DESC* ds, uint32_t rop)
+{
+    const int pass = rsx_rop_pass(rop);
+    if (pass == 1) {
+        ds->StencilWriteMask = 0;
+    } else if (pass == 2) {
+        if (ds->DepthEnable && ds->DepthWriteMask != D3D12_DEPTH_WRITE_MASK_ZERO) {
+            if (ds->DepthFunc == D3D12_COMPARISON_FUNC_LESS) ds->DepthFunc = D3D12_COMPARISON_FUNC_LESS_EQUAL;
+            else if (ds->DepthFunc == D3D12_COMPARISON_FUNC_GREATER) ds->DepthFunc = D3D12_COMPARISON_FUNC_GREATER_EQUAL;
+            else if (ds->DepthFunc == D3D12_COMPARISON_FUNC_NOT_EQUAL) ds->DepthFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+        }
+        ds->DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ZERO;
+    }
+}
+#endif /* __d3d12_h__ */
+
+#endif /* RSX_ROP_H */
diff --git a/libs/video/rsx_rt_oracle.h b/libs/video/rsx_rt_oracle.h
new file mode 100644
index 0000000..255039b
--- /dev/null
+++ b/libs/video/rsx_rt_oracle.h
@@ -0,0 +1,223 @@
+/* rsx_rt_oracle.h -- R1's stream oracle (diagnostic; included by rsx_d3d12_backend.c).
+ *
+ * RT_STREAM_LOG=<file>[,<n>]: the frame command list goes through a hashing pass-through proxy
+ * (rsx_rt_oracle_gen.h, generated from the SDK's vtable): every command-list call -- its method and arguments --
+ * and the descriptor writes made by the thread recording the list (CreateShaderResourceView, CopyDescriptorsSimple,
+ * CreateSampler at the hot sites, rth_desc) are mixed into the batch's hash, which is written at the list's
+ * Close: "<load> <seq> <reason> <records> <calls> <hash> <unhashed> <outside>". Pointers (interfaces, CPU / GPU
+ * descriptor handles, GPU virtual addresses) are named by the order of their first sighting since the last
+ * save-state load, so two runs that issue the same calls from the same state hash alike whatever the
+ * allocator's addresses; the first <n> batches (default 48) after each load are logged. The post-load frames
+ * are deterministic run to run (CELLMARK identity), so the same scene from the same state compares across
+ * builds and modes -- the pre-R1 exe built with this oracle, RENDER_THREAD=0 and RENDER_THREAD=1.
+ * "outside": descriptor writes by a thread that was not recording the list at the time (0 expected).
+ * Off: the proxy is not installed and each hook is one branch. */
+#include <stdint.h>
+static struct {
+    int on;                    /* -1 unknown, 0 off, 1 on */
+    FILE* f;
+    unsigned nmax;
+    unsigned long long h;      /* the open list's hash */
+    unsigned calls, unhashed, outside, seq;
+    unsigned long long loads;
+    DWORD owner;               /* the thread that made the latest list call */
+    const char* why;
+    unsigned rec;
+    uintptr_t* key;            /* canonical names: open addressing, 1 << 20 entries */
+    unsigned* val;
+    unsigned n, full;
+} s_rth = { -1 };
+#define RTH_CAP (1u << 20)
+static inline void rth_mixv(unsigned long long v)
+{
+    unsigned long long h = s_rth.h ^ v;
+    h *= 0x9E3779B97F4A7C15ull; h ^= h >> 29; h *= 0xBF58476D1CE4E5B9ull; h ^= h >> 32;
+    s_rth.h = h;
+}
+static void rth_u64(unsigned long long v) { rth_mixv(v); }
+static void rth_bytes(const void* p, size_t n)
+{
+    if (!p) { rth_mixv(0xA5A5ull); return; }
+    const unsigned char* b = (const unsigned char*)p;
+    unsigned long long acc = 0; size_t i = 0;
+    for (; i + 8 <= n; i += 8) { memcpy(&acc, b + i, 8); rth_mixv(acc); }
+    acc = 0; if (i < n) { memcpy(&acc, b + i, n - i); rth_mixv(acc ^ ((unsigned long long)(n - i) << 56)); }
+}
+static void rth_dump_canon(uintptr_t k, unsigned id);
+/* names: objects (kind 0), GPU virtual addresses (1), CPU (2) and GPU (3) descriptor handles -- separate spaces */
+static void rth_canon_k(uintptr_t k, unsigned kind);
+/* An object (ID3D12Resource, pipeline, heap, root signature...) is named by a number kept in its own private
+ * data (the load's generation and the order of first sighting since it): an address the allocator gives a new
+ * object after an old one was released is a new name, as it should be. */
+static const GUID s_rth_guid = { 0x7c1d5a31, 0x2e4b, 0x4f6a, { 0x9b, 0x52, 0x31, 0x52, 0x54, 0x48, 0x4e, 0x31 } };
+static unsigned s_rth_oid;
+static void rth_canon(const void* p)
+{
+    if (!p) { rth_mixv(0); return; }
+    ID3D12Object* o = (ID3D12Object*)(uintptr_t)p;
+    struct { unsigned long long gen; unsigned id, pad; } v; UINT sz = sizeof v;
+    if (FAILED(o->lpVtbl->GetPrivateData(o, &s_rth_guid, &sz, &v)) || sz != sizeof v || v.gen != s_rth.loads + 1u) {
+        v.gen = s_rth.loads + 1u; v.id = ++s_rth_oid; v.pad = 0;
+        o->lpVtbl->SetPrivateData(o, &s_rth_guid, sizeof v, &v);
+    }
+    rth_mixv(0x200000000ull | v.id);
+    rth_dump_canon((uintptr_t)p, v.id);
+}
+#define rth_va(x)   rth_canon_k((uintptr_t)(x), 1)
+#define rth_hcpu(x) rth_canon_k((uintptr_t)(x), 2)
+#define rth_hgpu(x) rth_canon_k((uintptr_t)(x), 3)
+/* GPU addresses inside the per-batch streams (vp_vb's two halves and its vertex cache, vp_ib, vp_cb, vp_fpcb):
+ * named by (buffer, offset) with the halves taken relative to the batch's parity -- which half a batch uses
+ * depends on how many batches ran before the load, so two runs' same batches would differ only by it. */
+static struct { uintptr_t base; unsigned long long half, size; } s_rthb[4];
+static int s_rthb_n, s_rth_par;
+static int s_rth_halves = 0;   /* off: the arena view and a half's view share an address at parity 0 -- compare
+                                * runs whose first batch after the load had the same parity and frame index */
+static void rth_canon_k(uintptr_t k, unsigned kind)
+{
+    if (kind == 1 && k && s_rth_halves)
+        for (int b = 0; b < s_rthb_n; b++)
+            if (k >= s_rthb[b].base && k - s_rthb[b].base < s_rthb[b].size) {
+                unsigned long long off = k - s_rthb[b].base;
+                if (s_rth_par && off < 2 * s_rthb[b].half) off = off < s_rthb[b].half ? off + s_rthb[b].half : off - s_rthb[b].half;
+                rth_mixv(0xB00000000ull | (unsigned)b); rth_mixv(off);
+                return;
+            }
+    if (k) k ^= (uintptr_t)kind << 58;
+    if (!k) { rth_mixv(0); return; }
+    if (s_rth.full) { rth_mixv(0xFFFFFFFFull); return; }
+    unsigned i = (unsigned)((k * 0x9E3779B97F4A7C15ull) >> 44) & (RTH_CAP - 1u);
+    while (s_rth.key[i] && s_rth.key[i] != k) i = (i + 1u) & (RTH_CAP - 1u);
+    if (!s_rth.key[i]) {
+        if (s_rth.n >= RTH_CAP / 2u) { s_rth.full = 1; rth_mixv(0xFFFFFFFFull); return; }
+        s_rth.key[i] = k; s_rth.val[i] = ++s_rth.n;
+    }
+    rth_mixv(0x100000000ull | s_rth.val[i]);
+    rth_dump_canon(k, s_rth.val[i]);
+}
+static void rth_barrier(const D3D12_RESOURCE_BARRIER* b)
+{
+    rth_mixv(((unsigned long long)b->Type << 8) | (unsigned long long)b->Flags);
+    if (b->Type == D3D12_RESOURCE_BARRIER_TYPE_TRANSITION) {
+        rth_canon(b->Transition.pResource); rth_mixv(b->Transition.Subresource);
+        rth_mixv(((unsigned long long)b->Transition.StateBefore << 32) | (unsigned)b->Transition.StateAfter);
+    } else if (b->Type == D3D12_RESOURCE_BARRIER_TYPE_ALIASING) {
+        rth_canon(b->Aliasing.pResourceBefore); rth_canon(b->Aliasing.pResourceAfter);
+    } else rth_canon(b->UAV.pResource);
+}
+static void rth_copyloc(const D3D12_TEXTURE_COPY_LOCATION* l)
+{
+    if (!l) { rth_mixv(0); return; }
+    rth_canon(l->pResource); rth_mixv((unsigned long long)l->Type);
+    if (l->Type == D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX) rth_mixv(l->SubresourceIndex);
+    else {
+        const D3D12_PLACED_SUBRESOURCE_FOOTPRINT* p = &l->PlacedFootprint;
+        rth_mixv(p->Offset); rth_mixv((unsigned long long)p->Footprint.Format);
+        rth_mixv(((unsigned long long)p->Footprint.Width << 32) | p->Footprint.Height);
+        rth_mixv(((unsigned long long)p->Footprint.Depth << 32) | p->Footprint.RowPitch);
+    }
+}
+/* RT_STREAM_DUMP=<load>:<seq>:<file> (debug): every call of that batch -- its index, the previous call's method,
+ * the hash after it -- to find where two streams part. */
+static FILE* s_rth_dump; static unsigned long long s_rth_dl; static unsigned s_rth_ds; static int s_rth_pm;
+static void rth_dump_canon(uintptr_t k, unsigned id)
+{
+    if (s_rth_dump && s_rth.loads == s_rth_dl && s_rth.seq == s_rth_ds)
+        fprintf(s_rth_dump, "  canon %llX -> %u%c", (unsigned long long)k, id, 10);
+}
+static void rth_call(int m)
+{
+    s_rth.owner = GetCurrentThreadId();
+    if (s_rth_dump && s_rth.loads == s_rth_dl && s_rth.seq == s_rth_ds)
+        fprintf(s_rth_dump, "%u %d %016llX%c", s_rth.calls, s_rth_pm, s_rth.h, 10);
+    s_rth_pm = m;
+    s_rth.calls++; rth_mixv(0xC0000000ull | (unsigned)m);
+}
+static void rth_unhashed(int m) { (void)m; s_rth.unhashed++; }
+static void rth_reset(void) { s_rth.h = 0x5EEDull; s_rth.calls = 1; s_rth.unhashed = 0; s_rth.outside = 0; }
+static void rth_close(void)
+{
+    if (s_rth.seq < s_rth.nmax)
+        fprintf(s_rth.f, "%llu %u %s %u %u %016llX %u %u p%d f%u\n", s_rth.loads, s_rth.seq, s_rth.why ? s_rth.why : "?",
+                s_rth.rec, s_rth.calls, s_rth.h, s_rth.unhashed, s_rth.outside, s_rth_par, s_d3d.frame_index);
+    if (s_rth_dump && s_rth.loads == s_rth_dl && s_rth.seq == s_rth_ds) {
+        fprintf(s_rth_dump, "close %016llX%c", s_rth.h, 10);
+        fclose(s_rth_dump); s_rth_dump = NULL;
+    }
+    s_rth.seq++;
+    if ((s_rth.seq & 15u) == 0) fflush(s_rth.f);
+}
+#include "rsx_rt_oracle_gen.h"
+static RthList s_rth_list;
+static int rth_on(void)
+{
+    if (s_rth.on >= 0) return s_rth.on;
+    s_rth.on = 0;
+    const char* e = getenv("RT_STREAM_LOG");
+    if (!e || !*e || (e[0] == '0' && !e[1])) return 0;
+    char path[MAX_PATH]; snprintf(path, sizeof path, "%s", e);
+    char* c = strrchr(path, ',');
+    s_rth.nmax = 48;
+    if (c && c > path + 2) { s_rth.nmax = (unsigned)atoi(c + 1); *c = 0; }
+    s_rth.key = (uintptr_t*)calloc(RTH_CAP, sizeof(uintptr_t));
+    s_rth.val = (unsigned*)calloc(RTH_CAP, sizeof(unsigned));
+    s_rth.f = (s_rth.key && s_rth.val) ? fopen(path, "w") : NULL;
+    if (!s_rth.f) { fprintf(stderr, "[RTSTREAM] cannot write %s -- off%c", path, 10); return 0; }
+    fprintf(stderr, "[RTSTREAM] command stream hashes -> %s (%u batches after each load)%c", path, s_rth.nmax, 10);
+    { const char* d = getenv("RT_STREAM_DUMP"); char fn[MAX_PATH]; unsigned long long dl = 0; unsigned ds = 0;
+      if (d && sscanf(d, "%llu:%u:%259s", &dl, &ds, fn) == 3) { s_rth_dump = fopen(fn, "w"); s_rth_dl = dl; s_rth_ds = ds; } }
+    s_rth.on = 1;
+    return 1;
+}
+static ID3D12GraphicsCommandList* rth_wrap(ID3D12GraphicsCommandList* real)
+{
+    if (!real || !rth_on()) return real;
+    s_rth_list.lpVtbl = &rth_vtbl; s_rth_list.real = real;
+    return (ID3D12GraphicsCommandList*)&s_rth_list;
+}
+static ID3D12GraphicsCommandList* rth_real(ID3D12GraphicsCommandList* l)
+{
+    return (l == (ID3D12GraphicsCommandList*)&s_rth_list) ? s_rth_list.real : l;
+}
+/* render_frame (the walker): the batch about to be recorded */
+static void rth_batch(const char* why, unsigned records)
+{
+    if (s_rth.on <= 0) return;
+    s_rth.why = why; s_rth.rec = records;
