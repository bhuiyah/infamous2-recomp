+static ovl_nav key_nav(int vk, int shift, int ctrl, int* ok)
+{
+    *ok = 1;
+    switch (vk) {
+    case VK_UP:     return OVL_NAV_UP;
+    case VK_DOWN:   return OVL_NAV_DOWN;
+    case VK_LEFT:   return shift ? OVL_NAV_LEFT_BIG : OVL_NAV_LEFT;
+    case VK_RIGHT:  return shift ? OVL_NAV_RIGHT_BIG : OVL_NAV_RIGHT;
+    case VK_RETURN: case VK_SPACE: return OVL_NAV_ACCEPT;
+    case VK_ESCAPE: case VK_BACK:  return OVL_NAV_BACK;
+    case VK_TAB:    return shift ? OVL_NAV_TAB_PREV : OVL_NAV_TAB_NEXT;
+    case 'Q':       return ctrl ? OVL_NAV_QUIT : OVL_NAV_TAB_PREV;
+    case 'E':       return OVL_NAV_TAB_NEXT;
+    case VK_PRIOR:  return ctrl ? OVL_NAV_TAB_PREV : OVL_NAV_PAGE_UP;
+    case VK_NEXT:   return ctrl ? OVL_NAV_TAB_NEXT : OVL_NAV_PAGE_DOWN;
+    case VK_HOME:   return OVL_NAV_HOME;
+    case VK_END:    return OVL_NAV_END;
+    case 'R': case VK_DELETE: return OVL_NAV_RESET;
+    default: *ok = 0; return OVL_NAV_UP;
+    }
+}
+
+/* the canvas origin in client coordinates (fallback host: the picture) */
+static int s_canvas_x, s_canvas_y;
+
+static void handle_events(double t)
+{
+    ovl_ev e;
+    while (pop_ev(&e)) {
+        if (!s_open) continue;
+        int act = OVL_ACT_NONE;
+        s_menu.now = t;
+        switch (e.type) {
+        case EV_KEY: {
+            int ok;
+            const ovl_nav nv = key_nav(e.a, e.c & 1, e.c & 2, &ok);
+            if (!ok) break;
+            if (e.b && (nv == OVL_NAV_ACCEPT || nv == OVL_NAV_BACK || nv == OVL_NAV_RESET || nv == OVL_NAV_QUIT))
+                break;                                                                          /* no auto-repeat */
+            act = ovl_menu_nav(&s_menu, nv, 0);
+            break;
+        }
+        case EV_MOVE:   act = ovl_menu_mouse_move(&s_menu, e.a - s_canvas_x, e.b - s_canvas_y); break;
+        case EV_BUTTON: act = ovl_menu_mouse_button(&s_menu, e.c, e.d, e.a - s_canvas_x, e.b - s_canvas_y); break;
+        case EV_WHEEL:  act = ovl_menu_mouse_wheel(&s_menu, e.c, e.a - s_canvas_x, e.b - s_canvas_y); break;
+        case EV_LEAVE:  ovl_menu_mouse_leave(&s_menu); break;
+        }
+        handle_act(act);
+    }
+}
+
+/* FPS counter text from the presents of the last second; 1 when it changed. */
+static int osd_text(double t, int mode, char* l1, size_t n1, char* l2, size_t n2)
+{
+    static LARGE_INTEGER f;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    LARGE_INTEGER c;
+    QueryPerformanceCounter(&c);
+    (void)t;
+    const LONG n = s_pres_n;
+    int cnt = 0;
+    LONG64 prev = 0, maxgap = 0, first = 0, last = 0;
+    for (int k = 0; k < 255 && k < n; k++) {
+        const LONG64 ts = s_pres_t[(n - k) & 255];
+        if (!ts || c.QuadPart - ts > f.QuadPart) break;
+        if (!last) last = ts;
+        if (prev && prev - ts > maxgap) maxgap = prev - ts;
+        prev = ts;
+        first = ts;
+        cnt++;
+    }
+    char a[64], b[96];
+    if (cnt >= 2) {
+        const double span = (double)(last - first) / (double)f.QuadPart;
+        const double fps = (cnt - 1) / (span > 1e-6 ? span : 1e-6);
+        snprintf(a, sizeof a, "%.0f FPS", fps);
+        snprintf(b, sizeof b, "%.1f ms avg \xC2\xB7 %.1f ms max", 1000.0 / fps, (double)maxgap * 1000.0 / (double)f.QuadPart);
+    } else {
+        snprintf(a, sizeof a, "-- FPS");
+        snprintf(b, sizeof b, "no frames presented");
+    }
+    if (mode < 2) b[0] = 0;
+    const int changed = strcmp(a, l1) || strcmp(b, l2);
+    snprintf(l1, n1, "%s", a);
+    snprintf(l2, n2, "%s", b);
+    return changed;
+}
+
+static DWORD WINAPI ovl_thread(LPVOID unused)
+{
+    (void)unused;
+    /* choose the host */
+    const char* hv = getenv("OVL_HOST");
+    int want_bb = hv && (!strcmp(hv, "backbuffer") || !strcmp(hv, "b"));
+    if (!a_init_queue()) { ovl_logf("D3D12 queue for the overlay failed: no overlay"); InterlockedExchange(&s_thread_state, -1); post_cmd(OVL_CMD_CLOSE, 0); return 1; }
+    int host = 0;
+    if (!want_bb && ovl_dcomp_available()) {
+        RECT rc;
+        GetClientRect(s_top, &rc);
+        int w = rc.right > 0 ? rc.right : 64, h = rc.bottom > 0 ? rc.bottom : 64;
+        if (a_init_chain(w, h) && ovl_gpu_init(&A.gpu, s_dev, DXGI_FORMAT_B8G8R8A8_UNORM)) host = 1;
+        else ovl_logf("composition host unavailable: falling back to the backbuffer");
+    } else if (!want_bb) ovl_logf("dcomp.dll not available: falling back to the backbuffer");
+    if (!host) {
+        if (ovl_gpu_init(&s_gpu_bb, s_dev, DXGI_FORMAT_R8G8B8A8_UNORM)) { host = 2; s_gpu_bb_ok = 1; }
+    }
+    if (!host) { ovl_logf("overlay renderer failed: no overlay"); InterlockedExchange(&s_thread_state, -1); post_cmd(OVL_CMD_CLOSE, 0); return 1; }
+    InterlockedExchange(&s_host, host);
+    ovl_logf("host: %s (thread %lu)", host == 1 ? "DirectComposition over the game window" : "the game's backbuffer (fallback)",
+             (unsigned long)GetCurrentThreadId());
+    InterlockedExchange(&s_thread_state, 2);
+
+    int open_seen = 0, dirty = 1, last_w = 0, last_h = 0, last_cx = -1, last_cy = -1, last_osd = -1;
+    unsigned last_gen = 0;
+    LONG notice_seen = 0;
+    double notice_t0 = 0, notice_until = 0, osd_next = 0, wake_at = 0;
+    char notice[200] = "", o1[64] = "", o2[96] = "";
+    LONG pres_at_hide = 0;
+    int bb_hidden_ok = 1;          /* the backbuffer host: no frame with the overlay on screen any more */
+    for (;;) {
+        DWORD timeout = INFINITE;
+        const double t0 = now_s();
+        if (s_open) timeout = 8;
+        else if (notice_until > t0) timeout = 30;
+        else if (osd_mode()) timeout = osd_next > t0 ? (DWORD)((osd_next - t0) * 1000) + 1 : 1;
+        if (wake_at > t0) { DWORD w2 = (DWORD)((wake_at - t0) * 1000) + 1; if (w2 < timeout) timeout = w2; }
+        if (s_capture_hold && s_host == 2 && !bb_hidden_ok) timeout = 5;
+        WaitForSingleObject(s_wake, timeout);
+        /* the state as it is now, after the wait: a close that woke this wait must be seen in this pass
+         * (read before the wait, it showed only at the next wake -- with nothing else to show, never) */
+        const int open = s_open != 0;
+        const int osd = osd_mode();
+        const double t = now_s();
+        s_menu.now = t;
+
+        /* a new glyph atlas */
+        ovl_font* nf = (ovl_font*)InterlockedExchangePointer((PVOID volatile*)&s_font_ready, NULL);
+        if (nf) {
+            int ok;
+            if (host == 1) { a_wait_idle(); ok = ovl_gpu_set_atlas(&A.gpu, nf, A.q); }
+            else {
+                AcquireSRWLockExclusive(&s_bb_lock);
+                ok = ovl_gpu_set_atlas(&s_gpu_bb, nf, A.q);
+                s_bb_list.nv = 0;
+                s_bb_list.ncmd = 1;
+                s_bb_list.cmd[0].count = 0;
+                ReleaseSRWLockExclusive(&s_bb_lock);
+            }
+            if (ok) { if (s_font) { ovl_font_free(s_font); free(s_font); } s_font = nf; dirty = 1; }
+            else { ovl_font_free(nf); free(nf); }
+        }
+
+        /* open / close */
+        if (open != open_seen) {
+            open_seen = open;
+            dirty = 1;
+            if (open) {
+                memset(&s_pn, 0, sizeof s_pn);
+                s_pn.dir_prev = -1; s_pn.big_prev = -1;
+                fill_env(&s_menu.env, 0);
+                ovl_menu_opened(&s_menu);
+            } else {
+                ovl_menu_mouse_leave(&s_menu);
+                /* input that arrived after the close */
+                ovl_ev e;
+                while (pop_ev(&e)) { }
+            }
+        }
+        if (open) {
+            handle_events(t);
+            ovl_nav nv[8];
+            if (in_front()) {
+                const int n = pad_poll_nav(t, nv, 8);
+                for (int i = 0; i < n; i++) {
+                    if (s_pn.kind != s_menu.env.pad_kind) s_menu.env.pad_kind = s_pn.kind;
+                    handle_act(ovl_menu_nav(&s_menu, nv[i], 1));
+                }
+            } else s_pn.armed = 0;      /* coming back: what is held then does not count */
+            if (s_menu.dirty) dirty = 1;
+            if (wake_at > 0 && t >= wake_at - 0.001) dirty = 1;   /* a tooltip's delay or a message's end passed */
+            const double nw = ovl_menu_next_wake(&s_menu);
+            wake_at = nw > t ? nw : 0;
+            if (s_menu.env.paused != pause_reported()) { s_menu.env.paused = pause_reported(); dirty = 1; }
+        }
+        if (opt_generation() != last_gen) { last_gen = opt_generation(); dirty = 1; }
+
+        /* notices */
+        if (s_notice_seq != notice_seen) {
+            notice_seen = s_notice_seq;
+            AcquireSRWLockShared(&s_notice_lock);
+            snprintf(notice, sizeof notice, "%s", s_notice);
+            const unsigned ms = s_notice_ms;
+            ReleaseSRWLockShared(&s_notice_lock);
+            notice_t0 = t;
+            notice_until = t + (ms ? ms : 2500) / 1000.0;
+            dirty = 1;
+        }
+        const int notice_on = notice_until > t && notice[0];
+        if (notice_until > 0 && !notice_on) { notice_until = 0; dirty = 1; }
+
+        /* FPS counter */
+        if (osd != last_osd) { last_osd = osd; dirty = 1; o1[0] = o2[0] = 0; }
+        if (osd && t >= osd_next) {
+            if (osd_text(t, osd, o1, sizeof o1, o2, sizeof o2)) dirty = 1;
+            osd_next = t + 0.25;
+        }
+
+        int visible = open || osd || notice_on;
+        const int hold = s_capture_hold != 0;
+        if (hold) visible = 0;
+
+        /* geometry */
+        RECT rc;
+        GetClientRect(s_top, &rc);
+        const int cw = rc.right, ch = rc.bottom;
+        const int minimised = IsIconic(s_top) || cw <= 0 || ch <= 0;
+        RECT pic;
+        picture_rect(&pic, cw > 0 ? cw : 1, ch > 0 ? ch : 1);
+        if (cw != last_w || ch != last_h) { last_w = cw; last_h = ch; dirty = 1; }
+
+        if (host == 1) {
+            s_canvas_x = 0; s_canvas_y = 0;
+            if (!visible || minimised) {
+                if (!visible) a_detach();       /* nothing above the game */
+                A.presented = A.presented && visible;
+            } else {
+                const float sc = ovl_menu_scale(cw, ch, window_dpi(), user_scale());
+                want_atlas(sc);
+                if (s_font && (dirty || !A.dcomp) && a_resize(cw, ch)) {
+                    ovl_begin(&s_list, cw, ch, s_font);
+                    const float s = s_font->scale;
+                    if (open) ovl_menu_draw(&s_menu, &s_list, s);
+                    if (osd) {
+                        const float r4[4] = { (float)pic.left, (float)pic.top, (float)pic.right, (float)pic.bottom };
+                        ovl_draw_osd(&s_list, s, s_row_fps_pos >= 0 ? opt_i(s_row_fps_pos) : 0, r4, o1, o2);
+                    }
+                    if (notice_on) {
+                        const double left = notice_until - t;
+                        float al = left < 0.3 ? (float)(left / 0.3) : 1.0f;
+                        if (t - notice_t0 < 0.12) al *= (float)((t - notice_t0) / 0.12);
+                        ovl_draw_notice(&s_list, s, notice, al < 0 ? 0 : al);
+                    }
+                    a_present(&s_list);
+                    if (!A.dcomp) a_attach();
+                    dirty = notice_on;           /* the fade keeps drawing */
+                }
+            }
+            if (hold) {
+                if (A.dcomp) a_detach();
+                InterlockedIncrement(&s_hidden_seq);
+                SetEvent(s_hidden_evt);
+            }
+        } else {
+            /* fallback: the list is drawn by the window thread into the backbuffer; its canvas is the picture */
+            const int pw = pic.right - pic.left, ph = pic.bottom - pic.top;
+            s_canvas_x = pic.left; s_canvas_y = pic.top;
+            if (pic.left != last_cx || pic.top != last_cy) { last_cx = pic.left; last_cy = pic.top; dirty = 1; }
+            if (!visible || minimised || pw <= 0 || ph <= 0) {
+                if (s_bb_visible) { InterlockedExchange(&s_bb_visible, 0); pres_at_hide = s_pres_n; }
+                if (!bb_hidden_ok && s_pres_n - pres_at_hide >= 2) bb_hidden_ok = 1;   /* two frames without it */
+            } else {
+                const float sc = ovl_menu_scale(pw, ph, window_dpi(), user_scale());
+                want_atlas(sc);
+                if (s_font && dirty) {
+                    ovl_begin(&s_list, pw, ph, s_font);
+                    const float s = s_font->scale;
+                    if (open) ovl_menu_draw(&s_menu, &s_list, s);
+                    if (osd) ovl_draw_osd(&s_list, s, s_row_fps_pos >= 0 ? opt_i(s_row_fps_pos) : 0, NULL, o1, o2);
+                    if (notice_on) ovl_draw_notice(&s_list, s, notice, 1.0f);
+                    AcquireSRWLockExclusive(&s_bb_lock);
+                    ovl_list tmp = s_bb_list;                /* swap buffers: no copy */
+                    s_bb_list = s_list;
+                    s_list = tmp;
+                    ReleaseSRWLockExclusive(&s_bb_lock);
+                    InterlockedExchange(&s_bb_visible, 1);
+                    bb_hidden_ok = 0;
+                    dirty = notice_on;
+                }
+            }
+            if (hold && bb_hidden_ok) { InterlockedIncrement(&s_hidden_seq); SetEvent(s_hidden_evt); }
+        }
+    }
+    return 0;
+}
+
+static int start_thread(void)
+{
+    LONG st = InterlockedCompareExchange(&s_thread_state, 1, 0);
+    if (st == 2) return 1;
+    if (st == -1) return 0;
+    if (st == 1) {                       /* another caller is starting it */
+        for (int i = 0; i < 2000 && s_thread_state == 1; i++) Sleep(1);
+        return s_thread_state == 2 || s_thread_state == 1;
+    }
+    s_thread = CreateThread(NULL, 0, ovl_thread, NULL, 0, NULL);
+    if (!s_thread) { InterlockedExchange(&s_thread_state, -1); ovl_logf("could not start the overlay thread"); return 0; }
+    return 1;
+}
+
+/* ---------------------------------------------------------------- open / close (window thread) */
+
+static void ovl_set_open(int on)
+{
+    on = on ? 1 : 0;
+    if (on == (int)s_open) return;
+    if (on) {
+        if (!start_thread()) return;
+        s_was_captured = cellPad_host_mouse_release();
+        options_set_intercepted(1);
+        InterlockedExchange(&s_open, 1);
+        s_mouse_tracked = 0;
+        ovl_logf("options menu open (%s)", pause_reported() ? "the game is told the system has the controller: it pauses"
+                                                            : "pause off: the game keeps running");
+    } else {
+        InterlockedExchange(&s_open, 0);
+        if (GetCapture() == s_top) ReleaseCapture();
+        options_set_intercepted(0);
+        if (s_was_captured) cellPad_host_mouse_capture(s_top);
+        s_was_captured = 0;
+        opt_save();
+        ovl_logf("options menu closed");
+    }
+    if (s_wake) SetEvent(s_wake);
+}
+
+/* cellPad hook, on a guest thread: the PS button (1) or the menu combination (2). */
+static void sys_hook(int port, int what)
+{
+    (void)port;
+    if (s_open || !in_front()) return;    /* open: the overlay thread reads the pad itself */
+    post_cmd(OVL_CMD_PAD, what);
+}
+
+static int mods_down(void)
+{
+    return (GetKeyState(VK_CONTROL) & 0x8000) || (GetKeyState(VK_SHIFT) & 0x8000) || (GetKeyState(VK_MENU) & 0x8000) ||
+           (GetKeyState(VK_LWIN) & 0x8000) || (GetKeyState(VK_RWIN) & 0x8000);
+}
+
+int ovl_wndproc(HWND h, UINT msg, WPARAM wp, LPARAM lp, LRESULT* result)
+{
+    if (!s_installed) return 0;
+    if (s_capture_msg && msg == s_capture_msg) {
+        /* a grabber in another process (tools\kbm_inject.ps1): 1 hide and wait, 0 show again */
+        if (wp) *result = ovl_capture_begin(s_host == 2 ? 0 : 1000);
+        else { ovl_capture_end(); *result = 0; }
+        return 1;
+    }
+    switch (msg) {
+    case WM_APP_OVL:
+        switch ((int)wp) {
+        case OVL_CMD_OPEN:   ovl_set_open(1); break;
+        case OVL_CMD_CLOSE:  ovl_set_open(0); break;
+        case OVL_CMD_TOGGLE: ovl_set_open(!s_open); break;
+        case OVL_CMD_PAD:
+            if (!s_open && in_front()) {
+                if (s_log || lp == 2) ovl_logf("controller %s", lp == 2 ? "shortcut held (L3 + R3)" : "PS / Guide / Home button");
+                ovl_set_open(1);
+            }
+            break;
+        }
+        *result = 0;
+        return 1;
+    case WM_KEYDOWN: case WM_SYSKEYDOWN: {
+        const int vk = (int)wp, rep = (lp & 0x40000000) != 0;
+        if (msg == WM_KEYDOWN && vk == VK_F1 && !mods_down()) {   /* exactly F1: Ctrl+F1 etc. are other keys' */
+            if (!rep) ovl_set_open(!s_open);
+            *result = 0;
+            return 1;
+        }
+        if (!s_open || msg == WM_SYSKEYDOWN || vk == VK_F11) return 0;   /* Alt+Enter, Alt+F4, F11: the window's */
+        const int m = ((GetKeyState(VK_SHIFT) & 0x8000) ? 1 : 0) | ((GetKeyState(VK_CONTROL) & 0x8000) ? 2 : 0);
+        push_ev(EV_KEY, vk, rep, m, 0);
+        *result = 0;
+        return 1;
+    }
+    case WM_KEYUP: case WM_CHAR: case WM_DEADCHAR:
+        if (!s_open) return 0;
+        if (msg == WM_KEYUP && wp == VK_F11) return 0;
+        *result = 0;
+        return 1;
+    case WM_MOUSEMOVE:
+        if (!s_open) return 0;
+        if (!s_mouse_tracked) {
+            TRACKMOUSEEVENT tme = { sizeof tme, TME_LEAVE, h, 0 };
+            s_mouse_tracked = TrackMouseEvent(&tme) ? 1 : 0;
+        }
+        push_ev(EV_MOVE, (short)LOWORD(lp), (short)HIWORD(lp), 0, 0);
+        *result = 0;
+        return 1;
+    case WM_MOUSELEAVE:
+        s_mouse_tracked = 0;
+        if (!s_open) return 0;
+        push_ev(EV_LEAVE, 0, 0, 0, 0);
+        *result = 0;
+        return 1;
+    case WM_LBUTTONDOWN: case WM_LBUTTONUP: case WM_RBUTTONDOWN: case WM_RBUTTONUP:
+    case WM_MBUTTONDOWN: case WM_MBUTTONUP: case WM_XBUTTONDOWN: case WM_XBUTTONUP:
+    case WM_LBUTTONDBLCLK: case WM_RBUTTONDBLCLK: {
+        if (!s_open) return 0;
+        const int down = msg == WM_LBUTTONDOWN || msg == WM_RBUTTONDOWN || msg == WM_LBUTTONDBLCLK ||
+                         msg == WM_RBUTTONDBLCLK || msg == WM_MBUTTONDOWN || msg == WM_XBUTTONDOWN;
+        const int btn = (msg == WM_LBUTTONDOWN || msg == WM_LBUTTONUP || msg == WM_LBUTTONDBLCLK) ? 0
+                      : (msg == WM_RBUTTONDOWN || msg == WM_RBUTTONUP || msg == WM_RBUTTONDBLCLK) ? 1 : 2;
+        if (btn <= 1) {
+            if (down && btn == 0) SetCapture(h);                 /* slider drags past the edge */
+            if (!down && btn == 0 && GetCapture() == h) ReleaseCapture();
+            push_ev(EV_BUTTON, (short)LOWORD(lp), (short)HIWORD(lp), btn, down);
+        }
+        *result = (msg == WM_XBUTTONDOWN || msg == WM_XBUTTONUP) ? TRUE : 0;
+        return 1;
+    }
+    case WM_MOUSEWHEEL: {
+        if (!s_open) return 0;
+        POINT p = { (short)LOWORD(lp), (short)HIWORD(lp) };
+        ScreenToClient(h, &p);
+        push_ev(EV_WHEEL, p.x, p.y, (short)HIWORD(wp), 0);
+        *result = 0;
+        return 1;
+    }
+    case WM_SETCURSOR:
+        if (s_open && LOWORD(lp) == HTCLIENT) { SetCursor(LoadCursor(NULL, IDC_ARROW)); *result = TRUE; return 1; }
+        return 0;
+    case WM_SIZE: case WM_DPICHANGED: case WM_DISPLAYCHANGE: case WM_MOVE:
+        if (s_wake) SetEvent(s_wake);
+        return 0;
+    }
+    return 0;
+}
+
+/* ---------------------------------------------------------------- the backend's hooks */
+
+void ovl_note_present(void)
+{
+    LARGE_INTEGER t;
+    QueryPerformanceCounter(&t);
+    const LONG n = InterlockedIncrement(&s_pres_n);
+    InterlockedExchange64(&s_pres_t[n & 255], t.QuadPart);
+}
+
+int ovl_backbuffer_wanted(void) { return s_host == 2 && s_bb_visible && s_gpu_bb_ok; }
+
+void ovl_backbuffer_pass(ID3D12GraphicsCommandList* cl, D3D12_CPU_DESCRIPTOR_HANDLE rtv, UINT w, UINT h)
+{
+    if (!ovl_backbuffer_wanted()) return;
+    AcquireSRWLockShared(&s_bb_lock);
+    if (s_bb_list.nv) ovl_gpu_record(&s_gpu_bb, cl, &s_bb_list, rtv, 0, 0, (float)w, (float)h);
+    ReleaseSRWLockShared(&s_bb_lock);
+}
+
+int ovl_install(ID3D12Device* dev, HWND top)
+{
+    if (s_installed || !top) return 0;
+    s_dev = dev;
+    s_top = top;
+    s_wnd_tid = GetCurrentThreadId();
+    { const char* e = getenv("OVL_LOG"); s_log = e && *e && *e != '0'; }
+    InitializeCriticalSection(&s_qlock);
+    s_wake = CreateEventA(NULL, FALSE, FALSE, NULL);
+    s_hidden_evt = CreateEventA(NULL, FALSE, FALSE, NULL);
+    s_capture_msg = RegisterWindowMessageA(OVL_CAPTURE_MESSAGE);
+    ovl_menu_init(&s_menu);
+    for (unsigned i = 0; i < sizeof s_rows / sizeof s_rows[0]; i++) opt_register(&s_rows[i]);
+    s_row_fps = opt_find("fps_counter");
+    s_row_fps_pos = opt_find("fps_counter_corner");
+    s_row_scale = opt_find("ui_scale");
+    s_row_combo = opt_find("menu_pad_combo");
+    s_row_pause = opt_find("pause_mode");
+    opt_id ids[] = { s_row_fps, s_row_fps_pos, s_row_scale, s_row_combo };
+    for (unsigned i = 0; i < sizeof ids / sizeof ids[0]; i++)
+        if (ids[i] >= 0) opt_watch(ids[i], rows_changed, NULL, OPT_ON_SETTER);
+    cellPad_kbm_unbind_key(VK_F1);           /* the menu's key is never a game key */
+    cellPad_host_set_system_hook(sys_hook);
+    apply_combo();
+    s_installed = 1;
+    printf("[ovl] options menu: F1, the PS / Guide / Home button%s, or View > Options (nothing is created until "
+           "it first shows)\n", (s_row_combo >= 0 && opt_i(s_row_combo) == 0) ? ", or L3 + R3 held" : "");
+    fflush(stdout);
+    if (osd_mode()) start_thread();          /* the FPS counter from the start */
+    return 1;
+}
+
+/* Tests (libs/video/tests/test_ovl_host.c): the host's state as other threads see it. */
+void ovl_test_state(int* thread_state, int* host, int* composed, int* surface_w, int* surface_h)
+{
+    if (thread_state) *thread_state = (int)s_thread_state;
+    if (host) *host = (int)s_host;
+    if (composed) *composed = A.dcomp != NULL;
+    if (surface_w) *surface_w = A.sc_w;
+    if (surface_h) *surface_h = A.sc_h;
+}
+
+void ovl_shutdown(void)
+{
+    /* The process ends with ExitProcess right after; only stop showing. */
+    if (A.dcomp) { ovl_dcomp_release(A.dcomp); A.dcomp = NULL; }
+}
+
+/* ---------------------------------------------------------------- public API */
+
+static void post_or_call(int cmd)
+{
+    if (!s_installed) return;
+    if (GetCurrentThreadId() == s_wnd_tid) {
+        if (cmd == OVL_CMD_OPEN) ovl_set_open(1);
+        else if (cmd == OVL_CMD_CLOSE) ovl_set_open(0);
+        else ovl_set_open(!s_open);
+    } else post_cmd(cmd, 0);
+}
+
+void ovl_open_options(void)   { post_or_call(OVL_CMD_OPEN); }
+void ovl_toggle_options(void) { post_or_call(OVL_CMD_TOGGLE); }
+int  ovl_options_open(void)   { return s_open != 0; }
+
+int  ovl_get_show_fps(void)   { return osd_mode() != 0; }
+void ovl_set_show_fps(int on)
+{
+    if (s_row_fps < 0) return;
+    opt_set(s_row_fps, on ? "on" : "off");
+}
+
+void ovl_notice(const char* utf8, unsigned ms)
+{
+    if (!s_installed || !utf8) return;
+    AcquireSRWLockExclusive(&s_notice_lock);
+    snprintf(s_notice, sizeof s_notice, "%s", utf8);
+    s_notice_ms = ms;
+    ReleaseSRWLockExclusive(&s_notice_lock);
+    InterlockedIncrement(&s_notice_seq);
+    start_thread();
+    if (s_wake) SetEvent(s_wake);
+}
+
+static void dwm_flush(void)
+{
+    typedef HRESULT (WINAPI *fn_t)(void);
+    static fn_t f = (fn_t)(intptr_t)-1;
+    if (f == (fn_t)(intptr_t)-1) {
+        HMODULE d = LoadLibraryA("dwmapi.dll");
+        f = d ? (fn_t)(void*)GetProcAddress(d, "DwmFlush") : NULL;
+    }
+    if (f) f();
+}
+
+int ovl_capture_begin(unsigned timeout_ms)
+{
+    if (!s_installed) return 0;
+    InterlockedIncrement(&s_capture_hold);
+    if (s_thread_state != 2) return 0;                 /* never shown: nothing to hide */
+    const LONG seq0 = s_hidden_seq;
+    SetEvent(s_wake);
+    const DWORD t0 = GetTickCount();
+    int hidden = 0;
+    while (timeout_ms && GetTickCount() - t0 < timeout_ms) {
+        WaitForSingleObject(s_hidden_evt, 20);
+        if (s_hidden_seq != seq0) { hidden = 1; break; }
+    }
+    if (hidden && s_host == 1) { dwm_flush(); dwm_flush(); }   /* the desktop has recomposed without it */
+    return hidden;
+}
+
+void ovl_capture_end(void)
+{
+    if (!s_installed) return;
+    if (InterlockedDecrement(&s_capture_hold) < 0) InterlockedExchange(&s_capture_hold, 0);
+    if (s_wake) SetEvent(s_wake);
+}
+
+#else /* !_WIN32 */
+
+#include "ps3emu/overlay.h"
+void ovl_open_options(void) {}
+void ovl_toggle_options(void) {}
+int  ovl_options_open(void) { return 0; }
+int  ovl_get_show_fps(void) { return 0; }
+void ovl_set_show_fps(int on) { (void)on; }
+void ovl_notice(const char* utf8, unsigned ms) { (void)utf8; (void)ms; }
+int  ovl_capture_begin(unsigned timeout_ms) { (void)timeout_ms; return 0; }
+void ovl_capture_end(void) {}
+
+#endif /* _WIN32 */
diff --git a/libs/video/ovl.h b/libs/video/ovl.h
new file mode 100644
index 0000000..49c3354
--- /dev/null
+++ b/libs/video/ovl.h
@@ -0,0 +1,56 @@
+/*
+ * ps3recomp - the options overlay: the presenting backend's side
+ * (libs/video/ovl.c; public entry points: include/ps3emu/overlay.h).
+ *
+ * The D3D12 backend calls, all on its window thread (the frame clock / RSX
+ * walker thread):
+ *   ovl_install          once, after the device exists: registers the
+ *                        overlay's settings rows, the controller hook and the
+ *                        menu key; creates nothing else
+ *   ovl_wndproc          first thing in the window procedure (before cellPad):
+ *                        F1, and every key / mouse message while the menu is
+ *                        open; 1 = consumed (*result is the return value)
+ *   ovl_note_present     right after the game's Present (FPS counter clock)
+ *   ovl_backbuffer_*     only for the fallback host (no DirectComposition):
+ *                        draws into the game's backbuffer after the frame
+ *                        dump copy, before the PRESENT barrier
+ *
+ * Hosts. A: DirectComposition -- the overlay's own swap chain at the
+ * window's client size, on its own queue and thread, composed by DWM above
+ * the game's picture; the game's swap chain and its pixels are untouched.
+ * B (fallback, or OVL_HOST=backbuffer): the same draw list squeezed into the
+ * 1280x720 backbuffer; soft text, and it lands in RSX_CAP backbuffer images
+ * while shown (never in CELLMARK_DUMP frames: the copy comes first).
+ *
+ * Environment: OVL_HOST=auto|dcomp|backbuffer (default auto), OVL_LOG=1
+ * (every open / close / host step in the log).
+ */
+#ifndef PS3RECOMP_OVL_H
+#define PS3RECOMP_OVL_H
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <d3d12.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int  ovl_install(ID3D12Device* dev, HWND top);
+int  ovl_wndproc(HWND h, UINT msg, WPARAM wp, LPARAM lp, LRESULT* result);
+void ovl_note_present(void);
+int  ovl_backbuffer_wanted(void);
+void ovl_backbuffer_pass(ID3D12GraphicsCommandList* cl, D3D12_CPU_DESCRIPTOR_HANDLE rtv, UINT w, UINT h);
+void ovl_shutdown(void);
+/* tests: thread state (0 none, 2 running, -1 failed), host (1 composition, 2 backbuffer), DirectComposition
+ * objects present, the composition surface's size */
+void ovl_test_state(int* thread_state, int* host, int* composed, int* surface_w, int* surface_h);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* _WIN32 */
+#endif /* PS3RECOMP_OVL_H */
diff --git a/libs/video/ovl_dcomp.cpp b/libs/video/ovl_dcomp.cpp
new file mode 100644
index 0000000..c75ede4
--- /dev/null
+++ b/libs/video/ovl_dcomp.cpp
@@ -0,0 +1,97 @@
+/*
+ * ps3recomp - the options overlay's DirectComposition attachment (the only
+ * C++ of the overlay: dcomp.h declares overloads and references and has no C
+ * binding). libs/video/ovl.c calls these from the overlay's own thread.
+ *
+ * A DirectComposition target on the game's top-level window with topmost =
+ * TRUE composes its visual ABOVE the window's children -- above the child
+ * "view" window that owns the game's 1280x720 flip swap chain, or above that
+ * chain itself when it sits on the top-level window (display.ini present =
+ * stretch) -- and DWM blends it with premultiplied alpha. The game's swap
+ * chain and its pixels are never touched.
+ *
+ * One topmost target per window: a second CreateTargetForHwnd(topmost) on the
+ * same HWND fails with DCOMPOSITION_ERROR_WINDOW_ALREADY_COMPOSED, so this
+ * module is the window's only composition owner; anything else that wants a
+ * composed layer has to become a visual of this tree.
+ *
+ * dcomp.dll is loaded at run time (Windows 8+): nothing is linked, and a
+ * missing DLL is a logged fallback to the backbuffer host, not a crash. The
+ * device, target and visual exist only while something is shown
+ * (ovl_dcomp_attach .. ovl_dcomp_release): a run that never opens the menu
+ * creates none.
+ */
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <dcomp.h>
+#include <stdio.h>
+
+struct ovl_dcomp {
+    IDCompositionDevice* dev;
+    IDCompositionTarget* target;
+    IDCompositionVisual* visual;
+};
+
+typedef HRESULT (WINAPI *ovl_dcomp_create_fn)(IDXGIDevice*, REFIID, void**);
+
+static ovl_dcomp_create_fn ovl_dcomp_entry(void)
+{
+    static ovl_dcomp_create_fn fn = nullptr;
+    static int tried = 0;
+    if (!tried) {
+        tried = 1;
+        HMODULE m = LoadLibraryA("dcomp.dll");
+        fn = m ? (ovl_dcomp_create_fn)(void*)GetProcAddress(m, "DCompositionCreateDevice") : nullptr;
+    }
+    return fn;
+}
+
+extern "C" int ovl_dcomp_available(void) { return ovl_dcomp_entry() != nullptr; }
+
+/* Device + topmost target on `top` + one visual showing `swapchain`, attached.
+ * Returns the handle, or NULL (logged; *hr_out = the failing HRESULT). */
+extern "C" void* ovl_dcomp_attach(void* top, void* swapchain, long* hr_out)
+{
+    if (hr_out) *hr_out = 0;
+    ovl_dcomp_create_fn create = ovl_dcomp_entry();
+    if (!create) { if (hr_out) *hr_out = (long)E_NOINTERFACE; return nullptr; }
+    ovl_dcomp* d = new ovl_dcomp();
+    HRESULT hr = create(nullptr, __uuidof(IDCompositionDevice), (void**)&d->dev);
+    if (SUCCEEDED(hr)) hr = d->dev->CreateTargetForHwnd((HWND)top, TRUE, &d->target);
+    if (SUCCEEDED(hr)) hr = d->dev->CreateVisual(&d->visual);
+    if (SUCCEEDED(hr)) hr = d->visual->SetContent((IUnknown*)swapchain);
+    if (SUCCEEDED(hr)) hr = d->target->SetRoot(d->visual);
+    if (SUCCEEDED(hr)) hr = d->dev->Commit();
+    if (FAILED(hr)) {
+        if (hr_out) *hr_out = (long)hr;
+        if (d->target) { d->target->SetRoot(nullptr); d->target->Release(); }
+        if (d->visual) d->visual->Release();
+        if (d->dev) { d->dev->Commit(); d->dev->Release(); }
+        delete d;
+        return nullptr;
+    }
+    return d;
+}
+
+/* Detach and free everything: DWM has nothing above the game's swap chain
+ * again (it may go back to independent flip). */
+extern "C" void ovl_dcomp_release(void* p)
+{
+    ovl_dcomp* d = (ovl_dcomp*)p;
+    if (!d) return;
+    if (d->target) { d->target->SetRoot(nullptr); d->dev->Commit(); d->target->Release(); }
+    if (d->visual) d->visual->Release();
+    if (d->dev) d->dev->Release();
+    delete d;
+}
+
+/* Wait until DWM has composed what was committed (for screen grabs). */
+extern "C" void ovl_dcomp_wait_composed(void* p)
+{
+    ovl_dcomp* d = (ovl_dcomp*)p;
+    if (d && d->dev) d->dev->WaitForCommitCompletion();
+}
+#endif /* _WIN32 */
diff --git a/libs/video/ovl_draw.h b/libs/video/ovl_draw.h
new file mode 100644
index 0000000..0a044fd
--- /dev/null
+++ b/libs/video/ovl_draw.h
@@ -0,0 +1,174 @@
+/*
+ * ps3recomp - the options overlay's draw list (header-only, OS-free apart
+ * from the font header's types).
+ *
+ * Everything the overlay draws is a quad with a mode the pixel shader
+ * resolves analytically: rounded rectangles (filled or as a border) from a
+ * signed distance with 1-pixel anti-aliasing, soft shadows, triangles
+ * (arrows) and text glyphs copied 1:1 from the GDI atlas (point sampling at
+ * integer pixel positions). One PSO, one texture, premultiplied alpha, one
+ * DrawInstanced per scissor run (ovl_gpu.h records it).
+ */
+#ifndef PS3RECOMP_OVL_DRAW_H
+#define PS3RECOMP_OVL_DRAW_H
+
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "ovl_font_gdi.h"
+
+enum { OVL_M_RRECT = 0, OVL_M_TEXT = 1, OVL_M_SHADOW = 2, OVL_M_TRI = 3 };
+
+typedef struct {
+    float x, y;          /* pixel position */
+    float u, v;          /* atlas texel coordinates (text) */
+    float lx, ly;        /* position relative to the shape's centre (pixels) */
+    float hx, hy;        /* the shape's half size */
+    float r, g, b, a;    /* premultiplied colour */
+    float radius, border, mode, extra;   /* extra: shadow feather / triangle direction */
+} ovl_vtx;
+
+#define OVL_MAXCMD 128
+typedef struct { int x0, y0, x1, y1; unsigned first, count; } ovl_cmd;
+
+typedef struct {
+    ovl_vtx* v; unsigned nv, cap;
+    ovl_cmd  cmd[OVL_MAXCMD]; int ncmd;
+    const ovl_font* font;
+    int W, H;
+    int oom;             /* an allocation failed: the frame is incomplete */
+} ovl_list;
+
+typedef struct { float r, g, b, a; } ovl_rgba;
+
+static inline ovl_rgba ovl_col(unsigned rgb, float a)   /* 0xRRGGBB, straight alpha -> premultiplied */
+{
+    ovl_rgba c = { ((rgb >> 16) & 255) / 255.0f * a, ((rgb >> 8) & 255) / 255.0f * a, (rgb & 255) / 255.0f * a, a };
+    return c;
+}
+
+static inline void ovl_begin(ovl_list* L, int W, int H, const ovl_font* f)
+{
+    L->nv = 0; L->W = W; L->H = H; L->font = f; L->oom = 0;
+    L->cmd[0].x0 = 0; L->cmd[0].y0 = 0; L->cmd[0].x1 = W; L->cmd[0].y1 = H; L->cmd[0].first = 0; L->cmd[0].count = 0;
+    L->ncmd = 1;
+}
+
+static inline void ovl_list_free(ovl_list* L) { free(L->v); memset(L, 0, sizeof *L); }
+
+static inline void ovl_scissor(ovl_list* L, int x0, int y0, int x1, int y1)
+{
+    if (x0 < 0) x0 = 0;
+    if (y0 < 0) y0 = 0;
+    if (x1 > L->W) x1 = L->W;
+    if (y1 > L->H) y1 = L->H;
+    if (x1 < x0) x1 = x0;
+    if (y1 < y0) y1 = y0;
+    ovl_cmd* c = &L->cmd[L->ncmd - 1];
+    if (c->count == 0) { c->x0 = x0; c->y0 = y0; c->x1 = x1; c->y1 = y1; c->first = L->nv; return; }
+    if (L->ncmd == OVL_MAXCMD) return;
+    c = &L->cmd[L->ncmd++];
+    c->x0 = x0; c->y0 = y0; c->x1 = x1; c->y1 = y1; c->first = L->nv; c->count = 0;
+}
+
+static inline ovl_vtx* ovl_alloc(ovl_list* L, unsigned n)
+{
+    if (L->nv + n > L->cap) {
+        unsigned cap = L->cap ? L->cap * 2 : 8192;
+        while (L->nv + n > cap) cap *= 2;
+        ovl_vtx* nvp = (ovl_vtx*)realloc(L->v, (size_t)cap * sizeof(ovl_vtx));
+        if (!nvp) { L->oom = 1; return NULL; }
+        L->v = nvp; L->cap = cap;
+    }
+    ovl_vtx* p = L->v + L->nv;
+    L->nv += n;
+    L->cmd[L->ncmd - 1].count += n;
+    return p;
+}
+
+/* A quad covering [x0,x1]x[y0,y1] (+pad for AA / shadow), 6 vertices. top / bot: a vertical gradient. */
+static inline void ovl_quad(ovl_list* L, float x0, float y0, float x1, float y1, float pad,
+                            ovl_rgba top, ovl_rgba bot, float radius, float border, int mode, float extra,
+                            float u0, float v0, float u1, float v1)
+{
+    float cx = (x0 + x1) * 0.5f, cy = (y0 + y1) * 0.5f, hx = (x1 - x0) * 0.5f, hy = (y1 - y0) * 0.5f;
+    float X0 = x0 - pad, Y0 = y0 - pad, X1 = x1 + pad, Y1 = y1 + pad;
+    const float xs[6] = { X0, X1, X0, X0, X1, X1 }, ys[6] = { Y0, Y0, Y1, Y1, Y0, Y1 };
+    const float us[6] = { u0, u1, u0, u0, u1, u1 }, vs[6] = { v0, v0, v1, v1, v0, v1 };
+    ovl_vtx* v = ovl_alloc(L, 6);
+    if (!v) return;
+    for (int i = 0; i < 6; i++) {
+        float t = (y1 > y0) ? (ys[i] - y0) / (y1 - y0) : 0.0f;
+        if (t < 0) t = 0;
+        if (t > 1) t = 1;
+        v[i].x = xs[i]; v[i].y = ys[i]; v[i].u = us[i]; v[i].v = vs[i];
+        v[i].lx = xs[i] - cx; v[i].ly = ys[i] - cy; v[i].hx = hx; v[i].hy = hy;
+        v[i].r = top.r + (bot.r - top.r) * t; v[i].g = top.g + (bot.g - top.g) * t;
+        v[i].b = top.b + (bot.b - top.b) * t; v[i].a = top.a + (bot.a - top.a) * t;
+        v[i].radius = radius; v[i].border = border; v[i].mode = (float)mode; v[i].extra = extra;
+    }
+}
+
+static inline void ovl_rect(ovl_list* L, float x0, float y0, float x1, float y1, ovl_rgba c, float radius)
+{ ovl_quad(L, x0, y0, x1, y1, 1.0f, c, c, radius, 0.0f, OVL_M_RRECT, 0, 0, 0, 0, 0); }
+static inline void ovl_rect_v(ovl_list* L, float x0, float y0, float x1, float y1, ovl_rgba top, ovl_rgba bot, float radius)
+{ ovl_quad(L, x0, y0, x1, y1, 1.0f, top, bot, radius, 0.0f, OVL_M_RRECT, 0, 0, 0, 0, 0); }
+static inline void ovl_frame(ovl_list* L, float x0, float y0, float x1, float y1, ovl_rgba c, float radius, float w)
+{ ovl_quad(L, x0, y0, x1, y1, 1.0f, c, c, radius, w, OVL_M_RRECT, 0, 0, 0, 0, 0); }
+static inline void ovl_shadow(ovl_list* L, float x0, float y0, float x1, float y1, ovl_rgba c, float radius, float feather)
+{ ovl_quad(L, x0, y0, x1, y1, feather * 2.0f, c, c, radius, 0.0f, OVL_M_SHADOW, feather, 0, 0, 0, 0); }
+static inline void ovl_circle(ovl_list* L, float cx, float cy, float r, ovl_rgba c, float border)
+{ ovl_quad(L, cx - r, cy - r, cx + r, cy + r, 1.0f, c, c, r, border, OVL_M_RRECT, 0, 0, 0, 0, 0); }
+/* dir: 0 up, 1 right, 2 down, 3 left; border > 0: outline */
+static inline void ovl_tri(ovl_list* L, float cx, float cy, float r, int dir, ovl_rgba c, float border)
+{ ovl_quad(L, cx - r, cy - r, cx + r, cy + r, 1.0f, c, c, 0.0f, border, OVL_M_TRI, (float)dir, 0, 0, 0, 0); }
+
+/* Text at (x, baseline y), snapped to integer pixels. Returns the advance. */
+static inline float ovl_text(ovl_list* L, int face, float x, float y, const char* s, ovl_rgba c)
+{
+    const ovl_font* F = L->font;
+    if (!F || !s) return 0;
+    const ovl_face* fc = &F->face[face];
+    float pen = floorf(x + 0.5f), base = floorf(y + 0.5f);
+    int prev = -1;
+    for (const unsigned char* p = (const unsigned char*)s; *p; ) {
+        unsigned cp = ovl_utf8_next(&p);
+        int i = ovl_font_index(cp);
+        if (i < 0 || !fc->g[i].present) i = ovl_font_index('?');
+        if (prev >= 0) pen += ovl_font_kern(fc, prev, i);
+        const ovl_glyph* g = &fc->g[i];
+        if (g->w && g->h) {   /* every glyph at an integer pixel (supersampled faces have fractional advances) */
+            float gx = floorf(pen + 0.5f) + g->ox, gy = base + g->oy;
+            ovl_quad(L, gx, gy, gx + g->w, gy + g->h, 0.0f, c, c, 0, 0, OVL_M_TEXT, 0,
+                     (float)g->x, (float)g->y, (float)(g->x + g->w), (float)(g->y + g->h));
+        }
+        pen += g->adv;
+        prev = i;
+    }
+    return ceilf(pen - floorf(x + 0.5f) - 0.01f);
+}
+
+static inline float ovl_text_w(const ovl_list* L, int face, const char* s)
+{ return L->font && s ? ceilf(ovl_font_measure(L->font, face, s) - 0.01f) : 0.0f; }
+
+/* Text cut to maxw with an ellipsis when it does not fit. */
+static inline float ovl_text_fit(ovl_list* L, int face, float x, float y, const char* s, ovl_rgba c, float maxw)
+{
+    if (!s) return 0;
+    if (ovl_text_w(L, face, s) <= maxw) return ovl_text(L, face, x, y, s, c);
+    char buf[256];
+    size_t n = strlen(s);
+    if (n > sizeof buf - 4) n = sizeof buf - 4;
+    while (n > 0) {
+        while (n > 0 && ((unsigned char)s[n] & 0xC0) == 0x80) n--;   /* not inside a UTF-8 sequence */
+        memcpy(buf, s, n);
+        memcpy(buf + n, "\xE2\x80\xA6", 4);                             /* ... */
+        if (ovl_text_w(L, face, buf) <= maxw) break;
+        n--;
+    }
+    if (!n) return 0;
+    return ovl_text(L, face, x, y, buf, c);
+}
+
+#endif /* PS3RECOMP_OVL_DRAW_H */
diff --git a/libs/video/ovl_font_gdi.h b/libs/video/ovl_font_gdi.h
new file mode 100644
index 0000000..d72c41a
--- /dev/null
+++ b/libs/video/ovl_font_gdi.h
@@ -0,0 +1,267 @@
+/*
+ * ps3recomp - the options overlay's glyph atlas (header-only, Windows).
+ *
+ * Text comes from a Windows system font (Segoe UI) rasterised with GDI: no
+ * font file ships and nothing new is linked (gdi32 already is).
+ * GetGlyphOutlineW(GGO_GRAY8_BITMAP) gives a hinted, 65-level coverage bitmap
+ * per glyph at the exact pixel size, so text drawn 1:1 at integer positions
+ * (the renderer point-samples the atlas) is as crisp as GDI's own at any
+ * window size, DPI or aspect. One R8 atlas holds every face (size x weight)
+ * of one UI scale; the overlay builds a new one on a worker thread when the
+ * scale changes and keeps drawing with the old one until it is ready.
+ *
+ * Small faces (below OVL_FONT_SS_BELOW = 22 px) are rasterised by GDI at 4x their
+ * size and box-filtered down, with fractional advances: GDI's hinting at 11-21
+ * px snaps stems so hard that glyph widths drift by a pixel (Segoe UI's 'm' at
+ * 15 px: 10 px of ink in a 13 px advance, so every "m" is followed by a gap).
+ * At 4x the hinting is only a nudge, so shapes and spacing stay the design's;
+ * each glyph is still placed at an integer pixel (the pen is fractional).
+ *
+ * Glyphs: ASCII 32..126 plus OVL_FONT_NEXTRA symbols (arrows, x, bullet, ...).
+ * Kerning: GetKerningPairsW, looked up in a per-face table.
+ */
+#ifndef PS3RECOMP_OVL_FONT_GDI_H
+#define PS3RECOMP_OVL_FONT_GDI_H
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+#define OVL_FONT_MAXFACE   8
+#define OVL_FONT_FIRST     32
+#define OVL_FONT_LAST      126
+#define OVL_FONT_NEXTRA    20
+#define OVL_FONT_NGLYPH    (OVL_FONT_LAST - OVL_FONT_FIRST + 1 + OVL_FONT_NEXTRA)
+#ifndef OVL_FONT_SS_BELOW
+#define OVL_FONT_SS_BELOW  22       /* faces smaller than this (px) are supersampled 4x */
+#endif
+
+typedef struct {
+    unsigned short x, y, w, h;   /* atlas rectangle */
+    short ox, oy;                /* bitmap top-left relative to the pen (y down, baseline 0) */
+    float adv;                   /* advance (fractional for supersampled faces) */
+    unsigned char present;
+} ovl_glyph;
+
+typedef struct {
+    int px, weight;
+    int ascent, descent, line;   /* pixels */
+    ovl_glyph g[OVL_FONT_NGLYPH];
+    signed char* kern;           /* OVL_FONT_NGLYPH^2 pair adjustments in quarter pixels, or NULL */
+    int ss;                      /* 1: GDI-hinted at the size; 4: rasterised 4x and box-filtered */
+} ovl_face;
+
+typedef struct {
+    int w, h;
+    unsigned char* pix;          /* 8-bit coverage, w*h */
+    ovl_face face[OVL_FONT_MAXFACE];
+    int nface;
+    float scale;                 /* the UI scale the faces were built for */
+    double build_ms;
+    char family[64];             /* the face GDI actually used */
+} ovl_font;
+
+/* extra code points after ASCII */
+static const unsigned short ovl_font_extra[OVL_FONT_NEXTRA] = {
+    0x00B0 /* degree */, 0x00D7 /* times */, 0x2013, 0x2014, 0x2026 /* ellipsis */, 0x2022 /* bullet */,
+    0x2190, 0x2192, 0x2191, 0x2193 /* arrows */, 0x00B7, 0x2212 /* minus */, 0x2122, 0x00A9,
+    0x25B8, 0x25BE, 0x2264, 0x2265, 0x00BD, 0x2715 };
+
+static inline int ovl_font_index(unsigned cp)
+{
+    if (cp >= OVL_FONT_FIRST && cp <= OVL_FONT_LAST) return (int)(cp - OVL_FONT_FIRST);
+    for (int i = 0; i < OVL_FONT_NEXTRA; i++) if (ovl_font_extra[i] == cp) return OVL_FONT_LAST - OVL_FONT_FIRST + 1 + i;
+    return -1;
+}
+static inline unsigned ovl_font_cp(int idx)
+{
+    return idx <= OVL_FONT_LAST - OVL_FONT_FIRST ? (unsigned)(idx + OVL_FONT_FIRST)
+                                                 : ovl_font_extra[idx - (OVL_FONT_LAST - OVL_FONT_FIRST + 1)];
+}
+
+/* Next code point of a UTF-8 string (advances *p). */
+static inline unsigned ovl_utf8_next(const unsigned char** pp)
+{
+    const unsigned char* p = *pp;
+    unsigned cp = *p++;
+    if (cp >= 0xE0 && p[0] && p[1]) { cp = ((cp & 15) << 12) | ((p[0] & 63) << 6) | (p[1] & 63); p += 2; }
+    else if (cp >= 0xC0 && p[0]) { cp = ((cp & 31) << 6) | (p[0] & 63); p += 1; }
+    *pp = p;
+    return cp;
+}
+
+static inline int ovl_font_fdiv(int a, int b) { return a >= 0 ? a / b : -((-a + b - 1) / b); }
+
+static inline void ovl_font_free(ovl_font* F)
+{
+    if (!F) return;
+    for (int i = 0; i < F->nface; i++) free(F->face[i].kern);
+    free(F->pix);
+    memset(F, 0, sizeof *F);
+}
+
+/* Build an atlas holding nf faces {px, weight}. Returns 0 on failure. */
+static inline int ovl_font_build(ovl_font* F, const char* family, const int (*faces)[2], int nf, float scale)
+{
+    LARGE_INTEGER f0, f1, fq;
+    QueryPerformanceFrequency(&fq); QueryPerformanceCounter(&f0);
+    memset(F, 0, sizeof *F);
+    F->scale = scale;
+    snprintf(F->family, sizeof F->family, "%s", family);
+    HDC dc = CreateCompatibleDC(NULL);
+    if (!dc) return 0;
+    typedef struct { unsigned char* bmp; int w, h, face, idx; } tmpg;
+    tmpg* tg = (tmpg*)calloc((size_t)nf * OVL_FONT_NGLYPH, sizeof(tmpg));
+    if (!tg) { DeleteDC(dc); return 0; }
+    int ntg = 0;
+    const MAT2 ident = { {0, 1}, {0, 0}, {0, 0}, {0, 1} };
+    const UINT ggo = GGO_GRAY8_BITMAP;   /* hinted at the exact size (GGO_UNHINTED has no effect on bitmaps) */
+    /* GGO's 65 levels are linear coverage; GDI's own grayscale TextOut of light text on a dark ground
+     * (what the overlay draws) lifts partial pixels about as sqrt(c), which keeps thin stems from looking
+     * faint and the spacing after them from looking too wide at small sizes ("m any"). Below 1/16 the
+     * curve is linear (no halo); 0 and 64 stay 0 and 255. */
+    unsigned char cov[65];
+    for (int v = 0; v <= 64; v++) {
+        const double c = v / 64.0;
+        const double a = c < 1.0 / 16.0 ? c * 4.0 : sqrt(c);
+        cov[v] = (unsigned char)(a * 255.0 + 0.5);
+    }
+    wchar_t wfam[64];
+    MultiByteToWideChar(CP_UTF8, 0, family, -1, wfam, 64);
+    for (int fi = 0; fi < nf && fi < OVL_FONT_MAXFACE; fi++) {
+        ovl_face* fc = &F->face[fi];
+        fc->px = faces[fi][0]; fc->weight = faces[fi][1];
+        const int ss = fc->px < OVL_FONT_SS_BELOW ? 4 : 1;
+        fc->ss = ss;
+        HFONT hf = CreateFontW(-fc->px * ss, 0, 0, 0, fc->weight, FALSE, FALSE, FALSE, DEFAULT_CHARSET,
+                               OUT_TT_ONLY_PRECIS, CLIP_DEFAULT_PRECIS, ANTIALIASED_QUALITY,
+                               DEFAULT_PITCH | FF_SWISS, wfam);
+        HGDIOBJ old = SelectObject(dc, hf);
+        if (fi == 0) {
+            wchar_t used[64] = {0};
+            if (GetTextFaceW(dc, 64, used))
+                WideCharToMultiByte(CP_UTF8, 0, used, -1, F->family, (int)sizeof F->family, NULL, NULL);
+        }
+        TEXTMETRICW tm; GetTextMetricsW(dc, &tm);
+        fc->ascent = (tm.tmAscent + ss / 2) / ss; fc->descent = (tm.tmDescent + ss / 2) / ss;
+        fc->line = (tm.tmHeight + tm.tmExternalLeading + ss / 2) / ss;
+        WORD gi[OVL_FONT_NGLYPH];
+        wchar_t cps[OVL_FONT_NGLYPH];
+        for (int i = 0; i < OVL_FONT_NGLYPH; i++) cps[i] = (wchar_t)ovl_font_cp(i);
+        GetGlyphIndicesW(dc, cps, OVL_FONT_NGLYPH, gi, GGI_MARK_NONEXISTING_GLYPHS);
+        for (int i = 0; i < OVL_FONT_NGLYPH; i++) {
+            ovl_glyph* g = &fc->g[i];
+            if (gi[i] == 0xFFFF) continue;
+            GLYPHMETRICS gm;
+            DWORD need = GetGlyphOutlineW(dc, cps[i], ggo, &gm, 0, NULL, &ident);
+            if (need == GDI_ERROR) continue;
+            g->present = 1;
+            g->adv = (float)gm.gmCellIncX / (float)ss;
+            /* the ss x ss cells of the target pixels: the pen (x = 0) and the baseline (y = 0) are cell edges */
+            const int ox = ovl_font_fdiv(gm.gmptGlyphOrigin.x, ss), oy = ovl_font_fdiv(-gm.gmptGlyphOrigin.y, ss);
+            g->ox = (short)ox;
+            g->oy = (short)oy;
+            if (!need || cps[i] == ' ') continue;          /* blank glyph */
+            unsigned char* raw = (unsigned char*)malloc(need);
+            if (!raw) continue;
+            GetGlyphOutlineW(dc, cps[i], ggo, &gm, need, raw, &ident);
+            const int pitch = (int)((gm.gmBlackBoxX + 3) & ~3u);
+            const int w4 = (int)gm.gmBlackBoxX, h4 = (int)gm.gmBlackBoxY;
+            const int sx = gm.gmptGlyphOrigin.x - ox * ss, sy = -gm.gmptGlyphOrigin.y - oy * ss;   /* 0..ss-1 */
+            tmpg* t = &tg[ntg++];
+            t->w = (sx + w4 + ss - 1) / ss; t->h = (sy + h4 + ss - 1) / ss; t->face = fi; t->idx = i;
+            t->bmp = (unsigned char*)malloc((size_t)t->w * t->h);
+            unsigned* acc = (unsigned*)calloc((size_t)t->w * t->h, sizeof(unsigned));
+            if (acc)
+                for (int y = 0; y < h4; y++)
+                    for (int x = 0; x < w4; x++) {
+                        const unsigned v = raw[y * pitch + x];          /* 0..64 */
+                        acc[((sy + y) / ss) * t->w + (sx + x) / ss] += v > 64 ? 64 : v;
+                    }
+            const unsigned full = 64u * (unsigned)(ss * ss);
+            for (int k = 0; k < t->w * t->h; k++) {
+                const unsigned a = acc ? acc[k] : 0;
+                t->bmp[k] = cov[(a * 64u + full / 2) / full];
+            }
+            free(acc);
+            free(raw);
+        }
+        DWORD nk = GetKerningPairsW(dc, 0, NULL);
+        if (nk) {
+            KERNINGPAIR* kp = (KERNINGPAIR*)malloc(nk * sizeof(KERNINGPAIR));
+            fc->kern = (signed char*)calloc((size_t)OVL_FONT_NGLYPH * OVL_FONT_NGLYPH, 1);
+            if (kp && fc->kern) {
+                nk = GetKerningPairsW(dc, nk, kp);
+                for (DWORD k = 0; k < nk; k++) {
+                    int a = ovl_font_index(kp[k].wFirst), b = ovl_font_index(kp[k].wSecond);
+                    int d = (kp[k].iKernAmount * 4 + (kp[k].iKernAmount >= 0 ? ss / 2 : -ss / 2)) / ss;   /* quarter px */
+                    if (a < 0 || b < 0 || !d) continue;
+                    if (d < -127) d = -127;
+                    if (d > 127) d = 127;
+                    fc->kern[a * OVL_FONT_NGLYPH + b] = (signed char)d;
+                }
+            }
+            free(kp);
+        }
+        SelectObject(dc, old);
+        DeleteObject(hf);
+        F->nface = fi + 1;
+    }
+    DeleteDC(dc);
+    /* shelf pack, 512 wide (1024 when the faces are large) */
+    int W = 512, x = 1, y = 1, shelf = 0;
+    long long total = 0;
+    for (int i = 0; i < ntg; i++) total += (long long)(tg[i].w + 2) * (tg[i].h + 2);
+    if (total > 512LL * 400) W = 1024;
+    if (total > 1024LL * 900) W = 2048;
+    for (int i = 0; i < ntg; i++) {
+        if (x + tg[i].w + 1 > W) { x = 1; y += shelf + 1; shelf = 0; }
+        ovl_glyph* g = &F->face[tg[i].face].g[tg[i].idx];
+        g->x = (unsigned short)x; g->y = (unsigned short)y; g->w = (unsigned short)tg[i].w; g->h = (unsigned short)tg[i].h;
+        x += tg[i].w + 1;
+        if (tg[i].h > shelf) shelf = tg[i].h;
+    }
+    int H = y + shelf + 1, H2 = 64;
+    while (H2 < H) H2 *= 2;
+    F->w = W; F->h = H2;
+    F->pix = (unsigned char*)calloc((size_t)W * H2, 1);
+    for (int i = 0; i < ntg; i++) {
+        ovl_glyph* g = &F->face[tg[i].face].g[tg[i].idx];
+        if (F->pix)
+            for (int yy = 0; yy < g->h; yy++) memcpy(F->pix + (size_t)(g->y + yy) * W + g->x, tg[i].bmp + yy * g->w, g->w);
+        free(tg[i].bmp);
+    }
+    free(tg);
+    QueryPerformanceCounter(&f1);
+    F->build_ms = (double)(f1.QuadPart - f0.QuadPart) * 1000.0 / (double)fq.QuadPart;
+    return F->pix != NULL && F->nface == nf;
+}
+
+static inline float ovl_font_kern(const ovl_face* fc, int a, int b)
+{
+    return fc->kern ? (float)fc->kern[a * OVL_FONT_NGLYPH + b] * 0.25f : 0.0f;
+}
+
+/* Width of a UTF-8 string in pixels (fractional for supersampled faces). */
+static inline float ovl_font_measure(const ovl_font* F, int face, const char* s)
+{
+    const ovl_face* fc = &F->face[face];
+    float w = 0;
+    int prev = -1;
+    for (const unsigned char* p = (const unsigned char*)s; p && *p; ) {
+        unsigned cp = ovl_utf8_next(&p);
+        int i = ovl_font_index(cp);
+        if (i < 0 || !fc->g[i].present) i = ovl_font_index('?');
+        if (prev >= 0) w += ovl_font_kern(fc, prev, i);
+        w += fc->g[i].adv;
+        prev = i;
+    }
+    return w;
+}
+
+#endif /* PS3RECOMP_OVL_FONT_GDI_H */
diff --git a/libs/video/ovl_gpu.h b/libs/video/ovl_gpu.h
