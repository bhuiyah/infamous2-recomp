+         * every chunk's CRC right, the pause measured around its capture */
+        const ss_image* img = ss_image_last();
+        char why[192];
+        why[0] = 0;
+        CHECK(rs.captured == 1 && res.image_bytes > 0 && img && img->hdr.file_size == res.image_bytes,
+              "the save was not captured (captured %u, %llu bytes, image %p)", rs.captured,
+              (unsigned long long)res.image_bytes, (const void*)img);
+        CHECK(res.pause_ms > 0 && res.pause_ms >= res.capture_ms + res.gpu_ms && res.capture_ms > 0,
+              "pause %.2f ms, gpu %.2f, capture %.2f", res.pause_ms, res.gpu_ms, res.capture_ms);
+        CHECK(img && ss_image_verify(img, why, sizeof why) == SS_OK && ss_image_validate(img, why, sizeof why) == SS_OK,
+              "the image does not verify: %s", why);
+        CHECK(img && ss_image_section(img, SS_FOURCC('T', 'I', 'M', 'E')) &&
+              ss_image_section(img, SS_FOURCC('C', 'H', 'N', 'S')) && ss_image_section(img, SS_FOURCC('T', 'S', 'T', 'S')),
+              "the image lacks TIME / CHNS / TSTS");
+        printf("phase 7b: captured %.1f KB in %u sections, pause %.1f ms (capture %.2f ms)\n",
+               (double)res.image_bytes / 1024.0, img ? img->hdr.nsections : 0, res.pause_ms, res.capture_ms);
+    }
+
+    /* ---- 8. one at a time: a second submit is BUSY (also eight at once) ------- */
+    {
+        ss_request r; memset(&r, 0, sizeof r); r.purpose = SS_P_SAVE; r.done = on_done;
+        const LONG n0 = g_done_n;
+        CHECK(ss_request_submit(&r) == SS_R_QUEUED, "first submit not queued");
+        CHECK(ss_busy(), "not busy with a request queued");
+        CHECK(ss_request_submit(&r) == SS_R_BUSY, "second submit not BUSY");
+        for (int i = 0; i < 3000 && g_done_n == n0; i++) { WaitForSingleObject(g_wake, 2); ss_frame_tick(++g_flip); }
+        CHECK(g_done_n == n0 + 1 && g_done_ok && !ss_busy(), "queued save did not finish once (%ld)", g_done_n - n0);
+        HANDLE rh[8];
+        g_race_go = 0; g_race_queued = 0; g_race_busy = 0;
+        for (int i = 0; i < 8; i++) rh[i] = CreateThread(NULL, 0, race_submit, NULL, 0, NULL);
+        Sleep(10);
+        InterlockedExchange(&g_race_go, 1);
+        WaitForMultipleObjects(8, rh, TRUE, 3000);
+        for (int i = 0; i < 8; i++) CloseHandle(rh[i]);
+        CHECK(g_race_queued == 1 && g_race_busy == 7, "eight submitters: %ld queued, %ld busy",
+              g_race_queued, g_race_busy);
+        const LONG n1 = g_done_n;
+        for (int i = 0; i < 3000 && g_done_n == n1; i++) { WaitForSingleObject(g_wake, 2); ss_frame_tick(++g_flip); }
+        CHECK(g_done_n == n1 + 1 && !ss_busy(), "the racing request did not finish");
+        printf("phase 8: busy: ok\n");
+    }
+
+    /* ---- 9. a thread inside a callback: each stop times out (300 ms), so the
+     * next waits 4 x 300 ms; given up with that reason and thread once a next
+     * stop would start past the window ---------------------------------------- */
+    InterlockedExchange(&g_cb_stuck, 1);
+    Sleep(20);
+    run_request(SS_P_SAVE, 2.0, 5000, &res);
+    printf("phase 9: save -> ok=%d reason=%s (%s) attempts=%u stopped=%.0f of %.0f ms: %s\n", res.ok,
+           ss_reason_name(res.reason), res.detail, res.attempts, res.stopped_ms, res.waited_ms, res.why);
+    CHECK(!res.ok && res.reason == SS_REASON_CALLBACK && !strcmp(res.detail, "callback"),
+          "a thread stuck in a callback: reason %s (%s)", ss_reason_name(res.reason), res.detail);
+    CHECK(res.attempts == 2 && res.waited_ms >= 1500 && res.waited_ms < 2000 &&
+          res.stopped_ms <= 0.45 * res.waited_ms, "not retried after the gap until the give-up (attempts %u,"
+          " stopped %.0f of %.0f ms)", res.attempts, res.stopped_ms, res.waited_ms);
+    InterlockedExchange(&g_cb_stuck, 0);
+    Sleep(20);
+
+    /* ---- 10. a file open for writing (an added check, read before the stop):
+     * no stop at all, given up with that reason; and once it closes during
+     * the window, the save goes through at its first stop -------------------- */
+    InterlockedExchange(&g_file_open, 1);
+    {
+        const LONG c0 = g_captures;
+        ss_stats s0; ss_get_stats(&s0);
+        run_request(SS_P_SAVE, 0.4, 3000, &res);
+        ss_stats s1; ss_get_stats(&s1);
+        printf("phase 10a: save -> ok=%d reason=%s (%s) attempts=%u waited=%.0f ms\n", res.ok,
+               ss_reason_name(res.reason), res.detail, res.attempts, res.waited_ms);
+        CHECK(!res.ok && res.reason == SS_REASON_FILE_WRITE && strstr(res.detail, "install.dat"),
+              "file open for writing: reason %s (%s)", ss_reason_name(res.reason), res.detail);
+        CHECK(res.attempts == 0 && s1.stops == s0.stops && g_captures == c0 && res.waited_ms >= 400,
+              "a file open for writing still stopped the world (%u stop(s)) or gave up early (%.0f ms)",
+              res.attempts, res.waited_ms);
+    }
+    CHECK(strstr(ss_reason_text(SS_REASON_FILE_WRITE), "writing data") != NULL, "file-write text");
+    { HANDLE h = CreateThread(NULL, 0, clear_after, (LPVOID)(intptr_t)300, 0, NULL); if (h) CloseHandle(h); }
+    run_request(SS_P_SAVE, 3.0, 5000, &res);
+    printf("phase 10b: save -> ok=%d attempts=%u eligible=%.0f ms\n", res.ok, res.attempts, res.eligible_ms);
+    CHECK(res.ok && res.attempts == 1 && res.eligible_ms >= 250, "a save did not go through at its first stop"
+          " once the file closed (ok=%d attempts %u eligible %.0f ms)", res.ok, res.attempts, res.eligible_ms);
+    InterlockedExchange(&g_file_open, 0);
+
+    /* ---- 11. a busy table (a thread being created): no stop, given up with
+     * that reason; an unpaired end is ignored -- the counter stays at zero,
+     * so one begin blocks again ------------------------------------------------ */
+    ss_transition_begin(SS_TR_PPU_THREAD);
+    run_request(SS_P_SAVE, 0.3, 3000, &res);
+    printf("phase 11: save -> ok=%d reason=%s (%s) attempts=%u\n", res.ok, ss_reason_name(res.reason),
+           res.detail, res.attempts);
+    CHECK(!res.ok && res.reason == SS_REASON_TRANSITION && res.attempts == 0, "busy table: reason %s attempts %u",
+          ss_reason_name(res.reason), res.attempts);
+    run_request(SS_P_LOAD, 0.3, 3000, &res);     /* a load waits for it too */
+    CHECK(!res.ok && res.reason == SS_REASON_TRANSITION && res.attempts == 0,
+          "busy table did not refuse a load (%s, %u stop(s))", ss_reason_name(res.reason), res.attempts);
+    ss_transition_end(SS_TR_PPU_THREAD);
+    ss_transition_end(SS_TR_PPU_THREAD);          /* unpaired: ignored */
+    ss_transition_begin(SS_TR_PPU_THREAD);        /* back to 1 only if that left it at 0 */
+    run_request(SS_P_SAVE, 0.2, 3000, &res);
+    CHECK(!res.ok && res.reason == SS_REASON_TRANSITION && strstr(res.why, "PPU thread"),
+          "an unpaired end took the counter below zero: a begin did not block (%s: %s)",
+          ss_reason_name(res.reason), res.why);
+    ss_transition_end(SS_TR_PPU_THREAD);
+    ss_transition_begin(SS_TR_SPU_THREAD);
+    run_request(SS_P_SAVE, 0.2, 3000, &res);
+    CHECK(!res.ok && res.reason == SS_REASON_TRANSITION && strstr(res.why, "SPU") && res.attempts == 0,
