+        return ss_reader_fail(r, SS_E_STATE, "this session: %s, which a load does not discard", why);
+    return SS_OK;
+}
+
+/* ss_set_load_session_check: SPUC's and SPUH's session checks again, inside
+ * every stop a load runs in (their check_image reads them once per request). */
+static int lv2_ss_session_check(char* why, size_t n)
+{
+    const int r = spu_channels_ss_check(why, n);
+    return r ? r : spu_workload_ss_busy(why, n);
+}
+
+static int spuh_restore(ss_reader* r)
+{
+    return ss_read_fields(r, &spu_workload_ss_taskset_list);
+}
