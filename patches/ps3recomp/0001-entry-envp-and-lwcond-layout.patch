+/*
+ * ps3recomp - tests for the Switch Pro Controller driver (pad_hid_switch.c)
+ *
+ * Windows only (the driver is). From external/ps3recomp:
+ *   clang-cl /nologo /std:c17 -D_CRT_SECURE_NO_WARNINGS -I include -I libs\input
+ *            libs\input\tests\test_pad_hid_switch.c /Fe:test_pad_hid_switch.exe && test_pad_hid_switch.exe
+ *
+ * The driver source is included directly, and padhost_dev_read/write are a
+ * fake controller that answers the USB handshake and the subcommands the way
+ * a Pro Controller does (from a fake SPI flash), so open() runs end to end.
+ * Covers: packet layouts and the packet counter, the USB / Bluetooth
+ * bring-up sequences, a pad that answers nothing, SPI stick and IMU
+ * calibration decoding (factory and user), 0x30 / 0x21 / 0x3F parsing,
+ * face-button layouts, IMU -> SIXAXIS units, battery, the HD rumble
+ * amplitude encoding, build_output (lights, rumble, the 30 ms pacing that
+ * defers to the refresh, stops and port changes at once), the MAC as the
+ * serial, the config options and close().
+ */
+#if defined(_WIN32)
+
+#include "../pad_hid_switch.c"
+
+#include <stdarg.h>
+#include <stdio.h>
+
+static int g_fail = 0, g_checks = 0;
+
+#define CHECK(cond)                                                            \
+    do { g_checks++;                                                           \
+         if (!(cond)) { printf("FAIL %s:%d  %s\n", __FILE__, __LINE__, #cond); \
+                        g_fail++; } } while (0)
+
+#define CHECK_STR(got, want)                                                   \
+    do { g_checks++;                                                           \
+         if (strcmp((got), (want))) { printf("FAIL %s:%d  %s = \"%s\", want \"%s\"\n", \
+                                             __FILE__, __LINE__, #got, (got), (want)); \
+                                      g_fail++; } } while (0)
+
+#define CHECK_EQ(got, want)                                                    \
+    do { long _g = (long)(got), _w = (long)(want); g_checks++;                 \
+         if (_g != _w) { printf("FAIL %s:%d  %s = %ld, want %ld\n",            \
+                                __FILE__, __LINE__, #got, _g, _w);             \
+                         g_fail++; } } while (0)
+
+/* ---- fake time and config ---------------------------------------------- */
+
+static unsigned long long g_now = 100000;
+static unsigned long long fake_clock(void) { return g_now; }
+static void fake_sleep(unsigned ms) { g_now += ms; }
+
+/* The pad host's side, as pad_host.h documents it. */
+static const char* g_cfg_layout = NULL;
+static const char* g_cfg_home = NULL;
+const char* padhost_config_get(const char* key)
+{
+    if (!strcmp(key, "switch_layout")) return g_cfg_layout;
+    if (!strcmp(key, "switch_home_led")) return g_cfg_home;
+    return NULL;
+}
+
+unsigned padhost_port_led_mask(int port)
+{
+    static const unsigned m[PADHOST_MAX_PORTS] = { 0x1, 0x2, 0x4, 0x8, 0x9, 0xA, 0xC };
+    return (port >= 0 && port < PADHOST_MAX_PORTS) ? m[port] : 0;
+}
+
+void padhost_logf(const char* fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    fputs("[padhost] ", stdout);
+    vprintf(fmt, ap);
+    fputs("\n", stdout);
+    va_end(ap);
+}
+
+/* ---- fake controller ----------------------------------------------------- */
+
+typedef struct { u8 b[64]; int len; } Pkt;
+
+static struct {
+    int usb_answers;            /* answers 0x80 commands (only over USB) */
+    int mute;                   /* answers nothing at all */
+    int no_imu;                 /* NACKs IMU enable */
+    int chatty;                 /* a 0x30 report before every reply */
+    u8  flash[0x10000];
+    Pkt q[256]; int qh, qt;
+    Pkt w[256]; int nw;
+    u8  mode, imu, vib, lights, home0, home1;
+    int handshakes;
+} F;
+
+static void fake_reset(void)
+{
+    memset(&F, 0, sizeof F);
+    memset(F.flash, 0xFF, sizeof F.flash);
+    F.mode = 0x3F;
+}
+
+static void fake_push(const u8* b, int len)
+{
+    Pkt* p = &F.q[F.qt++ % 256];
+    memset(p, 0, sizeof *p);
+    memcpy(p->b, b, (size_t)len);
+    p->len = len;
+}
+
+static void fake_input_bytes(u8* r)  /* bytes 1..12 of a neutral 0x30 / 0x21 */
+{
+    r[1] = 0x42; r[2] = 0x91;
+    /* sticks at 2048 */
+    r[6] = 0x00; r[7] = 0x08; r[8] = 0x80;
+    r[9] = 0x00; r[10] = 0x08; r[11] = 0x80;
+    r[12] = 0x0B;
+}
+
+int padhost_dev_write(PadHostDevice* d, const unsigned char* buf, int len)
+{
+    (void)d;
+    Pkt* w = &F.w[F.nw++ % 256];
+    memset(w, 0, sizeof *w);
+    memcpy(w->b, buf, (size_t)(len > 64 ? 64 : len));
+    w->len = len;
+    if (F.mute) return len;
+    if (buf[0] == 0x80) {
+        if (F.usb_answers && buf[1] != 0x04) {
+            u8 r[64] = { 0x81, buf[1], 0x00, 0x03, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66 };
+            if (buf[1] == 0x02) F.handshakes++;
+            fake_push(r, 64);
+        }
+        return len;
+    }
+    if (buf[0] != 0x01) return len;
+    if (F.chatty) {
+        u8 c[64] = { 0x30 };
+        fake_input_bytes(c);
+        fake_push(c, 64);
+    }
+    u8 r[64];
+    memset(r, 0, sizeof r);
+    r[0] = 0x21;
+    fake_input_bytes(r);
+    u8 sub = buf[10];
+    r[13] = 0x80;
+    r[14] = sub;
+    switch (sub) {
+    case 0x02:
+        r[13] = 0x82;
+        r[15] = 0x04; r[16] = 0x21; r[17] = 0x03; r[18] = 0x02;
+        memcpy(r + 19, "\x98\xB6\xE9\x00\x00\x01", 6); r[25] = 0x01; r[26] = 0x01;
+        break;
+    case 0x10: {
+        u32 a = (u32)buf[11] | ((u32)buf[12] << 8) | ((u32)buf[13] << 16) | ((u32)buf[14] << 24);
+        u8 n = buf[15];
+        r[13] = 0x90;
+        memcpy(r + 15, buf + 11, 5);
+        memcpy(r + 20, F.flash + (a & 0xFFFF), n);
+        break;
+    }
+    case 0x03: F.mode = buf[11]; break;
+    case 0x40: if (F.no_imu) r[13] = 0x00; else F.imu = buf[11]; break;
+    case 0x48: F.vib = buf[11]; break;
+    case 0x30: F.lights = buf[11]; break;
+    case 0x38: F.home0 = buf[11]; F.home1 = buf[12]; break;
+    default: break;
+    }
+    fake_push(r, 64);
+    return len;
+}
+
+int padhost_dev_read(PadHostDevice* d, unsigned char* buf, int cap, int timeout_ms)
+{
+    (void)d;
+    if (F.qh == F.qt) { g_now += (unsigned long long)timeout_ms; return 0; }
+    Pkt* p = &F.q[F.qh++ % 256];
+    int n = cap < 64 ? cap : 64;
+    memset(buf, 0, (size_t)cap);
+    memcpy(buf, p->b, (size_t)n);
+    g_now += 1;
+    return n;
+}
+
+/* ---- helpers ------------------------------------------------------------- */
+
+static void pack12(u8* o, const u16 v[6])
+{
+    for (int i = 0; i < 3; i++) {
+        o[i * 3]     = (u8)(v[i * 2] & 0xFF);
+        o[i * 3 + 1] = (u8)((v[i * 2] >> 8) | ((v[i * 2 + 1] & 0x0F) << 4));
+        o[i * 3 + 2] = (u8)(v[i * 2 + 1] >> 4);
+    }
+}
+
+static void put_le16(u8* b, int v) { b[0] = (u8)(v & 0xFF); b[1] = (u8)((v >> 8) & 0xFF); }
+
+/* left: user calibration (centre 2048, +-1600); right: factory
+ * (centre 2000/2100, below 1400/1450, above 1550/1500); IMU: the factory
+ * example from dekuNukem's SPI notes; no user IMU calibration. */
+static void fake_flash_default(void)
+{
+    u16 lf[6] = { 1500, 1450, 2050, 1980, 1520, 1490 };     /* X/Y above, centre, below */
+    u16 rf[6] = { 2000, 2100, 1400, 1450, 1550, 1500 };     /* X/Y centre, below, above */
+    pack12(F.flash + 0x603D, lf);
+    pack12(F.flash + 0x6046, rf);
+    u16 lu[6] = { 1600, 1600, 2048, 2048, 1600, 1600 };
+    F.flash[0x8010] = 0xB2; F.flash[0x8011] = 0xA1;
+    pack12(F.flash + 0x8012, lu);
+    static const u8 imu[24] = { 0xD3, 0xFF, 0xD5, 0xFF, 0x55, 0x01, 0x00, 0x40, 0x00, 0x40, 0x00, 0x40,
+                                0x19, 0x00, 0xDD, 0xFF, 0xDC, 0xFF, 0x3B, 0x34, 0x3B, 0x34, 0x3B, 0x34 };
+    memcpy(F.flash + 0x6020, imu, 24);
+}
+
+static void dev_init(PadHostDevice* d, int bus, int port)
+{
+    memset(d, 0, sizeof *d);
+    d->bus = bus;
+    d->vid = 0x057E; d->pid = 0x2009;
+    d->usage_page = 1; d->usage = 5;
+    d->in_len = 64;
+    d->out_len = bus == PADHOST_BUS_USB ? 64 : 49;
+    d->port = port;
+    d->path = "\\\\?\\hid#vid_057e&pid_2009#fake";
+}
+
+/* 0x30 report with the given button bytes, 12-bit sticks and one IMU sample
+ * repeated three times. */
+static void mk_full(u8* r, u8 right, u8 shared, u8 left, const int st[4], const int acc[3], const int gyr[3])
+{
+    memset(r, 0, 64);
+    r[0] = 0x30; r[1] = 0x10; r[2] = 0x90;
+    r[3] = right; r[4] = shared; r[5] = left;
+    r[6] = (u8)(st[0] & 0xFF); r[7] = (u8)((st[0] >> 8) | ((st[1] & 0xF) << 4)); r[8] = (u8)(st[1] >> 4);
+    r[9] = (u8)(st[2] & 0xFF); r[10] = (u8)((st[2] >> 8) | ((st[3] & 0xF) << 4)); r[11] = (u8)(st[3] >> 4);
+    for (int s = 0; s < 3; s++)
+        for (int i = 0; i < 3; i++) {
+            put_le16(r + 13 + s * 12 + i * 2, acc[i]);
+            put_le16(r + 13 + s * 12 + 6 + i * 2, gyr[i]);
+        }
+}
+
+static int count_writes(u8 id) { int n = 0; for (int i = 0; i < F.nw; i++) n += F.w[i].b[0] == id; return n; }
+
+/* ---- tests --------------------------------------------------------------- */
+
+static void test_packets(void)
+{
+    u8 out[64], args[5] = { 0x3D, 0x60, 0x00, 0x00, 0x12 };
+    sw_pkt_subcmd(out, 49, 0x13, sw_neutral_rumble, 0x10, args, 5);
+    CHECK_EQ(out[0], 0x01);
+    CHECK_EQ(out[1], 0x03);                         /* counter is 4 bits */
+    CHECK(!memcmp(out + 2, "\x00\x01\x40\x40\x00\x01\x40\x40", 8));
+    CHECK_EQ(out[10], 0x10);
+    CHECK(!memcmp(out + 11, args, 5));
+    int zero = 1;
+    for (int i = 16; i < 49; i++) zero &= out[i] == 0;
+    CHECK(zero);
+
+    sw_pkt_rumble(out, 64, 7, sw_neutral_rumble);
+    CHECK_EQ(out[0], 0x10);
+    CHECK_EQ(out[1], 7);
+    CHECK_EQ(out[10], 0);
+
+    /* lights: DS3 port numbering */
+    CHECK_EQ(sw_port_lights(0), 0x01); CHECK_EQ(sw_port_lights(1), 0x02);
+    CHECK_EQ(sw_port_lights(2), 0x04); CHECK_EQ(sw_port_lights(3), 0x08);
+    CHECK_EQ(sw_port_lights(4), 0x09); CHECK_EQ(sw_port_lights(5), 0x0A);
+    CHECK_EQ(sw_port_lights(6), 0x0C); CHECK_EQ(sw_port_lights(-1), 0x00);
+    CHECK_EQ(sw_port_lights(7), 0x00);
+
+    u8 h[4];
+    sw_home_light_args(h, 6);
+    CHECK_EQ(h[0], 0x01); CHECK_EQ(h[1], 0x60); CHECK_EQ(h[2], 0x60); CHECK_EQ(h[3], 0x00);
+    sw_home_light_args(h, 0);
+    CHECK_EQ(h[1], 0x00); CHECK_EQ(h[2], 0x00);
+}
+
+static void test_rumble_encoding(void)
+{
+    CHECK_EQ(sw_amp_code(0.0f), 0);
+    CHECK_EQ(sw_amp_code(-1.0f), 0);
+    CHECK_EQ(sw_amp_code(1.0f), 100);
+    CHECK_EQ(sw_amp_code(2.0f), 100);
+    CHECK_EQ(sw_amp_code(0.5f), 68);
+    CHECK_EQ(sw_amp_code(0.23f), 31);
+    CHECK_EQ(sw_amp_code(0.12f), 16);
+    CHECK_EQ(sw_amp_code(0.001f), 1);           /* any non-zero amplitude is audible */
+    int prev = 0, mono = 1, smooth = 1;
+    for (int i = 1; i <= 1000; i++) {
+        int c = sw_amp_code((float)i / 1000.0f);
+        if (c < prev) mono = 0;
+        if (i > 10 && c - prev > 2) smooth = 0;
+        prev = c;
+    }
+    CHECK(mono);
+    CHECK(smooth);
+
+    u8 r[8];
+    sw_rumble_bytes(r, 0, 0);
+    CHECK(!memcmp(r, sw_neutral_rumble, 8));
+    sw_encode_rumble(r, 1.0f, 1.0f);
+    CHECK_EQ(r[0], 0x00); CHECK_EQ(r[1], 0xC9); CHECK_EQ(r[2], 0x40); CHECK_EQ(r[3], 0x72);
+    sw_rumble_bytes(r, 1, 200);                 /* hi 0.6 -> 76, lo 200/255 -> 89 (odd) */
+    CHECK_EQ(r[1], (76 * 2) | 1);
+    CHECK_EQ(r[2], 0x40 | 0x80);
+    CHECK_EQ(r[3], 0x40 + 44);
+    CHECK(!memcmp(r, r + 4, 4));                /* both actuators */
+    sw_rumble_bytes(r, 0, 255);
+    CHECK_EQ(r[1], 0x01);                       /* high band silent */
+    CHECK_EQ(r[3], 0x72);
+}
+
+static void test_calibration_decode(void)
+{
+    SwPriv p;
+    memset(&p, 0, sizeof p);
+    sw_default_cal(&p);
+    u8 c[9];
+    u16 lf[6] = { 1500, 1450, 2050, 1980, 1520, 1490 };
+    pack12(c, lf);
+    CHECK(sw_decode_stick(&p, 0, c));
+    CHECK_EQ(p.stick[0][0].above, 1500); CHECK_EQ(p.stick[0][1].above, 1450);
+    CHECK_EQ(p.stick[0][0].center, 2050); CHECK_EQ(p.stick[0][1].center, 1980);
+    CHECK_EQ(p.stick[0][0].below, 1520); CHECK_EQ(p.stick[0][1].below, 1490);
+    u16 rf[6] = { 2000, 2100, 1400, 1450, 1550, 1500 };
+    pack12(c, rf);
+    CHECK(sw_decode_stick(&p, 1, c));
+    CHECK_EQ(p.stick[1][0].center, 2000); CHECK_EQ(p.stick[1][1].center, 2100);
+    CHECK_EQ(p.stick[1][0].below, 1400); CHECK_EQ(p.stick[1][1].below, 1450);
+    CHECK_EQ(p.stick[1][0].above, 1550); CHECK_EQ(p.stick[1][1].above, 1500);
+    /* erased flash (0xFFF everywhere) is rejected and leaves the stick alone */
+    memset(c, 0xFF, 9);
+    CHECK(!sw_decode_stick(&p, 1, c));
+    CHECK_EQ(p.stick[1][0].center, 2000);
+
+    /* stick math */
+    SwAxisCal a = { 2048, 1600, 1600 };
+    CHECK_EQ(sw_stick_u8(&a, 2048, 0), 128);
+    CHECK_EQ(sw_stick_u8(&a, 2048 + 1600, 0), 255);
+    CHECK_EQ(sw_stick_u8(&a, 2048 - 1600, 0), 0);
+    CHECK_EQ(sw_stick_u8(&a, 4095, 0), 255);    /* past the calibrated range: clamped */
+    CHECK_EQ(sw_stick_u8(&a, 0, 0), 0);
+    CHECK_EQ(sw_stick_u8(&a, 2048 + 800, 0), 192);
+    CHECK_EQ(sw_stick_u8(&a, 2048 - 800, 0), 64);
+    CHECK_EQ(sw_stick_u8(&a, 2048 + 1600, 1), 0);   /* Y: up = 0 */
+    CHECK_EQ(sw_stick_u8(&a, 2048 - 1600, 1), 255);
+    CHECK_EQ(sw_stick_u8(&a, 2048 + 3, 0), 128);    /* jitter stays centred */
+    CHECK_EQ(sw_stick_u8(&a, 2048 - 3, 1), 128);
+
+    /* IMU calibration: the example block, and an implausible one rejected */
+    static const u8 imu[24] = { 0xD3, 0xFF, 0xD5, 0xFF, 0x55, 0x01, 0x00, 0x40, 0x00, 0x40, 0x00, 0x40,
+                                0x19, 0x00, 0xDD, 0xFF, 0xDC, 0xFF, 0x3B, 0x34, 0x3B, 0x34, 0x3B, 0x34 };
+    CHECK(sw_decode_imu(&p, imu));
+    CHECK_EQ((int)p.acc_off[0], -45); CHECK_EQ((int)p.acc_off[2], 341);
+    CHECK_EQ((int)p.gyro_off[0], 25); CHECK_EQ((int)p.gyro_off[1], -35);
+    CHECK(fabsf(p.acc_k[2] - 4.0f / (16384.0f - 341.0f)) < 1e-9f);
+    CHECK(fabsf(p.gyro_k[1] - 936.0f / (13371.0f + 35.0f)) < 1e-9f);
+    u8 bad[24];
+    memset(bad, 0xFF, sizeof bad);
+    CHECK(!sw_decode_imu(&p, bad));
+    CHECK_EQ((int)p.acc_off[2], 341);           /* unchanged */
+}
+
+static void test_open_usb(void)
+{
+    PadHostDevice d;
+    fake_reset();
+    fake_flash_default();
+    F.usb_answers = 1;
+    F.chatty = 1;
+    g_cfg_layout = NULL;
+    dev_init(&d, PADHOST_BUS_USB, 2);
+    CHECK_EQ(padhost_drv_switchpro.match(&d), 100);
+    CHECK_EQ(padhost_drv_switchpro.open(&d), 0);
+    SwPriv* p = sw_priv(&d);
+
+    /* USB handshake: status, handshake, 3 Mbit, handshake, no-timeout */
+    static const u8 usb_seq[5] = { 0x01, 0x02, 0x03, 0x02, 0x04 };
+    CHECK_EQ(count_writes(0x80), 5);
+    for (int i = 0; i < 5; i++) { CHECK_EQ(F.w[i].b[0], 0x80); CHECK_EQ(F.w[i].b[1], usb_seq[i]); }
+    for (int i = 0; i < F.nw; i++) CHECK_EQ(F.w[i].len, 64);      /* output report length */
+
+    /* subcommands in order, counter 0, 1, 2, ... */
+    static const u8 sub_seq[10] = { 0x02, 0x10, 0x10, 0x10, 0x10, 0x48, 0x40, 0x03, 0x30, 0x38 };
+    CHECK_EQ(count_writes(0x01), 10);
+    for (int i = 0; i < 10 && 5 + i < F.nw; i++) {
+        const u8* w = F.w[5 + i].b;
+        CHECK_EQ(w[0], 0x01);
+        CHECK_EQ(w[1], i & 0xF);
+        CHECK_EQ(w[10], sub_seq[i]);
+        CHECK(!memcmp(w + 2, sw_neutral_rumble, 8));
+    }
+    /* SPI reads: address LE + length */
+    CHECK(!memcmp(F.w[6].b + 11, "\x3D\x60\x00\x00\x12", 5));
+    CHECK(!memcmp(F.w[7].b + 11, "\x10\x80\x00\x00\x16", 5));
+    CHECK(!memcmp(F.w[8].b + 11, "\x20\x60\x00\x00\x18", 5));
+    CHECK(!memcmp(F.w[9].b + 11, "\x26\x80\x00\x00\x1A", 5));
+
+    CHECK_EQ(F.mode, 0x30);
+    CHECK_EQ(F.imu, 1);
+    CHECK_EQ(F.vib, 1);
+    CHECK_EQ(F.lights, 0x04);                   /* port 2 = third light */
+    CHECK(F.home0 == 0x01 && (F.home1 >> 4) > 0);
+    CHECK_EQ(F.handshakes, 2);
+    CHECK_EQ(p->usb, 1);
+    CHECK_EQ(p->mode_set, 1);
+    CHECK_EQ(p->imu_on, 1);
+    CHECK_EQ(p->fw_major, 4); CHECK_EQ(p->fw_minor, 0x21);
+    CHECK_STR(d.serial, "98b6e9000001");       /* the Bluetooth address from device info */
+    CHECK_EQ(d.out_refresh_ms, SW_RUMBLE_REFRESH_MS);
+    CHECK_EQ(p->sent_port, 2);
+    CHECK_EQ(p->counter, 10);
+    /* left from the user block, right from factory */
+    CHECK_EQ(p->stick[0][0].center, 2048); CHECK_EQ(p->stick[0][0].above, 1600);
+    CHECK_EQ(p->stick[1][1].center, 2100); CHECK_EQ(p->stick[1][1].above, 1500);
+    CHECK(strstr(p->cal_src, "user/factory") != NULL);
+    CHECK(strstr(p->cal_src, "IMU factory") != NULL);
+
+    /* ---- 0x30 parsing ---- */
+    PadHostPortState st;
+    memset(&st, 0, sizeof st);
+    u8 r[64];
+    int sticks[4] = { 2048, 2048, 2000, 2100 };
+    int acc[3] = { -45, -43, 4352 };            /* flat: +1 G on Z */
+    int gyr[3] = { 25, -35, -36 };              /* at rest: the offsets */
+    mk_full(r, 0, 0, 0, sticks, acc, gyr);
+    CHECK_EQ(padhost_drv_switchpro.parse(&d, r, 64, &st), 1);
+    CHECK_EQ(st.connected, 1);
+    CHECK_EQ(st.kind, PADHOST_KIND_SWITCH_PRO);
+    CHECK_EQ(st.bus, PADHOST_BUS_USB);
+    CHECK_EQ(st.vid, 0x057E); CHECK_EQ(st.pid, 0x2009);
+    CHECK_EQ(st.buttons, 0);
+    CHECK_EQ(st.ps, 0);
+    CHECK_EQ(st.lx, 128); CHECK_EQ(st.ly, 128); CHECK_EQ(st.rx, 128); CHECK_EQ(st.ry, 128);
+    CHECK_EQ(st.has_motion, 1);
+    CHECK_EQ(st.has_pressure, 0);
+    CHECK_EQ(st.sensor_x, 512); CHECK_EQ(st.sensor_y, 399); CHECK_EQ(st.sensor_z, 512); CHECK_EQ(st.sensor_g, 512);
+    CHECK_EQ(st.battery, 100);
+    CHECK_EQ(st.seq, 0);                        /* the pad host's to bump */
+
+    /* yaw +90 deg/s about the Switch Z axis, nose up 1 G on X */
+    gyr[2] = 1253;
+    acc[0] = 4062; acc[2] = 341;
+    mk_full(r, 0, 0, 0, sticks, acc, gyr);
+    padhost_drv_switchpro.parse(&d, r, 64, &st);
+    CHECK_EQ(st.sensor_g, 389);
+    CHECK_EQ(st.sensor_z, 625);
+    CHECK_EQ(st.sensor_y, 512);
+
+    /* buttons: B A Y X by position; ZL ZR L R; minus plus capture home; sticks; d-pad */
+    int s2[4] = { 2048 + 1600, 2048 + 1600, 2000 - 700, 2100 + 1500 };
+    mk_full(r, 0x04 /* B */ | 0x40 /* R */, 0x01 /* - */ | 0x10 /* HOME */ | 0x08 /* LS */,
+            0x02 /* up */ | 0x80 /* ZL */, s2, acc, gyr);
+    padhost_drv_switchpro.parse(&d, r, 64, &st);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CROSS | CELL_PAD_CTRL_R1 | CELL_PAD_CTRL_SELECT |
+                         CELL_PAD_CTRL_L3 | CELL_PAD_CTRL_UP | CELL_PAD_CTRL_L2);
+    CHECK_EQ(st.ps, 1);
+    CHECK_EQ(st.lx, 255); CHECK_EQ(st.ly, 0);   /* full right, full up */
+    CHECK_EQ(st.rx, 64);  CHECK_EQ(st.ry, 0);
+    CHECK_EQ(st.press[6], 255);                 /* cross */
+    CHECK_EQ(st.press[10], 255);                /* l2 */
+    CHECK_EQ(st.press[2], 255);                 /* up */
+    CHECK_EQ(st.press[5], 0);                   /* circle */
+    CHECK_EQ(st.press[11], 0);                  /* r2 */
+
+    mk_full(r, 0x08 /* A */ | 0x02 /* X */ | 0x01 /* Y */ | 0x80 /* ZR */, 0x02 /* + */ | 0x20 /* capture */ | 0x04,
+            0x01 | 0x04 | 0x08 | 0x40, sticks, acc, gyr);
+    padhost_drv_switchpro.parse(&d, r, 64, &st);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CIRCLE | CELL_PAD_CTRL_TRIANGLE | CELL_PAD_CTRL_SQUARE |
+                         CELL_PAD_CTRL_R2 | CELL_PAD_CTRL_START | CELL_PAD_CTRL_SELECT |
+                         CELL_PAD_CTRL_R3 | CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_RIGHT |
+                         CELL_PAD_CTRL_LEFT | CELL_PAD_CTRL_L1);
+
+    /* 0x21 (a subcommand reply) carries input but no IMU: motion kept */
+    u8 rr[64];
+    memset(rr, 0, sizeof rr);
+    rr[0] = 0x21;
+    fake_input_bytes(rr);
+    rr[3] = 0x04;
+    CHECK_EQ(padhost_drv_switchpro.parse(&d, rr, 64, &st), 1);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CROSS);
+    CHECK_EQ(st.sensor_g, 389);
+    CHECK_EQ(st.has_motion, 1);
+
+    /* not input */
+    u8 junk[64] = { 0x81, 0x01 };
+    CHECK_EQ(padhost_drv_switchpro.parse(&d, junk, 64, &st), 0);
+    CHECK_EQ(padhost_drv_switchpro.parse(&d, r, 10, &st), 0);   /* truncated */
+
+    /* ---- build_output: what the pad host gets when it asks ---- */
+    u8 out[128];
+    g_now += 1000;
+    int n = padhost_drv_switchpro.build_output(&d, 1, 200, 2, out, sizeof out);
+    CHECK_EQ(n, 64);
+    CHECK_EQ(out[0], 0x10);
+    CHECK_EQ(out[1], 10);                       /* counter continues from open() */
+    CHECK_EQ(out[3], (76 * 2) | 1);
+    CHECK_EQ(out[5], 0x40 + 44);
+    CHECK(!memcmp(out + 2, out + 6, 4));
+    g_now += 10;                                /* a change 10 ms later: skipped ... */
+    CHECK_EQ(padhost_drv_switchpro.build_output(&d, 1, 100, 2, out, sizeof out), 0);
+    g_now += SW_RUMBLE_REFRESH_MS;              /* ... the refresh brings it */
+    n = padhost_drv_switchpro.build_output(&d, 1, 100, 2, out, sizeof out);
+    CHECK_EQ(n, 64);
+    CHECK_EQ(out[1], 11);
+    CHECK_EQ(out[5], 0x40 + sw_amp_code(100.0f / 255.0f) / 2);
+    g_now += SW_RUMBLE_REFRESH_MS;
+    n = padhost_drv_switchpro.build_output(&d, 1, 100, 2, out, sizeof out);
+    CHECK_EQ(n, 64);                            /* a refresh is never skipped */
+    CHECK_EQ(out[1], 12);
+    g_now += 5;
+    n = padhost_drv_switchpro.build_output(&d, 1, 100, 5, out, sizeof out);
+    CHECK_EQ(n, 64);                            /* port change: lights subcommand with the rumble, at once */
+    CHECK_EQ(out[0], 0x01);
+    CHECK_EQ(out[1], 13);
+    CHECK_EQ(out[10], 0x30);
+    CHECK_EQ(out[11], 0x0A);
+    CHECK_EQ(out[3], (76 * 2) | 1);
+    g_now += 1;
+    n = padhost_drv_switchpro.build_output(&d, 0, 0, 5, out, sizeof out);
+    CHECK_EQ(n, 64);                            /* a stop goes out at once too */
+    CHECK_EQ(out[0], 0x10);
+    CHECK(!memcmp(out + 2, sw_neutral_rumble, 8));
+    CHECK_EQ(padhost_drv_switchpro.build_output(&d, 0, 0, 5, out, 8), 0);            /* no room */
+
+    /* ---- close ---- */
+    F.nw = 0;
+    padhost_drv_switchpro.close(&d);
+    CHECK_EQ(F.nw, 4);
+    CHECK_EQ(F.w[0].b[0], 0x10);
+    CHECK(!memcmp(F.w[0].b + 2, sw_neutral_rumble, 8));
+    CHECK_EQ(F.w[1].b[10], 0x38); CHECK_EQ(F.w[1].b[12], 0x00);
+    CHECK_EQ(F.w[2].b[10], 0x30); CHECK_EQ(F.w[2].b[11], 0x00);
+    CHECK_EQ(F.w[3].b[10], 0x03); CHECK_EQ(F.w[3].b[11], 0x3F);
+    CHECK_EQ(F.mode, 0x3F);
+    for (int i = 1; i < 4; i++) CHECK_EQ(F.w[i].b[1], (F.w[i - 1].b[1] + 1) & 0xF);
+}
+
+static void test_open_bt_and_labels(void)
+{
+    PadHostDevice d;
+    fake_reset();
+    fake_flash_default();
+    F.usb_answers = 1;                          /* would answer, but must not be asked */
+    g_cfg_layout = "label";
+    dev_init(&d, PADHOST_BUS_BT, 0);
+    CHECK_EQ(padhost_drv_switchpro.open(&d), 0);
+    SwPriv* p = sw_priv(&d);
+    CHECK_EQ(count_writes(0x80), 0);
+    CHECK_EQ(count_writes(0x01), 10);
+    for (int i = 0; i < F.nw; i++) CHECK_EQ(F.w[i].len, 49);
+    CHECK_EQ(p->usb, 0);
+    CHECK_EQ(p->labels, 1);
+    CHECK_EQ(F.lights, 0x01);
+
+    PadHostPortState st;
+    memset(&st, 0, sizeof st);
+    u8 r[64];
+    int sticks[4] = { 2048, 2048, 2000, 2100 }, acc[3] = { 0, 0, 4096 }, gyr[3] = { 0, 0, 0 };
+    mk_full(r, 0x08 /* A */, 0, 0, sticks, acc, gyr);
+    padhost_drv_switchpro.parse(&d, r, 64, &st);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CROSS);  /* by label: A = Cross */
+    CHECK_EQ(st.bus, PADHOST_BUS_BT);
+    mk_full(r, 0x04 /* B */ | 0x02 /* X */ | 0x01 /* Y */, 0, 0, sticks, acc, gyr);
+    padhost_drv_switchpro.parse(&d, r, 64, &st);
+    CHECK_EQ(st.buttons, CELL_PAD_CTRL_CIRCLE | CELL_PAD_CTRL_SQUARE | CELL_PAD_CTRL_TRIANGLE);
+
+    /* the same pacing on Bluetooth; packets are the Bluetooth output length */
+    u8 out[128];
+    g_now += 1000;
+    int n = padhost_drv_switchpro.build_output(&d, 0, 255, 0, out, sizeof out);
+    CHECK_EQ(n, 49);
+    CHECK_EQ(out[0], 0x10);
+    g_now += SW_MIN_GAP_MS - 1;
+    CHECK_EQ(padhost_drv_switchpro.build_output(&d, 1, 255, 0, out, sizeof out), 0);
+    g_now += 1;
+    CHECK_EQ(padhost_drv_switchpro.build_output(&d, 1, 255, 0, out, sizeof out), 49);
+    g_cfg_layout = NULL;
+}
+
+static void test_bus_probe(void)
+{
+    PadHostDevice d;
+    fake_reset();
+    fake_flash_default();
+    F.usb_answers = 1;
+    dev_init(&d, PADHOST_BUS_OTHER, 1);
+    padhost_drv_switchpro.open(&d);
+    CHECK_EQ(sw_priv(&d)->usb, 1);
+    CHECK_EQ(count_writes(0x80), 5);            /* the probe's status + the rest */
+
+    fake_reset();
+    fake_flash_default();
+    F.usb_answers = 0;                          /* a Bluetooth pad never answers 0x80 */
+    dev_init(&d, PADHOST_BUS_OTHER, 1);
+    padhost_drv_switchpro.open(&d);
+    CHECK_EQ(sw_priv(&d)->usb, 0);
+    CHECK_EQ(count_writes(0x80), 1);
+    CHECK_EQ(sw_priv(&d)->mode_set, 1);
+}
