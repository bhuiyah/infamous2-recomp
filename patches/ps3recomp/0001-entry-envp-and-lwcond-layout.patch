+/* FP_PACK=0: leave the pack/unpack ops unhandled again (the old output). */
+static int fp_pack_enabled(void)
+{
+    static int en = -1;
+    if (en < 0) { const char* e = getenv("FP_PACK"); en = (e && *e == '0') ? 0 : 1; }
+    return en;
+}
