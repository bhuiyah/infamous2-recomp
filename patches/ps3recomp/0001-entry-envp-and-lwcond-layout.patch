+/* The Empire City gate pillar (2026-10-15): the deferred sun pass 6B8AE6FE
+ * (title census 6BFFD9CDF07FC47D) feeds the sun's N.L, H5.z = dot(N, -sun),
+ * through the source SATURATE in two places:
+ *   op 40  MAD_H H7.w, H1, H0, H5.zzzz[src2 sat]       sun weight
+ *          = sat(-N.L) * k + sat(N.L), k = 0 or 0.5 (a back-light material bit)
+ *   op 43  MUL_H H1.w, H5.zzzz[src0 sat], c(0,0,0,129) specular gate
+ * Without the modifier a sun-visible face turned away from the sun (the
+ * pillar's left face, N.L = -0.85) got the warm sun colour times a NEGATIVE
+ * weight, which drove red and blue below zero and left it green. Hand-built
+ * from the census disassembly (word fields as in rsx_fp_decompiler.c). */
+static void test_gate_pillar(void)
+{
+    static char h[16384];
+    static const float k129[4] = { 0.0f, 0.0f, 0.0f, 129.0f };
+    const u32 zzzz = (2u << 9) | (2u << 11) | (2u << 13) | (2u << 15);
+    set_env("FP_SRCPREC", NULL);
+    /* op 40 */
+    const u32 a0 = OPC(0x04) | (1u << 12) | OUTREG(7) | OUTHALF | END;
+    const u32 a1 = T_TEMP | REG(1) | SRC_HALF | SWZ_IDENT | EXEC_ALWAYS;
+    const u32 a2 = T_TEMP | REG(0) | SRC_HALF | SWZ_IDENT | SRCMOD(2, 4);
+    const u32 a3 = T_TEMP | REG(5) | SRC_HALF | zzzz;
+    fp_one(a0, a1, a2, a3, NULL, CTRL_16BIT, h, sizeof h);
+    check("pillar_op40_sun_weight_sat", h, "(float4)(((h[1]).xyzw) * ((h[0]).xyzw) + (saturate((h[5]).zzzz)));");
+    /* op 43 */
+    const u32 b0 = OPC(0x02) | (1u << 12) | OUTREG(1) | OUTHALF | END;
+    const u32 b1 = T_TEMP | REG(5) | SRC_HALF | zzzz | EXEC_ALWAYS;
+    const u32 b2 = T_CONST | SWZ_IDENT | SRCMOD(0, 4);
+    fp_one(b0, b1, b2, 0, k129, CTRL_16BIT, h, sizeof h);
+    check("pillar_op43_spec_gate_sat", h, "(float4)((saturate((h[5]).zzzz)) * ((float4(0,0,0,129)).xyzw));");
+    /* FP_SRCPREC=0 is the green pillar's text */
+    set_env("FP_SRCPREC", "0");
+    fp_one(a0, a1, a2, a3, NULL, CTRL_16BIT, h, sizeof h);
+    check("pillar_op40_off", h, "(float4)(((h[1]).xyzw) * ((h[0]).xyzw) + ((h[5]).zzzz));");
+    fp_one(b0, b1, b2, 0, k129, CTRL_16BIT, h, sizeof h);
+    check("pillar_op43_off", h, "(float4)(((h[5]).zzzz) * ((float4(0,0,0,129)).xyzw));");
+    set_env("FP_SRCPREC", NULL);
+    /* the modifier sits in SRC1 for all three sources: src2's field set on
+     * op 40 must not saturate src0/src1, nor src0's on op 43 the constant */
+    fp_one(a0, a1, a2, a3, NULL, CTRL_16BIT, h, sizeof h);
+    check_absent("pillar_op40_only_src2", h, "saturate((h[1])");
+    check_absent("pillar_op40_only_src2_b", h, "saturate((h[0])");
+    fp_one(b0, b1, b2, 0, k129, CTRL_16BIT, h, sizeof h);
+    check_absent("pillar_op43_only_src0", h, "saturate((float4(0,0,0,129))");
+}
