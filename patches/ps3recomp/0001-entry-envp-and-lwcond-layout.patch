+    d = new_dev(0x0268, PADHOST_BUS_USB, 37, 0, 0);    CHECK(padhost_drv_ds3.match(d) > 0);   /* SDF */
+    d = new_dev(0x0268, PADHOST_BUS_USB, 15, 0, 0);    CHECK_EQ(padhost_drv_ds3.match(d), 0); /* unknown: generic's */
+    d = new_dev(0x0CE6, PADHOST_BUS_USB, 64, 48, 64);  d->vid = 0x045E; CHECK_EQ(padhost_drv_dualsense.match(d), 0);
