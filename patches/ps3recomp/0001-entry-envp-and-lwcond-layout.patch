+/* ---------------------------------------------------------------------------
+ * Save state: SPUG, the lv2 SPU thread groups and threads
+ * (runtime/savestate/ss_state.h; engine design 5.2 / 6.2)
+ *
+ * Both tables slot by slot -- a group or a thread keeps its table index (the
+ * record's key) and its id, so a group's thread_indices stay true -- with
+ * their plain fields: ids, names, the image (the sys_spu_image EA and entry;
+ * the image and its segment table are guest memory, GMEM), the arguments lv2
+ * copied, exit status and cause, spu_cfg, the inbound-mailbox word waiting
+ * for a re-run, and every event binding as a queue id (connected_queue,
+ * evt_bind, q_bind, the group's event queue and user-event ports). Never a
+ * pointer or a handle: the context (SPUC has it, keyed by the tid), the host
+ * thread, the finish event, the PPU-fallback handler and its argument, a
+ * lazily allocated local store. What each of those stood for is a value in
+ * "thread_hosts" -- how group_start runs the thread, whether it has a
+ * context -- and a local store is a blob "ls.<tid>" here. The id counters
+ * and the image loader's two guest scratch bumps are statics ("lv2_spu").
+ *
+ * A LOAD (M4c; ss_state.h "THE LOAD", the section contract): TEARDOWN runs
+ * with every SPU host thread discarded -- returned at its discard root -- so
+ * the tables are the coordinator's alone. It closes each slot's host thread
+ * and finish event, frees the local stores and the contexts (each out of the
+ * lock-line notify registry first; SPUC's teardown empties the MFC table)
+ * and leaves the tables and the counters as at boot. RESTORE puts every
+ * group and thread back at its slot with the image's values, fb_handler from
+ * run_kind (spu_registry_fallback with fb_fp as its argument,
+ * spu_interp_fallback, or spu_lookup_ppu_fallback(entry_point) and the user
+ * pointer it returns) and a context-less thread's local store from its blob;
+ * SPUC's restore then hands each lifted thread its context. No host thread
+ * and no finish event: RECREATE (lv2_spu_ss_recreate) starts every running
+ * thread on its context and makes the event then (engine design 4.3 step
+ * 5); a thread that is not running has nobody waiting on one (group_join
+ * waits for running threads only; group_start makes the event it needs).
+ * live_ctx is NULL. lv2_spu_bound_queue finds a thread by its context
+ * pointer, so it follows the recreated context by itself. check_image
+ * refuses, before anything stops, tables that do not hold together, a
+ * running thread with no context (nothing a load can resume) and a handler
+ * or workload image this build does not have.
+ * -----------------------------------------------------------------------*/
+static const ss_field k_spug_fields[] = {
+    SS_FIELD(s_spu_next_group_id), SS_FIELD(s_spu_next_thread_id), SS_FIELD(s_spu_initialized),
+    SS_FIELD(s_spu_seg_bump), SS_FIELD(s_spu_img_bump),
+};
+static const ss_list k_spug_list = SS_LIST("lv2_spu", k_spug_fields);
+
+static const ss_field k_spug_group_fields[] = {
+    SS_MEMBER(spu_group_t, id), SS_MEMBER(spu_group_t, state), SS_MEMBER(spu_group_t, num_threads),
+    SS_MEMBER(spu_group_t, thread_indices), SS_MEMBER(spu_group_t, name),
+    SS_MEMBER(spu_group_t, exit_status), SS_MEMBER(spu_group_t, cause),
+    SS_MEMBER(spu_group_t, event_queue_id), SS_MEMBER(spu_group_t, user_event_ports),
+};
+static const ss_list k_spug_group_list = SS_LIST("groups", k_spug_group_fields);
+
+static const ss_field k_spug_thread_fields[] = {
+    SS_MEMBER(spu_thread_t, tid), SS_MEMBER(spu_thread_t, group_id), SS_MEMBER(spu_thread_t, index),
+    SS_MEMBER(spu_thread_t, exit_status), SS_MEMBER(spu_thread_t, entry_point),
+    SS_MEMBER(spu_thread_t, args_ea), SS_MEMBER(spu_thread_t, args_size), SS_MEMBER(spu_thread_t, args),
+    SS_MEMBER(spu_thread_t, img_ea), SS_MEMBER(spu_thread_t, spu_cfg), SS_MEMBER(spu_thread_t, running),
+    SS_MEMBER(spu_thread_t, pending_inmbox), SS_MEMBER(spu_thread_t, connected_queue),
+    SS_MEMBER(spu_thread_t, connect_spup), SS_MEMBER(spu_thread_t, evt_bind),
+    SS_MEMBER(spu_thread_t, evt_bind_n), SS_MEMBER(spu_thread_t, q_bind),
+    SS_MEMBER(spu_thread_t, q_bind_n),
+};
+static const ss_list k_spug_thread_list = SS_LIST("threads", k_spug_thread_fields);
+
+/* What a thread's host-side members stood for, as values. */
+enum {
+    LV2_SPU_RUN_NONE = 0,   /* no handler: never started, or completed at once */
+    LV2_SPU_RUN_LIFTED,     /* its own lifted image on its own context (sctx) */
+    LV2_SPU_RUN_REGISTRY,   /* spu_registry_fallback, a workload-registry worker */
+    LV2_SPU_RUN_INTERP,     /* spu_interp_fallback (RD_SPU_INTERP) */
+    LV2_SPU_RUN_FALLBACK    /* a PPU fallback found by entry point (spu_lookup_ppu_fallback) */
+};
+typedef struct lv2_spu_ss_host {
+    uint32_t tid;
+    uint32_t run_kind;      /* LV2_SPU_RUN_* */
+    uint32_t has_ctx;       /* sctx: SPUC's record `tid` */
+    uint32_t has_ls;        /* local_store (no context): blob "ls.<tid>" in this section */
+    uint64_t fb_fp;         /* RUN_REGISTRY: the image fingerprint its handler was given */
+} lv2_spu_ss_host;
+static const ss_field k_spug_host_fields[] = {
+    SS_MEMBER(lv2_spu_ss_host, tid), SS_MEMBER(lv2_spu_ss_host, run_kind),
+    SS_MEMBER(lv2_spu_ss_host, has_ctx), SS_MEMBER(lv2_spu_ss_host, has_ls),
+    SS_MEMBER(lv2_spu_ss_host, fb_fp),
+};
+static const ss_list k_spug_host_list = SS_LIST("thread_hosts", k_spug_host_fields);
+static const ss_list* const k_spug_lists[] = {
+    &k_spug_list, &k_spug_group_list, &k_spug_thread_list, &k_spug_host_list, NULL
+};
+
+/* "ls.2000", a blob's name, without printf (everything is parked). */
+static const char* lv2_spu_ss_ls_name(char b[16], uint32_t tid)
+{
+    static const char k_hex[] = "0123456789ABCDEF";
+    char d[8];
+    int n = 0;
+    do { d[n++] = k_hex[tid & 15u]; tid >>= 4; } while (tid && n < 8);
+    b[0] = 'l'; b[1] = 's'; b[2] = '.';
+    for (int i = 0; i < n; i++) b[3 + i] = d[n - 1 - i];
+    b[3 + n] = 0;
+    return b;
+}
+
+/* Strict eligibility: no SPU thread whose state lives outside the tables and
+ * a context -- a PPU-fallback or interpreter run on its own host thread, or a
+ * workload worker running on a context on its host stack (live_ctx). The
+ * lifted threads are SPUC's, and ss_core's SPU checks judge where they park. */
+static int spug_check(char* why, size_t n)
+{
+    for (int i = 0; i < MAX_SPU_THREADS; i++) {
+        const spu_thread_t* t = &s_spu_threads[i];
+        if (!t->in_use) continue;
+        if (t->live_ctx) {
+            snprintf(why, n, "SPU 0x%X: a worker run on a context on its host stack", t->tid);
+            return SS_REASON_SPU_EXTRA;
+        }
+        if (t->running && !t->sctx) {
+            snprintf(why, n, "SPU 0x%X: a PPU-fallback run in flight", t->tid);
+            return SS_REASON_SPU_EXTRA;
+        }
+    }
+    return 0;
+}
+
+static int spug_capture(ss_writer* w)
+{
+    ss_write_fields(w, &k_spug_list);
+    ss_recs_begin(w, &k_spug_group_list);
+    for (int i = 0; i < MAX_SPU_GROUPS; i++)
+        if (s_spu_groups[i].in_use) ss_recs_add(w, (uint32_t)i, &s_spu_groups[i]);
+    ss_recs_end(w);
+    ss_recs_begin(w, &k_spug_thread_list);
+    for (int i = 0; i < MAX_SPU_THREADS; i++)
+        if (s_spu_threads[i].in_use) ss_recs_add(w, (uint32_t)i, &s_spu_threads[i]);
+    ss_recs_end(w);
+    ss_recs_begin(w, &k_spug_host_list);
+    for (int i = 0; i < MAX_SPU_THREADS; i++) {
+        const spu_thread_t* t = &s_spu_threads[i];
+        if (!t->in_use) continue;
+        lv2_spu_ss_host h;
+        memset(&h, 0, sizeof h);
+        h.tid = t->tid;
+        h.has_ctx = t->sctx != NULL;
+        h.has_ls = t->local_store != NULL && !t->sctx;
+        if (t->sctx)                                     h.run_kind = LV2_SPU_RUN_LIFTED;
+        else if (t->fb_handler == spu_registry_fallback) h.run_kind = LV2_SPU_RUN_REGISTRY;
+        else if (t->fb_handler == spu_interp_fallback)   h.run_kind = LV2_SPU_RUN_INTERP;
+        else if (t->fb_handler)                          h.run_kind = LV2_SPU_RUN_FALLBACK;
+        if (h.run_kind == LV2_SPU_RUN_REGISTRY) h.fb_fp = (uint64_t)(uintptr_t)t->fb_user;
+        ss_recs_add(w, (uint32_t)i, &h);
+    }
+    ss_recs_end(w);
+    for (int i = 0; i < MAX_SPU_THREADS; i++) {     /* a lazily allocated local store */
+        const spu_thread_t* t = &s_spu_threads[i];
+        if (!t->in_use || !t->local_store || t->sctx) continue;
+        char name[16];
+        ss_blob_begin(w, lv2_spu_ss_ls_name(name, t->tid), 4096);
+        ss_blob_put(w, t->local_store, SPU_LS_SIZE);
+        ss_blob_end(w);
+    }
+    return ss_writer_error(w);
+}
+
+/* The tables come to well under SS_SECTION_SMALL; each local store is 256 KB. */
+static uint64_t spug_size_hint(void)
+{
+    uint64_t n = 0;
+    for (int i = 0; i < MAX_SPU_THREADS; i++)
+        if (s_spu_threads[i].in_use && s_spu_threads[i].local_store && !s_spu_threads[i].sctx) n++;
+    return n * (SPU_LS_SIZE + 8192u) + SS_SECTION_SMALL;
+}
+
+/* An image's thread table as the load's checks see it: per slot, what its
+ * "threads" and "thread_hosts" records say. */
+typedef struct lv2_spu_ss_img {
+    uint8_t  present[MAX_SPU_THREADS];   /* a "threads" record in this slot */
+    uint8_t  running[MAX_SPU_THREADS];
+    uint8_t  kind[MAX_SPU_THREADS];      /* its thread_hosts record: LV2_SPU_RUN_* */
+    uint8_t  has_ctx[MAX_SPU_THREADS];
+    uint8_t  has_ls[MAX_SPU_THREADS];
+    uint32_t tid[MAX_SPU_THREADS];
+    uint32_t entry[MAX_SPU_THREADS];
+    uint64_t fp[MAX_SPU_THREADS];
+} lv2_spu_ss_img;
+
+/* SPUG's thread records into m, checked to hold together: every slot inside
+ * the table and there once, the tids unique, the binding counts within their
+ * arrays, one thread_hosts record per thread with a known run kind, a
+ * context exactly for a lifted thread and a local-store blob only without
+ * one. Reads the image, never the tables. 0, or the refusal (r names it). */
+static int spug_ss_scan(ss_reader* r, lv2_spu_ss_img* m)
+{
+    ss_recs_it it;
+    uint32_t key;
+    int e, k;
+    memset(m, 0, sizeof *m);
+    if ((e = ss_recs_open(r, &k_spug_thread_list, &it)) != 0) return e;
+    for (;;) {
+        spu_thread_t t;
+        memset(&t, 0, sizeof t);
+        if ((k = ss_recs_next(&it, &key, &t)) != 1) break;
+        if (key >= MAX_SPU_THREADS)
+            return ss_reader_fail(r, SS_E_CORRUPT, "threads[%u]: past the table's %d slots", key, MAX_SPU_THREADS);
+        if (m->present[key]) return ss_reader_fail(r, SS_E_CORRUPT, "threads[%u]: twice", key);
+        if (t.evt_bind_n < 0 || t.evt_bind_n > 8 || t.q_bind_n < 0 || t.q_bind_n > 8)
+            return ss_reader_fail(r, SS_E_CORRUPT, "threads[%u]: %d event and %d queue bindings, 8 fit",
+                                  key, t.evt_bind_n, t.q_bind_n);
+        for (uint32_t j = 0; j < MAX_SPU_THREADS; j++)
+            if (m->present[j] && m->tid[j] == t.tid)
+                return ss_reader_fail(r, SS_E_CORRUPT, "threads[%u]: tid 0x%X is slot %u's too", key, t.tid, j);
+        m->present[key] = 1;
+        m->running[key] = t.running != 0;
+        m->tid[key] = t.tid;
+        m->entry[key] = t.entry_point;
+    }
+    if (k < 0) return k;
+    uint8_t seen[MAX_SPU_THREADS];
+    memset(seen, 0, sizeof seen);
+    if ((e = ss_recs_open(r, &k_spug_host_list, &it)) != 0) return e;
+    for (;;) {
+        lv2_spu_ss_host h;
+        memset(&h, 0, sizeof h);
+        if ((k = ss_recs_next(&it, &key, &h)) != 1) break;
+        if (key >= MAX_SPU_THREADS || !m->present[key] || m->tid[key] != h.tid)
+            return ss_reader_fail(r, SS_E_CORRUPT, "thread_hosts[%u]: no thread 0x%X in that slot", key, h.tid);
+        if (seen[key]) return ss_reader_fail(r, SS_E_CORRUPT, "thread_hosts[%u]: twice", key);
+        seen[key] = 1;
+        if (h.run_kind > LV2_SPU_RUN_FALLBACK)
+            return ss_reader_fail(r, SS_E_CORRUPT, "thread_hosts[%u].run_kind: %u, no such kind", key, h.run_kind);
+        if ((h.has_ctx != 0) != (h.run_kind == LV2_SPU_RUN_LIFTED) || (h.has_ctx && h.has_ls))
+            return ss_reader_fail(r, SS_E_CORRUPT, "thread_hosts[%u]: has_ctx %u and has_ls %u with run_kind %u",
+                                  key, h.has_ctx, h.has_ls, h.run_kind);
+        m->kind[key] = (uint8_t)h.run_kind;
+        m->has_ctx[key] = h.has_ctx != 0;
+        m->has_ls[key] = h.has_ls != 0;
+        m->fp[key] = h.fb_fp;
+    }
+    if (k < 0) return k;
+    for (uint32_t j = 0; j < MAX_SPU_THREADS; j++)
+        if (m->present[j] && !seen[j])
+            return ss_reader_fail(r, SS_E_CORRUPT, "threads[%u]: no thread_hosts record", j);
+    return SS_OK;
+}
+
+/* The slot of thread `tid` in m, or -1. */
+static int spug_ss_slot(const lv2_spu_ss_img* m, uint32_t tid)
+{
+    for (int j = 0; j < MAX_SPU_THREADS; j++)
+        if (m->present[j] && m->tid[j] == tid) return j;
+    return -1;
+}
+
+/* One "groups" record: its slot inside the table and there once, its id
+ * unique, every SPU index slot empty or a thread the image has. */
+static int spug_ss_group_ok(ss_reader* r, uint32_t key, const spu_group_t* g, uint8_t* used, uint32_t* ids,
+                            const lv2_spu_ss_img* m)
+{
+    if (key >= MAX_SPU_GROUPS)
+        return ss_reader_fail(r, SS_E_CORRUPT, "groups[%u]: past the table's %d slots", key, MAX_SPU_GROUPS);
+    if (used[key]) return ss_reader_fail(r, SS_E_CORRUPT, "groups[%u]: twice", key);
+    for (uint32_t j = 0; j < MAX_SPU_GROUPS; j++)
+        if (used[j] && ids[j] == g->id)
+            return ss_reader_fail(r, SS_E_CORRUPT, "groups[%u]: id 0x%X is slot %u's too", key, g->id, j);
+    if (g->num_threads > 8)
+        return ss_reader_fail(r, SS_E_CORRUPT, "groups[%u].num_threads: %u, a group holds 8", key, g->num_threads);
+    for (int i = 0; i < 8; i++) {
+        const uint32_t x = g->thread_indices[i];
+        if (x != 0xFFFFFFFFu && (x >= MAX_SPU_THREADS || !m->present[x]))
+            return ss_reader_fail(r, SS_E_CORRUPT, "groups[%u].thread_indices[%d]: %u, no thread there", key, i, x);
+    }
+    used[key] = 1;
+    ids[key] = g->id;
+    return SS_OK;
+}
+
+/* Before a LOAD stops anything: SPUG's tables hold together (spug_ss_scan,
+ * and every group names threads the image has); every running thread runs
+ * on a context -- a PPU-fallback or interpreter run has no state a load can
+ * resume, and a strict save refuses one, so this is a damaged image; every
+ * fallback handler and workload image a thread names exists in this build;
+ * every context-less local store is in the image whole. */
+static int spug_check_image(ss_reader* r)
+{
+    lv2_spu_ss_img m;
+    ss_recs_it it;
+    uint32_t key;
+    int e, k;
+    if ((e = spug_ss_scan(r, &m)) != 0) return e;
+    for (uint32_t i = 0; i < MAX_SPU_THREADS; i++) {
+        if (!m.present[i]) continue;
+        void* user = NULL;
+        int iid = 0;
+        if (m.running[i] && !m.has_ctx[i])
+            return ss_reader_fail(r, SS_E_STATE, "SPU 0x%X runs with no lifted context (a PPU-fallback run):"
+                                  " not resumable", m.tid[i]);
+        if (m.kind[i] == LV2_SPU_RUN_FALLBACK && !spu_lookup_ppu_fallback(m.entry[i], &user))
+            return ss_reader_fail(r, SS_E_STATE, "SPU 0x%X: this build has no PPU fallback for entry 0x%X",
+                                  m.tid[i], m.entry[i]);
+        if (m.kind[i] == LV2_SPU_RUN_REGISTRY && !spu_workload_find_img(m.fp[i], &iid))
+            return ss_reader_fail(r, SS_E_STATE, "SPU 0x%X: this build has no lifted workload 0x%016llX",
+                                  m.tid[i], (unsigned long long)m.fp[i]);
+        if (m.has_ls[i]) {
+            char name[16];
+            const void* p = NULL;
+            uint64_t n = 0;
+            if ((e = ss_find_blob(r, lv2_spu_ss_ls_name(name, m.tid[i]), &p, &n)) != 0) return e;
+            if (n != SPU_LS_SIZE)
+                return ss_reader_fail(r, SS_E_CORRUPT, "%s: %llu bytes, a local store is %u", name,
+                                      (unsigned long long)n, (unsigned)SPU_LS_SIZE);
+        }
+    }
+    uint32_t ids[MAX_SPU_GROUPS];
+    uint8_t used[MAX_SPU_GROUPS];
+    memset(used, 0, sizeof used);
+    if ((e = ss_recs_open(r, &k_spug_group_list, &it)) != 0) return e;
+    for (;;) {
+        spu_group_t g;
+        memset(&g, 0, sizeof g);
+        if ((k = ss_recs_next(&it, &key, &g)) != 1) break;
+        if ((e = spug_ss_group_ok(r, key, &g, used, ids, &m)) != 0) return e;
+    }
+    return k < 0 ? k : SS_OK;
+}
+
+/* A LOAD's TEARDOWN: the old state's threads are gone (discarded at their
+ * roots), so every handle, local store and context in the table is this
+ * thread's to drop. Each context leaves the lock-line notify registry before
+ * it is freed (spu_coh_notify_write would walk a freed pointer); SPUC's
+ * teardown empties the MFC table after this. The tables and the counters end
+ * as at boot -- what stays if the image has no SPUG. */
+static void spug_teardown(void)
+{
+    extern void spu_coh_unregister(struct spu_context*);
+    for (int i = 0; i < MAX_SPU_THREADS; i++) {   /* every slot: group_destroy leaves a slot's handles */
+        spu_thread_t* t = &s_spu_threads[i];
+#ifdef _WIN32
+        if (t->host_thread) CloseHandle(t->host_thread);
+        if (t->finish_event) CloseHandle(t->finish_event);
+#endif
+        free(t->local_store);
+        if (t->sctx) {
+            spu_coh_unregister((struct spu_context*)t->sctx);
+            free(t->sctx);
+        }
+    }
+    memset(s_spu_threads, 0, sizeof s_spu_threads);
+    memset(s_spu_groups, 0, sizeof s_spu_groups);
+    s_spu_next_group_id  = 0x1000;
+    s_spu_next_thread_id = 0x2000;
+    s_spu_initialized    = 0;
+    s_spu_seg_bump       = 0x0D000000u;
+    s_spu_img_bump       = SPU_IMAGE_STAGE_BASE;
+}
+
+/* A LOAD's RESTORE: the statics, then every group and thread at its slot
+ * with the image's values (spug_ss_scan repeats check_image's checks first:
+ * nothing is written unless the records hold together), then each thread's
+ * host side from thread_hosts -- its fallback handler, a context-less local
+ * store from its blob. Contexts are SPUC's (next); host threads RECREATE's. */
+static int spug_restore(ss_reader* r)
+{
+    lv2_spu_ss_img m;
+    ss_recs_it it;
+    uint32_t key;
+    int e, k;
+    if ((e = spug_ss_scan(r, &m)) != 0) return e;
+    if ((e = ss_read_fields(r, &k_spug_list)) != 0) return e;
+    uint32_t ids[MAX_SPU_GROUPS];
+    uint8_t used[MAX_SPU_GROUPS];
+    memset(used, 0, sizeof used);
+    if ((e = ss_recs_open(r, &k_spug_group_list, &it)) != 0) return e;
+    for (;;) {
+        spu_group_t g;
+        memset(&g, 0, sizeof g);
+        if ((k = ss_recs_next(&it, &key, &g)) != 1) break;
+        if ((e = spug_ss_group_ok(r, key, &g, used, ids, &m)) != 0) return e;
+        g.in_use = 1;
+        g.name[sizeof g.name - 1] = 0;
+        s_spu_groups[key] = g;
+    }
+    if (k < 0) return k;
+    if ((e = ss_recs_open(r, &k_spug_thread_list, &it)) != 0) return e;
+    for (;;) {
+        spu_thread_t t;
+        memset(&t, 0, sizeof t);
+        if ((k = ss_recs_next(&it, &key, &t)) != 1) break;
+        t.in_use = 1;                      /* (its slot and bindings: spug_ss_scan) */
+        s_spu_threads[key] = t;            /* no context, host thread, event, handler or store yet */
+    }
+    if (k < 0) return k;
+    if ((e = ss_recs_open(r, &k_spug_host_list, &it)) != 0) return e;
+    for (;;) {
+        lv2_spu_ss_host h;
+        memset(&h, 0, sizeof h);
+        if ((k = ss_recs_next(&it, &key, &h)) != 1) break;
+        spu_thread_t* t = &s_spu_threads[key];
+        void* user = NULL;
+        switch (h.run_kind) {
+        case LV2_SPU_RUN_REGISTRY:
+            t->fb_handler = spu_registry_fallback;
+            t->fb_user = (void*)(uintptr_t)h.fb_fp;
+            break;
+        case LV2_SPU_RUN_INTERP:
+            t->fb_handler = spu_interp_fallback;
+            break;
+        case LV2_SPU_RUN_FALLBACK:
+            t->fb_handler = spu_lookup_ppu_fallback(t->entry_point, &user);
+            t->fb_user = user;
+            if (!t->fb_handler)
+                return ss_reader_fail(r, SS_E_STATE, "SPU 0x%X: this build has no PPU fallback for entry 0x%X",
+                                      t->tid, t->entry_point);
+            break;
+        default:                           /* none, or lifted: SPUC's restore gives it its context */
+            break;
+        }
+        if (h.has_ls) {
+            char name[16];
+            uint64_t n = 0;
+            t->local_store = (uint8_t*)calloc(1, SPU_LS_SIZE);
+            if (!t->local_store)
+                return ss_reader_fail(r, SS_E_NOMEM, "SPU 0x%X: no memory for its local store", t->tid);
+            if ((e = ss_read_blob(r, lv2_spu_ss_ls_name(name, t->tid), t->local_store, SPU_LS_SIZE, &n)) != 0)
+                return e;
+            if (n != SPU_LS_SIZE)
+                return ss_reader_fail(r, SS_E_CORRUPT, "%s: %llu bytes, a local store is %u", name,
+                                      (unsigned long long)n, (unsigned)SPU_LS_SIZE);
+        }
+    }
+    return k < 0 ? k : SS_OK;
+}
+
+static const ss_section_ops k_spug_ops = {
+    SS_FOURCC('S', 'P', 'U', 'G'), 1, 0, SS_ORDER_SPU,
+    spug_check, spug_capture, spug_teardown, spug_restore, NULL,
+    "lv2 SPU thread groups", k_spug_lists, spug_size_hint,
+    NULL, spug_check_image,
+};
+SS_SECTION_REGISTER(k_spug_ops)
+
+/* ---------------------------------------------------------------------------
+ * Save state: SPUC, the SPU contexts, and SPUH, the taskset HLE's tables
+ * (runtime/savestate/ss_state.h; engine design 5.2 / 6.2)
+ *
+ * Registered here beside SPUG, the way cellSysmodule.c holds GCM_ and AUDI:
+ * spu_channels.c and spu_workload.c only describe their part -- the field
+ * lists and plain helpers, no call into the save-state engine -- so the SPU
+ * host tests that compile those files in link without it.
+ *
+ * SPUC: every context an lv2 SPU thread owns, keyed by the thread's id. The
+ * context field by field ("contexts": spu_channels.c's list, from
+ * spu_context_ss.inc); what the runtime keeps for it beside spu_context
+ * ("context_state": the decrementer as the value a read returns at the
+ * capture's one instant -- TIME's host.qpc -- and the MFC engine's completed
+ * tags); the 256 KB local store as a blob "ls.<tid>"; and "image_table", a
+ * fingerprint of the lifted-image tables the contexts' image ids index, so a
+ * load refuses an image whose ids would name other code. A LOAD frees the old
+ * contexts with the thread table (SPUG's teardown) and empties the MFC table
+ * (SPUC's); the restore builds each context anew -- spu_context_init, the
+ * record read into it, the local store from its blob, the decrementer
+ * re-anchored on the frozen guest clock, its MFC engine claimed with the
+ * saved tags -- and hands it to its thread. RECREATE drops a context's
+ * lock-line reservation just before its thread resumes
+ * (spu_channels_ss_resume), after the fidelity check.
+ * -----------------------------------------------------------------------*/
+extern const ss_list spu_channels_ss_contexts_list;
+int      spu_channels_ss_check(char* why, size_t n);
+int      spu_channels_ss_check_ctx(const spu_context* c, uint32_t tid, char* why, size_t n);
+uint64_t spu_channels_ss_now(uint64_t qpc, uint64_t qpc_freq);
+uint32_t spu_channels_ss_dec(const spu_context* c, uint64_t now, uint32_t* armed);
+int      spu_channels_ss_mfc(const spu_context* c, uint32_t* tags, uint32_t* queued);
+uint64_t spu_channels_ss_image_table(void);
+void     spu_channels_ss_set_dec(spu_context* c, uint32_t value, int armed);
+void     spu_channels_ss_set_mfc(spu_context* c, uint32_t tags);
+void     spu_channels_ss_teardown(void);
+void     spu_channels_ss_resume(spu_context* c);
+int      spu_coh_is_registered(const spu_context* ctx);   /* spu_coherency.c */
+
+/* What the runtime keeps for a context beside spu_context, as values. */
+typedef struct spuc_ctx_state {
+    uint32_t dec_now;            /* what SPU_RdDec returns at the capture's instant (TIME's host.qpc) */
+    uint32_t dec_armed;          /* dec_base_ns set (a WrDec or a read); 0: reads `decrementer` as written */
+    uint32_t mfc_tag_completed;  /* its MFC engine: the completed tag groups */
+    uint32_t mfc_queue_count;    /* ... and the queued commands (DMA completes synchronously: 0) */
+    uint32_t ls_saved;           /* blob ls.<tid> holds the local store */
+    int32_t  mfc_slot;           /* the engine's slot; -1 none yet (a fresh one), -2 the overflow engine */
+    uint32_t coh_registered;     /* in the lock-line notify registry (its next GETLLAR re-enters it) */
+    uint32_t rsvd;
+    uint64_t dec_base_ns;        /* the host instant dec_now counts from */
+} spuc_ctx_state;
+/* mfc_slot is read back (a load claims an engine where the image had one) but
+ * not compared: which slot is the host's. coh_registered and dec_base_ns are
+ * the host's too, for inspection only. */
+static const ss_field k_spuc_state_fields[] = {
+    SS_MEMBER(spuc_ctx_state, dec_now), SS_MEMBER(spuc_ctx_state, dec_armed),
+    SS_MEMBER(spuc_ctx_state, mfc_tag_completed), SS_MEMBER(spuc_ctx_state, mfc_queue_count),
+    SS_MEMBER(spuc_ctx_state, ls_saved),
+    SS_MEMBER_F(spuc_ctx_state, mfc_slot, SS_FF_HOST),
+    SS_MEMBER_F(spuc_ctx_state, coh_registered, SS_FF_NO_RESTORE | SS_FF_HOST),
+    SS_MEMBER_F(spuc_ctx_state, dec_base_ns, SS_FF_NO_RESTORE | SS_FF_HOST),
+};
+static const ss_list k_spuc_state_list = SS_LIST("context_state", k_spuc_state_fields);
+static const ss_list* const k_spuc_lists[] = { &spu_channels_ss_contexts_list, &k_spuc_state_list, NULL };
+
+static void spuc_state(const spu_context* c, uint64_t now, spuc_ctx_state* s)
+{
+    memset(s, 0, sizeof *s);
+    s->dec_now = spu_channels_ss_dec(c, now, &s->dec_armed);
+    s->dec_base_ns = c->dec_base_ns;
+    s->mfc_slot = spu_channels_ss_mfc(c, &s->mfc_tag_completed, &s->mfc_queue_count);
+    s->ls_saved = c->ls == c->ls_store;
+    s->coh_registered = (uint32_t)spu_coh_is_registered(c);
+}
+
+/* Strict eligibility: spu_channels.c's modes, then each lv2 context
+ * (interrupt handler, local-store window, queued MFC commands). */
+static int spuc_check(char* why, size_t n)
+{
+    int r = spu_channels_ss_check(why, n);
+    for (int i = 0; !r && i < MAX_SPU_THREADS; i++) {
+        const spu_thread_t* t = &s_spu_threads[i];
+        if (t->in_use && t->sctx) r = spu_channels_ss_check_ctx(t->sctx, t->tid, why, n);
+    }
+    return r;
+}
+
+static int spuc_capture(ss_writer* w)
+{
+    const ss_capture_info* ci = ss_writer_info(w);
+    const uint64_t now = spu_channels_ss_now(ci ? ci->qpc : 0, ci ? ci->qpc_freq : 0);
+    ss_recs_begin(w, &spu_channels_ss_contexts_list);
+    for (int i = 0; i < MAX_SPU_THREADS; i++) {
+        const spu_thread_t* t = &s_spu_threads[i];
+        if (t->in_use && t->sctx) ss_recs_add(w, t->tid, t->sctx);
+    }
+    ss_recs_end(w);
+    ss_recs_begin(w, &k_spuc_state_list);
+    for (int i = 0; i < MAX_SPU_THREADS; i++) {
+        const spu_thread_t* t = &s_spu_threads[i];
+        if (!t->in_use || !t->sctx) continue;
+        spuc_ctx_state s;
+        spuc_state(t->sctx, now, &s);
+        ss_recs_add(w, t->tid, &s);
+    }
+    ss_recs_end(w);
+    for (int i = 0; i < MAX_SPU_THREADS; i++) {
+        const spu_thread_t* t = &s_spu_threads[i];
+        if (!t->in_use || !t->sctx || t->sctx->ls != t->sctx->ls_store) continue;
+        char name[16];
+        ss_blob_begin(w, lv2_spu_ss_ls_name(name, t->tid), 4096);   /* page aligned, like GMEM's pages */
+        ss_blob_put(w, t->sctx->ls_store, SPU_LS_SIZE);
+        ss_blob_end(w);
+    }
+    ss_write_u64(w, "image_table", spu_channels_ss_image_table());
+    return ss_writer_error(w);
+}
+
+/* 256 KB of local store per context, its records well under 16 KB. */
+static uint64_t spuc_size_hint(void)
+{
+    uint64_t n = 0;
+    for (int i = 0; i < MAX_SPU_THREADS; i++)
+        if (s_spu_threads[i].in_use && s_spu_threads[i].sctx) n++;
+    return n * (SPU_LS_SIZE + 4096u + 16384u) + 65536u;
+}
+
+/* Before a LOAD stops anything: this session runs no SPU code a load would
+ * not replace (spu_channels.c's modes); the image's SPU image tables are
+ * this build's; and its contexts match SPUG's threads one for one -- a
+ * contexts and a context_state record and a whole local store for every
+ * thread SPUG says has a context, none for any other -- each with its local
+ * store saved (never a guest window) and no MFC command queued. */
+static int spuc_check_image(ss_reader* r)
+{
+    char why[160];
+    why[0] = 0;
+    if (spu_channels_ss_check(why, sizeof why))
+        return ss_reader_fail(r, SS_E_STATE, "this session: %s, which a load does not replace", why);
+    uint64_t v = 0;
+    int e = ss_read_u64(r, "image_table", &v);
+    if (e) return e;
+    const uint64_t here = spu_channels_ss_image_table();
+    if (v != here)
+        return ss_reader_fail(r, SS_E_LAYOUT, "image_table: 0x%016llX, this build's 0x%016llX (its image ids name"
+                              " other code)", (unsigned long long)v, (unsigned long long)here);
+    lv2_spu_ss_img m;
+    ss_reader g;
+    if ((e = ss_reader_open(&g, r->img, SS_FOURCC('S', 'P', 'U', 'G'))) != 0)
+        return ss_reader_fail(r, e, "no SPUG section for its threads");
+    if ((e = spug_ss_scan(&g, &m)) != 0) return ss_reader_fail(r, e, "SPUG: %s", ss_reader_what(&g));
+    uint8_t got[MAX_SPU_THREADS], st[MAX_SPU_THREADS];
+    memset(got, 0, sizeof got);
+    memset(st, 0, sizeof st);
+    ss_recs_it it;
+    uint32_t tid;
+    int k;
+    if ((e = ss_recs_open(r, &spu_channels_ss_contexts_list, &it)) != 0) return e;
+    while ((k = ss_recs_next(&it, &tid, NULL)) == 1) {
+        const int i = spug_ss_slot(&m, tid);
+        if (i < 0 || !m.has_ctx[i])
+            return ss_reader_fail(r, SS_E_CORRUPT, "contexts[0x%X]: SPUG has no thread with a context by that id", tid);
+        if (got[i]++) return ss_reader_fail(r, SS_E_CORRUPT, "contexts[0x%X]: twice", tid);
+    }
+    if (k < 0) return k;
+    if ((e = ss_recs_open(r, &k_spuc_state_list, &it)) != 0) return e;
+    for (;;) {
+        spuc_ctx_state s;
+        memset(&s, 0, sizeof s);
+        if ((k = ss_recs_next(&it, &tid, &s)) != 1) break;
+        const int i = spug_ss_slot(&m, tid);
+        if (i < 0 || !got[i])
+            return ss_reader_fail(r, SS_E_CORRUPT, "context_state[0x%X]: no context by that id", tid);
+        if (st[i]++) return ss_reader_fail(r, SS_E_CORRUPT, "context_state[0x%X]: twice", tid);
+        if (!s.ls_saved)
+            return ss_reader_fail(r, SS_E_STATE, "context_state[0x%X].ls_saved: 0 (a guest local-store window)", tid);
+        if (s.mfc_queue_count)
+            return ss_reader_fail(r, SS_E_STATE, "context_state[0x%X].mfc_queue_count: %u MFC commands queued",
+                                  tid, s.mfc_queue_count);
+        if (s.mfc_slot < -2)
+            return ss_reader_fail(r, SS_E_CORRUPT, "context_state[0x%X].mfc_slot: %d", tid, s.mfc_slot);
+    }
+    if (k < 0) return k;
+    for (int i = 0; i < MAX_SPU_THREADS; i++) {
+        if (!m.present[i] || !m.has_ctx[i]) continue;
+        if (!got[i] || !st[i])
+            return ss_reader_fail(r, SS_E_CORRUPT, "SPU 0x%X: SPUG gives it a context, this section has no %s",
+                                  m.tid[i], got[i] ? "context_state" : "contexts record");
+        char name[16];
+        const void* p = NULL;
+        uint64_t n = 0;
+        if ((e = ss_find_blob(r, lv2_spu_ss_ls_name(name, m.tid[i]), &p, &n)) != 0) return e;
+        if (n != SPU_LS_SIZE)
+            return ss_reader_fail(r, SS_E_CORRUPT, "%s: %llu bytes, a local store is %u", name,
+                                  (unsigned long long)n, (unsigned)SPU_LS_SIZE);
+    }
+    return SS_OK;
+}
+
+/* A LOAD's TEARDOWN: SPUG's freed the contexts; no MFC engine has an owner now. */
+static void spuc_teardown(void)
+{
+    spu_channels_ss_teardown();
+}
+
+/* A LOAD's RESTORE, after SPUG's (the threads are at their slots, none with
+ * a context): each context built anew -- spu_context_init (ls := ls_store;
+ * the channel locks, the wait condition variable, irq_frame, host_depth,
+ * drain_ret_pc, the dispatch cache and its ib_* / ibc_ggen all zero) and the
+ * contexts record read straight into it -- and handed to its thread; then
+ * from context_state its decrementer (dec_now, counting from the frozen guest
+ * clock's instant when armed) and, where the image's had one, its MFC engine
+ * with the saved completed tags; then its local store from the blob. Nothing
+ * else is rebuilt here: the reservation is dropped at RECREATE. */
+static int spuc_restore(ss_reader* r)
+{
+    ss_recs_it it;
+    uint32_t tid;
+    int e, k;
+    if ((e = ss_recs_open(r, &spu_channels_ss_contexts_list, &it)) != 0) return e;
+    for (uint32_t n = 0; n < it.count; n++) {
+        spu_context* c = (spu_context*)calloc(1, sizeof *c);
+        if (!c) return ss_reader_fail(r, SS_E_NOMEM, "contexts: no memory for context %u", n);
+        spu_context_init(c, 0);
+        if ((k = ss_recs_next(&it, &tid, c)) != 1) {
+            free(c);
+            return k < 0 ? k : ss_reader_fail(r, SS_E_CORRUPT, "contexts: %u of %u records", n, it.count);
+        }
+        spu_thread_t* t = spu_find_thread(tid);
+        if (!t || t->sctx) {
+            free(c);
+            return ss_reader_fail(r, SS_E_CORRUPT, "contexts[0x%X]: %s", tid,
+                                  t ? "a second context for its thread" : "no such SPU thread in SPUG");
+        }
+        t->sctx = c;
+    }
+    if ((e = ss_recs_open(r, &k_spuc_state_list, &it)) != 0) return e;
+    for (;;) {
+        spuc_ctx_state s;
+        memset(&s, 0, sizeof s);
+        if ((k = ss_recs_next(&it, &tid, &s)) != 1) break;
+        spu_thread_t* t = spu_find_thread(tid);
+        if (!t || !t->sctx)
+            return ss_reader_fail(r, SS_E_CORRUPT, "context_state[0x%X]: no context by that id", tid);
+        spu_channels_ss_set_dec(t->sctx, s.dec_now, s.dec_armed != 0);
+        if (s.mfc_slot != -1) spu_channels_ss_set_mfc(t->sctx, s.mfc_tag_completed);
+    }
+    if (k < 0) return k;
+    for (int i = 0; i < MAX_SPU_THREADS; i++) {
+        spu_thread_t* t = &s_spu_threads[i];
+        if (!t->in_use || !t->sctx) continue;
+        char name[16];
+        uint64_t n = 0;
+        if ((e = ss_read_blob(r, lv2_spu_ss_ls_name(name, t->tid), t->sctx->ls_store, SPU_LS_SIZE, &n)) != 0)
+            return e;
+        if (n != SPU_LS_SIZE)
+            return ss_reader_fail(r, SS_E_CORRUPT, "%s: %llu bytes, a local store is %u", name,
+                                  (unsigned long long)n, (unsigned)SPU_LS_SIZE);
+    }
+    /* every lifted thread of SPUG's has its context now (check_image's check) */
+    lv2_spu_ss_img m;
+    ss_reader g;
+    if ((e = ss_reader_open(&g, r->img, SS_FOURCC('S', 'P', 'U', 'G'))) != 0)
+        return ss_reader_fail(r, e, "no SPUG section for its threads");
+    if ((e = spug_ss_scan(&g, &m)) != 0) return ss_reader_fail(r, e, "SPUG: %s", ss_reader_what(&g));
+    for (int i = 0; i < MAX_SPU_THREADS; i++)
+        if (m.present[i] && m.has_ctx[i] && !s_spu_threads[i].sctx)
+            return ss_reader_fail(r, SS_E_CORRUPT, "SPU 0x%X: its context is not in the image", m.tid[i]);
+    return SS_OK;
+}
+
+static const ss_section_ops k_spuc_ops = {
+    SS_FOURCC('S', 'P', 'U', 'C'), 1, 0, SS_ORDER_SPU + 10,
+    spuc_check, spuc_capture, spuc_teardown, spuc_restore, NULL,
+    "SPU contexts", k_spuc_lists, spuc_size_hint,
+    NULL, spuc_check_image,
+};
+SS_SECTION_REGISTER(k_spuc_ops)
+
+/* SPUH: spu_workload.c's taskset HLE tables, by value ("taskset"), and the
+ * WAIT_SIGNAL parked list for inspection ("parked": each resumed task
+ * registers again, so a load's teardown empties it). check_image refuses a
+ * session running SPU code on the async runner's host threads, which a load
+ * would not discard. */
+extern const ss_list spu_workload_ss_taskset_list, spu_workload_ss_parked_list;
+int  spu_workload_ss_check(char* why, size_t n);
+int  spu_workload_ss_busy(char* why, size_t n);
+void spu_workload_ss_teardown(void);
+
+static const ss_list* const k_spuh_lists[] = {
+    &spu_workload_ss_taskset_list, &spu_workload_ss_parked_list, NULL
+};
+
+static int spuh_capture(ss_writer* w)
+{
+    ss_write_fields(w, &spu_workload_ss_taskset_list);
+    ss_write_fields(w, &spu_workload_ss_parked_list);
+    return ss_writer_error(w);
