+static void* read_file(const char* p, uint64_t* n)
+{
+    FILE* f = fopen(p, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END);
+    const long k = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    void* b = malloc((size_t)k);
+    if (b && fread(b, 1, (size_t)k, f) != (size_t)k) { free(b); b = NULL; }
+    fclose(f);
+    *n = (uint64_t)k;
+    return b;
+}
