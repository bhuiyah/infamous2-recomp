+ * OS-free pad_kbm.h; this part reads the host:
+ *
+ *   - keys and mouse buttons with GetAsyncKeyState at each pad report, and
+ *     only while a window of THIS process is in the foreground, so typing in
+ *     another application never drives the game. A press that starts and
+ *     ends between two reports (a quick tap while the game polls the pad at
+ *     14-30 fps) is latched by the window procedure (WM_KEYDOWN, mouse button
+ *     down) and shows in the next report, so it is never lost. A key already
+ *     held when the window gets the focus (the Tab of an Alt+Tab, the Enter
+ *     that started the game) is ignored until it is released;
+ *   - mouse motion and the wheel as raw input (WM_INPUT: relative counts,
+ *     no pointer acceleration), registered only while the mouse is captured,
+ *     and received by a message-only window on a small thread of its own:
+ *     the game window's thread is the render thread, which drains the RSX
+ *     FIFO for tens of milliseconds at a time, and motion pumped there would
+ *     arrive in bursts and make the camera stutter. The counts are added up
+ *     with interlocked adds; the next pad report drains them and turns them
+ *     into right-stick deflection. (If that thread cannot be made, the game
+ *     window receives the raw input instead.)
+ *   - capture, release, clicks and key presses from the game window: the
+ *     presenting backend's window procedure offers its messages to
+ *     cellPad_host_window_message() first.
+ *
+ * Mouse capture: a click in the game window captures the mouse (cursor hidden
+ * and clipped to the client area; that click is not passed to the game). Alt,
+ * F10, Alt+Tab or any focus loss releases it; click again to re-capture.
+ * Motion and mouse buttons only count while captured, so a mouse that merely
+ * crosses the window never turns the camera.
+ *
+ * Port 0 without a controller: keyboard/mouse IS the pad, all released while
+ * the game is not in the foreground -- the old keyboard fallback's contract
+ * (it had arrows/Z/X/A/S/Q/W/1/2/Enter/Tab; the table is now configurable).
+ * With a controller on port 0 (any kind pad_host.h drives) the two merge:
+ * buttons OR together, and a stick the keyboard/mouse is deflecting overrides
+ * the controller's stick for that report (merge_with_controller = 0: only
+ * without a controller).
+ * Scripted input (PAD_SCRIPT, PAD_STICK(S), PAD_FILE, PAD_AUTOPRESS, ...) is
+ * applied afterwards in cellPadGetData, on top of this, exactly as before.
+ *
+ * Configuration: PAD_CONFIG=<file> (or "none"), otherwise the first of
+ * .\input.ini and .\config\input.ini in the working directory (tools\run.ps1
+ * runs from the project root) and input.ini next to the exe; then PAD_KBM=
+ * "name=value|name=value" overrides. PAD_NO_KEYBOARD=1 turns keyboard AND
+ * mouse off (as it always turned the keyboard fallback off), PAD_NO_MOUSE=1
+ * the mouse only. The active table is printed once at startup. The same
+ * file's [controller] section configures the physical controllers.
+ *
+ * Window hotkeys (pad_hotkeys.h): the same files' [hotkeys] section (save
+ * states, fullscreen, ...). The window procedure asks cellPad_host_hotkey()
+ * on each key press; a hotkey's keys are kept from the game until they are
+ * released. cellPad_host_input_hold() makes the keyboard/mouse half of the
+ * pad neutral while a window menu is open (the menu loop takes the keys, but
+ * the pad reads held keys directly, so the arrows and Enter that navigate a
+ * menu would otherwise move Cole); the keys still held when it ends stay
+ * blocked until released, the focus-gain rule.
+ * -----------------------------------------------------------------------*/
+#ifdef _WIN32
+#include "pad_kbm.h"
+#include "pad_hotkeys.h"
+
+static int pad_host_window_focused(void)
+{
+    HWND fg = GetForegroundWindow();
+    if (!fg) return 0;
+    DWORD pid = 0;
+    GetWindowThreadProcessId(fg, &pid);
+    return pid == GetCurrentProcessId();
+}
+
+static KbmConfig     s_kbm;
+static KbmRuntime    s_kbm_rt;                 /* pad-report side only */
+static KbmArb        s_kbm_arb;                /* pad-report side only: which device has each stick */
+static volatile LONG s_kbm_ready;              /* 0 not loaded, 1 loading, 2 ready */
+static int           s_kbm_kb_on, s_kbm_mouse_on;
+/* window / raw input thread -> pad report */
+static volatile LONG s_kbm_mdx, s_kbm_mdy, s_kbm_wheel;
+static volatile LONG s_kbm_captured;
+static volatile LONG s_kbm_swallow;            /* 1 << VK: mouse buttons held since the capture */
+static volatile LONG s_kbm_latch[8];           /* 256 bits by VK: pressed since the last report */
+/* pad report only */
+static LONG          s_kbm_block[8];           /* 256 bits by VK: held when the window got the focus */
+static int           s_kbm_was_focused;
+static unsigned char s_kbm_state[256];         /* this report's key state, by VK */
+/* raw input receiver: the message-only window of the raw input thread, or
+ * NULL (then the game window receives it) */
+static HWND          s_kbm_sink;
+/* whichever thread receives WM_INPUT (only one does) */
+static int           s_kbm_abs_valid;
+static LONG          s_kbm_abs_x, s_kbm_abs_y;
+/* window thread only */
+static HWND          s_kbm_hwnd;               /* the game window, while captured */
+/* window hotkeys: written by kbm_load, then read-only */
+static HkConfig      s_hk;
+/* window thread -> pad report */
+static volatile LONG s_kbm_hold;               /* cellPad_host_input_hold depth: input neutral */
+static volatile LONG s_kbm_hold_gen;           /* bumped as a hold ends */
+static volatile LONG s_kbm_hkblock[8];         /* 256 bits by VK: keys of a hotkey just used */
+/* pad report only */
+static LONG          s_kbm_hold_seen;          /* the s_kbm_hold_gen the last report saw */
+
+#define KBM_WM_RAW    (WM_APP + 0x2B4D)        /* to the raw input thread: wParam 1 on, 0 off */
+#define KBM_TIMER_ID  ((UINT_PTR)0x4B424D)     /* re-asserts the cursor clip while captured */
+
+static double kbm_now_ms(void)
+{
+    static LARGE_INTEGER freq;
+    LARGE_INTEGER c;
+    if (!freq.QuadPart) QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart * 1000.0 / (double)freq.QuadPart;
+}
+
+static void kbm_warn(const void* ctx, const char* msg)
+{
+    printf("[cellPad] %s: %s\n", ctx ? (const char*)ctx : "input config", msg);
+}
+
+static const char* s_kbm_cfg_path;
+
+static void kbm_host_warn(const char* msg)
+{
+    kbm_warn(s_kbm_cfg_path, msg);
+}
+
+static int kbm_read_file(const char* path, int* errs)
+{
+    static char text[65536];
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    size_t n = fread(text, 1, sizeof text - 1, f);
+    fclose(f);
+    const char* t = kbm_text_prepare(text, n);
+    *errs += kbm_parse_text(&s_kbm, t, 0, kbm_warn, path);
+    /* The [controller] section (and "controller..." names) belong to the
+     * controller manager; pad_kbm.h skips them. */
+    s_kbm_cfg_path = path;
+    *errs += padhost_config_parse_text(t, 0, kbm_host_warn);
+    /* ... and [hotkeys] (and "hotkey_*" names) to the window hotkeys. */
+    *errs += hk_parse_text(&s_hk, t, 0, kbm_warn, path);
+    return 1;
+}
+
+/* config\options.ini's input sections (include/ps3emu/options.h): over the
+ * file, under PAD_KBM; nothing when there is no options.ini. kbm_load calls
+ * it once after the file (PAD_CONFIG or the search), before PAD_KBM; inside
+ * the PAD_NO_KEYBOARD block too, so its [controller] keys apply there. */
+static void kbm_load_options_layer(int* errs, char* src, size_t srcn)
+{
+    const char* lt = opt_layer_text("input");
+    if (!lt || !*lt) return;
+    static char ltext[65536];
+    snprintf(ltext, sizeof ltext, "%s", lt);
+    *errs += kbm_parse_text(&s_kbm, ltext, 0, kbm_warn, "options.ini");
+    s_kbm_cfg_path = "options.ini";
+    *errs += padhost_config_parse_text(ltext, 0, kbm_host_warn);
+    const size_t used = strlen(src);
+    snprintf(src + used, srcn - used, " + options.ini");
+}
+
+static void kbm_load(void)
+{
+    kbm_config_defaults(&s_kbm);
+    hk_config_defaults(&s_hk);
+    /* PAD_NO_KEYBOARD still reads the file, for its [controller] section. */
+    int kbm_off = getenv("PAD_NO_KEYBOARD") != NULL;
+    char src[MAX_PATH + 32];
+    int errs = 0;
+    snprintf(src, sizeof src, "built-in defaults");
+    const char* pc = getenv("PAD_CONFIG");
+    if (pc && *pc) {
+        if (strcmp(pc, "none") && strcmp(pc, "0")) {
+            if (kbm_read_file(pc, &errs)) snprintf(src, sizeof src, "%s", pc);
+            else printf("[cellPad] PAD_CONFIG=%s: cannot open it, using the defaults\n", pc);
+        }
+    } else {
+        char exe_ini[MAX_PATH];
+        DWORD n = GetModuleFileNameA(NULL, exe_ini, MAX_PATH);
+        char* slash = (n && n < MAX_PATH) ? strrchr(exe_ini, '\\') : NULL;
+        if (slash) snprintf(slash + 1, (size_t)(MAX_PATH - (slash + 1 - exe_ini)), "input.ini");
+        else       exe_ini[0] = 0;
+        const char* cand[3] = { "input.ini", "config\\input.ini", exe_ini };
+        for (int i = 0; i < 3; i++) {
+            if (!cand[i][0] || !kbm_read_file(cand[i], &errs)) continue;
+            if (!GetFullPathNameA(cand[i], (DWORD)sizeof src, src, NULL))
+                snprintf(src, sizeof src, "%s", cand[i]);
+            break;
+        }
+    }
+    /* Window hotkeys work with the keyboard bindings off too: they are the
+     * window's keys, not the game's. PAD_KBM may carry "hotkey_*" items. */
+    {
+        const char* hv = getenv("PAD_KBM");
+        if (hv && *hv) errs += hk_parse_text(&s_hk, hv, 1, kbm_warn, "PAD_KBM");
+    }
+    if (kbm_off) {
+        kbm_load_options_layer(&errs, src, sizeof src);   /* its [controller] keys */
+        s_kbm_kb_on = s_kbm_mouse_on = 0;
+        s_kbm.capture = KBM_CAPTURE_OFF;
+        printf("[cellPad] keyboard/mouse input off (PAD_NO_KEYBOARD)\n");
+        hk_print(&s_hk, stdout, "[cellPad]");
+        fflush(stdout);
+        return;
+    }
+    kbm_load_options_layer(&errs, src, sizeof src);
+    const char* ov = getenv("PAD_KBM");
+    if (ov && *ov) {
+        errs += kbm_parse_text(&s_kbm, ov, 1, kbm_warn, "PAD_KBM");
+        size_t used = strlen(src);
+        snprintf(src + used, sizeof src - used, " + PAD_KBM");
+    }
+    s_kbm_kb_on    = s_kbm.keyboard;
+    s_kbm_mouse_on = s_kbm.mouse && !getenv("PAD_NO_MOUSE") && s_kbm.capture != KBM_CAPTURE_OFF;
+    s_kbm.mouse    = s_kbm_mouse_on;
+    if (!s_kbm_mouse_on) s_kbm.capture = KBM_CAPTURE_OFF;
+    printf("[cellPad] keyboard/mouse -> pad port 0, bindings from %s%s:\n", src,
+           errs ? " (bad lines skipped, see above)" : "");
+    kbm_print_bindings(&s_kbm, stdout, "[cellPad]");
+    hk_print(&s_hk, stdout, "[cellPad]");
+    if (s_kbm_kb_on) hk_report_conflicts(&s_hk, &s_kbm, kbm_warn, "[hotkeys]");
+    fflush(stdout);
+}
+
+/* A live change of an input.ini row of the settings store: the [controller]
+ * keys go to the controller manager (live there, env keeps precedence), the
+ * rest to the keyboard/mouse table. */
+static void kbm_opt_changed(opt_id id, const char* old_v, const char* new_v, void* user)
+{
+    (void)old_v; (void)user;
+    const opt_def* d = opt_def_of(id);
+    if (!d || !d->home || strcmp(d->home, "input") || !new_v) return;
+    int r = (d->section && !strcmp(d->section, "controller")) ? padhost_config_set(d->key, new_v)
+                                                              : cellPad_kbm_set(d->key, new_v);
+    printf("[cellPad] %s = %s%s\n", d->key, new_v, r > 0 ? "" : " (refused)"); fflush(stdout);
+}
+
+/* Load the configuration once, from whichever thread gets here first (the
+ * window thread at window creation, or a guest thread's first pad poll). */
+static void kbm_ensure(void)
+{
+    if (InterlockedCompareExchange(&s_kbm_ready, 2, 2) == 2) return;
+    if (InterlockedCompareExchange(&s_kbm_ready, 1, 0) == 0) {
+        kbm_load();
+        opt_watch(-1, kbm_opt_changed, NULL, OPT_ON_SETTER);
+        InterlockedExchange(&s_kbm_ready, 2);
+        return;
+    }
+    while (InterlockedCompareExchange(&s_kbm_ready, 2, 2) != 2) Sleep(1);
+}
+
+static int kbm_is_mouse_button(int vk)
+{
+    return vk == VK_LBUTTON || vk == VK_RBUTTON || vk == VK_MBUTTON ||
+           vk == VK_XBUTTON1 || vk == VK_XBUTTON2;
+}
+
+static LONG kbm_vk_bit(int vk) { return (LONG)(1UL << (vk & 31)); }
+
+/* Window thread: a key or mouse button went down (not an auto-repeat). */
+static void kbm_latch(int vk)
+{
+    if (vk > 0 && vk < 256) InterlockedOr(&s_kbm_latch[vk >> 5], kbm_vk_bit(vk));
+}
+
+/* One host key for this report. latch: the presses since the last report;
+ * sysmod: Alt or a Windows key is held -- their combinations belong to the
+ * desktop (Alt+Tab, Alt+F4, Win+D), so no other key reaches the game, or
+ * Alt+Tab would open the map (Tab = SELECT) on its way out of the window;
+ * entering: first report with the window in front. A key held at focus gain
+ * or during an Alt/Win chord stays ignored until it is released (or pressed
+ * anew), so letting go of Alt before Tab does not leak a Tab either. */
+static int kbm_host_key(int vk, const LONG* latch, int sysmod, int entering)
+{
+    int held  = (GetAsyncKeyState(vk) & 0x8000) != 0;
+    int fresh = (latch[vk >> 5] & kbm_vk_bit(vk)) != 0;
+    if (kbm_is_mouse_button(vk)) {
+        /* Mouse buttons count only while the mouse is captured, and not
+         * while the button that captured it is still held. */
+        if (!s_kbm_mouse_on || !s_kbm_captured) return 0;
+        LONG bit = 1L << vk;
+        if (s_kbm_swallow & bit) {
+            if (held && !fresh) return 0;
+            InterlockedAnd(&s_kbm_swallow, ~bit);
+        }
+        return held || fresh;
+    }
+    if (!s_kbm_kb_on) return 0;
+    LONG* blk = &s_kbm_block[vk >> 5];
+    LONG  bit = kbm_vk_bit(vk);
+    if (sysmod && vk != VK_MENU && vk != VK_LMENU && vk != VK_RMENU &&
+        vk != VK_LWIN && vk != VK_RWIN) {
+        if (held) *blk |= bit;
+        return 0;
+    }
+    if (entering && held && !fresh) *blk |= bit;
+    if (*blk & bit) {
+        if (held && !fresh) return 0;
+        *blk &= ~bit;
+    }
+    return held || fresh;
+}
+
+/* Key state for pad_kbm.h: the table kbm_snapshot built for this report. */
+static int kbm_key_down(void* ctx, int code)
+{
+    (void)ctx;
+    return code > 0 && code < 256 && s_kbm_state[code];
+}
+
+/* Read every bound key once, at the start of a report. */
+static void kbm_snapshot(int entering)
+{
+    LONG latch[8];
+    unsigned char done[256];
+    for (int i = 0; i < 8; i++) latch[i] = InterlockedExchange(&s_kbm_latch[i], 0);
+    /* Keys of a hotkey the window just acted on: ignored until released. */
+    for (int i = 0; i < 8; i++) s_kbm_block[i] |= InterlockedExchange(&s_kbm_hkblock[i], 0);
+    int sysmod = ((GetAsyncKeyState(VK_MENU) | GetAsyncKeyState(VK_LWIN) |
+                   GetAsyncKeyState(VK_RWIN)) & 0x8000) != 0;
+    memset(done, 0, sizeof done);
+    memset(s_kbm_state, 0, sizeof s_kbm_state);
+    for (int t = 0; t < KBM_NUM_TARGETS; t++)
+        for (int i = 0; i < s_kbm.nkeys[t]; i++) {
+            int vk = s_kbm.keys[t][i];
+            if (vk <= 0 || vk > 0xFE || done[vk]) continue;   /* wheel: pad_kbm.h's pulses */
+            done[vk] = 1;
+            s_kbm_state[vk] = (unsigned char)kbm_host_key(vk, latch, sysmod, entering);
+        }
+}
+
+/* pad_poll_kbm's interlock, also taken by cellPad_kbm_set while it edits s_kbm. */
+static volatile LONG s_kbm_busy;
+
+static void pad_poll_kbm(void)
+{
+    kbm_ensure();
+    if (!s_kbm_kb_on && !s_kbm_mouse_on) return;
+    /* pad_poll_backend can run on two guest threads in the same tick; the
+     * filter state is not shareable, so the loser skips (the winner writes
+     * the same report). */
+    if (InterlockedCompareExchange(&s_kbm_busy, 1, 0) != 0) return;
+
+    LONG dx = InterlockedExchange(&s_kbm_mdx, 0);
+    LONG dy = InterlockedExchange(&s_kbm_mdy, 0);
+    LONG wh = InterlockedExchange(&s_kbm_wheel, 0);
+    if (s_icpt) {
+        /* The system has the controllers: nothing reaches the game, motion and
+         * taps meanwhile are dropped, and the first report after it ends counts
+         * as "entering" (kbm_host_key): a key still held then -- the one that
+         * closed a menu -- stays ignored until it is released. */
+        for (int i = 0; i < 8; i++) InterlockedExchange(&s_kbm_latch[i], 0);
+        kbm_runtime_reset(&s_kbm_rt);
+        s_kbm_was_focused = 0;
+        InterlockedExchange(&s_kbm_busy, 0);
+        return;
+    }
+    if (!s_kbm_captured) dx = dy = wh = 0;     /* a straggler added just after a release */
+    PadHostState* hs = &s_host_state[0];
+    int have_pad = hs->connected;              /* this sweep's controller on port 0 */
+    /* A window menu open (cellPad_host_input_hold) counts as unfocused: no
+     * keys, no mouse, latched taps dropped; its end is then a focus gain --
+     * also after a menu no report saw open: the Enter or Space that picked
+     * its item stays away from the game until it is released. */
+    int focused  = pad_host_window_focused() && s_kbm_hold == 0;
+    {
+        const LONG g = s_kbm_hold_gen;
+        if (g != s_kbm_hold_seen) { s_kbm_hold_seen = g; s_kbm_was_focused = 0; }
+    }
+    if (!focused || (have_pad && !s_kbm.merge)) {
+        /* Release everything on focus loss, or a key held while alt-tabbing
+         * would stay down forever; drop the taps latched meanwhile. */
+        for (int i = 0; i < 8; i++) InterlockedExchange(&s_kbm_latch[i], 0);
+        kbm_runtime_reset(&s_kbm_rt);
+    }
+    if (have_pad && !s_kbm.merge) {
+        s_kbm_was_focused = focused;
+        InterlockedExchange(&s_kbm_busy, 0);
+        return;
+    }
+
+    KbmOut o;
+    if (!focused) {
+        memset(&o, 0, sizeof o);
+    } else {
+        kbm_snapshot(!s_kbm_was_focused);
+        kbm_eval(&s_kbm, &s_kbm_rt, kbm_key_down, NULL, kbm_now_ms(), dx, dy, wh, &o);
+    }
+    s_kbm_was_focused = focused;
+
+    u16 b = o.buttons;
+    if (!have_pad) {
+        kbm_arb_reset(&s_kbm_arb);             /* a controller that comes starts with the sticks */
+        hs->connected = 1;
+        hs->buttons   = b;
+        hs->analog_lx = kbm_axis_u8(o.lx);
+        hs->analog_ly = kbm_axis_u8(o.ly);
+        hs->analog_rx = kbm_axis_u8(o.rx);
+        hs->analog_ry = kbm_axis_u8(o.ry);
+        hs->trigger_l2 = (u8)((b & CELL_PAD_CTRL_L2) ? 255 : 0);
+        hs->trigger_r2 = (u8)((b & CELL_PAD_CTRL_R2) ? 255 : 0);
+    } else {
+        /* Each stick from the device used last (pad_kbm.h, kbm_arbitrate):
+         * a resting or jittering mouse no longer takes the camera from a
+         * controller player. */
+        int use_l, use_r;
+        kbm_arbitrate(&s_kbm, &s_kbm_arb, 1, hs->buttons, hs->analog_lx, hs->analog_ly, hs->analog_rx,
+                      hs->analog_ry, &o, dx, dy, kbm_now_ms(), &use_l, &use_r);
+        hs->buttons |= b;
+        if (use_l) { hs->analog_lx = kbm_axis_u8(o.lx); hs->analog_ly = kbm_axis_u8(o.ly); }
+        if (use_r == 1)      { hs->analog_rx = kbm_axis_u8(o.rx);  hs->analog_ry = kbm_axis_u8(o.ry); }
+        else if (use_r == 2) { hs->analog_rx = kbm_axis_u8(o.krx); hs->analog_ry = kbm_axis_u8(o.kry); }
+        if (b & CELL_PAD_CTRL_L2) hs->trigger_l2 = 255;
+        if (b & CELL_PAD_CTRL_R2) hs->trigger_r2 = 255;
+    }
+    /* Pressure bytes (press mode): keys are all-or-nothing. Without a
+     * controller they follow the keys; merged, a held key forces its byte
+     * full and the controller's values stand otherwise. */
+    {
+        static const struct { u16 bit; size_t off; } pr[] = {
+            { CELL_PAD_CTRL_UP,       offsetof(PadHostState, press_up) },
+            { CELL_PAD_CTRL_DOWN,     offsetof(PadHostState, press_down) },
+            { CELL_PAD_CTRL_LEFT,     offsetof(PadHostState, press_left) },
+            { CELL_PAD_CTRL_RIGHT,    offsetof(PadHostState, press_right) },
+            { CELL_PAD_CTRL_TRIANGLE, offsetof(PadHostState, press_triangle) },
+            { CELL_PAD_CTRL_CIRCLE,   offsetof(PadHostState, press_circle) },
+            { CELL_PAD_CTRL_CROSS,    offsetof(PadHostState, press_cross) },
+            { CELL_PAD_CTRL_SQUARE,   offsetof(PadHostState, press_square) },
+            { CELL_PAD_CTRL_L1,       offsetof(PadHostState, press_l1) },
+            { CELL_PAD_CTRL_R1,       offsetof(PadHostState, press_r1) },
+        };
+        for (unsigned i = 0; i < sizeof pr / sizeof pr[0]; i++) {
+            u8* p = (u8*)hs + pr[i].off;
+            if (b & pr[i].bit) *p = 255;
+            else if (!have_pad) *p = 0;
+        }
+    }
+
+    { static int said = 0;
+      if (!said && (b || o.l_active || o.r_active)) { said = 1;
+          printf("[cellPad] keyboard/mouse input active on port 0 (%s)\n",
+                 have_pad ? "merged with the controller" : "no controller");
+          fflush(stdout); } }
+    InterlockedExchange(&s_kbm_busy, 0);
+}
+
+int cellPad_kbm_set(const char* key, const char* value)
+{
+    if (!key || !value) return -1;
+    kbm_ensure();
+    char line[300], err[200];
+    snprintf(line, sizeof line, "%s = %s", key, value);
+    /* Wait out a report in progress (microseconds), then edit under the
+     * interlock: the report reads the table only while it holds it. */
+    while (InterlockedCompareExchange(&s_kbm_busy, 1, 0) != 0) Sleep(0);
+    KbmConfig c = s_kbm;
+    int r = kbm_parse_line(&c, line, err, sizeof err);
+    if (r > 0) {
+        /* not live: they start or stop the raw-input thread and the capture */
+        c.keyboard = s_kbm.keyboard; c.mouse = s_kbm.mouse;
+        c.capture = s_kbm.capture;   c.merge = s_kbm.merge;
+        s_kbm = c;
+    }
+    InterlockedExchange(&s_kbm_busy, 0);
+    if (r < 0) printf("[cellPad] %s: %s\n", key, err);
+    return r > 0 ? 1 : -1;
+}
+
+int cellPad_kbm_unbind_key(int vk)
+{
+    kbm_ensure();
+    int n = 0;
+    while (InterlockedCompareExchange(&s_kbm_busy, 1, 0) != 0) Sleep(0);
+    for (int t = 0; t < KBM_NUM_TARGETS; t++) {
+        int k = 0;
+        for (int j = 0; j < s_kbm.nkeys[t]; j++) {
+            if (s_kbm.keys[t][j] == (uint16_t)vk) {
+                char kn[24];
+                printf("[cellPad] %s is the options menu's key: removed from %s\n",
+                       kbm_key_name(vk, kn, sizeof kn), kbm_target_name(t));
+                n++;
+                continue;
+            }
+            s_kbm.keys[t][k++] = s_kbm.keys[t][j];
+        }
+        s_kbm.nkeys[t] = (uint8_t)k;
+    }
+    InterlockedExchange(&s_kbm_busy, 0);
+    if (n) fflush(stdout);
+    return n;
+}
+
+/* --- raw mouse input ----------------------------------------------------- */
+
+/* One WM_INPUT: add its motion and wheel to the pad report's accumulators.
+ * Runs on whichever thread receives raw input (the raw input thread, or the
+ * game window's as a fallback). */
+static void kbm_on_wm_input(LPARAM lp)
+{
+    RAWINPUT ri;
+    UINT sz = sizeof ri;
+    if (!s_kbm_captured) return;
+    if (GetRawInputData((HRAWINPUT)lp, RID_INPUT, &ri, &sz, sizeof(RAWINPUTHEADER)) == (UINT)-1 ||
+        ri.header.dwType != RIM_TYPEMOUSE) return;
+    const RAWMOUSE* m = &ri.data.mouse;
+    LONG dx = 0, dy = 0;
+    if (m->usFlags & MOUSE_MOVE_ABSOLUTE) {
+        /* Remote desktop, VMs, tablets: absolute 0..65535. */
+        int virt = (m->usFlags & MOUSE_VIRTUAL_DESKTOP) != 0;
+        int w = GetSystemMetrics(virt ? SM_CXVIRTUALSCREEN : SM_CXSCREEN);
+        int h = GetSystemMetrics(virt ? SM_CYVIRTUALSCREEN : SM_CYSCREEN);
+        LONG x = MulDiv(m->lLastX, w, 65535), y = MulDiv(m->lLastY, h, 65535);
+        if (s_kbm_abs_valid) { dx = x - s_kbm_abs_x; dy = y - s_kbm_abs_y; }
+        s_kbm_abs_x = x; s_kbm_abs_y = y; s_kbm_abs_valid = 1;
+    } else {
+        dx = m->lLastX;
+        dy = m->lLastY;
+    }
+    if (dx) InterlockedExchangeAdd(&s_kbm_mdx, dx);
+    if (dy) InterlockedExchangeAdd(&s_kbm_mdy, dy);
+    if (m->usButtonFlags & RI_MOUSE_WHEEL)
+        InterlockedExchangeAdd(&s_kbm_wheel, (LONG)(SHORT)m->usButtonData);
+}
+
+/* Register (on) or remove (off) raw mouse input for target h. Called on the
+ * thread that owns h. With the raw input thread's message-only window the
+ * input has to be a sink (that window is never in front); it is only
+ * registered while the mouse is captured, i.e. while the game is in front. */
+static int kbm_raw_register(HWND h, int on, DWORD sink)
+{
+    RAWINPUTDEVICE rid;
+    rid.usUsagePage = 0x01;                    /* generic desktop */
+    rid.usUsage     = 0x02;                    /* mouse */
+    rid.dwFlags     = on ? sink : RIDEV_REMOVE;   /* legacy mouse messages kept */
+    rid.hwndTarget  = on ? h : NULL;
+    if (on) s_kbm_abs_valid = 0;
+    if (RegisterRawInputDevices(&rid, 1, sizeof rid)) return 1;
+    if (on) {
+        static int said = 0;
+        if (!said) { said = 1;
+            printf("[cellPad] raw mouse input unavailable (error %lu): no mouse camera, "
+                   "mouse buttons still work\n", (unsigned long)GetLastError());
+            fflush(stdout); }
+    }
+    return 0;
+}
+
+static LRESULT CALLBACK kbm_sink_proc(HWND h, UINT msg, WPARAM wp, LPARAM lp)
+{
+    if (msg == WM_INPUT) {
+        kbm_on_wm_input(lp);
+        return DefWindowProcA(h, msg, wp, lp);  /* frees the raw input */
+    }
+    if (msg == KBM_WM_RAW) return kbm_raw_register(h, (int)wp, RIDEV_INPUTSINK);
+    return DefWindowProcA(h, msg, wp, lp);
+}
+
+static DWORD WINAPI kbm_sink_thread(LPVOID ready)
+{
+    WNDCLASSEXA wc;
+    memset(&wc, 0, sizeof wc);
+    wc.cbSize        = sizeof wc;
+    wc.lpfnWndProc   = kbm_sink_proc;
+    wc.hInstance     = GetModuleHandleA(NULL);
+    wc.lpszClassName = "ps3recomp_kbm_rawmouse";
+    RegisterClassExA(&wc);
+    s_kbm_sink = CreateWindowExA(0, wc.lpszClassName, "", 0, 0, 0, 0, 0, HWND_MESSAGE,
+                                 NULL, wc.hInstance, NULL);
+    SetEvent((HANDLE)ready);
+    if (!s_kbm_sink) return 1;
+    MSG m;
+    while (GetMessageA(&m, NULL, 0, 0) > 0) DispatchMessageA(&m);
+    return 0;
+}
+
+static void kbm_sink_start(void)
+{
+    HANDLE ready = CreateEventA(NULL, TRUE, FALSE, NULL);
+    if (!ready) return;
+    HANDLE t = CreateThread(NULL, 64 * 1024, kbm_sink_thread, ready, 0, NULL);
+    if (t) {
+        WaitForSingleObject(ready, 2000);
+        CloseHandle(t);
+    }
+    CloseHandle(ready);
+    if (!s_kbm_sink) {
+        printf("[cellPad] raw input thread unavailable: the game window receives mouse motion\n");
+        fflush(stdout);
+    }
+}
+
+/* Mouse motion on (capture) or off (release). */
+static void kbm_raw_mouse(HWND game, int on)
+{
+    if (s_kbm_sink) PostMessageA(s_kbm_sink, KBM_WM_RAW, (WPARAM)on, 0);
+    else            kbm_raw_register(game, on, 0);   /* game window: foreground only */
+}
+
+/* --- window thread side -------------------------------------------------- */
+
+static void kbm_clip_to_client(HWND h)
+{
+    RECT rc;
+    POINT a, b;
+    if (!GetClientRect(h, &rc)) return;
+    a.x = rc.left;  a.y = rc.top;
+    b.x = rc.right; b.y = rc.bottom;
+    ClientToScreen(h, &a);
+    ClientToScreen(h, &b);
+    if (b.x <= a.x || b.y <= a.y) return;      /* minimised */
+    rc.left = a.x; rc.top = a.y; rc.right = b.x; rc.bottom = b.y;
+    ClipCursor(&rc);
+}
+
+static void kbm_log_capture(const char* what)
+{
+    static int n = 0;
+    if (n++ < 40) { printf("[cellPad] mouse %s\n", what); fflush(stdout); }
+}
+
+static void kbm_capture(HWND h, int click_vk)
+{
+    static const int vks[] = { VK_LBUTTON, VK_RBUTTON, VK_MBUTTON, VK_XBUTTON1, VK_XBUTTON2 };
+    if (s_kbm_captured) return;
+    /* The click that captures is not a game input: every mouse button down
+     * right now is ignored until it is released. */
+    LONG held = click_vk ? 1L << click_vk : 0;
+    for (unsigned i = 0; i < sizeof vks / sizeof vks[0]; i++)
+        if (GetAsyncKeyState(vks[i]) & 0x8000) held |= 1L << vks[i];
+    InterlockedExchange(&s_kbm_swallow, held);
+    InterlockedExchange(&s_kbm_mdx, 0);
+    InterlockedExchange(&s_kbm_mdy, 0);
+    InterlockedExchange(&s_kbm_wheel, 0);
+    s_kbm_hwnd = h;
+    kbm_clip_to_client(h);
+    SetCursor(NULL);
+    /* Something else can reset the cursor clip while the game stays in front
+     * (another program's ClipCursor, a display change): re-assert it, or the
+     * hidden cursor wanders off the window and the next click lands in
+     * another application. */
+    SetTimer(h, KBM_TIMER_ID, 500, NULL);
+    InterlockedExchange(&s_kbm_captured, 1);
+    kbm_raw_mouse(h, 1);
+    kbm_log_capture("captured (Alt or F10 releases it)");
+}
+
+static void kbm_release(void)
+{
+    if (!InterlockedExchange(&s_kbm_captured, 0)) return;
+    kbm_raw_mouse(s_kbm_hwnd, 0);
+    if (s_kbm_hwnd) KillTimer(s_kbm_hwnd, KBM_TIMER_ID);
+    ClipCursor(NULL);
+    SetCursor(LoadCursor(NULL, IDC_ARROW));
+    InterlockedExchange(&s_kbm_mdx, 0);
+    InterlockedExchange(&s_kbm_mdy, 0);
+    InterlockedExchange(&s_kbm_wheel, 0);
+    kbm_log_capture("released (click in the window to capture it again)");
+}
+
+void cellPad_host_window_created(void* hwnd)
+{
+    (void)hwnd;
+    kbm_ensure();                      /* load + print the table at window creation */
+#if PAD_BACKEND_HOST
+    InterlockedExchange(&s_pad_window_up, 1);   /* the window's notice box exists (rsx_winmenu_attach ran) */
+#endif
+    if (s_kbm_mouse_on && !s_kbm_sink) {
+        kbm_sink_start();
+        /* mouse_capture = focus captures while the window is being created,
+         * before that thread existed: move the registration over to it */
+        if (s_kbm_sink && s_kbm_captured) PostMessageA(s_kbm_sink, KBM_WM_RAW, 1, 0);
+    }
+}
+
+/* --- window hotkeys, input hold (window thread) ---------------------------- */
+
+/* Keep a hotkey's key from the game until it is released; a press of it
+ * latched but not reported yet (a modifier pressed just before) is dropped. */
+static void kbm_hk_block(int vk)
+{
+    if (vk <= 0 || vk >= 256) return;
+    InterlockedOr(&s_kbm_hkblock[vk >> 5], kbm_vk_bit(vk));
+    InterlockedAnd(&s_kbm_latch[vk >> 5], ~kbm_vk_bit(vk));
+}
+
+int cellPad_host_hotkey(unsigned int msg, uintptr_t wp, intptr_t lp)
+{
+    if (msg != WM_KEYDOWN && msg != WM_SYSKEYDOWN) return 0;
+    const int vk = (int)wp;
+    if (vk <= 0 || vk > 0xFE) return 0;
+    kbm_ensure();
+    /* GetKeyState: the modifiers as of this message, not as of now. */
+    int mods = ((GetKeyState(VK_SHIFT)   & 0x8000) ? HK_MOD_SHIFT : 0) |
+               ((GetKeyState(VK_CONTROL) & 0x8000) ? HK_MOD_CTRL  : 0) |
+               ((GetKeyState(VK_MENU)    & 0x8000) ? HK_MOD_ALT   : 0);
+    if (msg == WM_SYSKEYDOWN && (lp & 0x20000000)) mods |= HK_MOD_ALT;   /* context code: Alt held */
+    const int a = hk_match(&s_hk, vk, mods);
+    if (a == HK_NONE) return 0;
+    if (lp & 0x40000000) return a | HK_REPEAT;          /* auto-repeat: swallowed, not acted on */
+    /* The pad reads held keys directly: keep this combination's keys from
+     * the game until they are released (bound modifiers included). */
+    kbm_hk_block(vk);
+    if (mods & HK_MOD_SHIFT) { kbm_hk_block(VK_SHIFT); kbm_hk_block(VK_LSHIFT); kbm_hk_block(VK_RSHIFT); }
+    if (mods & HK_MOD_CTRL)  { kbm_hk_block(VK_CONTROL); kbm_hk_block(VK_LCONTROL); kbm_hk_block(VK_RCONTROL); }
+    return a;
+}
+
+int cellPad_host_hotkey_text(int action, char* buf, int n)
+{
+    if (!buf || n <= 0) return 0;
+    kbm_ensure();
+    hk_action_text(&s_hk, action, buf, (size_t)n);
+    return buf[0] != 0;
+}
+
+void cellPad_host_input_hold(int on)
+{
+    if (on) {
+        /* A menu needs the cursor: release a captured mouse (on this, the
+         * window's thread). */
+        if (InterlockedIncrement(&s_kbm_hold) == 1) kbm_release();
+        return;
+    }
+    /* The next report is a focus gain. The generation goes first: a report
+     * that reads the hold as over then also reads the new generation (in the
+     * other order one could see neither the hold nor the new generation and
+     * let the Enter that picked the item through as Cross). */
+    InterlockedIncrement(&s_kbm_hold_gen);
+    if (InterlockedDecrement(&s_kbm_hold) < 0) InterlockedExchange(&s_kbm_hold, 0);
+}
+
+int cellPad_host_input_held(void)
+{
+    return s_kbm_hold > 0;
+}
+
+int cellPad_host_window_message(void* hwnd_, unsigned int msg, uintptr_t wp, intptr_t lp,
+                                intptr_t* result)
+{
+    HWND hwnd = (HWND)hwnd_;
+    /* Alt or F10 alone would put the window into menu mode: a modal loop
+     * inside DispatchMessage on the window thread, which here is the thread
+     * that drains the RSX FIFO -- the game would freeze until the next key.
+     * Alt+F4 is SC_CLOSE and is not affected. */
+    if (msg == WM_SYSCOMMAND && (wp & 0xFFF0) == SC_KEYMENU) { *result = 0; return 1; }
+
+    kbm_ensure();
+
+    /* Latch key presses for the next pad report (see kbm_host_key). Only
+     * WM_KEYDOWN: Alt combinations arrive as WM_SYSKEYDOWN and are not game
+     * input. Bit 30 set = auto-repeat. */
+    if (msg == WM_KEYDOWN) {
+        if (s_kbm_kb_on && !(lp & 0x40000000)) {
+            int vk = (int)wp;
+            kbm_latch(vk);
+            if (vk == VK_SHIFT)        /* the left/right key the bindings name */
+                kbm_latch((int)MapVirtualKeyA((UINT)((lp >> 16) & 0xFF), MAPVK_VSC_TO_VK_EX));
+            else if (vk == VK_CONTROL)
+                kbm_latch((lp & 0x01000000) ? VK_RCONTROL : VK_LCONTROL);
+        }
+        return 0;
+    }
+    /* Release before the window goes away (close button, Alt+F4, shutdown):
+     * the exit path is ExitProcess right after. */
+    if (msg == WM_CLOSE || msg == WM_DESTROY) { kbm_release(); return 0; }
+
+    if (!s_kbm_mouse_on) return 0;
+
+    switch (msg) {
+    case WM_INPUT:                      /* only without the raw input thread */
+        if (!s_kbm_sink && GET_RAWINPUT_CODE_WPARAM(wp) == RIM_INPUT) kbm_on_wm_input((LPARAM)lp);
+        return 0;                       /* DefWindowProc must still see WM_INPUT */
+
+    case WM_TIMER:
+        if (wp != KBM_TIMER_ID) return 0;
+        if (s_kbm_captured) kbm_clip_to_client(hwnd);
+        else KillTimer(hwnd, KBM_TIMER_ID);
+        *result = 0;
+        return 1;
+
+    case WM_LBUTTONDOWN: case WM_RBUTTONDOWN: case WM_MBUTTONDOWN: case WM_XBUTTONDOWN: {
+        int vk = msg == WM_LBUTTONDOWN ? VK_LBUTTON : msg == WM_RBUTTONDOWN ? VK_RBUTTON :
+                 msg == WM_MBUTTONDOWN ? VK_MBUTTON :
+                 (GET_XBUTTON_WPARAM(wp) == XBUTTON1 ? VK_XBUTTON1 : VK_XBUTTON2);
+        if (!s_kbm_captured && !s_icpt && GetForegroundWindow() == hwnd) {   /* not while the system has the pad */
+            kbm_capture(hwnd, vk);
+            *result = (msg == WM_XBUTTONDOWN) ? TRUE : 0;
+            return 1;
+        }
+        if (s_kbm_captured) kbm_latch(vk);
+        return 0;
+    }
+
+    case WM_LBUTTONUP: case WM_RBUTTONUP: case WM_MBUTTONUP: case WM_XBUTTONUP: {
+        /* The capturing click is over even if no pad report saw it end (the
+         * game not polling the pad, e.g. on a loading screen): stop
+         * swallowing it, or the next real click would be eaten too. */
+        int vk = msg == WM_LBUTTONUP ? VK_LBUTTON : msg == WM_RBUTTONUP ? VK_RBUTTON :
+                 msg == WM_MBUTTONUP ? VK_MBUTTON :
+                 (GET_XBUTTON_WPARAM(wp) == XBUTTON1 ? VK_XBUTTON1 : VK_XBUTTON2);
+        InterlockedAnd(&s_kbm_swallow, ~(1L << vk));
+        return 0;
+    }
+
+    case WM_SETCURSOR:
+        if (s_kbm_captured && LOWORD(lp) == HTCLIENT) { SetCursor(NULL); *result = TRUE; return 1; }
+        return 0;
+
+    case WM_ACTIVATE:
+        if (LOWORD(wp) == WA_INACTIVE) kbm_release();
+        else if (s_kbm.capture == KBM_CAPTURE_FOCUS && !HIWORD(wp) && !s_icpt) kbm_capture(hwnd, 0);
+        return 0;
+
+    case WM_ACTIVATEAPP:
+        if (!wp) kbm_release();
+        return 0;
+
+    case WM_KILLFOCUS:
+        kbm_release();
+        return 0;
+
+    case WM_SYSKEYDOWN:
+        if (wp == VK_MENU || wp == VK_F10) kbm_release();
+        return 0;                       /* DefWindowProc keeps Alt+F4 */
+
+    case WM_SIZE:
+        if (s_kbm_captured) kbm_clip_to_client(hwnd);
+        else if (s_kbm.capture == KBM_CAPTURE_FOCUS && wp != SIZE_MINIMIZED && !s_icpt &&
+                 GetForegroundWindow() == hwnd)
+            kbm_capture(hwnd, 0);       /* restored from minimised */
+        return 0;
+
+    case WM_MOVE: case WM_DISPLAYCHANGE:
+        if (s_kbm_captured) kbm_clip_to_client(hwnd);
+        return 0;
+
+    default:
+        return 0;
+    }
+}
+
+int cellPad_host_mouse_release(void)
+{
+    kbm_ensure();
+    const int was = s_kbm_captured != 0;
+    kbm_release();
+    return was;
+}
+
+void cellPad_host_mouse_capture(void* hwnd)
+{
+    kbm_ensure();
+    if (s_kbm_mouse_on && !s_kbm_captured && hwnd && GetForegroundWindow() == (HWND)hwnd)
+        kbm_capture((HWND)hwnd, 0);
+}
