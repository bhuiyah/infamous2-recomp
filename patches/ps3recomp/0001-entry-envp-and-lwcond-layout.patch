+/* -1 when the directory cannot be read (`out` is then empty). */
+static int list_dir(const char* path, savedata_names* out)
+{
+    memset(out, 0, sizeof *out);
+#ifdef _WIN32
+    char search[1024];
+    snprintf(search, sizeof search, "%s\\*", path);
+    for (char* p = search; *p; p++) if (*p == '/') *p = '\\';
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(search, &fd);
+    if (h == INVALID_HANDLE_VALUE) return -1;
+    do {
+        if (!strcmp(fd.cFileName, ".") || !strcmp(fd.cFileName, "..")) continue;
+        if (names_add(out, fd.cFileName, (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0))
+            break;
+    } while (FindNextFileA(h, &fd));
+    FindClose(h);
+#else
+    DIR* dp = opendir(path);
+    if (!dp) return -1;
+    struct dirent* de;
+    while ((de = readdir(dp)) != NULL) {
+        if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, "..")) continue;
+        char full[1024];
+        snprintf(full, sizeof full, "%s/%s", path, de->d_name);
+        if (names_add(out, de->d_name, dir_exists(full))) break;
+    }
+    closedir(dp);
+#endif
+    return 0;
+}
+
+/* Delete a save directory: its files, then the directory. Saves are flat; a
+ * subdirectory is left alone, and the failed rmdir is logged. */
+static void remove_save_dir(const char* path)
+{
+    savedata_names s;
+    if (list_dir(path, &s) < 0) return;
+    char full[1024];
+    for (u32 i = 0; i < s.n; i++) {
+        if (s.dir[i]) continue;
+        path_join(full, sizeof full, path, s.v[i]);
+        remove(full);
+    }
+    names_free(&s);
+#ifdef _WIN32
+    if (_rmdir(path) != 0)
+#else
+    if (rmdir(path) != 0)
+#endif
+        printf("[cellSaveData] could not remove '%s'\n", path);
+}
+
+static int copy_file(const char* from, const char* to)
+{
+    FILE* in = fopen(from, "rb");
+    if (!in) return -1;
+    FILE* out = fopen(to, "wb");
+    if (!out) { fclose(in); return -1; }
+    char buf[16384];
+    size_t n;
+    int bad = 0;
+    while (!bad && (n = fread(buf, 1, sizeof buf, in)) > 0)
+        bad = fwrite(buf, 1, n, out) != n;
+    if (ferror(in)) bad = 1;
+    fclose(in);
+    if (fclose(out) != 0) bad = 1;
+    return bad ? -1 : 0;
+}
+
+/* Copy every file of one save directory into another, except PARAM.PFD: the
+ * copy is about to be rewritten, and neither RPCS3 nor this service keeps a
+ * PFD (the one-name-per-line text PFD this file used to write is folded into
+ * PARAM.SFO's "*NAME" keys when the save is rewritten). */
+static int copy_save_files(const char* from, const char* to)
+{
+    savedata_names s;
+    if (list_dir(from, &s) < 0) return 0;
+    char a[1024], b[1024];
+    int bad = 0;
+    for (u32 i = 0; i < s.n; i++) {
+        if (s.dir[i] || !strcmp(s.v[i], "PARAM.PFD")) continue;
+        path_join(a, sizeof a, from, s.v[i]);
+        path_join(b, sizeof b, to, s.v[i]);
+        if (copy_file(a, b) != 0) {
+            printf("[cellSaveData] copy '%s' -> '%s' failed\n", a, b);
+            bad = 1;
+        }
+    }
+    names_free(&s);
+    return bad ? -1 : 0;
+}
+
+/* System metadata belongs to the service, not the guest file list. */
+static int savedata_system_file(const char* name)
+{
+    return !strcmp(name, "PARAM.SFO") || !strcmp(name, "PARAM.PFD");
+}
+
+/* Which files of a save are SECUREFILEs. Firmware records them in PARAM.PFD;
+ * RPCS3, and this service, as an int key "*NAME" in PARAM.SFO (1 = secure).
+ * Without it every file came back as NORMALFILE, and a title that looks for
+ * its secure payload in the stat list (The Simpsons Arcade Game) called its
+ * own fresh save corrupt. */
+#define SAVEDATA_FILES_MAX 64
+typedef struct savedata_files {
+    u32  n;
+    char name[SAVEDATA_FILES_MAX][CELL_SAVEDATA_FILENAME_SIZE + 3];
+    u8   secure[SAVEDATA_FILES_MAX];
+} savedata_files;
+
+static int files_find(const savedata_files* f, const char* name)
+{
+    for (u32 i = 0; f && i < f->n; i++)
+        if (!strcmp(f->name[i], name)) return (int)i;
+    return -1;
+}
+
+/* 1 secure, 0 normal, -1 not recorded */
+static int files_get(const savedata_files* f, const char* name)
+{
+    int i = files_find(f, name);
+    return i < 0 ? -1 : f->secure[i];
+}
+
+static void files_set(savedata_files* f, const char* name, int secure)
+{
+    if (!f || strlen(name) >= sizeof f->name[0]) return;
+    int i = files_find(f, name);
+    if (i < 0) {
+        if (f->n == SAVEDATA_FILES_MAX) return;
+        i = (int)f->n++;
+        strcpy(f->name[i], name);
+    }
+    f->secure[i] = (u8)(secure != 0);
+}
+
+static void files_remove(savedata_files* f, const char* name)
+{
+    int i = files_find(f, name);
+    if (i < 0) return;
+    f->n--;
+    if ((u32)i != f->n) {
+        memcpy(f->name[i], f->name[f->n], sizeof f->name[0]);
+        f->secure[i] = f->secure[f->n];
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * PARAM.SFO
+ *
+ * This file used to write a private text PARAM.SFO ("TITLE=...\n"). That lost
+ * every line of a multi-line DETAIL after the first -- inFamous 2's is
+ * "Completion: 1%\nPowers and Upgrades: 13\n" -- and made our saves and
+ * RPCS3's unreadable to each other. It is now the real format: little-endian
+ * PSF 1.1 with the key set RPCS3 writes for a save (keys sorted, data slots
+ * at their maximum size), so a save copied in from RPCS3 loads here and ours
+ * load there. The old text form and the one-name-per-line PARAM.PFD that went
+ * with it are still read.
+ * -----------------------------------------------------------------------*/
+#define PSF_FMT_UTF8S 0x0004u   /* utf8, not NUL-terminated */
+#define PSF_FMT_UTF8  0x0204u   /* utf8, NUL-terminated     */
+#define PSF_FMT_INT32 0x0404u
+
+typedef struct psf_item {
+    const char* key;
+    u16 fmt;
+    u32 len, max;
+    const void* data;
+    u32 ival;
+} psf_item;
+
+static u32 psf_le32(const u8* p) { return p[0] | (u32)p[1] << 8 | (u32)p[2] << 16 | (u32)p[3] << 24; }
+static u16 psf_le16(const u8* p) { return (u16)(p[0] | p[1] << 8); }
+static void psf_put32(u8* p, u32 v) { p[0] = (u8)v; p[1] = (u8)(v >> 8); p[2] = (u8)(v >> 16); p[3] = (u8)(v >> 24); }
+static void psf_put16(u8* p, u16 v) { p[0] = (u8)v; p[1] = (u8)(v >> 8); }
+
+static void psf_str(psf_item* it, const char* key, const char* s, u32 max)
+{
+    it->key = key; it->fmt = PSF_FMT_UTF8; it->max = max; it->data = s; it->ival = 0;
+    it->len = (u32)(s ? strnlen(s, max - 1) : 0) + 1;
+}
+
+static void psf_int(psf_item* it, const char* key, u32 v)
+{
+    it->key = key; it->fmt = PSF_FMT_INT32; it->len = it->max = 4; it->data = NULL; it->ival = v;
+}
+
+static int psf_item_cmp(const void* a, const void* b)
+{
+    return strcmp(((const psf_item*)a)->key, ((const psf_item*)b)->key);
+}
+
+static int psf_write_file(const char* path, psf_item* it, u32 n)
+{
+    qsort(it, n, sizeof *it, psf_item_cmp);
+    u32 keys = 0, data = 0;
+    for (u32 i = 0; i < n; i++) {
+        keys += (u32)strlen(it[i].key) + 1;
+        data += (it[i].max + 3) & ~3u;
+    }
+    const u32 key_start = 0x14 + n * 0x10;
+    const u32 data_start = key_start + ((keys + 3) & ~3u);
+    u8* b = (u8*)calloc(1, data_start + data);
+    if (!b) return -1;
+    memcpy(b, "\0PSF", 4);
+    psf_put32(b + 4, 0x101);
+    psf_put32(b + 8, key_start);
+    psf_put32(b + 12, data_start);
+    psf_put32(b + 16, n);
+    u32 ko = 0, doff = 0;
+    for (u32 i = 0; i < n; i++) {
+        u8* e = b + 0x14 + i * 0x10;
+        psf_put16(e, (u16)ko);
+        psf_put16(e + 2, it[i].fmt);
+        psf_put32(e + 4, it[i].len);
+        psf_put32(e + 8, it[i].max);
+        psf_put32(e + 12, doff);
+        strcpy((char*)b + key_start + ko, it[i].key);
+        ko += (u32)strlen(it[i].key) + 1;
+        u8* d = b + data_start + doff;
+        if (it[i].fmt == PSF_FMT_INT32) psf_put32(d, it[i].ival);
+        else if (it[i].data) memcpy(d, it[i].data, it[i].fmt == PSF_FMT_UTF8 ? it[i].len - 1 : it[i].len);
+        doff += (it[i].max + 3) & ~3u;
+    }
+    FILE* fp = fopen(path, "wb");
+    int bad = !fp;
+    if (fp) {
+        bad = fwrite(b, 1, data_start + data, fp) != data_start + data;
+        if (fclose(fp) != 0) bad = 1;
+    }
+    free(b);
+    return bad ? -1 : 0;
+}
+
+static int name_cmp(const void* a, const void* b)
+{
+    return strcmp((const char*)a, (const char*)b);
+}
+
+/* CellSaveDataSystemFileParam.reserved2 is RPCS3's (and SDK < 3.70's)
+ * parental_level, a big-endian u32 in guest layout. RPCS3 writes it to
+ * PARENTAL_LEVEL and hands it back in getParam, so a title that edits getParam
+ * in place (inFamous 2) round-trips it. */
+static u32 sysparam_parental(const CellSaveDataSystemFileParam* p)
+{
+    const u8* b = (const u8*)p->reserved2;
+    return (u32)b[0] << 24 | (u32)b[1] << 16 | (u32)b[2] << 8 | b[3];
+}
+
+static void sysparam_set_parental(CellSaveDataSystemFileParam* p, u32 v)
+{
+    u8* b = (u8*)p->reserved2;
+    b[0] = (u8)(v >> 24); b[1] = (u8)(v >> 16); b[2] = (u8)(v >> 8); b[3] = (u8)v;
+}
+
+/* Write PARAM.SFO into save directory `dir`, with a "*NAME" flag for each
+ * file the directory holds and, as RPCS3 does, RPCS3_BLIST: those names
+ * sorted and joined with '/' ("ICON0.PNG/STATE"). */
+static int savedata_write_sfo(const char* dir, const CellSaveDataSystemFileParam* p,
+                              const char* dirName, const savedata_files* files)
+{
+    psf_item it[16 + SAVEDATA_FILES_MAX];
+    char keys[SAVEDATA_FILES_MAX][CELL_SAVEDATA_FILENAME_SIZE + 4];
+    char blist[SAVEDATA_FILES_MAX * (CELL_SAVEDATA_FILENAME_SIZE + 3)];
+    char account[16];
+    u32 n = 0, k = 0;
+    memset(account, '0', sizeof account);
+    it[n].key = "ACCOUNT_ID"; it[n].fmt = PSF_FMT_UTF8S; it[n].len = it[n].max = 16;
+    it[n].data = account; it[n].ival = 0; n++;
+    psf_int(&it[n++], "ATTRIBUTE", p->attribute);
+    psf_str(&it[n++], "CATEGORY", "SD", 4);
+    psf_str(&it[n++], "DETAIL", p->detail, CELL_SAVEDATA_SYSP_DETAIL_SIZE);
+    psf_str(&it[n++], "PARAMS", "", 1024);
+    psf_str(&it[n++], "PARAMS2", "", 12);
+    psf_int(&it[n++], "PARENTAL_LEVEL", sysparam_parental(p));
+    psf_str(&it[n++], "SAVEDATA_DIRECTORY", dirName, CELL_SAVEDATA_DIRNAME_SIZE);
+    psf_str(&it[n++], "SAVEDATA_LIST_PARAM", p->listParam, CELL_SAVEDATA_SYSP_LPARAM_SIZE);
+    psf_str(&it[n++], "SUB_TITLE", p->subTitle, CELL_SAVEDATA_SYSP_SUBTITLE_SIZE);
+    psf_str(&it[n++], "TITLE", p->title, CELL_SAVEDATA_SYSP_TITLE_SIZE);
+    savedata_names s;
+    if (list_dir(dir, &s) == 0) {
+        for (u32 i = 0; i < s.n && k < SAVEDATA_FILES_MAX; i++) {
+            if (s.dir[i] || savedata_system_file(s.v[i]) ||
+                strlen(s.v[i]) > CELL_SAVEDATA_FILENAME_SIZE + 2) continue;
+            snprintf(keys[k], sizeof keys[k], "*%s", s.v[i]);
+            psf_int(&it[n++], keys[k], files_get(files, s.v[i]) == 1);
+            k++;
+        }
+        names_free(&s);
+    }
+    if (k) {
+        /* sorted copy: it[] points into keys[] */
+        char sorted[SAVEDATA_FILES_MAX][CELL_SAVEDATA_FILENAME_SIZE + 4];
+        memcpy(sorted, keys, k * sizeof keys[0]);
+        qsort(sorted, k, sizeof sorted[0], name_cmp);
+        size_t len = 0;
+        for (u32 i = 0; i < k; i++)
+            len += (size_t)snprintf(blist + len, sizeof blist - len, "%s%s", i ? "/" : "", sorted[i] + 1);
+        it[n].key = "RPCS3_BLIST"; it[n].fmt = PSF_FMT_UTF8; it[n].data = blist; it[n].ival = 0;
+        it[n].len = (u32)len + 1; it[n].max = ((u32)len + 1 + 3) & ~3u; n++;
+    }
+    char path[1024];
+    path_join(path, sizeof path, dir, "PARAM.SFO");
+    return psf_write_file(path, it, n);
+}
+
+static void sfo_copy(char* dst, size_t cap, const u8* v, u32 len)
+{
+    size_t n = strnlen((const char*)v, len);
+    if (n >= cap) n = cap - 1;
+    memcpy(dst, v, n);
+    dst[n] = '\0';
+}
+
+/* Fill `param` (and, if given, the secure-file flags) from a save's
+ * PARAM.SFO. Accepts the PSF every writer uses and this file's old text form. */
+static void read_param_sfo(const char* save_path, CellSaveDataSystemFileParam* param,
+                           savedata_files* files)
+{
+    if (!param) return;
+    memset(param, 0, sizeof(CellSaveDataSystemFileParam));
+
+    char sfo_path[1024];
+    path_join(sfo_path, sizeof sfo_path, save_path, "PARAM.SFO");
+    FILE* fp = fopen(sfo_path, "rb");
+    if (!fp) return;
+    u8* d = NULL;
+    long sz = -1;
+    if (fseek(fp, 0, SEEK_END) == 0) sz = ftell(fp);
+    if (sz >= 0x14 && sz <= (1 << 20) && fseek(fp, 0, SEEK_SET) == 0) {
+        d = (u8*)malloc((size_t)sz);
+        if (d && fread(d, 1, (size_t)sz, fp) != (size_t)sz) { free(d); d = NULL; }
+    }
+    if (d && !memcmp(d, "\0PSF", 4)) {
+        const u32 ks = psf_le32(d + 8), ds = psf_le32(d + 12), n = psf_le32(d + 16);
+        for (u32 i = 0; i < n && 0x14 + (u64)(i + 1) * 0x10 <= (u64)sz; i++) {
+            const u8* e = d + 0x14 + i * 0x10;
+            const u64 kp = (u64)ks + psf_le16(e), vp = (u64)ds + psf_le32(e + 12);
+            const u32 fmt = psf_le16(e + 2), len = psf_le32(e + 4);
+            if (kp >= (u64)sz || vp + len > (u64)sz || !memchr(d + kp, 0, (size_t)((u64)sz - kp)))
+                continue;
+            const char* key = (const char*)d + kp;
+            const u8* v = d + vp;
+            if (!strcmp(key, "TITLE"))
+                sfo_copy(param->title, sizeof param->title, v, len);
+            else if (!strcmp(key, "SUB_TITLE"))
+                sfo_copy(param->subTitle, sizeof param->subTitle, v, len);
+            else if (!strcmp(key, "DETAIL"))
+                sfo_copy(param->detail, sizeof param->detail, v, len);
+            else if (!strcmp(key, "SAVEDATA_LIST_PARAM"))
+                sfo_copy(param->listParam, sizeof param->listParam, v, len);
+            else if (!strcmp(key, "ATTRIBUTE") && fmt == PSF_FMT_INT32 && len >= 4)
+                param->attribute = psf_le32(v);
+            else if (!strcmp(key, "PARENTAL_LEVEL") && fmt == PSF_FMT_INT32 && len >= 4)
+                sysparam_set_parental(param, psf_le32(v));
+            else if (key[0] == '*' && fmt == PSF_FMT_INT32 && len >= 4)
+                files_set(files, key + 1, psf_le32(v) != 0);
+        }
+        free(d);
+        fclose(fp);
+        return;
+    }
+    free(d);
+
+    /* The text form this file wrote before it wrote PSF. */
+    fseek(fp, 0, SEEK_SET);
+    char line[2048];
+    while (fgets(line, sizeof(line), fp)) {
+        size_t len = strlen(line);
+        while (len > 0 && (line[len-1] == '\n' || line[len-1] == '\r'))
+            line[--len] = '\0';
+
+        if (strncmp(line, "TITLE=", 6) == 0)
+            strncpy(param->title, line + 6, CELL_SAVEDATA_SYSP_TITLE_SIZE - 1);
+        else if (strncmp(line, "SUB_TITLE=", 10) == 0)
+            strncpy(param->subTitle, line + 10, CELL_SAVEDATA_SYSP_SUBTITLE_SIZE - 1);
+        else if (strncmp(line, "DETAIL=", 7) == 0)
+            strncpy(param->detail, line + 7, CELL_SAVEDATA_SYSP_DETAIL_SIZE - 1);
+        else if (strncmp(line, "ATTRIBUTE=", 10) == 0)
+            param->attribute = (u32)atoi(line + 10);
+        else if (strncmp(line, "LIST_PARAM=", 11) == 0)
+            strncpy(param->listParam, line + 11, CELL_SAVEDATA_SYSP_LPARAM_SIZE - 1);
+    }
+    fclose(fp);
+
+    /* ...and its PARAM.PFD: one secure file name per line. A firmware PFD
+     * is binary ("\0\0\0\0PFDB") and is not this. */
+    if (!files) return;
+    path_join(sfo_path, sizeof sfo_path, save_path, "PARAM.PFD");
+    fp = fopen(sfo_path, "rb");
+    if (!fp) return;
+    char magic[8] = {0};
+    if (fread(magic, 1, 8, fp) == 8 && !memcmp(magic, "\0\0\0\0PFDB", 8)) { fclose(fp); return; }
+    fseek(fp, 0, SEEK_SET);
+    while (fgets(line, sizeof line, fp)) {
+        line[strcspn(line, "\r\n")] = 0;
+        if (line[0]) files_set(files, line, 1);
+    }
+    fclose(fp);
+}
+
+/* A crash between the two renames of a commit leaves only ".NAME.old": put
+ * it back, or the save would be gone. */
+static void savedata_recover(const char* dirName)
+{
+    char path[1024], old[1024], oldn[64];
+    build_save_path(path, sizeof path, dirName);
+    if (dir_exists(path)) return;
+    snprintf(oldn, sizeof oldn, ".%s.old", dirName);
+    build_save_path(old, sizeof old, oldn);
+    if (dir_exists(old) && host_rename(old, path) == 0)
+        printf("[cellSaveData] restored '%s' left behind by an interrupted save\n", dirName);
+}
+
+/* Replace save directory `path` with the finished staging directory `stage`.
+ * A save is written into ".NAME.tmp" and swapped in only once every callback
+ * has succeeded, so a crash, a refused write or a failing callback leaves the
+ * previous save untouched -- this used to write in place, and the runtime
+ * dying mid-autosave would have taken the player's only save with it. */
+static s32 savedata_commit(const char* dirName, const char* stage, const char* path,
+                           int* wrote)
+{
+    *wrote = 0;
+    if (savedata_env_flag("PS3_SAVEDATA_READONLY")) {
+        remove_save_dir(stage);
+        printf("[cellSaveData] PS3_SAVEDATA_READONLY: '%s' not written\n", dirName);
+        return CELL_OK;
+    }
+    *wrote = 1;
+    char oldn[64], old[1024];
+    snprintf(oldn, sizeof oldn, ".%s.old", dirName);
+    build_save_path(old, sizeof old, oldn);
+    if (dir_exists(old)) remove_save_dir(old);
+    const int had = dir_exists(path);
+    if (!had || host_rename(path, old) == 0) {
+        if (host_rename(stage, path) == 0) {
+            if (had) remove_save_dir(old);
+            return CELL_OK;
+        }
+        if (had) host_rename(old, path);
+    }
+    /* A rename can be refused (on Windows, by any open handle into the save):
+     * fall back to updating the directory in place. */
+    printf("[cellSaveData] '%s': directory swap refused, writing in place\n", dirName);
+    ensure_dirs(path);
+    savedata_names s;
+    char a[1024], b[1024];
+    if (list_dir(path, &s) == 0) {
+        for (u32 i = 0; i < s.n; i++) {
+            if (s.dir[i]) continue;
+            path_join(a, sizeof a, stage, s.v[i]);
+            path_join(b, sizeof b, path, s.v[i]);
+            if (!file_exists(a)) remove(b);
+        }
+        names_free(&s);
+    }
+    const int bad = copy_save_files(stage, path) != 0;
+    remove_save_dir(stage);
+    return bad ? CELL_SAVEDATA_ERROR_ACCESS_ERROR : CELL_OK;
+}
+
+/* ---------------------------------------------------------------------------
+ * Directory list
+ *
+ * The saves a List/Fixed call offers: directories under the savedata root
+ * whose name starts with one of the '|'-separated prefixes and that hold a
+ * PARAM.SFO, sorted the way CellSaveDataSetList asks. The order is not
+ * cosmetic. inFamous 2's ListAutoLoad callback loads dirList[0] and nothing
+ * else, trusting the firmware to put the newest save first (it asks for
+ * MODIFIEDTIME, DESCENT); unsorted, the alphabetically first save -- the
+ * autosave, BCUS98125_INFAMOUS2_0 -- won over a newer manual save.
+ * -----------------------------------------------------------------------*/
+typedef struct savedata_dir_entry {
+    CellSaveDataDirList list;   /* guest layout: dirName[32] listParam[8] reserved[8] */
+    s64  mtime;                 /* of PARAM.SFO, rewritten by every save */
+    char subTitle[CELL_SAVEDATA_SYSP_SUBTITLE_SIZE];
+} savedata_dir_entry;
+
+typedef struct savedata_dirs {
+    savedata_dir_entry* e;
+    u32 n;
+} savedata_dirs;
+
+static void savedata_dirs_free(savedata_dirs* d)
+{
+    free(d->e);
+    d->e = NULL; d->n = 0;
+}
+
+static s64 savedata_dirs_mtime(const savedata_dirs* d, const char* name)
+{
+    for (u32 i = 0; d && i < d->n; i++)
+        if (!strcmp(d->e[i].list.dirName, name)) return d->e[i].mtime;
+    return 0;
+}
+
+static int savedata_prefix_match(const char* prefixes, const char* name)
+{
+    if (!prefixes || !*prefixes) return 1;
+    for (const char* p = prefixes;;) {
+        const char* bar = strchr(p, '|');
+        size_t n = bar ? (size_t)(bar - p) : strlen(p);
+        if (strncmp(name, p, n) == 0) return 1;
+        if (!bar) return 0;
+        p = bar + 1;
+    }
+}
+
+static u32 s_sort_type, s_sort_order;
+
+static int savedata_dir_cmp(const void* a, const void* b)
+{
+    const savedata_dir_entry* x = (const savedata_dir_entry*)a;
+    const savedata_dir_entry* y = (const savedata_dir_entry*)b;
+    int c = s_sort_type == CELL_SAVEDATA_SORTTYPE_SUBTITLE
+          ? strcmp(x->subTitle, y->subTitle)
+          : (x->mtime > y->mtime) - (x->mtime < y->mtime);
+    if (!c) c = strcmp(x->list.dirName, y->list.dirName);
+    return s_sort_order == CELL_SAVEDATA_SORTORDER_ASCENT ? c : -c;
