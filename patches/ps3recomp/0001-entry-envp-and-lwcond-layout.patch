+/* Fragment entry: snapshot the FBC / FLR slots (everything else in v[] is a
+ * host value the lifted code already stored). */
+void ppu_slotcheck_enter(const uint32_t* d, uint64_t* v)
+{
+    if (!ppu_sc_ready()) return;
+    const uint32_t n = d[1];
+    for (uint32_t i = 0; i < n; i++) {
+        const unsigned kind = d[2 + 2 * i] >> 8;
+        const int32_t off = (int32_t)d[3 + 2 * i];
+        uint64_t x;
+        if (kind == PPU_SC_FBC)
+            v[1 + i] = ppu_sc_rd(v[0] + (int64_t)off, 8, &x) ? x : PPU_SC_SKIP;
+        else if (kind == PPU_SC_FLR)
+            v[1 + i] = (i && v[i] != PPU_SC_SKIP && ppu_sc_rd(v[i] + (int64_t)off, 8, &x))
+                     ? x : PPU_SC_SKIP;
+    }
+}
+
+void ppu_slotcheck(ppu_context* ctx, const uint32_t* d, const uint64_t* v, uint32_t ra,
+                   int32_t sp_delta)
+{
+    if (!ppu_sc_ready()) return;
+    ppu_sc_cover(d[0]);
+    const uint64_t sp0 = v[0];
+    const uint32_t n = d[1];
+    for (uint32_t i = 0; i < n; i++) {
+        const unsigned kind = d[2 + 2 * i] >> 8, reg = d[2 + 2 * i] & 0xFF;
+        const int32_t off = (int32_t)d[3 + 2 * i];
+        uint64_t want = v[1 + i], got = 0, addr;
+        unsigned w = 8;
+        if (kind == PPU_SC_FBC || kind == PPU_SC_FLR) {
+            if (want == PPU_SC_SKIP) continue;
+            addr = (kind == PPU_SC_FLR ? v[i] : sp0) + (int64_t)off;
+        } else {
+            addr = sp0 + (int64_t)off;
+            if (kind == PPU_SC_BC32) { w = 4; want &= 0xFFFFFFFFull; }
+        }
+        const int ok = ppu_sc_rd(addr, w, &got);
+        if (!ok || got != want)
+            ppu_sc_mismatch(ctx, d, kind, reg, off, addr, want, got, ok, ra, sp0);
+    }
+    if (sp_delta != PPU_SC_NOSP && ctx && ctx->gpr[1] != sp0 + (int64_t)sp_delta)
+        ppu_sc_mismatch(ctx, d, PPU_SC_SP, 1, sp_delta, 0, sp0 + (int64_t)sp_delta,
+                        ctx->gpr[1], 1, ra, sp0);
+    if (__builtin_expect(++t_sc_batch >= 1024, 0)) ppu_sc_tick();
+}
+
+/* Print a summary now (e.g. from a shutdown path); also runs at exit. */
+void ppu_slotcheck_summary(const char* why)
+{
+    ppu_sc_summary(why ? why : "request");
+}
