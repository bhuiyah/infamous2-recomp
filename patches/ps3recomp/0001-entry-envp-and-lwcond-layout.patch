+/* --- mip chains ------------------------------------------------------------
+ * SET_TEXTURE_FORMAT's level count, clamped to the halvings down to 1x1. */
+static void test_level_count(void)
+{
+    CHECK_EQ(rsx_texture_level_count(1024, 8, 11), 11);
+    CHECK_EQ(rsx_texture_level_count(1024, 8, 15), 11);   /* 1024 = 2^10: 11 levels */
+    CHECK_EQ(rsx_texture_level_count(8, 2, 20), 4);       /* 8x2 4x1 2x1 1x1 */
+    CHECK_EQ(rsx_texture_level_count(64, 64, 0), 1);      /* 0 reads as 1 */
+    CHECK_EQ(rsx_texture_level_count(1, 1, 9), 1);
+    CHECK_EQ(rsx_texture_level_count(320, 180, 99), 9);   /* NPOT: floor(log2 320) + 1 */
+    CHECK_EQ(rsx_texture_level_count(0, 4, 3), 0);
+    rsx_tex_level lv[RSX_MAX_TEXTURE_LEVELS];
+    CHECK_EQ(rsx_texture_mip_chain(FMT_A8R8G8B8, 8, 2, 20, 0, lv), 4);
+    CHECK_EQ(lv[3].w, 1); CHECK_EQ(lv[3].h, 1);
+}
+
+/* Swizzled levels: packed back to back, each Morton-ordered at its own size. */
+static void test_mip_chain_swizzled(void)
+{
+    rsx_tex_level lv[RSX_MAX_TEXTURE_LEVELS];
+    const u32 n = rsx_texture_mip_chain(FMT_A8R8G8B8, 64, 16, 7, 0, lv);
+    CHECK_EQ(n, 7);
+    static const u32 w[7] = {64, 32, 16, 8, 4, 2, 1}, h[7] = {16, 8, 4, 2, 1, 1, 1};
+    u32 off = 0;
+    for (u32 m = 0; m < 7; m++) {
+        CHECK_EQ(lv[m].w, w[m]); CHECK_EQ(lv[m].h, h[m]);
+        CHECK_EQ(lv[m].offset, off);
+        CHECK(lv[m].tl.swizzled);
+        CHECK_EQ(lv[m].tl.face_bytes, w[m] * h[m] * 4u);
+        off += w[m] * h[m] * 4u;
+    }
+    /* a pitch does not apply to a swizzled texture */
+    rsx_tex_level lp[RSX_MAX_TEXTURE_LEVELS];
+    rsx_texture_mip_chain(FMT_A8R8G8B8, 64, 16, 7, 1024, lp);
+    for (u32 m = 0; m < 7; m++) CHECK_EQ(lp[m].offset, lv[m].offset);
+
+    /* level 1 of a swizzled 4x4 decodes from its own Morton order */
+    u8 src[16 * 4 + 4 * 4];
+    for (u32 i = 0; i < sizeof src; i++) src[i] = (u8)i;
+    rsx_texture_mip_chain(FMT_A8R8G8B8, 4, 4, 2, 0, lv);
+    CHECK_EQ(lv[1].offset, 64);
+    u8 dst[2 * 8];
+    rsx_texture_decode(dst, 8, src + lv[1].offset, 2, 2, &lv[1].tl, 0);
+    /* texel (1,0) is Morton index 1, (0,1) index 2: guest A,R,G,B -> R,G,B,A */
+    CHECK_EQ(dst[4], src[64 + 4 + 1]); CHECK_EQ(dst[7], src[64 + 4 + 0]);
+    CHECK_EQ(dst[8], src[64 + 8 + 1]);
+}
+
+/* Compressed levels are whole blocks: a 2-texel-high level is one block row,
+ * a 1x1 one a whole block. 1024x8 DXT1 is the fairground gate's strip. */
+static void test_mip_chain_dxt(void)
+{
+    rsx_tex_level lv[RSX_MAX_TEXTURE_LEVELS];
+    const u32 n = rsx_texture_mip_chain(FMT_DXT1, 1024, 8, 11, 0, lv);
+    CHECK_EQ(n, 11);
+    static const u32 off[11] = {0, 4096, 5120, 5632, 5888, 6016, 6080, 6112, 6128, 6136, 6144};
+    for (u32 m = 0; m < 11; m++) CHECK_EQ(lv[m].offset, off[m]);
+    CHECK_EQ(lv[2].w, 256); CHECK_EQ(lv[2].h, 2);
+    CHECK_EQ(lv[2].tl.rows, 1); CHECK_EQ(lv[2].tl.row_bytes, 512);
+    CHECK_EQ(lv[10].tl.face_bytes, 8);
+    CHECK_EQ(lv[10].offset + lv[10].tl.face_bytes, 6152);
+
+    /* DXT45: 16-byte blocks */
+    rsx_texture_mip_chain(FMT_DXT45, 16, 16, 5, 0, lv);
+    CHECK_EQ(lv[1].offset, 256); CHECK_EQ(lv[2].offset, 320);
+    CHECK_EQ(lv[3].offset, 336); CHECK_EQ(lv[4].offset, 352);
+}
