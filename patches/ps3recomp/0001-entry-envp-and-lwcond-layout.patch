+    { FP_PK_L2S,
+      "float4 rsx_l2s(float4 c) { return saturate(c < 0.0031308 ? c * 12.92 : 1.055 * pow(abs(c), 1.0 / 2.4) - 0.055); }\n" },
+    { FP_PK_S2L,
+      "float4 rsx_s2l(float4 c) { return c > 0.04045 ? pow((c + 0.055) / 1.055, 2.4) : c / 12.92; }\n" },
+    { FP_PK_PKB,
+      "float rsx_pkb(float4 v) { const uint4 b = (uint4)round(saturate(v) * 255.0);"
+      " return asfloat(b.x | (b.y << 8) | (b.z << 16) | (b.w << 24)); }\n" },
+    { FP_PK_UPB,
